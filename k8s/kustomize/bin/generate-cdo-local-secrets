#!/usr/bin/env ruby
#
# Usage:
#   ./bin/generate-cdo-local-secrets [NAME_PREFIX]
#
# Pass the same string your kustomization.yaml uses for `namePrefix:`.
#
# Example for levelbuilder/kustomization.yaml:
# ```
#   apiVersion: kustomize.config.k8s.io/v1alpha1
#   kind: Component
#   namePrefix: levelbuilder-
# ```
#
# Run like:
#   ./bin/generate-cdo-local-secrets levelbuilder-
#
# If omitted, NAME_PREFIX defaults to the empty string, which generates hostnames
# like `cdo-mysql`, `cdo-redis`, and `cdo-minio`. If passed in, it prepends it ;-)

require 'fileutils'
require 'securerandom'

ROOT = File.expand_path('..', __dir__)
MYSQL_SECRET_DIR = File.join(ROOT, 'components', 'mysql')
REDIS_SECRET_DIR = File.join(ROOT, 'components', 'redis')
MINIO_SECRET_DIR = File.join(ROOT, 'components', 'minio')

name_prefix = ARGV.shift || ''
hostname_for = ->(component) {"#{name_prefix}cdo-#{component}"}

def generate_password(length = 12)
  alphabet = [('a'..'z'), ('A'..'Z'), ('0'..'9')].flat_map(&:to_a)
  Array.new(length) {alphabet[SecureRandom.random_number(alphabet.length)]}.join
end

def write_env_file(dir, filename, values)
  FileUtils.mkdir_p(dir)
  lines = values.map {|key, value| "#{key}=#{value}"}
  path = File.join(dir, filename)
  File.write(path, "#{lines.join("\n")}\n")
  path
end

def read_env_file(path)
  return {} unless File.exist?(path)

  File.readlines(path, chomp: true).each_with_object({}) do |line, values|
    next if line.empty? || line.start_with?('#')

    key, value = line.split('=', 2)
    values[key] = value if key && value
  end
end

mysql_env = read_env_file(File.join(MYSQL_SECRET_DIR, 'cdo-local-secret-mysql.secret.env'))
redis_env = read_env_file(File.join(REDIS_SECRET_DIR, 'cdo-local-secret-redis.secret.env'))
minio_env = read_env_file(File.join(MINIO_SECRET_DIR, 'cdo-local-secret-minio.secret.env'))

mysql_password = mysql_env.fetch('_mysql_root_password', generate_password)
redis_password = redis_env.fetch('_redis_password', generate_password)
minio_password = minio_env.fetch('_minio_root_password', generate_password)
minio_user = minio_env.fetch('_minio_root_user', 'local-development')

mysql_env_path = write_env_file(MYSQL_SECRET_DIR, 'cdo-local-secret-mysql.secret.env', [
                                  ['_mysql_root_password', mysql_password],
                                  ['db_writer', "mysql://root:#{mysql_password}@#{hostname_for.call('mysql')}/"],
                                  ['db_reader', "mysql://root:#{mysql_password}@#{hostname_for.call('mysql')}/"],
                                  ['reporting_db_writer', "mysql://root:#{mysql_password}@#{hostname_for.call('mysql')}/"],
                                  ['reporting_db_reader', "mysql://root:#{mysql_password}@#{hostname_for.call('mysql')}/"],
                                  ['db_credential_admin', %({"username":"root","password":"#{mysql_password}"})],
                                  ['db_credential_writer', %({"username":"root","password":"#{mysql_password}"})],
                                  ['db_credential_reader', %({"username":"root","password":"#{mysql_password}"})]
                                ]
)

redis_env_path = write_env_file(REDIS_SECRET_DIR, 'cdo-local-secret-redis.secret.env', [
                                  ['_redis_password', redis_password],
                                  ['redis_url', "redis://:#{redis_password}@#{hostname_for.call('redis')}:6379/0"],
                                  ['netsim_redis_groups', %([{"master":"redis://:#{redis_password}@#{hostname_for.call('redis')}:6379"}])]
                                ]
)

minio_env_path = write_env_file(MINIO_SECRET_DIR, 'cdo-local-secret-minio.secret.env', [
                                  ['_minio_root_password', minio_password],
                                  ['_minio_root_user', minio_user],
                                  ['aws_s3_access_key_id', minio_user],
                                  ['aws_s3_secret_access_key', minio_password]
                                ]
)

puts "wrote secrets for namePrefix=#{name_prefix.inspect}:"
[
  mysql_env_path,
  redis_env_path,
  minio_env_path
].each do |path|
  puts
  puts path
  puts File.read(path)
end
