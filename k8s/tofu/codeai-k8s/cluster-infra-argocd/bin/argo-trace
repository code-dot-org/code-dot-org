#!/usr/bin/env -S bundle exec ruby
# frozen_string_literal: true

require "digest"
require "json"
require "optparse"
require "set"
require "tempfile"
require "time"
require "tmpdir"
require "yaml"
require "action_view"

Thread.report_on_exception = false

class CommandTimings
  Entry = Struct.new(:calls, :total_seconds, :max_seconds, :example, keyword_init: true)

  def initialize(path:)
    @path = path.to_s
    @entries = {}
    @mutex = Mutex.new
  end

  def enabled?
    !@path.empty?
  end

  def configure!(path:)
    @path = path.to_s
  end

  def measure(command)
    return yield unless enabled?

    started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    yield
  ensure
    if enabled? && started_at
      elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started_at
      label = command_label(command)
      example = command.join(" ")

      @mutex.synchronize do
        entry = @entries[label] ||= Entry.new(calls: 0, total_seconds: 0.0, max_seconds: 0.0, example: example)
        entry.calls += 1
        entry.total_seconds += elapsed
        entry.max_seconds = [entry.max_seconds, elapsed].max
      end
    end
  end

  def dump!
    return unless enabled?

    lines = ["count total_s avg_ms max_ms label example"]
    @entries.sort_by {|_, entry| -entry.total_seconds}.each do |label, entry|
      average_ms = entry.total_seconds * 1000 / entry.calls
      lines << format(
        "%5d %7.3f %7.1f %7.1f %s %s",
        entry.calls,
        entry.total_seconds,
        average_ms,
        entry.max_seconds * 1000,
        label,
        entry.example,
      )
    end
    File.write(@path, lines.join("\n") + "\n")
  end

  private def command_label(command)
    return command.first.to_s unless command.first == "kubectl"

    tokens = command.drop(1)
    index = tokens.index("get")
    if index
      subject = tokens[index + 1].to_s
      return "kubectl get #{subject}"
    end

    index = tokens.index("api-resources")
    return "kubectl api-resources" if index

    command.first(3).join(" ")
  end
end

COMMAND_TIMINGS = CommandTimings.new(path: ENV.fetch("ARGO_TRACE_TIMINGS_OUT", nil))
at_exit {COMMAND_TIMINGS.dump!}

class NullProfileSession
  def enabled?
    false
  end

  def profile_dir
    nil
  end

  def stackprof_path
    nil
  end

  def with_context(_label)
    yield
  end

  def command_started(*, **)
    nil
  end

  def command_finished(*, **)
    nil
  end
end

class ProfileSession
  THREAD_CONTEXT_KEY = :argo_trace_profile_context

  class << self
    def current
      @current ||= NullProfileSession.new
    end

    def configure!(enabled:)
      @current = enabled ? new : NullProfileSession.new
    end
  end

  attr_reader :profile_dir, :stackprof_path

  def initialize
    timestamp = Time.now.utc.strftime("%Y%m%dT%H%M%SZ")
    @profile_dir = Dir.mktmpdir("argo-trace-profile-#{timestamp}-", Dir.tmpdir)
    @stackprof_path = File.join(@profile_dir, "stackprof.dump")
    @command_log_path = File.join(@profile_dir, "profile-commands.yaml")
    @status_path = File.join(@profile_dir, "status.json")
    @started_at = Time.now.utc.iso8601(6)
    @command_records = []
    @mutex = Mutex.new
  end

  def enabled?
    true
  end

  def with_context(label)
    stack = Thread.current[THREAD_CONTEXT_KEY] ||= []
    stack.push(label)
    yield
  ensure
    stack&.pop
  end

  def command_started(command:, check:)
    payload = {
      started_at: Time.now.utc.iso8601(6),
      context: context_stack,
      command: command,
      check: check,
    }
    @mutex.synchronize do
      File.write(@status_path, JSON.pretty_generate(payload) + "\n")
    end
  end

  def command_finished(command:, elapsed_seconds:, status:, check:)
    record = {
      "finished_at" => Time.now.utc.iso8601(6),
      "elapsed_s" => elapsed_seconds.round(3),
      "status" => status&.exitstatus,
      "success" => status&.success?,
      "check" => check,
      "context" => context_stack,
      "command" => command,
    }

    @mutex.synchronize do
      @command_records << record
      File.write(
        @command_log_path,
        YAML.dump(
          {
            "started_at" => @started_at,
            "updated_at" => record.fetch("finished_at"),
            "commands" => @command_records,
          },
        ),
      )
      File.write(@status_path, JSON.pretty_generate({idle: true, last_finished_at: record.fetch("finished_at")}) + "\n")
    end
  end

  private def context_stack
    (Thread.current[THREAD_CONTEXT_KEY] || []).dup
  end
end

def profile_context(label, &block)
  ProfileSession.current.with_context(label, &block)
end

# #### API and identity types

ApiResource = Struct.new(
  :group,
  :version,
  :kind,
  :resource,
  :namespaced,
  :categories,
  keyword_init: true,
) do
  def api_version
    group.empty? ? version : "#{group}/#{version}"
  end

  def kubectl_name
    group.empty? ? resource : "#{resource}.#{group}"
  end
end

Ref = Struct.new(:group, :kind, :namespace, :name, keyword_init: true) do
  # Collapse a live object down to the identity Argo and kubectl both use when
  # referring to it. The rest of the tracer passes refs around instead of raw
  # hashes so graph edges stay cheap and stable.
  def self.from_object(k8s_object)
    api_version = k8s_object.fetch("apiVersion")
    group = api_version.include?("/") ? api_version.split("/", 2).first : ""
    new(
      group: group,
      kind: k8s_object.fetch("kind"),
      namespace: k8s_object.dig("metadata", "namespace"),
      name: k8s_object.dig("metadata", "name"),
    )
  end

  def key
    [group, kind, namespace.to_s, name]
  end

  def display
    return name if kind == "Application"
    return "applicationset/#{name}" if kind == "ApplicationSet"

    "#{kind.downcase}/#{name}"
  end
end

Edge = Struct.new(:ref, :source, :argo, keyword_init: true)

# #### Argo tracking and shell/discovery

