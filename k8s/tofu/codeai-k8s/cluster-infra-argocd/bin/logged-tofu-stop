#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cwd=$(CDPATH= cd -- "$script_dir/.." && pwd)
shared_log_file="$cwd/tofu.log"
run_log_file_file=/tmp/cluster-infra-argocd-last-log-path
events_pid_file="$cwd/.logged-tofu-events.pid"

[ -f "$events_pid_file" ] || exit 0

events_pid=$(cat "$events_pid_file" 2>/dev/null || true)
run_log_file=$(cat "$run_log_file_file" 2>/dev/null || true)

if [ -n "${events_pid:-}" ] && kill -0 "$events_pid" 2>/dev/null; then
  printf '%s [meta] stopping kubectl events watch pid=%s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$events_pid" \
    | tee -a "$shared_log_file" ${run_log_file:+"$run_log_file"}
  kill "$events_pid" 2>/dev/null || true
fi

rm -f "$events_pid_file"
