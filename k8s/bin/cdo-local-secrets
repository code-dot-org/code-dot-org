#!/usr/bin/env ruby
#
# Generate and load values from $(reporoot)/cdo-local-secrets.env.
#
# Skaffold uses these values in development to populate the Helm-managed
# cdo-local-secrets Secret for local MySQL/Redis/MinIO when we are using
# in-cluster dev services instead of RDS/S3/ElastiCache.
#
# Skaffold example from skaffold.yaml:
#   - op: add
#     path: /deploy/helm/releases/0/setValueTemplates/services.redis.password
#     value: '{{ cmd "./k8s/bin/cdo-local-secrets" "REDIS_PASSWORD" }}'
#
# Usage:
#   ./k8s/bin/cdo-local-secrets REDIS_PASSWORD
#
# It prints the requested value to stdout so Skaffold can pass it into Helm
# `setValueTemplates`.

require 'securerandom'

REPO_ROOT = File.expand_path('../..', __dir__)
ENV_PATH = File.join(REPO_ROOT, 'cdo-local-secrets.env')
LOCK_PATH = "#{ENV_PATH}.lock"
DEFAULTS = {
  'MYSQL_ROOT_PASSWORD' => nil,
  'REDIS_PASSWORD' => nil,
  'MINIO_ROOT_PASSWORD' => nil
}.freeze

def usage!
  warn "Usage: ./k8s/bin/cdo-local-secrets #{DEFAULTS.keys.join('|')}"
  exit 1
end

def read_env_file(path)
  return {} unless File.exist?(path)

  File.readlines(path, chomp: true).each_with_object({}) do |line, values|
    next if line.empty? || line.start_with?('#')

    key, value = line.split('=', 2)
    values[key] = value if key && value
  end
end

def generate_secret(length = 24)
  SecureRandom.alphanumeric(length)
end

def write_env_file(path, values)
  lines = [
    '# Generated and loaded by k8s/bin/cdo-local-secrets.',
    '# Used by Skaffold in development to populate the Helm-managed',
    '# cdo-local-secrets Secret. Delete this file to generate fresh values.',
    nil
  ]

  DEFAULTS.each_key do |key|
    lines << "#{key}=#{values.fetch(key)}"
  end

  File.write(path, "#{lines.join("\n")}\n")
end

def warn_regenerated_secret(key)
  warn "WARNING: Regenerated #{key} in #{ENV_PATH}."
  warn "WARNING: You may need to destroy and recreate the related service if it was already created with an old secret."
end

requested_key = ARGV.shift
usage! unless requested_key && DEFAULTS.key?(requested_key)

File.open(LOCK_PATH, File::RDWR | File::CREAT, 0o600) do |lock_file|
  lock_file.flock(File::LOCK_EX)

  env_file_existed = File.exist?(ENV_PATH)
  values = read_env_file(ENV_PATH)
  DEFAULTS.each do |key, default|
    next if values[key] && !values[key].empty?

    values[key] = default || generate_secret
    warn_regenerated_secret(key) if env_file_existed && default.nil?
  end

  write_env_file(ENV_PATH, values)
  puts values.fetch(requested_key)
end
