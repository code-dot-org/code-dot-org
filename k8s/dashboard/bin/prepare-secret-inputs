#!/usr/bin/env ruby

require 'fileutils'
require 'securerandom'

ROOT = File.expand_path('..', __dir__)
MYSQL_SECRET_DIR = File.join(ROOT, 'components', 'mysql')
REDIS_SECRET_DIR = File.join(ROOT, 'components', 'redis')
MINIO_SECRET_DIR = File.join(ROOT, 'components', 'minio')

TARGET_RELEASE_NAMES = {
  'development' => 'cdo',
  'mount-dot-aws' => 'cdo',
  'development-setup-db' => 'cdo',
  'development-setup-s3' => 'cdo',
  'development-setup-db-setup-s3' => 'cdo',
  'production' => 'cdo',
  'test' => 'cdo',
  'staging' => 'staging',
  'levelbuilder' => 'levelbuilder',
  'autoscale-prod' => 'autoscale-prod'
}.freeze

def release_name_for(target)
  TARGET_RELEASE_NAMES.fetch(target) {raise ArgumentError, "unknown target: #{target}"}
end

def component_name(release_name, component)
  if release_name.include?('cdo')
    "#{release_name}-#{component}"
  else
    "#{release_name}-cdo-#{component}"
  end
end

def random_alnum(length)
  alphabet = [('a'..'z'), ('A'..'Z'), ('0'..'9')].flat_map(&:to_a)
  Array.new(length) {alphabet[SecureRandom.random_number(alphabet.length)]}.join
end

def write_env_file(dir, filename, values)
  FileUtils.mkdir_p(dir)
  lines = values.map {|key, value| "#{key}=#{value}"}
  File.write(File.join(dir, filename), "#{lines.join("\n")}\n")
end

target = ARGV.shift
abort('Usage: ruby k8s/dashboard/bin/prepare-secret-inputs TARGET') unless target

release_name = release_name_for(target)
mysql_password = random_alnum(24)
redis_password = random_alnum(24)
minio_password = random_alnum(24)
minio_user = 'local-development'

write_env_file(MYSQL_SECRET_DIR, 'cdo-local-secret-mysql.secret.env', [
                 ['_mysql_root_password', mysql_password],
                 ['db_writer', "mysql://root:#{mysql_password}@#{component_name(release_name, 'mysql')}/"],
                 ['db_reader', "mysql://root:#{mysql_password}@#{component_name(release_name, 'mysql')}/"],
                 ['reporting_db_writer', "mysql://root:#{mysql_password}@#{component_name(release_name, 'mysql')}/"],
                 ['reporting_db_reader', "mysql://root:#{mysql_password}@#{component_name(release_name, 'mysql')}/"],
                 ['db_credential_admin', %({"username":"root","password":"#{mysql_password}"})],
                 ['db_credential_writer', %({"username":"root","password":"#{mysql_password}"})],
                 ['db_credential_reader', %({"username":"root","password":"#{mysql_password}"})]
               ]
)

write_env_file(REDIS_SECRET_DIR, 'cdo-local-secret-redis.secret.env', [
                 ['_redis_password', redis_password],
                 ['redis_url', "redis://:#{redis_password}@#{component_name(release_name, 'redis')}:6379/0"],
                 ['netsim_redis_groups', %([{"master":"redis://:#{redis_password}@#{component_name(release_name, 'redis')}:6379"}])]
               ]
)

write_env_file(MINIO_SECRET_DIR, 'cdo-local-secret-minio.secret.env', [
                 ['_minio_root_password', minio_password],
                 ['_minio_root_user', minio_user],
                 ['aws_s3_access_key_id', minio_user],
                 ['aws_s3_secret_access_key', minio_password]
               ]
)

puts "wrote secret inputs for #{target} to:"
puts "  #{MYSQL_SECRET_DIR}"
puts "  #{REDIS_SECRET_DIR}"
puts "  #{MINIO_SECRET_DIR}"
