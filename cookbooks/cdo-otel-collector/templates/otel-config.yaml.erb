# OpenTelemetry Collector Configuration
# For more details, see https://opentelemetry.io/docs/collector/configuration/
# Generated by Chef cookbook: cdo-otel-collector

receivers:
  # OTLP Receiver for applications sending telemetry data
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318

  # Prometheus receiver for collector health metrics
  prometheus:
    config:
      scrape_configs:
        - job_name: "otelcol"
          scrape_interval: 60s
          static_configs:
            - targets: ["0.0.0.0:8888"]

  # Syslog receiver listening for RFC 3164 (Ubuntu/rsyslog default) messages forwarded
  # by rsyslog over TCP. Natively parses hostname, appname, proc_id, and message body
  # without regex. Requires rsyslog to forward to 127.0.0.1:54526 (e.g. via omfwd).
  syslog:
    tcp:
      listen_address: "127.0.0.1:54526"
    protocol: rfc3164

<% if @prometheus_remote_write_url && !@prometheus_remote_write_url.empty? %>
connectors:
  # Generates RED (Rate, Errors, Duration) metrics from Rack spans for Prometheus.
  # span.name is automatically included as a label and serves as the route identifier
  # since http.route is not available in our Rails 6.1 Rack instrumentation.
  # Buckets are coarse by design: CloudWatch-oriented teams monitor at SLO boundaries
  # (p50 ~100ms, p99 ~500ms-1s) rather than sub-10ms granularity.
  spanmetrics/rack_prometheus:
    namespace: rack
    dimensions:
      - name: http.method
      - name: http.status_code
      - name: span.status.code
    exemplars:
      enabled: true
    histogram:
      explicit:
        buckets: [10ms, 50ms, 100ms, 250ms, 500ms, 1s, 2500ms, 5s, 10s, 30s]
    metrics_flush_interval: 60s

<% end %>
processors:
  # Batch processor for efficient data transmission
  batch:
    timeout: 10s
    send_batch_size: 1024
    send_batch_max_size: 2048

  # Detects host.name from the OS at runtime. Runs before the resource processor so that
  # host.name is available for the service.instance.id copy and transform/prometheus_labels.
  resourcedetection/system:
    detectors: [system]
    system:
      hostname_sources: [os]
    override: false

<% if @prometheus_remote_write_url && !@prometheus_remote_write_url.empty? %>
  # Promotes selected resource attributes to metric data point attributes (Prometheus dimensions).
  # Each statement adds a label that distinguishes metric series across collector instances,
  # preventing AMP from overwriting series from different hosts or environments.
  # resource_to_telemetry_conversion is intentionally omitted (defaults false) to avoid
  # promoting high-cardinality resource attributes as labels.
  transform/prometheus_labels:
    error_mode: ignore
    metric_statements:
      - context: datapoint
        statements:
          - set(attributes["host"], resource.attributes["host.name"])
          - set(attributes["environment"], resource.attributes["deployment.environment"])

  # Keeps only Rack instrumentation spans to feed the spanmetrics/rack_prometheus connector.
  filter/rack_prometheus:
    error_mode: ignore
    traces:
      span:
        - 'instrumentation_scope.name != "OpenTelemetry::Instrumentation::Rack"'

<% end %>
  # In the compatible version of OpenTelemetry for Rails 6.1, the included instrumentation does not support `http.route` as a span attribute (this is made available in Rails 7.1).
  # Due to this, DataDog will interpret the resource name as simply the HTTP method (e.g. `GET`) instead of the full route (e.g. `GET /users/:id`).
  # This processor adds a custom statement to set the resource name to the value of `http.route` when available so that resource name comes out as `GET [PATH]`.
  transform/rails_resource_name_from_rack:
    error_mode: ignore
    trace_statements:
      - context: span
        statements:
          - set(attributes["resource.name"], name)
            where instrumentation_scope.name == "OpenTelemetry::Instrumentation::Rack"
              and span.kind == SPAN_KIND_SERVER

  # Converts OpenTelemetry error spans to Datadog formatted error spans
  # OpenTelemetry specs are different than what Datadog expects for where the error lives.
  # See: https://docs.datadoghq.com/tracing/error_tracking/
  transform/datadog_errors:
    error_mode: ignore
    trace_statements:
      - context: spanevent
        statements:
          - set(span.attributes["error.type"], attributes["exception.type"])
            where name == "exception" and attributes["exception.type"] != nil
          - set(span.attributes["error.message"], attributes["exception.message"])
            where name == "exception" and attributes["exception.message"] != nil
          - set(span.attributes["error.stack"], attributes["exception.stacktrace"])
            where name == "exception" and attributes["exception.stacktrace"] != nil

  # Probabilistic sampler controlling APM trace volume. Hashes the trace ID to make a consistent
  # per-trace decision — all spans within a trace are kept or dropped together. Does not apply to
  # the spanmetrics pipeline so RED metrics remain accurate at full volume.
  probabilistic_sampler:
    sampling_percentage: <%= @apm_trace_sample_rate %>

  # Resource processor to add additional resource attributes
  resource:
    attributes:
      - key: deployment.environment
        value: <%= node.chef_environment %>
        action: upsert
      - key: service.instance.id
        from_attribute: host.name
        action: insert

<% if @prometheus_remote_write_url && !@prometheus_remote_write_url.empty? %>
extensions:
  # SigV4 signing for Amazon Managed Prometheus remote write requests.
  sigv4auth/prometheus:
    region: <%= @prometheus_region %>
    service: aps

<% end %>
exporters:
  # DataDog exporter for sending telemetry to DataDog.
  # APM stats (request/error/duration by service and resource) are computed
  # directly by the exporter — the equivalent of the datadog/connector in DDOT.
  datadog:
    api:
      key: <%= @datadog_api_key %>
      site: <%= @site %>
    traces:
      compute_stats_by_span_kind: true
      peer_tags_aggregation: true
      compute_top_level_by_span_kind: true
      ignore_resources:
        - "GET /health"
        - "GET /ping"
    metrics:
      sums:
        cumulative_monotonic_mode: to_delta
    logs:
      use_compression: true
    sending_queue:
      batch:
        flush_timeout: 10s

<% if @prometheus_remote_write_url && !@prometheus_remote_write_url.empty? %>
  # Prometheus Remote Write exporter for Amazon Managed Prometheus.
  prometheusremotewrite/rack_prometheus:
    endpoint: <%= @prometheus_remote_write_url %>
    auth:
      authenticator: sigv4auth/prometheus
<% end %>

service:
<% if @prometheus_remote_write_url && !@prometheus_remote_write_url.empty? %>
  extensions: [sigv4auth/prometheus]
<% end %>
  pipelines:
    # Traces pipeline
    traces:
      receivers: [otlp]
      processors: [resourcedetection/system, resource, transform/datadog_errors, transform/rails_resource_name_from_rack, probabilistic_sampler, batch]
      exporters: [datadog]

    # Metrics pipeline
    metrics:
      receivers: [otlp, prometheus]
      processors: [resourcedetection/system, resource, batch]
      exporters: [datadog]

    # Logs pipeline
    logs:
      receivers: [syslog, otlp]
      processors: [resourcedetection/system, resource, batch]
      exporters: [datadog]

<% if @prometheus_remote_write_url && !@prometheus_remote_write_url.empty? %>
    # Rack spans pipeline: filters to Rack spans and feeds the spanmetrics connector
    traces/rack_prometheus:
      receivers: [otlp]
      processors: [filter/rack_prometheus]
      exporters: [spanmetrics/rack_prometheus]

    # RED metrics pipeline: receives generated metrics from spanmetrics and ships to Prometheus
    metrics/rack_prometheus:
      receivers: [spanmetrics/rack_prometheus]
      processors: [resourcedetection/system, resource, transform/prometheus_labels, batch]
      exporters: [prometheusremotewrite/rack_prometheus]
<% end %>
