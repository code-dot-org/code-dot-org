# OpenTelemetry Collector Configuration  
# Generated by Chef cookbook: cdo-otel-collector

receivers:
  # OTLP Receiver for applications sending telemetry data
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318

  # Prometheus receiver for collector health metrics
  prometheus:
    config:
      scrape_configs:
        - job_name: "otelcol"
          scrape_interval: 60s
          static_configs:
            - targets: ["0.0.0.0:8888"]

processors:
  # Batch processor for efficient data transmission
  batch:
    timeout: 10s
    send_batch_size: 1024
    send_batch_max_size: 2048

  # Resource processor to add additional resource attributes
  resource:
    attributes:
      - key: deployment.environment
        value: <%= node.chef_environment %>
        action: upsert
      - key: service.instance.id
        from_attribute: host.name
        action: insert

connectors:
  # DataDog connector for APM trace metrics computation
  datadog/connector:
    traces:
      compute_stats_by_span_kind: true
      peer_tags_aggregation: true
      compute_top_level_by_span_kind: true

exporters:
  # DataDog exporter for sending telemetry to DataDog
  datadog:
    api:
      key: <%= @api_key %>
      site: <%= @site %>
    traces:
      ignore_resources:
        - "GET /health"
        - "GET /ping"
    metrics:
      sums:
        cumulative_monotonic_mode: to_delta
    logs:
      use_compression: true
    sending_queue:
      batch:
        flush_timeout: 10s

service:
  telemetry:
    logs:
      level: "info"
    metrics:
      address: 0.0.0.0:8888
      
  pipelines:
    # Traces pipeline
    traces:
      receivers: [otlp]
      processors: [resource, batch]
      exporters: [datadog/connector, datadog]
    
    # Metrics pipeline
    metrics:
      receivers: [otlp, prometheus, datadog/connector]
      processors: [resource, batch]
      exporters: [datadog]
    
    # Logs pipeline  
    logs:
      receivers: [otlp]
      processors: [resource, batch]
      exporters: [datadog]