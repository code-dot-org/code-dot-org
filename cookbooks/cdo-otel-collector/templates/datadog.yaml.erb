# DataDog Agent Configuration
# Generated by Chef cookbook: cdo-otel-collector

# DataDog site
site: <%= @site %>

# DataDog API key
api_key: <%= @datadog_api_key %>

# Enable hostname detection
hostname_fqdn: true

# Log configuration
log_level: INFO
log_file: /var/log/datadog/agent.log

# Enable OpenTelemetry Collector
otelcollector:
  enabled: true

# Agent IPC configuration for communication with OTel Collector
agent_ipc:
  port: 5009
  config_refresh_interval: 60

# Process monitoring
process_config:
  process_collection:
    enabled: true
  container_collection:
    enabled: true
  process_discovery:
    enabled: true

# Network monitoring
network_config:
  enabled: true

# Enable DogStatsD for metric collection
dogstatsd_config:
  enabled: true
  port: 8125
  non_local_traffic: false

# APM (Application Performance Monitoring) configuration  
apm_config:
  enabled: true
  port: 8126
  non_local_traffic: false

# Logs configuration
logs_enabled: <%= @logs_enabled %>
logs_config:
  logs_dd_url: https://http-intake.logs.<%= @site %>

# System Probe
system_probe_config:
  enabled: true