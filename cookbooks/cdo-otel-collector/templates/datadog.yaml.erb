# DataDog Agent Configuration
# Generated by Chef cookbook: cdo-otel-collector

# API key for DataDog
api_key: <%= @api_key %>

# DataDog site
site: <%= @site %>

# Enable hostname detection
hostname_fqdn: true

# Log configuration
log_level: INFO
log_file: /var/log/datadog/agent.log

# Enable OpenTelemetry Collector
otelcollector:
  enabled: true

# Agent IPC configuration for communication with OTel Collector
agent_ipc:
  port: 5009
  config_refresh_interval: 60

# Process monitoring (disabled by default)
process_config:
  enabled: false

# Network monitoring (disabled by default) 
network_config:
  enabled: false

# Enable DogStatsD for metric collection
dogstatsd_config:
  enabled: true
  port: 8125
  non_local_traffic: false

# APM (Application Performance Monitoring) configuration  
apm_config:
  enabled: true
  port: 8126
  non_local_traffic: false

# Logs configuration
logs_config:
  enabled: true
  logs_dd_url: https://http-intake.logs.<%= @site %>

# Enable additional integrations as needed
# Additional configuration will be placed here by other recipes/cookbooks