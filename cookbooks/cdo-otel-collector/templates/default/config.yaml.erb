receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 127.0.0.1:4317
      http:
        endpoint: 127.0.0.1:4318

  # Host telemetry
  hostmetrics:
    collection_interval: 60s
    scrapers:
      cpu: {}
      load: {}
      memory: {}
      disk: {}
      filesystem: {}
      network: {}

processors:
  batch:

exporters:
  otlp_http:
    endpoint: https://otlp.nr-data.net:4318
    headers:
      api-key: <%= node['cdo-otel']['newrelic_license_key'] %>
    compression: gzip

service:
  pipelines:
    traces:
      receivers: [otlp]
      processors: [batch]
      exporters: [otlp_http]

    metrics:
      receivers: [otlp, hostmetrics]
      processors: [batch]
      exporters: [otlp_http]

    logs:
      receivers: [otlp]
      processors: [batch]
      exporters: [otlp_http]