receivers:
<% @config['receivers'].each do |name, config| -%>
  <%= name %>:
<%= config.to_yaml.lines[2..-1].join if config.any? %>
<% end -%>

processors:
<% @config['processors'].each do |name, config| -%>
  <%= name %>:
<%= config.to_yaml.lines[2..-1].join if config.any? %>
<% end -%>

exporters:
<% @config['exporters'].each do |name, config| -%>
  <%= name %>:
<%= config.to_yaml.lines[2..-1].join if config.any? %>
<% end -%>

service:
  pipelines:
    traces:
      receivers: [otlp]
      processors: [batch, resourcedetection]
      exporters: [logging]
    metrics:
      receivers: [otlp, hostmetrics]
      processors: [batch, resourcedetection]
      exporters: [logging]
    logs:
      receivers: [otlp]
      processors: [batch]
      exporters: [logging]
      
  extensions: []
  
  telemetry:
    logs:
      level: <%= @config['log_level'] %>
    metrics:
      level: basic
      address: 0.0.0.0:8888