{
  "name": "code-dot-org",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/code-dot-org",
  "remoteUser": "cdo",

  // This runs once per container. A Codespaces prebuild caches the
  // result.
  "onCreateCommand": "cd /code-dot-org/apps && yarn install && cd /code-dot-org/frontend && yarn install && cd /code-dot-org && bundle exec rake install:hooks",

  // This runs on every start, including a bare `docker compose start`.
  // It is SETUP.md's `rake build` with the slow legs off: no seeding, and
  // no apps or studio build, since downloading the prebuilt apps package
  // beats building. It fails rather than handing over a half-migrated
  // schema.
  "postStartCommand": "CDO_SKIP_SEED_ALL=true CDO_BUILD_APPS=false CDO_BUILD_STUDIO=false bundle exec rake build",

  // Memory and storage cover the apps webpack dev server, Rails, MySQL,
  // and a jest worker running at once, plus node_modules and the built
  // apps packages. More CPUs make yarn install faster.
  "hostRequirements": {
    "cpus": 8,
    "memory": "32gb",
    "storage": "64gb"
  },

  "forwardPorts": [3000, 9000, 3036, 9001, 6006],
  "portsAttributes": {
    "3000": {"label": "Rails (dashboard)", "onAutoForward": "notify"},
    "9000": {"label": "apps dev server (webpack)", "onAutoForward": "silent"},
    "3036": {"label": "Vite (frontend/studio)", "onAutoForward": "silent"},
    "9001": {"label": "apps Storybook", "onAutoForward": "silent"},
    "6006": {"label": "Design-system Storybook", "onAutoForward": "silent"}
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "Shopify.ruby-lsp",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
