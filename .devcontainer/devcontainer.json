{
  "name": "code-dot-org",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/code-dot-org",
  "remoteUser": "cdo",

  // Once per container. A Codespaces prebuild stores the result in the
  // prebuild image. Both yarn installs are network-bound and cost about 25s each warm.
  // `dev-bootstrap create` links the git hooks and fetches the prebuilt apps
  // package from a public bucket, about 105s; apps/ is deliberately not built
  // here, because downloading beats building and only a commit that changes
  // apps/ and has never been through CI needs `yarn build` by hand.
  "onCreateCommand": "cd /code-dot-org/apps && yarn install && cd /code-dot-org/frontend && yarn install && dev-bootstrap create",

  // Every start, including a plain `docker compose start`. Applies whatever
  // migrations that the checkout gained after the database image was
  // pre-seeded,
  // and fails the start rather than handing over a half-migrated schema.
  "postStartCommand": "dev-bootstrap start",

  // Sized from measurements, not from taste. The apps webpack dev server
  // alone uses 6.5 to 14 GB. Add Rails, MySQL, and a jest worker, and a
  // normal fullstack day crosses 16 GB. Storage: node_modules is 4.1 GB
  // across the two workspaces, the prebuilt apps package is 2.1 GB, a local
  // apps build is another 2 GB, the images are 7 GB, and the checkout and
  // the caches take the rest. CPUs: yarn install uses 90 s of CPU in 22 s of
  // wall clock, so the parallelism is real.
  "hostRequirements": {
    "cpus": 8,
    "memory": "32gb",
    "storage": "64gb"
  },

  "forwardPorts": [3000, 9000, 3036, 9001, 6006],
  "portsAttributes": {
    "3000": {"label": "Rails (dashboard)", "onAutoForward": "notify"},
    "9000": {"label": "apps dev server (webpack)", "onAutoForward": "silent"},
    "3036": {"label": "Vite (frontend/studio)", "onAutoForward": "silent"},
    "9001": {"label": "apps Storybook", "onAutoForward": "silent"},
    "6006": {"label": "Design-system Storybook", "onAutoForward": "silent"}
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "Shopify.ruby-lsp",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
