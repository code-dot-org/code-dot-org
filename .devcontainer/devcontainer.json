{
  "name": "code-dot-org",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/code-dot-org",
  "remoteUser": "cdo",

  // Runs once per container; a Codespaces prebuild caches the result.
  // apps/ is deliberately not built here — downloading the prebuilt
  // package beats building, and only a commit that changes apps/ and has
  // never been through CI needs a manual `yarn build`.
  "onCreateCommand": "cd /code-dot-org/apps && yarn install && cd /code-dot-org/frontend && yarn install && dev-bootstrap create",

  // Runs on every start, including a bare `docker compose start`. Fails
  // rather than handing over a half-migrated schema.
  "postStartCommand": "dev-bootstrap start",

  // Sized from measurements, not guesses. The apps webpack dev server
  // alone uses 6.5 to 14 GB; add Rails, MySQL, and a jest worker and a
  // full day crosses 16 GB. Storage: node_modules is 4.1 GB, the images
  // 7 GB, plus the prebuilt and locally built apps packages. CPUs: yarn
  // install parallelizes 90 s of CPU into 22 s of wall clock.
  "hostRequirements": {
    "cpus": 8,
    "memory": "32gb",
    "storage": "64gb"
  },

  "forwardPorts": [3000, 9000, 3036, 9001, 6006],
  "portsAttributes": {
    "3000": {"label": "Rails (dashboard)", "onAutoForward": "notify"},
    "9000": {"label": "apps dev server (webpack)", "onAutoForward": "silent"},
    "3036": {"label": "Vite (frontend/studio)", "onAutoForward": "silent"},
    "9001": {"label": "apps Storybook", "onAutoForward": "silent"},
    "6006": {"label": "Design-system Storybook", "onAutoForward": "silent"}
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      },
      "extensions": [
        "Shopify.ruby-lsp",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
