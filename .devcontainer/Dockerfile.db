# cdo-devdb: mysql:8.0 that carries a pre-seeded dashboard datadir. A
# devcontainer starts against a populated database. It does not run a
# two-hour dashboard:setup_db. .github/workflows/cdo-devdb-image.yml
# publishes the image. A codespace has no tar file, so it must pull one.
#
# The datadir sits at /opt/mysql-data, not at the default /var/lib/mysql.
# The official image declares VOLUME /var/lib/mysql, and docker copies the
# image's contents of a VOLUME path into a fresh anonymous volume every time a
# container starts: several gigabytes of copying before mysqld accepts its
# first connection. At a path with no VOLUME declaration the layer is read in
# place and the container's copy-on-write layer holds only what it writes.
#
# The database is therefore scratch space. `docker compose down` discards the
# layer, and the next container starts from the pre-seeded datadir again. To
# move that starting point, pre-seed again.
#
#   .devcontainer/preseed-db.sh
#   docker build -f .devcontainer/Dockerfile.db -t cdo-devdb:local .devcontainer

FROM mysql:8.0

# mysql:8.0 runs as uid:gid 999:999.
ADD --chown=999:999 mysql-data.tar /opt/mysql-data/

# The image's entrypoint reads the datadir out of the server arguments, finds
# it non-empty, and skips initialization entirely.
#
# --default-time-zone is SETUP.md's `SET PERSIST time_zone = '+00:00'`, which
# a container cannot inherit: SET PERSIST writes mysqld-auto.cnf into the
# datadir, this datadir has none, and a datadir is the wrong place for it
# anyway — `docker compose down` would take it with the rest of the writes.
# Stating it on the command line makes it a property of the image, true on
# every start, and independent of whatever the host's clock is set to. Left
# unset the server reports SYSTEM, which is UTC here only by accident of the
# container's environment.
CMD ["--datadir=/opt/mysql-data", "--default-time-zone=+00:00"]
