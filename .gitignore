# Documentation at https://git-scm.com/docs/gitignore.

#
# Misc Ignores
#

\#*#
*.pid
*.pid.oldbin
*_temp.json
*~
**/.vscode
.DS_Store
.dropbox
.tmputils
.tscache/
.idea/
jsconfig.json
npm-debug.log
/.dropbox.cache
/.gdrive_session
/build-started
/.turbo/
/coverage
/crontab
/globals.yml
/levelbuilder_ci_last_run
/locals.yml
/log
/rebuild
/rebuild-apps
/rebuild-shared
/rebuild-code-studio
/.cached-staging-build-file-count

#
# Ruby Ignores
#
**/.bundle
.irb_history
dashboard/brakeman_security_report.htm
.rakeTasks
/vendor/bundle
/dashboard/engines/cdo_contentful/Gemfile.lock
/dashboard/vendor/bundle
/cookbooks/vendor/bundle

#
# JS Ignores
#

/apps/.babel-cache
/apps/build
/apps/build-times.log
/apps/build-times-to-upload.log
/apps/coverage
/apps/log
/apps/node_modules/
/apps/npm-debug.log
/apps/src/generated/*
!/apps/src/generated/README.md
/apps/src/util/color.js
/apps/src/styleConstants.js
/apps/src/fontConstants.js
/apps/storybook-deploy
/apps/generated-scripts/
/apps/yarn-error.log

# Yarn ignores based on documentation at https://yarnpkg.com/getting-started/qa#which-files-should-be-gitignored
/apps/.pnp.*
/apps/.yarn/*
!/apps/.yarn/patches
!/apps/.yarn/plugins
!/apps/.yarn/releases
!/apps/.yarn/sdks
!/apps/.yarn/versions

#
# Other Subdirectory-Specific Ignores
#

/aws/.code-studio-built
/aws/.code-studio-commit-built
/aws/.shared-built
/aws/.shared-commit-built
/aws/offsite/lambda/*/node_modules/
/aws/offsite/lambda/*.zip
/bin/cron/.dts
/bin/cron/log
/bin/test/coverage
/dashboard/public/blockly
/dashboard/public/code-studio
/dashboard/public/shared
/dashboard/public/styleguide
/pegasus/.sass-cache
/pegasus/sites.v3/*/public/css/generated

# python venv:
.venv
.pdm-python

# skaffold, part of k8s stack, see skaffold.yaml
skaffold-build-tags.json
/cdo-local-secrets.env
/cdo-local-secrets.env.lock

# codex
.codex

# claude
.claude/worktrees
CLAUDE.local.md
.claude/**/*.local.*
.claude/skills/*.local

# agent skills standard: https://agentskills.io/
.agents/**/*.local.*
.agents/skills/*.local

# playwright-best-practices: managed by skills-lock.json, not vendored.
# Restore with `npx skills experimental_install` (see e2e-tests/README.md).
.agents/skills/playwright-best-practices/
