##
## Secrets and any other config specific to the web server on the chef-managed
## test system. This is the only test environment that will have access to
## secrets via AWS Secrets Manager.
##

<% if managed_test_server? -%>
github_webhook_secret: !Secret
slack_set_last_dtt_green_token: !Secret
slack_start_build_token: !Secret
azure_content_moderation_key: !Secret
saucelabs_authkey: !Secret
saucelabs_username: !Secret

<% else %>

##
## Disable secrets in all other environments, and replace them with stub values.
##

<%= clear_secrets %>

dashboard_honeybadger_api_key: '00000000'
pegasus_honeybadger_api_key:   '00000000'
google_safe_browsing_key: fake_api_key
pusher_app_id:             fake_app_id
pusher_application_key:    fake_application_key
pusher_application_secret: fake_application_secret
poste_secret: not a real secret
channels_api_secret: not a real secret
dashboard_devise_pepper: not a pepper!
dashboard_secret_key_base: not a secret
google_maps_api_key: boguskey

db_cluster_id: localhost
db_endpoint_writer: localhost
db_endpoint_writer_port: 3306
db_endpoint_proxy_writer: localhost
db_endpoint_proxy_writer_port: 3306
db_endpoint_proxy_reader: localhost
db_endpoint_proxy_reader_port: 3306
db_endpoint_proxy_reporting: localhost
db_endpoint_proxy_reporting_port: 3306

db_credential_admin: {"username":"root", "password":""}
db_credential_writer: {"username":"root", "password":""}
db_credential_reader: {"username":"root", "password":""}
db_writer: 'mysql://root@localhost/'

# Number of workers to start when running `rake build:start_active_job_workers`:
active_job_backend_n_workers_to_start: 2
active_job_backend_rolling_restart_in_n_batches: 1
<% end -%>

##
## Configuration common to all test environments
##

# Configurations for making calls to the Immersive Reader API on Azure
imm_reader_client_id:     '92ef2120-f523-41fe-a995-f9720bf70b81'

# speed up rake tasks that are not running unit tests or web application.
# This saves 30 seconds each time the rails environment is loaded.
lazy_load_i18n: <%= !(running_web_application? || unit_test) %>

netsim_enable_metrics: true
stub_school_data: true
daemon: true
use_pusher: <%= managed_test_server? %>

# Install i18n dependencies for i18n tests
build_i18n: true

# Since channel ids are derived from user id and other sequential integer ids
# use a new S3 sources directory for each Test Build to prevent a UI test
# from inadvertently using a channel id from a previous Test Build.
# CI environments already override the sources_s3_directory setting to suffix it with the CI_BUILD_NUMBER:
# https://github.com/code-dot-org/code-dot-org/blob/84094ab7e1217601bc484f768b778feedd2eb1ef/docker/ui_tests.sh/#L60-L61
# Detect CI environment just to be safe.
sources_s3_directory: sources_test<%=ENV['CI_JOB'] == 'ui_tests' ? '' : "/#{GitUtils.git_revision_short(root_dir)}"%>

# Disable this for test by default, it won't make much sense if we keep wiping
# the DB.
disable_s3_image_uploads: true

ai_proxy_origin:

openai_evaluate_rubric_api_key: 'stub-api-key'

# Statsig API keys
# The only type of test environment we enable Statsig is the managed test server
# (`test.code.org / test-studio.code.org`) and only in Ruby code executing within
# the web application server.
<% if managed_test_server? -%>
statsig_server_secret_key: !Secret
statsig_api_client_key: !Secret
statsig_api_client_key_session_replay: !Secret
<% else %>
statsig_server_secret_key: 'secret-fake-key'
statsig_api_client_key: 'client-fake-key'
<% end -%>

# Enables DCDO settings via cookies
use_cookie_dcdo: true

# Allows Geolocation to be altered via cookies.
use_geolocation_override: true

##
## CI-specific config settings
##

<% if ENV['CI'] -%>

# Config shared by ui and unit pipelines.

# customize build steps in CI
build_apps: true
use_my_apps: true
skip_seed_all: true

# Pass in secrets via env vars, since Drone cannot access secrets directly.
cloudfront_key_pair_id: <%= ENV['CLOUDFRONT_KEY_PAIR_ID'] %>
cloudfront_private_key: "<%= ENV['CLOUDFRONT_PRIVATE_KEY'] %>"
contentful_cs_for_all_access_token: <%= ENV['CONTENTFUL_CS_FOR_ALL_ACCESS_TOKEN'] %>
saucelabs_authkey: <%= ENV['SAUCE_AUTHKEY'] %>
saucelabs_username: <%= ENV['SAUCE_USERNAME'] %>
properties_encryption_key: <%= ENV['PROPERTIES_ENCRYPTION_KEY'] %>

# customize rails server to run on localhost
dashboard_enable_pegasus: true
override_dashboard: localhost-studio.code.org
override_pegasus: localhost.code.org
dashboard_port: 3000
pegasus_port: 3000
no_https_store: true

# custom redis config for CI
redis_url: 'redis://ci-tests-redis:6379/0'
netsim_redis_groups:
- master: redis://ci-tests-redis:6379

# CI-specific S3 settings, to avoid collisions between concurrent CI jobs
animations_s3_directory: <%= "animations_circle/#{ENV['CI_BUILD_NUMBER']}" %>
assets_s3_directory: <%= "assets_circle/#{ENV['CI_BUILD_NUMBER']}" %>
files_s3_directory: <%= "files_circle/#{ENV['CI_BUILD_NUMBER']}" %>
libraries_s3_directory: <%= "libraries_circle/#{ENV['CI_BUILD_NUMBER']}" %>
sources_s3_directory: <%= "sources_circle/#{ENV['CI_BUILD_NUMBER']}" %>

# custom tunnel name to avoid collisions between concurrent CI jobs
saucelabs_tunnel_name: cdo-tunnel-<%= ENV['CI_BUILD_NUMBER'] %>

# we run eyes features in CI, but skip comparing visual diffs
disable_all_eyes_running: true

# The number of puma workers in CI has been optimized to minimize ui test time
# for drone workers running on m7i.4xlarge instances.
dashboard_workers: 5

# CI Unit Test Optimizations
<% if ENV['CI_JOB'] == 'unit_tests' -%>
# Skip asset compilation for unit tests; we take more time doing the
# compilation than we gain from serving optimized assets. We preserve the
# default behavior for UI tests so we still have some consistency with prod.
optimize_rails_assets: false
optimize_webpack_assets: false

# We already use the ActiveJob TestAdapter class within unit tests. Specify that adapter here
# explicitly so that we also do not start any ActiveJob backend workers during rake tasks.
active_job_queue_adapter: :test
<% end -%>

# End CI-specific settings
<% end -%>
