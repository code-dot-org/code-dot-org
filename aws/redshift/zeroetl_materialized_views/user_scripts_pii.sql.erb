CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.user_scripts
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "user_id",
  "script_id",
  "started_at",
  "completed_at",
  "assigned_at",
  "last_progress_at",
  "created_at",
  "updated_at",
  "properties",
  "deleted_at",
  "unit_group_id"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.user_scripts;
