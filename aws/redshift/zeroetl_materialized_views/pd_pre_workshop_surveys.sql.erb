CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>.zeroetl_pd_pre_workshop_surveys
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "pd_enrollment_id",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.pd_pre_workshop_surveys;
