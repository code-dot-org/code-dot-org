CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>.zeroetl_pd_application_emails
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "pd_application_id",
  "created_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.pd_application_emails;
