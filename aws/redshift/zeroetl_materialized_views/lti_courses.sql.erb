CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>.lti_courses
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "lti_integration_id",
  "lti_deployment_id",
  "context_id",
  "course_id",
  "nrps_url",
  "resource_link_id",
  "created_at",
  "updated_at",
  "deleted_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.lti_courses;
