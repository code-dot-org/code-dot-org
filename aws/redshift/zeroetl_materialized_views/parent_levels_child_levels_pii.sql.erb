CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>_pii.zeroetl_parent_levels_child_levels
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "parent_level_id",
  "child_level_id",
  "position",
  "kind"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.parent_levels_child_levels;
