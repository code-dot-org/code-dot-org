CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>_pii.zeroetl_pd_application_emails
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "pd_application_id",
  "application_status",
  "email_type",
  "to",
  "created_at",
  "sent_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.pd_application_emails;
