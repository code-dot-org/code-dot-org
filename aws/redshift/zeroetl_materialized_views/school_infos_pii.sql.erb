CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.zeroetl_school_infos
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "country",
  "school_type",
  "zip",
  "state",
  "school_district_id",
  "school_district_other",
  "school_district_name",
  "school_id",
  "school_other",
  "school_name",
  "full_address",
  "created_at",
  "updated_at",
  "validation_type"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.school_infos;
