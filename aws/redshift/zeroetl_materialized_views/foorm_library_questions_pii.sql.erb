CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.foorm_library_questions
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "library_name",
  "library_version",
  "question_name",
  "question",
  "created_at",
  "updated_at",
  "published"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.foorm_library_questions;
