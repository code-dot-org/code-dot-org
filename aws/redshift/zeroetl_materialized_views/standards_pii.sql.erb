CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.standards
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "description",
  "category_id",
  "framework_id",
  "shortcode"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.standards;
