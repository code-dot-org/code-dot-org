CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.zeroetl_authentication_options
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "email",
  "hashed_email",
  "credential_type",
  "authentication_id",
  "deleted_at",
  "user_id",
  "created_at",
  "updated_at",
  "version"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.authentication_options;
