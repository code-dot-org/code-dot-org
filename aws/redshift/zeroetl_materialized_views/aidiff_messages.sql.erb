CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>.zeroetl_aidiff_messages
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "aidiff_thread_id",
  "role",
  "is_preset",
  "created_at",
  "updated_at",
  "is_artifact_candidate"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.aidiff_messages;
