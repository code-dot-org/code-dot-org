CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>.zeroetl_pd_workshops
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "organizer_id",
  "capacity",
  "section_id",
  "created_at",
  "updated_at",
  "deleted_at",
  "regional_partner_id",
  "on_map",
  "funded",
  "hidden"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.pd_workshops;
