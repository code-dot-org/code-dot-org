CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.zeroetl_user_data_retention_statuses
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "user_id",
  "pii_scrubbed_at",
  "anonymized_at",
  "created_at",
  "updated_at",
  "deletion_warning_email_sent_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.user_data_retention_statuses;
