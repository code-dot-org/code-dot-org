CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>.zeroetl_new_feature_feedbacks
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "user_id",
  "form_key",
  "satisfied",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.new_feature_feedbacks;
