CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>.zeroetl_pd_post_course_surveys
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "form_id",
  "submission_id",
  "user_id",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.pd_post_course_surveys;
