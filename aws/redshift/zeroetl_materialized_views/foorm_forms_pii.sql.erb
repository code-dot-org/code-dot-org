CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.foorm_forms
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "name",
  "version",
  "questions",
  "created_at",
  "updated_at",
  "published"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.foorm_forms;
