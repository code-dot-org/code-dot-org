CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>.zeroetl_rubric_ai_evaluations
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "user_id",
  "requester_id",
  "rubric_id",
  "project_id",
  "project_version",
  "status",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.rubric_ai_evaluations;
