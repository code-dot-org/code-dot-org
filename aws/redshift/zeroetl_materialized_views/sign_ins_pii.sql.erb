CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.sign_ins
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "user_id",
  "sign_in_at",
  "sign_in_count"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.sign_ins;
