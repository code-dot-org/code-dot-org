  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "level_id",
  "created_at",
  "updated_at",
  "sequencing",
  "debugging",
  "repeat_loops",
  "repeat_until_while",
  "for_loops",
  "events",
  "variables",
  "functions",
  "functions_with_params",
  "conditionals"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.level_concept_difficulties;
