CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>.zeroetl_pd_scholarship_infos
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "user_id",
  "pd_application_id",
  "pd_enrollment_id",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.pd_scholarship_infos;
