CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>_pii.zeroetl_foorm_submissions
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "form_name",
  "form_version",
  "answers",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.foorm_submissions;
