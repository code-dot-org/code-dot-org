CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>.zeroetl_cap_user_events
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "name",
  "user_id",
  "policy",
  "created_at",
  "updated_at",
  "state_before",
  "state_after"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.cap_user_events;
