CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>.learning_goal_ai_evaluations
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "rubric_ai_evaluation_id",
  "learning_goal_id",
  "understanding",
  "ai_confidence",
  "created_at",
  "updated_at",
  "ai_confidence_exact_match"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.learning_goal_ai_evaluations;
