CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.user_geos
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "user_id",
  "created_at",
  "updated_at",
  "indexed_at",
  "ip_address",
  "city",
  "state",
  "country",
  "postal_code",
  "latitude",
  "longitude"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.user_geos;
