CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>.zeroetl_users
  BACKUP NO
  DISTSTYLE KEY DISTKEY (id)
  AUTO REFRESH NO
AS SELECT
  id,
  studio_person_id,
  sign_in_count,
  created_at,
  updated_at,
  admin,
  school_info_id,
  total_lines,
  secret_picture_id,
  active,
  deleted_at,
  invitation_limit,
  invited_by_id,
  invitations_count,
  terms_of_service_version,
  urm,
  primary_contact_info_id
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.users;
