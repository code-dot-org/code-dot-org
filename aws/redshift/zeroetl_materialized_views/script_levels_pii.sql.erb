CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.script_levels
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "script_id",
  "chapter",
  "created_at",
  "updated_at",
  "stage_id",
  "position",
  "assessment",
  "properties",
  "named_level",
  "bonus",
  "activity_section_id",
  "seed_key",
  "activity_section_position"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.script_levels;
