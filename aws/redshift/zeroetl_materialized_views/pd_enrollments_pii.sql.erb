CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.zeroetl_pd_enrollments
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "pd_workshop_id",
  "name",
  "first_name",
  "last_name",
  "email",
  "created_at",
  "updated_at",
  "school",
  "code",
  "user_id",
  "survey_sent_at",
  "completed_survey_id",
  "school_info_id",
  "deleted_at",
  "properties",
  "application_id"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.pd_enrollments;
