CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>.section_hidden_stages
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "section_id",
  "stage_id"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.section_hidden_stages;
