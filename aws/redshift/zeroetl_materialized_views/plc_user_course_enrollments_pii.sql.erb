CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.plc_user_course_enrollments
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "status",
  "plc_course_id",
  "user_id",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.plc_user_course_enrollments;
