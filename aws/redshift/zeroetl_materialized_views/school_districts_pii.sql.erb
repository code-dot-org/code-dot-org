CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>_pii.zeroetl_school_districts
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "name",
  "city",
  "state",
  "zip",
  "last_known_school_year_open",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.school_districts;
