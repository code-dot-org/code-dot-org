CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>.zeroetl_regional_partners
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "group",
  "urban",
  "created_at",
  "updated_at",
  "deleted_at",
  "is_active"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.regional_partners;
