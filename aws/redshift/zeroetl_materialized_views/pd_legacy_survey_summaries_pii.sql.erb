CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.zeroetl_pd_legacy_survey_summaries
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "facilitator_id",
  "course",
  "subject",
  "data",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.pd_legacy_survey_summaries;
