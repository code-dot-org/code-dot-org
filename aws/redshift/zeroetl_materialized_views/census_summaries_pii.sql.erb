CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>_pii.zeroetl_census_summaries
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "school_id",
  "school_year",
  "teaches_cs",
  "audit_data",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.census_summaries;
