CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>.zeroetl_levels
  BACKUP NO
  DISTSTYLE KEY DISTKEY (id)
  AUTO REFRESH NO
AS SELECT
  id,
  game_id,
  created_at,
  updated_at,
  ideal_level_source_id,
  user_id,
  published
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.levels;
