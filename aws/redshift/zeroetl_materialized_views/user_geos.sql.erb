CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>.zeroetl_user_geos
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "user_id",
  "created_at",
  "updated_at",
  "indexed_at",
  "city",
  "state",
  "country",
  "postal_code"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.user_geos;
