CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.zeroetl_learning_goal_teacher_evaluations
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "user_id",
  "teacher_id",
  "learning_goal_id",
  "project_id",
  "project_version",
  "understanding",
  "feedback",
  "submitted_at",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.learning_goal_teacher_evaluations;
