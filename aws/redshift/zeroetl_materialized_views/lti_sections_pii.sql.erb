CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.zeroetl_lti_sections
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "lti_course_id",
  "section_id",
  "lms_section_id",
  "created_at",
  "updated_at",
  "deleted_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.lti_sections;
