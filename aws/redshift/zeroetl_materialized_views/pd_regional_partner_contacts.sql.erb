CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>.zeroetl_pd_regional_partner_contacts
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "user_id",
  "regional_partner_id",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.pd_regional_partner_contacts;
