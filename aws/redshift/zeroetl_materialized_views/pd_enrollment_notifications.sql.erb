CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>.zeroetl_pd_enrollment_notifications
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "created_at",
  "updated_at",
  "pd_enrollment_id"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.pd_enrollment_notifications;
