CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>.zeroetl_teaching_profile_data
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "user_id",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.teaching_profile_data;
