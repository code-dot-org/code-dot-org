CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>.zeroetl_skills
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "description",
  "evaluation_criteria",
  "concept",
  "created_at",
  "updated_at",
  "key"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.skills;
