CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>.zeroetl_followers
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "student_user_id",
  "created_at",
  "updated_at",
  "section_id",
  "deleted_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.followers;
