CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.paired_user_levels
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "driver_user_level_id",
  "navigator_user_level_id",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.paired_user_levels;
