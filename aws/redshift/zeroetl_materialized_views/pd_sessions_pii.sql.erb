CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.pd_sessions
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "pd_workshop_id",
  "start",
  "end",
  "created_at",
  "updated_at",
  "deleted_at",
  "code",
  "session_format",
  "time_zone",
  "meeting_link",
  "location_name",
  "location_address"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.pd_sessions;
