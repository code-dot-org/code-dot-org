CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>.zeroetl_user_school_infos
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "user_id",
  "school_info_id",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.user_school_infos;
