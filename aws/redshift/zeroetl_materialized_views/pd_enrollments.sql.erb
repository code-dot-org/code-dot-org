CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>.zeroetl_pd_enrollments
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "pd_workshop_id",
  "created_at",
  "updated_at",
  "user_id",
  "completed_survey_id",
  "school_info_id",
  "deleted_at",
  "application_id"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.pd_enrollments;
