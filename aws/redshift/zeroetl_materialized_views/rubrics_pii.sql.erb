CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.rubrics
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "lesson_id",
  "level_id",
  "created_at",
  "updated_at",
  "s3_config_dir"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.rubrics;
