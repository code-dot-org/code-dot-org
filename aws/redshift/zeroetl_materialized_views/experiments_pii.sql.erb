CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.experiments
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "created_at",
  "updated_at",
  "name",
  "type",
  "start_at",
  "end_at",
  "section_id",
  "min_user_id",
  "max_user_id",
  "overflow_max_user_id",
  "earliest_section_at",
  "latest_section_at",
  "script_id"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.experiments;
