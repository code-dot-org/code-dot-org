CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>.zeroetl_student_work_evaluations
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "student_id",
  "requester_id",
  "level_id",
  "unit_id",
  "skill_id",
  "section_id",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.student_work_evaluations;
