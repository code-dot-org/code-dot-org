CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.zeroetl_puzzle_ratings
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "user_id",
  "script_id",
  "level_id",
  "rating",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.puzzle_ratings;
