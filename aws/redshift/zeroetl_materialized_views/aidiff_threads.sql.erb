CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>.aidiff_threads
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "user_id",
  "unit_id",
  "lesson_id",
  "created_at",
  "updated_at",
  "course_id",
  "level_id"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.aidiff_threads;
