CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>_pii.zeroetl_aidiff_message_feedbacks
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "aidiff_message_id",
  "teacher_id",
  "approval",
  "flagged",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.aidiff_message_feedbacks;
