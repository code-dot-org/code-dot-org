CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>_pii.zeroetl_channel_tokens
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "storage_app_id",
  "level_id",
  "created_at",
  "updated_at",
  "storage_id",
  "script_id",
  "deleted_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.channel_tokens;
