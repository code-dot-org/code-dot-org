CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.learning_goal_ai_evaluation_feedbacks
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "learning_goal_ai_evaluation_id",
  "teacher_id",
  "ai_feedback_approval",
  "false_positive",
  "false_negative",
  "vague",
  "feedback_other",
  "other_content",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.learning_goal_ai_evaluation_feedbacks;
