CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.zeroetl_sections
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "user_id",
  "name",
  "created_at",
  "updated_at",
  "code",
  "script_id",
  "course_id",
  "grade",
  "login_type",
  "deleted_at",
  "stage_extras",
  "section_type",
  "first_activity_at",
  "pairing_allowed",
  "sharing_disabled",
  "hidden",
  "tts_autoplay_enabled",
  "restrict_section",
  "properties",
  "participant_type",
  "lti_integration_id",
  "avatar_color",
  "avatar_emoji",
  "ai_chat_access_level",
  "demo_type"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.sections;
