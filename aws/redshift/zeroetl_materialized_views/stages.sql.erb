CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>.stages
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "name",
  "absolute_position",
  "script_id",
  "created_at",
  "updated_at",
  "lockable",
  "relative_position",
  "properties",
  "lesson_group_id",
  "key",
  "has_lesson_plan"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.stages;
