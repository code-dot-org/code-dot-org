CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.course_scripts
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "course_id",
  "script_id",
  "position",
  "unit_prefix"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.course_scripts;
