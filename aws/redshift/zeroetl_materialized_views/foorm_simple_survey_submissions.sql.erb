CREATE MATERIALIZED VIEW dashboard_<%=environment_type%>.zeroetl_foorm_simple_survey_submissions
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "foorm_submission_id",
  "user_id",
  "simple_survey_form_id",
  "created_at",
  "updated_at"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.foorm_simple_survey_submissions;
