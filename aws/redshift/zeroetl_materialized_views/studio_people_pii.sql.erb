CREATE MATERIALIZED VIEW learning_platform_<%=environment_type%>_pii.zeroetl_studio_people
  BACKUP NO
  DISTSTYLE KEY DISTKEY ("id")
  AUTO REFRESH NO
AS SELECT
  "id",
  "created_at",
  "updated_at",
  "emails"
FROM <%=environment_type%>_learningplatform_mysql_zeroetl.dashboard_<%=environment_type%>.studio_people;
