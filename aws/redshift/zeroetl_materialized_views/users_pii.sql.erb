  uid,
  admin,
  gender,
  name,
  locale,
  birthday,
  user_type,
  school,
  full_address,
  school_info_id,
  total_lines,
  secret_picture_id,
  active,
  hashed_email,
  deleted_at,
  purged_at,
  secret_words,
  properties,
  invitation_token,
  invitation_created_at,
  invitation_sent_at,
  invitation_accepted_at,
