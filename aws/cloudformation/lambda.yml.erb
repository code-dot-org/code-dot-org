\",s();else{var t=a.Snapshots[0].SnapshotId;console.log(\"DELETING SNAPSHOT:\",t),ec2.deleteSnapshot({SnapshotId:t},function(e,a){e?n(e,\"DeleteSnapshot call failed\"):s()})}}))})}else n(null,\"DescribeImages returned multiple Images, expected one\")})}else\"Create\"==e.RequestType?i?ec2.waitFor(\"instanceStopped\",{InstanceIds:[i]},function(a,d){if(a)return void n(a,\"waitFor instanceStopped failed\");var I={InstanceId:i,Name:o+\"-\"+i+\"-\"+e.RequestId};ec2.createImage(I,function(a,i){if(a)l&&\"InvalidAMIName.Duplicate\"==a.code?(c=a.message.match(\"already in use by AMI (.*)\")[1],r.ImageId=c,t({state:\"imageAvailable\",params:{ImageIds:[c]}})):n(a,\"CreateImage call failed\");else{var d=i.ImageId;c=d,console.log(\"SUCCESS: \",\"ImageId - \"+d);var I={Resources:[d],Tags:[{Key:\"cloudformation:amimanager:stack-name\",Value:o},{Key:\"cloudformation:amimanager:stack-id\",Value:e.StackId},{Key:\"cloudformation:amimanager:logical-id\",Value:e.LogicalResourceId}]};ec2.createTags(I,function(e,a){e?n(e,\"Create tags call failed\"):(r.ImageId=d,l?t({state:\"imageAvailable\",params:{ImageIds:[c]}}):s())})}})}):n(null,\"InstanceId not specified\"):\"Update\"==e.RequestType?c?(r.ImageId=c,s()):n(null,\"In-place updates not supported\"):n(null,\"Invalid RequestType: \"+e.RequestType)};\n"
      Handler: index.handler
      Runtime: nodejs6.10
      Timeout: 300
      Role: !GetAtt AMIManagerRole.Arn
  AMIManagerRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Statement:
          - Action: ['sts:AssumeRole']
            Effect: Allow
            Principal: {Service: [lambda.amazonaws.com]}
      Path: '/'
      Policies:
        - PolicyName: root
          PolicyDocument:
            Statement:
              - Effect: Allow
                Action: ["logs:CreateLogGroup","logs:CreateLogStream","logs:PutLogEvents"]
                Resource: "arn:aws:logs:*:*:*"
              - Effect: Allow
                Action:
                  - "ec2:CreateImage"
                  - "ec2:DeregisterImage"
                  - "ec2:DescribeImages"
                  - "ec2:CreateTags"
                  - "ec2:DescribeSnapshots"
                  - "ec2:DeleteSnapshot"
                  - "ec2:DescribeInstances"
                Resource: "*"
              # allow recursive calls
              - Effect: Allow
                Action: ['lambda:InvokeFunction']
                Resource: '*'
  CountASG:
    Type: AWS::Lambda::Function
    Properties:
      Description: 'Returns the current number of InService instances in an Auto Scaling Group.'
      FunctionName: CountASG
      Code:
        # TODO: Revert to using separate code files once we update the runtime (INF-1734)
        # ZipFile: <%=inline_js 'count_asg.js' %>
        ZipFile: "var response=require(\"cfn-response\"),AWS=require(\"aws-sdk\"),autoscaling=new AWS.AutoScaling;exports.handler=function(e,r){if(console.log(\"REQUEST RECEIVED:\\\\n\",JSON.stringify(e)),\"Delete\"==e.RequestType)return void response.send(e,r,response.SUCCESS);var n=e.ResourceProperties.AutoScalingGroupTags||errorExit(\"No AutoScalingGroupTags found\",e,r),o=e.ResourceProperties.Default||{MinSize:1,MaxSize:10,DesiredCapacity:1},s={},i=function(e,r){var n=!0;return Object.keys(e).forEach(function(o){e[o]!=r[o]&&(n=!1)}),n},a=function(e){var r={};return e.forEach(function(e){r[e.Key]=e.Value}),r};\"Create\"==e.RequestType||\"Update\"==e.RequestType?function(e,r){var n=o;autoscaling.describeAutoScalingGroups({},function(o,s){o?r(o,s):(s.AutoScalingGroups.forEach(function(r){i(e,a(r.Tags))&&(n={MinSize:r.MinSize,MaxSize:r.MaxSize,DesiredCapacity:r.DesiredCapacity})}),r(null,n))})}(a(n),function(n,i){n&&(s.Error=\"No AutoScalingGroup found\",s.OriginalError=n,i=o),s.MinSize=i.MinSize,s.MaxSize=i.MaxSize,s.DesiredCapacity=i.DesiredCapacity,response.send(e,r,response.SUCCESS,s)}):response.send(e,r,response.SUCCESS,s)};var errorExit=function(e,r,n){responseData={Error:e},console.log(responseData.Error),response.send(r,n,response.FAILED,responseData)};\n"
      Handler: index.handler
      Runtime: nodejs6.10
      Timeout: 30
      Role: !GetAtt CountASGRole.Arn
  CountASGRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Statement:
          - Action: ['sts:AssumeRole']
            Effect: Allow
            Principal: {Service: [lambda.amazonaws.com]}
      Path: '/'
      Policies:
        - PolicyName: root
          PolicyDocument:
            Statement:
              - Effect: Allow
                Action: ["logs:CreateLogGroup","logs:CreateLogStream","logs:PutLogEvents"]
                Resource: "arn:aws:logs:*:*:*"
              - Effect: Allow
                Action: ["autoscaling:DescribeAutoScalingGroups"]
                Resource: "*"
  SlackEvent:
    Type: AWS::Lambda::Function
    Properties:
      Description: 'Publish a CloudWatch Event to a Slack channel.'
      FunctionName: SlackEvent
      # TODO: Revert to using separate code files once we update the runtime (INF-1734)
      # Code: <%=js_zip ['slackCloudWatchEvent.js']%>
      Code: {"S3Bucket":"cdo-dist","S3Key":"lambdajs-abe6be59bf57852719a34ae5249421dd.zip"}
      Environment:
        Variables:
          SLACK_ENDPOINT: '{{resolve:secretsmanager:production/cdo/slack_endpoint}}'
      Handler: slackCloudWatchEvent.handler
      Runtime: nodejs10.x
      Timeout: 30
      Role: !GetAtt BasicLambdaRole.Arn
  BasicLambdaRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Statement:
          - Action: ['sts:AssumeRole']
            Effect: Allow
            Principal: {Service: [lambda.amazonaws.com]}
      Path: /
      ManagedPolicyArns:
      - "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
  S3Object:
    Type: AWS::Lambda::Function
    Properties:
      Description: S3 Object Custom Resource
      FunctionName: S3Object
      Role: !GetAtt S3ObjectRole.Arn
      Code:
        # TODO: Revert to using separate code files once we update the runtime (INF-1734)
        # ZipFile: <%=inline_js 's3Object.js' %>
        ZipFile: "const response=require(\"cfn-response\"),AWS=require(\"aws-sdk\"),s3=new AWS.S3;exports.handler=function(e,s){console.log(\"Request received:\\n\",JSON.stringify(e));let t=`${e.ResourceProperties.Bucket}/${e.ResourceProperties.Key}`;const r=r=>response.send(e,s,r?response.FAILED:response.SUCCESS,r||{},t),o=e.ResourceProperties;if(delete o.ServiceToken,\"Create\"===e.RequestType||\"Update\"===e.RequestType)s3.putObject(o).promise().then(e=>r()).catch(e=>r(e));else if(\"Delete\"===e.RequestType){const s={Bucket:e.ResourceProperties.Bucket,Key:e.ResourceProperties.Key};s3.deleteObject(s).promise().then(e=>r()).catch(e=>r(e))}else r({Error:\"Invalid request type\"})};\n"
      Handler: index.handler
      Timeout: 30
      Runtime: nodejs6.10
  S3ObjectRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
        - Effect: Allow
          Principal: {Service: [lambda.amazonaws.com]}
          Action: ['sts:AssumeRole']
      Path: /
      ManagedPolicyArns:
      - "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
      Policies:
      - PolicyName: S3Policy
        PolicyDocument:
          Version: '2012-10-17'
          Statement:
            - Effect: Allow
              Action:
                - 's3:PutObject'
                - 's3:PutObjectAcl'
                - 'S3:DeleteObject'
              Resource: !Sub "arn:aws:s3:::*"
  S3PartitionCloudFrontLog:
    Type: AWS::Lambda::Function
    Properties:
      Description: 'Partition CloudFront Access Log stored on S3.'
      FunctionName: S3PartitionCloudFrontLog
      Environment:
        Variables:
          ATHENA_DB: elb_logs
          ATHENA_TABLE: cloudfront_logs
      Code:
        # TODO: Revert to using separate code files once we update the runtime (INF-1734)
        # ZipFile: <%=inline_js 's3PartitionCloudFrontLog.js'%>
        ZipFile: "const AWS=require(\"aws-sdk\"),s3=new AWS.S3,glue=new AWS.Glue,inputFormat=\"org.apache.hadoop.mapred.TextInputFormat\",outputFormat=\"org.apache.hadoop.hive.ql.io.HiveIgnoreKeyTextOutputFormat\",serdeInfo={Name:\"LazySimpleSerde\",SerializationLibrary:\"org.apache.hadoop.hive.serde2.lazy.LazySimpleSerDe\",Parameters:{\"field.delim\":\"\\t\",\"serialization.format\":\"\\t\"}},createdPartitions={};exports.handler=((e,t,o)=>{function n(t){return e.Records?null:{invocationSchemaVersion:e.invocationSchemaVersion,treatMissingKeysAs:\"PermanentFailure\",invocationId:e.invocationId,results:[{taskId:e.tasks[0].taskId,resultCode:t?\"TemporaryFailure\":\"Succeeded\",resultString:t?t.toString():\"OK\"}]}}console.log(\"Request received:\\n\",JSON.stringify(e));process.on(\"uncaughtException\",e=>o(e));let i,r;e.Records?(i=e.Records[0].s3.bucket.name,r=e.Records[0].s3.object.key):(i=e.tasks[0].s3BucketArn.split(\":\").pop(),r=e.tasks[0].s3Key);const a=r.split(\"/\").map(e=>e.replace(/-tmp$/,\"\"));const c=a.pop();const s=[\"year\",\"month\",\"day\",\"hour\"];const u=c.split(\".\")[1].split(\"-\");const p=u.map((e,t)=>`${s[t]}=${e}`).join(\"/\");const l=[\"cloudfront\",a.join(\"/\"),p].filter(e=>e).join(\"/\");const d=[l,c].join(\"/\");const m=`s3://${i}/${l}`;s3.copyObject({CopySource:[i,r].join(\"/\"),Bucket:i,Key:d}).promise().catch(e=>{if(\"NoSuchKey\"!==e.code)throw e}).then(e=>s3.deleteObject({Bucket:i,Key:r}).promise()).catch(e=>{if(\"NoSuchKey\"!==e.code)throw e}).then(t=>{if(e.tasks||createdPartitions[u.join()])return;return glue.getPartition({DatabaseName:process.env.ATHENA_DB,TableName:process.env.ATHENA_TABLE,PartitionValues:u}).promise().catch(e=>{if(\"EntityNotFoundException\"===e.code)return glue.createPartition({DatabaseName:process.env.ATHENA_DB,TableName:process.env.ATHENA_TABLE,PartitionInput:{Values:u,StorageDescriptor:{Location:m,InputFormat:inputFormat,OutputFormat:outputFormat,SerdeInfo:serdeInfo}}}).promise().catch(e=>{if(\"AlreadyExistsException\"!==e.code)throw e});throw e}).then(e=>createdPartitions[u.join()]=!0)}).then(e=>o(null,n(null))).catch(e=>o(e,n(e)))});\n"
      Handler: index.handler
      Runtime: nodejs12.x
      Timeout: 30
      Role: !GetAtt S3LogsRole.Arn
  S3LogsRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
        - Effect: Allow
          Principal: {Service: [lambda.amazonaws.com]}
          Action: ['sts:AssumeRole']
      Path: /
      ManagedPolicyArns:
      - "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
      Policies:
      - PolicyName: cdo-logs-policy
        PolicyDocument:
          Version: '2012-10-17'
          Statement:
          - Effect: Allow
            Action:
            - 's3:GetObject'
            - 's3:PutObject'
            - 's3:PutObjectAcl'
            - 's3:DeleteObject'
            Resource: "arn:aws:s3:::cdo-logs/*"
          - Effect: Allow
            Action:
            - "glue:CreatePartition"
            - "glue:GetPartition"
            Resource: '*'
  S3BucketConfiguration:
    Type: AWS::Lambda::Function
    Properties:
      Description: Sets a NotificationConfiguration for an external S3 bucket.
      FunctionName: S3BucketConfiguration
      Handler: index.handler
      Role: !GetAtt S3LogsRole.Arn
      Code:
        ZipFile: |
          var response = require('cfn-response');
          var AWS = require('aws-sdk');
          var s3 = new AWS.S3();
          exports.handler = function(event, context) {
            var respond = (e) => response.send(event, context, e ? response.FAILED : response.SUCCESS, e ? e : {});
            process.on('uncaughtException', e=>respond(e));
            var params = event.ResourceProperties;
            delete params.ServiceToken;
            if (event.RequestType === 'Delete') {
              params.NotificationConfiguration = {};
            }
            s3.putBucketNotificationConfiguration(params).promise()
              .then((data)=>respond())
              .catch((e)=>respond());
          };
      Timeout: 30
      Runtime: nodejs6.10
  FastSnapshotRestore:
    Type: AWS::Lambda::Function
    Properties:
      Description: 'Enables EBS Fast Snapshot Restore for the given AMI snapshot.'
      FunctionName: FastSnapshotRestore
      # TODO: Revert to using separate code files once we update the runtime (INF-1734)
      # Code: <%=lambda_zip 'fast_snapshot_restore.rb', 'cfn_response.rb' %>
      Code: {"S3Bucket":"cdo-dist","S3Key":"lambda-5547d856adfa090b88c62e1ecf1c457c.zip"}
      Handler: fast_snapshot_restore.handler
      Runtime: ruby2.7
      MemorySize: 1024
      Timeout: 30
      Role: !GetAtt FastSnapshotRestoreRole.Arn
  FastSnapshotRestoreRole:
    Type: AWS::IAM::Role
    Properties:
      <%=service_role 'lambda'%>
      Path: /
      ManagedPolicyArns: ['arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole']
      Policies:
      - PolicyName: root
        PolicyDocument:
          Statement:
          - Effect: Allow
            Action:
            - "ec2:EnableFastSnapshotRestores"
            - "ec2:DisableFastSnapshotRestores"
            - "ec2:DescribeImages"
            Resource: '*'
      PermissionsBoundary: !ImportValue IAM-DevPermissions

  SQLUserLambda:
    Type: AWS::Lambda::Function
    Properties:
      Description: 'Custom CloudFormation Resource: Create/Update/Delete a SQL User and its permissions in a MySQL database.'
      FunctionName: SQLUser
      # TODO: Revert to using separate code files once we update the runtime (INF-1734)
      # Code: <%=package_node_lambda('sql-user')[:code_props].to_json %>
      Code: {"S3Bucket":"cdo-dist","S3Key":"lambda-c8777a1960dc3a178f30d5be9f48693d.zip"}
      Handler: index.handler
      Runtime: nodejs18.x
      MemorySize: 1024
      Timeout: 30
      Role: !GetAtt SQLUserLambdaRole.Arn
      VpcConfig:
        SecurityGroupIds: [!ImportValue VPC-FrontendSecurityGroup]
        SubnetIds: <%=subnets.to_json%>
  SQLUserLambdaRole:
    Type: AWS::IAM::Role
    Properties:
      <%=service_role 'lambda'%>
      Path: /
      ManagedPolicyArns:
        - 'arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole'
        - 'arn:aws:iam::aws:policy/service-role/AWSLambdaVPCAccessExecutionRole'
      Policies:
        - PolicyName: GetDBCredentials
          PolicyDocument:
            Statement:
              # Grant this Lambda permission to every Stack's database credential Secrets.
              -
                Effect: Allow
                Action: 'secretsmanager:GetSecretValue'
                Resource: !Sub "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:CfnStack/*/db_credential_admin-??????"
              -
                Effect: Allow
                Action: 'secretsmanager:GetSecretValue'
                Resource: !Sub "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:CfnStack/*/db_credential_writer-??????"
              -
                Effect: Allow
                Action: 'secretsmanager:GetSecretValue'
                Resource: !Sub "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:CfnStack/*/db_credential_reader-??????"
              # Grant SQLUSer Lambda permission to get the database writer endpoint configuration setting that's stored in a Secret.
              -
                Effect: Allow
                Action: 'secretsmanager:GetSecretValue'
                Resource: !Sub "arn:aws:secretsmanager:${AWS::Region}:${AWS::AccountId}:secret:CfnStack/*/db_endpoint_writer-??????"
      PermissionsBoundary: !ImportValue IAM-DevPermissions

  LambdaSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Security group for VPC-internal Lambda functions.
      VpcId: !ImportValue VPC
  AcceptLanguageFunction:
    Type: AWS::CloudFront::Function
    Properties:
      Name: AcceptLanguage
      # TODO: Revert to using separate code files once we update the runtime (INF-1734)
      # FunctionCode: <%=js_erb 'accept-language.js.erb', max: FUNCTION_MAX %>
      FunctionCode: "function handler(e){var a=e.request.headers,s=e.request.cookies.language_,r=a[\"accept-language\"]?a[\"accept-language\"].value:\"\";return a[\"accept-language\"]={value:s&&s.value||lookup(r,tags,defaultTag)},e.request}function lookup(e,a,s){e=e.toLowerCase();for(var r,n=/(?<range>([a-z]{1,8})(-([a-z0-9]{1,8}))*|\\*)(\\s*;\\s*q=(?<qvalue>0(\\.[0-9]{0,3})?|1(\\.0{0,3})?))?(\\s*,\\s*)?/g,u=s,l=0;null!==(r=n.exec(e));){var t=r.groups.qvalue?parseFloat(r.groups.qvalue):1;if(t>l)for(var i=r.groups.range,k=null;i!==k;){if(a.includes(i)){l=t,u=i;break}i=(k=i).replace(/-([a-z0-9]{1,8})$/,\"\")}}return u}var tags=[\"ar-sa\",\"ar\",\"az-az\",\"az\",\"bg-bg\",\"bg\",\"bn-bd\",\"bn\",\"bs-ba\",\"bs\",\"ca-es\",\"ca\",\"co-co\",\"co\",\"cs-cz\",\"cs\",\"da-dk\",\"da\",\"de-de\",\"de\",\"dv-mv\",\"dv\",\"el-gr\",\"el\",\"en-gb\",\"en-us\",\"en\",\"es-es\",\"es\",\"es-mx\",\"et-ee\",\"et\",\"eu-es\",\"eu\",\"fa-af\",\"fa-ir\",\"fi-fi\",\"fi\",\"fil-ph\",\"fil\",\"fr-fr\",\"fr\",\"ga-ie\",\"ga\",\"gl-es\",\"gl\",\"haw-hi\",\"haw\",\"he-il\",\"he\",\"hi-in\",\"hi\",\"hr-hr\",\"hr\",\"hu-hu\",\"hu\",\"hy-am\",\"hy\",\"id-id\",\"id\",\"in-tl\",\"in\",\"is-is\",\"is\",\"it-it\",\"it\",\"ja-jp\",\"ja\",\"ka-ge\",\"ka\",\"kk-kz\",\"kk\",\"kn-in\",\"kn\",\"km-kh\",\"km\",\"ko-kr\",\"ko\",\"ku-iq\",\"ku\",\"ky-kg\",\"ky\",\"lt-lt\",\"lt\",\"lv-lv\",\"lv\",\"mi-nz\",\"mi\",\"mk-mk\",\"mk\",\"mn-mn\",\"mn\",\"mr-in\",\"mr\",\"ms-my\",\"ms\",\"mt-mt\",\"mt\",\"my-mm\",\"my\",\"ne-np\",\"ne\",\"nl-nl\",\"nl\",\"nn-no\",\"nn\",\"no-no\",\"no\",\"pl-pl\",\"pl\",\"ps-af\",\"ps\",\"pt-br\",\"pt-pt\",\"ro-ro\",\"ro\",\"ru-ru\",\"ru\",\"se-fi\",\"se\",\"sm-ws\",\"sm\",\"si-lk\",\"si\",\"sk-sk\",\"sk\",\"sl-si\",\"sl\",\"sq-al\",\"sq\",\"sr-sp\",\"sr\",\"sv-se\",\"sv\",\"ta-in\",\"ta\",\"te-in\",\"te\",\"tg-tj\",\"tg\",\"th-th\",\"th\",\"tr-tr\",\"tr\",\"uk-ua\",\"uk\",\"ur-pk\",\"ur\",\"uz-uz\",\"uz\",\"vi-vn\",\"vi\",\"zh-cn\",\"zh-tw\",\"zu-za\",\"zu\"],defaultTag=\"en\";\n"
      FunctionConfig:
        Comment: "Normalizes Accept-Language header from viewer requests"
        Runtime: cloudfront-js-1.0
Outputs:
  AMIManager:
    Value: !GetAtt AMIManager.Arn
    Description: ServiceToken for AMIManager Lambda function
    Export: {Name: AMIManager}
  SlackEvent:
    Value: !GetAtt SlackEvent.Arn
    Export: {Name: SlackEvent}
  S3Object:
    Value: !GetAtt S3Object.Arn
    Export: {Name: S3Object}
  S3LogsRole:
    Value: !GetAtt S3LogsRole.Arn
    Export: {Name: S3LogsRole}
