      Handler: index.handler
      Runtime: nodejs6.10
      Timeout: 300
      Role: !GetAtt AMIManagerRole.Arn
  AMIManagerRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Statement:
          - Action: ['sts:AssumeRole']
            Effect: Allow
            Principal: {Service: [lambda.amazonaws.com]}
      Path: '/'
      Policies:
        - PolicyName: root
          PolicyDocument:
            Statement:
              - Effect: Allow
                Action: ["logs:CreateLogGroup","logs:CreateLogStream","logs:PutLogEvents"]
                Resource: "arn:aws:logs:*:*:*"
              - Effect: Allow
                Action:
                  - "ec2:CreateImage"
                  - "ec2:DeregisterImage"
                  - "ec2:DescribeImages"
                  - "ec2:CreateTags"
                  - "ec2:DescribeSnapshots"
                  - "ec2:DeleteSnapshot"
                  - "ec2:DescribeInstances"
                Resource: "*"
              # allow recursive calls
              - Effect: Allow
                Action: ['lambda:InvokeFunction']
                Resource: '*'
  CountASG:
    Type: AWS::Lambda::Function
    Properties:
      Description: 'Returns the current number of InService instances in an Auto Scaling Group.'
      FunctionName: CountASG
      Code:
        ZipFile: "var response=require(\"cfn-response\"),AWS=require(\"aws-sdk\"),autoscaling=new AWS.AutoScaling,errorExit=(exports.handler=function(n,o){var e,s,i,a,t,u,c;console.log(\"REQUEST RECEIVED:\\\\n\",JSON.stringify(n)),\"Delete\"==n.RequestType?response.send(n,o,response.SUCCESS):(e=n.ResourceProperties.AutoScalingGroupTags||errorExit(\"No AutoScalingGroupTags found\",n,o),s=n.ResourceProperties.Default||{MinSize:1,MaxSize:10,DesiredCapacity:1},i={},a=function(e){var r={};return e.forEach(function(e){r[e.Key]=e.Value}),r},\"Create\"==n.RequestType||\"Update\"==n.RequestType?(t=a(e),u=function(e,r){e&&(i.Error=\"No AutoScalingGroup found\",i.OriginalError=e,r=s),i.MinSize=r.MinSize,i.MaxSize=r.MaxSize,i.DesiredCapacity=r.DesiredCapacity,response.send(n,o,response.SUCCESS,i)},c=s,autoscaling.describeAutoScalingGroups({},function(e,r){e?u(e,r):(r.AutoScalingGroups.forEach(function(e){var r,n,o;r=t,n=a(e.Tags),o=!0,Object.keys(r).forEach(function(e){r[e]!=n[e]&&(o=!1)}),o&&(c={MinSize:e.MinSize,MaxSize:e.MaxSize,DesiredCapacity:e.DesiredCapacity})}),u(null,c))})):response.send(n,o,response.SUCCESS,i))},function(e,r,n){responseData={Error:e},console.log(responseData.Error),response.send(r,n,response.FAILED,responseData)});\n"
      Handler: index.handler
      Runtime: nodejs6.10
      Timeout: 30
      Role: !GetAtt CountASGRole.Arn
  CountASGRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Statement:
          - Action: ['sts:AssumeRole']
            Effect: Allow
            Principal: {Service: [lambda.amazonaws.com]}
      Path: '/'
      Policies:
        - PolicyName: root
          PolicyDocument:
            Statement:
              - Effect: Allow
                Action: ["logs:CreateLogGroup","logs:CreateLogStream","logs:PutLogEvents"]
                Resource: "arn:aws:logs:*:*:*"
              - Effect: Allow
                Action: ["autoscaling:DescribeAutoScalingGroups"]
                Resource: "*"
  SlackEvent:
    Type: AWS::Lambda::Function
    Properties:
      Description: 'Publish a CloudWatch Event to a Slack channel.'
      FunctionName: SlackEvent
      Code: {"S3Bucket":"cdo-dist","S3Key":"lambdajs-782e037d87e901ed56a61adfb9385981.zip"}
      Environment:
        Variables:
          SLACK_ENDPOINT: '{{resolve:secretsmanager:production/cdo/slack_endpoint}}'
      Handler: slackCloudWatchEvent.handler
      Runtime: nodejs10.x
      Timeout: 30
      Role: !GetAtt BasicLambdaRole.Arn
  BasicLambdaRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Statement:
          - Action: ['sts:AssumeRole']
            Effect: Allow
            Principal: {Service: [lambda.amazonaws.com]}
      Path: /
      ManagedPolicyArns:
      - "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
  S3Object:
    Type: AWS::Lambda::Function
    Properties:
      Description: S3 Object Custom Resource
      FunctionName: S3Object
      Role: !GetAtt S3ObjectRole.Arn
      Code:
        ZipFile: "let response=require(\"cfn-response\"),AWS=require(\"aws-sdk\"),s3=new AWS.S3;exports.handler=function(r,s){console.log(\"Request received:\\n\",JSON.stringify(r));let t=r.ResourceProperties.Bucket+\"/\"+r.ResourceProperties.Key,o=e=>response.send(r,s,e?response.FAILED:response.SUCCESS,e||{},t);var e=r.ResourceProperties;delete e.ServiceToken,\"Create\"===r.RequestType||\"Update\"===r.RequestType?s3.putObject(e).promise().then(e=>o()).catch(e=>o(e)):\"Delete\"===r.RequestType?(e={Bucket:r.ResourceProperties.Bucket,Key:r.ResourceProperties.Key},s3.deleteObject(e).promise().then(e=>o()).catch(e=>o(e))):o({Error:\"Invalid request type\"})};\n"
      Handler: index.handler
      Timeout: 30
      Runtime: nodejs6.10
  S3ObjectRole:
    Type: AWS::IAM::Role
    Properties:
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
        - Effect: Allow
          Principal: {Service: [lambda.amazonaws.com]}
          Action: ['sts:AssumeRole']
      Path: /
      ManagedPolicyArns:
      - "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
      Policies:
      - PolicyName: S3Policy
        PolicyDocument:
          Version: '2012-10-17'
          Statement:
            - Effect: Allow
              Action:
                - 's3:PutObject'
                - 's3:PutObjectAcl'
                - 'S3:DeleteObject'
              Resource: !Sub "arn:aws:s3:::*"
  S3PartitionCloudFrontLog:
    Type: AWS::Lambda::Function
    Properties:
      Description: 'Partition CloudFront Access Log stored on S3.'
      FunctionName: S3PartitionCloudFrontLog
      Environment:
        Variables:
          ATHENA_DB: elb_logs
          ATHENA_TABLE: cloudfront_logs
      Code:
        ZipFile: "let AWS=require(\"aws-sdk\"),s3=new AWS.S3,glue=new AWS.Glue,inputFormat=\"org.apache.hadoop.mapred.TextInputFormat\",outputFormat=\"org.apache.hadoop.hive.ql.io.HiveIgnoreKeyTextOutputFormat\",serdeInfo={Name:\"LazySimpleSerde\",SerializationLibrary:\"org.apache.hadoop.hive.serde2.lazy.LazySimpleSerDe\",Parameters:{\"field.delim\":\"\\t\",\"serialization.format\":\"\\t\"}},createdPartitions={};exports.handler=(t,e,o)=>{function r(e){return t.Records?null:{invocationSchemaVersion:t.invocationSchemaVersion,treatMissingKeysAs:\"PermanentFailure\",invocationId:t.invocationId,results:[{taskId:t.tasks[0].taskId,resultCode:e?\"TemporaryFailure\":\"Succeeded\",resultString:e?e.toString():\"OK\"}]}}console.log(\"Request received:\\n\",JSON.stringify(t)),process.on(\"uncaughtException\",e=>o(e));let a,i;var n=(i=t.Records?(a=t.Records[0].s3.bucket.name,t.Records[0].s3.object.key):(a=t.tasks[0].s3BucketArn.split(\":\").pop(),t.tasks[0].s3Key)).split(\"/\").map(e=>e.replace(/-tmp$/,\"\")),s=n.pop();let c=[\"year\",\"month\",\"day\",\"hour\"],p=s.split(\".\")[1].split(\"-\");var u=p.map((e,t)=>c[t]+\"=\"+e).join(\"/\"),n=[\"cloudfront\",n.join(\"/\"),u].filter(e=>e).join(\"/\"),u=[n,s].join(\"/\");let l=`s3://${a}/`+n;s3.copyObject({CopySource:[a,i].join(\"/\"),Bucket:a,Key:u}).promise().catch(e=>{if(\"NoSuchKey\"!==e.code)throw e}).then(e=>s3.deleteObject({Bucket:a,Key:i}).promise()).catch(e=>{if(\"NoSuchKey\"!==e.code)throw e}).then(e=>{if(!t.tasks&&!createdPartitions[p.join()])return glue.getPartition({DatabaseName:process.env.ATHENA_DB,TableName:process.env.ATHENA_TABLE,PartitionValues:p}).promise().catch(e=>{if(\"EntityNotFoundException\"===e.code)return glue.createPartition({DatabaseName:process.env.ATHENA_DB,TableName:process.env.ATHENA_TABLE,PartitionInput:{Values:p,StorageDescriptor:{Location:l,InputFormat:inputFormat,OutputFormat:outputFormat,SerdeInfo:serdeInfo}}}).promise().catch(e=>{if(\"AlreadyExistsException\"!==e.code)throw e});throw e}).then(e