AWSTemplateFormatVersion: 2010-09-09
Description: 'S3 Buckets with S3 Inventory-based Daily Batch Replication'
Parameters:
  PrimaryAccount:
    Type: String
    NoEcho: true
  SecondaryAccount:
    Type: String
    NoEcho: true

Resources:
  TestProjectBucket:
    Type: 'AWS::S3::Bucket'
    Properties:
      BucketName: 'cdo-v3-test'
      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - ServerSideEncryptionByDefault:
              SSEAlgorithm: 'AES256'  # S3-managed encryption
      VersioningConfiguration:
        Status: 'Enabled'
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true
      InventoryConfigurations:
        - Id: 'DailyInventory'
          Enabled: true
          IncludedObjectVersions: 'All'
          OptionalFields:
            - 'Size'
            - 'LastModifiedDate'
            - 'ETag'
            - 'StorageClass'
            - 'IsMultipartUploaded'
            - 'ReplicationStatus'
          ScheduleFrequency: 'Daily'
          Destination:
            BucketArn: !GetAtt InventoryBucket.Arn
            Format: 'CSV'
            Prefix: 'inventory-reports/'
            BucketAccountId: !Ref 'AWS::AccountId'

  # Dedicated bucket for S3 Inventory reports and batch operations
  InventoryBucket:
    Type: 'AWS::S3::Bucket'
    Properties:
      BucketName: !Sub 'cdo-inventory-${AWS::AccountId}'
      BucketEncryption:
        ServerSideEncryptionConfiguration:
          - ServerSideEncryptionByDefault:
              SSEAlgorithm: 'AES256'  # S3-managed encryption
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true
      LifecycleConfiguration:
        Rules:
          - Id: 'CleanupOldInventoryReports'
            Status: 'Enabled'
            ExpirationInDays: 30
            Prefix: 'inventory-reports/'

  # S3 Bucket Policy to allow inventory writes
  InventoryBucketPolicy:
    Type: 'AWS::S3::BucketPolicy'
    Properties:
      Bucket: !Ref InventoryBucket
      PolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: 'Allow'
            Principal:
              Service: 's3.amazonaws.com'
            Action: 's3:PutObject'
            Resource: !Sub '${InventoryBucket.Arn}/inventory-reports/*'
            Condition:
              StringEquals:
                's3:x-amz-acl': 'bucket-owner-full-control'
              ArnLike:
                'aws:SourceArn': !GetAtt TestProjectBucket.Arn
          - Effect: 'Allow'
            Principal:
              Service: 's3.amazonaws.com'
            Action:
              - 's3:GetBucketAcl'
              - 's3:ListBucket'
            Resource: !GetAtt InventoryBucket.Arn
            Condition:
              ArnLike:
                'aws:SourceArn': !GetAtt TestProjectBucket.Arn

  S3BatchOperationsRole:
    Type: 'AWS::IAM::Role'
    Properties:
      RoleName: 's3-batch-replication-role'
      AssumeRolePolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: 'Allow'
            Principal:
              Service: 'batchoperations.s3.amazonaws.com'
            Action: 'sts:AssumeRole'
      Policies:
        - PolicyName: 'S3BatchReplicationPolicy'
          PolicyDocument:
            Version: '2012-10-17'
            Statement:
              # Read source bucket objects (Primary Account)
              - Effect: 'Allow'
                Action:
                  - 's3:GetObject'
                  - 's3:GetObjectVersion'
                  - 's3:GetObjectVersionTagging'
                  - 's3:ListBucket'
                  - 's3:ListBucketVersions'
                Resource:
                  - !Sub '${TestProjectBucket.Arn}/*'
                  - !GetAtt TestProjectBucket.Arn
              # Write to destination bucket (Secondary Account)
              # NOTE: No READ permissions on Secondary Account bucket
              - Effect: 'Allow'
                Action:
                  - 's3:ReplicateObject'
                  - 's3:ReplicateDelete'
                  - 's3:ReplicateTags'
                Resource:
                  - !Sub 'arn:aws:s3:::cdo-secondary-v3-test/*'
              # Access to inventory bucket for manifests and reports
              - Effect: 'Allow'
                Action:
                  - 's3:GetObject'
                  - 's3:PutObject'
                  - 's3:GetBucketLocation'
                  - 's3:ListBucket'
                Resource:
                  - !Sub '${InventoryBucket.Arn}/*'
                  - !GetAtt InventoryBucket.Arn
              # Explicitly deny any KMS operations on Secondary Account keys
              - Effect: 'Deny'
                Action:
                  - 'kms:*'
                Resource:
                  - !Sub 'arn:aws:kms:*:${SecondaryAccount}:*'
  BatchReplicationLambdaRole:
      Type: 'AWS::IAM::Role'
      Properties:
        RoleName: 'batch-replication-lambda-role'
        AssumeRolePolicyDocument:
          Version: '2012-10-17'
          Statement:
            - Effect: 'Allow'
              Principal:
                Service: 'lambda.amazonaws.com'
              Action: 'sts:AssumeRole'
        ManagedPolicyArns:
          - 'arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole'
        Policies:
          - PolicyName: 'BatchReplicationLambdaPolicy'
            PolicyDocument:
              Version: '2012-10-17'
              Statement:
                # S3 permissions for source and inventory buckets
                - Effect: 'Allow'
                  Action:
                    - 's3:ListBucket'
                    - 's3:GetBucketLocation'
                  Resource:
                    - !GetAtt TestProjectBucket.Arn
                    - !GetAtt InventoryBucket.Arn

                # S3 object permissions for reading inventory files
                - Effect: 'Allow'
                  Action:
                    - 's3:GetObject'
                  Resource:
                    - !Sub '${TestProjectBucket.Arn}/*'
                    - !Sub '${InventoryBucket.Arn}/inventory-reports/*'
                    - !Sub '${InventoryBucket.Arn}/backup-reports/*'

                # S3 object permissions for writing manifests and backup reports
                - Effect: 'Allow'
                  Action:
                    - 's3:PutObject'
                  Resource:
                    - !Sub '${InventoryBucket.Arn}/batch-manifests/*'
                    - !Sub '${InventoryBucket.Arn}/backup-reports/*'

                # S3 delete permissions specifically for in-progress markers
                - Effect: 'Allow'
                  Action:
                    - 's3:DeleteObject'
                  Resource:
                    - !Sub '${InventoryBucket.Arn}/backup-reports/*/in-progress/*'

                # Batch Operations permissions
                - Effect: 'Allow'
                  Action:
                    - 's3:CreateJob'
                    - 's3:DescribeJob'
                    - 's3:ListJobs'
                  Resource: '*'

                # IAM permission to pass role to S3 Batch Operations
                - Effect: 'Allow'
                  Action: 'iam:PassRole'
                  Resource: !GetAtt S3BatchOperationsRole.Arn
  # Lambda function to process S3 Inventory and create batch replication jobs
  BatchReplicationLambda:
    Type: 'AWS::Lambda::Function'
    Properties:
      FunctionName: 'inventory-based-batch-replication'
      Runtime: 'ruby3.2'
      Handler: 'lambda_function.lambda_handler'
      Role: !GetAtt BatchReplicationLambdaRole.Arn
      Timeout: 900  # 15 minutes to process large inventories
      Environment:
        Variables:
          SOURCE_BUCKET: !Ref TestProjectBucket
          DESTINATION_BUCKET: 'cdo-secondary-v3-test'
          DESTINATION_ACCOUNT: !Ref SecondaryAccount
          BATCH_ROLE_ARN: !GetAtt S3BatchOperationsRole.Arn
          INVENTORY_BUCKET: !Ref InventoryBucket
          LOG_LEVEL: 'DEBUG'
          # Removed DEST_KMS_KEY since we're using S3-managed encryption
      Code: {"S3Bucket":"cdo-ci-artifacts","S3Key":"test_s3_backup/batch-replication.20250902.zip"}
      Description: "Inventory-based batch replication Lambda"

  # EventBridge rule to trigger Lambda daily at 00:00 UTC
  DailyReplicationSchedule:
    Type: 'AWS::Events::Rule'
    Properties:
      Name: 'daily-inventory-batch-replication'
      Description: 'Trigger inventory-based batch replication daily at 00:00 UTC'
      ScheduleExpression: 'cron(0 0 * * ? *)'  # 00:00 UTC daily
      State: 'ENABLED'
      Targets:
        - Arn: !GetAtt BatchReplicationLambda.Arn
          Id: 'InventoryBatchReplicationTarget'

  # Permission for EventBridge to invoke Lambda
  LambdaInvokePermission:
    Type: 'AWS::Lambda::Permission'
    Properties:
      Action: 'lambda:InvokeFunction'
      FunctionName: !Ref BatchReplicationLambda
      Principal: 'events.amazonaws.com'
      SourceArn: !GetAtt DailyReplicationSchedule.Arn

Outputs:
  SourceBucket:
    Description: 'Primary S3 bucket name'
    Value: !Ref TestProjectBucket

  InventoryBucket:
    Description: 'Bucket for S3 Inventory reports and batch operations'
    Value: !Ref InventoryBucket

  BatchRoleArn:
    Description: 'IAM role ARN for batch operations'
    Value: !GetAtt S3BatchOperationsRole.Arn

  InventoryConfiguration:
    Description: 'S3 Inventory configuration status'
    Value: 'Daily inventory enabled for efficient object discovery'
