AWSTemplateFormatVersion: '2010-09-09'
Description: Set up OIDC identity provider and IAM role for GitHub Actions

Parameters:
  MarketingApplicationStackName:
    Type: String
    Description: The name of the Marketing application stack to use for this deployment.

Resources:
  GitHubOIDCProvider:
    Type: AWS::IAM::OIDCProvider
    Properties:
      # See: https://docs.github.com/en/actions/security-for-github-actions/security-hardening-your-deployments/configuring-openid-connect-in-amazon-web-services#adding-the-identity-provider-to-aws
      Url: https://token.actions.githubusercontent.com
      ClientIdList:
        - sts.amazonaws.com
      ThumbprintList:
        # GitHub's current root CA thumbprint
        # See: https://github.blog/changelog/2023-06-27-github-actions-update-on-oidc-integration-with-aws/
        - '6938fd4d98bab03faadb97b34396831e3780aea1'
        - '1c58a3a8518e8759bf075b76b750d4f2df264fcd'