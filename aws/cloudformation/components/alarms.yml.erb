  Critical: {Type: 'AWS::SNS::Topic'}
  Warning: {Type: 'AWS::SNS::Topic'}
<%{Warning: 70, Critical: 90}.each do |name, threshold| -%>
  DiskUsed<%=name%>:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmActions: [!Ref '<%=name%>']
      AlarmDescription: Max disk usage in <%=environment%> env exceeds <%=threshold%>%
      Dimensions: [{Name: Environment, Value: <%=environment%>}]
      Namespace: CWAgent
      MetricName: disk_used_percent
      Statistic: Maximum
      EvaluationPeriods: 1
      Period: 60
      ComparisonOperator: GreaterThanThreshold
      Threshold: <%=threshold%>
<%end -%>
  DaemonMemoryUtilizationAlarm:
    Type: "AWS::CloudWatch::Alarm"
    Properties:
<%    unless rack_env?(:adhoc) -%>
      AlarmActions:
        - !Sub "arn:aws:sns:${AWS::Region}:${AWS::AccountId}:CDO-<%= rack_env?(:production) ? 'Urgent' : 'LowPriority'%>"
<%    end -%>
      AlarmDescription: Daemon memory utilization exceeded 87% for 5 minutes
      AlarmName: <%="#{stack_name}_daemon_high_memory_utilization" %>
      ComparisonOperator: GreaterThanThreshold
      Dimensions:
        - {Name: InstanceId, Value: !Ref <%=daemon%>}
        - {Name: Environment, Value: <%= environment %>}
      EvaluationPeriods: 7
      MetricName: mem_used_percent
      Namespace: CWAgent
      Period: 60
      Statistic: Maximum
      Threshold: 87
      TreatMissingData: breaching
<% if environment == :production -%>
  # Detect problems with the bin/cron/deliver_poste_messages scheduled job by monitoring outbound emails sent by AWS SES.
  OutboundEmailAlarm:
    Type: "AWS::CloudWatch::Alarm"
    Properties:
      AlarmActions:
        - !Sub "arn:aws:sns:${AWS::Region}:${AWS::AccountId}:CDO-Urgent"
      AlarmDescription: Send page if number of outbound transactional emails sent drops below threshold.
      AlarmName: <%="#{stack_name}_no_outbound_emails_sent" %>
      ComparisonOperator: LessThanThreshold
      MetricName: Send
      Namespace: 'AWS/SES'
      # No outbound transactional emails (password reset, new account welcome, etc.) sent per hour for 4 consecutive hours.
      Period: 3600
      EvaluationPeriods: 4
      Statistic: Sum
      Threshold: 1
      TreatMissingData: breaching

  # 'App Server'/backlog is published every second per instance; the Host-only series pools every instance's samples.
  PumaBacklogInstanceWedgedAlarm:
    Type: "AWS::CloudWatch::Alarm"
    Properties:
      AlarmActions:
        - !Ref InfraWorkdayUrgent
      AlarmName: <%="#{stack_name}_puma_backlog_instance_wedged" %>
      AlarmDescription: >-
        One app server's Puma backlog has stayed above 100 queued requests for 10 minutes while the
        load balancer still routes to it. Known cause: a Puma worker deadlocked in DNS resolution
        after fork; health checks stay green and the queue grows without bound. Find the instance
        in the per-InstanceId 'App Server'/backlog series, capture worker threads if practical,
        then replace the instance.
      Namespace: App Server
      MetricName: backlog
      Dimensions: [{Name: Host, Value: <%=CDO.dashboard_hostname%>}]
      # One stuck instance lifts p97 while it supplies over 3% of samples (fleets under ~33
      # instances); a fleet-wide one-second burst supplies under 2%.
      ExtendedStatistic: p97
      Period: 60
      EvaluationPeriods: 10
      DatapointsToAlarm: 10
      ComparisonOperator: GreaterThanThreshold
      Threshold: 100
      TreatMissingData: notBreaching

  PumaBacklogFleetBurstsAlarm:
    Type: "AWS::CloudWatch::Alarm"
    Properties:
      AlarmActions:
        - !Ref InfraWorkdayUrgent
      AlarmName: <%="#{stack_name}_puma_backlog_fleet_bursts" %>
      AlarmDescription: >-
        Puma backlog bursts above 20 queued requests in at least 5 of the last 30 minutes. Bursts
        last about a second and hit every app server at once, so the cause is usually a shared
        downstream stall (database, RDS Proxy, cache, or an external service), not one instance.
        Compare the burst minutes with RDS Proxy DatabaseConnectionsBorrowLatency, Aurora latency,
        and load balancer p99 TargetResponseTime.
      Namespace: App Server
      MetricName: backlog
      Dimensions: [{Name: Host, Value: <%=CDO.dashboard_hostname%>}]
      Statistic: Maximum
      Period: 60
      EvaluationPeriods: 30
      DatapointsToAlarm: 5
      ComparisonOperator: GreaterThanThreshold
      Threshold: 20
      TreatMissingData: notBreaching

  PumaBacklogFleetSaturationAlarm:
    Type: "AWS::CloudWatch::Alarm"
    Properties:
      AlarmActions:
        - !Ref InfraWorkdayUrgent
      AlarmName: <%="#{stack_name}_puma_backlog_fleet_saturation" %>
      AlarmDescription: >-
        The fleet's average Puma backlog has exceeded 10% of its total thread capacity in 3 of the
        last 5 minutes: app servers are out of capacity and autoscaling has not caught up. Check the
        Auto Scaling group's desired and in-service counts, then whether request volume or request
        duration rose.
      Metrics:
        - Id: saturation_pct
          Label: Backlog Saturation %
          Expression: (backlog / max_threads) * 100
          ReturnData: true
        - Id: backlog
          ReturnData: false
          MetricStat:
            Metric:
              Namespace: App Server
              MetricName: backlog
              Dimensions: [{Name: Host, Value: <%=CDO.dashboard_hostname%>}]
            Period: 60
            Stat: Sum
        - Id: max_threads
          ReturnData: false
          MetricStat:
            Metric:
              Namespace: App Server
              MetricName: max_threads
              Dimensions: [{Name: Host, Value: <%=CDO.dashboard_hostname%>}]
            Period: 60
            Stat: Sum
      EvaluationPeriods: 5
      DatapointsToAlarm: 3
      ComparisonOperator: GreaterThanThreshold
      Threshold: 10
      TreatMissingData: notBreaching
<%  end -%>

  # ---------------------------------------------
  # Team Alerting SNS Topics
  # 
  # These topics are created in each environment
  # and will be subscribed to by alerting tools
  # like PagerDuty, Slack (Chatbot) or others.
  #
  # Unmanaged topics that could be migrated here:
  #   - CDO-LowPriority
  #   - CDO-WorkdayUrgent
  #   - CDO-Urgent
  #
  # ---------------------------------------------

  InfraLowPriority:
    Type: 'AWS::SNS::Topic'
    Properties:
      DisplayName: Infra-LowPriority

  InfraWorkdayUrgent:
    Type: 'AWS::SNS::Topic'
    Properties:
      DisplayName: Infra-WorkdayUrgent

  InfraUrgent:
    Type: 'AWS::SNS::Topic'
    Properties:
      DisplayName: Infra-Urgent

  StudentLearningWorkdayUrgent:
      Type: 'AWS::SNS::Topic'
      Properties:
        DisplayName: StudentLearning-WorkdayUrgent
