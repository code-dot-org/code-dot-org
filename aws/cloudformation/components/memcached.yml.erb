<% cache_node_type = rack_env?(:production) ? 'cache.r5.large' : 'cache.t2.micro' -%>
  GeocoderSubnetGroup:
    Type: AWS::ElastiCache::SubnetGroup
    Properties:
      Description: Geocoder Cache Subnet Group
      SubnetIds: <%= subnets.to_json %>

  MemcachedParameterGroup:
    Type: AWS::ElastiCache::ParameterGroup
    Properties:
      CacheParameterGroupFamily: memcached1.4
      Description: Memcached modified max_item_size.
      Properties:
        max_item_size: <%=64.megabytes%>
  Memcached:
    Type: AWS::ElastiCache::CacheCluster
    Properties:
      CacheNodeType: <%= cache_node_type %>
      CacheParameterGroupName: !Ref MemcachedParameterGroup
      CacheSubnetGroupName: !Ref GeocoderSubnetGroup
      ClusterName: <%=stack_name[0..19]%> # Max 20 chars
      Engine: memcached
      EngineVersion: 1.4
      NumCacheNodes: 3
      AZMode: cross-az
      PreferredAvailabilityZones: <%= AVAILABILITY_ZONES.first(3).to_json %>
      PreferredMaintenanceWindow: sat:03:00-sat:04:00
      VpcSecurityGroupIds: [!ImportValue VPC-MemcachedSecurityGroup]
  # Publish the configuration endpoint so Kubernetes workers can read it from
  # Secrets Manager (synced as CDO_memcached_endpoint by the k8s-gitops
  # standard-envtypes ExternalSecret). Legacy frontends get the same value from
  # bootstrap_chef_stack.sh.erb.
  MemcachedEndpointConfig:
    Type: AWS::SecretsManager::Secret
    Properties:
      Description: 'Publish Memcached configuration endpoint to application configuration setting CDO.memcached_endpoint'
      Name: !Sub "CfnStack/${AWS::StackName}/memcached_endpoint"
      SecretString: !Sub "${Memcached.ConfigurationEndpoint.Address}:${Memcached.ConfigurationEndpoint.Port}"
