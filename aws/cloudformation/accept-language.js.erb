// CloudFront Functions handler to normalize Accept-Language header for optimized caching.
<%= File.read(aws_dir('cloudformation/partials/accept_language_normalizer.js')) %>
<%
  require 'cdo/languages'
  require_relative '../../pegasus/helpers/pegasus_languages'
  tags = PegasusLanguages.table.select(:locale_s, :code_s).map {|x| x.values.values}.flatten.uniq.map(&:downcase)
%>

function handler(event) {
  var request = event.request;
  var headers = request.headers || {};
  var v = normalizeAcceptLanguage(request, <%= tags.to_json %>);
  if (v) headers['accept-language'] = { value: v };
  return request;
}
