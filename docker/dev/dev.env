# A CDO_* variable has a higher priority than locals.yml, so this harness
# needs no locals.yml. See README.md.

AWS_EC2_METADATA_DISABLED=true
BUNDLE_APP_CONFIG=/home/cdo/.bundle

# turbo puts its cache beside the git common directory. In a linked worktree
# that path is on the host, outside the mount, and root owns it. Keep the
# cache in the checkout.
TURBO_CACHE_DIR=/code-dot-org/.turbo/cache

# The prebuilt apps package is code-split. Without this flag its entry
# points do not run, and every React root stays empty.
CDO_OPTIMIZE_WEBPACK_ASSETS=true

# db_writer does not set the db_endpoint_* keys. They default to
# 127.0.0.1, where this container has no server.
CDO_DB_WRITER=mysql://root@mysql/
CDO_DB_CLUSTER_ID=local
CDO_DB_ENDPOINT_WRITER=mysql
CDO_DB_ENDPOINT_WRITER_PORT=3306
CDO_DB_ENDPOINT_PROXY_WRITER=mysql
CDO_DB_ENDPOINT_PROXY_WRITER_PORT=3306
CDO_DB_ENDPOINT_PROXY_READER=mysql
CDO_DB_ENDPOINT_PROXY_READER_PORT=3306
CDO_DB_ENDPOINT_PROXY_REPORTING=mysql
CDO_DB_ENDPOINT_PROXY_REPORTING_PORT=3306
CDO_REDIS_URL=redis://redis:6379/0
CDO_DB_CREDENTIAL_ADMIN={"username":"root","password":""}
CDO_DB_CREDENTIAL_WRITER={"username":"root","password":""}
CDO_DB_CREDENTIAL_READER={"username":"root","password":""}

# Presigned S3 and CloudFront URLs need credentials to sign, even when the
# code sends no request. The endpoint address is unused.
AWS_ACCESS_KEY_ID=local-development
AWS_SECRET_ACCESS_KEY=allstudents
AWS_REGION=us-east-1
CDO_AWS_S3_ENDPOINT=http://127.0.0.1:33993
CDO_AWS_S3_ACCESS_KEY_ID=local-development
CDO_AWS_S3_SECRET_ACCESS_KEY=allstudents
CDO_AWS_S3_EMULATED=true

# development.yml.erb clears the secrets in config.yml.erb, then declares
# these again. A missing one names itself: GetSecretValue: <key>.
CDO_AI_GATEWAY_AUTH_KEY=localoverride
CDO_AI_GATEWAY_AUTH_KEY_PASSPHRASE=localoverride
CDO_AI_GATEWAY_AUTH_PUBLIC_KEY=localoverride
CDO_APPLICATIONS_GSHEET_KEY=localoverride
CDO_AZURE_AI_CONTENT_SAFETY_KEY=localoverride
CDO_DEVICE_FARM_MOBILE_PROJECT_ARN=localoverride
CDO_DEVINTERNAL_DB_WRITER=localoverride
CDO_EIR_TEACHER_ENROLLMENTS_GSHEET_KEY=localoverride
CDO_ELEVENLABS_API_KEY=localoverride
CDO_GOOGLE_GEMINI_AI_CHAT_LAB_API_KEY=localoverride
CDO_GOOGLE_GEMINI_AI_TUTOR_API_KEY=localoverride
CDO_GOOGLE_VERTEX_AI_CHAT_SERVICE_ACCOUNT_KEY=localoverride
CDO_GOOGLE_VERTEX_AI_TUTOR_SERVICE_ACCOUNT_KEY=localoverride
CDO_JAVABUILDER_KEY_PASSWORD=localoverride
CDO_JAVABUILDER_PRIVATE_KEY=localoverride
CDO_OPENAI_LESSON_SUMMARIES_API_KEY=localoverride
CDO_OPENAI_MEASURES_OF_LEARNING_API_KEY=localoverride
CDO_OPENAI_STUDENT_LEARNING_API_KEY=localoverride
CDO_PARDOT_PRIVATE_KEY=localoverride
CDO_PROPERTIES_ENCRYPTION_KEY=
CDO_SLACK_BOT_TOKEN=localoverride
CDO_TA_LANGFUSE_PUBLIC_KEY=localoverride
CDO_TA_LANGFUSE_SECRET_KEY=localoverride
CDO_TUTOR_LANGFUSE_PUBLIC_KEY=localoverride
CDO_TUTOR_LANGFUSE_SECRET_KEY=localoverride
