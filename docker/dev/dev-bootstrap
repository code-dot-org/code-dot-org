#!/bin/bash
# This splits the way the devcontainer lifecycle splits it:
#
#   dev-bootstrap create   once per container   (onCreateCommand)
#   dev-bootstrap start    on every start       (postStartCommand)
#
# Both subcommands are idempotent.
set -euo pipefail

usage() {
  echo "usage: dev-bootstrap {create|start}" >&2
  exit 64
}

# --- create -----------------------------------------------------------------

install_hooks() {
  local hooks_dir="/code-dot-org/.git/hooks"
  local tools_dir="/code-dot-org/tools/hooks"
  if [ -d "$tools_dir" ] && [ -d "$hooks_dir" ]; then
    # This links only where nothing exists yet. git-lfs writes real hook
    # files for post-checkout and post-merge on clone. Overwriting one
    # breaks `git lfs post-checkout`.
    for hook in pre-commit post-checkout post-merge; do
      if [ -f "$tools_dir/$hook" ] && [ ! -e "$hooks_dir/$hook" ]; then
        ln -sf "../../tools/hooks/$hook" "$hooks_dir/$hook"
      fi
    done
  fi
}

bootstrap_apps() {
  # Level pages need /blockly/* assets. The package is public-read on S3.
  # It is keyed by the content of apps/, so this is a download, not a
  # build.
  local blockly_target="/code-dot-org/dashboard/public/blockly"
  if [ -L "$blockly_target" ] && [ -d "$(readlink -f "$blockly_target")" ]; then
    return
  fi

  # An absolute symlink from a native build will not resolve here.
  # Repointing it fixes this container. It also breaks the host's own
  # symlink. The messages below say so, instead of repointing quietly.
  if [ -L "$blockly_target" ]; then
    echo "dev-bootstrap: $blockly_target points at $(readlink "$blockly_target"), which does not exist in this container."
    echo "dev-bootstrap: repointing it. On the host, 'bundle exec rake package:apps:symlink' puts it back."
  fi

  if command -v bundle >/dev/null 2>&1 && [ -f /code-dot-org/Rakefile ] && \
     git -C /code-dot-org rev-parse HEAD >/dev/null 2>&1; then
    # This replaces a large package. The commands below log it before and
    # after, for a checkout shared with a native setup.
    local package_dir=/code-dot-org/dashboard/public/apps-package
    if [ -d "$package_dir" ]; then
      echo "dev-bootstrap: overwriting the apps package in $package_dir (commit_hash $(cat "$package_dir/commit_hash" 2>/dev/null || echo unknown))"
    fi
    echo "dev-bootstrap: downloading apps package from S3..."
    cd /code-dot-org
    bundle exec rake package:apps:update 2>&1 || true
    bundle exec rake package:apps:symlink 2>&1 || \
      echo "dev-bootstrap: apps bootstrap skipped (S3 package not available for this commit)"
    if [ -d "$package_dir" ]; then
      echo "dev-bootstrap: apps package now at commit_hash $(cat "$package_dir/commit_hash" 2>/dev/null || echo unknown)"
    fi
    if [ -L "$blockly_target" ]; then
      echo "dev-bootstrap: $blockly_target -> $(readlink "$blockly_target")"
    fi
  fi
}

# --- start ------------------------------------------------------------------

db_query() {
  # Credentials come from the environment, so a compose file or CDO_LOCALS
  # can set them. Empty DB_PASSWORD means "no -p at all", not -p''.
  local pw_arg=()
  [ -n "${DB_PASSWORD-not-a-secret-password}" ] && pw_arg=(-p"${DB_PASSWORD-not-a-secret-password}")
  mysql -h "${DB_HOST:-db}" -u "${DB_USER:-root}" "${pw_arg[@]}" -N -e "$1"
}

migration_versions_on_disk() {
  # 20260805182458_drop_contact_rollups_final.rb -> 20260805182458
  basename -a "${1:-db/migrate}"/*.rb 2>/dev/null |
    sed -n 's/^\([0-9][0-9]*\)_.*\.rb$/\1/p' | sort -u
}

versions_missing_from_db() {
  # These are sets, not counts. An orphaned schema_migrations row, from a
  # migration deleted after it ran, must not force a full db:migrate on
  # every container start.
  comm -23 <(printf '%s\n' "$1" | sed '/^$/d' | sort -u) \
           <(printf '%s\n' "$2" | sed '/^$/d' | sort -u)
}

migrate_or_die() {
  RAILS_ENV="$1" bundle exec rake db:migrate 2>&1 && return 0
  echo "dev-bootstrap: db:migrate failed for the $1 database; refusing to start with a half-migrated schema." >&2
  exit 1
}

auto_migrate() {
  # This compares version sets with one query, instead of booting Rails.
  [ -f /code-dot-org/dashboard/Rakefile ] || return 0
  command -v mysql >/dev/null 2>&1 || return 0

  cd /code-dot-org/dashboard

  local disk db pending
  disk=$(migration_versions_on_disk db/migrate)
  [ -n "$disk" ] || return 0

  if ! db=$(db_query "SELECT version FROM dashboard_development.schema_migrations" 2>/dev/null); then
    # Usually locals.yml points at a database this container cannot reach.
    # Rails would otherwise surface this later as a confusing socket error.
    # rake reads locals.yml, not DB_USER, so it may succeed here.
    echo "dev-bootstrap: cannot read schema_migrations as '${DB_USER:-root}'@'${DB_HOST:-db}'." >&2
    echo "dev-bootstrap: check /code-dot-org/locals.yml — the devcontainer mounts its own there, and CDO_LOCALS chooses which. Running db:migrate to be sure." >&2
    db=""
  fi

  pending=$(versions_missing_from_db "$disk" "$db")
  [ -n "$pending" ] || return 0

  # This is fatal. A half-migrated database is not a working container. A
  # warning here would only defer the failure to later.
  echo "dev-bootstrap: $(printf '%s\n' "$pending" | wc -l) pending migration(s), oldest $(printf '%s\n' "$pending" | head -1); running db:migrate..."
  migrate_or_die development
  migrate_or_die test
  echo "dev-bootstrap: migrations complete"
}

# --- dispatch ---------------------------------------------------------------

case "${1:-}" in
  create)
    install_hooks
    bootstrap_apps
    ;;
  start)
    auto_migrate
    ;;
  *)
    usage
    ;;
esac
