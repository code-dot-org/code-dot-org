# Configuration for running cdo-dashboard against the compose.yaml services.
# CDO_* stubs pre-empt every declared secret at locals.yml priority; the
# rationale per group is in README.md under "Running Rails from this image".
RAILS_ENV=adhoc
RACK_ENV=adhoc
AWS_EC2_METADATA_DISABLED=true
SKIP_SCRIPT_PRELOAD=1
CDO_DB_WRITER=mysql://root@mysql/
CDO_DB_CLUSTER_ID=local
CDO_DB_ENDPOINT_WRITER=mysql
CDO_DB_ENDPOINT_WRITER_PORT=3306
CDO_DB_ENDPOINT_PROXY_WRITER=mysql
CDO_DB_ENDPOINT_PROXY_WRITER_PORT=3306
CDO_DB_ENDPOINT_PROXY_READER=mysql
CDO_DB_ENDPOINT_PROXY_READER_PORT=3306
CDO_DB_ENDPOINT_PROXY_REPORTING=mysql
CDO_DB_ENDPOINT_PROXY_REPORTING_PORT=3306
CDO_DB_CREDENTIAL_ADMIN={"username":"root","password":""}
CDO_DB_CREDENTIAL_WRITER={"username":"root","password":""}
CDO_DB_CREDENTIAL_READER={"username":"root","password":""}
CDO_DASHBOARD_WORKERS=2
CDO_REDIS_URL=redis://redis:6379/0
CDO_NO_HTTPS_STORE=true
CDO_USE_MY_APPS=true
CDO_OPTIMIZE_WEBPACK_ASSETS=false
CDO_CONTENTFUL_API_KEY=stub
CDO_CONTENTFUL_CS_FOR_ALL_ACCESS_TOKEN=stub
CDO_RECAPTCHA_SITE_KEY=stub
CDO_RECAPTCHA_SECRET_KEY=stub
CDO_JAVABUILDER_PRIVATE_KEY=stub
CDO_JAVABUILDER_KEY_PASSWORD=stub
CDO_PROPERTIES_ENCRYPTION_KEY=stub
CDO_PUMA_CONTROL_SERVER_TOKEN=stub
CDO_OPENAI_STUDENT_LEARNING_API_KEY=stub
