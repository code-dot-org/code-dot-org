                        "title": "Block type",
                        "x-choices": "one of the names the editor page supplies as \"toolboxBlockTypes\"",
                        "description": "One block type, or any of several."
                      },
                      "under": {
                        "title": "Under a top block of type",
                        "x-choices": "one of the names the editor page supplies as \"toolboxBlockTypes\"",
                        "type": "string",
                        "minLength": 1
                      },
                      "data": {
                        "title": "Under the stack tagged",
                        "description": "The tag of a stack the level adds.",
                        "x-choices": "a name found at \"blocks.addOnArrival.*.data\" in the settings",
                        "type": "string"
                      },
                      "fields": {
                        "title": "Field values",
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "scene": {
                        "title": "In scene",
                        "description": "The open scene when not set.",
                        "x-choices": "a name found at \"scenes.starting.*.id\" in the settings",
                        "type": "string"
                      }
                    },
                    "required": [
                      "kind",
                      "type"
                    ],
                    "additionalProperties": false,
                    "title": "Uses a block"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "world"
                      },
                      "role": {
                        "title": "Shows an image with role",
                        "type": "string",
                        "minLength": 1
                      },
                      "changed": {
                        "title": "Changed from the start",
