{
  "name": "@code-dot-org/studio",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "build:mobile": "tsc -b && CAPACITOR_BUILD=1 vite build --base=./",
    "dev": "vite dev",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "preview": "vite preview",
    "snapshot:k5-ai-decisions": "node --import tsx/esm scripts/snapshot-k5-ai-decisions.ts",
    "test": "vitest --run --passWithNoTests",
    "typecheck": "tsc -b --noEmit"
  },
  "prettier": "@code-dot-org/lint-config/prettier/index.mjs",
  "stylelint": {
    "extends": "@code-dot-org/lint-config/stylelint/index.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^5.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@code-dot-org/component-library": "workspace:*",
    "@code-dot-org/component-library-styles": "workspace:*",
    "@code-dot-org/core": "workspace:*",
    "@code-dot-org/fonts": "workspace:*",
    "@code-dot-org/music-lab": "workspace:*",
    "@code-dot-org/notebook-lab": "workspace:*",
    "@code-dot-org/oceans-lab": "workspace:*",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-python": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@mui/material": "catalog:",
    "@sentry/browser": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "^1.139.14",
    "@tanstack/react-router-devtools": "^1.139.14",
    "dompurify": "^3.0.0",
    "ky": "catalog:",
    "marked": "^15.0.0",
    "qrcode": "^1.5.0",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@code-dot-org/lint-config": "workspace:*",
    "@tanstack/router-plugin": "^1.139.14",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "typescript": "~5.9.3",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "^0.21.0",
    "vite-plugin-rails": "^0.5.0",
    "vitest": "catalog:"
  }
