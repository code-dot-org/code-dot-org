    "stylelint": "stylelint src/**/*.{css,scss,sass}",
    "stylelint:fix": "yarn run stylelint --fix",
    "test": "jest",
    "test:ui:ci": "playwright test",
    "test:ui:local": "STAGE=localhost yarn test:ui:ci"
