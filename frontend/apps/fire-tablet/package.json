{
  "name": "@code-dot-org/fire-tablet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "android:build:debug": "yarn android:sync && cd android && ./gradlew assembleDebug",
    "android:build:release": "yarn android:sync && cd android && ./gradlew assembleRelease",
    "android:sync": "yarn build && cap sync android",
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "preview": "vite preview",
    "stylelint": "stylelint 'src/**/*.scss'",
    "stylelint:fix": "stylelint --fix 'src/**/*.scss'",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit"
  },
  "prettier": "@code-dot-org/lint-config/prettier/index.mjs",
  "stylelint": {
    "extends": "@code-dot-org/lint-config/stylelint/index.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@capacitor/inappbrowser": "4.0.3",
    "@code-dot-org/component-library-styles": "workspace:*"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@code-dot-org/lint-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "sass": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
