{
  "name": "@code-dot-org/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "android:open": "cap open android",
    "android:sync": "yarn build && cap sync android",
    "build": "yarn run -T turbo build --filter @code-dot-org/studio",
    "dev": "yarn workspace @code-dot-org/studio dev",
    "lint": "yarn typecheck",
    "lint:fix": "prettier --write .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test": "yarn workspace @code-dot-org/studio test",
    "typecheck": "tsc -p tsconfig.node.json --noEmit"
  },
  "prettier": "@code-dot-org/lint-config/prettier/index.mjs",
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@code-dot-org/lint-config": "workspace:*",
    "@code-dot-org/studio": "workspace:*",
    "@types/node": "catalog:",
    "prettier": "catalog:",
    "typescript": "~5.9.3"
  }
}
