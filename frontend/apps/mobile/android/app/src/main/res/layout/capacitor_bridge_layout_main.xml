<?xml version="1.0" encoding="utf-8"?>
<!-- Replaces Capacitor's layout of the same name so MainActivity can pad the
     root for system bars and the keyboard. The background shows behind the
     status and navigation bars and matches the site header. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/app_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/codeai_purple"
    tools:context=".MainActivity">

    <com.getcapacitor.CapacitorWebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
