<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen with a spinner below the wordmark, shown while a page loads.
     Clickable so it swallows taps meant for the page underneath. The wordmark
     sits where splash.xml draws it and returns to the landing page. Its
     background covers the WebView, not the window's own background. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background"
    android:clickable="true"
    android:focusable="true"
    tools:ignore="Overdraw">

    <ImageView
        android:id="@+id/loading_cover_logo"
        android:layout_width="280dp"
        android:layout_height="47.37dp"
        android:layout_gravity="center"
        android:contentDescription="@string/go_home"
        android:scaleType="fitXY"
        android:src="@drawable/logo_codeai" />

    <ProgressBar
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:layout_marginTop="96dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/codeai_purple" />
</FrameLayout>
