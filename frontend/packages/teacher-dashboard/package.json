{
  "name": "@code-dot-org/teacher-dashboard",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "teacher-tools",
    "code.org"
  ],
  "homepage": "https://github.com/code-dot-org/code-dot-org/blob/staging/frontend/packages/teacher-dashboard/#readme",
  "bugs": {
    "url": "https://github.com/code-dot-org/code-dot-org/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-dot-org/code-dot-org.git",
    "directory": "frontend/packages/teacher-dashboard"
  },
  "license": "SEE LICENSE IN LICENSE",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./redux": {
      "types": "./dist/redux/index.d.ts",
      "import": "./dist/redux/index.mjs",
      "require": "./dist/redux/index.cjs"
    },
    "./redux/teacherSectionsSlice": {
      "types": "./dist/redux/teacherSectionsSlice.d.ts"
    }
  },
  "scripts": {
    "build": "vite build && tsc --noEmit",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "typecheck": "tsc -b --noEmit"
  },
  "prettier": "@code-dot-org/lint-config/prettier/index.mjs",
  "dependencies": {
    "@code-dot-org/core": "workspace:*",
    "@code-dot-org/users": "workspace:*",
    "@reduxjs/toolkit": "catalog:",
    "lodash": "^4.17.21",
    "react-redux": "catalog:"
  },
  "devDependencies": {
    "@code-dot-org/lint-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vite-plugin-externalize-deps": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
