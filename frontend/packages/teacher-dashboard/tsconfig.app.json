{
  "extends": "@code-dot-org/lint-config/typescript/tsconfig.vite.app.json",
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    // Relaxed for files moved from apps/ which use non-verbatim import syntax,
    // parameter properties, .js modules without declarations, and apps-era
    // type patterns that don't match the frontend workspace's stricter config.
    // Will be tightened incrementally as files are modernized.
    "strict": false,
    "verbatimModuleSyntax": false,
    "erasableSyntaxOnly": false,
    "allowJs": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // Include only non-moved files for strict typechecking. Moved files from
  // apps/ are type-checked by the Vite build (which transpiles them) but
  // excluded from tsc --noEmit because they use apps-era patterns (MUI palette
  // augmentations, non-verbatim imports, parameter properties) incompatible
  // with the frontend workspace's stricter config. They will be included
  // incrementally as type alignment progresses.
  "include": [
    "src/index.ts",
    "src/types",
    "src/devhost",
    "src/mocks",
    "src/stubs",
    "src/home/DemoSectionStalenessDialog.tsx",
    "src/home/LogoTransition.tsx",
    "src/home/TeacherHomepageConstants.tsx",
    "src/home/sectionAvatars",
    "src/home/logoTransition.module.scss"
  ],
  "exclude": ["src/**/__tests__"]
}
