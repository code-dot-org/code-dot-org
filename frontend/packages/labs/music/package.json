{
  "name": "@code-dot-org/music-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Code.org Music lab",
  "homepage": "https://github.com/code-dot-org/code-dot-org/blob/staging/frontend/packages/labs/music/#readme",
  "bugs": {
    "url": "https://github.com/code-dot-org/code-dot-org/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-dot-org/code-dot-org.git",
    "directory": "frontend/packages/labs/music"
  },
  "license": "SEE LICENSE IN LICENSE",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./components": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/esm/components/index.mjs",
      "require": "./dist/cjs/components/index.js"
    },
    "./parser": {
      "types": "./dist/types/parser/index.d.ts",
      "import": "./dist/esm/parser/index.mjs",
      "require": "./dist/cjs/parser/index.js"
    },
    "./player": {
      "types": "./dist/types/player/index.d.ts",
      "import": "./dist/esm/player/index.mjs",
      "require": "./dist/cjs/player/index.js"
    },
    "./redux": {
      "types": "./dist/types/redux/index.d.ts",
      "import": "./dist/esm/redux/index.mjs",
      "require": "./dist/cjs/redux/index.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest --run",
    "typecheck": "tsc -b --noEmit"
  },
  "prettier": "@code-dot-org/lint-config/prettier/index.mjs",
  "dependencies": {
    "@code-dot-org/blockly-workspace": "workspace:*",
    "@code-dot-org/component-library": "workspace:*",
    "@code-dot-org/component-library-styles": "workspace:*",
    "@code-dot-org/core": "workspace:*",
    "@code-dot-org/fonts": "workspace:*",
    "@code-dot-org/lab": "workspace:*",
    "@code-dot-org/markdown": "workspace:*",
    "@code-dot-org/metrics": "workspace:*",
    "@magenta/music": "^1.23.1",
    "@react-hook/resize-observer": "^2.0.2",
    "@rexxars/react-split-pane": "^1.0.0",
    "events": "^3.3.0",
    "intro.js": "^8.3.2",
    "lodash": "^4.17.21",
    "react-focus-lock": "^2.13.6",
    "react-focus-on": "^3.10.2",
    "tone": "15.1.22"
  },
  "devDependencies": {
    "@code-dot-org/lint-config": "workspace:*",
    "@eslint/js": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/events": "^3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "stylelint": "catalog:",
    "typed-emitter": "^2.1.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "catalog:",
    "vite-plugin-externalize-deps": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
