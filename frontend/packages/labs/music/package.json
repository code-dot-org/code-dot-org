{
  "name": "@code-dot-org/music-lab",
  "version": "0.0.0",
  "private": true,
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/App.d.ts",
      "import": "./dist/App.mjs",
      "require": "./dist/App.cjs"
    },
    "./mocks": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures/index.mjs",
      "require": "./dist/fixtures/index.cjs"
    },
    "./components": {
      "types": "./dist/types/components/index.d.ts",
      "import": "./dist/esm/components/index.mjs",
      "require": "./dist/cjs/components/index.cjs"
    },
    "./parser": {
      "types": "./dist/types/parser/index.d.ts",
      "import": "./dist/esm/parser/index.mjs",
      "require": "./dist/cjs/parser/index.cjs"
    },
    "./player": {
      "types": "./dist/types/player/index.d.ts",
      "import": "./dist/esm/player/index.mjs",
      "require": "./dist/cjs/player/index.cjs"
    },
    "./redux": {
      "types": "./dist/types/redux/index.d.ts",
      "import": "./dist/esm/redux/index.mjs",
      "require": "./dist/cjs/redux/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build && tsc --noEmit",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "stylelint": "stylelint src/**/*.css",
    "stylelint:fix": "yarn run stylelint --fix",
    "test": "vitest --run",
    "typecheck": "tsc -b --noEmit"
  },
  "prettier": "@code-dot-org/lint-config/prettier/index.mjs",
  "stylelint": {
    "extends": "@code-dot-org/lint-config/stylelint/index.mjs"
  },
  "dependencies": {
    "@code-dot-org/blockly": "workspace:*",
    "@code-dot-org/component-library": "workspace:*",
    "@code-dot-org/component-library-styles": "workspace:*",
    "@code-dot-org/core": "workspace:*",
    "@code-dot-org/fonts": "workspace:*",
    "@code-dot-org/lab": "workspace:*",
    "@code-dot-org/progress": "workspace:*",
    "@magenta/music": "^1.23.1",
    "@react-hook/resize-observer": "^2.0.2",
    "@rexxars/react-split-pane": "^1.0.0",
    "events": "^3.3.0",
    "intro.js": "^8.3.2",
    "lodash": "^4.17.21",
    "react-focus-lock": "^2.13.6",
    "react-focus-on": "^3.10.2",
    "tone": "15.1.22",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/events": "^3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "stylelint": "catalog:",
    "typed-emitter": "^2.1.0",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "catalog:",
    "vite-plugin-externalize-deps": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
