{
  "name": "@code-dot-org/lab",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "lab",
    "code.org"
  ],
  "homepage": "https://github.com/code-dot-org/code-dot-org/blob/staging/frontend/packages/labs/base/#readme",
  "bugs": {
    "url": "https://github.com/code-dot-org/code-dot-org/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-dot-org/code-dot-org.git",
    "directory": "frontend/packages/labs/base"
  },
  "license": "SEE LICENSE IN LICENSE",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dialogs": {
      "types": "./dist/dialogs/index.d.ts",
      "import": "./dist/dialogs/index.mjs",
      "require": "./dist/dialogs/index.js"
    },
    "./contexts": {
      "types": "./dist/contexts/index.d.ts",
      "import": "./dist/contexts/index.mjs",
      "require": "./dist/contexts/index.js"
    },
    "./instructions": {
      "types": "./dist/instructions/index.d.ts",
      "import": "./dist/instructions/index.mjs",
      "require": "./dist/instructions/index.js"
    },
    "./interpreter": {
      "types": "./dist/interpreter/index.d.ts",
      "import": "./dist/interpreter/index.mjs",
      "require": "./dist/interpreter/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.mjs",
      "require": "./dist/components/index.js"
    },
    "./resourcePanel": {
      "types": "./dist/resourcePanel/index.d.ts",
      "import": "./dist/resourcePanel/index.mjs",
      "require": "./dist/resourcePanel/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.mjs",
      "require": "./dist/hooks/index.js"
    },
    "./redux": {
      "types": "./dist/redux/index.d.ts",
      "import": "./dist/redux/index.mjs",
      "require": "./dist/redux/index.js"
    },
    "./redux/labSlice": {
      "types": "./dist/redux/labSlice.d.ts"
    },
    "./redux/labViewSlice": {
      "types": "./dist/redux/labViewSlice.d.ts"
    },
    "./redux/labSystemSlice": {
      "types": "./dist/redux/labSystemSlice.d.ts"
    },
    "./redux/labProjectSlice": {
      "types": "./dist/redux/labProjectSlice.d.ts"
    },
    "./redux/predictLevelSlice": {
      "types": "./dist/redux/predictLevelSlice.d.ts"
    },
    "./styles/variables.scss": "./src/components/layout/variables.scss"
  },
  "files": [
    "dist",
    "src/components/layout/variables.scss"
  ],
  "scripts": {
    "build": "vite build && tsc --noEmit",
    "clean": "rimraf dist .turbo",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepack": "clean-package",
    "postpack": "clean-package restore",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "release": "release-it --preRelease=alpha",
    "start": "yarn dev",
    "stylelint": "stylelint src/**/*.{css,scss,sass}",
    "stylelint:fix": "yarn run stylelint --fix",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@code-dot-org/lint-config/prettier/index.mjs",
  "stylelint": {
    "extends": "@code-dot-org/lint-config/stylelint/index.mjs"
  },
  "dependencies": {
    "@code-dot-org/blockly-workspace": "workspace:*",
    "@code-dot-org/component-library": "workspace:*",
    "@code-dot-org/core": "workspace:*",
    "@code-dot-org/fonts": "workspace:*",
    "@code-dot-org/js-interpreter": "^1.3.13",
    "@code-dot-org/platform": "workspace:*",
    "@code-dot-org/teacher-dashboard": "workspace:*",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "@reduxjs/toolkit": "^2.8.2",
    "focus-trap-react": "^11.0.4",
    "intro.js-react": "^1.0.0",
    "lodash": "^4.17.21",
    "markdown-to-jsx": "^7.4.7",
    "qrcode.react": "^4.2.0",
    "query-string": "^9.2.2",
    "react-focus-lock": "^2.13.6",
    "react-redux": "^9.2.0",
    "react-string-replace": "^1.1.1"
  },
  "devDependencies": {
    "@code-dot-org/changelogs": "workspace:*",
    "@code-dot-org/component-library-styles": "workspace:*",
    "@code-dot-org/lint-config": "workspace:*",
    "@eslint/js": "^9.15.0",
    "@release-it/conventional-changelog": "^10.0.0",
    "@swc/core": "^1.9.3",
    "@swc/jest": "^0.2.37",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/identity-obj-proxy": "^3",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4",
    "@types/node": "^22.9.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "axe-playwright": "^2.0.3",
    "classnames": "^2.5.1",
    "clean-package": "^2.2.0",
    "esbuild-sass-plugin": "^3.3.1",
    "eslint": "^9.15.0",
    "eslint-plugin-jest": "^28.9.0",
    "eslint-plugin-react": "^7.37.2",
    "glob": "^11.0.0",
    "globals": "^15.12.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.49",
    "postcss-modules": "^6.0.1",
    "prettier": "3.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "release-it": "^18.1.2",
    "rimraf": "^6.0.1",
    "schema-dts": "^1.1.5",
    "stylelint": "^16.14.1",
    "swiper": "^11.0.5",
    "tsc-alias": "^1.8.11",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^7.2.4",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-externalize-deps": "^0.10.0",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "classnames": "^2.5.1",
    "react": ">=16",
    "react-dom": ">=16",
    "swiper": "^11.0.5"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "clean-package": "./clean-package.config.cjs"
}
