{
  "name": "@code-dot-org/lab",
  "version": "0.1.0",
  "keywords": [
    "lab",
    "code.org"
  ],
  "homepage": "https://github.com/code-dot-org/code-dot-org/blob/staging/frontend/packages/labs/base/#readme",
  "bugs": {
    "url": "https://github.com/code-dot-org/code-dot-org/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-dot-org/code-dot-org.git",
    "directory": "frontend/packages/labs/base"
  },
  "license": "SEE LICENSE IN LICENSE",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "src/index.ts",
  "files": [
    "dist"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js"
    },
    "./dialogs": {
      "types": "./dist/types/dialogs/index.d.ts",
      "import": "./dist/esm/dialogs/index.mjs",
      "require": "./dist/cjs/dialogs/index.js"
    },
    "./contexts": {
      "types": "./dist/types/contexts/index.d.ts",
      "import": "./dist/esm/contexts/index.mjs",
      "require": "./dist/cjs/contexts/index.js"
    },
    "./redux": {
      "types": "./dist/types/redux/index.d.ts",
      "import": "./dist/esm/redux/index.mjs",
      "require": "./dist/cjs/redux/index.js"
    },
    "./redux/labSlice": {
      "types": "./dist/types/redux/labSlice.d.ts"
    },
    "./redux/labSystemSlice": {
      "types": "./dist/types/redux/labSystemSlice.d.ts"
    },
    "./redux/labProjectSlice": {
      "types": "./dist/types/redux/labProjectSlice.d.ts"
    },
    "./redux/predictLevelSlice": {
      "types": "./dist/types/redux/predictLevelSlice.d.ts"
    }
  },
  "scripts": {
    "build": "tsup --clean",
    "storybook:build": "storybook build -o dist/storybook",
    "storybook:dev": "yarn run storybook",
    "storybook": "storybook dev -p 6006",
    "clean": "rimraf dist .turbo",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepack": "clean-package",
    "postpack": "clean-package restore",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "release": "release-it --preRelease=alpha",
    "start": "yarn dev",
    "stylelint": "stylelint src/**/*.{css,scss,sass}",
    "stylelint:fix": "yarn run stylelint --fix",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@code-dot-org/lint-config/prettier/index.mjs",
  "stylelint": {
    "extends": "@code-dot-org/lint-config/stylelint/index.mjs"
  },
  "dependencies": {
    "@code-dot-org/api": "workspace:*",
    "@code-dot-org/blockly-workspace": "workspace:*",
    "@code-dot-org/component-library": "workspace:*",
    "@code-dot-org/fonts": "workspace:*",
    "@code-dot-org/markdown": "workspace:*",
    "@code-dot-org/metrics": "workspace:*",
    "@code-dot-org/projects": "workspace:*",
    "@code-dot-org/redux": "workspace:*",
    "@code-dot-org/teacher-dashboard": "workspace:*",
    "@code-dot-org/user": "workspace:*",
    "@reduxjs/toolkit": "^2.8.2",
    "focus-trap-react": "^11.0.4",
    "lodash": "^4.17.21",
    "qrcode.react": "^4.2.0",
    "query-string": "^9.2.2",
    "react-focus-lock": "^2.13.6",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@code-dot-org/changelogs": "workspace:*",
    "@code-dot-org/lint-config": "workspace:*",
    "@eslint/js": "^9.15.0",
    "@release-it/conventional-changelog": "^10.0.0",
    "@storybook/addon-a11y": "^8.6.9",
    "@storybook/addon-essentials": "^8.6.9",
    "@storybook/addon-interactions": "^8.6.9",
    "@storybook/addon-storysource": "^8.6.9",
    "@storybook/addon-styling-webpack": "^1.0.1",
    "@storybook/addon-webpack5-compiler-swc": "^3.0.0",
    "@storybook/blocks": "^8.6.9",
    "@storybook/react": "^8.6.9",
    "@storybook/react-webpack5": "^8.6.9",
    "@storybook/test": "^8.6.9",
    "@storybook/test-runner": "^0.22.0",
    "@swc/core": "^1.9.3",
    "@swc/jest": "^0.2.37",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/identity-obj-proxy": "^3",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "axe-playwright": "^2.0.3",
    "classnames": "^2.5.1",
    "clean-package": "^2.2.0",
    "esbuild-sass-plugin": "^3.3.1",
    "eslint": "^9.15.0",
    "eslint-plugin-jest": "^28.9.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-storybook": "^0.11.1",
    "glob": "^11.0.0",
    "globals": "^15.12.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.49",
    "postcss-modules": "^6.0.1",
    "prettier": "3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "release-it": "^18.1.2",
    "rimraf": "^6.0.1",
    "schema-dts": "^1.1.5",
    "storybook": "^8.6.9",
    "storybook-addon-rtl": "^1.0.1",
    "stylelint": "^16.14.1",
    "swiper": "^11.0.5",
    "tsc-alias": "^1.8.11",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.15.0"
  },
  "peerDependencies": {
    "classnames": "^2.5.1",
    "react": ">=16",
    "react-dom": ">=16",
    "swiper": "^11.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "clean-package": "./clean-package.config.cjs"
}
