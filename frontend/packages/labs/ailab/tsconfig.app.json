{
  "extends": "@code-dot-org/lint-config/typescript/tsconfig.vite.app.json",
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "resolveJsonModule": true,
    // apps compiles JSX with the classic runtime; match it here so the move
    // does not have to touch every component.
    "jsx": "react",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"]
}
