{
  "name": "@code-dot-org/sprite-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Sprite Lab, the Lab2 Blockly lab for building scenes and games with sprites",
  "homepage": "https://github.com/code-dot-org/code-dot-org/blob/staging/frontend/packages/labs/sprite/#readme",
  "bugs": {
    "url": "https://github.com/code-dot-org/code-dot-org/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-dot-org/code-dot-org.git",
    "directory": "frontend/packages/labs/sprite"
  },
  "license": "SEE LICENSE IN LICENSE",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./mocks": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures/index.mjs",
      "require": "./dist/fixtures/index.cjs"
    },
    "./sprites": {
      "types": "./dist/sprites/index.d.ts",
      "import": "./dist/sprites/index.mjs",
      "require": "./dist/sprites/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "preview": "vite preview",
    "stylelint": "stylelint --allow-empty-input \"src/**/*.{css,scss,sass}\"",
    "stylelint:fix": "yarn run stylelint --fix",
    "test": "vitest --run",
    "test:ui": "playwright test",
    "test:ui:ci": "CI=true playwright test",
    "test:visual:prove": "prove-visual",
    "typecheck": "tsc -b --noEmit"
  },
  "prettier": "@code-dot-org/lint-config/prettier/index.mjs",
  "stylelint": {
    "extends": "@code-dot-org/lint-config/stylelint/index.mjs"
  },
  "dependencies": {
    "@blockly/field-bitmap": "^13.3.0",
    "@blockly/field-grid-dropdown": "^13.3.0",
    "@code-dot-org/audio": "workspace:*",
    "@code-dot-org/blockly": "workspace:*",
    "@code-dot-org/core": "workspace:*",
    "@code-dot-org/lab": "workspace:*",
    "@reduxjs/toolkit": "catalog:",
    "blockly": "^13.1.0",
    "md5": "^2.3.0",
    "p5": "^2.3.4"
  },
  "devDependencies": {
    "@code-dot-org/lint-config": "workspace:*",
    "@code-dot-org/playwright-support": "workspace:*",
    "@emotion/react": "catalog:",
    "@emotion/styled": "catalog:",
    "@mui/material": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/md5": "^2.3.5",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "acorn": "^8.15.0",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vite-plugin-externalize-deps": "catalog:",
    "vitest": "catalog:",
    "vitest-canvas-mock": "^1.1.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/material": "^7.0.0",
    "@tanstack/react-query": "*",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  }
}
