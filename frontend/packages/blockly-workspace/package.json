    "@types/identity-obj-proxy": "^3",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "classnames": "^2.5.1",
    "clean-package": "^2.2.0",
    "eslint": "^9.15.0",
    "glob": "^11.0.0",
    "globals": "^15.12.0",
    "identity-obj-proxy": "^3.0.0",
