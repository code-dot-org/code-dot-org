    "@blockly/theme-highcontrast": "^7.0.3",
    "@code-dot-org/fonts": "workspace:*",
    "@code-dot-org/markdown": "workspace:*",
    "@mantine/hooks": "^8.3.13",
    "blockly": "12.2.0"
  },
  "devDependencies": {
