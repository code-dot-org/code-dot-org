{
  "name": "@code-dot-org/widgets-catalog",
  "version": "0.0.0",
  "private": true,
  "description": "Reviewed, versioned widget artifacts graduated from Author Mode's authoring session. One esbuild pipeline (buildWidget) and one contract-gate check (checkWidgetDocument) serve both the authoring service and this package's own catalog build/CI gate, so the two can never disagree about what a valid widget is.",
  "homepage": "https://github.com/code-dot-org/code-dot-org/blob/staging/frontend/packages/widgets-catalog/#readme",
  "bugs": {
    "url": "https://github.com/code-dot-org/code-dot-org/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-dot-org/code-dot-org.git",
    "directory": "frontend/packages/widgets-catalog"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build && tsc --noEmit && tsx scripts/buildCatalog.ts",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test": "vitest --run",
    "test:gates": "tsx scripts/testGates.ts",
    "typecheck": "tsc -b --noEmit",
    "widgets:rehash": "tsx scripts/rehash.ts"
  },
  "prettier": "@code-dot-org/lint-config/prettier/index.mjs",
  "dependencies": {
    "esbuild": "0.25.12",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@code-dot-org/component-library": "workspace:*",
    "@code-dot-org/lint-config": "workspace:*",
    "@code-dot-org/widget-runtime": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vite-plugin-externalize-deps": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@code-dot-org/component-library": "*",
    "@code-dot-org/widget-runtime": "*",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
