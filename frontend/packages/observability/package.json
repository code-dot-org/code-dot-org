    "@code-dot-org/lint-config": "workspace:*",
    "@datadog/browser-logs": "^6.31.0",
    "@datadog/browser-rum": "^6.31.0",
    "@sentry/browser": "*",
    "@types/node": "^20",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.1",
    "fast-check": "^3.0.0",
    "prettier": "3.4.2",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4",
