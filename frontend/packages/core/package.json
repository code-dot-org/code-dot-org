{
  "name": "@code-dot-org/core",
  "version": "0.0.0",
  "private": true,
  "keywords": [
    "design-system",
    "code.org"
  ],
  "homepage": "https://github.com/code-dot-org/code-dot-org/blob/staging/frontend/packages/core/#readme",
  "bugs": {
    "url": "https://github.com/code-dot-org/code-dot-org/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-dot-org/code-dot-org.git",
    "directory": "frontend/packages/core"
  },
  "license": "SEE LICENSE IN LICENSE",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.mjs",
      "require": "./dist/api/index.js"
    },
    "./localization": {
      "types": "./dist/plugins/localization/index.d.ts",
      "import": "./dist/plugins/localization/index.mjs",
      "require": "./dist/plugins/localization/index.cjs"
    },
    "./observability": {
      "types": "./dist/plugins/observability/index.d.ts",
      "import": "./dist/plugins/observability/index.mjs",
      "require": "./dist/plugins/observability/index.cjs"
    }
  },
  "scripts": {
    "build": "vite build && tsc --noEmit",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@code-dot-org/lint-config/prettier/index.mjs",
  "dependencies": {
    "tldts": "^7.0.23"
  },
  "devDependencies": {
    "@code-dot-org/lint-config": "workspace:*",
    "@sentry/browser": "^10.46.0",
    "@types/node": "^20",
    "@types/tldjs": "^2",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "ky": "^1.14.3",
    "prettier": "3.4.2",
    "react": "^19.2.0",
    "typescript": "~5.9.3",
    "uuid": "^11.1.0",
    "vite": "^7.2.4",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-externalize-deps": "^0.10.0",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "@sentry/browser": "^10.46.0",
    "ky": "^1.14.3",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "uuid": "^11.1.0"
  }
}
