{
  "name": "@code-dot-org/metrics",
  "version": "0.1.0",
  "keywords": [
    "lab",
    "code.org"
  ],
  "homepage": "https://github.com/code-dot-org/code-dot-org/blob/staging/frontend/packages/metrics/#readme",
