    "prettier": "3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "release-it": "^18.1.2",
    "rimraf": "^6.0.1",
    "schema-dts": "^1.1.5",
    "stylelint": "^16.14.1",
    "swiper": "^11.0.5",
