{
  "name": "@code-dot-org/playwright-support",
  "version": "0.0.0",
  "private": true,
  "description": "Shared Playwright test support — fixtures, config helpers, and scripts for code.org frontend packages.",
  "keywords": [
    "playwright",
    "testing",
    "visual-regression",
    "code.org"
  ],
  "homepage": "https://github.com/code-dot-org/code-dot-org/blob/staging/frontend/packages/playwright-support/#readme",
  "bugs": {
    "url": "https://github.com/code-dot-org/code-dot-org/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-dot-org/code-dot-org.git",
    "directory": "frontend/packages/playwright-support"
  },
  "license": "SEE LICENSE IN LICENSE",
  "exports": {
    "./visual": {
      "types": "./dist/visual/index.d.ts",
      "import": "./dist/visual/index.mjs",
      "require": "./dist/visual/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "prove-visual": "./bin/prove-visual.mjs"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@code-dot-org/lint-config/prettier/index.mjs",
  "dependencies": {
    "@applitools/eyes-playwright": "^1.34.0"
  },
  "devDependencies": {
    "@code-dot-org/lint-config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vite-plugin-externalize-deps": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "playwright": "1.59.1"
  }
}
