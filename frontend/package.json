{
  "name": "@code-dot-org/frontend",
  "private": true,
  "homepage": "https://github.com/code-dot-org/code-dot-org/blob/staging/frontend/#readme",
  "bugs": {
    "url": "https://github.com/code-dot-org/code-dot-org/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-dot-org/code-dot-org.git",
    "directory": "frontend"
  },
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/labs/*"
  ],
  "scripts": {
    "build": "TURBO_TELEMETRY_DISABLED=1 turbo build",
    "clean": "TURBO_TELEMETRY_DISABLED=1 turbo clean",
    "dev": "TURBO_TELEMETRY_DISABLED=1 turbo watch dev --filter @code-dot-org/studio",
    "format": "prettier --check *",
    "format:fix": "prettier --write .",
    "lint": "TURBO_TELEMETRY_DISABLED=1 turbo lint",
    "lint:fix": "TURBO_TELEMETRY_DISABLED=1 turbo lint:fix",
    "release:dryrun": "TURBO_TELEMETRY_DISABLED=1 turbo release:dryrun",
    "start": "yarn dev",
    "test": "TURBO_TELEMETRY_DISABLED=1 turbo test",
    "test:ui:ci": "TURBO_TELEMETRY_DISABLED=1 turbo test:ui:ci",
    "test:ui:local": "TURBO_TELEMETRY_DISABLED=1 turbo test:ui:local",
    "test:unit": "yarn test",
    "typecheck": "TURBO_TELEMETRY_DISABLED=1 turbo typecheck"
  },
  "prettier": "@code-dot-org/lint-config/prettier/index.mjs",
  "resolutions": {
    "vite": "7.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "catalog:",
    "@turbo/gen": "^2.6.3",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "rimraf": "catalog:",
    "turbo": "^2.9.14",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": ">=20"
  }
}
