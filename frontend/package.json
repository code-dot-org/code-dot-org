{
  "name": "@code-dot-org/frontend",
  "private": true,
  "homepage": "https://github.com/code-dot-org/code-dot-org/blob/staging/frontend/#readme",
  "bugs": {
    "url": "https://github.com/code-dot-org/code-dot-org/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-dot-org/code-dot-org.git",
    "directory": "frontend"
  },
  "license": "SEE LICENSE IN LICENSE",
  "sideEffects": [
    "**/*.css"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "clean": "turbo clean",
    "clean:deps": "rm -rf node_modules && pnpm -r exec rm -rf node_modules",
    "dev": "turbo watch dev --filter @code-dot-org/studio",
    "format": "prettier --check *",
    "format:fix": "prettier --write .",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "release:dryrun": "turbo release:dryrun",
    "start": "pnpm dev",
    "test": "turbo test",
    "test:ui:ci": "turbo test:ui:ci",
    "test:ui:local": "turbo test:ui:local",
    "test:unit": "pnpm test",
    "typecheck": "turbo typecheck"
  },
  "prettier": "@code-dot-org/lint-config/prettier/index.mjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@code-dot-org/lint-config": "workspace:*",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "eslint": "^9.39.1",
    "lint-staged": "^15.4.3",
    "prettier": "3.4.2",
    "prettier-plugin-packagejson": "^2.5.19",
    "rimraf": "^6.0.1",
    "turbo": "^2.6.3",
    "typescript": "5.8.2",
    "typescript-eslint": "^8.49.0"
  },
  "packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b",
  "engines": {
    "node": ">=20"
  }
}
