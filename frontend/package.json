{
  "name": "@code-dot-org/frontend",
  "private": true,
  "homepage": "https://github.com/code-dot-org/code-dot-org/blob/staging/frontend/#readme",
  "bugs": {
    "url": "https://github.com/code-dot-org/code-dot-org/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-dot-org/code-dot-org.git",
    "directory": "frontend"
  },
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "build": "turbo build",
    "clean": "turbo clean",
    "dev": "turbo dev",
    "format": "prettier --check *",
    "format:fix": "prettier --write .",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "release:dryrun": "turbo release:dryrun",
    "start": "pnpm dev",
    "test": "turbo test",
    "test:ui:ci": "turbo test:ui:ci",
    "test:ui:local": "turbo test:ui:local",
    "test:unit": "pnpm test",
    "typecheck": "turbo typecheck"
  },
  "prettier": "@code-dot-org/lint-config/prettier/index.mjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.56.1",
    "lint-staged": "^15.4.3",
    "prettier": "3.4.2",
    "prettier-plugin-packagejson": "^2.5.19",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.0",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.22.0+sha1.3e9e4d522d30f3cf4cabb7506f5d15b89feffd04"
}
