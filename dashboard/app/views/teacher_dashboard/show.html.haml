- @page_title = I18n.t('teacher.dashboard')

%link{href: asset_path('css/scripts.css'), rel: 'stylesheet', type: 'text/css'}
%link{href: asset_path('css/courses.css'), rel: 'stylesheet', type: 'text/css'}

-# When the codeai-brand logo morph animation will run on initial load,
-# pre-hide the Rails-rendered header logo so users don't see it flash
-# before the React modal mounts. The LogoTransition component removes
-# this <style> tag when it unmounts (i.e., user navigates away from /home).
- if Cdo::Brand.current_brand_code(request) == Cdo::Brand::BRAND_CODEAI && request.path.end_with?('/teacher_dashboard/home')
  %style#logo-transition-pre-hide
    :plain
      #header_logo_container img { visibility: hidden; }

:ruby
  teacher_dashboard_data = {}
  teacher_dashboard_data[:studioUrlPrefix] = CDO.studio_url('', CDO.default_scheme)
  teacher_dashboard_data[:sections] = @sections
  teacher_dashboard_data[:sectionOrder] = @section_order
  teacher_dashboard_data[:section] = @section_summary
  teacher_dashboard_data[:currentUserId] = @current_user.id
  teacher_dashboard_data[:userName] = @current_user.short_name
  teacher_dashboard_data[:localeCode] = I18n.locale.to_s
  teacher_dashboard_data[:showAITALessonSummary] = DCDO.get('show-aita-lesson-summaries', false)
  teacher_dashboard_data[:showAITAPodcasts] = DCDO.get('ai-lesson-summary-podcasts', false)
  teacher_dashboard_data[:hasCompletedPersonalizationQuiz] = @current_user.present? && TeachingProfileData.find_by(user: @current_user).present?
  teacher_dashboard_data[:providers] = @current_user.providers
  teacher_dashboard_data[:flash] = @flash if @flash.present?
  if Cdo::Brand.current_brand_code(request) == Cdo::Brand::BRAND_CODEAI
    teacher_dashboard_data[:logoTransitionGifUrl] = asset_path('code2-logo-transition.gif')
    teacher_dashboard_data[:logoSvgUrl] = asset_path('code2-logo-inverse.svg')
  end

= render partial: 'shared/emulate_print_media'

%script{src: webpack_asset_path('js/teacher_dashboard/show.js'), data: {dashboard: teacher_dashboard_data.to_json}}

- if current_user
  - if current_user.admin
    = render partial: 'home/admin'
  - if current_user.teacher? && !current_user.accepted_latest_terms?
    - current_user.update_user_tos_version_accept()
    = render partial: 'layouts/implicit_new_user_terms_interstitial'

#teacher-dashboard
