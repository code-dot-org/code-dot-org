-#
-# NOTE: wrap asset paths in to_code_studio_url() so they are served off studio.code.org instead of preview.codeprojects.org
-# as preview.codeprojects.org is reserved for student paths.
-#
<!DOCTYPE html>
%html
  %head
    = javascript_include_tag 'application', 'data-ot-ignore' => ''
    -# webpack-runtime.js must appear exactly once on any page containing webpack entries
    %script{src: to_code_studio_url(webpack_asset_path('js/webpack-runtime.js')), 'data-ot-ignore' => ''}
    %script{src: to_code_studio_url(webpack_asset_path("js/codeprojects_preview/show.js"))}
    -# These files are generated by Webpack's SplitChunksPlugin,
    -# which we only use when optimizing our webpack build (ie, non-development environments).
    - if CDO.optimize_webpack_assets
      %script{src: to_code_studio_url(webpack_asset_path('js/vendors.js')), 'data-ot-ignore' => ''}
      %script{src: to_code_studio_url(webpack_asset_path('js/code-studio-common.js')), 'data-ot-ignore' => ''}
    -# Import brand fonts
    %link{rel: "stylesheet", href: to_code_studio_url("shared/css/fonts/barlow-semi-condensed.scss"), media: "all"}
    %link{rel: "stylesheet", href: to_code_studio_url("shared/css/fonts/figtree.scss"), media: "all"}

  -# Remove default body margin and padding to prevent empty state spacing issues
  %body{style: 'margin:0; padding:0;'}
    #codeprojects-preview-container

