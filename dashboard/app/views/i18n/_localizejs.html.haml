-# Loads the LocalizeJS widget, but only on LocalizeJS pages. The backend
-# renders these pages in English (see ApplicationController) and hands the
-# widget its project key and the language to switch to (the LocalizeJS code for
-# the visitor's locale / Global Edition region) here; the widget swaps the page
-# into that language client-side. @localizejs_project_key is nil on all other
-# pages.
- if @localizejs_project_key
  %script{src: webpack_asset_path("js/localization.js"), 'data-ot-ignore' => '', data: {localizejs: {projectKey: @localizejs_project_key, language: @localizejs_language}.to_json}}
