  %script{id: "localize-js", src: "https://global.localizecdn.com/localize.js", data: { locale: I18n.locale, blah: "foo", jslocale: request.env['cdo.locale'], path: request.path, prefixes: { "MlKri360o3v2T": csd_prefixes, "I0P5RaUEW8s5h": donor_prefixes, "3vPUSGZrdllW2": unplugged_prefixes, }.to_json}}
  :javascript
    // Currently, restrict the localize widget to these pages
    window.forcedLocale = "en-US";
    const prefixes = JSON.parse(document.querySelector("script#localize-js").getAttribute("data-prefixes"));
    console.log(prefixes);

    const projectKeys = Object.entries(prefixes).filter(([projectId, prefixes]) => prefixes.filter((prefix) => window.location.pathname.startsWith(prefix)).length > 0);

    if (projectKeys.length > 0) {
      console.log(projectKeys[0][0]);
      !function(a){if(!a.Localize){a.Localize={};for(var e=["translate","untranslate","phrase","initialize","translatePage","setLanguage","getLanguage","getSourceLanguage","detectLanguage","getAvailableLanguages","setWidgetLanguages","hideLanguagesInWidget","untranslatePage","bootstrap","prefetch","on","off","hideWidget","showWidget"],t=0;t<e.length;t++)a.Localize[e[t]]=function(){}}}(window);

      Localize.initialize({
        key: projectKeys[0][0],
        rememberLanguage: true,
        retranslateOnNewPhrases: true,
      });

      // Add a custom function to Localize:
      Localize.realSetLanguage = Localize.setLanguage;
      Localize.cdoCallbacks = [];
      Localize.cdoSetLanguage = (language) => {
        const lang = language.split("-")[0];

        // Our internal language codes do not always match LocalizeJS
        const mapping = {
          "fa-IR": "fa",
          "en-US": "en",
        };

        // Call LocalizeJS's setLanguage function (which we have renamed to override it)
        Localize.realSetLanguage(mapping[language] || language);
        document.querySelector("html").setAttribute("dir", ["fa"].includes(lang) ? "rtl" : "ltr");

        // Craft the inverse map so we can get our internal language code from LocalizeJS's code
        const inverseMapping = {};
        for (const key in mapping) {
          if (Object.hasOwnProperty.call(mapping, key)) {
            inverseMapping[mapping[key]] = key;
          }
        }
        const cdoLanguage = language === "source" ? "en-US" : inverseMapping[language] || language;

        const ensureSelector = (cdoLanguage) => {
          const localeSelect = document.querySelector("#locale");
          if (localeSelect) {
            localeSelect.selectedIndex = localeSelect.querySelector("option[value='" + cdoLanguage + "']").index;
          }
        };

        // This function ensures that the dropdowns show the requested language
        const handleChange = (event) => {
          console.log("handleChange:", event.target, event.target.selectedOptions[0]);
          Localize.cdoSetLanguage(event.target.selectedOptions[0].value);
          event.stopPropagation();
          event.preventDefault();
        };

        // When the site loads, ensure the language selector has the correct value
        document.addEventListener('DOMContentLoaded', () => {
          const localeSelect = document.querySelector("#locale");
          if (localeSelect) {
            localeSelect.addEventListener('change', handleChange);
          }
          console.log(cdoLanguage);
          console.log("looking for select");
          ensureSelector(cdoLanguage);
        });

        // Translate everything in the Blockly message pool
        ensureSelector(cdoLanguage);
      };

      Localize.on('setLanguage', () => {
        console.log("language set ... looking for blockly");
        Localize.Blockly ||= {};
        Localize.Blockly.Msg ||= {};
        Localize.Blockly.Variables ||= {}
        Localize.Blockly.ReverseVariables ||= {}

        console.log(window?.Blockly?.WorkspaceSvg?.prototype?.clear);

        // Hook into the blockly clear function
        if (window?.Blockly?.WorkspaceSvg?.prototype?.clear) {
        }

        for (const [key, value] of Object.entries(window?.Blockly?.Msg || {})) {
          //console.log(Localize.phrase(value));
          Localize.Blockly.Msg[key] ||= Blockly.Msg[key];
          const dummy = document.createElement("span");
          dummy.setAttribute("data-localize", "blockly-block");
          dummy.textContent = Localize.Blockly.Msg[key];
          Blockly.Msg[key] = Localize.translate(dummy).textContent;
        }
        console.log(Blockly.Msg);

        const refreshWorkspace = (workspace) => {
          const xml = Blockly.Xml.workspaceToDom(workspace);

          // First, remove any global variables (those will be reloaded via the xml)
          // Otherwise, the clear will add them prior to loading and there will be
          // conflicts.
          let variables = workspace.globalVariables;
          variables = [];
          if (variables) {
            workspace.globalVariables = [];

            // Rename the variables to their traditional names
            variables = variables.map((varName) => {
              // Retain the original variable names on first load
              Localize.Blockly.Variables[varName] ||= varName;

              // Convert the names back, if needed
              if (Localize.Blockly.ReverseVariables[varName]) {
                const variable = workspace.getVariable(varName);
                const oldName = Localize.Blockly.ReverseVariables[varName];
                delete Localize.Blockly.ReverseVariables[varName];
                workspace.renameVariableById(variable.getId(), oldName);
                return oldName;
              }

              return varName;
            });
          }
          Blockly.Xml.clearWorkspaceAndLoadFromXml(xml, workspace);
          if (variables) {
            workspace.globalVariables = variables;

            // Add global variables with their traditional names
            workspace.getVariableMap().addVariables(variables);

            // Rename global variables
            workspace.globalVariables = variables.map((varName) => {
              const variable = workspace.getVariable(varName);
              console.log("GLOBAL VARIABLE:", variable);
              const newName = Localize.translate(varName);

              // Keep track of how to verse this name
              Localize.Blockly.ReverseVariables[newName] ||= varName;
              workspace.renameVariableById(variable.getId(), newName);
              return newName;
            });
          }

          // Handle the toolbox
          const toolbox = workspace.getToolbox(true);
          if (toolbox) {
            // Close the toolbox when it exists
            toolbox.clearSelection();
          }

          // Handle the flyout as well
          const flyout = workspace.getFlyout(true);
          if (flyout) {
            // Redraw the flyout
            flyout.show(workspace.options.languageTree);
            // Scroll the flyout to the start
            if (typeof flyout.scrollToStart === 'function') {
              flyout.scrollToStart();
            }
          }
        };

        console.log("refresh???");
        if (window.Blockly?.getMainWorkspace?.()) {
          console.log("refresh!");
          refreshWorkspace(Blockly.getMainWorkspace());
          Blockly.embeddedWorkspaces.forEach((workspace_id) => {
            const workspace = Blockly.Workspace.getById(workspace_id);
            if (workspace) {
              refreshWorkspace(workspace);
            }
          });
        }
      });

      // Just in case... any other calls to the Localize setLanguage will also hit
      // our custom code which also ensures the site dropdowns match
      Localize.setLanguage = Localize.cdoSetLanguage;

      // Ensure we are setting the correct direction on our <html> tag
      console.log("localizejs: current language:", Localize.getLanguage());
      Localize.cdoSetLanguage(Localize.getLanguage());
      Localize.showWidget();
    }
