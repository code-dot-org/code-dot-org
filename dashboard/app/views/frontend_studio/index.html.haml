!!!
%html{data: {brand: Cdo::Brand.current_brand_code(request)}}
  %head
    %meta{name: 'viewport', content: 'width=device-width, initial-scale=1'}
    = csrf_meta_tags
    = csp_meta_tag
    %meta{name: 'app-config', content: frontend_app_config(CDO.frontend_studio_sentry_dsn)}
    - page_flash = page_flash_json
    - if page_flash
      %meta{name: 'page-flash', content: page_flash}
    = render_shared_haml 'onetrust_cookie_scripts', dashboard: true, domain: 'code.org'
    -# Google's stock tag. The measurement id is synced with layouts/_google_analytics.html.haml.
    %script{async: '', src: 'https://www.googletagmanager.com/gtag/js?id=G-L9HT5MZ3HD'}
    :javascript
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-L9HT5MZ3HD');
    = vite_client_tag
    = vite_react_refresh_tag

    = vite_typescript_tag 'application.tsx'
  %body
    %div{id: 'vite-root'}
