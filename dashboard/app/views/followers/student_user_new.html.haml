- content_for(:head) do
  %meta{name: "robots", content: "noindex"}/

:ruby
  join_section_data = {
    submitPath: student_user_new_path,
    authenticityToken: form_authenticity_token,
    sectionCode: params[:section_code],
    title: t('join_section.code.title'),
    instructions: t('join_section.code.instructions'),
    placeholder: t('join_section.code.placeholder'),
    submitLabel: t('join_section.code.submit'),
    inlineAlert: inline_alert,
    displayCaptcha: (current_user.present? && current_user.display_join_section_captcha?),
    recaptchaSiteKey: CDO.recaptcha_site_key
  }.to_json

%script{src: webpack_asset_path('js/followers/student_user_new.js'), data: {joinsection: join_section_data}}

