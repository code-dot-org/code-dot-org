%h1.control-legend{data: {toggle: "collapse", target: "#ai-tutor-prompt-settings-container"}}
  AI Tutor Prompt Settings

#ai-tutor-prompt-settings-container.in.collapse
  #ai-tutor-prompt-settings-editor

- content_for :body_scripts do
  %script{src: webpack_asset_path('js/levels/editors/fields/_ai_tutor_prompt_settings.js'),
        data: {answertypes: @level.properties["ai_tutor_prompt_answer_types"] || "[]", legacymode: @level.properties["ai_tutor_mode"]}}