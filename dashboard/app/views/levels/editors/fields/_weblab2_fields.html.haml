%h1.control-legend{data: {toggle: "collapse", target: "#weblab2_fields"}}
  Web Lab 2 Fields

#weblab2_fields.in.collapse
  .field
    = render partial: 'levels/editors/fields/checkboxes', locals: {f: f, field_name: :require_edit_to_continue, description: "Require student to edit code before continuing"}

  .field
    = render partial: 'levels/editors/fields/checkboxes', locals: {f: f, field_name: :ai_tutor_optional, description: "AI Tutor is optional on this level"}
    %p
      Check this when the curriculum does not ask students to use AI Tutor on
      this level. The tutor is still available, but a course containing only
      such Web Lab 2 levels no longer reports that it requires AI chat tools
      to complete, and students whose section allows AI chat tools only where
      they are essential will not be able to use the tutor here.

  .field
    = f.label :initial_view_mode, 'Initial View Mode'
    = f.select :initial_view_mode, options_for_select(@level.class.view_modes, @level.initial_view_mode)
    %p Allows setting the initial view mode when the level is loaded, which can be:
    %ul
      %li
        %strong Split mode (default):
        shows both code editing and HTML preview in a split view.
      %li
        %strong Preview only:
        Shows HTML preview only.
      %li
        %strong Code only:
        Shows code editor only.
    %p Students can switch between modes using buttons in the header.

  .field
    = f.label :level_system_prompt, 'Level System Prompt'
    %p Optional addition to the system prompt for AI Tutor. This will be deprecated at the end of the AIF Semester 2 pilot!
    = f.text_area :level_system_prompt, placeholder: 'Level system prompt', rows: 4, style: 'width: 50%', value: @level.level_system_prompt
