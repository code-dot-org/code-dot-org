.field
  = f.label :text_to_speech_overrides
  %p By default, Text-to-Speech will use the Instructions text as its source. You can override here if you wish to tweak the pronunciation.
  .row
    - unless (@level.is_a?(Applab) || @level.instance_of?(Gamelab) || @level.is_a?(Weblab) || @level.is_a?(Javalab)) || @level.is_a?(Aichat) || @level.is_a?(Music)
      .col-md-6
        %h5 Short Instructions
        = f.text_area :tts_short_instructions_override, placeholder: '', rows: 4, class:"form-control"
    .col-md-6
      %h5 Long Instructions
      = f.text_area :tts_long_instructions_override, placeholder: '', rows: 4, class:"form-control"
