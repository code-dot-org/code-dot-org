%h1.control-legend{data: {toggle: "collapse", target: "#adaptive-fields"}}
  Adaptive

#adaptive-fields.in.collapse
  .form-group
    = f.label :adaptive_id, 'Content ID'
    = f.select :adaptive_id, AdaptiveContent.ids, {include_blank: true}, class: 'form-control'
    %p.help-block
      Picks the content file under dashboard/config/level_content/adaptive. New content files must be added in the repo.

  - if @level.persisted? && AdaptiveContent.exist?(@level.adaptive_id)
    .form-group#adaptive-content-editor{data: {saved_adaptive_id: @level.adaptive_id}}
      = f.label :adaptive_content_json, "Content (#{@level.adaptive_id}.json)"
      %p.help-block
        Saving this level writes this JSON to
        %code= "dashboard/config/level_content/adaptive/#{@level.adaptive_id}.json"
      %p.help-block
        This file is shared by:
        = safe_join(@level.sharing_levels.map {|level| link_to level.name, edit_level_path(level)}, ', ')
      %p.help-block#adaptive-content-locked{style: 'display: none; color: #b00'}
        The Content ID has changed. Save the level to edit the new content.
      = f.text_area :adaptive_content_json, rows: 30, value: File.read(AdaptiveContent.path(@level.adaptive_id))

= render partial: 'levels/editors/fields/audit_log', locals: {f: f}

%script{src: webpack_asset_path('js/levels/editors/_adaptive.js')}
