- require 'policies/lti'
- if Policies::StudentBadges.authentication_enabled?
  = render 'shared/badge_link', href: badge_login_path, label: t('student_badges.title')
%link{href: "/shared/css/2022-rebrand-update.css", rel: "stylesheet"}
%script{src: webpack_asset_path('js/devise/sessions/new.js')}

- if Policies::Lti.lti_registration_in_progress?(session)
  = render 'login_lti_account_linking', lms_name: params[:lms_name]
- else
  = render 'login'
