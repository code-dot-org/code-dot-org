-# Mount node for the React ShareLogo (apps/src/code-studio/components/shareLogo).
-# Rendered only on share pages via view_options[:code_studio_logo]. The logo
-# image is chosen client-side from the current theme; the home link target is
-# passed through as a data attribute.
%div{id: 'main-logo', data: {'home-url': current_user ? '/home' : CDO.code_org_url}}
