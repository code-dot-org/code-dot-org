%div{id: 'main-logo'}
  - if current_user
    = link_to(image_tag(Cdo::Brand.header_logo_filename(request)), '/home', {id: "logo-img", alt: Cdo::Brand.logo_alt_text(request)})
  - else
    = link_to(image_tag(Cdo::Brand.header_logo_filename(request)), CDO.code_org_url, {id: "logo-img", alt: Cdo::Brand.logo_alt_text(request)})
