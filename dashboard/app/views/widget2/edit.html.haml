%h1 Widget2 Edit

%h2 Widgets
- @directories.each do |directory|
  .field
    %a{href: directory[:url]}= directory[:name]

%h3 New Widget
= form_with url: "/widget2/new", method: :post do |f|
  .field
    = f.label "New widget2 ID:"
    = f.text_field :id, placeholder: "e.g. mywidget1", maxlength: 25, style: "width: 200px", pattern: "[a-z0-9_-]+", title: "Lowercase letters, numbers, underscores, and hyphens only"
  .field
    = f.submit "Create widget2", class: "btn"
