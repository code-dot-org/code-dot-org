<div style="background-color:#000000; border-radius:12px; padding:20px; margin:20px auto; max-width:90%; overflow-x:auto;">

<pre style="margin:0; background-color:#000000; font-family:Consolas, Monaco, 'Courier New', monospace; font-size:14px; line-height:1.5; color:#f8f8f2;">

<span style="color:#ff6b6b;">runBtn</span>.<span style="color:#4dabf7;">addEventListener</span>(<span style="color:#69db7c;">'click'</span>, () => {

  
    <span style="color:#4dabf7;">addLog</span>(<span style="color:#69db7c;">"Order started..."</span>);

  
    <span style="color:#4dabf7;">setTimeout</span>(() => {
        <span style="color:#4dabf7;">addLog</span>(<span style="color:#69db7c;">"Coffee is brewed!"</span>);
    }, <span style="color:#ffa94d;">5000</span>);


    <span style="color:#4dabf7;">setTimeout</span>(() => {
        <span style="color:#4dabf7;">addLog</span>(<span style="color:#69db7c;">"Eggs are fried!"</span>);
    }, <span style="color:#ffa94d;">3000</span>);

  
    <span style="color:#4dabf7;">setTimeout</span>(() => {
        <span style="color:#4dabf7;">addLog</span>(<span style="color:#69db7c;">"Toast popped!"</span>);
    }, <span style="color:#ffa94d;">2000</span>);


    <span style="color:#4dabf7;">addLog</span>(<span style="color:#69db7c;">"Pouring Orange Juice"</span>);

  
    <span style="color:#4dabf7;">addLog</span>(<span style="color:#69db7c;">"Ticket placed on counter."</span>);

});
</pre>

</div>


<div style="clear:both;"></div>

