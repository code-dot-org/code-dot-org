name 'designing-reliable-apps-postassessment-q5_2026'

question 'A developer writes: fetch(url).then(response => response.json()).then(data => console.log(data.title)); — and the API responds with {"title": "Afrofuturism", "author": "Ytasha Womack"}. What is printed to the console?'

wrong '{"title": "Afrofuturism", "author": "Ytasha Womack"}'
wrong 'response.json()'
right '"Afrofuturism"'
wrong 'undefined'

allow_multiple_attempts true

