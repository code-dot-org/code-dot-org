name 'designing-reliable-apps-postassessment-q4_2025'

question 'A developer runs this code: console.log("Start"); setTimeout(() => console.log("Timer done"), 2000); console.log("End"); What is the correct output order?'

wrong 'Start → Timer done → End'
right 'Start → End → Timer done'
wrong 'Timer done → Start → End'
wrong 'End → Start → Timer done'

allow_multiple_attempts true

