name 'designing-reliable-apps-preassessment-q6_2025'

question 'In this code: fetch(url).then(res => res.json()).then(data => display(data)).catch(err => showError()) — what is the role of .catch()?'

wrong 'It converts the raw server response into a usable JavaScript object'
wrong 'It runs after every successful .then() call to confirm the data was received'
wrong 'It sends a new request to a backup server if the first request takes too long'
right 'It runs a block of code when the Promise is rejected, preventing the app from crashing'

allow_multiple_attempts true

