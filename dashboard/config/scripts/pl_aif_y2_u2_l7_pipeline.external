    <div role="columnheader" style="flex: 1; padding: 8px 10px;">Train or test</div>
  </div>
  <div role="row" style="display: flex; background-color: #F7F7FB; font-size: 16px;">
    <div role="cell" style="flex: 1; padding: 8px 10px;">1</div><div role="cell" style="flex: 1; padding: 8px 10px;">Ocean</div><div role="cell" style="flex: 1; padding: 8px 10px;">Yes</div><div role="cell" style="flex: 1; padding: 8px 10px;">No</div><div role="cell" style="flex: 1; padding: 8px 10px;">Yes</div><div role="cell" style="flex: 1; padding: 8px 10px;">Train</div>
  </div>
  <div role="row" style="display: flex; background-color: #FFFFFF; font-size: 16px;">
    <div role="cell" style="flex: 1; padding: 8px 10px;">2</div><div role="cell" style="flex: 1; padding: 8px 10px;">Ocean</div><div role="cell" style="flex: 1; padding: 8px 10px;">Yes</div><div role="cell" style="flex: 1; padding: 8px 10px;">Yes</div><div role="cell" style="flex: 1; padding: 8px 10px;">Yes</div><div role="cell" style="flex: 1; padding: 8px 10px;">Train</div>
  </div>
  <div role="row" style="display: flex; background-color: #F7F7FB; font-size: 16px;">
    <div role="cell" style="flex: 1; padding: 8px 10px;">7</div><div role="cell" style="flex: 1; padding: 8px 10px;">River</div><div role="cell" style="flex: 1; padding: 8px 10px;">No</div><div role="cell" style="flex: 1; padding: 8px 10px;">Yes</div><div role="cell" style="flex: 1; padding: 8px 10px;">No</div><div role="cell" style="flex: 1; padding: 8px 10px;">Train</div>
  </div>
  <div role="row" style="display: flex; background-color: #FFFFFF; font-size: 16px;">
    <div role="cell" style="flex: 1; padding: 8px 10px;">11</div><div role="cell" style="flex: 1; padding: 8px 10px;">River</div><div role="cell" style="flex: 1; padding: 8px 10px;">No</div><div role="cell" style="flex: 1; padding: 8px 10px;">Yes</div><div role="cell" style="flex: 1; padding: 8px 10px;">No</div><div role="cell" style="flex: 1; padding: 8px 10px;">Test</div>
  </div>
</div>

<div style="background-color: #E4E2F8; border-radius: 10px; padding: 16px 20px; margin: 16px 0;">
  <div style="font-size: 16px; color: #222222; line-height: 1.5;"><b>&#128161; Teacher tip:</b> steps 1 and 2 decide everything that follows. If a student's features are weak, the table and the code will be too, no matter how well they program. Catch it early.</div>
</div>

