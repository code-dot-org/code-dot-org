  <div style="position:absolute; left:260px; top:20px; width:180px; height:50px; box-sizing:border-box; display:flex; align-items:center; justify-content:center; text-align:center; background-color:#E4E2F8; color:#000000; border:4px solid #4C42CF; border-radius:28px; font-size:16px; font-weight:bold; z-index:2;">
