      <div aria-hidden="true" style="position:absolute; left:341px; top:556px; color:#34BD43; font-size:18px; z-index:1;">▼</div>
    <div aria-hidden="true" style="position:absolute; left:450px; top:597px; width:220px; height:4px; background-color:#34BD43; z-index:1;"></div>
