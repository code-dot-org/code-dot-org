<!-- HEADER -->
<tr>
<td colspan="3" style="padding:6px 20px 10px 20px; text-align:center;">
<div style="font-size:36px; line-height:1.05; font-weight:900; color:#1596aa; letter-spacing:-1px;">
✨ Prompting Tips & Tricks ✨
</div>
</td>
</tr>

<!-- ROW 1 -->
<tr style="background:white; box-shadow:0 4px 14px rgba(0,0,0,0.08); border-radius:20px;">
