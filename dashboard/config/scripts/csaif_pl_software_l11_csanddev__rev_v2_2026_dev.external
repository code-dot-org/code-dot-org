    </div>

  <!-- Three software categories -->
  <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:28px;">

  <!-- System Software -->
   <div style="width:31%; text-align:center;">

  <div style="display:inline-block; min-width:150px; padding:10px 14px; background-color:#E4E2F8; border:2px solid #4C42CF; border-radius:8px; color:#1F1976; font-size:18px; font-weight:700; line-height:1.2; box-sizing:border-box;">
          System Software
        </div>

   <div aria-hidden="true" style="width:3px; height:14px; margin:0 auto; background-color:#4C42CF;"></div>
   <div aria-hidden="true" style="width:72%; height:3px; margin:0 auto; background-color:#4C42CF;"></div>

   <div style="display:flex; justify-content:center; gap:8px;">
     <div style="flex:1;">
            <div aria-hidden="true" style="width:3px; height:13px; margin:0 auto; background-color:#4C42CF;"></div>
