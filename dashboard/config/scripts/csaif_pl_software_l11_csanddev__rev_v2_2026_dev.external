  <div aria-hidden="true" style="width:3px; height:16px; margin:0 auto; background-color:#06338D;"></div>
  <div aria-hidden="true" style="width:68%; height:3px; margin:0 auto; background-color:#06338D;"></div>

  <!-- Branch connectors -->
  <div aria-hidden="true" style="display:flex; justify-content:space-between; width:68%; margin:0 auto;">
      <div style="width:3px; height:16px; background-color:#06338D;"></div>
