              Android
            </div>
          </div>

   <div style="flex:1;">
            <div aria-hidden="true" style="width:3px; height:13px; margin:0 auto; background-color:#4C42CF;"></div>
            <div style="padding:10px 5px; background-color:#FFFFFF; border:2px solid #ACA8EA; border-radius:20px; font-size:16px; font-weight:700;">
              Windows
            </div>
          </div>

   <div style="flex:1;">
            <div aria-hidden="true" style="width:3px; height:13px; margin:0 auto; background-color:#4C42CF;"></div>
            <div style="padding:10px 5px; background-color:#FFFFFF; border:2px solid #ACA8EA; border-radius:20px; font-size:16px; font-weight:700;">
              Apple iOS
            </div>
          </div>

  </div>

   <p style="margin:22px 8px 0; font-size:16px; line-height:1.35;">
          Manages hardware and software and enables basic functionality.
        </p>

  </div>

   <!-- Application Software -->
   <div style="width:36%; text-align:center;">

   <div style="display:inline-block; min-width:170px; padding:10px 14px; background-color:#D5EFFF; border:2px solid #0099F3; border-radius:8px; color:#06338D; font-size:18px; font-weight:700; line-height:1.2; box-sizing:border-box;">
          Application Software
        </div>

   <div aria-hidden="true" style="width:3px; height:14px; margin:0 auto; background-color:#0099F3;"></div>
