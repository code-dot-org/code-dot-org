  <div style="flex:1;">
            <div aria-hidden="true" style="width:3px; height:13px; margin:0 auto; background-color:#0099F3;"></div>
            <div style="padding:10px 4px; background-color:#FFFFFF; border:2px solid #6FCAFF; border-radius:20px; font-size:16px; font-weight:700;">
