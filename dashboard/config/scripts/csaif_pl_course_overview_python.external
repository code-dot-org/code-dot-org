      <div style="background: #fff; border: 2px solid #4C42CF; border-radius: 6px; padding: 10px; flex: 2 1 240px; min-width: 220px; font-size: 12.5px; color: #1F1976; text-align: center; line-height: 1.4; display: flex; align-items: center; justify-content: center; gap: 8px; font-weight: 600;">
        <span style="display:inline-block; background:#4C42CF; color:#fff; font-size:10px; font-weight:700; padding:2px 8px; border-radius:20px; text-transform:uppercase; white-space:nowrap;">Capstone</span>
