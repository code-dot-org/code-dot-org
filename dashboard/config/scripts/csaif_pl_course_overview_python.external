      <div style="background: #fff; border: 1.5px solid #ACA8EA; border-radius: 6px; padding: 10px; flex: 1 1 120px; min-width: 110px; font-size: 12.5px; color: #1F1976; text-align: center; line-height: 1.4;">
        <span style="display:block; font-size:10px; font-weight:600; color:#4C42CF; margin-bottom:4px; text-transform:uppercase;">Lesson 10</span>
        Algorithms IRL
      </div>
    </div>
  </div>

  <!-- Week 3 -->
  <div style="display: flex; align-items: stretch;">
    <div style="background: #4C42CF; color: #fff; font-weight: 700; font-size: 14px; display: flex; align-items: center; justify-content: center; min-width: 72px; padding: 16px 10px; text-align: center;">
      Week 3
    </div>
    <div style="display: flex; flex: 1; flex-wrap: wrap; background: #E4E2F8; gap: 6px; padding: 10px;">
      <div style="background: #fff; border: 1.5px solid #ACA8EA; border-radius: 6px; padding: 10px; flex: 1 1 120px; min-width: 110px; font-size: 12.5px; color: #1F1976; text-align: center; line-height: 1.4;">
        <span style="display:block; font-size:10px; font-weight:600; color:#4C42CF; margin-bottom:4px; text-transform:uppercase;">Lesson 11</span>
        Decomposition
