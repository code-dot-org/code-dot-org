    <tr style="background-color: #4C42CF;">
      <th scope="col" style="padding: 12px; text-align: left; color: #FFFFFF; font-size: 18px;"></th>
      <th scope="col" style="padding: 12px; text-align: left; color: #FFFFFF; font-size: 18px;">Semester 1: Fundamentals</th>
      <th scope="col" style="padding: 12px; text-align: left; color: #FFFFFF; font-size: 18px;">Semester 2: Foundry</th>
    </tr>
