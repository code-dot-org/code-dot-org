  <!-- Choice 5 -->
  <a href="#" target="_blank" style="text-decoration: none;">
    <div style="background-color: #DECEEA; color: #000000; padding: 20px; border-radius: 20px; box-shadow: 4px 4px 10px rgba(0, 0, 0, 0.1); text-align: center; transition: 0.3s;">
      <p style="font-size: 16pt; font-weight: bold; margin: 0;">Debug</p>
