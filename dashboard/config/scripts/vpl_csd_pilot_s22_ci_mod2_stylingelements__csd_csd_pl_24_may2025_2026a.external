  <div style="background-color:#E4E2F8; color:#1F1976; padding:12px 16px; border-bottom:1px solid #E4E2F8;">Sets the color of the border</div>
  <div style="background-color:#E4E2F8; padding:12px 16px; border-bottom:1px solid #E4E2F8;"><a href="https://www.w3schools.com/css/css_border.asp" target="_blank" rel="noopener noreferrer" style="color:#0099F3;">W3 Schools</a></div>

  <div style="background-color:#ffffff; color:#1F1976; padding:12px 16px; border-bottom:1px solid #E4E2F8;">border-width</div>
  <div style="background-color:#ffffff; color:#1F1976; padding:12px 16px; border-bottom:1px solid #E4E2F8;">Changes the border width of an element</div>
  <div style="background-color:#ffffff; padding:12px 16px; border-bottom:1px solid #E4E2F8;"><a href="https://www.w3schools.com/css/css_border.asp" target="_blank" rel="noopener noreferrer" style="color:#0099F3;">W3 Schools</a></div>

  <div style="background-color:#E4E2F8; color:#1F1976; padding:12px 16px; border-bottom:1px solid #E4E2F8;">border-style</div>
  <div style="background-color:#E4E2F8; color:#1F1976; padding:12px 16px; border-bottom:1px solid #E4E2F8;">Changes the style of border</div>
  <div style="background-color:#E4E2F8; padding:12px 16px; border-bottom:1px solid #E4E2F8;"><a href="https://www.w3schools.com/css/css_border.asp" target="_blank" rel="noopener noreferrer" style="color:#0099F3;">W3 Schools</a></div>

