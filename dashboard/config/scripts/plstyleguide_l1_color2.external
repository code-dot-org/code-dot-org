      <div style="font-size:12pt;">#E4E2F8</div>
    </div>
  </div>

  <div style="width:180px;border:1px solid #000000;border-radius:10px;overflow:hidden;">
    <div style="background:#ACA8EA;height:140px;display:flex;align-items:center;justify-content:center;">
