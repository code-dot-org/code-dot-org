    </div>
    <div style="padding:12px;text-align:center;">
      <div style="font-weight:bold;">Mid</div>
      <div style="font-size:12pt;">#ACA8EA</div>
    </div>
  </div>

  <div style="width:180px;border:1px solid #000000;border-radius:10px;overflow:hidden;">
    <div style="background:#4C42CF;height:140px;display:flex;align-items:center;justify-content:center;">
