name 'CSA U6L9-L5_pilot_oo2025_2025-alt'
title 'Check for Understanding'

wrong '`[3, 9, 1, 5, 2]`'
wrong '`[6, 8]`'
right '`[6, 8, 2]`'
wrong '`[2, 6, 8]`'
