      "files": {
        "2": {
          "id": "2",
          "name": "MyClass.java",
          "contents": "import org.code.neighborhood.*;\nimport java.util.Scanner;\n\npublic class MyClass {\n  public static void main(String[] args) {\n    Scanner scanner = new Scanner(System.in);\n    Painter p = new Painter();\n    System.out.print(\"How much paint should I take? \");\n    int paintCount = scanner.nextInt();\n    scanner.nextLine();\n    for(int i = 0; i < paintCount; i++) {\n      p.takePaint();\n    }\n    p.move();\n    System.out.print(\"What color should I paint? \");\n    String color = scanner.nextLine();\n    p.paint(color);\n    p.move();\n    p.move();\n    System.out.println(\"All done!\");\n  }\n}\n\n",
          "folderId": "0",
