        "nodes": [
          {
            "id": "48567a9d-0db8-4fcc-8f8a-562d252dcab3",
            "type": "text",
            "data": {
              "text": "Scavenger Hunt Activity - Instructions\n",
              "strokeColor": "transparent",
              "fontSize": "large",
              "textAlign": "left",
              "locked": true
            },
            "position": {
              "x": -4428.39248033287,
