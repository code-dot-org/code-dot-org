          {
            "id": "9e089b20-1df9-4842-8d50-eaf501f6006b",
            "type": "text",
            "data": {
              "text": "1. What I'm into",
              "strokeColor": "transparent",
              "textAlign": "left",
              "fontSize": "large",
              "locked": true
            },
            "position": {
              "x": -1442.7267628092955,
              "y": 81.91634911064408
