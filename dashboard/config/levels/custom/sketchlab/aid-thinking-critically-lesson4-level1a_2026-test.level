            "text": "Step 1: The Pilot Test",
            "fontSize": 20,
            "fontFamily": 1,
            "textAlign": "left",
            "verticalAlign": "top",
            "baseline": 18,
            "containerId": null,
            "originalText": "Step 1: The Pilot Test",
            "lineHeight": 1.25
          },
          {
            "id": "hUhnBoEHpJhiJtd_csmbD",
            "type": "text",
            "x": 309.3397314354751,
            "y": 90.10802007731502,
            "width": 336.1875,
            "height": 202.39999999999998,
            "angle": 0,
            "strokeColor": "#1e1e1e",
            "backgroundColor": "transparent",
            "fillStyle": "solid",
            "strokeWidth": 2,
            "strokeStyle": "solid",
            "roughness": 1,
            "opacity": 100,
            "groupIds": [

            ],
            "frameId": null,
            "roundness": null,
            "seed": 2067774734,
            "version": 49,
            "versionNonce": 853625998,
            "isDeleted": false,
            "boundElements": null,
            "updated": 1772117256173,
            "link": null,
            "locked": false,
            "text": "A clear check that proves the human is leading.\n\nExamples:\n\n“Can I explain why I chose this output?”\n\n“Did I revise this in my own words?”\n\n“Does this still sound like me?”\n\nMake this specific and actionable.",
            "fontSize": 16,
            "fontFamily": 2,
            "textAlign": "left",
            "verticalAlign": "top",
            "baseline": 198,
            "containerId": null,
            "originalText": "A clear check that proves the human is leading.\n\nExamples:\n\n“Can I explain why I chose this output?”\n\n“Did I revise this in my own words?”\n\n“Does this still sound like me?”\n\nMake this specific and actionable.",
            "lineHeight": 1.15
          },
          {
            "id": "mD7mBQ3gc9TwZuPB7MrIW",
            "type": "text",
            "x": 240.912348957081,
            "y": 421.40904330164796,
