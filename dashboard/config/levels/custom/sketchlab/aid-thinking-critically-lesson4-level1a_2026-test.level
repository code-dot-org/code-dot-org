            "text": "Step 2: The AI Impact Check ",
            "fontSize": 20,
            "fontFamily": 1,
            "textAlign": "left",
            "verticalAlign": "top",
            "baseline": 18,
            "containerId": null,
            "originalText": "Step 2: The AI Impact Check ",
            "lineHeight": 1.25
          },
          {
            "id": "J0Qkxg_s1Ri-0ColfH-Gh",
            "type": "text",
            "x": 315.4219720703171,
            "y": 505.3986533592438,
            "width": 434.828125,
            "height": 423.2,
            "angle": 0,
            "strokeColor": "#1e1e1e",
            "backgroundColor": "transparent",
            "fillStyle": "solid",
            "strokeWidth": 2,
            "strokeStyle": "solid",
            "roughness": 1,
            "opacity": 100,
            "groupIds": [

            ],
            "frameId": null,
            "roundness": null,
            "seed": 1018164686,
            "version": 46,
            "versionNonce": 1784974030,
            "isDeleted": false,
            "boundElements": null,
            "updated": 1772117256173,
            "link": null,
            "locked": false,
            "text": "A rule that addresses trade-offs.\n\nThink about:\n\nSkill practice\n\nCreativity\n\nHonesty\n\nEffort\n\nEnergy use\n\nOver-reliance\n\nExamples:\n\n“If this is something I need to learn, I should try it myself first.”\n\n“If AI saves time but removes my voice, I need to revise it.”\n\nShow that you understand AI has benefits and costs.",
            "fontSize": 16,
            "fontFamily": 2,
            "textAlign": "left",
            "verticalAlign": "top",
            "baseline": 419,
            "containerId": null,
            "originalText": "A rule that addresses trade-offs.\n\nThink about:\n\nSkill practice\n\nCreativity\n\nHonesty\n\nEffort\n\nEnergy use\n\nOver-reliance\n\nExamples:\n\n“If this is something I need to learn, I should try it myself first.”\n\n“If AI saves time but removes my voice, I need to revise it.”\n\nShow that you understand AI has benefits and costs.",
            "lineHeight": 1.15
          },
          {
            "id": "J3D8SLSu2dG0UmhIleFNT",
            "type": "text",
            "x": 326.02021031980433,
            "y": 1145.0678647497564,
            "width": 415.28125,
            "height": 128.79999999999998,
            "angle": 0,
            "strokeColor": "#1e1e1e",
            "backgroundColor": "transparent",
            "fillStyle": "solid",
            "strokeWidth": 2,
            "strokeStyle": "solid",
