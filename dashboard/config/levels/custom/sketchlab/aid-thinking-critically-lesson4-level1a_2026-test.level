            "isDeleted": false,
            "boundElements": null,
            "updated": 1772117286459,
            "link": null,
            "locked": false,
            "text": "A rule for how you will credit AI.\n\nExamples:\n\n“I will state when AI helped generate ideas.”\n\n“If AI wrote part of my draft, I will explain how I changed it.”",
            "fontSize": 16,
            "fontFamily": 2,
            "textAlign": "left",
            "verticalAlign": "top",
            "baseline": 125,
            "containerId": null,
            "originalText": "A rule for how you will credit AI.\n\nExamples:\n\n“I will state when AI helped generate ideas.”\n\n“If AI wrote part of my draft, I will explain how I changed it.”",
