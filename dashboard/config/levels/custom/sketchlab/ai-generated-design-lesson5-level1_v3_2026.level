            "boundElements": [

            ],
            "updated": 1773182770380,
            "link": null,
            "locked": false,
            "fontSize": 16,
            "fontFamily": 1,
            "text": "It seems like Adidas's target audience is \nTeens and young adults who like sports and big events \nlike soccer. The bright colors and bold graphics feel \nenergetic and trendy.",
            "textAlign": "left",
            "verticalAlign": "top",
            "containerId": null,
            "originalText": "It seems like Adidas's target audience is \nTeens and young adults who like sports and big events \nlike soccer. The bright colors and bold graphics feel \nenergetic and trendy.",
