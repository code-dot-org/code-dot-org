            "strokeColor": "#e03131",
            "backgroundColor": "#b2f2bb",
            "width": 435.5208435058594,
            "height": 60,
            "seed": 1088686410,
            "groupIds": [

            ],
            "frameId": null,
            "roundness": null,
            "boundElements": [

            ],
            "updated": 1773182875290,
            "link": null,
            "locked": false,
            "fontSize": 16,
            "fontFamily": 1,
            "text": "It seems like Disney's target audience is \nFamilies and kids. The clean layout and familiar titles \nmake it feel safe and family-friendly.",
            "textAlign": "left",
            "verticalAlign": "top",
            "containerId": null,
            "originalText": "It seems like Disney's target audience is \nFamilies and kids. The clean layout and familiar titles \nmake it feel safe and family-friendly.",
