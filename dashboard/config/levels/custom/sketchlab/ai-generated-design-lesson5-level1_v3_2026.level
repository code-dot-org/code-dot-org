            "boundElements": [

            ],
            "updated": 1773181846674,
            "link": null,
            "locked": false,
            "fontSize": 16,
            "fontFamily": 1,
            "text": "The Netflix brand ... \n- Dark background with red buttons and bright movie posters.\n- Bold, clear fonts that feel cinematic.\n- Highlights price and trending shows right away.",
            "textAlign": "left",
            "verticalAlign": "top",
            "containerId": null,
            "originalText": "The Netflix brand ... \n- Dark background with red buttons and bright movie posters.\n- Bold, clear fonts that feel cinematic.\n- Highlights price and trending shows right away.",
            "lineHeight": 1.25,
            "baseline": 74
          },
          {
            "type": "text",
            "version": 496,
            "versionNonce": 1298385482,
            "isDeleted": false,
            "id": "2rfc_31gr3Lzcgy5CSDyT",
            "fillStyle": "solid",
            "strokeWidth": 2,
            "strokeStyle": "solid",
            "roughness": 0,
            "opacity": 100,
            "angle": 0,
            "x": -219.4515656692971,
            "y": 959.9451894330896,
            "strokeColor": "#e03131",
            "backgroundColor": "#b2f2bb",
            "width": 445.8333435058594,
            "height": 80,
            "seed": 1500181450,
            "groupIds": [

            ],
            "frameId": null,
            "roundness": null,
            "boundElements": [

            ],
            "updated": 1773181864896,
            "link": null,
            "locked": false,
            "fontSize": 16,
            "fontFamily": 1,
            "text": "The Disney brand ... \n- Uses cool blues and organized sections.\n- Clean layout, lots of brand logos (Disney, Hulu, ESPN).\n- Feels family-friendly and professional.",
            "textAlign": "left",
            "verticalAlign": "top",
            "containerId": null,
            "originalText": "The Disney brand ... \n- Uses cool blues and organized sections.\n- Clean layout, lots of brand logos (Disney, Hulu, ESPN).\n- Feels family-friendly and professional.",
            "lineHeight": 1.25,
            "baseline": 74
          },
          {
            "type": "text",
            "version": 591,
            "versionNonce": 1120179146,
            "isDeleted": false,
            "id": "CtXrOsQJY_d7i0BamMXpq",
            "fillStyle": "solid",
            "strokeWidth": 2,
            "strokeStyle": "solid",
            "roughness": 0,
            "opacity": 100,
            "angle": 0,
            "x": -712.8802591681807,
            "y": 1141.2687569760324,
            "strokeColor": "#e03131",
            "backgroundColor": "#b2f2bb",
            "width": 447.9791564941406,
            "height": 80,
