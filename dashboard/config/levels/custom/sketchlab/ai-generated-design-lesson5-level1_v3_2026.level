            ],
            "frameId": null,
            "roundness": null,
            "boundElements": [

            ],
            "updated": 1773182858939,
            "link": null,
            "locked": false,
            "fontSize": 16,
            "fontFamily": 1,
            "text": "It seems like Netflix's target audience is \nTeens and adults who watch a lot of shows and movies.\n The dark layout and big show images make it feel \ndramatic and immersive.",
            "textAlign": "left",
            "verticalAlign": "top",
            "containerId": null,
            "originalText": "It seems like Netflix's target audience is \nTeens and adults who watch a lot of shows and movies.\n The dark layout and big show images make it feel \ndramatic and immersive.",
            "lineHeight": 1.25,
            "baseline": 74
          },
          {
