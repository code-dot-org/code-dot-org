            ],
            "updated": 1773181844022,
            "link": null,
            "locked": false,
            "fontSize": 14.399998256138392,
            "fontFamily": 1,
            "text": "The Nike brand ...\n- Uses powerful, confident fonts and close-up images of athletes.\n- Bold black and white theme with strong contrast.\n- Clean layout with rounded buttons and simple icons.",
            "textAlign": "left",
            "verticalAlign": "top",
            "containerId": null,
            "originalText": "The Nike brand ...\n- Uses powerful, confident fonts and close-up images of athletes.\n- Bold black and white theme with strong contrast.\n- Clean layout with rounded buttons and simple icons.",
            "lineHeight": 1.25,
            "baseline": 67
          },
          {
            "type": "text",
            "version": 161,
            "versionNonce": 24723722,
            "isDeleted": false,
            "id": "-5kjzrcIgvps80ww-5LLj",
            "fillStyle": "solid",
            "strokeWidth": 2,
            "strokeStyle": "solid",
            "roughness": 0,
            "opacity": 100,
            "angle": 0,
            "x": -216.92570712662064,
            "y": 16.32608077888575,
            "strokeColor": "#e03131",
            "backgroundColor": "#b2f2bb",
            "width": 505.9791564941406,
            "height": 80,
            "seed": 813470346,
            "groupIds": [

            ],
            "frameId": null,
            "roundness": null,
            "boundElements": [

            ],
            "updated": 1773181844022,
            "link": null,
            "locked": false,
            "fontSize": 16,
            "fontFamily": 1,
            "text": "The Adidas brand ...\n- Bright, energetic colors (yellow and red).\n- Urban, sporty look with focus on pop culture events like FIFA.\n- Bold text and sharp graphic design. ",
            "textAlign": "left",
            "verticalAlign": "top",
            "containerId": null,
            "originalText": "The Adidas brand ...\n- Bright, energetic colors (yellow and red).\n- Urban, sporty look with focus on pop culture events like FIFA.\n- Bold text and sharp graphic design. ",
            "lineHeight": 1.25,
            "baseline": 74
          },
          {
            "type": "text",
            "version": 228,
            "versionNonce": 1442798666,
            "isDeleted": false,
            "id": "l9aWkiCku0LGYK4vmH27l",
            "fillStyle": "solid",
            "strokeWidth": 2,
            "strokeStyle": "solid",
            "roughness": 0,
            "opacity": 100,
            "angle": 0,
            "x": -706.9257071266206,
            "y": 202.64964832182847,
            "strokeColor": "#e03131",
            "backgroundColor": "#b2f2bb",
            "width": 394.9583435058594,
            "height": 80,
            "seed": 891138378,
            "groupIds": [

            ],
            "frameId": null,
            "roundness": null,
            "boundElements": [

            ],
            "updated": 1773182722810,
            "link": null,
            "locked": false,
            "fontSize": 16,
            "fontFamily": 1,
            "text": "It seems like Nike's target audience is \nTeens and young adults who are into sports and \ncompetition. The dark colors and intense athlete\n images make it feel serious and powerful.",
            "textAlign": "left",
            "verticalAlign": "top",
            "containerId": null,
            "originalText": "It seems like Nike's target audience is \nTeens and young adults who are into sports and \ncompetition. The dark colors and intense athlete\n images make it feel serious and powerful.",
            "lineHeight": 1.25,
            "baseline": 74
          },
