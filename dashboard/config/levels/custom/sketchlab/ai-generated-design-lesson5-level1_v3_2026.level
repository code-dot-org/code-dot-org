              "x": -655.3505197882978,
              "y": 1076.8402204246927
            },
            "data": {
              "text": "Who is Netflix's target audience?",
              "fontColor": "#1e1e1e",
              "fontSize": 20,
              "showHandles": false
            },
            "measured": {
              "width": 313,
              "height": 44
            }
          },
          {
            "id": "NBeLfrNmyRYGoNqJNonNj",
            "type": "text",
            "position": {
              "x": -181.26417030099367,
              "y": 1079.4116315575052
            },
            "data": {
              "text": "Who is Disney's target audience?",
              "fontColor": "#1e1e1e",
              "fontSize": 20,
              "showHandles": false
            },
            "measured": {
              "width": 313,
              "height": 44
            }
          },
          {
            "id": "4nV3go7-yu6dHmw3d8rKk",
            "type": "text",
            "position": {
              "x": -725.849061484029,
              "y": 901.397406878376
            },
            "data": {
              "text": "What do you notice about the Netflix brand?",
              "fontColor": "#1e1e1e",
              "fontSize": 20,
              "showHandles": false
            },
            "measured": {
              "width": 417,
              "height": 44
            }
          },
          {
            "id": "r6qE-vSjnhwQPCgKWcEjy",
            "type": "text",
            "position": {
              "x": -222.2075580137447,
              "y": 903.6973894397598
            },
            "data": {
              "text": "What do you notice about the Disney brand?",
              "fontColor": "#1e1e1e",
              "fontSize": 20,
              "showHandles": false
            },
            "measured": {
              "width": 417,
              "height": 44
            }
          },
          {
            "id": "kVmZCYZzoLEjDtkGxHrp7",
            "type": "text",
            "position": {
              "x": -734.9919535041182,
              "y": 945.5239567695666
            },
            "data": {
              "text": "The Netflix brand ... \n- Dark background with red buttons and bright movie posters.\n- Bold, clear fonts that feel cinematic.\n- Highlights price and trending shows right away.",
              "fontColor": "#e03131",
              "fontSize": 16,
              "showHandles": false
            },
            "measured": {
              "width": 458,
              "height": 101
            }
          },
          {
            "id": "2rfc_31gr3Lzcgy5CSDyT",
            "type": "text",
            "position": {
              "x": -219.4515656692971,
              "y": 959.9451894330896
            },
            "data": {
              "text": "The Disney brand ... \n- Uses cool blues and organized sections.\n- Clean layout, lots of brand logos (Disney, Hulu, ESPN).\n- Feels family-friendly and professional.",
              "fontColor": "#e03131",
              "fontSize": 16,
              "showHandles": false
            },
            "measured": {
              "width": 415,
              "height": 101
            }
          },
          {
            "id": "CtXrOsQJY_d7i0BamMXpq",
            "type": "text",
            "position": {
              "x": -712.8802591681807,
              "y": 1141.2687569760324
            },
            "data": {
              "text": "It seems like Netflix's target audience is \nTeens and adults who watch a lot of shows and movies.\n The dark layout and big show images make it feel \ndramatic and immersive.",
              "fontColor": "#e03131",
              "fontSize": 16,
              "showHandles": false
            },
            "measured": {
              "width": 412,
              "height": 101
            }
          },
          {
            "id": "_lGvdRYhBlphJQowl69Mg",
            "type": "text",
            "position": {
              "x": -231.83572094273393,
              "y": 1147.0544538231302
            },
            "data": {
              "text": "It seems like Disney's target audience is \nFamilies and kids. The clean layout and familiar titles \nmake it feel safe and family-friendly.",
              "fontColor": "#e03131",
              "fontSize": 16,
              "showHandles": false
            },
            "measured": {
              "width": 392,
              "height": 80
            }
          },
          {
            "id": "2pEB-YinZcHRPMEjAT0MB",
            "type": "text",
            "position": {
              "x": 953.0835511436426,
              "y": 421.40191592320537
            },
            "data": {
              "text": "Walmart",
              "fontColor": "#1e1e1e",
              "fontSize": 36,
              "showHandles": false
            },
            "measured": {
              "width": 152,
              "height": 65
            }
          },
          {
