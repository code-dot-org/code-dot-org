          {
            "id": "b8dea7a5-e006-4036-b976-62341782815c",
            "type": "text",
            "data": {
              "text": "TIPS FOR RESPONSIBLE USE",
              "fontSize": 60,
              "fontColor": "var(--sketchlab-stroke-yellow)",
              "locked": true
            },
            "position": {
              "x": -47.12684349172736,
              "y": 2164.331509975887
