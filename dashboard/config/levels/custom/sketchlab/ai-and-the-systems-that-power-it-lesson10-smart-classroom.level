            "dragging": false
          },
          {
            "id": "08b8fd65-1e39-4ee9-8082-c84bd5e790ba",
            "type": "text",
            "data": {
              "text": "What is a problem or issue you’d like to address in your school?\n\nWhat kind of technology do you think we'll have by 2050?\n\nStill stuck getting started? Here are some ideas:\n\n- Design a device that makes students feel safer.\n\n- Design something that reduces distractions.\n\n\n",
              "strokeColor": "transparent",
              "fontSize": "small",
              "fontFamily": "sans",
              "textAlign": "left",
