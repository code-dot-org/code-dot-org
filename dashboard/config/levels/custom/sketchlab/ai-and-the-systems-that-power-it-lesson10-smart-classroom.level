          {
            "id": "754534b2-b6de-46d8-954d-9c29d3274c13",
            "type": "text",
            "data": {
              "text": "* What problem does your innovation solve?\n\n* What sensor/hardware does it use and what data is collected?\n\n* How does it send/receive data?\n\n* What privacy or security concerns might arise?",
              "strokeColor": "transparent",
              "fontSize": "small",
              "fontFamily": "sans",
              "textAlign": "left",
              "locked": true
            },
            "position": {
