          {
            "id": "5a7c230d-0e3d-4d2f-9c76-8b9d1854e5ec",
            "type": "text",
            "data": {
              "text": "Hi, my name is Jasmine. I've been passionate about environmental science since middle school, and I love working on sustainability projects in my community. I'm a strong student with a 4.1 GPA, and I've taken AP Biology, AP Environmental Science, and AP Statistics. My SAT score is 1420. I'm applying to this college because of its strong environmental studies program and the research opportunities available for undergraduates. Outside of school, I run a community garden and volunteer for a local conservation group.",
              "strokeColor": "transparent",
              "fontFamily": "draw",
              "textAlign": "left"
            },
            "position": {
