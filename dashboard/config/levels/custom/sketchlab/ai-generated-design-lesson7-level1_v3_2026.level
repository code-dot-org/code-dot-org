    "exemplar_sources": {
      "source": {
        "nodes": [
          {
            "id": "P-pT-duP9y88PSqJu0z98",
            "type": "image",
            "position": {
              "x": 1207.7923857673713,
              "y": -517.7475516909644
            },
            "style": {
              "width": 295.13332790798626,
              "height": 442.69999186197947
            },
            "data": {
              "src": "/level_starter_assets/ai-generated-design-lesson7-level1_v3_2026/uuid/fb4f9172b6a82fd9f247783db3b3aababe28835e.png",
              "altText": "",
              "showHandles": false
            },
            "measured": {
              "width": 295,
              "height": 443
            }
          },
          {
            "id": "eIV3WbmNB9F4l0UVw4fZy",
            "type": "image",
            "position": {
              "x": -12.956001620228335,
              "y": 757.1857165382017
            },
            "style": {
              "width": 370.50574942678685,
              "height": 469.3666585286458
            },
            "data": {
              "src": "/level_starter_assets/ai-generated-design-lesson7-level1_v3_2026/uuid/9136ff6dc47f91ce19ef9275797c4fff0abcd5bd.png",
              "altText": "",
              "showHandles": false
            },
            "measured": {
              "width": 371,
              "height": 469
            }
          },
          {
            "id": "jhWj0PSZqHMe_WGseYE6r",
            "type": "text",
            "position": {
              "x": -1643.1181759975702,
              "y": -718.6949628135629
            },
            "data": {
              "text": "SCENARIO 1:\nDesign an app to help new students make friends at school.",
              "fontColor": "#1e1e1e",
              "fontSize": 36,
              "showHandles": false
            },
            "measured": {
              "width": 872,
              "height": 158
            },
            "dragging": false
          },
          {
            "id": "et4mLErIo1FtGmta-lKvR",
            "type": "shape",
            "position": {
              "x": -2168.5643080727955,
              "y": -458.47761295898823
            },
            "style": {
              "width": 634.3784056904835,
              "height": 260.59161689160516
            },
            "data": {
              "shapeType": "rectangle",
              "label": "",
              "backgroundColor": "#a5d8ff",
              "strokeColor": "#1e1e1e"
            },
            "measured": {
              "width": 634,
              "height": 261
            },
            "dragging": false
          },
          {
            "id": "NZpRPAvxU_ZOEldIxYkpP",
            "type": "text",
            "position": {
              "x": -2062.4855361211903,
              "y": -433.99739910307346
            },
            "data": {
              "text": "Name(s): Maya Rodriguez\n\n\nAge/Grade: 14 yrs, 9th grade\n\n\nNew to the school because ... she just moved to the area \nover the summer and doesn't know anyone yet",
              "fontColor": "#e03131",
              "fontSize": 20,
              "showHandles": false
            },
            "measured": {
              "width": 527,
              "height": 226
            }
          },
          {
            "id": "Wine8Sjda24i_MuMYPjZc",
            "type": "shape",
            "position": {
              "x": -904.4288650594879,
              "y": 100.98104354998121
            },
            "style": {
              "width": 914.3784819844287,
              "height": 327.3916733491245
            },
            "data": {
              "shapeType": "rectangle",
              "label": "",
              "backgroundColor": "#a5d8ff",
              "strokeColor": "#1e1e1e"
            },
            "measured": {
              "width": 914,
              "height": 327
            },
            "dragging": false
          },
          {
            "id": "qdXd8zkwirPheERyYQjqO",
            "type": "text",
            "position": {
              "x": -857.2837377705897,
              "y": 143.86954195393014
            },
            "data": {
              "text": "A specific frustration: she doesn't know how to start conversations or figure\nout who has similar interests\n\n\nA meaningful goal: she wants to feel comfortable at school and have at least\none close friend she can talk to during the day\n\n",
              "fontColor": "#e03131",
              "fontSize": 20,
              "showHandles": false
            },
            "measured": {
              "width": 698,
              "height": 200
            },
            "dragging": false
          },
          {
            "id": "YvinXTiFsUCFwzgkpk3cp",
            "type": "shape",
            "position": {
              "x": -2097.6792850216116,
              "y": 66.71386330391377
            },
            "style": {
              "width": 927.9782744648971,
              "height": 352.1916916596717
            },
            "data": {
              "shapeType": "rectangle",
              "label": "",
              "backgroundColor": "#a5d8ff",
              "strokeColor": "#1e1e1e"
            },
            "measured": {
              "width": 928,
              "height": 352
            },
            "dragging": false
          },
          {
            "id": "Jf4nUliQEmQuX6sjzhz4q",
            "type": "text",
            "position": {
              "x": -2054.2856612432606,
              "y": 77.20258258637966
            },
            "data": {
              "text": "Says:\n\n- I don't know where to sit\n- Everyone already has their own friend\ngroups",
              "fontColor": "#e03131",
              "fontSize": 20,
              "showHandles": false
            },
            "measured": {
              "width": 367,
              "height": 148
            }
          },
          {
            "id": "_k8A9O5wit3u1alQPHmsL",
            "type": "text",
            "position": {
              "x": -1604.0961261022694,
              "y": 86.30252765473881
            },
            "data": {
              "text": "Thinks:\n\n- What if I say something awkward?\n- People probably already have their friends",
              "fontColor": "#e03131",
              "fontSize": 20,
              "showHandles": false
            },
            "measured": {
              "width": 406,
              "height": 122
            }
          },
          {
            "id": "AuudXsfFxi54NPKNEBWvH",
            "type": "text",
            "position": {
              "x": -2056.8957476843007,
              "y": 245.1027901059108
            },
            "data": {
              "text": "Feels:\n\n- nervious\n- left out\n- overwhelmed",
              "fontColor": "#e03131",
              "fontSize": 20,
              "showHandles": false
            },
            "measured": {
              "width": 152,
              "height": 148
            }
          },
          {
            "id": "flD1X9H1mJtvvs2cL23KB",
            "type": "text",
            "position": {
              "x": -1610.8959918249257,
              "y": 224.70255206880142
            },
            "data": {
              "text": "Does:\n\n- scrolls on her phone during lunch\n- sits alone or waits for someone to invite her\n- avoid starting conversations",
              "fontColor": "#e03131",
              "fontSize": 20,
              "showHandles": false
            },
            "measured": {
              "width": 421,
              "height": 148
            }
          },
          {
            "id": "ds2J7IO1Hs68tC_JmgZoS",
            "type": "shape",
            "position": {
              "x": -698.7020546257729,
              "y": -419.19544624736784
            },
            "style": {
              "width": 696.37829887896,
              "height": 315.39162757275756
            },
            "data": {
              "shapeType": "rectangle",
              "label": "",
              "backgroundColor": "#a5d8ff",
              "strokeColor": "#1e1e1e"
            },
            "measured": {
              "width": 696,
              "height": 315
            },
            "dragging": false
          },
          {
            "id": "BZyLMxmI_a5f59YnH_wI9",
            "type": "text",
            "position": {
              "x": -656.9939017522938,
              "y": -415.89739299955784
            },
            "data": {
              "text": "Problem Statement:\n\nMaya needs a way to connect with students who share her \ninterests because she feels nervous starting conversations \nand doesn’t know where she fits in.",
              "fontColor": "#e03131",
              "fontSize": 20,
              "showHandles": false
            },
            "measured": {
              "width": 547,
              "height": 148
            }
          },
          {
            "id": "4GEIhupcoG0vJZB8T0W-3",
            "type": "text",
            "position": {
              "x": -2096.2856307256825,
              "y": -566.7974479311983
            },
            "data": {
              "text": "#1",
              "fontColor": "#1e1e1e",
              "fontSize": 76.34784731657601,
              "showHandles": false
            },
            "measured": {
              "width": 98,
              "height": 117
            }
          },
          {
            "id": "mLfP9lT-ekywi7YonKjSg",
            "type": "text",
            "position": {
              "x": -2057.4568135669847,
              "y": -31.497585260300298
            },
            "data": {
              "text": "#2",
              "fontColor": "#1e1e1e",
              "fontSize": 76.34784731657601,
              "showHandles": false
            },
            "measured": {
              "width": 109,
              "height": 117
            }
          },
          {
            "id": "AwXIBBcq8QwvQyye614HF",
            "type": "text",
            "position": {
              "x": -980.6568562915945,
              "y": 0.9025459652856398
            },
            "data": {
              "text": "#3",
              "fontColor": "#1e1e1e",
              "fontSize": 76.34784731657601,
              "showHandles": false
            },
            "measured": {
              "width": 108,
              "height": 117
            }
          },
          {
            "id": "fsYBoRKKJM_Tn4PCALa_z",
            "type": "text",
            "position": {
              "x": -675.0567586353445,
              "y": -526.2975272769017
            },
            "data": {
              "text": "#4",
              "fontColor": "#1e1e1e",
              "fontSize": 76.34784731657601,
              "showHandles": false
            },
            "measured": {
              "width": 113,
              "height": 117
            }
          },
          {
            "id": "9kGv4hOaea6gqHfwJpzO4",
            "type": "text",
            "position": {
              "x": -508.75192406064343,
              "y": -222.63484646025142
            },
            "data": {
              "text": "Remember to focus on a need, not a specific solution \n(no apps, websites, or features)",
              "fontColor": "#1e1e1e",
              "fontSize": 15.51421587391919,
              "showHandles": false
            },
            "measured": {
              "width": 391,
              "height": 58
            }
          },
          {
            "id": "1jttLxvL4Dxr1R_OnLl9q",
            "type": "text",
            "position": {
              "x": -259.8435880410383,
              "y": 589.1543424707953
