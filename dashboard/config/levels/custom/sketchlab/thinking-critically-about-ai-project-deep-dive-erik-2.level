            "fontSize": 26.399999999999988,
            "fontFamily": 1,
            "text": "AI sometimes doesn't want to generate\nan image. And when it does, without\ndetail it is really basic",
            "textAlign": "left",
            "verticalAlign": "top",
            "containerId": null,
            "originalText": "AI sometimes doesn't want to generate\nan image. And when it does, without\ndetail it is really basic",
