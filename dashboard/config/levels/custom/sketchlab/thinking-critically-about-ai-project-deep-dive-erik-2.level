          {
            "id": "yHxmARpZMrQ9OWDt_1-MJ",
            "type": "text",
            "x": 1744.6373583401007,
            "y": 4141.489352353109,
            "width": 443.0797119140625,
            "height": 125,
            "angle": 0,
            "strokeColor": "#1e1e1e",
            "backgroundColor": "#ffffff",
            "fillStyle": "solid",
            "strokeWidth": 2,
            "strokeStyle": "solid",
            "roughness": 1,
            "opacity": 100,
            "groupIds": [
