            "boundElements": null,
            "updated": 1776353752294,
            "link": null,
            "locked": false,
            "text": "Get ready for a playful, exploratory, and photo-heavy ride! \nWe will focus on discovering Austin's quirkiest art and offbeat landmarks. \nThis is a casually paced social ride suitable for all skill levels. \nJust bring your bike, a helmet, and your camera!",
            "fontSize": 25.222936614767168,
            "fontFamily": 1,
            "textAlign": "left",
            "verticalAlign": "top",
            "baseline": 116.99999999999993,
            "containerId": null,
