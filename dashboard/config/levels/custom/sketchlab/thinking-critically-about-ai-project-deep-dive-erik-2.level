            "seed": 1204747673,
            "version": 1029,
            "versionNonce": 1394643639,
            "isDeleted": false,
            "boundElements": null,
            "updated": 1776354122640,
            "link": null,
            "locked": false,
            "text": "When you have AI create all of the text, it\njust doesn't reflect your personality at all \nanymore. I really think that AI can help \nwith text, but it shouldn't write the whole \nthing.",
            "fontSize": 20,
            "fontFamily": 1,
            "textAlign": "center",
            "verticalAlign": "middle",
            "baseline": 118,
            "containerId": "aZx-jA6tecCYqr2eVE9cp",
            "originalText": "When you have AI create all of the text, it just doesn't reflect your personality at all anymore. I really think that AI can help with text, but it shouldn't write the whole thing.",
            "lineHeight": 1.25
          },
