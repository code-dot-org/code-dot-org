            "isDeleted": false,
            "boundElements": null,
            "updated": 1775743424565,
            "link": null,
            "locked": false,
            "text": "When generating images or visual content, I will not accept \nthe first output at face value. I will actively look for \nstereotypes and adjust my prompts to force the AI to be more \naccurate",
            "fontSize": 25.27282023484605,
            "fontFamily": 1,
            "textAlign": "left",
            "verticalAlign": "top",
            "baseline": 117,
            "containerId": null,
            "originalText": "When generating images or visual content, I will not accept \nthe first output at face value. I will actively look for \nstereotypes and adjust my prompts to force the AI to be more \naccurate",
            "lineHeight": 1.25
          },
