            "link": null,
            "locked": false,
            "text": "I will use AI to help brainstorm outlines, generate synonyms, \nor suggest catchy hooks, but I will write the final draft \nmyself to ensure my work stays authentically ME!",
            "fontSize": 25.27282023484605,
            "fontFamily": 1,
            "textAlign": "left",
            "verticalAlign": "top",
            "baseline": 85,
            "containerId": null,
            "originalText": "I will use AI to help brainstorm outlines, generate synonyms, \nor suggest catchy hooks, but I will write the final draft \nmyself to ensure my work stays authentically ME!",
            "lineHeight": 1.25
          },
