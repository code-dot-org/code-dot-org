            "type": "shape",
            "data": {
              "shapeType": "rectangle",
              "label": "User Persona #2\n\nWho he is: Practices late, \nstudies later. Earbuds \nalways in, notifications \nmostly off.\n\nHabits & prefs: Dark mode, \nhaptics off, hates sudden \nsounds; likes quiet status \ncues.\n\nNeeds: Low-glare UI, gentle\nfeedback, and control over \nalerts.",
              "showHandles": false,
              "fontSize": "medium",
              "backgroundColor": "var(--sketchlab-bg-pink)"
            },
            "position": {
