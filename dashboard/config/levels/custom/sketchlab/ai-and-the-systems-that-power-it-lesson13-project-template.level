          {
            "id": "8267ed8a-43a4-45ae-b067-a5342a64a4f1",
            "type": "text",
            "data": {
              "text": "Use arrows to connect the icons and explanatory cards to show the way that data flows through your device\n",
              "strokeColor": "transparent",
              "fontFamily": "sans",
              "fontSize": "medium",
              "locked": true
            },
            "position": {
              "x": 1207.5860972892242,
              "y": 518.9651832474274
            },
            "width": 336.19239334617544,
            "height": 120.64464570813755,
            "measured": {
              "width": 336,
              "height": 121
            },
            "dragging": false
          },
          {
            "id": "5f2b3611-b3ff-4d15-86e5-495694ec6dd8",
            "type": "text",
            "data": {
              "text": "Use explanatory cards to label the major parts and actions of your device, including hardware, software, and communication decisions made,",
              "strokeColor": "transparent",
              "fontFamily": "sans",
              "fontSize": "medium",
              "locked": true
            },
            "position": {
              "x": 455.82080790815735,
              "y": 524.4213329251775
            },
            "width": 336.19239334617544,
            "height": 120.64464570813755,
            "measured": {
              "width": 336,
              "height": 121
            },
            "dragging": false
          },
          {
            "id": "c7ac0c67-10d4-41fc-9a3b-5a96b7c54a0c",
            "type": "text",
            "data": {
              "text": "Consider numbering the major sections to make it easier to visualize the way that the device functions.\n",
              "strokeColor": "transparent",
              "fontFamily": "sans",
              "fontSize": "medium",
              "locked": true
            },
            "position": {
              "x": 471.7192549439005,
              "y": 1034.3091054156996
            },
            "width": 336.19239334617544,
            "height": 120.64464570813755,
            "measured": {
              "width": 336,
              "height": 121
            },
            "dragging": false
          },
          {
            "id": "3e062937-8cdb-4207-ac0a-86c1f9ce7a7a",
            "type": "text",
            "data": {
              "text": "As a final step, consider using shapes, simple images, or color to add clarity to your device.\n",
              "strokeColor": "transparent",
              "fontFamily": "sans",
              "fontSize": "medium",
              "locked": true
            },
