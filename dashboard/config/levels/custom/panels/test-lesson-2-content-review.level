  "level_num": "custom",
  "user_id": 1,
  "properties": {
    "panels": [
      {
        "key": "test-lesson-2-content-review-2658d8a3-cc11-47d2-a98e-32513950521c",
        "text": "We've learned about essential HTML tags like `<h1>` for headings and `<p>` for paragraphs. These tags are fundamental for organizing and structuring text on your page.",
        "imageUrl": "https://images.code.org/5abf1567943f897d86c8e221d1df9635-test-lesson-2-content-review-panel-1-f1dd131c-fd74-4c8a-a42b-eb2c75db6846.png",
        "layout": "text-top-left"
      },
      {
        "key": "test-lesson-2-content-review-d614399d-2793-444d-92f5-a6195c466e0e",
        "text": "Lists, created with `<ul>` (unordered) and `<ol>` (ordered) tags, help present information clearly. They break down content into easy-to-read points, improving organization.",
        "imageUrl": "https://images.code.org/e0a665345f70fb307bb770ef38967b26-test-lesson-2-content-review-panel-2-97cfee9e-2e22-49fc-962c-6a9f88742566.png",
        "layout": "text-top-right"
      },
      {
        "key": "test-lesson-2-content-review-2f4c1ce2-5ab7-4dfb-89bb-9b3da4b2532d",
        "text": "The `<img>` tag allows us to embed engaging images directly into our webpages using the `src` attribute. Remember the `alt` attribute for accessibility!",
        "imageUrl": "https://images.code.org/611df011ddce031a247ddf53de00a604-test-lesson-2-content-review-panel-3-2ae78996-8a1d-4567-9a34-8e8037cb2ca8.png",
        "layout": "text-bottom-left"
      },
      {
        "key": "test-lesson-2-content-review-e5b2d99d-083e-4fad-9a37-b6c6dd348097",
        "text": "Hyperlinks, made with the `<a>` tag and `href` attribute, connect your page to other pages or websites. This creates a navigable and interconnected web experience.",
        "imageUrl": "https://images.code.org/7fe2137abe13ae563286712507bb67ac-test-lesson-2-content-review-panel-4-1e8d7246-80ac-4a3e-a36e-21d2cb4eca6e.png",
        "layout": "text-bottom-right"
      },
      {
        "key": "test-lesson-2-content-review-95bcbff0-0685-4fd1-a16c-6f77e45af9bb",
        "text": "By combining headings, paragraphs, lists, images, and links, you can build rich, interactive webpages that effectively communicate your message and engage your audience.",
        "imageUrl": "https://images.code.org/431a4001de2e8c8fbd3a3d1b5256428d-test-lesson-2-content-review-panel-5-006df6c0-61bc-4a1c-9ed1-66b41787b260.png",
        "layout": "text-top-center"
      }
    ],
    "generate_prompt": "Summarize all the content-related HTML tags learned in the lesson (headings, paragraphs, lists, images, and links). Provide a brief overview of how these elements work together to build a rich webpage."
  },
