<Panels>
  <config><![CDATA[{
  "published": true,
  "game_id": 73,
  "created_at": "2026-04-24T02:31:06.000Z",
  "level_num": "custom",
  "user_id": 16889,
  "properties": {
    "encrypted": "false",
    "offer_browser_tts": "false",
    "panels": [
      {
        "text": "UX Design is the process of creating products that provide meaningful, smooth, and relevant experiences to users.",
        "imageUrl": "https://images.code.org/ea904832c5ab0ebd50286264726e0769-l2-p1.jpg",
        "key": "undefined-f97b510a-e1c0-4e9c-88a0-6911a42ef05a",
        "layout": "text-bottom-left"
      },
      {
        "text": "Designers create \"wireframes\"—digital blueprints that focus on the layout and functionality before any colors or images are added.",
        "imageUrl": "https://images.code.org/35e2ec77987685175f6ec5bde1629e65-l2-p2.jpg",
        "key": "undefined-e9c5e44d-7dc1-4c0b-b8f9-d4991047b009",
        "layout": "text-bottom-center"
      },
      {
        "text": "By researching human behavior, UX designers organize information so that the most important buttons are exactly where you expect them to be.",
        "imageUrl": "https://images.code.org/83eca41729b97d8e46318bcdadbdd732-l2-p3.jpg",
        "key": "undefined-27e7d451-ed33-4ec9-a662-b9f8fd73455f",
        "layout": "text-bottom-right"
      },
      {
        "text": "Great UX design ensures technology is usable for everyone, including people with different physical or cognitive abilities.",
        "imageUrl": "https://images.code.org/c284ed07e8be97fd96e49e48f26b2108-l2-p4.jpg",
        "key": "undefined-2c9ccff0-1dcc-43e3-bc17-dde6078e4cc9",
        "layout": "text-top-left"
      }
    ]
  },
