  "properties": {
    "panels": [
      {
        "key": "test-lesson-2-about-images-e792be05-c6ba-40ad-88c7-0e3cec2cda71",
        "text": "Remember how we learned about adding text? Now, let's make our pages more visually exciting! The `<img>` tag is how you embed images directly into your webpage.",
        "imageUrl": "https://images.code.org/37196971398a048cdae02becadb8f857-test-lesson-2-about-images-panel-1-b42ca487-91f4-42c4-a23b-855252d859b8.png",
        "layout": "text-top-left"
      },
      {
        "key": "test-lesson-2-about-images-44a5dc43-5a44-4cec-b704-6dfb6b1a8591",
        "text": "The `<img>` tag is *self-closing*, meaning it doesn't need a separate closing tag. It uses a special `src` (source) attribute to tell the browser *where* to find the image file.",
        "imageUrl": "https://images.code.org/866ada2366dcda09dcccb7d9f07dac22-test-lesson-2-about-images-panel-2-718b76b3-a426-4830-acd6-e88d74e67f00.png",
        "layout": "text-top-right"
      },
      {
        "key": "test-lesson-2-about-images-71523eb4-e82c-4fb0-853b-aa87f2bbc738",
        "text": "Another crucial attribute is `alt`. This provides 'alternative text' for the image. It's important for accessibility, describing the image for users who can't see it (like screen readers), or if the image fails to load.",
        "imageUrl": "https://images.code.org/1f382d3ad7b65f08eeb03fa46c015130-test-lesson-2-about-images-panel-3-0594e780-5d0d-4312-a4f5-5b943228875b.png",
        "layout": "text-bottom-left"
      }
    ],
    "generate_prompt": "Explain the purpose and syntax of the <img> tag. Detail the src attribute for specifying the image source and the alt attribute for accessibility, providing examples."
  },
