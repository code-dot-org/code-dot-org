  "properties": {
    "panels": [
      {
        "key": "agathaweb-interactivity-intro-4760ce7c-2fd3-42b9-8dc5-7787df9b021b",
        "text": "We've crafted the look of Agatha's website with HTML and CSS. But how do we make it truly magical and interactive?",
        "imageUrl": "https://images.code.org/c0c5d9dc3a0417209e15bb64dd0fecdd-agathaweb-interactivity-intro-panel-1-30f25169-8651-4c0d-9db3-47feff1f2df1.png",
        "layout": "text-top-center"
      },
      {
        "key": "agathaweb-interactivity-intro-08cb38d6-1bd5-4c32-8e27-e74ee6482169",
        "text": "This is where **JavaScript** casts its spell! It's the enchantment that allows your website to respond to every click and interaction.",
        "imageUrl": "https://images.code.org/f00a22c6bb7e9d99fb54aaa857fe5db3-agathaweb-interactivity-intro-panel-2-431f9e80-1b7e-4924-a969-79ad60805d87.png",
        "layout": "text-bottom-center"
      },
      {
        "key": "agathaweb-interactivity-intro-f82d63ae-9e14-402b-ac00-50b804042d8b",
        "text": "With JavaScript, your website can have pop-up spell descriptions, animated potion effects, or even validate customer orders. It brings the page to vibrant life!",
        "imageUrl": "https://images.code.org/846b55bb9f9ca45e318120338d9c70bb-agathaweb-interactivity-intro-panel-3-6e675f8a-e551-41be-9e18-9a8e6e164ca4.png",
        "layout": "text-top-right"
      }
    ],
    "generate_prompt": "Introduce JavaScript as the enchantment that brings Agatha's website to life, making it interactive. Explain that JavaScript can respond to user actions like clicks and add dynamic features to a webpage."
  },
