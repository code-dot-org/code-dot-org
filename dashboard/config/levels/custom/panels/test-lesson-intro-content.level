  "properties": {
    "panels": [
      {
        "key": "test-lesson-intro-content-e9d5d04f-a439-4e40-80db-8f2905c8c299",
        "text": "Webpages aren't just pretty pictures! They're built to share information, stories, and ideas with the world.",
        "imageUrl": "https://images.code.org/79c2007eca23c2b91048bfdda95d6156-test-lesson-intro-content-panel-1-1c2a8e2c-a747-4d50-a060-4cc9942630c7.png",
        "layout": "text-top-left"
      },
      {
        "key": "test-lesson-intro-content-645a21d1-f4f7-4d8e-a005-9517bdf552e3",
        "text": "HTML elements like `<h1>` for main titles and `<p>` for paragraphs give your content structure, making it easy to read and understand.",
        "imageUrl": "https://images.code.org/bf154bb97fffa7115ccd3614af07085a-test-lesson-intro-content-panel-2-5a7b68bc-bca3-46e5-b898-4d5c12b56168.png",
        "layout": "text-bottom-center"
      },
      {
        "key": "test-lesson-intro-content-4d4253e7-3fef-48e1-877a-81b2ae9e1cbc",
        "text": "Using **semantic HTML** means choosing the right element for the right kind of content. For example, use `<nav>` for navigation links.",
        "imageUrl": "https://images.code.org/05e1bf4f5c8cd73b3438e873833c1c72-test-lesson-intro-content-panel-3-cd2e32e0-5a5b-4df9-a201-f386471838dc.png",
        "layout": "text-top-right"
      },
      {
        "key": "test-lesson-intro-content-1b2c3938-83c0-41c8-8d5f-da863c598695",
        "text": "This thoughtful organization helps everyone, including search engines and assistive technologies, understand and navigate your webpage more effectively.",
        "imageUrl": "https://images.code.org/e213e57c7ef0d15ac651b663e6c953c5-test-lesson-intro-content-panel-4-90ffdffb-4183-466f-917d-70c1c8f4b9a9.png",
        "layout": "text-bottom-left"
      }
    ],
    "generate_prompt": "Explain why content is important on a webpage and how HTML elements like headings and paragraphs structure information. Introduce the concept of semantic HTML for readability and organization."
  },
