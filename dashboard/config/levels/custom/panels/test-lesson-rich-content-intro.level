<Panels>
  <config><![CDATA[{
  "game_id": 73,
  "created_at": "2026-05-20T01:56:22.000Z",
  "level_num": "custom",
  "user_id": 1,
  "properties": {
    "panels": [
      {
        "key": "test-lesson-rich-content-intro-ecfa12e2-bdfd-43b5-b514-90e7f011ab7b",
        "text": "Have you ever seen a webpage that's just a wall of plain text? It can be pretty boring to look at, right?",
        "imageUrl": "https://images.code.org/d5e36eca3beaae0540ac44a913168fe7-test-lesson-rich-content-intro-panel-1-48003ef8-aaf2-42fc-8376-47eec1c4eeda.png",
        "layout": "text-top-center"
      },
      {
        "key": "test-lesson-rich-content-intro-74f0f286-9a44-4d0e-be20-75d6f7c13ec8",
        "text": "Webpages don't have to be boring! We can make them much more informative and engaging by adding different kinds of content.",
        "imageUrl": "https://images.code.org/5ab704fb813ebcc3fae22dc6a2908436-test-lesson-rich-content-intro-panel-2-97dfc45b-7dce-4285-8674-aad3656d52d7.png",
        "layout": "text-top-left"
      },
      {
        "key": "test-lesson-rich-content-intro-9a7db9d5-12cc-4ed3-b909-639398088c7e",
        "text": "This lesson will show you how to use lists to organize information, embed images to add visual interest, and create hyperlinks to connect to other pages.",
        "imageUrl": "https://images.code.org/290abc8a699d5972eabdc682352028a8-test-lesson-rich-content-intro-panel-3-40c5dfe4-b4b7-4ab6-a623-473acbff98c2.png",
        "layout": "text-bottom-center"
      },
      {
        "key": "test-lesson-rich-content-intro-a5289a85-86aa-43f1-bd78-cab7f6b2906c",
        "text": "Get ready to transform your plain text into rich, interactive web content!",
        "imageUrl": "https://images.code.org/310a55bfc4e59f9796903b65469782df-test-lesson-rich-content-intro-panel-4-c84ba370-0c1d-4577-960e-9c44666325aa.png",
        "layout": "text-bottom-right"
      }
    ],
    "generate_outline": "Introduce the concept of rich web content beyond just paragraphs and headings. Explain that this lesson will cover lists, images, and hyperlinks as essential tools for making web pages more informative and engaging for middle school students."
  },
