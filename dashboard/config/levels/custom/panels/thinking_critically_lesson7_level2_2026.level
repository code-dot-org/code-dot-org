    "panels": [
      {
        "text": "###Check a trusted source\nSearch for the same information on a website you already trust.",
        "imageUrl": "https://images.code.org/b9b867a4898e8533d9d19d90652e4f90-Gemini_Generated_Image_oqf4jdoqf4jdoqf4.png",
        "key": "thinking_critically_lesson7_level2_2026-31ec809c-49de-4489-a7e8-016afcf23d44"
      },
      {
        "text": "###Look for agreement\nCheck if more than one source says the same thing.",
        "imageUrl": "https://images.code.org/4a83df78316c3bec7e4c20b611b3c5f5-Gemini_Generated_Image_kra0mrkra0mrkra0.png",
