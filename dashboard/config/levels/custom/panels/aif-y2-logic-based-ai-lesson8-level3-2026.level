    "offer_browser_tts": "false",
    "panels": [
      {
        "text": "Your simulation assumes growth can continue forever.  But in the real world, growth has limits. For example, a social media post can’t be seen by more people than there are in the world.",
        "imageUrl": "https://images.code.org/ef12aa60709fe92cffdf191c9dbbb0f8-earth.jpg",
        "key": "aif-y2-logic-based-ai-lesson8-level3-2026-324a7684-432b-4400-b480-b3848a605dd7",
        "layout": "text-bottom-center"
      },
      {
        "text": "That’s why scientists often use **logistic growth**. Logistic growth is growth that slows down as it gets closer to a limit.",
        "imageUrl": "https://images.code.org/402b5fe8a16b0ec5b2bed2d0ae08cc9c-Logistic Growth Chalkboard.jpg",
        "key": "aif-y2-logic-based-ai-lesson8-level3-2026-7c2a9b1b-a66b-46ba-8f7a-fcfc54d0557f",
        "layout": "text-bottom-center"
      }
    ],
    "use_links": "false"
  },
