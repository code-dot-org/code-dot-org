    "panels": [
      {
        "text": "**Boba Loyalty: “Do I get a free drink?”**\n\n```\n// Start\n// Process: set input\nlet stamps = 7; // try changing this number\n\n// Decision\nlet msg;\nif (stamps >= 10) {\n  // Process (Yes)\n  msg = \"🎉 Free boba unlocked!\";\n} else {\n  // Process (No)\n  let left = 10 - stamps;\n  msg = \"⭐ \" + left + \" more to go\";\n}\n\noutput.textContent = msg;",
        "imageUrl": "https://images.code.org/940cf01ab644c5bf957fba96af7c3f5f-U2L5L2a.png",
        "key": "ai-and-algorithmic-decisions-lesson5-level2-test-2025-4a108ea5-adeb-45ac-99b7-bb95a63ad69e",
        "layout": "text-top-right",
        "fadeInOverPrevious": false
      },
      {
        "text": "**Sneaker Drop Queue: “Early access or waitlist?”**\n\n```\n// Start\n// Process: set input\nlet position = 245; // try 88 to test Yes\n\n// Decision\nlet status;\nif (position <= 100) {\n  // Process (Yes)\n  status = \"⚡ Early access granted\";\n} else {\n  // Process (No)\n  status = \"⌛ Waitlist — hang tight\";\n}\n\noutput.textContent = status;\n",
        "imageUrl": "https://images.code.org/05a298ad32e5851be200425a200a5561-U2L5L2b.png",
        "key": "ai-and-algorithmic-decisions-lesson5-level2-test-2025-672ae7d1-3f32-4aee-849a-3ca72837a513"
      },
      {
        "text": "**Playlist Switcher: “HYPE or CHILL?”**\n\n```\n// Start\n// Process: set input\nlet mood = \"CHILL\"; // switch to \"HYPE\" to test\n\n// Decision\nlet playlist;\nif (mood === \"HYPE\") {\n  // Process (Yes)\n  playlist = \"🔊 TURN UP playlist\";\n} else {\n  // Process (No)\n  playlist = \"🎧 CHILL playlist\";\n}\n\noutput.textContent = playlist;\n",
        "imageUrl": "https://images.code.org/b5f8822dca3b4ea5cbbeb34e15a80ba5-U2L5L2c.png",
        "key": "ai-and-algorithmic-decisions-lesson5-level2-test-2025-a215e3f4-333c-40df-8208-12015d08e436"
      }
    ]
  },
