  "properties": {
    "panels": [
      {
        "key": "testlesson-intro-rave-page-63e1a185-21d6-49e4-af50-231edd4f6c18",
        "text": "Ever wanted to share your ideas, stories, or even a super cool event with the world? A web page is exactly like a digital poster board, ready for everyone to see!",
        "imageUrl": "https://images.code.org/20945ae5f42c8a3a4cdab8907a6aa57c-testlesson-intro-rave-page-panel-1-a1dcfe26-18af-43cc-aee3-486c9f2a4f75.png",
        "layout": "text-top-center"
      },
      {
        "key": "testlesson-intro-rave-page-b7c96daf-676b-40b0-b17a-c4affcbc884a",
        "text": "Now, imagine this: **Harry Potter at his very first rave!** What would it look like? What spells would he use? You're going to create a web page to show us!",
        "imageUrl": "https://images.code.org/3052b6eb726de1c9085a26f475bb047b-testlesson-intro-rave-page-panel-2-9eb74f08-fd41-4de2-aa84-d381989f60fa.png",
        "layout": "text-bottom-center"
      },
      {
        "key": "testlesson-intro-rave-page-187cc5f3-e7ef-4f7b-9cdc-36847845545b",
        "text": "To bring Harry's amazing rave to life on the web, we'll learn basic HTML. Think of HTML as the secret code and building blocks that construct all the websites you visit!",
        "imageUrl": "https://images.code.org/baf63ea21f161967ab88327349e96738-testlesson-intro-rave-page-panel-3-ea1861c2-b5f9-4ecb-aba8-0db92522c07d.png",
        "layout": "text-top-center"
      }
    ],
    "generate_prompt": "Introduce the concept of a web page as a digital poster. Frame the project: creating a web page about Harry Potter's first rave. Explain that students will learn basic HTML to build the page."
