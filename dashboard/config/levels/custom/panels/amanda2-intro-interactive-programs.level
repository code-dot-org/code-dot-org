  "level_num": "custom",
  "user_id": 19028,
  "properties": {
    "panels": [
      {
        "key": "amanda2-intro-interactive-programs-429fc651-b62b-4c81-9e1e-43dae5414b37",
        "text": "Have you ever used an app or website that asked for your name or preferences?",
        "imageUrl": "https://images.code.org/cb924849e1e1eea52f5a79088695afe6-amanda2-intro-interactive-programs-panel-1-5228c8f9-4a2a-467b-bc63-86b213436b6b.png",
        "layout": "text-top-center"
      },
      {
        "key": "amanda2-intro-interactive-programs-a0867c06-4897-4dd4-b4ff-a26bcdb1c034",
        "text": "That's an *interactive program* in action! It's designed to communicate directly with you.",
        "imageUrl": "https://images.code.org/f22827bd97738a53353c382a653abc9f-amanda2-intro-interactive-programs-panel-2-e8b7599e-e96c-4367-a6e3-725e835dba53.png",
        "layout": "text-top-center"
      },
      {
        "key": "amanda2-intro-interactive-programs-4b5f2391-8000-4849-a36e-f94674bd046f",
        "text": "Interactive programs can ask you questions, like \"What's your favorite color?\" or \"Where are you from?\"",
        "imageUrl": "https://images.code.org/35194806935b3c4cc503f11957a1c33f-amanda2-intro-interactive-programs-panel-3-9490a6c5-adc9-4bb8-9397-76fb4aa12b9d.png",
        "layout": "text-bottom-center"
      },
      {
        "key": "amanda2-intro-interactive-programs-ae62a568-a0f4-48cc-af63-86995aaf4e22",
        "text": "They then receive your input and can use it to give you a personalized response or experience.",
        "imageUrl": "https://images.code.org/8012bcc82afb54de6801bd08f4c99aef-amanda2-intro-interactive-programs-panel-4-90752209-5dad-4cc6-8500-356e68569d26.png",
        "layout": "text-bottom-center"
      }
    ],
    "generate_outline": "Learn what an interactive program is and how it can communicate with a user. This level introduces the concept of a program asking for and receiving information, laying the groundwork for user engagement."
  },
  "published": true,
