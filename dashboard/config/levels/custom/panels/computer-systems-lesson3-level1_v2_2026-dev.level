    "panels": [
      {
        "text": "**SELF**\n\nRestate the problem and make your best guesses about possible solutions. ",
        "imageUrl": "https://images.code.org/c35dd3c06c20b57512122df773cc0487-snot-troubleshooting-medium-shot-slight-high-angle-looking-down-at-a--1.png",
