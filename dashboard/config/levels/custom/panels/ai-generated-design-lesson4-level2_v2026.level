    "panels": [
      {
        "text": "# How To: Save To Your Backpack\n\nSaving your work to the Backpack lets you reuse it in the future.",
        "imageUrl": "https://images.code.org/0bef9fcda0f05c2d71d787ff1c16e2ca-Screenshot 2026-03-03 151845.png",
