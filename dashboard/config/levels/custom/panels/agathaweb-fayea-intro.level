  "properties": {
    "panels": [
      {
        "key": "agathaweb-fayea-intro-9e504c28-f83f-4b34-89fc-cd1d6b907884",
        "text": "Meet Fayea! She's a brave rabbit with glasses, a wand, and a sword, and she teaches self-defense lessons.",
        "imageUrl": "https://images.code.org/5eb7e251aaf991cb1021c66fbd0bdf68-agathaweb-fayea-intro-panel-1-1569a03d-8895-497e-a74b-bc0c843c1354.png",
        "layout": "text-top-left"
      },
      {
        "key": "agathaweb-fayea-intro-ac0362aa-3205-42e7-a947-ba5e6e88bc15",
        "text": "Fayea loves helping others learn to be strong and safe, but she can only teach a few students at a time.",
        "imageUrl": "https://images.code.org/78eadd1588bbce70f66e26f821ce13fe-agathaweb-fayea-intro-panel-2-617bde0d-b7c0-415a-80f4-0a2806a72925.png",
        "layout": "text-top-center"
      },
      {
        "key": "agathaweb-fayea-intro-6f2714b3-c6c1-4929-bdcf-a41d9da1e9b3",
        "text": "She wishes she could share her amazing lessons with everyone, far and wide, without leaving her home!",
        "imageUrl": "https://images.code.org/9d1ba1ac95fa3ccb5c6b4e4146ecad41-agathaweb-fayea-intro-panel-3-119cd711-fbcb-4791-bae3-3ac1279ec3c6.png",
        "layout": "text-bottom-center"
      },
      {
        "key": "agathaweb-fayea-intro-916e52f7-0e3f-4deb-b0dc-8802f26782bb",
        "text": "That's where a *website* comes in! A website is like an online clubhouse where Fayea can share all her knowledge.",
        "imageUrl": "https://images.code.org/97c5b4edabfa264ac808be0d86613269-agathaweb-fayea-intro-panel-4-511916f0-6e25-4785-a59f-f1fdd687faf4.png",
        "layout": "text-top-right"
      },
      {
        "key": "agathaweb-fayea-intro-b61afa78-6fdc-4b81-857b-08d9b784d65f",
        "text": "Anyone, anywhere, can visit Fayea's website and learn her self-defense lessons, helping her reach countless students!",
        "imageUrl": "https://images.code.org/338f15a293331144b3ded860839ac568-agathaweb-fayea-intro-panel-5-9033fc8c-cc1c-4049-adb5-ffcb9919aae6.png",
        "layout": "text-bottom-left"
      }
    ],
    "generate_prompt": "Introduce Fayea, a rabbit with glasses, a wand, and a sword. She wants to create a website to share her self-defense lessons. Explain why a website is a good tool for her goal, like reaching many students."
  },
