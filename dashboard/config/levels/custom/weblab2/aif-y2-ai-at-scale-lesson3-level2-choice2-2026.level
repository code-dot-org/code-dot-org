        "12",
        "13"
      ]
    }
  },
  "audit_log": "[{\"changed_at\":\"2026-11-20T18:40:54.878+00:00\",\"changed\":[\"cloned from \\\"aif-y2-ai-at-scale-lesson3-level2-choice1-2026\\\"\"],\"cloned_from\":\"aif-y2-ai-at-scale-lesson3-level2-choice1-2026\"},{\"changed_at\":\"2026-11-20 18:41:28 +0000\",\"changed\":[\"display_name\",\"long_instructions\",\"bubble_choice_description\",\"thumbnail_url\"],\"changed_by_id\":23838,\"changed_by_email\":\"brian@fifty.foundation\"}]"
}]]></config>
