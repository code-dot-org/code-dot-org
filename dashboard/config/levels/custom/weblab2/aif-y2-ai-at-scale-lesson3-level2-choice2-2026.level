      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Neuron</title>\n    <link rel=\"stylesheet\" href=\"styles.css\" />\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Geist+Mono:ital,wght@0,100..900;1,100..900&family=Geist:ital,wght@0,100..900;1,100..900&family=Space+Grotesk:wght@300..700&display=swap\"\n      rel=\"stylesheet\"\n    />\n  </head>\n  <body>\n    <header>\n      <h1>Artificial Neuron</h1>\n    </header>\n    <main>\n      <section class=\"neuron-section\" aria-label=\"Neuron\">\n        <div class=\"card-panel controls\">\n          <div class=\"input-stepper\" role=\"group\" aria-label=\"Number of inputs\">\n            <button\n              type=\"button\"\n              class=\"input-stepper__button input-stepper__button--remove\"\n              aria-label=\"Remove an input\"\n            >\n              −\n            </button>\n            <output class=\"input-stepper__count\" aria-live=\"polite\"\n              >1 input</output\n            >\n            <button\n              type=\"button\"\n              class=\"input-stepper__button input-stepper__button--add\"\n              aria-label=\"Add an input\"\n            >\n              +\n            </button>\n          </div>\n\n          <div class=\"activation-toggle\">\n            <input\n              type=\"checkbox\"\n              id=\"activation-toggle\"\n              class=\"activation-toggle__checkbox\"\n            />\n            <label class=\"activation-toggle__label\" for=\"activation-toggle\"\n              >ReLU activation</label\n            >\n          </div>\n\n          <p class=\"field__error\" id=\"neuron-error\"></p>\n        </div>\n\n        <div class=\"neuron-diagram\">\n          <!-- Wires between the boxes are drawn by wires.js. -->\n          <svg class=\"wires\" aria-hidden=\"true\" focusable=\"false\"></svg>\n\n          <ol class=\"input-list\" aria-label=\"Inputs and weights\"></ol>\n\n          <div class=\"field bias-field\">\n            <label class=\"field__label\" for=\"bias-input\">Bias</label>\n            <input\n              id=\"bias-input\"\n              class=\"number-field number-field--parameter\"\n              type=\"number\"\n              step=\"0.01\"\n              value=\"0\"\n              autocomplete=\"off\"\n            />\n          </div>\n\n          <div class=\"neuron\">\n            <div class=\"neuron__body\" data-wire-shape=\"circle\">\n              <span class=\"readout-label\">Sum</span>\n              <!-- Spans, not <output>s: <output> is a live region of its own,\n                   and changes are announced by #neuron-status instead. -->\n              <span class=\"readout-value\" id=\"sum-value\"></span>\n            </div>\n          </div>\n\n          <!-- Sits on the arrow from the neuron to the output while switched on. -->\n          <div class=\"activation-box\" id=\"activation-box\">\n            <span class=\"readout-label\">ReLU</span>\n            <svg\n              class=\"activation-box__graph\"\n              viewBox=\"0 0 48 28\"\n              aria-hidden=\"true\"\n              focusable=\"false\"\n            >\n              <path class=\"activation-box__axis\" d=\"M2 24 H46 M24 2 V26\" />\n              <path class=\"activation-box__curve\" d=\"M4 22 H24 L44 4\" />\n            </svg>\n          </div>\n\n          <div class=\"neuron-output\">\n            <span class=\"readout-label\">Output</span>\n            <span class=\"readout-value\" id=\"output-value\"></span>\n          </div>\n        </div>\n\n        <!-- What screen readers hear when the sum or output changes: see\n             announcer.js. -->\n        <p class=\"visually-hidden\" id=\"neuron-status\" role=\"status\"></p>\n      </section>\n\n      <section class=\"calculation-section\" aria-labelledby=\"calculation-heading\">\n        <div class=\"card-panel\">\n          <h2 class=\"calculation-section__heading\" id=\"calculation-heading\">\n            Calculation\n          </h2>\n        </div>\n        <div class=\"calculation-section__lines\">\n          <p class=\"calculation-section__line\" id=\"calculation-sum\"></p>\n          <p class=\"calculation-section__line\" id=\"calculation-output\"></p>\n        </div>\n      </section>\n    </main>\n\n    <template id=\"input-row-template\">\n      <li class=\"input-row\">\n        <div class=\"field\">\n          <label class=\"field__label input-row__value-label\"></label>\n          <input\n            class=\"number-field input-row__value\"\n            type=\"number\"\n            step=\"0.1\"\n            autocomplete=\"off\"\n          />\n        </div>\n        <div class=\"field\">\n          <label class=\"field__label input-row__weight-label\"></label>\n          <input\n            class=\"number-field number-field--parameter input-row__weight\"\n            type=\"number\"\n            step=\"0.01\"\n            autocomplete=\"off\"\n          />\n        </div>\n      </li>\n    </template>\n\n    <script type=\"module\" src=\"app.js\"></script>\n  </body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "app.js",
          "contents": "/**\n * app.js — the Neurons controller.\n *\n * Wires four pieces together:\n *   - the input stepper (how many inputs the neuron has)\n *   - the input list (each input's value and weight)\n *   - the bias field and the activation checkbox (plain DOM in index.html)\n *   - the wires between the boxes of the diagram\n *   - the calculation, in a card of its own below the neuron\n *   - the announcer, which tells screen readers the new sum and output\n *\n * Every change runs the same short path: read every box, and if they all hold\n * numbers, work out the sum and the output; then write them into the neuron\n * and the output box.\n *\n * The neuron shows the sum: every input times its weight, plus the bias. An\n * arrow carries it to the output. With ReLU activation on, the ReLU box sits on\n * that arrow and the output is the ReLU of the sum; with it off, the output is\n * the sum itself.\n *\n * A box that doesn't hold a number leaves a \"?\" in the neuron and the output,\n * and the error message names the box in words.\n *\n * The screen always updates at once. What is spoken goes through the announcer\n * instead, which waits for typing to stop before speaking.\n */\n\nimport { MAX_INPUTS, MIN_INPUTS, relu, weightedSum } from \"./model.js\";\nimport { createInputList } from \"./components/input-list.js\";\nimport { createInputStepper } from \"./components/input-stepper.js\";\nimport { createWires } from \"./components/wires.js\";\nimport { createAnnouncer } from \"./components/announcer.js\";\nimport { commitNumber, fieldName, readNumber } from \"./components/number-field.js\";\n\n// One input of 1, weighted 1. The bias starts at 0 (set in index.html), so the\n// output starts as the input itself, and the student builds up from there.\nconst INITIAL_ROWS = [{ value: 1, weight: 1 }];\nconst ERROR_ID = \"neuron-error\";\nconst UNKNOWN = \"?\";\n// Read in place of the \"?\", which a screen reader otherwise voices as a\n// question: \"Output?\"\nconst UNKNOWN_SPOKEN = \"unknown\";\n// The largest number that still fits on one line inside the neuron or the\n// output box. Past it, the number switches to scientific notation.\nconst MAX_PLAIN_NUMBER = 99999.9;\n\nconst diagram = document.querySelector(\".neuron-diagram\");\nconst list = document.querySelector(\".input-list\");\nconst neuronBody = document.querySelector(\".neuron__body\");\nconst sumValue = document.getElementById(\"sum-value\");\nconst outputBox = document.querySelector(\".neuron-output\");\nconst outputValue = document.getElementById(\"output-value\");\nconst biasField = document.querySelector(\".bias-field\");\nconst biasInput = document.getElementById(\"bias-input\");\nconst activationToggle = document.getElementById(\"activation-toggle\");\nconst activationBox = document.getElementById(\"activation-box\");\nconst errorMessage = document.getElementById(ERROR_ID);\nconst calculationSum = document.getElementById(\"calculation-sum\");\nconst calculationOutput = document.getElementById(\"calculation-output\");\n\nconst inputList = createInputList(list, {\n  rows: INITIAL_ROWS,\n  errorId: ERROR_ID,\n  onInput: () => render({ typing: true }),\n});\n\ncreateInputStepper(document.querySelector(\".input-stepper\"), {\n  min: MIN_INPUTS,\n  max: MAX_INPUTS,\n  count: INITIAL_ROWS.length,\n  onChange: (count) => {\n    inputList.setCount(count);\n    render();\n  },\n});\n\nconst wires = createWires(document.querySelector(\".wires\"));\nconst announcer = createAnnouncer(document.getElementById(\"neuron-status\"));\n\nconst listFormat = new Intl.ListFormat(\"en\", { type: \"conjunction\" });\n\nfunction render({ typing = false } = {}) {\n  const { values, missing } = inputList.read();\n  const bias = readNumber(biasInput, ERROR_ID);\n  if (bias === null) missing.push(fieldName(biasInput));\n\n  const useActivation = activationToggle.checked;\n  activationBox.classList.toggle(\"activation-box--on\", useActivation);\n\n  const sum = missing.length === 0 ? weightedSum(values, bias) : null;\n  const output = sum === null ? null : useActivation ? relu(sum) : sum;\n\n  renderNumber(sumValue, sum);\n  renderNumber(outputValue, output);\n  renderCalculation(values, bias, sum, output, useActivation);\n  const error = missing.length ? `Enter a number for ${missingText(missing)}.` : \"\";\n  errorMessage.textContent = error;\n\n  // One message covering everything, so the numbers and the reason they are\n  // unknown are heard together rather than as announcements racing each other.\n  // With the activation off, the output is the sum, so it is only said once.\n  const message = error\n    ? `Sum and output ${UNKNOWN_SPOKEN}. ${error}`\n    : useActivation\n      ? `Sum ${spoken(sum)}. Output ${spoken(output)}.`\n      : `Output ${spoken(output)}.`;\n  if (typing) announcer.afterTyping(message);\n  else announcer.now(message);\n\n  drawWires();\n}\n\n// The calculation card, with the student's own numbers in it:\n//   Sum = (1 × 1) + (1 × 1) + (−1.5) = 0.5\n//   Output = ReLU(0.5) = 0.5, since 0.5 > 0\n// Inputs are boxed and weights and the bias are pills, as in the diagram, so a\n// number can be traced back to the field it came from. A number that isn't a\n// number yet shows as \"?\", read as \"unknown\", like the readouts.\nfunction renderCalculation(values, bias, sum, output, useActivation) {\n  const terms = values.map(({ value, weight }) =>\n    term(\"(\", chip(value, \"input\"), \" × \", chip(weight, \"parameter\"), \")\"),\n  );\n  // A negative bias is parenthesized, so \"+ (−1.5)\" rather than \"+ −1.5\".\n  terms.push(\n    bias !== null && bias < 0 ? term(\"(\", chip(bias, \"parameter\"), \")\") : term(chip(bias, \"parameter\")),\n  );\n\n  const sumLine = [\"Sum = \"];\n  terms.forEach((part, index) => {\n    if (index > 0) sumLine.push(\" + \");\n    sumLine.push(part);\n  });\n  sumLine.push(\" = \", result(sum));\n  calculationSum.replaceChildren(...sumLine);\n\n  if (!useActivation) {\n    calculationOutput.replaceChildren(\"Output = Sum = \", result(output));\n    return;\n  }\n  const outputLine = [\"Output = \", term(\"ReLU(\", ...numberNodes(sum), \")\"), \" = \", result(output)];\n  if (sum !== null) {\n    const reason = term(\", since \", ...numberNodes(sum), sum > 0 ? \" > 0\" : \" ≤ 0\");\n    reason.classList.add(\"calculation__reason\");\n    outputLine.push(reason);\n  }\n  calculationOutput.replaceChildren(...outputLine);\n}\n\n// A run that stays on one line: the line breaks only between terms.\nfunction term(...children) {\n  const element = document.createElement(\"span\");\n  element.className = \"calculation__term\";\n  element.append(...children);\n  return element;\n}\n\nfunction chip(number, kind) {\n  const element = document.createElement(\"span\");\n  element.className = `calculation__value calculation__value--${kind}`;\n  element.append(...numberNodes(number));\n  return element;\n}\n\nfunction result(number) {\n  const element = term(...numberNodes(number));\n  element.classList.add(\"calculation__result\");\n  return element;\n}\n\n// The message has two lines at the right of the control panel, so past three\n// boxes it names the first two and counts the rest. Each box that needs a\n// number is still marked on its own, with aria-invalid and a dashed red border.\nfunction missingText(names) {\n  if (names.length <= 3) return listFormat.format(names);\n  return `${names[0]}, ${names[1]}, and ${names.length - 2} more`;\n}\n\nfunction drawWires() {\n  const rows = inputList.getRows();\n  // Side by side, every weight gets its own wire into the neuron. Stacked,\n  // those wires would have to cut across the rows below them, so the list\n  // feeds the neuron through a single arrow instead.\n  const stacked = neuronBody.getBoundingClientRect().top >= list.getBoundingClientRect().bottom;\n\n  const connections = rows.flatMap(({ valueInput, weightInput }) => {\n    const row = [{ from: valueInput, to: weightInput, sign: \"×\" }];\n    if (!stacked) row.push({ from: weightInput, to: neuronBody });\n    return row;\n  });\n  if (stacked) connections.push({ from: list, to: neuronBody, arrow: true });\n\n  connections.push({ from: biasField, to: neuronBody });\n  // One arrow whether or not the activation is on: the ReLU box, when shown,\n  // sits on top of it.\n  connections.push({ from: neuronBody, to: outputBox, arrow: true });\n\n  wires.draw(connections);\n}\n\n// 123456 → 1.23 × 10⁵, with thin spaces around the × so it stays compact.\n//\n// Wherever what is shown and what should be heard differ, the shown text is\n// hidden from screen readers and the words are put beside it, visually hidden:\n// the \"?\" is read as \"unknown\", and the exponent — a <sup>, which screen\n// readers don't announce as one, so \"1.23 times 10 5\" — as \"to the power of 5\".\n// That way a student reading the diagram with a screen reader, rather than\n// waiting for an announcement, hears the same thing the announcer would say.\n// Past 8 characters (\"−99999.9\"), a plain number is set smaller to stay on one\n// line. Weights in hundredths times inputs in tenths reach thousandths, so a\n// sum can run to \"−99999.875\" before scientific notation takes over.\nconst MAX_FULL_SIZE_CHARACTERS = 8;\n\nfunction renderNumber(element, number) {\n  const scientific = isScientific(number);\n  const long = !scientific && number !== null && format(number).length > MAX_FULL_SIZE_CHARACTERS;\n  element.classList.toggle(\"readout-value--scientific\", scientific);\n  element.classList.toggle(\"readout-value--long\", long);\n  element.replaceChildren(...numberNodes(number));\n}\n\n// A number as it is shown, with the words to read in place of anything shown\n// that shouldn't be read as it looks.\nfunction numberNodes(number) {\n  if (number === null) return [hidden(UNKNOWN), visuallyHidden(UNKNOWN_SPOKEN)];\n  if (!isScientific(number)) return [format(number)];\n\n  const { mantissa, power } = scientific(number);\n  const superscript = hidden(format(power), \"sup\");\n  superscript.className = \"readout-value__exponent\";\n  return [\n    `${format(mantissa)}\\u2009×\\u200910`,\n    superscript,\n    visuallyHidden(` to the power of ${format(power)}`),\n  ];\n}\n\n// A number in words, as the announcer says it.\nfunction spoken(number) {\n  if (number === null) return UNKNOWN_SPOKEN;\n  if (!isScientific(number)) return format(number);\n  const { mantissa, power } = scientific(number);\n  return `${format(mantissa)} times 10 to the power of ${format(power)}`;\n}\n\nfunction isScientific(number) {\n  return number !== null && Number.isFinite(number) && Math.abs(number) > MAX_PLAIN_NUMBER;\n}\n\n// Number() drops trailing zeros and the exponent's \"+\": \"1.00\", \"+5\" → 1, 5.\nfunction scientific(number) {\n  const [mantissa, exponent] = number.toExponential(2).split(\"e\");\n  return { mantissa: Number(mantissa), power: Number(exponent) };\n}\n\nfunction hidden(text, tag = \"span\") {\n  const element = document.createElement(tag);\n  element.setAttribute(\"aria-hidden\", \"true\");\n  element.textContent = text;\n  return element;\n}\n\nfunction visuallyHidden(text) {\n  const element = document.createElement(\"span\");\n  element.className = \"visually-hidden\";\n  element.textContent = text;\n  return element;\n}\n\n// A proper minus sign rather than a hyphen, which screen readers read as\n// \"minus\".\nfunction format(number) {\n  if (number === null) return UNKNOWN;\n  if (number === Infinity) return \"∞\";\n  if (number === -Infinity) return \"−∞\";\n  return String(number).replace(\"-\", \"−\");\n}\n\nbiasInput.addEventListener(\"input\", () => render({ typing: true }));\nbiasInput.addEventListener(\"change\", () => commitNumber(biasInput));\nactivationToggle.addEventListener(\"change\", () => render());\n\n// The wires depend on where the boxes land, which changes with the window, the\n// text size, and the web fonts arriving after first paint.\nnew ResizeObserver(() => drawWires()).observe(diagram);\ndocument.fonts?.ready.then(() => drawWires());\n\nrender();\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "model.js",
          "contents": "/**\n * model.js — what a single artificial neuron computes. Pure logic, no DOM.\n *\n * A neuron multiplies each input by that input's weight, adds the products\n * together, and adds its bias. That weighted sum is the neuron's output — or,\n * with an activation function switched on, the sum is passed through the\n * function first and whatever comes out is the output.\n *\n * The one activation offered is the ReLU, or rectified linear unit: the sum\n * itself when it is greater than 0, and 0 when it is 0 or less — max(0, sum).\n * The split is the canonical one, x if x > 0 and 0 if x ≤ 0. Either split gives\n * the same output at exactly 0, but this is the one students will meet in\n * print, and the calculation card names the branch taken.\n * It is the activation most modern networks use: it lets positive signals\n * through unchanged and silences negative ones.\n */\n\nexport const MIN_INPUTS = 1;\nexport const MAX_INPUTS = 5;\n\n// Floating-point arithmetic leaves crumbs — 0.1 × 3 comes out as\n// 0.30000000000000004, and 0.1 + 0.2 − 0.3 as a hair above zero. Rounding the\n// sum away from those crumbs means the number a student sees is the number the\n// ReLU is judged on, so a sum shown as 0 is never, underneath, a hair below it.\nconst DECIMAL_PLACES = 6;\n\n/**\n * The bias plus the sum of every input times its weight. `inputs` is a list of\n * `{ value, weight }`.\n */\nexport function weightedSum(inputs, bias) {\n  const sum = inputs.reduce((total, { value, weight }) => total + value * weight, bias);\n  return round(sum);\n}\n\nexport function relu(sum) {\n  return sum > 0 ? sum : 0;\n}\n\nfunction round(number) {\n  // Past about 1e15 there are no decimal places left to round, and scaling up\n  // would only overflow.\n  if (!Number.isFinite(number) || Math.abs(number) >= 1e15) return number;\n  const scale = 10 ** DECIMAL_PLACES;\n  // Adding 0 turns −0 into 0.\n  return Math.round(number * scale) / scale + 0;\n}\n",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "styles.css",
          "contents": "@import url(\"components/number-field.css\");\n@import url(\"components/input-list.css\");\n@import url(\"components/input-stepper.css\");\n@import url(\"components/wires.css\");\n\n:root {\n  --gray-0: #fdfdfd;\n  --gray-50: #f9f9f9;\n  --gray-100: #f4f4f4;\n  --gray-150: #eeeeee;\n  --gray-200: #e5e5e5;\n  --gray-300: #d4d4d4;\n  --gray-400: #a3a3a3;\n  --gray-500: #737373;\n  --gray-600: #525252;\n  --gray-700: #404040;\n  --gray-800: #262626;\n  --gray-900: #171717;\n  --gray-950: #0a0a0a;\n  --purple-0: rgb(245, 244, 253);\n  --purple-100: rgb(234, 232, 251);\n  --purple-200: rgb(214, 210, 246);\n  --purple-300: rgb(192, 188, 240);\n  --purple-400: rgb(169, 163, 232);\n  --purple-500: rgb(105, 98, 210);\n  --purple-600: rgb(82, 75, 184);\n  --purple-700: rgb(59, 53, 153);\n  --purple-800: rgb(41, 35, 126);\n  --purple-900: rgb(30, 25, 113);\n  --mint-0: rgb(244, 252, 247);\n  --mint-100: rgb(230, 247, 237);\n  --mint-200: rgb(211, 240, 211);\n  --mint-300: rgb(184, 228, 196);\n  --mint-400: rgb(141, 207, 170);\n  --mint-500: rgb(91, 175, 138);\n  --mint-600: rgb(56, 140, 110);\n  --mint-700: rgb(34, 107, 86);\n  --mint-800: rgb(21, 74, 60);\n  --mint-900: rgb(12, 46, 38);\n  --red-700: rgb(155, 28, 28);\n\n  /* A field's label height is fixed rather than left to the font, because\n       the input list offsets its rows by exactly one label (input-list.css). */\n  --field-label-size: 0.875rem;\n  --field-label-line-height: 1.25;\n  --field-gap: 0.35rem;\n}\n\nh1,\nh2,\nh3,\nh4,\nh5,\nh6,\np {\n  margin: 0;\n}\n\nbody {\n  align-items: center;\n  background-color: var(--gray-50);\n  box-sizing: border-box;\n  display: flex;\n  flex-direction: column;\n  font-family: \"Geist\", sans-serif;\n  justify-content: center;\n  margin: 0;\n  gap: 2em;\n  min-height: 100vh;\n  padding: 1.5em 1em;\n  color: var(--purple-900);\n}\n\nheader {\n  text-align: center;\n  max-width: 34em;\n}\n\nheader h1 {\n  font-family: \"Space Grotesk\", monospace;\n  font-weight: 700;\n}\n\nmain {\n  align-items: center;\n  display: flex;\n  flex-direction: column;\n  gap: 1em;\n  justify-content: center;\n  width: 100%;\n}\n\nsection {\n  background-color: var(--gray-0);\n  border-radius: 0.5em;\n  box-sizing: border-box;\n  box-shadow: 0px 2px 2px rgba(0, 0, 0, 0.3);\n  padding: 1em;\n}\n\n.heading {\n  font-family: \"Space Grotesk\", monospace;\n  font-weight: bold;\n}\n\n/* Fields */\n\n.field {\n  display: flex;\n  flex-direction: column;\n  gap: var(--field-gap);\n}\n\n.field__label {\n  font-family: \"Space Grotesk\", monospace;\n  font-size: var(--field-label-size);\n  font-weight: bold;\n  line-height: var(--field-label-line-height);\n}\n\n.field__error {\n  color: var(--red-700);\n}\n\n/* ---------- Section ---------- */\n\n.neuron-section {\n  display: flex;\n  flex-direction: column;\n  gap: 1.25em;\n  /* Room for the whole diagram side by side: inputs, neuron, arrow, output. */\n  max-width: 39em;\n  width: 100%;\n  /* The diagram's layout answers to this card's width (see \"Responsive\"). */\n  container: neuron-section / inline-size;\n}\n\n/* A panel across the top of a card: its own background, running to the card's\n   edges and into its rounded top corners, with a hairline where it meets the\n   rest. Gray rather than the pale purple, which in the diagram means the\n   neuron and its settings. */\n.card-panel {\n  background-color: var(--gray-100);\n  border-bottom: 1px solid var(--gray-200);\n  border-radius: 0.5em 0.5em 0 0;\n  margin: -1em -1em 0;\n  padding: 0.75em 1em;\n}\n\n/* The main card's panel holds the controls. */\n.controls {\n  align-items: center;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.75em 2em;\n  justify-content: flex-start;\n}\n\n/* The controls keep their size; only the error gives way. */\n.input-stepper,\n.activation-toggle {\n  flex-shrink: 0;\n}\n\n/* Pushed to the panel's right edge. Its two lines are held open whether or not\n   there is an error, and fit beside the 45px buttons, so a message arriving\n   never makes the panel taller and shifts everything below it — or, since the\n   page is centered, the − / + buttons above. When the panel is too narrow for\n   it beside the controls, it wraps onto a line of its own, still reserved. */\n.controls .field__error {\n  /* Centered against the buttons whether the message is one line or two. */\n  align-items: center;\n  display: flex;\n  flex: 1 1 12em;\n  font-size: 0.875rem;\n  justify-content: flex-end;\n  line-height: 1.25;\n  min-height: 2.5em;\n  text-align: end;\n}\n\n/* ---------- Activation toggle ---------- */\n\n.activation-toggle {\n  align-items: center;\n  display: flex;\n  gap: 0.5em;\n}\n\n.activation-toggle__checkbox {\n  accent-color: var(--purple-900);\n  cursor: pointer;\n  /* 24px — the minimum target (WCAG 2.5.8) — and the label widens it. */\n  height: 1.5em;\n  margin: 0;\n  width: 1.5em;\n}\n\n.activation-toggle__checkbox:focus-visible {\n  outline: 3px solid var(--purple-900);\n  outline-offset: 2px;\n}\n\n.activation-toggle__label {\n  cursor: pointer;\n  font-family: \"Space Grotesk\", monospace;\n  font-weight: 700;\n}\n\n/* ---------- Diagram ---------- */\n\n/* Inputs on the left, feeding the neuron, whose sum runs along an arrow to the\n   output on the right. The empty tracks are where the wires run: the arrow's\n   track is wide enough for the ReLU box to sit on it and still leave arrow\n   showing on both sides. */\n.neuron-diagram {\n  align-items: center;\n  display: grid;\n  grid-template-areas: \"inputs . neuron activation output\";\n  grid-template-columns: auto 4em auto 7em auto;\n  /* The wires are drawn in a layer beneath everything else in here. */\n  isolation: isolate;\n  justify-content: center;\n  padding: 0.5em 0;\n  position: relative;\n}\n\n.wires {\n  height: 100%;\n  inset: 0;\n  overflow: visible;\n  pointer-events: none;\n  position: absolute;\n  width: 100%;\n  z-index: -1;\n}\n\n.input-list {\n  grid-area: inputs;\n}\n\n.neuron {\n  grid-area: neuron;\n}\n\n.neuron__body {\n  align-items: center;\n  background-color: var(--purple-0);\n  border: 0.2em solid var(--purple-900);\n  border-radius: 50%;\n  box-sizing: border-box;\n  display: flex;\n  flex-direction: column;\n  height: 7em;\n  justify-content: center;\n  /* No side padding: the number sits across the circle's middle, where it is\n     widest, so it can use the full width inside the border. */\n  padding: 0.5em 0;\n  text-align: center;\n  width: 7em;\n}\n\n/* The same width as the neuron, and a fixed one: sized to its content, the\n   box would widen as the number grew and shift the whole diagram sideways. */\n.neuron-output {\n  align-items: center;\n  background-color: var(--purple-900);\n  border-radius: 0.5em;\n  box-sizing: border-box;\n  color: var(--gray-0);\n  display: flex;\n  flex-direction: column;\n  grid-area: output;\n  padding: 0.6em 0;\n  text-align: center;\n  width: 7em;\n}\n\n/* \"Sum\", \"ReLU\", \"Output\" — the small caps over each readout. */\n.readout-label {\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 0.8rem;\n  font-weight: 700;\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n}\n\n.neuron__body .readout-label {\n  color: var(--purple-700);\n}\n\n.neuron-output .readout-label {\n  color: var(--purple-100);\n}\n\n/* \"ReLU\" is a name with its own casing, not a word to set in capitals, so it\n   is shown exactly as written rather than as \"RELU\". */\n.activation-box .readout-label {\n  text-transform: none;\n}\n\n/* Sized so \"−99999.9\", the widest number shown before scientific notation\n   takes over, fits inside the circle's rim. The label above pushes the number\n   a little below the circle's middle, where the circle is narrower than its\n   diameter, so it is the chord there that counts, not the width of the box. */\n.readout-value {\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 1.3em;\n  font-variant-numeric: tabular-nums;\n  font-weight: 700;\n  line-height: 1.1;\n  /* A long number breaks inside its box rather than spilling out of it. */\n  max-width: 100%;\n  overflow-wrap: anywhere;\n}\n\n/* Scientific notation only appears past 99999.9, and is sized so that even\n   the widest case, \"−9.99 × 10³⁰⁸\", stays on one line inside the circle. */\n.readout-value--scientific {\n  font-size: 1em;\n  white-space: nowrap;\n}\n\n/* A plain number longer than \"−99999.9\" — one with thousandths, such as\n   \"−99999.875\" — is set smaller so it, too, stays on one line in the circle. */\n.readout-value--long {\n  font-size: 1em;\n  white-space: nowrap;\n}\n\n/* Held level with the digits, not raised into the line above: a superscript\n   would otherwise make the line taller and nudge the number off center. */\n.readout-value__exponent {\n  font-size: 0.6em;\n  line-height: 0;\n}\n\n/* Read by screen readers, not shown. */\n.visually-hidden {\n  clip-path: inset(50%);\n  height: 1px;\n  overflow: hidden;\n  position: absolute;\n  white-space: nowrap;\n  width: 1px;\n}\n\n/* Shares the neuron's cell and hangs 1.5em beneath the circle, so the circle\n   itself stays level with the middle of the input list. Given a row of its\n   own, the bias would sit out at the bottom of the list's reserved height\n   instead, far from the neuron it belongs to. */\n.bias-field {\n  align-items: center;\n  align-self: center;\n  grid-area: neuron;\n  justify-self: center;\n  transform: translateY(calc(50% + 3.5em + 1.5em));\n}\n\n/* Sits on the arrow from the neuron to the output, covering its middle, so the\n   sum visibly passes through it on the way. */\n.activation-box {\n  align-items: center;\n  background-color: var(--gray-0);\n  border: 0.125rem solid var(--purple-900);\n  border-radius: 0.5em;\n  display: flex;\n  flex-direction: column;\n  gap: 0.2em;\n  grid-area: activation;\n  justify-self: center;\n  padding: 0.4em 0.6em;\n  /* Holds its place while switched off, so toggling the activation never\n     moves anything else in the diagram. Hidden this way, it is hidden from\n     screen readers too. */\n  visibility: hidden;\n}\n\n.activation-box--on {\n  visibility: visible;\n}\n\n.activation-box__graph {\n  height: 1.75em;\n  width: 3em;\n}\n\n.activation-box__axis {\n  fill: none;\n  stroke: var(--gray-500);\n  stroke-width: 1.5px;\n}\n\n.activation-box__curve {\n  fill: none;\n  stroke: var(--purple-900);\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-width: 3px;\n}\n\n/* ---------- Calculation card ---------- */\n\n/* The same width as the main card, so the two line up as one column. */\n.calculation-section {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5em;\n  max-width: 39em;\n  width: 100%;\n}\n\n.calculation-section__heading {\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 1rem;\n}\n\n.calculation-section__line {\n  font-family: \"Geist Mono\", monospace;\n  font-size: 0.95rem;\n  font-variant-numeric: tabular-nums;\n  line-height: 1.8;\n}\n\n/* Room for three lines, so the sum can wrap once, which it can at five\n   inputs, without the card growing and — while the page fits the window and\n   is centered — the main card moving up under the student's pointer. The\n   spare room falls below the output, not between the two lines. */\n.calculation-section__lines {\n  min-height: calc(3 * 1.8 * 0.95rem);\n}\n\n.calculation__term {\n  white-space: nowrap;\n}\n\n/* The numbers wear the look of the fields they came from: inputs boxed,\n   weights and the bias in pills. Thin borders, since these are labels for\n   the fields, not fields themselves. */\n.calculation__value {\n  border: 1px solid;\n  padding: 0 0.3em;\n}\n\n.calculation__value--input {\n  border-color: var(--gray-500);\n  border-radius: 0.25em;\n}\n\n.calculation__value--parameter {\n  background-color: var(--purple-0);\n  border-color: var(--purple-600);\n  border-radius: 999px;\n}\n\n.calculation__result {\n  font-weight: 700;\n}\n\n.calculation__reason {\n  color: var(--purple-700);\n}\n\n/* ---------- Responsive ---------- */\n\n/* Too narrow to lay the diagram out left to right, so it runs top to bottom:\n   the inputs, then the neuron with its bias beside it, then the arrow down to\n   the output, with the ReLU box on the arrow. Above the neuron is where the\n   inputs' arrow comes in.\n\n   A container query in ems, not a media query in pixels: the side-by-side\n   diagram needs 36.5em, which grows with the text. Enlarging text alone\n   (WCAG 1.4.4) leaves the viewport's pixel width where it was, so a pixel\n   breakpoint kept the wide layout and scrolled the page sideways. The card's\n   width in ems shrinks as text grows, whatever the cause. */\n@container neuron-section (max-width: 36.5em) {\n  .neuron-diagram {\n    gap: 2.5em 0.75em;\n    grid-template-areas:\n      \"inputs inputs inputs\"\n      \"bias neuron .\"\n      \". activation .\"\n      \". output .\";\n    /* Equal side tracks that are allowed to shrink below the bias field's\n       width, so the neuron lands dead center under the inputs rather than\n       being nudged right by the bias beside it. */\n    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);\n    /* The arrow's row holds the ReLU box whether or not it is showing. */\n    grid-template-rows: auto auto 3.5em auto;\n  }\n\n  /* At 320px, a slightly smaller circle and bias box are what let the two fit\n     side by side inside the card. The output matches the circle. */\n  .neuron__body {\n    height: 6.5em;\n    width: 6.5em;\n  }\n\n  .neuron-output {\n    width: 6.5em;\n  }\n\n  /* Scaled down with the circle, for the same reason as above. */\n  .readout-value {\n    font-size: 1.15em;\n  }\n\n  .readout-value--scientific {\n    font-size: 0.9em;\n  }\n\n  .readout-value--long {\n    font-size: 0.9em;\n  }\n\n  .bias-field .number-field {\n    width: 4em;\n  }\n\n  /* The − / + buttons are above the list, and a page this narrow is taller\n     than the screen and never re-centers, so the list can grow freely. */\n  .input-list {\n    justify-self: center;\n    min-height: 0;\n    padding-bottom: 0;\n  }\n\n  .bias-field {\n    grid-area: bias;\n    justify-self: end;\n    transform: none;\n  }\n\n  .neuron-output {\n    justify-self: center;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    transition: none !important;\n  }\n}\n",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "announcer.js",
          "contents": "/**\n * announcer.js — the one place the widget speaks to screen readers from.\n *\n * The neuron's output changes with every keystroke, but a screen reader is\n * busy on every keystroke too: it echoes the key that was typed. An\n * announcement made at the same moment gets cut off by the echo, and the two\n * run together. Typing \"-12\" was heard as \"Output 12\" — \"Output\" from the\n * widget, \"1, 2\" from the echo — when the output was nothing of the kind.\n * Announcing on each keystroke also reads out every half-typed state in turn,\n * such as the \"Enter a number\" error for the lone \"-\" at the start of \"-12\".\n *\n * So what comes from typing is held until the typing stops, and only the\n * last state is said. What comes from a button or the checkbox is said\n * straight away, since nothing else is talking then. Either way, a message\n * identical to the last one is dropped: a change that leaves the output where\n * it was, like adding an input with a weight of 0, stays quiet.\n *\n * The region is a visually hidden `role=\"status\"` — polite and atomic — that\n * starts empty, so nothing is announced on page load.\n */\n\n// Long enough to outlast VoiceOver finishing its own reply to the typing. Each\n// field is an <input type=\"number\">, a stepper to VoiceOver, and once typing\n// stops, Safari's VoiceOver reads the field's whole new value aloud (\"one\n// hundred twenty-five\"). An announcement that lands while it is still talking\n// is dropped, not queued. At 1s that happened to every number longer than a\n// digit. 2s leaves room for a long value like \"−1234.5\" to be read in full.\nconst TYPING_PAUSE_MS = 2000;\n\nexport function createAnnouncer(region) {\n  let timer;\n  let lastMessage = null;\n\n  function say(message) {\n    clearTimeout(timer);\n    // The first message describes the page as it loaded. Nothing has changed\n    // yet, so there is nothing to announce — just something to compare with.\n    if (lastMessage === null || message === lastMessage) {\n      lastMessage = message;\n      return;\n    }\n    lastMessage = message;\n    region.textContent = message;\n  }\n\n  return {\n    // After a button press or a toggle.\n    now: say,\n    // After a keystroke: wait until the student stops typing.\n    afterTyping(message) {\n      clearTimeout(timer);\n      timer = setTimeout(() => say(message), TYPING_PAUSE_MS);\n    },\n  };\n}\n",
          "folderId": "1",
          "active": false
        },
        "6": {
          "id": "6",
          "name": "input-list.js",
          "contents": "/**\n * input-list.js — the neuron's inputs, one row per input.\n *\n * Each row pairs an input's value with that input's weight, cloned from\n * `#input-row-template`. Rows come and go from the end of the list only, so\n * \"Input 3\" always means the third row, and the numbering a student sees never\n * shuffles under them.\n *\n * A new row starts at 0 with a weight of 0: it joins the neuron without\n * changing the output, and the student decides what it should contribute.\n */\n\nimport { commitNumber, fieldName, readNumber } from \"./number-field.js\";\n\nconst NEW_ROW = { value: 0, weight: 0 };\n\nexport function createInputList(list, { rows = [], errorId, onInput } = {}) {\n  const template = document.getElementById(\"input-row-template\");\n  const entries = [];\n\n  function addRow({ value, weight } = NEW_ROW) {\n    const n = entries.length + 1;\n    const element = template.content.firstElementChild.cloneNode(true);\n\n    const valueInput = element.querySelector(\".input-row__value\");\n    const weightInput = element.querySelector(\".input-row__weight\");\n    label(element.querySelector(\".input-row__value-label\"), valueInput, `input-${n}`, `Input ${n}`);\n    label(element.querySelector(\".input-row__weight-label\"), weightInput, `weight-${n}`, `Weight ${n}`);\n    valueInput.value = String(value);\n    weightInput.value = String(weight);\n\n    list.append(element);\n    entries.push({ element, valueInput, weightInput });\n  }\n\n  function setCount(count) {\n    while (entries.length < count) addRow();\n    while (entries.length > count) entries.pop().element.remove();\n  }\n\n  /**\n   * Every row's `{ value, weight }`, with `null` standing in for a box that\n   * doesn't hold a number, plus the names of those boxes.\n   */\n  function read() {\n    const missing = [];\n    const values = entries.map(({ valueInput, weightInput }) => ({\n      value: readField(valueInput, missing),\n      weight: readField(weightInput, missing),\n    }));\n    return { values, missing };\n  }\n\n  function readField(input, missing) {\n    const number = readNumber(input, errorId);\n    if (number === null) missing.push(fieldName(input));\n    return number;\n  }\n\n  // One listener for every row, present and future.\n  list.addEventListener(\"input\", () => onInput?.());\n  list.addEventListener(\"change\", (event) => commitNumber(event.target));\n\n  rows.forEach(addRow);\n\n  return {\n    setCount,\n    read,\n    // The boxes themselves, for drawing wires between them.\n    getRows: () => entries.map(({ valueInput, weightInput }) => ({ valueInput, weightInput })),\n  };\n}\n\nfunction label(labelElement, input, id, text) {\n  input.id = id;\n  labelElement.htmlFor = id;\n  labelElement.textContent = text;\n}\n",
          "folderId": "1",
          "active": false
        },
        "7": {
          "id": "7",
          "name": "input-stepper.js",
          "contents": "/**\n * input-stepper.js — the − / + control for how many inputs the neuron has.\n *\n * At either limit the matching button is marked `aria-disabled` rather than\n * `disabled`. A disabled button drops keyboard focus to <body>, so a student\n * who presses \"+\" up to the limit would lose their place on the page; an\n * aria-disabled one keeps focus, is announced as unavailable, and simply does\n * nothing when pressed.\n *\n * The count is a polite live region, so each press is confirmed out loud\n * (\"3 inputs\") without moving focus off the button.\n */\n\nexport function createInputStepper(container, { min, max, count, onChange } = {}) {\n  const removeButton = container.querySelector(\".input-stepper__button--remove\");\n  const addButton = container.querySelector(\".input-stepper__button--add\");\n  const countOutput = container.querySelector(\".input-stepper__count\");\n\n  function render() {\n    countOutput.textContent = `${count} ${count === 1 ? \"input\" : \"inputs\"}`;\n    removeButton.setAttribute(\"aria-disabled\", String(count <= min));\n    addButton.setAttribute(\"aria-disabled\", String(count >= max));\n  }\n\n  function change(delta) {\n    const next = Math.min(max, Math.max(min, count + delta));\n    if (next === count) return;\n    count = next;\n    render();\n    onChange?.(count);\n  }\n\n  removeButton.addEventListener(\"click\", () => change(-1));\n  addButton.addEventListener(\"click\", () => change(1));\n\n  render();\n\n  return { getCount: () => count };\n}\n",
          "folderId": "1",
          "active": false
        },
        "8": {
          "id": "8",
          "name": "number-field.js",
          "contents": "/**\n * number-field.js — reading a number out of an `<input type=\"number\">`.\n *\n * Every box in the widget — each input, each weight, the bias — is read the\n * same way, so they all agree on what counts as a number and all flag a\n * missing one the same way: `aria-invalid`, and a pointer to the one message\n * that says which boxes need fixing (WCAG 3.3.1).\n *\n * A number field reports an empty value both when it is blank and when it\n * holds something that isn't a number yet, like a lone \"-\" typed on the way to\n * \"-2\". Both count as missing: the neuron can't compute with either.\n *\n * A field whose `step` is a power of ten holds values only to that many\n * decimal places: inputs to tenths (0.1), weights and the bias to hundredths\n * (0.01). What it holds is rounded as it is read, so the neuron always computes\n * with the rounded value, even mid-keystroke. The box itself is only rewritten\n * once the student commits the value, on `change`; rewriting it on every\n * keystroke would turn an input of \"0.25\" into \"0.3\" before the \"5\" was done\n * being typed.\n */\n\nexport function readNumber(input, errorId) {\n  const raw = input.value === \"\" ? NaN : input.valueAsNumber;\n  const valid = Number.isFinite(raw);\n\n  input.setAttribute(\"aria-invalid\", String(!valid));\n  if (valid) input.removeAttribute(\"aria-describedby\");\n  else input.setAttribute(\"aria-describedby\", errorId);\n\n  return valid ? roundToStep(input, raw) : null;\n}\n\n// Show the rounded value in the box. Call on `change`.\nexport function commitNumber(input) {\n  if (input.value === \"\" || !Number.isFinite(input.valueAsNumber)) return;\n  const rounded = String(roundToStep(input, input.valueAsNumber));\n  if (input.value !== rounded) input.value = rounded;\n}\n\nfunction roundToStep(input, value) {\n  if (!(Number(input.step) > 0)) return value;\n  // Past about 1e15 there are no decimal places left to round.\n  if (Math.abs(value) >= 1e15) return value;\n  // Shifting the decimal point in the number's text, rather than multiplying\n  // by 10 or dividing by 0.1, keeps binary rounding out of it: 0.35 / 0.1 is\n  // 3.4999999999999996, which would round down, but \"0.35e1\" is exactly 3.5.\n  // Adding 0 turns −0 into 0.\n  const places = (input.step.split(\".\")[1] ?? \"\").length;\n  return Number(`${Math.round(Number(`${value}e${places}`))}e-${places}`) + 0;\n}\n\n// The field's visible label, which is what the error message calls it.\nexport function fieldName(input) {\n  return input.labels[0].textContent.trim();\n}\n",
          "folderId": "1",
          "active": false
        },
        "9": {
          "id": "9",
          "name": "wires.js",
          "contents": "/**\n * wires.js — the lines joining the boxes of the neuron diagram.\n *\n * The SVG sits behind the whole diagram and is redrawn from the boxes' actual\n * positions on the page, so the wires follow whatever layout CSS settles on —\n * side by side on a wide screen, stacked on a narrow one — without this file\n * knowing which. Each wire runs from the edge of one box toward the center of\n * another and stops at that box's edge: a rectangle's border, or the rim of an\n * element marked `data-wire-shape=\"circle\"`.\n *\n * Every wire looks the same, whatever the weight on it: the weights are in\n * their boxes as numbers, and the wires only show what connects to what. That\n * is also why the SVG is aria-hidden — the connections are already the order\n * of the fields and readouts on the page.\n *\n * A wire can also carry a sign at its midpoint — the \"×\" between an input and\n * its weight — drawn on a disc of the card's color, so the line appears to run\n * into the sign and out the other side.\n */\n\nconst SVG_NS = \"http://www.w3.org/2000/svg\";\nconst SIGN_RADIUS = 8;\n\nexport function createWires(svg) {\n  const origin = svg.parentElement;\n\n  svg.innerHTML = `\n    <defs>\n      <marker id=\"wire-arrow\" viewBox=\"0 0 10 10\" refX=\"9\" refY=\"5\"\n              markerWidth=\"10\" markerHeight=\"10\" markerUnits=\"userSpaceOnUse\"\n              orient=\"auto-start-reverse\">\n        <path class=\"wires__arrowhead\" d=\"M0 0 L10 5 L0 10 Z\" />\n      </marker>\n    </defs>\n    <g class=\"wires__lines\"></g>\n  `;\n  const group = svg.querySelector(\".wires__lines\");\n\n  /**\n   * Replace every wire with `connections`, a list of `{ from, to, arrow,\n   * sign }`. `sign`, if given, is the text drawn at the wire's midpoint.\n   */\n  function draw(connections) {\n    const originRect = origin.getBoundingClientRect();\n    svg.setAttribute(\"viewBox\", `0 0 ${originRect.width} ${originRect.height}`);\n\n    const lines = connections.flatMap(({ from, to, arrow = false, sign }) => {\n      const a = shapeOf(from, originRect);\n      const b = shapeOf(to, originRect);\n      const start = edgePoint(a, b.cx, b.cy);\n      const end = edgePoint(b, a.cx, a.cy);\n\n      const line = document.createElementNS(SVG_NS, \"line\");\n      line.setAttribute(\"x1\", start.x);\n      line.setAttribute(\"y1\", start.y);\n      line.setAttribute(\"x2\", end.x);\n      line.setAttribute(\"y2\", end.y);\n      line.setAttribute(\"class\", \"wire\");\n      if (arrow) line.setAttribute(\"marker-end\", \"url(#wire-arrow)\");\n      if (!sign) return [line];\n      return [line, signAt((start.x + end.x) / 2, (start.y + end.y) / 2, sign)];\n    });\n\n    group.replaceChildren(...lines);\n  }\n\n  return { draw };\n}\n\nfunction signAt(x, y, text) {\n  const group = document.createElementNS(SVG_NS, \"g\");\n  group.setAttribute(\"class\", \"wires__sign\");\n\n  const disc = document.createElementNS(SVG_NS, \"circle\");\n  disc.setAttribute(\"cx\", x);\n  disc.setAttribute(\"cy\", y);\n  disc.setAttribute(\"r\", SIGN_RADIUS);\n\n  const label = document.createElementNS(SVG_NS, \"text\");\n  label.setAttribute(\"x\", x);\n  label.setAttribute(\"y\", y);\n  label.textContent = text;\n\n  group.append(disc, label);\n  return group;\n}\n\n// A box's center and half-size, relative to the diagram.\nfunction shapeOf(element, originRect) {\n  const rect = element.getBoundingClientRect();\n  return {\n    cx: rect.left - originRect.left + rect.width / 2,\n    cy: rect.top - originRect.top + rect.height / 2,\n    halfWidth: rect.width / 2,\n    halfHeight: rect.height / 2,\n    circle: element.dataset.wireShape === \"circle\",\n  };\n}\n\n// Where a line from the shape's center toward (x, y) crosses its edge.\nfunction edgePoint(shape, x, y) {\n  const dx = x - shape.cx;\n  const dy = y - shape.cy;\n  const length = Math.hypot(dx, dy);\n  if (length === 0) return { x: shape.cx, y: shape.cy };\n\n  if (shape.circle) {\n    return {\n      x: shape.cx + (dx / length) * shape.halfWidth,\n      y: shape.cy + (dy / length) * shape.halfWidth,\n    };\n  }\n\n  const t = Math.min(\n    dx === 0 ? Infinity : shape.halfWidth / Math.abs(dx),\n    dy === 0 ? Infinity : shape.halfHeight / Math.abs(dy),\n  );\n  return { x: shape.cx + dx * t, y: shape.cy + dy * t };\n}\n",
          "folderId": "1",
          "active": false
        },
        "10": {
          "id": "10",
          "name": "number-field.css",
          "contents": "/* number-field.css — the boxes a student types numbers into. */\n\n/* The border is the only thing marking out where a box starts and stops, so it\n   carries 3:1 against the card behind it (WCAG 1.4.11) — the same border the\n   Tokenization widget gives its fields. */\n.number-field {\n    appearance: textfield;\n    background-color: var(--gray-50);\n    border: 0.125rem solid var(--gray-500);\n    border-radius: 0.5rem;\n    box-sizing: border-box;\n    color: inherit;\n    font-family: \"Geist Mono\", monospace;\n    font-size: 1rem;\n    font-variant-numeric: tabular-nums;\n    padding: 0.4rem 0.35rem;\n    text-align: center;\n    width: 4.5em;\n}\n\n/* The browser's spin arrows are too small to hit (WCAG 2.5.8) and crowd a box\n   this narrow. The arrow keys still step the value, by the field's own step:\n   0.1 for an input, 0.01 for a weight or the bias. */\n.number-field::-webkit-inner-spin-button,\n.number-field::-webkit-outer-spin-button {\n    -webkit-appearance: none;\n    margin: 0;\n}\n\n/* Weights and the bias are the neuron's own settings — what learning adjusts —\n   while inputs are the data it is given. So they look different: inputs are\n   plain boxes, and weights and the bias are tinted pills. The shape carries the\n   difference on its own, without the color (WCAG 1.4.1), and the purple border\n   still clears 3:1 against the card (6.75:1, WCAG 1.4.11). */\n.number-field--parameter {\n    background-color: var(--purple-0);\n    border-color: var(--purple-600);\n    border-radius: 999px;\n}\n\n.number-field:focus {\n    border-color: var(--purple-600);\n    outline: 3px solid var(--purple-900);\n    outline-offset: 2px;\n}\n\n/* Paired with the error message beneath the diagram, which names the box in\n   words — the red border is never the only sign (WCAG 1.4.1). */\n.number-field[aria-invalid=\"true\"] {\n    border-color: var(--red-700);\n    border-style: dashed;\n}\n",
          "folderId": "1",
          "active": false
        },
        "11": {
          "id": "11",
          "name": "input-list.css",
          "contents": "/* input-list.css — the rows of inputs and their weights. */\n\n/* Tall enough for the most rows the stepper allows, with fewer rows centered\n   inside it. The page is centered vertically, so a list that grew with each\n   row would push the − / + buttons up the page by half a row every press, and\n   a student clicking \"+\" repeatedly would find the button no longer under the\n   pointer.\n\n   Centering the rows would center each whole row, label and all, leaving the\n   boxes — which is where the wires meet — below the middle by half a label.\n   Padding the bottom by one label (and the gap under it) moves them back up\n   by that half, so a lone input's wire runs level into the neuron's center.\n   The label's measurements are set on :root, in styles.css. */\n.input-list {\n    display: flex;\n    flex-direction: column;\n    gap: 0.75em;\n    justify-content: center;\n    list-style: none;\n    margin: 0;\n    min-height: 22.75em;\n    padding: 0 0 calc(var(--field-label-size) * var(--field-label-line-height) + var(--field-gap));\n}\n\n/* The gap between the two boxes is where the wire from input to weight runs,\n   with a \"×\" on it (drawn by wires.js), so it is wide enough for the line to\n   show on both sides of the sign. Aligning to the bottom keeps the two boxes\n   level, whatever their labels do. */\n.input-row {\n    align-items: flex-end;\n    display: flex;\n    gap: 2.5em;\n}\n",
          "folderId": "1",
          "active": false
        },
        "12": {
          "id": "12",
          "name": "wires.css",
          "contents": "/* wires.css — the lines in the diagram.\n\n   One style for every wire, clearing 3:1 against the card (WCAG 1.4.11). */\n\n.wire {\n    fill: none;\n    stroke: var(--purple-900);\n    stroke-linecap: round;\n    stroke-width: 2px;\n}\n\n.wires__arrowhead {\n    fill: var(--purple-900);\n}\n\n/* The \"×\" between an input and its weight. The disc is the card's color, so it\n   hides the wire behind the sign rather than drawing a shape of its own. */\n.wires__sign circle {\n    fill: var(--gray-0);\n}\n\n.wires__sign text {\n    dominant-baseline: central;\n    fill: var(--purple-900);\n    font-family: \"Space Grotesk\", monospace;\n    font-size: 16px;\n    font-weight: 700;\n    text-anchor: middle;\n}\n",
          "folderId": "1",
          "active": false
        },
        "13": {
          "id": "13",
          "name": "input-stepper.css",
          "contents": "/* input-stepper.css — the − / + control for the number of inputs. */\n\n.input-stepper {\n    align-items: center;\n    display: flex;\n    gap: 0.5em;\n}\n\n/* 2.25em is 36px at the default size: comfortably over the 24px minimum\n   target (WCAG 2.5.8). Colors are the repo's primary button. */\n.input-stepper__button {\n    align-items: center;\n    appearance: none;\n    background-color: var(--purple-900);\n    border: none;\n    border-radius: 0.25em;\n    color: var(--purple-0);\n    display: inline-flex;\n    font-family: \"Space Grotesk\", monospace;\n    font-size: 1.25rem;\n    font-weight: 700;\n    height: 2.25em;\n    justify-content: center;\n    line-height: 1;\n    padding: 0;\n    transition: background-color 0.1s ease-in-out;\n    width: 2.25em;\n}\n\n.input-stepper__button:not([aria-disabled=\"true\"]):hover {\n    background-color: var(--purple-800);\n    cursor: pointer;\n}\n\n.input-stepper__button:not([aria-disabled=\"true\"]):active {\n    background-color: var(--purple-700);\n}\n\n/* At a limit — visible, focusable, and plainly spent. */\n.input-stepper__button[aria-disabled=\"true\"] {\n    background-color: var(--gray-300);\n    color: var(--gray-700);\n    cursor: not-allowed;\n}\n\n.input-stepper__button:focus-visible {\n    outline: 3px solid var(--purple-900);\n    outline-offset: 2px;\n}\n\n/* Wide enough for \"5 inputs\", so the + button doesn't shift as the count\n   changes between one digit and the singular \"1 input\". */\n.input-stepper__count {\n    font-family: \"Space Grotesk\", monospace;\n    font-variant-numeric: tabular-nums;\n    font-weight: 700;\n    min-width: 4.5em;\n    text-align: center;\n}\n",
          "folderId": "1",
          "active": true
        }
      },
      "openFiles": [
        "1",
