  "properties": {
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "style.css",
          "contents": "@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n\n:root {\n  --bg: #f4f6fb;\n  --surface: #ffffff;\n  --ink: #1a1d29;\n  --muted: #6b7280;\n  --line: #e8ebf2;\n  --primary: #4f46e5;\n  --primary-dark: #4338ca;\n  --good: #16a34a;\n  --good-bg: #ecfdf3;\n  --alert: #dc2626;\n  --alert-bg: #fef2f2;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\n\nbody {\n  font-family: 'Inter', system-ui, sans-serif;\n  background: var(--bg);\n  color: var(--ink);\n  padding: 32px 24px;\n  line-height: 1.5;\n}\n\nmain { max-width: 1100px; margin: 0 auto; }\n\n/* Header */\n.app-header { margin-bottom: 28px; }\n\n.app-header h1 {\n  font-size: 1.9rem;\n  font-weight: 800;\n  letter-spacing: -0.5px;\n}\n\n.subtitle {\n  color: var(--muted);\n  font-size: 0.95rem;\n  margin-top: 4px;\n}\n\n/* Controls */\n#controls {\n  display: flex;\n  gap: 12px;\n  margin-bottom: 20px;\n  flex-wrap: wrap;\n}\n\nbutton {\n  padding: 11px 22px;\n  font-size: 0.95rem;\n  font-family: inherit;\n  font-weight: 600;\n  border: none;\n  border-radius: 10px;\n  cursor: pointer;\n  transition: transform 0.08s ease, background 0.15s ease, box-shadow 0.15s ease;\n}\n\nbutton:active { transform: scale(0.97); }\n\n.primary-btn {\n  background: var(--primary);\n  color: #fff;\n  box-shadow: 0 2px 8px rgba(79, 70, 229, 0.25);\n}\n\n.primary-btn:hover { background: var(--primary-dark); }\n\n.secondary-btn {\n  background: var(--surface);\n  color: var(--ink);\n  border: 1px solid var(--line);\n}\n\n.secondary-btn:hover { background: #f9fafb; }\n\n/* Status message */\n#statusMessage {\n  font-weight: 600;\n  font-size: 1rem;\n  color: var(--muted);\n  margin-bottom: 20px;\n  padding-left: 2px;\n}\n\n/* Card grid */\n#entriesList {\n  list-style: none;\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));\n  gap: 18px;\n}\n\nli {\n  background: var(--surface);\n  padding: 22px;\n  border-radius: 14px;\n  border: 1px solid var(--line);\n  box-shadow: 0 1px 3px rgba(16, 24, 40, 0.04), 0 4px 12px rgba(16, 24, 40, 0.04);\n  transition: transform 0.12s ease, box-shadow 0.12s ease;\n}\n\nli:hover {\n  transform: translateY(-2px);\n  box-shadow: 0 4px 8px rgba(16, 24, 40, 0.06), 0 12px 24px rgba(16, 24, 40, 0.08);\n}\n\nli h3 {\n  font-size: 1.1rem;\n  font-weight: 700;\n  margin-bottom: 2px;\n}\n\nli h3 small {\n  color: var(--muted);\n  font-weight: 500;\n  font-size: 0.8rem;\n}\n\n.email {\n  color: var(--muted);\n  font-size: 0.85rem;\n  display: block;\n  margin-bottom: 16px;\n  word-break: break-all;\n}\n\n.data-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 0.9rem;\n  padding: 7px 0;\n  border-bottom: 1px solid var(--line);\n}\n\n.data-row span:first-child {\n  color: var(--muted);\n  font-weight: 500;\n}\n\n.row-value { font-weight: 600; }\n\n.reason-box {\n  background: var(--bg);\n  padding: 12px 14px;\n  font-style: italic;\n  font-size: 0.88rem;\n  color: #4b5563;\n  margin-top: 14px;\n  border-radius: 8px;\n  border-left: 3px solid var(--line);\n}\n\n/* Data-quality highlights */\n.alert {\n  color: var(--alert);\n  font-weight: 700;\n}\n\n.good {\n  color: var(--good);\n  font-weight: 700;\n}\n\n.empty-message {\n  text-align: center;\n  color: var(--muted);\n  font-style: italic;\n  box-shadow: none;\n  border: 1px dashed var(--line);\n}\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "helpers.js",
          "contents": "// ===================================================\n// helpers.js — page setup and display code\n// You do not need to change anything in this file.\n// ===================================================\n\n// DOM element used for displaying the entries\nconst entriesList = document.getElementById(\"entriesList\");\n\n// Build one card for a single raffle entry and add it to the list\nconst addEntryCard = (entry) => {\n  const li = document.createElement(\"li\");\n\n  // Name + ID heading\n  const heading = document.createElement(\"h3\");\n  heading.textContent = entry.name + \" (ID: \" + entry.id + \")\";\n\n  // Email\n  const email = document.createElement(\"span\");\n  email.className = \"email\";\n  email.textContent = entry.email;\n\n  li.appendChild(heading);\n  li.appendChild(email);\n\n  // Unique entry row — green if true, red if false\n  const uniqueRow = makeRow(\"Unique Entry:\", String(entry.uniqueEntry));\n  const uniqueValue = uniqueRow.querySelector(\".row-value\");\n  uniqueValue.className = \"row-value \" + (entry.uniqueEntry ? \"good\" : \"alert\");\n  li.appendChild(uniqueRow);\n\n  // Age row — red if it isn't a real number\n  const ageRow = makeRow(\"Age:\", String(entry.age));\n  if (typeof entry.age !== \"number\") {\n    ageRow.querySelector(\".row-value\").className = \"row-value alert\";\n  }\n  li.appendChild(ageRow);\n\n  // Distance row\n  li.appendChild(makeRow(\"Distance:\", entry.distance_km + \" km\"));\n\n  // Reason box\n  const reason = document.createElement(\"div\");\n  reason.className = \"reason-box\";\n  reason.textContent = \"\\u201C\" + entry.reason + \"\\u201D\";\n  li.appendChild(reason);\n\n  entriesList.appendChild(li);\n};\n\n// Small helper: build one \"label : value\" row\nconst makeRow = (label, value) => {\n  const row = document.createElement(\"div\");\n  row.className = \"data-row\";\n\n  const labelSpan = document.createElement(\"span\");\n  labelSpan.textContent = label;\n\n  const valueSpan = document.createElement(\"span\");\n  valueSpan.className = \"row-value\";\n  valueSpan.textContent = value;\n\n  row.appendChild(labelSpan);\n  row.appendChild(valueSpan);\n  return row;\n};\n\n// Show a message when no entries match the filter\nconst showEmptyMessage = () => {\n  entriesList.innerHTML = \"\";\n  const li = document.createElement(\"li\");\n  li.className = \"empty-message\";\n  li.textContent = \"No entries match this filter.\";\n  entriesList.appendChild(li);\n};\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "data.js",
          "contents": "const raffleEntries = [\n  {\n    id: 1,\n    name: \"Aisha Khan\",\n    email: \"aisha.k@mail.com\",\n    age: 28,\n    reason: \"I am a huge fan of the organizer's mission and want to support it! Very excited for this chance.\",\n    distance_km: 4.5,\n    referralSource: \"Email Newsletter\",\n    uniqueEntry: true\n  },\n  {\n    id: 2,\n    name: \"Bot1748\",\n    email: \"bot_entry@placeholder.com\",\n    age: null,\n    reason: \"WINNING IS THE BEST. I REQUIRE ENTRY NOW. WINNING IS THE BEST. I REQUIRE ENTRY NOW.\",\n    distance_km: null,\n    referralSource: \"Social Media Ad\",\n    uniqueEntry: true\n  },\n  {\n    id: 3,\n    name: \"John Smith\",\n    email: \"jsmith@generic.net\",\n    age: 41,\n    reason: \"Don't know.\",\n    distance_km: 150,\n    referralSource: \"Search Engine\",\n    uniqueEntry: false\n  },\n  {\n    id: 4,\n    name: \"Marie Dubois\",\n    email: \"dubois_m@email.fr\",\n    age: 33,\n    reason: \"I've followed this event for years and finally have the chance to participate. I live close by!\",\n    distance_km: 1.2,\n    referralSource: \"Referral Code\",\n    uniqueEntry: true\n  },\n  {\n    id: 5,\n    name: \"Priya Sharma\",\n    email: \"p.sharma@domain.co\",\n    age: \"Prefer not to say\",\n    reason: \"No reason.\",\n    distance_km: 8.9,\n    referralSource: \"Social Media Ad\",\n    uniqueEntry: true\n  },\n  {\n    id: 6,\n    name: \"Alex\",\n    email: \"alex123@web.com\",\n    age: 22,\n    reason: \"I need to win the prize for my sister's birthday gift.\",\n    distance_km: 7.0,\n    referralSource: \"Email Newsletter\",\n    uniqueEntry: true\n  },\n  {\n    id: 7,\n    name: \"Zoe Chen\",\n    email: \"zchen@test.com\",\n    age: 18,\n    reason: \"...\",\n    distance_km: 50,\n    referralSource: \"Search Engine\",\n    uniqueEntry: true\n  },\n  {\n    id: 8,\n    name: \"Omar Hassan\",\n    email: \"omar_h@corp.org\",\n    age: 55,\n    reason: \"I have decades of experience with these types of raffles and believe I am a strong candidate.\",\n    distance_km: 3.1,\n    referralSource: \"Referral Code\",\n    uniqueEntry: false\n  },\n  {\n    id: 9,\n    name: \"Mia Rodriguez\",\n    email: \"mia.r@email.es\",\n    age: 29,\n    reason: \"This is a great opportunity. Looking forward to it!\",\n    distance_km: 9.9,\n    referralSource: \"Social Media Ad\",\n    uniqueEntry: true\n  },\n  {\n    id: 10,\n    name: \"Rajesh K.\",\n    email: \"rajeshk@internet.biz\",\n    age: 60,\n    reason: \"I hope to win.\",\n    distance_km: 2500,\n    referralSource: \"Other\",\n    uniqueEntry: true\n  },\n  {\n    id: 11,\n    name: \"S. Lee\",\n    email: \"S.Lee@work.net\",\n    age: 35,\n    reason: \"I am available for the event dates and meet all criteria.\",\n    distance_km: 0.5,\n    referralSource: \"Email Newsletter\",\n    uniqueEntry: true\n  },\n  {\n    id: 12,\n    name: \"Taehyung Kim\",\n    email: \"taehyung.k@mail.kr\",\n    age: 27,\n    reason: \"My friend told me to enter.\",\n    distance_km: 12.3,\n    referralSource: \"Referral Code\",\n    uniqueEntry: false\n  },\n  {\n    id: 13,\n    name: \"Sarah G.\",\n    email: \"sarahg@mail.com\",\n    age: 38,\n    reason: \"Absolutely love the prizes and would use them responsibly!\",\n    distance_km: 6.1,\n    referralSource: \"Social Media Ad\",\n    uniqueEntry: true\n  },\n  {\n    id: 14,\n    name: \"Chris N.\",\n    email: \"chrisn@corp.co\",\n    age: \"N/A\",\n    reason: \"I am interested in winning. The reason is simple: prize.\",\n    distance_km: 20.0,\n    referralSource: \"Search Engine\",\n    uniqueEntry: true\n  },\n  {\n    id: 15,\n    name: \"Eva Mendez\",\n    email: \"eva.m@mail.com\",\n    age: 30,\n    reason: \"This raffle is for a good cause, and I want to support it! Excellent initiative.\",\n    distance_km: 2.8,\n    referralSource: \"Referral Code\",\n    uniqueEntry: true\n  }\n];",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Raffle Entry Manager</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"data.js\" defer></script>\n  <script src=\"helpers.js\" defer></script>\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <main>\n    <header class=\"app-header\">\n      <h1>Raffle Admin Dashboard</h1>\n      <p class=\"subtitle\">Review entries and filter for eligible winners</p>\n    </header>\n\n    <div id=\"controls\">\n      <button id=\"showAllBtn\" class=\"secondary-btn\">Show All Entries</button>\n      <button id=\"showTopBtn\" class=\"primary-btn\">Filter Top Candidates</button>\n    </div>\n\n    <div id=\"statusMessage\">Showing: All Entries</div>\n\n    <ul id=\"entriesList\"></ul>\n  </main>\n\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "script.js",
          "contents": "// DOM elements\nconst showAllBtn = document.getElementById(\"showAllBtn\");\nconst showTopBtn = document.getElementById(\"showTopBtn\");\nconst statusMessage = document.getElementById(\"statusMessage\");\n\n// Display a list of raffle entries\nconst renderEntries = (list) => {\n  entriesList.innerHTML = \"\";\n\n  for (let i = 0; i < list.length; i++) {\n    addEntryCard(list[i]);\n  }\n};\n\n\n// Top Candidate Filter\nconst filterTopCandidates = () => {\n  let topList = [];\n\n  for (let i = 0; i < raffleEntries.length; i++) {\n\n\n  }\n\n  return topList;\n};\n\n\n\n// Event listeners\nshowAllBtn.addEventListener(\"click\", () => {\n  statusMessage.textContent = \"Showing: All Entries\";\n  renderEntries(raffleEntries);\n});\n\nshowTopBtn.addEventListener(\"click\", () => {\n  statusMessage.textContent = \"Showing: Top Candidates Only\";\n  const topList = filterTopCandidates();\n  renderEntries(topList);\n});\n\n// Initial render\nrenderEntries(raffleEntries);\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "3",
        "5"
      ]
    },
    "encrypted": "false",
    "long_instructions": "## Do This\r\n\r\nYou're judging an online raffle with a flood of applicants and the data is full of bots, duplicate entries, and people who don't meet the requirements.\r\n\r\n1. Look at the `raffleEntries` array in `data.js` and decide which properties make an entry valid.\r\n2. Inside `filterTopCandidates()` in `script.js`, write the logic that keeps only the entries meeting your criteria.\r\n3. Run the app and click \"Filter Top Candidates.\" Does the final list look like a set of real, eligible people?\r\n",
