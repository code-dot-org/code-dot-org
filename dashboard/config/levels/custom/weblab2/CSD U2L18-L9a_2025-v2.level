      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    \n    <!-- Hidden tip -->\n    <div>\n      <h1>Hover over this to show the hidden tip!</h1>\n      <p>TADA! HERE I AM!</p>\n    </div>\n\n\n\n\n\n\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* basic style for all text */\n* {\n  font-family: Verdana;\n  text-align: center;\n  font-weight: bold;\n}\n\n/* 1) Add properties to this paragraph rule set */\np {\n  padding: 15px;\n  \n  \n  \n}\n\n/* 2) ADD a rule set to style the paragraph child of the div with the hover pseudo-class */",
