        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Welcome</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n\n    <header>\n      <h1>Brand Name</h1>\n      <nav>\n        <a href=\"#about\">About</a>\n        <a href=\"#offerings\">What We Offer</a>\n        <a href=\"#visit\">Visit Us</a>\n      </nav>\n    </header>\n\n    <main>\n\n      <section id=\"hero\">\n        <h2>A tagline goes here</h2>\n        <p>A short description of what makes this place special and who it's for.</p>\n        <a href=\"#offerings\">Learn more</a>\n      </section>\n\n      <section id=\"about\">\n        <h2>About Us</h2>\n        <p>\n          This is where the brand story goes. What is this place? Who started it\n          and why? What values or ideas drive everything here? This paragraph\n          gives visitors a sense of the people and purpose behind the brand.\n        </p>\n        <p>\n          A second paragraph can add more detail — the history, the community,\n          or what sets this brand apart from others like it.\n        </p>\n      </section>\n\n      <section id=\"offerings\">\n        <h2>What We Offer</h2>\n\n        <article>\n          <h3>Item One</h3>\n          <p>A short description of the first offering, product, or feature.</p>\n        </article>\n\n        <article>\n          <h3>Item Two</h3>\n          <p>A short description of the second offering, product, or feature.</p>\n        </article>\n\n        <article>\n          <h3>Item Three</h3>\n          <p>A short description of the third offering, product, or feature.</p>\n        </article>\n\n      </section>\n\n      <section id=\"visit\">\n        <h2>Visit Us</h2>\n        <ul>\n          <li><strong>Location:</strong> 123 Main Street</li>\n          <li><strong>Hours:</strong> Mon–Fri, 9am–6pm</li>\n          <li><strong>Contact:</strong> <a href=\"mailto:hello@brand.com\">hello@brand.com</a></li>\n        </ul>\n      </section>\n\n    </main>\n\n    <footer>\n      <p>&copy; 2025 Brand Name. All rights reserved.</p>\n    </footer>\n\n  </body>\n</html>",
