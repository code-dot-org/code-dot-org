    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n\n    <!-- Parent container -->\n    <div class=\"parent\">\n      <!-- Children -->\n      <h2>Child Selector</h2>\n      <h4>The child selector (>) selects all elements that are the children of a specified element.</h4>\n      <p>Paragraph 1 in the div.</p>\n      <p>Paragraph 2 in the div.</p>\n      <div class=\"child\">\n        <!-- paragraph 3 is a descendant but not a child of the parent container -->\n        <p>Paragraph 3 in the div (inside a new container).</p>\n      </div>\n      <p>Paragraph 4 in the div.</p>\n    </div>\n\n    <p>Paragraph 5. Not in the div.</p>\n    <p>Paragraph 6. Not in the div.</p>\n\n    <!-- div container with a class attribute around the 4 images -->\n    <div class=\"container-1\">\n      <img class=\"special\" src=\"one.jpg\" alt=\"one\">\n      <img class=\"special\" src=\"two.jpg\" alt=\"two\">\n      <img src=\"three.jpg\" alt=\"three\">\n      <img src=\"four.jpg\" alt=\"four\">\n    </div>\n    \n    <!-- images not in a container -->\n    <img src=\"five.jpg\" alt=\"five\">\n    <img src=\"six.jpg\" alt=\"six\">\n\n\n\n\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* 1) Add a rule to the CSS file that uses the child selector to style the images within the container. */\n\n/* p child tags inside parent div */\n.parent > p {\n  background-color: yellow;\n}\n\n/* flex style for items in container */\n.container-1 {\n  /* The div container has a background color so you can see how the items are positioned within it */\n  background: #b691d6;\n\n  /* Create a flex layout context */\n  display: flex;\n\n  /* Define the flow direction \n  and if the items should wrap */\n  flex-flow: row wrap;\n\n  /* Define how items should be distributed horizontally across the container */\n  justify-content: space-evenly;\n\n  /* Define how items should be distributed vertically within the container */\n  align-items: center;\n\n}\n\n/* image style */\nimg {\n  border-style: double;\n  border-width: thick;\n}\n\n/* ADD CODE BELOW to style the images within the div container with the child selector */\n\n\n/* ADD CODE BELOW FOR THE EXTRA CHALLENGE to style the first two images within the div container with the child selector */",
          "folderId": "0",
          "active": false
        },
