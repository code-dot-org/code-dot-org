      "files": {
        "1": {
          "id": "1",
          "name": "utils.js",
          "contents": "document.addEventListener('click', (event) => {\n    if (event.target.classList.contains('order-trigger')) {\n        // Visual feedback only\n        const display = document.getElementById('cartDisplay');\n        display.style.color = \"#222\"; \n        setTimeout(() => {\n            display.style.color = \"#ff6600\";\n        }, 150);\n    }\n});",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": ":root {\n    --lc-orange: #ff6600;\n    --lc-dark: #222222;\n    --lc-white: #ffffff;\n}\n\n* {\n    box-sizing: border-box;\n}\n\nbody {\n    font-family: 'Roboto', sans-serif;\n    background-color: #f0f0f0;\n    margin: 0;\n    min-height: 100vh;\n    color: var(--lc-dark);\n}\n\n.app-shell {\n    width: min(100%, 1100px);\n    min-height: 100vh;\n    margin: 0 auto;\n    background: var(--lc-white);\n    display: flex;\n    flex-direction: column;\n    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);\n    overflow: hidden;\n}\n\n/* Header stays at the top */\n.fixed-top {\n    flex-shrink: 0;\n    z-index: 10;\n    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);\n}\n\n.navbar {\n    background: var(--lc-orange);\n    color: white;\n    padding: clamp(14px, 2.5vw, 18px) clamp(16px, 3vw, 24px);\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 12px;\n}\n\n.nav-title {\n    font-weight: 700;\n    text-align: center;\n}\n\n.cart-card {\n    padding: 15px 20px;\n    background: #fff;\n    border-bottom: 2px solid #f2f2f2;\n    text-align: center;\n}\n\n/* Scrollable Container */\n.scroll-content {\n    flex-grow: 1;\n    overflow-y: auto;\n    scrollbar-width: none;\n}\n\n.scroll-content::-webkit-scrollbar {\n    display: none;\n}\n\n.hero-banner {\n    position: relative;\n    height: clamp(180px, 30vw, 260px);\n    background-image: linear-gradient(to top, rgba(0,0,0,0.7), transparent),\n                      url('images/hero.jpg');\n    background-size: cover;\n    background-position: center;\n}\n\n.hero-overlay {\n    position: absolute;\n    bottom: 14px;\n    left: 18px;\n    color: white;\n}\n\n.hero-overlay p {\n    margin: 0 0 4px;\n    font-size: 0.8rem;\n    font-weight: 700;\n}\n\n.hero-overlay h2 {\n    margin: 0;\n    font-size: clamp(1.4rem, 3vw, 2rem);\n}\n\n#cartDisplay {\n    font-family: 'Oswald', sans-serif;\n    font-size: clamp(18px, 2.5vw, 24px);\n    color: var(--lc-orange);\n    text-transform: uppercase;\n    margin: 5px 0 0;\n}\n\n.cart-label {\n    font-size: 9px;\n    font-weight: 900;\n    color: #bbb;\n    margin: 0;\n}\n\n.menu-list {\n    padding: 8px 0 24px;\n}\n\n.menu-item {\n    display: flex;\n    align-items: center;\n    padding: 15px 20px;\n    border-bottom: 1px solid #f8f8f8;\n    gap: 15px;\n}\n\n.menu-item img {\n    width: 70px;\n    height: 70px;\n    border-radius: 10px;\n    object-fit: cover;\n    flex-shrink: 0;\n}\n\n.item-info {\n    flex: 1;\n    min-width: 0;\n}\n\n.item-info h3 {\n    margin: 0;\n    font-size: 15px;\n    font-weight: 700;\n}\n\n.item-info p {\n    margin: 2px 0 0;\n    font-weight: 900;\n    color: #666;\n    font-size: 13px;\n}\n\n.size-select {\n    margin-top: 8px;\n    padding: 7px 10px;\n    border: 1px solid #ddd;\n    border-radius: 8px;\n    background: white;\n    color: var(--lc-dark);\n    font-size: 13px;\n    font-family: 'Roboto', sans-serif;\n    width: 100%;\n    max-width: 130px;\n}\n\n.order-trigger {\n    width: 40px;\n    height: 40px;\n    border: 2px solid #eee;\n    background: white;\n    color: var(--lc-orange);\n    font-size: 20px;\n    font-weight: 700;\n    border-radius: 8px;\n    cursor: pointer;\n    flex-shrink: 0;\n}\n\n/* Tablet */\n@media (max-width: 767px) {\n    .app-shell {\n        width: 100%;\n    }\n}\n\n/* Mobile */\n@media (max-width: 480px) {\n    .navbar {\n        padding: 14px 16px;\n    }\n\n    .nav-title {\n        font-size: 0.95rem;\n    }\n\n    .cart-card {\n        padding: 12px 16px;\n    }\n\n    .hero-banner {\n        height: 150px;\n    }\n\n    .hero-overlay {\n        left: 14px;\n        bottom: 12px;\n    }\n\n    .hero-overlay p {\n        font-size: 0.72rem;\n    }\n\n    .hero-overlay h2 {\n        font-size: 1.3rem;\n    }\n\n    .menu-item {\n        padding: 12px 16px;\n        gap: 12px;\n    }\n\n    .menu-item img {\n        width: 56px;\n        height: 56px;\n    }\n\n    .item-info h3 {\n        font-size: 14px;\n    }\n\n    .item-info p {\n        font-size: 12px;\n    }\n\n    .size-select {\n        max-width: 115px;\n        font-size: 12px;\n        padding: 6px 8px;\n    }\n\n    .order-trigger {\n        width: 34px;\n        height: 34px;\n        font-size: 18px;\n    }\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Slices-N-Stix | Lab</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=Roboto:wght@400;700;900&display=swap\" rel=\"stylesheet\">\n</head>\n<body>\n\n    <div class=\"app-shell\">\n        <div class=\"fixed-top\">\n            <nav class=\"navbar\">\n                <span class=\"back-arrow\">←</span>\n                <div class=\"nav-title\">Menu - Pickup Order</div>\n                <div class=\"cart-box\">\n                    <span class=\"bag-icon\">🛒</span>\n                    <span id=\"bagCount\" class=\"cart-badge\">0</span>\n                </div>\n            </nav>\n\n            <div class=\"cart-card\">\n                <p class=\"cart-label\">ACTIVE SELECTION</p>\n                <h2 id=\"cartDisplay\">Cart is empty</h2>\n            </div>\n        </div>\n\n        <main class=\"scroll-content\">\n            <div class=\"hero-banner\">\n                <div class=\"hero-overlay\">\n                    <p>LIMITED TIME OFFER</p>\n                    <h2>SLICES-N-STIX</h2>\n                </div>\n            </div>\n\n            <div class=\"menu-list\">\n                <div class=\"menu-item\">\n                    <img src=\"images/mushroom-pizza.jpg\" alt=\"Mushroom pizza\">\n                    <div class=\"item-info\">\n                        <h3>Mushroom Special</h3>\n                        <p>$7.99</p>\n                        <select id=\"mushroomSize\" class=\"size-select\">\n                            <option value=\"Small\">Small</option>\n                            <option value=\"Medium\" selected>Medium</option>\n                            <option value=\"Large\">Large</option>\n                        </select>\n                    </div>\n                    <button id=\"mushroomBtn\" class=\"order-trigger\">+</button>\n                </div>\n\n                <div class=\"menu-item\">\n                    <img src=\"images/pepperoni-pizza.jpg\" alt=\"Pepperoni pizza\">\n                    <div class=\"item-info\">\n                        <h3>Classic Pepperoni</h3>\n                        <p>$6.99</p>\n                        <select id=\"pepperoniSize\" class=\"size-select\">\n                            <option value=\"Small\">Small</option>\n                            <option value=\"Medium\" selected>Medium</option>\n                            <option value=\"Large\">Large</option>\n                        </select>\n                    </div>\n                    <button id=\"pepperoniBtn\" class=\"order-trigger\">+</button>\n                </div>\n            </div>\n        </main>\n    </div>\n\n    <script src=\"utils.js\"></script>\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "active": false
        },
