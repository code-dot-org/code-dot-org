        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Weekday Reminder App</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n    <script defer src=\"script.js\"></script>\n  </head>\n  <body>\n    <h1 class=\"title\">Remind-Meow! Weekday Helper</h1>\n    <main class=\"container\">\n      <section class=\"left\">\n        <img id=\"image\" class=\"image\" src=\"image.png\" alt=\"Reminder illustration\" />\n      </section>\n      <section class=\"right\">\n        <div id=\"textArea\" class=\"textArea\" aria-live=\"polite\">Click a weekday to see your reminder.</div>\n        <div class=\"buttons\">\n          <button id=\"mondayButton\" type=\"button\">Monday</button>\n          <button id=\"tuesdayButton\" type=\"button\">Tuesday</button>\n          <button id=\"wednesdayButton\" type=\"button\">Wednesday</button>\n          <button id=\"thursdayButton\" type=\"button\">Thursday</button>\n          <button id=\"fridayButton\" type=\"button\">Friday</button>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nhtml,\nbody {\n  height: 100%;\n}\n\nbody {\n  margin: 0;\n  font-family: Arial, sans-serif;\n  background: #f7f7fb;\n  color: #222;\n}\n\n.title {\n  text-align: center;\n  margin: 16px 0 0;\n  font-size: 1.75rem;\n  letter-spacing: 0.5px;\n}\n\n.container {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 24px;\n  padding: 24px;\n  max-width: 1000px;\n  margin: 0 auto;\n}\n\n.left {\n  background: #fff;\n  border: 2px solid #ddd;\n  border-radius: 12px;\n  padding: 16px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n}\n\n.image {\n  display: block;\n  max-width: 100%;\n  height: auto;\n  border-radius: 8px;\n  object-fit: contain;\n}\n\n.right {\n  display: flex;\n  flex-direction: column;\n  gap: 24px;\n}\n\n.textArea {\n  min-height: 120px;\n  border: 2px dashed #9aa4b2;\n  border-radius: 12px;\n  padding: 16px;\n  background: #fff;\n  font-size: 1.1rem;\n  line-height: 1.4;\n}\n\n.buttons {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  width: 240px;\n  margin-inline: auto;\n}\n\n.buttons button {\n  padding: 12px 16px;\n  font-size: 1rem;\n  border-radius: 12px;\n  border: 2px solid #333;\n  background: #fff;\n  cursor: pointer;\n}\n\n.buttons button:hover {\n  background: #f0f4ff;\n}\n\n.buttons button:active {\n  transform: translateY(1px);\n}\n\n@media (max-width: 800px) {\n  .container {\n    grid-template-columns: 1fr;\n  }\n\n  .buttons {\n    width: 100%;\n  }\n}\n",
