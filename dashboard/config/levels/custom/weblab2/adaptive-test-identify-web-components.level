        "27a49b53-f2ec-4fe4-baac-2928bb10a76c": {
          "id": "27a49b53-f2ec-4fe4-baac-2928bb10a76c",
          "name": "index.html",
          "contents": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>My AI-Generated Page</title><link rel=\"stylesheet\" href=\"style.css\"></head><body><!-- Start Hero Section --><header class=\"hero\"><h1>Welcome to Our Amazing Service!</h1><p>Discover how we can help you achieve your goals with ease.</p><button class=\"hero-button\" onclick=\"alert('Learn More clicked!')\">Learn More</button></header><!-- End Hero Section --><main><!-- Start Feature Cards Section --><section class=\"features-container\"><h2>What We Offer</h2><div class=\"feature-card\"><h3>Feature One</h3><p>Description for the first fantastic feature.</p></div><div class=\"feature-card\"><h3>Feature Two</h3><p>Description for the second incredible feature.</p></div><div class=\"feature-card\"><h3>Feature Three</h3><p>Description for the third unique feature.</p></div></section><!-- End Feature Cards Section --><!-- Start Interactive Element Section --><section class=\"interactive-section\"><h2>Interactive Area</h2><button id=\"interactiveBtn\" onclick=\"document.getElementById('interactiveMsg').innerText = 'You clicked the button!';\">Click Me!</button><p id=\"interactiveMsg\">Try clicking the button above.</p></section><!-- End Interactive Element Section --><!-- Start Call-to-Action Section --><section class=\"cta-section\"><h2>Ready to Get Started?</h2><p>Join us today and transform your experience.</p><a href=\"#signup\" class=\"cta-button\">Sign Up Now!</a></section><!-- End Call-to-Action Section --><script>document.getElementById('interactiveBtn').addEventListener('mouseover', function() { console.log('Mouse over interactive button'); });</script></body></html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "ae5510b1-bbad-48c0-9005-3d4fd8a6fc07": {
          "id": "ae5510b1-bbad-48c0-9005-3d4fd8a6fc07",
          "name": "style.css",
          "contents": "body { font-family: 'Arial', sans-serif; margin: 0; padding: 0; background-color: #f4f7f6; color: #333; line-height: 1.6; } .hero { background-color: #007bff; color: white; text-align: center; padding: 80px 20px; } .hero h1 { font-size: 2.8em; margin-bottom: 10px; } .hero p { font-size: 1.2em; margin-bottom: 30px; } .hero-button { background-color: #28a745; color: white; padding: 12px 25px; border: none; border-radius: 5px; cursor: pointer; font-size: 1.1em; transition: background-color 0.3s ease; } .hero-button:hover { background-color: #218838; } .features-container { display: flex; justify-content: center; flex-wrap: wrap; padding: 40px 20px; gap: 20px; background-color: #fff; } .features-container h2 { width: 100%; text-align: center; margin-bottom: 30px; color: #007bff; font-size: 2em; } .feature-card { background-color: #e9ecef; border-radius: 8px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); padding: 25px; width: 300px; text-align: center; transition: transform 0.3s ease; } .feature-card:hover { transform: translateY(-5px); } .feature-card h3 { color: #0056b3; margin-bottom: 10px; } .interactive-section { text-align: center; padding: 50px 20px; background-color: #f8f9fa; border-top: 1px solid #dee2e6; } .interactive-section button { background-color: #ffc107; color: #333; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer; font-size: 1em; margin-top: 15px; } .cta-section { background-color: #007bff; color: white; text-align: center; padding: 60px 20px; margin-top: 30px; } .cta-section h2 { font-size: 2.5em; margin-bottom: 15px; } .cta-section p { font-size: 1.1em; margin-bottom: 30px; } .cta-button { background-color: #28a745; color: white; padding: 15px 30px; border-radius: 5px; text-decoration: none; font-size: 1.2em; display: inline-block; transition: background-color 0.3s ease; } .cta-button:hover { background-color: #218838; }",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
