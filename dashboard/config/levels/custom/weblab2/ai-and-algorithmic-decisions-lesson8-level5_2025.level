      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n<head>\n  <title>Output Screen</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n\n  <section class=\"screen\">\n    \n    <h1>Output Screen</h1>\n    \n    <div id=\"output\">\n      <img id=\"image\" class=\"hide\" src=\"placeholder.jpg\" alt=\"Result image\" >\n      <p id=\"message\">Your output will appear here.</p>\n    </div>\n    \n  </section>\n\n  <script src=\"script.js\"></script>\n  \n</body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "styles.css",
          "language": "css",
          "contents": "body {\n  font-family: system-ui, sans-serif;\n  background-color: #f5f7fb;\n  color: #222;\n  text-align: center;\n  margin: 0;\n  padding: 40px;\n}\n\n.screen {\n  background: #ffffff;\n  border: 2px solid #e3e6ef;\n  border-radius: 12px;\n  padding: 24px;\n  width: 300px;\n  margin: 60px auto;\n  box-shadow: 0 6px 14px rgba(0, 0, 0, 0.05);\n}\n\nh1 {\n  font-size: 1.25rem;\n  margin-top: 0;\n  margin-bottom: 20px;\n  color: #333;\n}\n\n#image {\n  width: 100%;\n}\n\n.label {\n  font-size: 0.9rem;\n  color: #555;\n  margin-bottom: 4px;\n}\n\n#output {\n  background: #f0f2f8;\n  border: 1px solid #d5d9e3;\n  border-radius: 8px;\n  padding: 16px;\n  margin-top: 8px;\n  font-size: 1rem;\n  min-height: 50px;\n  color: #222;\n}\n\n/* ----- Visibility Control ----- */\n.hide {\n  opacity: 0;\n  visibility: hidden;\n}\n\n.show {\n  opacity: 1;\n  visibility: visible;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const output = document.getElementById(\"output\");\nconst image = document.getElementById(\"image\");\nconst message = document.getElementById(\"message\");\n\n// Shows the image by changing its class to 'show'\nimage.classList.remove(\"hide\");\nimage.classList.add(\"show\");\n\n// Updates the message by changing its text content\nmessage.textContent = \"Your output text will go here.\";",
          "folderId": "0",
          "active": true
        },
