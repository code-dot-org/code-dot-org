      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>Movie Cards</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    <h1>Movie Collection</h1>\n    <div id=\"cards-container\"></div>\n    <script src=\"data.js\" defer></script>\n    <script src=\"helpers.js\" defer></script>\n    <script src=\"script.js\" defer></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: sans-serif;\n  background-color: #f4f4f9;\n  padding: 20px;\n}\n\nh1 {\n  text-align: center;\n  color: #333;\n}\n\n/* Container to hold all cards */\n#cards-container {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 20px;\n}\n\n/* Individual Card Styling */\n.card {\n  background: white;\n  border: 1px solid #ddd;\n  border-radius: 8px;\n  width: 250px;\n  overflow: hidden; /* Keeps image corners rounded */\n  box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n  display: flex;\n  flex-direction: column;\n}\n\n.card-image {\n  width: 100%;\n  height: 150px;\n  object-fit: cover; /* Ensures placeholder/image fills area nicely */\n  background-color: #eee;\n}\n\n.card-content {\n  padding: 15px;\n}\n\n.card-title {\n  margin-top: 0;\n  font-size: 1.2em;\n  color: #222;\n}\n\n.card-meta {\n  font-size: 0.9em;\n  color: #666;\n  margin-bottom: 10px;\n  font-style: italic;\n}\n\n.card-rating {\n  font-weight: bold;\n  color: #007bff; /* Blue for emphasis */\n  margin-bottom: 10px;\n}\n\n.card-summary {\n  font-size: 0.9em;\n  line-height: 1.4;\n  color: #444;\n}\n\n.read-more-btn {\n  display: inline-block;\n  margin-top: 10px;\n  padding: 8px 12px;\n  background-color: transparent;\n  border: 1px solid #333;\n  border-radius: 20px;\n  text-decoration: none;\n  color: #333;\n  font-size: 0.85em;\n  width: fit-content;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const container = document.querySelector(\"#cards-container\");\n\nfor (let i = 0; i < movies.length; i++) {\n  const movie = movies[i];\n\n  // --- YOUR FALLBACK LOGIC GOES HERE ---\n  // Check each field that might be null.\n  // Reassign the value before the card is built.\n\n\n\n\n  // --- BUILD AND DISPLAY THE CARD ---\n  const card = buildCard(movie);\n  container.appendChild(card);\n}",
          "folderId": "0",
          "active": true
        },
        "9": {
          "id": "9",
          "name": "placeholder.jpg",
          "language": "jpg",
          "contents": "",
          "folderId": "1",
          "url": "/level_starter_assets/iterating-with-ai-lesson5-level5-test-2025/uuid/f0697ef3-fb6f-40f0-9c15-4233776cb341.jpg",
          "type": "starter",
          "active": false
        },
        "10": {
          "id": "10",
          "name": "data.js",
          "contents": "const movies = [\n  {\n    title: \"Hollow Signal\",\n    genre: \"Sci-Fi\",\n    runtime: 94,\n    rating: null,\n    imageURL: \"images/hollow_signal.png\",\n    summary: null\n  },\n  {\n    title: \"The Ember Road\",\n    genre: \"Drama\",\n    runtime: 112,\n    rating: 4.2,\n    imageURL: \"images/ember_road.png\",\n    summary: \"Two strangers cross the country with nothing but a broken car and an old map.\"\n  },\n  {\n    title: \"Neon Tide\",\n    genre: \"Thriller\",\n    runtime: 88,\n    rating: null,\n    imageURL: null,\n    summary: \"A city sleeps. A signal wakes something that was never meant to be found.\"\n  },\n  {\n    title: \"Frostbound\",\n    genre: \"Adventure\",\n    runtime: 105,\n    rating: 3.8,\n    imageURL: \"images/frostbound.png\",\n    summary: null\n  }\n];",
          "folderId": "0",
          "active": false
        },
        "11": {
          "id": "11",
          "name": "helpers.js",
          "contents": "const buildCard = (movie) => {\n  const card = document.createElement(\"div\");\n  card.classList.add(\"card\");\n  card.innerHTML = `\n    <img class=\"card-image\" src=\"${movie.imageURL}\" alt=\"movie poster\">\n  `;\n  return card;\n};",
          "folderId": "0",
          "active": false
        },
