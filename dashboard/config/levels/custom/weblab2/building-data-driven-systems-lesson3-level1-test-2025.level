      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>VibeCheck Queue</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <main class=\"app-container\">\n    <header>\n      <h1>VibeCheck 🎧</h1>\n      <p>Party Playlist Manager</p>\n    </header>\n\n    <section class=\"input-card\">\n      <h3>Queue Controls</h3>\n      \n      <div class=\"input-group\">\n        <label>Song Title</label>\n        <input type=\"text\" id=\"input-song\" placeholder=\"e.g. Levitating\">\n      </div>\n      <div class=\"input-group\">\n        <label>Artist Name</label>\n        <input type=\"text\" id=\"input-artist\" placeholder=\"e.g. Dua Lipa\">\n      </div>\n\n      <div class=\"controls\">\n        <button id=\"btn-add\" class=\"btn primary\">Add to End (push)</button>\n        <button id=\"btn-vip\" class=\"btn special\">VIP Bump (unshift)</button>\n        <button id=\"btn-play\" class=\"btn action\">Play Next (shift)</button>\n        <button id=\"btn-veto\" class=\"btn danger\">Veto Last (pop)</button>\n      </div>\n    </section>\n\n    <hr>\n\n    <section id=\"player-display\">\n      <div class=\"status-bar\">\n        <p>Total in Queue: <span id=\"count\">0</span></p>\n      </div>\n\n      <div class=\"track-slot active\">\n        <div class=\"slot-num\">1</div>\n        <div class=\"track-info\">\n          <p class=\"song\" id=\"song1\">---</p>\n          <p class=\"artist\" id=\"artist1\">---</p>\n        </div>\n      </div>\n      \n      <div class=\"track-slot\">\n        <div class=\"slot-num\">2</div>\n        <div class=\"track-info\">\n          <p class=\"song\" id=\"song2\">---</p>\n          <p class=\"artist\" id=\"artist2\">---</p>\n        </div>\n      </div>\n\n      <div class=\"track-slot\">\n        <div class=\"slot-num\">3</div>\n        <div class=\"track-info\">\n          <p class=\"song\" id=\"song3\">---</p>\n          <p class=\"artist\" id=\"artist3\">---</p>\n        </div>\n      </div>\n\n      <div class=\"track-slot\">\n        <div class=\"slot-num\">4</div>\n        <div class=\"track-info\">\n          <p class=\"song\" id=\"song4\">---</p>\n          <p class=\"artist\" id=\"artist4\">---</p>\n        </div>\n      </div>\n    </section>\n\n  </main>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// DOM ELEMENTS\nconst inputSong = document.querySelector(\"#input-song\");\nconst inputArtist = document.querySelector(\"#input-artist\");\n\nconst song1 = document.querySelector(\"#song1\");\nconst artist1 = document.querySelector(\"#artist1\");\nconst song2 = document.querySelector(\"#song2\");\nconst artist2 = document.querySelector(\"#artist2\");\nconst song3 = document.querySelector(\"#song3\");\nconst artist3 = document.querySelector(\"#artist3\");\nconst song4 = document.querySelector(\"#song4\");\nconst artist4 = document.querySelector(\"#artist4\");\n\nconst countEl = document.querySelector(\"#count\");\n\nconst btnAdd = document.querySelector(\"#btn-add\");\nconst btnVip = document.querySelector(\"#btn-vip\");\nconst btnPlay = document.querySelector(\"#btn-play\");\nconst btnVeto = document.querySelector(\"#btn-veto\");\n\n// DATASET\nconst songs = [\"Midnight City\", \"Blinding Lights\", \"Good 4 U\"];\nconst artists = [\"M83\", \"The Weeknd\", \"Olivia Rodrigo\"];\n\n// RENDER\nconst render = () => {\n  // Slot 1\n  if (songs[0]) {\n    song1.textContent = songs[0];\n    artist1.textContent = artists[0];\n  } else {\n    song1.textContent = \"---\";\n    artist1.textContent = \"---\";\n  }\n\n  // Slot 2\n  if (songs[1]) {\n    song2.textContent = songs[1];\n    artist2.textContent = artists[1];\n  } else {\n    song2.textContent = \"---\";\n    artist2.textContent = \"---\";\n  }\n\n  // Slot 3\n  if (songs[2]) {\n    song3.textContent = songs[2];\n    artist3.textContent = artists[2];\n  } else {\n    song3.textContent = \"---\";\n    artist3.textContent = \"---\";\n  }\n\n  // Slot 4\n  if (songs[3]) {\n    song4.textContent = songs[3];\n    artist4.textContent = artists[3];\n  } else {\n    song4.textContent = \"---\";\n    artist4.textContent = \"---\";\n  }\n\n  countEl.textContent = songs.length;\n};\n\n// HELPER FUNCTIONS\n\nconst addRequest = () => {\n  // Get user input\n  let s = inputSong.value;\n  let a = inputArtist.value;\n  \n  // Only add if not empty (optional validation)\n  if (s !== \"\" && a !== \"\") {\n    songs.push(s);\n    artists.push(a);\n    render();\n  }\n};\n\nconst vipBump = () => {\n  let s = inputSong.value;\n  let a = inputArtist.value;\n  \n  if (s !== \"\" && a !== \"\") {\n    songs.unshift(s);\n    artists.unshift(a);\n    render();\n  }\n};\n\nconst playNext = () => {\n  songs.shift();\n  artists.shift();\n  render();\n};\n\nconst vetoLast = () => {\n  songs.pop();\n  artists.pop();\n  render();\n};\n\n// EVENTS\nbtnAdd.addEventListener(\"click\", addRequest);\nbtnVip.addEventListener(\"click\", vipBump);\nbtnPlay.addEventListener(\"click\", playNext);\nbtnVeto.addEventListener(\"click\", vetoLast);\n\nrender();",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;700&display=swap');\n\n:root {\n  --bg-dark: #121212;\n  --card-bg: #1E1E24;\n  --input-bg: #2A2A35;\n  --primary: #8A2BE2;\n  --accent: #00FFC6;\n  --danger: #FF4B4B;\n  --text-main: #FFFFFF;\n  --text-muted: #AAAAAA;\n}\n\nbody {\n  background-color: var(--bg-dark);\n  color: var(--text-main);\n  font-family: 'Outfit', sans-serif;\n  display: flex;\n  justify-content: center;\n  padding: 2rem 0;\n  min-height: 100vh;\n  margin: 0;\n}\n\n.app-container {\n  background-color: var(--card-bg);\n  padding: 2rem;\n  border-radius: 16px;\n  width: 100%;\n  max-width: 420px;\n  box-shadow: 0 8px 24px rgba(0,0,0,0.5);\n}\n\nheader { text-align: center; margin-bottom: 1.5rem; }\nheader h1 { margin: 0; color: var(--accent); font-size: 2rem; }\nheader p { color: var(--text-muted); margin-top: 0.5rem; }\n\n/* Input Card */\n.input-card {\n  background: var(--input-bg);\n  padding: 1.5rem;\n  border-radius: 12px;\n  margin-bottom: 1rem;\n}\n\n.input-card h3 { margin-top: 0; font-size: 1rem; color: var(--primary); text-transform: uppercase;}\n\n.input-group { margin-bottom: 1rem; }\n.input-group label { display: block; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.4rem; }\n.input-group input {\n  width: 100%;\n  padding: 10px;\n  background: #121212;\n  border: 1px solid #444;\n  border-radius: 6px;\n  color: white;\n  font-family: inherit;\n  box-sizing: border-box;\n}\n.input-group input:focus { outline: 2px solid var(--accent); border-color: transparent; }\n\n/* Controls */\n.controls { \n  display: grid; \n  grid-template-columns: 1fr 1fr; \n  gap: 10px; \n  margin-top: 1rem;\n}\n\n.btn {\n  padding: 12px;\n  border: none;\n  border-radius: 8px;\n  font-weight: 700;\n  cursor: pointer;\n  transition: 0.2s;\n}\n.btn:hover { opacity: 0.9; }\n.btn:active { transform: scale(0.96); }\n\n.primary { background-color: var(--primary); color: white; }\n.action { background-color: var(--accent); color: var(--bg-dark); }\n.danger { background-color: transparent; border: 2px solid var(--danger); color: var(--danger); }\n.special { background-color: #FFD700; color: var(--bg-dark); }\n\nhr { border: 0; border-top: 1px solid #333; margin: 1.5rem 0; }\n\n/* Track Slots */\n.track-slot {\n  display: flex;\n  align-items: center;\n  background: #252530;\n  margin: 0.5rem 0;\n  padding: 0.8rem;\n  border-radius: 8px;\n}\n.track-slot.active { border: 1px solid var(--accent); background: #2A2A35; }\n\n.slot-num {\n  font-size: 1.5rem;\n  font-weight: bold;\n  color: var(--text-muted);\n  width: 40px;\n  opacity: 0.3;\n}\n.track-info p { margin: 0; }\n.song { font-size: 1.1rem; font-weight: 700; color: white; }\n.artist { font-size: 0.9rem; color: var(--text-muted); }\n\n.status-bar { text-align: right; font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.5rem;}",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "2",
        "1",
        "3"
      ]
    },
