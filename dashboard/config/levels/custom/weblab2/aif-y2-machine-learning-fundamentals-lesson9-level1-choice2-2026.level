  "properties": {
    "require_edit_to_continue": "false",
    "encrypted": "false",
    "long_instructions": "You’re tuning a classifier to identify a rare bird—the purple finch. A ranger doesn’t want people to *think* they’ve seen the rare bird when they in fact haven’t.\r\n\r\n**☑️ Do This:**\r\n- Find the threshold that maximizes the model’s accuracy.\r\n- Find the threshold that maximizes the model’s recall.\r\n- Find the threshold that maximizes the model’s precision.\r\n- Find the best threshold for the model. Be ready to justify your choice.\r\n",
    "offer_browser_tts": "false",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "true",
