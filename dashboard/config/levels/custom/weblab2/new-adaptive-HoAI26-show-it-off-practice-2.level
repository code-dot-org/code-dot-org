        "37440d37-aea9-4035-b340-2e96b796650e": {
          "id": "37440d37-aea9-4035-b340-2e96b796650e",
          "name": "index.html",
          "contents": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Your Skill Summary</title><link rel=\"stylesheet\" href=\"style.css\"></head><body><div class=\"container\"><h1>My Web Dev Journey: Skill Summary</h1><p>Explore the skills you've built and celebrate your progress!</p><div class=\"summary-section\"><h2>Overall Progress</h2><div class=\"progress-item\"><strong>Levels Completed:</strong> <span id=\"levelsCompleted\">0</span> of 67</div><div class=\"progress-item\"><strong>Concepts Mastered:</strong> <span id=\"conceptsMastered\">0</span></div></div><div class=\"skills-grid\"><h2>Skills Earned</h2><div id=\"skillBadges\"></div></div><button id=\"saveShareCardButton\">Save Your Share Card</button></div><script src=\"script.js\"></script></body></html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "33db2100-cff7-4ea3-abcc-6cbbf30695d5": {
          "id": "33db2100-cff7-4ea3-abcc-6cbbf30695d5",
          "name": "style.css",
          "contents": "body {font-family: Arial, sans-serif;display: flex;flex-direction: column;align-items: center;min-height: 100vh;background-color: #f0f2f5;color: #333;margin: 0;padding: 20px;box-sizing: border-box;}.container {background-color: #fff;padding: 30px;border-radius: 12px;box-shadow: 0 4px 15px rgba(0,0,0,0.1);width: 90%;max-width: 800px;text-align: center;margin-bottom: 30px;}h1 {color: #0056b3;margin-bottom: 10px;}p {margin-bottom: 25px;text-align: center;max-width: 600px;margin-left: auto;margin-right: auto;}h2 {color: #4CAF50;margin-top: 30px;margin-bottom: 20px;border-bottom: 1px solid #eee;padding-bottom: 10px;}.summary-section, .skills-grid {margin-bottom: 30px;}.progress-item {font-size: 1.1em;margin-bottom: 10px;}.skills-grid {display: flex;flex-wrap: wrap;justify-content: center;gap: 15px;}.skill-badge {background-color: #007bff;color: white;padding: 10px 18px;border-radius: 25px;font-size: 0.9em;font-weight: bold;display: inline-flex;align-items: center;box-shadow: 0 2px 5px rgba(0,0,0,0.1);}#saveShareCardButton {background-color: #FF9800;color: white;padding: 15px 30px;border: none;border-radius: 30px;font-size: 1.2em;cursor: pointer;margin-top: 20px;transition: background-color 0.3s ease, transform 0.2s ease;}#saveShareCardButton:hover {background-color: #FB8C00;transform: translateY(-2px);}",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "073118a9-8fa5-43a1-a7f9-ca562a66c566": {
          "id": "073118a9-8fa5-43a1-a7f9-ca562a66c566",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {const levelsCompletedSpan = document.getElementById('levelsCompleted');const conceptsMasteredSpan = document.getElementById('conceptsMastered');const skillBadgesDiv = document.getElementById('skillBadges');const saveShareCardButton = document.getElementById('saveShareCardButton');const totalLevels = 67;const completedLevels = 65;const masteredConcepts = [\"Website Planning\",\"Prompt Engineering\",\"Bug Reporting\",\"Describing Interactions\",\"Describing Looks\",\"Describing Tone\",\"Asking for Code\",\"Matching Plans\",\"Naming Parts\",\"Sorting Jobs\",\"Interactive Elements\",\"Readability\"];levelsCompletedSpan.textContent = completedLevels;conceptsMasteredSpan.textContent = masteredConcepts.length;masteredConcepts.forEach(skill => {const badge = document.createElement('span');badge.classList.add('skill-badge');badge.textContent = skill;skillBadgesDiv.appendChild(badge);});saveShareCardButton.addEventListener('click', () => {alert('Share card saved! (This is a simulation)');console.log('Simulating saving share card with current skills:', masteredConcepts);});});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
