  "properties": {
    "encrypted": "false",
    "display_name": "E-Commerce Discount",
    "long_instructions": "\r\n## E-Commerce Discount\r\n\r\n**Eligibility Criteria:**\r\nA shopper **receives a discount** if they are a **student**, **65 or older**, or have a **referral**, and their **discount code is not expired**.\r\n\r\n---\r\n\r\n**Do This:**\r\n\r\n1. Review the input fields in the starter code: `isStudent`, `age`, `hasReferral`, and `codeExpired`.\r\n\r\n2. Complete the `eligible()` function so it updates the discount **message (`message`)** based on whether the current input values meet the criteria.\r\n\r\n3. In the event handler for the **Run** button (`runBtn`), call `eligible()` to test the current inputs.\r\n\r\n",
    "thumbnail_url": "https://images.code.org/8bef33b95053d42d8887590c4f7579f5-coupon.png",
    "submittable": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
    "disable_edit_run_for_submission": "false",
    "ai_tutor_mode": "outline",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "allowMultipleAttempts": false,
      "placeholderText": "",
      "multipleChoiceOptions": [
        ""
      ],
      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false
    },
    "bubble_choice_description": "Apply if student or 65+ or referral, and not an expired code.",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <meta charset=\"utf-8\">\n    <title>E-Commerce Discount</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    <h1>E-Commerce Discount</h1>\n\n    <label>\n      <input id=\"isStudent\" type=\"checkbox\">\n      Student\n    </label>\n\n    <label>\n      Age:\n      <input id=\"age\" type=\"number\" min=\"0\" value=\"30\">\n    </label>\n\n    <label>\n      <input id=\"hasReferral\" type=\"checkbox\">\n      Has referral\n    </label>\n\n    <label>\n      <input id=\"codeExpired\" type=\"checkbox\">\n      Code expired\n    </label>\n\n    <button id=\"runBtn\">Run</button>\n\n    <p id=\"message\">—</p>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: sans-serif;\n  text-align: center;\n  padding: 2rem;\n  background-color: #f9f9f9;\n}\n\nh1 {\n  margin-bottom: 1rem;\n}\n\nlabel {\n  display: block;\n  margin: 0.5rem 0;\n}\n\ninput[type=\"number\"] {\n  padding: 0.4rem;\n  margin-left: 0.5rem;\n}\n\nbutton {\n  margin-top: 1rem;\n  padding: 0.5rem 1rem;\n  border: 1px solid #ccc;\n  border-radius: 6px;\n  background-color: #f2f2f2;\n  cursor: pointer;\n}\n\nbutton:hover {\n  background-color: #e2e2e2;\n}\n\n#message {\n  margin-top: 1rem;\n  font-weight: bold;\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const isStudent = document.getElementById(\"isStudent\");\nconst age = document.getElementById(\"age\");\nconst hasReferral = document.getElementById(\"hasReferral\");\nconst codeExpired = document.getElementById(\"codeExpired\");\nconst message = document.getElementById(\"message\");\nconst runBtn = document.getElementById(\"runBtn\");\n\nconst eligible = () => {\n  // Use these variables in your logic\n  const student = isStudent.checked;\n  const ageValue = Number(age.value);\n  const referral = hasReferral.checked;\n  const expired = codeExpired.checked;\n\n\n\n\n  \n}\n\nrunBtn.addEventListener(\"click\", eligible);\n",
          "folderId": "0",
          "active": true
        }
      },
