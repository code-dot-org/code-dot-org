      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>Music Bookmark</title>\n    <link rel=\"stylesheet\" href=\"styles.css\">\n  </head>\n  <body>\n    <div id=\"topbar\">\n      <div id=\"avatar\"></div>\n      <h3 id=\"brand\">MyTunes</h3>\n    </div>\n\n    <div id=\"card\">\n      <h2 id=\"songTitle\">Now Playing</h2>\n\n      <img id=\"albumArt\" src=\"album.png\" alt=\"Album cover for Golden Hour\">\n\n      <p id=\"songName\"><strong>Golden Hour</strong> by Jake Rivers</p>\n\n      <button id=\"bookmark\">✫ Not Saved</button>\n    </div>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "styles.css",
          "language": "css",
          "contents": "body {\n  font-family: sans-serif;\n  background-color: #fafafa;\n  text-align: center;\n  margin: 0;\n}\n\n#topbar {\n  background-color: white;\n  padding: 10px;\n}\n\n#avatar {\n  display: inline-block;\n  width: 28px;\n  height: 28px;\n  border-radius: 50%;\n  background: linear-gradient(135deg, #ff7a59, #ffd15c);\n  vertical-align: middle;\n}\n\n#brand {\n  display: inline-block;\n  margin: 0 0 0 8px;\n  vertical-align: middle;\n}\n\n#card {\n  background-color: white;\n  border-radius: 10px;\n  width: 320px;\n  margin: 20px auto;\n  padding: 20px 0;\n}\n\n#songTitle {\n  margin: 0;\n}\n\n#albumArt {\n  width: 180px;\n  height: 180px;\n  border-radius: 8px;\n  margin: 12px 0;\n}\n\n#songName {\n  margin: 8px 0 20px 0;\n}\n\n#bookmark {\n  border: 1px solid #ddd;\n  padding: 8px 16px;\n  border-radius: 6px;\n  cursor: pointer;\n  font-weight: 600;\n  font-size: 16px;\n  width: 160px; /* keeps width consistent */\n  background-color: white;\n}\n\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "document.querySelector(\"#bookmark\").style.backgroundColor = \"#ffd15c\";\n\ndocument.querySelector(\"#bookmark\").addEventListener(\"onclick\", function() {\n  document.querySelector(\"#bookmark\").text = \"✭ Saved\";\n});\n",
          "folderId": "0",
          "active": true
        },
