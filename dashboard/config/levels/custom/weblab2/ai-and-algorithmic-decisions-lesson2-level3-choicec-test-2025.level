    "display_name": "Broken Bookmark Star",
    "thumbnail_url": "https://images.code.org/0d4d544eb306ec4f5435faad395a5cf5-ChatGPT Image Oct 16, 2025, 09_19_35 PM.png",
    "start_sources": {
