      ],
      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false
    },
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Lost & Found Finder</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <div class=\"app-container\">\n    <header>\n      <h1>🔎 Lost & Found</h1>\n      <p>Recover missing items quickly.</p>\n    </header>\n\n    <main>\n      <div class=\"search-panel\">\n        \n        <div class=\"input-group\">\n          <label for=\"locationInput\">Location Found</label>\n          <select id=\"locationInput\">\n            <option value=\"Gym\">Gym</option>\n            <option value=\"Cafeteria\">Cafeteria</option>\n            <option value=\"Library\">Library</option>\n            <option value=\"Main Office\">Main Office</option>\n          </select>\n        </div>\n\n        <div class=\"input-group\">\n          <label for=\"dateInput\">Date Found</label>\n          <input type=\"date\" id=\"dateInput\">\n        </div>\n\n        <div class=\"input-group\">\n          <label for=\"colorHintInput\">Color (Optional)</label>\n          <input type=\"text\" id=\"colorHintInput\" placeholder=\"e.g. Red\">\n        </div>\n\n        <button id=\"searchButton\">Search Items</button>\n      </div>\n\n      <div class=\"results-panel\">\n        <h3 id=\"countLabel\">Matches: 0</h3>\n        <pre id=\"resultsArea\">Select filters to search...</pre>\n      </div>\n    </main>\n  </div>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// Data\nconst items = [\n  { name: \"Water Bottle\", location: \"Gym\", dateFound: \"2023-10-24\", colorHint: \"Blue\" },\n  { name: \"Math Textbook\", location: \"Library\", dateFound: \"2023-10-24\", colorHint: \"Red\" },\n  { name: \"Hoodie\", location: \"Cafeteria\", dateFound: \"2023-10-25\", colorHint: \"Black\" },\n  { name: \"Sneaker (Left)\", location: \"Gym\", dateFound: \"2023-10-24\" }, // Missing color!\n  { name: \"Notebook\", location: \"Library\", dateFound: \"2023-10-25\", colorHint: \"Blue\" },\n  { name: \"Unknown Item\", location: \"Main Office\", dateFound: \"2023-10-26\" } // Missing color!\n];\n\n// Element Selection\nconst locationInput = document.querySelector(\"#locationInput\");\nconst dateInput = document.querySelector(\"#dateInput\");\nconst colorHintInput = document.querySelector(\"#colorHintInput\");\nconst searchButton = document.querySelector(\"#searchButton\");\nconst resultsArea = document.querySelector(\"#resultsArea\");\nconst countLabel = document.querySelector(\"#countLabel\");\n\n// Helper Functions\n\nfunction filterByLocation(item, location) {\n  \n}\n\nfunction filterByDate(item, date) {\n  \n}\n\nfunction filterByColorHint(item, searchColor) {\n  \n}\n\n// Main Logic\n\nfunction applyLostAndFoundFilter() {\n  const locVal = locationInput.value;\n  const dateVal = dateInput.value;\n  const colorVal = colorHintInput.value;\n  \n  // Map over items\n  const results = items.map((item) => {\n    \n    return \"\"; \n  });\n\n  // Display\n  resultsArea.textContent = results.join(\"\\n\");\n\n}\n\nsearchButton.addEventListener(\"click\", applyLostAndFoundFilter);",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "/* style.css */\n:root {\n  --primary: #d63031;\n  --secondary: #ff7675;\n  --bg: #ffeaa7;\n  --panel-bg: #ffffff;\n  --text: #2d3436;\n  --border: #b2bec3;\n}\n\nbody {\n  font-family: 'Verdana', sans-serif;\n  background-color: var(--bg);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  min-height: 100vh;\n  margin: 0;\n  color: var(--text);\n}\n\n.app-container {\n  background-color: var(--panel-bg);\n  width: 380px;\n  padding: 2rem;\n  border-radius: 8px;\n  border: 2px solid #fab1a0;\n  box-shadow: 8px 8px 0px rgba(0,0,0,0.1);\n}\n\nheader {\n  text-align: center;\n  margin-bottom: 1.5rem;\n  border-bottom: 2px dashed var(--border);\n  padding-bottom: 1rem;\n}\n\nh1 {\n  margin: 0;\n  color: var(--primary);\n  text-transform: uppercase;\n  letter-spacing: 1px;\n}\n\n.input-group {\n  margin-bottom: 1rem;\n}\n\nlabel {\n  display: block;\n  font-size: 0.9rem;\n  font-weight: bold;\n  margin-bottom: 0.3rem;\n  color: #636e72;\n}\n\nselect, input {\n  width: 100%;\n  padding: 0.6rem;\n  border: 2px solid var(--border);\n  border-radius: 4px;\n  font-size: 1rem;\n  box-sizing: border-box;\n}\n\nbutton {\n  width: 100%;\n  padding: 0.8rem;\n  background-color: var(--primary);\n  color: white;\n  border: none;\n  border-radius: 4px;\n  font-size: 1rem;\n  font-weight: bold;\n  cursor: pointer;\n  margin-top: 1rem;\n}\n\nbutton:hover {\n  background-color: #b71c1c;\n}\n\n.results-panel {\n  margin-top: 1.5rem;\n  background-color: #f1f2f6;\n  padding: 1rem;\n  border-radius: 4px;\n  min-height: 100px;\n}\n\n#resultsArea {\n  white-space: pre-wrap;\n  font-family: 'Courier New', monospace;\n  font-size: 0.9rem;\n  color: #333;\n}",
          "folderId": "0",
          "active": false
        },
