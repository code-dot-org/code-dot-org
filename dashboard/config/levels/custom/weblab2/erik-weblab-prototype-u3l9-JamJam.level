      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<p><strong>Goal:</strong> Show only fruits that are red.</p>\n<script defer src=\"script.js\"></script>\n<section id=\"list\" aria-label=\"Filtered fruits\"></section>\n\n<p><strong>Total fruits:</strong> <span id=\"totalCount\"></span></p>\n<p><strong>Red fruits:</strong> <span id=\"redCount\"></span></p>",
          "active": false,
          "folderId": "0"
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "// Dataset\nconst fruits = [\n  { name: \"apple\", color: \"red\" },\n  { name: \"banana\", color: \"yellow\" },\n  { name: \"grape\", color: \"purple\" },\n  { name: \"strawberry\", color: \"red\" }\n];\n\n// Make one card as HTML\nconst makeCard = (fruit) => {\n  return `\n    <article class=\"card\">\n      <h2>${fruit.name}</h2>\n      <p><strong>Color:</strong> ${fruit.color}</p>\n    </article>\n  `;\n};\n\n// Custom filter function that returns only red fruits\nconst filterRedFruits = (data) => {\n  const result = [];\n\n  // Check each fruit using .map to keep syntax familiar\n  data.map((fruit) => {\n    if (fruit.color === \"red\") {\n      result.push(fruit);\n    }\n  });\n\n  return result;\n};\n\n// Render a list of fruits\nconst renderList = (data) => {\n  const cards = data.map((fruit) => makeCard(fruit));\n  document.getElementById(\"list\").innerHTML = cards.join(\"\");\n};\n\n// Main render logic\nconst render = () => {\n  const redFruits = filterRedFruits(fruits);\n  renderList(redFruits);\n\n  document.getElementById(\"totalCount\").textContent = fruits.length;\n  document.getElementById(\"redCount\").textContent = redFruits.length;\n};\n\n// Initial paint\nrender();",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "3"
      ]
    }
  },
