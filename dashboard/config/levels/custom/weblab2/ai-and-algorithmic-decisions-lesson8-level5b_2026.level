    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>StreamWave</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n\n<body>\n\n<header class=\"top-bar\">\n  <div class=\"logo\">StreamWave</div>\n  <nav>\n    <a>Home</a>\n    <a>Shows</a>\n    <a>Movies</a>\n  </nav>\n</header>\n\n<section class=\"hero\">\n  <div class=\"hero-content\">\n    <h1>StreamWave</h1>\n    <p id=\"message\">Teen-friendly content is currently shown.</p>\n  </div>\n</section>\n\n<main class=\"content\">\n\n  <!-- FULL ACCESS -->\n  <section id=\"full-access\" class=\"row hide\">\n    <h2>Because You Watch Thrillers</h2>\n    <div class=\"cards\">\n      <div class=\"card\"><img src=\"https://picsum.photos/300/150?1\"><p>Night Shift</p></div>\n      <div class=\"card\"><img src=\"https://picsum.photos/300/150?2\"><p>Final Verdict</p></div>\n      <div class=\"card\"><img src=\"https://picsum.photos/300/150?3\"><p>City Under Fire</p></div>\n      <div class=\"card\"><img src=\"https://picsum.photos/300/150?4\"><p>Deep Signal</p></div>\n    </div>\n  </section>\n\n  <!-- PERMISSION REQUIRED -->\n  <section id=\"permission-required\" class=\"row hide\">\n    <h2>Finish Setup to Continue</h2>\n    <div class=\"cards\">\n      <div class=\"card\"><img src=\"https://picsum.photos/300/150?5\"><p>Update Settings</p></div>\n      <div class=\"card\"><img src=\"https://picsum.photos/300/150?6\"><p>Family Permissions</p></div>\n      <div class=\"card\"><img src=\"https://picsum.photos/300/150?7\"><p>Profile Access</p></div>\n      <div class=\"card\"><img src=\"https://picsum.photos/300/150?8\"><p>Help Center</p></div>\n    </div>\n  </section>\n\n  <!-- TEEN VERSION (default visible) -->\n  <section id=\"teen-version\" class=\"row show\">\n    <h2>Popular with Teens</h2>\n    <div class=\"cards\">\n      <div class=\"card\"><img src=\"https://picsum.photos/300/150?9\"><p>Galaxy Crew</p></div>\n      <div class=\"card\"><img src=\"https://picsum.photos/300/150?10\"><p>School Mystery</p></div>\n      <div class=\"card\"><img src=\"https://picsum.photos/300/150?11\"><p>Game On</p></div>\n      <div class=\"card\"><img src=\"https://picsum.photos/300/150?12\"><p>Future Lab</p></div>\n    </div>\n  </section>\n\n  <!-- RESTRICTED -->\n  <section id=\"restricted-access\" class=\"row hide\">\n    <h2>Limited Access</h2>\n    <div class=\"cards\">\n      <div class=\"card\"><img src=\"https://picsum.photos/300/150?13\"><p>Request Access</p></div>\n      <div class=\"card\"><img src=\"https://picsum.photos/300/150?14\"><p>Switch Profile</p></div>\n      <div class=\"card\"><img src=\"https://picsum.photos/300/150?15\"><p>Family Settings</p></div>\n      <div class=\"card\"><img src=\"https://picsum.photos/300/150?16\"><p>Help</p></div>\n    </div>\n  </section>\n\n</main>\n\n<!-- TEACHER TEST OVERLAY -->\n<div class=\"test-overlay\">\n  <h3>Test Cases</h3>\n  <p class=\"overlay-subtitle\">Student test cases</p>\n\n  <button onclick=\"setTest(18,true)\">Path 1: True / True</button>\n  <button onclick=\"setTest(18,false)\">Path 2: True / False</button>\n  <button onclick=\"setTest(16,true)\">Path 3: False / True</button>\n  <button onclick=\"setTest(16,false)\">Path 4: False / False</button>\n  <button onclick=\"resetTest()\">Reset</button>\n\n  <div class=\"overlay-key\">\n    <p><strong>Condition 1:</strong> userAge &gt;= 18?</p>\n    <p><strong>Condition 2:</strong> hasConsent?</p>\n  </div>\n</div>\n\n<script src=\"overlay.js\"></script>\n<script src=\"script.js\"></script>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  margin: 0;\n  font-family: Arial;\n  background: #111;\n  color: white;\n}\n\n.top-bar {\n  display: flex;\n  justify-content: space-between;\n  padding: 16px;\n  background: #000;\n}\n\n.logo {\n  color: red;\n  font-weight: bold;\n}\n\n.hero {\n  padding: 40px;\n  background: linear-gradient(#000, #111);\n}\n\n.content {\n  padding: 20px;\n}\n\n.row {\n  margin-bottom: 30px;\n}\n\n.cards {\n  display: flex;\n  gap: 10px;\n}\n\n.card {\n  background: #222;\n  padding: 10px;\n  border-radius: 8px;\n  width: 150px;\n}\n\n.card img {\n  width: 100%;\n  border-radius: 6px;\n}\n\n.test-overlay {\n  position: fixed;\n  top: 90px;\n  right: 20px;\n  width: 200px;\n  background-color: #16161f;\n  border: 1px solid #2e2e3f;\n  border-radius: 14px;\n  padding: 16px;\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);\n}\n\n.test-overlay h3 {\n  margin-top: 0;\n  margin-bottom: 6px;\n}\n\n.overlay-subtitle {\n  font-size: 13px;\n  color: #b7b7c2;\n  margin-bottom: 10px;\n}\n\n.test-overlay button {\n  width: 100%;\n  margin-bottom: 10px;\n  padding: 10px;\n  background-color: #2a2a3a;\n  color: white;\n  border: 1px solid #3f3f55;\n  border-radius: 8px;\n  cursor: pointer;\n}\n\n.test-overlay button:hover {\n  background-color: #3a3a52;\n}\n\n.overlay-key {\n  margin-top: 10px;\n  font-size: 12px;\n  color: #b7b7c2;\n}\n\n.content {\n  padding: 20px;\n  padding-right: 260px;\n}\n\n.hide {\n  display: none;\n}\n\n.show {\n  display: block;\n}",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "script.js",
          "contents": "const message = document.getElementById(\"message\");\nconst fullAccess = document.getElementById(\"full-access\");\nconst permissionRequired = document.getElementById(\"permission-required\");\nconst teenVersion = document.getElementById(\"teen-version\");\nconst restrictedAccess = document.getElementById(\"restricted-access\");\n\n// Inputs\nlet userAge = 16;\nlet hasConsent = true;\n\n// Student testing overlay override\nif (window.testUserAge !== undefined) {\n  userAge = window.testUserAge;\n}\nif (window.testHasConsent !== undefined) {\n  hasConsent = window.testHasConsent;\n}\n\n// Nested conditionals\n",
          "folderId": "0",
          "active": true
        },
        "6": {
          "id": "6",
          "name": "overlay.js",
          "contents": "const savedAge = localStorage.getItem(\"testUserAge\");\nconst savedConsent = localStorage.getItem(\"testHasConsent\");\n\nif (savedAge !== null) {\n  window.testUserAge = Number(savedAge);\n}\n\nif (savedConsent !== null) {\n  window.testHasConsent = savedConsent === \"true\";\n}\n\nfunction setTest(age, consent) {\n  localStorage.setItem(\"testUserAge\", age);\n  localStorage.setItem(\"testHasConsent\", consent);\n  location.reload();\n}\n\nfunction resetTest() {\n  localStorage.removeItem(\"testUserAge\");\n  localStorage.removeItem(\"testHasConsent\");\n  location.reload();\n}",
          "folderId": "0",
          "active": false,
          "type": "support"
        }
      },
      "openFiles": [
        "5"
      ]
    },
