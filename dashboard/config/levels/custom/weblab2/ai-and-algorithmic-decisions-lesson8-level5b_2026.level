    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <meta charset=\"utf-8\">\n    <title>StreamWave</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    <div class=\"app-shell\">\n      <header class=\"top-bar\">\n        <div class=\"logo\">StreamWave</div>\n        <nav class=\"top-nav\">\n          <a href=\"#\">Home</a>\n          <a href=\"#\">Shows</a>\n          <a href=\"#\">Movies</a>\n          <a href=\"#\">My List</a>\n        </nav>\n      </header>\n\n      <main class=\"hero\">\n        <div class=\"hero-overlay\">\n          <p class=\"tag\">Featured Tonight</p>\n          <h1 id=\"headline\">Your next favorite story starts here.</h1>\n          <p id=\"message\" class=\"message\">Trending movies, new episodes, and personalized picks — all in one place.</p>\n\n          <div class=\"status-row\">\n            <div class=\"status-card\">\n              <span class=\"label\">User Age</span>\n              <span id=\"ageStatus\">0</span>\n            </div>\n            <div class=\"status-card\">\n              <span class=\"label\">Permission</span>\n              <span id=\"permissionStatus\">false</span>\n            </div>\n          </div>\n        </div>\n      </main>\n\n      <section class=\"content-area\">\n        <!-- Default homepage preview -->\n        <section id=\"home-preview\" class=\"view-card show\">\n          <h2>Popular on StreamWave</h2>\n          <p>Watch what everyone is talking about right now.</p>\n\n          <div class=\"row-grid\">\n            <div class=\"mini-card\">City Lights</div>\n            <div class=\"mini-card\">Galaxy Run</div>\n            <div class=\"mini-card\">Hidden Truth</div>\n            <div class=\"mini-card\">Weekend Laughs</div>\n          </div>\n        </section>\n\n        <section id=\"continue-watching\" class=\"view-card show\">\n          <h2>Continue Watching</h2>\n          <p>Pick up where you left off.</p>\n\n          <div class=\"row-grid\">\n            <div class=\"mini-card\">Ocean Rescue</div>\n            <div class=\"mini-card\">The Final Level</div>\n            <div class=\"mini-card\">Rookie Detectives</div>\n            <div class=\"mini-card\">Future Makers</div>\n          </div>\n        </section>\n\n        <!-- Adult version -->\n        <section id=\"adult-version\" class=\"view-card hide\">\n          <h2>Full Access</h2>\n          <p>Full library unlocked, including titles rated for older audiences.</p>\n\n          <div class=\"row-grid\">\n            <div class=\"mini-card\">Trending Drama</div>\n            <div class=\"mini-card\">Action Premieres</div>\n            <div class=\"mini-card\">True Crime</div>\n            <div class=\"mini-card\">Late Night Comedy</div>\n          </div>\n        </section>\n\n        <!-- Need permission -->\n        <section id=\"need-permission\" class=\"view-card hide\">\n          <h2>Permission Needed</h2>\n          <p>This profile cannot continue until permissions are updated.</p>\n\n          <div class=\"notice-box\">\n            Ask a parent or guardian to update viewing permissions before continuing.\n          </div>\n        </section>\n\n        <!-- Teen version -->\n        <section id=\"teen-version\" class=\"view-card hide\">\n          <h2>Teen Version</h2>\n          <p>Showing a teen-friendly catalog with age-appropriate recommendations.</p>\n\n          <div class=\"row-grid\">\n            <div class=\"mini-card\">School Mystery</div>\n            <div class=\"mini-card\">Animated Hits</div>\n            <div class=\"mini-card\">Sports Highlights</div>\n            <div class=\"mini-card\">Science Adventure</div>\n          </div>\n        </section>\n\n        <!-- Hide content -->\n        <section id=\"hide-content\" class=\"view-card hide\">\n          <h2>Content Hidden</h2>\n          <p>No content is visible right now because viewing access has not been approved.</p>\n\n          <div class=\"notice-box\">\n            This account is locked until permission is granted.\n          </div>\n        </section>\n      </section>\n    </div>\n\n    <!-- Test overlay -->\n    <aside class=\"test-overlay\">\n      <h3>Test Cases</h3>\n      <p class=\"overlay-subtitle\">Student test controls</p>\n\n      <button id=\"path1Btn\">Path 1: True / True</button>\n      <button id=\"path2Btn\">Path 2: True / False</button>\n      <button id=\"path3Btn\">Path 3: False / True</button>\n      <button id=\"path4Btn\">Path 4: False / False</button>\n      <button id=\"resetBtn\">Reset</button>\n\n      <div class=\"overlay-key\">\n        <p><strong>Condition 1:</strong> userAge &gt;= 18?</p>\n        <p><strong>Condition 2:</strong> hasConsent?</p>\n      </div>\n    </aside>\n\n    <script src=\"script.js\"></script>\n    <script src=\"overlay.js\"></script>\n  </body>\n</html>",
          "active": true,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  margin: 0;\n  font-family: Arial, sans-serif;\n  background-color: #0f0f14;\n  color: #ffffff;\n}\n\na {\n  color: white;\n  text-decoration: none;\n}\n\n.app-shell {\n  min-height: 100vh;\n}\n\n.top-bar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 18px 28px;\n  background-color: #111111;\n  border-bottom: 1px solid #2a2a2a;\n}\n\n.logo {\n  font-size: 28px;\n  font-weight: bold;\n  color: #ff2f5b;\n}\n\n.top-nav {\n  display: flex;\n  gap: 18px;\n}\n\n.hero {\n  min-height: 320px;\n  background: linear-gradient(rgba(0, 0, 0, 0.35), rgba(15, 15, 20, 1)),\n              url(\"https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=1200&q=80\");\n  background-size: cover;\n  background-position: center;\n  display: flex;\n  align-items: end;\n}\n\n.hero-overlay {\n  padding: 36px 28px;\n  max-width: 720px;\n}\n\n.tag {\n  text-transform: uppercase;\n  font-size: 12px;\n  letter-spacing: 2px;\n  color: #ffb3c1;\n}\n\n#headline {\n  margin-top: 8px;\n  margin-bottom: 10px;\n  font-size: 42px;\n}\n\n.message {\n  color: #d5d5d5;\n  margin-bottom: 20px;\n  font-size: 18px;\n}\n\n.status-row {\n  display: flex;\n  gap: 14px;\n  flex-wrap: wrap;\n}\n\n.status-card {\n  background-color: rgba(255, 255, 255, 0.08);\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  padding: 10px 14px;\n  border-radius: 10px;\n  min-width: 150px;\n}\n\n.label {\n  display: block;\n  font-size: 12px;\n  color: #bbbbbb;\n  margin-bottom: 4px;\n}\n\n.content-area {\n  padding: 28px;\n  padding-right: 250px;\n}\n\n.view-card {\n  background-color: #1a1a22;\n  border: 1px solid #2c2c38;\n  border-radius: 16px;\n  padding: 24px;\n  margin-bottom: 20px;\n}\n\n.row-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(120px, 1fr));\n  gap: 14px;\n  margin-top: 18px;\n}\n\n.mini-card {\n  background-color: #272733;\n  padding: 24px 14px;\n  border-radius: 12px;\n  text-align: center;\n  border: 1px solid #363648;\n}\n\n.notice-box {\n  background-color: #252532;\n  border-left: 4px solid #ff2f5b;\n  padding: 16px;\n  border-radius: 10px;\n  margin-top: 16px;\n}\n\n.test-overlay {\n  position: fixed;\n  top: 90px;\n  right: 20px;\n  width: 190px;\n  background-color: #16161f;\n  border: 1px solid #333347;\n  border-radius: 14px;\n  padding: 16px;\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);\n}\n\n.test-overlay h3 {\n  margin-top: 0;\n  margin-bottom: 8px;\n}\n\n.overlay-subtitle {\n  font-size: 13px;\n  color: #c8c8d2;\n}\n\n.test-overlay button {\n  width: 100%;\n  margin-bottom: 10px;\n  padding: 10px;\n  background-color: #2a2a3a;\n  color: white;\n  border: 1px solid #44445a;\n  border-radius: 8px;\n  cursor: pointer;\n}\n\n.test-overlay button:hover {\n  background-color: #35354a;\n}\n\n.overlay-key {\n  margin-top: 10px;\n  font-size: 12px;\n  color: #c7c7d1;\n}\n\n.hide {\n  display: none;\n}\n\n.show {\n  display: block;\n}",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "script.js",
          "contents": "// Output text\nconst headline = document.getElementById(\"headline\");\nconst message = document.getElementById(\"message\");\nconst ageStatus = document.getElementById(\"ageStatus\");\nconst permissionStatus = document.getElementById(\"permissionStatus\");\n\n// Default homepage sections\nconst homePreview = document.getElementById(\"home-preview\");\nconst continueWatching = document.getElementById(\"continue-watching\");\n\n// View sections\nconst adultVersion = document.getElementById(\"adult-version\");\nconst needPermission = document.getElementById(\"need-permission\");\nconst teenVersion = document.getElementById(\"teen-version\");\nconst hideContent = document.getElementById(\"hide-content\");\n\n// Inputs\nlet userAge = 0;\nlet hasConsent = false;\n\n// Hides all possible sections\nconst hideAllViews = () => {\n  homePreview.classList.remove(\"show\");\n  homePreview.classList.add(\"hide\");\n\n  continueWatching.classList.remove(\"show\");\n  continueWatching.classList.add(\"hide\");\n\n  adultVersion.classList.remove(\"show\");\n  adultVersion.classList.add(\"hide\");\n\n  needPermission.classList.remove(\"show\");\n  needPermission.classList.add(\"hide\");\n\n  teenVersion.classList.remove(\"show\");\n  teenVersion.classList.add(\"hide\");\n\n  hideContent.classList.remove(\"show\");\n  hideContent.classList.add(\"hide\");\n};\n\n// Updates the labels in the hero section\nconst updateStatus = () => {\n  ageStatus.textContent = userAge;\n  permissionStatus.textContent = hasConsent;\n};\n\n// Nested decisions -> four outcomes\nconst renderView = () => {\n  hideAllViews();\n  updateStatus();\n\n  if (userAge >= 18) {\n    if (hasConsent === true) {\n      adultVersion.classList.remove(\"hide\");\n      adultVersion.classList.add(\"show\");\n      headline.textContent = \"Full Access unlocked\";\n      message.textContent = \"This profile can view the full StreamWave catalog.\";\n    } else {\n      needPermission.classList.remove(\"hide\");\n      needPermission.classList.add(\"show\");\n      headline.textContent = \"Permission required\";\n      message.textContent = \"This profile is missing the permissions needed to continue.\";\n    }\n  } else {\n    if (hasConsent === true) {\n      teenVersion.classList.remove(\"hide\");\n      teenVersion.classList.add(\"show\");\n      headline.textContent = \"Teen version enabled\";\n      message.textContent = \"This profile now shows a teen-friendly version of StreamWave.\";\n    } else {\n      hideContent.classList.remove(\"hide\");\n      hideContent.classList.add(\"show\");\n      headline.textContent = \"Content hidden\";\n      message.textContent = \"This profile cannot view content until permission is approved.\";\n    }\n  }\n};\n\n// Helper function so overlay.js can test each path\nconst setInputs = (newAge, newConsent) => {\n  userAge = newAge;\n  hasConsent = newConsent;\n  renderView();\n};\n\n// Reset screen to realistic homepage\nconst resetApp = () => {\n  userAge = 0;\n  hasConsent = false;\n\n  hideAllViews();\n\n  homePreview.classList.remove(\"hide\");\n  homePreview.classList.add(\"show\");\n\n  continueWatching.classList.remove(\"hide\");\n  continueWatching.classList.add(\"show\");\n\n  updateStatus();\n\n  headline.textContent = \"Your next favorite story starts here.\";\n  message.textContent = \"Trending movies, new episodes, and personalized picks — all in one place.\";\n};\n\n// Make functions available to overlay.js\nwindow.setInputs = setInputs;\nwindow.resetApp = resetApp;\n\n// Starting state\nresetApp();",
          "folderId": "0",
          "active": false
        },
        "6": {
          "id": "6",
          "name": "overlay.js",
          "contents": "const path1Btn = document.getElementById(\"path1Btn\");\nconst path2Btn = document.getElementById(\"path2Btn\");\nconst path3Btn = document.getElementById(\"path3Btn\");\nconst path4Btn = document.getElementById(\"path4Btn\");\nconst resetBtn = document.getElementById(\"resetBtn\");\n\n// Path 1 -> True / True -> Show adult version\npath1Btn.addEventListener(\"click\", () => {\n  window.setInputs(18, true);\n});\n\n// Path 2 -> True / False -> Show \"Need permission\"\npath2Btn.addEventListener(\"click\", () => {\n  window.setInputs(18, false);\n});\n\n// Path 3 -> False / True -> Show teen version\npath3Btn.addEventListener(\"click\", () => {\n  window.setInputs(16, true);\n});\n\n// Path 4 -> False / False -> Hide content\npath4Btn.addEventListener(\"click\", () => {\n  window.setInputs(16, false);\n});\n\n// Reset\nresetBtn.addEventListener(\"click\", () => {\n  window.resetApp();\n});",
          "folderId": "0",
          "active": false,
          "type": "support"
        }
      },
      "openFiles": [
        "5",
        "1"
      ]
    },
