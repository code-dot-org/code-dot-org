      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n\n    <header class=\"top-nav\">\n        <div class=\"nav-content\">\n            <div class=\"tabs\">\n                <span class=\"active-tab\">For you</span>\n                <span>Following</span>\n            </div>\n        </div>\n    </header>\n\n    <main class=\"container\">\n        <div class=\"timeline\">\n            \n            <article class=\"tweet\" id=\"postCard\">\n                <div class=\"tweet-left\">\n                    <div class=\"avatar\"></div>\n                </div>\n                \n                <div class=\"tweet-right\">\n                    <div class=\"tweet-header\">\n                        <span class=\"display-name\">MovieBuff99</span>\n                        <span class=\"verified\">\n                            <svg viewBox=\"0 0 24 24\" class=\"verified-icon\"><g fill=\"currentColor\"><path d=\"M22.5 12.5c0-1.58-.875-2.95-2.148-3.6.154-.435.238-.905.238-1.4 0-2.21-1.71-3.998-3.918-3.998-.47 0-.92.084-1.336.25C14.818 2.415 13.51 1.5 12 1.5s-2.816.917-3.337 2.25c-.416-.165-.866-.25-1.336-.25-2.21 0-3.918 1.79-3.918 4 0 .495.084.965.238 1.4-1.273.65-2.148 2.02-2.148 3.6 0 1.46.827 2.75 2.043 3.4-.114.417-.175.852-.175 1.3 0 2.21 1.71 4 3.918 4 .535 0 1.045-.104 1.517-.29.568 1.35 1.884 2.29 3.398 2.29s2.83-.94 3.398-2.29c.472.186.982.29 1.517.29 2.21 0 3.918-1.79 3.918-4 0-.448-.06-.883-.175-1.3 1.216-.65 2.043-1.94 2.043-3.4zm-13.01 4.316l-3.23-3.084 1.36-1.42 1.87 1.79 4.88-4.66 1.36 1.42-6.24 5.954z\"></path></g></svg>\n                        </span>\n                        <span class=\"handle\">@mbuff99</span>\n                        <span class=\"dot\">·</span>\n                        <span class=\"time\">2h</span>\n                    </div>\n                    \n                    <div class=\"tweet-body\">\n                        <p>Just walked out of the theater for <strong>The Midnight Sky</strong>!</p>\n                        \n                        <div id=\"spoilerContainer\" class=\"media-container\">\n                            \n                            <div id=\"warningBadge\" class=\"post-badge\"></div>\n                            \n                            <img id=\"staticPostImage\" class=\"state-img\" src=\"images/the-midnight-sky.png\" alt=\"Movie Scene\">\n                            \n                        </div>\n                    </div>\n                    \n                    <div class=\"tweet-actions\">\n                        <div class=\"action-group\">\n                            <svg viewBox=\"0 0 24 24\" class=\"x-icon\"><path fill=\"currentColor\" d=\"M1.751 10c0-4.42 3.584-8 8.005-8h4.366c4.49 0 8.129 3.64 8.129 8.13 0 2.96-1.607 5.68-4.196 7.11l-8.054 4.46v-3.69h-.067c-4.49.1-8.183-3.51-8.183-8.01zm8.005-6c-3.317 0-6.005 2.69-6.005 6 0 3.37 2.77 6.08 6.138 6.01l.351-.01h1.761v2.3l5.087-2.81c1.951-1.08 3.163-3.13 3.163-5.36 0-3.39-2.744-6.13-6.129-6.13H9.756z\"></path></svg>\n                            <span>450</span>\n                        </div>\n                        <div class=\"action-group\">\n                            <svg viewBox=\"0 0 24 24\" class=\"x-icon\"><path fill=\"currentColor\" d=\"M4.5 3.88l4.432 4.14-1.364 1.46L5.5 7.55V16c0 1.1.896 2 2 2H13v2H7.5c-2.209 0-4-1.79-4-4V7.55L1.432 9.48.068 8.02 4.5 3.88zM16.5 6H11V4h5.5c2.209 0 4 1.79 4 4v8.45l2.068-1.93 1.364 1.46-4.432 4.14-4.432-4.14 1.364-1.46 2.068 1.93V8c0-1.1-.896-2-2-2z\"></path></svg>\n                            <span>89</span>\n                        </div>\n                        <div class=\"action-group\">\n                            <svg viewBox=\"0 0 24 24\" class=\"x-icon\"><path fill=\"currentColor\" d=\"M16.697 5.5c-1.222-.06-2.679.51-3.89 2.16l-.805 1.09-.806-1.09C9.984 6.01 8.526 5.44 7.304 5.5c-1.243.07-2.349.78-2.91 1.91-.552 1.12-.633 2.78.479 4.82 1.074 1.97 3.257 4.27 7.129 6.61 3.87-2.34 6.052-4.64 7.126-6.61 1.111-2.04 1.03-3.7.477-4.82-.561-1.13-1.666-1.84-2.908-1.91zm4.187 7.69c-1.351 2.48-4.001 5.12-8.379 7.67l-.503.3-.504-.3c-4.379-2.55-7.029-5.19-8.382-7.67-1.36-2.5-1.41-4.86-.514-6.67.887-1.79 2.647-2.91 4.601-3.01 1.651-.09 3.368.56 4.798 2.01 1.429-1.45 3.146-2.1 4.796-2.01 1.954.1 3.714 1.22 4.601 3.01.896 1.81.846 4.17-.514 6.67z\"></path></svg>\n                            <span>1.2k</span>\n                        </div>\n                        <div class=\"action-group\">\n                            <svg viewBox=\"0 0 24 24\" class=\"x-icon\"><path fill=\"currentColor\" d=\"M8.75 21V3h2v18h-2zM18 21V8.5h2V21h-2zM4 21l.004-10h2L6 21H4zm9.248 0v-7h2v7h-2z\"></path></svg>\n                            <span>84K</span>\n                        </div>\n                        <div class=\"action-group\">\n                            <svg viewBox=\"0 0 24 24\" class=\"x-icon\"><path fill=\"currentColor\" d=\"M4 4.5C4 3.12 5.119 2 6.5 2h11C18.881 2 20 3.12 20 4.5v18.44l-8-5.71-8 5.71V4.5zM6.5 4c-.276 0-.5.22-.5.5v14.56l6-4.29 6 4.29V4.5c0-.28-.224-.5-.5-.5h-11z\"></path></svg>\n                        </div>\n                    </div>\n                </div>\n            </article>\n            \n        </div>\n    </main>\n\n    <div class=\"logic-lab\">\n        <h3>🛠 Logic Lab <button id=\"toggleLabMinimize\" class=\"lab-toggle-btn\">−</button></h3>\n        <p>Toggle state to check spoiler filter <code>if/else</code> logic:</p>\n        \n        <div class=\"control-row\">\n            <label>finishedMovie</label>\n            <button id=\"toggleFinished\" class=\"lab-btn\">FALSE</button>\n        </div>\n\n        <div class=\"control-row\">\n            <label>hasSpoilerTags</label>\n            <button id=\"toggleSpoilers\" class=\"lab-btn\">FALSE</button>\n        </div>\n\n        <div class=\"outcome-box\">\n            <strong>Current State:</strong>\n            <div id=\"logicStatus\">Calculating...</div>\n        </div>\n    </div>\n\n    <script src=\"script.js\"></script>\n    <script src=\"lab-overlay.js\"></script> \n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "const warningBadge = document.getElementById(\"warningBadge\");\n\nlet finishedMovie = false;\nlet hasSpoilerTags = false;\n\n\nconst updateAppUI = () => {\n\n  if (finishedMovie) {\n    \n    if (hasSpoilerTags) {         \n      warningBadge.innerText = \"Spoiler-Talk Approved\"; \n      warningBadge.style.backgroundColor = \"#1d9bf0\";\n    } else {\n        warningBadge.innerText = \"Universal Share\";\n        warningBadge.style.backgroundColor = \"#71767b\";\n      }\n  \n  } else {\n    \n    if (hasSpoilerTags) {\n      warningBadge.innerText = \"WARNING: CONTAINS SPOILERS\";\n      warningBadge.style.backgroundColor = \"#f91880\";\n        \n    } else {\n       warningBadge.innerText = \"Spoiler-Free Movie Teaser\";\n      warningBadge.style.backgroundColor = \"#00ba7c\";\n    }\n    }\n};\n\nupdateAppUI()",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "* { \n    box-sizing: border-box; \n    margin: 0; \n    padding: 0; \n}\n\nbody {\n    background-color: #000000;\n    color: #e7e9ea;\n    font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n    -webkit-font-smoothing: antialiased;\n}\n\n.top-nav {\n    border-bottom: 1px solid #2f3336;\n    position: sticky;\n    top: 0;\n    background: rgba(0, 0, 0, 0.65);\n    backdrop-filter: blur(12px);\n    z-index: 100;\n}\n\n.nav-content {\n    max-width: 600px;\n    margin: 0 auto;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n}\n\n.logo {\n    padding: 12px 0;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n}\n\n.y-logo {\n    width: 26px;\n    height: 26px;\n    color: #e7e9ea;\n}\n\n.tabs {\n    display: flex;\n    width: 100%;\n    border-top: 1px solid #2f3336;\n}\n\n.tabs span {\n    flex: 1;\n    text-align: center;\n    padding: 16px 0;\n    font-weight: bold;\n    color: #71767b;\n    cursor: pointer;\n    transition: background 0.2s;\n}\n\n.tabs span:hover { \n    background: rgba(255, 255, 255, 0.03); \n}\n\n.active-tab {\n    color: #e7e9ea !important;\n    position: relative;\n}\n\n.active-tab::after {\n    content: '';\n    position: absolute;\n    bottom: 0;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 56px;\n    height: 4px;\n    background-color: #1d9bf0;\n    border-radius: 2px;\n}\n\n.container { \n    max-width: 600px;\n    margin: 0 auto;\n    border-left: 1px solid #2f3336;\n    border-right: 1px solid #2f3336;\n    min-height: 100vh;\n}\n\n.tweet {\n    display: flex;\n    padding: 12px 16px;\n    border-bottom: 1px solid #2f3336;\n    cursor: pointer;\n    transition: background 0.2s, border-left 0.2s;\n    border-left: 4px solid transparent; \n}\n\n.tweet:hover { \n    background: rgba(255, 255, 255, 0.03); \n}\n\n.tweet-left { \n    margin-right: 12px; \n}\n\n.avatar {\n    width: 40px;\n    height: 40px;\n    border-radius: 50%;\n    background: url('https://picsum.photos/seed/avatar2/100') center/cover;\n}\n\n.tweet-right { \n    flex: 1; \n    min-width: 0; \n}\n\n.tweet-header {\n    display: flex;\n    align-items: center;\n    margin-bottom: 4px;\n    font-size: 15px;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n}\n\n.display-name { \n    font-weight: 700; \n    color: #e7e9ea; \n    margin-right: 4px; \n}\n\n.verified {\n    display: inline-flex;\n    align-items: center;\n    margin-right: 4px;\n}\n\n.verified-icon {\n    width: 18px;\n    height: 18px;\n    color: #1d9bf0; \n}\n\n.handle { \n    color: #71767b; \n}\n\n.time { \n    color: #71767b; \n}\n\n.dot { \n    color: #71767b; \n    margin: 0 4px; \n}\n\n.tweet-body p { \n    font-size: 15px; \n    line-height: 20px; \n    margin-bottom: 12px; \n}\n\n.media-container {\n    position: relative;\n    border-radius: 16px;\n    border: 1px solid #2f3336;\n    overflow: hidden;\n    margin-top: 12px;\n    background-color: #ffffff; \n    display: flex;\n    flex-direction: column;\n}\n\n.post-badge {\n    width: 100%;\n    padding: 12px 16px;\n    text-align: center;\n    font-weight: 800;\n    font-size: 15px;\n    margin: 0; \n}\n\n.state-img {\n    width: 100%;\n    display: block;\n    object-fit: cover;\n}\n\n.tweet-actions {\n    display: flex;\n    justify-content: space-between;\n    margin-top: 12px;\n    color: #71767b;\n    font-size: 13px;\n    max-width: 425px;\n}\n\n.action-group {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    cursor: pointer;\n    transition: color 0.2s;\n}\n\n.x-icon {\n    width: 18px;\n    height: 18px;\n    color: #71767b;\n    transition: color 0.2s;\n}\n\n.action-group:nth-child(1):hover { \n    color: #1d9bf0; \n}\n\n.action-group:nth-child(1):hover .x-icon { \n    color: #1d9bf0; \n}\n\n.action-group:nth-child(2):hover { \n    color: #00ba7c; \n}\n\n.action-group:nth-child(2):hover .x-icon { \n    color: #00ba7c; \n}\n\n.action-group:nth-child(3):hover { \n    color: #f91880; \n}\n\n.action-group:nth-child(3):hover .x-icon { \n    color: #f91880; \n}\n\n.action-group:nth-child(4):hover { \n    color: #1d9bf0; \n}\n\n.action-group:nth-child(4):hover .x-icon { \n    color: #1d9bf0; \n}\n\n.action-group:nth-child(5):hover { \n    color: #1d9bf0; \n}\n\n.action-group:nth-child(5):hover .x-icon { \n    color: #1d9bf0; \n}\n\n/* --- Logic Lab Styles --- */\n.logic-lab {\n    position: fixed;\n    bottom: 20px;\n    right: 20px;\n    background: #16181c;\n    color: #e7e9ea;\n    padding: 20px;\n    border-radius: 16px;\n    width: 320px;\n    box-shadow: 0 0 15px rgba(255, 255, 255, 0.1);\n    z-index: 1000;\n    border: 1px solid #2f3336;\n    transition: height 0.3s ease, padding 0.3s ease; \n}\n\n.logic-lab.minimized {\n    height: 56px; \n    overflow: hidden;\n    padding: 16px 20px; \n}\n\n.logic-lab h3 { \n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 15px; \n    font-size: 1.1rem; \n    border-bottom: 1px solid #2f3336; \n    padding-bottom: 10px; \n}\n\n.logic-lab.minimized h3 {\n    border-bottom: none;\n    margin-bottom: 0;\n    padding-bottom: 0;\n}\n\n.lab-toggle-btn {\n    background: transparent;\n    border: none;\n    color: inherit;\n    cursor: pointer;\n    font-size: 1.5rem;\n    line-height: 1;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n.logic-lab p { \n    font-size: 14px; \n    color: #71767b; \n    margin-bottom: 15px; \n}\n\n.control-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 12px;\n    font-size: 15px;\n}\n\n.lab-btn {\n    padding: 6px 12px;\n    cursor: pointer;\n    background: #f91880; \n    color: #ffffff;\n    border: 1px solid #f91880;\n    font-weight: bold;\n    width: 80px;\n    border-radius: 9999px; \n    transition: all 0.2s;\n}\n\n.lab-btn.active { \n    background: #00ba7c; \n    color: #ffffff; \n    border: 1px solid #00ba7c; \n}\n\n.outcome-box {\n    margin-top: 15px;\n    padding-top: 15px;\n    border-top: 1px solid #2f3336;\n    font-size: 14px;\n}\n\n#logicStatus { \n    margin-top: 8px; \n    font-weight: bold; \n    line-height: 1.4; \n}\n\n.logic-lab.minimized p { \n    display: none; \n}\n\n.logic-lab.minimized .control-row { \n    display: none; \n}\n\n.logic-lab.minimized .outcome-box { \n    display: none; \n}\n",
          "folderId": "0",
          "active": false
        },
        "9": {
          "id": "9",
          "name": "lab-overlay.js",
          "contents": "const finishedLabBtn = document.getElementById('toggleFinished');\nconst spoilerLabBtn = document.getElementById('toggleSpoilers');\nconst statusDisplay = document.getElementById('logicStatus');\n\nconst toggleMinimizeBtn = document.getElementById('toggleLabMinimize');\nconst logicLab = document.querySelector('.logic-lab');\n\n// 0. Logic for Minimizing/Unminimizing the Lab overlay\ntoggleMinimizeBtn.addEventListener('click', () => {\n    logicLab.classList.toggle('minimized'); \n    if (logicLab.classList.contains('minimized')) {\n        toggleMinimizeBtn.innerText = '+';\n    } else {\n        toggleMinimizeBtn.innerText = '−';\n    }\n});\n\n// 1. Logic for \"Finished Movie\" Toggle & Styling\nfinishedLabBtn.addEventListener('click', () => {\n    // Toggle the state variable in script.js\n    finishedMovie = !finishedMovie; \n    \n    // Update Button Text\n    finishedLabBtn.innerText = finishedMovie ? \"TRUE\" : \"FALSE\";\n    \n    // Toggle color logic: Green for true (active), Red for false\n    if (finishedMovie) {\n        finishedLabBtn.classList.add('active'); // CSS defines this as Green\n    } else {\n        finishedLabBtn.classList.remove('active'); // CSS defines base as Red\n    }\n    \n    // Trigger updates\n    updateAppUI();\n    updateLabStatus();\n});\n\n// 2. Logic for \"Has Spoiler Tags\" Toggle & Styling\nspoilerLabBtn.addEventListener('click', () => {\n    // Toggle the state variable in script.js\n    hasSpoilerTags = !hasSpoilerTags;\n    \n    // Update Button Text\n    spoilerLabBtn.innerText = hasSpoilerTags ? \"TRUE\" : \"FALSE\";\n    \n    // Toggle color logic: Green for true (active), Red for false\n    if (hasSpoilerTags) {\n        spoilerLabBtn.classList.add('active'); // CSS defines this as Green\n    } else {\n        spoilerLabBtn.classList.remove('active'); // CSS defines base as Red\n    }\n    \n    // Trigger updates\n    updateAppUI();\n    updateLabStatus();\n});\n\n// 3. Update the Lab's internal status text using hardcoded hex and strict if/else\n// Status messages are framed about whether both people have seen the movie\nfunction updateLabStatus() {\n    if (finishedMovie === true) {\n        // Case 1: Both people have seen the movie!\n        if (hasSpoilerTags === true) {\n            // Safe, debating is safe\n            statusDisplay.innerText = \"Safe: Both people have seen the movie, so spoilers are fine!\";\n            statusDisplay.style.color = \"#ffd400\"; // Warning color\n\n        } else {\n            // Safe, standard share\n            statusDisplay.innerText = \"Safe: Both people have seen the movie and it's clean.\";\n            statusDisplay.style.color = \"#00ba7c\"; // Safe color\n        }\n\n    } else {\n        // Case 2: Someone hasn't seen the movie yet! (implicit cooperative framing)\n        if (hasSpoilerTags === true) {\n            // DANGER state, massive spoilers\n            statusDisplay.innerText = \"BLOCKED: Someone hasn't seen the movie yet, and it has massive spoilers!\";\n            statusDisplay.style.color = \"#f91880\"; // Danger color\n\n        } else {\n            // Safe, build hype\n            statusDisplay.innerText = \"Safe: Someone hasn't seen the movie yet, but it's clean.\";\n            statusDisplay.style.color = \"#00ba7c\"; // Safe color\n        }\n    }\n}\n\n// Initialize the UI on first load\nupdateAppUI();\nupdateLabStatus();",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
