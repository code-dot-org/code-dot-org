  "properties": {
    "encrypted": "false",
    "long_instructions": "## Movie Spoiler Checker\r\n\r\nThis app displays a dynamic warning badge to advise you whether it is safe to share a movie-related post with a specific friend.\r\n\r\nIt bases its decision on two conditions:\r\n\r\n1. `finishedMovie`: Have both you and your friend already watched the movie to the end?\r\n2. `hasSpoilerTags`: Does the post itself contain potential spoilers??\r\n\r\n---\r\n\r\n### Do This:\r\n\r\n1. Click through the different combinations of \"Yes\" and \"No\" in the app.\r\n\r\n2. In `notes.md`, describe the outcome of each combination of path in the flowchart and check that the code works as expected.\r\n\r\n3. Ask AI to help you understand the nested `if/else` statements.",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
    "ai_tutor_mode": "tutor",
    "predict_settings": {
      "isPredictLevel": false,
