<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-11-03T03:29:09.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": true,
    "start_sources": {
      "folders": {
      },
      "files": {
        "2a24749a-aeed-4395-9e4d-f836f144fbb1": {
          "id": "2a24749a-aeed-4395-9e4d-f836f144fbb1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Name the Message Parts</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <h1>Name the Message Parts</h1>\n    <p>Click on different text elements of this page to learn their names and what they are for.</p>\n\n    <div class=\"page-container\">\n        <h2 id=\"parkHeadline\">Protect Our Local Park!</h2>\n        <p id=\"introText\">Our beautiful community park needs your support. Learn how you can help preserve this vital green space for everyone to enjoy.</p>\n        \n        <div class=\"message-cards\">\n            <div class=\"card\">\n                <h3 class=\"card-title\">Why it Matters</h3>\n                <p class=\"card-text\" id=\"cardMessage1\">This park provides essential habitat for wildlife and a peaceful retreat for residents. Its natural beauty enriches our lives.</p>\n            </div>\n            <div class=\"card\">\n                <h3 class=\"card-title\">How to Help</h3>\n                <p class=\"card-text\" id=\"cardMessage2\">Volunteer for clean-up days, donate to conservation efforts, or simply spread the word about its importance.</p>\n            </div>\n        </div>\n\n        <button class=\"cta-button\" id=\"ctaText\">Join Our Efforts Now</button>\n    </div>\n\n    <div class=\"info-box\">\n        <h2>Selected Text Info:</h2>\n        <p><strong>Name:</strong> <span id=\"controlName\">Click a text element</span></p>\n        <p><strong>Job:</strong> <span id=\"controlJob\">To see its name and what it does.</span></p>\n    </div>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "7de20371-0227-4996-9fa1-cb4d75bca4ef": {
          "id": "7de20371-0227-4996-9fa1-cb4d75bca4ef",
          "name": "style.css",
          "contents": "body {\n    font-family: Arial, sans-serif;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    min-height: 100vh;\n    background-color: #f4f4f4;\n    color: #333;\n    margin: 0;\n    padding: 20px;\n    box-sizing: border-box;\n}\n\nh1 {\n    color: #0056b3;\n    margin-bottom: 10px;\n}\n\np {\n    margin-bottom: 25px;\n    text-align: center;\n}\n\n.page-container {\n    background-color: #fff;\n    padding: 30px;\n    border-radius: 10px;\n    box-shadow: 0 4px 10px rgba(0,0,0,0.1);\n    margin-bottom: 30px;\n    width: 90%;\n    max-width: 800px;\n    display: flex;\n    flex-direction: column;\n    gap: 20px;\n    text-align: center;\n}\n\n.page-container h2,\n.page-container p,\n.cta-button {\n    cursor: pointer;\n    transition: background-color 0.2s ease, transform 0.2s ease;\n}\n\n.page-container h2:hover,\n.page-container p:hover,\n.cta-button:hover {\n    background-color: #e9e9e9;\n    transform: translateY(-2px);\n}\n\n#parkHeadline {\n    color: #28a745;\n    font-size: 2.2em;\n    margin-top: 0;\n    margin-bottom: 10px;\n    padding: 10px;\n}\n\n#introText {\n    font-size: 1.1em;\n    color: #555;\n    padding: 10px;\n}\n\n.message-cards {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n    gap: 20px;\n    margin-top: 20px;\n}\n\n.card {\n    background-color: #f9f9f9;\n    border: 1px solid #eee;\n    border-radius: 8px;\n    padding: 15px;\n    box-shadow: 0 2px 5px rgba(0,0,0,0.05);\n}\n\n.card-title {\n    color: #ffc107;\n    font-size: 1.4em;\n    margin-top: 0;\n    margin-bottom: 10px;\n}\n\n.card-text {\n    font-size: 0.95em;\n    color: #666;\n    padding: 8px;\n    margin-bottom: 0;\n}\n\n.cta-button {\n    background-color: #007bff;\n    color: white;\n    padding: 15px 30px;\n    border: none;\n    border-radius: 5px;\n    font-size: 1.2em;\n    cursor: pointer;\n    margin-top: 30px;\n}\n\n.cta-button:hover {\n    background-color: #0056b3;\n}\n\n.info-box {\n    background-color: #e2f0fb;\n    border: 1px solid #a8d5f7;\n    padding: 20px;\n    border-radius: 8px;\n    width: 90%;\n    max-width: 400px;\n    box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n    margin-top: 20px;\n}\n\n.info-box h2 {\n    color: #007bff;\n    margin-top: 0;\n    margin-bottom: 15px;\n    border-bottom: 1px solid #a8d5f7;\n    padding-bottom: 10px;\n    text-align: center;\n}\n\n.info-box p {\n    text-align: left;\n    margin-bottom: 10px;\n    font-size: 1em;\n}\n\n.info-box strong {\n    color: #0056b3;\n}",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "f6d82dae-d7bb-4462-8eeb-e8598c146b03": {
          "id": "f6d82dae-d7bb-4462-8eeb-e8598c146b03",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const parkHeadline = document.getElementById('parkHeadline');\n    const introText = document.getElementById('introText');\n    const cardMessage1 = document.getElementById('cardMessage1');\n    const cardMessage2 = document.getElementById('cardMessage2');\n    const ctaText = document.getElementById('ctaText');\n\n    const controlNameSpan = document.getElementById('controlName');\n    const controlJobSpan = document.getElementById('controlJob');\n\n    function updateInfo(name, job) {\n        controlNameSpan.textContent = name;\n        controlJobSpan.textContent = job;\n    }\n\n    parkHeadline.addEventListener('click', () => {\n        updateInfo(\"Headline\", \"To grab immediate attention and state the page's main topic.\");\n    });\n\n    introText.addEventListener('click', () => {\n        updateInfo(\"Introductory Paragraph\", \"To provide a brief overview and context for the page's content.\");\n    });\n\n    cardMessage1.addEventListener('click', () => {\n        updateInfo(\"Card Text\", \"To present key information or benefits in a concise, digestible format.\");\n    });\n\n    cardMessage2.addEventListener('click', () => {\n        updateInfo(\"Card Text\", \"To present key information or benefits in a concise, digestible format.\");\n    });\n\n    ctaText.addEventListener('click', () => {\n        updateInfo(\"Call-to-Action Text\", \"To prompt the visitor to take a specific, desired action.\");\n    });\n\n    // Initial message\n    updateInfo(\"Click a text element\", \"To see its name and what it does.\");\n});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
        "2a24749a-aeed-4395-9e4d-f836f144fbb1",
        "7de20371-0227-4996-9fa1-cb4d75bca4ef",
        "f6d82dae-d7bb-4462-8eeb-e8598c146b03"
      ]
    },
    "long_instructions": "TODOs:\r\n- Open index.html to view the sample save-the-park page.\r\n- Click on the main headline of the page.\r\n- Observe the name and job displayed in the info box.\r\n- Click on the paragraphs within the message cards.\r\n- Observe how the info box describes these text parts.\r\n- Click on the call-to-action button's text.\r\n- Understand the role of each text element in conveying the page's message.",
