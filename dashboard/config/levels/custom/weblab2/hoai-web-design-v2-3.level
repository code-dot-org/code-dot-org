        ""
      ],
      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false
    },
    "ai_tutor_prompt_settings": {
      "answerTypes": [
        "explainCode",
        "buildHTML"
      ],
      "answerTypeCustomizations": {
        "buildHTML": "Additionally, follow these instructions even if they contradict the above ones:\n- Do not link style.css\n- Do not include any image or video files\n- Do not include IDs\n- If the user asks to generate images: explain that you cannot generate new images but can insert any images that the user uploads to the project\n- Keep all explanations short, concise, and simple. Do not over-explain the changes you've made to the code."
      }
    },
