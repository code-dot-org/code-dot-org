      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <title>RemindMe — Reminders</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <header class=\"site-header\">\n    <div class=\"container header-inner\">\n      <a class=\"brand\" href=\"index.html\">Remind<span>Me</span></a>\n      <nav>\n        <ul class=\"nav\">\n          <li><a class=\"nav-link\" href=\"index.html\">🏠 Home</a></li>\n          <li><a class=\"nav-link\" href=\"about.html\">❓ About</a></li>\n          <li>\n            <button id=\"themeToggle\" class=\"btn btn-ghost\">\n              🌗 Theme\n            </button>\n          </li>\n        </ul>\n      </nav>\n    </div>\n  </header>\n\n  <main id=\"main\">\n    <section class=\"hero\">\n      <div class=\"container hero-inner\">\n        <div>\n          <h1 class=\"title\">Your reminders, simplified</h1>\n          <p class=\"lede\">Add tasks, mark them done, and keep your day on track.</p>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"container grid\">\n      <article class=\"card\">\n        <h2 class=\"h2\">Add Reminder</h2>\n\n        <!-- NOTE: no form submission. Just input + buttons. -->\n        <div class=\"stack\" role=\"group\">\n          <label id=\"addLabel\" class=\"field\">\n            <span class=\"label\">Title</span>\n            <input id=\"title\" class=\"input\" name=\"title\" type=\"text\" placeholder=\"e.g., Finish history outline\" />\n          </label>\n\n          <div class=\"row\">\n            <button id=\"addBtn\" type=\"button\" class=\"btn btn-primary\">Add</button>\n            <button id=\"clearAll\" type=\"button\" class=\"btn btn-secondary\">Clear All</button>\n          </div>\n\n          <p id=\"hint\" class=\"hint\"></p>\n        </div>\n      </article>\n\n      <article class=\"card\">\n        <h2 class=\"h2\">Reminders</h2>\n        <ul id=\"list\" class=\"list\"></ul>\n        <p id=\"emptyState\" class=\"empty\">No reminders yet. Add your first one above.</p>\n      </article>\n    </section>\n  </main>\n\n  <footer class=\"site-footer\">\n    <div class=\"container footer-inner\">\n      <p>© 2025 RemindMe</p>\n      <nav>\n        <a class=\"nav-link\" href=\"about.html\">About</a>\n      </nav>\n    </div>\n  </footer>\n\n  <!-- Load script AFTER the DOM to avoid timing issues -->\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* ===== Design tokens (kept small and simple) ===== */\n:root{\n  --bg: #f7f8fb;\n  --surface: #ffffff;\n  --text: #111827;\n  --muted: #6b7280;\n  --primary: #2563eb;\n  --primary-600: #1e4fd5;\n  --border: #e5e7eb;\n\n  --radius: 12px;\n  --radius-sm: 8px;\n\n  --space-2: 8px;\n  --space-3: 12px;\n  --space-4: 16px;\n  --space-6: 24px;\n  --space-8: 32px;\n\n  --shadow-1: 0 2px 8px rgba(0,0,0,.08);\n}\n\n/* ===== Dark theme (responds to html[data-theme=\"dark\"]) ===== */\nhtml[data-theme=\"dark\"]{\n  --bg: #0f172a;\n  --surface: #0b1224;\n  --text: #e5e7eb;\n  --muted: #a1a1aa;\n  --border: #1f2a44;\n  --primary: #60a5fa;\n  --primary-600: #3b82f6;\n}\n\n\n/* ===== Base ===== */\n*{ box-sizing: border-box; }\nhtml, body{ \n  margin:0; padding:0; \n}\n\nbody{\n  font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n  background: var(--bg);\n  color: var(--text);\n  line-height: 1.5;\n  margin: 1rem;\n}\n\nimg{ \n  max-width:100%; \n  display:block; \n}\na{ \n  color: var(--primary); \n}\nh1,h2,h3{ \n  line-height: 1.2; \n  margin: 0 0 var(--space-3); \n}\np{ \n  margin: 0 0 var(--space-3); \n}\n\n/* ===== Layout ===== */\n.container{\n  width: min(100%, 1080px);\n  margin: 0 auto;\n  padding: 0 var(--space-4);\n}\n\n.site-header{\n  background: var(--surface);\n  border-bottom: 1px solid var(--border);\n\n}\n\n.header-inner{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  /* padding: var(--space-4) 0; */\n  padding: var(--space-6) var(--space-8);\n}\n\n.brand{\n  font-weight: 900;\n  text-decoration: none;\n  color: var(--text);\n  letter-spacing: .2px;\n}\n.brand span{ \n  color: var(--primary); \n}\n\n.nav{\n  display:flex;\n  gap: var(--space-3);\n  list-style:none;\n  margin:0;\n  padding:0;\n}\n.nav-link{\n  display:inline-flex;\n  align-items:center;\n  gap:6px;\n  padding: 8px 10px;\n  border-radius: var(--radius-sm);\n  color: var(--text);\n  text-decoration: none;\n}\n/* Mark current page with a class in HTML if needed */\n.nav-link.is-current{ \n  background: rgba(37,99,235,.12); \n}\n\n.site-footer{\n  border-top: 1px solid var(--border);\n  margin-top: var(--space-8);\n}\n.footer-inner{\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  padding: var(--space-4) 0;\n}\n\n/* ===== Hero ===== */\n.hero{\n  background: rgba(37,99,235,.06);\n  border-bottom: 1px solid var(--border);\n}\n.hero-inner{ \n  padding: var(--space-8) var(--space-8);\n}\n.title{ \n  margin: 0 0 var(--space-2); \n}\n.lede{ \n  color: var(--muted); \n}\n\n/* ===== Cards / sections ===== */\n.grid{\n  display:grid;\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  gap: var(--space-6);\n  padding: var(--space-8) 0;\n}\n.card{\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  padding: var(--space-6);\n  box-shadow: var(--shadow-1);\n}\n.h2{ \n  margin-top: 0; \n}\n\n/* ===== Form / list ===== */\n.stack > * + *{ \n  margin-top: var(--space-3); \n}\n\n.field .label{\n  display:block;\n  font-weight: 600;\n  margin-bottom: 6px;\n}\n\n.input{\n  width:100%;\n  padding: 10px 12px;\n  border: 1px solid var(--border);\n  border-radius: var(--radius-sm);\n  background: transparent;\n  color: inherit;\n}\n.input:focus{\n  outline: 3px solid rgba(37,99,235,.35);\n  outline-offset: 2px;\n}\n\n.row{\n  display:flex;\n  gap: var(--space-3);\n  flex-wrap: wrap;\n}\n\n.btn{\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  padding: 10px 14px;\n  border-radius: var(--radius-sm);\n  border: 1px solid var(--border);\n  background: var(--surface);\n  color: var(--text);\n  text-decoration: none;\n  cursor: pointer;\n  font-weight: 600;\n  transition: background .18s ease, border-color .18s ease;\n}\n\n.btn:hover{ \n  background: #f3f4f6; \n}\n.btn-primary{\n  background: var(--primary);\n  border-color: var(--primary);\n  color:#fff;\n}\n\n.btn-primary:hover{\n  background: var(--primary-600);\n  border-color: var(--primary-600);\n}\n\n.btn-secondary{\n  background: transparent;\n  border-color: var(--primary);\n  color: var(--primary);\n}\n.btn-ghost{ \n  background: transparent; \n}\n\n.hint{ \n  color: var(--muted); min-height: 1.25rem; \n}\n\n.list{\n  list-style: none;\n  padding:0;\n  margin: var(--space-3) 0 0;\n}\n.list li{\n  display:grid;\n  grid-template-columns: 1fr auto auto;\n  align-items:center;\n  gap: var(--space-3);\n  padding: 10px 12px;\n  border: 1px solid var(--border);\n  border-radius: var(--radius-sm);\n  background: var(--surface);\n  margin-bottom: var(--space-2);\n}\n.list li .text{ \n  overflow-wrap: anywhere; \n}\n.list li.done .text{ \n  text-decoration: line-through; color: var(--muted); \n}\n\n.item-btn{\n  border: 1px solid var(--border);\n  background: transparent;\n  color: inherit;\n  border-radius: var(--radius-sm);\n  padding: 6px 10px;\n  cursor: pointer;\n}\n\n.item-btn:hover{ \n  background: rgba(37,99,235,.1); \n}\n\n.empty{\n  color: var(--muted);\n  margin-top: var(--space-3);\n  text-align:center;\n}\n\n/* ===== Prose (About) ===== */\n.prose p, .prose ul{ \n  max-width: 65ch; \n}\n.prose ul{ \n  padding-left: 1.25rem; \n}\n\n/* ===== Focus state ===== */\n:focus{\n  outline: 3px solid rgba(37,99,235,.45);\n  outline-offset: 2px;\n}\n",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "// -------- Theme toggle (safe; won’t block reminders logic) --------\n(function () {\n  var toggle = document.getElementById(\"themeToggle\");\n  if (!toggle) return;\n\n  function apply(mode) {\n    document.documentElement.setAttribute(\"data-theme\", mode);\n    toggle.setAttribute(\"aria-pressed\", String(mode === \"dark\"));\n    try { localStorage.setItem(\"remindme-theme\", mode); }\n    catch (err) { /* ignore */ }\n  }\n\n  var saved = \"\";\n  try { saved = (localStorage.getItem(\"remindme-theme\") || \"\").toLowerCase(); } catch {}\n  var prefersDark = false;\n  try { prefersDark = window.matchMedia && window.matchMedia(\"(prefers-color-scheme: dark)\").matches; } catch {}\n\n  apply(saved || (prefersDark ? \"dark\" : \"light\"));\n  toggle.addEventListener(\"click\", function () {\n    var current = document.documentElement.getAttribute(\"data-theme\") === \"dark\" ? \"dark\" : \"light\";\n    apply(current === \"dark\" ? \"light\" : \"dark\");\n  });\n})();\n\n// -------- Reminders (no form submit; button listeners only) --------\n(function () {\n  // Elements\n  var titleInput = document.getElementById(\"title\");\n  var addBtn = document.getElementById(\"addBtn\");\n  var clearAll = document.getElementById(\"clearAll\");\n  var list = document.getElementById(\"list\");\n  var empty = document.getElementById(\"emptyState\");\n  var hint = document.getElementById(\"hint\");\n\n  // If we’re not on the reminders page, bail.\n  if (!titleInput || !addBtn || !clearAll || !list || !empty) return;\n\n  // Simple in-memory state\n  var items = [];\n\n  function escapeHtml(s) {\n    return String(s).replace(/[&<>\"']/g, function (m) {\n      return ({ \"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",\"\\\"\":\"&quot;\",\"'\":\"&#39;\" })[m];\n    });\n  }\n\n  function updateEmpty() {\n    empty.style.display = items.length ? \"none\" : \"block\";\n  }\n\n  function render() {\n    list.innerHTML = \"\";\n    for (var i = 0; i < items.length; i++) {\n      var li = document.createElement(\"li\");\n      li.innerHTML =\n        '<span class=\"text\">' + escapeHtml(items[i]) + '</span>' +\n        '<button class=\"item-btn\" type=\"button\" data-i=\"' + i + '\" data-action=\"done\">Done</button>' +\n        '<button class=\"item-btn\" type=\"button\" data-i=\"' + i + '\" data-action=\"delete\">Delete</button>';\n      list.appendChild(li);\n    }\n    updateEmpty();\n  }\n\n  function addItemFromInput() {\n    var value = (titleInput.value || \"\").trim();\n    if (!value) {\n      hint && (hint.textContent = \"Please enter a reminder title.\");\n      titleInput.focus();\n      return;\n    }\n    items.push(value);\n    titleInput.value = \"\";\n    render();\n    hint && (hint.textContent = \"Added a new reminder.\");\n  }\n\n  // Add button click (primary path)\n  addBtn.addEventListener(\"click\", addItemFromInput);\n\n  // Also add on Enter key in the input\n  titleInput.addEventListener(\"keydown\", function (e) {\n    if (e.key === \"Enter\") {\n      e.preventDefault(); // don’t submit anything\n      addItemFromInput();\n    }\n  });\n\n  // Delete / Done via event delegation\n  list.addEventListener(\"click\", function (e) {\n    var btn = e.target.closest(\"button.item-btn\");\n    if (!btn) return;\n\n    var idx = parseInt(btn.getAttribute(\"data-i\"), 10);\n    if (isNaN(idx)) return;\n\n    var action = btn.getAttribute(\"data-action\");\n    if (action === \"delete\") {\n      items.splice(idx, 1);\n      render();\n      hint && (hint.textContent = \"Reminder deleted.\");\n    } else if (action === \"done\") {\n      var li = btn.closest(\"li\");\n      if (li) {\n        li.classList.toggle(\"done\");\n        hint && (hint.textContent = li.classList.contains(\"done\") ? \"Marked as done.\" : \"Marked as not done.\");\n      }\n    }\n  });\n\n  // Clear All button\n  clearAll.addEventListener(\"click\", function () {\n    items.length = 0;\n    render();\n    hint && (hint.textContent = \"All reminders cleared.\");\n  });\n\n  // Initial paint\n  render();\n})();",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "about.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <title>About — RemindMe</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n  <script defer src=\"script.js\"></script>\n</head>\n<body>\n  <header class=\"site-header\">\n    <div class=\"container header-inner\">\n      <a class=\"brand\" href=\"index.html\">Remind<span>Me</span></a>\n      <nav>\n        <ul class=\"nav\">\n          <li><a class=\"nav-link\" href=\"index.html\">🏠 Home</a></li>\n          <li><a class=\"nav-link\" href=\"about.html\">❓ About</a></li>\n          <li>\n            <button id=\"themeToggle\" class=\"btn btn-ghost\">\n              🌗 Theme\n            </button>\n          </li>\n        </ul>\n      </nav>\n    </div>\n  </header>\n\n  <main id=\"main\" class=\"container\">\n    <section class=\"prose card\">\n      <h1>About RemindMe</h1>\n      <p><strong>RemindMe</strong> is a simple, student-friendly reminder app designed to demonstrate\n         good UI patterns: clear labels, predictable actions, and helpful feedback.</p>\n\n      <h2>What’s improved vs. Level 1?</h2>\n      <ul>\n        <li>Readable colors with strong contrast</li>\n        <li>Clear, labeled buttons with consistent behavior</li>\n        <li>Accessible structure (skip link, ARIA, focus states)</li>\n        <li>Theme toggle that reflects state and stores your preference</li>\n      </ul>\n\n      <p><a class=\"btn btn-primary\" href=\"index.html\">Back to Reminders</a></p>\n    </section>\n  </main>\n\n  <footer class=\"site-footer\">\n    <div class=\"container footer-inner\">\n      <p>© 2025 RemindMe</p>\n      <nav>\n        <a class=\"nav-link\" href=\"index.html\">Home</a>\n      </nav>\n    </div>\n  </footer>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "1",
        "2",
        "3",
        "4"
      ]
    },
    "long_instructions": "## Explore the Improved App\r\n\r\n* Add a few reminders.\r\n* Mark some as done and delete one.\r\n* Use Clear All and try Light/Dark mode.\r\n* Navigate between pages."
  },
  "audit_log": "[{\"changed_at\":\"2025-10-16T17:57:55.481+00:00\",\"changed\":[\"cloned from \\\"ai-and-algorithmic-decisions-lesson1-level1-test-2025\\\"\"],\"cloned_from\":\"ai-and-algorithmic-decisions-lesson1-level1-test-2025\"},{\"changed_at\":\"2025-10-16 17:58:03 +0000\",\"changed\":[\"long_instructions\"],\"changed_by_id\":18602,\"changed_by_email\":\"angelina+levelbuilder@code.org\"},{\"changed_at\":\"2025-10-16 18:09:49 +0000\",\"changed\":[\"start_sources\"],\"changed_by_id\":18602,\"changed_by_email\":\"angelina+levelbuilder@code.org\"},{\"changed_at\":\"2025-10-16 18:12:46 +0000\",\"changed\":[],\"changed_by_id\":18602,\"changed_by_email\":\"angelina+levelbuilder@code.org\"},{\"changed_at\":\"2025-10-16 18:21:18 +0000\",\"changed\":[\"start_sources\"],\"changed_by_id\":18602,\"changed_by_email\":\"angelina+levelbuilder@code.org\"},{\"changed_at\":\"2025-10-16 18:22:06 +0000\",\"changed\":[],\"changed_by_id\":18602,\"changed_by_email\":\"angelina+levelbuilder@code.org\"},{\"changed_at\":\"2025-10-16 18:28:36 +0000\",\"changed\":[\"start_sources\"],\"changed_by_id\":18602,\"changed_by_email\":\"angelina+levelbuilder@code.org\"},{\"changed_at\":\"2025-10-16 18:31:32 +0000\",\"changed\":[],\"changed_by_id\":18602,\"changed_by_email\":\"angelina+levelbuilder@code.org\"},{\"changed_at\":\"2025-10-16 18:33:02 +0000\",\"changed\":[\"long_instructions\"],\"changed_by_id\":18602,\"changed_by_email\":\"angelina+levelbuilder@code.org\"},{\"changed_at\":\"2025-10-16 18:53:08 +0000\",\"changed\":[\"start_sources\"],\"changed_by_id\":18602,\"changed_by_email\":\"angelina+levelbuilder@code.org\"},{\"changed_at\":\"2025-10-16 21:28:33 +0000\",\"changed\":[\"start_sources\"],\"changed_by_id\":18602,\"changed_by_email\":\"angelina+levelbuilder@code.org\"},{\"changed_at\":\"2025-10-16 21:28:36 +0000\",\"changed\":[],\"changed_by_id\":18602,\"changed_by_email\":\"angelina+levelbuilder@code.org\"},{\"changed_at\":\"2025-10-16 21:28:43 +0000\",\"changed\":[],\"changed_by_id\":18602,\"changed_by_email\":\"angelina+levelbuilder@code.org\"},{\"changed_at\":\"2025-10-16 21:29:39 +0000\",\"changed\":[],\"changed_by_id\":18602,\"changed_by_email\":\"angelina+levelbuilder@code.org\"},{\"changed_at\":\"2025-10-17 21:39:29 +0000\",\"changed\":[\"start_sources\"],\"changed_by_id\":18602,\"changed_by_email\":\"angelina+levelbuilder@code.org\"},{\"changed_at\":\"2025-10-21 15:26:07 +0000\",\"changed\":[\"start_sources\"],\"changed_by_id\":18762,\"changed_by_email\":\"emma.wingreen+levelbuilder@code.org\"},{\"changed_at\":\"2025-10-31 18:10:09 +0000\",\"changed\":[\"ai_tutor_mode\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2025-11-12 19:25:35 +0000\",\"changed\":[\"long_instructions\"],\"changed_by_id\":16889,\"changed_by_email\":\"jamila+lb@code.org\"}]"
