        "15": {
          "id": "15",
          "name": "data.js",
          "contents": "const animals = [\n  {\n    name: \"Buddy\",\n    species: \"Dog\",\n    breed: \"Golden Retriever\",\n    image: \"golden_retriever_dog.png\",\n    age: 3,\n    gender: \"Male\",\n    color: \"Golden\",\n    status: \"Available\",\n    bio: \"Friendly and loves to play fetch. Great with kids and other dogs!\"\n  },\n  {\n    name: \"Max\",\n    species: \"Dog\",\n    breed: \"Golden Doodle\",\n    image: \"doodle_dog.jpg\",\n    age: 2,\n    gender: \"Male\",\n    color: \"Cream\",\n    status: \"Available\",\n    bio: \"A playful doodle with endless energy, loves long walks.\"\n  },\n  {\n    name: \"Rocky\",\n    species: \"Dog\",\n    breed: \"Boxer\",\n    image: \"boxer_dog.png\",\n    age: 4,\n    gender: \"Male\",\n    color: \"Brown\",\n    status: \"Pending Adoption\"\n  },\n  {\n    name: \"Peanut\",\n    species: \"Dog\",\n    breed: \"Chihuahua\",\n    image: \"chiuaua_dog.png\",\n    age: 5,\n    gender: \"Male\",\n    color: \"Tan\",\n    status: \"Available\",\n    bio: \"A tiny dog with a big personality!\"\n  },\n  {\n    name: \"Bruno\",\n    species: \"Dog\",\n    breed: \"Rottweiler\",\n    image: \"rottweiler_dog.png\",\n    gender: \"Male\",\n    status: \"Available\",\n    bio: \"Needs an experienced owner.\"\n  },\n  {\n    name: \"Daisy\",\n    species: \"Dog\",\n    breed: \"Pomeranian\",\n    image: \"pomeranian_dog.png\",\n    age: 1,\n    gender: \"Female\",\n    color: \"Orange\",\n    status: \"Available\",\n    bio: \"Sweet little floof looking for her forever home. Loves cuddles and treats.\"\n  },\n  {\n    name: \"Oliver\",\n    species: \"Cat\",\n    breed: \"Tuxedo\",\n    image: \"tuxedo_cat.jpg\",\n    age: 6,\n    gender: \"Male\",\n    color: \"Black and White\",\n    status: \"Available\",\n    bio: \"A charming and independent cat, enjoys quiet afternoons by the window and a good nap. Oliver is litter-trained and gets along well with calm adults.\"\n  },\n  {\n    name: \"Luna\",\n    species: \"Cat\",\n    breed: \"Siamese\",\n    image: \"siamese_cat.jpg\",\n    gender: \"Female\",\n    status: \"Adopted\"\n  }\n]",
