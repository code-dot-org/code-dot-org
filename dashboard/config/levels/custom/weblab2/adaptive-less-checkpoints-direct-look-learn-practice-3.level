<Weblab2>
  <config><![CDATA[{
  "published": true,
  "game_id": 74,
  "created_at": "2026-11-03T04:23:50.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": "false",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "script.js",
          "contents": "'use strict';\n\n/* ------------------------------------------------------------------ */\n/* Configuration                                                      */\n/* ------------------------------------------------------------------ */\n\nconst CONFIG = {\n  // Finish turns on after a picture has shown once. Set to false to leave it on.\n  requireImageToFinish: true\n};\n\n// Files that are already in the project before anything is uploaded.\nconst PROJECT_FILES = ['index.html', 'script.js', 'style.css'];\n\n// Words the practice tutor listens for when a prompt names a photo card.\n// Index 0 is the first card and index 1 is the second card.\nconst CARD_WORDS = [\n  ['first', '1st', '1', 'one', 'top', 'left'],\n  ['second', '2nd', '2', 'two', 'bottom', 'right']\n];\n\n/* ------------------------------------------------------------------ */\n/* Copy                                                               */\n/* Backticks mark inline code. Keep whole sentences together so they  */\n/* can be translated.                                                 */\n/* ------------------------------------------------------------------ */\n\nconst STRINGS = {\n  practiceTag: 'Practice',\n\n  introTitle: 'Show your picture on a page',\n  introDefinition: 'The `img` tag shows a picture. Its `src` (short for source) tells the browser which file to show.',\n  introPurpose: 'This is a quick chance to practice a skill you will use in your project.',\n  introSteps: [\n    'Press Code. Then press + in Files and choose Upload.',\n    'Ask the AI Tutor to put the picture in a photo card. Use the exact file name.',\n    'Press Preview to see it. Then change the name or the card and watch the page.'\n  ],\n  startButton: 'Start',\n\n  activityTitle: 'Show your picture',\n  activitySteps: [\n    'Press Code to see your Files.',\n    'In Files, press + and then Upload. Pick a picture.',\n    {\n      text: 'Ask the AI Tutor to put it on your page. Use the exact file name and say where it goes.',\n      example: 'Example: “Put hiking.jpg in the first photo card.”'\n    },\n    'Press Preview to see your picture. Then press Finish.'\n  ],\n  modeBarAria: 'Workspace view',\n  modeCode: 'Code',\n  modePreview: 'Preview',\n  modeSplit: 'Split View',\n  announceMode: (label) => `Showing ${label}.`,\n  finishButton: 'Finish',\n  resetButton: 'Start over',\n\n  filesTitle: 'Files',\n  uploadAria: 'Add to Files',\n  menuNewFolder: 'New Folder',\n  menuNewFile: 'New File',\n  menuUpload: 'Upload',\n  menuPickTitle: 'Choose an image',\n  uploadedLabel: 'Uploaded',\n  uploadMenuAria: (name) => `Upload ${name}`,\n  removeAria: (name) => `Remove ${name}`,\n  fileMarkFound: 'Named in your prompt',\n  fileMarkClose: 'Compare with your prompt',\n\n  tutorTitle: 'Ask the AI Tutor',\n  promptLabel: 'Your prompt',\n  promptPlaceholder: 'Example: Put hiking.jpg in the first photo card.',\n  sendButton: 'Send',\n  samplePrompt: (name) => `Put ${name} in the first photo card.`,\n\n  previewTitle: 'Your page',\n  cardPlaceholders: ['[Photo of Juniper hiking]', '[Photo of Juniper in the park]'],\n  cardOrdinals: ['first', 'second'],\n  previewMissing: 'Picture not found',\n\n  takeawayTitle: 'Takeaway: src must match the file name',\n  takeawayText: 'The browser looks in your project files for the name in `src`. If the file is missing, or a letter, capital or ending is different, no picture shows.',\n  takeawaySteps: [\n    'Press Code. In Files, press + and then Upload to add your image.',\n    {\n      text: 'Ask the AI Tutor to put it in a photo card. Use the exact file name.',\n      example: 'Example: “Put hiking.jpg in the first photo card.”'\n    },\n    'If no picture shows, check the file name and tell the AI Tutor what to fix.'\n  ],\n  takeawayNext: 'Press Continue to go to your project.',\n  workspaceAlt: 'The Web Lab workspace. The Files list is on the left with a plus button at the top. The index.html code is on the right, with the photo card sections where an img tag can go.',\n\n  loadError: 'This activity could not start. Reload the page to try again.',\n\n  announceUploaded: (name) => `Uploaded ${name} to Files.`,\n  announceRemoved: (name) => `Removed ${name} from Files.`,\n  announceReset: 'Started over. Both photo cards show placeholder text.',\n\n  previewDescription: (first, second) =>\n    `Preview of your page. It has the heading Photo Collection and two photo cards. The first card ${first}. The second card ${second}.`,\n  cardPlaceholderDescription: 'shows placeholder text',\n  cardMissingDescription: 'shows a message that the picture was not found',\n  cardShownDescription: (description) => `shows a picture of ${description}`,\n\n  // One short label and one short takeaway for each result.\n  status: {\n    waiting: { label: 'Waiting', text: 'Press Code. Then press + in Files to upload a picture.' },\n    ready: { label: 'Ready', text: 'Press Send to ask the AI Tutor.' },\n    askFile: { label: 'Tutor asks', text: 'Which file? Add the exact file name to your prompt.' },\n    askPlace: { label: 'Tutor asks', text: 'Which photo card? Say first or second.' },\n    found: { label: 'Found', text: (name, card) => `The tutor put ${name} in the ${card} photo card.` },\n    noFiles: { label: 'Not found', text: 'No picture is uploaded yet. Press Code, then + in Files.' },\n    case: { label: 'Almost', text: 'Capital letters count. Compare with the marked file.' },\n    ending: { label: 'Almost', text: 'The file ending counts, like .jpg. Compare with the marked file.' },\n    notPicture: { label: 'Not a picture', text: 'That file is not a picture. Use a picture file.' },\n    missing: { label: 'Not found', text: 'No file has that name. Check the Files list in Code.' }\n  }\n};\n\n// Pictures a student can upload. The art is drawn in index.html.\nconst SAMPLE_IMAGES = [\n  { name: 'hiking.jpg', art: 'sunset', description: 'hills at sunset' },\n  { name: 'park.jpg', art: 'garden', description: 'a pink flower in a park' },\n  { name: 'badge.svg', art: 'badge', description: 'a purple badge with a spark' }\n];\n\n/* ------------------------------------------------------------------ */\n/* Visual settings for each result                                    */\n/* ------------------------------------------------------------------ */\n\nconst STATUS_STYLE = {\n  waiting: { tone: 'info', icon: 'info' },\n  ready: { tone: 'info', icon: 'info' },\n  askFile: { tone: 'info', icon: 'info' },\n  askPlace: { tone: 'info', icon: 'info' },\n  found: { tone: 'success', icon: 'check' },\n  noFiles: { tone: 'warning', icon: 'search' },\n  case: { tone: 'warning', icon: 'alert' },\n  ending: { tone: 'warning', icon: 'alert' },\n  notPicture: { tone: 'warning', icon: 'alert' },\n  missing: { tone: 'warning', icon: 'search' }\n};\n\nconst SVG_NS = 'http://www.w3.org/2000/svg';\n\nconst ICONS = {\n  file: ['M7 3h7l4 4v14H7z', 'M14 3v4h4'],\n  image: ['M4 5h16v14H4z', 'M4 16l5-5 4 4 3-3 4 4', 'M9 8.5h.01'],\n  imageOff: ['M4 5h16v14H4z', 'M4 16l5-5 3 3', 'M3 3l18 18'],\n  plus: ['M12 5v14', 'M5 12h14'],\n  check: ['M5 12l5 5 9-10'],\n  xmark: ['M6 6l12 12', 'M18 6L6 18'],\n  alert: ['M12 4l9 16H3z', 'M12 10v4', 'M12 17h.01'],\n  info: ['M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z', 'M12 11v6', 'M12 7.5h.01'],\n  search: ['M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14z', 'M16 16l5 5'],\n  code: ['M8 7l-5 5 5 5', 'M16 7l5 5-5 5', 'M14 5l-4 14'],\n  eye: ['M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z', 'M12 9.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z'],\n  split: ['M4 5h16v14H4z', 'M12 5v14'],\n  folder: ['M3 6h6l2 2h10v11H3z'],\n  upload: ['M12 15V4', 'M7 9l5-5 5 5', 'M4 15v5h16v-5']\n};\n\n/* ------------------------------------------------------------------ */\n/* State                                                              */\n/* ------------------------------------------------------------------ */\n\nconst state = {\n  uploaded: [],          // names of uploaded sample pictures, in upload order\n  cards: [null, null],   // what the tutor wrote in each card: { src } or null\n  last: null,            // the last thing the tutor did: { card } or { kind }\n  promptEdited: false,   // the student changed the sample prompt\n  pictureShown: false,   // a picture has shown at least once\n  menuOpen: false,\n  menuView: 'main',      // 'main' shows the menu, 'pick' shows the pictures\n  mode: 'preview',       // 'code', 'preview' or 'split'\n  newFile: null,         // name of the row that was just uploaded\n  flashCard: null,       // card that just changed\n  noteKey: null,         // which result the note currently shows\n  previewKeys: [null, null]\n};\n\nconst els = {};\n\n/* ------------------------------------------------------------------ */\n/* Helpers                                                            */\n/* ------------------------------------------------------------------ */\n\nfunction createIcon(name) {\n  const svg = document.createElementNS(SVG_NS, 'svg');\n  svg.setAttribute('viewBox', '0 0 24 24');\n  svg.setAttribute('class', 'icon');\n  svg.setAttribute('aria-hidden', 'true');\n  svg.setAttribute('focusable', 'false');\n  ICONS[name].forEach((d) => {\n    const path = document.createElementNS(SVG_NS, 'path');\n    path.setAttribute('d', d);\n    svg.appendChild(path);\n  });\n  return svg;\n}\n\nfunction setRichText(el, text) {\n  el.textContent = '';\n  text.split('`').forEach((part, index) => {\n    if (!part) {\n      return;\n    }\n    if (index % 2 === 1) {\n      const code = document.createElement('code');\n      code.textContent = part;\n      el.appendChild(code);\n    } else {\n      el.appendChild(document.createTextNode(part));\n    }\n  });\n}\n\nfunction plainText(text) {\n  return text.split('`').join('');\n}\n\nfunction createArt(artId) {\n  const template = document.getElementById(`art-${artId}`);\n  if (!template || !template.content || !template.content.firstElementChild) {\n    throw new Error(`Missing picture: ${artId}`);\n  }\n  return template.content.firstElementChild.cloneNode(true);\n}\n\nfunction findSample(name) {\n  return SAMPLE_IMAGES.find((image) => image.name === name);\n}\n\nfunction stripEnding(name) {\n  const dot = name.lastIndexOf('.');\n  return dot > 0 ? name.slice(0, dot) : name;\n}\n\nfunction restartAnimation(el) {\n  el.classList.remove('is-new');\n  void el.offsetWidth;\n  el.classList.add('is-new');\n}\n\nfunction announce(message) {\n  // Clearing first makes a repeated message announce again.\n  els.announcer.textContent = '';\n  window.setTimeout(() => {\n    els.announcer.textContent = message;\n  }, 50);\n}\n\n/* ------------------------------------------------------------------ */\n/* Screens                                                            */\n/* ------------------------------------------------------------------ */\n\nfunction showScreen(name) {\n  ['intro', 'activity', 'takeaway'].forEach((screen) => {\n    document.getElementById(`screen-${screen}`).hidden = screen !== name;\n  });\n  const title = document.querySelector(`#screen-${name} .screen-title`);\n  if (title) {\n    title.focus();\n  }\n}\n\n/* ------------------------------------------------------------------ */\n/* The practice tutor                                                 */\n/* ------------------------------------------------------------------ */\n\n// Finds the file name and the photo card a prompt asks for.\nfunction interpretPrompt(text) {\n  const knownBases = state.uploaded.map((name) => stripEnding(name).toLowerCase());\n  const tokens = (text.match(/[^\\s\"'“”‘’,;:!?()]+/g) || []).map((token) => token.replace(/\\.+$/, ''));\n\n  const fileIndex = tokens.findIndex((token) => {\n    const hasEnding = /^[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.[A-Za-z0-9]{2,5}$/.test(token);\n    return hasEnding || knownBases.includes(token.toLowerCase());\n  });\n\n  const file = fileIndex === -1 ? null : tokens[fileIndex];\n  const words = tokens\n    .filter((token, index) => index !== fileIndex)\n    .map((token) => token.toLowerCase());\n\n  const card = words.reduce((found, word) => {\n    if (found !== null) {\n      return found;\n    }\n    const index = CARD_WORDS.findIndex((list) => list.includes(word));\n    return index === -1 ? null : index;\n  }, null);\n\n  return { file, card };\n}\n\nfunction evaluateSrc(value) {\n  const src = value.trim();\n  const images = state.uploaded.map(findSample);\n\n  const exact = images.find((image) => image.name === src);\n  if (exact) {\n    return { kind: 'found', file: exact };\n  }\n  if (PROJECT_FILES.includes(src)) {\n    return { kind: 'notPicture', closeName: src };\n  }\n\n  const lower = src.toLowerCase();\n  const sameLetters = images.find((image) => image.name.toLowerCase() === lower);\n  if (sameLetters) {\n    return { kind: 'case', closeName: sameLetters.name };\n  }\n\n  const typedBase = (src.includes('.') ? stripEnding(src) : src).toLowerCase();\n  const sameBase = images.find((image) => stripEnding(image.name).toLowerCase() === typedBase);\n  if (sameBase) {\n    return { kind: 'ending', closeName: sameBase.name };\n  }\n\n  return { kind: images.length === 0 ? 'noFiles' : 'missing' };\n}\n\nfunction getCardResult(index) {\n  const card = state.cards[index];\n  return card ? evaluateSrc(card.src) : { kind: 'placeholder' };\n}\n\nfunction sendPrompt() {\n  const { file, card } = interpretPrompt(els.promptInput.value);\n\n  if (!file) {\n    state.last = { kind: 'askFile' };\n  } else if (card === null) {\n    state.last = { kind: 'askPlace' };\n  } else {\n    state.cards[card] = { src: file };\n    state.last = { card };\n    state.flashCard = card;\n  }\n\n  const note = update();\n  announce(note.message);\n}\n\n/* ------------------------------------------------------------------ */\n/* Rendering                                                          */\n/* ------------------------------------------------------------------ */\n\nfunction createFileRow(name, isUpload) {\n  const row = document.createElement('li');\n  row.className = 'file-row';\n  row.dataset.file = name;\n  if (isUpload && state.newFile === name) {\n    row.classList.add('is-new');\n  }\n\n  const icons = document.createElement('span');\n  icons.className = 'file-icons';\n  const fileIcon = createIcon(isUpload ? 'image' : 'file');\n  fileIcon.classList.add('file-icon');\n  const foundIcon = createIcon('check');\n  foundIcon.classList.add('mark-icon', 'mark-found');\n  const closeIcon = createIcon('alert');\n  closeIcon.classList.add('mark-icon', 'mark-close');\n  icons.append(fileIcon, foundIcon, closeIcon);\n\n  const label = document.createElement('span');\n  label.className = 'file-name';\n  label.textContent = name;\n\n  const markText = document.createElement('span');\n  markText.className = 'visually-hidden file-mark-text';\n  label.appendChild(markText);\n\n  row.append(icons, label);\n\n  if (isUpload) {\n    const removeButton = document.createElement('button');\n    removeButton.type = 'button';\n    removeButton.className = 'button button-text button-icon';\n    removeButton.setAttribute('aria-label', STRINGS.removeAria(name));\n    removeButton.appendChild(createIcon('xmark'));\n    removeButton.dataset.file = name;\n    row.appendChild(removeButton);\n  }\n\n  return row;\n}\n\nfunction renderFiles() {\n  els.fileList.textContent = '';\n  PROJECT_FILES.forEach((name) => els.fileList.appendChild(createFileRow(name, false)));\n  state.uploaded.forEach((name) => els.fileList.appendChild(createFileRow(name, true)));\n  state.newFile = null;\n}\n\nfunction createMenuAction(iconName, label, options) {\n  const item = document.createElement('li');\n  const button = document.createElement('button');\n  button.type = 'button';\n  button.className = 'menu-item';\n  button.appendChild(createIcon(iconName));\n  const text = document.createElement('span');\n  text.className = 'menu-name';\n  text.textContent = label;\n  button.appendChild(text);\n  if (options.disabled) {\n    button.disabled = true;\n  } else {\n    button.dataset.action = options.action;\n  }\n  item.appendChild(button);\n  return item;\n}\n\nfunction renderMenu() {\n  els.uploadMenu.textContent = '';\n\n  if (state.menuView === 'main') {\n    els.uploadMenu.appendChild(createMenuAction('folder', STRINGS.menuNewFolder, { disabled: true }));\n    els.uploadMenu.appendChild(createMenuAction('file', STRINGS.menuNewFile, { disabled: true }));\n    els.uploadMenu.appendChild(createMenuAction('upload', STRINGS.menuUpload, { action: 'upload' }));\n    return;\n  }\n\n  const heading = document.createElement('li');\n  heading.className = 'menu-heading';\n  heading.setAttribute('role', 'presentation');\n  heading.textContent = STRINGS.menuPickTitle;\n  els.uploadMenu.appendChild(heading);\n\n  SAMPLE_IMAGES.forEach((image) => {\n    const isUploaded = state.uploaded.includes(image.name);\n\n    const item = document.createElement('li');\n    const button = document.createElement('button');\n    button.type = 'button';\n    button.className = 'menu-item';\n    button.dataset.name = image.name;\n    button.disabled = isUploaded;\n\n    const thumb = document.createElement('span');\n    thumb.className = 'menu-thumb';\n    thumb.setAttribute('aria-hidden', 'true');\n    thumb.appendChild(createArt(image.art));\n\n    const name = document.createElement('span');\n    name.className = 'menu-name';\n    name.textContent = image.name;\n\n    button.append(thumb, name);\n\n    if (isUploaded) {\n      const done = document.createElement('span');\n      done.className = 'menu-done';\n      done.appendChild(createIcon('check'));\n      const doneText = document.createElement('span');\n      doneText.textContent = STRINGS.uploadedLabel;\n      done.appendChild(doneText);\n      button.appendChild(done);\n    } else {\n      button.setAttribute('aria-label', STRINGS.uploadMenuAria(image.name));\n    }\n\n    item.appendChild(button);\n    els.uploadMenu.appendChild(item);\n  });\n}\n\nfunction renderCode() {\n  els.codeContents.forEach((content, index) => {\n    content.textContent = '';\n    const card = state.cards[index];\n    if (card) {\n      const value = document.createElement('span');\n      value.className = 'code-value';\n      value.textContent = card.src;\n      content.append(document.createTextNode('  <img src=\"'), value, document.createTextNode('\">'));\n    } else {\n      content.textContent = `  <p>${STRINGS.cardPlaceholders[index]}</p>`;\n    }\n    if (state.flashCard === index) {\n      restartAnimation(content.parentElement);\n    }\n  });\n}\n\nfunction renderPreview(results) {\n  const phrases = results.map((result) => {\n    if (result.kind === 'found') {\n      return STRINGS.cardShownDescription(result.file.description);\n    }\n    return result.kind === 'placeholder' ? STRINGS.cardPlaceholderDescription : STRINGS.cardMissingDescription;\n  });\n  els.previewDescription.textContent = STRINGS.previewDescription(phrases[0], phrases[1]);\n\n  els.previewCards.forEach((frame, index) => {\n    const result = results[index];\n    const key = result.kind === 'found' ? `art:${result.file.name}` : (result.kind === 'placeholder' ? 'placeholder' : 'broken');\n    if (key === state.previewKeys[index]) {\n      return;\n    }\n    const isFirstDraw = state.previewKeys[index] === null;\n    state.previewKeys[index] = key;\n\n    frame.textContent = '';\n    if (result.kind === 'found') {\n      frame.dataset.state = 'shown';\n      frame.appendChild(createArt(result.file.art));\n      state.pictureShown = true;\n    } else if (result.kind === 'placeholder') {\n      frame.dataset.state = 'placeholder';\n      const text = document.createElement('span');\n      text.textContent = STRINGS.cardPlaceholders[index];\n      frame.appendChild(text);\n    } else {\n      frame.dataset.state = 'broken';\n      frame.appendChild(createIcon('imageOff'));\n      const text = document.createElement('span');\n      text.textContent = STRINGS.previewMissing;\n      frame.appendChild(text);\n    }\n    if (!isFirstDraw) {\n      restartAnimation(frame);\n    }\n  });\n}\n\n// Works out what the tutor note should say right now.\nfunction getNote(results) {\n  if (!state.last) {\n    return { key: state.uploaded.length === 0 ? 'waiting' : 'ready', result: null };\n  }\n  if (state.last.kind) {\n    return { key: state.last.kind, result: null };\n  }\n  const result = results[state.last.card];\n  return { key: result.kind, result, card: state.last.card };\n}\n\nfunction renderNote(note) {\n  const copy = STRINGS.status[note.key];\n  const style = STATUS_STYLE[note.key];\n  let text = copy.text;\n  if (note.key === 'found') {\n    text = copy.text(note.result.file.name, STRINGS.cardOrdinals[note.card]);\n  }\n  const fullKey = `${note.key}:${text}`;\n\n  els.statusNote.dataset.status = style.tone;\n  const message = `${copy.label}. ${plainText(text)}`;\n  if (fullKey === state.noteKey) {\n    return { message, changed: false };\n  }\n  state.noteKey = fullKey;\n\n  els.statusNote.textContent = '';\n  const tag = document.createElement('span');\n  tag.className = `tag tag-${style.tone}`;\n  tag.appendChild(createIcon(style.icon));\n  const label = document.createElement('span');\n  label.textContent = copy.label;\n  tag.appendChild(label);\n\n  const body = document.createElement('p');\n  body.className = 'status-text';\n  setRichText(body, text);\n\n  els.statusNote.append(tag, body);\n  return { message, changed: true };\n}\n\nfunction markRows(note) {\n  els.fileList.querySelectorAll('.file-row').forEach((row) => {\n    let mark = '';\n    let text = '';\n    if (note.key === 'found' && row.dataset.file === note.result.file.name) {\n      mark = 'found';\n      text = STRINGS.fileMarkFound;\n    } else if (note.result && note.result.closeName === row.dataset.file) {\n      mark = 'close';\n      text = STRINGS.fileMarkClose;\n    }\n    if (mark) {\n      row.dataset.match = mark;\n    } else {\n      delete row.dataset.match;\n    }\n    row.querySelector('.file-mark-text').textContent = text ? ` (${text})` : '';\n  });\n}\n\n// Runs after anything changes. Returns the note text and whether it changed.\nfunction update() {\n  const results = state.cards.map((card, index) => getCardResult(index));\n  const note = getNote(results);\n\n  renderCode();\n  state.flashCard = null;\n  renderPreview(results);\n  markRows(note);\n  const rendered = renderNote(note);\n  els.finishButton.disabled = CONFIG.requireImageToFinish && !state.pictureShown;\n\n  return { message: rendered.message, changed: rendered.changed };\n}\n\n/* ------------------------------------------------------------------ */\n/* Upload menu                                                        */\n/* ------------------------------------------------------------------ */\n\nfunction openMenu() {\n  state.menuOpen = true;\n  state.menuView = 'main';\n  renderMenu();\n  els.uploadMenu.hidden = false;\n  els.uploadToggle.setAttribute('aria-expanded', 'true');\n  const first = els.uploadMenu.querySelector('button:not(:disabled)');\n  if (first) {\n    first.focus();\n  }\n}\n\nfunction closeMenu(returnFocus) {\n  state.menuOpen = false;\n  state.menuView = 'main';\n  els.uploadMenu.hidden = true;\n  els.uploadToggle.setAttribute('aria-expanded', 'false');\n  if (returnFocus) {\n    els.uploadToggle.focus();\n  }\n}\n\nfunction moveMenuFocus(step) {\n  const buttons = Array.from(els.uploadMenu.querySelectorAll('button:not(:disabled)'));\n  if (buttons.length === 0) {\n    return;\n  }\n  const index = buttons.indexOf(document.activeElement);\n  const next = (index + step + buttons.length) % buttons.length;\n  buttons[next].focus();\n}\n\n/* ------------------------------------------------------------------ */\n/* Workspace view                                                     */\n/* ------------------------------------------------------------------ */\n\nconst MODE_LABELS = {\n  code: () => STRINGS.modeCode,\n  preview: () => STRINGS.modePreview,\n  split: () => STRINGS.modeSplit\n};\n\nfunction setMode(mode, shouldAnnounce) {\n  state.mode = mode;\n  els.activity.dataset.mode = mode;\n  els.modeButtons.forEach((button) => {\n    button.setAttribute('aria-pressed', String(button.dataset.mode === mode));\n  });\n  if (mode !== 'code' && state.menuOpen) {\n    closeMenu(false);\n  }\n  if (shouldAnnounce) {\n    announce(STRINGS.announceMode(MODE_LABELS[mode]()));\n  }\n}\n\n/* ------------------------------------------------------------------ */\n/* Actions                                                            */\n/* ------------------------------------------------------------------ */\n\n// Fills the prompt box with a sample for the newest upload, until the student edits it.\nfunction refreshSamplePrompt() {\n  if (state.promptEdited) {\n    return;\n  }\n  const newest = state.uploaded[state.uploaded.length - 1];\n  els.promptInput.value = newest ? STRINGS.samplePrompt(newest) : '';\n}\n\nfunction uploadImage(name) {\n  if (state.uploaded.includes(name)) {\n    return;\n  }\n  state.uploaded.push(name);\n  state.newFile = name;\n  renderFiles();\n  renderMenu();\n  closeMenu(true);\n  refreshSamplePrompt();\n  const note = update();\n  announce([STRINGS.announceUploaded(name), note.changed ? note.message : ''].filter(Boolean).join(' '));\n}\n\nfunction removeImage(name) {\n  state.uploaded = state.uploaded.filter((item) => item !== name);\n  renderFiles();\n  renderMenu();\n  refreshSamplePrompt();\n  const note = update();\n  els.uploadToggle.focus();\n  announce([STRINGS.announceRemoved(name), note.changed ? note.message : ''].filter(Boolean).join(' '));\n}\n\nfunction resetActivity() {\n  state.uploaded = [];\n  state.cards = [null, null];\n  state.last = null;\n  state.promptEdited = false;\n  state.pictureShown = false;\n  state.noteKey = null;\n  state.previewKeys = [null, null];\n  els.promptInput.value = '';\n  closeMenu(false);\n  setMode('preview', false);\n  renderFiles();\n  update();\n  els.modeButtons[0].focus();\n  announce(STRINGS.announceReset);\n}\n\n/* ------------------------------------------------------------------ */\n/* Events                                                             */\n/* ------------------------------------------------------------------ */\n\nfunction bindEvents() {\n  document.getElementById('start-button').addEventListener('click', () => showScreen('activity'));\n  els.finishButton.addEventListener('click', () => showScreen('takeaway'));\n  document.getElementById('reset-button').addEventListener('click', resetActivity);\n\n  els.promptForm.addEventListener('submit', (event) => {\n    event.preventDefault();\n    sendPrompt();\n  });\n\n  els.promptInput.addEventListener('input', () => {\n    state.promptEdited = true;\n  });\n\n  els.promptInput.addEventListener('keydown', (event) => {\n    if (event.key === 'Enter' && !event.shiftKey) {\n      event.preventDefault();\n      els.sendButton.click();\n    }\n  });\n\n  els.uploadToggle.addEventListener('click', () => {\n    if (state.menuOpen) {\n      closeMenu(false);\n    } else {\n      openMenu();\n    }\n  });\n\n  els.uploadMenu.addEventListener('click', (event) => {\n    const action = event.target.closest('button[data-action]');\n    if (action) {\n      // The button is replaced below, so stop the outside-click handler from closing the menu.\n      event.stopPropagation();\n      state.menuView = 'pick';\n      renderMenu();\n      const first = els.uploadMenu.querySelector('button:not(:disabled)');\n      if (first) {\n        first.focus();\n      }\n      return;\n    }\n    const button = event.target.closest('button[data-name]');\n    if (button && !button.disabled) {\n      uploadImage(button.dataset.name);\n    }\n  });\n\n  els.modeButtons.forEach((button) => {\n    button.addEventListener('click', () => setMode(button.dataset.mode, true));\n  });\n\n  els.uploadMenu.addEventListener('keydown', (event) => {\n    if (event.key === 'ArrowDown') {\n      event.preventDefault();\n      moveMenuFocus(1);\n    } else if (event.key === 'ArrowUp') {\n      event.preventDefault();\n      moveMenuFocus(-1);\n    }\n  });\n\n  els.fileList.addEventListener('click', (event) => {\n    const button = event.target.closest('button[data-file]');\n    if (button) {\n      removeImage(button.dataset.file);\n    }\n  });\n\n  document.addEventListener('keydown', (event) => {\n    if (event.key === 'Escape' && state.menuOpen) {\n      closeMenu(true);\n    }\n  });\n\n  document.addEventListener('click', (event) => {\n    if (state.menuOpen && !event.target.closest('.upload-area')) {\n      closeMenu(false);\n    }\n  });\n}\n\n/* ------------------------------------------------------------------ */\n/* Start                                                              */\n/* ------------------------------------------------------------------ */\n\nfunction applyStrings() {\n  document.querySelectorAll('[data-string]').forEach((el) => {\n    setRichText(el, STRINGS[el.dataset.string]);\n  });\n  document.querySelectorAll('[data-string-list]').forEach((list) => {\n    STRINGS[list.dataset.stringList].forEach((entry) => {\n      const item = document.createElement('li');\n      const text = typeof entry === 'string' ? entry : entry.text;\n      setRichText(item, text);\n      if (typeof entry !== 'string' && entry.example) {\n        const example = document.createElement('em');\n        example.className = 'example-line';\n        example.textContent = entry.example;\n        item.appendChild(example);\n      }\n      list.appendChild(item);\n    });\n  });\n  document.querySelectorAll('[data-aria-string]').forEach((el) => {\n    el.setAttribute('aria-label', STRINGS[el.dataset.ariaString]);\n  });\n  document.querySelectorAll('[data-alt-string]').forEach((img) => {\n    img.setAttribute('alt', STRINGS[img.dataset.altString]);\n  });\n  document.querySelectorAll('[data-icon]').forEach((slot) => {\n    slot.replaceWith(createIcon(slot.dataset.icon));\n  });\n  els.promptInput.setAttribute('placeholder', STRINGS.promptPlaceholder);\n}\n\nfunction init() {\n  els.announcer = document.getElementById('announcer');\n  els.activity = document.getElementById('screen-activity');\n  els.modeButtons = Array.from(document.querySelectorAll('.mode-button'));\n  els.finishButton = document.getElementById('finish-button');\n  els.fileList = document.getElementById('file-list');\n  els.uploadToggle = document.getElementById('upload-toggle');\n  els.uploadMenu = document.getElementById('upload-menu');\n  els.promptForm = document.getElementById('prompt-form');\n  els.promptInput = document.getElementById('prompt-input');\n  els.sendButton = document.getElementById('send-button');\n  els.statusNote = document.getElementById('status-note');\n  els.previewDescription = document.getElementById('preview-description');\n  els.codeContents = Array.from(document.querySelectorAll('.code-content'));\n  els.previewCards = Array.from(document.querySelectorAll('.preview-card'));\n\n  if (typeof document.createElement('template').content === 'undefined') {\n    throw new Error('Templates are not supported');\n  }\n\n  applyStrings();\n  setMode('preview', false);\n  renderFiles();\n  renderMenu();\n  update();\n  bindEvents();\n}\n\nfunction showLoadError() {\n  const banner = document.getElementById('error-banner');\n  if (banner) {\n    banner.textContent = STRINGS.loadError;\n    banner.hidden = false;\n  }\n}\n\nfunction start() {\n  try {\n    init();\n  } catch (error) {\n    showLoadError();\n  }\n}\n\nif (document.readyState === 'loading') {\n  document.addEventListener('DOMContentLoaded', start);\n} else {\n  start();\n}\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Show your picture</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <div id=\"error-banner\" class=\"error-banner\" role=\"alert\" hidden></div>\n  <noscript>\n    <p class=\"error-banner\">This activity needs JavaScript. Turn it on and reload the page.</p>\n  </noscript>\n  <div id=\"announcer\" class=\"visually-hidden\" aria-live=\"polite\"></div>\n\n  <main class=\"app\">\n\n    <!-- Intro -->\n    <section id=\"screen-intro\" class=\"screen card\" aria-labelledby=\"intro-title\">\n      <span class=\"tag tag-brand\" data-string=\"practiceTag\"></span>\n      <h1 id=\"intro-title\" class=\"screen-title\" tabindex=\"-1\" data-string=\"introTitle\"></h1>\n      <p data-string=\"introDefinition\"></p>\n      <p data-string=\"introPurpose\"></p>\n      <ol class=\"steps\" data-string-list=\"introSteps\"></ol>\n      <button type=\"button\" id=\"start-button\" class=\"button button-primary button-large\" data-string=\"startButton\"></button>\n    </section>\n\n    <!-- Activity -->\n    <section id=\"screen-activity\" class=\"screen\" aria-labelledby=\"activity-title\" hidden>\n      <div class=\"instruction-box\">\n        <div class=\"instruction-copy\">\n          <div class=\"instruction-head\">\n            <span class=\"tag tag-brand\" data-string=\"practiceTag\"></span>\n            <h1 id=\"activity-title\" class=\"screen-title screen-title-small\" tabindex=\"-1\" data-string=\"activityTitle\"></h1>\n          </div>\n          <ol class=\"instruction-steps\" data-string-list=\"activitySteps\"></ol>\n        </div>\n        <div class=\"instruction-actions\">\n          <button type=\"button\" id=\"reset-button\" class=\"button button-text button-small\" data-string=\"resetButton\"></button>\n          <button type=\"button\" id=\"finish-button\" class=\"button button-primary\" data-string=\"finishButton\" disabled></button>\n        </div>\n      </div>\n\n      <div id=\"status-note\" class=\"status-note\" data-status=\"info\"></div>\n\n      <div class=\"mode-bar\" role=\"group\" data-aria-string=\"modeBarAria\">\n        <button type=\"button\" class=\"mode-button\" data-mode=\"code\" aria-pressed=\"false\">\n          <span data-icon=\"code\"></span><span data-string=\"modeCode\"></span>\n        </button>\n        <button type=\"button\" class=\"mode-button\" data-mode=\"preview\" aria-pressed=\"true\">\n          <span data-icon=\"eye\"></span><span data-string=\"modePreview\"></span>\n        </button>\n        <button type=\"button\" class=\"mode-button\" data-mode=\"split\" aria-pressed=\"false\">\n          <span data-icon=\"split\"></span><span data-string=\"modeSplit\"></span>\n        </button>\n      </div>\n\n      <div class=\"workspace\">\n        <div class=\"side-column\">\n          <section class=\"panel files-panel\" aria-labelledby=\"files-title\">\n            <div class=\"panel-head\">\n              <h2 id=\"files-title\" class=\"panel-title\" data-string=\"filesTitle\"></h2>\n              <div class=\"upload-area\">\n                <button type=\"button\" id=\"upload-toggle\" class=\"button button-outlined button-icon\" data-aria-string=\"uploadAria\" aria-expanded=\"false\" aria-controls=\"upload-menu\">\n                  <span data-icon=\"plus\"></span>\n                </button>\n                <ul id=\"upload-menu\" class=\"upload-menu\" hidden></ul>\n              </div>\n            </div>\n            <ul id=\"file-list\" class=\"file-list\"></ul>\n          </section>\n\n          <section class=\"panel tutor-panel\" aria-labelledby=\"tutor-title\">\n            <h2 id=\"tutor-title\" class=\"panel-title\" data-string=\"tutorTitle\"></h2>\n            <form id=\"prompt-form\" class=\"prompt-form\">\n              <label for=\"prompt-input\" class=\"visually-hidden\" data-string=\"promptLabel\"></label>\n              <textarea id=\"prompt-input\" class=\"prompt-input\" rows=\"2\" autocomplete=\"off\" autocapitalize=\"none\" autocorrect=\"off\" spellcheck=\"false\"></textarea>\n              <button type=\"submit\" id=\"send-button\" class=\"button button-primary button-full\" data-string=\"sendButton\"></button>\n            </form>\n          </section>\n        </div>\n\n        <section class=\"code-box\" aria-labelledby=\"code-title\">\n          <h2 id=\"code-title\" class=\"code-tab\">\n            <span data-icon=\"file\"></span>\n            <span>index.html</span>\n          </h2>\n          <div class=\"code-lines\">\n            <div class=\"code-line\"><span class=\"line-number\" aria-hidden=\"true\">19</span><code>&lt;div class=\"photo-card\"&gt;</code></div>\n            <div class=\"code-line\" data-card=\"0\"><span class=\"line-number\" aria-hidden=\"true\">20</span><code class=\"code-content\"></code></div>\n            <div class=\"code-line\"><span class=\"line-number\" aria-hidden=\"true\">21</span><code>&lt;/div&gt;</code></div>\n            <div class=\"code-line\"><span class=\"line-number\" aria-hidden=\"true\">22</span><code>&lt;div class=\"photo-card\"&gt;</code></div>\n            <div class=\"code-line\" data-card=\"1\"><span class=\"line-number\" aria-hidden=\"true\">23</span><code class=\"code-content\"></code></div>\n            <div class=\"code-line\"><span class=\"line-number\" aria-hidden=\"true\">24</span><code>&lt;/div&gt;</code></div>\n          </div>\n        </section>\n\n          <section class=\"preview\" aria-labelledby=\"preview-title\">\n            <h2 id=\"preview-title\" class=\"preview-bar\" data-string=\"previewTitle\"></h2>\n            <p id=\"preview-description\" class=\"visually-hidden\"></p>\n            <div class=\"preview-page\" aria-hidden=\"true\">\n              <p class=\"preview-heading\">Photo Collection</p>\n              <div class=\"preview-cards\">\n                <div class=\"preview-card\" data-card=\"0\" data-state=\"placeholder\"></div>\n                <div class=\"preview-card\" data-card=\"1\" data-state=\"placeholder\"></div>\n              </div>\n            </div>\n          </section>\n      </div>\n    </section>\n\n    <!-- Takeaway -->\n    <section id=\"screen-takeaway\" class=\"screen card card-wide\" aria-labelledby=\"takeaway-title\" hidden>\n      <div class=\"takeaway-copy\">\n        <h1 id=\"takeaway-title\" class=\"screen-title\" tabindex=\"-1\" data-string=\"takeawayTitle\"></h1>\n        <p data-string=\"takeawayText\"></p>\n        <ol class=\"steps\" data-string-list=\"takeawaySteps\"></ol>\n        <p class=\"takeaway-next\" data-string=\"takeawayNext\"></p>\n      </div>\n      <div class=\"workspace-figure\">\n        <img class=\"workspace-image\" src=\"workspace.png\" data-alt-string=\"workspaceAlt\" alt=\"\">\n        <span class=\"callout callout-plus\" aria-hidden=\"true\"><span class=\"callout-number\">1</span></span>\n        <span class=\"callout callout-code\" aria-hidden=\"true\"><span class=\"callout-number\">2</span></span>\n      </div>\n    </section>\n\n  </main>\n\n  <!-- Sample pictures. They are drawn here so the widget needs no image files. -->\n  <template id=\"art-sunset\">\n    <svg viewBox=\"0 0 360 90\" preserveAspectRatio=\"xMidYMid slice\" xmlns=\"http://www.w3.org/2000/svg\">\n      <rect class=\"art-sunset-sky\" width=\"360\" height=\"90\"/>\n      <circle class=\"art-sunset-sun\" cx=\"240\" cy=\"52\" r=\"24\"/>\n      <path class=\"art-sunset-hill-back\" d=\"M0 90V58C40 34 90 36 140 56S250 62 360 44V90Z\"/>\n      <path class=\"art-sunset-hill-front\" d=\"M0 90V72C60 56 120 60 190 74S300 76 360 64V90Z\"/>\n    </svg>\n  </template>\n\n  <template id=\"art-garden\">\n    <svg viewBox=\"0 0 360 90\" preserveAspectRatio=\"xMidYMid slice\" xmlns=\"http://www.w3.org/2000/svg\">\n      <rect class=\"art-garden-sky\" width=\"360\" height=\"90\"/>\n      <rect class=\"art-garden-soil\" y=\"74\" width=\"360\" height=\"16\"/>\n      <rect class=\"art-garden-stem\" x=\"177\" y=\"38\" width=\"6\" height=\"40\"/>\n      <ellipse class=\"art-garden-leaf\" cx=\"164\" cy=\"62\" rx=\"12\" ry=\"5\" transform=\"rotate(-25 164 62)\"/>\n      <ellipse class=\"art-garden-leaf\" cx=\"196\" cy=\"58\" rx=\"12\" ry=\"5\" transform=\"rotate(25 196 58)\"/>\n      <g class=\"art-garden-petals\">\n        <circle cx=\"193\" cy=\"32\" r=\"9\"/>\n        <circle cx=\"184\" cy=\"44.4\" r=\"9\"/>\n        <circle cx=\"169.5\" cy=\"39.6\" r=\"9\"/>\n        <circle cx=\"169.5\" cy=\"24.4\" r=\"9\"/>\n        <circle cx=\"184\" cy=\"19.6\" r=\"9\"/>\n      </g>\n      <circle class=\"art-garden-center\" cx=\"180\" cy=\"32\" r=\"8\"/>\n    </svg>\n  </template>\n\n  <template id=\"art-badge\">\n    <svg viewBox=\"0 0 360 90\" preserveAspectRatio=\"xMidYMid slice\" xmlns=\"http://www.w3.org/2000/svg\">\n      <rect class=\"art-badge-bg\" width=\"360\" height=\"90\"/>\n      <circle class=\"art-badge-disc\" cx=\"180\" cy=\"45\" r=\"34\"/>\n      <path class=\"art-badge-spark\" d=\"M180 20Q184 41 205 45Q184 49 180 70Q176 49 155 45Q176 41 180 20Z\"/>\n    </svg>\n  </template>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": "/* ==================================================================\n   CADS design tokens (light theme)\n   Copied from the CADS runtime (manifest 0.1.0). Only the tokens this\n   widget uses are included. Hex values live in this block only.\n   ================================================================== */\n:root {\n  /* Primitives */\n  --brand-orange-30: #ffa868;\n  --brand-orange-5: #ffe3ce;\n  --brand-orange-50: #f46800;\n  --brand-pink-50: #e11970;\n  --brand-purple-10: #cac6f5;\n  --brand-purple-20: #aca8ea;\n  --brand-purple-5: #e4e2f8;\n  --brand-purple-50: #4c42cf;\n  --brand-purple-80: #2b1e9f;\n  --neutral-base-black: #121212;\n  --neutral-base-white: #ffffff;\n  --neutral-gray-10: #e1e3e6;\n  --neutral-gray-20: #d3d6da;\n  --neutral-gray-40: #9ea5ad;\n  --neutral-gray-5: #f1f2f4;\n  --neutral-gray-50: #87909a;\n  --neutral-gray-80: #4b5258;\n  --sentiment-error-5: #ffdada;\n  --sentiment-error-50: #eb1414;\n  --sentiment-information-5: #d5efff;\n  --sentiment-information-50: #0099f3;\n  --sentiment-success-5: #d8ffdc;\n  --sentiment-success-50: #34bd43;\n  --sentiment-success-70: #258830;\n  --sentiment-warning-5: #fff5da;\n  --sentiment-warning-50: #f5c000;\n\n  /* Semantic tokens */\n  --background-accent-orange-light: var(--brand-orange-5);\n  --background-accent-orange-mid: var(--brand-orange-30);\n  --background-accent-orange-primary: var(--brand-orange-50);\n  --background-accent-pink-primary: var(--brand-pink-50);\n  --background-brand-light: var(--brand-purple-5);\n  --background-brand-mid: var(--brand-purple-20);\n  --background-brand-primary: var(--brand-purple-50);\n  --background-brand-strong: var(--brand-purple-80);\n  --background-disabled-neutral: var(--neutral-gray-20);\n  --background-error-light: var(--sentiment-error-5);\n  --background-info-light: var(--sentiment-information-5);\n  --background-neutral-primary: var(--neutral-base-white);\n  --background-neutral-secondary: var(--neutral-gray-5);\n  --background-neutral-senary: var(--neutral-gray-50);\n  --background-neutral-tertiary: var(--neutral-gray-10);\n  --background-neutral-white-fixed: var(--neutral-base-white);\n  --background-success-light: var(--sentiment-success-5);\n  --background-success-primary: var(--sentiment-success-70);\n  --background-warning-light: var(--sentiment-warning-5);\n  --border-brand-light: var(--brand-purple-10);\n  --border-brand-primary: var(--brand-purple-50);\n  --border-disabled-neutral: var(--neutral-gray-20);\n  --border-error-primary: var(--sentiment-error-50);\n  --border-focused-primary: var(--brand-purple-50);\n  --border-info-primary: var(--sentiment-information-50);\n  --border-neutral-primary: var(--neutral-gray-20);\n  --border-neutral-secondary: var(--neutral-gray-40);\n  --border-neutral-solid: var(--neutral-base-black);\n  --border-success-primary: var(--sentiment-success-50);\n  --border-warning-primary: var(--sentiment-warning-50);\n  --font-family-heading: \"Space Grotesk\", \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-family-main: \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-family-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\n  --font-weight-bold: 700;\n  --font-weight-semi-bold: 600;\n  --shadow-md: 0 10px 15px -3px rgb(0 0 0 / 10%), 0 4px 6px -4px rgb(0 0 0 / 10%);\n  --shape-lg: .625rem;\n  --shape-md: .5rem;\n  --shape-round: 62.4375rem;\n  --shape-sm: .375rem;\n  --spacing-p-s: 1.5rem;\n  --text-body-lg: 1.125rem;\n  --text-body-md: 1rem;\n  --text-disabled-neutral-inverse: var(--neutral-base-white);\n  --text-heading-md: 1.5rem;\n  --text-heading-sm: 1.375rem;\n  --text-heading-xs: 1.25rem;\n  --text-neutral-primary: var(--neutral-base-black);\n  --text-neutral-tertiary: var(--neutral-gray-80);\n  --text-neutral-white-fixed: var(--neutral-base-white);\n}\n\n/* ==================================================================\n   Component styles\n\n   CADS (used as published): the design tokens above, copied from the\n   CADS runtime light theme. Every color, font, size, radius and shadow\n   below comes from those variables.\n\n   Rebuilt from the CADS manifest (the runtime is React, Web Lab has no\n   build step): Button (contained primary, outlined, text, icon-only),\n   Tag (brand, info, success, warning), Alert-style status note, and the\n   file list and menu rows.\n\n   Approximated: button hover colors, the code box, and the page preview.\n   The focus ring follows the CADS checkbox recipe (2px gap, then a 2px\n   ring in the primary focus border). Geist and Space Grotesk are named by the CADS\n   font tokens but are not loaded, so the fallback sans-serif shows.\n   Icons are inline SVG because the CADS icon font cannot be bundled.\n   ================================================================== */\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nbody {\n  margin: 0;\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-md);\n  line-height: 1.5;\n}\n\nh1,\nh2,\np,\nul,\nol {\n  margin: 0;\n}\n\ncode {\n  font-family: var(--font-family-mono);\n}\n\n.visually-hidden {\n  position: absolute;\n  inline-size: 1px;\n  block-size: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.app {\n  max-inline-size: 75rem;\n  margin-inline: auto;\n  padding: 0.75rem;\n}\n\n.error-banner {\n  margin: 0.75rem;\n  padding: 0.75rem 1rem;\n  border: 1px solid var(--border-error-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-error-light);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.icon {\n  flex: none;\n  inline-size: 1.25rem;\n  block-size: 1.25rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* ---------- Headings ---------- */\n\n.screen-title {\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-md);\n  font-weight: var(--font-weight-bold);\n  line-height: 1.2;\n}\n\n.screen-title-small {\n  font-size: var(--text-heading-xs);\n}\n\n.screen-title:focus {\n  outline: none;\n}\n\n/* ---------- Tag ---------- */\n\n.tag {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.375rem;\n  padding: 0.125rem 0.625rem;\n  border: 1px solid transparent;\n  border-radius: var(--shape-round);\n  font-size: var(--text-body-md);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: 1.5;\n  white-space: nowrap;\n}\n\n.tag-brand {\n  border-color: var(--border-brand-primary);\n  background: var(--background-brand-primary);\n  color: var(--text-neutral-white-fixed);\n}\n\n.tag-info {\n  border-color: var(--border-info-primary);\n  background: var(--background-info-light);\n  color: var(--text-neutral-primary);\n}\n\n.tag-success {\n  border-color: var(--border-success-primary);\n  background: var(--background-success-light);\n  color: var(--text-neutral-primary);\n}\n\n.tag-warning {\n  border-color: var(--border-warning-primary);\n  background: var(--background-warning-light);\n  color: var(--text-neutral-primary);\n}\n\n/* ---------- Button ---------- */\n\n.button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.5rem;\n  min-block-size: 2.5rem;\n  padding-inline: 1rem;\n  border: 1px solid transparent;\n  border-radius: var(--shape-sm);\n  background: transparent;\n  color: var(--text-neutral-primary);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  line-height: 1.25;\n  cursor: pointer;\n}\n\n.button:focus-visible,\n.prompt-input:focus-visible,\n.menu-item:focus-visible {\n  outline: 2px solid transparent;\n  box-shadow:\n    0 0 0 2px var(--background-neutral-primary),\n    0 0 0 4px var(--border-focused-primary);\n}\n\n.button-primary {\n  border-color: var(--border-brand-primary);\n  background: var(--background-brand-primary);\n  color: var(--text-neutral-white-fixed);\n}\n\n.button-primary:hover:not(:disabled) {\n  background: var(--background-brand-strong);\n}\n\n.button-primary:disabled {\n  border-color: var(--border-disabled-neutral);\n  background: var(--background-disabled-neutral);\n  color: var(--text-disabled-neutral-inverse);\n  cursor: not-allowed;\n}\n\n.button-outlined {\n  border-color: var(--border-neutral-solid);\n  background: var(--background-neutral-primary);\n}\n\n.button-outlined:hover:not(:disabled) {\n  background: var(--background-brand-light);\n}\n\n.button-text:hover:not(:disabled) {\n  background: var(--background-brand-light);\n}\n\n.button-large {\n  min-block-size: 3rem;\n  padding-inline: 1.5rem;\n}\n\n.button-small {\n  min-block-size: 2rem;\n  padding-inline: 0.75rem;\n}\n\n.button-icon {\n  inline-size: 2rem;\n  min-inline-size: 2rem;\n  padding-inline: 0;\n}\n\n.upload-area .button-icon {\n  inline-size: 2.5rem;\n  min-inline-size: 2.5rem;\n}\n\n.button-full {\n  inline-size: 100%;\n}\n\n/* ---------- Intro and takeaway cards ---------- */\n\n.card {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 0.75rem;\n  max-inline-size: 40rem;\n  margin: 0.5rem auto 0;\n  padding: var(--spacing-p-s);\n  border: 1px solid var(--border-brand-light);\n  border-radius: var(--shape-lg);\n  background: var(--background-brand-light);\n}\n\n.card .steps {\n  padding-inline-start: 1.5rem;\n}\n\n.card .steps li + li {\n  margin-block-start: 0.25rem;\n}\n\n.card code,\n.instruction-steps code {\n  padding: 0.0625rem 0.375rem;\n  border: 1px solid var(--border-brand-light);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-primary);\n}\n\n.example-line {\n  display: block;\n  margin-block-start: 0.25rem;\n}\n\n.takeaway-next {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.card-wide {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 28rem);\n  align-items: center;\n  gap: 1rem 1.5rem;\n  max-inline-size: 54rem;\n}\n\n@media (max-width: 48rem) {\n  .card-wide {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n\n.takeaway-copy {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 0.75rem;\n}\n\n.workspace-figure {\n  position: relative;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n}\n\n.workspace-image {\n  display: block;\n  inline-size: 100%;\n  block-size: auto;\n  border-radius: var(--shape-md);\n}\n\n.callout {\n  position: absolute;\n  border: 3px solid var(--border-brand-primary);\n}\n\n.callout-plus {\n  inset-inline-start: 12.6%;\n  inset-block-start: 7.4%;\n  inline-size: 4.2%;\n  aspect-ratio: 1;\n  border-radius: 50%;\n}\n\n.callout-plus .callout-number {\n  inset-block-start: auto;\n  inset-block-end: -1.25rem;\n  inset-inline-start: auto;\n  inset-inline-end: -1.25rem;\n}\n\n.callout-code {\n  inset-inline-start: 31.6%;\n  inset-block-start: 60.4%;\n  inline-size: 40%;\n  block-size: 18.6%;\n  border-radius: var(--shape-sm);\n}\n\n.callout-code .callout-number {\n  inset-inline-start: auto;\n  inset-inline-end: -1rem;\n}\n\n.callout-number {\n  position: absolute;\n  inset-block-start: -1rem;\n  inset-inline-start: -1rem;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  inline-size: 1.5rem;\n  block-size: 1.5rem;\n  border-radius: 50%;\n  background: var(--background-brand-primary);\n  color: var(--text-neutral-white-fixed);\n  font-weight: var(--font-weight-bold);\n  line-height: 1;\n}\n\n/* ---------- Instruction box ---------- */\n\n.instruction-box {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.75rem 1rem;\n  padding: 0.75rem 1rem;\n  border: 1px solid var(--border-brand-light);\n  border-radius: var(--shape-lg);\n  background: var(--background-brand-light);\n}\n\n.instruction-copy {\n  flex: 1 1 20rem;\n  min-inline-size: 0;\n}\n\n.instruction-actions {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.instruction-head {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n/* ---------- Workspace ---------- */\n\n.workspace {\n  display: grid;\n  grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);\n  gap: 0.75rem;\n  align-items: start;\n  margin-block-start: 0.75rem;\n}\n\n@media (max-width: 48rem) {\n  .workspace {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n\n.panel {\n  padding: 0.75rem;\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-lg);\n  background: var(--background-neutral-primary);\n}\n\n.panel-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.5rem;\n  margin-block-end: 0.5rem;\n}\n\n.panel-title {\n  font-family: var(--font-family-heading);\n  font-size: var(--text-body-lg);\n  font-weight: var(--font-weight-bold);\n}\n\n/* ---------- Side column and tutor ---------- */\n\n.side-column {\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n  min-inline-size: 0;\n}\n\n.tutor-panel,\n.prompt-form {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n}\n\n.prompt-input {\n  inline-size: 100%;\n  min-block-size: 4.25rem;\n  padding: 0.5rem 0.75rem;\n  border: 2px solid var(--border-neutral-solid);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font: inherit;\n  line-height: 1.5;\n  resize: vertical;\n}\n\n.prompt-input::placeholder {\n  color: var(--text-neutral-tertiary);\n}\n\n/* ---------- Project files ---------- */\n\n.file-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n  padding: 0;\n  list-style: none;\n}\n\n.file-row {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  min-block-size: 2.25rem;\n  padding: 0.0625rem 0.375rem 0.0625rem 0.5rem;\n  border: 2px solid transparent;\n  border-radius: var(--shape-sm);\n}\n\n.file-row[data-match=\"found\"] {\n  border-color: var(--border-success-primary);\n  background: var(--background-success-light);\n}\n\n.file-row[data-match=\"close\"] {\n  border-color: var(--border-warning-primary);\n  background: var(--background-warning-light);\n}\n\n.file-row.is-new {\n  animation: pop-in 0.3s ease-out;\n}\n\n.file-icons {\n  display: flex;\n  flex: none;\n}\n\n.mark-icon {\n  display: none;\n}\n\n.file-row[data-match=\"found\"] .file-icon,\n.file-row[data-match=\"close\"] .file-icon {\n  display: none;\n}\n\n.file-row[data-match=\"found\"] .mark-found,\n.file-row[data-match=\"close\"] .mark-close {\n  display: block;\n}\n\n.file-name {\n  flex: 1;\n  min-inline-size: 0;\n  font-family: var(--font-family-mono);\n  overflow-wrap: anywhere;\n}\n\n/* ---------- Upload menu ---------- */\n\n.upload-area {\n  position: relative;\n}\n\n.upload-menu {\n  position: absolute;\n  inset-inline-end: 0;\n  inset-block-start: calc(100% + 0.25rem);\n  inline-size: 17rem;\n  max-inline-size: calc(100vw - 2rem);\n  z-index: 5;\n  padding: 0.25rem;\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n  box-shadow: var(--shadow-md);\n  list-style: none;\n}\n\n.menu-item {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  inline-size: 100%;\n  min-block-size: 2.75rem;\n  padding: 0.25rem 0.5rem;\n  border: 0;\n  border-radius: var(--shape-sm);\n  background: transparent;\n  color: var(--text-neutral-primary);\n  font: inherit;\n  text-align: start;\n  cursor: pointer;\n}\n\n.menu-item:hover:not(:disabled) {\n  background: var(--background-brand-light);\n}\n\n.menu-item:disabled {\n  color: var(--text-neutral-primary);\n  cursor: default;\n}\n\n.menu-thumb {\n  flex: none;\n  inline-size: 3rem;\n  block-size: 1.75rem;\n  overflow: hidden;\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-sm);\n}\n\n.menu-thumb svg {\n  display: block;\n  inline-size: 100%;\n  block-size: 100%;\n}\n\n.menu-name {\n  flex: 1;\n  min-inline-size: 0;\n  font-family: var(--font-family-mono);\n  overflow-wrap: anywhere;\n}\n\n.menu-done {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.25rem;\n  font-weight: var(--font-weight-semi-bold);\n}\n\n/* ---------- Code, note and preview ---------- */\n\n\n.code-box {\n  overflow: hidden;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-lg);\n  background: var(--background-neutral-secondary);\n}\n\n.code-tab {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  margin: 0;\n  padding: 0.25rem 0.75rem;\n  border-block-end: 1px solid var(--border-neutral-primary);\n  background: var(--background-neutral-tertiary);\n  font-family: var(--font-family-mono);\n  font-size: var(--text-body-md);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.code-lines {\n  padding: 0.25rem 0.75rem;\n}\n\n.code-line {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  min-block-size: 1.75rem;\n  font-size: var(--text-body-md);\n}\n\n.code-line code {\n  flex: 1 1 0;\n  min-inline-size: 0;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n}\n\n.code-line.is-new {\n  animation: pop-in 0.3s ease-out;\n}\n\n.code-value {\n  padding: 0 0.25rem;\n  border-radius: var(--shape-sm);\n  background: var(--background-brand-light);\n  font-weight: var(--font-weight-bold);\n}\n\n.line-number {\n  flex: none;\n  inline-size: 2.5ch;\n  margin-inline-end: 1rem;\n  color: var(--text-neutral-tertiary);\n  font-family: var(--font-family-mono);\n  text-align: end;\n  user-select: none;\n}\n\n.status-note {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.25rem 0.75rem;\n  min-block-size: 3.5rem;\n  padding: 0.5rem 0.75rem;\n  border: 1px solid var(--border-info-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-info-light);\n}\n\n.status-note[data-status=\"success\"] {\n  border-color: var(--border-success-primary);\n  background: var(--background-success-light);\n}\n\n.status-note[data-status=\"warning\"] {\n  border-color: var(--border-warning-primary);\n  background: var(--background-warning-light);\n}\n\n.status-text {\n  flex: 1 1 12rem;\n  min-inline-size: 0;\n}\n\n.status-text code {\n  padding: 0 0.25rem;\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-primary);\n}\n\n.preview {\n  overflow: hidden;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-lg);\n  background: var(--background-neutral-primary);\n}\n\n.preview-bar {\n  margin: 0;\n  padding: 0.25rem 0.75rem;\n  border-block-end: 1px solid var(--border-neutral-primary);\n  background: var(--background-neutral-tertiary);\n  font-size: var(--text-body-md);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.preview-page {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n  padding: 0.5rem 0.75rem 0.75rem;\n}\n\n.preview-heading {\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-sm);\n  font-weight: var(--font-weight-bold);\n  line-height: 1.2;\n}\n\n.preview-cards {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 0.5rem;\n}\n\n.preview-card {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.5rem;\n  min-inline-size: 0;\n  block-size: 6.5rem;\n  padding: 0.5rem;\n  overflow: hidden;\n  border-radius: var(--shape-md);\n  text-align: center;\n}\n\n.preview-card[data-state=\"placeholder\"] {\n  border: 2px dashed var(--border-neutral-secondary);\n  background: var(--background-neutral-secondary);\n}\n\n.preview-card[data-state=\"broken\"] {\n  border: 2px solid var(--border-warning-primary);\n  background: var(--background-warning-light);\n}\n\n.preview-card[data-state=\"shown\"] {\n  padding: 0;\n}\n\n.preview-card[data-state=\"shown\"] svg {\n  display: block;\n  inline-size: 100%;\n  block-size: 100%;\n}\n\n.preview-card.is-new {\n  animation: pop-in 0.3s ease-out;\n}\n\n/* ---------- Sample pictures ---------- */\n\n.art-sunset-sky {\n  fill: var(--background-accent-orange-light);\n}\n\n.art-sunset-sun {\n  fill: var(--background-accent-orange-primary);\n}\n\n.art-sunset-hill-back {\n  fill: var(--background-brand-mid);\n}\n\n.art-sunset-hill-front {\n  fill: var(--background-brand-primary);\n}\n\n.art-garden-sky {\n  fill: var(--background-info-light);\n}\n\n.art-garden-soil {\n  fill: var(--background-neutral-senary);\n}\n\n.art-garden-stem,\n.art-garden-leaf {\n  fill: var(--background-success-primary);\n}\n\n.art-garden-petals circle {\n  fill: var(--background-accent-pink-primary);\n}\n\n.art-garden-center {\n  fill: var(--background-accent-orange-mid);\n}\n\n.art-badge-bg {\n  fill: var(--background-brand-light);\n}\n\n.art-badge-disc {\n  fill: var(--background-brand-primary);\n}\n\n.art-badge-spark {\n  fill: var(--background-neutral-white-fixed);\n}\n\n/* ---------- Motion ---------- */\n\n@keyframes pop-in {\n  from {\n    opacity: 0;\n    transform: scale(0.97);\n  }\n\n  to {\n    opacity: 1;\n    transform: none;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  * {\n    animation: none !important;\n    transition: none !important;\n  }\n}\n\n.instruction-steps {\n  margin: 0.25rem 0 0;\n  padding-inline-start: 1.5rem;\n}\n\n.instruction-steps li + li {\n  margin-block-start: 0.125rem;\n}\n\n/* ---------- Workspace view (Code, Preview, Split View) ---------- */\n\n.mode-bar {\n  display: inline-flex;\n  align-self: flex-start;\n  overflow: hidden;\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n}\n\n.mode-button {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  min-block-size: 2.5rem;\n  padding: 0.25rem 1rem;\n  border: 0;\n  border-inline-end: 1px solid var(--border-neutral-primary);\n  background: transparent;\n  color: var(--text-neutral-primary);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n}\n\n.mode-button:last-child {\n  border-inline-end: 0;\n}\n\n.mode-button:hover {\n  background: var(--background-brand-light);\n}\n\n.mode-button[aria-pressed=\"true\"] {\n  background: var(--background-brand-primary);\n  color: var(--text-neutral-white-fixed);\n}\n\n.mode-button .icon {\n  inline-size: 1.25rem;\n  block-size: 1.25rem;\n}\n\n#screen-activity[data-mode=\"preview\"] .files-panel,\n#screen-activity[data-mode=\"preview\"] .code-box,\n#screen-activity[data-mode=\"code\"] .preview,\n#screen-activity[data-mode=\"split\"] .files-panel {\n  display: none;\n}\n\n.menu-heading {\n  padding: 0.5rem 0.75rem 0.25rem;\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.menu-item:disabled {\n  opacity: 0.55;\n  cursor: default;\n}\n\n.menu-item > .icon {\n  inline-size: 1.25rem;\n  block-size: 1.25rem;\n}\n\n.mode-bar {\n  margin-block-start: 0.75rem;\n}\n\n.status-note {\n  margin-block-start: 0.5rem;\n}\n\n.code-box,\n.preview {\n  min-inline-size: 0;\n}\n\n@media (min-width: 48rem) {\n  #screen-activity[data-mode=\"split\"] .workspace {\n    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr) minmax(0, 1fr);\n  }\n}\n",
