<Weblab2>
  <config><![CDATA[{
  "published": true,
  "game_id": 74,
  "created_at": "2026-11-03T04:23:50.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": "false",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>How to add an image to your website</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <link rel=\"stylesheet\" href=\"continue-arrow.css\">\n  <script src=\"continue-arrow.js\" defer></script>\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <svg class=\"sprite\" width=\"0\" height=\"0\" aria-hidden=\"true\" focusable=\"false\">\n    <defs>\n      <symbol id=\"icon-check\" viewBox=\"0 0 24 24\"><path class=\"icon-stroke\" d=\"M5 12.5l4.5 4.5L19 7.5\"/></symbol>\n      <symbol id=\"icon-cross\" viewBox=\"0 0 24 24\"><path class=\"icon-stroke\" d=\"M6 6l12 12M18 6L6 18\"/></symbol>\n      <symbol id=\"icon-pointer\" viewBox=\"0 0 24 24\"><path class=\"icon-fill\" d=\"M6 3.5l12 8.5-5.4 1.2 3.1 6-2.6 1.3-3.1-6.1L6 18z\"/></symbol>\n\n      <symbol id=\"photo-park\" viewBox=\"0 0 320 180\">\n        <rect class=\"art-sky\" width=\"320\" height=\"180\"/>\n        <circle class=\"art-sun\" cx=\"248\" cy=\"46\" r=\"20\"/>\n        <ellipse class=\"art-hill-back\" cx=\"90\" cy=\"170\" rx=\"190\" ry=\"70\"/>\n        <ellipse class=\"art-hill-front\" cx=\"260\" cy=\"190\" rx=\"200\" ry=\"70\"/>\n        <rect class=\"art-trunk\" x=\"86\" y=\"86\" width=\"12\" height=\"52\"/>\n        <circle class=\"art-leaves\" cx=\"92\" cy=\"72\" r=\"30\"/>\n        <rect class=\"art-bench\" x=\"170\" y=\"128\" width=\"62\" height=\"7\" rx=\"2\"/>\n        <rect class=\"art-bench\" x=\"176\" y=\"135\" width=\"6\" height=\"14\"/>\n        <rect class=\"art-bench\" x=\"220\" y=\"135\" width=\"6\" height=\"14\"/>\n      </symbol>\n\n      <symbol id=\"photo-city\" viewBox=\"0 0 320 180\">\n        <rect class=\"art-city-sky\" width=\"320\" height=\"180\"/>\n        <rect class=\"art-building-a\" x=\"30\" y=\"70\" width=\"50\" height=\"110\"/>\n        <rect class=\"art-building-b\" x=\"90\" y=\"40\" width=\"44\" height=\"140\"/>\n        <rect class=\"art-building-a\" x=\"144\" y=\"86\" width=\"58\" height=\"94\"/>\n        <rect class=\"art-building-b\" x=\"212\" y=\"56\" width=\"40\" height=\"124\"/>\n        <rect class=\"art-building-a\" x=\"260\" y=\"96\" width=\"44\" height=\"84\"/>\n      </symbol>\n    </defs>\n  </svg>\n\n  <div id=\"error-banner\" class=\"error-banner\" role=\"alert\" hidden></div>\n  <p id=\"announcer\" class=\"visually-hidden\" aria-live=\"polite\"></p>\n\n  <main class=\"app\" id=\"app\">\n\n    <!-- Intro -->\n    <section id=\"view-intro\" class=\"view view-intro\" aria-labelledby=\"intro-title\">\n      <span class=\"tag tag-brand\" data-text=\"practiceTag\"></span>\n      <h1 id=\"intro-title\" class=\"view-title\" data-text=\"introTitle\" tabindex=\"-1\"></h1>\n      <p class=\"lead\" data-text=\"introLead\"></p>\n      <ol class=\"intro-steps\" id=\"intro-steps\"></ol>\n      <button type=\"button\" class=\"btn btn-primary btn-large\" id=\"start-button\" data-text=\"startLabel\"></button>\n    </section>\n\n    <!-- Practice -->\n    <section id=\"view-practice\" class=\"view view-practice\" aria-labelledby=\"practice-heading\" hidden>\n      <header class=\"practice-head\">\n        <div class=\"head-row\">\n          <span class=\"tag tag-brand\" data-text=\"practiceTag\"></span>\n          <h1 id=\"practice-heading\" class=\"head-line\" data-text=\"practiceLine\" tabindex=\"-1\"></h1>\n        </div>\n        <div class=\"head-row head-controls\">\n          <ol class=\"rail\" id=\"rail\" aria-label=\"Steps\"></ol>\n          <div class=\"head-buttons\">\n            <button type=\"button\" class=\"btn btn-text\" id=\"back-button\" data-text=\"backLabel\"></button>\n            <button type=\"button\" class=\"btn btn-primary\" id=\"next-button\"></button>\n          </div>\n        </div>\n      </header>\n\n      <div class=\"stage\" id=\"stage\" data-step=\"1\">\n        <div class=\"step-column\">\n\n          <section class=\"step step-1\" aria-labelledby=\"step-title-1\">\n            <h2 id=\"step-title-1\" class=\"step-title\" data-text=\"step1Title\" tabindex=\"-1\"></h2>\n            <p class=\"step-text\" data-text=\"step1Text\"></p>\n          </section>\n\n          <section class=\"step step-2\" aria-labelledby=\"step-title-2\">\n            <h2 id=\"step-title-2\" class=\"step-title\" data-text=\"step2Title\" tabindex=\"-1\"></h2>\n            <p class=\"step-text\" data-text=\"step2Text\"></p>\n            <p class=\"action-hint\"><svg class=\"icon hint-icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#icon-pointer\"/></svg><span data-text=\"step2Hint\"></span></p>\n            <div class=\"choices\" id=\"choices-2\" role=\"group\" aria-labelledby=\"step-title-2\"></div>\n            <p class=\"feedback\" id=\"feedback-2\" hidden></p>\n          </section>\n\n          <section class=\"step step-3\" aria-labelledby=\"step-title-3\">\n            <h2 id=\"step-title-3\" class=\"step-title\" data-text=\"step3Title\" tabindex=\"-1\"></h2>\n            <ol class=\"how-list\" id=\"how-list\"></ol>\n          </section>\n\n          <section class=\"step step-4\" aria-labelledby=\"step-title-4\">\n            <h2 id=\"step-title-4\" class=\"step-title\" data-text=\"step4Title\" tabindex=\"-1\"></h2>\n            <p class=\"action-hint\"><svg class=\"icon hint-icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#icon-pointer\"/></svg><span data-text=\"step4Hint\"></span></p>\n            <div class=\"choices\" id=\"choices-4\" role=\"group\" aria-labelledby=\"step-title-4\"></div>\n            <p class=\"feedback\" id=\"feedback-4\" hidden></p>\n          </section>\n\n        </div>\n\n        <div class=\"visual-column\">\n\n          <!-- Steps 1 and 2: the folder on the computer -->\n          <figure class=\"vis vis-folder\" aria-labelledby=\"folder-caption\">\n            <div class=\"window\">\n              <div class=\"window-bar\"><span class=\"window-title\" data-text=\"folderTitle\"></span></div>\n              <div class=\"window-body\">\n                <div class=\"file-tile\" id=\"file-tile\" data-state=\"start\">\n                  <svg class=\"file-thumb\" viewBox=\"0 0 320 180\" role=\"img\" aria-label=\"\">\n                    <use href=\"#photo-park\"/>\n                  </svg>\n                  <span class=\"file-name\" id=\"file-name\"></span>\n                </div>\n              </div>\n            </div>\n            <div class=\"code-strip\" id=\"code-strip\">\n              <p class=\"code-label\" data-text=\"codeLabel\"></p>\n              <code class=\"code-line\">&lt;img src=\"<span id=\"code-name\" class=\"code-name\"></span>\"&gt;</code>\n            </div>\n            <figcaption id=\"folder-caption\" class=\"visually-hidden\"></figcaption>\n          </figure>\n\n          <!-- Step 3: the Code tab menu -->\n          <figure class=\"vis vis-upload\">\n            <img class=\"menu-shot\" id=\"menu-shot\" src=\"upload-menu.png\" width=\"534\" height=\"340\" alt=\"\">\n          </figure>\n\n          <!-- Step 4: the mini website -->\n          <figure class=\"vis vis-page\" aria-labelledby=\"page-description\">\n            <div class=\"mini-page\" id=\"mini-page\" data-result=\"none\" aria-hidden=\"true\">\n              <div class=\"mp-bar\"><span class=\"mp-bar-label\" data-text=\"pageBarLabel\"></span></div>\n              <div class=\"mp-body\">\n                <p class=\"mp-heading\" data-text=\"pageHeading\"></p>\n                <div class=\"mp-slot mp-slot-top\">\n                  <div class=\"mp-empty\" data-text=\"pageEmpty\"></div>\n                  <svg class=\"mp-photo mp-photo-park\" viewBox=\"0 0 320 180\"><use href=\"#photo-park\"/></svg>\n                  <svg class=\"mp-photo mp-photo-city\" viewBox=\"0 0 320 180\"><use href=\"#photo-city\"/></svg>\n                  <span class=\"mp-badge\" data-text=\"pageDecoyBadge\"></span>\n                </div>\n                <div class=\"mp-lines\"><span class=\"mp-line\"></span><span class=\"mp-line\"></span><span class=\"mp-line mp-line-short\"></span></div>\n                <span class=\"mp-button\" data-text=\"pageButton\"></span>\n                <div class=\"mp-broken\" data-text=\"pageBroken\"></div>\n              </div>\n            </div>\n            <figcaption id=\"page-description\" class=\"visually-hidden\"></figcaption>\n          </figure>\n\n        </div>\n      </div>\n    </section>\n\n    <!-- Takeaway -->\n    <section id=\"view-takeaway\" class=\"view view-takeaway\" aria-labelledby=\"takeaway-title\" hidden>\n      <div class=\"takeaway-text\">\n        <h1 id=\"takeaway-title\" class=\"view-title\" data-text=\"takeawayTitle\" tabindex=\"-1\"></h1>\n        <p class=\"takeaway-body\" data-text=\"takeawayBody\"></p>\n        <p class=\"recap-lead\" data-text=\"recapLead\"></p>\n        <ol class=\"recap\" id=\"recap\"></ol>\n        <p class=\"takeaway-last\"><strong data-text=\"takeawayLast\"></strong></p>\n      </div>\n      <img class=\"menu-shot menu-shot-small\" src=\"upload-menu.png\" width=\"534\" height=\"340\" alt=\"\" id=\"menu-shot-recap\">\n    </section>\n\n  </main>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "/* Add an image to your website. CADS tokens first, then component styles. */\n\n/* ==== CADS tokens (copied unchanged from the CADS runtime, manifest 0.1.0) ==== */\n:root{\n  --brand-purple-5: #e4e2f8;\n  --brand-purple-10: #cac6f5;\n  --brand-purple-20: #aca8ea;\n  --brand-purple-30: #928cef;\n  --brand-purple-40: #6f67d9;\n  --brand-purple-50: #4c42cf;\n  --brand-purple-60: #4238c4;\n  --brand-purple-70: #3228b7;\n  --brand-purple-80: #2b1e9f;\n  --brand-purple-90: #1d1590;\n  --brand-purple-95: #1f1976;\n  --brand-orange-5: #ffe3ce;\n  --brand-orange-10: #ffd2b3;\n  --brand-orange-20: #ffbd8a;\n  --brand-orange-30: #ffa868;\n  --brand-orange-40: #ff8b38;\n  --brand-orange-50: #f46800;\n  --brand-orange-60: #d15900;\n  --brand-orange-70: #b34800;\n  --brand-orange-80: #942f00;\n  --brand-orange-90: #701c00;\n  --brand-orange-95: #611d00;\n  --brand-pink-5: #fbdae8;\n  --brand-pink-10: #f3c3d8;\n  --brand-pink-20: #eea1c3;\n  --brand-pink-30: #f07fb0;\n  --brand-pink-40: #eb5895;\n  --brand-pink-50: #e11970;\n  --brand-pink-60: #ce035b;\n  --brand-pink-70: #b5004f;\n  --brand-pink-80: #a10448;\n  --brand-pink-90: #8d003d;\n  --brand-pink-95: #7d0c3d;\n  --neutral-base-black: #121212;\n  --neutral-base-true-black: #000000;\n  --neutral-base-white: #ffffff;\n  --neutral-black-alpha-5: #1212120d;\n  --neutral-black-alpha-10: #1212121a;\n  --neutral-black-alpha-20: #12121233;\n  --neutral-black-alpha-30: #1212124d;\n  --neutral-black-alpha-40: #12121266;\n  --neutral-black-alpha-50: #12121280;\n  --neutral-black-alpha-60: #12121299;\n  --neutral-black-alpha-70: #121212b2;\n  --neutral-black-alpha-80: #121212cc;\n  --neutral-black-alpha-90: #121212e5;\n  --neutral-black-alpha-95: #121212f2;\n  --neutral-gray-5: #f1f2f4;\n  --neutral-gray-10: #e1e3e6;\n  --neutral-gray-20: #d3d6da;\n  --neutral-gray-30: #b7bcc2;\n  --neutral-gray-40: #9ea5ad;\n  --neutral-gray-50: #87909a;\n  --neutral-gray-60: #6e7782;\n  --neutral-gray-70: #596069;\n  --neutral-gray-80: #4b5258;\n  --neutral-gray-90: #363b40;\n  --neutral-gray-95: #282b2f;\n  --neutral-white-alpha-5: #ffffff0d;\n  --neutral-white-alpha-10: #ffffff1a;\n  --neutral-white-alpha-20: #ffffff33;\n  --neutral-white-alpha-30: #ffffff4d;\n  --neutral-white-alpha-40: #ffffff66;\n  --neutral-white-alpha-50: #ffffff80;\n  --neutral-white-alpha-60: #ffffff99;\n  --neutral-white-alpha-70: #ffffffb2;\n  --neutral-white-alpha-80: #ffffffcc;\n  --neutral-white-alpha-90: #ffffffe5;\n  --neutral-white-alpha-95: #fffffff2;\n  --sentiment-error-5: #ffdada;\n  --sentiment-error-10: #fac2c2;\n  --sentiment-error-20: #f69898;\n  --sentiment-error-30: #f37272;\n  --sentiment-error-40: #ef4848;\n  --sentiment-error-50: #eb1414;\n  --sentiment-error-60: #d31212;\n  --sentiment-error-70: #b30f0f;\n  --sentiment-error-80: #8d0c0c;\n  --sentiment-error-90: #6c0909;\n  --sentiment-error-95: #620202;\n  --sentiment-information-5: #d5efff;\n  --sentiment-information-10: #b8e5ff;\n  --sentiment-information-20: #94d7ff;\n  --sentiment-information-30: #6fcaff;\n  --sentiment-information-40: #38b3ff;\n  --sentiment-information-50: #0099f3;\n  --sentiment-information-60: #0082e5;\n  --sentiment-information-70: #1570d1;\n  --sentiment-information-80: #0855b2;\n  --sentiment-information-90: #0b43a3;\n  --sentiment-information-95: #06338d;\n  --sentiment-success-5: #d8ffdc;\n  --sentiment-success-10: #c4f1ca;\n  --sentiment-success-20: #9be3a3;\n  --sentiment-success-30: #7cdb87;\n  --sentiment-success-40: #4fcf5d;\n  --sentiment-success-50: #34bd43;\n  --sentiment-success-60: #2da43a;\n  --sentiment-success-70: #258830;\n  --sentiment-success-80: #1f7028;\n  --sentiment-success-90: #17541e;\n  --sentiment-success-95: #003f25;\n  --sentiment-warning-5: #fff5da;\n  --sentiment-warning-10: #ffecb8;\n  --sentiment-warning-20: #ffe08a;\n  --sentiment-warning-30: #ffd35c;\n  --sentiment-warning-40: #fdc835;\n  --sentiment-warning-50: #f5c000;\n  --sentiment-warning-60: #edaf02;\n  --sentiment-warning-70: #cf8e02;\n  --sentiment-warning-80: #b27a01;\n  --sentiment-warning-90: #885d02;\n  --sentiment-warning-95: #654500}\n:root,[data-theme=Light]{\n  --background-neutral-primary: var(--neutral-base-white);\n  --background-neutral-secondary: var(--neutral-gray-5);\n  --background-neutral-tertiary: var(--neutral-gray-10);\n  --background-neutral-quaternary: var(--neutral-gray-20);\n  --background-neutral-quinary: var(--neutral-gray-30);\n  --background-neutral-senary: var(--neutral-gray-50);\n  --background-neutral-septenary: var(--neutral-gray-70);\n  --background-neutral-octonary: var(--neutral-gray-80);\n  --background-neutral-primary-inverse: var(--neutral-base-black);\n  --background-neutral-true-base: var(--neutral-base-black);\n  --background-neutral-black-fixed: var(--neutral-base-black);\n  --background-neutral-white-fixed: var(--neutral-base-white);\n  --background-neutral-alpha-5: var(--neutral-black-alpha-5);\n  --background-neutral-alpha-10: var(--neutral-black-alpha-10);\n  --background-neutral-alpha-20: var(--neutral-black-alpha-20);\n  --background-neutral-alpha-30: var(--neutral-black-alpha-30);\n  --background-neutral-alpha-40: var(--neutral-black-alpha-40);\n  --background-neutral-alpha-50: var(--neutral-black-alpha-50);\n  --background-neutral-alpha-60: var(--neutral-black-alpha-60);\n  --background-neutral-alpha-70: var(--neutral-black-alpha-70);\n  --background-neutral-alpha-80: var(--neutral-black-alpha-80);\n  --background-neutral-alpha-90: var(--neutral-black-alpha-90);\n  --background-neutral-alpha-95: var(--neutral-black-alpha-95);\n  --background-brand-primary: var(--brand-purple-50);\n  --background-brand-light: var(--brand-purple-5);\n  --background-brand-mid: var(--brand-purple-20);\n  --background-brand-strong: var(--brand-purple-80);\n  --background-error-primary: var(--sentiment-error-50);\n  --background-error-light: var(--sentiment-error-5);\n  --background-error-mid: var(--sentiment-error-30);\n  --background-error-strong: var(--sentiment-error-70);\n  --background-warning-primary: var(--sentiment-warning-50);\n  --background-warning-light: var(--sentiment-warning-5);\n  --background-warning-mid: var(--sentiment-warning-30);\n  --background-warning-strong: var(--sentiment-warning-70);\n  --background-success-primary: var(--sentiment-success-70);\n  --background-success-light: var(--sentiment-success-5);\n  --background-success-mid: var(--sentiment-success-30);\n  --background-success-strong: var(--sentiment-success-90);\n  --background-info-primary: var(--sentiment-information-70);\n  --background-info-light: var(--sentiment-information-5);\n  --background-info-mid: var(--sentiment-information-30);\n  --background-info-strong: var(--sentiment-information-90);\n  --background-selected-primary: var(--brand-purple-80);\n  --background-selected-strong: var(--brand-purple-95);\n  --background-selected-primary-inverse: var(--sentiment-success-5);\n  --background-disabled-brand: var(--brand-purple-5);\n  --background-disabled-error: var(--sentiment-error-5);\n  --background-disabled-info: var(--sentiment-information-5);\n  --background-disabled-neutral: var(--neutral-gray-20);\n  --background-disabled-orange: var(--brand-orange-5);\n  --background-disabled-pink: var(--brand-pink-5);\n  --background-disabled-success: var(--sentiment-success-5);\n  --background-disabled-warning: var(--sentiment-warning-5);\n  --background-accent-orange-primary: var(--brand-orange-50);\n  --background-accent-orange-light: var(--brand-orange-5);\n  --background-accent-orange-mid: var(--brand-orange-30);\n  --background-accent-orange-strong: var(--brand-orange-70);\n  --background-accent-pink-primary: var(--brand-pink-50);\n  --background-accent-pink-light: var(--brand-pink-5);\n  --background-accent-pink-mid: var(--brand-pink-30);\n  --background-accent-pink-strong: var(--brand-pink-70);\n  --border-neutral-primary: var(--neutral-gray-20);\n  --border-neutral-secondary: var(--neutral-gray-40);\n  --border-neutral-solid: var(--neutral-base-black);\n  --border-neutral-black-fixed: var(--neutral-base-black);\n  --border-neutral-white-fixed: var(--neutral-base-white);\n  --border-brand-primary: var(--brand-purple-50);\n  --border-brand-light: var(--brand-purple-10);\n  --border-brand-mid: var(--brand-purple-30);\n  --border-brand-strong: var(--brand-purple-70);\n  --border-error-primary: var(--sentiment-error-50);\n  --border-error-light: var(--sentiment-error-10);\n  --border-error-mid: var(--sentiment-error-20);\n  --border-error-strong: var(--sentiment-error-70);\n  --border-warning-primary: var(--sentiment-warning-50);\n  --border-warning-light: var(--sentiment-warning-10);\n  --border-warning-mid: var(--sentiment-warning-30);\n  --border-warning-strong: var(--sentiment-warning-70);\n  --border-success-primary: var(--sentiment-success-50);\n  --border-success-light: var(--sentiment-success-10);\n  --border-success-mid: var(--sentiment-success-30);\n  --border-success-strong: var(--sentiment-success-70);\n  --border-info-primary: var(--sentiment-information-50);\n  --border-info-light: var(--sentiment-information-10);\n  --border-info-mid: var(--sentiment-information-30);\n  --border-info-strong: var(--sentiment-information-70);\n  --border-focused-primary: var(--brand-purple-50);\n  --border-selected-primary: var(--brand-purple-80);\n  --border-selected-strong: var(--brand-purple-95);\n  --border-selected-primary-inverse: var(--sentiment-success-5);\n  --border-disabled-brand: var(--brand-purple-5);\n  --border-disabled-error: var(--sentiment-error-5);\n  --border-disabled-info: var(--sentiment-information-5);\n  --border-disabled-neutral: var(--neutral-gray-20);\n  --border-disabled-orange: var(--brand-orange-5);\n  --border-disabled-pink: var(--brand-pink-5);\n  --border-disabled-success: var(--sentiment-success-5);\n  --border-disabled-warning: var(--sentiment-warning-5);\n  --border-focused-inverse: var(--sentiment-success-5);\n  --border-accent-orange-primary: var(--brand-orange-50);\n  --border-accent-orange-light: var(--brand-orange-10);\n  --border-accent-orange-mid: var(--brand-orange-30);\n  --border-accent-orange-strong: var(--brand-orange-70);\n  --border-accent-pink-primary: var(--brand-pink-50);\n  --border-accent-pink-light: var(--brand-pink-10);\n  --border-accent-pink-mid: var(--brand-pink-30);\n  --border-accent-pink-strong: var(--brand-pink-70);\n  --text-neutral-primary: var(--neutral-base-black);\n  --text-neutral-secondary: var(--neutral-gray-90);\n  --text-neutral-tertiary: var(--neutral-gray-80);\n  --text-neutral-quaternary: var(--neutral-gray-70);\n  --text-neutral-primary-inverse: var(--neutral-base-white);\n  --text-neutral-placeholder: var(--neutral-gray-40);\n  --text-neutral-black-fixed: var(--neutral-base-black);\n  --text-neutral-white-fixed: var(--neutral-base-white);\n  --text-brand-primary: var(--brand-purple-50);\n  --text-brand-secondary: var(--brand-purple-90);\n  --text-brand-primary-fixed: var(--brand-purple-50);\n  --text-error-primary: var(--sentiment-error-50);\n  --text-error-secondary: var(--sentiment-error-70);\n  --text-error-primary-fixed: var(--sentiment-error-50);\n  --text-warning-primary: var(--sentiment-warning-50);\n  --text-warning-secondary: var(--sentiment-warning-90);\n  --text-warning-primary-fixed: var(--sentiment-warning-50);\n  --text-success-primary: var(--sentiment-success-70);\n  --text-success-secondary: var(--sentiment-success-90);\n  --text-success-primary-fixed: var(--sentiment-success-70);\n  --text-info-primary: var(--sentiment-information-70);\n  --text-info-secondary: var(--sentiment-information-90);\n  --text-info-primary-fixed: var(--sentiment-information-70);\n  --text-selected-primary: var(--sentiment-success-5);\n  --text-selected-primary-inverse: var(--brand-purple-95);\n  --text-disabled-brand: var(--brand-purple-5);\n  --text-disabled-error: var(--sentiment-error-5);\n  --text-disabled-info: var(--sentiment-information-5);\n  --text-disabled-neutral: var(--neutral-gray-20);\n  --text-disabled-neutral-inverse: var(--neutral-base-white);\n  --text-disabled-orange: var(--brand-orange-5);\n  --text-disabled-pink: var(--brand-pink-5);\n  --text-disabled-success: var(--sentiment-success-5);\n  --text-disabled-warning: var(--sentiment-warning-5);\n  --text-accent-orange-primary: var(--brand-orange-50);\n  --text-accent-orange-secondary: var(--brand-orange-70);\n  --text-accent-orange-primary-fixed: var(--brand-orange-50);\n  --text-accent-pink-primary: var(--brand-pink-50);\n  --text-accent-pink-secondary: var(--brand-pink-70);\n  --text-accent-pink-primary-fixed: var(--brand-pink-50)}\n:root{\n  --font-family-main: \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-family-heading: \"Space Grotesk\", \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-family-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\n  --font-weight-thin: 100;\n  --font-weight-extra-light: 200;\n  --font-weight-light: 300;\n  --font-weight-regular: 400;\n  --font-weight-medium: 500;\n  --font-weight-semi-bold: 600;\n  --font-weight-bold: 700;\n  --font-weight-extra-bold: 800;\n  --font-weight-black: 900;\n  --font-size-body-xs: .75rem;\n  --font-size-body-sm: .875rem;\n  --font-size-body-md: 1rem;\n  --font-size-body-lg: 1.125rem}\n:root{\n  --text-heading-xxl: 3rem;\n  --text-heading-xl: 2.375rem;\n  --text-heading-lg: 1.75rem;\n  --text-heading-md: 1.5rem;\n  --text-heading-sm: 1.375rem;\n  --text-heading-xs: 1.25rem;\n  --leading-heading-xxl: 3.25rem;\n  --leading-heading-xl: 2.5rem;\n  --leading-heading-lg: 2.25rem;\n  --leading-heading-md: 2rem;\n  --leading-heading-sm: 1.875rem;\n  --leading-heading-xs: 1.75rem;\n  --text-body-lg: 1.125rem;\n  --text-body-md: 1rem;\n  --text-body-sm: .875rem;\n  --text-body-xs: .75rem;\n  --text-body-xxs: .625rem;\n  --leading-body-lg: 1.75rem;\n  --leading-body-md: 1.5rem;\n  --leading-body-sm: 1.375rem;\n  --leading-body-xs: 1.125rem;\n  --leading-body-xxs: 1rem;\n  --tracking-heading-display: -.01em;\n  --tracking-overline: .08em;\n  --tracking-none: 0}\n:root{\n  --shape-sm: .375rem;\n  --shape-md: .5rem;\n  --shape-lg: .625rem;\n  --shape-xl: .75rem;\n  --shape-round: 62.4375rem;\n  --spacing-p-xxs: .5rem;\n  --spacing-p-xs: 1rem;\n  --spacing-p-s: 1.5rem;\n  --spacing-p-m: 2rem;\n  --spacing-p-l: 2.5rem;\n  --spacing-p-xl: 3rem;\n  --spacing-p-xxl: 3.5rem;\n  --spacing-p-xxxl: 4rem;\n  --shadow-sm: 0 4px 7px rgb(0 0 0 / 7%), 0 2px 2px rgb(0 0 0 / 7%);\n  --shadow-md: 0 10px 15px -3px rgb(0 0 0 / 10%), 0 4px 6px -4px rgb(0 0 0 / 10%);\n  --shadow-lg: 0 20px 25px -5px rgb(0 0 0 / 10%), 0 8px 10px -6px rgb(0 0 0 / 10%)}\n\n/* ==========================================================================\n   Component styles\n\n   What is CADS\n   - Every color, font, size, spacing, radius and shadow comes from the CADS\n     tokens above (copied unchanged from the CADS runtime, manifest 0.1.0).\n     There are no hard-coded colors in this file.\n   - Selected chrome (the step rail, the chosen answer border) uses the CADS\n     selected tokens, not brand fills.\n\n   What was rebuilt from the manifest\n   - Button: contained primary (40px, 48px for Start) and text. Contained\n     primary disabled uses neutral tokens.\n   - Tag: brand and success pills.\n   - Alert-style tints for the feedback strips (success and warning).\n\n   What was approximated\n   - The answer cards are modeled on Chip and Alert but are larger so a full\n     sentence fits. They are not an exact CADS component.\n   - The step rail, folder window, Files list and mini website are custom\n     pieces built from tokens. CADS has no matching component.\n   - Geist and Space Grotesk are named by the font tokens but are not loaded\n     (Web Lab blocks outside fonts), so the fallback fonts show.\n   ========================================================================== */\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nbody {\n  margin: 0;\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-md);\n  line-height: var(--leading-body-md);\n  color: var(--text-neutral-primary);\n  background: var(--background-neutral-primary);\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.sprite {\n  position: absolute;\n  width: 0;\n  height: 0;\n  overflow: hidden;\n}\n\n.icon {\n  width: 1.25rem;\n  height: 1.25rem;\n  flex: none;\n}\n\n.icon-fill {\n  fill: currentColor;\n  stroke: currentColor;\n  stroke-width: 1.5;\n  stroke-linejoin: round;\n}\n\n.icon-stroke {\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2.5;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* Sample pictures drawn in the sprite at the top of index.html */\n.art-sky { fill: var(--sentiment-information-10); }\n.art-sun { fill: var(--sentiment-warning-40); }\n.art-hill-back { fill: var(--sentiment-success-30); }\n.art-hill-front { fill: var(--sentiment-success-50); }\n.art-trunk { fill: var(--brand-orange-70); }\n.art-leaves { fill: var(--sentiment-success-70); }\n.art-bench { fill: var(--brand-orange-80); }\n.art-city-sky { fill: var(--brand-pink-10); }\n.art-building-a { fill: var(--neutral-gray-70); }\n.art-building-b { fill: var(--neutral-gray-50); }\n\n[tabindex=\"-1\"]:focus {\n  outline: none;\n}\n\n.btn:focus-visible,\n.choice:focus-visible {\n  outline: 2px solid var(--border-focused-primary);\n  outline-offset: 2px;\n}\n\n/* ---------- Layout ---------- */\n\n.app {\n  max-width: 55rem;\n  margin: 0 auto;\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs) var(--spacing-p-xs);\n}\n\n.error-banner {\n  margin: var(--spacing-p-xxs) var(--spacing-p-xs);\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  background: var(--background-error-light);\n  color: var(--text-error-secondary);\n  border: 1px solid var(--border-error-primary);\n  border-radius: var(--shape-md);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.view-title {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-md);\n  line-height: var(--leading-heading-md);\n  font-weight: var(--font-weight-bold);\n  letter-spacing: var(--tracking-heading-display);\n}\n\n/* ---------- Buttons and tags ---------- */\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.5rem;\n  min-height: 2.5rem;\n  padding: 0 var(--spacing-p-xs);\n  border: 1px solid transparent;\n  border-radius: var(--shape-sm);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n}\n\n.btn-large {\n  min-height: 3rem;\n  padding: 0 var(--spacing-p-s);\n}\n\n.btn-primary {\n  background: var(--background-brand-primary);\n  color: var(--text-neutral-primary-inverse);\n}\n\n.btn-primary:hover {\n  background: var(--background-brand-strong);\n}\n\n.btn-primary:disabled {\n  background: var(--background-brand-mid);\n  color: var(--text-brand-secondary);\n  cursor: default;\n}\n\n.btn-text {\n  background: transparent;\n  color: var(--text-brand-primary);\n}\n\n.btn-text:hover {\n  background: var(--background-brand-light);\n}\n\n.tag {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.375rem;\n  padding: 0.125rem 0.75rem;\n  border-radius: var(--shape-round);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: var(--leading-body-md);\n}\n\n.tag-brand {\n  background: var(--background-brand-primary);\n  color: var(--text-neutral-primary-inverse);\n}\n\n/* ---------- Intro ---------- */\n\n.view-intro {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: var(--spacing-p-xs);\n  max-width: 38rem;\n  margin: var(--spacing-p-xs) 0 0;\n}\n\n.lead {\n  margin: 0;\n}\n\n.intro-steps {\n  margin: 0;\n  padding-inline-start: 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.375rem;\n}\n\n/* ---------- Practice header (purple box) ---------- */\n\n.practice-head {\n  display: flex;\n  flex-direction: column;\n  gap: 0.625rem;\n  padding: 0.75rem var(--spacing-p-xs);\n  background: var(--background-brand-light);\n  border: 1px solid var(--border-brand-mid);\n  border-radius: var(--shape-lg);\n}\n\n.head-row {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 0.75rem;\n}\n\n.head-line {\n  margin: 0;\n  font-size: var(--text-body-lg);\n  line-height: var(--leading-body-md);\n  font-weight: var(--font-weight-semi-bold);\n  color: var(--text-brand-secondary);\n}\n\n.head-controls {\n  justify-content: space-between;\n}\n\n.head-buttons {\n  display: flex;\n  gap: 0.5rem;\n  margin-inline-start: auto;\n}\n\n.rail {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.25rem 0.75rem;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.rail-item {\n  display: flex;\n  align-items: center;\n  gap: 0.375rem;\n  color: var(--text-neutral-tertiary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.rail-dot {\n  display: grid;\n  place-items: center;\n  width: 1.75rem;\n  height: 1.75rem;\n  border: 2px solid var(--border-neutral-secondary);\n  border-radius: 50%;\n  background: var(--background-neutral-primary);\n  line-height: 1;\n}\n\n.rail-item.is-done .rail-dot {\n  background: var(--background-brand-mid);\n  border-color: var(--border-brand-mid);\n  color: var(--text-brand-secondary);\n}\n\n.rail-item.is-current {\n  color: var(--text-neutral-primary);\n}\n\n.rail-item.is-current .rail-dot {\n  background: var(--background-selected-primary);\n  border-color: var(--border-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n/* ---------- Stage ---------- */\n\n.stage {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  gap: var(--spacing-p-s);\n  align-items: start;\n  margin-top: var(--spacing-p-xs);\n}\n\n.step,\n.vis {\n  display: none;\n  margin: 0;\n}\n\n.stage[data-step=\"1\"] :is(.step-1, .vis-folder),\n.stage[data-step=\"2\"] :is(.step-2, .vis-folder),\n.stage[data-step=\"3\"] :is(.step-3, .vis-upload),\n.stage[data-step=\"4\"] :is(.step-4, .vis-page) {\n  display: block;\n}\n\n.step-title {\n  margin: 0 0 0.5rem;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-xs);\n  line-height: var(--leading-heading-xs);\n  font-weight: var(--font-weight-bold);\n}\n\n.step-text {\n  margin: 0 0 0.75rem;\n}\n\n.how-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n  margin: 0 0 var(--spacing-p-xs);\n  padding-inline-start: 1.5rem;\n}\n\n/* ---------- Action hint (tells students to do something) ---------- */\n\n.action-hint {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  margin: 0 0 0.75rem;\n  font-weight: var(--font-weight-semi-bold);\n  color: var(--text-brand-secondary);\n}\n\n.hint-icon {\n  width: 2rem;\n  height: 2rem;\n  padding: 0.4rem;\n  background: var(--background-brand-primary);\n  color: var(--text-neutral-primary-inverse);\n  border-radius: 50%;\n  animation: nudge 1.8s ease-in-out infinite;\n}\n\n/* ---------- Answer cards ---------- */\n\n.choices {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n}\n\n.choice {\n  display: flex;\n  flex-direction: column;\n  gap: 0.375rem;\n  min-height: 3rem;\n  padding: 0.625rem 0.875rem;\n  background: var(--background-neutral-primary);\n  border: 2px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-md);\n  color: var(--text-neutral-primary);\n  font: inherit;\n  text-align: start;\n  cursor: pointer;\n}\n\n.choice:hover {\n  background: var(--background-neutral-secondary);\n}\n\n.choice-text {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n#choices-2 .choice-text {\n  font-family: var(--font-family-mono);\n  overflow-wrap: anywhere;\n}\n\n.choice[aria-pressed=\"true\"] {\n  border-color: var(--border-selected-primary);\n}\n\n.choice[data-verdict=\"best\"] {\n  background: var(--background-success-light);\n}\n\n.choice[data-verdict=\"try\"] {\n  background: var(--background-warning-light);\n}\n\n.verdict {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.375rem;\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.verdict-best {\n  color: var(--text-success-secondary);\n}\n\n.verdict-try {\n  color: var(--text-warning-secondary);\n}\n\n.feedback {\n  margin: 0.625rem 0 0;\n  padding: 0.625rem 0.875rem;\n  border: 1px solid transparent;\n  border-radius: var(--shape-md);\n}\n\n.feedback[data-verdict=\"best\"] {\n  background: var(--background-success-light);\n  border-color: var(--border-success-mid);\n  color: var(--text-success-secondary);\n}\n\n.feedback[data-verdict=\"try\"] {\n  background: var(--background-warning-light);\n  border-color: var(--border-warning-mid);\n  color: var(--text-warning-secondary);\n}\n\n/* ---------- Steps 1 and 2: folder ---------- */\n\n.window {\n  overflow: hidden;\n  background: var(--background-neutral-primary);\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-md);\n  box-shadow: var(--shadow-sm);\n}\n\n.window-bar {\n  padding: 0.375rem 0.75rem;\n  background: var(--background-neutral-tertiary);\n  border-bottom: 1px solid var(--border-neutral-primary);\n}\n\n.window-title {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.window-body {\n  display: grid;\n  place-items: center;\n  min-height: 11.5rem;\n  padding: var(--spacing-p-xs);\n  background: var(--background-neutral-secondary);\n}\n\n.file-tile {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.5rem;\n  max-width: 100%;\n}\n\n.file-thumb {\n  display: block;\n  width: 10rem;\n  max-width: 100%;\n  height: auto;\n  aspect-ratio: 16 / 9;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-sm);\n}\n\n.file-name {\n  max-width: 100%;\n  padding: 0.125rem 0.5rem;\n  background: var(--background-neutral-primary);\n  border: 2px solid transparent;\n  border-radius: var(--shape-sm);\n  font-family: var(--font-family-mono);\n  font-weight: var(--font-weight-semi-bold);\n  text-align: center;\n  overflow-wrap: anywhere;\n}\n\n.file-tile[data-state=\"best\"] .file-name {\n  background: var(--background-success-light);\n  border-color: var(--border-success-primary);\n}\n\n.file-tile[data-state=\"try\"] .file-name {\n  background: var(--background-warning-light);\n  border-color: var(--border-warning-primary);\n}\n\n.file-tile.is-arriving {\n  animation: arrive 0.5s ease-out;\n}\n\n.code-strip {\n  margin-top: 0.75rem;\n}\n\n.stage:not([data-step=\"2\"]) .code-strip {\n  display: none;\n}\n\n.code-label {\n  margin: 0 0 0.25rem;\n}\n\n.code-line {\n  display: block;\n  padding: 0.625rem 0.75rem;\n  background: var(--background-neutral-primary-inverse);\n  color: var(--text-neutral-primary-inverse);\n  border-radius: var(--shape-sm);\n  font-family: var(--font-family-mono);\n  font-size: var(--text-body-md);\n  overflow-wrap: anywhere;\n}\n\n.code-name {\n  color: var(--sentiment-warning-30);\n  font-weight: var(--font-weight-bold);\n}\n\n/* ---------- Step 3: upload ---------- */\n\n.menu-shot {\n  display: block;\n  width: 100%;\n  max-width: 23rem;\n  height: auto;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-md);\n}\n\n/* ---------- Step 4: mini website ---------- */\n\n.mini-page {\n  overflow: hidden;\n  background: var(--background-neutral-primary);\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-md);\n  box-shadow: var(--shadow-sm);\n}\n\n.mp-bar {\n  padding: 0.375rem 0.75rem;\n  background: var(--background-neutral-tertiary);\n  border-bottom: 1px solid var(--border-neutral-primary);\n}\n\n.mp-bar-label {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.mp-body {\n  display: flex;\n  flex-direction: column;\n  gap: 0.625rem;\n  padding: 0.75rem var(--spacing-p-xs);\n}\n\n.mp-heading {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-sm);\n  line-height: var(--leading-heading-xs);\n  font-weight: var(--font-weight-bold);\n}\n\n.mp-slot-top {\n  position: relative;\n  width: 100%;\n  max-width: 17rem;\n  aspect-ratio: 16 / 9;\n  border-radius: var(--shape-sm);\n  overflow: hidden;\n}\n\n.mp-empty,\n.mp-photo,\n.mp-badge,\n.mp-broken {\n  display: none;\n}\n\n.mp-empty {\n  height: 100%;\n  place-items: center;\n  border: 2px dashed var(--border-neutral-secondary);\n  border-radius: var(--shape-sm);\n  color: var(--text-neutral-quaternary);\n}\n\n.mp-photo {\n  width: 100%;\n  height: 100%;\n  animation: arrive 0.4s ease-out;\n}\n\n.mp-badge {\n  position: absolute;\n  inset-block-end: 0.375rem;\n  inset-inline-start: 0.375rem;\n  padding: 0.125rem 0.625rem;\n  background: var(--background-warning-light);\n  color: var(--text-warning-secondary);\n  border: 1px solid var(--border-warning-primary);\n  border-radius: var(--shape-round);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.mini-page[data-result=\"none\"] .mp-empty {\n  display: grid;\n}\n\n.mini-page[data-result=\"best\"] .mp-photo-park {\n  display: block;\n}\n\n.mini-page[data-result=\"decoy\"] .mp-photo-city {\n  display: block;\n}\n\n.mini-page[data-result=\"decoy\"] .mp-badge {\n  display: inline-block;\n}\n\n.mini-page[data-result=\"vague\"] .mp-slot-top {\n  display: none;\n}\n\n.mini-page[data-result=\"vague\"] .mp-broken {\n  display: block;\n}\n\n.mp-lines {\n  display: flex;\n  flex-direction: column;\n  gap: 0.375rem;\n}\n\n.mp-line {\n  height: 0.625rem;\n  background: var(--background-neutral-quaternary);\n  border-radius: var(--shape-round);\n}\n\n.mp-line-short {\n  width: 60%;\n}\n\n.mp-button {\n  align-self: flex-start;\n  padding: 0.375rem 0.875rem;\n  background: var(--background-accent-orange-strong);\n  color: var(--text-neutral-primary-inverse);\n  border-radius: var(--shape-sm);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.mp-broken {\n  padding: 0.75rem;\n  background: var(--background-error-light);\n  color: var(--text-error-secondary);\n  border: 2px dashed var(--border-error-primary);\n  border-radius: var(--shape-sm);\n  font-weight: var(--font-weight-semi-bold);\n  text-align: center;\n  animation: arrive 0.4s ease-out;\n}\n\n/* ---------- Takeaway ---------- */\n\n.view-takeaway {\n  display: grid;\n  grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);\n  gap: var(--spacing-p-s);\n  align-items: start;\n  margin-top: var(--spacing-p-xs);\n}\n\n.takeaway-text {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-p-xs);\n}\n\n.takeaway-body,\n.takeaway-last,\n.recap-lead {\n  margin: 0;\n}\n\n.recap-lead {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.recap {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n  margin: 0;\n  padding-inline-start: 1.5rem;\n}\n\n/* ---------- Motion and small screens ---------- */\n\n@keyframes nudge {\n  0%,\n  100% {\n    transform: none;\n  }\n  50% {\n    transform: translate(0.125rem, 0.125rem);\n  }\n}\n\n@keyframes arrive {\n  from {\n    opacity: 0;\n    transform: translateY(-0.75rem);\n  }\n  to {\n    opacity: 1;\n    transform: none;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n}\n\n@media (max-width: 47.99rem) {\n  .stage,\n  .view-takeaway {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .rail-item:not(.is-current) .rail-label {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    overflow: hidden;\n    clip: rect(0, 0, 0, 0);\n    white-space: nowrap;\n  }\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "'use strict';\n\n/* ---------- Configuration ---------- */\n\nconst CONFIG = {\n  photoFile: 'park-cleanup.png',\n  originalName: 'IMG_4827.png',\n  totalSteps: 4\n};\n\n/* ---------- Copy (all text lives here so it can be translated) ---------- */\n\nconst COPY = {\n  practiceTag: 'Practice',\n\n  introTitle: 'How to add an image to your website',\n  introLead: 'A quick chance to practice a skill for your project.',\n  introSteps: [\n    'See the four steps for adding a photo to your website.',\n    'Select a clear file name and a clear prompt.',\n    'Watch the sample website change with each choice.'\n  ],\n  startLabel: 'Start',\n\n  practiceLine: 'Quick practice: see the steps for adding a photo to your project.',\n  backLabel: 'Back',\n  nextLabel: 'Next',\n  finishLabel: 'Finish',\n  railLabels: ['Save', 'Name', 'Upload', 'Ask'],\n\n  step1Title: 'Step 1: You will find a photo and save it to your computer.',\n  step1Text: 'Use your own photo or one that is free to use. Save it where you can find it, like your Downloads folder. The park photo here is a sample.',\n\n  step2Title: 'Step 2: You will give the file a clear, simple name.',\n  step2Text: 'Photos often come with messy names, like this sample photo.',\n  step2Hint: 'Try it: select the name that works best for this sample image.',\n\n  step3Title: 'Step 3: You will upload the photo in the Code tab.',\n  howSteps: [\n    'When in your project, open the Code tab.',\n    'Click the plus sign next to Files.',\n    'Click Upload, then pick your photo.'\n  ],\n  menuAlt: 'The Code tab in Web Lab. The plus sign next to Files is open and shows New Folder, New File, and Upload. Upload is highlighted.',\n\n  step4Title: 'Step 4: You will tell AI Tutor which file to add and where to put it.',\n  step4Hint: 'Try it: select the prompt that works best.',\n\n  folderTitle: 'Downloads',\n  codeLabel: 'Your page finds the photo by its exact name:',\n  folderDescription: (name) => `A folder window showing your photo saved as ${name}.`,\n  thumbAlt: 'A sample photo of a park with a tree, a bench, and a sunny sky.',\n\n  pageBarLabel: 'Sample website',\n  pageHeading: 'Park Cleanup Club',\n  pageEmpty: 'No photo yet',\n  pageDecoyBadge: 'Not your photo',\n  pageButton: 'Join us',\n  pageBroken: 'Image not found',\n  pageDescriptions: {\n    none: 'A sample website for a park cleanup club. It has a heading, a few lines of text, and a Join us button. There is no photo yet.',\n    vague: 'The sample website now has a box at the bottom that says image not found. The photo is not under the heading.',\n    decoy: 'The sample website now has a picture of a city under the heading, labeled not your photo.',\n    best: 'The sample website now shows your park photo under the heading.'\n  },\n\n  verdictBest: 'Best choice',\n  verdictTry: 'Not quite',\n  announceChoice: (verdict, why) => `${verdict}. ${why}`,\n\n  takeawayTitle: 'Takeaway: Name your file clearly, then tell AI Tutor which file and where.',\n  takeawayBody: 'A short name with no spaces is easy for your page to find. A prompt that names the file and the spot puts your photo on the page the first time.',\n  recapLead: 'In your project:',\n  recap: [\n    'Save your photo.',\n    'Give it a clear, simple name.',\n    'Upload it in the Code tab.',\n    'Tell AI Tutor which file and where.'\n  ],\n  takeawayLast: 'Press Continue to go to your project.',\n\n  errorMessage: 'This activity could not load. Please reload the page.'\n};\n\n/* ---------- Choices ---------- */\n\nconst NAME_CHOICES = [\n  {\n    id: 'camera',\n    label: CONFIG.originalName,\n    best: false,\n    why: 'This name does not say what the photo shows, so it is hard to find later.'\n  },\n  {\n    id: 'clear',\n    label: CONFIG.photoFile,\n    best: true,\n    why: 'Short, clear, and no spaces. Keep the .png at the end.'\n  },\n  {\n    id: 'messy',\n    label: 'My Best Photo FINAL (2).png',\n    best: false,\n    why: 'Spaces and symbols can stop your page from finding the photo.'\n  }\n];\n\nconst PROMPT_CHOICES = [\n  {\n    id: 'no-file',\n    label: 'Add a photo of people cleaning a park under my heading.',\n    best: false,\n    result: 'decoy',\n    why: 'It says where, but not which file. AI Tutor may use a different picture.'\n  },\n  {\n    id: 'vague',\n    label: 'Add a picture to my website.',\n    best: false,\n    result: 'vague',\n    why: 'It does not say which file or where. AI Tutor has to guess.'\n  },\n  {\n    id: 'exact',\n    label: `Add ${CONFIG.photoFile} under the heading at the top of my page.`,\n    best: true,\n    result: 'best',\n    why: 'It names the file and the spot.'\n  }\n];\n\n/* ---------- State ---------- */\n\nconst state = {\n  step: 1,\n  nameChoice: null,\n  foundName: false,\n  promptChoice: null,\n  foundPrompt: false\n};\n\nconst els = {};\n\n/* ---------- Helpers ---------- */\n\nfunction $(id) {\n  return document.getElementById(id);\n}\n\nfunction showError() {\n  const banner = $('error-banner');\n  if (!banner) return;\n  banner.textContent = COPY.errorMessage;\n  banner.hidden = false;\n}\n\nfunction announce(message) {\n  const region = els.announcer;\n  region.textContent = '';\n  window.setTimeout(() => {\n    region.textContent = message;\n  }, 50);\n}\n\nfunction createIcon(name) {\n  const svgNs = 'http://www.w3.org/2000/svg';\n  const svg = document.createElementNS(svgNs, 'svg');\n  svg.setAttribute('class', 'icon');\n  svg.setAttribute('aria-hidden', 'true');\n  svg.setAttribute('focusable', 'false');\n  const use = document.createElementNS(svgNs, 'use');\n  use.setAttribute('href', `#icon-${name}`);\n  svg.appendChild(use);\n  return svg;\n}\n\nfunction createElement(tag, className, text) {\n  const el = document.createElement(tag);\n  if (className) el.className = className;\n  if (text !== undefined) el.textContent = text;\n  return el;\n}\n\nfunction applyCopy() {\n  document.querySelectorAll('[data-text]').forEach((el) => {\n    const key = el.getAttribute('data-text');\n    if (typeof COPY[key] === 'string') {\n      el.textContent = COPY[key];\n    } else {\n      console.warn(`Missing copy for ${key}`);\n    }\n  });\n}\n\nfunction focusHeading(id) {\n  const heading = $(id);\n  if (heading) heading.focus({ preventScroll: true });\n}\n\n/* ---------- Builders ---------- */\n\nfunction buildIntroSteps() {\n  const list = $('intro-steps');\n  COPY.introSteps.forEach((text) => list.appendChild(createElement('li', '', text)));\n}\n\nfunction buildRail() {\n  const rail = $('rail');\n  COPY.railLabels.forEach((label, index) => {\n    const item = createElement('li', 'rail-item');\n    item.appendChild(createElement('span', 'rail-dot', String(index + 1)));\n    item.appendChild(createElement('span', 'rail-label', label));\n    rail.appendChild(item);\n  });\n}\n\nfunction buildHowList() {\n  const list = $('how-list');\n  COPY.howSteps.forEach((text) => list.appendChild(createElement('li', '', text)));\n}\n\nfunction buildRecap() {\n  const list = $('recap');\n  COPY.recap.forEach((text) => list.appendChild(createElement('li', '', text)));\n}\n\nfunction buildChoices(containerId, choices, onPick) {\n  const container = $(containerId);\n  choices.forEach((choice) => {\n    const button = createElement('button', 'choice');\n    button.type = 'button';\n    button.setAttribute('aria-pressed', 'false');\n    button.dataset.id = choice.id;\n    button.appendChild(createElement('span', 'choice-text', choice.label));\n\n    const verdict = createElement('span', 'verdict');\n    verdict.hidden = true;\n    button.appendChild(verdict);\n\n    button.addEventListener('click', () => onPick(choice));\n    container.appendChild(button);\n  });\n}\n\n/* ---------- Choice feedback ---------- */\n\nfunction markChoice(containerId, choice) {\n  const container = $(containerId);\n  container.querySelectorAll('.choice').forEach((button) => {\n    const isChosen = button.dataset.id === choice.id;\n    button.setAttribute('aria-pressed', String(isChosen));\n    button.dataset.verdict = isChosen ? (choice.best ? 'best' : 'try') : '';\n    const verdict = button.querySelector('.verdict');\n    verdict.textContent = '';\n    verdict.hidden = !isChosen;\n    if (isChosen) {\n      verdict.className = `verdict verdict-${choice.best ? 'best' : 'try'}`;\n      verdict.appendChild(createIcon(choice.best ? 'check' : 'cross'));\n      verdict.appendChild(createElement('span', '', choice.best ? COPY.verdictBest : COPY.verdictTry));\n    }\n  });\n}\n\nfunction verdictLabel(choice) {\n  return choice.best ? COPY.verdictBest : COPY.verdictTry;\n}\n\n/* ---------- Step 2: file name ---------- */\n\nfunction updateFolder() {\n  const choice = NAME_CHOICES.find((item) => item.id === state.nameChoice);\n  const name = choice ? choice.label : CONFIG.originalName;\n  els.fileName.textContent = name;\n  els.codeName.textContent = name;\n  els.fileTile.dataset.state = choice ? (choice.best ? 'best' : 'try') : 'start';\n  els.folderCaption.textContent = COPY.folderDescription(name);\n}\n\nfunction pickName(choice) {\n  state.nameChoice = choice.id;\n  if (choice.best) state.foundName = true;\n  markChoice('choices-2', choice);\n  updateFolder();\n\n  const feedback = $('feedback-2');\n  feedback.textContent = choice.why;\n  feedback.dataset.verdict = choice.best ? 'best' : 'try';\n  feedback.hidden = false;\n\n  updateNext();\n  announce(COPY.announceChoice(verdictLabel(choice), choice.why));\n}\n\n/* ---------- Step 4: prompt ---------- */\n\nfunction pickPrompt(choice) {\n  state.promptChoice = choice.id;\n  if (choice.best) state.foundPrompt = true;\n  markChoice('choices-4', choice);\n\n  els.miniPage.dataset.result = choice.result;\n  els.pageDescription.textContent = COPY.pageDescriptions[choice.result];\n\n  const feedback = $('feedback-4');\n  feedback.textContent = choice.why;\n  feedback.dataset.verdict = choice.best ? 'best' : 'try';\n  feedback.hidden = false;\n\n  updateNext();\n  announce(COPY.announceChoice(verdictLabel(choice), choice.why));\n}\n\n/* ---------- Steps and views ---------- */\n\nfunction canAdvance() {\n  switch (state.step) {\n    case 2: return state.foundName;\n    case 4: return state.foundPrompt;\n    default: return true;\n  }\n}\n\nfunction updateNext() {\n  els.nextButton.disabled = !canAdvance();\n}\n\nfunction updateRail() {\n  els.rail.querySelectorAll('.rail-item').forEach((item, index) => {\n    const number = index + 1;\n    item.classList.toggle('is-done', number < state.step);\n    item.classList.toggle('is-current', number === state.step);\n    if (number === state.step) {\n      item.setAttribute('aria-current', 'step');\n    } else {\n      item.removeAttribute('aria-current');\n    }\n  });\n}\n\nfunction playArrival() {\n  els.fileTile.classList.remove('is-arriving');\n  void els.fileTile.offsetWidth;\n  els.fileTile.classList.add('is-arriving');\n}\n\nfunction showStep(number, shouldFocus) {\n  state.step = number;\n  els.stage.dataset.step = String(number);\n  els.backButton.hidden = number === 1;\n  els.nextButton.textContent = number === CONFIG.totalSteps ? COPY.finishLabel : COPY.nextLabel;\n  updateRail();\n  updateNext();\n  updateFolder();\n  if (number === 1) playArrival();\n\n  if (shouldFocus) {\n    const title = $(`step-title-${number}`);\n    focusHeading(`step-title-${number}`);\n    announce(title.textContent);\n  }\n}\n\nfunction showView(name) {\n  ['intro', 'practice', 'takeaway'].forEach((view) => {\n    $(`view-${view}`).hidden = view !== name;\n  });\n}\n\nfunction startPractice() {\n  showView('practice');\n  showStep(1, false);\n  focusHeading('practice-heading');\n  announce(`${COPY.practiceLine} ${COPY.step1Title}`);\n}\n\nfunction goNext() {\n  if (!canAdvance()) return;\n  if (state.step === CONFIG.totalSteps) {\n    showView('takeaway');\n    focusHeading('takeaway-title');\n    if (window.continueArrow) window.continueArrow.show();\n    announce(COPY.takeawayTitle);\n    return;\n  }\n  showStep(state.step + 1, true);\n}\n\nfunction goBack() {\n  if (state.step > 1) showStep(state.step - 1, true);\n}\n\n/* ---------- Setup ---------- */\n\nfunction collectElements() {\n  els.announcer = $('announcer');\n  els.stage = $('stage');\n  els.rail = $('rail');\n  els.backButton = $('back-button');\n  els.nextButton = $('next-button');\n  els.fileTile = $('file-tile');\n  els.fileName = $('file-name');\n  els.codeName = $('code-name');\n  els.folderCaption = $('folder-caption');\n  els.miniPage = $('mini-page');\n  els.pageDescription = $('page-description');\n}\n\nfunction init() {\n  collectElements();\n  applyCopy();\n  buildIntroSteps();\n  buildRail();\n  buildHowList();\n  buildRecap();\n  buildChoices('choices-2', NAME_CHOICES, pickName);\n  buildChoices('choices-4', PROMPT_CHOICES, pickPrompt);\n\n  document.querySelectorAll('.menu-shot').forEach((img) => img.setAttribute('alt', COPY.menuAlt));\n  document.querySelector('.file-thumb').setAttribute('aria-label', COPY.thumbAlt);\n  els.pageDescription.textContent = COPY.pageDescriptions.none;\n\n  $('start-button').addEventListener('click', startPractice);\n  els.backButton.addEventListener('click', goBack);\n  els.nextButton.addEventListener('click', goNext);\n}\n\ntry {\n  init();\n} catch (error) {\n  console.error(error);\n  showError();\n}\n\nwindow.addEventListener('error', showError);\n",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "upload-menu.png",
          "contents": "",
          "folderId": "0",
          "url": "/level_starter_assets/adaptive-less-checkpoints-direct-look-learn-practice-3/uuid/5678b6ce-fee8-479e-b8ee-82ed1eafa8a8.png",
          "type": "starter",
          "active": true
        },
        "5": {
          "id": "5",
          "name": "continue-arrow.css",
          "contents": "/* ==================================================================\n   Continue arrow\n   Points down at Web Lab's Continue button, which sits just under the\n   widget at the bottom right. Colors and spacing come from the CADS\n   tokens in style.css; the fallbacks let this file work on its own.\n   Shown and hidden by continue-arrow.js.\n   ================================================================== */\n\n/* Centered under Continue, which sits flush with the frame's right edge\n   and is about 4rem wide; the nudge's lowest point just meets the edge. */\n.continue-arrow {\n  position: fixed;\n  right: 2.5rem;\n  bottom: .625rem;\n  width: 3rem;\n  height: 3rem;\n  fill: var(--sentiment-success-50, #34bd43);\n  pointer-events: none;\n  animation: continue-arrow-nudge 1.2s ease-in-out infinite;\n}\n\n/* Keeps the page's last lines clear of the arrow. */\nbody.has-continue-arrow { padding-block-end: 4rem; }\n\n@keyframes continue-arrow-nudge {\n  0%, 100% { transform: translateY(0); }\n  50% { transform: translateY(.625rem); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .continue-arrow { animation: none; }\n}\n",
          "folderId": "0",
          "active": false
        },
        "6": {
          "id": "6",
          "name": "continue-arrow.js",
          "contents": "'use strict';\n\n/* ------------------------------------------------------------------\n   Continue arrow\n   An animated arrow that points down at Web Lab's Continue button, which\n   sits just under the widget at the bottom right. Load this file and\n   continue-arrow.css alongside the widget's own files, then call\n   continueArrow.show() once the student has finished the activity, and\n   continueArrow.hide() if the activity can be reopened.\n   ------------------------------------------------------------------ */\n\n(() => {\n  const SVG_NS = 'http://www.w3.org/2000/svg';\n  const ARROW_CLASS = 'continue-arrow';\n  const BODY_CLASS = 'has-continue-arrow';\n  let arrow = null;\n\n  function build() {\n    const svg = document.createElementNS(SVG_NS, 'svg');\n    svg.setAttribute('class', ARROW_CLASS);\n    svg.setAttribute('viewBox', '0 0 24 24');\n    svg.setAttribute('aria-hidden', 'true');\n    svg.setAttribute('focusable', 'false');\n    const path = document.createElementNS(SVG_NS, 'path');\n    path.setAttribute('d', 'M12 22L3 13H9V3H15V13H21Z');\n    svg.append(path);\n    return svg;\n  }\n\n  function show() {\n    if (!arrow) arrow = build();\n    if (!arrow.isConnected) document.body.append(arrow);\n    document.body.classList.add(BODY_CLASS);\n  }\n\n  function hide() {\n    if (arrow) arrow.remove();\n    document.body.classList.remove(BODY_CLASS);\n  }\n\n  window.continueArrow = { show, hide };\n})();\n",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "1",
        "2",
        "3",
        "4"
      ]
