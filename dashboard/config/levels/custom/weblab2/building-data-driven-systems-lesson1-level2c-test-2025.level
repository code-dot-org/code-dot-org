      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Foodie Focus Magazine</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <div class=\"magazine-wrapper\">\n    <header class=\"masthead\">\n      <h1 id=\"magTitle\">Foodie Focus</h1>\n      <div class=\"issue-details\">Winter Issue • $5.99</div>\n    </header>\n\n    <main class=\"cover-body\">\n      <div class=\"image-frame\">\n        <img id=\"coverImage\" src=\"/images/cover1c.png\" alt=\"Food Cover Image\">\n      </div>\n      \n      <div class=\"text-overlay\">\n        <h2 id=\"headline\"></h2>\n        <p id=\"tagline\"></p>\n      </div>\n    </main>\n\n    <footer>\n      <p id=\"count\"></p>\n    </footer>\n  </div>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// FOOD MAGAZINE: Parallel Arrays\n\n// Data Arrays\nconst coverImages = [\n  \"/images/cover1c.png\",\n  \"/images/cover2c.png\",\n  \"/images/cover3c.png\"\n];\nconst headlines = [];\nconst taglines = [];\n\n",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  background-color: #f4e1d2;\n  font-family: 'Georgia', serif;\n  display: flex;\n  justify-content: center;\n  padding: 20px;\n}\n\n.magazine-wrapper {\n  background: white;\n  width: 380px;\n  padding: 20px;\n  border: 1px solid #d4a373;\n  box-shadow: 0 10px 20px rgba(0,0,0,0.1);\n  text-align: center;\n}\n\n.masthead {\n  border-bottom: 2px solid #8a2be2; /* Creative accent */\n  border-bottom: 4px double #a52a2a; /* Brown/Red */\n  padding-bottom: 10px;\n  margin-bottom: 15px;\n}\n\nh1 {\n  font-family: 'Playfair Display', serif; /* Elegant header font */\n  font-size: 3rem;\n  margin: 0;\n  color: #a52a2a;\n  letter-spacing: -1px;\n}\n\n.issue-details {\n  font-style: italic;\n  color: #666;\n  margin-top: 5px;\n}\n\n.cover-body {\n  position: relative;\n}\n\n.image-frame {\n  border: 1px solid #ddd;\n  padding: 5px;\n  background: #fff;\n}\n\n#coverImage {\n  width: 100%;\n  height: auto;\n  display: block;\n}\n\n.text-overlay {\n  margin-top: 15px;\n}\n\n#headline {\n  font-family: 'Helvetica', sans-serif;\n  font-size: 2rem;\n  color: #333;\n  margin: 10px 0 5px 0;\n  font-weight: bold;\n  text-transform: uppercase;\n}\n\n#tagline {\n  font-size: 1.2rem;\n  font-style: italic;\n  color: #a52a2a;\n  margin: 0;\n}\n\nfooter {\n  margin-top: 20px;\n  border-top: 1px solid #eee;\n  padding-top: 10px;\n  font-size: 0.9rem;\n  color: #888;\n}",
          "folderId": "0",
          "active": false
        },
