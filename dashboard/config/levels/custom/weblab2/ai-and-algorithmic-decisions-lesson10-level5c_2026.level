      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>ShopSmart</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <header class=\"site-header\">\n      <div class=\"top-bar\">\n        <div class=\"brand\">ShopSmart</div>\n\n        <div class=\"search-bar\">\n          <input type=\"text\" placeholder=\"Search ShopSmart\" />\n          <button>🔍</button>\n        </div>\n\n        <nav class=\"top-links\">\n          <a href=\"#\">Account</a>\n          <a href=\"#\">Orders</a>\n          <a href=\"#\">Cart</a>\n        </nav>\n      </div>\n\n      <div class=\"nav-bar\">\n        <a href=\"#\">Today's Deals</a>\n        <a href=\"#\">Fashion</a>\n        <a href=\"#\">Electronics</a>\n        <a href=\"#\">Home</a>\n        <a href=\"#\">Gift Cards</a>\n      </div>\n    </header>\n\n    <main class=\"page\">\n      <section class=\"top-section\">\n        <section class=\"product-panel\">\n          <p class=\"eyebrow\">Featured deal</p>\n          <h1>Wireless Noise-Canceling Headphones</h1>\n          <p class=\"product-subtitle\">\n            Limited-time savings on a popular student favorite.\n          </p>\n\n          <div class=\"product-card\">\n            <img\n              src=\"Images/beats.jpg\"\n              alt=\"Wireless headphones\"\n              class=\"product-image\"\n            />\n\n            <div class=\"product-info\">\n              <p class=\"price\">$89.99</p>\n              <p class=\"rating\">★★★★☆ 4.4</p>\n              <p class=\"shipping\">Free delivery tomorrow</p>\n            </div>\n          </div>\n        </section>\n\n        <aside class=\"tool-panel\">\n          <section class=\"discount-card\">\n            <p class=\"tool-label\">Savings Check</p>\n            <h2>E-Commerce Discount</h2>\n            <p class=\"tool-intro\">\n              Check whether this shopper qualifies for a discount based on\n              account details and promo status.\n            </p>\n\n            <label class=\"checkbox-row\">\n              <input id=\"isStudent\" type=\"checkbox\" />\n              Student\n            </label>\n\n            <div class=\"form-group\">\n              <label for=\"age\">Age</label>\n              <input id=\"age\" type=\"number\" value=\"30\" min=\"0\" />\n            </div>\n\n            <label class=\"checkbox-row\">\n              <input id=\"hasReferral\" type=\"checkbox\" />\n              Has referral\n            </label>\n\n            <label class=\"checkbox-row\">\n              <input id=\"codeExpired\" type=\"checkbox\" />\n              Code expired\n            </label>\n\n            <button id=\"runBtn\" class=\"primary-btn\">Check discount</button>\n\n            <div class=\"result-card\">\n              <p class=\"result-label\">Discount status</p>\n              <p id=\"message\" class=\"result-message\">—</p>\n            </div>\n          </section>\n        </aside>\n      </section>\n\n      <section class=\"gallery\">\n        <article class=\"gallery-card\">\n          <h3>Gaming Accessories</h3>\n          <div class=\"gallery-grid\">\n            <div class=\"gallery-item\">\n              <img src=\"Images/mouse.jpg\" alt=\"Gaming mouse\" />\n              <p>Gaming Mouse</p>\n            </div>\n            <div class=\"gallery-item\">\n              <img src=\"Images/keyboard.jpg\" alt=\"Keyboard\" />\n              <p>Mechanical Keyboard</p>\n            </div>\n            <div class=\"gallery-item\">\n              <img src=\"Images/webcam.jpg\" alt=\"Webcam\" />\n              <p>HD Webcam</p>\n            </div>\n            <div class=\"gallery-item\">\n              <img src=\"Images/speaker.jpg\" alt=\"Speaker\" />\n              <p>Bluetooth Speaker</p>\n            </div>\n          </div>\n        </article>\n\n        <article class=\"gallery-card\">\n          <h3>Top picks for students</h3>\n          <div class=\"gallery-grid\">\n            <div class=\"gallery-item\">\n              <img src=\"Images/backpack.jpg\" alt=\"Backpack\" />\n              <p>Backpack</p>\n            </div>\n            <div class=\"gallery-item\">\n              <img src=\"Images/lamp.jpg\" alt=\"Desk lamp\" />\n              <p>Desk Lamp</p>\n            </div>\n            <div class=\"gallery-item\">\n              <img src=\"Images/tablet-stand.jpg\" alt=\"Tablet stand\" />\n              <p>Tablet Stand</p>\n            </div>\n            <div class=\"gallery-item\">\n              <img src=\"Images/charger.jpg\" alt=\"Charger\" />\n              <p>Fast Charger</p>\n            </div>\n          </div>\n        </article>\n      </section>\n    </main>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  font-family: Arial, Helvetica, sans-serif;\n  background: #eaeded;\n  color: #0f172a;\n}\n\n/* Header */\n.top-bar {\n  background: #131921;\n  color: white;\n  display: grid;\n  grid-template-columns: 180px 1fr 180px;\n  gap: 12px;\n  align-items: center;\n  padding: 10px 14px;\n}\n\n.brand {\n  font-size: 28px;\n  font-weight: 800;\n  letter-spacing: -0.02em;\n}\n\n.search-bar {\n  display: flex;\n  height: 38px;\n}\n\n.search-bar input {\n  flex: 1;\n  border: none;\n  padding: 0 12px;\n  font-size: 15px;\n  border-radius: 8px 0 0 8px;\n}\n\n.search-bar button {\n  width: 52px;\n  border: none;\n  background: #febd69;\n  font-size: 18px;\n  border-radius: 0 8px 8px 0;\n  cursor: pointer;\n}\n\n.top-links {\n  display: flex;\n  justify-content: flex-end;\n  gap: 16px;\n}\n\n.top-links a {\n  color: white;\n  text-decoration: none;\n  font-weight: 700;\n  font-size: 14px;\n}\n\n.nav-bar {\n  background: #232f3e;\n  padding: 10px 14px;\n  display: flex;\n  gap: 16px;\n  flex-wrap: wrap;\n}\n\n.nav-bar a {\n  color: white;\n  text-decoration: none;\n  font-size: 13px;\n  font-weight: 600;\n}\n\n/* Page */\n.page {\n  max-width: 1180px;\n  margin: 0 auto;\n  padding: 16px 14px 28px;\n}\n\n/* Top row: product + checker */\n.top-section {\n  display: grid;\n  grid-template-columns: minmax(0, 0.95fr) minmax(280px, 340px);\n  gap: 16px;\n  align-items: start;\n}\n\n.product-panel,\n.discount-card,\n.gallery-card {\n  background: white;\n  border-radius: 18px;\n  box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08);\n}\n\n.product-panel {\n  padding: 20px;\n  min-width: 0;\n}\n\n.tool-panel {\n  min-width: 0;\n}\n\n.discount-card {\n  padding: 18px;\n}\n\n/* Product */\n.eyebrow {\n  margin: 0 0 8px 0;\n  color: #c45500;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.product-panel h1 {\n  margin: 0 0 8px 0;\n  font-size: 28px;\n  line-height: 1.05;\n}\n\n.product-subtitle {\n  margin: 0 0 14px 0;\n  color: #475569;\n  font-size: 15px;\n  line-height: 1.4;\n}\n\n.product-card {\n  background: #f8fafc;\n  border: 1px solid #e2e8f0;\n  border-radius: 18px;\n  padding: 16px;\n}\n\n.product-image {\n  width: 100%;\n  height: 170px;\n  object-fit: cover;\n  border-radius: 14px;\n  display: block;\n  background: #ffffff;\n}\n\n.product-info {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  margin-top: 14px;\n}\n\n.price {\n  margin: 0;\n  font-size: 28px;\n  font-weight: 800;\n  color: #b12704;\n}\n\n.rating {\n  margin: 0;\n  font-size: 16px;\n  color: #0f172a;\n}\n\n.shipping {\n  margin: 0;\n  font-size: 14px;\n  color: #007600;\n  font-weight: 700;\n}\n\n/* Checker */\n.tool-label {\n  margin: 0 0 8px 0;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: #2563eb;\n}\n\n.discount-card h2 {\n  margin: 0 0 8px 0;\n  font-size: 24px;\n  line-height: 1.1;\n}\n\n.tool-intro {\n  margin: 0 0 14px 0;\n  color: #475569;\n  font-size: 13px;\n  line-height: 1.4;\n}\n\n.form-group {\n  margin-bottom: 14px;\n}\n\n.form-group label {\n  display: block;\n  margin-bottom: 6px;\n  font-size: 13px;\n  font-weight: 700;\n  color: #1e293b;\n}\n\ninput[type=\"number\"] {\n  width: 100%;\n  padding: 10px 12px;\n  border: 1px solid #cbd5e1;\n  border-radius: 10px;\n  font-size: 15px;\n  background: white;\n}\n\n.checkbox-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  margin: 0 0 14px 0;\n  font-size: 15px;\n  color: #1e293b;\n}\n\n.checkbox-row input {\n  width: 18px;\n  height: 18px;\n  margin: 0;\n}\n\n.primary-btn {\n  width: 100%;\n  border: none;\n  border-radius: 10px;\n  padding: 12px;\n  background: #ffd814;\n  color: #111827;\n  font-size: 15px;\n  font-weight: 800;\n  cursor: pointer;\n}\n\n.primary-btn:hover {\n  background: #f7ca00;\n}\n\n.result-card {\n  margin-top: 14px;\n  padding: 14px;\n  background: #f8fafc;\n  border: 1px solid #e2e8f0;\n  border-radius: 12px;\n}\n\n.result-label {\n  margin: 0 0 6px 0;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: #64748b;\n}\n\n.result-message {\n  margin: 0;\n  font-size: 18px;\n  font-weight: 800;\n}\n\n/* Gallery */\n.gallery {\n  margin-top: 18px;\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 18px;\n}\n\n.gallery-card {\n  padding: 18px;\n}\n\n.gallery-card h3 {\n  margin: 0 0 14px 0;\n  font-size: 24px;\n  line-height: 1.1;\n}\n\n.gallery-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 14px;\n}\n\n.gallery-item img {\n  width: 100%;\n  height: 110px;\n  object-fit: cover;\n  border-radius: 10px;\n  display: block;\n  background: #f1f5f9;\n}\n\n.gallery-item p {\n  margin: 6px 0 0 0;\n  font-size: 14px;\n  font-weight: 600;\n  line-height: 1.25;\n}\n\n/* Responsive */\n@media (max-width: 1000px) {\n  .top-section,\n  .gallery {\n    grid-template-columns: 1fr;\n  }\n\n  .product-image {\n    height: 220px;\n  }\n}\n\n@media (max-width: 820px) {\n  .top-bar {\n    grid-template-columns: 1fr;\n  }\n\n  .top-links {\n    justify-content: flex-start;\n  }\n}\n\n@media (max-width: 700px) {\n  .product-panel h1,\n  .discount-card h2,\n  .gallery-card h3 {\n    font-size: 24px;\n  }\n\n  .page {\n    padding: 14px 10px 24px;\n  }\n\n  .top-bar,\n  .nav-bar {\n    padding-left: 10px;\n    padding-right: 10px;\n  }\n\n  .gallery-grid {\n    grid-template-columns: 1fr;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "// Selectors\nconst isStudent = document.getElementById(\"isStudent\");\nconst age = document.getElementById(\"age\");\nconst hasReferral = document.getElementById(\"hasReferral\");\nconst codeExpired = document.getElementById(\"codeExpired\");\nconst message = document.getElementById(\"message\");\nconst runBtn = document.getElementById(\"runBtn\");\n\n// Function to check discount\nconst eligible = () => {\n  const student = isStudent.checked;\n  const ageValue = Number(age.value);\n  const referral = hasReferral.checked;\n  const expired = codeExpired.checked;\n\n  if (student) {\n    if (!expired) {\n      message.textContent = \"✅ Discount applied!\";\n      message.style.color = \"green\";\n    } else {\n      message.textContent = \"❌ No discount.\";\n      message.style.color = \"red\";\n    }\n  } else {\n    if (ageValue >= 65) {\n      if (!expired) {\n        message.textContent = \"✅ Discount applied!\";\n        message.style.color = \"green\";\n      } else {\n        message.textContent = \"❌ No discount.\";\n        message.style.color = \"red\";\n      }\n    } else {\n      if (referral) {\n        if (!expired) {\n          message.textContent = \"✅ Discount applied!\";\n          message.style.color = \"green\";\n        } else {\n          message.textContent = \"❌ No discount.\";\n          message.style.color = \"red\";\n        }\n      } else {\n        message.textContent = \"❌ No discount.\";\n        message.style.color = \"red\";\n      }\n    }\n  }\n};\n\n// Event listener\nrunBtn.addEventListener(\"click\", eligible);\n\n// Initial state\nmessage.textContent = \"—\";",
          "folderId": "0",
          "active": true
        },
