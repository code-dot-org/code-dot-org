<Weblab2>
  <config><![CDATA[{
  "published": true,
  "game_id": 74,
  "created_at": "2026-11-03T04:29:23.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": "true",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Look under the hood</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"widget\" id=\"widget\">\n    <div class=\"error-banner\" id=\"error\" role=\"alert\" hidden></div>\n    <h1 class=\"visually-hidden\" data-text=\"intro.title\"></h1>\n\n    <section class=\"intro-screen\" id=\"introScreen\" hidden>\n      <span class=\"tag\" data-text=\"intro.tag\"></span>\n      <h2 class=\"intro-title\" data-text=\"intro.heading\"></h2>\n      <p class=\"intro-lead\" id=\"introLead\"></p>\n      <ol class=\"intro-steps\">\n        <li data-text=\"intro.steps.0\"></li>\n        <li data-text=\"intro.steps.1\"></li>\n        <li data-text=\"intro.steps.2\"></li>\n      </ol>\n      <button type=\"button\" class=\"btn btn-primary\" id=\"startButton\" data-text=\"intro.start\"></button>\n    </section>\n\n    <section class=\"demo-screen\" id=\"demoScreen\" hidden>\n      <p class=\"demo-step\" id=\"demoStep\"></p>\n      <div class=\"demo-visual\" id=\"demoVisual\"></div>\n      <p class=\"demo-text\" id=\"demoText\"></p>\n      <div>\n        <button type=\"button\" class=\"btn btn-outline\" id=\"demoNext\"></button>\n      </div>\n    </section>\n\n    <section class=\"activity\" id=\"activity\" hidden>\n      <header class=\"intro\">\n        <div class=\"intro-line\">\n          <span class=\"tag\" data-text=\"intro.tag\"></span>\n          <p class=\"do-this\"><strong data-text=\"doThis.label\"></strong> <span id=\"doThis\"></span></p>\n          <span class=\"progress\" id=\"progress\"></span>\n        </div>\n      </header>\n\n      <div id=\"splitHost\"></div>\n\n      <div class=\"foot\">\n        <p class=\"status\" id=\"status\"></p>\n        <button type=\"button\" class=\"btn btn-primary\" id=\"nextButton\" data-text=\"next\" hidden></button>\n        <div class=\"finish-area\" id=\"finishArea\" hidden>\n          <p class=\"end-card\" id=\"endCard\"></p>\n          <button type=\"button\" class=\"btn btn-primary\" id=\"finishButton\" data-text=\"finish\"></button>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"visually-hidden\" id=\"announcer\" aria-live=\"polite\" aria-atomic=\"true\"></div>\n\n    <section class=\"takeaway-page\" id=\"takeaway\" aria-labelledby=\"takeaway-title\" tabindex=\"-1\" hidden>\n      <h2 class=\"intro-title\" id=\"takeaway-title\" data-text=\"takeaway.title\"></h2>\n      <p class=\"intro-lead\" data-text=\"takeaway.text\"></p>\n      <ul class=\"takeaway-labels\" id=\"takeawayLabels\"></ul>\n      <p class=\"takeaway-last\"><strong data-text=\"takeaway.last\"></strong></p>\n    </section>\n  </main>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "/* ==================================================================\n   CADS tokens\n   Copied from the CADS runtime (@moshebari/cads-react, manifest 0.1.0).\n   Light theme only. Only the tokens this widget uses are copied. Do not\n   edit this block. Build only with these variables below it.\n   ================================================================== */\n\n:root {\n  --brand-purple-5: #e4e2f8;\n  --brand-purple-50: #4c42cf;\n  --brand-purple-80: #2b1e9f;\n  --brand-purple-90: #1d1590;\n  --brand-orange-5: #ffe3ce;\n  --brand-orange-70: #b34800;\n  --brand-pink-5: #fbdae8;\n  --brand-pink-70: #b5004f;\n  --neutral-base-black: #121212;\n  --neutral-base-white: #ffffff;\n  --neutral-gray-5: #f1f2f4;\n  --neutral-gray-10: #e1e3e6;\n  --neutral-gray-20: #d3d6da;\n  --neutral-gray-30: #b7bcc2;\n  --neutral-gray-40: #9ea5ad;\n  --neutral-gray-70: #596069;\n  --neutral-gray-90: #363b40;\n  --sentiment-error-5: #ffdada;\n  --sentiment-error-20: #f69898;\n  --sentiment-error-70: #b30f0f;\n  --sentiment-information-5: #d5efff;\n  --sentiment-information-30: #6fcaff;\n  --sentiment-information-70: #1570d1;\n  --sentiment-information-90: #0b43a3;\n  --sentiment-information-95: #06338d;\n  --sentiment-warning-5: #fff5da;\n  --sentiment-warning-30: #ffd35c;\n  --sentiment-warning-50: #f5c000;\n  --sentiment-warning-95: #654500;\n  --background-neutral-primary: var(--neutral-base-white);\n  --background-neutral-secondary: var(--neutral-gray-5);\n  --background-brand-primary: var(--brand-purple-50);\n  --background-brand-light: var(--brand-purple-5);\n  --background-brand-strong: var(--brand-purple-80);\n  --background-error-light: var(--sentiment-error-5);\n  --background-warning-light: var(--sentiment-warning-5);\n  --background-warning-mid: var(--sentiment-warning-30);\n  --background-info-light: var(--sentiment-information-5);\n  --background-accent-orange-light: var(--brand-orange-5);\n  --background-accent-pink-light: var(--brand-pink-5);\n  --border-neutral-primary: var(--neutral-gray-20);\n  --border-neutral-secondary: var(--neutral-gray-40);\n  --border-neutral-solid: var(--neutral-base-black);\n  --border-brand-primary: var(--brand-purple-50);\n  --border-error-mid: var(--sentiment-error-20);\n  --border-warning-primary: var(--sentiment-warning-50);\n  --border-info-mid: var(--sentiment-information-30);\n  --border-info-strong: var(--sentiment-information-70);\n  --border-focused-primary: var(--brand-purple-50);\n  --border-accent-orange-strong: var(--brand-orange-70);\n  --border-accent-pink-strong: var(--brand-pink-70);\n  --text-neutral-primary: var(--neutral-base-black);\n  --text-neutral-secondary: var(--neutral-gray-90);\n  --text-neutral-quaternary: var(--neutral-gray-70);\n  --text-neutral-white-fixed: var(--neutral-base-white);\n  --text-brand-secondary: var(--brand-purple-90);\n  --text-error-secondary: var(--sentiment-error-70);\n  --text-info-secondary: var(--sentiment-information-90);\n  --font-family-main: \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-family-heading: \"Space Grotesk\", \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-family-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\n  --font-weight-semi-bold: 600;\n  --font-weight-bold: 700;\n  --text-heading-md: 1.5rem;\n  --text-heading-xs: 1.25rem;\n  --leading-heading-md: 2rem;\n  --leading-heading-xs: 1.75rem;\n  --text-body-lg: 1.125rem;\n  --text-body-md: 1rem;\n  --leading-body-md: 1.5rem;\n  --tracking-overline: .08em;\n  --shape-sm: .375rem;\n  --shape-md: .5rem;\n  --shape-round: 62.4375rem;\n  --spacing-p-xxs: .5rem;\n  --spacing-p-xs: 1rem;\n  --spacing-p-s: 1.5rem;\n  --duration-short: .15s;\n  --duration-medium: .2s;\n  --easing-standard: cubic-bezier(.4, 0, .2, 1);\n  --motion-press-scale: .97;\n  --motion-press-duration: .15s;\n  --motion-press-easing: cubic-bezier(.23, 1, .32, 1);\n  --transition-colors: background-color var(--duration-short) var(--easing-standard), color var(--duration-short) var(--easing-standard), border-color var(--duration-short) var(--easing-standard), box-shadow var(--duration-short) var(--easing-standard), opacity var(--duration-short) var(--easing-standard);\n  --transition-press: transform var(--motion-press-duration) var(--motion-press-easing);\n  --ring: var(--border-focused-primary);\n  --control-height-medium: 40px;\n}\n\n/* ===== end CADS tokens ===== */\n\n/* ==================================================================\n   Look under the hood component styles\n\n   What is CADS\n   - Every color, type size, radius, spacing step and motion value below\n     comes from the CADS tokens above. No hard-coded colors.\n   - Spacing is 8 and 16 pixels (--spacing-p-xxs and --spacing-p-xs).\n   - Search field look (40px high, 1px border, --shape-md radius, focus ring).\n   - Focus ring: 2px --ring, never removed.\n   - Overline labels, the Tag look for \"Practice\", and the white card with\n     a 1px hairline and --shape-md radius.\n   - Control heights from --control-height-* (40px buttons and search field).\n\n   What was rebuilt from the manifest\n   - The search field is a native search input styled like the CADS\n     TextInput. The CADS runtime is not loaded.\n   - The primary and outlined Button looks for Start, Next, Try it and\n     Finish.\n   - Glowing lines use the CADS warning tints so they read as highlighted.\n\n   What was approximated\n   - Geist and Space Grotesk are named by the tokens but are not loaded.\n     The tokens' own fallback fonts show instead.\n   - Icons are small inline SVGs drawn to match the Font Awesome weight.\n   - The sample page and code are illustrations built only from CADS\n     tokens. They are not CADS components.\n   - Text is at least 16px everywhere, including the code.\n   ================================================================== */\n\n*,\n*::before,\n*::after { box-sizing: border-box; }\n\n[hidden] { display: none !important; }\n\nhtml { font-size: 100%; }\n\nbody {\n  margin: 0;\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-md);\n  line-height: var(--leading-body-md);\n  color: var(--text-neutral-primary);\n  background: var(--background-neutral-primary);\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.nowrap { white-space: nowrap; }\n\n.icon {\n  flex: none;\n  width: 1.5rem;\n  height: 1.5rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* Language colors. HTML is orange, CSS is purple and JavaScript is pink. Green\n   and red are not used. */\n.is-t1 { --tone-line: var(--border-accent-orange-strong); --tone-bg: var(--background-accent-orange-light); }\n.is-t2 { --tone-line: var(--border-brand-primary); --tone-bg: var(--background-brand-light); }\n.is-t3 { --tone-line: var(--border-accent-pink-strong); --tone-bg: var(--background-accent-pink-light); }\n.is-t4 { --tone-line: var(--border-info-strong); --tone-bg: var(--background-info-light); }\n\n/* ---------- Page ---------- */\n\n.widget {\n  max-width: 60rem;\n  margin: 0 auto;\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs) var(--spacing-p-xs);\n}\n\n.error-banner {\n  margin-block-end: var(--spacing-p-xs);\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border: 1px solid var(--border-error-mid);\n  border-radius: var(--shape-md);\n  background: var(--background-error-light);\n  color: var(--text-error-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.tag {\n  display: inline-block;\n  padding: 0 var(--spacing-p-xxs);\n  border-radius: var(--shape-sm);\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: var(--leading-body-md);\n}\n\n.intro-screen,\n.takeaway-page {\n  display: grid;\n  justify-items: start;\n  align-content: start;\n  gap: var(--spacing-p-xs);\n  max-width: 32rem;\n}\n\n.intro-title {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-md);\n  font-weight: var(--font-weight-bold);\n  line-height: var(--leading-heading-md);\n}\n\n.intro-lead { margin: 0; }\n\n.intro-steps {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  margin: 0;\n  padding-inline-start: var(--spacing-p-s);\n}\n\n.intro-steps li::marker { font-weight: var(--font-weight-bold); }\n\n.takeaway-labels {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-p-xxs) var(--spacing-p-xs);\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.takeaway-label {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.takeaway-label .icon { color: var(--tone-line); }\n\n.takeaway-last { margin: 0; }\n\n.takeaway-page:focus-visible {\n  outline: 2px solid var(--ring);\n  outline-offset: 2px;\n}\n\n/* ---------- Buttons ---------- */\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: var(--control-height-medium);\n  padding: 0 var(--spacing-p-xs);\n  border: 1px solid transparent;\n  border-radius: var(--shape-md);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n  transition: var(--transition-colors), var(--transition-press);\n}\n\n.btn:active { transform: scale(var(--motion-press-scale)); }\n\n.btn-primary {\n  background: var(--background-brand-primary);\n  color: var(--text-neutral-white-fixed);\n}\n\n.btn-primary:hover { background: var(--background-brand-strong); }\n\n.btn-outline {\n  background: var(--background-neutral-primary);\n  border-color: var(--border-neutral-solid);\n  color: var(--text-neutral-primary);\n}\n\n.btn-outline:hover { background: var(--background-neutral-secondary); }\n\n.btn:focus-visible,\n.opt:focus-visible,\n.slider:focus-visible {\n  outline: 2px solid var(--ring);\n  outline-offset: 2px;\n}\n\n.button-row { display: flex; }\n\n/* ---------- Opening panels ---------- */\n\n.demo-screen {\n  display: grid;\n  gap: var(--spacing-p-xs);\n  justify-items: start;\n}\n\n.demo-step {\n  margin: 0;\n  font-weight: var(--font-weight-semi-bold);\n  letter-spacing: var(--tracking-overline);\n  text-transform: uppercase;\n  color: var(--text-neutral-quaternary);\n}\n\n.demo-visual { width: 100%; min-height: 15rem; }\n\n.demo-text {\n  margin: 0;\n  min-height: 3rem;\n  font-size: var(--text-body-lg);\n  line-height: var(--leading-body-md);\n}\n\n.layers {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  max-width: 24rem;\n}\n\n.layer {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  padding: var(--spacing-p-xs);\n  border: 1px solid var(--tone-line);\n  border-radius: var(--shape-md);\n  background: var(--tone-bg);\n  font-weight: var(--font-weight-bold);\n  margin-inline-start: calc(var(--depth) * var(--spacing-p-xs));\n}\n\n.layer .icon { color: var(--tone-line); }\n\n/* ---------- Activity ---------- */\n\n.intro { margin-block-end: var(--spacing-p-xs); }\n\n.intro-line {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: var(--spacing-p-xxs);\n}\n\n.do-this { margin: 0; flex: 1 1 auto; color: var(--text-neutral-primary); }\n\n/* The thing to find stands out so students spot it first */\n.target {\n  padding: 0 var(--spacing-p-xxs);\n  border-bottom: 2px solid var(--border-brand-primary);\n  border-radius: var(--shape-sm);\n  background: var(--background-brand-light);\n  font-weight: var(--font-weight-bold);\n  -webkit-box-decoration-break: clone;\n  box-decoration-break: clone;\n}\n\n.progress {\n  margin-inline-start: auto;\n  font-weight: var(--font-weight-semi-bold);\n  color: var(--text-neutral-secondary);\n  white-space: nowrap;\n}\n\n.card {\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n}\n\n/* Split view: the page on the left, the code on the right */\n.split {\n  position: relative;\n  display: grid;\n  grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);\n  gap: var(--spacing-p-s);\n  align-items: start;\n}\n\n.split-page,\n.split-code { min-width: 0; }\n\n.split-code { display: grid; gap: var(--spacing-p-xxs); }\n\n.search-row {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n}\n\n.search-label {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  font-weight: var(--font-weight-semi-bold);\n  white-space: nowrap;\n}\n\n.search-input {\n  flex: 1 1 auto;\n  min-width: 0;\n  min-height: var(--control-height-medium);\n  padding: 0 var(--spacing-p-xxs);\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font: inherit;\n}\n\n.search-input:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }\n\n.code-box {\n  padding: var(--spacing-p-xxs);\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-secondary);\n  font-family: var(--font-family-mono);\n  font-size: var(--text-body-md);\n  line-height: 1.25rem;\n}\n\n.code-head {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  margin: 0;\n  padding: 0 var(--spacing-p-xxs);\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-bold);\n  line-height: 1.25rem;\n}\n\n.code-head:not(:first-child) {\n  margin-block-start: 0;\n  border-block-start: 1px solid var(--border-neutral-secondary);\n}\n\n.code-head .icon { width: 1rem; height: 1rem; color: var(--tone-line); }\n\n.code-line {\n  display: grid;\n  grid-template-columns: 1.5rem minmax(0, 1fr);\n  gap: var(--spacing-p-xxs);\n  width: 100%;\n  margin: 0;\n  padding: 0 var(--spacing-p-xxs);\n  border: 0;\n  border-radius: var(--shape-sm);\n  background: transparent;\n  color: var(--text-neutral-primary);\n  font: inherit;\n  text-align: left;\n}\n\nbutton.code-line { cursor: default; }\nbutton.code-line:disabled { color: var(--text-neutral-primary); }\n\n.ln {\n  color: var(--tone-line);\n  font-weight: var(--font-weight-bold);\n  text-align: right;\n}\n\n.code-text { white-space: pre-wrap; overflow-wrap: anywhere; }\n\n.hit {\n  border-radius: var(--shape-sm);\n  background: var(--background-warning-mid);\n  color: var(--text-neutral-primary);\n}\n\n.code-line.is-glow {\n  background: var(--background-warning-light);\n  outline: 1px solid var(--border-warning-primary);\n  outline-offset: -1px;\n  animation: glow 1.6s ease-in-out 2;\n}\n\n/* On highlighted lines the number turns dark so it stays easy to read */\n.code-line.is-glow .ln,\n.code-line.is-selected .ln { color: var(--text-neutral-primary); }\n\nbutton.code-line.is-glow { cursor: pointer; }\nbutton.code-line.is-glow:hover { background: var(--background-warning-mid); }\n\nbutton.code-line:focus-visible {\n  outline: 2px solid var(--ring);\n  outline-offset: 2px;\n}\n\n.code-line.is-selected {\n  border-inline-start: 4px solid var(--border-brand-primary);\n  background: var(--background-brand-light);\n  outline-color: var(--border-brand-primary);\n}\n\n/* The glowing connector between a code line and its section */\n.connector {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  overflow: visible;\n  pointer-events: none;\n}\n\n.connector-glow {\n  fill: none;\n  stroke: var(--background-brand-light);\n  stroke-width: 10;\n  stroke-linecap: round;\n  opacity: .9;\n}\n\n.connector-line {\n  fill: none;\n  stroke: var(--border-brand-primary);\n  stroke-width: 3;\n  stroke-linecap: round;\n  stroke-dasharray: 8 6;\n  animation: flow 1s linear infinite;\n}\n\n.connector-dot { fill: var(--border-brand-primary); }\n\n/* The sample page */\n.mini {\n  overflow: hidden;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n}\n\n.site-bar {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  height: 2rem;\n  padding: 0 var(--spacing-p-xxs);\n  border-bottom: 1px solid var(--border-neutral-primary);\n  background: var(--background-neutral-secondary);\n}\n\n.site-dot {\n  width: var(--spacing-p-xxs);\n  height: var(--spacing-p-xxs);\n  border-radius: var(--shape-round);\n  background: var(--neutral-gray-30);\n}\n\n.site-url {\n  padding: 0 var(--spacing-p-xxs);\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-quaternary);\n  line-height: 1.5rem;\n}\n\n.mini-body {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  padding: var(--spacing-p-xxs);\n}\n\n.sec {\n  position: relative;\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  justify-items: start;\n  padding: var(--spacing-p-xs);\n  border: 1px dashed var(--border-neutral-secondary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n  transition: background-color var(--duration-medium) var(--easing-standard);\n}\n\n.sec-tag {\n  padding: 0 var(--spacing-p-xxs);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-secondary);\n  color: var(--text-neutral-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.mini-title {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-xs);\n  font-weight: var(--font-weight-bold);\n  line-height: var(--leading-heading-xs);\n}\n\n.mini-btn {\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border: 1px solid var(--border-neutral-solid);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.mini-result { margin: 0; color: var(--text-neutral-secondary); }\n\n/* CSS makes it look styled */\n.mini[data-mode=\"styled\"] .sec[data-section=\"hero\"],\n.mini[data-mode=\"js\"] .sec[data-section=\"hero\"] {\n  border-style: solid;\n  border-color: var(--sentiment-warning-30);\n  background: var(--sentiment-warning-30);\n  color: var(--sentiment-warning-95);\n}\n\n.mini[data-mode=\"styled\"] .mini-btn,\n.mini[data-mode=\"js\"] .mini-btn {\n  border-color: transparent;\n  background: var(--background-brand-primary);\n  color: var(--text-neutral-white-fixed);\n}\n\n/* The plant shop page */\n.mini-links { display: flex; gap: var(--spacing-p-xs); }\n.mini-link { font-weight: var(--font-weight-semi-bold); text-decoration: underline; }\n.mini-note { margin: 0; padding: var(--spacing-p-xs) var(--spacing-p-xxs); font-weight: var(--font-weight-semi-bold); }\n.mini-foot { margin: 0; }\n\n.mini[data-mode=\"styled\"] .sec[data-section=\"menu\"] {\n  border-style: solid;\n  border-color: var(--sentiment-information-95);\n  background: var(--sentiment-information-95);\n  color: var(--neutral-base-white);\n}\n\n.mini[data-mode=\"styled\"] .sec[data-section=\"footer\"] {\n  border-style: solid;\n  border-color: var(--neutral-gray-10);\n  background: var(--neutral-gray-10);\n  color: var(--neutral-gray-90);\n}\n\n/* The section students are asked to find */\n.sec.is-target {\n  outline: 3px dashed var(--border-brand-primary);\n  outline-offset: 2px;\n}\n\n/* A section lights up when its code line is clicked */\n/* A lit section turns the dashed outline solid */\n.sec.is-lit {\n  outline: 3px solid var(--border-brand-primary);\n  outline-offset: 2px;\n}\n\n.sec.is-lit .sec-tag {\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n}\n\n.flash { animation: flash-fade 1s ease-out forwards; }\n\n.foot {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--spacing-p-xs);\n  margin-block-start: var(--spacing-p-xs);\n}\n\n.status {\n  display: flex;\n  gap: var(--spacing-p-xxs);\n  flex: 1 1 auto;\n  align-items: center;\n  min-height: 3rem;\n  margin: 0;\n  padding-inline-start: var(--spacing-p-xxs);\n  border-inline-start: 4px solid var(--border-neutral-secondary);\n}\n\n.status[data-ok=\"true\"] { border-inline-color: var(--border-brand-primary); }\n\n.status .icon { margin-block-start: 0; }\n\n.finish-area {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xs);\n}\n\n.end-card {\n  margin: 0;\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border: 1px solid var(--border-info-mid);\n  border-radius: var(--shape-md);\n  background: var(--background-info-light);\n  color: var(--text-info-secondary);\n}\n\n/* ---------- Motion ---------- */\n\n@keyframes glow {\n  0%, 100% { background: var(--background-warning-light); }\n  50% { background: var(--background-warning-mid); }\n}\n\n@keyframes flow {\n  to { stroke-dashoffset: -28; }\n}\n\n@keyframes flash-fade {\n  from { outline-offset: 10px; }\n  to { outline-offset: 2px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n}\n\n/* ---------- Narrow screens ---------- */\n\n@media (max-width: 47.99rem) {\n  .split { grid-template-columns: minmax(0, 1fr); }\n  .foot { flex-direction: column; }\n  .progress { margin-inline-start: 0; }\n  .finish-area { flex-direction: column; align-items: flex-start; }\n  .search-row { flex-wrap: wrap; }\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "'use strict';\n\n/* ------------------------------------------------------------------\n   Look under the hood\n   Skill: Language of web dev.\n   Students search sample code for a section's name, click a glowing line\n   to see which section of the page lights up, then find the JavaScript\n   line that holds a list of options.\n   ------------------------------------------------------------------ */\n\nconst CONFIG = {\n  // Intro page with a Start button. Address override: ?intro=0\n  showIntro: true,\n  // Five opening panels after Start. Address override: ?demo=0\n  showDemo: true,\n  // Fewest letters that make lines glow\n  minSearchLength: 2,\n  flashMilliseconds: 1000,\n  searchAnnounceDelay: 600,\n  completeEventName: 'widget:complete',\n  completeMessageType: 'widget-complete'\n};\n\n/* ---------- Words ---------- */\n\nconst T = {\n  intro: {\n    title: 'Look under the hood',\n    tag: 'Practice',\n    heading: 'Find a section in the code',\n    term: 'Section name',\n    definition: ' is a word in the code, like hero, that labels one part of a page. Search for it to find that part.',\n    steps: [\n      'Search the code for a section name.',\n      'Click a glowing line to see its section.',\n      'Find the line that holds a list.'\n    ],\n    start: 'Start'\n  },\n  demo: {\n    stepOf: (n, total) => `Step ${n} of ${total}`,\n    next: 'Next',\n    start: 'Try it',\n    panels: [\n      'A page is built from three languages.',\n      'HTML says what is on the page.',\n      'CSS says how it looks.',\n      'JavaScript says what it does.',\n      'Every section has a name in the code. Find the name to find the section.'\n    ]\n  },\n  doThis: {\n    label: 'Do This:',\n    /* [words before, the thing to find, words after] */\n    tasks: [\n      ['Find ', 'the hero', ', the big top section.'],\n      ['Find ', 'the call-to-action', ', the button that asks visitors to act.'],\n      ['Find the JavaScript line that holds ', 'the list of options', '.'],\n      ['New page. Find ', 'the footer', ', the bottom section.'],\n      ['Find ', 'the menu', ', the row of links at the top.'],\n      ['Find the JavaScript line that holds ', 'the list of plants', '.']\n    ]\n  },\n  progress: (n, total) => `Step ${n} of ${total}`,\n  search: {\n    label: 'Search the code',\n    empty: 'Type in the search bar to make matching lines glow.',\n    placeholders: [\n      'Type its name',\n      'Type words you see on the button',\n      'Type a word to search',\n      'Type its name',\n      'Type words you see in the menu',\n      'Type a plant you see'\n    ],\n    none: (q) => `No lines match “${q}”. Try another word.`,\n    one: '1 line matches. Click it.',\n    many: (n) => `${n} lines match. Click one.`\n  },\n  messages: {\n    found: {\n      hero: 'This line belongs to the hero. See it light up on the page.',\n      cta: 'This line belongs to the call-to-action. See it light up on the page.',\n      options: 'This line holds the list of options. A list is a group of items in square brackets.',\n      footer: 'This line belongs to the footer. See it light up on the page.',\n      menu: 'This line belongs to the menu. See it light up on the page.',\n      plants: 'This line holds the list of plants. A list is a group of items in square brackets.'\n    },\n    otherSection: (name, target) => `This line belongs to the ${name}. Try another search to find the ${target}.`,\n    notSection: 'This line is JavaScript. It does not belong to a section. Try another search.',\n    notJs: (lang) => `This line is ${lang}. The list is in JavaScript.`,\n    usesList: 'This line uses the list. The line that holds the list has the items in square brackets.'\n  },\n  sections: {\n    hero: 'hero',\n    cta: 'call-to-action',\n    menu: 'menu',\n    footer: 'footer'\n  },\n  pages: [\n    {\n      url: 'lunch.web',\n      label: 'Sample page: lunch picker',\n      title: 'Lunch Picker',\n      button: 'Pick my lunch',\n      result: 'Your lunch: Tacos',\n      resultEmpty: 'Your lunch: ?',\n      tags: { hero: 'Hero', cta: 'Call to action' }\n    },\n    {\n      url: 'plants.web',\n      label: 'Sample page: plant shop',\n      links: ['Shop', 'Care tips'],\n      note: 'Plant of the day: Fern',\n      footer: 'Open Sat and Sun',\n      tags: { menu: 'Menu', footer: 'Footer' }\n    }\n  ],\n  inCode: (name) => `In the code: ${name}`,\n  languages: { html: 'HTML', css: 'CSS', js: 'JavaScript' },\n  layers: ['JavaScript', 'CSS', 'HTML'],\n  next: 'Next',\n  endCard: 'Front-end developers search code the same way.',\n  finish: 'Finish',\n  takeaway: {\n    title: 'Takeaway: Search the code for a section’s name to find the section.',\n    text: 'Every section of a page has a name in the code. Search for that name, or for words you see on the page, and you land on the lines that build it.',\n    last: 'Press Continue to go to your project.'\n  },\n  aria: {\n    code: 'Sample code',\n    connector: 'Connector from the code line to its section'\n  },\n  error: 'Something went wrong while loading this activity. Try reloading the page.'\n};\n\n/* ---------- Content ---------- */\n\n/*\n  The sample code for each page. Each line belongs to a language and, for\n  HTML and CSS, to one section of the page. A line with role \"list\" holds\n  the list. Line numbers restart in each language, like separate files.\n*/\nconst CODE = [\n  [\n    { lang: 'html', text: '<section id=\"hero\">', section: 'hero' },\n    { lang: 'html', text: '  <h1>Lunch Picker</h1>', section: 'hero' },\n    { lang: 'html', text: '</section>', section: 'hero' },\n    { lang: 'html', text: '<section id=\"cta\">', section: 'cta' },\n    { lang: 'html', text: '  <button>Pick my lunch</button>', section: 'cta' },\n    { lang: 'html', text: '</section>', section: 'cta' },\n    { lang: 'css', text: '#hero { background: gold; }', section: 'hero' },\n    { lang: 'css', text: '#cta button { color: white; }', section: 'cta' },\n    { lang: 'js', text: 'const options = [\"Tacos\", \"Pizza\", \"Salad\"];', role: 'list' },\n    { lang: 'js', text: 'function pickLunch() {' },\n    { lang: 'js', text: '  const i = randomNumber(options.length);' },\n    { lang: 'js', text: '  show(options[i]);' },\n    { lang: 'js', text: '}' }\n  ],\n  [\n    { lang: 'html', text: '<nav id=\"menu\">', section: 'menu' },\n    { lang: 'html', text: '  <a href=\"#\">Shop</a>', section: 'menu' },\n    { lang: 'html', text: '  <a href=\"#\">Care tips</a>', section: 'menu' },\n    { lang: 'html', text: '</nav>', section: 'menu' },\n    { lang: 'html', text: '<footer id=\"footer\">', section: 'footer' },\n    { lang: 'html', text: '  <p>Open Sat and Sun</p>', section: 'footer' },\n    { lang: 'html', text: '</footer>', section: 'footer' },\n    { lang: 'css', text: '#menu { background: navy; }', section: 'menu' },\n    { lang: 'css', text: '#footer { color: gray; }', section: 'footer' },\n    { lang: 'js', text: 'const plants = [\"Fern\", \"Cactus\", \"Mint\"];', role: 'list' },\n    { lang: 'js', text: 'function showPlant(n) {' },\n    { lang: 'js', text: '  show(plants[n]);' },\n    { lang: 'js', text: '}' }\n  ]\n];\n\n/* Language colors and icons: HTML is orange, CSS is purple, JavaScript is pink. */\nconst LANGS = {\n  html: { icon: 'code', tone: 1 },\n  css: { icon: 'palette', tone: 2 },\n  js: { icon: 'pointer', tone: 3 }\n};\n\n/*\n  The six tasks, three on each page. A \"section\" task is found by clicking\n  any line that belongs to that section. A \"list\" task is found by clicking\n  the line that holds the list.\n*/\nconst TASKS = [\n  { page: 0, type: 'section', section: 'hero', found: 'hero' },\n  { page: 0, type: 'section', section: 'cta', found: 'cta' },\n  { page: 0, type: 'list', found: 'options' },\n  { page: 1, type: 'section', section: 'footer', found: 'footer' },\n  { page: 1, type: 'section', section: 'menu', found: 'menu' },\n  { page: 1, type: 'list', found: 'plants' }\n];\n\n/* The five opening panels. */\nconst PANELS = [\n  { kind: 'layers' },\n  { kind: 'split', mode: 'html', langs: ['html'] },\n  { kind: 'split', mode: 'styled', langs: ['css'] },\n  { kind: 'split', mode: 'js', langs: ['js'] },\n  { kind: 'split', mode: 'styled', langs: ['html'], lit: 'hero', selected: 0, query: 'hero' }\n];\n\n/* ---------- Icons (inline SVG, drawn with strokes) ---------- */\n\nconst ICONS = {\n  code: [['path', { d: 'M8 7l-5 5 5 5M16 7l5 5-5 5' }]],\n  palette: [\n    ['path', { d: 'M12 3a9 9 0 1 0 0 18c1.2 0 2-.8 2-1.8 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-1 .8-1.8 1.8-1.8H17a4 4 0 0 0 4-4c0-4.4-4-8-9-8z' }],\n    ['circle', { cx: 7.5, cy: 11, r: 1 }],\n    ['circle', { cx: 10, cy: 7, r: 1 }],\n    ['circle', { cx: 15, cy: 7, r: 1 }]\n  ],\n  pointer: [['path', { d: 'M5 3l14 7-6 2-2 6z' }]],\n  search: [\n    ['circle', { cx: 11, cy: 11, r: 6 }],\n    ['path', { d: 'M16 16l5 5' }]\n  ],\n  check: [['path', { d: 'M5 12.5l4.5 4.5L19 7.5' }]],\n  info: [\n    ['circle', { cx: 12, cy: 12, r: 8 }],\n    ['path', { d: 'M12 11v5M12 8v.5' }]\n  ]\n};\n\n/* ---------- Helpers ---------- */\n\nconst SVG_NS = 'http://www.w3.org/2000/svg';\n\nfunction h(tag, props, ...kids) {\n  const el = document.createElement(tag);\n  if (props) {\n    for (const [key, value] of Object.entries(props)) {\n      if (value === false || value === null || value === undefined) continue;\n      if (key === 'class') el.className = value;\n      else if (key === 'text') el.textContent = value;\n      else el.setAttribute(key, value === true ? '' : value);\n    }\n  }\n  for (const kid of kids) if (kid) el.append(kid);\n  return el;\n}\n\nfunction s(tag, attrs) {\n  const el = document.createElementNS(SVG_NS, tag);\n  if (attrs) for (const [key, value] of Object.entries(attrs)) el.setAttribute(key, String(value));\n  return el;\n}\n\nfunction icon(name, extraClass) {\n  const svg = s('svg', {\n    viewBox: '0 0 24 24',\n    class: extraClass ? `icon ${extraClass}` : 'icon',\n    'aria-hidden': 'true',\n    focusable: 'false'\n  });\n  for (const [tag, attrs] of ICONS[name]) svg.append(s(tag, attrs));\n  return svg;\n}\n\nfunction formatNumber(value) {\n  try {\n    return new Intl.NumberFormat(document.documentElement.lang || 'en').format(value);\n  } catch (err) {\n    return String(value);\n  }\n}\n\nfunction readParams() {\n  try {\n    const params = new URLSearchParams(window.location.search);\n    return { demo: params.get('demo'), intro: params.get('intro') };\n  } catch (err) {\n    return { demo: null, intro: null };\n  }\n}\n\n/* ---------- State ---------- */\n\nconst els = {};\nconst state = {\n  stage: 'intro',\n  task: 0,\n  pageIndex: 0,\n  query: '',\n  selected: null,\n  found: false\n};\nlet demoStep = 0;\nlet completionReported = false;\nlet announceTimer = null;\nlet drawn = null;\n\n/* ---------- Sample page ---------- */\n\nfunction sec(key, tagText, ...kids) {\n  return h('section', { class: 'sec', 'data-section': key, 'data-tag': tagText },\n    h('span', { class: 'sec-tag', text: tagText }), ...kids);\n}\n\nfunction buildPage(pageIndex, mode) {\n  const info = T.pages[pageIndex];\n  let sections;\n  if (pageIndex === 0) {\n    sections = [\n      sec('hero', info.tags.hero, h('p', { class: 'mini-title', text: info.title })),\n      sec('cta', info.tags.cta,\n        h('span', { class: 'mini-btn', text: info.button }),\n        h('p', { class: 'mini-result', text: mode === 'js' ? info.result : info.resultEmpty }))\n    ];\n  } else {\n    const links = h('div', { class: 'mini-links' });\n    info.links.forEach((text) => links.append(h('span', { class: 'mini-link', text })));\n    sections = [\n      sec('menu', info.tags.menu, links),\n      h('p', { class: 'mini-note', text: info.note }),\n      sec('footer', info.tags.footer, h('p', { class: 'mini-foot', text: info.footer }))\n    ];\n  }\n  return h('div', { class: 'mini', 'data-mode': mode, role: 'group', 'aria-label': info.label },\n    h('div', { class: 'site-bar', 'aria-hidden': 'true' },\n      h('span', { class: 'site-dot' }), h('span', { class: 'site-dot' }), h('span', { class: 'site-dot' }),\n      h('span', { class: 'site-url', text: info.url })),\n    h('div', { class: 'mini-body' }, ...sections));\n}\n\nfunction lightSection(page, name) {\n  page.querySelectorAll('.sec').forEach((el) => {\n    const key = el.getAttribute('data-section');\n    const lit = key === name;\n    el.classList.toggle('is-lit', lit);\n    el.querySelector('.sec-tag').textContent = lit ? T.inCode(key) : el.getAttribute('data-tag');\n  });\n}\n\n/* ---------- Sample code ---------- */\n\nfunction matchRanges(text, query) {\n  const ranges = [];\n  if (!query) return ranges;\n  const lower = text.toLowerCase();\n  let from = 0;\n  while (true) {\n    const at = lower.indexOf(query, from);\n    if (at === -1) break;\n    ranges.push([at, at + query.length]);\n    from = at + query.length;\n  }\n  return ranges;\n}\n\nfunction lineContent(text, query) {\n  const frag = document.createDocumentFragment();\n  const ranges = matchRanges(text, query);\n  let last = 0;\n  ranges.forEach(([start, end]) => {\n    if (start > last) frag.append(text.slice(last, start));\n    frag.append(h('mark', { class: 'hit', text: text.slice(start, end) }));\n    last = end;\n  });\n  if (last < text.length) frag.append(text.slice(last));\n  return frag;\n}\n\nfunction renderCode(box, opts) {\n  const query = opts.query || '';\n  box.textContent = '';\n  opts.langs.forEach((lang) => {\n    const info = LANGS[lang];\n    box.append(h('p', { class: `code-head is-t${info.tone}` }, icon(info.icon), h('span', { text: T.languages[lang] })));\n    let number = 0;\n    opts.code.forEach((line, index) => {\n      if (line.lang !== lang) return;\n      number += 1;\n      const glows = Boolean(query) && matchRanges(line.text, query).length > 0;\n      const cls = `code-line is-t${info.tone}${glows ? ' is-glow' : ''}${opts.selected === index ? ' is-selected' : ''}`;\n      const row = opts.interactive\n        ? h('button', { type: 'button', class: cls, 'data-line': String(index), disabled: !glows })\n        : h('div', { class: cls, 'data-line': String(index) });\n      row.append(h('span', { class: 'ln', 'aria-hidden': 'true', text: formatNumber(number) }),\n        h('span', { class: 'code-text' }, lineContent(line.text, query)));\n      box.append(row);\n    });\n  });\n}\n\nfunction matchCount(query) {\n  return CODE[state.pageIndex].filter((line) => matchRanges(line.text, query).length > 0).length;\n}\n\n/* ---------- Connector ---------- */\n\nfunction drawConnector(split, lineEl, sectionEl) {\n  const svg = split.querySelector('.connector');\n  svg.textContent = '';\n  if (!lineEl || !sectionEl) return;\n  const box = split.getBoundingClientRect();\n  const a = lineEl.getBoundingClientRect();\n  const b = sectionEl.getBoundingClientRect();\n  svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);\n  svg.setAttribute('width', String(box.width));\n  svg.setAttribute('height', String(box.height));\n  let d;\n  if (b.right <= a.left) {\n    const x1 = a.left - box.left;\n    const y1 = a.top + a.height / 2 - box.top;\n    const x2 = b.right - box.left;\n    const y2 = b.top + b.height / 2 - box.top;\n    const mid = (x1 + x2) / 2;\n    d = `M${x1} ${y1} C${mid} ${y1} ${mid} ${y2} ${x2} ${y2}`;\n  } else {\n    /* Stacked on a narrow screen: run the line down the left edge so it never crosses the search bar */\n    const x1 = a.left - box.left;\n    const y1 = a.top + a.height / 2 - box.top;\n    const x2 = b.left - box.left;\n    const y2 = b.top + b.height / 2 - box.top;\n    const bend = -12;\n    d = `M${x1} ${y1} C${bend} ${y1} ${bend} ${y2} ${x2} ${y2}`;\n  }\n  svg.append(s('path', { class: 'connector-glow', d }), s('path', { class: 'connector-line', d }));\n  const dot = (cx, cy) => s('circle', { class: 'connector-dot', cx, cy, r: 5 });\n  const end = d.split(' ').slice(-2).map(Number);\n  svg.append(dot(end[0], end[1]));\n}\n\nfunction redraw() {\n  if (!drawn) return;\n  const { split, line, section } = drawn;\n  if (!document.body.contains(split) || split.offsetParent === null) return;\n  drawConnector(split, split.querySelector(`[data-line=\"${line}\"]`), split.querySelector(`[data-section=\"${section}\"]`));\n}\n\n/* ---------- Split view ---------- */\n\nfunction buildSplit(withSearch) {\n  const code = h('div', { class: 'code-box', role: 'group', 'aria-label': T.aria.code });\n  const pane = h('div', { class: 'split-code' });\n  if (withSearch) {\n    const input = h('input', { type: 'search', id: 'search', class: 'search-input', autocomplete: 'off', spellcheck: 'false' });\n    pane.append(h('div', { class: 'search-row' },\n      h('label', { for: 'search', class: 'search-label' }, icon('search'), h('span', { text: T.search.label })),\n      input));\n  }\n  pane.append(code);\n  const split = h('div', { class: 'split' },\n    h('div', { class: 'split-page' }),\n    pane,\n    s('svg', { class: 'connector', 'aria-hidden': 'true' }));\n  split.querySelector('.connector').setAttribute('role', 'presentation');\n  return { split, code };\n}\n\n/* ---------- Activity ---------- */\n\nfunction announce(text) {\n  els.announcer.textContent = '';\n  window.setTimeout(() => { els.announcer.textContent = text; }, 30);\n}\n\nfunction setStatus(text, kind) {\n  els.status.textContent = '';\n  els.status.setAttribute('data-ok', String(kind === 'check'));\n  if (kind) els.status.append(icon(kind));\n  els.status.append(h('span', { text }));\n}\n\nfunction renderActivity() {\n  renderCode(els.code, { code: CODE[state.pageIndex], langs: ['html', 'css', 'js'], query: state.query, selected: state.selected, interactive: true });\n}\n\nfunction onSearch() {\n  const raw = els.search.value.trim().toLowerCase();\n  state.query = raw.length >= CONFIG.minSearchLength ? raw : '';\n  state.selected = null;\n  state.found = false;\n  els.nextButton.hidden = true;\n  els.finishArea.hidden = true;\n  drawn = null;\n  els.split.querySelector('.connector').textContent = '';\n  lightSection(els.page, null);\n  renderActivity();\n  let message;\n  if (!state.query) message = T.search.empty;\n  else {\n    const n = matchCount(state.query);\n    message = n === 0 ? T.search.none(raw) : (n === 1 ? T.search.one : T.search.many(formatNumber(n)));\n  }\n  setStatus(message, 'info');\n  window.clearTimeout(announceTimer);\n  announceTimer = window.setTimeout(() => announce(message), CONFIG.searchAnnounceDelay);\n}\n\nfunction messageFor(line) {\n  const task = TASKS[state.task];\n  const found = T.messages.found[task.found];\n  if (task.type === 'section') {\n    if (line.section === task.section) return { text: found, ok: true };\n    if (line.section) return { text: T.messages.otherSection(T.sections[line.section], T.sections[task.section]), ok: false };\n    return { text: T.messages.notSection, ok: false };\n  }\n  if (line.role === 'list') return { text: found, ok: true };\n  if (line.lang !== 'js') return { text: T.messages.notJs(T.languages[line.lang]), ok: false };\n  return { text: T.messages.usesList, ok: false };\n}\n\nfunction onLine(event) {\n  const btn = event.target.closest('.code-line');\n  if (!btn || btn.disabled) return;\n  const index = Number(btn.getAttribute('data-line'));\n  const line = CODE[state.pageIndex][index];\n  state.selected = index;\n  els.code.querySelectorAll('.code-line').forEach((row) => row.classList.toggle('is-selected', row === btn));\n  lightSection(els.page, line.section || null);\n  const sectionEl = line.section ? els.page.querySelector(`[data-section=\"${line.section}\"]`) : null;\n  drawn = sectionEl ? { split: els.split, line: index, section: line.section } : null;\n  drawConnector(els.split, btn, sectionEl);\n  if (sectionEl) flash(sectionEl);\n  const result = messageFor(line);\n  setStatus(result.text, result.ok ? 'check' : 'info');\n  announce(result.text);\n  state.found = state.found || result.ok;\n  const last = state.task === TASKS.length - 1;\n  els.nextButton.hidden = !(state.found && !last);\n  els.finishArea.hidden = !(state.found && last);\n}\n\nfunction flash(el) {\n  el.classList.remove('flash');\n  void el.offsetWidth;\n  el.classList.add('flash');\n  window.setTimeout(() => el.classList.remove('flash'), CONFIG.flashMilliseconds);\n}\n\nfunction showPage(pageIndex) {\n  state.pageIndex = pageIndex;\n  els.page = buildPage(pageIndex, 'styled');\n  els.split.querySelector('.split-page').textContent = '';\n  els.split.querySelector('.split-page').append(els.page);\n}\n\nfunction setDoThis(index) {\n  const [before, target, after] = T.doThis.tasks[index];\n  els.doThis.textContent = '';\n  els.doThis.append(before, h('strong', { class: 'target', text: target }), after);\n  const task = TASKS[index];\n  els.page.querySelectorAll('.sec').forEach((el) => {\n    el.classList.toggle('is-target', task.type === 'section' && el.getAttribute('data-section') === task.section);\n  });\n  els.search.setAttribute('placeholder', T.search.placeholders[index]);\n}\n\nfunction startTask(index) {\n  state.task = index;\n  state.query = '';\n  state.selected = null;\n  state.found = false;\n  drawn = null;\n  if (TASKS[index].page !== state.pageIndex || !els.page) showPage(TASKS[index].page);\n  els.search.value = '';\n  els.nextButton.hidden = true;\n  els.finishArea.hidden = true;\n  els.split.querySelector('.connector').textContent = '';\n  lightSection(els.page, null);\n  setDoThis(index);\n  els.progress.textContent = T.progress(index + 1, TASKS.length);\n  renderActivity();\n  setStatus(T.search.empty, 'info');\n  announce(`${T.progress(index + 1, TASKS.length)}. ${T.doThis.tasks[index].join('')}`);\n  els.search.focus();\n}\n\n/* ---------- Completion ---------- */\n\nfunction reportComplete() {\n  if (completionReported) return;\n  completionReported = true;\n  try {\n    window.dispatchEvent(new CustomEvent(CONFIG.completeEventName));\n  } catch (err) { /* no listener needed */ }\n  try {\n    if (window.parent && window.parent !== window) {\n      window.parent.postMessage({ type: CONFIG.completeMessageType }, '*');\n    }\n  } catch (err) { /* sandbox may block it */ }\n}\n\nfunction buildTakeawayLabels() {\n  els.takeawayLabels.textContent = '';\n  Object.keys(LANGS).forEach((lang) => {\n    const info = LANGS[lang];\n    els.takeawayLabels.append(h('li', { class: `takeaway-label is-t${info.tone}` }, icon(info.icon), h('span', { text: T.languages[lang] })));\n  });\n}\n\nfunction finish() {\n  reportComplete();\n  buildTakeawayLabels();\n  setStage('done');\n  els.takeaway.focus();\n}\n\n/* ---------- Stages ---------- */\n\nfunction setStage(stage) {\n  state.stage = stage;\n  els.introScreen.hidden = stage !== 'intro';\n  els.demoScreen.hidden = stage !== 'demo';\n  els.activity.hidden = stage !== 'activity';\n  els.takeaway.hidden = stage !== 'done';\n}\n\nfunction startActivity() {\n  els.demoVisual.textContent = '';\n  setStage('activity');\n  showPage(0);\n  startTask(0);\n}\n\n/* ---------- Opening panels ---------- */\n\nfunction buildLayers() {\n  const stack = h('div', { class: 'layers', role: 'group', 'aria-label': T.demo.panels[0] });\n  const langs = ['js', 'css', 'html'];\n  T.layers.forEach((name, i) => {\n    const info = LANGS[langs[i]];\n    stack.append(h('div', { class: `layer is-t${info.tone}`, style: `--depth: ${i}` }, icon(info.icon), h('span', { text: name })));\n  });\n  return stack;\n}\n\nfunction showPanel(n) {\n  demoStep = n;\n  const panel = PANELS[n - 1];\n  const last = n === PANELS.length;\n  els.demoStep.textContent = T.demo.stepOf(n, PANELS.length);\n  els.demoVisual.textContent = '';\n  drawn = null;\n  if (panel.kind === 'layers') {\n    els.demoVisual.append(buildLayers());\n  } else {\n    const { split, code } = buildSplit(false);\n    split.classList.add('split-demo');\n    split.querySelector('.split-page').append(buildPage(0, panel.mode));\n    renderCode(code, { code: CODE[0], langs: panel.langs, query: panel.query, selected: panel.selected, interactive: false });\n    els.demoVisual.append(split);\n    if (panel.lit) {\n      const page = split.querySelector('.mini');\n      lightSection(page, panel.lit);\n      const lineEl = split.querySelector(`[data-line=\"${panel.selected}\"]`);\n      const sectionEl = split.querySelector(`[data-section=\"${panel.lit}\"]`);\n      drawn = { split, line: panel.selected, section: panel.lit };\n      window.requestAnimationFrame(() => drawConnector(split, lineEl, sectionEl));\n    }\n  }\n  els.demoText.textContent = T.demo.panels[n - 1];\n  els.demoNext.textContent = last ? T.demo.start : T.demo.next;\n  els.demoNext.classList.toggle('btn-primary', last);\n  els.demoNext.classList.toggle('btn-outline', !last);\n  announce(T.demo.panels[n - 1]);\n}\n\nfunction startDemo() {\n  setStage('demo');\n  showPanel(1);\n  els.demoNext.focus();\n}\n\nfunction afterIntro(params) {\n  if (CONFIG.showDemo && params.demo !== '0') startDemo();\n  else startActivity();\n}\n\n/* ---------- Setup ---------- */\n\nfunction fillText() {\n  document.querySelectorAll('[data-text]').forEach((el) => {\n    el.textContent = el.getAttribute('data-text').split('.').reduce((obj, key) => obj[key], T);\n  });\n}\n\nfunction showError() {\n  const box = els.error || document.getElementById('error');\n  if (!box) return;\n  box.textContent = T.error;\n  box.hidden = false;\n}\n\nfunction init() {\n  ['widget', 'introScreen', 'introLead', 'startButton', 'demoScreen', 'demoStep', 'demoVisual', 'demoText', 'demoNext',\n    'activity', 'doThis', 'progress', 'splitHost', 'status', 'nextButton', 'finishArea', 'endCard', 'finishButton', 'announcer',\n    'takeaway', 'takeawayLabels', 'error'].forEach((id) => { els[id] = document.getElementById(id); });\n  fillText();\n  els.introLead.append(h('strong', { text: T.intro.term }), T.intro.definition);\n  els.endCard.textContent = T.endCard;\n\n  const { split, code } = buildSplit(true);\n  els.split = split;\n  els.code = code;\n  els.search = split.querySelector('#search');\n  els.splitHost.append(split);\n\n  els.search.addEventListener('input', onSearch);\n  els.code.addEventListener('click', onLine);\n  els.nextButton.addEventListener('click', () => startTask(state.task + 1));\n  els.finishButton.addEventListener('click', finish);\n  els.demoNext.addEventListener('click', () => {\n    if (demoStep === PANELS.length) startActivity();\n    else showPanel(demoStep + 1);\n  });\n  window.addEventListener('resize', redraw);\n\n  const params = readParams();\n  els.startButton.addEventListener('click', () => afterIntro(params));\n  if (CONFIG.showIntro && params.intro !== '0') setStage('intro');\n  else afterIntro(params);\n}\n\nwindow.addEventListener('error', showError);\n\ntry {\n  init();\n} catch (err) {\n  showError();\n}\n",
          "folderId": "0",
          "active": true
        }
      },
