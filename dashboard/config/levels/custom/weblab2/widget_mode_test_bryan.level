    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width,initial-scale=1\" />\n  <title>Parsons Problem Quiz (Drag + Keyboard)</title>\n  <style>\n    :root{\n      --bg:#0b1020;\n      --panel:#121a33;\n      --panel2:#0f1730;\n      --text:#e9ecf5;\n      --muted:#aab2d6;\n      --border:rgba(255,255,255,.12);\n      --focus:#7aa2ff;\n      --good:#2ecc71;\n      --bad:#ff5c5c;\n      --shadow:0 10px 30px rgba(0,0,0,.35);\n      --radius:14px;\n      --gap:14px;\n    }\n    * { box-sizing:border-box; }\n    body{\n      margin:0;\n      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, \"Apple Color Emoji\", \"Segoe UI Emoji\";\n      background: radial-gradient(1200px 700px at 10% 10%, #18224a 0%, var(--bg) 55%);\n      color:var(--text);\n      line-height:1.35;\n      padding: 28px;\n    }\n    .app{\n      max-width: 1050px;\n      margin: 0 auto;\n      display: grid;\n      gap: var(--gap);\n    }\n    header{\n      display:flex;\n      align-items:flex-start;\n      justify-content:space-between;\n      gap: 16px;\n    }\n    h1{\n      margin:0;\n      font-size: 20px;\n      letter-spacing:.2px;\n    }\n    .sub{\n      margin-top:6px;\n      color: var(--muted);\n      font-size: 13px;\n    }\n    .pill{\n      background: rgba(255,255,255,.08);\n      border: 1px solid var(--border);\n      border-radius: 999px;\n      padding: 8px 12px;\n      font-size: 12px;\n      color: var(--muted);\n      box-shadow: var(--shadow);\n      white-space:nowrap;\n    }\n    .card{\n      background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));\n      border: 1px solid var(--border);\n      border-radius: var(--radius);\n      box-shadow: var(--shadow);\n      overflow:hidden;\n    }\n    .card .inner{\n      padding: 16px;\n    }\n\n    .prompt{\n      font-size: 15px;\n      margin: 0 0 8px 0;\n    }\n    .help{\n      color: var(--muted);\n      font-size: 13px;\n      margin: 0;\n    }\n    .kbd{\n      display:inline-block;\n      border: 1px solid var(--border);\n      border-bottom-color: rgba(255,255,255,.2);\n      background: rgba(0,0,0,.18);\n      padding: 1px 6px;\n      border-radius: 6px;\n      font-size: 12px;\n      line-height: 1.6;\n      color: var(--text);\n      transform: translateY(-1px);\n      margin: 0 2px;\n    }\n\n    .columns{\n      display:grid;\n      grid-template-columns: 1fr 1fr;\n      gap: var(--gap);\n      padding: 16px;\n    }\n\n    .col{\n      background: rgba(0,0,0,.12);\n      border: 1px solid var(--border);\n      border-radius: var(--radius);\n      padding: 12px;\n      min-height: 320px;\n      display:flex;\n      flex-direction:column;\n      gap: 10px;\n    }\n    .col h2{\n      margin:0;\n      font-size: 14px;\n      color: var(--muted);\n      font-weight: 600;\n      letter-spacing:.2px;\n      display:flex;\n      align-items:center;\n      justify-content:space-between;\n    }\n    .count{\n      font-size: 12px;\n      color: var(--muted);\n      opacity:.9;\n    }\n\n    .list{\n      display:flex;\n      flex-direction:column;\n      gap: 8px;\n      padding: 0;\n      margin: 0;\n      list-style: none;\n      flex: 1;\n    }\n\n    .block{\n      display:flex;\n      align-items:flex-start;\n      justify-content:space-between;\n      gap: 10px;\n      padding: 10px 10px;\n      border-radius: 12px;\n      background: linear-gradient(180deg, rgba(255,255,255,.08), rgba(255,255,255,.04));\n      border: 1px solid rgba(255,255,255,.12);\n      cursor: grab;\n      user-select:none;\n    }\n    .block:active{ cursor:grabbing; }\n\n    .block[aria-grabbed=\"true\"]{\n      outline: 2px solid var(--focus);\n      outline-offset: 2px;\n      box-shadow: 0 0 0 5px rgba(122,162,255,.18);\n    }\n\n    .code{\n      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\n      font-size: 13px;\n      white-space: pre-wrap;\n      word-break: break-word;\n      margin:0;\n      color: var(--text);\n      flex:1;\n    }\n\n    .meta{\n      display:flex;\n      align-items:center;\n      gap:8px;\n      min-width: 28px;\n      justify-content:flex-end;\n      padding-top: 1px;\n    }\n    .badge{\n      width: 20px;\n      height: 20px;\n      border-radius: 999px;\n      display:grid;\n      place-items:center;\n      font-size: 13px;\n      line-height:1;\n      border: 1px solid rgba(255,255,255,.14);\n      background: rgba(0,0,0,.18);\n      color: var(--muted);\n      flex: 0 0 auto;\n    }\n    .badge.good{\n      background: rgba(46,204,113,.18);\n      border-color: rgba(46,204,113,.5);\n      color: #b9ffd2;\n    }\n    .badge.empty{\n      opacity: .5;\n    }\n\n    .drop-hint{\n      border: 1px dashed rgba(255,255,255,.22);\n      background: rgba(122,162,255,.10);\n    }\n\n    .footer{\n      display:flex;\n      align-items:center;\n      justify-content:space-between;\n      gap: 12px;\n      padding: 12px 16px 16px;\n      border-top: 1px solid var(--border);\n      background: rgba(0,0,0,.12);\n    }\n\n    .btnrow{\n      display:flex;\n      gap: 10px;\n      flex-wrap: wrap;\n    }\n\n    button{\n      border: 1px solid var(--border);\n      background: rgba(255,255,255,.08);\n      color: var(--text);\n      padding: 10px 12px;\n      border-radius: 12px;\n      cursor:pointer;\n      font-weight: 600;\n      letter-spacing:.2px;\n    }\n    button:hover{ background: rgba(255,255,255,.10); }\n    button:focus-visible{\n      outline: 2px solid var(--focus);\n      outline-offset: 2px;\n    }\n    button.primary{\n      background: rgba(122,162,255,.18);\n      border-color: rgba(122,162,255,.45);\n    }\n    button.primary:hover{ background: rgba(122,162,255,.24); }\n    button.danger{\n      background: rgba(255,92,92,.14);\n      border-color: rgba(255,92,92,.38);\n    }\n\n    .status{\n      color: var(--muted);\n      font-size: 13px;\n      display:flex;\n      align-items:center;\n      gap: 10px;\n      flex-wrap: wrap;\n    }\n    .status strong{ color: var(--text); }\n    .sr-only{\n      position:absolute; width:1px; height:1px;\n      padding:0; margin:-1px; overflow:hidden;\n      clip:rect(0,0,0,0); white-space:nowrap; border:0;\n    }\n\n    @media (max-width: 900px){\n      .columns{ grid-template-columns: 1fr; }\n      header{ flex-direction:column; }\n      .pill{ align-self:flex-start; }\n    }\n  </style>\n</head>\n<body>\n  <div class=\"app\">\n    <header>\n      <div>\n        <h1>Parsons Problem Quiz</h1>\n        <p class=\"sub\">\n          Drag blocks to the Answer list in the correct order. Correctly placed blocks show a green ✓.\n        </p>\n      </div>\n      <div class=\"pill\" aria-hidden=\"true\">Drag + Keyboard friendly</div>\n    </header>\n\n    <div class=\"card\">\n      <div class=\"inner\">\n        <p class=\"prompt\" id=\"prompt\"></p>\n        <p class=\"help\" id=\"help\">\n          Keyboard controls:\n          <span class=\"kbd\">↑</span>/<span class=\"kbd\">↓</span> move focus,\n          <span class=\"kbd\">Alt</span>+<span class=\"kbd\">↑</span>/<span class=\"kbd\">Alt</span>+<span class=\"kbd\">↓</span> move block within a list,\n          <span class=\"kbd\">Alt</span>+<span class=\"kbd\">→</span> send to Answer,\n          <span class=\"kbd\">Alt</span>+<span class=\"kbd\">←</span> send back to Bank,\n          <span class=\"kbd\">Space</span> toggles “grab” mode (optional).\n        </p>\n        <div class=\"sr-only\" aria-live=\"polite\" id=\"live\"></div>\n      </div>\n\n      <div class=\"columns\">\n        <section class=\"col\" aria-labelledby=\"bankTitle\">\n          <h2 id=\"bankTitle\">Bank <span class=\"count\" id=\"bankCount\"></span></h2>\n          <ul class=\"list\"\n              id=\"bank\"\n              role=\"listbox\"\n              aria-label=\"Bank code blocks\"\n              aria-describedby=\"help\"></ul>\n        </section>\n\n        <section class=\"col\" aria-labelledby=\"ansTitle\">\n          <h2 id=\"ansTitle\">Answer <span class=\"count\" id=\"ansCount\"></span></h2>\n          <ul class=\"list\"\n              id=\"answer\"\n              role=\"listbox\"\n              aria-label=\"Answer code blocks\"\n              aria-describedby=\"help\"></ul>\n        </section>\n      </div>\n\n      <div class=\"footer\">\n        <div class=\"btnrow\">\n          <button id=\"prevBtn\">◀ Prev</button>\n          <button class=\"primary\" id=\"nextBtn\">Next ▶</button>\n          <button id=\"resetBtn\" class=\"danger\">Reset</button>\n        </div>\n        <div class=\"status\" id=\"status\"></div>\n      </div>\n    </div>\n  </div>\n\n  <script>\n    // ---------- Utilities ----------\n    function shuffle(arr){\n      const a = arr.slice();\n      for (let i = a.length - 1; i > 0; i--) {\n        const j = Math.floor(Math.random() * (i + 1));\n        [a[i], a[j]] = [a[j], a[i]];\n      }\n      return a;\n    }\n\n    function clamp(n, lo, hi){ return Math.max(lo, Math.min(hi, n)); }\n\n    function uid(){\n      return Math.random().toString(16).slice(2) + \"-\" + Date.now().toString(16);\n    }\n\n    // ---------- Quiz Data (edit/add your own) ----------\n    const QUESTIONS = [\n      {\n        prompt: \"JavaScript: Build a function that returns the sum of numbers 1..n.\",\n        // Blocks shown (we shuffle these). You can include distractors too.\n        blocks: [\n          \"function sumTo(n) {\",\n          \"  let total = 0;\",\n          \"  for (let i = 1; i <= n; i++) {\",\n          \"    total += i;\",\n          \"  }\",\n          \"  return total;\",\n          \"}\"\n        ],\n        solution: [\n          \"function sumTo(n) {\",\n          \"  let total = 0;\",\n          \"  for (let i = 1; i <= n; i++) {\",\n          \"    total += i;\",\n          \"  }\",\n          \"  return total;\",\n          \"}\"\n        ]\n      },\n      {\n        prompt: \"JavaScript: Given an array, return a new array with only the even numbers.\",\n        blocks: [\n          \"function evens(arr) {\",\n          \"  const out = [];\",\n          \"  for (const x of arr) {\",\n          \"    if (x % 2 === 0) {\",\n          \"      out.push(x);\",\n          \"    }\",\n          \"  }\",\n          \"  return out;\",\n          \"}\"\n        ],\n        solution: [\n          \"function evens(arr) {\",\n          \"  const out = [];\",\n          \"  for (const x of arr) {\",\n          \"    if (x % 2 === 0) {\",\n          \"      out.push(x);\",\n          \"    }\",\n          \"  }\",\n          \"  return out;\",\n          \"}\"\n        ]\n      }\n    ];\n\n    // ---------- State ----------\n    const state = {\n      qIndex: 0,\n      items: [],      // [{id, text}]\n      bankIds: [],    // array of item ids in bank order\n      ansIds: [],     // array of item ids in answer order\n      grabbedId: null // for optional \"grab\" mode\n    };\n\n    // ---------- DOM ----------\n    const promptEl = document.getElementById(\"prompt\");\n    const bankEl   = document.getElementById(\"bank\");\n    const ansEl    = document.getElementById(\"answer\");\n    const bankCountEl = document.getElementById(\"bankCount\");\n    const ansCountEl  = document.getElementById(\"ansCount\");\n    const statusEl = document.getElementById(\"status\");\n    const liveEl   = document.getElementById(\"live\");\n\n    const prevBtn  = document.getElementById(\"prevBtn\");\n    const nextBtn  = document.getElementById(\"nextBtn\");\n    const resetBtn = document.getElementById(\"resetBtn\");\n\n    // ---------- Rendering ----------\n    function currentQ(){ return QUESTIONS[state.qIndex]; }\n\n    function announce(msg){\n      liveEl.textContent = msg;\n    }\n\n    function makeBlockLi(itemId, listName){\n      const item = state.items.find(x => x.id === itemId);\n\n      const li = document.createElement(\"li\");\n      li.className = \"block\";\n      li.draggable = true;\n\n      li.dataset.id = itemId;\n      li.dataset.list = listName;\n\n      li.setAttribute(\"role\", \"option\");\n      li.tabIndex = -1;\n      li.setAttribute(\"aria-grabbed\", state.grabbedId === itemId ? \"true\" : \"false\");\n\n      // Code text\n      const pre = document.createElement(\"pre\");\n      pre.className = \"code\";\n      pre.textContent = item.text;\n\n      // Badge (checkmark)\n      const meta = document.createElement(\"div\");\n      meta.className = \"meta\";\n      const badge = document.createElement(\"span\");\n      badge.className = \"badge empty\";\n      badge.setAttribute(\"aria-hidden\",\"true\");\n      badge.textContent = \" \";\n\n      meta.appendChild(badge);\n\n      li.appendChild(pre);\n      li.appendChild(meta);\n\n      // Drag events\n      li.addEventListener(\"dragstart\", (e) => {\n        e.dataTransfer.setData(\"text/plain\", itemId);\n        e.dataTransfer.effectAllowed = \"move\";\n        li.style.opacity = \"0.7\";\n      });\n      li.addEventListener(\"dragend\", () => {\n        li.style.opacity = \"\";\n        clearDropHints();\n      });\n\n      // Keyboard: optional grab mode toggle\n      li.addEventListener(\"keydown\", (e) => onBlockKeyDown(e, li));\n\n      return li;\n    }\n\n    function clearDropHints(){\n      [...document.querySelectorAll(\".drop-hint\")].forEach(el => el.classList.remove(\"drop-hint\"));\n    }\n\n    function render(){\n      const q = currentQ();\n      promptEl.textContent = `Q${state.qIndex + 1}/${QUESTIONS.length}: ${q.prompt}`;\n\n      bankEl.innerHTML = \"\";\n      ansEl.innerHTML = \"\";\n\n      state.bankIds.forEach(id => bankEl.appendChild(makeBlockLi(id, \"bank\")));\n      state.ansIds.forEach(id => ansEl.appendChild(makeBlockLi(id, \"answer\")));\n\n      bankCountEl.textContent = `(${state.bankIds.length})`;\n      ansCountEl.textContent  = `(${state.ansIds.length})`;\n\n      prevBtn.disabled = state.qIndex === 0;\n      nextBtn.textContent = (state.qIndex === QUESTIONS.length - 1) ? \"Restart ↻\" : \"Next ▶\";\n\n      updateChecks();\n      updateStatus();\n      setupRovingTabIndex();\n    }\n\n    function setupRovingTabIndex(){\n      // Roving tabindex per list: first item gets tabIndex=0\n      [bankEl, ansEl].forEach(list => {\n        const items = [...list.querySelectorAll(\".block\")];\n        items.forEach(el => el.tabIndex = -1);\n        if (items.length > 0) items[0].tabIndex = 0;\n      });\n    }\n\n    function updateStatus(){\n      const q = currentQ();\n      const correctCount = countCorrectInAnswer();\n      const total = q.solution.length;\n\n      const done = state.ansIds.length === total && correctCount === total;\n      statusEl.innerHTML = `\n        <span><strong>Correct placements:</strong> ${correctCount}/${total}</span>\n        <span>•</span>\n        <span><strong>Answer blocks:</strong> ${state.ansIds.length}/${total}</span>\n        ${done ? `<span>•</span><span style=\"color:var(--good)\"><strong>Complete ✓</strong></span>` : \"\"}\n      `;\n    }\n\n    function countCorrectInAnswer(){\n      const sol = currentQ().solution;\n      let c = 0;\n      for (let i=0; i<state.ansIds.length; i++){\n        const id = state.ansIds[i];\n        const text = state.items.find(x => x.id === id)?.text;\n        if (text === sol[i]) c++;\n      }\n      return c;\n    }\n\n    function updateChecks(){\n      // Mark blocks in Answer list that are in correct position\n      const sol = currentQ().solution;\n\n      const ansLis = [...ansEl.querySelectorAll(\".block\")];\n      ansLis.forEach((li, idx) => {\n        const id = li.dataset.id;\n        const text = state.items.find(x => x.id === id)?.text;\n        const badge = li.querySelector(\".badge\");\n        const isCorrect = (text === sol[idx]);\n\n        if (isCorrect){\n          badge.classList.remove(\"empty\");\n          badge.classList.add(\"good\");\n          badge.textContent = \"✓\";\n          li.setAttribute(\"aria-label\", `${text} (correct position)`);\n        } else {\n          badge.classList.add(\"empty\");\n          badge.classList.remove(\"good\");\n          badge.textContent = \" \";\n          li.setAttribute(\"aria-label\", text);\n        }\n      });\n\n      // Bank blocks have no checkmark\n      const bankLis = [...bankEl.querySelectorAll(\".block\")];\n      bankLis.forEach(li => {\n        const badge = li.querySelector(\".badge\");\n        badge.classList.add(\"empty\");\n        badge.classList.remove(\"good\");\n        badge.textContent = \" \";\n      });\n    }\n\n    // ---------- List operations ----------\n    function moveIdBetweenLists(id, fromList, toList, toIndex=null){\n      const from = fromList === \"bank\" ? state.bankIds : state.ansIds;\n      const to   = toList   === \"bank\" ? state.bankIds : state.ansIds;\n\n      const fromIdx = from.indexOf(id);\n      if (fromIdx === -1) return;\n\n      from.splice(fromIdx, 1);\n      if (toIndex === null || toIndex === undefined) toIndex = to.length;\n      toIndex = clamp(toIndex, 0, to.length);\n      to.splice(toIndex, 0, id);\n    }\n\n    function moveWithinList(id, listName, delta){\n      const list = listName === \"bank\" ? state.bankIds : state.ansIds;\n      const idx = list.indexOf(id);\n      if (idx === -1) return;\n      const newIdx = clamp(idx + delta, 0, list.length - 1);\n      if (newIdx === idx) return;\n      list.splice(idx, 1);\n      list.splice(newIdx, 0, id);\n    }\n\n    function focusItem(listEl, itemId){\n      const li = listEl.querySelector(`.block[data-id=\"${CSS.escape(itemId)}\"]`);\n      if (!li) return;\n      // set roving tabIndex\n      [...listEl.querySelectorAll(\".block\")].forEach(x => x.tabIndex = -1);\n      li.tabIndex = 0;\n      li.focus();\n    }\n\n    // ---------- Keyboard behavior ----------\n    function onBlockKeyDown(e, li){\n      const id = li.dataset.id;\n      const listName = li.dataset.list;\n      const listEl = listName === \"bank\" ? bankEl : ansEl;\n\n      // Roving focus within a list using ArrowUp/ArrowDown (no modifiers)\n      if (!e.altKey && (e.key === \"ArrowUp\" || e.key === \"ArrowDown\")){\n        e.preventDefault();\n        const items = [...listEl.querySelectorAll(\".block\")];\n        const idx = items.indexOf(li);\n        const nextIdx = clamp(idx + (e.key === \"ArrowUp\" ? -1 : 1), 0, items.length - 1);\n        items.forEach(x => x.tabIndex = -1);\n        items[nextIdx].tabIndex = 0;\n        items[nextIdx].focus();\n        return;\n      }\n\n      // Optional \"grab\" mode with Space\n      if (e.key === \" \" || e.key === \"Spacebar\"){\n        e.preventDefault();\n        state.grabbedId = (state.grabbedId === id) ? null : id;\n        announce(state.grabbedId ? \"Grabbed block. Use Alt+Arrow keys to move it.\" : \"Released block.\");\n        render();\n        // restore focus\n        const afterListEl = (listName === \"bank\" ? bankEl : ansEl);\n        focusItem(afterListEl, id);\n        return;\n      }\n\n      // Alt+Up/Down: reorder within current list\n      if (e.altKey && (e.key === \"ArrowUp\" || e.key === \"ArrowDown\")){\n        e.preventDefault();\n        moveWithinList(id, listName, e.key === \"ArrowUp\" ? -1 : 1);\n        render();\n        focusItem(listEl, id);\n        announce(\"Moved within list.\");\n        return;\n      }\n\n      // Alt+Right: send to Answer\n      if (e.altKey && e.key === \"ArrowRight\"){\n        e.preventDefault();\n        if (listName === \"bank\"){\n          moveIdBetweenLists(id, \"bank\", \"answer\");\n          render();\n          focusItem(ansEl, id);\n          announce(\"Moved to Answer.\");\n        }\n        return;\n      }\n\n      // Alt+Left: send to Bank\n      if (e.altKey && e.key === \"ArrowLeft\"){\n        e.preventDefault();\n        if (listName === \"answer\"){\n          moveIdBetweenLists(id, \"answer\", \"bank\");\n          render();\n          focusItem(bankEl, id);\n          announce(\"Moved to Bank.\");\n        }\n        return;\n      }\n    }\n\n    // ---------- Drag & drop on lists ----------\n    function enableDnDForList(listEl, listName){\n      // Allow dropping on list (append)\n      listEl.addEventListener(\"dragover\", (e) => {\n        e.preventDefault();\n        e.dataTransfer.dropEffect = \"move\";\n      });\n\n      listEl.addEventListener(\"drop\", (e) => {\n        e.preventDefault();\n        clearDropHints();\n        const id = e.dataTransfer.getData(\"text/plain\");\n        if (!id) return;\n\n        const sourceList = state.bankIds.includes(id) ? \"bank\" : (state.ansIds.includes(id) ? \"answer\" : null);\n        if (!sourceList) return;\n\n        // If dropping on a specific block, insert before it\n        const targetBlock = e.target.closest(\".block\");\n        let toIndex = null;\n\n        if (targetBlock && targetBlock.dataset.list === listName){\n          const targetId = targetBlock.dataset.id;\n          const targetArr = listName === \"bank\" ? state.bankIds : state.ansIds;\n          toIndex = targetArr.indexOf(targetId);\n          if (toIndex < 0) toIndex = null;\n        }\n\n        moveIdBetweenLists(id, sourceList, listName, toIndex);\n        render();\n        const destEl = (listName === \"bank\" ? bankEl : ansEl);\n        focusItem(destEl, id);\n        announce(\"Dropped block.\");\n      });\n\n      // Add insert hints when hovering over blocks\n      listEl.addEventListener(\"dragenter\", (e) => {\n        const li = e.target.closest(\".block\");\n        if (!li || li.dataset.list !== listName) return;\n        clearDropHints();\n        li.classList.add(\"drop-hint\");\n      });\n      listEl.addEventListener(\"dragleave\", (e) => {\n        const li = e.target.closest(\".block\");\n        if (!li) return;\n        li.classList.remove(\"drop-hint\");\n      });\n    }\n\n    // ---------- Question setup ----------\n    function loadQuestion(index){\n      state.qIndex = index;\n\n      const q = currentQ();\n      // Create items with stable ids for this question\n      const shuffled = shuffle(q.blocks);\n      state.items = shuffled.map(text => ({ id: uid(), text }));\n\n      // Start: everything in bank, randomized\n      state.bankIds = state.items.map(x => x.id);\n      state.ansIds  = [];\n      state.grabbedId = null;\n\n      render();\n      // Focus first bank item\n      if (state.bankIds[0]) focusItem(bankEl, state.bankIds[0]);\n    }\n\n    // ---------- Buttons ----------\n    prevBtn.addEventListener(\"click\", () => {\n      const nextIndex = clamp(state.qIndex - 1, 0, QUESTIONS.length - 1);\n      loadQuestion(nextIndex);\n    });\n\n    nextBtn.addEventListener(\"click\", () => {\n      if (state.qIndex === QUESTIONS.length - 1){\n        // restart (reshuffle everything)\n        loadQuestion(0);\n      } else {\n        loadQuestion(state.qIndex + 1);\n      }\n    });\n\n    resetBtn.addEventListener(\"click\", () => {\n      loadQuestion(state.qIndex);\n    });\n\n    // Enable DnD\n    enableDnDForList(bankEl, \"bank\");\n    enableDnDForList(ansEl, \"answer\");\n\n    // Initial load\n    loadQuestion(0);\n  </script>\n</body>\n</html>\n",
          "active": true,
          "folderId": "0"
        }
      },
      "openFiles": [
        "1"
      ]
    }
