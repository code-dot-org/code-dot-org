  "properties": {
    "encrypted": "false",
    "long_instructions": "## Password Visibility\r\n\r\nA user reported that the password visibility feature is not working correctly.\r\n\r\n### Expected Behavior:\r\n\r\n- Checking the box should show the password\r\n- Unchecking the box should hide the password\r\n\r\n### Do This:\r\n\r\n1. Run the app and test the checkbox. What's wrong?\r\n2. Check how the `showPassword` value changes and how the UI updates.\r\n3. Fix the issue so the password visibility works correctly.\r\n\r\nUse AI (if needed) to explain the code before making changes.",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
    "ai_tutor_mode": "tutor",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
