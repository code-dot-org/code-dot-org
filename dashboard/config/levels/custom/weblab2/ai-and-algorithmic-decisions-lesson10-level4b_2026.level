      "allowMultipleAttempts": false
    },
    "display_name": "Fix Password Visibility",
    "bubble_choice_description": "Investigate and fix a broken password visibility feature. Figure out what’s wrong and make sure the password shows and hides correctly.",
    "thumbnail_url": "https://images.code.org/22f7b42cb451c3a7ef366ba683ca15d7-password.png",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>Sign In</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <main class=\"page\">\n      <section class=\"login-card\">\n        <h1 class=\"app-title\">Streamly</h1>\n        <p class=\"subtitle\">Sign in to continue</p>\n\n        <label for=\"pwInput\" class=\"label\">Password</label>\n\n        <div class=\"input-row\">\n          <input\n            id=\"pwInput\"\n            type=\"password\"\n            placeholder=\"Enter your password\"\n          />\n\n          <button id=\"btnToggle\" class=\"toggle-btn\">\n            👁\n          </button>\n        </div>\n\n        <label class=\"checkbox-row\">\n          <input id=\"chkToggle\" type=\"checkbox\" />\n          Show password\n        </label>\n\n        <button class=\"primary-btn\">Sign In</button>\n      </section>\n    </main>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  font-family: Arial, Helvetica, sans-serif;\n  background: linear-gradient(135deg, #4f46e5, #9333ea);\n  color: #111827;\n}\n\n.page {\n  min-height: 100vh;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  padding: 20px;\n}\n\n.login-card {\n  width: 100%;\n  max-width: 360px;\n  background: #ffffff;\n  border-radius: 16px;\n  padding: 28px;\n  box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);\n}\n\n.app-title {\n  margin: 0;\n  font-size: 28px;\n  text-align: center;\n}\n\n.subtitle {\n  text-align: center;\n  margin: 6px 0 20px 0;\n  color: #6b7280;\n  font-size: 14px;\n}\n\n.label {\n  font-size: 14px;\n  margin-bottom: 6px;\n  display: block;\n}\n\n.input-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  border: 1px solid #d1d5db;\n  border-radius: 10px;\n  padding: 8px 10px;\n  margin-bottom: 12px;\n}\n\n.input-row input {\n  border: none;\n  outline: none;\n  flex: 1;\n  font-size: 16px;\n}\n\n.toggle-btn {\n  border: none;\n  background: none;\n  cursor: pointer;\n  font-size: 18px;\n}\n\n.checkbox-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 14px;\n  margin-bottom: 18px;\n}\n\n.primary-btn {\n  width: 100%;\n  padding: 12px;\n  border: none;\n  border-radius: 10px;\n  background: #4f46e5;\n  color: white;\n  font-size: 16px;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.primary-btn:hover {\n  background: #4338ca;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "// State\nlet showPassword = false;\n\n// Selectors\nconst pwInput = document.getElementById(\"pwInput\");\nconst chkToggle = document.getElementById(\"chkToggle\");\n\n// Render UI from state\nconst render = () => {\n  if (!showPassword) { \n    pwInput.setAttribute(\"type\", \"text\");\n  } else {\n    pwInput.setAttribute(\"type\", \"password\");\n  }\n};\n\n// Event: checkbox change -> flip -> render\nchkToggle.addEventListener(\"change\", () => {\n  showPassword = showPassword;\n  render();\n});\n\n// Initial render\nrender();",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "3"
      ]
    },
