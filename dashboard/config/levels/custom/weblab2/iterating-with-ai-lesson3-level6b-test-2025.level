    "display_name": "Cargo Loader",
    "bubble_choice_description": "Debug the **while loop** which seems to never run.",
    "thumbnail_url": "https://images.code.org/cab59675c61505a32203b137c7b7e428-Screenshot 2025-11-21 at 11.43.22 AM.png",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Starship Odyssey Auto-Loader</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <header>\n    <h1>🚀 Starship Odyssey</h1>\n    <h2>Auto-Loader System v4.3</h2>\n  </header>\n\n  <main>\n    <div class=\"control-panel\">\n      <div class=\"status-box\">\n        <h3>System Status</h3>\n        <p id=\"status-msg\">Ready to load cargo...</p>\n        <p>Current Weight: <span id=\"weight-display\">0</span> / 800 tons</p>\n        <button id=\"run-btn\">Run Loader Sequence</button>\n      </div>\n    </div>\n\n    <div class=\"cargo-bay\">\n      <div class=\"container\">\n        <h3>📦 Warehouse Queue</h3>\n        <ul id=\"warehouse-list\">\n          </ul>\n      </div>\n\n      <div class=\"container\">\n        <h3>🚀 Ship Cargo Hold</h3>\n        <ul id=\"ship-list\">\n          </ul>\n      </div>\n    </div>\n  </main>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// DOM Elements\nconst runBtn = document.querySelector(\"#run-btn\");\nconst statusMsg = document.querySelector(\"#status-msg\");\nconst weightDisplay = document.querySelector(\"#weight-display\");\nconst warehouseList = document.querySelector(\"#warehouse-list\");\nconst shipList = document.querySelector(\"#ship-list\");\n\n// Data\nconst warehouseQueue = [150, 300, 120, 200, 500, 100];\nconst maxCapacity = 800;\nlet shipCargo = [];\nlet currentWeight = 0;\n\n// Initial Render\nrenderLists();\n\n// Event Listener\nrunBtn.addEventListener(\"click\", () => {\n  // Reset for the run\n  shipCargo = [];\n  currentWeight = 0;\n  let i = 0; // Index tracker\n\n  statusMsg.textContent = \"Loading sequence initiated...\";\n\n  // LOOP: Run as long as we have items AND haven't exceeded capacity\n  while (i < warehouseQueue.length && currentWeight < maxCapacity) {\n\n    let crate = warehouseQueue[i];\n\n    // Check if adding this crate fits on the ship\n    if (currentWeight + crate <= maxCapacity) {\n      currentWeight = currentWeight + crate;\n\n      // Add the crate to the shipCargo array\n      shipCargo.push(crate);\n    }\n\n    // MISSING CODE HERE\n\n\n    \n  }\n\n  updateScreen();\n});\n\n// Helper Functions\nfunction renderLists() {\n  warehouseList.innerHTML = \"\";\n  warehouseQueue.forEach(crate => {\n    warehouseList.innerHTML += `<li>📦 Crate (${crate} tons)</li>`;\n  });\n\n  shipList.innerHTML = \"\";\n  if(shipCargo.length === 0) {\n    shipList.innerHTML = \"<li style='opacity:0.5'>Empty</li>\";\n  } else {\n    shipCargo.forEach(crate => {\n      shipList.innerHTML += `<li class=\"loaded\">🚀 Crate (${crate} tons)</li>`;\n    });\n  }\n}\n\nfunction updateScreen() {\n  weightDisplay.textContent = currentWeight;\n  renderLists();\n\n  if (currentWeight > 0) {\n    statusMsg.textContent = \"Loading Complete!\";\n    statusMsg.style.color = \"var(--neon-green)\";\n  } else {\n    statusMsg.textContent = \"System Error: No cargo loaded.\";\n    statusMsg.style.color = \"var(--neon-red)\";\n  }\n}",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "/* Orbitron font for sci-fi feel */\n@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&family=Roboto:wght@400;700&display=swap');\n\n:root {\n  --neon-blue: #00f3ff;\n  --neon-green: #0aff00;\n  --neon-red: #ff0055;\n  --dark-bg: #0b0d17;\n  --panel-bg: #1a1d2e;\n}\n\nbody {\n  background-color: var(--dark-bg);\n  color: white;\n  font-family: 'Roboto', sans-serif;\n  margin: 0;\n  padding: 20px;\n  text-align: center;\n}\n\nh1, h2, h3 {\n  font-family: 'Orbitron', sans-serif;\n  text-transform: uppercase;\n  letter-spacing: 2px;\n}\n\nh1 { color: var(--neon-blue); margin-bottom: 5px; }\nh2 { font-size: 1rem; color: #888; margin-top: 0; }\n\n.control-panel {\n  display: flex;\n  justify-content: center;\n  margin-bottom: 30px;\n}\n\n.status-box {\n  background: var(--panel-bg);\n  border: 1px solid var(--neon-blue);\n  padding: 20px;\n  border-radius: 8px;\n  width: 300px;\n  box-shadow: 0 0 15px rgba(0, 243, 255, 0.2);\n}\n\n#run-btn {\n  background-color: var(--neon-green);\n  color: black;\n  border: none;\n  padding: 10px 20px;\n  font-family: 'Orbitron', sans-serif;\n  font-weight: bold;\n  font-size: 1rem;\n  cursor: pointer;\n  margin-top: 10px;\n  border-radius: 4px;\n}\n\n#run-btn:hover {\n  background-color: #fff;\n  box-shadow: 0 0 10px var(--neon-green);\n}\n\n.cargo-bay {\n  display: flex;\n  justify-content: center;\n  gap: 40px;\n  flex-wrap: wrap;\n}\n\n.container {\n  background: var(--panel-bg);\n  width: 250px;\n  padding: 20px;\n  border-radius: 8px;\n  border-top: 4px solid #444;\n}\n\n.container:nth-child(2) {\n  border-color: var(--neon-blue);\n}\n\nul {\n  list-style: none;\n  padding: 0;\n  min-height: 150px;\n}\n\nli {\n  background: #333;\n  margin: 5px 0;\n  padding: 8px;\n  border-radius: 4px;\n  border-left: 4px solid #666;\n}\n\n/* Helper class to visualize moved items */\nli.loaded {\n  border-left-color: var(--neon-green);\n  background: #224422;\n}",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "2",
        "1",
        "3"
      ]
    },
