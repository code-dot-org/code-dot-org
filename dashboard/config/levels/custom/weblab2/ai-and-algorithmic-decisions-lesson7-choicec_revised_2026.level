    "display_name": "Move Through Steps",
    "bubble_choice_description": "Click Next to move through recipe instructions one step at a time.",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Recipe Steps</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <div class=\"app\">\n    <h2>Chocolate Chip Cookies</h2>\n\n    <div class=\"recipe-card\">\n      <img id=\"stepImage\" src=\"step1.jpg\">\n      <p class=\"step-label\">Current Step</p>\n      <p id=\"stepText\">Step 1: Gather your ingredients.</p>\n    </div>\n\n    <button id=\"nextButton\">Next</button>\n  </div>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  font-family: Arial, sans-serif;\n  background: linear-gradient(180deg, #1f2125 0%, #2d3035 100%);\n  color: #ffffff;\n  padding: 32px 16px;\n}\n\n.app {\n  max-width: 600px;\n  margin: 0 auto;\n  text-align: center;\n}\n\nh2 {\n  margin-bottom: 24px;\n  font-size: 2.2rem;\n}\n\n\n.recipe-card {\n  background: #f8f5ef;\n  color: #1f1f1f;\n  border-radius: 20px;\n  padding: 20px;\n  margin-bottom: 20px;\n  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.2);\n}\n\n#stepImage {\n  width: 100%;\n  height: auto;\n  border-radius: 12px;\n  margin-bottom: 16px;\n}\n\n\n.step-label {\n  font-size: 0.8rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: #666;\n  margin: 0 0 6px 0;\n}\n\n#stepText {\n  font-size: 1.2rem;\n  line-height: 1.6;\n  margin: 0;\n}\n\n/* Button */\nbutton {\n  padding: 14px 24px;\n  font-size: 1rem;\n  font-weight: 700;\n  border: none;\n  border-radius: 12px;\n  background: #1da1f2;\n  color: white;\n  cursor: pointer;\n  transition: background 0.15s ease, transform 0.1s ease;\n}\n\nbutton:hover {\n  background: #0d8bd8;\n}\n\nbutton:active {\n  transform: scale(0.98);\n}\n\n/* Responsive */\n@media (max-width: 500px) {\n  h2 {\n    font-size: 1.8rem;\n  }\n\n  .recipe-card {\n    padding: 16px;\n  }\n\n  #stepText {\n    font-size: 1.05rem;\n  }\n\n  button {\n    width: 100%;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const stepText = document.getElementById(\"stepText\");\nconst stepImage = document.getElementById(\"stepImage\");\nconst nextButton = document.getElementById(\"nextButton\");\n\nlet step = 1;\n\n\nconst showStep = (currentStep) => {\n  if (currentStep === 1) {\n    stepText.textContent = \"Step 1: Gather your ingredients.\";\n    stepImage.src = \"step1.jpg\";\n    \n  } else if (currentStep === 2) {\n    stepText.textContent = \"Step 2: Mix the dry ingredients.\";\n    stepImage.src = \"step2.jpg\";\n    \n  } else if (currentStep === 3) {\n    stepText.textContent = \"Step 3: Add the wet ingredients.\";\n    stepImage.src = \"step3.jpg\";\n    \n  } else if (currentStep === 4) {\n    stepText.textContent = \"Step 4: Bake for 20 minutes.\";\n    stepImage.src = \"step4.jpg\";\n    \n  } else {\n    stepText.textContent = \"You're all done!\";\n    stepImage.src = \"step5.jpg\";\n  }\n};\n\n\nnextButton.addEventListener(\"click\", () => {\n  step = step + 1;\n  showStep(step);\n});",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
