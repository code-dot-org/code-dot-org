    "display_name": "Music Web App",
    "bubble_choice_description": "Complete the `script.js` code to make your Music Web App work.",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Simple Music Like Tracker</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <main class=\"wrap\">\n    <h1>Hit or Miss</h1>\n\n    <section class=\"card\">\n      <h2>Now Playing:</h2>\n      <p class=\"song-title\">“Lo-Fi Study Beats”</p>\n\n      <div class=\"like-display\">\n        Likes: <span id=\"likeCount\">0</span>\n      </div>\n\n      <div class=\"buttons\">\n        <button id=\"likeBtn\" class=\"btn like\">Like</button>\n        <button id=\"unlikeBtn\" class=\"btn dislike\">Dislike</button>\n        <button id=\"resetBtn\" class=\"btn reset\">Reset</button>\n      </div>\n    </section>\n  </main>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>\n\n  ",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": ":root {\n  --bg: #f1f5f9;        /* light background */\n  --card: #ffffff;      /* white card */\n  --text: #0b1220;      /* dark text */\n  --like: #16a34a;      /* green */\n  --dislike: #dc2626;   /* red */\n  --reset: #2563eb;     /* blue */\n}\n\n* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;\n  background: var(--bg);\n  color: var(--text);\n  display: grid;\n  place-items: center;\n  height: 100vh;\n}\n\n.wrap {\n  text-align: center;\n}\n\nh1 {\n  margin-bottom: 1rem;\n  color: #1e293b;\n}\n\n.card {\n  background: var(--card);\n  color: var(--text);\n  border-radius: 16px;\n  padding: 1.5rem 2rem;\n  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);\n  max-width: 320px;\n}\n\n.song-title {\n  font-weight: 600;\n  font-size: 1.2rem;\n  color: var(--reset);\n  margin-bottom: 1rem;\n}\n\n.like-display {\n  font-size: 1.25rem;\n  margin-bottom: 1rem;\n}\n\n.buttons {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n}\n\n.btn {\n  border: none;\n  border-radius: 8px;\n  padding: 0.6rem 1rem;\n  font-size: 1rem;\n  font-weight: 600;\n  color: white;\n  cursor: pointer;\n  transition: background 0.2s, transform 0.1s;\n}\n\n.btn:hover { transform: scale(1.03); }\n.btn:active { transform: scale(0.97); }\n\n.like { background: var(--like); }\n.like:hover { background: #15803d; }\n\n.dislike { background: var(--dislike); }\n.dislike:hover { background: #b91c1c; }\n\n.reset { background: var(--reset); }\n.reset:hover { background: #1d4ed8; }\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "// variable for likes\n\n\n\n// references to display element and buttons\nconst likeCount = document.getElementById('likeCount');\nconst likeBtn     = document.getElementById('likeBtn');\nconst unlikeBtn   = document.getElementById('unlikeBtn');\nconst resetBtn    = document.getElementById('resetBtn');\n\n// increases likes by 1 and updates the display\nlikeBtn.addEventListener('click', () => {\n\n  \n\n});\n\n// decreases likes by 1 and updates the display\nunlikeBtn.addEventListener('click', () => {\n\n\n  \n});\n\n// resets likes to 0 and updates the display\nresetBtn.addEventListener('click', () => {\n\n  \n\n});",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "3"
      ]
    },
