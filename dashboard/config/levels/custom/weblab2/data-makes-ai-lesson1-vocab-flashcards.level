      "files": {
        "6f308134-7136-4480-a501-e93dc06a8b08": {
          "id": "6f308134-7136-4480-a501-e93dc06a8b08",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en-US\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Vocabulary cards</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"app\" id=\"app\">\n    <h1 class=\"deck-title\" id=\"deck-title\">Vocabulary cards</h1>\n\n    <div class=\"stage\">\n      <div class=\"card\" id=\"card\" tabindex=\"0\" role=\"group\" aria-labelledby=\"deck-title\" hidden>\n        <div class=\"card-inner\">\n          <section class=\"card-face card-front\" id=\"card-front\">\n            <span class=\"card-label\"></span>\n            <div class=\"card-content\"></div>\n            <p class=\"card-hint\"></p>\n          </section>\n          <section class=\"card-face card-back\" id=\"card-back\" aria-hidden=\"true\">\n            <span class=\"card-label\"></span>\n            <div class=\"card-content\"></div>\n          </section>\n        </div>\n      </div>\n\n      <div class=\"message\" id=\"message\" tabindex=\"-1\">\n        <p class=\"message-text\" id=\"message-text\">Loading cards...</p>\n        <p class=\"message-detail\" id=\"message-detail\" hidden></p>\n        <div class=\"message-actions\" id=\"message-actions\" hidden>\n          <button type=\"button\" class=\"btn\" id=\"finish-restart\">\n            <span class=\"btn-label\">Start over</span>\n            <span class=\"btn-key\">R</span>\n          </button>\n          <button type=\"button\" class=\"btn btn-secondary\" id=\"finish-review\" hidden>\n            <span class=\"btn-label\"></span>\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"controls controls-primary\">\n      <button type=\"button\" class=\"btn\" id=\"btn-back\" disabled>\n        <span class=\"btn-label\">Back</span>\n        <span class=\"btn-key\">Left</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-flip\" id=\"btn-flip\" disabled>\n        <span class=\"btn-label\">Flip</span>\n        <span class=\"btn-key\">Space</span>\n      </button>\n      <button type=\"button\" class=\"btn\" id=\"btn-next\" disabled>\n        <span class=\"btn-label\">Next</span>\n        <span class=\"btn-key\">Right</span>\n      </button>\n    </div>\n\n    <fieldset class=\"controls controls-secondary\" id=\"options\">\n      <legend class=\"visually-hidden\" id=\"options-legend\">Card options</legend>\n      <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-shuffle\" disabled>\n        <span class=\"btn-label\">Shuffle</span>\n        <span class=\"btn-key\">S</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-direction\" disabled>\n        <span class=\"btn-label\">Start from definition</span>\n        <span class=\"btn-key\">F</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-secondary btn-toggle\" id=\"btn-known\" aria-pressed=\"false\" disabled>\n        <span class=\"btn-label\">\n          <svg class=\"check-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2.5 8.5l3.5 3.5 7.5-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          <span class=\"btn-text\">Got it</span>\n        </span>\n        <span class=\"btn-key\">K</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-restart\" disabled>\n        <span class=\"btn-label\">Start over</span>\n        <span class=\"btn-key\">R</span>\n      </button>\n    </fieldset>\n\n    <div class=\"status\" aria-live=\"polite\">\n      <p class=\"counter\" id=\"counter\"></p>\n      <p class=\"visually-hidden\" id=\"sr-status\"></p>\n    </div>\n  </main>\n</body>\n</html>\n",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "54c0fbb8-98f8-479d-99f1-5b2524a651f2": {
          "id": "54c0fbb8-98f8-479d-99f1-5b2524a651f2",
          "name": "style.css",
          "contents": ":root {\n  --bg: #E4E2F8;\n  --card-face: #FFFFFF;\n  --text: #000000;\n  --accent: #4C42CF;\n  --accent-text: #FFFFFF;\n  --frame-word: #0099F3;\n  --frame-definition: #003F25;\n  --frame-example: #F46800;\n  --frame-image: #4C42CF;\n  --label-text-word: #000000;\n  --label-text-definition: #FFFFFF;\n  --label-text-example: #000000;\n  --label-text-image: #FFFFFF;\n  --font: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nhtml {\n  -webkit-text-size-adjust: 100%;\n  text-size-adjust: 100%;\n}\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  background: var(--bg);\n  color: var(--text);\n  font-family: var(--font);\n  line-height: 1.4;\n}\n\n.app {\n  --word-size: clamp(1.75rem, 7cqw, 3rem);\n  --body-size: clamp(1rem, 3.6cqw, 1.375rem);\n  --sub-size: clamp(0.95rem, 3cqw, 1.125rem);\n  --radius: 16px;\n  --content-justify: center;\n  --content-align: center;\n  --text-align: center;\n  width: 100%;\n  max-width: 640px;\n  margin-inline: auto;\n  padding-block: 24px 40px;\n  padding-inline: 16px;\n  font-family: var(--font);\n  color: var(--text);\n}\n\n.app[data-word-size=\"medium\"] {\n  --word-size: clamp(1.5rem, 5.5cqw, 2.25rem);\n}\n\n.app[data-word-size=\"xlarge\"] {\n  --word-size: clamp(2rem, 9cqw, 3.75rem);\n}\n\n.app[data-corner-radius=\"none\"] {\n  --radius: 0px;\n}\n\n.app[data-corner-radius=\"round\"] {\n  --radius: 32px;\n}\n\n.app[data-text-align=\"start\"] {\n  --content-align: flex-start;\n  --text-align: start;\n}\n\n.app[data-text-position=\"top\"] {\n  --content-justify: flex-start;\n}\n\n.deck-title {\n  margin-block: 0 20px;\n  font-size: clamp(1.5rem, 5vw, 2rem);\n  line-height: 1.2;\n  text-align: center;\n}\n\n.stage {\n  container-type: inline-size;\n  width: 100%;\n  max-width: 560px;\n  margin-inline: auto;\n}\n\n/* Card */\n\n.card {\n  position: relative;\n  width: 100%;\n  border-radius: var(--radius);\n  perspective: 1400px;\n}\n\n.card:focus {\n  outline: none;\n}\n\n.card:focus-visible {\n  outline: 4px solid var(--text);\n  outline-offset: 4px;\n}\n\n.card-inner {\n  display: grid;\n  aspect-ratio: 3 / 2;\n  transform-style: preserve-3d;\n  transition: transform 0.5s ease;\n}\n\n.card.is-flipped .card-inner {\n  transform: rotateY(180deg);\n}\n\n.card.no-animation .card-inner {\n  transition: none;\n}\n\n.card-face {\n  --frame: var(--frame-word);\n  --label-text: var(--label-text-word);\n  position: relative;\n  grid-area: 1 / 1;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  padding-block: 3rem 1rem;\n  padding-inline: 1.25rem;\n  border: 8px solid var(--frame);\n  border-radius: var(--radius);\n  background: var(--card-face);\n  color: var(--text);\n  -webkit-backface-visibility: hidden;\n  backface-visibility: hidden;\n}\n\n.card-back {\n  transform: rotateY(180deg);\n}\n\n.card-face[data-kind=\"definition\"] {\n  --frame: var(--frame-definition);\n  --label-text: var(--label-text-definition);\n}\n\n.card-face[data-kind=\"example\"] {\n  --frame: var(--frame-example);\n  --label-text: var(--label-text-example);\n}\n\n.card-face[data-kind=\"image\"] {\n  --frame: var(--frame-image);\n  --label-text: var(--label-text-image);\n}\n\n.card-label {\n  position: absolute;\n  inset-block-start: 0;\n  inset-inline-start: 0;\n  padding-block: 0.3rem 0.4rem;\n  padding-inline: 0.9rem;\n  border-end-end-radius: 10px;\n  background: var(--frame);\n  color: var(--label-text);\n  font-size: 0.85rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  line-height: 1.2;\n}\n\n.app[data-corner-radius=\"none\"] .card-label {\n  border-end-end-radius: 0;\n}\n\n.card-content {\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  justify-content: var(--content-justify);\n  align-items: var(--content-align);\n  gap: 0.5rem;\n  min-height: 0;\n  text-align: var(--text-align);\n}\n\n.content-word {\n  margin: 0;\n  max-width: 100%;\n  font-size: var(--word-size);\n  font-weight: 700;\n  line-height: 1.1;\n  overflow-wrap: anywhere;\n}\n\n.content-text {\n  margin: 0;\n  max-width: 36ch;\n  font-size: var(--body-size);\n  line-height: 1.4;\n}\n\n.content-sub {\n  margin: 0;\n  max-width: 40ch;\n  font-size: var(--sub-size);\n  line-height: 1.4;\n}\n\n.content-image {\n  display: block;\n  width: clamp(96px, 30cqw, 168px);\n  height: auto;\n  max-height: 100%;\n}\n\n.card-hint {\n  margin-block: 0.75rem 0;\n  font-size: 0.95rem;\n  font-weight: 600;\n  text-align: center;\n}\n\n/* Loading, error, and finish states */\n\n.message {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 1rem;\n  aspect-ratio: 3 / 2;\n  padding: 1.5rem;\n  border: 3px dashed var(--text);\n  border-radius: var(--radius);\n  background: var(--card-face);\n  color: var(--text);\n  text-align: center;\n}\n\n.message:focus {\n  outline: none;\n}\n\n.message:focus-visible {\n  outline: 4px solid var(--text);\n  outline-offset: 4px;\n}\n\n.message-text {\n  margin: 0;\n  font-size: var(--body-size);\n  font-weight: 700;\n}\n\n.message-detail {\n  margin: 0;\n}\n\n.message-actions {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 12px;\n}\n\n/* Buttons */\n\n.controls {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 12px;\n  margin-block: 20px 0;\n  margin-inline: auto;\n  max-width: 560px;\n}\n\n.controls-secondary {\n  min-width: 0;\n  padding: 0;\n  border: 0;\n}\n\n.btn {\n  display: inline-flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 2px;\n  min-width: 96px;\n  min-height: 52px;\n  padding-block: 6px;\n  padding-inline: 18px;\n  border: 3px solid var(--accent);\n  border-radius: 12px;\n  background: var(--accent);\n  color: var(--accent-text);\n  font: inherit;\n  font-weight: 700;\n  line-height: 1.2;\n  cursor: pointer;\n  touch-action: manipulation;\n}\n\n.btn-flip {\n  min-width: 128px;\n}\n\n.btn-secondary {\n  min-height: 44px;\n  border-color: var(--text);\n  background: var(--card-face);\n  color: var(--text);\n}\n\n.btn-toggle[aria-pressed=\"true\"] {\n  border-color: var(--accent);\n  background: var(--accent);\n  color: var(--accent-text);\n}\n\n.btn:focus {\n  outline: none;\n}\n\n.btn:focus-visible {\n  outline: 3px solid var(--text);\n  outline-offset: 3px;\n}\n\n.btn:disabled,\n.btn[aria-disabled=\"true\"] {\n  cursor: not-allowed;\n  opacity: 0.45;\n}\n\n.btn-label {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.btn-key {\n  font-size: 0.75rem;\n  font-weight: 500;\n}\n\n.check-icon {\n  display: none;\n  width: 1em;\n  height: 1em;\n}\n\n.btn-toggle[aria-pressed=\"true\"] .check-icon {\n  display: block;\n}\n\n/* Status */\n\n.status {\n  margin-block-start: 16px;\n  text-align: center;\n}\n\n.counter {\n  margin: 0;\n  font-weight: 600;\n}\n\n.counter-part + .counter-part {\n  margin-inline-start: 1.25em;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .card-inner {\n    transition: none;\n  }\n}\n",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "NaN": {
          "id": "NaN",
          "name": "config.json",
          "contents": "{\n  \"schemaVersion\": 1,\n  \"configId\": \"codeai-default\",\n  \"theme\": {\n    \"background\": \"#E4E2F8\",\n    \"cardFace\": \"#FFFFFF\",\n    \"textColor\": \"#000000\",\n    \"accent\": \"#4C42CF\",\n    \"frameColors\": {\n      \"word\": \"#0099F3\",\n      \"definition\": \"#003F25\",\n      \"example\": \"#F46800\",\n      \"image\": \"#4C42CF\"\n    },\n    \"fontFamily\": \"system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif\",\n    \"wordSize\": \"large\",\n    \"textAlign\": \"center\",\n    \"textPosition\": \"center\",\n    \"cornerRadius\": \"medium\"\n  },\n  \"controls\": {\n    \"shuffle\": true,\n    \"flipDirection\": true,\n    \"progressCounter\": true,\n    \"markKnown\": true\n  },\n  \"startFlipped\": false,\n  \"startShuffled\": false\n}",
          "folderId": "0",
          "active": false
        }
