        "6f308134-7136-4480-a501-e93dc06a8b08": {
          "id": "6f308134-7136-4480-a501-e93dc06a8b08",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Web Lab Flashcards</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <header>\n        <h1>Understanding AI: Key Terms</h1>\n    </header>\n    <main class=\"flashcard-container\">\n        <div class=\"flashcard\">\n            <div class=\"term\">\n                <h3>Feature</h3>\n            </div>\n            <div class=\"definition\">\n                <p>A characteristic or attribute of an object or data that can be used for classification or analysis.</p>\n            </div>\n        </div>\n        <div class=\"flashcard\">\n            <div class=\"term\">\n                <h3>Dataset</h3>\n            </div>\n            <div class=\"definition\">\n                <p>A collection of related information, often organized in tables or other structures, used to train AI models.</p>\n            </div>\n        </div>\n    </main>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "54c0fbb8-98f8-479d-99f1-5b2524a651f2": {
          "id": "54c0fbb8-98f8-479d-99f1-5b2524a651f2",
          "name": "style.css",
          "contents": "body {\n    font-family: sans-serif;\n    background-color: #f0f2f5;\n    color: #333;\n    margin: 0;\n    padding: 20px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n}\n\nh1 {\n    color: #0056b3;\n    margin-bottom: 30px;\n}\n\n.flashcard-container {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 20px;\n    justify-content: center;\n}\n\n.flashcard {\n    background-color: #fff;\n    border-radius: 8px;\n    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);\n    width: 250px;\n    min-height: 150px;\n    padding: 20px;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    text-align: center;\n    cursor: pointer;\n    transition: transform 0.2s ease-in-out;\n}\n\n.flashcard:hover {\n    transform: translateY(-5px);\n}\n\n.flashcard .term h3 {\n    margin: 0;\n    color: #007bff;\n    font-size: 1.5em;\n}\n\n.flashcard .definition {\n    margin-top: 15px;\n    font-size: 0.9em;\n    color: #555;\n    display: none; /* Hide definition by default */\n}\n\n.flashcard:hover .definition {\n    display: block; /* Show definition on hover */\n}\n",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
