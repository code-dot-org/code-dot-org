      "codeEditableAfterSubmit": false
    },
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Transit Planner</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&family=Oswald:wght@500&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <header>\n    <h1>🚆 Metro Expansion Queue</h1>\n    <div class=\"stats-container\">\n      <p class=\"stat-box built\">Stops Built: <span id=\"builtCount\">0</span></p>\n      <p class=\"stat-box skipped\">Skipped: <span id=\"skippedCount\">0</span></p>\n    </div>\n  </header>\n\n  <main>\n    <div class=\"controls\">\n      <button id=\"btnBuild\">Build Stop 🏗️</button>\n      <button id=\"btnSkip\">Skip Stop ⏭️</button>\n    </div>\n\n    <div class=\"dashboard-grid\">\n      <div class=\"card active-card\" id=\"card-current\">\n        <div class=\"card-header\">\n          <h2>Current Proposal</h2>\n          <span class=\"badge\">Reviewing</span>\n        </div>\n        <div class=\"details\">\n          <p>Loading proposals...</p>\n        </div>\n      </div>\n\n      <div class=\"card next-card\" id=\"card-next\">\n        <div class=\"card-header\">\n          <h2>On Deck</h2>\n        </div>\n        <div class=\"details\">\n          <p>...</p>\n        </div>\n      </div>\n    </div>\n  </main>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// DOM Elements\nconst currentCard = document.querySelector(\"#card-current .details\");\nconst nextCard = document.querySelector(\"#card-next .details\");\nconst builtEl = document.querySelector(\"#builtCount\");\nconst skippedEl = document.querySelector(\"#skippedCount\");\nconst btnBuild = document.querySelector(\"#btnBuild\");\nconst btnSkip = document.querySelector(\"#btnSkip\");\n\n// Data\nlet builtCount = 0;\nlet skippedCount = 0;\nlet proposals = [{ location: \"\", type: \"\", riders: 0, cost: 0, aiPriority: 0 }]; \n\n// Helper Functions\nconst formatCost = (cost) => {\n  // Format number to currency string (e.g. \"$2.5M\")\n};\n\nconst getProposal = (index) => {\n  // Return proposal object at index\n};\n\nconst updateStatus = (index, status) => {\n  // Update status property of proposal\n};\n\nconst shiftProposal = () => {\n  // Remove first item from array and return it\n};\n\n// Render Functions\nconst renderCurrent = () => {\n  // Display proposals[0] details\n};\n\nconst renderNext = () => {\n  // Display proposals[1] summary\n};\n\nconst updateStats = () => {\n  builtEl.innerText = builtCount;\n  skippedEl.innerText = skippedCount;\n};\n\n// Event Listeners\nbtnBuild.addEventListener(\"click\", () => {\n  if (proposals.length > 0) {\n    // 1. Logic\n    updateStatus(0, \"Approved\");\n    shiftProposal();\n    builtCount = builtCount + 1;\n\n    // 2. Render\n    updateStats();\n    renderCurrent();\n    renderNext();\n  }\n});\n\nbtnSkip.addEventListener(\"click\", () => {\n  if (proposals.length > 0) {\n    // 1. Logic\n    updateStatus(0, \"Skipped\");\n    shiftProposal();\n    skippedCount = skippedCount + 1;\n\n    // 2. Render\n    updateStats();\n    renderCurrent();\n    renderNext();\n  }\n});\n\n// Initial Load\nrenderCurrent();\nrenderNext();",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "/* Palette: Urban, Municipal, Transit Map colors */\n:root {\n  --bg-color: #eef2f3;\n  --card-bg: #ffffff;\n  --primary: #2c3e50; /* Asphalt */\n  --accent: #f1c40f;  /* Transit Yellow */\n  --success: #27ae60; /* Green Line */\n  --danger: #e74c3c;  /* Red Line */\n  --text: #34495e;\n  --subtle: #95a5a6;\n}\n\nbody {\n  font-family: 'Roboto', sans-serif;\n  background-color: var(--bg-color);\n  color: var(--text);\n  margin: 0;\n  padding: 20px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n\nheader {\n  text-align: center;\n  margin-bottom: 2rem;\n  width: 100%;\n  max-width: 700px;\n}\n\nh1 {\n  font-family: 'Oswald', sans-serif;\n  color: var(--primary);\n  font-size: 2.5rem;\n  margin-bottom: 15px;\n  letter-spacing: 1px;\n  text-transform: uppercase;\n}\n\n.stats-container {\n  display: flex;\n  justify-content: center;\n  gap: 20px;\n}\n\n.stat-box {\n  background: white;\n  padding: 12px 24px;\n  border-radius: 6px;\n  font-weight: 700;\n  box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n  font-size: 1.1rem;\n}\n\n.built { border-top: 5px solid var(--success); }\n.skipped { border-top: 5px solid var(--subtle); }\n\n.controls {\n  margin-bottom: 30px;\n  display: flex;\n  gap: 20px;\n}\n\nbutton {\n  font-family: 'Oswald', sans-serif;\n  border: none;\n  padding: 15px 30px;\n  font-size: 1.2rem;\n  letter-spacing: 0.5px;\n  border-radius: 4px;\n  cursor: pointer;\n  transition: transform 0.2s;\n  color: white;\n  box-shadow: 0 4px 0 rgba(0,0,0,0.2);\n}\n\nbutton:active {\n  transform: translateY(4px);\n  box-shadow: none;\n}\n\n#btnBuild { background-color: var(--success); }\n#btnSkip { background-color: var(--primary); }\n\n.dashboard-grid {\n  display: flex;\n  gap: 24px;\n  justify-content: center;\n  flex-wrap: wrap;\n}\n\n.card {\n  background: var(--card-bg);\n  border: 1px solid #ddd;\n  border-radius: 8px;\n  padding: 24px;\n  width: 320px;\n  box-shadow: 0 4px 10px rgba(0,0,0,0.05);\n  display: flex;\n  flex-direction: column;\n}\n\n.active-card {\n  border-left: 8px solid var(--accent);\n}\n\n.next-card {\n  border-left: 8px solid var(--subtle);\n  opacity: 0.7;\n  background-color: #f9f9f9;\n}\n\n.card-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  border-bottom: 2px solid #eee;\n  padding-bottom: 12px;\n  margin-bottom: 15px;\n}\n\n.card h2 {\n  font-family: 'Oswald', sans-serif;\n  margin: 0;\n  font-size: 1.4rem;\n  color: var(--primary);\n}\n\n.badge {\n  background-color: var(--primary);\n  color: var(--accent);\n  font-size: 0.7rem;\n  padding: 4px 8px;\n  border-radius: 4px;\n  font-weight: bold;\n  text-transform: uppercase;\n}\n\n.details p {\n  font-size: 1rem;\n  line-height: 1.6;\n  margin: 10px 0;\n}",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "reflection.md",
          "language": "md",
          "contents": "Reflect on the data fairness: explain how the data\nthat AI help generate could unfairly affect the what\nstops might get added in a Metro expansion:\n\n",
