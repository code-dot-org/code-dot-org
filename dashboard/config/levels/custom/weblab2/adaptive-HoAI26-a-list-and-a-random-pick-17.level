<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-10-16T21:32:17.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": "true",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "script.js",
          "contents": "/*\n  Pick one by chance: Who presents the project\n\n  Shaped like Test a Sensor: CONFIG and COPY first, then state, then small\n  named functions. The CADS notes (what is CADS, rebuilt, approximated) are in\n  the comment block at the top of style.css.\n\n  Takeaway: the random pick decides the result; the animation reveals it.\n  Repeated action: pick a presenter.\n\n  Order of events in pickPresenter(): the pick is made first (one random number),\n  then the wheel is told where to land. The animation never chooses anything.\n*/\n'use strict';\n\n/* ---------- CONFIG (author edits here) ---------- */\n\nconst CONFIG = {\n  people: ['maya', 'jordan', 'aiden', 'priya', 'diego'],\n  spinMs: 3200,              // how long the wheel spins\n  spinTurns: 5,              // full turns before it lands\n  spinEasing: 'cubic-bezier(.12, .62, .16, 1)',\n  historyMax: 6,             // past picks shown\n  confettiCount: 20,\n  confettiMs: 900,\n  wheel: { cx: 190, cy: 208, r: 176, labelR: 108 },\n};\n\n/* ---------- COPY (all text the script writes) ---------- */\n\nconst COPY = {\n  personNames: {\n    maya: 'Maya',\n    jordan: 'Jordan',\n    aiden: 'Aiden',\n    priya: 'Priya',\n    diego: 'Diego',\n  },\n\n  resultIdle: '?',\n  resultIdleSr: 'Not picked yet',\n  stepIdle: 'No pick yet',\n  revealSpinning: 'Spinning\\u2026',\n  revealLanded: (name) => `Landed on ${name}`,\n  revealInstant: 'Shown right away',\n  pastNone: 'None yet',\n  announcePick: (name, animated) => (animated ? `Picked ${name}. Spinning.` : `Picked ${name}.`),\n  announceLanded: (name) => `The wheel landed on ${name}.`,\n  announceInstant: (name) => `${name}. Shown right away.`,\n  errorBanner: 'This activity could not start. Reload the page to try again.',\n  codeShow: 'How it was built',\n  codeHide: 'Back to the wheel',\n  announceCodeShown: 'Showing how it was built.',\n  announceCodeHidden: 'Back to the wheel.',\n  promptLead: 'Make my presenter picker ',\n  promptJoin: ', and ',\n  promptPick: 'randomly select one name from my list when I click',\n  promptAnimate: 'add a spinning animation that ends on the selected name',\n  codePick: [\n    'function pickPresenter() {',\n    '  const count = names.length;',\n    '  const pick = Math.floor(Math.random() * count);',\n    '  spinTo(pick);',\n    '}',\n  ].join('\\n'),\n  codeAnimate: [\n    'function spinTo(pick) {',\n    '  const slice = 360 / names.length;',\n    '  const angle = 360 * 5 - (pick + 0.5) * slice;',\n    '  wheel.style.transition = \"transform 3s ease-out\";',\n    '  wheel.style.transform = `rotate(${angle}deg)`;',\n    '}',\n  ].join('\\n'),\n};\n\n/* ---------- State ---------- */\n\nconst state = {\n  pick: null,                // index chosen by chance, set the instant the button is pressed\n  revealed: null,            // index the animation has finished showing\n  spinning: false,\n  animationOn: true,\n  rotation: 0,               // total degrees the wheel has turned\n  history: [],               // revealed name ids, newest first\n  codeOpen: false,\n};\n\nconst el = {};               // cached nodes, filled in by cacheElements\nlet announceTimer = 0;\n\n/* ---------- Small helpers ---------- */\n\nconst SVG_NS = 'http://www.w3.org/2000/svg';\n\nfunction byId(id) {\n  const node = document.getElementById(id);\n  if (!node) {\n    throw new Error(`Missing element: ${id}`);\n  }\n  return node;\n}\n\nfunction makeNode(tag, className) {\n  const node = document.createElement(tag);\n  if (className) {\n    node.className = className;\n  }\n  return node;\n}\n\nfunction svgNode(tag, attrs) {\n  const node = document.createElementNS(SVG_NS, tag);\n  Object.keys(attrs || {}).forEach((key) => {\n    node.setAttribute(key, attrs[key]);\n  });\n  return node;\n}\n\nfunction prefersReducedMotion() {\n  return window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n}\n\nfunction announce(text) {\n  window.clearTimeout(announceTimer);\n  el.announcer.textContent = '';\n  announceTimer = window.setTimeout(() => {\n    el.announcer.textContent = text;\n  }, 40);\n}\n\nfunction showError(text) {\n  const banner = document.getElementById('error-banner');\n  if (banner) {\n    banner.textContent = text;\n    banner.hidden = false;\n  }\n}\n\nfunction makePill(personId) {\n  const pill = makeNode('span', 'pill');\n  pill.dataset.person = personId;\n  pill.textContent = COPY.personNames[personId];\n  return pill;\n}\n\n/* ---------- Build ---------- */\n\nfunction cacheElements() {\n  el.app = byId('app');\n  el.wheel = byId('wheel');\n  el.wheelBox = byId('wheel-box');\n  el.pickButton = byId('pick-btn');\n  el.animToggle = byId('anim-toggle');\n  el.result = byId('result-name');\n  el.resultTile = byId('result-tile');\n  el.history = byId('history');\n  el.stepPick = byId('step-pick');\n  el.stepReveal = byId('step-reveal');\n  el.statusPick = byId('status-pick');\n  el.statusReveal = byId('status-reveal');\n  el.announcer = byId('announcer');\n  el.codeButton = byId('code-btn');\n  el.codePanel = byId('code-panel');\n  el.layout = byId('layout');\n  el.promptText = byId('prompt-text');\n  el.codePick = byId('code-pick');\n  el.codeAnimate = byId('code-animate');\n}\n\nfunction polar(angle, radius) {\n  const { cx, cy } = CONFIG.wheel;\n  const rad = (angle * Math.PI) / 180;\n  return { x: cx + radius * Math.sin(rad), y: cy - radius * Math.cos(rad) };\n}\n\n/* Angles run clockwise from the top. Slice i covers i * slice to (i + 1) * slice. */\nfunction buildWheel() {\n  const { cx, cy, r, labelR } = CONFIG.wheel;\n  const count = CONFIG.people.length;\n  const slice = 360 / count;\n\n  const rotor = svgNode('g', { class: 'rotor' });\n  el.slices = [];\n  CONFIG.people.forEach((personId, index) => {\n    const start = polar(index * slice, r);\n    const end = polar((index + 1) * slice, r);\n    const d = `M ${cx} ${cy} L ${start.x.toFixed(2)} ${start.y.toFixed(2)} A ${r} ${r} 0 0 1 ${end.x.toFixed(2)} ${end.y.toFixed(2)} Z`;\n    const group = svgNode('g', { class: 'slice-group', 'data-person': personId, 'data-win': 'false' });\n    group.append(svgNode('path', { class: 'slice', d }), svgNode('path', { class: 'win-ring', d }));\n\n    const mid = (index + 0.5) * slice;\n    const spot = polar(mid, labelR);\n    const turn = mid <= 180 ? mid - 90 : mid + 90; // keep the words upright, reading along the slice\n    const label = svgNode('text', {\n      class: 'slice-label',\n      transform: `translate(${spot.x.toFixed(2)} ${spot.y.toFixed(2)}) rotate(${turn})`,\n      dy: '0.35em',\n    });\n    label.textContent = COPY.personNames[personId];\n    group.append(label);\n    rotor.append(group);\n    el.slices.push(group);\n  });\n  el.rotor = rotor;\n\n  const rim = svgNode('circle', { class: 'rim', cx, cy, r });\n  const hub = svgNode('circle', { class: 'hub', cx, cy, r: 14 });\n  const pointer = svgNode('polygon', { class: 'pointer', points: `${cx - 15},6 ${cx + 15},6 ${cx},46` });\n  el.wheel.replaceChildren(rotor, rim, hub, pointer);\n}\n\n/* ---------- Render ---------- */\n\nfunction renderResult() {\n  const done = state.revealed !== null;\n  el.resultTile.dataset.state = done ? 'done' : 'idle';\n  if (done) {\n    const personId = CONFIG.people[state.revealed];\n    el.resultTile.dataset.person = personId;\n    el.result.textContent = COPY.personNames[personId];\n  } else {\n    delete el.resultTile.dataset.person;\n    /* The ? is only for the eyes. A screen reader hears \"Presenter, not picked yet\". */\n    const mark = makeNode('span');\n    mark.setAttribute('aria-hidden', 'true');\n    mark.textContent = COPY.resultIdle;\n    const hint = makeNode('span', 'visually-hidden');\n    hint.textContent = COPY.resultIdleSr;\n    el.result.replaceChildren(mark, hint);\n  }\n}\n\nfunction renderHistory() {\n  if (state.history.length === 0) {\n    const none = makeNode('li', 'past-empty');\n    none.textContent = COPY.pastNone;\n    el.history.replaceChildren(none);\n    return;\n  }\n  const items = state.history.map((personId) => {\n    const item = makeNode('li');\n    item.append(makePill(personId));\n    return item;\n  });\n  el.history.replaceChildren(...items);\n}\n\nfunction renderSteps() {\n  const picked = state.pick !== null;\n  el.stepPick.dataset.state = picked ? 'done' : 'idle';\n  if (picked) {\n    el.statusPick.replaceChildren(makePill(CONFIG.people[state.pick]));\n  } else {\n    el.statusPick.textContent = COPY.stepIdle;\n  }\n\n  if (!picked) {\n    el.stepReveal.dataset.state = 'idle';\n    el.statusReveal.textContent = COPY.stepIdle;\n  } else if (state.spinning) {\n    el.stepReveal.dataset.state = 'active';\n    el.statusReveal.textContent = COPY.revealSpinning;\n  } else {\n    el.stepReveal.dataset.state = 'done';\n    el.statusReveal.textContent = state.revealedInstantly\n      ? COPY.revealInstant\n      : COPY.revealLanded(COPY.personNames[CONFIG.people[state.revealed]]);\n  }\n}\n\nfunction renderControls() {\n  el.pickButton.setAttribute('aria-disabled', String(state.spinning));\n  el.animToggle.setAttribute('aria-checked', String(state.animationOn));\n  el.slices.forEach((group, index) => {\n    group.dataset.win = String(!state.spinning && state.revealed === index);\n  });\n}\n\nfunction renderCode() {\n  el.codeButton.setAttribute('aria-expanded', String(state.codeOpen));\n  el.codeButton.textContent = state.codeOpen ? COPY.codeHide : COPY.codeShow;\n  el.codePanel.hidden = !state.codeOpen;\n  el.layout.hidden = state.codeOpen;\n}\n\nfunction buildPrompt() {\n  const pick = makeNode('mark', 'part part-pick');\n  pick.textContent = COPY.promptPick;\n  const animate = makeNode('mark', 'part part-animate');\n  animate.textContent = COPY.promptAnimate;\n  el.promptText.replaceChildren(COPY.promptLead, pick, COPY.promptJoin, animate, '.');\n  el.codePick.textContent = COPY.codePick;\n  el.codeAnimate.textContent = COPY.codeAnimate;\n}\n\nfunction render() {\n  renderResult();\n  renderHistory();\n  renderSteps();\n  renderControls();\n  renderCode();\n}\n\n/* ---------- Motion ---------- */\n\n/* The rotation that puts the middle of slice `index` under the pointer. */\nfunction rotationFor(index, extraTurns) {\n  const slice = 360 / CONFIG.people.length;\n  const needed = (((360 - (index + 0.5) * slice) % 360) + 360) % 360;\n  const current = state.rotation;\n  const forward = (((needed - (current % 360)) % 360) + 360) % 360;\n  return current + forward + extraTurns * 360;\n}\n\nfunction spinTo(index, animate, done) {\n  state.rotation = rotationFor(index, animate ? CONFIG.spinTurns : 0);\n  el.rotor.style.transition = animate\n    ? `transform ${CONFIG.spinMs}ms ${CONFIG.spinEasing}`\n    : 'none';\n  el.rotor.style.transform = `rotate(${state.rotation}deg)`;\n\n  if (!animate) {\n    done();\n    return;\n  }\n  let finished = false;\n  let timer = 0;\n  const end = () => {\n    if (finished) {\n      return;\n    }\n    finished = true;\n    window.clearTimeout(timer);\n    el.rotor.removeEventListener('transitionend', onEnd);\n    done();\n  };\n  const onEnd = (event) => {\n    if (event.target === el.rotor && event.propertyName === 'transform') {\n      end();\n    }\n  };\n  el.rotor.addEventListener('transitionend', onEnd);\n  timer = window.setTimeout(end, CONFIG.spinMs + 250);\n}\n\n/* A short burst from the middle of the wheel when it lands. */\nfunction burst() {\n  if (prefersReducedMotion() || !el.wheelBox.animate) {\n    return;\n  }\n  const layer = makeNode('span', 'confetti-layer');\n  layer.setAttribute('aria-hidden', 'true');\n  const pieces = [];\n  for (let i = 0; i < CONFIG.confettiCount; i += 1) {\n    const piece = makeNode('span', 'confetti');\n    piece.dataset.person = CONFIG.people[i % CONFIG.people.length];\n    layer.append(piece);\n    pieces.push(piece);\n  }\n  el.wheelBox.append(layer);\n  const easing = getComputedStyle(document.documentElement).getPropertyValue('--easing-out').trim() || 'ease-out';\n  pieces.forEach((piece, i) => {\n    const angle = (i / pieces.length) * Math.PI * 2 + (i % 3) * 0.2;\n    const distance = 70 + (i % 4) * 18;\n    const dx = Math.sin(angle) * distance;\n    const dy = -Math.cos(angle) * distance - 20;\n    const turn = (i % 2 === 0 ? 1 : -1) * 220;\n    piece.animate(\n      [\n        { transform: 'translate(0, 0) rotate(0deg)', opacity: 1 },\n        { transform: `translate(${dx.toFixed(1)}px, ${dy.toFixed(1)}px) rotate(${turn}deg)`, opacity: 0 },\n      ],\n      { duration: CONFIG.confettiMs, easing, fill: 'forwards' },\n    );\n  });\n  window.setTimeout(() => layer.remove(), CONFIG.confettiMs + 100);\n}\n\n/* ---------- Actions ---------- */\n\nfunction finishReveal(index, animated) {\n  state.spinning = false;\n  state.revealed = index;\n  state.revealedInstantly = !animated;\n  state.history.unshift(CONFIG.people[index]);\n  state.history = state.history.slice(0, CONFIG.historyMax);\n  render();\n  const name = COPY.personNames[CONFIG.people[index]];\n  announce(animated ? COPY.announceLanded(name) : COPY.announceInstant(name));\n  if (animated) {\n    burst();\n  }\n}\n\nfunction pickPresenter() {\n  if (state.spinning) {\n    return;\n  }\n  /* Step 1: the random pick. This single line is the only place chance is used. */\n  const index = Math.floor(Math.random() * CONFIG.people.length);\n\n  state.pick = index;\n  state.revealed = null;\n  state.spinning = true;\n  const animate = state.animationOn && !prefersReducedMotion();\n  render();\n  announce(COPY.announcePick(COPY.personNames[CONFIG.people[index]], animate));\n\n  /* Step 2: the animation. It is told where to land and shows the result. */\n  spinTo(index, animate, () => finishReveal(index, animate));\n}\n\nfunction setAnimation(on) {\n  if (state.animationOn === on) {\n    return;\n  }\n  state.animationOn = on; // a switch announces its own state, so nothing extra is announced\n  render();\n}\n\nfunction toggleCode(open) {\n  state.codeOpen = open;\n  render();\n  announce(open ? COPY.announceCodeShown : COPY.announceCodeHidden);\n}\n\n/* ---------- Start ---------- */\n\nfunction bindEvents() {\n  el.pickButton.addEventListener('click', pickPresenter);\n  el.animToggle.addEventListener('click', () => setAnimation(!state.animationOn));\n  el.codeButton.addEventListener('click', () => toggleCode(!state.codeOpen));\n  document.addEventListener('keydown', (event) => {\n    if (event.key === 'Escape' && state.codeOpen) {\n      toggleCode(false);\n      el.codeButton.focus();\n    }\n  });\n}\n\nfunction init() {\n  try {\n    cacheElements();\n    buildWheel();\n    buildPrompt();\n    bindEvents();\n    render();\n  } catch (error) {\n    showError(COPY.errorBanner);\n    console.error(error);\n  }\n}\n\ninit();\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "/* ==========================================================================\n   Pick one by chance: Who presents the project\n   Web Lab widget: index.html, style.css, script.js.\n\n   TAKEAWAY\n   The random pick decides the result; the animation reveals it. Students ask\n   the AI for each part separately.\n\n   WHAT IS CADS\n   - Every color, font family, type size, weight, radius, shadow, spacing\n     step, control height, motion duration and easing is a CADS token used\n     as var(--token-name). No hard-coded colors anywhere else in this file.\n   - Type: three sizes (12, 14 and 24px) and two weights (400 and 600), all\n     CADS tokens, all in the body family. CADS keeps Space Grotesk for display\n     headings only. Text color steps primary (labels, values), secondary\n     (body), quaternary (context).\n   - The :root block below mirrors the CADS runtime tokens this widget uses\n     (runtime v0.1.0, manifest built 2026-10-13), same names and values.\n     Web Lab cannot load the CADS stylesheet, so it is the only place hex\n     values appear. Delete the block if Web Lab ever supplies CADS itself.\n   - Focus ring: 2px --border-focused-primary, as in CADS.\n   - Selected chrome (the switch when on, How it was built while open)\n     uses selected tokens, never brand fills, as the CADS rules say.\n\n   WHAT WAS REBUILT\n   CADS components are React, so these follow the CADS recipe in plain CSS:\n   - Pick a presenter: Button, contained, primary, small (32px, 14px semi-bold,\n     5px/12px padding), stretched to the width of its column. It is the one\n     brand-filled control, as CADS asks.\n   - How it was built: Button, outlined, secondary, small (1px\n     --border-neutral-secondary). It uses selected tokens while the panel is open.\n   - Animation switch: Toggle, small (34 x 18 track, 14px label on the left, check\n     and x icons in the track), the same markup CADS uses: a button with\n     role=\"switch\", aria-checked and aria-labelledby. On uses selected tokens,\n     off uses the neutral septenary tokens.\n   - Name pills: Tag, medium (24px, 12px semi-bold, 6px radius, 1px border).\n     Each pill is tinted with its slice color instead of one Tag color.\n   - Practice label: Tag, brand, large (28px tall, 14px semi-bold, 6px radius,\n     1px border, 5px/10px padding). Not interactive, so a Tag and not a Chip.\n   - Error banner: Alert, error sentiment.\n\n   WHAT WAS APPROXIMATED\n   - Fonts: the tokens name Geist and Space Grotesk, but Web Lab bans\n     external font files, so the stacks fall back to Noto Sans or the system.\n   - Spin: 3.2 seconds with a custom ease-out. CADS motion tokens stop at .2s\n     and have no long, decelerating curve. It is skipped when the Animation\n     switch is Off or the person prefers reduced motion.\n   - Control borders use the CADS --border-neutral-secondary (about 2.4:1 on\n     white). The text label identifies each control, so the edge is not what\n     makes it findable, but check this with your accessibility reviewer.\n   - Padding values (5px, 10px, 12px, .25rem): the smallest CADS spacing token\n     is .5rem, so these are plain rem values copied from the rendered components.\n   - Code panel: a plain card with the --font-family-mono token; CADS has no\n     code block component.\n   - The wheel, its pointer, the confetti, the result tile and the step number\n     badges have no CADS equivalent. Their colors are CADS accent (purple, orange),\n     sentiment-success (green), sentiment-information (blue) and\n     sentiment-warning (yellow) tokens. Sizes are plain rem or SVG values.\n   - Custom properties that are not CADS: --person-light and --person-fill (set\n     per name), --part-bg and --part-line (set per prompt part).\n   ========================================================================== */\n\n:root {\n  /* CADS tokens, mirrored (see the comment block above). Base values first. */\n  --brand-orange-5: #ffe3ce;\n  --brand-orange-30: #ffa868;\n  --brand-purple-5: #e4e2f8;\n  --brand-purple-20: #aca8ea;\n  --sentiment-error-5: #ffdada;\n  --neutral-base-white: #ffffff;\n  --sentiment-warning-30: #ffd35c;\n  --sentiment-warning-5: #fff5da;\n  --brand-purple-60: #4238c4;\n  --neutral-gray-20: #d3d6da;\n  --neutral-gray-5: #f1f2f4;\n  --neutral-gray-10: #e1e3e6;\n  --brand-purple-80: #2b1e9f;\n  --brand-purple-90: #1d1590;\n  --brand-purple-95: #1f1976;\n  --sentiment-success-20: #9be3a3;\n  --brand-purple-30: #928cef;\n  --sentiment-error-50: #eb1414;\n  --brand-purple-50: #4c42cf;\n  --neutral-gray-40: #9ea5ad;\n  --neutral-base-black: #121212;\n  --control-height-small: 32px;\n  --duration-medium: .2s;\n  --duration-short: .15s;\n  --easing-out: cubic-bezier(.23, 1, .32, 1);\n  --easing-standard: cubic-bezier(.4, 0, .2, 1);\n  --font-family-main: \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-family-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\n  --font-weight-semi-bold: 600;\n  --leading-body-sm: 1.375rem;\n  --leading-body-xs: 1.125rem;\n  --leading-heading-md: 2rem;\n  --motion-press-scale: .97;\n  --shape-lg: .625rem;\n  --shape-md: .5rem;\n  --shape-round: 62.4375rem;\n  --shape-sm: .375rem;\n  --spacing-p-xs: 1rem;\n  --spacing-p-xxs: .5rem;\n  --text-body-sm: .875rem;\n  --text-body-xs: .75rem;\n  --sentiment-error-70: #b30f0f;\n  --text-heading-md: 1.5rem;\n  --neutral-gray-70: #596069;\n  --neutral-gray-80: #4b5258;\n  --neutral-gray-90: #363b40;\n  --sentiment-success-5: #d8ffdc;\n  --sentiment-information-5: #d5efff;\n  --sentiment-information-30: #6fcaff;\n  --tracking-overline: .08em;\n\n  /* Semantic tokens */\n  --background-accent-orange-light: var(--brand-orange-5);\n  --background-accent-orange-mid: var(--brand-orange-30);\n  --background-brand-light: var(--brand-purple-5);\n  --background-brand-primary: var(--brand-purple-50);\n  --background-brand-primary-hover: var(--brand-purple-60);\n  --background-warning-light: var(--sentiment-warning-5);\n  --background-warning-mid: var(--sentiment-warning-30);\n  --background-info-light: var(--sentiment-information-5);\n  --background-brand-mid: var(--brand-purple-20);\n  --background-error-light: var(--sentiment-error-5);\n  --background-neutral-primary: var(--neutral-base-white);\n  --background-neutral-secondary: var(--neutral-gray-5);\n  --background-neutral-tertiary: var(--neutral-gray-10);\n  --background-selected-primary: var(--brand-purple-80);\n  --background-selected-strong: var(--brand-purple-95);\n  --background-neutral-septenary: var(--neutral-gray-70);\n  --background-neutral-octonary: var(--neutral-gray-80);\n  --border-brand-mid: var(--brand-purple-30);\n  --border-error-primary: var(--sentiment-error-50);\n  --border-focused-primary: var(--brand-purple-50);\n  --border-neutral-primary: var(--neutral-gray-20);\n  --border-neutral-secondary: var(--neutral-gray-40);\n  --border-neutral-solid: var(--neutral-base-black);\n  --border-selected-primary: var(--brand-purple-80);\n  --text-error-secondary: var(--sentiment-error-70);\n  --text-neutral-primary: var(--neutral-base-black);\n  --text-neutral-primary-inverse: var(--neutral-base-white);\n  --text-neutral-quaternary: var(--neutral-gray-70);\n  --text-neutral-secondary: var(--neutral-gray-90);\n  --text-selected-primary: var(--sentiment-success-5);\n}\n\n\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nhtml,\nbody {\n  block-size: 100%;\n  margin: 0;\n}\n\nbody {\n  background: var(--background-neutral-secondary);\n  color: var(--text-neutral-primary);\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-sm);\n  line-height: var(--leading-body-sm);\n}\n\nbutton {\n  color: inherit;\n  font: inherit;\n}\n\nul,\nol {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n:focus-visible {\n  outline: 2px solid var(--border-focused-primary);\n  outline-offset: 2px;\n}\n\n.visually-hidden {\n  position: absolute;\n  inline-size: 1px;\n  block-size: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  border: 0;\n  clip: rect(0 0 0 0);\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n/* ---------- Name colors (one set per name, read by every piece of that name) ---------- */\n\n[data-person=\"maya\"] {\n  --person-light: var(--background-brand-light);\n  --person-fill: var(--background-brand-mid);\n}\n\n[data-person=\"jordan\"] {\n  --person-light: var(--background-info-light);\n  --person-fill: var(--sentiment-information-30);\n}\n\n[data-person=\"aiden\"] {\n  --person-light: var(--sentiment-success-5);\n  --person-fill: var(--sentiment-success-20);\n}\n\n[data-person=\"priya\"] {\n  --person-light: var(--background-accent-orange-light);\n  --person-fill: var(--background-accent-orange-mid);\n}\n\n[data-person=\"diego\"] {\n  --person-light: var(--background-warning-light);\n  --person-fill: var(--background-warning-mid);\n}\n\n/* ---------- Layout ---------- */\n\n.app {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-p-xxs);\n  container-type: inline-size;\n  max-inline-size: 55rem;\n  min-block-size: 100%;\n  margin-inline: auto;\n  padding: var(--spacing-p-xs);\n}\n\n.layout {\n  display: grid;\n  flex: 1;\n  grid-template-columns: auto minmax(0, 1fr);\n  align-items: center;\n  gap: var(--spacing-p-xs);\n}\n\n.panel {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-p-xs);\n  min-inline-size: 0;\n}\n\n/* ---------- Cards ---------- */\n\n.card {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-p-xxs);\n  min-inline-size: 0;\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  background: var(--background-neutral-primary);\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-lg);\n}\n\n.card-head {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--spacing-p-xxs);\n  min-block-size: var(--control-height-small);\n}\n\n.card-heading {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  gap: 0 var(--spacing-p-xxs);\n  min-inline-size: 0;\n}\n\n.card-sub {\n  color: var(--text-neutral-quaternary);\n}\n\n.card-title {\n  margin: 0;\n  font-size: var(--text-body-sm);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: var(--leading-body-sm);\n}\n\n.overline {\n  margin: 0;\n  color: var(--text-neutral-quaternary);\n  font-size: var(--text-body-xs);\n  font-weight: var(--font-weight-semi-bold);\n  letter-spacing: var(--tracking-overline);\n  line-height: var(--leading-body-xs);\n  text-transform: uppercase;\n}\n\n/* ---------- Buttons ---------- */\n\n.pick-btn,\n.code-btn {\n  min-block-size: var(--control-height-small);\n  padding-inline: 0.75rem;\n  border-radius: var(--shape-sm);\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n  transition: transform var(--duration-short) var(--easing-out),\n    background-color var(--duration-short) var(--easing-standard);\n}\n\n.pick-btn {\n  inline-size: 100%;\n  background: var(--background-brand-primary);\n  border: 1px solid transparent;\n  color: var(--text-neutral-primary-inverse);\n}\n\n.pick-btn:hover:not([aria-disabled=\"true\"]) {\n  background: var(--background-brand-primary-hover);\n}\n\n.pick-btn:active:not([aria-disabled=\"true\"]) {\n  transform: scale(var(--motion-press-scale));\n}\n\n.pick-btn[aria-disabled=\"true\"] {\n  background: var(--background-brand-light);\n  cursor: default;\n}\n\n.code-btn {\n  margin-inline-start: auto;\n  background: var(--background-neutral-primary);\n  border: 1px solid var(--border-neutral-secondary);\n  color: var(--text-neutral-primary);\n}\n\n.code-btn:hover:not([aria-expanded=\"true\"]) {\n  background: var(--background-neutral-tertiary);\n}\n\n.code-btn:active {\n  transform: scale(var(--motion-press-scale));\n}\n\n.code-btn[aria-expanded=\"true\"] {\n  background: var(--background-selected-primary);\n  border-color: var(--border-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n/* Animation switch: CADS Toggle, small (34 x 18 track, 14px label, check and x\n   icons in the track so the state is not shown by color alone). The whole row is\n   the label, so the click target is at least 24px tall. */\n\n.toggle {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--spacing-p-xxs);\n  min-block-size: 1.5rem;\n  cursor: pointer;\n}\n\n.toggle-label {\n  white-space: nowrap;\n}\n\n.toggle-track {\n  position: relative;\n  flex: none;\n  inline-size: 2.125rem;\n  block-size: 1.125rem;\n  padding: 0.125rem;\n  background: var(--toggle-bg);\n  border: 0;\n  border-radius: var(--shape-round);\n  color: var(--toggle-fg);\n  cursor: pointer;\n  transition: background-color var(--duration-short) var(--easing-standard);\n}\n\n.toggle-track[aria-checked=\"true\"] {\n  --toggle-bg: var(--background-selected-primary);\n  --toggle-bg-hover: var(--background-selected-strong);\n  --toggle-fg: var(--text-selected-primary);\n}\n\n.toggle-track[aria-checked=\"false\"] {\n  --toggle-bg: var(--background-neutral-septenary);\n  --toggle-bg-hover: var(--background-neutral-octonary);\n  --toggle-fg: var(--text-neutral-primary-inverse);\n}\n\n.toggle-track:hover {\n  background: var(--toggle-bg-hover);\n}\n\n.toggle-handle {\n  position: absolute;\n  inset-block-start: 0.125rem;\n  inset-inline-start: 0.125rem;\n  inline-size: 0.875rem;\n  block-size: 0.875rem;\n  background: var(--toggle-fg);\n  border-radius: var(--shape-round);\n  transition: inset-inline-start var(--duration-short) var(--easing-standard);\n}\n\n.toggle-track[aria-checked=\"true\"] .toggle-handle {\n  inset-inline-start: 1.125rem;\n}\n\n.toggle-icon {\n  position: absolute;\n  inset-block-start: 50%;\n  inline-size: 0.5625rem;\n  block-size: 0.5625rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  stroke-width: 1.6;\n  transform: translateY(-50%);\n}\n\n.toggle-icon-on {\n  inset-inline-start: 0.375rem;\n}\n\n.toggle-icon-off {\n  inset-inline-end: 0.375rem;\n}\n\n.toggle-track[aria-checked=\"true\"] .toggle-icon-off,\n.toggle-track[aria-checked=\"false\"] .toggle-icon-on {\n  opacity: 0;\n}\n\n/* ---------- Wheel ---------- */\n\n.wheel-box {\n  position: relative;\n  display: grid;\n  justify-items: center;\n}\n\n.wheel {\n  display: block;\n  inline-size: 23.75rem;\n  max-inline-size: 100%;\n  block-size: auto;\n  aspect-ratio: 380 / 400;\n  overflow: visible;\n}\n\n.rotor {\n  transform-box: view-box;\n  transform-origin: 190px 208px;\n}\n\n.slice {\n  fill: var(--person-fill);\n  stroke: var(--border-neutral-solid);\n  stroke-width: 2;\n  stroke-linejoin: round;\n}\n\n.win-ring {\n  fill: none;\n  stroke: var(--border-neutral-solid);\n  stroke-width: 5;\n  stroke-linejoin: round;\n  opacity: 0;\n  transition: opacity var(--duration-medium) var(--easing-standard);\n}\n\n.slice-group[data-win=\"true\"] .win-ring {\n  opacity: 1;\n}\n\n.slice-label {\n  fill: var(--text-neutral-primary);\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-sm);\n  font-weight: var(--font-weight-semi-bold);\n  text-anchor: middle;\n}\n\n.rim {\n  fill: none;\n  stroke: var(--border-neutral-solid);\n  stroke-width: 2;\n}\n\n.pointer {\n  fill: var(--border-neutral-solid);\n  stroke: var(--background-neutral-primary);\n  stroke-width: 2;\n  stroke-linejoin: round;\n}\n\n.hub {\n  fill: var(--background-neutral-primary);\n  stroke: var(--border-neutral-solid);\n  stroke-width: 2;\n}\n\n.confetti-layer {\n  position: absolute;\n  inset: 0;\n  overflow: hidden;\n  pointer-events: none;\n}\n\n.confetti {\n  position: absolute;\n  inset-inline-start: 50%;\n  inset-block-start: 52%;\n  inline-size: 0.5rem;\n  block-size: 0.75rem;\n  background: var(--person-fill);\n  border: 1px solid var(--border-neutral-solid);\n  border-radius: 2px;\n}\n\n/* ---------- Title, result, controls, past picks ---------- */\n\n.panel-title {\n  margin: 0;\n  font-size: var(--text-heading-md);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: var(--leading-heading-md);\n}\n\n.result-tile {\n  display: grid;\n  align-content: space-between;\n  min-block-size: 6rem;\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  background: var(--background-neutral-primary);\n  border: 2px dashed var(--border-neutral-secondary);\n  border-radius: var(--shape-lg);\n  transition: background-color var(--duration-medium) var(--easing-standard);\n}\n\n.result-tile[data-state=\"done\"] {\n  background: var(--person-fill);\n  border: 2px solid var(--border-neutral-solid);\n}\n\n.result-name {\n  margin: 0;\n  color: var(--text-neutral-quaternary);\n  font-size: var(--text-heading-md);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: var(--leading-heading-md);\n  text-align: center;\n}\n\n.result-tile[data-state=\"done\"] .result-name {\n  color: var(--text-neutral-primary);\n}\n\n.result-tile[data-state=\"done\"] .overline {\n  color: var(--text-neutral-secondary);\n}\n\n.controls {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n}\n\n.past {\n  display: grid;\n  gap: 0.25rem;\n}\n\n.history {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.25rem;\n  min-block-size: 1.5rem;\n}\n\n.past-empty {\n  color: var(--text-neutral-quaternary);\n}\n\n.pill {\n  display: inline-flex;\n  align-items: center;\n  block-size: 1.5rem;\n  padding-inline: var(--spacing-p-xxs);\n  background: var(--person-light);\n  border: 1px solid var(--person-fill);\n  border-radius: var(--shape-sm);\n  font-size: var(--text-body-xs);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: var(--leading-body-xs);\n  white-space: nowrap;\n}\n\n/* ---------- Behind the scenes (inside How it was built) ---------- */\n\n.step-row {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: var(--spacing-p-xxs);\n}\n\n.step-card {\n  min-block-size: 0;\n  border-block-start: 3px solid var(--part-line);\n}\n\n.step-head {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr) auto;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  min-block-size: var(--control-height-small);\n}\n\n.step-num {\n  display: grid;\n  place-items: center;\n  inline-size: 1.5rem;\n  block-size: 1.5rem;\n  background: var(--background-neutral-primary);\n  border: 1px solid var(--border-neutral-solid);\n  border-radius: var(--shape-round);\n  font-size: var(--text-body-xs);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.step-status {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  min-block-size: 1.5rem;\n  color: var(--text-neutral-secondary);\n  text-align: end;\n  white-space: nowrap;\n}\n\n.step-card[data-state=\"idle\"] .step-status {\n  color: var(--text-neutral-quaternary);\n}\n\n.note {\n  margin: 0;\n  color: var(--text-neutral-secondary);\n}\n\n.error-banner {\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  background: var(--background-error-light);\n  border: 1px solid var(--border-error-primary);\n  border-radius: var(--shape-md);\n  color: var(--text-error-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n/* ---------- Header row ---------- */\n\n.toolbar {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  gap: var(--spacing-p-xxs);\n  margin-block-end: var(--spacing-p-xxs);\n}\n\n/* ---------- Practice header (top of the app)\n   PATTERN TO COPY TO OTHER WIDGETS\n   Line 1:  [Practice] Goal: what students get out of trying this (95 characters or fewer).\n   Line 2:  Do This: the steps, in order, as plain commands (105 characters or fewer).\n   This widget leaves line 2 out; the instruction panel beside it carries the steps.\n   - Goal says what they are doing it for. It does not say they are building the thing.\n   - One type size (14px). Hierarchy comes from color: the Goal label is primary and\n     semi-bold, the sentence is quaternary.\n   - The Goal must fit on one line at 880px wide.\n   ---------- */\n\n.intro {\n  display: grid;\n  flex: 1 1 0;\n  gap: 0.25rem;\n  min-inline-size: 0;\n}\n\n.intro-practice {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.25rem var(--spacing-p-xxs);\n  margin: 0;\n  color: var(--text-neutral-quaternary);\n}\n\n.intro-practice strong {\n  color: var(--text-neutral-primary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.intro-label {\n  display: inline-flex;\n  align-items: center;\n  block-size: 1.75rem;\n  padding-inline: 0.625rem;\n  background: var(--background-brand-light);\n  border: 1px solid var(--border-brand-mid);\n  border-radius: var(--shape-sm);\n  color: var(--brand-purple-90);\n  font-size: var(--text-body-sm);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: var(--leading-body-sm);\n}\n\n/* ---------- How it was built ----------\n   The sample prompt is the main thing on this view. Its two parts are tinted,\n   and the same tints mark the matching code below. Each tint is paired with a\n   label, so color is never the only cue. */\n\n.part-pick {\n  --part-bg: var(--background-brand-light);\n  --part-line: var(--border-brand-mid);\n}\n\n.part-animate {\n  --part-bg: var(--background-info-light);\n  --part-line: var(--sentiment-information-30);\n}\n\n.code-panel {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  gap: var(--spacing-p-xxs);\n  min-block-size: 0;\n}\n\n.prompt-card {\n  gap: var(--spacing-p-xs);\n}\n\n.prompt-text {\n  margin: 0;\n  font-size: var(--text-heading-md);\n  line-height: var(--leading-heading-md);\n}\n\nmark.part {\n  padding-inline: 0.125rem;\n  background: var(--part-bg);\n  box-shadow: inset 0 -2px 0 var(--part-line);\n  color: inherit;\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.code {\n  margin: 0;\n  padding: var(--spacing-p-xxs);\n  overflow-x: auto;\n  background: var(--background-neutral-secondary);\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  font-family: var(--font-family-mono);\n  font-size: var(--text-body-xs);\n  line-height: var(--leading-body-xs);\n}\n\n.code code {\n  font: inherit;\n  white-space: pre;\n}\n\n/* ---------- Motion ---------- */\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n}\n\n/* ---------- Stacked layout under 48rem ---------- */\n\n@container (max-width: 47.9375rem) {\n  .toolbar {\n    flex-direction: column;\n    align-items: stretch;\n    margin-block-end: 0;\n  }\n\n  .intro {\n    gap: 0;\n  }\n\n  .code-btn {\n    align-self: flex-start;\n    margin-inline-start: 0;\n  }\n\n  .layout {\n    grid-template-columns: minmax(0, 1fr);\n    align-content: start;\n  }\n\n  .wheel {\n    inline-size: min(23.75rem, 100%);\n  }\n\n  .step-row {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .prompt-text {\n    font-size: var(--text-body-sm);\n    line-height: var(--leading-body-sm);\n  }\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Pick one by chance: Who presents the project</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <main class=\"app\" id=\"app\">\n    <h1 class=\"visually-hidden\">Pick one by chance: Who presents the project</h1>\n\n    <div class=\"error-banner\" id=\"error-banner\" role=\"alert\" hidden></div>\n\n    <div class=\"toolbar\">\n      <div class=\"intro\">\n        <p class=\"intro-practice\">\n          <span class=\"intro-label\">Practice</span>\n          <span><strong>Goal:</strong> see how a button can pick one name by chance and an animation can reveal it.</span>\n        </p>\n      </div>\n      <button type=\"button\" class=\"code-btn\" id=\"code-btn\" aria-expanded=\"false\" aria-controls=\"code-panel\">How it was built</button>\n    </div>\n\n    <div class=\"layout\" id=\"layout\">\n      <div class=\"wheel-box\" id=\"wheel-box\">\n        <svg class=\"wheel\" id=\"wheel\" viewBox=\"0 0 380 400\" role=\"img\" aria-label=\"A wheel with five names: Maya, Jordan, Aiden, Priya and Diego\"></svg>\n      </div>\n\n      <div class=\"panel\">\n        <h2 class=\"panel-title\">Who presents the project</h2>\n\n        <div class=\"result-tile\" id=\"result-tile\" data-state=\"idle\">\n          <span class=\"overline\">Presenter</span>\n          <p class=\"result-name\" id=\"result-name\"></p>\n        </div>\n\n        <div class=\"controls\">\n          <button type=\"button\" class=\"pick-btn\" id=\"pick-btn\">Pick a presenter</button>\n          <label class=\"toggle\">\n            <span class=\"toggle-label\" id=\"anim-label\">Animation</span>\n            <button type=\"button\" class=\"toggle-track\" id=\"anim-toggle\" role=\"switch\" aria-checked=\"true\" aria-labelledby=\"anim-label\">\n              <svg class=\"toggle-icon toggle-icon-on\" viewBox=\"0 0 10 10\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M1.5 5.4 4 7.9 8.6 2.4\"/></svg>\n              <svg class=\"toggle-icon toggle-icon-off\" viewBox=\"0 0 10 10\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2 2 8 8M8 2 2 8\"/></svg>\n              <span class=\"toggle-handle\" aria-hidden=\"true\"></span>\n            </button>\n          </label>\n        </div>\n\n        <div class=\"past\">\n          <span class=\"overline\">Past picks</span>\n          <ul class=\"history\" id=\"history\"></ul>\n        </div>\n      </div>\n    </div>\n\n    <section class=\"code-panel\" id=\"code-panel\" aria-labelledby=\"code-title\" hidden>\n      <h2 class=\"visually-hidden\" id=\"code-title\">How it was built</h2>\n      <div class=\"card prompt-card\">\n        <h3 class=\"card-title\">Sample prompt to build this with AI</h3>\n        <p class=\"prompt-text\" id=\"prompt-text\"></p>\n        <p class=\"note\">The pick decides the result. The animation reveals it.</p>\n      </div>\n\n      <p class=\"overline\">Behind the scenes</p>\n      <ol class=\"step-row\">\n        <li class=\"card step-card part-pick\" id=\"step-pick\" data-state=\"idle\">\n          <div class=\"step-head\">\n            <span class=\"step-num\" aria-hidden=\"true\">1</span>\n            <div class=\"card-heading\">\n              <h3 class=\"card-title\" id=\"code-pick-title\">Random pick</h3>\n              <span class=\"card-sub\">Chooses one by chance</span>\n            </div>\n            <span class=\"step-status\" id=\"status-pick\"></span>\n          </div>\n          <pre class=\"code\" tabindex=\"0\" aria-labelledby=\"code-pick-title\"><code id=\"code-pick\"></code></pre>\n        </li>\n        <li class=\"card step-card part-animate\" id=\"step-reveal\" data-state=\"idle\">\n          <div class=\"step-head\">\n            <span class=\"step-num\" aria-hidden=\"true\">2</span>\n            <div class=\"card-heading\">\n              <h3 class=\"card-title\" id=\"code-animate-title\">Animation</h3>\n              <span class=\"card-sub\">Reveals the result</span>\n            </div>\n            <span class=\"step-status\" id=\"status-reveal\"></span>\n          </div>\n          <pre class=\"code\" tabindex=\"0\" aria-labelledby=\"code-animate-title\"><code id=\"code-animate\"></code></pre>\n        </li>\n      </ol>\n    </section>\n\n    <div class=\"visually-hidden\" id=\"announcer\" aria-live=\"polite\" aria-atomic=\"true\"></div>\n  </main>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    },
    "long_instructions": "###Pick one by chance\r\n\r\n**Do This:**\r\n\r\n1. Select Pick a presenter a few times.\r\n2. Turn Animation off and pick again.\r\n3. Select How it was built.\r\n4. Find the part of the prompt that picks and the part that animates.\r\n\r\nRemember: The random pick decides the result. The animation reveals it.",
