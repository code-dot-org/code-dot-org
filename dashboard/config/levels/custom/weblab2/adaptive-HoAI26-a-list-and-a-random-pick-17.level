<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-10-16T21:32:17.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": true,
    "start_sources": {
      "folders": {
      },
      "files": {
        "c0da03fd-3a9b-4e1a-88ac-ff9a77a3fff7": {
          "id": "c0da03fd-3a9b-4e1a-88ac-ff9a77a3fff7",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Random Picker Widget</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <div class=\"container\">\n        <h1>Random Item Picker</h1>\n\n        <div class=\"list-manager\">\n            <h2>Your Options</h2>\n            <ul id=\"optionList\">\n                <li>Apple</li>\n                <li>Banana</li>\n                <li>Cherry</li>\n            </ul>\n            <div class=\"controls\">\n                <input type=\"text\" id=\"newItemInput\" placeholder=\"Add a new option\">\n                <button id=\"addItemBtn\">Add Item</button>\n                <button id=\"removeLastItemBtn\">Remove Last</button>\n            </div>\n        </div>\n\n        <div class=\"picker-area\">\n            <button id=\"pickRandomBtn\">Pick Random!</button>\n            <p>Today's Pick:</p>\n            <div id=\"pickedItemDisplay\" class=\"picked-item\"></div>\n        </div>\n    </div>\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "24439cf4-3eb2-4fc9-bb7e-817d3c9fc6dc": {
          "id": "24439cf4-3eb2-4fc9-bb7e-817d3c9fc6dc",
          "name": "style.css",
          "contents": "body {\n    font-family: sans-serif;\n    margin: 0;\n    padding: 20px;\n    background-color: #f4f7f6;\n    color: #333;\n    display: flex;\n    justify-content: center;\n    align-items: flex-start;\n    min-height: 100vh;\n    box-sizing: border-box;\n}\n\n.container {\n    background-color: #ffffff;\n    border-radius: 10px;\n    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);\n    max-width: 600px;\n    width: 100%;\n    padding: 25px;\n    text-align: center;\n}\n\nh1 {\n    color: #2c3e50;\n    margin-top: 0;\n    margin-bottom: 30px;\n}\n\nh2 {\n    color: #4CAF50; /* Green for options */\n    margin-top: 20px;\n    margin-bottom: 15px;\n}\n\n.list-manager {\n    border: 1px solid #e0e0e0;\n    border-radius: 8px;\n    padding: 15px;\n    margin-bottom: 25px;\n    background-color: #f9f9f9;\n}\n\n#optionList {\n    list-style: none;\n    padding: 0;\n    margin: 15px 0;\n    max-height: 200px;\n    overflow-y: auto;\n    border: 1px solid #eee;\n    border-radius: 5px;\n    background-color: #fff;\n}\n\n#optionList li {\n    padding: 10px 15px;\n    border-bottom: 1px solid #eee;\n    text-align: left;\n}\n\n#optionList li:last-child {\n    border-bottom: none;\n}\n\n.controls {\n    display: flex;\n    gap: 10px;\n    margin-top: 15px;\n    justify-content: center;\n    flex-wrap: wrap;\n}\n\n#newItemInput {\n    flex-grow: 1;\n    padding: 10px;\n    border: 1px solid #ccc;\n    border-radius: 5px;\n    font-size: 1em;\n    min-width: 150px;\n}\n\n.controls button {\n    padding: 10px 15px;\n    border: none;\n    border-radius: 5pt;\n    cursor: pointer;\n    font-size: 1em;\n    transition: background-color 0.2s;\n}\n\n#addItemBtn {\n    background-color: #007bff;\n    color: white;\n}\n#addItemBtn:hover {\n    background-color: #0056b3;\n}\n\n#removeLastItemBtn {\n    background-color: #dc3545;\n    color: white;\n}\n#removeLastItemBtn:hover {\n    background-color: #c82333;\n}\n\n.picker-area {\n    margin-top: 30px;\n}\n\n#pickRandomBtn {\n    background-color: #28aa45; /* Green */\n    color: white;\n    padding: 15px 30px;\n    border: none;\n    border-radius: 8px;\n    font-size: 1.2em;\n    cursor: pointer;\n    transition: background-color 0.2s, transform 0.1s;\n}\n\n#pickRandomBtn:hover {\n    background-color: #218838;\n    transform: translateY(-2px);\n}\n\n.picked-item {\n    font-size: 1.8em;\n    font-weight: bold;\n    color: #007bff; /* Blue */\n    margin-top: 20px;\n    min-height: 1.8em; /* Reserve space */\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    background-color: #e0f2f7;\n    padding: 15px;\n    border-radius: 8px;\n    border: 2px dashed #a7d9f7;\n}\n\np {\n    margin-top: 25px;\n    margin-bottom: 10px;\n    font-size: 1.1em;\n    color: #555;\n}",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "540ce590-8133-43b7-8732-4f9dbf013b1e": {
          "id": "540ce590-8133-43b7-8732-4f9dbf013b1e",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const optionListElement = document.getElementById('optionList');\n    const newItemInput = document.getElementById('newItemInput');\n    const addItemBtn = document.getElementById('addItemBtn');\n    const removeLastItemBtn = document.getElementById('removeLastItemBtn');\n    const pickRandomBtn = document.getElementById('pickRandomBtn');\n    const pickedItemDisplay = document.getElementById('pickedItemDisplay');\n\n    let options = [\"Apple\", \"Banana\", \"Cherry\"];\n\n    function renderOptions() {\n        optionListElement.innerHTML = '';\n        if (options.length === 0) {\n            optionListElement.innerHTML = '<li style=\"text-align: center; color: #888;\">No options yet!</li>';\n        } else {\n            options.forEach(option => {\n                const li = document.createElement('li');\n                li.textContent = option;\n                optionListElement.appendChild(li);\n            });\n        }\n    }\n\n    addItemBtn.addEventListener('click', () => {\n        const newItem = newItemInput.value.trim();\n        if (newItem) {\n            options.push(newItem);\n            newItemInput.value = '';\n            renderOptions();\n        }\n    });\n\n    // Allow adding with Enter key\n    newItemInput.addEventListener('keypress', (event) => {\n        if (event.key === 'Enter') {\n            addItemBtn.click();\n        }\n    });\n\n    removeLastItemBtn.addEventListener('click', () => {\n        if (options.length > 0) {\n            options.pop();\n            renderOptions();\n            pickedItemDisplay.textContent = ''; // Clear picked item if list changes\n        }\n    });\n\n    pickRandomBtn.addEventListener('click', () => {\n        if (options.length === 0) {\n            pickedItemDisplay.textContent = \"Add some options first!\";\n            pickedItemDisplay.style.color = '#dc3545'; // Red for error\n        } else {\n            const randomIndex = Math.floor(Math.random() * options.length);\n            pickedItemDisplay.textContent = options[randomIndex];\n            pickedItemDisplay.style.color = '#007bff'; // Blue for normal pick\n        }\n    });\n\n    // Initial render\n    renderOptions();\n});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
        "c0da03fd-3a9b-4e1a-88ac-ff9a77a3fff7",
        "24439cf4-3eb2-4fc9-bb7e-817d3c9fc6dc",
        "540ce590-8133-43b7-8732-4f9dbf013b1e"
      ]
    },
    "long_instructions": "TODOs:\r\n- locate the \"Add a new option\" input field\r\n- type a new item, like \"Grape\", into the input field and click \"Add Item\"\r\n- observe \"Grape\" being added to the \"Your Options\" list\r\n- click the \"Remove Last\" button to take the last item off the list\r\n- repeatedly click the \"Pick Random!\" button\r\n- notice how a different item from the \"Your Options\" list is chosen each time\r\n- try adding more items and picking again to see the random selection in action",
