    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Random Advice</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <header>\n    <h1>Random Advice Generator</h1>\n    <p>Click the button to load advice.</p>\n  </header>\n\n  <main>\n    <button id=\"btn\">Get Advice</button>\n    <p id=\"status\">Status: ready</p>\n\n    <section class=\"card\">\n      <h2>Advice</h2>\n      <p id=\"advice-text\">(advice will appear here)</p>\n    </section>\n  </main>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "const btn = document.querySelector(\"#btn\");\nconst statusEl = document.querySelector(\"#status\");\nconst adviceEl = document.querySelector(\"#advice-text\");\n\nbtn.addEventListener(\"click\", function () {\n  statusEl.textContent = \"Status: loading...\";\n\n  fetch(\"https://api.adviceslip.com/advice\")\n    .then(function (response) {\n      return response.json();\n    })\n    .then(function (data) {\n      adviceEl.textContent = data.slip.advice;\n      statusEl.textContent = \"Status: done\";\n    });\n});",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "/* Basic Reset */\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n  background-color: #f0f2f5;\n  color: #333;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  min-height: 100vh;\n  text-align: center;\n}\n\nheader {\n  margin-bottom: 2rem;\n}\n\nh1 {\n  color: #2c3e50;\n  margin-bottom: 0.5rem;\n}\n\n/* Button Styling */\n#btn {\n  background-color: #3498db;\n  color: white;\n  border: none;\n  padding: 12px 24px;\n  font-size: 1rem;\n  border-radius: 8px;\n  cursor: pointer;\n  transition: background-color 0.3s ease, transform 0.1s;\n}\n\n#btn:hover {\n  background-color: #2980b9;\n}\n\n#btn:active {\n  transform: scale(0.98);\n}\n\n/* Status Text */\n#status {\n  margin-top: 1rem;\n  font-size: 0.9rem;\n  color: #7f8c8d;\n  font-style: italic;\n}\n\n/* Advice Card */\n.card {\n  background: white;\n  margin-top: 2rem;\n  padding: 2rem;\n  border-radius: 12px;\n  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);\n  max-width: 400px;\n  width: 90%;\n}\n\n.card h2 {\n  font-size: 0.8rem;\n  text-transform: uppercase;\n  letter-spacing: 2px;\n  color: #95a5a6;\n  margin-bottom: 1rem;\n}\n\n#advice-text {\n  font-size: 1.25rem;\n  line-height: 1.6;\n  color: #2c3e50;\n  font-weight: 500;\n}",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "2"
      ]
    },
