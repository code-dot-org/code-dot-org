    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Castle Patrol — Debug the Guard</title>\n\n  <!-- Press Start 2P: classic pixel-art / retro game font -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap\" rel=\"stylesheet\">\n\n  <!-- All styling lives in style.css -->\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n  <!-- Outer wrapper centres the game on the page -->\n  <div id=\"game-container\">\n\n    <!-- Title bar above the canvas -->\n    <div id=\"title-bar\">&#9876; CASTLE PATROL</div>\n\n    <!-- Canvas wrapper holds the game canvas + result overlay -->\n    <div id=\"canvas-wrapper\">\n\n      <!-- The main 800×400 game canvas — all drawing happens here -->\n      <canvas id=\"game-canvas\" width=\"800\" height=\"400\"></canvas>\n\n      <!-- Result overlay — hidden until the while-loop finishes -->\n      <div id=\"result-overlay\" class=\"hidden\"></div>\n\n    </div><!-- end canvas-wrapper -->\n\n  </div><!-- end game-container -->\n\n  <!--\n    helpers.js is loaded here. It sets up the game engine and, on\n    window load, fetches script.js and evals it to run the student's code.\n    script.js is intentionally NOT linked as a <script> tag.\n  -->\n  <script src=\"helpers.js\"></script>\n\n</body>\n</html>\n",
          "active": false,
          "folderId": "0",
          "type": "support"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "*, *::before, *::after {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  background-color: #0a0c10;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  min-height: 100vh;\n  font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  color: #e0e0e0;\n  padding: 16px;\n}\n\n#game-container {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0;\n  width: 100%;\n  max-width: 800px;\n}\n\n#title-bar {\n  background: linear-gradient(180deg, #1a1a2e 0%, #0f0f1e 100%);\n  border: 2px solid #3a3a5a;\n  border-bottom: none;\n  width: 100%;\n  padding: 12px 16px;\n  font-family: 'Press Start 2P', monospace;\n  font-size: clamp(10px, 2.4vw, 14px);\n  line-height: 1.5;\n  letter-spacing: 2px;\n  color: #ffa500;\n  text-shadow: 0 0 10px rgba(255, 165, 0, 0.6);\n  text-align: center;\n  user-select: none;\n}\n\n#canvas-wrapper {\n  position: relative;\n  width: 100%;\n  aspect-ratio: 2 / 1;\n  box-shadow: 0 0 30px rgba(80, 120, 180, 0.4);\n  border: 2px solid #3a3a5a;\n}\n\n#game-canvas {\n  display: block;\n  width: 100%;\n  height: 100%;\n  image-rendering: pixelated;\n  image-rendering: crisp-edges;\n}\n\n#result-overlay {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  gap: 16px;\n  text-align: center;\n  padding: 24px;\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity 0.4s ease;\n}\n\n#result-overlay.visible {\n  opacity: 1;\n  pointer-events: all;\n}\n\n#result-overlay.hidden {\n  display: none;\n}\n\n#result-overlay.bug-present {\n  background: rgba(60, 0, 0, 0.88);\n}\n\n#result-overlay.bug-present .result-title {\n  color: #ff4444;\n  font-family: 'Press Start 2P', monospace;\n  font-size: clamp(12px, 3vw, 18px);\n  line-height: 1.6;\n  letter-spacing: 1px;\n  text-shadow: 0 0 12px rgba(255, 50, 50, 0.8);\n  animation: flash-red 1s step-end infinite;\n}\n\n#result-overlay.bug-present .result-sub {\n  color: #ffcccc;\n  font-size: clamp(14px, 3vw, 18px);\n  line-height: 1.5;\n  max-width: 560px;\n}\n\n#result-overlay.bug-fixed {\n  background: rgba(0, 30, 10, 0.88);\n}\n\n#result-overlay.bug-fixed .result-title {\n  color: #44ff88;\n  font-family: 'Press Start 2P', monospace;\n  font-size: clamp(12px, 3vw, 20px);\n  line-height: 1.6;\n  letter-spacing: 1px;\n  text-shadow: 0 0 12px rgba(50, 255, 100, 0.8);\n}\n\n#result-overlay.bug-fixed .result-sub {\n  color: #ccffdd;\n  font-size: clamp(14px, 3vw, 18px);\n  line-height: 1.5;\n}\n\n.play-again-btn {\n  margin-top: 10px;\n  padding: 12px 24px;\n  min-height: 44px;\n  font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  font-size: clamp(14px, 3vw, 17px);\n  font-weight: 700;\n  background: #1a1a2e;\n  color: #ffa500;\n  border: 2px solid #ffa500;\n  border-radius: 6px;\n  cursor: pointer;\n  letter-spacing: 0.5px;\n  transition: background 0.15s, color 0.15s, box-shadow 0.15s, transform 0.15s;\n}\n\n.play-again-btn:hover {\n  background: #ffa500;\n  color: #080810;\n  box-shadow: 0 0 16px rgba(255, 165, 0, 0.6);\n  transform: scale(1.05);\n}\n\n.play-again-btn:focus-visible {\n  outline: 3px solid #ffffff;\n  outline-offset: 4px;\n}\n\n@keyframes flash-red {\n  0%, 49% {\n    opacity: 1;\n  }\n\n  50%, 100% {\n    opacity: 0.4;\n  }\n}\n\n@media (max-width: 500px) {\n  body {\n    padding: 8px;\n    align-items: flex-start;\n  }\n\n  #title-bar {\n    font-size: 10px;\n    letter-spacing: 1px;\n    padding: 10px 8px;\n  }\n\n  #result-overlay {\n    gap: 10px;\n    padding: 16px;\n  }\n\n  #result-overlay.bug-present .result-title,\n  #result-overlay.bug-fixed .result-title {\n    font-size: 12px;\n    letter-spacing: 1px;\n  }\n\n  #result-overlay.bug-present .result-sub,\n  #result-overlay.bug-fixed .result-sub,\n  .play-again-btn {\n    font-size: 14px;\n  }\n\n  .play-again-btn {\n    padding: 10px 18px;\n  }\n}",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
        "3": {
          "id": "3",
          "name": "helpers.js",
          "contents": "/*\n  helpers.js — Castle Patrol Game Engine (Top-Down View, Redesigned)\n  ===================================================================\n  Students do NOT edit this file.\n\n  This file handles everything except the patrol logic:\n    - Canvas setup and scene drawing (top-down castle map with grey-blue tiles)\n    - Pixel-art sprite definitions (guard purple-grey, player brownish-red)\n    - Patrol mechanics and safety cap\n    - Event queue and animated playback\n    - Bootstrap: fetches script.js, evals it, reruns on Play Again\n\n  Sections:\n    1. Constants & canvas setup\n    2. Pre-baked tile colour grid (TILE_COLORS)\n    3. Pixel-art sprite data\n    4. Drawing helpers (sprites, background, walls, HUD)\n    5. Game state & event queue\n    6. Patrol engine (patrolStep, detectPlayer, alertMode)\n    7. Animation playback (animateEvents, drawScene)\n    8. Result overlay\n    9. Bootstrap (fetch + eval script.js)\n*/\n\n\n/* ============================================================\n   1. CONSTANTS & CANVAS SETUP\n   ============================================================ */\n\nconst SCALE           = 3;    // Each logical pixel in a sprite = 3×3 canvas pixels\nconst PATROL_WIDTH    = 14;   // Steps to cross the full patrol path (left to right)\nconst PLAYER_PATH_POS = 7;    // Player stands at path step 7 (horizontal center-ish)\n\n// Guard patrols horizontally near the TOP of the canvas\nconst LEFT_BOUND  = 60;    // Left pixel bound of the patrol path\nconst PATROL_PX   = 680;   // Total pixel width of the patrol path\n\n// Guard patrols at Y=100; player stands at Y=250\nconst PATROL_Y_GUARD  = 100;   // Guard's fixed Y on canvas (open corridor above walls)\nconst PATROL_Y_PLAYER = 250;   // Player's fixed Y on canvas (open corridor below walls)\n\n// Canvas dimensions (match the HTML canvas attributes)\nconst CANVAS_W = 800;\nconst CANVAS_H = 400;\n\n// HUD bar occupies the bottom strip of the canvas\nconst HUD_Y      = 360;          // Y where the HUD bar starts\nconst HUD_HEIGHT = CANVAS_H - HUD_Y;   // 40px tall\n\n// Floor tile dimensions (large grey-blue tiles separated by dark grid lines)\nconst TILE_SIZE    = 48;   // Each floor tile is 48×48 canvas pixels\nconst GRID_LINE_W  = 2;    // 2px dark grid line between tiles\n\nconst canvas = document.getElementById('game-canvas');\nconst ctx    = canvas.getContext('2d');\n\n\n/* ============================================================\n   2. PRE-BAKED TILE COLOUR GRID\n   ============================================================\n   We generate random tile colours ONCE at load time and store\n   them in TILE_COLORS[row][col].  This prevents tiles from\n   flickering between frames because Math.random() is never\n   called inside drawBackground().\n   ============================================================ */\n\n// How many tile columns and rows we need to cover 800×360px\nconst TILE_COLS = Math.ceil(CANVAS_W / TILE_SIZE) + 1;\nconst TILE_ROWS = Math.ceil(HUD_Y    / TILE_SIZE) + 1;\n\n// TILE_COLORS[row][col] — an rgb() string for each tile position\nconst TILE_COLORS = [];\n\nfor (let tr = 0; tr < TILE_ROWS; tr++) {\n    TILE_COLORS.push([]);\n    for (let tc = 0; tc < TILE_COLS; tc++) {\n        // Base grey-blue: around #8fa8bc with ±8 random variation on each channel\n        const rBase = 0x8f;\n        const gBase = 0xa8;\n        const bBase = 0xbc;\n        const offset = (Math.random() * 16 | 0) - 8;   // -8 to +7\n        const r = Math.min(255, Math.max(0, rBase + offset));\n        const g = Math.min(255, Math.max(0, gBase + offset));\n        const b = Math.min(255, Math.max(0, bBase + offset));\n        TILE_COLORS[tr].push('rgb(' + r + ',' + g + ',' + b + ')');\n    }\n}\n\n\n/* ============================================================\n   3. PIXEL-ART SPRITE DATA\n   ============================================================\n   Each sprite is a 2D array of colour strings.\n   '.' means transparent — that pixel is skipped.\n   SCALE is applied when drawing so each logical pixel\n   becomes a SCALE×SCALE block on the canvas.\n\n   All sprites are drawn from a top-down / bird's-eye view.\n   ============================================================ */\n\n// --- Guard — top-down overhead view (10×10 logical pixels) ---\n//\n// Purple-grey enemy viewed from directly above:\n//   - Outer ring:   #554466 (dark purple)\n//   - Inner body:   #7755aa (medium purple)\n//   - Center dot:   #9966cc (brighter purple — the head)\n//   - Facing arrow: #ffee44 (bright yellow) — added dynamically in drawGuardTopDown()\n//\n// This base sprite does NOT include the yellow facing indicator.\n// drawGuardTopDown() draws the indicator separately on the correct edge.\n\nconst GUARD_SPRITE_BASE = [\n    // row 0 — top outer ring\n    ['.', '.', '#554466', '#554466', '#554466', '#554466', '#554466', '#554466', '.', '.'],\n    // row 1 — outer ring sides, body begins\n    ['.', '#554466', '#7755aa', '#7755aa', '#7755aa', '#7755aa', '#7755aa', '#554466', '.', '.'],\n    // row 2 — center area, head dot top\n    ['#554466', '#7755aa', '#7755aa', '#9966cc', '#9966cc', '#7755aa', '#7755aa', '#554466', '.', '.'],\n    // row 3 — head dot center\n    ['#554466', '#7755aa', '#9966cc', '#9966cc', '#9966cc', '#9966cc', '#7755aa', '#554466', '.', '.'],\n    // row 4 — head dot lower\n    ['#554466', '#7755aa', '#7755aa', '#9966cc', '#9966cc', '#7755aa', '#7755aa', '#554466', '.', '.'],\n    // row 5 — body lower half\n    ['#554466', '#7755aa', '#7755aa', '#7755aa', '#7755aa', '#7755aa', '#7755aa', '#554466', '.', '.'],\n    // row 6 — bottom outer ring\n    ['.', '#554466', '#554466', '#554466', '#554466', '#554466', '#554466', '#554466', '.', '.'],\n    // row 7 — bottom shadow hint\n    ['.', '.', '#3a2255', '#3a2255', '#3a2255', '#3a2255', '.', '.', '.', '.'],\n    // row 8 — blank padding\n    ['.', '.', '.', '.', '.', '.', '.', '.', '.', '.'],\n    // row 9 — blank padding\n    ['.', '.', '.', '.', '.', '.', '.', '.', '.', '.'],\n];\n\n// Sprite width and height in logical pixels (before SCALE is applied)\nconst GUARD_SPRITE_W = 8;   // Columns 0–7 contain actual pixels\nconst GUARD_SPRITE_H = 8;   // Rows 0–7 contain actual pixels\n\n// --- Player — brownish-red hooded figure, top-down (~8×10 logical pixels) ---\n//\n// Brownish-red hooded cloak viewed from above:\n//   - Outer hood rim: #8b3a1a (dark brownish-red)\n//   - Cloak body:     #c45a2a (warm brown-orange)\n//   - Face/center:    #e8c098 (pale skin tone)\n//   - Cloak shadow:   #6b2a10 (very dark brown at the edges)\n\nconst PLAYER_SPRITE = [\n    // row 0 — hood outer rim top\n    ['.', '.', '#8b3a1a', '#8b3a1a', '#8b3a1a', '#8b3a1a', '.', '.', '.', '.'],\n    // row 1 — hood sides begin\n    ['.', '#8b3a1a', '#c45a2a', '#c45a2a', '#c45a2a', '#c45a2a', '#8b3a1a', '.', '.', '.'],\n    // row 2 — face dot top\n    ['#8b3a1a', '#c45a2a', '#c45a2a', '#e8c098', '#e8c098', '#c45a2a', '#c45a2a', '#8b3a1a', '.', '.'],\n    // row 3 — face dot center (2×2 face visible from above)\n    ['#8b3a1a', '#c45a2a', '#c45a2a', '#e8c098', '#e8c098', '#c45a2a', '#c45a2a', '#8b3a1a', '.', '.'],\n    // row 4 — cloak lower body\n    ['#8b3a1a', '#c45a2a', '#c45a2a', '#c45a2a', '#c45a2a', '#c45a2a', '#c45a2a', '#8b3a1a', '.', '.'],\n    // row 5 — cloak fold highlight\n    ['.', '#8b3a1a', '#c45a2a', '#c45a2a', '#c45a2a', '#c45a2a', '#8b3a1a', '.', '.', '.'],\n    // row 6 — hood outer rim bottom\n    ['.', '.', '#8b3a1a', '#8b3a1a', '#8b3a1a', '#8b3a1a', '.', '.', '.', '.'],\n    // row 7 — cloak shadow tail\n    ['.', '.', '.', '#6b2a10', '#6b2a10', '.', '.', '.', '.', '.'],\n    // row 8 — blank padding\n    ['.', '.', '.', '.', '.', '.', '.', '.', '.', '.'],\n    // row 9 — blank padding\n    ['.', '.', '.', '.', '.', '.', '.', '.', '.', '.'],\n];\n\n// --- Alert Exclamation Mark (~5×9 logical pixels) ---\n// Red body with yellow outline. Appears above the guard on detection.\n\nconst ALERT_SPRITE = [\n    // row 0 — top of stem\n    ['.', '#ffee00', '#ffee00', '#ffee00', '.'],\n    // row 1\n    ['#ffee00', '#ff2222', '#ff2222', '#ffee00', '.'],\n    // row 2\n    ['#ffee00', '#ff2222', '#ff2222', '#ffee00', '.'],\n    // row 3\n    ['#ffee00', '#ff2222', '#ff2222', '#ffee00', '.'],\n    // row 4 — narrowing towards gap\n    ['.', '#ffee00', '#ff4444', '#ffee00', '.'],\n    // row 5 — gap between stem and dot\n    ['.', '#ffee00', '#ffee00', '.', '.'],\n    // row 6 — gap continues\n    ['.', '.', '.', '.', '.'],\n    // row 7 — dot top\n    ['.', '#ffee00', '#ffee00', '#ffee00', '.'],\n    // row 8 — dot\n    ['#ffee00', '#ff2222', '#ff2222', '#ffee00', '.'],\n];\n\n\n/* ============================================================\n   4. DRAWING HELPERS\n   ============================================================ */\n\n// drawSprite — renders a 2D colour array at (x, y) on the canvas.\n// Transparent pixels (value '.' or falsy) are skipped.\n// scale defaults to the global SCALE constant.\nfunction drawSprite(sprite, x, y, scale) {\n    const s    = scale || SCALE;\n    const rows = sprite.length;\n    const cols = sprite[0].length;\n    for (let row = 0; row < rows; row++) {\n        for (let col = 0; col < cols; col++) {\n            const colour = sprite[row][col];\n            if (!colour || colour === '.') continue;\n            ctx.fillStyle = colour;\n            ctx.fillRect(\n                Math.round(x + col * s),\n                Math.round(y + row * s),\n                s, s\n            );\n        }\n    }\n}\n\n// guardCanvasX — converts a path position (0–14) to a canvas X coordinate.\n// The patrol path spans from LEFT_BOUND to LEFT_BOUND + PATROL_PX.\nfunction guardCanvasX(pathPos) {\n    return LEFT_BOUND + (pathPos / PATROL_WIDTH) * PATROL_PX;\n}\n\n// playerCanvasX — fixed horizontal position for the player sprite.\n// Player stands at path step PLAYER_PATH_POS (center of the patrol range).\nconst PLAYER_CANVAS_X = guardCanvasX(PLAYER_PATH_POS);\n\n// drawGuardTopDown — draws the purple-grey guard sprite with a yellow\n// directional facing indicator on the correct edge.\n//\n// x, y         — top-left corner of the sprite in canvas pixels\n// facingRight  — true = guard faces right, false = faces left\nfunction drawGuardTopDown(x, y, facingRight) {\n    const s = SCALE;\n\n    // Draw all rows of the base sprite (no indicator — we add that below)\n    for (let row = 0; row < 8; row++) {\n        for (let col = 0; col < 10; col++) {\n            const colour = GUARD_SPRITE_BASE[row][col];\n            if (!colour || colour === '.') continue;\n            ctx.fillStyle = colour;\n            ctx.fillRect(\n                Math.round(x + col * s),\n                Math.round(y + row * s),\n                s, s\n            );\n        }\n    }\n\n    // Draw the directional facing indicator — a 2-pixel yellow bar on the\n    // leading edge of the sprite so the player knows which way the guard looks.\n    // Indicator sits at the vertical center of the sprite (rows 2–4).\n    const indicatorColor = '#ffee44';\n    ctx.fillStyle = indicatorColor;\n\n    if (facingRight) {\n        // Facing RIGHT: yellow bar extends from the right side of the body\n        ctx.fillRect(Math.round(x + 8 * s), Math.round(y + 2 * s), s, s);  // top\n        ctx.fillRect(Math.round(x + 9 * s), Math.round(y + 3 * s), s, s);  // tip point\n        ctx.fillRect(Math.round(x + 8 * s), Math.round(y + 4 * s), s, s);  // bottom\n    } else {\n        // Facing LEFT: yellow bar extends from the left side of the body\n        ctx.fillRect(Math.round(x - 1 * s), Math.round(y + 2 * s), s, s);  // top\n        ctx.fillRect(Math.round(x - 2 * s), Math.round(y + 3 * s), s, s);  // tip point\n        ctx.fillRect(Math.round(x - 1 * s), Math.round(y + 4 * s), s, s);  // bottom\n    }\n}\n\n// drawWallBlock — draws a solid dark brick wall block at (x, y) with the\n// given width and height.  Brick detail lines are drawn every 48px\n// horizontally and 24px vertically to suggest mortar joints.\n//\n// x, y   — top-left corner of the block\n// w, h   — width and height in canvas pixels\nfunction drawWallBlock(x, y, w, h) {\n    // Solid dark base fill — brownish-black brick colour\n    ctx.fillStyle = '#2a2528';\n    ctx.fillRect(x, y, w, h);\n\n    // Subtle top highlight — makes the block look slightly raised\n    ctx.fillStyle = '#352e32';\n    ctx.fillRect(x, y, w, 2);\n\n    // Left edge highlight\n    ctx.fillStyle = '#302a2e';\n    ctx.fillRect(x, y, 2, h);\n\n    // Bottom shadow — makes the block look grounded\n    ctx.fillStyle = '#1a1820';\n    ctx.fillRect(x, y + h - 2, w, 2);\n\n    // --- Brick / mortar joint lines ---\n    // Dark mortar-coloured lines create the brick grid texture.\n    ctx.fillStyle = '#1e1c20';\n\n    // Horizontal mortar lines every 24px inside the block\n    for (let ly = y + 24; ly < y + h; ly += 24) {\n        ctx.fillRect(x + 2, ly, w - 4, 1);\n    }\n\n    // Vertical mortar lines every 48px inside the block\n    for (let lx = x + 48; lx < x + w; lx += 48) {\n        ctx.fillRect(lx, y + 2, 1, h - 4);\n    }\n}\n\n// drawBackground — draws the complete top-down castle map each frame.\n//\n// Layout (800×400):\n//   Y 0–140   : open corridor where the guard patrols\n//   Y 140–248 : T-shaped wall obstacle (horizontal bar + downward arm)\n//   Y 200–248 : left L-wall (vertical + horizontal parts overlap the T-wall area)\n//   Y 248–360 : open corridor where the player stands\n//   Y 360–400 : HUD bar\n//\n// No vignette — the map is evenly lit for a clean look.\nfunction drawBackground() {\n\n    // --- Grey-blue floor tiles ---\n    // Fill the entire game area (above the HUD) with 48px tiles.\n    // A 2px dark grid line separates each tile.\n\n    // First fill the entire area with the grid-line colour\n    ctx.fillStyle = '#5a7088';\n    ctx.fillRect(0, 0, CANVAS_W, HUD_Y);\n\n    // Draw each tile on top of the grid-line background\n    for (let tr = 0; tr < TILE_ROWS; tr++) {\n        for (let tc = 0; tc < TILE_COLS; tc++) {\n            const tx = tc * TILE_SIZE + (tc > 0 ? GRID_LINE_W * tc : 0);\n            const ty = tr * TILE_SIZE + (tr > 0 ? GRID_LINE_W * tr : 0);\n            // Clip tiles that would overlap the HUD bar\n            if (ty >= HUD_Y) continue;\n            ctx.fillStyle = TILE_COLORS[tr][tc];\n            ctx.fillRect(tx, ty, TILE_SIZE, TILE_SIZE);\n        }\n    }\n\n    // --- HUD bar at the bottom ---\n    // Solid black strip from Y=360 to Y=400.\n    // Text is drawn by drawHUD() separately.\n    ctx.fillStyle = '#000000';\n    ctx.fillRect(0, HUD_Y, CANVAS_W, HUD_HEIGHT);\n\n    // --- Wall obstacles ---\n    // Two chunky dark brick obstacle shapes in the middle of the map.\n\n    // 1. Upper T-wall\n    //    Horizontal bar: x=120, y=140, width=560, height=48\n    //    Vertical arm:   x=340, y=188, width=96, height=48\n    drawWallBlock(120, 140, 560, 48);\n    drawWallBlock(340, 188, 96,  48);\n\n    // 2. Left L-wall\n    //    Vertical part:   x=60, y=200, width=48, height=96\n    //    Horizontal part: x=60, y=296, width=144, height=48\n    drawWallBlock(60,  200, 48,  96);\n    drawWallBlock(60,  296, 144, 48);\n}\n\n// drawSightBeam — top-down vertical sight beam always shining downward from the\n// guard. The beam intensifies when it overlaps the player (inSight = true),\n// making it visually clear the guard CAN see the player but isn't reacting —\n// which is exactly the bug students need to fix.\n//\n// guardCenterX — horizontal center of the guard sprite in canvas pixels\n// inSight      — true when the beam is currently sweeping over the player\nfunction drawSightBeam(guardCenterX, inSight) {\n    const tipY  = PATROL_Y_GUARD;   // Guard center Y\n    const farY  = PATROL_Y_PLAYER;  // Player center Y\n    const halfW = 36;               // Half-width of the beam at the player end\n\n    // Beam is brighter and more saturated when hitting the player\n    const fillAlpha   = inSight ? 0.45 : 0.18;\n    const strokeAlpha = inSight ? 0.80 : 0.35;\n    const glowAlpha   = inSight ? 0.50 : 0.22;\n    const glowRadius  = inSight ? 18   : 12;\n\n    ctx.save();\n\n    // Filled triangle fanning downward from the guard toward the player\n    ctx.fillStyle = `rgba(255, 220, 50, ${fillAlpha})`;\n    ctx.beginPath();\n    ctx.moveTo(guardCenterX, tipY);\n    ctx.lineTo(guardCenterX - halfW, farY);\n    ctx.lineTo(guardCenterX + halfW, farY);\n    ctx.closePath();\n    ctx.fill();\n\n    // Outline of the same triangle\n    ctx.strokeStyle = `rgba(255, 220, 50, ${strokeAlpha})`;\n    ctx.lineWidth = 1.5;\n    ctx.beginPath();\n    ctx.moveTo(guardCenterX, tipY);\n    ctx.lineTo(guardCenterX - halfW, farY);\n    ctx.lineTo(guardCenterX + halfW, farY);\n    ctx.closePath();\n    ctx.stroke();\n\n    // Glow circle at the guard's position — the \"eye\" of the beam\n    ctx.fillStyle = `rgba(255, 220, 50, ${glowAlpha})`;\n    ctx.beginPath();\n    ctx.arc(guardCenterX, tipY, glowRadius, 0, Math.PI * 2);\n    ctx.fill();\n\n    ctx.restore();\n}\n\n// drawHUD — draws the status bar at the bottom of the canvas (Y=360–400).\n// The HUD is already cleared to black by drawBackground().\n//\n// status   — 'patrol' (green text) or 'alert' (red text)\n// stepNum  — current step number shown on the right side\nfunction drawHUD(status, stepNum) {\n    ctx.font = '18px monospace';\n    ctx.textBaseline = 'middle';\n    const midY = HUD_Y + HUD_HEIGHT / 2;   // Vertical center of the HUD bar\n\n    if (status === 'patrol') {\n        // Green status text when the guard is still patrolling normally\n        ctx.fillStyle = '#44ff88';\n        ctx.fillText('STATUS: PATROLLING', 14, midY);\n    } else {\n        // Red status text when the guard is in alert mode\n        ctx.fillStyle = '#ff4444';\n        ctx.fillText('STATUS: !! ALERT !!', 14, midY);\n    }\n\n    // Step counter — right-aligned in the HUD bar\n    ctx.fillStyle = '#aaaacc';\n    ctx.textAlign = 'right';\n    ctx.fillText('STEP: ' + stepNum, CANVAS_W - 14, midY);\n    ctx.textAlign = 'left';   // Always reset to left so later draws are not affected\n}\n\n\n/* ============================================================\n   5. GAME STATE & EVENT QUEUE\n   ============================================================ */\n\n// gameEvents holds all events produced by the while-loop in script.js.\n// After the loop finishes, animateEvents() replays them one by one.\nlet gameEvents      = [];\nlet iterationCount  = 0;\nlet safetyCapHit    = false;\n\n// studentCodeSource holds the raw text of script.js so Play Again can re-eval it\nlet studentCodeSource = '';\n\n\n/* ============================================================\n   6. PATROL ENGINE\n   ============================================================\n   These functions are called FROM script.js (the student's code).\n   patrolStep and detectPlayer read window.step so that the\n   student's variable (hoisted to window scope after stripping\n   let/const) is always accessible here.\n   ============================================================ */\n\n// computeGuardPathPos — calculates where the guard is on the 0–14 path\n// for a given step number.  The guard oscillates: 0→14→0→14→...\nfunction computeGuardPathPos(stepNum) {\n    const phase = stepNum % (PATROL_WIDTH * 2);\n    return phase < PATROL_WIDTH ? phase : (PATROL_WIDTH * 2) - phase;\n}\n\n// patrolStep — advances the guard one step and records a 'patrol' event.\n// Called by the student's while-loop on each iteration.\nfunction patrolStep(stepArg) {\n    iterationCount++;\n\n    // --- Safety cap ---\n    // If the loop runs more than 200 times the bug was not fixed.\n    // Setting window.playerDetected = true causes !playerDetected to become\n    // false, which lets the while-loop exit naturally on its next check.\n    if (iterationCount > 200) {\n        safetyCapHit = true;\n        window.playerDetected = true;\n        return;\n    }\n\n    const guardPathPos = computeGuardPathPos(stepArg);\n    const inSight      = Math.abs(guardPathPos - PLAYER_PATH_POS) <= 1;\n\n    // console.log here helps students debug by checking the patrol in DevTools\n    // console.log('[patrolStep] step=' + stepArg + ' guardPos=' + guardPathPos + ' inSight=' + inSight);\n\n    // Push a patrol event — animateEvents() replays these after the loop ends\n    gameEvents.push({\n        type:         'patrol',\n        step:         stepArg,\n        guardPathPos: guardPathPos,\n        inSight:      inSight\n    });\n}\n\n// detectPlayer — returns true if the guard can currently see the player.\n// The guard's X position must be within 1 path step of the player's X.\n// Students add a call to this function inside their while-loop to fix the bug.\nfunction detectPlayer() {\n    const currentStep  = window.step || 0;\n    const guardPathPos = computeGuardPathPos(currentStep);\n    return Math.abs(guardPathPos - PLAYER_PATH_POS) <= 1;\n}\n\n// alertMode — called at the end of the student's script (after the while-loop).\n// Records the final result event and kicks off animated playback.\nfunction alertMode(finalStep) {\n    gameEvents.push({\n        type:           'result',\n        step:           finalStep,\n        safetyCapHit:   safetyCapHit,\n        playerDetected: window.playerDetected\n    });\n\n    // Start replaying the queued events on the canvas\n    animateEvents();\n}\n\n\n/* ============================================================\n   7. ANIMATION PLAYBACK\n   ============================================================\n   animateEvents processes gameEvents one at a time via setInterval.\n   Each event produces one rendered frame on the canvas.\n   ============================================================ */\n\n// startCanvasLoop — draws a static idle scene before the game events begin.\n// Shows the background, player, and guard at their step-0 starting position.\nfunction startCanvasLoop() {\n    // Guard at path position 0 (far left), facing right\n    const guardPathPos = 0;\n    const facingRight  = true;\n    drawScene(guardPathPos, facingRight, false, false, 'patrol', 0);\n}\n\n// animateEvents — replays all queued patrol events at ~120ms per frame.\n// After all patrol events are processed, the result overlay appears.\nfunction animateEvents() {\n    let eventIndex  = 0;\n    let lastGuardPx = guardCanvasX(0);   // Track last X so we can detect direction\n    let lastFacing  = true;              // true = right, false = left\n\n    // Draw the initial idle scene immediately\n    startCanvasLoop();\n\n    const interval = setInterval(function () {\n        // Nothing left to process — stop the timer\n        if (eventIndex >= gameEvents.length) {\n            clearInterval(interval);\n            return;\n        }\n\n        const event = gameEvents[eventIndex];\n        eventIndex++;\n\n        if (event.type === 'patrol') {\n            const gx = guardCanvasX(event.guardPathPos);\n\n            // Determine facing direction from horizontal movement\n            // If X increased (or stayed the same) the guard faces right\n            const facingRight = gx >= lastGuardPx;\n            lastFacing = facingRight;\n\n            // Show the alert \"!\" only when the bug is fixed AND in sight\n            const showAlert = event.inSight && window.playerDetected && !safetyCapHit;\n\n            drawScene(\n                event.guardPathPos,\n                facingRight,\n                event.inSight,\n                showAlert,\n                'patrol',\n                event.step\n            );\n\n            lastGuardPx = gx;\n\n        } else if (event.type === 'result') {\n            // Final frame — guard at rest, then show the result overlay\n            drawScene(\n                computeGuardPathPos(event.step),\n                lastFacing,\n                false,\n                event.playerDetected && !safetyCapHit,\n                'alert',\n                event.step\n            );\n            setTimeout(function () {\n                showResultOverlay(event);\n            }, 400);\n        }\n\n    }, 120);   // ~120ms per event = roughly 8 frames per second\n}\n\n// drawScene — renders one complete top-down frame of the game.\n//\n// Parameters:\n//   guardPathPos — guard's current 0–14 path position (NOT canvas X)\n//   facingRight  — true (facing right) or false (facing left)\n//   inSight      — whether the vertical sight beam should appear\n//   showAlert    — whether the \"!\" sprite appears above the guard\n//   hudStatus    — 'patrol' or 'alert' for the HUD text colour\n//   stepNum      — step number shown in the HUD\nfunction drawScene(guardPathPos, facingRight, inSight, showAlert, hudStatus, stepNum) {\n    // Convert path position to canvas X for guard placement\n    const guardX = guardCanvasX(guardPathPos);\n\n    // Sprite pixel dimensions (SCALE applied)\n    const spriteW = GUARD_SPRITE_W * SCALE;   // 24px\n    const spriteH = GUARD_SPRITE_H * SCALE;   // 24px\n\n    // Top-left corner of each sprite, centered on their Y positions\n    const guardDrawX  = guardX - spriteW / 2;\n    const guardDrawY  = PATROL_Y_GUARD  - spriteH / 2;\n    const playerDrawX = PLAYER_CANVAS_X - spriteW / 2;\n    const playerDrawY = PATROL_Y_PLAYER - spriteH / 2;\n\n    // Center points (used for sight beam and alert icon positioning)\n    const guardCenterX = guardDrawX + spriteW / 2;\n    const guardCenterY = guardDrawY + spriteH / 2;\n\n    // 1. Draw the background — floor tiles, walls, HUD black bar\n    drawBackground();\n\n    // 2. Sight beam — always drawn so the guard appears to constantly scan.\n    //    Passes inSight so the beam brightens when sweeping over the player,\n    //    making it obvious the guard can see the player but isn't reacting.\n    drawSightBeam(guardCenterX, inSight);\n\n    // 3. Player sprite — fixed center position, brownish-red cloak from above\n    drawSprite(PLAYER_SPRITE, playerDrawX, playerDrawY, SCALE);\n\n    // 4. Guard sprite — top-down view with yellow directional facing indicator\n    drawGuardTopDown(guardDrawX, guardDrawY, facingRight);\n\n    // 5. Alert \"!\" — floats above the guard sprite when detection occurs\n    if (showAlert) {\n        const alertW = ALERT_SPRITE[0].length * SCALE;\n        const alertH = ALERT_SPRITE.length    * SCALE;\n        drawSprite(\n            ALERT_SPRITE,\n            guardCenterX - alertW / 2,   // Centered above the guard\n            guardDrawY   - alertH - 6,   // Just above the guard sprite\n            SCALE\n        );\n    }\n\n    // 6. HUD text — drawn last so it always sits on top of everything\n    drawHUD(hudStatus, stepNum);\n}\n\n\n/* ============================================================\n   8. RESULT OVERLAY\n   ============================================================ */\n\n// showResultOverlay — fills and reveals the #result-overlay div based on\n// whether the safety cap was hit (bug present) or the loop exited cleanly\n// (bug fixed).\nfunction showResultOverlay(event) {\n    const overlay = document.getElementById('result-overlay');\n\n    // Remove any leftover classes from a previous run\n    overlay.classList.remove('hidden', 'bug-present', 'bug-fixed', 'visible');\n    overlay.innerHTML = '';\n\n    if (event.safetyCapHit) {\n        // --- Bug was NOT fixed — guard never detected the player ---\n        overlay.classList.add('bug-present');\n\n        const title = document.createElement('div');\n        title.className = 'result-title';\n        title.textContent = 'GUARD NEVER ALERTED';\n\n        const sub = document.createElement('div');\n        sub.className = 'result-sub';\n        sub.textContent = 'The patrol ran for 200 steps.';\n\n        const btn = document.createElement('button');\n        btn.className = 'play-again-btn';\n        btn.textContent = 'PLAY AGAIN';\n        btn.addEventListener('click', rerunGame);\n\n        overlay.appendChild(title);\n        overlay.appendChild(sub);\n        overlay.appendChild(btn);\n\n    } else {\n        // --- Bug was fixed — guard spotted the player ---\n        overlay.classList.add('bug-fixed');\n\n        const title = document.createElement('div');\n        title.className = 'result-title';\n        title.textContent = 'PLAYER DETECTED!';\n\n        const sub = document.createElement('div');\n        sub.className = 'result-sub';\n        sub.textContent = 'Guard spotted you on step ' + event.step + '.';\n\n        const btn = document.createElement('button');\n        btn.className = 'play-again-btn';\n        btn.textContent = 'PLAY AGAIN';\n        btn.addEventListener('click', rerunGame);\n\n        overlay.appendChild(title);\n        overlay.appendChild(sub);\n        overlay.appendChild(btn);\n    }\n\n    // CSS transition handles the fade-in when .visible is added\n    overlay.classList.add('visible');\n}\n\n\n/* ============================================================\n   9. BOOTSTRAP — fetch script.js, eval, support Play Again\n   ============================================================ */\n\n// resetGameState — clears all mutable state so a fresh run starts clean.\n// Called both on first load and on every Play Again click.\nfunction resetGameState() {\n    gameEvents      = [];\n    iterationCount  = 0;\n    safetyCapHit    = false;\n\n    // Clear the globals used by script.js\n    // (eval will re-declare them, but clearing here is defensive)\n    window.playerDetected = false;\n    window.step           = 0;\n}\n\n// runStudentCode — strips let/const from the student source so variables\n// land on the global (window) scope where helpers can read them,\n// then evals the code in the global context.\nfunction runStudentCode(source) {\n    resetGameState();\n\n    // Replace 'let ' and 'const ' with plain assignments so the vars are global.\n    // This is safe here because script.js is a controlled teaching file.\n    const globalised = source\n        .replace(/\\blet\\s+/g,   '')\n        .replace(/\\bconst\\s+/g, '');\n\n    // Students can open DevTools and check the Console to see this message\n    console.log('[Castle Patrol] Running student code...');\n\n    // (0, eval) invokes eval in the global scope rather than function scope\n    try {\n        (0, eval)(globalised);\n    } catch (err) {\n        console.error('[Castle Patrol] Error in student code:', err);\n    }\n}\n\n// rerunGame — Play Again button handler.\n// Re-evals the student source that was already fetched on first load.\nfunction rerunGame() {\n    const overlay = document.getElementById('result-overlay');\n    overlay.classList.remove('visible');\n    overlay.classList.add('hidden');\n\n    // Small delay so the overlay fade-out finishes before the canvas resets\n    setTimeout(function () {\n        runStudentCode(studentCodeSource);\n    }, 300);\n}\n\n// On page load: fetch script.js and kick everything off\nwindow.addEventListener('load', function () {\n    // Draw an initial idle scene while script.js loads over the network\n    drawBackground();\n    drawHUD('patrol', 0);\n\n    fetch('script.js')\n        .then(function (response) {\n            if (!response.ok) {\n                throw new Error('Could not load script.js — status ' + response.status);\n            }\n            return response.text();\n        })\n        .then(function (source) {\n            studentCodeSource = source;\n            runStudentCode(source);\n        })\n        .catch(function (err) {\n            console.error('[Castle Patrol] Failed to load script.js:', err);\n            // Show an error message directly on the canvas\n            ctx.fillStyle = 'rgba(0,0,0,0.7)';\n            ctx.fillRect(0, 0, CANVAS_W, CANVAS_H);\n            ctx.fillStyle = '#ff4444';\n            ctx.font = '18px monospace';\n            ctx.textAlign = 'center';\n            ctx.fillText('ERROR: script.js not found', CANVAS_W / 2, CANVAS_H / 2 - 10);\n            ctx.fillStyle = '#888888';\n            ctx.font = '18px monospace';\n            ctx.fillText('Open this via a local server', CANVAS_W / 2, CANVAS_H / 2 + 16);\n            ctx.textAlign = 'left';\n        });\n});\n",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
        "4": {
          "id": "4",
          "name": "script.js",
          "contents": "// The guard patrols while the player hasn't been detected.\nlet playerDetected = false;\nlet step = 0;\n\nwhile (playerDetected === false) {\n    step++;\n    patrolStep(step);\n  // What information should the loop use to decide \n  // when the player has been detected?\n\n}\n\nalertMode(step);\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "4"
