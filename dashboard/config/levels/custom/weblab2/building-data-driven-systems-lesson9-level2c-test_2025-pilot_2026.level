  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-04-01T21:38:25.000Z",
  "level_num": "custom",
  "user_id": 1574,
  "properties": {
    "encrypted": "false",
    "long_instructions": "## Chip Search\r\n\r\n### Do This:\r\n\r\n1. In `prompt.md`, plan how you want your chip search to work.\r\n\r\n2. Give your plan to AI and ask it to help you write the `chipSearch()` function.\r\n\r\n3. Your function should:\r\n\r\n   * take in a selected tag\r\n   * reset `displayResources` to an empty array\r\n   * use `.map()` to go through each resource in `resources`\r\n   * use an `if` statement to decide which resources should be kept\r\n   * add matching resources to `displayResources`\r\n   * call `renderResources()` at the end\r\n\r\n4. Connect each chip button to `chipSearch()` using the correct tag.\r\n\r\n5. Ask AI to suggest test cases to check your chip search. Try those tests in the app.",
    "submittable": "false",
    "hide_share_and_remix": "false",
    "disable_edit_run_for_submission": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
    "ai_tutor_mode": "engineer",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "placeholderText": "",
      "multipleChoiceOptions": [
        ""
      ],
      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false,
      "allowMultipleAttempts": false
    },
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Study Resource Hub - Chip Search</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n\n<body>\n  <header class=\"site-header\">\n    <h1>Study Resource Hub</h1>\n    <p class=\"tagline\">Find the right study resource fast.</p>\n  </header>\n\n  <main>\n    <section class=\"search-section\">\n      <h2>Chip Search</h2>\n\n      <div class=\"chip-row\">\n        <button id=\"quadraticsChip\" class=\"chip\">quadratics</button>\n        <button id=\"biologyChip\" class=\"chip\">biology</button>\n        <button id=\"historyChip\" class=\"chip\">history</button>\n        <button id=\"codingChip\" class=\"chip\">coding</button>\n        <button id=\"literatureChip\" class=\"chip\">literature</button>\n        <button id=\"mathChip\" class=\"chip\">math</button>\n        <button id=\"allChip\" class=\"chip chip-all\">All</button>\n      </div>\n\n      <p class=\"hint\">Click a chip to show resources with that tag.</p>\n\n      <p class=\"counts\">\n        Matches: <span id=\"matchCount\">0</span> of <span id=\"totalCount\">0</span>\n      </p>\n    </section>\n\n    <section class=\"results-section\">\n      <h2>Results</h2>\n      <div id=\"list\" class=\"card-list\"></div>\n    </section>\n  </main>\n\n\n  <script src=\"data.js\"></script>\n  <script src=\"helpers.js\"></script>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: Arial, sans-serif;\n  margin: 0;\n  background: #f5f7fb;\n  color: #222;\n}\n\n.site-header {\n  background: #264653;\n  color: white;\n  padding: 18px 16px;\n  text-align: center;\n}\n\n.site-header h1 {\n  margin: 0 0 4px;\n}\n\n.tagline {\n  margin: 0;\n  font-size: 0.95rem;\n}\n\nmain {\n  max-width: 900px;\n  margin: 0 auto;\n  padding: 16px;\n}\n\n.search-section {\n  background: white;\n  padding: 16px;\n  border-radius: 10px;\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);\n  margin-bottom: 16px;\n}\n\n.chip-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin: 12px 0;\n}\n\n.chip {\n  padding: 7px 14px;\n  background: #e0eef2;\n  border: none;\n  border-radius: 999px;\n  font-size: 0.9rem;\n  cursor: pointer;\n  color: #264653;\n}\n\n.chip:hover,\n.chip:focus {\n  background: #c7e3e9;\n  outline: none;\n}\n\n.chip-all {\n  background: #2a9d8f;\n  color: white;\n}\n\n.hint {\n  font-size: 0.9rem;\n  color: #555;\n}\n\n.counts {\n  font-size: 0.95rem;\n  margin-top: 8px;\n}\n\n.card-list {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n  gap: 12px;\n  margin-top: 8px;\n}\n\n.resource-card {\n  background: white;\n  padding: 12px;\n  border-radius: 8px;\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);\n}\n\n.resource-card h3 {\n  margin-top: 0;\n  margin-bottom: 4px;\n}\n\n.resource-meta {\n  font-size: 0.85rem;\n  color: #555;\n  margin-bottom: 6px;\n}\n\n.tags {\n  margin-top: 4px;\n  font-size: 0.8rem;\n}\n\n.tag {\n  display: inline-block;\n  background: #e9f5ff;\n  color: #13567a;\n  padding: 2px 6px;\n  margin: 2px 4px 0 0;\n  border-radius: 4px;\n}\n\n.badge-teacher {\n  display: inline-block;\n  background: #ffb703;\n  color: #000;\n  padding: 2px 6px;\n  border-radius: 4px;\n  font-size: 0.75rem;\n  margin-left: 6px;\n}\n\n.site-footer {\n  text-align: center;\n  padding: 12px;\n  font-size: 0.85rem;\n  color: #555;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const matchCount = document.getElementById(\"matchCount\");\nconst totalCount = document.getElementById(\"totalCount\");\nconst list = document.getElementById(\"list\");\n\nlet displayResources = resources;\n\nconst renderResources = () => {\n  list.innerHTML = \"\";\n\n  displayResources.map((resource) => {\n    createResourceCard(resource);\n  });\n\n  matchCount.textContent = displayResources.length;\n  totalCount.textContent = resources.length;\n};\n\nrenderResources();\n\n\n// Chip Search\nconst chipSearch = (selectedTag) => {\n\n\n\n\n\n\n\n  \n};\n\n\n// Event Handlers\ndocument.getElementById(\"quadraticsChip\").addEventListener(\"click\", () => {\n  chipSearch(\"quadratics\");\n});\n\ndocument.getElementById(\"biologyChip\").addEventListener(\"click\", () => {\n  chipSearch(\"biology\");\n});\n\ndocument.getElementById(\"historyChip\").addEventListener(\"click\", () => {\n  chipSearch(\"history\");\n});\n\ndocument.getElementById(\"codingChip\").addEventListener(\"click\", () => {\n  chipSearch(\"coding\");\n});\n\ndocument.getElementById(\"literatureChip\").addEventListener(\"click\", () => {\n  chipSearch(\"literature\");\n});\n\ndocument.getElementById(\"mathChip\").addEventListener(\"click\", () => {\n  chipSearch(\"math\");\n});\n\ndocument.getElementById(\"allChip\").addEventListener(\"click\", () => {\n  chipSearch(\"all\");\n});",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
          "name": "data.js",
          "contents": "const resources = [\n  {\n    title: \"Quadratics Intro Video\",\n    subject: \"Math\",\n    resourceType: \"video\",\n    gradeLevel: \"Algebra 1\",\n    tags: [\"math\", \"quadratics\", \"parabolas\"],\n    rating: 4.7,\n    teacherVerified: true\n  },\n  {\n    title: \"Plant Cells Diagram Notes\",\n    subject: \"Biology\",\n    resourceType: \"notes\",\n    gradeLevel: \"Biology\",\n    tags: [\"biology\", \"plant cells\", \"organelles\"],\n    rating: 4.5,\n    teacherVerified: false\n  },\n  {\n    title: \"Civil Rights Movement Flashcards\",\n    subject: \"US History\",\n    resourceType: \"flashcards\",\n    gradeLevel: \"10\",\n    tags: [\"history\", \"civil rights\", \"1960s\"],\n    rating: 4.9,\n    teacherVerified: true\n  },\n  {\n    title: \"Exponential Functions Practice\",\n    subject: \"Math\",\n    resourceType: \"worksheet\",\n    gradeLevel: \"Algebra 2\",\n    tags: [\"math\", \"exponentials\"],\n    rating: 4.2,\n    teacherVerified: false\n  },\n  {\n    title: \"Shakespeare Character Map\",\n    subject: \"English\",\n    resourceType: \"graphic organizer\",\n    gradeLevel: \"10\",\n    tags: [\"literature\", \"macbeth\", \"characters\"],\n    rating: 4.8,\n    teacherVerified: true\n  },\n  {\n    title: \"Photosynthesis Comic Summary\",\n    subject: \"Biology\",\n    resourceType: \"comic\",\n    gradeLevel: \"9\",\n    tags: [\"biology\", \"photosynthesis\", \"visual\"],\n    rating: 4.6,\n    teacherVerified: false\n  },\n  {\n    title: \"Intro to Coding Quiz Game\",\n    subject: \"Computer Science\",\n    resourceType: \"interactive quiz\",\n    gradeLevel: \"Intro CS\",\n    tags: [\"coding\", \"variables\", \"loops\"],\n    rating: 4.4,\n    teacherVerified: true\n  },\n  {\n    title: \"World War I Timeline Slides\",\n    subject: \"World History\",\n    resourceType: \"slide deck\",\n    gradeLevel: \"10\",\n    tags: [\"history\", \"WWI\", \"timeline\"],\n    rating: 4.3,\n    teacherVerified: false\n  },\n  {\n    title: \"Geometry Proof Practice Sheet\",\n    subject: \"Math\",\n    resourceType: \"worksheet\",\n    gradeLevel: \"Geometry\",\n    tags: [\"math\", \"proofs\", \"logic\"],\n    rating: 4.0,\n    teacherVerified: false\n  },\n  {\n    title: \"The Great Gatsby Symbolism Notes\",\n    subject: \"English\",\n    resourceType: \"notes\",\n    gradeLevel: \"11\",\n    tags: [\"literature\", \"gatsby\", \"symbolism\"],\n    rating: 4.9,\n    teacherVerified: true\n  }\n];",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "helpers.js",
          "contents": "const createResourceCard = (resource) => {\n  const list = document.getElementById(\"list\");\n\n  const card = document.createElement(\"article\");\n  card.className = \"resource-card\";\n\n  const title = document.createElement(\"h3\");\n  title.textContent = resource.title;\n\n  const meta = document.createElement(\"p\");\n  meta.className = \"resource-meta\";\n  meta.textContent = resource.subject + \" • \" + resource.resourceType + \" • Grade \" + resource.gradeLevel;\n\n  const rating = document.createElement(\"p\");\n  rating.className = \"resource-meta\";\n  rating.textContent = \"Rating: \" + resource.rating;\n\n  if (resource.teacherVerified === true) {\n    const badge = document.createElement(\"span\");\n    badge.className = \"badge-teacher\";\n    badge.textContent = \"Teacher Verified\";\n    rating.appendChild(badge);\n  }\n\n  const tags = document.createElement(\"p\");\n  tags.className = \"tags\";\n\n  resource.tags.map((tag) => {\n    const tagSpan = document.createElement(\"span\");\n    tagSpan.className = \"tag\";\n    tagSpan.textContent = tag;\n    tags.appendChild(tagSpan);\n  });\n\n  card.appendChild(title);\n  card.appendChild(meta);\n  card.appendChild(rating);\n  card.appendChild(tags);\n\n  list.appendChild(card);\n};",
          "folderId": "0",
          "active": false
        },
        "6": {
          "id": "6",
          "name": "prompt.md",
          "contents": "",
          "folderId": "0",
