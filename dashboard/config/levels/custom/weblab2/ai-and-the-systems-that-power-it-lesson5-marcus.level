  "properties": {
    "encrypted": "false",
    "long_instructions": "# RenderDeck Software Optimization\r\n\r\nMarcus needs help troubleshooting and optimizing the RenderDeck software he is using.\r\n\r\nRead the directions on the tablet displayed.",
    "offer_browser_tts": "false",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "true",
