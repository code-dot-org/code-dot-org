    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>RenderDeck</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n<script src=\"script.js\" defer></script>\n</head>\n<body>\n\n<h1 class=\"sr-only\">RenderDeck: one afternoon before the review</h1>\n\n<svg class=\"sprite\" aria-hidden=\"true\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\">\n\n  <symbol id=\"t-processor\" viewBox=\"0 0 24 24\">\n    <rect x=\"6\" y=\"6\" width=\"12\" height=\"12\" rx=\"2\"/>\n    <rect x=\"9.5\" y=\"9.5\" width=\"5\" height=\"5\" rx=\"1\" fill=\"#FFFFFF\"/>\n    <rect x=\"8.6\" y=\"2.5\" width=\"1.6\" height=\"3\"/><rect x=\"13.8\" y=\"2.5\" width=\"1.6\" height=\"3\"/>\n    <rect x=\"8.6\" y=\"18.5\" width=\"1.6\" height=\"3\"/><rect x=\"13.8\" y=\"18.5\" width=\"1.6\" height=\"3\"/>\n    <rect x=\"2.5\" y=\"8.6\" width=\"3\" height=\"1.6\"/><rect x=\"2.5\" y=\"13.8\" width=\"3\" height=\"1.6\"/>\n    <rect x=\"18.5\" y=\"8.6\" width=\"3\" height=\"1.6\"/><rect x=\"18.5\" y=\"13.8\" width=\"3\" height=\"1.6\"/>\n  </symbol>\n  <symbol id=\"t-gpu\" viewBox=\"0 0 24 24\">\n    <rect x=\"1.5\" y=\"5\" width=\"21\" height=\"12\" rx=\"2\"/>\n    <circle cx=\"8\" cy=\"11\" r=\"4\" fill=\"#FFFFFF\"/>\n    <circle cx=\"8\" cy=\"11\" r=\"1.3\"/>\n    <rect x=\"14\" y=\"8\" width=\"6\" height=\"1.6\" fill=\"#FFFFFF\"/>\n    <rect x=\"14\" y=\"12.4\" width=\"6\" height=\"1.6\" fill=\"#FFFFFF\"/>\n    <rect x=\"4\" y=\"17\" width=\"2.2\" height=\"3\"/><rect x=\"9\" y=\"17\" width=\"2.2\" height=\"3\"/>\n    <rect x=\"14\" y=\"17\" width=\"2.2\" height=\"3\"/>\n  </symbol>\n  <symbol id=\"t-storage\" viewBox=\"0 0 24 24\">\n    <ellipse cx=\"12\" cy=\"6\" rx=\"8\" ry=\"3\"/>\n    <path d=\"M4 6v5c0 1.7 3.6 3 8 3s8-1.3 8-3V6c0 1.7-3.6 3-8 3S4 7.7 4 6z\"/>\n    <path d=\"M4 13v5c0 1.7 3.6 3 8 3s8-1.3 8-3v-5c0 1.7-3.6 3-8 3s-8-1.3-8-3z\"/>\n  </symbol>\n  <symbol id=\"t-memory\" viewBox=\"0 0 24 24\">\n    <path d=\"M3 7h18v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/>\n    <rect x=\"6\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"9.6\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"13.2\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"16.8\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"5\" y=\"19\" width=\"4\" height=\"2.5\" rx=\"1\"/><rect x=\"15\" y=\"19\" width=\"4\" height=\"2.5\" rx=\"1\"/>\n  </symbol>\n  <symbol id=\"t-network\" viewBox=\"0 0 24 24\">\n    <circle cx=\"12\" cy=\"18.5\" r=\"2.4\"/>\n    <path d=\"M6.5 14.2a7.8 7.8 0 0 1 11 0l-1.8 1.8a5.2 5.2 0 0 0-7.4 0z\"/>\n    <path d=\"M3 10.7a12.8 12.8 0 0 1 18 0l-1.8 1.8a10.2 10.2 0 0 0-14.4 0z\"/>\n  </symbol>\n\n  <symbol id=\"a-clean\" viewBox=\"0 0 24 24\">\n    <rect x=\"11\" y=\"4.5\" width=\"2\" height=\"15\" transform=\"rotate(20 12 12)\"/>\n    <rect x=\"4.5\" y=\"8.6\" width=\"15\" height=\"2\" transform=\"rotate(-15 12 9.6)\"/>\n    <rect x=\"6\" y=\"14.6\" width=\"12\" height=\"2\" transform=\"rotate(12 12 15.6)\"/>\n    <circle cx=\"12\" cy=\"3.6\" r=\"2.6\"/>\n    <circle cx=\"4.4\" cy=\"10.6\" r=\"2.2\"/><circle cx=\"19.6\" cy=\"8.6\" r=\"2.2\"/>\n    <circle cx=\"6.6\" cy=\"20.4\" r=\"2.2\"/><circle cx=\"17.4\" cy=\"21\" r=\"2.2\"/>\n  </symbol>\n  <symbol id=\"a-render\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 1.6 22 7v10l-10 5.4L2 17V7z\"/>\n    <path d=\"m12 4.2 7.4 4-7.4 4-7.4-4z\" fill=\"#FFFFFF\"/>\n    <rect x=\"11.2\" y=\"11.6\" width=\"1.6\" height=\"8.4\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"a-save\" viewBox=\"0 0 24 24\">\n    <path d=\"M3 3h14.5L21 6.5V21H3z\"/>\n    <rect x=\"7\" y=\"3\" width=\"10\" height=\"7\" fill=\"#FFFFFF\"/>\n    <rect x=\"13\" y=\"4.4\" width=\"2.4\" height=\"4.2\"/>\n    <rect x=\"6.5\" y=\"13\" width=\"11\" height=\"8\" fill=\"#FFFFFF\"/>\n    <rect x=\"8.4\" y=\"15\" width=\"7.2\" height=\"1.6\"/>\n    <rect x=\"8.4\" y=\"17.6\" width=\"7.2\" height=\"1.6\"/>\n  </symbol>\n  <symbol id=\"a-publish\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 1.8 18 8h-3.9v7.4h-4.2V8H6z\"/>\n    <path d=\"M3.6 14.6H6v4.2h12v-4.2h2.4V22H3.6z\"/>\n  </symbol>\n  <symbol id=\"a-check\" viewBox=\"0 0 24 24\">\n    <path d=\"M9.4 18.6 3 12.2l2.3-2.3 4.1 4.1L18.7 5l2.3 2.3z\"/>\n  </symbol>\n  <symbol id=\"a-chevron\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 15.6 3.9 7.5a1.6 1.6 0 0 1 2.2-2.2l5.9 5.9 5.9-5.9a1.6 1.6 0 0 1 2.2 2.2z\"/>\n  </symbol>\n  <symbol id=\"a-reset\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 4.5a7.5 7.5 0 1 0 7.2 9.6h-2.7A4.9 4.9 0 1 1 12 7.1a4.8 4.8 0 0 1 3.4 1.4L12.6 11.3H21V2.9l-2.7 2.7A7.5 7.5 0 0 0 12 4.5z\"/>\n  </symbol>\n  <symbol id=\"a-alert\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 2.5 23 21H1z\"/>\n    <rect x=\"11\" y=\"9\" width=\"2\" height=\"6\" rx=\"1\" fill=\"#FFFFFF\"/>\n    <circle cx=\"12\" cy=\"18\" r=\"1.3\" fill=\"#FFFFFF\"/>\n  </symbol>\n\n  <symbol id=\"g-scene\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 1.6 22 7v10l-10 5.4L2 17V7z\"/>\n    <path d=\"m12 4.2 7.4 4-7.4 4-7.4-4z\" fill=\"#FFFFFF\"/>\n    <rect x=\"11.2\" y=\"11.6\" width=\"1.6\" height=\"8.4\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"g-gpu\" viewBox=\"0 0 24 24\">\n    <rect x=\"1.5\" y=\"5\" width=\"21\" height=\"12\" rx=\"2\"/>\n    <circle cx=\"8\" cy=\"11\" r=\"4\" fill=\"#FFFFFF\"/>\n    <circle cx=\"8\" cy=\"11\" r=\"1.3\"/>\n    <rect x=\"14\" y=\"8\" width=\"6\" height=\"1.6\" fill=\"#FFFFFF\"/>\n    <rect x=\"14\" y=\"12.4\" width=\"6\" height=\"1.6\" fill=\"#FFFFFF\"/>\n    <rect x=\"4\" y=\"17\" width=\"2.2\" height=\"3\"/><rect x=\"9\" y=\"17\" width=\"2.2\" height=\"3\"/>\n    <rect x=\"14\" y=\"17\" width=\"2.2\" height=\"3\"/>\n  </symbol>\n  <symbol id=\"g-render\" viewBox=\"0 0 24 24\">\n    <rect x=\"1.5\" y=\"3.5\" width=\"21\" height=\"17\" rx=\"2\"/>\n    <rect x=\"6.5\" y=\"6.5\" width=\"11\" height=\"11\" fill=\"#FFFFFF\"/>\n    <rect x=\"3.2\" y=\"5.6\" width=\"2\" height=\"2\" fill=\"#FFFFFF\"/>\n    <rect x=\"3.2\" y=\"11\" width=\"2\" height=\"2\" fill=\"#FFFFFF\"/>\n    <rect x=\"3.2\" y=\"16.4\" width=\"2\" height=\"2\" fill=\"#FFFFFF\"/>\n    <rect x=\"18.8\" y=\"5.6\" width=\"2\" height=\"2\" fill=\"#FFFFFF\"/>\n    <rect x=\"18.8\" y=\"11\" width=\"2\" height=\"2\" fill=\"#FFFFFF\"/>\n    <rect x=\"18.8\" y=\"16.4\" width=\"2\" height=\"2\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"g-storage\" viewBox=\"0 0 24 24\">\n    <ellipse cx=\"12\" cy=\"6\" rx=\"8\" ry=\"3\"/>\n    <path d=\"M4 6v5c0 1.7 3.6 3 8 3s8-1.3 8-3V6c0 1.7-3.6 3-8 3S4 7.7 4 6z\"/>\n    <path d=\"M4 13v5c0 1.7 3.6 3 8 3s8-1.3 8-3v-5c0 1.7-3.6 3-8 3s-8-1.3-8-3z\"/>\n  </symbol>\n  <symbol id=\"g-network\" viewBox=\"0 0 24 24\">\n    <rect x=\"10.6\" y=\"9\" width=\"2.8\" height=\"13\" rx=\"1\"/>\n    <path d=\"M12 2a7 7 0 0 0-7 7h2.6A4.4 4.4 0 0 1 12 4.6z\"/>\n    <path d=\"M12 2a7 7 0 0 1 7 7h-2.6A4.4 4.4 0 0 0 12 4.6z\"/>\n    <circle cx=\"12\" cy=\"8\" r=\"2.2\"/>\n  </symbol>\n  <symbol id=\"g-system\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 8.4A3.6 3.6 0 1 0 12 15.6 3.6 3.6 0 0 0 12 8.4zm9.4 5.2.1-1.6-.1-1.6 2-1.6-2-3.4-2.4.9a7.8 7.8 0 0 0-2.8-1.6L15.8 2h-3.9l-.4 2.7a7.8 7.8 0 0 0-2.8 1.6L6.3 5.4l-2 3.4 2 1.6-.1 1.6.1 1.6-2 1.6 2 3.4 2.4-.9a7.8 7.8 0 0 0 2.8 1.6l.4 2.7h3.9l.4-2.7a7.8 7.8 0 0 0 2.8-1.6l2.4.9 2-3.4z\"/>\n  </symbol>\n  <symbol id=\"g-display\" viewBox=\"0 0 24 24\">\n    <rect x=\"2\" y=\"3.5\" width=\"20\" height=\"14\" rx=\"2\"/>\n    <rect x=\"4.5\" y=\"6\" width=\"15\" height=\"9\" fill=\"#FFFFFF\"/>\n    <rect x=\"8\" y=\"19.5\" width=\"8\" height=\"2\" rx=\"1\"/>\n  </symbol>\n  <symbol id=\"g-settings\" viewBox=\"0 0 24 24\">\n    <rect x=\"2\" y=\"4.6\" width=\"20\" height=\"2.2\" rx=\"1.1\"/>\n    <rect x=\"2\" y=\"10.9\" width=\"20\" height=\"2.2\" rx=\"1.1\"/>\n    <rect x=\"2\" y=\"17.2\" width=\"20\" height=\"2.2\" rx=\"1.1\"/>\n    <circle cx=\"8\" cy=\"5.7\" r=\"3\"/><circle cx=\"16\" cy=\"12\" r=\"3\"/><circle cx=\"10\" cy=\"18.3\" r=\"3\"/>\n    <circle cx=\"8\" cy=\"5.7\" r=\"1.3\" fill=\"#FFFFFF\"/><circle cx=\"16\" cy=\"12\" r=\"1.3\" fill=\"#FFFFFF\"/>\n    <circle cx=\"10\" cy=\"18.3\" r=\"1.3\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"g-shots\" viewBox=\"0 0 24 24\">\n    <rect x=\"1.5\" y=\"3.5\" width=\"21\" height=\"17\" rx=\"2\"/>\n    <rect x=\"6.5\" y=\"6.5\" width=\"11\" height=\"11\" fill=\"#FFFFFF\"/>\n    <rect x=\"3.2\" y=\"5.6\" width=\"2\" height=\"2\" fill=\"#FFFFFF\"/>\n    <rect x=\"3.2\" y=\"11\" width=\"2\" height=\"2\" fill=\"#FFFFFF\"/>\n    <rect x=\"3.2\" y=\"16.4\" width=\"2\" height=\"2\" fill=\"#FFFFFF\"/>\n    <rect x=\"18.8\" y=\"5.6\" width=\"2\" height=\"2\" fill=\"#FFFFFF\"/>\n    <rect x=\"18.8\" y=\"11\" width=\"2\" height=\"2\" fill=\"#FFFFFF\"/>\n    <rect x=\"18.8\" y=\"16.4\" width=\"2\" height=\"2\" fill=\"#FFFFFF\"/>\n  </symbol>\n\n  <symbol id=\"s-rooftop\" viewBox=\"0 0 48 48\">\n    <rect x=\"3\" y=\"19\" width=\"12\" height=\"26\"/>\n    <rect x=\"17\" y=\"9\" width=\"14\" height=\"36\"/>\n    <rect x=\"33\" y=\"25\" width=\"12\" height=\"20\"/>\n    <rect x=\"22\" y=\"2\" width=\"4\" height=\"7\"/>\n    <rect x=\"6\" y=\"23\" width=\"3\" height=\"3\" fill=\"#FFFFFF\"/><rect x=\"11\" y=\"23\" width=\"3\" height=\"3\" fill=\"#FFFFFF\"/>\n    <rect x=\"6\" y=\"30\" width=\"3\" height=\"3\" fill=\"#FFFFFF\"/><rect x=\"11\" y=\"30\" width=\"3\" height=\"3\" fill=\"#FFFFFF\"/>\n    <rect x=\"20\" y=\"14\" width=\"3.4\" height=\"3.4\" fill=\"#FFFFFF\"/><rect x=\"26\" y=\"14\" width=\"3.4\" height=\"3.4\" fill=\"#FFFFFF\"/>\n    <rect x=\"20\" y=\"22\" width=\"3.4\" height=\"3.4\" fill=\"#FFFFFF\"/><rect x=\"26\" y=\"22\" width=\"3.4\" height=\"3.4\" fill=\"#FFFFFF\"/>\n    <rect x=\"20\" y=\"30\" width=\"3.4\" height=\"3.4\" fill=\"#FFFFFF\"/><rect x=\"26\" y=\"30\" width=\"3.4\" height=\"3.4\" fill=\"#FFFFFF\"/>\n    <rect x=\"36\" y=\"29\" width=\"3\" height=\"3\" fill=\"#FFFFFF\"/><rect x=\"36\" y=\"36\" width=\"3\" height=\"3\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"s-car\" viewBox=\"0 0 48 48\">\n    <path d=\"M3 29h42v8a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3z\"/>\n    <path d=\"M11 29 16 18h16l7 11z\"/>\n    <path d=\"M17 21h5v8h-9z\" fill=\"#FFFFFF\"/>\n    <path d=\"M26 21h4.6l4.4 8h-9z\" fill=\"#FFFFFF\"/>\n    <circle cx=\"14\" cy=\"40\" r=\"5.5\"/><circle cx=\"34\" cy=\"40\" r=\"5.5\"/>\n    <circle cx=\"14\" cy=\"40\" r=\"2\" fill=\"#FFFFFF\"/><circle cx=\"34\" cy=\"40\" r=\"2\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"s-creature\" viewBox=\"0 0 48 48\">\n    <path d=\"M2 24c7-10.5 14-15.5 22-15.5S39 13.5 46 24c-7 10.5-14 15.5-22 15.5S9 34.5 2 24z\"/>\n    <circle cx=\"24\" cy=\"24\" r=\"11.5\" fill=\"#FFFFFF\"/>\n    <ellipse cx=\"24\" cy=\"24\" rx=\"4\" ry=\"10.5\"/>\n    <path d=\"M6 9 14 14l-1.8 3L4 12z\"/>\n    <path d=\"M42 9 34 14l1.8 3L44 12z\"/>\n  </symbol>\n  <symbol id=\"s-crowd\" viewBox=\"0 0 48 48\">\n    <circle cx=\"10\" cy=\"19\" r=\"6.5\"/><path d=\"M0 43a10 10 0 0 1 20 0z\"/>\n    <circle cx=\"38\" cy=\"19\" r=\"6.5\"/><path d=\"M28 43a10 10 0 0 1 20 0z\"/>\n    <circle cx=\"24\" cy=\"15\" r=\"9.5\" fill=\"#FFFFFF\"/><circle cx=\"24\" cy=\"15\" r=\"7.5\"/>\n    <path d=\"M10 46a14 14 0 0 1 28 0z\" fill=\"#FFFFFF\"/>\n    <path d=\"M12 46a12 12 0 0 1 24 0z\"/>\n  </symbol>\n</svg>\n\n<div class=\"device\">\n  <div class=\"screen\">\n\n    <div class=\"statusbar\">\n      <div class=\"stat\"><span class=\"stat-label\">Time</span><span class=\"stat-value\" id=\"stat-clock\">2:00 PM</span></div>\n      <div class=\"stat has-gauge\"><span class=\"stat-label\">Card temp</span><span class=\"stat-value\" id=\"stat-temp\">42&deg;</span><span class=\"gauge\"><span class=\"gauge-fill\" id=\"gauge-temp\"></span></span></div>\n      <div class=\"stat has-gauge\"><span class=\"stat-label\">RAM</span><span class=\"stat-value\" id=\"stat-ram\">75%</span><span class=\"gauge\"><span class=\"gauge-fill\" id=\"gauge-ram\"></span></span></div>\n      <div class=\"stat has-gauge\"><span class=\"stat-label\">Disk</span><span class=\"stat-value\" id=\"stat-disk\">35%</span><span class=\"gauge\"><span class=\"gauge-fill\" id=\"gauge-disk\"></span></span></div>\n      <div class=\"stat\"><span class=\"stat-label\">Speed</span><span class=\"stat-value\" id=\"stat-speed\">Full speed</span></div>\n      <button type=\"button\" class=\"reset\" id=\"reset-btn\" aria-label=\"Start the afternoon over\">\n        <svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-reset\"></use></svg>\n      </button>\n    </div>\n\n    <div class=\"procbar\"><div class=\"procbar-fill\" id=\"procbar-fill\"></div></div>\n\n    <main class=\"body\">\n\n      <section class=\"view\" id=\"view-brief\">\n       <div class=\"hero\">\n          <h2 class=\"hero-title\">RenderDeck<br> Workstation</h2>\n        </div>\n\n        <h3 class=\"brief-head\">The situation</h3>\n        <p class=\"lede\">Marcus supervises visual effects for a film. He creates digital versions of complicated shots before anyone films them, so the director can see what a scene will look like. He has four shots to finish by 6:00 PM, and one workstation to do all of it on.</p>\n\n        <h3 class=\"brief-head\">Your job</h3>\n        <p class=\"lede\">Help Marcus troubleshoot and optimize the RenderDeck software on his workstation. Every time a problem comes up, open <strong>Settings</strong>, figure out which setting is causing it, and change it. Some settings will fix the problem. Many of them will not do anything at all, and every change you make takes some of his limited time .</p>\n\n        <h3 class=\"brief-head\">For each shot, you will</h3>\n        <ul class=\"steplist\">\n          <li class=\"step-item\"><span class=\"step-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-clean\"></use></svg></span><span class=\"step-name\">Clean up the motion data</span></li>\n          <li class=\"step-item\"><span class=\"step-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-render\"></use></svg></span><span class=\"step-name\">Render the picture</span></li>\n          <li class=\"step-item\"><span class=\"step-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-save\"></use></svg></span><span class=\"step-name\">Save the file</span></li>\n          <li class=\"step-item\"><span class=\"step-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-publish\"></use></svg></span><span class=\"step-name\">Send it to the review</span></li>\n        </ul>\n        <p class=\"lede\">Work them in any order you like. How a saved shot gets sent to the review is one of the settings.</p>\n\n        <h3 class=\"brief-head\">A good afternoon looks like this</h3>\n        <ul class=\"goals\" id=\"brief-goals\"></ul>\n\n        <div class=\"actions\">\n          <button type=\"button\" class=\"btn btn-go btn-lg\" id=\"start-btn\">Start the afternoon</button>\n        </div>\n      </section>\n\n      <section class=\"view\" id=\"view-shots\" hidden>\n        <div class=\"banner\" id=\"banner\" hidden role=\"alert\"></div>\n        <div class=\"section-head\">\n          <h2 class=\"section-title\">Today's shots</h2>\n          <span class=\"section-chip\" id=\"shots-chip\"></span>\n        </div>\n        <ul class=\"squad\" id=\"shots\"></ul>\n        <div class=\"detail\" id=\"detail\" hidden></div>\n        <div class=\"finish\" id=\"finish\"></div>\n      </section>\n\n      <section class=\"view\" id=\"view-settings\" hidden>\n        <div class=\"section-head\">\n          <h2 class=\"section-title\">Settings</h2>\n        </div>\n        <div class=\"symptom\" id=\"symptom\" hidden aria-live=\"polite\"></div>\n        <p class=\"settings-note\" id=\"settings-note\"></p>\n        <div class=\"groups\" id=\"groups\"></div>\n      </section>\n\n      <section class=\"view\" id=\"view-report\" hidden>\n        <div class=\"hero\">\n          <p class=\"hero-kicker\">End of day report</p>\n          <h2 class=\"hero-title\" id=\"report-headline\">End of Day Report</h2>\n          <p class=\"hero-sub\" id=\"report-sub\"></p>\n          <p class=\"verdict\" id=\"verdict\"></p>\n        </div>\n        <ul class=\"report-list\" id=\"report-list\"></ul>\n        <h3>Where the afternoon went</h3>\n        <div class=\"tally\" id=\"tally\"></div>\n        <div class=\"report-notes\" id=\"report-notes\"></div>\n        <h3>Questions</h3>\n        <ol class=\"questions\" id=\"questions\"></ol>\n        <div class=\"actions\">\n          <button type=\"button\" class=\"btn btn-go\" id=\"again-btn\">Try the afternoon again</button>\n        </div>\n      </section>\n\n    </main>\n\n    <div class=\"sheet\" id=\"sheet\" hidden>\n      <div class=\"sheet-card\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"sheet-title\">\n        <h2 class=\"sheet-title\" id=\"sheet-title\">Start the afternoon over?</h2>\n        <p class=\"sheet-body\">The clock goes back to 2:00 PM, the computer goes back to how it started up, every setting resets, and the four shots are waiting again.</p>\n        <div class=\"actions\">\n          <button type=\"button\" class=\"btn btn-go\" id=\"sheet-yes\">Yes, start over</button>\n          <button type=\"button\" class=\"btn btn-alt\" id=\"sheet-no\">Keep going</button>\n        </div>\n      </div>\n    </div>\n\n    <nav class=\"tabbar\" id=\"tabbar\" aria-label=\"RenderDeck sections\" hidden>\n      <button type=\"button\" class=\"tab\" data-tab=\"shots\">\n        <span class=\"tab-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#g-shots\"></use></svg></span>\n        <span class=\"tab-label\">Shots</span>\n      </button>\n      <button type=\"button\" class=\"tab\" data-tab=\"settings\">\n        <span class=\"tab-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#g-settings\"></use></svg></span>\n        <span class=\"tab-label\">Settings</span>\n        <span class=\"tab-dot\" id=\"tab-dot\" hidden></span>\n      </button>\n    </nav>\n\n  </div>\n</div>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "/* Brand fonts, subset to Latin. Any glyph they lack falls through to the\n   next family in each stack, so other writing systems still render. */\n@font-face {\n  font-family: \"Space Grotesk\";\n  src: url(\"SpaceGrotesk.ttf\") format(\"truetype\");\n  font-weight: 300 700;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: \"Geist\";\n  src: url(\"Geist.ttf\") format(\"truetype\");\n  font-weight: 100 900;\n  font-display: swap;\n}\n\n:root {\n  --purple-light: #E4E2F8;\n  --purple-mid: #ACA8EA;\n  --purple: #4C42CF;\n  --purple-dark: #1F1976;\n  --blue-light: #D5EFFF;\n  --blue-mid: #6FCAFF;\n  --blue: #0099F3;\n  --blue-dark: #06338D;\n  --green-light: #CCF1D0;\n  --green-mid: #7CDB87;\n  --green: #34BD43;\n  --green-dark: #003F25;\n  --orange-light: #FFE3CE;\n  --orange-mid: #FFA868;\n  --orange: #F46800;\n  --orange-dark: #611D00;\n  --pink-light: #FBDAE8;\n  --pink-mid: #F07FB0;\n  --pink: #E11970;\n  --pink-dark: #7D0C3D;\n\n  --ink: #000000;\n  --ink-soft: #4A4857;\n  --line: #D6D4E0;\n  --tint: #F7F6FC;\n\n  --lift: 0 2px 0 rgba(31, 25, 118, 0.14);\n  --lift-lg: 0 4px 16px rgba(31, 25, 118, 0.18);\n\n  --font-display: \"Space Grotesk\", \"Noto Sans\", system-ui, sans-serif;\n  --font-body: \"Geist\", \"Noto Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n}\n\n* { box-sizing: border-box; }\n[hidden] { display: none !important; }\nhtml, body { height: 100%; }\n\nbody {\n  margin: 0;\n  padding: 10px;\n  background-color: var(--purple-light);\n  font-family: var(--font-body);\n  font-size: 15px;\n  color: var(--ink);\n  line-height: 1.45;\n}\n\n.sr-only {\n  position: absolute; width: 1px; height: 1px;\n  padding: 0; margin: -1px; overflow: hidden;\n  clip: rect(0 0 0 0); white-space: nowrap; border: 0;\n}\n\n.sprite { position: absolute; width: 0; height: 0; }\n\n.device {\n  max-width: 44rem;\n  margin-inline: auto;\n  background-color: var(--purple-dark);\n  border-radius: 20px;\n  padding: 10px;\n  box-shadow: var(--lift-lg);\n}\n\n.screen {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  height: min(42rem, calc(100dvh - 40px));\n  min-height: 26rem;\n  background-color: #FFFFFF;\n  border-radius: 12px;\n  overflow: hidden;\n}\n\n/* ---------- status bar ---------- */\n\n.statusbar {\n  display: flex; flex-wrap: wrap;\n  gap: 0.3rem 1.3rem;\n  padding: 0.5rem 0.85rem;\n  background-color: var(--purple-dark);\n  color: #FFFFFF;\n  flex: 0 0 auto;\n}\n\n.stat { display: flex; flex-direction: column; line-height: 1.15; }\n.stat.has-gauge { min-width: 4.4rem; }\n\n.stat-label {\n  font-size: 0.6rem; letter-spacing: 0.08em;\n  text-transform: uppercase; color: var(--purple-mid);\n}\n\n.stat-value { font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; }\n.stat-value.warn { color: var(--orange-mid); }\n.stat-value.bad { color: var(--pink-mid); }\n\n.gauge {\n  display: block; height: 7px; margin-block-start: 0.25rem;\n  border-radius: 4px; overflow: hidden;\n  background-color: var(--purple-dark);\n  border: 1px solid var(--purple-mid);\n}\n\n.gauge-fill {\n  display: block; height: 100%; width: 0;\n  transition: width 260ms ease-out;\n}\n\n.gauge-fill.battery { background-color: var(--green-mid); }\n.gauge-fill.storage { background-color: var(--blue-mid); }\n.gauge-fill.ram { background-color: var(--purple-mid); }\n.gauge-fill.temp { background-color: var(--green-mid); }\n.gauge-fill.warn { background-color: var(--orange-mid); }\n.gauge-fill.bad { background-color: var(--pink-mid); }\n\n.reset {\n  margin-inline-start: auto; align-self: center;\n  width: 38px; height: 38px; flex: 0 0 auto;\n  display: flex; align-items: center; justify-content: center;\n  border-radius: 10px; cursor: pointer;\n  background-color: var(--purple); color: #FFFFFF;\n  border: 2px solid var(--purple-mid);\n}\n\n.reset svg { width: 21px; height: 21px; fill: currentColor; }\n\n.procbar { flex: 0 0 auto; height: 5px; background-color: var(--purple-light); }\n.procbar-fill { height: 100%; width: 0; background-color: var(--orange); transition: width linear; }\n\n@media (max-width: 26rem) {\n  .statusbar { gap: 0.3rem 0.9rem; padding: 0.45rem 0.65rem; }\n  .stat-value { font-size: 0.86rem; }\n}\n\n/* ---------- layout ---------- */\n\n.body { flex: 1 1 auto; overflow-y: auto; overscroll-behavior: contain; }\n.view { padding: 0.85rem 0.9rem 1.1rem; }\n\nh2, h3 { font-family: var(--font-display); margin: 0; }\nh3 { font-size: 1rem; color: var(--purple-dark); margin-block-end: 0.35rem; }\n\n.section-head {\n  display: flex; align-items: center; gap: 0.5rem;\n  margin-block-end: 0.55rem;\n}\n\n.section-title {\n  font-size: 1.3rem; line-height: 0.95;\n  letter-spacing: -0.02em; color: var(--purple-dark);\n}\n\n.section-chip {\n  margin-inline-start: auto;\n  font-family: var(--font-display); font-weight: 700; font-size: 0.72rem;\n  letter-spacing: 0.04em; text-transform: uppercase;\n  color: var(--purple-dark); background-color: var(--purple-light);\n  padding: 0.2rem 0.6rem; border-radius: 999px;\n}\n\n/* ---------- hero band ----------\n   Brand gradient: Primary at the top, Mid in the middle, Light at the bottom.\n   White type stays in the Primary region. */\n\n.hero {\n  border-radius: 14px;\n  padding: 1rem 1rem 1.1rem;\n  margin-block-end: 0.9rem;\n  background-image: linear-gradient(180deg, var(--purple) 0%, var(--purple-mid) 62%, var(--purple-light) 100%);\n}\n\n.hero-kicker {\n  margin: 0 0 0.3rem;\n  font-family: var(--font-display); font-weight: 700;\n  font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase;\n  color: #FFFFFF;\n}\n\n.hero-title {\n  font-size: 1.8rem; line-height: 0.94;\n  letter-spacing: -0.02em; color: #FFFFFF;\n  margin-block-end: 0.55rem;\n}\n\n.hero-title:only-child { margin-block-end: 0; }\n\n.hero-sub {\n  margin: 0;\n  font-size: 0.9rem; font-weight: 600;\n  color: var(--purple-dark);\n}\n\n.verdict {\n  display: inline-block; margin: 0.6rem 0 0;\n  font-family: var(--font-display); font-weight: 700; font-size: 0.83rem;\n  padding: 0.3rem 0.75rem; border-radius: 999px;\n  background-color: var(--pink-light); color: var(--pink-dark);\n}\n\n.verdict.good { background-color: var(--green-light); color: var(--green-dark); }\n\n/* ---------- brief ---------- */\n\n.brief-head {\n  font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase;\n  color: var(--purple); margin-block-end: 0.3rem;\n}\n\n.brief-head + .lede { margin-block-start: 0; }\n.lede { margin: 0 0 0.7rem; font-size: 0.93rem; }\n.lede strong { color: var(--purple-dark); }\n\n.goals { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.3rem; }\n\n.goals li {\n  display: flex; align-items: flex-start; gap: 0.5rem;\n  font-size: 0.88rem; color: var(--green-dark);\n  background-color: var(--green-light);\n  border-radius: 9px; padding: 0.35rem 0.55rem;\n}\n\n.goal-icon {\n  flex: 0 0 auto; width: 20px; height: 20px; border-radius: 6px;\n  background-color: var(--green-dark); color: #FFFFFF;\n  display: flex; align-items: center; justify-content: center;\n}\n\n.goal-icon svg { width: 12px; height: 12px; fill: currentColor; }\n\n.steplist {\n  list-style: none; margin: 0 0 0.85rem; padding: 0;\n  display: grid; gap: 0.45rem;\n  grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));\n}\n\n.step-item {\n  display: flex; align-items: center; gap: 0.55rem;\n  border-radius: 12px; padding: 0.5rem 0.6rem;\n  background-color: var(--tint);\n  border: 2px solid var(--purple-light);\n}\n\n.step-icon {\n  flex: 0 0 auto; width: 34px; height: 34px; border-radius: 9px;\n  background-color: var(--purple); color: #FFFFFF;\n  display: flex; align-items: center; justify-content: center;\n}\n\n.step-icon svg { width: 21px; height: 21px; fill: currentColor; }\n.step-name { font-family: var(--font-display); font-weight: 700; font-size: 0.87rem; color: var(--purple-dark); }\n\n/* ---------- banner ---------- */\n\n.banner {\n  border-radius: 14px; overflow: hidden;\n  margin-block-end: 0.85rem;\n  background-color: var(--orange-light);\n  border: 2px solid var(--orange-dark);\n  box-shadow: var(--lift);\n}\n\n.banner.hard { background-color: var(--pink-light); border-color: var(--pink-dark); }\n\n.banner-head {\n  display: flex; align-items: center; gap: 0.55rem;\n  padding: 0.5rem 0.7rem;\n  background-color: var(--orange-dark);\n}\n\n.banner.hard .banner-head { background-color: var(--pink-dark); }\n\n.banner-icon {\n  flex: 0 0 auto; width: 28px; height: 28px; border-radius: 8px;\n  background-color: #FFFFFF; color: var(--orange-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.banner.hard .banner-icon { color: var(--pink-dark); }\n.banner-icon svg { width: 18px; height: 18px; fill: currentColor; }\n.banner-title { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 0.97rem; color: #FFFFFF; }\n\n.banner-voice {\n  margin: 0; padding: 0.6rem 0.75rem 0.5rem;\n  font-size: 0.88rem; font-style: italic; color: var(--orange-dark);\n}\n\n.banner.hard .banner-voice { color: var(--pink-dark); }\n.banner .actions { padding: 0 0.75rem 0.7rem; }\n\n/* ---------- player picker ---------- */\n\n.squad {\n  list-style: none; margin: 0 0 0.85rem; padding: 0;\n  display: grid; gap: 0.5rem;\n  grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));\n}\n\n.player {\n  width: 100%;\n  display: flex; flex-direction: column; align-items: center; gap: 0.3rem;\n  font: inherit; color: inherit; cursor: pointer;\n  border: 2px solid var(--purple-light); border-radius: 14px;\n  background-color: #FFFFFF; padding: 0.6rem 0.45rem 0.5rem;\n  min-height: 44px;\n  box-shadow: var(--lift);\n  transition: transform 120ms ease-out;\n}\n\n.player:active { transform: translateY(1px); }\n.player.picked { border-color: var(--purple-dark); background-color: var(--purple); }\n.player.done { border-color: var(--green); background-color: var(--green-light); }\n\n.player-icon {\n  width: 52px; height: 52px; border-radius: 13px;\n  background-color: var(--purple-light); color: var(--purple-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.player.picked .player-icon { background-color: #FFFFFF; color: var(--purple); }\n.player.done .player-icon { background-color: #FFFFFF; color: var(--green-dark); }\n.player-icon svg { width: 38px; height: 38px; fill: currentColor; }\n\n.player-name { font-family: var(--font-display); font-weight: 700; font-size: 0.92rem; color: var(--purple-dark); }\n.player.picked .player-name { color: #FFFFFF; }\n.player.done .player-name { color: var(--green-dark); }\n\n.pips {\n  display: flex; gap: 0.22rem;\n  padding: 0.2rem; border-radius: 9px;\n  background-color: var(--tint);\n}\n\n.player.picked .pips { background-color: var(--purple-dark); }\n\n.pip {\n  width: 21px; height: 21px; border-radius: 6px;\n  background-color: var(--purple-light); color: var(--purple-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.pip svg { width: 13px; height: 13px; fill: currentColor; }\n\n.here-badge {\n  width: 24px; height: 24px; border-radius: 7px;\n  background-color: var(--orange); color: #FFFFFF;\n  display: flex; align-items: center; justify-content: center;\n}\n\n.here-badge svg { width: 15px; height: 15px; fill: currentColor; }\n.pip-done { background-color: var(--green-dark); color: #FFFFFF; }\n\n/* ---------- player detail ---------- */\n\n.detail {\n  border-radius: 14px; overflow: hidden;\n  margin-block-end: 0.85rem;\n  background-color: #FFFFFF;\n  border: 2px solid var(--purple-light);\n  box-shadow: var(--lift);\n}\n\n.detail.empty {\n  padding: 0.95rem; color: var(--ink-soft);\n  font-size: 0.9rem; font-style: italic;\n  background-color: var(--tint);\n}\n\n.detail.empty p { margin: 0; }\n\n.detail-head {\n  display: flex; align-items: center; gap: 0.6rem;\n  padding: 0.6rem 0.75rem 0.7rem;\n  background-image: linear-gradient(180deg, var(--purple) 0%, var(--purple-mid) 62%, var(--purple-light) 100%);\n}\n\n.detail-icon {\n  flex: 0 0 auto; width: 48px; height: 48px; border-radius: 12px;\n  background-color: #FFFFFF; color: var(--purple);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.detail-icon svg { width: 34px; height: 34px; fill: currentColor; }\n.detail-id { display: flex; flex-direction: column; min-width: 0; }\n.detail-name { font-family: var(--font-display); font-weight: 700; font-size: 1.12rem; line-height: 1.05; color: #FFFFFF; }\n.detail-kind { font-size: 0.78rem; font-weight: 600; color: var(--purple-dark); }\n\n.detail-body { padding: 0.7rem 0.75rem 0.8rem; }\n.complaint { margin: 0 0 0.5rem; font-size: 0.89rem; font-style: italic; color: var(--ink-soft); }\n\n.findings { list-style: none; margin: 0 0 0.6rem; padding: 0; display: grid; gap: 0.25rem; }\n\n.findings li {\n  font-size: 0.86rem;\n  padding: 0.32rem 0.5rem 0.32rem 0.55rem;\n  border-radius: 8px;\n  background-color: var(--purple-light);\n  border-inline-start: 4px solid var(--purple);\n  color: var(--purple-dark);\n}\n\n.detail-flag {\n  margin: 0 0 0.6rem; padding: 0.4rem 0.6rem; border-radius: 9px;\n  font-size: 0.82rem; font-weight: 600;\n  background-color: var(--orange-light); color: var(--orange-dark);\n  border-inline-start: 5px solid var(--orange);\n}\n\n.detail-travel {\n  margin: 0 0 0.55rem; font-size: 0.79rem; color: var(--ink-soft);\n}\n\n.shot { margin: 0 0 0.6rem; }\n\n.shot-img {\n  display: block; width: 100%; max-width: 230px; height: auto;\n  border-radius: 12px; border: 3px solid var(--blue);\n}\n\n.q-standard { filter: blur(0.6px); }\n.q-low { filter: blur(1.6px); image-rendering: pixelated; }\n\n.shot-cap {\n  margin: 0.35rem 0 0; font-size: 0.77rem; font-weight: 600;\n  color: var(--blue-dark);\n}\n\n.detail-note {\n  margin: 0.5rem 0 0; padding: 0.45rem 0.6rem; border-radius: 9px;\n  font-size: 0.8rem; font-weight: 600;\n  background-color: var(--pink-light); color: var(--pink-dark);\n}\n\n/* ---------- finish ---------- */\n\n.finish {\n  border-radius: 14px; padding: 0.7rem 0.75rem;\n  background-color: var(--tint);\n  border: 2px dashed var(--purple);\n}\n\n.finish-note { margin: 0.4rem 0 0; font-size: 0.79rem; color: var(--ink-soft); }\n\n/* ---------- settings page ---------- */\n\n.symptom {\n  border-radius: 12px; padding: 0.6rem 0.75rem; margin-block-end: 0.6rem;\n  background-color: var(--pink-light);\n  border-inline-start: 6px solid var(--pink);\n}\n\n.symptom.good { background-color: var(--green-light); border-inline-start-color: var(--green); }\n.symptom-line { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; color: var(--pink-dark); }\n.symptom.good .symptom-line { color: var(--green-dark); }\n.symptom-hint { margin: 0.25rem 0 0; font-size: 0.83rem; color: var(--pink-dark); }\n\n.settings-note { margin: 0 0 0.7rem; font-size: 0.81rem; color: var(--ink-soft); }\n\n.groups { display: grid; gap: 0.85rem; }\n\n.group-head {\n  display: flex; align-items: center; gap: 0.5rem;\n  margin-block-end: 0.4rem;\n  padding-block-end: 0.35rem;\n  border-block-end: 3px solid var(--fam-dark);\n}\n\n.group-icon {\n  flex: 0 0 auto; width: 30px; height: 30px; border-radius: 9px;\n  background-color: var(--fam-dark); color: #FFFFFF;\n  display: flex; align-items: center; justify-content: center;\n}\n\n.group-icon svg { width: 19px; height: 19px; fill: currentColor; }\n.group-name { margin: 0; font-size: 1.02rem; color: var(--fam-dark); }\n\n.fam-scene   { --fam: #4C42CF; --fam-dark: #1F1976; --fam-light: #E4E2F8; }\n.fam-system  { --fam: #E11970; --fam-dark: #7D0C3D; --fam-light: #FBDAE8; }\n.fam-gpu     { --fam: #34BD43; --fam-dark: #003F25; --fam-light: #CCF1D0; }\n.fam-render  { --fam: #0099F3; --fam-dark: #06338D; --fam-light: #D5EFFF; }\n.fam-storage { --fam: #0099F3; --fam-dark: #06338D; --fam-light: #D5EFFF; }\n.fam-network { --fam: #F46800; --fam-dark: #611D00; --fam-light: #FFE3CE; }\n.fam-display { --fam: #4C42CF; --fam-dark: #1F1976; --fam-light: #E4E2F8; }\n\n.srow {\n  border: 2px solid var(--line); border-radius: 12px;\n  margin-block-end: 0.35rem; background-color: #FFFFFF;\n}\n\n.srow[open] { border-color: var(--fam); box-shadow: var(--lift); }\n\n.srow-summary {\n  display: flex; align-items: center; gap: 0.5rem;\n  padding: 0.5rem 0.65rem; cursor: pointer; min-height: 44px;\n  list-style: none;\n}\n\n.srow-summary::-webkit-details-marker { display: none; }\n.srow-name { font-family: var(--font-display); font-weight: 700; font-size: 0.88rem; color: var(--ink); }\n\n.srow-value {\n  margin-inline-start: auto; font-size: 0.78rem; font-weight: 600; color: var(--ink-soft);\n  padding: 0.14rem 0.5rem; border-radius: 999px; background-color: var(--tint);\n  border: 1px solid var(--line);\n}\n\n.srow-chevron {\n  flex: 0 0 auto; width: 24px; height: 24px; border-radius: 7px;\n  display: flex; align-items: center; justify-content: center;\n  background-color: var(--fam-light); color: var(--fam-dark);\n  transition: transform 140ms ease-out;\n}\n\n.srow-chevron svg { width: 15px; height: 15px; fill: currentColor; }\n.srow[open] .srow-chevron { background-color: var(--fam-dark); color: #FFFFFF; transform: rotate(180deg); }\n.srow-body { padding: 0 0.65rem 0.7rem; }\n.srow-why { margin: 0 0 0.5rem; font-size: 0.82rem; color: var(--ink-soft); }\n\n.options { display: grid; gap: 0.4rem; grid-template-columns: 1fr; }\n\n@media (min-width: 32rem) { .options { grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); } }\n\n.option {\n  display: flex; flex-direction: column; gap: 0.18rem;\n  text-align: start; font: inherit; color: var(--ink);\n  min-height: 44px; padding: 0.5rem 0.65rem;\n  border-radius: 11px; border: 2px solid var(--line);\n  background-color: #FFFFFF; cursor: pointer;\n  transition: transform 120ms ease-out;\n}\n\n.option:active { transform: translateY(1px); }\n.option-label { font-family: var(--font-display); font-weight: 700; font-size: 0.87rem; color: var(--purple-dark); }\n.option-note { font-size: 0.76rem; color: var(--ink-soft); line-height: 1.32; }\n\n.option[aria-pressed=\"true\"] { background-color: var(--purple); border-color: var(--purple-dark); }\n.option[aria-pressed=\"true\"] .option-label { color: #FFFFFF; }\n.option[aria-pressed=\"true\"] .option-note { color: var(--purple-light); }\n\n/* ---------- buttons ---------- */\n\n.actions { display: flex; flex-wrap: wrap; gap: 0.45rem; }\n\n.btn {\n  font-family: var(--font-display); font-weight: 700; font-size: 0.87rem;\n  min-height: 44px; padding: 0.5rem 0.9rem;\n  border-radius: 11px; border: 2px solid transparent; cursor: pointer;\n  text-align: start;\n  transition: transform 120ms ease-out;\n}\n\n.btn:active { transform: translateY(1px); }\n.btn-lg { font-size: 0.93rem; min-height: 48px; padding: 0.6rem 1.05rem; }\n.btn-go { background-color: var(--purple); color: #FFFFFF; border-color: var(--purple-dark); box-shadow: var(--lift); }\n.btn-alt { background-color: #FFFFFF; color: var(--purple-dark); border-color: var(--purple); }\n.btn-warn { background-color: var(--orange-light); color: var(--orange-dark); border-color: var(--orange); }\n.btn:disabled { cursor: not-allowed; background-color: #EDECF3; color: #56545F; border-color: var(--line); box-shadow: none; }\n\n@media (prefers-reduced-motion: reduce) {\n  .procbar-fill, .gauge-fill, .player, .option, .btn, .srow-chevron { transition: none; }\n  .player:active, .option:active, .btn:active { transform: none; }\n}\n\n/* ---------- report ---------- */\n\n.report-list { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.35rem; }\n\n.report-list li {\n  display: flex; flex-wrap: wrap; gap: 0.2rem 0.7rem;\n  justify-content: space-between; align-items: baseline;\n  border-radius: 11px; padding: 0.5rem 0.75rem;\n  border: 2px solid var(--line); font-size: 0.89rem;\n}\n\n.report-list li.met { background-color: var(--green-light); border-color: var(--green); }\n.report-list li.unmet { background-color: var(--pink-light); border-color: var(--pink); }\n\n.rep-name { font-weight: 600; }\n.rep-val { font-family: var(--font-display); font-weight: 700; }\nli.met .rep-val { color: var(--green-dark); }\nli.unmet .rep-val { color: var(--pink-dark); }\n\n.cat-processor { --fam: #4C42CF; --fam-dark: #1F1976; --fam-light: #E4E2F8; }\n.cat-gpu       { --fam: #34BD43; --fam-dark: #003F25; --fam-light: #CCF1D0; }\n.cat-storage   { --fam: #0099F3; --fam-dark: #06338D; --fam-light: #D5EFFF; }\n.cat-network   { --fam: #F46800; --fam-dark: #611D00; --fam-light: #FFE3CE; }\n.cat-memory    { --fam: #E11970; --fam-dark: #7D0C3D; --fam-light: #FBDAE8; }\n.cat-settings  { --fam: #4C42CF; --fam-dark: #1F1976; --fam-light: #E4E2F8; }\n\n.tally {\n  display: grid; gap: 0.45rem;\n  grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));\n  margin-block-end: 0.9rem;\n}\n\n.tally-card {\n  border-radius: 12px; overflow: hidden;\n  border: 2px solid var(--fam-light);\n  background-color: #FFFFFF;\n}\n\n.tally-card.is-top { border-color: var(--fam-dark); box-shadow: var(--lift); }\n\n.tally-head {\n  display: flex; align-items: center; gap: 0.4rem;\n  padding: 0.35rem 0.5rem;\n  background-color: var(--fam-dark);\n}\n\n.tally-dot {\n  width: 24px; height: 24px; flex: 0 0 auto; border-radius: 7px;\n  background-color: #FFFFFF; color: var(--fam-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.tally-dot svg { width: 16px; height: 16px; fill: currentColor; }\n.tally-name { font-family: var(--font-display); font-weight: 700; font-size: 0.8rem; color: #FFFFFF; }\n.tally-body { padding: 0.45rem 0.6rem 0.55rem; }\n.tally-val { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; color: var(--fam-dark); margin: 0; }\n.tally-sub { font-size: 0.73rem; color: var(--ink-soft); margin: 0; }\n\n.tally-flag {\n  display: inline-block; margin: 0.3rem 0 0;\n  font-size: 0.66rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase;\n  color: var(--fam-dark); background-color: var(--fam-light);\n  padding: 0.16rem 0.5rem; border-radius: 999px;\n}\n\n.report-notes { display: grid; gap: 0.35rem; margin-block-end: 1rem; }\n\n.report-note {\n  background-color: var(--orange-light);\n  border-inline-start: 6px solid var(--orange);\n  border-radius: 11px; padding: 0.55rem 0.75rem;\n  color: var(--orange-dark); font-size: 0.87rem; margin: 0;\n}\n\n.questions { padding-inline-start: 1.2rem; margin: 0 0 1rem; font-size: 0.89rem; }\n.questions li { margin-block-end: 0.4rem; }\n\n/* ---------- confirmation sheet ---------- */\n\n.sheet {\n  position: absolute; inset: 0; z-index: 10;\n  display: flex; align-items: center; justify-content: center;\n  padding: 1rem;\n  background-color: rgba(31, 25, 118, 0.55);\n}\n\n.sheet-card {\n  width: 100%; max-width: 22rem;\n  border-radius: 16px; padding: 1rem;\n  background-color: #FFFFFF;\n  border: 3px solid var(--purple-dark);\n  box-shadow: var(--lift-lg);\n}\n\n.sheet-title {\n  font-size: 1.15rem; line-height: 1.05;\n  color: var(--purple-dark); margin-block-end: 0.45rem;\n}\n\n.sheet-body { margin: 0 0 0.8rem; font-size: 0.88rem; color: var(--ink-soft); }\n\n/* ---------- tab bar ---------- */\n\n.tabbar {\n  display: flex; flex: 0 0 auto;\n  border-block-start: 2px solid var(--purple-light);\n  background-color: var(--tint);\n}\n\n.tab {\n  position: relative;\n  flex: 1 1 0;\n  display: flex; align-items: center; justify-content: center; gap: 0.45rem;\n  font-family: var(--font-display); font-weight: 700; font-size: 0.88rem;\n  min-height: 50px; padding: 0.35rem;\n  border: none; border-block-start: 4px solid transparent;\n  background-color: transparent; color: var(--ink-soft); cursor: pointer;\n}\n\n.tab[aria-current=\"page\"] { color: #FFFFFF; border-block-start-color: var(--purple-dark); background-color: var(--purple); }\n.tab-icon { display: flex; }\n.tab-icon svg { width: 21px; height: 21px; fill: currentColor; }\n\n.tab-dot {\n  width: 11px; height: 11px; border-radius: 50%;\n  background-color: var(--pink);\n  border: 2px solid #FFFFFF;\n}\n\n.tab[aria-current=\"page\"] .tab-dot { border-color: var(--purple); }\n\n/* ---------- focus ---------- */\n\n.btn:focus-visible,\n.option:focus-visible,\n.player:focus-visible,\n.tab:focus-visible,\n.reset:focus-visible,\n.srow-summary:focus-visible {\n  outline: 3px solid var(--orange);\n  outline-offset: 2px;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const DAY_START = 840;\nconst DAY_END = 1080;\nconst DISK_CAP = 100;\n\nconst RAM_BASE = 20;\nconst SCENE_RAM = { full: 55, proxy: 18 };\nconst SHOT_RAM = 20;\nconst SWAP_DISK_PER_PERCENT = 0.6;\nconst SWAP_TIME_PER_PERCENT = 0.02;\nconst VIEWPORT_PENALTY = 0.25;\nconst BACKGROUND_PENALTY = 0.3;\n\nconst IDLE_TEMP = 42;\nconst CRASH_TEMP = 98;\nconst HOT_WARN = 78;\nconst COOL_PER_TASK = 3;\nconst COOL_MINUTES = 10;\nconst COOL_DROP = 15;\nconst RENDER_HEAT = { open: 26, capped: 14 };\nconst CAPPED_RENDER_TIME = 1.5;\n\nconst CLEAN_MINUTES = 12;\nconst SAVE_MINUTES = 2;\nconst UNLOAD_MINUTES = 2;\nconst AUTOSAVE_MINUTES = 1;\nconst PROXY_BUILD_MINUTES = 15;\nconst DRIVER_ROLLBACK_MINUTES = 20;\nconst CRASH_MINUTES = 15;\nconst ARCHIVE_MINUTES = 4;\nconst OLD_VERSION_UNITS = 30;\nconst CACHE_UNITS = 5;\nconst PUBLISH_MINUTES_PER_UNIT = 0.8;\nconst PUBLISH_MINUTES_PER_SHOT = 1;\nconst REAL_SETTING_MINUTES = 2;\nconst IDLE_SETTING_MINUTES = 1;\nconst USEFUL_RENDER_SCORE = 50;\nconst HINT_AFTER_TRIES = 1;\n\nconst QUALITY = {\n  full: { units: 22, detail: 100, minutes: 9, word: 'Full' },\n  draft: { units: 8, detail: 75, minutes: 6, word: 'Draft' },\n  blocking: { units: 3, detail: 35, minutes: 4, word: 'Blocking' }\n};\n\nconst GROUPS = [\n  { id: 'scene', name: 'Scene', icon: 'g-scene' },\n  { id: 'system', name: 'System', icon: 'g-system' },\n  { id: 'gpu', name: 'Graphics card', icon: 'g-gpu' },\n  { id: 'render', name: 'Render', icon: 'g-render' },\n  { id: 'storage', name: 'Storage', icon: 'g-storage' },\n  { id: 'network', name: 'Network', icon: 'g-network' },\n  { id: 'display', name: 'Display', icon: 'g-display' }\n];\n\n/* real: changing it moves time, heat, disk or memory.\n   Everything else is here because a real settings screen has things in it\n   that look promising and do nothing. */\nconst SETTINGS = [\n  {\n    id: 'viewport', group: 'scene', real: true, start: 'full',\n    name: 'Detail in the work window',\n    why: 'How much detail the computer keeps loaded in the window Marcus works in. The finished pictures always use the full detail either way.',\n    options: [\n      { value: 'full', label: 'Full detail', note: 'Holds 55% of the memory before a single shot is open, and makes every task 25% slower.' },\n      { value: 'proxy', label: 'Simple stand-in shapes', note: 'Takes 15 minutes to build the simple shapes once. After that it only holds 18% of the memory.' }\n    ]\n  },\n  {\n    id: 'unload', group: 'scene', real: true, start: 'keep',\n    name: 'Shots after they are saved',\n    why: 'Each open shot holds 20% of the memory. When memory runs out the machine starts using the hard drive instead, which is far slower.',\n    options: [\n      { value: 'keep', label: 'Leave them open', note: 'Nothing is released until the app closes.' },\n      { value: 'auto', label: 'Close them automatically', note: 'Costs 2 minutes per shot and gives the memory back.' }\n    ]\n  },\n  {\n    id: 'ghosting', group: 'scene', real: false, start: 'on',\n    name: 'Show the frames around this one',\n    why: 'Draws faded copies of the previous and next frames behind the current one.',\n    options: [\n      { value: 'on', label: 'On', note: 'Shows the frames on either side.' },\n      { value: 'off', label: 'Off', note: 'Shows only the current frame.' }\n    ]\n  },\n  {\n    id: 'driver', group: 'system', real: true, start: 'current',\n    name: 'Graphics card software',\n    why: 'This software was updated right after the card overheated last month, and nobody has tested anything against it since.',\n    options: [\n      { value: 'current', label: 'Keep the new version', note: 'Costs nothing right now.' },\n      { value: 'rollback', label: 'Go back to the older version', note: 'Takes 20 minutes to switch back and restart the computer. The restart also clears the memory and cools the card down.' }\n    ]\n  },\n  {\n    id: 'autosave', group: 'system', real: true, start: 'off',\n    name: 'Autosave',\n    why: 'Keeps a spare copy of the work as Marcus goes. It is stored separately from the real file, so a bad save cannot hurt it.',\n    options: [\n      { value: 'off', label: 'Off', note: 'Costs nothing. If the machine goes down, unsaved renders are gone.' },\n      { value: 'on', label: 'On', note: 'Adds 1 minute to every task. If the machine goes down, nothing is lost.' }\n    ]\n  },\n  {\n    id: 'power', group: 'gpu', real: true, start: 'open',\n    name: 'How hard the card works',\n    why: 'How hard the card is allowed to push. Heat is what took this machine down last month.',\n    options: [\n      { value: 'open', label: 'Full speed', note: 'Renders run as fast as the card can go and add 26 degrees each.' },\n      { value: 'capped', label: 'Hold it back', note: 'Renders take 50% longer and add 14 degrees each.' }\n    ]\n  },\n  {\n    id: 'fanProfile', group: 'gpu', real: false, start: 'quiet',\n    name: 'Fan speed',\n    why: 'How loud the fans are allowed to get. The replacement fan already runs at its maximum under load.',\n    options: [\n      { value: 'quiet', label: 'Quiet', note: 'Ramps up gradually.' },\n      { value: 'loud', label: 'Aggressive', note: 'Ramps up immediately.' }\n    ]\n  },\n  {\n    id: 'overlay', group: 'gpu', real: false, start: 'off',\n    name: 'Numbers in the corner',\n    why: 'Shows the temperature and the speed in the corner of the work window.',\n    options: [\n      { value: 'off', label: 'Off', note: 'Nothing in the corner.' },\n      { value: 'on', label: 'On', note: 'Shows the numbers while you work.' }\n    ]\n  },\n  {\n    id: 'quality', group: 'render', real: true, start: 'full',\n    name: 'Render quality',\n    why: 'How finished each preview looks. Detail is what fills the disk and what makes sending the reel slow.',\n    options: [\n      { value: 'full', label: 'Full', note: 'Takes 9 minutes and 22% of the disk per shot. The director can judge anything from it, rated 100 out of 100.' },\n      { value: 'draft', label: 'Draft', note: 'Takes 6 minutes and 8% of the disk. Rated 75 out of 100.' },\n      { value: 'blocking', label: 'Rough', note: 'Takes 4 minutes and 3% of the disk. Plain gray shapes only, rated 35 out of 100.' }\n    ]\n  },\n  {\n    id: 'denoise', group: 'render', real: false, start: 'on',\n    name: 'Smooth out the speckles',\n    why: 'Cleans the speckles out of a finished picture. It happens inside the render time either way.',\n    options: [\n      { value: 'on', label: 'On', note: 'Cleans up the speckles.' },\n      { value: 'off', label: 'Off', note: 'Leaves them in.' }\n    ]\n  },\n  {\n    id: 'safeFrame', group: 'render', real: false, start: 'on',\n    name: 'Edge guides',\n    why: 'Draws boxes over the work window showing what will still be on screen in a theater. They are not saved into the picture.',\n    options: [\n      { value: 'on', label: 'On', note: 'Shows the guides.' },\n      { value: 'off', label: 'Off', note: 'Hides the guides.' }\n    ]\n  },\n  {\n    id: 'archive', group: 'storage', real: true, start: 'local',\n    name: 'Last week\\u2019s versions',\n    why: 'Every version Marcus saved last week is still sitting on this disk taking up room that today needs.',\n    options: [\n      { value: 'local', label: 'Keep them here', note: 'Holds 30% of the disk. He can pull up last week\\u2019s version without waiting.' },\n      { value: 'server', label: 'Move them to the server', note: 'Frees 30% of the disk. Pulling an old version back takes a request to IT.' }\n    ]\n  },\n  {\n    id: 'cache', group: 'storage', real: true, start: 'kept',\n    name: 'Temporary files',\n    why: 'Scratch files the renderer leaves behind. Clearing them helps a little.',\n    options: [\n      { value: 'kept', label: 'Keep them', note: 'Holds 5% of the disk.' },\n      { value: 'cleared', label: 'Clear them', note: 'Frees 5% of the disk. That is almost a whole rough render.' }\n    ]\n  },\n  {\n    id: 'publish', group: 'network', real: true, start: 'background',\n    name: 'Sending shots to the review',\n    why: 'The computer that holds the review copies is in another building on the lot. Uploading is not free either way, but you get to choose whether it happens while Marcus works or after he is done.',\n    options: [\n      { value: 'background', label: 'Upload in the background', note: 'Each shot goes up as soon as it is saved. The upload has to share the computer, so every task runs 30% slower all afternoon.' },\n      { value: 'end', label: 'Upload everything at the end', note: 'Nothing is sharing the computer while he works. The upload costs about 1 minute for every percent of the disk the pictures take up.' }\n    ]\n  },\n  {\n    id: 'checkUpdates', group: 'network', real: false, start: 'on',\n    name: 'Check for software updates',\n    why: 'Looks for a new version of the shot planning software when it opens. It does not download anything without asking.',\n    options: [\n      { value: 'on', label: 'On', note: 'Checks at launch.' },\n      { value: 'off', label: 'Off', note: 'Does not check.' }\n    ]\n  },\n  {\n    id: 'theme', group: 'display', real: false, start: 'dark',\n    name: 'Interface theme',\n    why: 'The color scheme of the panels around the work window.',\n    options: [\n      { value: 'dark', label: 'Dark', note: 'The studio standard.' },\n      { value: 'light', label: 'Light', note: 'Lighter panels.' }\n    ]\n  },\n  {\n    id: 'textSize', group: 'display', real: false, start: 'medium',\n    name: 'Text size',\n    why: 'How big the panel text is. Does not change what the machine has to draw in the work window.',\n    options: [\n      { value: 'small', label: 'Small', note: 'More fits on the screen.' },\n      { value: 'medium', label: 'Medium', note: 'The usual size.' },\n      { value: 'large', label: 'Large', note: 'Fewer words on the screen at once.' }\n    ]\n  }\n];\n\nconst SHOTS = [\n  {\n    id: 's042', name: 'Shot 042', title: 'Rooftop chase', icon: 's-rooftop', image: 'render-068.jpg',\n    alt: 'Rough gray test picture of two figures running across a rooftop toward a gap between buildings.',\n    note: 'The director wants to know if the jump looks right from a low camera.',\n    issues: [\n      'Two of the trackers on the actor cut out mid-jump, so the gap got filled in by hand.',\n      'The left foot slides about four inches on the landing.',\n      'The camera move runs a little longer than the edit has room for.'\n    ]\n  },\n  {\n    id: 's068', name: 'Shot 068', title: 'Car flip', icon: 's-car', image: 'render-091.jpg',\n    alt: 'Rough gray test picture of a car flipping above a street, with debris around it.',\n    note: 'The stunt team needs to know how much room the flip actually takes.',\n    issues: [\n      'The car data jumps to a strange value at the exact moment of impact.',\n      'The car leaves the picture two feet earlier than the storyboard shows.',\n      'The flying debris is still borrowed from the last movie.'\n    ]\n  },\n  {\n    id: 's091', name: 'Shot 091', title: 'Creature reveal', icon: 's-creature', image: 'render-114.jpg',\n    alt: 'Rough gray test picture of a large creature stepping out of shadow toward the camera.',\n    note: 'The creature team wants to see the outline before they build the real one.',\n    issues: [\n      'The actor is wearing more trackers than the creature model can use.',\n      'The head turn looks too fast once it plays at normal speed.',\n      'The creature shows up a beat later than the music says it should.'\n    ]\n  },\n  {\n    id: 's114', name: 'Shot 114', title: 'Crowd plaza', icon: 's-crowd', image: 'render-042.jpg',\n    alt: 'Rough gray test picture of a wide plaza filled with simple crowd figures walking in several directions.',\n    note: 'The director wants to see whether the plaza feels full enough.',\n    issues: [\n      'Forty of the crowd figures are walking straight through each other.',\n      'The camera tracking slips in the last second of the shot.',\n      'The hero actor crosses in front of camera at the wrong moment.'\n    ]\n  }\n];\n\nconst PROBLEMS = [\n  {\n    id: 'heavy', setting: 'viewport', group: 'scene', blocks: 'clean',\n    title: 'The work window is dragging the whole computer',\n    voice: 'I can barely move the camera around. Every click just sits there.',\n    symptom: 'Right now the work window is holding the full-detail scene in memory.',\n    fixed: 'The work window moves again.',\n    fires: function () { return true; },\n    ready: function () { return state.settings.viewport === 'proxy'; }\n  },\n  {\n    id: 'corrupt', setting: 'driver', group: 'system', blocks: 'save',\n    title: 'Saving it destroyed the picture',\n    voice: 'I hit save, and the picture it just spent all that time making came back empty.',\n    symptom: 'Right now, saving a shot destroys the picture the computer just finished making.',\n    fixed: 'Saving works properly again.',\n    fires: function () { return state.redone >= 1; },\n    ready: function () { return state.settings.driver === 'rollback'; }\n  },\n  {\n    id: 'full', setting: 'archive', group: 'storage', blocks: 'render',\n    title: 'The render will not write',\n    voice: 'Disk is full and I still have shots to render.',\n    symptom: 'Right now there is no room on the disk for another render.',\n    fixed: 'There is room again.',\n    fires: function () { return !renderFits() && needsRender() > 0; },\n    ready: function () { return renderFits(); }\n  },\n  {\n    id: 'swap', setting: 'unload', group: 'scene', blocks: null,\n    title: 'The computer ran out of memory',\n    voice: 'Memory is full, so it started using the hard drive instead, and you can feel it on every click.',\n    symptom: 'Right now the machine is out of memory and using the disk instead.',\n    fixed: 'It is back inside its memory again.',\n    fires: function () { return swapOver() > 0; },\n    ready: function () { return swapOver() === 0; }\n  },\n  {\n    id: 'hot', setting: 'power', group: 'gpu', blocks: null,\n    title: 'The card is running hot',\n    voice: 'Seventy-eight and climbing. This is exactly how it went down last month.',\n    symptom: 'Right now the graphics card is close to the temperature that takes it down.',\n    fixed: 'The card has room to breathe now.',\n    fires: function () { return state.temp >= HOT_WARN && tasksLeft() > 0; },\n    ready: function () { return state.settings.power === 'capped'; }\n  },\n  {\n    id: 'huge', setting: 'quality', group: 'render', blocks: null,\n    title: 'One render took a fifth of the disk',\n    voice: 'That frame looks incredible and it is enormous.',\n    symptom: 'Right now every render is going out at full quality.',\n    fixed: 'The next renders will use less room.',\n    fires: function () { return rendersDone() >= 1 && state.settings.quality === 'full'; },\n    ready: function () { return state.settings.quality !== 'full'; }\n  }\n];\n\nconst GOALS = [\n  'All four shots make it to the 6:00 PM review.',\n  'Marcus is done before 6:00 PM.',\n  'The workstation never goes down.',\n  'Every shot gets a render.',\n  'The renders are sharp enough for the director to judge.',\n  'No render has to be thrown out and done over.',\n  'The machine never has to swap to disk.'\n];\n\nconst QUESTIONS = [\n  'Switching the work window to simple shapes cost 15 minutes up front and gave time back on every task after that. How would you decide whether a fix like that is worth paying for?',\n  'When memory ran out, the machine kept working by using the disk instead. Why did that make everything slower rather than simply stopping?',\n  'Holding the graphics card back made every render take longer. Explain why that was still the faster way through the afternoon.',\n  'The overheating was repaired weeks ago. Why was the software still destroying work, and what did that cost before you caught it?',\n  'Uploading in the background and uploading at the end move the same footage. Which one is better depends on another setting entirely. Which one, and why?',\n  'Troubleshooting means fixing something that is not working. Optimization means making something run better even when it works. Name one of each from this afternoon.'\n];\n\nconst nf = new Intl.NumberFormat();\nconst pf = new Intl.NumberFormat(undefined, { style: 'percent', maximumFractionDigits: 0 });\nconst df = new Intl.NumberFormat(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 });\nconst tf = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });\n\nlet state;\nlet busy = false;\nlet renderedView = null;\nlet viewJustChanged = false;\nconst els = {};\n\n/* ================= state ================= */\n\nfunction freshState() {\n  const settings = {};\n  SETTINGS.forEach(function (s) { settings[s.id] = s.start; });\n  return {\n    view: 'brief',\n    settings: settings,\n    selected: null,\n    shots: SHOTS.map(function (s) {\n      return { id: s.id, cleaned: false, render: null, saved: false, published: false, loaded: false };\n    }),\n    problem: null,\n    seen: {},\n    wrongTries: 0,\n    justFixed: null,\n    clock: DAY_START,\n    temp: IDLE_TEMP,\n    renderUnits: 0,\n    redone: 0,\n    crashes: 0,\n    lostRenders: 0,\n    log: [],\n    over: false,\n    endReason: null,\n    missedHistory: false\n  };\n}\n\nfunction shotDef(id) { for (let i = 0; i < SHOTS.length; i++) if (SHOTS[i].id === id) return SHOTS[i]; return null; }\nfunction shotState(id) { for (let i = 0; i < state.shots.length; i++) if (state.shots[i].id === id) return state.shots[i]; return null; }\nfunction settingById(id) { for (let i = 0; i < SETTINGS.length; i++) if (SETTINGS[i].id === id) return SETTINGS[i]; return null; }\nfunction groupById(id) { for (let i = 0; i < GROUPS.length; i++) if (GROUPS[i].id === id) return GROUPS[i]; return GROUPS[0]; }\nfunction problemById(id) { for (let i = 0; i < PROBLEMS.length; i++) if (PROBLEMS[i].id === id) return PROBLEMS[i]; return null; }\n\nfunction loadedShots() { return state.shots.filter(function (s) { return s.loaded; }).length; }\nfunction rendersDone() { return state.shots.filter(function (s) { return s.render !== null; }).length; }\nfunction needsRender() { return state.shots.filter(function (s) { return s.cleaned && s.render === null; }).length; }\n\nfunction tasksLeft() {\n  let n = 0;\n  state.shots.forEach(function (s) {\n    if (!s.cleaned) n += 1;\n    if (s.render === null) n += 1;\n    if (!s.saved) n += 1;\n  });\n  return n;\n}\n\n/* Memory is the pressure point on this machine. Anything past full spills onto\n   the disk as swap, which costs both room and speed. */\nfunction ramUsed() { return RAM_BASE + SCENE_RAM[state.settings.viewport] + loadedShots() * SHOT_RAM; }\nfunction swapOver() { return Math.max(0, ramUsed() - 100); }\nfunction swapDiskUnits() { return Math.round(swapOver() * SWAP_DISK_PER_PERCENT); }\n\nfunction oldVersionUnits() { return state.settings.archive === 'server' ? 0 : OLD_VERSION_UNITS; }\nfunction cacheUnits() { return state.settings.cache === 'cleared' ? 0 : CACHE_UNITS; }\n\nfunction diskUsed() {\n  return Math.min(oldVersionUnits() + cacheUnits() + state.renderUnits + swapDiskUnits(), DISK_CAP);\n}\n\nfunction diskFree() { return Math.max(0, DISK_CAP - diskUsed()); }\nfunction renderFits() { return diskUsed() + QUALITY[state.settings.quality].units <= DISK_CAP; }\n\nfunction viewportMultiplier() { return state.settings.viewport === 'full' ? 1 + VIEWPORT_PENALTY : 1; }\nfunction swapMultiplier() { return 1 + swapOver() * SWAP_TIME_PER_PERCENT; }\nfunction backgroundMultiplier() { return state.settings.publish === 'background' ? 1 + BACKGROUND_PENALTY : 1; }\nfunction timeMultiplier() { return viewportMultiplier() * swapMultiplier() * backgroundMultiplier(); }\n\nfunction renderDetailAverage() {\n  const done = state.shots.filter(function (s) { return s.render !== null; });\n  if (done.length === 0) return 0;\n  let total = 0;\n  done.forEach(function (s) { total += QUALITY[s.render].detail; });\n  return Math.round(total / done.length);\n}\n\nfunction pendingUploads() {\n  return state.shots.filter(function (s) { return s.saved && !s.published; });\n}\n\nfunction uploadCost(shots) {\n  let units = 0;\n  shots.forEach(function (s) { if (s.render) units += QUALITY[s.render].units; });\n  return Math.round(units * PUBLISH_MINUTES_PER_UNIT + shots.length * PUBLISH_MINUTES_PER_SHOT);\n}\n\n/* ================= costs ================= */\n\nfunction spend(minutes, cat, text, menu) {\n  const m = Math.round(minutes);\n  state.clock += m;\n  state.log.push({ text: text, cat: cat, minutes: m, menu: !!menu });\n  return m;\n}\n\n/* Charges the task to the part doing the work, then bills each slowdown to\n   whatever actually caused it, so the report can name a culprit. */\nfunction runTask(baseMinutes, cat, text) {\n  const vp = viewportMultiplier();\n  const sw = swapMultiplier();\n  const bg = backgroundMultiplier();\n  const total = Math.round(baseMinutes * vp * sw * bg);\n\n  let vpShare = Math.round(baseMinutes * (vp - 1));\n  let swShare = Math.round(baseMinutes * vp * (sw - 1));\n  let bgShare = Math.round(baseMinutes * vp * sw * (bg - 1));\n  if (vpShare < 2) vpShare = 0;\n  if (swShare < 2) swShare = 0;\n  if (bgShare < 2) bgShare = 0;\n\n  const own = Math.max(0, total - vpShare - swShare - bgShare);\n  spend(own, cat, text);\n\n  if (vpShare > 0) spend(vpShare, 'gpu', `The full-detail work window added ${nf.format(vpShare)} minutes to that.`);\n  if (swShare > 0) spend(swShare, 'memory', `Being out of memory added ${nf.format(swShare)} minutes to that.`);\n  if (bgShare > 0) spend(bgShare, 'network', `The background upload added ${nf.format(bgShare)} minutes to that.`);\n}\n\nfunction cool() { state.temp = Math.max(IDLE_TEMP, state.temp - COOL_PER_TASK); }\n\nfunction heat() {\n  state.temp += RENDER_HEAT[state.settings.power];\n  if (state.temp >= CRASH_TEMP) crash();\n}\n\n/* The card goes down the way it went down last month. Everything rendered but\n   not yet saved is gone unless the recovery autosave was running. */\nfunction crash() {\n  state.crashes += 1;\n  const unsaved = state.shots.filter(function (s) { return s.render !== null && !s.saved; });\n  let lost = 0;\n  if (state.settings.autosave === 'off') {\n    unsaved.forEach(function (s) {\n      state.renderUnits -= QUALITY[s.render].units;\n      s.render = null;\n      lost += 1;\n    });\n    state.lostRenders += lost;\n  }\n  state.shots.forEach(function (s) { s.loaded = false; });\n  state.temp = IDLE_TEMP;\n  spend(CRASH_MINUTES, 'gpu', lost > 0\n    ? `The workstation went down at ${nf.format(CRASH_TEMP)} degrees. ${nf.format(lost)} unsaved renders were lost and the reboot cost ${nf.format(CRASH_MINUTES)} minutes.`\n    : `The workstation went down at ${nf.format(CRASH_TEMP)} degrees. The recovery file had everything, and the reboot cost ${nf.format(CRASH_MINUTES)} minutes.`);\n}\n\nfunction autosaveTick() {\n  if (state.settings.autosave !== 'on') return;\n  spend(AUTOSAVE_MINUTES, 'storage', 'Wrote a recovery file.');\n}\n\nfunction checkOver() {\n  if (state.over) return true;\n  if (state.clock >= DAY_END) { state.over = true; state.endReason = 'clock'; return true; }\n  return false;\n}\n\n/* ================= problems ================= */\n\nfunction syncProblem() {\n  if (state.problem) {\n    const active = problemById(state.problem);\n    if (active.ready()) {\n      state.justFixed = active.fixed;\n      state.problem = null;\n      state.wrongTries = 0;\n    } else if (!active.fires()) {\n      /* The situation went away without the setting changing, for example a\n         crash cleared memory on its own. Drop it and look for whatever is next. */\n      state.problem = null;\n      state.wrongTries = 0;\n    } else {\n      return;\n    }\n  }\n  for (let i = 0; i < PROBLEMS.length; i++) {\n    const p = PROBLEMS[i];\n    if (state.seen[p.id]) continue;\n    if (p.ready()) continue;\n    if (!p.fires()) continue;\n    state.problem = p.id;\n    state.seen[p.id] = true;\n    state.wrongTries = 0;\n    return;\n  }\n}\n\nfunction blockedAction(kind) {\n  if (!state.problem) return false;\n  return problemById(state.problem).blocks === kind;\n}\n\nfunction dismissBanner() {\n  if (!state.problem) return;\n  state.seen[state.problem] = true;\n  state.problem = null;\n  render();\n}\n\n/* ================= actions ================= */\n\nfunction doClean(id) {\n  const s = shotState(id);\n  s.cleaned = true;\n  s.loaded = true;\n  runTask(CLEAN_MINUTES, 'processor', `Cleaned up the motion data on ${shotDef(id).name}.`);\n  cool();\n  autosaveTick();\n}\n\nfunction doRender(id) {\n  const s = shotState(id);\n  const q = QUALITY[state.settings.quality];\n  s.render = state.settings.quality;\n  s.loaded = true;\n  state.renderUnits += q.units;\n  const capped = state.settings.power === 'capped';\n  runTask(q.minutes * (capped ? CAPPED_RENDER_TIME : 1), 'gpu',\n    `Rendered ${shotDef(id).name} at ${q.word} quality, using ${pf.format(q.units / 100)} of the disk.`);\n  autosaveTick();\n  heat();\n}\n\nfunction doSave(id) {\n  const s = shotState(id);\n  const def = shotDef(id);\n\n  if (state.settings.driver === 'current') {\n    state.renderUnits -= QUALITY[s.render].units;\n    s.render = null;\n    state.redone += 1;\n    runTask(SAVE_MINUTES, 'processor',\n      `Saved ${def.name}. The save destroyed the picture along with it, so the whole render has to be done again.`);\n    cool();\n    autosaveTick();\n    return;\n  }\n\n  s.saved = true;\n  runTask(SAVE_MINUTES, 'processor', `Saved ${def.name}.`);\n  cool();\n\n  if (state.settings.publish === 'background') {\n    s.published = true;\n    spend(0, 'network', `${def.name} started uploading in the background.`);\n  }\n  if (state.settings.unload === 'auto') {\n    s.loaded = false;\n    spend(UNLOAD_MINUTES, 'memory', `Closed ${def.name} and gave the memory back.`);\n  }\n  autosaveTick();\n}\n\nfunction doUnloadAll() {\n  const open = state.shots.filter(function (s) { return s.saved && s.loaded; });\n  if (open.length === 0) return;\n  open.forEach(function (s) { s.loaded = false; });\n  spend(UNLOAD_MINUTES * open.length, 'memory', `Closed ${nf.format(open.length)} saved shots and gave the memory back.`);\n}\n\nfunction doCool() {\n  spend(COOL_MINUTES, 'gpu', 'Stepped away and let the card cool down.');\n  state.temp = Math.max(IDLE_TEMP, state.temp - COOL_DROP);\n}\n\nfunction doFinish() {\n  const pending = pendingUploads();\n  if (state.settings.publish === 'end' && pending.length > 0) {\n    const minutes = uploadCost(pending);\n    pending.forEach(function (s) { s.published = true; });\n    spend(minutes, 'network', `Uploaded everything to the review in one batch, ${nf.format(pending.length)} shots.`);\n  }\n  state.over = true;\n  if (!state.endReason) state.endReason = state.clock >= DAY_END ? 'clock' : 'finished';\n}\n\nfunction changeSetting(id, value) {\n  if (busy || state.over) return;\n  if (state.settings[id] === value) return;\n\n  const setting = settingById(id);\n  const fromLabel = optionLabel(setting, state.settings[id]);\n  const toLabel = optionLabel(setting, value);\n  state.settings[id] = value;\n  state.justFixed = null;\n\n  if (state.problem && problemById(state.problem).setting !== id) state.wrongTries += 1;\n\n  let minutes = setting.real ? REAL_SETTING_MINUTES : IDLE_SETTING_MINUTES;\n  if (id === 'archive') minutes += ARCHIVE_MINUTES;\n\n  const text = setting.real\n    ? `${setting.name} changed from ${fromLabel} to ${toLabel}.`\n    : `${setting.name} changed from ${fromLabel} to ${toLabel}. Nothing about the afternoon changed.`;\n  spend(minutes, 'settings', text, true);\n\n  if (id === 'archive' && value === 'server') state.missedHistory = true;\n  if (id === 'viewport' && value === 'proxy') {\n    spend(PROXY_BUILD_MINUTES, 'gpu', 'Built the simple stand-in shapes for the whole scene.');\n  }\n  if (id === 'driver' && value === 'rollback') {\n    spend(DRIVER_ROLLBACK_MINUTES, 'gpu',\n      'Switched back to the older graphics card software and restarted. Memory came back clear and the card came back cool.');\n    state.shots.forEach(function (s) { s.loaded = false; });\n    state.temp = IDLE_TEMP;\n  }\n  if (id === 'unload' && value === 'auto') doUnloadAll();\n\n  if (checkOver()) state.view = 'report';\n  syncProblem();\n  render();\n}\n\n/* ================= running an action ================= */\n\nfunction reducedMotion() {\n  return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);\n}\n\nfunction act(fn) {\n  if (busy || state.over) return;\n  const duration = reducedMotion() ? 0 : Math.min(650, Math.round(150 + (timeMultiplier() - 1) * 420));\n  if (duration === 0) { finishAction(fn); return; }\n  busy = true;\n  els.procFill.style.transitionDuration = '0ms';\n  els.procFill.style.width = '0%';\n  window.setTimeout(function () {\n    els.procFill.style.transitionDuration = `${duration}ms`;\n    els.procFill.style.width = '100%';\n  }, 20);\n  window.setTimeout(function () {\n    els.procFill.style.transitionDuration = '0ms';\n    els.procFill.style.width = '0%';\n    busy = false;\n    finishAction(fn);\n  }, duration + 40);\n}\n\nfunction finishAction(fn) {\n  state.justFixed = null;\n  fn();\n  checkOver();\n  syncProblem();\n  if (state.over) state.view = 'report';\n  render();\n  focusMain();\n}\n\n/* ================= small helpers ================= */\n\nfunction clockText(minutes) {\n  const m = typeof minutes === 'number' ? minutes : state.clock;\n  return tf.format(new Date(2026, 0, 1, 0, Math.round(Math.min(m, 24 * 60 - 1))));\n}\n\nfunction optionLabel(setting, value) {\n  for (let i = 0; i < setting.options.length; i++) {\n    if (setting.options[i].value === value) return setting.options[i].label;\n  }\n  return String(value);\n}\n\nfunction speedText() {\n  const m = timeMultiplier();\n  return m <= 1.05 ? 'Full speed' : `${df.format(m)} times slower`;\n}\n\nfunction makeText(tag, className, text) {\n  const el = document.createElement(tag);\n  if (className) el.className = className;\n  if (text !== undefined && text !== null) el.textContent = text;\n  return el;\n}\n\nfunction clearChildren(el) { el.textContent = ''; }\n\nfunction icon(symbolId, className) {\n  const box = document.createElement('span');\n  box.className = className;\n  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');\n  svg.setAttribute('aria-hidden', 'true');\n  svg.setAttribute('focusable', 'false');\n  const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');\n  use.setAttribute('href', `#${symbolId}`);\n  svg.appendChild(use);\n  box.appendChild(svg);\n  return box;\n}\n\nfunction button(label, kind, handler, disabled) {\n  const b = document.createElement('button');\n  b.type = 'button';\n  b.className = `btn ${kind}`;\n  b.textContent = label;\n  b.disabled = !!disabled;\n  b.addEventListener('click', handler);\n  return b;\n}\n\n/* ================= status ================= */\n\nfunction renderStatus() {\n  const disk = diskUsed();\n  const ram = ramUsed();\n  els.clock.textContent = clockText();\n  els.temp.textContent = `${nf.format(Math.round(state.temp))}\\u00B0`;\n  els.ram.textContent = pf.format(ram / 100);\n  els.disk.textContent = pf.format(disk / 100);\n  els.speed.textContent = speedText();\n\n  els.temp.className = 'stat-value' + (state.temp >= HOT_WARN ? ' bad' : state.temp >= 65 ? ' warn' : '');\n  els.ram.className = 'stat-value' + (ram > 100 ? ' bad' : ram >= 90 ? ' warn' : '');\n  els.disk.className = 'stat-value' + (disk >= 90 ? ' bad' : disk >= 75 ? ' warn' : '');\n  els.speed.className = 'stat-value' + (timeMultiplier() > 1.5 ? ' bad' : timeMultiplier() > 1.05 ? ' warn' : '');\n  els.clock.className = 'stat-value' + (state.clock >= DAY_END - 25 ? ' bad' : state.clock >= DAY_END - 55 ? ' warn' : '');\n\n  els.gaugeTemp.style.width = `${Math.max(0, Math.min(100, state.temp))}%`;\n  els.gaugeTemp.className = 'gauge-fill temp' + (state.temp >= HOT_WARN ? ' bad' : state.temp >= 65 ? ' warn' : '');\n  els.gaugeRam.style.width = `${Math.max(0, Math.min(100, ram))}%`;\n  els.gaugeRam.className = 'gauge-fill ram' + (ram > 100 ? ' bad' : ram >= 90 ? ' warn' : '');\n  els.gaugeDisk.style.width = `${Math.max(0, Math.min(100, disk))}%`;\n  els.gaugeDisk.className = 'gauge-fill storage' + (disk >= 90 ? ' bad' : disk >= 75 ? ' warn' : '');\n\n  els.tabDot.hidden = !state.problem;\n}\n\n/* ================= shots view ================= */\n\nfunction renderBanner() {\n  if (!state.problem) {\n    els.banner.hidden = true;\n    clearChildren(els.banner);\n    return;\n  }\n  const p = problemById(state.problem);\n  els.banner.hidden = false;\n  els.banner.className = 'banner' + (p.blocks ? ' hard' : '');\n  clearChildren(els.banner);\n\n  const head = document.createElement('div');\n  head.className = 'banner-head';\n  head.appendChild(icon('a-alert', 'banner-icon'));\n  head.appendChild(makeText('p', 'banner-title', p.title));\n  els.banner.appendChild(head);\n\n  els.banner.appendChild(makeText('p', 'banner-voice', p.voice));\n\n  const row = document.createElement('div');\n  row.className = 'actions';\n  row.appendChild(button('Open Settings', 'btn-go', function () { goTab('settings'); }));\n  if (!p.blocks) row.appendChild(button('Not now', 'btn-alt', dismissBanner));\n  els.banner.appendChild(row);\n}\n\nfunction stepPip(symbol, done) {\n  return icon(symbol, 'pip' + (done ? ' pip-done' : ''));\n}\n\nfunction renderShots() {\n  const done = state.shots.filter(function (s) { return s.saved; }).length;\n  els.shotsChip.textContent = `${nf.format(done)} of ${nf.format(SHOTS.length)} done`;\n  clearChildren(els.shots);\n  SHOTS.forEach(function (shot) {\n    const s = shotState(shot.id);\n    const li = document.createElement('li');\n    const card = document.createElement('button');\n    card.type = 'button';\n    card.className = 'player' + (state.selected === shot.id ? ' picked' : '') + (s.saved ? ' done' : '');\n    card.setAttribute('aria-pressed', state.selected === shot.id ? 'true' : 'false');\n\n    card.appendChild(icon(shot.icon, 'player-icon'));\n    card.appendChild(makeText('span', 'player-name', shot.name));\n\n    const pips = document.createElement('span');\n    pips.className = 'pips';\n    pips.appendChild(stepPip('a-clean', s.cleaned));\n    pips.appendChild(stepPip('a-render', s.render !== null));\n    pips.appendChild(stepPip('a-save', s.saved));\n    card.appendChild(pips);\n\n    const sr = makeText('span', 'sr-only',\n      `${shot.title}. ${s.cleaned ? 'Motion data cleaned' : 'Motion data not cleaned'}. ${s.render !== null ? 'Rendered' : 'Not rendered'}. ${s.saved ? 'Saved' : 'Not saved'}. ${s.loaded ? 'Open in memory.' : ''}`);\n    card.appendChild(sr);\n\n    card.addEventListener('click', function () {\n      state.selected = shot.id;\n      state.justFixed = null;\n      render();\n    });\n    li.appendChild(card);\n    els.shots.appendChild(li);\n  });\n}\n\nfunction renderDetail() {\n  if (!state.selected) {\n    els.detail.hidden = false;\n    clearChildren(els.detail);\n    els.detail.className = 'detail empty';\n    els.detail.appendChild(makeText('p', null, 'Pick a shot to get started.'));\n    return;\n  }\n\n  const shot = shotDef(state.selected);\n  const s = shotState(state.selected);\n  const mult = timeMultiplier();\n\n  els.detail.hidden = false;\n  els.detail.className = 'detail';\n  clearChildren(els.detail);\n\n  const head = document.createElement('div');\n  head.className = 'detail-head';\n  head.appendChild(icon(shot.icon, 'detail-icon'));\n  const idBox = document.createElement('span');\n  idBox.className = 'detail-id';\n  idBox.appendChild(makeText('span', 'detail-name', shot.name));\n  idBox.appendChild(makeText('span', 'detail-kind', shot.title));\n  head.appendChild(idBox);\n  els.detail.appendChild(head);\n\n  const bodyBox = document.createElement('div');\n  bodyBox.className = 'detail-body';\n  els.detail.appendChild(bodyBox);\n\n  bodyBox.appendChild(makeText('p', 'complaint', shot.note));\n\n  if (s.cleaned) {\n    const ul = document.createElement('ul');\n    ul.className = 'findings';\n    shot.issues.forEach(function (r) { ul.appendChild(makeText('li', null, r)); });\n    bodyBox.appendChild(ul);\n  }\n\n  if (s.render) {\n    const q = QUALITY[s.render];\n    const fig = document.createElement('figure');\n    fig.className = 'shot';\n    const img = document.createElement('img');\n    img.src = shot.image;\n    img.alt = shot.alt;\n    img.width = 480;\n    img.height = 360;\n    img.className = `shot-img q-${s.render === 'draft' ? 'standard' : s.render === 'blocking' ? 'low' : 'original'}`;\n    fig.appendChild(img);\n    fig.appendChild(makeText('figcaption', 'shot-cap',\n      `${q.word} quality. Used ${pf.format(q.units / 100)} of the disk, rated ${nf.format(q.detail)} out of 100.`));\n    bodyBox.appendChild(fig);\n  }\n\n  if (s.loaded) {\n    bodyBox.appendChild(makeText('p', 'detail-travel',\n      `This shot is open and holding ${pf.format(SHOT_RAM / 100)} of the memory.`));\n  }\n\n  const actions = document.createElement('div');\n  actions.className = 'actions';\n\n  if (!s.cleaned) {\n    actions.appendChild(button(\n      `Clean up the motion data (${nf.format(Math.round(CLEAN_MINUTES * mult))} min)`,\n      'btn-go',\n      function () { act(function () { doClean(shot.id); }); },\n      blockedAction('clean')\n    ));\n  }\n\n  if (s.cleaned && s.render === null) {\n    const q = QUALITY[state.settings.quality];\n    const capped = state.settings.power === 'capped';\n    actions.appendChild(button(\n      `Render the picture (${nf.format(Math.round(q.minutes * (capped ? CAPPED_RENDER_TIME : 1) * mult))} min, ${pf.format(q.units / 100)} of the disk)`,\n      'btn-go',\n      function () { act(function () { doRender(shot.id); }); },\n      blockedAction('render') || !renderFits()\n    ));\n  }\n\n  if (s.render !== null && !s.saved) {\n    actions.appendChild(button(\n      `Save the file (${nf.format(Math.round(SAVE_MINUTES * mult))} min)`,\n      'btn-go',\n      function () { act(function () { doSave(shot.id); }); },\n      blockedAction('save')\n    ));\n  }\n\n  if (s.saved && s.loaded) {\n    actions.appendChild(button(`Close the shot (${nf.format(UNLOAD_MINUTES)} min)`, 'btn-alt',\n      function () { act(doUnloadAll); }));\n  }\n\n  bodyBox.appendChild(actions);\n\n  if (!renderFits() && s.cleaned && s.render === null) {\n    bodyBox.appendChild(makeText('p', 'detail-note',\n      `The disk has ${pf.format(diskFree() / 100)} free and this render needs ${pf.format(QUALITY[state.settings.quality].units / 100)}.`));\n  }\n}\n\nfunction renderFinish() {\n  clearChildren(els.finish);\n  const pending = pendingUploads();\n  const left = tasksLeft();\n\n  const row = document.createElement('div');\n  row.className = 'actions';\n\n  if (state.settings.publish === 'end' && pending.length > 0) {\n    row.appendChild(button(\n      `Upload everything and finish (${nf.format(uploadCost(pending))} min)`,\n      'btn-warn btn-lg',\n      function () { act(doFinish); }\n    ));\n  } else {\n    row.appendChild(button('Finish the afternoon', 'btn-warn btn-lg', function () { act(doFinish); }));\n  }\n\n  if (state.temp >= 60) {\n    row.appendChild(button(`Let the card cool (${nf.format(COOL_MINUTES)} min)`, 'btn-alt',\n      function () { act(doCool); }));\n  }\n  els.finish.appendChild(row);\n\n  if (state.settings.publish === 'end' && pending.length > 0) {\n    els.finish.appendChild(makeText('p', 'finish-note',\n      `${nf.format(pending.length)} saved shots are waiting to go up. Nothing has left this computer yet.`));\n  }\n\n  if (state.temp >= HOT_WARN) {\n    els.finish.appendChild(makeText('p', 'finish-note',\n      `The card is at ${nf.format(Math.round(state.temp))} degrees. It goes down at ${nf.format(CRASH_TEMP)}.`));\n  }\n\n  if (left > 0) {\n    els.finish.appendChild(makeText('p', 'finish-note', `${nf.format(left)} things are still undone across the four shots.`));\n  }\n}\n\nfunction renderShotsView() {\n  renderBanner();\n  renderShots();\n  renderDetail();\n  renderFinish();\n}\n\n/* ================= settings view ================= */\n\nfunction renderSymptom() {\n  if (state.justFixed) {\n    els.symptom.hidden = false;\n    els.symptom.className = 'symptom good';\n    clearChildren(els.symptom);\n    els.symptom.appendChild(makeText('p', 'symptom-line', state.justFixed));\n    return;\n  }\n  if (!state.problem) {\n    els.symptom.hidden = true;\n    clearChildren(els.symptom);\n    return;\n  }\n  const p = problemById(state.problem);\n  els.symptom.hidden = false;\n  els.symptom.className = 'symptom';\n  clearChildren(els.symptom);\n  els.symptom.appendChild(makeText('p', 'symptom-line', p.symptom));\n  /* A blocking problem has to be solved before anything else can happen, so\n     point at the group straight away rather than making the student guess. */\n  if (p.blocks || state.wrongTries >= HINT_AFTER_TRIES) {\n    els.symptom.appendChild(makeText('p', 'symptom-hint', `Look in the ${groupById(p.group).name} settings.`));\n  }\n}\n\nfunction renderSettings() {\n  renderSymptom();\n  els.settingsNote.textContent = 'Opening a setting is free. Changing one costs time.';\n\n  clearChildren(els.groups);\n  GROUPS.forEach(function (group) {\n    const section = document.createElement('section');\n    section.className = `group fam-${group.id}`;\n\n    const head = document.createElement('div');\n    head.className = 'group-head';\n    head.appendChild(icon(group.icon, 'group-icon'));\n    head.appendChild(makeText('h3', 'group-name', group.name));\n    section.appendChild(head);\n\n    SETTINGS.filter(function (s) { return s.group === group.id; }).forEach(function (setting) {\n      const row = document.createElement('details');\n      row.className = 'srow';\n\n      const summary = document.createElement('summary');\n      summary.className = 'srow-summary';\n      summary.appendChild(makeText('span', 'srow-name', setting.name));\n      summary.appendChild(makeText('span', 'srow-value', optionLabel(setting, state.settings[setting.id])));\n      summary.appendChild(icon('a-chevron', 'srow-chevron'));\n      row.appendChild(summary);\n\n      const bodyBox = document.createElement('div');\n      bodyBox.className = 'srow-body';\n      bodyBox.appendChild(makeText('p', 'srow-why', setting.why));\n\n      const opts = document.createElement('div');\n      opts.className = 'options';\n      opts.setAttribute('role', 'group');\n      opts.setAttribute('aria-label', setting.name);\n      setting.options.forEach(function (opt) {\n        const b = document.createElement('button');\n        b.type = 'button';\n        b.className = 'option';\n        b.setAttribute('aria-pressed', state.settings[setting.id] === opt.value ? 'true' : 'false');\n        b.appendChild(makeText('span', 'option-label', opt.label));\n        b.appendChild(makeText('span', 'option-note', opt.note));\n        b.addEventListener('click', function () { changeSetting(setting.id, opt.value); });\n        opts.appendChild(b);\n      });\n      bodyBox.appendChild(opts);\n      row.appendChild(bodyBox);\n      section.appendChild(row);\n    });\n\n    els.groups.appendChild(section);\n  });\n}\n\n/* ================= report ================= */\n\nfunction menuMinutesSpent() {\n  let t = 0;\n  state.log.forEach(function (e) { if (e.menu) t += e.minutes; });\n  return t;\n}\n\nfunction wastedMenuMinutes() {\n  let t = 0;\n  state.log.forEach(function (e) {\n    if (e.menu && e.text.indexOf('Nothing about the afternoon changed.') !== -1) t += e.minutes;\n  });\n  return t;\n}\n\nfunction totalsByCategory() {\n  const totals = {\n    processor: { m: 0 }, gpu: { m: 0 }, storage: { m: 0 },\n    memory: { m: 0 }, network: { m: 0 }, settings: { m: 0 }\n  };\n  state.log.forEach(function (e) {\n    if (!totals[e.cat]) return;\n    totals[e.cat].m += e.minutes;\n  });\n  return totals;\n}\n\nconst TALLY_CARDS = [\n  { id: 'processor', name: 'Processor', symbol: 't-processor' },\n  { id: 'gpu', name: 'Graphics card', symbol: 't-gpu' },\n  { id: 'memory', name: 'Memory', symbol: 't-memory' },\n  { id: 'storage', name: 'Storage', symbol: 't-storage' },\n  { id: 'network', name: 'Network', symbol: 't-network' },\n  { id: 'settings', name: 'Settings', symbol: 'g-settings' }\n];\n\nfunction renderTally() {\n  const totals = totalsByCategory();\n  let topId = null;\n  let topScore = 0;\n  TALLY_CARDS.forEach(function (c) {\n    if (totals[c.id].m > topScore) { topScore = totals[c.id].m; topId = c.id; }\n  });\n\n  clearChildren(els.tally);\n  TALLY_CARDS.forEach(function (c) {\n    const card = document.createElement('div');\n    card.className = `tally-card cat-${c.id}` + (c.id === topId ? ' is-top' : '');\n    const head = document.createElement('div');\n    head.className = 'tally-head';\n    head.appendChild(icon(c.symbol, 'tally-dot'));\n    head.appendChild(makeText('span', 'tally-name', c.name));\n    card.appendChild(head);\n\n    const bodyBox = document.createElement('div');\n    bodyBox.className = 'tally-body';\n    bodyBox.appendChild(makeText('p', 'tally-val', `${nf.format(totals[c.id].m)} min`));\n    if (c.id === 'gpu') {\n      bodyBox.appendChild(makeText('p', 'tally-sub', `Card finished at ${nf.format(Math.round(state.temp))} degrees`));\n      bodyBox.appendChild(makeText('p', 'tally-sub', `${nf.format(state.crashes)} crashes`));\n    }\n    if (c.id === 'storage') bodyBox.appendChild(makeText('p', 'tally-sub', `${pf.format(state.renderUnits / 100)} of the disk in renders`));\n    if (c.id === 'memory') bodyBox.appendChild(makeText('p', 'tally-sub', `Finished at ${pf.format(ramUsed() / 100)} of memory`));\n    if (c.id === 'settings') {\n      bodyBox.appendChild(makeText('p', 'tally-sub', `${nf.format(menuMinutesSpent())} min changing settings`));\n      bodyBox.appendChild(makeText('p', 'tally-sub', `${nf.format(wastedMenuMinutes())} min of that changed nothing`));\n    }\n    if (c.id === topId) bodyBox.appendChild(makeText('p', 'tally-flag', 'Biggest cost'));\n    card.appendChild(bodyBox);\n    els.tally.appendChild(card);\n  });\n}\n\nfunction renderReport() {\n  const published = state.shots.filter(function (s) { return s.published; }).length;\n  const rendered = rendersDone();\n  const detail = renderDetailAverage();\n\n  const rows = [\n    { name: 'Shots at the review', value: `${nf.format(published)} of ${nf.format(SHOTS.length)}`, met: published === SHOTS.length },\n    { name: 'Finished before 6:00 PM', value: state.endReason === 'finished' ? `Done at ${clockText()}` : `Stopped at ${clockText()}`, met: state.endReason === 'finished' },\n    { name: 'Times the workstation went down', value: nf.format(state.crashes), met: state.crashes === 0 },\n    { name: 'Shots rendered', value: `${nf.format(rendered)} of ${nf.format(SHOTS.length)}`, met: rendered === SHOTS.length },\n    { name: 'How useful the renders were', value: `${nf.format(detail)} out of 100`, met: detail >= USEFUL_RENDER_SCORE },\n    { name: 'Renders destroyed and done over', value: nf.format(state.redone + state.lostRenders), met: state.redone + state.lostRenders === 0 },\n    { name: 'Memory peak', value: ramUsed() > 100 ? `${pf.format(ramUsed() / 100)}, using the disk instead` : pf.format(ramUsed() / 100), met: swapOver() === 0 }\n  ];\n\n  const passed = rows.every(function (r) { return r.met; });\n  els.reportHeadline.textContent = passed ? 'Marcus made the review' : 'The review came up short';\n  els.verdict.textContent = passed\n    ? `All ${nf.format(rows.length)} goals met`\n    : `${nf.format(rows.filter(function (r) { return !r.met; }).length)} of ${nf.format(rows.length)} goals missed`;\n  els.verdict.className = passed ? 'verdict good' : 'verdict';\n\n  if (state.endReason === 'clock') els.reportSub.textContent = `It hit ${clockText()} with work still left.`;\n  else if (passed) els.reportSub.textContent = 'Four shots on the screen, nothing done twice, and the computer stayed up.';\n  else els.reportSub.textContent = 'He finished, but something did not make it.';\n\n  clearChildren(els.reportList);\n  rows.forEach(function (row) {\n    const li = document.createElement('li');\n    li.className = row.met ? 'met' : 'unmet';\n    li.appendChild(makeText('span', 'rep-name', row.name));\n    li.appendChild(makeText('span', 'rep-val', row.met ? row.value : `${row.value} (not enough)`));\n    els.reportList.appendChild(li);\n  });\n\n  renderTally();\n\n  clearChildren(els.reportNotes);\n  const notes = [];\n  const wasted = wastedMenuMinutes();\n  const totals = totalsByCategory();\n\n  if (state.redone > 0) {\n    notes.push(`${nf.format(state.redone)} renders were destroyed by their own save. The card was repaired weeks ago, but the software update that went on right after it was never tested, and a repaired machine can still be running broken software.`);\n  }\n  if (state.crashes > 0 && state.settings.autosave === 'off') {\n    notes.push('The machine went down with renders that had never been saved, and there was no recovery file to bring them back.');\n  }\n  if (state.crashes > 0 && state.settings.autosave === 'on') {\n    notes.push('The machine still went down, but the recovery file meant the only cost was the reboot.');\n  }\n  if (state.settings.power === 'open' && rendered > 0) {\n    notes.push('The graphics card ran at full speed all afternoon. Holding it back makes each render slower and is usually still the faster way through, because one crash costs more than all the slower renders put together.');\n  }\n  if (state.settings.viewport === 'full') {\n    notes.push(`The work window held the full-detail scene the whole time, which is why the memory gauge started near the top and every task ran ${pf.format(VIEWPORT_PENALTY)} slow.`);\n  }\n  if (swapOver() > 0 || totals.memory.m > 20) {\n    notes.push('The machine spent part of the afternoon using the disk as extra memory. That is not a failure, it is the computer keeping going the only way it can, and it is much slower than real memory.');\n  }\n  if (state.settings.quality === 'full' && state.renderUnits > 0) {\n    notes.push('Every render went out at full quality, which is why the disk filled and the reel took so long to send.');\n  }\n  if (detail > 0 && detail < USEFUL_RENDER_SCORE) {\n    notes.push('The renders were cheap and too rough to read. The director could not judge a shot from plain gray boxes.');\n  }\n  if (state.settings.publish === 'background' && state.renderUnits <= 40) {\n    notes.push('The uploads ran in the background all afternoon and slowed every task down. With pictures this small, sending everything at the end would have cost less time overall.');\n  }\n  if (state.settings.publish === 'end' && state.renderUnits >= 70) {\n    notes.push('Everything went up in one batch at the end. With pictures this large, letting the uploads run in the background while he worked would have cost less time overall.');\n  }\n  if (wasted >= 3) {\n    notes.push(`${nf.format(wasted)} minutes went into settings that do not affect speed, heat, memory, or disk.`);\n  }\n  if (state.missedHistory) {\n    notes.push('The director asked to see last week\\u2019s version of the car flip. It was on the server and getting it back took a request to IT.');\n  }\n  notes.forEach(function (t) { els.reportNotes.appendChild(makeText('p', 'report-note', t)); });\n\n  clearChildren(els.questions);\n  QUESTIONS.forEach(function (q) { els.questions.appendChild(makeText('li', null, q)); });\n}\n\n/* ================= views ================= */\n\nfunction render() {\n  /* Each view is a separate screen, so switching to one should start it at the\n     top rather than inheriting wherever the last screen was scrolled to. */\n  viewJustChanged = renderedView !== state.view;\n  renderedView = state.view;\n\n  const chrome = state.view !== 'brief';\n  els.statusbar.hidden = !chrome;\n  els.procbar.hidden = !chrome;\n  els.tabbar.hidden = !chrome || state.over;\n  els.resetBtn.hidden = !chrome;\n  if (chrome) renderStatus();\n\n  Object.keys(els.views).forEach(function (key) { els.views[key].hidden = key !== state.view; });\n\n  if (state.view === 'brief') renderGoals();\n  if (state.view === 'shots') renderShotsView();\n  if (state.view === 'settings') renderSettings();\n  if (state.view === 'report') renderReport();\n\n  els.tabs.forEach(function (tab) {\n    if (tab.dataset.tab === state.view) tab.setAttribute('aria-current', 'page');\n    else tab.removeAttribute('aria-current');\n  });\n\n  if (viewJustChanged) els.body.scrollTop = 0;\n}\n\nfunction focusMain() {\n  const view = els.views[state.view];\n  if (!view) return;\n  const first = view.querySelector('.btn') || view.querySelector('button');\n  if (!first) return;\n  /* On a fresh screen, keep the scroll at the top instead of letting focus drag\n     the page down to whatever control happens to be first. Inside a screen, let\n     focus scroll normally so the control the student just used stays visible. */\n  first.focus({ preventScroll: viewJustChanged });\n  if (viewJustChanged) els.body.scrollTop = 0;\n  viewJustChanged = false;\n}\n\nlet sheetReturnFocus = null;\n\nfunction openSheet() {\n  if (busy) return;\n  sheetReturnFocus = document.activeElement;\n  els.sheet.hidden = false;\n  els.sheetYes.focus();\n}\n\nfunction closeSheet() {\n  els.sheet.hidden = true;\n  if (sheetReturnFocus && sheetReturnFocus.focus) sheetReturnFocus.focus();\n  sheetReturnFocus = null;\n}\n\n/* Keeps Tab inside the dialog while it is open, since the rest of the screen\n   stays in the document behind it. */\nfunction trapSheetFocus(event) {\n  if (els.sheet.hidden) return;\n  if (event.key === 'Escape') { closeSheet(); return; }\n  if (event.key !== 'Tab') return;\n  const stops = [els.sheetYes, els.sheetNo];\n  const first = stops[0];\n  const last = stops[stops.length - 1];\n  if (event.shiftKey && document.activeElement === first) {\n    event.preventDefault();\n    last.focus();\n  } else if (!event.shiftKey && document.activeElement === last) {\n    event.preventDefault();\n    first.focus();\n  }\n}\n\nfunction confirmRestart() {\n  closeSheet();\n  restart();\n}\n\nfunction goTab(name) {\n  if (busy || state.over) return;\n  if (name !== 'settings') state.justFixed = null;\n  state.view = name;\n  render();\n  focusMain();\n}\n\nfunction renderGoals() {\n  clearChildren(els.briefGoals);\n  GOALS.forEach(function (text) {\n    const li = document.createElement('li');\n    li.appendChild(icon('a-check', 'goal-icon'));\n    li.appendChild(makeText('span', null, text));\n    els.briefGoals.appendChild(li);\n  });\n}\n\nfunction startAfternoon() {\n  syncProblem();\n  state.view = 'shots';\n  render();\n  focusMain();\n}\n\n/* A reset drops the student back on the scenario screen, so the setup and the\n   goals are in front of them again before the second attempt. */\nfunction restart() {\n  els.sheet.hidden = true;\n  renderedView = null;\n  state = freshState();\n  render();\n  focusMain();\n}\n\n/* ================= boot ================= */\n\nfunction cacheElements() {\n  els.statusbar = document.querySelector('.statusbar');\n  els.body = document.querySelector('.body');\n  els.procbar = document.querySelector('.procbar');\n  els.clock = document.getElementById('stat-clock');\n  els.temp = document.getElementById('stat-temp');\n  els.ram = document.getElementById('stat-ram');\n  els.disk = document.getElementById('stat-disk');\n  els.speed = document.getElementById('stat-speed');\n  els.gaugeTemp = document.getElementById('gauge-temp');\n  els.gaugeRam = document.getElementById('gauge-ram');\n  els.gaugeDisk = document.getElementById('gauge-disk');\n  els.procFill = document.getElementById('procbar-fill');\n  els.views = {\n    brief: document.getElementById('view-brief'),\n    shots: document.getElementById('view-shots'),\n    settings: document.getElementById('view-settings'),\n    report: document.getElementById('view-report')\n  };\n  els.banner = document.getElementById('banner');\n  els.shots = document.getElementById('shots');\n  els.shotsChip = document.getElementById('shots-chip');\n  els.detail = document.getElementById('detail');\n  els.finish = document.getElementById('finish');\n  els.symptom = document.getElementById('symptom');\n  els.settingsNote = document.getElementById('settings-note');\n  els.groups = document.getElementById('groups');\n  els.reportHeadline = document.getElementById('report-headline');\n  els.reportSub = document.getElementById('report-sub');\n  els.verdict = document.getElementById('verdict');\n  els.reportList = document.getElementById('report-list');\n  els.tally = document.getElementById('tally');\n  els.reportNotes = document.getElementById('report-notes');\n  els.questions = document.getElementById('questions');\n  els.tabbar = document.getElementById('tabbar');\n  els.tabDot = document.getElementById('tab-dot');\n  els.briefGoals = document.getElementById('brief-goals');\n  els.resetBtn = document.getElementById('reset-btn');\n  els.sheet = document.getElementById('sheet');\n  els.sheetYes = document.getElementById('sheet-yes');\n  els.sheetNo = document.getElementById('sheet-no');\n  els.tabs = Array.prototype.slice.call(document.querySelectorAll('.tab'));\n}\n\nfunction bindEvents() {\n  document.getElementById('start-btn').addEventListener('click', startAfternoon);\n  document.getElementById('again-btn').addEventListener('click', restart);\n  els.resetBtn.addEventListener('click', openSheet);\n  els.sheetYes.addEventListener('click', confirmRestart);\n  els.sheetNo.addEventListener('click', closeSheet);\n  document.addEventListener('keydown', trapSheetFocus);\n  els.tabs.forEach(function (tab) {\n    tab.addEventListener('click', function () { goTab(tab.dataset.tab); });\n  });\n}\n\nfunction init() {\n  try {\n    cacheElements();\n    bindEvents();\n    state = freshState();\n    render();\n  } catch (error) {\n    /* Students get a plain message; the real error goes to the console so\n       whoever is fixing it can see what actually broke. */\n    console.error('RenderDeck could not start.', error);\n    const p = document.createElement('p');\n    p.textContent = 'This activity could not load. Refresh the page, and tell your teacher if it happens again.';\n    document.body.insertBefore(p, document.body.firstChild);\n  }\n}\n\ninit();",
