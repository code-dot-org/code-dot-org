    "display_name": "The Fallback",
    "bubble_choice_description": "Display a local fallback image when the fetch fails.",
    "thumbnail_url": "https://images.code.org/094c77eafa5c3c615df9d7b55c4daf88-Pasted Graphic 3.png",
