      "files": {
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": ":root {\n    --earnr-green: #16c784;\n    --earnr-green-dark: #0f9f67;\n    --earnr-bg: #f3f5f7;\n    --earnr-card: #ffffff;\n    --earnr-text: #171717;\n    --earnr-muted: #6b7280;\n    --earnr-line: #e5e7eb;\n    --earnr-shadow: 0 14px 32px rgba(0, 0, 0, 0.08);\n    --earnr-blue: #2563eb;\n}\n\n* {\n    box-sizing: border-box;\n}\n\nhtml {\n    font-size: 16px;\n}\n\nbody {\n    margin: 0;\n    min-height: 100vh;\n    font-family: 'Roboto', sans-serif;\n    color: var(--earnr-text);\n    background: var(--earnr-bg);\n}\n\nimg {\n    display: block;\n    max-width: 100%;\n}\n\nbutton {\n    font: inherit;\n}\n\n.app-shell {\n    width: min(100%, 1200px);\n    min-height: 100vh;\n    margin: 0 auto;\n    background: rgba(255, 255, 255, 0.96);\n    box-shadow: var(--earnr-shadow);\n    display: flex;\n    flex-direction: column;\n    overflow: hidden;\n}\n\n.fixed-top {\n    position: sticky;\n    top: 0;\n    z-index: 20;\n    background: var(--earnr-card);\n    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);\n}\n\n.navbar {\n    background: linear-gradient(135deg, var(--earnr-green), var(--earnr-green-dark));\n    color: white;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    padding: 14px 18px;\n    position: relative;\n}\n\n.back-arrow {\n    position: absolute;\n    left: 18px;\n    font-size: 1.25rem;\n    font-weight: 700;\n    line-height: 1;\n}\n\n.nav-title-wrap {\n    min-width: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n}\n\n.nav-logo {\n    width: 30px;\n    height: 30px;\n    object-fit: contain;\n    border-radius: 8px;\n    background: rgba(255, 255, 255, 0.12);\n    padding: 3px;\n}\n\n.nav-title {\n    font-family: 'Oswald', sans-serif;\n    font-size: clamp(1.1rem, 2vw, 1.5rem);\n    letter-spacing: 0.02em;\n    white-space: nowrap;\n}\n\n.status-panel {\n    padding: 16px 18px 18px;\n    border-bottom: 1px solid var(--earnr-line);\n    background: white;\n}\n\n.current-gig-block {\n    margin-bottom: 14px;\n}\n\n.status-label {\n    margin: 0 0 6px;\n    font-size: 0.72rem;\n    font-weight: 900;\n    letter-spacing: 0.14em;\n    color: var(--earnr-muted);\n    text-transform: uppercase;\n}\n\n#cartDisplay {\n    margin: 0;\n    font-family: 'Oswald', sans-serif;\n    font-size: clamp(1.15rem, 2.5vw, 1.7rem);\n    line-height: 1.15;\n    color: var(--earnr-green-dark);\n    text-transform: uppercase;\n}\n\n.status-grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 12px;\n}\n\n.status-card {\n    background: #fafafa;\n    border: 1px solid var(--earnr-line);\n    border-radius: 16px;\n    padding: 14px;\n}\n\n.status-value {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: baseline;\n    gap: 8px;\n    font-family: 'Oswald', sans-serif;\n    font-size: clamp(1.05rem, 2vw, 1.45rem);\n    color: var(--earnr-text);\n}\n\n.earnings-change {\n    font-size: 1rem;\n    color: var(--earnr-blue);\n    font-weight: 700;\n}\n\n.scroll-content {\n    flex: 1;\n    overflow-y: auto;\n    scrollbar-width: none;\n}\n\n.scroll-content::-webkit-scrollbar {\n    display: none;\n}\n\n.hero-banner {\n    position: relative;\n    min-height: clamp(220px, 34vw, 360px);\n    background-size: cover;\n    background-position: center;\n}\n\n.hero-overlay {\n    position: absolute;\n    left: clamp(16px, 3vw, 28px);\n    bottom: clamp(16px, 3vw, 28px);\n    color: white;\n    max-width: 80%;\n}\n\n.hero-overlay p {\n    margin: 0 0 6px;\n    font-size: 0.78rem;\n    font-weight: 900;\n    letter-spacing: 0.12em;\n}\n\n.hero-overlay h2 {\n    margin: 0;\n    font-family: 'Oswald', sans-serif;\n    font-size: clamp(1.6rem, 4vw, 2.7rem);\n    line-height: 1;\n}\n\n.menu-list {\n    padding: 8px 18px 26px;\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 14px;\n}\n\n.menu-item {\n    display: flex;\n    align-items: flex-start;\n    gap: 14px;\n    padding: 14px;\n    background: white;\n    border: 1px solid var(--earnr-line);\n    border-radius: 18px;\n    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.04);\n}\n\n.menu-item > img {\n    width: 84px;\n    height: 84px;\n    object-fit: cover;\n    border-radius: 14px;\n    flex-shrink: 0;\n}\n\n.item-info {\n    flex: 1;\n    min-width: 0;\n}\n\n.item-info h3 {\n    margin: 0 0 10px;\n    font-size: 1rem;\n    font-weight: 900;\n    line-height: 1.2;\n}\n\n.job-list {\n    list-style: none;\n    margin: 0;\n    padding: 0;\n    display: grid;\n    gap: 8px;\n}\n\n.job-btn {\n    width: 100%;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n\n    border: 1px solid var(--earnr-line);\n    background: #fafafa;\n    border-radius: 12px;\n    padding: 10px 12px;\n\n    cursor: pointer;\n\n    transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;\n}\n\n.job-btn:hover {\n    transform: translateY(-1px);\n    border-color: #cfd4dc;\n    background: #f3f4f6;\n}\n\n.job-desc {\n    font-size: 0.9rem;\n    font-weight: 700;\n    color: var(--earnr-text);\n}\n\n.job-pay {\n    font-size: 0.9rem;\n    font-weight: 900;\n    color: var(--earnr-green);\n}\n\n@media (min-width: 700px) {\n    .navbar {\n        padding: 16px 24px;\n    }\n\n    .back-arrow {\n        left: 24px;\n    }\n\n    .status-panel {\n        padding: 18px 24px 20px;\n    }\n\n    .stats-strip {\n        padding: 18px 24px 10px;\n    }\n\n    .menu-list {\n        padding: 10px 24px 32px;\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n\n    .menu-item > img {\n        width: 96px;\n        height: 96px;\n    }\n}\n\n@media (min-width: 1024px) {\n    .scroll-content {\n        display: grid;\n        grid-template-columns: 1.05fr 1fr;\n        grid-template-areas:\n            \"hero stats\"\n            \"hero list\";\n        align-content: start;\n    }\n\n    .hero-banner {\n        grid-area: hero;\n        min-height: 100%;\n    }\n\n    .stats-strip {\n        grid-area: stats;\n        padding: 22px 24px 10px;\n    }\n\n    .menu-list {\n        grid-area: list;\n        padding: 10px 24px 32px;\n        grid-template-columns: 1fr;\n        align-content: start;\n    }\n}\n\n@media (max-width: 520px) {\n    .app-shell {\n        width: 100%;\n        box-shadow: none;\n    }\n\n    .navbar {\n        padding: 12px 14px;\n    }\n\n    .back-arrow {\n        left: 14px;\n    }\n\n    .nav-logo {\n        width: 26px;\n        height: 26px;\n    }\n\n    .nav-title {\n        font-size: 1.1rem;\n    }\n\n    .status-panel {\n        padding: 14px;\n    }\n\n    .status-grid {\n        grid-template-columns: 1fr;\n    }\n\n    .hero-banner {\n        min-height: 190px;\n    }\n\n    .hero-overlay {\n        max-width: 90%;\n    }\n\n    .stats-strip {\n        padding: 14px 14px 6px;\n    }\n\n    .menu-list {\n        padding: 8px 14px 24px;\n        gap: 12px;\n    }\n\n    .menu-item {\n        padding: 12px;\n        gap: 12px;\n    }\n\n    .menu-item > img {\n        width: 68px;\n        height: 68px;\n        border-radius: 12px;\n    }\n\n    .item-info h3 {\n        font-size: 0.95rem;\n    }\n\n    .job-btn {\n        font-size: 0.84rem;\n        padding: 9px 10px;\n    }\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const burgerBtn = document.getElementById('burgerBtn');\nconst tacoBtn = document.getElementById('tacoBtn');\nconst pizzaBtn = document.getElementById('pizzaBtn');\n\nconst selectGig = () => {\n    const display = document.getElementById('gigDisplay');\n    display.textContent = \"Burger combo dropoff\";\n};\n\nburgerBtn.addEventListener(\"click\", () => {\n    selectGig();\n});\ntacoBtn.addEventListener(\"click\", () => {\n    selectGig();\n});\npizzaBtn.addEventListener(\"click\", () => {\n    selectGig();\n});\n",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Earnr | Side Hustle Simulator</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=Roboto:wght@400;700;900&display=swap\" rel=\"stylesheet\">\n</head>\n<body>\n\n    <div class=\"app-shell\">\n        <div class=\"fixed-top\">\n            <nav class=\"navbar\">\n                <span class=\"back-arrow\">←</span>\n                <div class=\"nav-title-wrap\">\n                    <img src=\"images/logo.png\" alt=\"Earnr logo\" class=\"nav-logo\">\n                    <div class=\"nav-title\">Earnr</div>\n                </div>\n            </nav>\n\n            <div class=\"status-panel\">\n                <div class=\"current-gig-block\">\n                    <p class=\"status-label\">Current Gig</p>\n                    <h2 id=\"gigDisplay\">None selected</h2>\n                </div>\n            </div>\n        </div>\n\n        <main class=\"scroll-content\">\n            <div class=\"hero-banner\" style=\"background-image: linear-gradient(to top, rgba(0,0,0,0.7), transparent), url('images/hero.jpg');\">\n                <div class=\"hero-overlay\">\n                    <p>There's money to be made</p>\n                    <h2>Pick Up Your Next Gig</h2>\n                </div>\n            </div>\n\n            <div class=\"menu-list\">\n                <div class=\"menu-item\">\n                    <img src=\"images/gig-food.jpg\" alt=\"Food delivery\">\n                    <div class=\"item-info\">\n                        <h3>Food Delivery</h3>\n                        <ul class=\"job-list\">\n                            <li>\n                                <button id=\"burgerBtn\" class=\"job-btn\">\n                                    <span class=\"job-desc\">Burger combo dropoff</span>\n                                    <span class=\"job-pay\">$14</span>\n                                </button>\n                            </li>\n                            <li>\n                                <button id=\"tacoBtn\" class=\"job-btn\">\n                                    <span class=\"job-desc\">Late-night taco run</span>\n                                    <span class=\"job-pay\">$18</span>\n                                </button>\n                            </li>\n                            <li>\n                                <button id=\"pizzaBtn\" class=\"job-btn\">\n                                    <span class=\"job-desc\">Family pizza delivery</span>\n                                    <span class=\"job-pay\">$22</span>\n                                </button>\n                            </li>\n                        </ul>\n                    </div>\n                </div>\n            </div>\n        </main>\n    </div>\n\n    <script src=\"utils.js\"></script>\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "active": false
        },
