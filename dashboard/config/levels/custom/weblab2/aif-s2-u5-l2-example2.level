    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "script.js",
          "language": "js",
          "contents": "const outputElement = document.getElementById('status-output');\n\noutputElement.innerHTML = '<p style=\"color: red;\">WARNING: Browser will be unresponsive for 3 seconds after click Run Code.</p>';\n\ndocument.getElementById('start-button').addEventListener('click', () => {\n\n    const startTime = Date.now();\n    let counter = 0;\n    \n    // This blocks the main thread completely.\n    while (Date.now() - startTime < 3000) { // Loops for 3 seconds\n        counter++;\n    }\n    \n    // This message only appears AFTER the 3-second freeze.\n    outputElement.innerHTML = `\n        <p>Loop finished after 3 seconds.</p>\n        <p style=\"color: red; font-weight: bold;\">NOTICE: The button was unresponsive during this entire time!</p>\n    `;\n    \n    // The key learning point is visual: nothing updates on the page until the loop is done.\n});",
          "folderId": "0",
          "active": true
        },
        "2": {
          "id": "2",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n  </head>\n  <body>\n    <div id=\"status-output\" style=\"min-height: 100px; border: 1px solid #ccc; padding: 10px;\">\n    </div>\n    <br/>\n    <button id=\"start-button\"> ▶ Run Code</button>\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "folderId": "0",
          "active": false
        }
      },
