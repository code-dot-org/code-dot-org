    "encrypted": "false",
    "long_instructions": "**Snippet 2: The UI Blocking Problem (Why we need Async)**\r\n\r\nThis optional snippet demonstrates the opposite (a bad synchronous block), which causes the browser to freeze and proves why the asynchronous pattern is mandatory.",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
