  "properties": {
    "require_edit_to_continue": "true",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "style.css",
          "contents": ":root {\n  --background-neutral-primary: #ffffff;\n  --background-neutral-secondary: #f1f2f4;\n  --background-neutral-tertiary: #e1e3e6;\n  --background-brand-primary: #4c42cf;\n  --background-selected-primary: #2b1e9f;\n  --background-success-light: #d8ffdc;\n  --background-success-primary: #258830;\n  --border-neutral-primary: #d3d6da;\n  --border-neutral-secondary: #9ea5ad;\n  --border-neutral-solid: #121212;\n  --border-selected-primary: #2b1e9f;\n  --border-focused-primary: #4c42cf;\n  --text-neutral-primary: #121212;\n  --text-neutral-secondary: #363b40;\n  --text-neutral-quaternary: #596069;\n  --text-neutral-white-fixed: #ffffff;\n  --text-selected-primary: #d8ffdc;\n  --text-success-secondary: #17541e;\n  --text-warning-secondary: #885d02;\n  --illustration-leaves-back: #258830;\n  --illustration-leaves-front: #34bd43;\n  --illustration-trunk: #b34800;\n  --shape-sm: 0.375rem;\n  --shape-md: 0.5rem;\n  --shadow-md: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);\n  --font-family-main: \"Geist\", \"Noto Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif;\n  --text-body-sm: 0.875rem;\n  --text-body-md: 1rem;\n  --text-body-xs: 0.75rem;\n  --leading-body-sm: 1.375rem;\n  --transition-colors: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  padding: 1rem;\n  background-color: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-sm);\n  line-height: var(--leading-body-sm);\n}\n\nbutton,\ninput {\n  font: inherit;\n}\n\n:focus-visible {\n  outline: 2px solid var(--border-focused-primary);\n  outline-offset: 2px;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.widget {\n  display: grid;\n  grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);\n  gap: 1rem;\n  max-width: 62rem;\n  margin-inline: auto;\n}\n\n.panel {\n  min-width: 0;\n  padding: 1rem;\n  background-color: var(--background-neutral-primary);\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n}\n\n.overline {\n  margin: 1.5rem 0 0.75rem;\n  color: var(--text-neutral-quaternary);\n  font-size: var(--text-body-xs);\n  font-weight: 600;\n  letter-spacing: 0.08em;\n  line-height: 1rem;\n  text-transform: uppercase;\n}\n\n/* Label box */\n\n.field {\n  display: flex;\n  flex-direction: column;\n  gap: 0.375rem;\n}\n\n.field label {\n  font-weight: 600;\n}\n\n.field input {\n  width: 100%;\n  min-height: 2.5rem;\n  padding: 0.5rem 0.75rem;\n  border: 1px solid var(--border-neutral-solid);\n  border-radius: var(--shape-sm);\n  background-color: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font-size: var(--text-body-md);\n}\n\n/* Pick chips */\n\n.chip-tray {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.chip {\n  min-height: 2.5rem;\n  padding: 0.25rem 1rem;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: 999px;\n  background-color: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font-weight: 600;\n  cursor: pointer;\n  transition: var(--transition-colors);\n}\n\n.chip:hover {\n  background-color: var(--background-neutral-secondary);\n}\n\n.chip:active {\n  background-color: var(--background-neutral-tertiary);\n}\n\n.chip[aria-pressed=\"true\"] {\n  border-color: var(--border-selected-primary);\n  background-color: var(--background-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n/* Sample page */\n\n.page {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  padding: 1.5rem 1rem 1rem;\n  border-radius: var(--shape-md);\n  background-color: var(--background-success-light);\n  text-align: center;\n  overflow: hidden;\n}\n\n.tree-trunk {\n  fill: var(--illustration-trunk);\n}\n\n.tree-leaves-back {\n  fill: var(--illustration-leaves-back);\n}\n\n.tree-leaves-front {\n  fill: var(--illustration-leaves-front);\n}\n\n.page-title {\n  margin: 0.5rem 0 0.25rem;\n  color: var(--text-success-secondary);\n  font-size: 1.75rem;\n  line-height: 1.2;\n}\n\n.page-text {\n  margin: 0;\n  color: var(--text-neutral-secondary);\n  font-size: var(--text-body-md);\n}\n\n.button-zone {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  width: 100%;\n  min-height: 13rem;\n  margin-block-start: 1.5rem;\n}\n\n.page-button {\n  display: inline-block;\n  max-width: 100%;\n  min-height: 3rem;\n  padding: 0.625rem 1.75rem;\n  border-radius: var(--shape-sm);\n  background-color: var(--background-brand-primary);\n  color: var(--text-neutral-white-fixed);\n  font-size: var(--text-body-md);\n  font-weight: 600;\n  line-height: 1.5rem;\n  overflow-wrap: anywhere;\n  transition: transform 0.12s ease;\n}\n\n.page-button.is-pressed {\n  transform: scale(0.96);\n}\n\n.page-button.is-empty {\n  opacity: 0.6;\n}\n\n/* Cursor */\n\n.cursor {\n  position: absolute;\n  top: 0;\n  left: 0;\n  pointer-events: none;\n  opacity: 0;\n  transform: translate(var(--start-x, 0px), var(--start-y, 0px));\n  transition: transform 0.7s ease, opacity 0.2s ease;\n}\n\n.cursor path {\n  fill: var(--text-neutral-primary);\n  stroke: var(--background-neutral-primary);\n  stroke-width: 1.5;\n  stroke-linejoin: round;\n}\n\n.cursor.is-visible {\n  opacity: 1;\n}\n\n.cursor.is-moving {\n  transform: translate(var(--end-x, 0px), var(--end-y, 0px));\n}\n\n.cursor.is-instant {\n  transition: none;\n}\n\n/* Result card */\n\n.result-card {\n  width: min(100%, 20rem);\n  margin-block-start: 1rem;\n  padding: 0.75rem 1rem;\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background-color: var(--background-neutral-primary);\n  box-shadow: var(--shadow-md);\n  text-align: start;\n  opacity: 0;\n  visibility: hidden;\n  transform: translateY(6px);\n  transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.2s;\n}\n\n.result-card.is-open {\n  opacity: 1;\n  visibility: visible;\n  transform: translateY(0);\n  transition-delay: 0s;\n}\n\n.checks {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.check {\n  display: grid;\n  grid-template-columns: auto 1fr auto;\n  align-items: center;\n  gap: 0.5rem;\n  padding-block: 0.25rem;\n}\n\n.check-name {\n  font-weight: 600;\n}\n\n.check .icon-no {\n  display: block;\n}\n\n.check .icon-yes {\n  display: none;\n}\n\n.check.is-yes .icon-yes {\n  display: block;\n}\n\n.check.is-yes .icon-no {\n  display: none;\n}\n\n.icon-yes circle {\n  fill: var(--background-success-primary);\n}\n\n.icon-yes path {\n  fill: none;\n  stroke: var(--text-neutral-white-fixed);\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.icon-no circle {\n  fill: var(--background-neutral-tertiary);\n}\n\n.icon-no path {\n  fill: none;\n  stroke: var(--text-neutral-quaternary);\n  stroke-width: 2;\n  stroke-linecap: round;\n}\n\n.check-state {\n  color: var(--text-warning-secondary);\n}\n\n.check.is-yes .check-state {\n  color: var(--text-success-secondary);\n}\n\n.result-note {\n  margin: 0.5rem 0 0;\n  padding-block-start: 0.5rem;\n  border-block-start: 1px solid var(--border-neutral-primary);\n  color: var(--text-neutral-secondary);\n}\n\n@media (max-width: 640px) {\n  body {\n    padding: 0.5rem;\n  }\n\n  .widget {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .chip,\n  .page-button,\n  .cursor,\n  .result-card {\n    transition: none;\n  }\n}\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Make the ask clear</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"widget\">\n    <h1 class=\"visually-hidden\">Make the ask clear</h1>\n\n    <section class=\"panel controls\" aria-label=\"Button label\">\n      <div class=\"field\">\n        <label for=\"button-label\">Button label</label>\n        <input type=\"text\" id=\"button-label\" maxlength=\"40\" value=\"Click here\" autocomplete=\"off\" spellcheck=\"false\">\n      </div>\n\n      <h2 class=\"overline\" id=\"picks-heading\">Or pick one</h2>\n      <ul class=\"chip-tray\" aria-labelledby=\"picks-heading\">\n        <li><button type=\"button\" class=\"chip\" aria-pressed=\"false\">Learn more</button></li>\n        <li><button type=\"button\" class=\"chip\" aria-pressed=\"false\">Join the cleanup</button></li>\n        <li><button type=\"button\" class=\"chip\" aria-pressed=\"false\">Sign up to plant a tree</button></li>\n        <li><button type=\"button\" class=\"chip\" aria-pressed=\"false\">Help</button></li>\n      </ul>\n    </section>\n\n    <section class=\"panel preview\" aria-label=\"Sample page\">\n      <div class=\"page\">\n        <svg class=\"page-tree\" viewBox=\"0 0 64 80\" width=\"56\" height=\"70\" aria-hidden=\"true\" focusable=\"false\">\n          <rect class=\"tree-trunk\" x=\"28\" y=\"50\" width=\"8\" height=\"26\" rx=\"2\"></rect>\n          <circle class=\"tree-leaves-back\" cx=\"32\" cy=\"30\" r=\"24\"></circle>\n          <circle class=\"tree-leaves-front\" cx=\"24\" cy=\"38\" r=\"16\"></circle>\n          <circle class=\"tree-leaves-front\" cx=\"42\" cy=\"36\" r=\"14\"></circle>\n        </svg>\n        <h2 class=\"page-title\">Save Maple Park</h2>\n        <p class=\"page-text\">Help keep our neighborhood park green.</p>\n\n        <div class=\"button-zone\" id=\"button-zone\">\n          <span class=\"page-button\" id=\"page-button\">Click here</span>\n\n          <svg class=\"cursor\" id=\"cursor\" viewBox=\"0 0 24 24\" width=\"28\" height=\"28\" aria-hidden=\"true\" focusable=\"false\">\n            <path d=\"M5 3 L19 11 L12.8 12.6 L9.6 19 Z\"></path>\n          </svg>\n\n          <div class=\"result-card\" id=\"result-card\" aria-hidden=\"true\">\n            <ul class=\"checks\">\n              <li class=\"check\" id=\"check-verb\">\n                <svg class=\"check-icon icon-yes\" viewBox=\"0 0 20 20\" width=\"20\" height=\"20\" aria-hidden=\"true\" focusable=\"false\">\n                  <circle cx=\"10\" cy=\"10\" r=\"9\"></circle>\n                  <path d=\"M5.5 10.4 L8.7 13.4 L14.5 7\"></path>\n                </svg>\n                <svg class=\"check-icon icon-no\" viewBox=\"0 0 20 20\" width=\"20\" height=\"20\" aria-hidden=\"true\" focusable=\"false\">\n                  <circle cx=\"10\" cy=\"10\" r=\"9\"></circle>\n                  <path d=\"M6 10 L14 10\"></path>\n                </svg>\n                <span class=\"check-name\">Clear verb</span>\n                <strong class=\"check-state\"></strong>\n              </li>\n              <li class=\"check\" id=\"check-step\">\n                <svg class=\"check-icon icon-yes\" viewBox=\"0 0 20 20\" width=\"20\" height=\"20\" aria-hidden=\"true\" focusable=\"false\">\n                  <circle cx=\"10\" cy=\"10\" r=\"9\"></circle>\n                  <path d=\"M5.5 10.4 L8.7 13.4 L14.5 7\"></path>\n                </svg>\n                <svg class=\"check-icon icon-no\" viewBox=\"0 0 20 20\" width=\"20\" height=\"20\" aria-hidden=\"true\" focusable=\"false\">\n                  <circle cx=\"10\" cy=\"10\" r=\"9\"></circle>\n                  <path d=\"M6 10 L14 10\"></path>\n                </svg>\n                <span class=\"check-name\">Next step</span>\n                <strong class=\"check-state\"></strong>\n              </li>\n            </ul>\n            <p class=\"result-note\" id=\"result-note\"></p>\n          </div>\n        </div>\n      </div>\n      <p class=\"visually-hidden\" id=\"live-region\" role=\"status\" aria-live=\"polite\"></p>\n    </section>\n  </main>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const TYPE_DELAY = 700;\nconst CURSOR_TRAVEL = 750;\nconst PRESS_TIME = 160;\nconst START_OFFSET = { x: 110, y: 90 };\nconst CURSOR_TIP = { x: 5, y: 3 };\n\nconst ACTION_VERBS = [\n  'add', 'adopt', 'apply', 'ask', 'book', 'bring', 'build', 'buy', 'call', 'choose', 'claim',\n  'clean', 'contact', 'count', 'create', 'discover', 'donate', 'download', 'email', 'explore',\n  'find', 'follow', 'fund', 'get', 'give', 'grow', 'help', 'join', 'learn', 'make', 'meet',\n  'order', 'pick', 'pitch', 'plan', 'plant', 'play', 'pledge', 'protect', 'read', 'register',\n  'reserve', 'rescue', 'restore', 'review', 'rsvp', 'save', 'see', 'send', 'share', 'shop',\n  'show', 'sign', 'speak', 'spread', 'stand', 'start', 'subscribe', 'support', 'take', 'tell',\n  'tour', 'try', 'visit', 'volunteer', 'vote', 'walk', 'watch'\n];\nconst WEAK_VERBS = ['click', 'press', 'tap', 'submit', 'go', 'enter', 'continue', 'next', 'proceed'];\nconst SKIP_START_WORDS = ['please', \"let's\", 'lets', 'just'];\nconst FILLER_WORDS = [\n  'a', 'an', 'the', 'to', 'for', 'of', 'in', 'on', 'with', 'and', 'our', 'my', 'your', 'us',\n  'up', 'out', 'now', 'today'\n];\nconst VAGUE_WORDS = [\n  'it', 'this', 'that', 'here', 'there', 'more', 'info', 'started', 'something', 'stuff',\n  'thing', 'things', 'details'\n];\n\nconst NOTES = {\n  empty: 'Type a label for the button.',\n  unknown: 'I could not spot an action word at the start. Try a verb like join, plant, or donate.',\n  noStep: 'Good verb. Add what happens next, like “Join the cleanup”.',\n  clear: 'Clear! The verb says what to do and the rest says what happens next.'\n};\n\nfunction getWords(label) {\n  return label\n    .toLowerCase()\n    .replace(/[’]/g, \"'\")\n    .replace(/[^a-z0-9$'\\s-]/g, ' ')\n    .split(/\\s+/)\n    .filter(Boolean);\n}\n\nfunction evaluateLabel(label) {\n  const words = getWords(label);\n  while (words.length > 0 && SKIP_START_WORDS.includes(words[0])) {\n    words.shift();\n  }\n  if (words.length === 0) {\n    return { hasVerb: false, hasStep: false, note: NOTES.empty };\n  }\n\n  const verb = words[0];\n  if (WEAK_VERBS.includes(verb)) {\n    return {\n      hasVerb: false,\n      hasStep: false,\n      note: `Words like “${verb}” describe the button, not what happens next. Try a verb like join or plant.`\n    };\n  }\n  if (!ACTION_VERBS.includes(verb)) {\n    return { hasVerb: false, hasStep: false, note: NOTES.unknown };\n  }\n\n  const objectWords = words\n    .slice(1)\n    .map((word) => word.replace(/'s$/, ''))\n    .filter((word) => word && !FILLER_WORDS.includes(word));\n  const specificWords = objectWords.filter((word) => !VAGUE_WORDS.includes(word));\n\n  if (specificWords.length > 0) {\n    return { hasVerb: true, hasStep: true, note: NOTES.clear };\n  }\n  if (objectWords.length > 0) {\n    return {\n      hasVerb: true,\n      hasStep: false,\n      note: `Good verb, but “${objectWords[0]}” does not say what happens next.`\n    };\n  }\n  return { hasVerb: true, hasStep: false, note: NOTES.noStep };\n}\n\nfunction init() {\n  const input = document.getElementById('button-label');\n  const pageButton = document.getElementById('page-button');\n  const zone = document.getElementById('button-zone');\n  const cursor = document.getElementById('cursor');\n  const card = document.getElementById('result-card');\n  const note = document.getElementById('result-note');\n  const checkVerb = document.getElementById('check-verb');\n  const checkStep = document.getElementById('check-step');\n  const liveRegion = document.getElementById('live-region');\n  const chips = document.querySelectorAll('.chip');\n\n  if (!input || !pageButton || !zone || !cursor || !card || !note || !checkVerb || !checkStep || !liveRegion) {\n    document.body.textContent = 'This activity could not load. Try refreshing the page.';\n    return;\n  }\n\n  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n  let typeTimer = null;\n  let sequenceTimers = [];\n\n  function clearTimers() {\n    window.clearTimeout(typeTimer);\n    sequenceTimers.forEach((timer) => window.clearTimeout(timer));\n    sequenceTimers = [];\n  }\n\n  function later(callback, delay) {\n    sequenceTimers.push(window.setTimeout(callback, delay));\n  }\n\n  function setCheck(row, isYes) {\n    row.classList.toggle('is-yes', isYes);\n    row.querySelector('.check-state').textContent = isYes ? 'Yes' : 'Not yet';\n  }\n\n  function updatePage() {\n    const label = input.value.trim();\n    pageButton.textContent = label || 'Your label';\n    pageButton.classList.toggle('is-empty', !label);\n    chips.forEach((chip) => {\n      const isMatch = chip.textContent.trim().toLowerCase() === label.toLowerCase();\n      chip.setAttribute('aria-pressed', String(isMatch));\n    });\n  }\n\n  function placeCursor() {\n    const zoneBox = zone.getBoundingClientRect();\n    const buttonBox = pageButton.getBoundingClientRect();\n    const scale = cursor.getBoundingClientRect().width / 24 || 1;\n    const endX = buttonBox.left - zoneBox.left + buttonBox.width * 0.62 - CURSOR_TIP.x * scale;\n    const endY = buttonBox.top - zoneBox.top + buttonBox.height * 0.55 - CURSOR_TIP.y * scale;\n    cursor.style.setProperty('--end-x', `${endX}px`);\n    cursor.style.setProperty('--end-y', `${endY}px`);\n    cursor.style.setProperty('--start-x', `${endX + START_OFFSET.x}px`);\n    cursor.style.setProperty('--start-y', `${endY + START_OFFSET.y}px`);\n  }\n\n  function hideResult() {\n    clearTimers();\n    card.classList.remove('is-open');\n    pageButton.classList.remove('is-pressed');\n    cursor.classList.add('is-instant');\n    cursor.classList.remove('is-visible', 'is-moving');\n    void cursor.offsetWidth;\n    cursor.classList.remove('is-instant');\n  }\n\n  function openResult(label, result) {\n    card.classList.add('is-open');\n    liveRegion.textContent = `Button says “${label}”. ${result.note}`;\n  }\n\n  function showResult() {\n    hideResult();\n    const label = input.value.trim();\n    const result = evaluateLabel(label);\n\n    setCheck(checkVerb, result.hasVerb);\n    setCheck(checkStep, result.hasStep);\n    note.textContent = result.note;\n\n    if (!label) {\n      liveRegion.textContent = result.note;\n      return;\n    }\n\n    cursor.classList.add('is-instant');\n    placeCursor();\n\n    if (reducedMotion.matches) {\n      cursor.classList.add('is-visible', 'is-moving');\n      void cursor.offsetWidth;\n      cursor.classList.remove('is-instant');\n      openResult(label, result);\n      return;\n    }\n\n    void cursor.offsetWidth;\n    cursor.classList.remove('is-instant');\n    cursor.classList.add('is-visible', 'is-moving');\n\n    later(() => pageButton.classList.add('is-pressed'), CURSOR_TRAVEL);\n    later(() => {\n      pageButton.classList.remove('is-pressed');\n      openResult(label, result);\n    }, CURSOR_TRAVEL + PRESS_TIME);\n  }\n\n  input.addEventListener('input', () => {\n    updatePage();\n    hideResult();\n    typeTimer = window.setTimeout(showResult, TYPE_DELAY);\n  });\n\n  input.addEventListener('keydown', (event) => {\n    if (event.key === 'Enter') {\n      event.preventDefault();\n      showResult();\n    }\n  });\n\n  chips.forEach((chip) => {\n    chip.addEventListener('click', () => {\n      input.value = chip.textContent.trim();\n      updatePage();\n      showResult();\n    });\n  });\n\n  window.addEventListener('resize', () => {\n    if (!cursor.classList.contains('is-visible')) {\n      return;\n    }\n    cursor.classList.add('is-instant');\n    placeCursor();\n    void cursor.offsetWidth;\n    cursor.classList.remove('is-instant');\n  });\n\n  updatePage();\n  later(showResult, 600);\n}\n\ninit();\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
