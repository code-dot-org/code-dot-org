<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-10-16T21:44:38.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": true,
    "start_sources": {
      "folders": {
      },
      "files": {
        "614d78a4-7064-4869-9bf9-5868dea01aaf": {
          "id": "614d78a4-7064-4869-9bf9-5868dea01aaf",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Clear Call-to-Action Widget</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <div class=\"container\">\n        <h1>Make the Ask Clear</h1>\n\n        <div class=\"sample-page-section\">\n            <h2>Your Sample Page</h2>\n            <div class=\"simulated-page-content\">\n                <p>Ready to discover something amazing?</p>\n                <button id=\"ctaButton\">Click Here</button>\n            </div>\n        </div>\n\n        <div class=\"control-section\">\n            <h2>Try a New Button Label</h2>\n            <p>Make sure your button tells visitors what to do (a verb) and what happens next (a step).</p>\n            <input type=\"text\" id=\"newLabelInput\" placeholder=\"e.g., 'Find My Clubs'\">\n            <button id=\"applyLabelBtn\">Apply Label</button>\n            <div id=\"feedbackMessage\" class=\"feedback\"></div>\n        </div>\n    </div>\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "ce7eeba8-e833-4ce6-b586-933d0e0c01f7": {
          "id": "ce7eeba8-e833-4ce6-b586-933d0e0c01f7",
          "name": "style.css",
          "contents": "body {\n    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n    margin: 0;\n    padding: 20px;\n    background-color: #f0f4f8;\n    color: #333;\n    display: flex;\n    justify-content: center;\n    align-items: flex-start;\n    min-height: 100vh;\n    box-sizing: border-box;\n}\n\n.container {\n    background-color: #ffffff;\n    border-radius: 10px;\n    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);\n    max-width: 700px;\n    width: 100%;\n    padding: 30px;\n    text-align: center;\n}\n\nh1 {\n    color: #2c3e50;\n    margin-top: 0;\n    margin-bottom: 30px;\n    font-size: 2.2em;\n}\n\nh2 {\n    color: #34495e;\n    font-size: 1.5em;\n    margin-top: 20px;\n    margin-bottom: 15px;\n    border-bottom: 1px solid #eceff1;\n    padding-bottom: 10px;\n}\n\n.sample-page-section {\n    border: 1px solid #dee2e6;\n    border-radius: 8px;\n    padding: 20px;\n    margin-bottom: 30px;\n    background-color: #e3f2fd; /* Light blue background for sample page */\n}\n\n.simulated-page-content {\n    background-color: #ffffff;\n    padding: 25px;\n    border-radius: 5px;\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);\n}\n\n.simulated-page-content p {\n    font-size: 1.1em;\n    margin-bottom: 25px;\n}\n\n#ctaButton {\n    background-color: #007bff;\n    color: white;\n    padding: 15px 30px;\n    border: none;\n    border-radius: 8px;\n    font-size: 1.2em;\n    cursor: pointer;\n    transition: background-color 0.3s ease, transform 0.2s ease;\n    box-shadow: 0 4px 10px rgba(0, 123, 255, 0.3);\n}\n\n#ctaButton:hover {\n    background-color: #0056b3;\n    transform: translateY(-2px);\n}\n\n.control-section {\n    border: 1px solid #dee2e6;\n    border-radius: 8px;\n    padding: 20px;\n    background-color: #f8f9fa;\n}\n\n.control-section p {\n    font-size: 0.95em;\n    color: #6c757d;\n    margin-bottom: 20px;\n}\n\n#newLabelInput {\n    width: calc(100% - 130px); /* Adjust width considering button */\n    padding: 12px;\n    border: 1px solid #ced4da;\n    border-radius: 5px;\n    font-size: 1em;\n    margin-right: 10px;\n    box-sizing: border-box;\n}\n\n#applyLabelBtn {\n    background-color: #28a745; /* Green */\n    color: white;\n    padding: 12px 20px;\n    border: none;\n    border-radius: 5px;\n    font-size: 1em;\n    cursor: pointer;\n    transition: background-color 0.2s ease;\n}\n\n#applyLabelBtn:hover {\n    background-color: #218838;\n}\n\n.feedback {\n    margin-top: 20px;\n    padding: 15px;\n    border-radius: 8px;\n    font-weight: bold;\n    min-height: 40px; /* Ensure space for message */\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    color: #333; /* Default text color */\n    background-color: #f8f9fa; /* Default background */\n    border: 1px dashed #ced4da;\n}\n\n.feedback.good {\n    background-color: #d4edda; /* Light green */\n    color: #155724; /* Dark green */\n    border-color: #28a745;\n}\n\n.feedback.neutral {\n    background-color: #fff3cd; /* Light yellow */\n    color: #856404; /* Dark yellow */\n    border-color: #ffc107;\n}\n\n.feedback.bad {\n    background-color: #f8d7da; /* Light red */\n    color: #721c24; /* Dark red */\n    border-color: #dc3545;\n}",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "86d919a1-9d30-49fb-a74a-68f82416e49a": {
          "id": "86d919a1-9d30-49fb-a74a-68f82416e49a",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const ctaButton = document.getElementById('ctaButton');\n    const newLabelInput = document.getElementById('newLabelInput');\n    const applyLabelBtn = document.getElementById('applyLabelBtn');\n    const feedbackMessage = document.getElementById('feedbackMessage');\n\n    const verbs = ['get', 'find', 'start', 'explore', 'learn', 'sign up', 'discover', 'join', 'view', 'download', 'buy', 'shop', 'read'];\n    const nextSteps = ['now', 'here', 'today', 'more', 'details', 'free', 'account', 'club', 'course', 'product', 'list', 'website'];\n\n    function analyzeLabel(label) {\n        if (!label.trim()) {\n            return {\n                message: \"Please enter some text for your button!\",\n                type: \"bad\"\n            };\n        }\n\n        const lowerLabel = label.toLowerCase();\n        const hasVerb = verbs.some(verb => lowerLabel.includes(verb));\n        const hasNextStep = nextSteps.some(step => lowerLabel.includes(step));\n\n        if (hasVerb && hasNextStep) {\n            return {\n                message: `Excellent! \"${label}\" clearly tells users what to do and what they'll get.`,\n                type: \"good\"\n            };\n        } else if (hasVerb) {\n            return {\n                message: `Good start! \"${label}\" has a clear action. Can you add what happens next?`,\n                type: \"neutral\"\n            };\n        } else if (hasNextStep) {\n            return {\n                message: `You've got a next step in \"${label}\". What action should the user take?`,\n                type: \"neutral\"\n            };\n        } else {\n            return {\n                message: `\"${label}\" could be clearer. Try to include a verb (like \"Get\" or \"Find\") and a next step (like \"Now\" or \"Details\").`,\n                type: \"bad\"\n            };\n        }\n    }\n\n    applyLabelBtn.addEventListener('click', () => {\n        const newLabel = newLabelInput.value;\n        ctaButton.textContent = newLabel;\n        const feedback = analyzeLabel(newLabel);\n        feedbackMessage.textContent = feedback.message;\n        feedbackMessage.className = `feedback ${feedback.type}`; // Apply CSS class based on type\n    });\n\n    // Allow Enter key to apply label\n    newLabelInput.addEventListener('keypress', (event) => {\n        if (event.key === 'Enter') {\n            applyLabelBtn.click();\n        }\n    });\n\n    // Initial feedback\n    feedbackMessage.textContent = \"Start by typing a new label for the button.\";\n    feedbackMessage.className = \"feedback\";\n});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
        "614d78a4-7064-4869-9bf9-5868dea01aaf",
        "ce7eeba8-e833-4ce6-b586-933d0e0c01f7",
        "86d919a1-9d30-49fb-a74a-68f82416e49a"
      ]
    },
    "long_instructions": "TODOs:\r\n- examine the sample page and the vague \"Click Here\" button\r\n- locate the input field below \"Try a New Button Label\"\r\n- type a new label into the input field that describes an action and a next step\r\n- click \"Apply Label\" to see your new button text in action\r\n- read the feedback message to understand if your label is clear\r\n- try a few more options, making sure each has a verb and a next step\r\n- aim for a label that earns positive feedback",
