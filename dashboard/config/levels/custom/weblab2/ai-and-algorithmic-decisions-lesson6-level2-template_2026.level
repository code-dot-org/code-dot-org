      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Theme Park Ride Board</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <h1>Theme Park Ride Board</h1>\n  <p>Select a ride and check its status.</p>\n\n  <div class=\"section\">\n    <h2>Ride Wait Time</h2>\n    <button id=\"coasterBtn\">Roller Coaster</button>\n    <button id=\"wheelBtn\">Ferris Wheel</button>\n    <p id=\"waitTimeOutput\">Wait Time: --</p>\n  </div>\n\n  <div class=\"section\">\n    <h2>Ride Status</h2>\n    <button id=\"openBtn\">Open</button>\n    <button id=\"delayedBtn\">Delayed</button>\n    <p id=\"statusOutput\">Status: --</p>\n  </div>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: Arial, sans-serif;\n  text-align: center;\n  margin: 40px;\n  background-color: #f4f6f8;\n}\n\nh1 {\n  margin-bottom: 5px;\n}\n\np {\n  color: #555;\n}\n\n.section {\n  background: white;\n  padding: 20px;\n  margin: 20px auto;\n  width: 320px;\n  border-radius: 12px;\n  box-shadow: 0 4px 10px rgba(0,0,0,0.08);\n}\n\nbutton {\n  margin: 6px;\n  padding: 10px 16px;\n  font-size: 14px;\n  cursor: pointer;\n  border: none;\n  border-radius: 8px;\n  background-color: #2d89ef;\n  color: white;\n}\n\nbutton:hover {\n  background-color: #1b5fbf;\n}\n\n#waitTimeOutput,\n#statusOutput {\n  margin-top: 15px;\n  font-weight: bold;\n  font-size: 18px;\n  padding: 8px;\n  border-radius: 6px;\n  background-color: #eef3f8;\n}",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "prompt.md",
          "contents": "# Function: <verb-first name here>\n\n# What it does\nDescribe the main purpose of this function in one sentence:\n\n# Inputs\nName each parameter:\n\n# What it changes\nWhat variables get updated? \nWhat changes appear on screen?",
          "folderId": "0",
          "active": true
        },
        "5": {
          "id": "5",
          "name": "script.js",
          "contents": "// --- SELECT ELEMENTS ---\nconst waitTimeOutput = document.getElementById(\"waitTimeOutput\");\nconst statusOutput = document.getElementById(\"statusOutput\");\n\nconst coasterBtn = document.getElementById(\"coasterBtn\");\nconst wheelBtn = document.getElementById(\"wheelBtn\");\n\nconst openBtn = document.getElementById(\"openBtn\");\nconst delayedBtn = document.getElementById(\"delayedBtn\");\n\n// --- APP STATE ---\nlet waitTime = \"\";\nlet rideStatus = \"\";\n\n// --- FUNCTION DEFINITIONS ---\nconst updateWaitTime = (rideType) => {\n  \n};\n\nconst updateRideStatus = (statusType) => {\n\n};\n\n// --- EVENT LISTENERS ---\ncoasterBtn.addEventListener(\"click\", () => updateWaitTime(\"coaster\"));\nwheelBtn.addEventListener(\"click\", () => updateWaitTime(\"wheel\"));\n\nopenBtn.addEventListener(\"click\", () => updateRideStatus(\"open\"));\ndelayedBtn.addEventListener(\"click\", () => updateRideStatus(\"delayed\"));\n\n// --- STARTING DISPLAY ---\nwaitTimeOutput.textContent = \"Wait Time: --\";\nstatusOutput.textContent = \"Status: --\";",
          "folderId": "0",
          "active": false
        }
      },
