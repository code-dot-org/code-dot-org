      "files": {
        "b9b8f636-f1ba-44e2-a98d-8a7f2a35a880": {
          "id": "b9b8f636-f1ba-44e2-a98d-8a7f2a35a880",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Decision Wheel Widget</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <h1>Sample Decision Wheel</h1>\n    <div id=\"promptDisplay\">Current Prompt: <span id=\"currentPrompt\">A decision wheel.</span></div>\n    <div class=\"controls\">\n        <button id=\"toggleDetail1\">Add Detail: Specific Color</button>\n        <button id=\"toggleDetail2\">Add Detail: Specific Category</button>\n        <button id=\"toggleDetail3\">Add Detail: More Segments</button>\n    </div>\n    <div id=\"decisionWheel\">\n        <p>A plain section</p>\n    </div>\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "c80e3cae-6280-4f5a-a10e-dc6823ff1b9f": {
          "id": "c80e3cae-6280-4f5a-a10e-dc6823ff1b9f",
          "name": "style.css",
          "contents": "body {\n    font-family: Arial, sans-serif;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding: 20px;\n    background-color: #f0f0f0;\n}\n\nh1 {\n    color: #333;\n}\n\n#promptDisplay {\n    margin: 20px 0;\n    font-size: 1.1em;\n    color: #555;\n}\n\n#currentPrompt {\n    font-weight: bold;\n}\n\n.controls {\n    margin-bottom: 20px;\n}\n\nbutton {\n    padding: 10px 15px;\n    margin: 0 5px;\n    border: none;\n    background-color: #007bff;\n    color: white;\n    border-radius: 5px;\n    cursor: pointer;\n    transition: background-color 0.3s ease;\n}\n\nbutton:hover {\n    background-color: #0056b3;\n}\n\n#decisionWheel {\n    width: 250px;\n    height: 250px;\n    border: 2px dashed #ccc;\n    border-radius: 50%;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    font-size: 1.2em;\n    color: #888;\n    background-color: #fff;\n    text-align: center;\n    transition: all 0.5s ease-in-out;\n}",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "5647f3ba-e84f-42a6-a6c2-fba6036cf7f5": {
          "id": "5647f3ba-e84f-42a6-a6c2-fba6036cf7f5",
          "name": "script.js",
          "contents": "// This script serves as a placeholder. The Web Lab widget's logic\n// will simulate changes to the page based on student actions, \n// demonstrating how prompt details affect the outcome.\nconsole.log(\"Decision Wheel Widget loaded. Student will observe changes simulated by the widget.\");",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
