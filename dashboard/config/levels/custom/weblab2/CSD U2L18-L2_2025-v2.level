          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    \n    <!-- instruction paragraph -->\n    <p>Add the \"link\" and \"visited\" pseudo-classes to this link in the CSS file:</p> \n    \n    <!-- hyperlink to another page -->\n    <a href=\"another-page.html\">Another Page</a>\n\n\n\n  </body>\n</html>",
          "active": false,
