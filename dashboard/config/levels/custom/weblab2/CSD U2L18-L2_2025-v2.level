          "name": "style.css",
          "language": "css",
          "contents": "/* 1) Add a rule to style the \"link\" state of the <a> element. */\n\n\n\n\n/* 2) Add a rule to style the \"visited\" state of the <a> element. */\n\n\n\n/* paragraph style */\np {\n  font-family: sans-serif;\n  font-size: 24px;\n  background-color: yellow;\n}",
          "folderId": "0",
          "active": true
        },
