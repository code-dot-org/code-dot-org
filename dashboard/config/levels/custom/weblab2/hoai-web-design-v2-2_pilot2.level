      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false
    },
    "ai_tutor_prompt_settings": {
      "answerTypes": [
        "buildCSS",
        "buildHTML"
      ],
      "answerTypeCustomizations": {
        "explainCode": "- Limit responses to just HTML. Do not mention CSS or Javascript.",
        "buildCSS": "- Do NOT use separate file name. Put all css in a `<style>` tag in the head of the index.html file\n- Do NOT use relative units. Use px values.\n- You should generate both HTML and CSS at the same time\n- Keep explanations sparse and simple, acknowledging the work that has been done. Do NOT list specific HTML tags or CSS rules that have been changed. Do NOT explain how HTML or CSS works.\n- Once the user has made at least one change to the webpage, instruct them to press Continue rather than continuing to iterate on this webpage.",
        "buildHTML": "- Do NOT link a style.css file\n- Do NOT use IDs or class on elements\n- Do NOT generate links or buttons\n- Keep explanations sparse and simple, acknowledging the work that has been done. Do NOT list specific HTML tags or CSS rules that have been changed. Do NOT explain how HTML or CSS works.\n- Once the user has made at least one change to the webpage, instruct them to press Continue rather than continuing to iterate on this webpage."
      }
