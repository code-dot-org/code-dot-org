        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Now Playing</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <h1>🎬 Now Playing</h1>\n\n  <label>Choose a Show:</label>\n  <select id=\"showSelect\">\n    <option value=\"Midnight Case\">Midnight Case</option>\n    <option value=\"Sunny Days\">Sunny Days</option>\n    <option value=\"Wild Earth\">Wild Earth</option>\n    <option value=\"Fast Track\">Fast Track</option>\n  </select>\n\n  <br><br>\n\n  <label>Choose a Viewing Mode:</label>\n  <select id=\"modeSelect\">\n    <option value=\"HD\">HD</option>\n    <option value=\"4K\">4K</option>\n    <option value=\"Subtitled\">Subtitled</option>\n    <option value=\"Dubbed\">Dubbed</option>\n  </select>\n\n  <br><br>\n\n  <button id=\"watchBtn\">Watch Now</button>\n\n  <p id=\"output\"></p>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// --- SELECT ELEMENTS ---\nconst showSelect = document.getElementById(\"showSelect\");\nconst modeSelect = document.getElementById(\"modeSelect\");\nconst watchBtn = document.getElementById(\"watchBtn\");\nconst outputElement = document.getElementById(\"output\");\n\n// --- FUNCTION WITH PARAMETERS ---\n// Write a function that takes in two parameters.\n// Choose a clear name based on what your function does.\n// Use the parameters to build a “Now Playing” message.\n// Display the message on screen.\n\n\n\n\n// --- EVENT LISTENER ---\nwatchBtn.addEventListener(\"click\", () => {\n  const selectedShow = showSelect.value;\n  const selectedMode = modeSelect.value;\n\n  // Call your function here\n  \n});",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: Arial, sans-serif;\n  text-align: center;\n  margin-top: 50px;\n}\n\nselect, button {\n  padding: 6px 10px;\n  margin: 5px;\n  font-size: 16px;\n}\n\n#output {\n  margin-top: 20px;\n  font-weight: bold;\n  font-size: 18px;\n}",
          "folderId": "0",
          "active": false
        },
