        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Game Stats</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <h1>🎮 Game Actions</h1>\n\n  <button id=\"attackBtn\">Attack</button>\n  <button id=\"healBtn\">Heal</button>\n  <button id=\"bonusBtn\">Bonus</button>\n\n  <p id=\"output\"></p>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: Arial, sans-serif;\n  text-align: center;\n  margin-top: 50px;\n}\n\nbutton {\n  margin: 10px;\n  padding: 8px 16px;\n  font-size: 16px;\n  cursor: pointer;\n}\n\n#output {\n  margin-top: 20px;\n  font-weight: bold;\n  font-size: 20px;\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "// --- SELECT ELEMENTS ---\nconst outputElement = document.getElementById(\"output\");\nconst attackBtn = document.getElementById(\"attackBtn\");\nconst healBtn = document.getElementById(\"healBtn\");\nconst bonusBtn = document.getElementById(\"bonusBtn\");\n\n// --- GAME VARIABLES ---\nlet score = 0;\nlet health = 100;\n\n// --- PARAMETERIZED FUNCTION ---\n\n\n// --- EVENT LISTENERS ---\nattackBtn.addEventListener(\"click\", () => updateStats(\"attack\"));\nhealBtn.addEventListener(\"click\", () => updateStats(\"heal\"));\nbonusBtn.addEventListener(\"click\", () => updateStats(\"bonus\"));\n\n// --- INITIAL DISPLAY ---\nupdateStats();",
          "folderId": "0",
          "active": true
        }
      },
