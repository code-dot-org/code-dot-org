        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>All About Otters!</title>\n  </head>\n  <body>\n    <header>\n      <h1>Welcome to the Otter Zone!</h1>\n      <img src=\"otter.jpg\" alt=\"A cute brown otter floating in a river\">\n      <p>Image by Michael Baird photography</p>\n    </header>\n\n    <main>\n      <section>\n        <h2>Cool Otter Facts!</h2>\n        <ul>\n          <li>Did you know otters hold hands when they sleep so they don't drift apart? Awww!</li>\n          <li>They can also hold their breath for a loooong time underwater!</li>\n        </ul>\n      </section>\n\n      <section>\n        <h2>Otterly Amazing Swimmers!</h2>\n        <p>Otters are super speedy in the water! They use their powerful tails and webbed feet to zoom around.</p>\n        <p>They can dive deep to find yummy snacks like fish and crabs.</p>\n      </section>\n\n      <section>\n        <h2>Where in the World are Otters?\n        <p>You can find different kinds of otters all over the globe, from chilly Alaska to sunny Brazil.</p>\n        <p>Some live in rivers, some in coasts, and some even in the open ocean!</p>\n      </section>\n    </main>\n\n    <footer>\n      <p>Thanks for visiting the otter-tastic website!</p>\n    </footer>\n  </body>\n</html>",
          "active": true,
          "folderId": "0"
        },
