    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>AcreWatch</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n<script src=\"script.js\" defer></script>\n</head>\n<body>\n\n<h1 class=\"sr-only\">AcreWatch: one morning at Carter Family Farm</h1>\n\n<svg class=\"sprite\" aria-hidden=\"true\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\">\n\n  <symbol id=\"t-processor\" viewBox=\"0 0 24 24\">\n    <rect x=\"6\" y=\"6\" width=\"12\" height=\"12\" rx=\"2\"/>\n    <rect x=\"9.5\" y=\"9.5\" width=\"5\" height=\"5\" rx=\"1\" fill=\"#FFFFFF\"/>\n    <rect x=\"8.6\" y=\"2.5\" width=\"1.6\" height=\"3\"/><rect x=\"13.8\" y=\"2.5\" width=\"1.6\" height=\"3\"/>\n    <rect x=\"8.6\" y=\"18.5\" width=\"1.6\" height=\"3\"/><rect x=\"13.8\" y=\"18.5\" width=\"1.6\" height=\"3\"/>\n    <rect x=\"2.5\" y=\"8.6\" width=\"3\" height=\"1.6\"/><rect x=\"2.5\" y=\"13.8\" width=\"3\" height=\"1.6\"/>\n    <rect x=\"18.5\" y=\"8.6\" width=\"3\" height=\"1.6\"/><rect x=\"18.5\" y=\"13.8\" width=\"3\" height=\"1.6\"/>\n  </symbol>\n  <symbol id=\"t-storage\" viewBox=\"0 0 24 24\">\n    <ellipse cx=\"12\" cy=\"6\" rx=\"8\" ry=\"3\"/>\n    <path d=\"M4 6v5c0 1.7 3.6 3 8 3s8-1.3 8-3V6c0 1.7-3.6 3-8 3S4 7.7 4 6z\"/>\n    <path d=\"M4 13v5c0 1.7 3.6 3 8 3s8-1.3 8-3v-5c0 1.7-3.6 3-8 3s-8-1.3-8-3z\"/>\n  </symbol>\n  <symbol id=\"t-network\" viewBox=\"0 0 24 24\">\n    <circle cx=\"12\" cy=\"18.5\" r=\"2.4\"/>\n    <path d=\"M6.5 14.2a7.8 7.8 0 0 1 11 0l-1.8 1.8a5.2 5.2 0 0 0-7.4 0z\"/>\n    <path d=\"M3 10.7a12.8 12.8 0 0 1 18 0l-1.8 1.8a10.2 10.2 0 0 0-14.4 0z\"/>\n  </symbol>\n  <symbol id=\"t-memory\" viewBox=\"0 0 24 24\">\n    <path d=\"M3 7h18v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/>\n    <rect x=\"6\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"9.6\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"13.2\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"16.8\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"5\" y=\"19\" width=\"4\" height=\"2.5\" rx=\"1\"/><rect x=\"15\" y=\"19\" width=\"4\" height=\"2.5\" rx=\"1\"/>\n  </symbol>\n\n  <symbol id=\"a-read\" viewBox=\"0 0 24 24\">\n    <rect x=\"10.8\" y=\"8.5\" width=\"2.4\" height=\"13.5\" rx=\"1.2\"/>\n    <path d=\"M12 4.6 15.8 9h-7.6z\"/>\n    <path d=\"M6.6 2.6 8.3 4.3a5.2 5.2 0 0 0 0 7.4l-1.7 1.7a7.6 7.6 0 0 1 0-10.8z\"/>\n    <path d=\"M17.4 2.6 15.7 4.3a5.2 5.2 0 0 1 0 7.4l1.7 1.7a7.6 7.6 0 0 0 0-10.8z\"/>\n  </symbol>\n  <symbol id=\"a-drone\" viewBox=\"0 0 24 24\">\n    <rect x=\"2.6\" y=\"11.1\" width=\"18.8\" height=\"1.8\" rx=\"0.9\" transform=\"rotate(35 12 12)\"/>\n    <rect x=\"2.6\" y=\"11.1\" width=\"18.8\" height=\"1.8\" rx=\"0.9\" transform=\"rotate(-35 12 12)\"/>\n    <circle cx=\"4.3\" cy=\"6.6\" r=\"2.4\"/><circle cx=\"19.7\" cy=\"6.6\" r=\"2.4\"/>\n    <circle cx=\"4.3\" cy=\"17.4\" r=\"2.4\"/><circle cx=\"19.7\" cy=\"17.4\" r=\"2.4\"/>\n    <rect x=\"8.4\" y=\"8.4\" width=\"7.2\" height=\"7.2\" rx=\"2.2\"/>\n    <circle cx=\"12\" cy=\"12\" r=\"1.9\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"a-log\" viewBox=\"0 0 24 24\">\n    <rect x=\"4\" y=\"3\" width=\"16\" height=\"19\" rx=\"2\"/>\n    <rect x=\"8.5\" y=\"1.4\" width=\"7\" height=\"3.4\" rx=\"1.2\"/>\n    <rect x=\"7.5\" y=\"9\" width=\"9\" height=\"1.7\" fill=\"#FFFFFF\"/>\n    <rect x=\"7.5\" y=\"13\" width=\"9\" height=\"1.7\" fill=\"#FFFFFF\"/>\n    <rect x=\"7.5\" y=\"17\" width=\"5.5\" height=\"1.7\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"a-send\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 1.8 18 8h-3.9v7.4h-4.2V8H6z\"/>\n    <path d=\"M3.6 14.6H6v4.2h12v-4.2h2.4V22H3.6z\"/>\n  </symbol>\n  <symbol id=\"a-check\" viewBox=\"0 0 24 24\">\n    <path d=\"M9.4 18.6 3 12.2l2.3-2.3 4.1 4.1L18.7 5l2.3 2.3z\"/>\n  </symbol>\n  <symbol id=\"a-chevron\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 15.6 3.9 7.5a1.6 1.6 0 0 1 2.2-2.2l5.9 5.9 5.9-5.9a1.6 1.6 0 0 1 2.2 2.2z\"/>\n  </symbol>\n  <symbol id=\"a-reset\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 4.5a7.5 7.5 0 1 0 7.2 9.6h-2.7A4.9 4.9 0 1 1 12 7.1a4.8 4.8 0 0 1 3.4 1.4L12.6 11.3H21V2.9l-2.7 2.7A7.5 7.5 0 0 0 12 4.5z\"/>\n  </symbol>\n  <symbol id=\"a-alert\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 2.5 23 21H1z\"/>\n    <rect x=\"11\" y=\"9\" width=\"2\" height=\"6\" rx=\"1\" fill=\"#FFFFFF\"/>\n    <circle cx=\"12\" cy=\"18\" r=\"1.3\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"a-truck\" viewBox=\"0 0 24 24\">\n    <path d=\"M1.5 6h11.5v9H1.5z\"/>\n    <path d=\"M14 8.5h4.2L22 12v3h-8z\"/>\n    <circle cx=\"6\" cy=\"17\" r=\"2.6\"/><circle cx=\"18\" cy=\"17\" r=\"2.6\"/>\n    <circle cx=\"6\" cy=\"17\" r=\"1\" fill=\"#FFFFFF\"/><circle cx=\"18\" cy=\"17\" r=\"1\" fill=\"#FFFFFF\"/>\n  </symbol>\n\n  <symbol id=\"g-app\" viewBox=\"0 0 24 24\">\n    <rect x=\"2.5\" y=\"2.5\" width=\"8\" height=\"8\" rx=\"2\"/>\n    <rect x=\"13.5\" y=\"2.5\" width=\"8\" height=\"8\" rx=\"2\"/>\n    <rect x=\"2.5\" y=\"13.5\" width=\"8\" height=\"8\" rx=\"2\"/>\n    <rect x=\"13.5\" y=\"13.5\" width=\"8\" height=\"8\" rx=\"2\"/>\n  </symbol>\n  <symbol id=\"g-display\" viewBox=\"0 0 24 24\">\n    <rect x=\"2\" y=\"3.5\" width=\"20\" height=\"14\" rx=\"2\"/>\n    <rect x=\"4.5\" y=\"6\" width=\"15\" height=\"9\" fill=\"#FFFFFF\"/>\n    <rect x=\"8\" y=\"19.5\" width=\"8\" height=\"2\" rx=\"1\"/>\n  </symbol>\n  <symbol id=\"g-drone\" viewBox=\"0 0 24 24\">\n    <rect x=\"2.6\" y=\"11.1\" width=\"18.8\" height=\"1.8\" rx=\"0.9\" transform=\"rotate(35 12 12)\"/>\n    <rect x=\"2.6\" y=\"11.1\" width=\"18.8\" height=\"1.8\" rx=\"0.9\" transform=\"rotate(-35 12 12)\"/>\n    <circle cx=\"4.3\" cy=\"6.6\" r=\"2.4\"/><circle cx=\"19.7\" cy=\"6.6\" r=\"2.4\"/>\n    <circle cx=\"4.3\" cy=\"17.4\" r=\"2.4\"/><circle cx=\"19.7\" cy=\"17.4\" r=\"2.4\"/>\n    <rect x=\"8.4\" y=\"8.4\" width=\"7.2\" height=\"7.2\" rx=\"2.2\"/>\n    <circle cx=\"12\" cy=\"12\" r=\"1.9\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"g-storage\" viewBox=\"0 0 24 24\">\n    <ellipse cx=\"12\" cy=\"6\" rx=\"8\" ry=\"3\"/>\n    <path d=\"M4 6v5c0 1.7 3.6 3 8 3s8-1.3 8-3V6c0 1.7-3.6 3-8 3S4 7.7 4 6z\"/>\n    <path d=\"M4 13v5c0 1.7 3.6 3 8 3s8-1.3 8-3v-5c0 1.7-3.6 3-8 3s-8-1.3-8-3z\"/>\n  </symbol>\n  <symbol id=\"g-network\" viewBox=\"0 0 24 24\">\n    <rect x=\"10.6\" y=\"9\" width=\"2.8\" height=\"13\" rx=\"1\"/>\n    <path d=\"M12 2a7 7 0 0 0-7 7h2.6A4.4 4.4 0 0 1 12 4.6z\"/>\n    <path d=\"M12 2a7 7 0 0 1 7 7h-2.6A4.4 4.4 0 0 0 12 4.6z\"/>\n    <circle cx=\"12\" cy=\"8\" r=\"2.2\"/>\n  </symbol>\n  <symbol id=\"g-processing\" viewBox=\"0 0 24 24\">\n    <path d=\"M6.6 20A5 5 0 0 1 6 10a6.4 6.4 0 0 1 12.1-1.7A5.1 5.1 0 0 1 17.6 20z\"/>\n    <rect x=\"8.7\" y=\"11.6\" width=\"6.6\" height=\"6.6\" rx=\"1.4\" fill=\"#FFFFFF\"/>\n    <rect x=\"10.5\" y=\"13.4\" width=\"3\" height=\"3\" rx=\"0.7\"/>\n  </symbol>\n  <symbol id=\"g-battery\" viewBox=\"0 0 24 24\">\n    <rect x=\"2\" y=\"6\" width=\"17\" height=\"12\" rx=\"2.4\"/>\n    <rect x=\"20\" y=\"10\" width=\"2.6\" height=\"4\" rx=\"1\"/>\n    <rect x=\"4.4\" y=\"8.4\" width=\"6\" height=\"7.2\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"g-settings\" viewBox=\"0 0 24 24\">\n    <rect x=\"2\" y=\"4.6\" width=\"20\" height=\"2.2\" rx=\"1.1\"/>\n    <rect x=\"2\" y=\"10.9\" width=\"20\" height=\"2.2\" rx=\"1.1\"/>\n    <rect x=\"2\" y=\"17.2\" width=\"20\" height=\"2.2\" rx=\"1.1\"/>\n    <circle cx=\"8\" cy=\"5.7\" r=\"3\"/><circle cx=\"16\" cy=\"12\" r=\"3\"/><circle cx=\"10\" cy=\"18.3\" r=\"3\"/>\n    <circle cx=\"8\" cy=\"5.7\" r=\"1.3\" fill=\"#FFFFFF\"/><circle cx=\"16\" cy=\"12\" r=\"1.3\" fill=\"#FFFFFF\"/>\n    <circle cx=\"10\" cy=\"18.3\" r=\"1.3\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"g-fields\" viewBox=\"0 0 24 24\">\n    <path d=\"M1.4 20.4 7.6 4.6h8.8l6.2 15.8z\"/>\n    <path d=\"M10.6 4.6h1.3l-1.9 15.8H8.4z\" fill=\"#FFFFFF\"/>\n    <path d=\"M13.4 4.6h1.3l2.2 15.8h-1.6z\" fill=\"#FFFFFF\"/>\n  </symbol>\n\n  <symbol id=\"f-sweetpotato\" viewBox=\"0 0 48 48\">\n    <ellipse cx=\"24\" cy=\"30\" rx=\"16\" ry=\"10\" transform=\"rotate(-18 24 30)\"/>\n    <circle cx=\"16\" cy=\"32\" r=\"1.8\" fill=\"#FFFFFF\"/>\n    <circle cx=\"25\" cy=\"26\" r=\"1.8\" fill=\"#FFFFFF\"/>\n    <circle cx=\"31\" cy=\"32\" r=\"1.6\" fill=\"#FFFFFF\"/>\n    <path d=\"M33 15c4-4 10-4 12-1-4 0-7 2-8 6z\"/>\n    <path d=\"M31 17c-1-6 2-11 6-11-2 3-2 7 0 9z\"/>\n  </symbol>\n  <symbol id=\"f-cotton\" viewBox=\"0 0 48 48\">\n    <circle cx=\"16\" cy=\"18\" r=\"8.5\"/><circle cx=\"32\" cy=\"18\" r=\"8.5\"/>\n    <circle cx=\"24\" cy=\"12\" r=\"8.5\"/><circle cx=\"24\" cy=\"24\" r=\"9.5\"/>\n    <circle cx=\"24\" cy=\"19\" r=\"3.2\" fill=\"#FFFFFF\"/>\n    <path d=\"M24 30 13 44h22z\"/>\n    <rect x=\"22.6\" y=\"36\" width=\"2.8\" height=\"10\" rx=\"1.4\"/>\n  </symbol>\n  <symbol id=\"f-soybean\" viewBox=\"0 0 48 48\">\n    <rect x=\"22.4\" y=\"3\" width=\"3.2\" height=\"12\" rx=\"1.6\"/>\n    <path d=\"M7 27c2-9 8-14 17-14s15 5 17 14c-2 9-8 14-17 14S9 36 7 27z\"/>\n    <circle cx=\"15\" cy=\"27\" r=\"4.6\" fill=\"#FFFFFF\"/>\n    <circle cx=\"24\" cy=\"27\" r=\"4.6\" fill=\"#FFFFFF\"/>\n    <circle cx=\"33\" cy=\"27\" r=\"4.6\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"f-corn\" viewBox=\"0 0 48 48\">\n    <path d=\"M14 21C8 17 5 27 9 36c5 4 7-3 7-9z\"/>\n    <path d=\"M34 21c6-4 9 6 5 15-5 4-7-3-7-9z\"/>\n    <ellipse cx=\"24\" cy=\"26\" rx=\"10\" ry=\"17\"/>\n    <rect x=\"17.8\" y=\"14\" width=\"2.4\" height=\"24\" rx=\"1.2\" fill=\"#FFFFFF\"/>\n    <rect x=\"22.8\" y=\"11\" width=\"2.4\" height=\"30\" rx=\"1.2\" fill=\"#FFFFFF\"/>\n    <rect x=\"27.8\" y=\"14\" width=\"2.4\" height=\"24\" rx=\"1.2\" fill=\"#FFFFFF\"/>\n  </symbol>\n</svg>\n\n<div class=\"device\">\n  <div class=\"screen\">\n\n    <div class=\"statusbar\">\n      <div class=\"stat\"><span class=\"stat-label\">Time</span><span class=\"stat-value\" id=\"stat-clock\">8:00 AM</span></div>\n      <div class=\"stat has-gauge\"><span class=\"stat-label\">Battery</span><span class=\"stat-value\" id=\"stat-battery\">100%</span><span class=\"gauge\"><span class=\"gauge-fill\" id=\"gauge-battery\"></span></span></div>\n      <div class=\"stat has-gauge\"><span class=\"stat-label\">Storage</span><span class=\"stat-value\" id=\"stat-drive\">40%</span><span class=\"gauge\"><span class=\"gauge-fill\" id=\"gauge-drive\"></span></span></div>\n      <div class=\"stat has-gauge\"><span class=\"stat-label\">Data left</span><span class=\"stat-value\" id=\"stat-data\">100%</span><span class=\"gauge\"><span class=\"gauge-fill\" id=\"gauge-data\"></span></span></div>\n      <div class=\"stat\"><span class=\"stat-label\">Speed</span><span class=\"stat-value\" id=\"stat-speed\">Full speed</span></div>\n      <button type=\"button\" class=\"reset\" id=\"reset-btn\" aria-label=\"Start the morning over\">\n        <svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-reset\"></use></svg>\n      </button>\n    </div>\n\n    <div class=\"procbar\"><div class=\"procbar-fill\" id=\"procbar-fill\"></div></div>\n\n    <main class=\"body\">\n\n      <section class=\"view\" id=\"view-brief\">\n        <div class=\"hero\">\n          <h2 class=\"hero-title\">AcreWatch<br>Field Sensor Dashboard</h2>\n        </div>\n\n        <h3 class=\"brief-head\">The situation</h3>\n        <p class=\"lede\">Denise runs a family farm in Sampson County, North Carolina. She flies a drone to get information about her crops. This morning she has to check all four fields and get her notes to the farm office before the heat shuts the drone down at noon. Her internet out here is satellite, and it comes with a <strong>monthly data allowance</strong>.</p>\n\n        <h3 class=\"brief-head\">Your job</h3>\n        <p class=\"lede\">Assist with troubleshooting and optimizing the Acrewatch software. Every time a problem comes up, open <strong>Settings</strong>, figure out which setting is causing it, and change it. Some settings will fix the problem. Many of them will not do anything at all, and every change you make uses up minutes she does not have.</p>\n\n        <h3 class=\"brief-head\">For each field, you will</h3>\n        <ul class=\"steplist\">\n          <li class=\"step-item\"><span class=\"step-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-read\"></use></svg></span><span class=\"step-name\">Read the sensors</span></li>\n          <li class=\"step-item\"><span class=\"step-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-drone\"></use></svg></span><span class=\"step-name\">Fly the drone</span></li>\n          <li class=\"step-item\"><span class=\"step-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-log\"></use></svg></span><span class=\"step-name\">Log the call</span></li>\n          <li class=\"step-item\"><span class=\"step-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-send\"></use></svg></span><span class=\"step-name\">Send to the office</span></li>\n        </ul>\n        <p class=\"lede\">Work them in any order you like. The fields are spread across several hundred acres, so moving the truck to a different field costs driving time.</p>\n\n        <h3 class=\"brief-head\">A good morning looks like this</h3>\n        <ul class=\"goals\" id=\"brief-goals\"></ul>\n\n        <div class=\"actions\">\n          <button type=\"button\" class=\"btn btn-go btn-lg\" id=\"start-btn\">Start the morning</button>\n        </div>\n      </section>\n\n      <section class=\"view\" id=\"view-fields\" hidden>\n        <div class=\"banner\" id=\"banner\" hidden role=\"alert\"></div>\n        <div class=\"section-head\">\n          <h2 class=\"section-title\">Today's fields</h2>\n          <span class=\"section-chip\" id=\"fields-chip\"></span>\n        </div>\n        <ul class=\"squad\" id=\"fields\"></ul>\n        <div class=\"detail\" id=\"detail\" hidden></div>\n        <div class=\"finish\" id=\"finish\"></div>\n      </section>\n\n      <section class=\"view\" id=\"view-settings\" hidden>\n        <div class=\"section-head\">\n          <h2 class=\"section-title\">Settings</h2>\n        </div>\n        <div class=\"symptom\" id=\"symptom\" hidden aria-live=\"polite\"></div>\n        <p class=\"settings-note\" id=\"settings-note\"></p>\n        <div class=\"groups\" id=\"groups\"></div>\n      </section>\n\n      <section class=\"view\" id=\"view-report\" hidden>\n        <div class=\"hero\">\n          <p class=\"hero-kicker\">Morning report</p>\n          <h2 class=\"hero-title\" id=\"report-headline\">Morning Report</h2>\n          <p class=\"hero-sub\" id=\"report-sub\"></p>\n          <p class=\"verdict\" id=\"verdict\"></p>\n        </div>\n        <ul class=\"report-list\" id=\"report-list\"></ul>\n        <h3>The calls she logged</h3>\n        <ul class=\"calls\" id=\"calls\"></ul>\n        <h3>Where the morning went</h3>\n        <div class=\"tally\" id=\"tally\"></div>\n        <div class=\"report-notes\" id=\"report-notes\"></div>\n        <h3>Questions</h3>\n        <ol class=\"questions\" id=\"questions\"></ol>\n        <div class=\"actions\">\n          <button type=\"button\" class=\"btn btn-go\" id=\"again-btn\">Try the morning again</button>\n        </div>\n      </section>\n\n    </main>\n\n    <div class=\"sheet\" id=\"sheet\" hidden>\n      <div class=\"sheet-card\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"sheet-title\">\n        <h2 class=\"sheet-title\" id=\"sheet-title\">Start the morning over?</h2>\n        <p class=\"sheet-body\">The clock goes back to 8:00 AM, the data allowance goes back to full, every setting goes back to how it started, and the four fields are waiting again.</p>\n        <div class=\"actions\">\n          <button type=\"button\" class=\"btn btn-go\" id=\"sheet-yes\">Yes, start over</button>\n          <button type=\"button\" class=\"btn btn-alt\" id=\"sheet-no\">Keep going</button>\n        </div>\n      </div>\n    </div>\n\n    <nav class=\"tabbar\" id=\"tabbar\" aria-label=\"AcreWatch sections\" hidden>\n      <button type=\"button\" class=\"tab\" data-tab=\"fields\">\n        <span class=\"tab-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#g-fields\"></use></svg></span>\n        <span class=\"tab-label\">Fields</span>\n      </button>\n      <button type=\"button\" class=\"tab\" data-tab=\"settings\">\n        <span class=\"tab-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#g-settings\"></use></svg></span>\n        <span class=\"tab-label\">Settings</span>\n        <span class=\"tab-dot\" id=\"tab-dot\" hidden></span>\n      </button>\n    </nav>\n\n  </div>\n</div>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "/* Brand fonts, subset to Latin. Any glyph they lack falls through to the\n   next family in each stack, so other writing systems still render. */\n@font-face {\n  font-family: \"Space Grotesk\";\n  src: url(\"SpaceGrotesk.ttf\") format(\"truetype\");\n  font-weight: 300 700;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: \"Geist\";\n  src: url(\"Geist.ttf\") format(\"truetype\");\n  font-weight: 100 900;\n  font-display: swap;\n}\n\n:root {\n  --purple-light: #E4E2F8;\n  --purple-mid: #ACA8EA;\n  --purple: #4C42CF;\n  --purple-dark: #1F1976;\n  --blue-light: #D5EFFF;\n  --blue-mid: #6FCAFF;\n  --blue: #0099F3;\n  --blue-dark: #06338D;\n  --green-light: #CCF1D0;\n  --green-mid: #7CDB87;\n  --green: #34BD43;\n  --green-dark: #003F25;\n  --orange-light: #FFE3CE;\n  --orange-mid: #FFA868;\n  --orange: #F46800;\n  --orange-dark: #611D00;\n  --pink-light: #FBDAE8;\n  --pink-mid: #F07FB0;\n  --pink: #E11970;\n  --pink-dark: #7D0C3D;\n\n  --ink: #000000;\n  --ink-soft: #4A4857;\n  --line: #D6D4E0;\n  --tint: #F7F6FC;\n\n  --lift: 0 2px 0 rgba(31, 25, 118, 0.14);\n  --lift-lg: 0 4px 16px rgba(31, 25, 118, 0.18);\n\n  --font-display: \"Space Grotesk\", \"Noto Sans\", system-ui, sans-serif;\n  --font-body: \"Geist\", \"Noto Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n}\n\n* { box-sizing: border-box; }\n[hidden] { display: none !important; }\nhtml, body { height: 100%; }\n\nbody {\n  margin: 0;\n  padding: 10px;\n  background-color: var(--purple-light);\n  font-family: var(--font-body);\n  font-size: 15px;\n  color: var(--ink);\n  line-height: 1.45;\n}\n\n.sr-only {\n  position: absolute; width: 1px; height: 1px;\n  padding: 0; margin: -1px; overflow: hidden;\n  clip: rect(0 0 0 0); white-space: nowrap; border: 0;\n}\n\n.sprite { position: absolute; width: 0; height: 0; }\n\n.device {\n  max-width: 44rem;\n  margin-inline: auto;\n  background-color: var(--purple-dark);\n  border-radius: 20px;\n  padding: 10px;\n  box-shadow: var(--lift-lg);\n}\n\n.screen {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  height: min(42rem, calc(100dvh - 40px));\n  min-height: 26rem;\n  background-color: #FFFFFF;\n  border-radius: 12px;\n  overflow: hidden;\n}\n\n/* ---------- status bar ---------- */\n\n.statusbar {\n  display: flex; flex-wrap: wrap;\n  gap: 0.3rem 1.3rem;\n  padding: 0.5rem 0.85rem;\n  background-color: var(--purple-dark);\n  color: #FFFFFF;\n  flex: 0 0 auto;\n}\n\n.stat { display: flex; flex-direction: column; line-height: 1.15; }\n.stat.has-gauge { min-width: 4.4rem; }\n\n.stat-label {\n  font-size: 0.6rem; letter-spacing: 0.08em;\n  text-transform: uppercase; color: var(--purple-mid);\n}\n\n.stat-value { font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; }\n.stat-value.warn { color: var(--orange-mid); }\n.stat-value.bad { color: var(--pink-mid); }\n\n.gauge {\n  display: block; height: 7px; margin-block-start: 0.25rem;\n  border-radius: 4px; overflow: hidden;\n  background-color: var(--purple-dark);\n  border: 1px solid var(--purple-mid);\n}\n\n.gauge-fill {\n  display: block; height: 100%; width: 0;\n  transition: width 260ms ease-out;\n}\n\n.gauge-fill.battery { background-color: var(--green-mid); }\n.gauge-fill.storage { background-color: var(--blue-mid); }\n.gauge-fill.data { background-color: var(--purple-mid); }\n.gauge-fill.warn { background-color: var(--orange-mid); }\n.gauge-fill.bad { background-color: var(--pink-mid); }\n\n.reset {\n  margin-inline-start: auto; align-self: center;\n  width: 38px; height: 38px; flex: 0 0 auto;\n  display: flex; align-items: center; justify-content: center;\n  border-radius: 10px; cursor: pointer;\n  background-color: var(--purple); color: #FFFFFF;\n  border: 2px solid var(--purple-mid);\n}\n\n.reset svg { width: 21px; height: 21px; fill: currentColor; }\n\n.procbar { flex: 0 0 auto; height: 5px; background-color: var(--purple-light); }\n.procbar-fill { height: 100%; width: 0; background-color: var(--orange); transition: width linear; }\n\n@media (max-width: 26rem) {\n  .statusbar { gap: 0.3rem 0.9rem; padding: 0.45rem 0.65rem; }\n  .stat-value { font-size: 0.86rem; }\n}\n\n/* ---------- layout ---------- */\n\n.body { flex: 1 1 auto; overflow-y: auto; overscroll-behavior: contain; }\n.view { padding: 0.85rem 0.9rem 1.1rem; }\n\nh2, h3 { font-family: var(--font-display); margin: 0; }\nh3 { font-size: 1rem; color: var(--purple-dark); margin-block-end: 0.35rem; }\n\n.section-head {\n  display: flex; align-items: center; gap: 0.5rem;\n  margin-block-end: 0.55rem;\n}\n\n.section-title {\n  font-size: 1.3rem; line-height: 0.95;\n  letter-spacing: -0.02em; color: var(--purple-dark);\n}\n\n.section-chip {\n  margin-inline-start: auto;\n  font-family: var(--font-display); font-weight: 700; font-size: 0.72rem;\n  letter-spacing: 0.04em; text-transform: uppercase;\n  color: var(--purple-dark); background-color: var(--purple-light);\n  padding: 0.2rem 0.6rem; border-radius: 999px;\n}\n\n/* ---------- hero band ----------\n   Brand gradient: Primary at the top, Mid in the middle, Light at the bottom.\n   White type stays in the Primary region. */\n\n.hero {\n  border-radius: 14px;\n  padding: 1rem 1rem 1.1rem;\n  margin-block-end: 0.9rem;\n  background-image: linear-gradient(180deg, var(--purple) 0%, var(--purple-mid) 62%, var(--purple-light) 100%);\n}\n\n.hero-kicker {\n  margin: 0 0 0.3rem;\n  font-family: var(--font-display); font-weight: 700;\n  font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase;\n  color: #FFFFFF;\n}\n\n.hero-title {\n  font-size: 1.8rem; line-height: 0.94;\n  letter-spacing: -0.02em; color: #FFFFFF;\n  margin-block-end: 0.55rem;\n}\n\n.hero-title:only-child { margin-block-end: 0; }\n\n.hero-sub {\n  margin: 0;\n  font-size: 0.9rem; font-weight: 600;\n  color: var(--purple-dark);\n}\n\n.verdict {\n  display: inline-block; margin: 0.6rem 0 0;\n  font-family: var(--font-display); font-weight: 700; font-size: 0.83rem;\n  padding: 0.3rem 0.75rem; border-radius: 999px;\n  background-color: var(--pink-light); color: var(--pink-dark);\n}\n\n.verdict.good { background-color: var(--green-light); color: var(--green-dark); }\n\n/* ---------- brief ---------- */\n\n.brief-head {\n  font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase;\n  color: var(--purple); margin-block-end: 0.3rem;\n}\n\n.brief-head + .lede { margin-block-start: 0; }\n.lede { margin: 0 0 0.7rem; font-size: 0.93rem; }\n.lede strong { color: var(--purple-dark); }\n\n.goals { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.3rem; }\n\n.goals li {\n  display: flex; align-items: flex-start; gap: 0.5rem;\n  font-size: 0.88rem; color: var(--green-dark);\n  background-color: var(--green-light);\n  border-radius: 9px; padding: 0.35rem 0.55rem;\n}\n\n.goal-icon {\n  flex: 0 0 auto; width: 20px; height: 20px; border-radius: 6px;\n  background-color: var(--green-dark); color: #FFFFFF;\n  display: flex; align-items: center; justify-content: center;\n}\n\n.goal-icon svg { width: 12px; height: 12px; fill: currentColor; }\n\n.steplist {\n  list-style: none; margin: 0 0 0.85rem; padding: 0;\n  display: grid; gap: 0.45rem;\n  grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));\n}\n\n.step-item {\n  display: flex; align-items: center; gap: 0.55rem;\n  border-radius: 12px; padding: 0.5rem 0.6rem;\n  background-color: var(--tint);\n  border: 2px solid var(--purple-light);\n}\n\n.step-icon {\n  flex: 0 0 auto; width: 34px; height: 34px; border-radius: 9px;\n  background-color: var(--purple); color: #FFFFFF;\n  display: flex; align-items: center; justify-content: center;\n}\n\n.step-icon svg { width: 21px; height: 21px; fill: currentColor; }\n.step-name { font-family: var(--font-display); font-weight: 700; font-size: 0.87rem; color: var(--purple-dark); }\n\n/* ---------- banner ---------- */\n\n.banner {\n  border-radius: 14px; overflow: hidden;\n  margin-block-end: 0.85rem;\n  background-color: var(--orange-light);\n  border: 2px solid var(--orange-dark);\n  box-shadow: var(--lift);\n}\n\n.banner.hard { background-color: var(--pink-light); border-color: var(--pink-dark); }\n\n.banner-head {\n  display: flex; align-items: center; gap: 0.55rem;\n  padding: 0.5rem 0.7rem;\n  background-color: var(--orange-dark);\n}\n\n.banner.hard .banner-head { background-color: var(--pink-dark); }\n\n.banner-icon {\n  flex: 0 0 auto; width: 28px; height: 28px; border-radius: 8px;\n  background-color: #FFFFFF; color: var(--orange-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.banner.hard .banner-icon { color: var(--pink-dark); }\n.banner-icon svg { width: 18px; height: 18px; fill: currentColor; }\n.banner-title { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 0.97rem; color: #FFFFFF; }\n\n.banner-voice {\n  margin: 0; padding: 0.6rem 0.75rem 0.5rem;\n  font-size: 0.88rem; font-style: italic; color: var(--orange-dark);\n}\n\n.banner.hard .banner-voice { color: var(--pink-dark); }\n.banner .actions { padding: 0 0.75rem 0.7rem; }\n\n/* ---------- player picker ---------- */\n\n.squad {\n  list-style: none; margin: 0 0 0.85rem; padding: 0;\n  display: grid; gap: 0.5rem;\n  grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));\n}\n\n.player {\n  width: 100%;\n  display: flex; flex-direction: column; align-items: center; gap: 0.3rem;\n  font: inherit; color: inherit; cursor: pointer;\n  border: 2px solid var(--purple-light); border-radius: 14px;\n  background-color: #FFFFFF; padding: 0.6rem 0.45rem 0.5rem;\n  min-height: 44px;\n  box-shadow: var(--lift);\n  transition: transform 120ms ease-out;\n}\n\n.player:active { transform: translateY(1px); }\n.player.picked { border-color: var(--purple-dark); background-color: var(--purple); }\n.player.done { border-color: var(--green); background-color: var(--green-light); }\n\n.player-icon {\n  width: 52px; height: 52px; border-radius: 13px;\n  background-color: var(--purple-light); color: var(--purple-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.player.picked .player-icon { background-color: #FFFFFF; color: var(--purple); }\n.player.done .player-icon { background-color: #FFFFFF; color: var(--green-dark); }\n.player-icon svg { width: 38px; height: 38px; fill: currentColor; }\n\n.player-name { font-family: var(--font-display); font-weight: 700; font-size: 0.92rem; color: var(--purple-dark); }\n.player.picked .player-name { color: #FFFFFF; }\n.player.done .player-name { color: var(--green-dark); }\n\n.pips {\n  display: flex; gap: 0.22rem;\n  padding: 0.2rem; border-radius: 9px;\n  background-color: var(--tint);\n}\n\n.player.picked .pips { background-color: var(--purple-dark); }\n\n.pip {\n  width: 21px; height: 21px; border-radius: 6px;\n  background-color: var(--purple-light); color: var(--purple-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.pip svg { width: 13px; height: 13px; fill: currentColor; }\n\n.here-badge {\n  width: 24px; height: 24px; border-radius: 7px;\n  background-color: var(--orange); color: #FFFFFF;\n  display: flex; align-items: center; justify-content: center;\n}\n\n.here-badge svg { width: 15px; height: 15px; fill: currentColor; }\n.pip-done { background-color: var(--green-dark); color: #FFFFFF; }\n\n/* ---------- player detail ---------- */\n\n.detail {\n  border-radius: 14px; overflow: hidden;\n  margin-block-end: 0.85rem;\n  background-color: #FFFFFF;\n  border: 2px solid var(--purple-light);\n  box-shadow: var(--lift);\n}\n\n.detail.empty {\n  padding: 0.95rem; color: var(--ink-soft);\n  font-size: 0.9rem; font-style: italic;\n  background-color: var(--tint);\n}\n\n.detail.empty p { margin: 0; }\n\n.detail-head {\n  display: flex; align-items: center; gap: 0.6rem;\n  padding: 0.6rem 0.75rem 0.7rem;\n  background-image: linear-gradient(180deg, var(--purple) 0%, var(--purple-mid) 62%, var(--purple-light) 100%);\n}\n\n.detail-icon {\n  flex: 0 0 auto; width: 48px; height: 48px; border-radius: 12px;\n  background-color: #FFFFFF; color: var(--purple);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.detail-icon svg { width: 34px; height: 34px; fill: currentColor; }\n.detail-id { display: flex; flex-direction: column; min-width: 0; }\n.detail-name { font-family: var(--font-display); font-weight: 700; font-size: 1.12rem; line-height: 1.05; color: #FFFFFF; }\n.detail-kind { font-size: 0.78rem; font-weight: 600; color: var(--purple-dark); }\n\n.detail-body { padding: 0.7rem 0.75rem 0.8rem; }\n.complaint { margin: 0 0 0.5rem; font-size: 0.89rem; font-style: italic; color: var(--ink-soft); }\n\n.findings { list-style: none; margin: 0 0 0.6rem; padding: 0; display: grid; gap: 0.25rem; }\n\n.findings li {\n  font-size: 0.86rem;\n  padding: 0.32rem 0.5rem 0.32rem 0.55rem;\n  border-radius: 8px;\n  background-color: var(--purple-light);\n  border-inline-start: 4px solid var(--purple);\n  color: var(--purple-dark);\n}\n\n.detail-flag {\n  margin: 0 0 0.6rem; padding: 0.4rem 0.6rem; border-radius: 9px;\n  font-size: 0.82rem; font-weight: 600;\n  background-color: var(--orange-light); color: var(--orange-dark);\n  border-inline-start: 5px solid var(--orange);\n}\n\n.detail-call {\n  margin: 0 0 0.6rem; padding: 0.45rem 0.6rem; border-radius: 9px;\n  font-size: 0.85rem; font-weight: 600;\n  background-color: var(--purple-light); color: var(--purple-dark);\n  border-inline-start: 5px solid var(--purple);\n}\n\n.detail-travel {\n  margin: 0 0 0.55rem; font-size: 0.79rem; color: var(--ink-soft);\n}\n\n.shot { margin: 0 0 0.6rem; }\n\n.shot-img {\n  display: block; width: 100%; max-width: 230px; height: auto;\n  border-radius: 12px; border: 3px solid var(--blue);\n}\n\n.q-standard { filter: blur(0.6px); }\n.q-low { filter: blur(1.6px); image-rendering: pixelated; }\n\n.shot-cap {\n  margin: 0.35rem 0 0; font-size: 0.77rem; font-weight: 600;\n  color: var(--blue-dark);\n}\n\n.detail-note {\n  margin: 0.5rem 0 0; padding: 0.45rem 0.6rem; border-radius: 9px;\n  font-size: 0.8rem; font-weight: 600;\n  background-color: var(--pink-light); color: var(--pink-dark);\n}\n\n/* ---------- finish ---------- */\n\n.finish {\n  border-radius: 14px; padding: 0.7rem 0.75rem;\n  background-color: var(--tint);\n  border: 2px dashed var(--purple);\n}\n\n.finish-note { margin: 0.4rem 0 0; font-size: 0.79rem; color: var(--ink-soft); }\n\n/* ---------- settings page ---------- */\n\n.symptom {\n  border-radius: 12px; padding: 0.6rem 0.75rem; margin-block-end: 0.6rem;\n  background-color: var(--pink-light);\n  border-inline-start: 6px solid var(--pink);\n}\n\n.symptom.good { background-color: var(--green-light); border-inline-start-color: var(--green); }\n.symptom-line { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; color: var(--pink-dark); }\n.symptom.good .symptom-line { color: var(--green-dark); }\n.symptom-hint { margin: 0.25rem 0 0; font-size: 0.83rem; color: var(--pink-dark); }\n\n.settings-note { margin: 0 0 0.7rem; font-size: 0.81rem; color: var(--ink-soft); }\n\n.groups { display: grid; gap: 0.85rem; }\n\n.group-head {\n  display: flex; align-items: center; gap: 0.5rem;\n  margin-block-end: 0.4rem;\n  padding-block-end: 0.35rem;\n  border-block-end: 3px solid var(--fam-dark);\n}\n\n.group-icon {\n  flex: 0 0 auto; width: 30px; height: 30px; border-radius: 9px;\n  background-color: var(--fam-dark); color: #FFFFFF;\n  display: flex; align-items: center; justify-content: center;\n}\n\n.group-icon svg { width: 19px; height: 19px; fill: currentColor; }\n.group-name { margin: 0; font-size: 1.02rem; color: var(--fam-dark); }\n\n.fam-app        { --fam: #4C42CF; --fam-dark: #1F1976; --fam-light: #E4E2F8; }\n.fam-processing { --fam: #E11970; --fam-dark: #7D0C3D; --fam-light: #FBDAE8; }\n.fam-drone      { --fam: #0099F3; --fam-dark: #06338D; --fam-light: #D5EFFF; }\n.fam-storage    { --fam: #0099F3; --fam-dark: #06338D; --fam-light: #D5EFFF; }\n.fam-network    { --fam: #F46800; --fam-dark: #611D00; --fam-light: #FFE3CE; }\n.fam-display    { --fam: #4C42CF; --fam-dark: #1F1976; --fam-light: #E4E2F8; }\n.fam-battery    { --fam: #34BD43; --fam-dark: #003F25; --fam-light: #CCF1D0; }\n\n.srow {\n  border: 2px solid var(--line); border-radius: 12px;\n  margin-block-end: 0.35rem; background-color: #FFFFFF;\n}\n\n.srow[open] { border-color: var(--fam); box-shadow: var(--lift); }\n\n.srow-summary {\n  display: flex; align-items: center; gap: 0.5rem;\n  padding: 0.5rem 0.65rem; cursor: pointer; min-height: 44px;\n  list-style: none;\n}\n\n.srow-summary::-webkit-details-marker { display: none; }\n.srow-name { font-family: var(--font-display); font-weight: 700; font-size: 0.88rem; color: var(--ink); }\n\n.srow-value {\n  margin-inline-start: auto; font-size: 0.78rem; font-weight: 600; color: var(--ink-soft);\n  padding: 0.14rem 0.5rem; border-radius: 999px; background-color: var(--tint);\n  border: 1px solid var(--line);\n}\n\n.srow-chevron {\n  flex: 0 0 auto; width: 24px; height: 24px; border-radius: 7px;\n  display: flex; align-items: center; justify-content: center;\n  background-color: var(--fam-light); color: var(--fam-dark);\n  transition: transform 140ms ease-out;\n}\n\n.srow-chevron svg { width: 15px; height: 15px; fill: currentColor; }\n.srow[open] .srow-chevron { background-color: var(--fam-dark); color: #FFFFFF; transform: rotate(180deg); }\n.srow-body { padding: 0 0.65rem 0.7rem; }\n.srow-why { margin: 0 0 0.5rem; font-size: 0.82rem; color: var(--ink-soft); }\n\n.options { display: grid; gap: 0.4rem; grid-template-columns: 1fr; }\n\n@media (min-width: 32rem) { .options { grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); } }\n\n.option {\n  display: flex; flex-direction: column; gap: 0.18rem;\n  text-align: start; font: inherit; color: var(--ink);\n  min-height: 44px; padding: 0.5rem 0.65rem;\n  border-radius: 11px; border: 2px solid var(--line);\n  background-color: #FFFFFF; cursor: pointer;\n  transition: transform 120ms ease-out;\n}\n\n.option:active { transform: translateY(1px); }\n.option-label { font-family: var(--font-display); font-weight: 700; font-size: 0.87rem; color: var(--purple-dark); }\n.option-note { font-size: 0.76rem; color: var(--ink-soft); line-height: 1.32; }\n\n.option[aria-pressed=\"true\"] { background-color: var(--purple); border-color: var(--purple-dark); }\n.option[aria-pressed=\"true\"] .option-label { color: #FFFFFF; }\n.option[aria-pressed=\"true\"] .option-note { color: var(--purple-light); }\n\n/* ---------- buttons ---------- */\n\n.actions { display: flex; flex-wrap: wrap; gap: 0.45rem; }\n\n.btn {\n  font-family: var(--font-display); font-weight: 700; font-size: 0.87rem;\n  min-height: 44px; padding: 0.5rem 0.9rem;\n  border-radius: 11px; border: 2px solid transparent; cursor: pointer;\n  text-align: start;\n  transition: transform 120ms ease-out;\n}\n\n.btn:active { transform: translateY(1px); }\n.btn-lg { font-size: 0.93rem; min-height: 48px; padding: 0.6rem 1.05rem; }\n.btn-go { background-color: var(--purple); color: #FFFFFF; border-color: var(--purple-dark); box-shadow: var(--lift); }\n.btn-alt { background-color: #FFFFFF; color: var(--purple-dark); border-color: var(--purple); }\n.btn-warn { background-color: var(--orange-light); color: var(--orange-dark); border-color: var(--orange); }\n.btn:disabled { cursor: not-allowed; background-color: #EDECF3; color: #56545F; border-color: var(--line); box-shadow: none; }\n\n@media (prefers-reduced-motion: reduce) {\n  .procbar-fill, .gauge-fill, .player, .option, .btn, .srow-chevron { transition: none; }\n  .player:active, .option:active, .btn:active { transform: none; }\n}\n\n/* ---------- report ---------- */\n\n.report-list { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.35rem; }\n\n.report-list li {\n  display: flex; flex-wrap: wrap; gap: 0.2rem 0.7rem;\n  justify-content: space-between; align-items: baseline;\n  border-radius: 11px; padding: 0.5rem 0.75rem;\n  border: 2px solid var(--line); font-size: 0.89rem;\n}\n\n.report-list li.met { background-color: var(--green-light); border-color: var(--green); }\n.report-list li.unmet { background-color: var(--pink-light); border-color: var(--pink); }\n\n.rep-name { font-weight: 600; }\n.rep-val { font-family: var(--font-display); font-weight: 700; }\nli.met .rep-val { color: var(--green-dark); }\nli.unmet .rep-val { color: var(--pink-dark); }\n\n.cat-processor { --fam: #4C42CF; --fam-dark: #1F1976; --fam-light: #E4E2F8; }\n.cat-storage   { --fam: #0099F3; --fam-dark: #06338D; --fam-light: #D5EFFF; }\n.cat-network   { --fam: #F46800; --fam-dark: #611D00; --fam-light: #FFE3CE; }\n.cat-memory    { --fam: #E11970; --fam-dark: #7D0C3D; --fam-light: #FBDAE8; }\n.cat-settings  { --fam: #34BD43; --fam-dark: #003F25; --fam-light: #CCF1D0; }\n\n.tally {\n  display: grid; gap: 0.45rem;\n  grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));\n  margin-block-end: 0.9rem;\n}\n\n.tally-card {\n  border-radius: 12px; overflow: hidden;\n  border: 2px solid var(--fam-light);\n  background-color: #FFFFFF;\n}\n\n.tally-card.is-top { border-color: var(--fam-dark); box-shadow: var(--lift); }\n\n.tally-head {\n  display: flex; align-items: center; gap: 0.4rem;\n  padding: 0.35rem 0.5rem;\n  background-color: var(--fam-dark);\n}\n\n.tally-dot {\n  width: 24px; height: 24px; flex: 0 0 auto; border-radius: 7px;\n  background-color: #FFFFFF; color: var(--fam-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.tally-dot svg { width: 16px; height: 16px; fill: currentColor; }\n.tally-name { font-family: var(--font-display); font-weight: 700; font-size: 0.8rem; color: #FFFFFF; }\n.tally-body { padding: 0.45rem 0.6rem 0.55rem; }\n.tally-val { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; color: var(--fam-dark); margin: 0; }\n.tally-sub { font-size: 0.73rem; color: var(--ink-soft); margin: 0; }\n\n.tally-flag {\n  display: inline-block; margin: 0.3rem 0 0;\n  font-size: 0.66rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase;\n  color: var(--fam-dark); background-color: var(--fam-light);\n  padding: 0.16rem 0.5rem; border-radius: 999px;\n}\n\n.calls { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.35rem; }\n\n.calls li {\n  display: grid; gap: 0.15rem;\n  border-radius: 11px; padding: 0.5rem 0.75rem;\n  border: 2px solid var(--line);\n}\n\n.calls li.met { background-color: var(--green-light); border-color: var(--green); }\n.calls li.unmet { background-color: var(--pink-light); border-color: var(--pink); }\n\n.call-name { font-family: var(--font-display); font-weight: 700; font-size: 0.82rem; }\n.calls li.met .call-name { color: var(--green-dark); }\n.calls li.unmet .call-name { color: var(--pink-dark); }\n.call-text { font-size: 0.87rem; }\n.call-cost { font-size: 0.79rem; font-style: italic; color: var(--pink-dark); }\n\n.report-notes { display: grid; gap: 0.35rem; margin-block-end: 1rem; }\n\n.report-note {\n  background-color: var(--orange-light);\n  border-inline-start: 6px solid var(--orange);\n  border-radius: 11px; padding: 0.55rem 0.75rem;\n  color: var(--orange-dark); font-size: 0.87rem; margin: 0;\n}\n\n.questions { padding-inline-start: 1.2rem; margin: 0 0 1rem; font-size: 0.89rem; }\n.questions li { margin-block-end: 0.4rem; }\n\n/* ---------- confirmation sheet ---------- */\n\n.sheet {\n  position: absolute; inset: 0; z-index: 10;\n  display: flex; align-items: center; justify-content: center;\n  padding: 1rem;\n  background-color: rgba(31, 25, 118, 0.55);\n}\n\n.sheet-card {\n  width: 100%; max-width: 22rem;\n  border-radius: 16px; padding: 1rem;\n  background-color: #FFFFFF;\n  border: 3px solid var(--purple-dark);\n  box-shadow: var(--lift-lg);\n}\n\n.sheet-title {\n  font-size: 1.15rem; line-height: 1.05;\n  color: var(--purple-dark); margin-block-end: 0.45rem;\n}\n\n.sheet-body { margin: 0 0 0.8rem; font-size: 0.88rem; color: var(--ink-soft); }\n\n/* ---------- tab bar ---------- */\n\n.tabbar {\n  display: flex; flex: 0 0 auto;\n  border-block-start: 2px solid var(--purple-light);\n  background-color: var(--tint);\n}\n\n.tab {\n  position: relative;\n  flex: 1 1 0;\n  display: flex; align-items: center; justify-content: center; gap: 0.45rem;\n  font-family: var(--font-display); font-weight: 700; font-size: 0.88rem;\n  min-height: 50px; padding: 0.35rem;\n  border: none; border-block-start: 4px solid transparent;\n  background-color: transparent; color: var(--ink-soft); cursor: pointer;\n}\n\n.tab[aria-current=\"page\"] { color: #FFFFFF; border-block-start-color: var(--purple-dark); background-color: var(--purple); }\n.tab-icon { display: flex; }\n.tab-icon svg { width: 21px; height: 21px; fill: currentColor; }\n\n.tab-dot {\n  width: 11px; height: 11px; border-radius: 50%;\n  background-color: var(--pink);\n  border: 2px solid #FFFFFF;\n}\n\n.tab[aria-current=\"page\"] .tab-dot { border-color: var(--purple); }\n\n/* ---------- focus ---------- */\n\n.btn:focus-visible,\n.option:focus-visible,\n.player:focus-visible,\n.tab:focus-visible,\n.reset:focus-visible,\n.srow-summary:focus-visible {\n  outline: 3px solid var(--orange);\n  outline-offset: 2px;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const DAY_START = 480;\nconst DAY_END = 720;\nconst DRIVE_CAP = 100;\nconst DATA_CAP = 100;\nconst DATA_GOAL = 25;\nconst PAST_SEASON_UNITS = 35;\nconst CACHE_UNITS = 5;\n\nconst READ_MINUTES = 7;\nconst READ_BATTERY = 4;\nconst DRONE_BATTERY = 4;\nconst LOG_MINUTES = 10;\nconst LOG_BATTERY = 5;\nconst TRAVEL_MINUTES = 6;\nconst RECHECK_MINUTES = 6;\nconst CLOSE_MINUTES = 2;\nconst REAL_SETTING_MINUTES = 2;\nconst IDLE_SETTING_MINUTES = 1;\nconst ARCHIVE_MINUTES = 4;\n\nconst SEND_OVERHEAD_DATA = 7;\nconst SEND_DATA_PER_NOTE = 2;\nconst SEND_MINUTES_PER_DATA = 0.8;\nconst SEND_BATTERY_PER_DATA = 0.5;\n\nconst NOISE_PENALTY = 0.3;\nconst MEMORY_PENALTY = 0.25;\nconst SAVER_TIME = 1.4;\nconst SAVER_BATTERY = 0.6;\nconst USEFUL_IMAGE_SCORE = 50;\nconst HINT_AFTER_TRIES = 2;\n\nconst BRIGHTNESS_DRAIN = { low: 0.85, medium: 1, high: 1.4 };\n\n/* Where the raw sensor readings get turned into something a person can use.\n   Doing it off the farm is quick and spends the month's data allowance. Doing\n   it on a cheap truck tablet is free and slow. Summarizing first is the middle. */\nconst PROCESSING = {\n  service: { minutes: 3, data: 12, word: 'In the service' },\n  summary: { minutes: 8, data: 3, word: 'Summary first' },\n  tablet: { minutes: 16, data: 0, word: 'On the tablet' }\n};\n\nconst IMAGE = {\n  original: { units: 24, data: 12, detail: 100, minutes: 6, word: 'Original' },\n  standard: { units: 8, data: 4, detail: 75, minutes: 3, word: 'Standard' },\n  low: { units: 3, data: 2, detail: 35, minutes: 2, word: 'Low' }\n};\n\nconst GROUPS = [\n  { id: 'app', name: 'AcreWatch app', icon: 'g-app' },\n  { id: 'processing', name: 'Processing', icon: 'g-processing' },\n  { id: 'drone', name: 'Drone', icon: 'g-drone' },\n  { id: 'storage', name: 'Storage', icon: 'g-storage' },\n  { id: 'network', name: 'Network', icon: 'g-network' },\n  { id: 'display', name: 'Display', icon: 'g-display' },\n  { id: 'battery', name: 'Battery', icon: 'g-battery' }\n];\n\n/* real: changing it moves time, battery, storage or the data allowance.\n   Everything else is here because a real settings screen has things in it\n   that look promising and do nothing. */\nconst SETTINGS = [\n  {\n    id: 'readings', group: 'app', real: true, start: 'all',\n    name: 'Readings shown',\n    why: 'How much of the raw sensor feed the dashboard puts on the screen. The tablet has to draw every row it shows.',\n    options: [\n      { value: 'all', label: 'Every reading', note: 'About four thousand rows per field. Every task takes 30% longer while Denise hunts through them.' },\n      { value: 'flagged', label: 'Only flagged readings', note: 'Shows the readings that are outside their normal range. The rest are still saved, just not drawn.' }\n    ]\n  },\n  {\n    id: 'autoClose', group: 'app', real: true, start: 'keep',\n    name: 'Finished field notes',\n    why: 'A saved note stays loaded in memory until something closes it.',\n    options: [\n      { value: 'keep', label: 'Leave them open', note: 'Every open note makes each task 25% slower.' },\n      { value: 'close', label: 'Close them automatically', note: 'Costs 2 minutes per note. Memory stays clear and the app stays fast.' }\n    ]\n  },\n  {\n    id: 'tips', group: 'app', real: false, start: 'on',\n    name: 'Tip of the day',\n    why: 'Shows a short growing tip when the app opens.',\n    options: [\n      { value: 'on', label: 'On', note: 'A tip on every launch.' },\n      { value: 'off', label: 'Off', note: 'No tips.' }\n    ]\n  },\n  {\n    id: 'processing', group: 'processing', real: true, start: 'service',\n    name: 'Where readings get processed',\n    why: 'Raw readings are not useful until something turns them into averages, trends and warnings. That work has to happen somewhere.',\n    options: [\n      { value: 'service', label: 'In the service', note: 'Ships every raw reading off the farm. Adds 3 minutes per field and spends 12% of the month\\u2019s data allowance each time.' },\n      { value: 'summary', label: 'Summary first', note: 'The tablet boils the readings down, then sends the summary. Adds 8 minutes per field and spends 3% of the allowance each time.' },\n      { value: 'tablet', label: 'On the tablet', note: 'Nothing leaves the farm. Adds 16 minutes per field and spends no allowance at all.' }\n    ]\n  },\n  {\n    id: 'recheck', group: 'processing', real: true, start: 'accept',\n    name: 'Nodes repaired after the flood',\n    why: 'Two nodes went under water last week. The hardware was replaced, but the software on them still garbles a reading now and then.',\n    options: [\n      { value: 'accept', label: 'Use the readings as they come', note: 'Costs nothing. A garbled reading goes into the field note looking like a real one.' },\n      { value: 'recheck', label: 'Read those nodes twice and compare', note: 'Costs 6 minutes at each repaired node. Garbled readings get caught, and any field already read gets read again.' }\n    ]\n  },\n  {\n    id: 'quality', group: 'drone', real: true, start: 'original',\n    name: 'Drone image quality',\n    why: 'How much detail each pass keeps. Detail is what fills the storage and what makes the upload expensive.',\n    options: [\n      { value: 'original', label: 'Original', note: 'Takes 24% of the storage and 12% of the data allowance per field. Sharp enough to count leaves, rated 100 out of 100.' },\n      { value: 'standard', label: 'Standard', note: 'Takes 8% of the storage and 4% of the allowance. Rated 75 out of 100.' },\n      { value: 'low', label: 'Low', note: 'Takes 3% of the storage and 2% of the allowance. Rated 35 out of 100.' }\n    ]\n  },\n  {\n    id: 'grid', group: 'drone', real: false, start: 'off',\n    name: 'Flight grid overlay',\n    why: 'Draws the flight path over the live view while the drone is up. The lines are not saved into the images.',\n    options: [\n      { value: 'off', label: 'Off', note: 'A plain live view.' },\n      { value: 'on', label: 'On', note: 'Shows the path the drone is flying.' }\n    ]\n  },\n  {\n    id: 'chime', group: 'drone', real: false, start: 'on',\n    name: 'Launch chime',\n    why: 'The sound the tablet makes when the drone lifts off and lands.',\n    options: [\n      { value: 'on', label: 'On', note: 'The tablet chimes.' },\n      { value: 'off', label: 'Off', note: 'The tablet is silent.' }\n    ]\n  },\n  {\n    id: 'archive', group: 'storage', real: true, start: 'tablet',\n    name: 'Past seasons',\n    why: 'Three years of old field data sit in storage taking up room that today needs.',\n    options: [\n      { value: 'tablet', label: 'Keep on the tablet', note: 'Holds 35% of the storage. Denise can compare today against past seasons right here in the field.' },\n      { value: 'office', label: 'Move to the office computer', note: 'Frees 35% of the storage. She cannot compare against past seasons out here.' }\n    ]\n  },\n  {\n    id: 'cache', group: 'storage', real: true, start: 'kept',\n    name: 'Temporary files',\n    why: 'Scratch files the app leaves behind. Clearing them helps a little.',\n    options: [\n      { value: 'kept', label: 'Keep them', note: 'Holds 5% of the storage.' },\n      { value: 'cleared', label: 'Clear them', note: 'Frees 5% of the storage. That is one fifth of a drone pass at original quality.' }\n    ]\n  },\n  {\n    id: 'sending', group: 'network', real: true, start: 'auto',\n    name: 'Sending to the office',\n    why: 'When the tablet phones the office. Every connection it opens spends 7% of the allowance on overhead before a single reading moves.',\n    options: [\n      { value: 'auto', label: 'Send after every note', note: 'Each note goes on its own, and each trip pays the 7% overhead again.' },\n      { value: 'manual', label: 'Send everything at once', note: 'Nothing leaves until you send it, so the overhead gets paid one time.' }\n    ]\n  },\n  {\n    id: 'wifi', group: 'network', real: false, start: 'on',\n    name: 'Look for Wi-Fi',\n    why: 'Scans for Wi-Fi networks. The house router is two miles back up the road, and the satellite link is what costs allowance anyway.',\n    options: [\n      { value: 'on', label: 'On', note: 'Keeps scanning for a network to join.' },\n      { value: 'off', label: 'Off', note: 'Stops scanning.' }\n    ]\n  },\n  {\n    id: 'brightness', group: 'display', real: true, start: 'medium',\n    name: 'Screen brightness',\n    why: 'How bright the backlight runs. The backlight is one of the hungriest things on the tablet.',\n    options: [\n      { value: 'low', label: 'Low', note: 'Hard to read outside. Uses 15% less battery per task.' },\n      { value: 'medium', label: 'Medium', note: 'Readable in the shade of the truck. Normal battery use.' },\n      { value: 'high', label: 'High', note: 'Readable standing in the open field. Uses 40% more battery per task.' }\n    ]\n  },\n  {\n    id: 'textSize', group: 'display', real: false, start: 'medium',\n    name: 'Text size',\n    why: 'How big the words are. Does not change how many readings the dashboard draws.',\n    options: [\n      { value: 'small', label: 'Small', note: 'More fits on the screen.' },\n      { value: 'medium', label: 'Medium', note: 'The usual size.' },\n      { value: 'large', label: 'Large', note: 'Fewer words on the screen at once.' }\n    ]\n  },\n  {\n    id: 'darkMode', group: 'display', real: false, start: 'off',\n    name: 'Dark colors',\n    why: 'Swaps the app to a dark color scheme. This screen lights every pixel from behind either way.',\n    options: [\n      { value: 'off', label: 'Off', note: 'Dark words on a light background.' },\n      { value: 'on', label: 'On', note: 'Light words on a dark background.' }\n    ]\n  },\n  {\n    id: 'power', group: 'battery', real: true, start: 'normal',\n    name: 'Power mode',\n    why: 'Trades speed for battery life. Which one helps depends on what Denise is short of.',\n    options: [\n      { value: 'normal', label: 'Normal', note: 'Full speed. Normal battery use.' },\n      { value: 'saver', label: 'Power saver', note: 'Every task takes 40% longer. Uses 40% less battery.' }\n    ]\n  },\n  {\n    id: 'batteryPercent', group: 'battery', real: false, start: 'on',\n    name: 'Show battery percent',\n    why: 'Whether the number appears next to the battery icon.',\n    options: [\n      { value: 'on', label: 'On', note: 'Shows the number.' },\n      { value: 'off', label: 'Off', note: 'Shows only the icon.' }\n    ]\n  }\n];\n\nconst FIELDS = [\n  {\n    id: 'bottom', name: 'Bottom Field', crop: 'Sweet potatoes, 60 acres',\n    icon: 'f-sweetpotato', image: 'drone-bottom.jpg', flooded: true,\n    alt: 'Drone view of sweet potato rows with water still standing at the low end of the field.',\n    concern: 'The sensors down here went under water in last week\\u2019s storm.',\n    readings: [\n      'Soil moisture is sitting at 41%, far wetter than sweet potatoes want.',\n      'Water is still standing at the low end four days after the rain.',\n      'Soil temperature is three degrees colder than the rest of the farm.'\n    ],\n    goodCall: 'Hold the irrigation. The low end is still saturated.',\n    badCall: 'Run the irrigation here tonight.',\n    badCost: 'The low end was already soaked, so a night of irrigation drowned the roots on about eight acres.'\n  },\n  {\n    id: 'creek', name: 'Creek Field', crop: 'Cotton, 85 acres',\n    icon: 'f-cotton', image: 'drone-creek.jpg', flooded: true,\n    alt: 'Drone view of a cotton field with a pale damaged patch along the north edge.',\n    concern: 'Something is chewing on the north end and she wants to know how far it has gone.',\n    readings: [\n      'Leaf damage shows up in the north twelve acres and nowhere else.',\n      'Soil moisture reads normal across the whole field.',\n      'The damaged patch has grown about thirty feet since Monday.'\n    ],\n    goodCall: 'Scout and spot-spray the north twelve acres for thrips.',\n    badCall: 'Nothing in this field needs attention this week.',\n    badCost: 'The thrips in the north twelve acres went untreated and kept spreading all weekend.'\n  },\n  {\n    id: 'hill', name: 'Hill Field', crop: 'Soybeans, 40 acres',\n    icon: 'f-soybean', image: 'drone-hill.jpg', flooded: false,\n    alt: 'Drone view of soybean rows running up a gentle slope, paler along the top.',\n    concern: 'The slope drains fast and the forecast has nothing in it.',\n    readings: [\n      'Soil moisture on the top third is down to 12%.',\n      'There is no rain in the forecast for nine days.',\n      'The bottom of the slope is holding moisture just fine.'\n    ],\n    goodCall: 'Irrigate the top third tomorrow morning.',\n    badCall: 'Leave the whole field alone.',\n    badCost: 'The top third went another nine days without water.'\n  },\n  {\n    id: 'home', name: 'Home Field', crop: 'Corn, 55 acres',\n    icon: 'f-corn', image: 'drone-home.jpg', flooded: false,\n    alt: 'Drone view of a corn field with a yellow strip running along the east edge.',\n    concern: 'A yellow strip showed up along the east edge in last Tuesday\\u2019s pass.',\n    readings: [\n      'A yellow strip runs the length of the east edge.',\n      'Soil moisture is even across the whole field.',\n      'The strip lines up with where the spreader ran short last fall.'\n    ],\n    goodCall: 'Pull tissue samples from the yellow strip before spreading anything.',\n    badCall: 'Spread nitrogen across the whole field.',\n    badCost: 'A full field of nitrogen went out to fix a strip that may not have needed it.'\n  }\n];\n\nconst PROBLEMS = [\n  {\n    id: 'noise', setting: 'readings', group: 'app', blocks: 'read',\n    title: 'Four thousand readings on one screen',\n    voice: 'I cannot find the field I am standing in inside all of this.',\n    symptom: 'Right now the dashboard is drawing every reading at once.',\n    fixed: 'The dashboard is down to what matters.',\n    fires: function () { return true; },\n    ready: function () { return state.settings.readings !== 'all'; }\n  },\n  {\n    id: 'huge', setting: 'quality', group: 'drone', blocks: null,\n    title: 'One drone pass took a quarter of the storage',\n    voice: 'That pass came out beautiful and enormous.',\n    symptom: 'Right now one drone pass is taking a quarter of the storage.',\n    fixed: 'The next passes will use less room.',\n    fires: function () { return passesFlown() >= 1 && state.settings.quality === 'original'; },\n    ready: function () { return state.settings.quality !== 'original'; }\n  },\n  {\n    id: 'garble', setting: 'recheck', group: 'processing', blocks: null,\n    title: 'These numbers do not make sense',\n    voice: 'That node says the ground is bone dry and I am standing in water.',\n    symptom: 'Right now a repaired node is returning garbled readings.',\n    fixed: 'Those fields were read again and the numbers are clean.',\n    fires: function () { return badFields().length >= 1; },\n    ready: function () { return state.settings.recheck === 'recheck'; }\n  },\n  {\n    id: 'full', setting: 'archive', group: 'storage', blocks: 'drone',\n    title: 'The drone pass will not save',\n    voice: 'No room in storage, and I still have fields to fly.',\n    symptom: 'Right now drone passes will not save.',\n    fixed: 'There is room again.',\n    fires: function () { return !passFits() && needsPass() > 0; },\n    ready: function () { return passFits(); }\n  },\n  {\n    id: 'overhead', setting: 'sending', group: 'network', blocks: null,\n    title: 'Every little send pays the same toll',\n    voice: 'It just phoned the office again to push one note across.',\n    symptom: 'Right now the tablet opens a new connection for every note.',\n    fixed: 'It will hold everything until you say go.',\n    fires: function () { return state.sends >= 2; },\n    ready: function () { return state.settings.sending === 'manual'; }\n  },\n  {\n    id: 'datalow', setting: 'processing', group: 'processing', blocks: null,\n    title: 'The month\\u2019s data allowance is going fast',\n    voice: 'We are past halfway on the month and it is only the ninth.',\n    symptom: 'Right now the data allowance is dropping faster than the month is.',\n    fixed: 'Less is leaving the farm now.',\n    fires: function () { return dataLeft() <= 45 && tasksLeft() > 0; },\n    ready: function () { return state.settings.processing !== 'service'; }\n  },\n  {\n    id: 'slow', setting: 'autoClose', group: 'app', blocks: null,\n    title: 'AcreWatch is lagging',\n    voice: 'Everything is slow. I have field notes stacked up open.',\n    symptom: 'Right now AcreWatch is lagging.',\n    fixed: 'Memory is clear again.',\n    fires: function () { return openNotes() >= 2; },\n    ready: function () { return openNotes() === 0; }\n  },\n  {\n    id: 'lowbatt', setting: 'power', group: 'battery', blocks: null,\n    title: 'The battery is getting low',\n    voice: 'Under half, and I still have fields to work plus a send at the end.',\n    symptom: 'Right now the battery is under half.',\n    fixed: 'Noted.',\n    fires: function () { return state.battery <= 45 && tasksLeft() > 0; },\n    ready: function () { return state.settings.power === 'saver'; }\n  }\n];\n\nconst GOALS = [\n  'All four field notes reach the office.',\n  'Denise is done before noon.',\n  'The tablet still has battery at the end.',\n  'Every field gets a drone pass.',\n  'The drone images are sharp enough to spot trouble.',\n  'Every call is made on good data.',\n  'At least a quarter of the month\\u2019s data allowance is left.'\n];\n\nconst QUESTIONS = [\n  'Processing on the tablet cost no data and a lot of time. Processing in the service cost no time and a lot of data. What made the middle choice better than either one?',\n  'The app was not broken when it felt slow at the start of the morning. What was actually making every task take longer, and which setting stopped it?',\n  'Sending one note at a time and sending all four at once move the same readings. Why did one of them spend so much more of the allowance?',\n  'Both flooded nodes had already been repaired. Why were their readings still wrong, and what did trusting them cost Denise?',\n  'Several settings in that list changed nothing at all. How could you tell which ones were worth trying?',\n  'Troubleshooting means fixing something that is not working. Optimization means making something run better even when it works. Name one of each from this morning.'\n];\n\nconst nf = new Intl.NumberFormat();\nconst pf = new Intl.NumberFormat(undefined, { style: 'percent', maximumFractionDigits: 0 });\nconst df = new Intl.NumberFormat(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 });\nconst tf = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });\n\nlet state;\nlet busy = false;\nlet renderedView = null;\nlet viewJustChanged = false;\nconst els = {};\n\n/* ================= state ================= */\n\nfunction freshState() {\n  const settings = {};\n  SETTINGS.forEach(function (s) { settings[s.id] = s.start; });\n  return {\n    view: 'brief',\n    settings: settings,\n    selected: null,\n    atField: null,\n    fields: FIELDS.map(function (f) {\n      return {\n        id: f.id, read: false, pass: null, skipped: false, logged: false,\n        closed: false, sent: false, badData: false, badCall: false\n      };\n    }),\n    problem: null,\n    seen: {},\n    wrongTries: 0,\n    justFixed: null,\n    clock: DAY_START,\n    battery: 100,\n    dataUsed: 0,\n    passUnits: 0,\n    sends: 0,\n    failedSends: 0,\n    moves: 0,\n    log: [],\n    over: false,\n    endReason: null,\n    missedHistory: false\n  };\n}\n\nfunction fieldDef(id) { for (let i = 0; i < FIELDS.length; i++) if (FIELDS[i].id === id) return FIELDS[i]; return null; }\nfunction fieldState(id) { for (let i = 0; i < state.fields.length; i++) if (state.fields[i].id === id) return state.fields[i]; return null; }\nfunction settingById(id) { for (let i = 0; i < SETTINGS.length; i++) if (SETTINGS[i].id === id) return SETTINGS[i]; return null; }\nfunction groupById(id) { for (let i = 0; i < GROUPS.length; i++) if (GROUPS[i].id === id) return GROUPS[i]; return GROUPS[0]; }\nfunction problemById(id) { for (let i = 0; i < PROBLEMS.length; i++) if (PROBLEMS[i].id === id) return PROBLEMS[i]; return null; }\n\nfunction openNotes() {\n  let n = 0;\n  state.fields.forEach(function (f) { if (f.logged && !f.closed) n += 1; });\n  return n;\n}\n\nfunction passesFlown() { return state.fields.filter(function (f) { return f.pass !== null; }).length; }\nfunction needsPass() { return state.fields.filter(function (f) { return f.read && f.pass === null && !f.skipped; }).length; }\nfunction badFields() { return state.fields.filter(function (f) { return f.badData; }); }\n\nfunction tasksLeft() {\n  let n = 0;\n  state.fields.forEach(function (f) {\n    if (!f.read) n += 1;\n    if (f.pass === null && !f.skipped) n += 1;\n    if (!f.logged) n += 1;\n  });\n  return n;\n}\n\nfunction pastSeasonUnits() { return state.settings.archive === 'office' ? 0 : PAST_SEASON_UNITS; }\nfunction cacheUnits() { return state.settings.cache === 'cleared' ? 0 : CACHE_UNITS; }\n\n/* Clamped so the gauge can never read past full, in case a student moves past\n   seasons back onto a tablet that has since filled up. */\nfunction driveUsed() {\n  return Math.min(pastSeasonUnits() + cacheUnits() + state.passUnits, DRIVE_CAP);\n}\n\nfunction driveFree() { return Math.max(0, DRIVE_CAP - driveUsed()); }\nfunction passFits() { return driveUsed() + IMAGE[state.settings.quality].units <= DRIVE_CAP; }\nfunction dataLeft() { return Math.max(0, DATA_CAP - state.dataUsed); }\n\nfunction pendingNotes() {\n  return state.fields.filter(function (f) { return f.logged && !f.sent; });\n}\n\nfunction sendCost(notes) {\n  let data = SEND_OVERHEAD_DATA + SEND_DATA_PER_NOTE * notes.length;\n  notes.forEach(function (f) { if (f.pass) data += IMAGE[f.pass].data; });\n  return {\n    data: data,\n    minutes: Math.round(data * SEND_MINUTES_PER_DATA * saverTime()),\n    battery: Math.round(data * SEND_BATTERY_PER_DATA * batteryMultiplier())\n  };\n}\n\nfunction noiseMultiplier() { return state.settings.readings === 'all' ? 1 + NOISE_PENALTY : 1; }\nfunction memoryMultiplier() { return 1 + openNotes() * MEMORY_PENALTY; }\nfunction saverTime() { return state.settings.power === 'saver' ? SAVER_TIME : 1; }\nfunction timeMultiplier() { return noiseMultiplier() * memoryMultiplier() * saverTime(); }\nfunction batteryMultiplier() {\n  return BRIGHTNESS_DRAIN[state.settings.brightness] * (state.settings.power === 'saver' ? SAVER_BATTERY : 1);\n}\n\nfunction imageDetailAverage() {\n  const shots = state.fields.filter(function (f) { return f.pass !== null; });\n  if (shots.length === 0) return 0;\n  let total = 0;\n  shots.forEach(function (f) { total += IMAGE[f.pass].detail; });\n  return Math.round(total / shots.length);\n}\n\n/* ================= costs ================= */\n\nfunction spend(minutes, battery, cat, text, menu) {\n  const m = Math.round(minutes);\n  const b = Math.round(battery);\n  state.clock += m;\n  state.battery -= b;\n  if (state.battery < 0) state.battery = 0;\n  state.log.push({ text: text, cat: cat, minutes: m, battery: b, data: 0, menu: !!menu });\n  return { minutes: m, battery: b };\n}\n\nfunction spendData(amount, text) {\n  const d = Math.min(Math.round(amount), dataLeft());\n  state.dataUsed += d;\n  state.log.push({ text: text, cat: 'network', minutes: 0, battery: 0, data: d, menu: false });\n  return d;\n}\n\n/* Charges the task to the part doing the work, then bills each slowdown to\n   whatever actually caused it, so the report can name a culprit. */\nfunction runTask(baseMinutes, baseBattery, cat, text) {\n  const noise = noiseMultiplier();\n  const mem = memoryMultiplier();\n  const sav = saverTime();\n  const total = Math.round(baseMinutes * noise * mem * sav);\n\n  let noiseShare = Math.round(baseMinutes * (noise - 1));\n  let memShare = Math.round(baseMinutes * noise * (mem - 1));\n  let savShare = Math.round(baseMinutes * noise * mem * (sav - 1));\n  if (noiseShare < 2) noiseShare = 0;\n  if (memShare < 2) memShare = 0;\n  if (savShare < 2) savShare = 0;\n\n  const own = Math.max(0, total - noiseShare - memShare - savShare);\n  spend(own, baseBattery * batteryMultiplier(), cat, text);\n\n  if (noiseShare > 0) {\n    spend(noiseShare, 0, 'settings', `Drawing every reading added ${nf.format(noiseShare)} minutes to that.`);\n  }\n  if (memShare > 0) {\n    spend(memShare, 0, 'memory', `${nf.format(openNotes())} open notes added ${nf.format(memShare)} minutes to that.`);\n  }\n  if (savShare > 0) {\n    spend(savShare, 0, 'settings', `Power saver added ${nf.format(savShare)} minutes to that.`);\n  }\n}\n\nfunction travelTo(id) {\n  if (state.atField === id) return;\n  const from = state.atField;\n  state.atField = id;\n  state.moves += 1;\n  spend(TRAVEL_MINUTES, 0, 'driving', from === null\n    ? `Drove out to ${fieldDef(id).name}.`\n    : `Drove from ${fieldDef(from).name} over to ${fieldDef(id).name}.`);\n}\n\nfunction sendNotes(auto) {\n  const notes = pendingNotes();\n  if (notes.length === 0) return;\n  const cost = sendCost(notes);\n  if (cost.data > dataLeft()) {\n    state.failedSends += 1;\n    spend(2, 0, 'network', 'Tried to send. There is not enough data allowance left this month.');\n    return;\n  }\n  notes.forEach(function (f) { f.sent = true; });\n  state.sends += 1;\n  spendData(cost.data, `Sent ${nf.format(notes.length)} field notes to the office, which spent ${pf.format(cost.data / 100)} of the allowance.`);\n  const how = auto ? 'The tablet opened a connection and sent' : 'Sent';\n  spend(cost.minutes, cost.battery, 'network',\n    `${how} ${nf.format(notes.length)} field notes over the satellite link.`);\n}\n\nfunction autoSendTick() {\n  if (state.settings.sending !== 'auto') return;\n  if (pendingNotes().length === 0) return;\n  sendNotes(true);\n}\n\nfunction checkOver() {\n  if (state.over) return true;\n  if (state.battery <= 0) { state.over = true; state.endReason = 'battery'; return true; }\n  if (state.clock >= DAY_END) { state.over = true; state.endReason = 'clock'; return true; }\n  return false;\n}\n\n/* ================= problems ================= */\n\nfunction syncProblem() {\n  if (state.problem) {\n    const active = problemById(state.problem);\n    if (active.ready()) {\n      state.justFixed = active.fixed;\n      state.problem = null;\n      state.wrongTries = 0;\n    } else if (!active.fires()) {\n      /* The situation went away without the setting changing, for example the\n         student skipped the drone pass instead of making room. Drop it and look for whatever is next. */\n      state.problem = null;\n      state.wrongTries = 0;\n    } else {\n      return;\n    }\n  }\n  for (let i = 0; i < PROBLEMS.length; i++) {\n    const p = PROBLEMS[i];\n    if (state.seen[p.id]) continue;\n    if (p.ready()) continue;\n    if (!p.fires()) continue;\n    state.problem = p.id;\n    state.seen[p.id] = true;\n    state.wrongTries = 0;\n    return;\n  }\n}\n\nfunction blockedAction(kind) {\n  if (!state.problem) return false;\n  return problemById(state.problem).blocks === kind;\n}\n\nfunction dismissBanner() {\n  if (!state.problem) return;\n  state.seen[state.problem] = true;\n  state.problem = null;\n  render();\n}\n\n/* ================= actions ================= */\n\nfunction doRead(id) {\n  travelTo(id);\n  const f = fieldState(id);\n  const def = fieldDef(id);\n  f.read = true;\n\n  /* If the allowance is gone, the service is simply not reachable and the\n     tablet has to do the work itself. */\n  let mode = state.settings.processing;\n  if (mode === 'service' && dataLeft() < PROCESSING.service.data) mode = 'tablet';\n  const how = PROCESSING[mode];\n\n  runTask(READ_MINUTES + how.minutes, READ_BATTERY, 'processor', `Read the sensors at ${def.name}.`);\n\n  if (mode !== state.settings.processing) {\n    spend(0, 0, 'network', 'The allowance is spent, so the readings had to be worked out on the tablet.');\n  }\n  if (how.data > 0) {\n    spendData(how.data, `Sent ${def.name}\\u2019s readings out to be processed, which spent ${pf.format(how.data / 100)} of the allowance.`);\n  }\n\n  if (def.flooded) {\n    if (state.settings.recheck === 'recheck') {\n      spend(RECHECK_MINUTES, 0, 'processor', `Read the repaired node at ${def.name} twice and compared the two.`);\n    } else {\n      f.badData = true;\n      spend(0, 0, 'processor', `The repaired node at ${def.name} garbled a reading, and it went into the file looking real.`);\n    }\n  }\n  autoSendTick();\n}\n\nfunction doPass(id) {\n  travelTo(id);\n  const f = fieldState(id);\n  const q = IMAGE[state.settings.quality];\n  f.pass = state.settings.quality;\n  state.passUnits += q.units;\n  runTask(q.minutes, DRONE_BATTERY, 'storage',\n    `Flew ${fieldDef(id).name} at ${q.word} quality, using ${pf.format(q.units / 100)} of the storage.`);\n  autoSendTick();\n}\n\nfunction doSkipPass(id) {\n  fieldState(id).skipped = true;\n  spend(0, 0, 'storage', `No drone pass over ${fieldDef(id).name}. The office will not see this one.`);\n}\n\nfunction doLog(id) {\n  travelTo(id);\n  const f = fieldState(id);\n  const def = fieldDef(id);\n  f.logged = true;\n  f.badCall = f.badData;\n  runTask(LOG_MINUTES, LOG_BATTERY, 'processor', `Logged the call for ${def.name}.`);\n  if (state.settings.autoClose === 'close') {\n    f.closed = true;\n    spend(CLOSE_MINUTES, 0, 'memory', `Closed the note for ${def.name} automatically.`);\n  }\n  autoSendTick();\n}\n\nfunction doCloseAll() {\n  const open = state.fields.filter(function (f) { return f.logged && !f.closed; });\n  if (open.length === 0) return;\n  open.forEach(function (f) { f.closed = true; });\n  spend(CLOSE_MINUTES * open.length, 0, 'memory', `Closed ${nf.format(open.length)} open notes by hand.`);\n}\n\n/* Re-reading a flooded node fixes the data, but a call that was already logged\n   from the garbled version stays logged. */\nfunction doRereadFlooded() {\n  const bad = badFields();\n  if (bad.length === 0) return;\n  bad.forEach(function (f) { f.badData = false; });\n  spend(RECHECK_MINUTES * bad.length, 0, 'processor',\n    `Read ${nf.format(bad.length)} repaired nodes again and replaced the garbled values.`);\n}\n\nfunction doFinish() {\n  const ready = pendingNotes();\n  /* If there is not enough allowance left, the notes simply stay on the tablet\n     rather than the morning becoming impossible to end. */\n  if (ready.length > 0 && sendCost(ready).data <= dataLeft()) sendNotes(false);\n  state.over = true;\n  if (!state.endReason) state.endReason = state.clock >= DAY_END ? 'clock' : 'finished';\n}\n\nfunction changeSetting(id, value) {\n  if (busy || state.over) return;\n  if (state.settings[id] === value) return;\n\n  const setting = settingById(id);\n  const fromLabel = optionLabel(setting, state.settings[id]);\n  const toLabel = optionLabel(setting, value);\n  state.settings[id] = value;\n  state.justFixed = null;\n\n  if (state.problem && problemById(state.problem).setting !== id) state.wrongTries += 1;\n\n  let minutes = setting.real ? REAL_SETTING_MINUTES : IDLE_SETTING_MINUTES;\n  if (id === 'archive') minutes += ARCHIVE_MINUTES;\n\n  const text = setting.real\n    ? `${setting.name} changed from ${fromLabel} to ${toLabel}.`\n    : `${setting.name} changed from ${fromLabel} to ${toLabel}. Nothing about the morning changed.`;\n  spend(minutes, 0, 'settings', text, true);\n\n  if (id === 'archive' && value === 'office') state.missedHistory = true;\n  if (id === 'autoClose' && value === 'close') doCloseAll();\n  if (id === 'recheck' && value === 'recheck') doRereadFlooded();\n\n  if (checkOver()) state.view = 'report';\n  syncProblem();\n  render();\n}\n\n/* ================= running an action ================= */\n\nfunction reducedMotion() {\n  return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);\n}\n\nfunction act(fn) {\n  if (busy || state.over) return;\n  const duration = reducedMotion() ? 0 : Math.min(650, Math.round(150 + (timeMultiplier() - 1) * 420));\n  if (duration === 0) { finishAction(fn); return; }\n  busy = true;\n  els.procFill.style.transitionDuration = '0ms';\n  els.procFill.style.width = '0%';\n  window.setTimeout(function () {\n    els.procFill.style.transitionDuration = `${duration}ms`;\n    els.procFill.style.width = '100%';\n  }, 20);\n  window.setTimeout(function () {\n    els.procFill.style.transitionDuration = '0ms';\n    els.procFill.style.width = '0%';\n    busy = false;\n    finishAction(fn);\n  }, duration + 40);\n}\n\nfunction finishAction(fn) {\n  state.justFixed = null;\n  fn();\n  checkOver();\n  syncProblem();\n  if (state.over) state.view = 'report';\n  render();\n  focusMain();\n}\n\n/* ================= small helpers ================= */\n\nfunction clockText(minutes) {\n  const m = typeof minutes === 'number' ? minutes : state.clock;\n  return tf.format(new Date(2026, 0, 1, 0, Math.round(Math.min(m, 24 * 60 - 1))));\n}\n\nfunction optionLabel(setting, value) {\n  for (let i = 0; i < setting.options.length; i++) {\n    if (setting.options[i].value === value) return setting.options[i].label;\n  }\n  return String(value);\n}\n\nfunction speedText() {\n  const m = timeMultiplier();\n  return m <= 1.05 ? 'Full speed' : `${df.format(m)} times slower`;\n}\n\nfunction makeText(tag, className, text) {\n  const el = document.createElement(tag);\n  if (className) el.className = className;\n  if (text !== undefined && text !== null) el.textContent = text;\n  return el;\n}\n\nfunction clearChildren(el) { el.textContent = ''; }\n\nfunction icon(symbolId, className) {\n  const box = document.createElement('span');\n  box.className = className;\n  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');\n  svg.setAttribute('aria-hidden', 'true');\n  svg.setAttribute('focusable', 'false');\n  const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');\n  use.setAttribute('href', `#${symbolId}`);\n  svg.appendChild(use);\n  box.appendChild(svg);\n  return box;\n}\n\nfunction button(label, kind, handler, disabled) {\n  const b = document.createElement('button');\n  b.type = 'button';\n  b.className = `btn ${kind}`;\n  b.textContent = label;\n  b.disabled = !!disabled;\n  b.addEventListener('click', handler);\n  return b;\n}\n\n/* ================= status ================= */\n\nfunction renderStatus() {\n  const drive = driveUsed();\n  const data = dataLeft();\n  els.clock.textContent = clockText();\n  els.battery.textContent = state.settings.batteryPercent === 'on' ? pf.format(state.battery / 100) : '';\n  els.drive.textContent = pf.format(drive / 100);\n  els.data.textContent = pf.format(data / 100);\n  els.speed.textContent = speedText();\n\n  els.battery.className = 'stat-value' + (state.battery <= 20 ? ' bad' : state.battery <= 45 ? ' warn' : '');\n  els.drive.className = 'stat-value' + (drive >= 90 ? ' bad' : drive >= 75 ? ' warn' : '');\n  els.data.className = 'stat-value' + (data <= 15 ? ' bad' : data <= DATA_GOAL ? ' warn' : '');\n  els.speed.className = 'stat-value' + (timeMultiplier() > 1.5 ? ' bad' : timeMultiplier() > 1.05 ? ' warn' : '');\n  els.clock.className = 'stat-value' + (state.clock >= DAY_END - 25 ? ' bad' : state.clock >= DAY_END - 55 ? ' warn' : '');\n\n  const batteryLevel = state.battery <= 20 ? ' bad' : state.battery <= 45 ? ' warn' : '';\n  const driveLevel = drive >= 90 ? ' bad' : drive >= 75 ? ' warn' : '';\n  const dataLevel = data <= 15 ? ' bad' : data <= DATA_GOAL ? ' warn' : '';\n  els.gaugeBattery.style.width = `${Math.max(0, Math.min(100, state.battery))}%`;\n  els.gaugeBattery.className = 'gauge-fill battery' + batteryLevel;\n  els.gaugeDrive.style.width = `${Math.max(0, Math.min(100, drive))}%`;\n  els.gaugeDrive.className = 'gauge-fill storage' + driveLevel;\n  els.gaugeData.style.width = `${Math.max(0, Math.min(100, data))}%`;\n  els.gaugeData.className = 'gauge-fill data' + dataLevel;\n\n  els.tabDot.hidden = !state.problem;\n}\n\n/* ================= fields view ================= */\n\nfunction renderBanner() {\n  if (!state.problem) {\n    els.banner.hidden = true;\n    clearChildren(els.banner);\n    return;\n  }\n  const p = problemById(state.problem);\n  els.banner.hidden = false;\n  els.banner.className = 'banner' + (p.blocks ? ' hard' : '');\n  clearChildren(els.banner);\n\n  const head = document.createElement('div');\n  head.className = 'banner-head';\n  head.appendChild(icon('a-alert', 'banner-icon'));\n  head.appendChild(makeText('p', 'banner-title', p.title));\n  els.banner.appendChild(head);\n\n  els.banner.appendChild(makeText('p', 'banner-voice', p.voice));\n\n  const row = document.createElement('div');\n  row.className = 'actions';\n  row.appendChild(button('Open Settings', 'btn-go', function () { goTab('settings'); }));\n  if (!p.blocks) row.appendChild(button('Not now', 'btn-alt', dismissBanner));\n  els.banner.appendChild(row);\n}\n\nfunction stepPip(symbol, done) {\n  return icon(symbol, 'pip' + (done ? ' pip-done' : ''));\n}\n\nfunction renderFields() {\n  const done = state.fields.filter(function (f) { return f.logged; }).length;\n  els.fieldsChip.textContent = `${nf.format(done)} of ${nf.format(FIELDS.length)} done`;\n  clearChildren(els.fields);\n  FIELDS.forEach(function (field) {\n    const f = fieldState(field.id);\n    const li = document.createElement('li');\n    const card = document.createElement('button');\n    card.type = 'button';\n    card.className = 'player' + (state.selected === field.id ? ' picked' : '') + (f.logged ? ' done' : '');\n    card.setAttribute('aria-pressed', state.selected === field.id ? 'true' : 'false');\n\n    card.appendChild(icon(field.icon, 'player-icon'));\n    card.appendChild(makeText('span', 'player-name', field.name));\n\n    const pips = document.createElement('span');\n    pips.className = 'pips';\n    pips.appendChild(stepPip('a-read', f.read));\n    pips.appendChild(stepPip('a-drone', f.pass !== null || f.skipped));\n    pips.appendChild(stepPip('a-log', f.logged));\n    card.appendChild(pips);\n\n    if (state.atField === field.id) card.appendChild(icon('a-truck', 'here-badge'));\n\n    const sr = makeText('span', 'sr-only',\n      `${f.read ? 'Sensors read' : 'Sensors not read'}. ${f.pass !== null ? 'Drone pass flown' : f.skipped ? 'No drone pass' : 'No drone pass yet'}. ${f.logged ? 'Call logged' : 'Call not logged'}. ${state.atField === field.id ? 'The truck is here.' : ''}`);\n    card.appendChild(sr);\n\n    card.addEventListener('click', function () {\n      state.selected = field.id;\n      state.justFixed = null;\n      render();\n    });\n    li.appendChild(card);\n    els.fields.appendChild(li);\n  });\n}\n\nfunction renderDetail() {\n  if (!state.selected) {\n    els.detail.hidden = false;\n    clearChildren(els.detail);\n    els.detail.className = 'detail empty';\n    els.detail.appendChild(makeText('p', null, 'Pick a field to get started.'));\n    return;\n  }\n\n  const field = fieldDef(state.selected);\n  const f = fieldState(state.selected);\n  const mult = timeMultiplier();\n  const away = state.atField !== field.id;\n\n  els.detail.hidden = false;\n  els.detail.className = 'detail';\n  clearChildren(els.detail);\n\n  const head = document.createElement('div');\n  head.className = 'detail-head';\n  head.appendChild(icon(field.icon, 'detail-icon'));\n  const idBox = document.createElement('span');\n  idBox.className = 'detail-id';\n  idBox.appendChild(makeText('span', 'detail-name', field.name));\n  idBox.appendChild(makeText('span', 'detail-kind', field.crop));\n  head.appendChild(idBox);\n  els.detail.appendChild(head);\n\n  const bodyBox = document.createElement('div');\n  bodyBox.className = 'detail-body';\n  els.detail.appendChild(bodyBox);\n\n  bodyBox.appendChild(makeText('p', 'complaint', field.concern));\n\n  if (f.read) {\n    const ul = document.createElement('ul');\n    ul.className = 'findings';\n    field.readings.forEach(function (r) { ul.appendChild(makeText('li', null, r)); });\n    bodyBox.appendChild(ul);\n  }\n\n  if (f.badData) {\n    bodyBox.appendChild(makeText('p', 'detail-flag',\n      'Some of these numbers came off the repaired node and cannot be trusted. A call logged now will be the wrong one.'));\n  }\n\n  if (f.logged) {\n    bodyBox.appendChild(makeText('p', 'detail-call',\n      `Logged: ${f.badCall ? field.badCall : field.goodCall}`));\n  }\n\n  if (f.pass) {\n    const q = IMAGE[f.pass];\n    const fig = document.createElement('figure');\n    fig.className = 'shot';\n    const img = document.createElement('img');\n    img.src = field.image;\n    img.alt = field.alt;\n    img.width = 480;\n    img.height = 360;\n    img.className = `shot-img q-${f.pass}`;\n    fig.appendChild(img);\n    fig.appendChild(makeText('figcaption', 'shot-cap',\n      `${q.word} quality. Used ${pf.format(q.units / 100)} of the storage, rated ${nf.format(q.detail)} out of 100.`));\n    bodyBox.appendChild(fig);\n  }\n\n  if (away && tasksLeftHere(field.id) > 0) {\n    bodyBox.appendChild(makeText('p', 'detail-travel',\n      `The truck is not at this field. The first thing you do here costs ${nf.format(TRAVEL_MINUTES)} minutes of driving.`));\n  }\n\n  const actions = document.createElement('div');\n  actions.className = 'actions';\n\n  if (!f.read) {\n    const how = PROCESSING[state.settings.processing];\n    actions.appendChild(button(\n      `Read the sensors (${nf.format(Math.round((READ_MINUTES + how.minutes) * mult))} min)`,\n      'btn-go',\n      function () { act(function () { doRead(field.id); }); },\n      blockedAction('read')\n    ));\n  }\n\n  if (f.read && f.pass === null && !f.skipped) {\n    const q = IMAGE[state.settings.quality];\n    actions.appendChild(button(\n      `Fly the drone (${nf.format(Math.round(q.minutes * mult))} min, ${pf.format(q.units / 100)} of the storage)`,\n      'btn-go',\n      function () { act(function () { doPass(field.id); }); },\n      blockedAction('drone') || !passFits()\n    ));\n    actions.appendChild(button('Skip the pass', 'btn-alt', function () { act(function () { doSkipPass(field.id); }); }));\n  }\n\n  if (f.read && !f.logged) {\n    actions.appendChild(button(\n      `Log the call (${nf.format(Math.round(LOG_MINUTES * mult))} min)`,\n      'btn-go',\n      function () { act(function () { doLog(field.id); }); },\n      blockedAction('log')\n    ));\n  }\n\n  if (f.logged && !f.closed) {\n    actions.appendChild(button(`Close the note (${nf.format(CLOSE_MINUTES)} min)`, 'btn-alt',\n      function () { act(doCloseAll); }));\n  }\n\n  bodyBox.appendChild(actions);\n\n  if (!passFits() && f.read && f.pass === null && !f.skipped) {\n    bodyBox.appendChild(makeText('p', 'detail-note',\n      `Storage has ${pf.format(driveFree() / 100)} free and this pass needs ${pf.format(IMAGE[state.settings.quality].units / 100)}.`));\n  }\n}\n\nfunction tasksLeftHere(id) {\n  const f = fieldState(id);\n  let n = 0;\n  if (!f.read) n += 1;\n  if (f.pass === null && !f.skipped) n += 1;\n  if (!f.logged) n += 1;\n  return n;\n}\n\nfunction renderFinish() {\n  clearChildren(els.finish);\n  const ready = pendingNotes();\n  const left = tasksLeft();\n\n  const row = document.createElement('div');\n  row.className = 'actions';\n\n  if (ready.length === 0) {\n    row.appendChild(button('Finish the morning', 'btn-warn btn-lg', function () { act(doFinish); }));\n  } else if (sendCost(ready).data > dataLeft()) {\n    row.appendChild(button('Finish without sending', 'btn-warn btn-lg', function () { act(doFinish); }));\n  } else {\n    const cost = sendCost(ready);\n    row.appendChild(button(\n      `Send to the office (${nf.format(cost.minutes)} min, ${pf.format(cost.data / 100)} of the allowance)`,\n      'btn-warn btn-lg',\n      function () { act(doFinish); }\n    ));\n  }\n  els.finish.appendChild(row);\n\n  if (ready.length > 0) {\n    const cost = sendCost(ready);\n    if (cost.data > dataLeft()) {\n      els.finish.appendChild(makeText('p', 'finish-note',\n        `Sending ${nf.format(ready.length)} notes needs ${pf.format(cost.data / 100)} of the allowance and only ${pf.format(dataLeft() / 100)} is left. Those notes will stay on the tablet.`));\n    } else {\n      els.finish.appendChild(makeText('p', 'finish-note',\n        `${nf.format(ready.length)} notes are waiting. One connection covers all of them.`));\n    }\n  }\n\n  if (left > 0) {\n    els.finish.appendChild(makeText('p', 'finish-note', `${nf.format(left)} things are still undone out in the fields.`));\n  }\n}\n\nfunction renderFieldsView() {\n  renderBanner();\n  renderFields();\n  renderDetail();\n  renderFinish();\n}\n\n/* ================= settings view ================= */\n\nfunction renderSymptom() {\n  if (state.justFixed) {\n    els.symptom.hidden = false;\n    els.symptom.className = 'symptom good';\n    clearChildren(els.symptom);\n    els.symptom.appendChild(makeText('p', 'symptom-line', state.justFixed));\n    return;\n  }\n  if (!state.problem) {\n    els.symptom.hidden = true;\n    clearChildren(els.symptom);\n    return;\n  }\n  const p = problemById(state.problem);\n  els.symptom.hidden = false;\n  els.symptom.className = 'symptom';\n  clearChildren(els.symptom);\n  els.symptom.appendChild(makeText('p', 'symptom-line', p.symptom));\n  if (state.wrongTries >= HINT_AFTER_TRIES) {\n    els.symptom.appendChild(makeText('p', 'symptom-hint', `Try the ${groupById(p.group).name} settings.`));\n  }\n}\n\nfunction renderSettings() {\n  renderSymptom();\n  els.settingsNote.textContent = 'Opening a setting is free. Changing one costs time.';\n\n  clearChildren(els.groups);\n  GROUPS.forEach(function (group) {\n    const section = document.createElement('section');\n    section.className = `group fam-${group.id}`;\n\n    const head = document.createElement('div');\n    head.className = 'group-head';\n    head.appendChild(icon(group.icon, 'group-icon'));\n    head.appendChild(makeText('h3', 'group-name', group.name));\n    section.appendChild(head);\n\n    SETTINGS.filter(function (s) { return s.group === group.id; }).forEach(function (setting) {\n      const row = document.createElement('details');\n      row.className = 'srow';\n\n      const summary = document.createElement('summary');\n      summary.className = 'srow-summary';\n      summary.appendChild(makeText('span', 'srow-name', setting.name));\n      summary.appendChild(makeText('span', 'srow-value', optionLabel(setting, state.settings[setting.id])));\n      summary.appendChild(icon('a-chevron', 'srow-chevron'));\n      row.appendChild(summary);\n\n      const bodyBox = document.createElement('div');\n      bodyBox.className = 'srow-body';\n      bodyBox.appendChild(makeText('p', 'srow-why', setting.why));\n\n      const opts = document.createElement('div');\n      opts.className = 'options';\n      opts.setAttribute('role', 'group');\n      opts.setAttribute('aria-label', setting.name);\n      setting.options.forEach(function (opt) {\n        const b = document.createElement('button');\n        b.type = 'button';\n        b.className = 'option';\n        b.setAttribute('aria-pressed', state.settings[setting.id] === opt.value ? 'true' : 'false');\n        b.appendChild(makeText('span', 'option-label', opt.label));\n        b.appendChild(makeText('span', 'option-note', opt.note));\n        b.addEventListener('click', function () { changeSetting(setting.id, opt.value); });\n        opts.appendChild(b);\n      });\n      bodyBox.appendChild(opts);\n      row.appendChild(bodyBox);\n      section.appendChild(row);\n    });\n\n    els.groups.appendChild(section);\n  });\n}\n\n/* ================= report ================= */\n\nfunction menuMinutesSpent() {\n  let t = 0;\n  state.log.forEach(function (e) { if (e.menu) t += e.minutes; });\n  return t;\n}\n\nfunction wastedMenuMinutes() {\n  let t = 0;\n  state.log.forEach(function (e) {\n    if (e.menu && e.text.indexOf('Nothing about the morning changed.') !== -1) t += e.minutes;\n  });\n  return t;\n}\n\nfunction drivingMinutes() {\n  let t = 0;\n  state.log.forEach(function (e) { if (e.cat === 'driving') t += e.minutes; });\n  return t;\n}\n\nfunction totalsByCategory() {\n  const totals = {\n    processor: { m: 0, b: 0, d: 0 },\n    storage: { m: 0, b: 0, d: 0 },\n    network: { m: 0, b: 0, d: 0 },\n    memory: { m: 0, b: 0, d: 0 },\n    settings: { m: 0, b: 0, d: 0 }\n  };\n  state.log.forEach(function (e) {\n    if (!totals[e.cat]) return;\n    totals[e.cat].m += e.minutes;\n    totals[e.cat].b += e.battery;\n    totals[e.cat].d += e.data;\n  });\n  return totals;\n}\n\nconst TALLY_CARDS = [\n  { id: 'processor', name: 'Processor', symbol: 't-processor' },\n  { id: 'storage', name: 'Storage', symbol: 't-storage' },\n  { id: 'network', name: 'Network', symbol: 't-network' },\n  { id: 'memory', name: 'Memory', symbol: 't-memory' },\n  { id: 'settings', name: 'Settings', symbol: 'g-settings' }\n];\n\nfunction renderTally() {\n  const totals = totalsByCategory();\n  let topId = null;\n  let topScore = 0;\n  TALLY_CARDS.forEach(function (c) {\n    let score = totals[c.id].m / (DAY_END - DAY_START) + totals[c.id].b / 100 + totals[c.id].d / 100;\n    if (c.id === 'storage') score += state.passUnits / 100;\n    if (score > topScore) { topScore = score; topId = c.id; }\n  });\n\n  clearChildren(els.tally);\n  TALLY_CARDS.forEach(function (c) {\n    const card = document.createElement('div');\n    card.className = `tally-card cat-${c.id}` + (c.id === topId ? ' is-top' : '');\n    const head = document.createElement('div');\n    head.className = 'tally-head';\n    head.appendChild(icon(c.symbol, 'tally-dot'));\n    head.appendChild(makeText('span', 'tally-name', c.name));\n    card.appendChild(head);\n\n    const bodyBox = document.createElement('div');\n    bodyBox.className = 'tally-body';\n    bodyBox.appendChild(makeText('p', 'tally-val', `${nf.format(totals[c.id].m)} min`));\n    bodyBox.appendChild(makeText('p', 'tally-sub', `${pf.format(totals[c.id].b / 100)} of the battery`));\n    if (c.id === 'storage') bodyBox.appendChild(makeText('p', 'tally-sub', `${pf.format(state.passUnits / 100)} of the storage in drone passes`));\n    if (c.id === 'network') {\n      bodyBox.appendChild(makeText('p', 'tally-sub', `${pf.format(totals.network.d / 100)} of the month\\u2019s allowance`));\n      bodyBox.appendChild(makeText('p', 'tally-sub', `${nf.format(state.sends)} connections to the office`));\n    }\n    if (c.id === 'settings') {\n      bodyBox.appendChild(makeText('p', 'tally-sub', `${nf.format(menuMinutesSpent())} min changing settings`));\n      bodyBox.appendChild(makeText('p', 'tally-sub', `${nf.format(wastedMenuMinutes())} min of that changed nothing`));\n    }\n    if (c.id === topId) bodyBox.appendChild(makeText('p', 'tally-flag', 'Biggest cost'));\n    card.appendChild(bodyBox);\n    els.tally.appendChild(card);\n  });\n}\n\nfunction renderCalls() {\n  clearChildren(els.calls);\n  FIELDS.forEach(function (field) {\n    const f = fieldState(field.id);\n    const li = document.createElement('li');\n    li.className = !f.logged ? 'unmet' : f.badCall ? 'unmet' : 'met';\n    li.appendChild(makeText('span', 'call-name', field.name));\n    li.appendChild(makeText('span', 'call-text',\n      f.logged ? (f.badCall ? field.badCall : field.goodCall) : 'No call was logged for this field.'));\n    if (f.logged && f.badCall) li.appendChild(makeText('span', 'call-cost', field.badCost));\n    els.calls.appendChild(li);\n  });\n}\n\nfunction renderReport() {\n  const sent = state.fields.filter(function (f) { return f.sent; }).length;\n  const flown = passesFlown();\n  const detail = imageDetailAverage();\n  const wrong = state.fields.filter(function (f) { return f.logged && f.badCall; }).length;\n  const logged = state.fields.filter(function (f) { return f.logged; }).length;\n\n  const rows = [\n    { name: 'Field notes at the office', value: `${nf.format(sent)} of ${nf.format(FIELDS.length)}`, met: sent === FIELDS.length },\n    { name: 'Finished before noon', value: state.endReason === 'finished' ? `Done at ${clockText()}` : `Stopped at ${clockText()}`, met: state.endReason === 'finished' },\n    { name: 'Battery left', value: pf.format(state.battery / 100), met: state.battery > 0 },\n    { name: 'Fields flown', value: `${nf.format(flown)} of ${nf.format(FIELDS.length)}`, met: flown === FIELDS.length },\n    { name: 'How useful the drone images were', value: `${nf.format(detail)} out of 100`, met: detail >= USEFUL_IMAGE_SCORE },\n    { name: 'Calls made on good data', value: `${nf.format(logged - wrong)} of ${nf.format(FIELDS.length)}`, met: wrong === 0 && logged === FIELDS.length },\n    { name: 'Data allowance left for the month', value: pf.format(dataLeft() / 100), met: dataLeft() >= DATA_GOAL }\n  ];\n\n  const passed = rows.every(function (r) { return r.met; });\n  els.reportHeadline.textContent = passed ? 'Denise got through the morning' : 'The farm came up short';\n  els.verdict.textContent = passed\n    ? `All ${nf.format(rows.length)} goals met`\n    : `${nf.format(rows.filter(function (r) { return !r.met; }).length)} of ${nf.format(rows.length)} goals missed`;\n  els.verdict.className = passed ? 'verdict good' : 'verdict';\n\n  if (state.endReason === 'battery') els.reportSub.textContent = `The tablet died at ${clockText()}.`;\n  else if (state.endReason === 'clock') els.reportSub.textContent = `It hit ${clockText()} with work still left.`;\n  else if (passed) els.reportSub.textContent = 'Every call was right, every note landed, and the month still has room in it.';\n  else els.reportSub.textContent = 'She finished, but something did not make it.';\n\n  clearChildren(els.reportList);\n  rows.forEach(function (row) {\n    const li = document.createElement('li');\n    li.className = row.met ? 'met' : 'unmet';\n    li.appendChild(makeText('span', 'rep-name', row.name));\n    li.appendChild(makeText('span', 'rep-val', row.met ? row.value : `${row.value} (not enough)`));\n    els.reportList.appendChild(li);\n  });\n\n  renderCalls();\n  renderTally();\n\n  clearChildren(els.reportNotes);\n  const notes = [];\n  const wasted = wastedMenuMinutes();\n  const totals = totalsByCategory();\n\n  if (wrong > 0) {\n    notes.push(`${nf.format(wrong)} of the calls came out of garbled readings. Repairing a sensor puts the hardware right, but it does nothing about numbers that were already written down wrong.`);\n  }\n  if (state.settings.processing === 'service' && totals.network.d > 0) {\n    notes.push('Every raw reading got shipped off the farm to be processed. Sending a summary instead moves the same information for a fraction of the allowance.');\n  }\n  if (state.settings.processing === 'tablet') {\n    notes.push('Nothing left the farm for processing, which cost no allowance at all and cost a lot of morning.');\n  }\n  if (state.sends >= 3) {\n    notes.push(`The tablet opened ${nf.format(state.sends)} separate connections to the office. Each one paid the same ${pf.format(SEND_OVERHEAD_DATA / 100)} of overhead before any readings moved.`);\n  }\n  if (state.failedSends > 0) {\n    notes.push('At least one send was refused because there was not enough allowance left. No setting can buy more data in the middle of the month.');\n  }\n  if (wasted >= 3) {\n    notes.push(`${nf.format(wasted)} minutes went into settings that do not affect speed, battery, storage, or the allowance.`);\n  }\n  if (state.settings.readings === 'all') {\n    notes.push('The dashboard drew every reading all morning, which is why every single task ran slow.');\n  }\n  if (state.settings.quality === 'original' && state.passUnits > 0) {\n    notes.push('Every pass stayed at original quality, which is why the storage filled and the upload was so expensive.');\n  }\n  if (detail > 0 && detail < USEFUL_IMAGE_SCORE) {\n    notes.push('The images were cheap to store and too coarse to be worth flying. The office could not see what Denise saw.');\n  }\n  if (state.moves > FIELDS.length) {\n    notes.push(`The truck moved ${nf.format(state.moves)} times for four fields, which cost ${nf.format(drivingMinutes())} minutes of driving.`);\n  }\n  if (state.missedHistory) {\n    notes.push('She wanted to compare Creek Field against the same week two seasons ago. Those records were back on the office computer.');\n  }\n  if (openNotes() >= 2) {\n    notes.push(`She finished with ${nf.format(openNotes())} notes open, which is why the app never sped back up.`);\n  }\n  notes.forEach(function (t) { els.reportNotes.appendChild(makeText('p', 'report-note', t)); });\n\n  clearChildren(els.questions);\n  QUESTIONS.forEach(function (q) { els.questions.appendChild(makeText('li', null, q)); });\n}\n\n/* ================= views ================= */\n\nfunction render() {\n  /* Each view is a separate screen, so switching to one should start it at the\n     top rather than inheriting wherever the last screen was scrolled to. */\n  viewJustChanged = renderedView !== state.view;\n  renderedView = state.view;\n\n  const chrome = state.view !== 'brief';\n  els.statusbar.hidden = !chrome;\n  els.procbar.hidden = !chrome;\n  els.tabbar.hidden = !chrome || state.over;\n  els.resetBtn.hidden = !chrome;\n  if (chrome) renderStatus();\n\n  Object.keys(els.views).forEach(function (key) { els.views[key].hidden = key !== state.view; });\n\n  if (state.view === 'brief') renderGoals();\n  if (state.view === 'fields') renderFieldsView();\n  if (state.view === 'settings') renderSettings();\n  if (state.view === 'report') renderReport();\n\n  els.tabs.forEach(function (tab) {\n    if (tab.dataset.tab === state.view) tab.setAttribute('aria-current', 'page');\n    else tab.removeAttribute('aria-current');\n  });\n\n  if (viewJustChanged) els.body.scrollTop = 0;\n}\n\nfunction focusMain() {\n  const view = els.views[state.view];\n  if (!view) return;\n  const first = view.querySelector('.btn') || view.querySelector('button');\n  if (!first) return;\n  /* On a fresh screen, keep the scroll at the top instead of letting focus drag\n     the page down to whatever control happens to be first. Inside a screen, let\n     focus scroll normally so the control the student just used stays visible. */\n  first.focus({ preventScroll: viewJustChanged });\n  if (viewJustChanged) els.body.scrollTop = 0;\n  viewJustChanged = false;\n}\n\nlet sheetReturnFocus = null;\n\nfunction openSheet() {\n  if (busy) return;\n  sheetReturnFocus = document.activeElement;\n  els.sheet.hidden = false;\n  els.sheetYes.focus();\n}\n\nfunction closeSheet() {\n  els.sheet.hidden = true;\n  if (sheetReturnFocus && sheetReturnFocus.focus) sheetReturnFocus.focus();\n  sheetReturnFocus = null;\n}\n\n/* Keeps Tab inside the dialog while it is open, since the rest of the screen\n   stays in the document behind it. */\nfunction trapSheetFocus(event) {\n  if (els.sheet.hidden) return;\n  if (event.key === 'Escape') { closeSheet(); return; }\n  if (event.key !== 'Tab') return;\n  const stops = [els.sheetYes, els.sheetNo];\n  const first = stops[0];\n  const last = stops[stops.length - 1];\n  if (event.shiftKey && document.activeElement === first) {\n    event.preventDefault();\n    last.focus();\n  } else if (!event.shiftKey && document.activeElement === last) {\n    event.preventDefault();\n    first.focus();\n  }\n}\n\nfunction confirmRestart() {\n  closeSheet();\n  restart();\n}\n\nfunction goTab(name) {\n  if (busy || state.over) return;\n  if (name !== 'settings') state.justFixed = null;\n  state.view = name;\n  render();\n  focusMain();\n}\n\nfunction renderGoals() {\n  clearChildren(els.briefGoals);\n  GOALS.forEach(function (text) {\n    const li = document.createElement('li');\n    li.appendChild(icon('a-check', 'goal-icon'));\n    li.appendChild(makeText('span', null, text));\n    els.briefGoals.appendChild(li);\n  });\n}\n\nfunction startMorning() {\n  syncProblem();\n  state.view = 'fields';\n  render();\n  focusMain();\n}\n\n/* A reset drops the student back on the scenario screen, so the setup and the\n   goals are in front of them again before the second attempt. */\nfunction restart() {\n  els.sheet.hidden = true;\n  renderedView = null;\n  state = freshState();\n  render();\n  focusMain();\n}\n\n/* ================= boot ================= */\n\nfunction cacheElements() {\n  els.statusbar = document.querySelector('.statusbar');\n  els.body = document.querySelector('.body');\n  els.procbar = document.querySelector('.procbar');\n  els.clock = document.getElementById('stat-clock');\n  els.battery = document.getElementById('stat-battery');\n  els.gaugeBattery = document.getElementById('gauge-battery');\n  els.gaugeDrive = document.getElementById('gauge-drive');\n  els.gaugeData = document.getElementById('gauge-data');\n  els.drive = document.getElementById('stat-drive');\n  els.data = document.getElementById('stat-data');\n  els.speed = document.getElementById('stat-speed');\n  els.procFill = document.getElementById('procbar-fill');\n  els.views = {\n    brief: document.getElementById('view-brief'),\n    fields: document.getElementById('view-fields'),\n    settings: document.getElementById('view-settings'),\n    report: document.getElementById('view-report')\n  };\n  els.banner = document.getElementById('banner');\n  els.fields = document.getElementById('fields');\n  els.fieldsChip = document.getElementById('fields-chip');\n  els.detail = document.getElementById('detail');\n  els.finish = document.getElementById('finish');\n  els.symptom = document.getElementById('symptom');\n  els.settingsNote = document.getElementById('settings-note');\n  els.groups = document.getElementById('groups');\n  els.reportHeadline = document.getElementById('report-headline');\n  els.reportSub = document.getElementById('report-sub');\n  els.verdict = document.getElementById('verdict');\n  els.reportList = document.getElementById('report-list');\n  els.calls = document.getElementById('calls');\n  els.tally = document.getElementById('tally');\n  els.reportNotes = document.getElementById('report-notes');\n  els.questions = document.getElementById('questions');\n  els.tabbar = document.getElementById('tabbar');\n  els.tabDot = document.getElementById('tab-dot');\n  els.briefGoals = document.getElementById('brief-goals');\n  els.resetBtn = document.getElementById('reset-btn');\n  els.sheet = document.getElementById('sheet');\n  els.sheetYes = document.getElementById('sheet-yes');\n  els.sheetNo = document.getElementById('sheet-no');\n  els.tabs = Array.prototype.slice.call(document.querySelectorAll('.tab'));\n}\n\nfunction bindEvents() {\n  document.getElementById('start-btn').addEventListener('click', startMorning);\n  document.getElementById('again-btn').addEventListener('click', restart);\n  els.resetBtn.addEventListener('click', openSheet);\n  els.sheetYes.addEventListener('click', confirmRestart);\n  els.sheetNo.addEventListener('click', closeSheet);\n  document.addEventListener('keydown', trapSheetFocus);\n  els.tabs.forEach(function (tab) {\n    tab.addEventListener('click', function () { goTab(tab.dataset.tab); });\n  });\n}\n\nfunction init() {\n  try {\n    cacheElements();\n    bindEvents();\n    state = freshState();\n    render();\n  } catch (error) {\n    /* Students get a plain message; the real error goes to the console so\n       whoever is fixing it can see what actually broke. */\n    console.error('AcreWatch could not start.', error);\n    const p = document.createElement('p');\n    p.textContent = 'This activity could not load. Refresh the page, and tell your teacher if it happens again.';\n    document.body.insertBefore(p, document.body.firstChild);\n  }\n}\n\ninit();",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    },
    "display_name": "Drone Software",
    "bubble_choice_description": "Help Denise to optimize her drone software that helps her track the health of her crops.",
    "thumbnail_url": "https://images.code.org/ab215dc7ad256110532e4b85d3abd594-denise-aif-career-journey-denise-is-sitting-in-her-truck-using-a-tablet-th-1.png"
  },
