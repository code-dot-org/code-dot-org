  "properties": {
    "encrypted": "false",
    "long_instructions": "**Goal:** Protect Cybershield Inc. Learn about 4 cyber threats. Choose the best defense for each one.\r\n\r\n1. On the **Security Dashboard**, click any threat to start.\r\n2. Click **Learn more about the threat** and read about the attack.\r\n3. Click **Investigate the threat** and finish the challenge:\r\n   - **Phishing Email:** Find all 5 red flags (warning signs) in the email.\r\n   - **Weak Passwords:** Try all 3 password-cracking methods.\r\n   - **Default Credentials:** For each of the three devices choose **Secure** or **Not Secure**.\r\n   - **Social Engineering:** Choose an **Attack type**, a **Target** and a **Manipulation strategy**. Look at the result with strong training and with weak training.\r\n4. Click **Mitigation**. Choose the best defense for this threat.\r\n5. Click **Return to the security dashboard**. Repeat these steps until **Network integrity** is 100%.",
    "offer_browser_tts": "false",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "true",
