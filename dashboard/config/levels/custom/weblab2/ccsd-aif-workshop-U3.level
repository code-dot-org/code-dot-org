        "8": {
          "id": "8",
          "name": "style.css",
          "contents": ":root {\n  --bg: #121831;\n  --panel: #1d2546;\n  --panel-raised: #28315a;\n  --card: #f2f3f7;\n  --card-selected: #ffe9ef;\n  --card-text: #1a1f3a;\n  --text: #ffffff;\n  --muted: #c8cde4;\n  --accent: #ff5c84;\n  --accent-dark: #c41a4c;\n  --good: #5ad995;\n  --good-dark: #1d7a49;\n  --bad: #ff8a8a;\n  --bad-dark: #b3261e;\n  --warn: #ffd166;\n  --high: #c2410c;\n  --focus: #ffd166;\n  --terminal: #0b0f1f;\n  --radius: 10px;\n  --gap: clamp(8px, 1.6vw, 16px);\n  --ease: cubic-bezier(0.2, 0.8, 0.2, 1);\n  --font: \"Poppins\", \"Segoe UI\", \"Helvetica Neue\", Arial, sans-serif;\n  --mono: \"Consolas\", \"Menlo\", \"Courier New\", monospace;\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\nhtml,\nbody {\n  height: 100%;\n  margin: 0;\n}\n\nbody {\n  background-color: var(--bg);\n  background-image:\n    linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);\n  background-size: 32px 32px;\n  color: var(--text);\n  font-family: var(--font);\n  font-size: 1rem;\n  line-height: 1.4;\n}\n\nh1,\nh2,\nh3,\np,\nul,\ndl,\ndd,\nfigure {\n  margin: 0;\n}\n\nbutton {\n  font: inherit;\n  color: inherit;\n  cursor: pointer;\n  transition: transform 0.12s var(--ease), box-shadow 0.15s var(--ease), border-color 0.15s, background-color 0.15s;\n}\n\nbutton:active {\n  transform: scale(0.97);\n}\n\nbutton:disabled {\n  cursor: not-allowed;\n}\n\n:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 2px;\n}\n\n.icon-sprite {\n  position: absolute;\n  width: 0;\n  height: 0;\n  overflow: hidden;\n}\n\n.icon,\n.map-icon {\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.icon {\n  width: 1.25em;\n  height: 1.25em;\n  flex-shrink: 0;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.app {\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  max-width: 1400px;\n  height: 100%;\n  margin: 0 auto;\n  padding: clamp(16px, 3vw, 40px) clamp(16px, 4vw, 56px);\n  gap: clamp(12px, 2vw, 24px);\n}\n\n/* Top bar */\n\n.topbar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--gap);\n}\n\n.tool-nav {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, max-content));\n  gap: 8px var(--gap);\n}\n\n.tool-nav[hidden] {\n  display: none;\n}\n\n.tool-btn {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 4px 10px 4px 4px;\n  background: transparent;\n  border: 2px solid transparent;\n  border-radius: var(--radius);\n  font-size: 0.9rem;\n  text-align: start;\n}\n\n.tool-btn:hover {\n  background: var(--panel);\n  transform: translateY(-2px);\n}\n\n.tool-btn:hover .icon-box {\n  box-shadow: 0 0 14px rgba(255, 92, 132, 0.7);\n}\n\n.tool-btn[aria-current=\"page\"] {\n  background: var(--panel-raised);\n  border-color: var(--accent);\n  box-shadow: 0 0 14px rgba(255, 92, 132, 0.45);\n}\n\n.icon-box {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  width: 44px;\n  height: 44px;\n  background: var(--card);\n  color: var(--card-text);\n  border: 2px dashed var(--accent-dark);\n  border-radius: 6px;\n  transition: box-shadow 0.15s;\n}\n\n.icon-box .icon {\n  width: 26px;\n  height: 26px;\n}\n\n.header-end {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n  gap: 6px;\n  margin-inline-start: auto;\n}\n\n.screen-title {\n  font-size: clamp(1.25rem, 2.4vw, 1.75rem);\n  font-weight: 700;\n  text-align: end;\n}\n\n.screen-title:focus {\n  outline: none;\n}\n\n.screen-title:focus-visible {\n  outline: 3px solid var(--focus);\n}\n\n.integrity {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 4px 8px;\n  padding: 4px 12px;\n  background: var(--terminal);\n  border: 1px solid var(--panel-raised);\n  border-radius: 999px;\n  font-size: 0.9rem;\n}\n\n.integrity-label {\n  color: var(--muted);\n}\n\n.integrity-bar {\n  width: 120px;\n  height: 8px;\n  background: var(--panel-raised);\n  border-radius: 999px;\n  overflow: hidden;\n}\n\n.integrity-fill {\n  display: block;\n  width: 0;\n  height: 100%;\n  border-radius: 999px;\n  transition: width 1s var(--ease), background-color 0.6s;\n}\n\n.integrity-value {\n  font-family: var(--mono);\n  font-weight: 700;\n}\n\n.integrity-status {\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n.integrity-danger .integrity-fill {\n  background: var(--accent);\n}\n\n.integrity-danger .integrity-status {\n  color: var(--accent);\n}\n\n.integrity-warn .integrity-fill {\n  background: var(--warn);\n}\n\n.integrity-warn .integrity-status {\n  color: var(--warn);\n}\n\n.integrity-safe .integrity-fill {\n  background: var(--good);\n}\n\n.integrity-safe .integrity-status {\n  color: var(--good);\n}\n\n/* Shared pieces */\n\n.main {\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n  overflow: auto;\n  padding: 10px 4px 4px;\n}\n\n/* Every screen sits at the top of the panel, right under the title. */\n.main > * {\n  width: 100%;\n}\n\n.panel {\n  background: var(--panel);\n  border: 1px solid var(--panel-raised);\n  border-radius: var(--radius);\n  padding: clamp(12px, 2vw, 20px);\n}\n\n.panel p + p,\n.panel p + h3,\n.panel ul + h3,\n.panel h2 + p,\n.panel h3 + p,\n.panel h3 + ul,\n.panel p + ul,\n.panel .banner + h2 {\n  margin-top: 8px;\n}\n\n.panel h3 {\n  font-size: 1rem;\n  color: var(--accent);\n}\n\n.panel-heading {\n  margin-bottom: 8px;\n  font-size: 0.9rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n\n.bullets {\n  padding-inline-start: 1.2em;\n}\n\n.bullets li + li {\n  margin-top: 4px;\n}\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  min-height: 44px;\n  margin-top: 12px;\n  margin-inline-end: 8px;\n  padding: 8px 16px;\n  background: transparent;\n  border: 2px solid var(--muted);\n  border-radius: 999px;\n  font-weight: 600;\n}\n\n.btn:hover {\n  background: var(--panel-raised);\n  transform: translateY(-2px);\n}\n\n.btn-primary {\n  background: var(--accent-dark);\n  border-color: var(--accent-dark);\n}\n\n.btn-primary:hover {\n  background: #a0143d;\n  box-shadow: 0 0 16px rgba(255, 92, 132, 0.6);\n}\n\n.chip {\n  position: absolute;\n  top: -11px;\n  inset-inline-end: 10px;\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 2px 8px;\n  border-radius: 999px;\n  color: var(--text);\n  font-size: 0.78rem;\n  font-weight: 700;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n  white-space: nowrap;\n}\n\n.chip-accent {\n  background: var(--accent-dark);\n}\n\n.chip-good {\n  background: var(--good-dark);\n}\n\n.chip-bad {\n  background: var(--bad-dark);\n}\n\n.chip-icon {\n  width: 1em;\n  height: 1em;\n  stroke-width: 3;\n}\n\n.banner {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 8px 14px;\n  border-radius: 8px;\n  color: var(--text);\n  font-weight: 800;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n.banner-good {\n  background: var(--good-dark);\n  box-shadow: 0 0 18px rgba(90, 217, 149, 0.45);\n}\n\n.banner-bad {\n  background: var(--bad-dark);\n  box-shadow: 0 0 18px rgba(255, 92, 92, 0.45);\n}\n\n.banner-icon {\n  width: 1.6em;\n  height: 1.6em;\n}\n\n.banner.deploy .banner-icon {\n  animation: deploy 0.6s var(--ease);\n}\n\n.split {\n  display: grid;\n  grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);\n  align-items: center;\n  gap: clamp(12px, 2vw, 24px);\n}\n\n.split-email {\n  grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);\n}\n\n.split-narrow-first {\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);\n}\n\n.side {\n  display: flex;\n  flex-direction: column;\n  gap: var(--gap);\n  min-height: 0;\n}\n\n.feedback {\n  overflow: auto;\n  border-inline-start: 6px solid var(--panel-raised);\n}\n\n.feedback-good {\n  border-inline-start-color: var(--good);\n}\n\n.feedback-bad {\n  border-inline-start-color: var(--bad);\n}\n\n.feedback-title {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 1.25rem;\n}\n\n.feedback-good .feedback-title {\n  color: var(--good);\n}\n\n.feedback-bad .feedback-title {\n  color: var(--bad);\n}\n\n.title-icon {\n  width: 1.4em;\n  height: 1.4em;\n  stroke-width: 2.5;\n}\n\n.feedback-lead {\n  font-weight: 700;\n}\n\n.done-note {\n  margin-top: 12px;\n  color: var(--good);\n  font-weight: 700;\n}\n\n.question,\n.side-intro {\n  font-size: 1.05rem;\n}\n\n.question {\n  font-weight: 600;\n}\n\n/* Paging for long panels */\n\n.page:focus {\n  outline: none;\n}\n\n.pager {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  margin-top: 12px;\n  padding-top: 10px;\n  border-top: 1px solid var(--panel-raised);\n}\n\n.pager-status {\n  color: var(--muted);\n  font-weight: 600;\n}\n\n.pager-btn {\n  min-width: 88px;\n  min-height: 40px;\n  padding: 6px 16px;\n  background: transparent;\n  border: 2px solid var(--muted);\n  border-radius: 999px;\n  font-weight: 700;\n}\n\n.pager-btn:hover:not(:disabled) {\n  background: var(--panel-raised);\n  transform: translateY(-2px);\n}\n\n.pager-next:not(:disabled) {\n  background: var(--accent-dark);\n  border-color: var(--accent-dark);\n  box-shadow: 0 0 14px rgba(255, 92, 132, 0.5);\n}\n\n.pager-btn:disabled {\n  opacity: 0.4;\n}\n\n.crack-title {\n  font-size: 1.2rem;\n}\n\n/* Animation cues (added for one render only) */\n\n.scan-once {\n  position: relative;\n  overflow: hidden;\n}\n\n.scan-once::after {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  right: 0;\n  bottom: 0;\n  left: 0;\n  pointer-events: none;\n  background: linear-gradient(to bottom, transparent 40%, rgba(255, 92, 132, 0.35) 50%, transparent 60%);\n  transform: translateY(-100%);\n  animation: scan 1.1s ease-out forwards;\n}\n\n.pop-in {\n  animation: pop 0.35s var(--ease);\n}\n\n.shake {\n  animation: shake 0.4s;\n}\n\n.stamp-in {\n  animation: stamp 0.45s var(--ease);\n}\n\n.stamp-in.delayed {\n  animation: stamp 0.45s var(--ease) 0.9s both;\n}\n\n/* Dashboard */\n\n.dashboard {\n  display: grid;\n  gap: var(--gap);\n}\n\n.welcome {\n  display: flex;\n  align-items: center;\n  gap: var(--gap);\n}\n\n.avatar {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 56px;\n  height: 56px;\n  background: #e8836a;\n  color: #fff3b0;\n  border-radius: 50%;\n  box-shadow: 0 0 0 3px var(--panel-raised);\n}\n\n.avatar .icon {\n  width: 34px;\n  height: 34px;\n}\n\n.welcome-name {\n  font-weight: 700;\n  font-size: 1.1rem;\n}\n\n.welcome-text {\n  color: var(--muted);\n}\n\n.dashboard-body {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);\n  align-items: center;\n  gap: clamp(12px, 2vw, 24px);\n}\n\n.map-panel {\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n  background: rgba(11, 15, 31, 0.85);\n}\n\n.network-map {\n  width: 100%;\n  max-height: 56vh;\n}\n\n.link {\n  stroke-width: 3;\n  transition: stroke 0.6s;\n}\n\n.link-notStarted {\n  stroke: #6e1a30;\n}\n\n.link-investigated {\n  stroke: #6b5520;\n}\n\n.link-defended {\n  stroke: var(--good);\n  stroke-width: 4;\n}\n\n.packets {\n  fill: none;\n  stroke-width: 5;\n  stroke-linecap: round;\n  stroke-dasharray: 2 18;\n  animation: packet-flow 1s linear infinite;\n}\n\n.packets-notStarted {\n  stroke: var(--accent);\n}\n\n.packets-investigated {\n  stroke: var(--warn);\n  animation-duration: 2s;\n}\n\n.server-ring {\n  fill: none;\n  stroke: var(--accent);\n  stroke-width: 2;\n  transform-box: fill-box;\n  transform-origin: center;\n  animation: ring 2.4s ease-out infinite;\n}\n\n.server-core {\n  fill: var(--panel-raised);\n  stroke: #8fa0ff;\n  stroke-width: 2;\n}\n\n.map-icon {\n  color: var(--text);\n}\n\n.map-label {\n  fill: var(--muted);\n  font-family: var(--font);\n  font-size: 14px;\n  font-weight: 600;\n}\n\n.map-label-server {\n  fill: var(--text);\n  font-size: 15px;\n}\n\n.node-core {\n  stroke-width: 2.5;\n}\n\n.map-node-notStarted .node-core {\n  fill: #3a0f1e;\n  stroke: var(--accent);\n}\n\n.map-node-investigated .node-core {\n  fill: #3a3010;\n  stroke: var(--warn);\n}\n\n.map-node-defended .node-core {\n  fill: #0f3a24;\n  stroke: var(--good);\n}\n\n.node-pulse {\n  fill: none;\n  stroke: var(--accent);\n  stroke-width: 2;\n  transform-box: fill-box;\n  transform-origin: center;\n  animation: ring 1.6s ease-out infinite;\n}\n\n.map-node-investigated .node-pulse {\n  stroke: var(--warn);\n  animation-duration: 2.4s;\n}\n\n.map-node-defended .node-pulse {\n  display: none;\n}\n\n.shield-badge circle {\n  fill: var(--good-dark);\n  stroke: var(--text);\n  stroke-width: 2;\n}\n\n.shield-badge {\n  transform-box: fill-box;\n  transform-origin: center;\n}\n\n.just-defended .shield-badge {\n  animation: shield-drop 0.7s var(--ease) 0.3s both;\n}\n\n.alerts {\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n}\n\n.alert-list {\n  display: flex;\n  flex-direction: column;\n  gap: var(--gap);\n  padding: 0;\n  list-style: none;\n}\n\n.alert-item {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 8px;\n  border-radius: var(--radius);\n}\n\n.alert-item.just-defended {\n  animation: glow-good 1.4s ease-out;\n}\n\n.threat-card {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  min-height: 72px;\n  padding: 8px 12px;\n  background: var(--panel);\n  border: 2px solid var(--panel-raised);\n  border-inline-start: 6px solid var(--accent);\n  border-radius: var(--radius);\n  text-align: start;\n}\n\n.alert-investigated .threat-card {\n  border-inline-start-color: var(--warn);\n}\n\n.alert-defended .threat-card {\n  border-inline-start-color: var(--good);\n}\n\n.threat-card:hover {\n  border-color: var(--accent);\n  transform: translateY(-2px);\n  box-shadow: 0 6px 18px rgba(255, 92, 132, 0.3);\n}\n\n.alert-defended .threat-card:hover {\n  border-color: var(--good);\n  box-shadow: 0 6px 18px rgba(90, 217, 149, 0.3);\n}\n\n.threat-card:hover .icon-box {\n  box-shadow: 0 0 14px rgba(255, 92, 132, 0.7);\n}\n\n.threat-card-text {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.threat-card-name {\n  font-size: 1.05rem;\n  font-weight: 600;\n}\n\n.alert-meta {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 4px 10px;\n}\n\n.severity {\n  padding: 1px 8px;\n  border-radius: 4px;\n  font-size: 0.78rem;\n  font-weight: 800;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.severity-critical {\n  background: var(--accent-dark);\n}\n\n.severity-high {\n  background: var(--high);\n}\n\n.alert-defended .severity {\n  background: var(--panel-raised);\n  text-decoration: line-through;\n}\n\n.status {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 0.9rem;\n  color: var(--accent);\n  font-weight: 600;\n}\n\n.status-light {\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  background: var(--accent);\n  box-shadow: 0 0 8px var(--accent);\n  animation: blink 1s steps(2, start) infinite;\n}\n\n.status-investigated {\n  color: var(--warn);\n}\n\n.status-investigated .status-light {\n  background: var(--warn);\n  box-shadow: 0 0 8px var(--warn);\n  animation-duration: 2s;\n}\n\n.status-defended {\n  color: var(--good);\n}\n\n.status-defended .status-light {\n  background: var(--good);\n  box-shadow: 0 0 8px var(--good);\n  animation: none;\n}\n\n.mitigation-btn {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 14px;\n  background: var(--card);\n  color: var(--card-text);\n  border: 2px solid transparent;\n  border-radius: 999px;\n  font-weight: 700;\n}\n\n.mitigation-btn:hover {\n  border-color: var(--accent-dark);\n  transform: translateY(-2px);\n  box-shadow: 0 0 16px rgba(255, 92, 132, 0.5);\n}\n\n.mitigation-icon {\n  width: 26px;\n  height: 26px;\n  color: var(--accent-dark);\n}\n\n.alert-defended .mitigation-icon {\n  color: var(--good-dark);\n  stroke-width: 3;\n}\n\n/* Learn */\n\n.learn-figure {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 0;\n  background: var(--panel);\n  border-radius: var(--radius);\n  overflow: hidden;\n}\n\n.learn-figure img {\n  display: block;\n  max-width: 100%;\n  max-height: 60vh;\n  object-fit: contain;\n}\n\n.learn-text {\n  overflow: auto;\n}\n\n.learn-text h2 {\n  color: var(--accent);\n  font-size: 1.15rem;\n}\n\n.threat-level {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  margin-bottom: 10px;\n  padding: 3px 10px;\n  border-radius: 4px;\n  font-size: 0.85rem;\n  font-weight: 800;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n.threat-level-icon {\n  width: 1.1em;\n  height: 1.1em;\n}\n\n/* Phishing email */\n\n.email-window {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  min-height: 0;\n  background: #e6e7ec;\n  color: #1b1b1b;\n  border-radius: var(--radius);\n  overflow: hidden;\n  box-shadow: 0 0 0 2px var(--panel-raised), 0 10px 30px rgba(0, 0, 0, 0.4);\n}\n\n.email-bar {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 8px 12px;\n  background: #3a3f4f;\n  color: var(--text);\n}\n\n.email-dot {\n  width: 12px;\n  height: 12px;\n  border-radius: 50%;\n}\n\n.dot-red {\n  background: #ff5f57;\n}\n\n.dot-yellow {\n  background: #febc2e;\n}\n\n.email-bar-title {\n  margin-inline-start: 8px;\n  font-weight: 600;\n}\n\n.email-body {\n  padding: clamp(10px, 2vw, 20px);\n  overflow: auto;\n  font-family: Arial, \"Helvetica Neue\", sans-serif;\n  font-size: 0.95rem;\n  transition: opacity 0.6s, filter 0.6s;\n}\n\n.email-para + .email-para {\n  margin-top: 6px;\n}\n\n.email-part {\n  display: inline;\n  padding: 1px 3px;\n  background: transparent;\n  border: 2px solid transparent;\n  border-radius: 4px;\n  line-height: 1.4;\n  text-align: start;\n}\n\n.email-part:hover {\n  background: #fff4c2;\n  border: 2px dashed #8a6d00;\n}\n\n.email-part:active {\n  transform: none;\n}\n\n.email-part.is-strong {\n  font-weight: 700;\n}\n\n.email-part.is-link {\n  color: #1a56c4;\n  text-decoration: underline;\n}\n\n.email-part.is-block {\n  display: inline-block;\n}\n\n.email-part.is-found {\n  position: relative;\n  border: 2px dashed var(--accent-dark);\n  background: #fde3ea;\n}\n\n.email-part.shake {\n  display: inline-block;\n}\n\n/* The flag sits on the corner of a found part so it doesn't push the email text onto more lines. */\n.flag-chip {\n  position: absolute;\n  top: -10px;\n  inset-inline-end: -8px;\n  display: inline-flex;\n  align-items: center;\n  padding: 2px 4px;\n  background: var(--accent-dark);\n  color: var(--text);\n  border-radius: 999px;\n  font-size: 0.78rem;\n  font-weight: 800;\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n  vertical-align: middle;\n}\n\n.is-quarantined .email-body {\n  opacity: 0.55;\n  filter: grayscale(0.7);\n}\n\n.quarantine-stamp {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 8px 18px;\n  background: rgba(255, 255, 255, 0.92);\n  color: var(--accent-dark);\n  border: 4px solid var(--accent-dark);\n  border-radius: 8px;\n  font-size: clamp(1.4rem, 3vw, 2.2rem);\n  font-weight: 800;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  transform: translate(-50%, -50%) rotate(-8deg);\n  pointer-events: none;\n}\n\n.quarantine-stamp.stamp-in {\n  animation: stamp-center 0.5s var(--ease);\n}\n\n.stamp-icon {\n  width: 1em;\n  height: 1em;\n  stroke-width: 3;\n}\n\n.analysis {\n  padding: 10px 12px;\n  background: var(--terminal);\n  border: 1px solid var(--panel-raised);\n  border-radius: var(--radius);\n}\n\n.counter {\n  font-weight: 700;\n  color: var(--accent);\n}\n\n.analysis-banner {\n  padding: 6px 10px;\n  font-size: 0.95rem;\n  letter-spacing: normal;\n  text-transform: none;\n}\n\n.analysis .btn {\n  margin-top: 6px;\n}\n\n.segments {\n  display: flex;\n  gap: 4px;\n  margin-top: 8px;\n}\n\n.segment {\n  flex: 1;\n  height: 10px;\n  background: var(--panel-raised);\n  border-radius: 3px;\n  transition: background-color 0.3s;\n}\n\n.segment.is-on {\n  background: var(--accent);\n  box-shadow: 0 0 8px var(--accent);\n}\n\n/* Choice cards (passwords, devices, defenses, attack steps) */\n\n.choice-list,\n.device-list,\n.defense-list,\n.step-options {\n  display: flex;\n  flex-direction: column;\n  gap: calc(var(--gap) + 4px);\n  padding: 0;\n  list-style: none;\n}\n\n.choice-card,\n.device-btn,\n.defense-btn,\n.step-btn {\n  position: relative;\n  width: 100%;\n  background: var(--card);\n  color: var(--card-text);\n  border: 3px solid transparent;\n  border-radius: var(--radius);\n  text-align: start;\n}\n\n.choice-card:hover,\n.device-btn:hover,\n.defense-btn:hover,\n.step-btn:hover {\n  border-color: var(--accent);\n  transform: translateY(-2px);\n  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35), 0 0 12px rgba(255, 92, 132, 0.4);\n}\n\n.choice-card[aria-pressed=\"true\"],\n.device-btn[aria-pressed=\"true\"],\n.defense-btn[aria-pressed=\"true\"],\n.step-btn[aria-pressed=\"true\"] {\n  background: var(--card-selected);\n  border-color: var(--accent-dark);\n  box-shadow: 0 0 0 3px var(--accent), 0 0 20px rgba(255, 92, 132, 0.55);\n}\n\n.choice-card {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  padding: 12px 16px;\n}\n\n.choice-name {\n  font-weight: 700;\n  font-size: 1.05rem;\n}\n\n.choice-summary {\n  font-size: 0.95rem;\n}\n\n.defense-btn {\n  min-height: 64px;\n  padding: 12px 16px;\n  font-size: 1.15rem;\n  font-weight: 600;\n  text-align: center;\n}\n\n.defense-btn.is-failed {\n  background: #f1dfe2;\n  color: #5b2630;\n}\n\n.defense-btn.is-deployed {\n  background: #def7e9;\n  border-color: var(--good-dark);\n  box-shadow: 0 0 0 3px var(--good), 0 0 20px rgba(90, 217, 149, 0.55);\n}\n\n/* Weak passwords */\n\n.terminal {\n  margin-bottom: 12px;\n  padding: 12px 14px;\n  background: var(--terminal);\n  border: 1px solid #2c3766;\n  border-radius: 8px;\n  font-family: var(--mono);\n}\n\n.terminal-label {\n  font-size: 0.85rem;\n  color: var(--muted);\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n}\n\n.terminal-field {\n  margin-top: 4px;\n  padding: 6px 10px;\n  background: #151b33;\n  border: 1px solid #2c3766;\n  border-radius: 4px;\n  color: var(--warn);\n  font-size: clamp(1.1rem, 2.2vw, 1.5rem);\n  letter-spacing: 0.06em;\n  overflow-wrap: anywhere;\n}\n\n.terminal-field.is-cracked {\n  color: var(--bad);\n  border-color: var(--bad);\n  box-shadow: 0 0 14px rgba(255, 92, 92, 0.45);\n}\n\n.terminal-status {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  margin-top: 8px;\n  color: var(--warn);\n  font-weight: 700;\n}\n\n.terminal-status.is-cracked {\n  padding: 3px 10px;\n  background: var(--bad-dark);\n  color: var(--text);\n  border-radius: 4px;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n\n.terminal-time {\n  display: inline-block;\n  margin-inline-start: 12px;\n  color: var(--muted);\n}\n\n/* Default credentials */\n\n.credentials {\n  display: grid;\n  grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.2fr) minmax(0, 1.3fr);\n  align-items: center;\n  gap: clamp(12px, 2vw, 24px);\n}\n\n.device-list {\n  padding-top: 10px;\n}\n\n.device-btn {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 8px;\n}\n\n.device-btn-text {\n  display: flex;\n  flex-direction: column;\n}\n\n.device-center {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 10px;\n  min-height: 0;\n  padding: 10px 6px 6px;\n}\n\n.device-art {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: clamp(72px, 14vh, 120px);\n  height: clamp(72px, 14vh, 120px);\n  background: var(--panel);\n  color: var(--muted);\n  border: 3px solid var(--panel-raised);\n  border-radius: 50%;\n  transition: background-color 0.4s, border-color 0.4s, color 0.4s;\n}\n\n.device-art-icon {\n  width: 55%;\n  height: 55%;\n  stroke-width: 1.6;\n}\n\n.device-hijacked {\n  background: #3a0f1e;\n  color: var(--bad);\n  border-color: var(--bad);\n  box-shadow: 0 0 24px rgba(255, 92, 92, 0.55);\n}\n\n.device-safe {\n  background: #0f3a24;\n  color: var(--good);\n  border-color: var(--good);\n  box-shadow: 0 0 24px rgba(90, 217, 149, 0.55);\n}\n\n.device-badge {\n  position: absolute;\n  inset-inline-end: -4px;\n  bottom: -4px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 38%;\n  height: 38%;\n  background: var(--card);\n  border-radius: 50%;\n}\n\n.device-hijacked .device-badge {\n  color: var(--bad-dark);\n}\n\n.device-safe .device-badge {\n  color: var(--good-dark);\n}\n\n.device-badge .icon {\n  width: 60%;\n  height: 60%;\n  stroke-width: 2.5;\n}\n\n.glitch {\n  animation: glitch 0.6s steps(6);\n}\n\n.pulse-safe {\n  animation: pulse-safe 0.9s ease-out;\n}\n\n.device-result {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  padding: 4px 16px;\n  border-radius: 6px;\n  text-align: center;\n}\n\n.device-result strong {\n  font-size: 1.1rem;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n}\n\n.device-result span {\n  font-size: 0.95rem;\n}\n\n.device-result-hijacked {\n  background: var(--bad-dark);\n}\n\n.device-result-safe {\n  background: var(--good-dark);\n}\n\n.login-card {\n  width: 100%;\n  padding: 12px 16px;\n  background: linear-gradient(#cfd1d8, #f2f3f7 18%);\n  color: var(--card-text);\n  border-radius: var(--radius);\n}\n\n.login-title {\n  font-size: 1.1rem;\n  text-align: center;\n}\n\n.login-fields {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  align-items: center;\n  gap: 8px 12px;\n  margin-top: 8px;\n}\n\n.login-fields dt {\n  font-weight: 700;\n}\n\n.login-fields dd {\n  padding: 6px 10px;\n  background: #ffffff;\n  border-radius: 4px;\n  overflow-wrap: anywhere;\n}\n\n.mono {\n  font-family: var(--mono);\n}\n\n.verdict-prompt {\n  text-align: center;\n}\n\n.verdict-row {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: var(--gap);\n  padding-top: 8px;\n}\n\n.verdict-btn {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  min-height: 48px;\n  padding: 8px 18px;\n  border: 3px solid transparent;\n  border-radius: 999px;\n  font-weight: 700;\n  color: var(--text);\n}\n\n.verdict-btn .icon {\n  stroke-width: 3;\n}\n\n.verdict-btn:hover {\n  transform: translateY(-2px);\n  border-color: var(--text);\n}\n\n.verdict-secure {\n  background: var(--good-dark);\n}\n\n.verdict-secure:hover {\n  box-shadow: 0 0 16px rgba(90, 217, 149, 0.6);\n}\n\n.verdict-not-secure {\n  background: var(--bad-dark);\n}\n\n.verdict-not-secure:hover {\n  box-shadow: 0 0 16px rgba(255, 92, 92, 0.6);\n}\n\n.verdict-btn[aria-pressed=\"true\"] {\n  border-color: var(--text);\n  box-shadow: 0 0 0 3px var(--focus);\n}\n\n/* Social engineering */\n\n.social {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);\n  align-items: start;\n  gap: clamp(12px, 2vw, 24px);\n}\n\n.steps {\n  display: grid;\n  gap: 8px;\n}\n\n.step {\n  padding: 8px 12px;\n  border-top: 4px solid var(--panel-raised);\n  transition: opacity 0.3s, border-color 0.3s;\n}\n\n.step.is-done {\n  border-top-color: var(--accent);\n}\n\n.step.is-locked {\n  opacity: 0.6;\n}\n\n.step-title {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 8px;\n  font-size: 1rem;\n}\n\n.step-number {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 28px;\n  height: 28px;\n  background: var(--accent-dark);\n  border-radius: 50%;\n  font-size: 0.9rem;\n}\n\n.step-hint,\n.step-locked {\n  margin: 4px 0 12px;\n  font-size: 0.95rem;\n  color: var(--muted);\n}\n\n.step-locked {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.step-options {\n  flex-direction: row;\n  flex-wrap: wrap;\n  gap: 12px 8px;\n}\n\n.step-btn {\n  width: auto;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-height: 36px;\n  padding: 4px 10px;\n  font-weight: 600;\n}\n\n.step-icon {\n  color: var(--accent-dark);\n}\n\n.strategy-note {\n  margin-top: 8px;\n  font-size: 0.95rem;\n}\n\n.attack-path {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin: 8px 0;\n  padding: 6px 10px;\n  background: var(--terminal);\n  border-radius: 8px;\n}\n\n.path-node {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 4px;\n  min-width: 64px;\n  font-size: 0.85rem;\n  text-align: center;\n}\n\n.path-node .icon {\n  width: 34px;\n  height: 34px;\n  padding: 6px;\n  background: var(--panel-raised);\n  border: 2px solid var(--muted);\n  border-radius: 50%;\n}\n\n.path-attacker .icon {\n  color: var(--accent);\n  border-color: var(--accent);\n}\n\n.path-weak .path-target .icon {\n  background: var(--bad-dark);\n  border-color: var(--bad);\n  box-shadow: 0 0 16px rgba(255, 92, 92, 0.7);\n}\n\n.path-strong .path-target .icon {\n  border-color: var(--good);\n}\n\n.path-track {\n  position: relative;\n  flex: 1;\n  height: 4px;\n  background: repeating-linear-gradient(90deg, var(--muted) 0 8px, transparent 8px 14px);\n}\n\n.path-packet {\n  position: absolute;\n  top: -6px;\n  left: 0;\n  width: 16px;\n  height: 16px;\n  background: var(--accent);\n  border-radius: 50%;\n  box-shadow: 0 0 12px var(--accent);\n}\n\n.path-ready .path-packet {\n  animation: ready 1.2s ease-in-out infinite;\n}\n\n.path-strong .path-packet {\n  left: calc(50% - 24px);\n}\n\n.path-weak .path-packet {\n  left: calc(100% - 16px);\n}\n\n.run .path-packet {\n  animation: travel 0.8s ease-in both;\n}\n\n.path-shield {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  display: flex;\n  color: var(--good);\n  transform: translate(-50%, -50%);\n}\n\n.path-shield .icon {\n  width: 34px;\n  height: 34px;\n  stroke-width: 2.5;\n}\n\n.run .path-shield {\n  animation: shield-up 0.5s var(--ease) 0.4s both;\n}\n\n.run.path-weak .path-target .icon {\n  animation: hit 0.5s ease-out 0.8s both;\n}\n\n.outcome-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px 8px;\n  margin-top: 14px;\n}\n\n.outcome-btn {\n  position: relative;\n  flex: 1 1 10rem;\n  min-height: 48px;\n  padding: 8px 12px;\n  border: 3px solid transparent;\n  border-radius: var(--radius);\n  font-weight: 600;\n  color: var(--text);\n}\n\n.outcome-btn:hover {\n  transform: translateY(-2px);\n  border-color: var(--text);\n}\n\n.outcome-strong {\n  background: var(--good-dark);\n}\n\n.outcome-weak {\n  background: var(--bad-dark);\n}\n\n.action-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 10px;\n}\n\n.action-row .btn {\n  min-height: 40px;\n  margin: 0;\n  padding: 4px 14px;\n  font-size: 0.95rem;\n}\n\n.outcome-result {\n  margin-top: 12px;\n  padding: 10px 12px;\n  background: var(--panel-raised);\n  border-radius: 6px;\n}\n\n.outcome-result h3 {\n  margin-top: 10px;\n  color: var(--text);\n}\n\n.error-note,\n.no-script {\n  padding: 20px;\n  font-size: 1.1rem;\n}\n\n/* Keyframes */\n\n@keyframes packet-flow {\n  to {\n    stroke-dashoffset: -20;\n  }\n}\n\n@keyframes ring {\n  from {\n    transform: scale(1);\n    opacity: 0.9;\n  }\n\n  to {\n    transform: scale(1.5);\n    opacity: 0;\n  }\n}\n\n@keyframes blink {\n  to {\n    visibility: hidden;\n  }\n}\n\n@keyframes scan {\n  to {\n    transform: translateY(100%);\n  }\n}\n\n@keyframes pop {\n  from {\n    transform: scale(0.96);\n    opacity: 0.4;\n  }\n}\n\n@keyframes shake {\n  20%,\n  60% {\n    transform: translateX(-6px);\n  }\n\n  40%,\n  80% {\n    transform: translateX(6px);\n  }\n}\n\n@keyframes stamp {\n  from {\n    transform: scale(1.8);\n    opacity: 0;\n  }\n}\n\n@keyframes stamp-center {\n  from {\n    transform: translate(-50%, -50%) rotate(-8deg) scale(2);\n    opacity: 0;\n  }\n}\n\n@keyframes deploy {\n  from {\n    transform: scale(2.4) rotate(-20deg);\n    opacity: 0;\n  }\n}\n\n@keyframes shield-drop {\n  from {\n    transform: scale(2.5);\n    opacity: 0;\n  }\n}\n\n@keyframes glow-good {\n  from {\n    box-shadow: 0 0 0 4px var(--good), 0 0 30px rgba(90, 217, 149, 0.8);\n  }\n}\n\n@keyframes glitch {\n  0% {\n    transform: translate(0, 0);\n  }\n\n  20% {\n    transform: translate(-4px, 2px);\n  }\n\n  40% {\n    transform: translate(4px, -2px);\n  }\n\n  60% {\n    transform: translate(-3px, -1px);\n  }\n\n  80% {\n    transform: translate(3px, 1px);\n  }\n}\n\n@keyframes pulse-safe {\n  from {\n    box-shadow: 0 0 0 0 rgba(90, 217, 149, 0.8);\n  }\n\n  to {\n    box-shadow: 0 0 0 24px rgba(90, 217, 149, 0);\n  }\n}\n\n@keyframes ready {\n  50% {\n    transform: scale(1.3);\n  }\n}\n\n@keyframes travel {\n  from {\n    left: 0;\n  }\n}\n\n@keyframes shield-up {\n  from {\n    transform: translate(-50%, -50%) scale(0);\n  }\n}\n\n@keyframes hit {\n  from {\n    transform: scale(1.4);\n  }\n}\n\n/* Fit each screen inside the app panel: long panels scroll inside themselves, not the page. */\n\n.main > * {\n  max-height: 100%;\n}\n\n.split,\n.credentials,\n.social,\n.dashboard-body {\n  grid-template-rows: minmax(0, 1fr);\n}\n\n.dashboard {\n  grid-template-rows: auto minmax(0, 1fr);\n}\n\n.learn {\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);\n}\n\n.learn-figure img {\n  max-height: 50vh;\n}\n\n.learn-text,\n.feedback,\n.email-window,\n.learn-figure,\n.step,\n.side,\n.map-panel,\n.alerts,\n.device-list,\n.device-center {\n  max-height: 100%;\n}\n\n.side > *,\n.alerts,\n.device-list,\n.device-center {\n  min-height: 0;\n}\n\n.alerts,\n.device-list,\n.device-center {\n  overflow: auto;\n}\n\n.verdict-btn {\n  padding: 8px 14px;\n}\n\n.device-art {\n  width: clamp(56px, 11vh, 120px);\n  height: clamp(56px, 11vh, 120px);\n}\n\n/* Smaller screens */\n\n@media (max-width: 1280px) {\n  .tool-nav {\n    grid-template-columns: repeat(2, minmax(0, max-content));\n  }\n}\n\n@media (max-width: 1100px) {\n  .icon-box {\n    width: 36px;\n    height: 36px;\n  }\n\n  .icon-box .icon {\n    width: 22px;\n    height: 22px;\n  }\n}\n\n@media (max-width: 760px) {\n  .main > * {\n    max-height: none;\n  }\n\n  .split,\n  .credentials,\n  .social,\n  .steps,\n  .dashboard,\n  .dashboard-body {\n    grid-template-rows: none;\n  }\n\n  .credentials .device-list {\n    flex-direction: row;\n    flex-wrap: wrap;\n  }\n\n  .credentials .device-list li {\n    flex: 1 1 10rem;\n  }\n\n  .dashboard,\n  .dashboard-body,\n  .split,\n  .split-narrow-first,\n  .credentials,\n  .steps {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .topbar {\n    flex-direction: column;\n    align-items: stretch;\n  }\n\n  .header-end {\n    order: -1;\n    flex-direction: row;\n    flex-wrap: wrap;\n    align-items: center;\n    justify-content: space-between;\n    margin-inline-start: 0;\n  }\n\n  .screen-title {\n    text-align: start;\n  }\n\n  .tool-nav {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .network-map {\n    max-height: 260px;\n  }\n\n  .tool-label {\n    font-size: 0.85rem;\n  }\n}\n\n@media (min-width: 1200px) and (min-height: 800px) {\n  html {\n    font-size: 17px;\n  }\n}\n\n@media (max-height: 760px) {\n  .step-hint {\n    display: none;\n  }\n\n  .tool-btn {\n    padding: 2px 8px 2px 2px;\n  }\n\n  .btn {\n    min-height: 40px;\n    margin-top: 8px;\n  }\n\n  .panel {\n    padding: 12px 14px;\n  }\n\n  .email-body {\n    padding: 10px 12px;\n  }\n\n  .terminal {\n    padding: 8px 12px;\n  }\n}\n\n@media (min-width: 761px) and (max-width: 900px) {\n  .split-email {\n    grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr);\n  }\n}\n\n@media (max-height: 640px) {\n  .email-body {\n    font-size: 0.9rem;\n  }\n\n  .email-bar {\n    padding: 5px 12px;\n  }\n\n  .email-para + .email-para {\n    margin-top: 4px;\n  }\n}\n\n@media (max-height: 720px) {\n  .avatar {\n    width: 40px;\n    height: 40px;\n  }\n\n  .avatar .icon {\n    width: 26px;\n    height: 26px;\n  }\n\n  .threat-card {\n    min-height: 60px;\n    padding: 6px 10px;\n  }\n\n  .threat-card .icon-box {\n    width: 40px;\n    height: 40px;\n  }\n\n  .threat-card .icon-box .icon {\n    width: 24px;\n    height: 24px;\n  }\n\n  .mitigation-btn {\n    padding: 6px 12px;\n    font-size: 0.9rem;\n  }\n\n  .login-card {\n    padding: 8px 12px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n\n  .scan-once::after {\n    display: none;\n  }\n}\n",
          "folderId": "0",
          "active": true
        }
      },
