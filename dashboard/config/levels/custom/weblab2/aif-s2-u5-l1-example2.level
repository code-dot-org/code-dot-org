        "1": {
          "id": "1",
          "name": "script.js",
          "language": "js",
          "contents": "// --- Helper function to display text in the browser ---\nconst logToDOM = (message, containerId = 'output-container') => {\n    const outputElement = document.getElementById(containerId);\n    if (outputElement) {\n        // Append a new paragraph element for each message\n        outputElement.innerHTML += `<p style=\"margin: 2px 0;\">${message}</p>`;\n    }\n};\n// --------------------------------------------------------\n\n\n// 1. The data, simulating the JavaScript object received from the API (JSON converted):\nconst inventoryData = [\n    { id: 101, name: \"Widget Alpha\", price: 29.99 },\n    { id: 102, name: \"Gismo Beta\", price: 14.50 }\n];\n\n\n// 2. Now, the code can easily iterate and use this data:\ninventoryData.forEach(item => {\n    // We use the DOM helper instead of console.log\n    logToDOM(`📦 Inventory Item: ${item.name} costs $${item.price.toFixed(2)}`);\n});\n",
          "folderId": "0",
          "active": true
        },
        "2": {
          "id": "2",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n  </head>\n  <body>\n    <div id=\"output-container\">\n    </div>\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "folderId": "0",
          "active": false
        }
