      "codeEditableAfterSubmit": false,
      "allowMultipleAttempts": false
    },
    "display_name": "Fix the Like Button",
    "bubble_choice_description": "Investigate and fix a broken Like button. Figure out what’s wrong and make sure the icon, count, and behavior all update correctly.",
    "thumbnail_url": "https://images.code.org/3d2dd0e8a027b3ae5881b0f550a66d48-like-love-count.png",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>Weekend Photo Drop</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <main class=\"page\">\n      <section class=\"post-card\">\n        <img\n          id=\"postImage\"\n          src=\"city_sunset.jpg\"\n          alt=\"City skyline at sunset\"\n          class=\"post-image\"\n        />\n\n        <div class=\"post-content\">\n          <p class=\"post-label\">Featured Post</p>\n          <h1 class=\"post-title\">Weekend Photo Drop</h1>\n          <p class=\"post-caption\">Sunset walk downtown 🌆</p>\n\n          <button id=\"btnToggle\" class=\"like-button\">\n            <img\n              id=\"heartEmpty\"\n              src=\"heart-empty.png\"\n              alt=\"\"\n              class=\"heart-icon\"\n            />\n            <img\n              id=\"heartFull\"\n              src=\"heart-full.png\"\n              alt=\"\"\n              class=\"heart-icon hidden\"\n            />\n            <span id=\"buttonText\">Like</span>\n          </button>\n\n          <p id=\"likeCountEl\" class=\"like-count\">124 likes</p>\n        </div>\n      </section>\n    </main>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  font-family: Arial, Helvetica, sans-serif;\n  background: #f3f4f6;\n  color: #111827;\n}\n\n.page {\n  min-height: 100vh;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  padding: 32px 16px;\n}\n\n.post-card {\n  width: 100%;\n  max-width: 380px;\n  background: #ffffff;\n  border: 1px solid #d1d5db;\n  border-radius: 20px;\n  overflow: hidden;\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);\n}\n\n.post-image {\n  width: 100%;\n  height: 260px;\n  object-fit: cover;\n  display: block;\n}\n\n.post-content {\n  padding: 20px;\n}\n\n.post-label {\n  margin: 0 0 8px 0;\n  font-size: 13px;\n  font-weight: 700;\n  color: #6b7280;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n}\n\n.post-title {\n  margin: 0 0 8px 0;\n  font-size: 28px;\n  line-height: 1.1;\n}\n\n.post-caption {\n  margin: 0 0 18px 0;\n  font-size: 17px;\n  color: #374151;\n}\n\n.like-button {\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  border: 1px solid #d1d5db;\n  background: #ffffff;\n  color: #111827;\n  border-radius: 999px;\n  padding: 12px 18px;\n  font-size: 18px;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.like-button:hover {\n  background: #f9fafb;\n}\n\n.heart-icon {\n  width: 22px;\n  height: 22px;\n  display: block;\n}\n\n.hidden {\n  display: none;\n}\n\n.like-count {\n  margin: 16px 0 0 0;\n  font-size: 20px;\n  font-weight: 700;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "// State\nlet liked = false;\nconst likeCount = 124;\n\n// Selectors\nconst btnToggle = document.getElementById(\"btnToggle\");\nconst heartEmpty = document.getElementById(\"heartEmpty\");\nconst heartFull = document.getElementById(\"heartFull\");\nconst likeCountEl = document.getElementById(\"likeCountEl\");\nconst buttonText = document.getElementById(\"buttonText\");\n\n// Render UI from state\nconst render = () => {\n  if (liked) {\n    heartEmpty.classList.add(\"hidden\");\n    heartFull.classList.add(\"hidden\"); \n    buttonText.textContent = \"Liked\";\n    likeCountEl.textContent = likeCount + 1 + \" likes\";\n  } else {\n    heartEmpty.classList.remove(\"hidden\");\n    heartFull.classList.add(\"hidden\");\n    buttonText.textContent = \"Like\";\n    likeCountEl.textContent = likeCount + \" likes\";\n  }\n};\n\n// Wire: click -> flip -> render\nbtnToggle.addEventListener(\"click\", () => {\n  liked = liked; \n  render();\n});\n\n// Initial render\nrender();",
          "folderId": "0",
          "active": true
        },
