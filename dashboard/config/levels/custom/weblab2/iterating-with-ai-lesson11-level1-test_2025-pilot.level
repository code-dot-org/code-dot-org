          "contents": "// List of Most-Followed Instagram Accounts\n// Source: https://www.kaggle.com/datasets/rajkumarpandey02/list-of-mostfollowed-instagram-accounts\n\nconst dataset = [\n  {\"Unnamed: 0\": 0, \"Rank\": \"1\", \"Username\": \"@instagram\", \"Owner\": \"Instagram\", \"Followers(millions)[2]\": \"586\", \"Profession/Activity\": \"Social media platform\", \"Country/Continent\": \"United States\"},\n  {\"Unnamed: 0\": 1, \"Rank\": \"2\", \"Username\": \"@cristiano\", \"Owner\": \"Cristiano Ronaldo\", \"Followers(millions)[2]\": \"531\", \"Profession/Activity\": \"Footballer\", \"Country/Continent\": \"Portugal\"},\n  {\"Unnamed: 0\": 2, \"Rank\": \"3\", \"Username\": \"@leomessi\", \"Owner\": \"Lionel Messi\", \"Followers(millions)[2]\": \"417\", \"Profession/Activity\": \"Footballer\", \"Country/Continent\": \"Argentina\"},\n  {\"Unnamed: 0\": 3, \"Rank\": \"4\", \"Username\": \"@kyliejenner\", \"Owner\": \"Kylie Jenner\", \"Followers(millions)[2]\": \"377\", \"Profession/Activity\": \"Television personality, model and businesswoman\", \"Country/Continent\": \"United States\"},\n  {\"Unnamed: 0\": 4, \"Rank\": \"5\", \"Username\": \"@selenagomez\", \"Owner\": \"Selena Gomez\", \"Followers(millions)[2]\": \"367\", \"Profession/Activity\": \"Musician, actress, and businesswoman\", \"Country/Continent\": \"United States\"},\n  {\"Unnamed: 0\": 5, \"Rank\": \"6\", \"Username\": \"@therock\", \"Owner\": \"Dwayne Johnson\", \"Followers(millions)[2]\": \"356\", \"Profession/Activity\": \"Actor and professional wrestler\", \"Country/Continent\": \"United States\"},\n  {\"Unnamed: 0\": 6, \"Rank\": \"7\", \"Username\": \"@arianagrande\", \"Owner\": \"Ariana Grande\", \"Followers(millions)[2]\": \"347\", \"Profession/Activity\": \"Musician, actress and businesswoman\", \"Country/Continent\": \"United States\"},\n  {\"Unnamed: 0\": 7, \"Rank\": \"8\", \"Username\": \"@kimkardashian\", \"Owner\": \"Kim Kardashian\", \"Followers(millions)[2]\": \"339\", \"Profess