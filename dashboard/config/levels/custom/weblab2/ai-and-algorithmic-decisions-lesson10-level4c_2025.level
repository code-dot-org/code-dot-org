    },
    "display_name": "Captions Toggle",
    "bubble_choice_description": "Turn image captions on and off.",
    "thumbnail_url": "https://images.code.org/d03031afc37a066ec5620eb49bc1ab8d-caption.png",
    "start_sources": {
      "folders": {
