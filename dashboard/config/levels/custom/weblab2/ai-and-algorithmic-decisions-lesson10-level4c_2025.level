      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>Level 2 – Photo Caption Toggle</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body class=\"light\">\n    <h1>Photo Caption Toggle</h1>\n\n    <section id=\"photoBlock\">\n      <img id=\"photoImg\" src=\"helloworld.png\" alt=\"Hello world photo\" width=\"300\">\n      <p id=\"captionText\" class=\"hidden\">This photo says “Hello, world!”</p>\n    </section>\n\n    <button id=\"btnToggle\">Toggle Caption</button>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// Selectors\nconst btnToggle = document.getElementById(\"btnToggle\");\nconst captionText = document.getElementById(\"captionText\");\n\n\n",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "/* Layout */\nbody {\n  font-family: sans-serif;\n  text-align: center;\n  padding: 2rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n  align-items: center;\n  min-height: 100vh;\n  transition: background-color 0.3s, color 0.3s;\n}\n\n/* Button */\nbutton {\n  background: none;\n  border: 2px solid #ccc;\n  padding: 0.6rem 1rem;\n  border-radius: 8px;\n  cursor: pointer;\n  color: inherit;\n  transition: background-color 0.2s, border-color 0.2s;\n}\nbutton:hover {\n  background-color: rgba(128,128,128,0.15);\n  border-color: #aaa;\n}\n\n/* Hidden state */\n.hidden { \n  display: none; \n}\n\n\n/* Caption text */\n#captionText {\n  margin-top: 0.5rem;\n  font-style: italic;\n  background: rgba(0,0,0,0.05);\n  padding: 0.4rem 0.8rem;\n  border-radius: 4px;\n  width: fit-content;\n}\n",
          "folderId": "0",
