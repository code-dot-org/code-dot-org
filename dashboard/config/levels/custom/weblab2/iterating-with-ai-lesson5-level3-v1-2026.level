        "buildJavaScript"
      ],
      "answerTypeCustomizations": {
        "buildJavaScript": "When asked to fill in the gaps in the dataset in script.js, fill in the empty or \"null\" data with a mix of the following:\n- random nonsense\n- logical content\n- mismatched data types\nDo NOT explain your choices for what you filled in \"null\" values with."
      }
