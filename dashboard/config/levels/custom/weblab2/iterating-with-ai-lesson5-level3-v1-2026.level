        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const data = [\n  {\n    field1: \"Maya\",\n    field2: \"B\",\n    field3: \"AM\",\n    field4: 18\n  },\n  {\n    field1: \"Jordan\",\n    field2: null,\n    field3: \"PM\",\n    field4: 21\n  },\n  {\n    field1: \"Avery\",\n    field2: \"G\",\n    field3: null,\n    field4: 19\n  },\n  {\n    field1: \"Luis\",\n    field2: \"R\",\n    field3: \"AM\",\n    field4: null\n  }\n];\n\nshowMysteryCards(data);",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
          "name": "notes.md",
          "contents": "For the Mystery Records dataset: \n  * What values did AI Tutor fill in? Do they seem reasonable? Why or why not?\n\n\n\n  * Were there any values AI Tutor filled in that surprised you?\n\n\n\n  * What do you think AI Tutor used to make its guesses this time?\n\n\n",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>Missing Data and Labels</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    <main class=\"layout\">\n\n      <section>\n        <h2>Mystery Records</h2>\n        <div id=\"mystery-records\" class=\"card-grid\"></div>\n      </section>\n    </main>\n\n    <script src=\"helpers.js\" defer></script>\n    <script src=\"script.js\" defer></script>\n  </body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "6": {
          "id": "6",
          "name": "style.css",
          "contents": "body {\n  font-family: Arial, sans-serif;\n  margin: 0;\n  padding: 32px;\n  background: #eef2f7;\n  color: #222;\n}\n\n.layout {\n  max-width: 1000px;\n  margin: 0 auto;\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 24px;\n}\n\nsection {\n  background: #ffffff;\n  border: 1px solid #d7deea;\n  border-radius: 16px;\n  padding: 24px;\n  box-shadow: 0 8px 24px rgba(31, 41, 55, 0.08);\n}\n\nh2 {\n  margin: 0 0 18px;\n  font-size: 1.3rem;\n  color: #1f2937;\n}\n\n.card-grid {\n  display: grid;\n  gap: 14px;\n}\n\n.card {\n  background: #f9fafb;\n  border: 1px solid #e1e7ef;\n  border-radius: 12px;\n  padding: 16px;\n}\n\n.card p {\n  margin: 8px 0;\n  line-height: 1.4;\n}\n\n.label {\n  font-weight: bold;\n  color: #374151;\n}\n\n.missing {\n  color: #9a3412;\n  font-style: italic;\n}\n\n@media (max-width: 800px) {\n  body {\n    padding: 20px;\n  }\n\n  .layout {\n    grid-template-columns: 1fr;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "7": {
          "id": "7",
          "name": "helpers.js",
          "contents": "function showValue(value) {\n  if (value === null) {\n    return \"<span class='missing'>Missing data</span>\";\n  }\n\n  return value;\n}\n\nfunction showMysteryCards(data) {\n  const mysteryRecords = document.querySelector(\"#mystery-records\");\n\n  for (let i = 0; i < data.length; i++) {\n    mysteryRecords.innerHTML += `\n      <div class=\"card\">\n        <p><strong>Field 1:</strong> ${showValue(data[i].field1)}</p>\n        <p><strong>Field 2:</strong> ${showValue(data[i].field2)}</p>\n        <p><strong>Field 3:</strong> ${showValue(data[i].field3)}</p>\n        <p><strong>Field 4:</strong> ${showValue(data[i].field4)}</p>\n      </div>\n    `;\n  }\n}",
          "folderId": "0",
          "active": false
        }
      },
