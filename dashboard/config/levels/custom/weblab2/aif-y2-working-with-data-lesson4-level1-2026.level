        "9"
      ]
    }
  },
  "published": true,
  "audit_log": "[{\"changed_at\":\"2026-09-07 16:20:59 +0000\",\"changed\":[\"require_edit_to_continue\"],\"changed_by_id\":23870,\"changed_by_email\":\"carter.zenke@code.org\"},{\"changed_at\":\"2026-09-07 16:24:48 +0000\",\"changed\":[],\"changed_by_id\":23870,\"changed_by_email\":\"carter.zenke@code.org\"},{\"changed_at\":\"2026-09-07 16:24:50 +0000\",\"changed\":[],\"changed_by_id\":23870,\"changed_by_email\":\"carter.zenke@code.org\"}]"
}]]></config>
