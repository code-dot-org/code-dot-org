  "properties": {
    "require_edit_to_continue": "false",
    "encrypted": "false",
    "long_instructions": "In *Flip*, you’ll flip a coin 20 times. Heads gives you one point. Tails doesn’t give you any points.\r\n\r\n☑️ Do This:\r\n- Follow your teacher’s instructions.\r\n- Whoever has the highest score wins!",
    "offer_browser_tts": "false",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "true",
    "widget_view": "true",
    "initial_view_mode": "preview",
    "predict_settings": {
