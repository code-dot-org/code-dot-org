          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;\n  margin: 0;\n  padding: 32px 16px;\n  background: #f7f7f9;\n  color: #222;\n  text-align: center;\n}\n\n.container {\n  max-width: 500px;\n  margin: 0 auto;\n}\n\nh1 {\n  font-size: 24px;\n  margin-bottom: 20px;\n}\n\n.textArea {\n  margin: 0 auto 20px;\n  padding: 16px;\n  border: 2px solid #ccc;\n  border-radius: 10px;\n  background: #fff;\n  min-height: 50px;\n  font-size: 1rem;\n}\n\n.buttonRow {\n  display: flex;\n  justify-content: center;\n  gap: 10px;\n}\n\nbutton {\n  padding: 10px 16px;\n  font-size: 16px;\n  border: 1px solid #aaa;\n  border-radius: 8px;\n  background-color: #fff;\n  cursor: pointer;\n}\n\nbutton:hover {\n  background-color: #f0f0f0;\n}",
