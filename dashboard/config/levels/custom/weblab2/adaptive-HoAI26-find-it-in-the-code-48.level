  "properties": {
    "require_edit_to_continue": true,
    "start_sources": {
      "folders": {
      },
      "files": {
        "1f88e058-64f7-42bc-b1c4-a29c1b241a04": {
          "id": "1f88e058-64f7-42bc-b1c4-a29c1b241a04",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Find it in the Code Widget</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <div class=\"container\">\n        <h1>Find it in the Code</h1>\n        <p>Type a block name below to highlight it on the sample page.</p>\n        <div class=\"search-area\">\n            <input type=\"text\" id=\"searchInput\" placeholder=\"Search for a block name (e.g., header, button)\">\n        </div>\n\n        <div class=\"sample-page-display\">\n            <header data-block-name=\"header\">\n                <h2>Page Header</h2>\n            </header>\n            <section class=\"hero-section\" data-block-name=\"hero section\">\n                <h3>Hero Section</h3>\n                <p>This is the main message area of your page.</p>\n            </section>\n            <div class=\"feature-cards\">\n                <div class=\"card\" data-block-name=\"feature card\">\n                    <h4>Feature One</h4>\n                    <p>Details about feature one.</p>\n                </div>\n                <div class=\"card\" data-block-name=\"feature card\">\n                    <h4>Feature Two</h4>\n                    <p>Details about feature two.</p>\n                </div>\n            </div>\n            <button class=\"call-to-action\" data-block-name=\"call to action button\">\n                Call to Action\n            </button>\n            <footer data-block-name=\"footer\">\n                <p>Page Footer &copy; 2023</p>\n            </footer>\n        </div>\n    </div>\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "fb8ffad4-747e-4712-9aca-3a51628f071b": {
          "id": "fb8ffad4-747e-4712-9aca-3a51628f071b",
          "name": "style.css",
          "contents": "body {\n    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n    margin: 0;\n    padding: 20px;\n    background-color: #f0f4f8;\n    color: #333;\n    display: flex;\n    justify-content: center;\n    align-items: flex-start;\n    min-height: 100vh;\n    box-sizing: border-box;\n}\n\n.container {\n    background-color: #ffffff;\n    border-radius: 10px;\n    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.1);\n    max-width: 800px;\n    width: 100%;\n    padding: 30px;\n    text-align: center;\n}\n\nh1 {\n    color: #2c3e50;\n    margin-top: 0;\n    margin-bottom: 20px;\n    font-size: 2.2em;\n}\n\np {\n    font-size: 1em;\n    margin-bottom: 15px;\n}\n\n.search-area {\n    margin-bottom: 30px;\n}\n\n#searchInput {\n    width: 80%;\n    max-width: 400px;\n    padding: 12px 15px;\n    border: 2px solid #ced4da;\n    border-radius: 8px;\n    font-size: 1.1em;\n    outline: none;\n    transition: border-color 0.2s, box-shadow 0.2s;\n}\n\n#searchInput:focus {\n    border-color: #007bff;\n    box-shadow: 0 0 0 0.2rem rgba(0, 123, 255, 0.25);\n}\n\n.sample-page-display {\n    border: 1px solid #dee2e6;\n    border-radius: 8px;\n    padding: 20px;\n    background-color: #f8f9fa;\n    margin-top: 20px;\n    text-align: left;\n}\n\n.sample-page-display > * {\n    margin-bottom: 15px;\n    padding: 10px 15px;\n    border: 1px solid transparent;\n    border-radius: 5px;\n    transition: background-color 0.2s, border-color 0.2s;\n}\n\n.sample-page-display > *:last-child {\n    margin-bottom: 0;\n}\n\nheader {\n    background-color: #e9ecef;\n    text-align: center;\n}\n\n.hero-section {\n    background-color: #d1ecf1;\n    border-color: #bee5eb;\n}\n\n.hero-section h3 {\n    margin-top: 0;\n    color: #0c5460;\n}\n\n.feature-cards {\n    display: flex;\n    gap: 15px;\n    justify-content: center;\n    flex-wrap: wrap;\n    margin: 20px 0;\n}\n\n.card {\n    flex: 1;\n    min-width: 200px;\n    max-width: 48%;\n    background-color: #e2f0d9;\n    border: 1px solid #c3e6cb;\n    padding: 15px;\n    border-radius: 8px;\n    text-align: center;\n}\n\n.card h4 {\n    margin-top: 0;\n    color: #1a561d;\n}\n\n.call-to-action {\n    background-color: #007bff;\n    color: white;\n    padding: 12px 25px;\n    border: none;\n    border-radius: 8px;\n    font-size: 1.1em;\n    cursor: pointer;\n    display: block;\n    width: fit-content;\n    margin: 20px auto;\n    transition: background-color 0.2s;\n}\n\n.call-to-action:hover {\n    background-color: #0056b3;\n}\n\nfooter {\n    background-color: #e9ecef;\n    text-align: center;\n    font-size: 0.9em;\n    color: #6c757d;\n}\n\n.highlighted {\n    border: 2px solid #ffc107; /* Yellow border */\n    background-color: #fff3cd; /* Light yellow background */\n    box-shadow: 0 0 10px rgba(255, 193, 7, 0.5);\n}\n",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "f55a6a1d-147e-4a21-9e7d-8bdf913f0f74": {
          "id": "f55a6a1d-147e-4a21-9e7d-8bdf913f0f74",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const searchInput = document.getElementById('searchInput');\n    const blockElements = document.querySelectorAll('[data-block-name]');\n\n    function highlightElements(searchTerm) {\n        // Remove existing highlights\n        blockElements.forEach(el => {\n            el.classList.remove('highlighted');\n        });\n\n        if (!searchTerm) {\n            return; // If search term is empty, just remove highlights and exit\n        }\n\n        const lowerCaseSearchTerm = searchTerm.toLowerCase();\n\n        blockElements.forEach(el => {\n            const blockName = el.dataset.blockName ? el.dataset.blockName.toLowerCase() : '';\n            if (blockName.includes(lowerCaseSearchTerm)) {\n                el.classList.add('highlighted');\n            }\n        });\n    }\n\n    searchInput.addEventListener('input', (event) => {\n        highlightElements(event.target.value);\n    });\n});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
        "1f88e058-64f7-42bc-b1c4-a29c1b241a04",
        "fb8ffad4-747e-4712-9aca-3a51628f071b",
        "f55a6a1d-147e-4a21-9e7d-8bdf913f0f74"
      ]
    },
