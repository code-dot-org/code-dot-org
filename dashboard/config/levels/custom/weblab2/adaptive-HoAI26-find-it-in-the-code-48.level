<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-10-16T21:47:54.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": "true",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Find it in the Code</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"widget\">\n    <h1 class=\"visually-hidden\">Find it in the Code</h1>\n\n    <section class=\"game\" aria-labelledby=\"step-label\">\n      <header class=\"game-header\">\n        <h2 class=\"overline\" id=\"step-label\">Clue 1 of 3</h2>\n        <ol class=\"rail\" aria-hidden=\"true\">\n          <li class=\"bubble\" data-state=\"current\"><span class=\"bubble-mark\">1</span></li>\n          <li class=\"bubble\" data-state=\"todo\"><span class=\"bubble-mark\">2</span></li>\n          <li class=\"bubble\" data-state=\"todo\"><span class=\"bubble-mark\">3</span></li>\n          <li class=\"bubble\" data-state=\"todo\">\n            <svg class=\"bubble-mark\" viewBox=\"0 0 20 20\" width=\"14\" height=\"14\" focusable=\"false\">\n              <path d=\"M10 1.8 L12.5 7.3 L18.4 8 L14 12 L15.2 17.9 L10 14.9 L4.8 17.9 L6 12 L1.6 8 L7.5 7.3 Z\"></path>\n            </svg>\n          </li>\n        </ol>\n      </header>\n\n      <div class=\"game-body\">\n        <p class=\"clue\" id=\"clue\" role=\"status\" aria-live=\"polite\">Find the big section at the top that welcomes visitors.</p>\n\n        <div class=\"search\" id=\"search\">\n          <svg class=\"search-icon\" viewBox=\"0 0 20 20\" width=\"20\" height=\"20\" aria-hidden=\"true\" focusable=\"false\">\n            <circle cx=\"8.5\" cy=\"8.5\" r=\"5.5\"></circle>\n            <path d=\"M12.6 12.6 L17 17\"></path>\n          </svg>\n          <label class=\"visually-hidden\" for=\"search-box\">Search the code</label>\n          <input type=\"search\" id=\"search-box\" placeholder=\"Type a section name\" autocomplete=\"off\" spellcheck=\"false\">\n          <p class=\"match-count\" id=\"match-count\" role=\"status\" aria-live=\"polite\"></p>\n        </div>\n\n        <ul class=\"chip-tray\" id=\"request-tray\" aria-label=\"Requests to try\" hidden>\n          <li><button type=\"button\" class=\"chip\" data-request=\"all\" aria-pressed=\"false\">Make the text bigger</button></li>\n          <li><button type=\"button\" class=\"chip\" data-request=\"top\" aria-pressed=\"false\">Make the top bigger</button></li>\n          <li><button type=\"button\" class=\"chip\" data-request=\"hero\" aria-pressed=\"false\">Make the hero bigger</button></li>\n        </ul>\n\n        <div class=\"alert\" id=\"status-alert\" data-sentiment=\"neutral\">\n          <svg class=\"alert-icon icon-info\" viewBox=\"0 0 20 20\" width=\"20\" height=\"20\" aria-hidden=\"true\" focusable=\"false\">\n            <circle class=\"icon-shape\" cx=\"10\" cy=\"10\" r=\"9\"></circle>\n            <path class=\"icon-mark\" d=\"M10 9.2 V14\"></path>\n            <circle class=\"icon-dot\" cx=\"10\" cy=\"6.2\" r=\"1.2\"></circle>\n          </svg>\n          <svg class=\"alert-icon icon-success\" viewBox=\"0 0 20 20\" width=\"20\" height=\"20\" aria-hidden=\"true\" focusable=\"false\">\n            <circle class=\"icon-shape\" cx=\"10\" cy=\"10\" r=\"9\"></circle>\n            <path class=\"icon-mark\" d=\"M5.5 10.4 L8.7 13.4 L14.5 7\"></path>\n          </svg>\n          <svg class=\"alert-icon icon-warning\" viewBox=\"0 0 20 20\" width=\"20\" height=\"20\" aria-hidden=\"true\" focusable=\"false\">\n            <path class=\"icon-shape\" d=\"M10 2 L18.8 17.2 H1.2 Z\"></path>\n            <path class=\"icon-mark\" d=\"M10 8 V12.2\"></path>\n            <circle class=\"icon-dot\" cx=\"10\" cy=\"14.6\" r=\"1.1\"></circle>\n          </svg>\n          <p class=\"alert-text\" id=\"alert-text\" role=\"status\" aria-live=\"polite\">Type a section name. Lines with that name will glow.</p>\n          <button type=\"button\" class=\"outline-button\" id=\"alert-action\" hidden>Next clue</button>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"split\" id=\"split\">\n      <section class=\"page-pane\" aria-labelledby=\"page-title\">\n        <h2 class=\"pane-title\" id=\"page-title\">Page</h2>\n        <div class=\"pane-body\">\n          <div class=\"sample-page\" data-block=\"page\">\n            <span class=\"block-tag\">body</span>\n\n            <div class=\"block block-header\" data-block=\"header\">\n              <span class=\"block-tag\">header</span>\n              <p class=\"site-name\">Save Maple Park</p>\n            </div>\n\n            <div class=\"block block-hero\" data-block=\"hero\">\n              <span class=\"block-tag\">hero</span>\n              <p class=\"hero-title\">Keep our park green</p>\n              <p class=\"hero-text\">Join neighbors who care.</p>\n            </div>\n\n            <div class=\"block block-cards\" data-block=\"cards\">\n              <span class=\"block-tag\">feature cards</span>\n              <div class=\"card-row\">\n                <p class=\"mini-card\">Clean paths</p>\n                <p class=\"mini-card\">New trees</p>\n              </div>\n            </div>\n\n            <div class=\"block block-cta\" data-block=\"cta\">\n              <span class=\"block-tag\">call-to-action</span>\n              <span class=\"fake-button\">Join the cleanup</span>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"code-pane\" aria-labelledby=\"code-title\">\n        <h2 class=\"pane-title\" id=\"code-title\">Code</h2>\n        <div class=\"code-scroll\" id=\"code-scroll\">\n          <div class=\"code\" id=\"code\"></div>\n        </div>\n      </section>\n\n      <svg class=\"connector\" id=\"connector\" aria-hidden=\"true\" focusable=\"false\">\n        <path class=\"connector-glow\" id=\"connector-glow\"></path>\n        <path class=\"connector-line\" id=\"connector-line\"></path>\n        <circle class=\"connector-dot\" id=\"connector-start\" r=\"5\"></circle>\n        <circle class=\"connector-dot\" id=\"connector-end\" r=\"5\"></circle>\n      </svg>\n    </div>\n  </main>\n  <div class=\"confetti\" id=\"confetti\" aria-hidden=\"true\"></div>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": ":root {\n  --background-neutral-primary: #ffffff;\n  --background-neutral-secondary: #f1f2f4;\n  --background-neutral-tertiary: #e1e3e6;\n  --background-brand-primary: #4c42cf;\n  --background-brand-light: #e4e2f8;\n  --background-selected-primary: #2b1e9f;\n  --background-success-light: #d8ffdc;\n  --background-success-primary: #258830;\n  --background-success-strong: #17541e;\n  --background-warning-light: #fff5da;\n  --background-info-light: #d5efff;\n  --border-neutral-primary: #d3d6da;\n  --border-neutral-secondary: #9ea5ad;\n  --border-neutral-solid: #121212;\n  --border-brand-primary: #4c42cf;\n  --border-brand-mid: #928cef;\n  --border-selected-primary: #2b1e9f;\n  --border-focused-primary: #4c42cf;\n  --border-success-mid: #7cdb87;\n  --border-warning-mid: #ffd35c;\n  --border-info-mid: #6fcaff;\n  --text-neutral-primary: #121212;\n  --text-neutral-secondary: #363b40;\n  --text-neutral-quaternary: #596069;\n  --text-neutral-white-fixed: #ffffff;\n  --text-selected-primary: #d8ffdc;\n  --text-success-secondary: #17541e;\n  --text-warning-secondary: #885d02;\n  --text-info-primary: #1570d1;\n  --text-info-secondary: #0b43a3;\n  --block-page: #596069;\n  --block-page-glow: rgba(89, 96, 105, 0.35);\n  --block-header: #17541e;\n  --block-header-glow: rgba(23, 84, 30, 0.35);\n  --block-hero: #2b1e9f;\n  --block-hero-glow: rgba(43, 30, 159, 0.35);\n  --block-cards: #0b43a3;\n  --block-cards-glow: rgba(11, 67, 163, 0.35);\n  --block-cta: #b34800;\n  --block-cta-glow: rgba(179, 72, 0, 0.35);\n  --confetti-brand: #4c42cf;\n  --confetti-success: #34bd43;\n  --confetti-orange: #f46800;\n  --confetti-info: #0099f3;\n  --shape-sm: 0.375rem;\n  --shape-md: 0.5rem;\n  --font-family-main: \"Geist\", \"Noto Sans\", system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif;\n  --font-family-code: ui-monospace, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace;\n  --text-body-sm: 0.875rem;\n  --text-body-md: 1rem;\n  --text-body-lg: 1.125rem;\n  --text-body-xs: 0.75rem;\n  --leading-body-sm: 1.375rem;\n  --transition-colors: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  padding: 1rem;\n  background-color: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-sm);\n  line-height: var(--leading-body-sm);\n}\n\nbutton,\ninput {\n  font: inherit;\n}\n\n:focus-visible {\n  outline: 2px solid var(--border-focused-primary);\n  outline-offset: 2px;\n}\n\n[hidden] {\n  display: none !important;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.widget {\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n  max-width: 62rem;\n  margin-inline: auto;\n}\n\n.overline,\n.pane-title {\n  margin: 0;\n  color: var(--text-neutral-quaternary);\n  font-size: var(--text-body-xs);\n  font-weight: 600;\n  letter-spacing: 0.08em;\n  line-height: 1rem;\n  text-transform: uppercase;\n}\n\n/* Game card */\n\n.game {\n  overflow: hidden;\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background-color: var(--background-neutral-primary);\n}\n\n.game-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n  min-height: 2.5rem;\n  padding-inline: 1rem;\n  border-block-end: 1px solid var(--border-neutral-primary);\n  background-color: var(--background-neutral-secondary);\n}\n\n.game-body {\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n  padding: 1rem;\n}\n\n.clue {\n  margin: 0;\n  font-size: var(--text-body-lg);\n  font-weight: 600;\n  line-height: 1.5rem;\n}\n\n/* Progress bubbles */\n\n.rail {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.bubble {\n  display: grid;\n  place-items: center;\n  width: 0.75rem;\n  height: 0.75rem;\n  border: 2px solid var(--border-neutral-secondary);\n  border-radius: 50%;\n  background-color: var(--background-neutral-primary);\n  color: var(--text-neutral-white-fixed);\n  transition: var(--transition-colors);\n}\n\n.bubble[data-state=\"done\"] {\n  border-color: var(--background-success-primary);\n  background-color: var(--background-success-primary);\n}\n\n.bubble[data-state=\"current\"] {\n  width: 1.5rem;\n  height: 1.5rem;\n  border-color: var(--background-success-strong);\n  background-color: var(--background-success-strong);\n}\n\n.bubble-mark {\n  display: none;\n  font-size: var(--text-body-xs);\n  font-weight: 700;\n  line-height: 1;\n}\n\nsvg.bubble-mark {\n  fill: currentColor;\n}\n\n.bubble[data-state=\"current\"] .bubble-mark {\n  display: block;\n}\n\n/* Search bar */\n\n.search {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.5rem;\n  min-height: 2.5rem;\n  padding-inline: 0.75rem;\n  border: 1px solid var(--border-neutral-solid);\n  border-radius: var(--shape-sm);\n  background-color: var(--background-neutral-primary);\n}\n\n.search:focus-within {\n  outline: 2px solid var(--border-focused-primary);\n  outline-offset: 2px;\n}\n\n.search-icon circle,\n.search-icon path {\n  fill: none;\n  stroke: var(--text-neutral-quaternary);\n  stroke-width: 2;\n  stroke-linecap: round;\n}\n\n.search input {\n  flex: 1 1 10rem;\n  min-width: 0;\n  min-height: 2.25rem;\n  padding: 0;\n  border: 0;\n  outline: 0;\n  background: transparent;\n  color: var(--text-neutral-primary);\n  font-size: var(--text-body-md);\n}\n\n.match-count {\n  margin: 0;\n  color: var(--text-neutral-quaternary);\n}\n\n/* Request chips */\n\n.chip-tray {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.chip {\n  min-height: 2.5rem;\n  padding: 0.25rem 1rem;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: 999px;\n  background-color: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font-weight: 600;\n  cursor: pointer;\n  transition: var(--transition-colors);\n}\n\n.chip:hover {\n  background-color: var(--background-neutral-secondary);\n}\n\n.chip[aria-pressed=\"true\"] {\n  border-color: var(--border-selected-primary);\n  background-color: var(--background-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n/* Inline alert */\n\n.alert {\n  --alert-background: var(--background-neutral-secondary);\n  --alert-border: var(--border-neutral-primary);\n  --alert-text: var(--text-neutral-secondary);\n  --alert-accent: var(--text-neutral-quaternary);\n  display: grid;\n  grid-template-columns: auto 1fr auto;\n  align-items: center;\n  gap: 0.75rem;\n  min-height: 4.25rem;\n  padding: 0.75rem 1rem;\n  border: 1px solid var(--alert-border);\n  border-radius: var(--shape-md);\n  background-color: var(--alert-background);\n  color: var(--alert-text);\n}\n\n.alert[data-sentiment=\"info\"] {\n  --alert-background: var(--background-info-light);\n  --alert-border: var(--border-info-mid);\n  --alert-text: var(--text-info-secondary);\n  --alert-accent: var(--text-info-primary);\n}\n\n.alert[data-sentiment=\"success\"] {\n  --alert-background: var(--background-success-light);\n  --alert-border: var(--border-success-mid);\n  --alert-text: var(--text-success-secondary);\n  --alert-accent: var(--background-success-primary);\n}\n\n.alert[data-sentiment=\"warning\"] {\n  --alert-background: var(--background-warning-light);\n  --alert-border: var(--border-warning-mid);\n  --alert-text: var(--text-warning-secondary);\n  --alert-accent: var(--text-warning-secondary);\n}\n\n.alert-text {\n  margin: 0;\n}\n\n.alert-icon {\n  display: none;\n}\n\n.alert[data-sentiment=\"neutral\"] .icon-info,\n.alert[data-sentiment=\"info\"] .icon-info,\n.alert[data-sentiment=\"success\"] .icon-success,\n.alert[data-sentiment=\"warning\"] .icon-warning {\n  display: block;\n}\n\n.icon-shape {\n  fill: var(--alert-accent);\n}\n\n.icon-mark {\n  fill: none;\n  stroke: var(--text-neutral-white-fixed);\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.icon-dot {\n  fill: var(--text-neutral-white-fixed);\n}\n\n.outline-button {\n  min-height: 2rem;\n  padding: 0.125rem 0.875rem;\n  border: 1px solid var(--border-neutral-solid);\n  border-radius: var(--shape-sm);\n  background-color: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font-weight: 600;\n  cursor: pointer;\n  transition: var(--transition-colors);\n}\n\n.outline-button:hover {\n  background-color: var(--background-neutral-secondary);\n}\n\n.outline-button:active {\n  background-color: var(--background-neutral-tertiary);\n}\n\n/* Split view */\n\n.split {\n  position: relative;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  gap: 3rem;\n  align-items: start;\n}\n\n.page-pane,\n.code-pane {\n  min-width: 0;\n  overflow: hidden;\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background-color: var(--background-neutral-primary);\n}\n\n.pane-title {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 2.5rem;\n  border-block-end: 1px solid var(--border-neutral-primary);\n}\n\n.pane-body {\n  padding: 0.75rem;\n}\n\n.code-scroll {\n  overflow-x: auto;\n}\n\n/* Sample page */\n\n.sample-page {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n  padding: 0.75rem;\n  border-radius: var(--shape-sm);\n  background-color: var(--background-neutral-primary);\n}\n\n.block {\n  position: relative;\n  padding: 0.75rem;\n  border-radius: var(--shape-sm);\n}\n\n[data-block=\"page\"] {\n  --block-color: var(--block-page);\n  --block-glow: var(--block-page-glow);\n}\n\n[data-block=\"header\"] {\n  --block-color: var(--block-header);\n  --block-glow: var(--block-header-glow);\n}\n\n[data-block=\"hero\"] {\n  --block-color: var(--block-hero);\n  --block-glow: var(--block-hero-glow);\n}\n\n[data-block=\"cards\"] {\n  --block-color: var(--block-cards);\n  --block-glow: var(--block-cards-glow);\n}\n\n[data-block=\"cta\"] {\n  --block-color: var(--block-cta);\n  --block-glow: var(--block-cta-glow);\n}\n\n.block-tag {\n  display: none;\n  position: absolute;\n  inset-block-start: 0.25rem;\n  inset-inline-end: 0.25rem;\n  z-index: 1;\n  padding: 0.125rem 0.5rem;\n  border-radius: 999px;\n  background-color: var(--block-color);\n  color: var(--text-neutral-white-fixed);\n  font-size: var(--text-body-xs);\n  font-weight: 600;\n  line-height: 1.25rem;\n}\n\n.is-lit > .block-tag {\n  display: block;\n}\n\n.sample-page.is-lit,\n.block.is-lit {\n  outline: 3px solid var(--block-color);\n  outline-offset: 3px;\n  box-shadow: 0 0 16px 2px var(--block-glow);\n}\n\n.block-header {\n  background-color: var(--background-neutral-tertiary);\n}\n\n.site-name {\n  margin: 0;\n  font-weight: 700;\n}\n\n.block-hero {\n  background-color: var(--background-success-light);\n  text-align: center;\n}\n\n.hero-title {\n  margin: 0.5rem 0 0.25rem;\n  color: var(--text-success-secondary);\n  font-size: 1.375rem;\n  font-weight: 700;\n  line-height: 1.25;\n}\n\n.hero-text {\n  margin: 0 0 0.5rem;\n  color: var(--text-neutral-secondary);\n}\n\n.block-cards {\n  padding: 0.75rem 0;\n}\n\n.card-row {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 0.75rem;\n}\n\n.mini-card {\n  margin: 0;\n  padding: 0.75rem;\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-sm);\n  background-color: var(--background-neutral-secondary);\n  font-weight: 600;\n  text-align: center;\n}\n\n.block-cta {\n  display: flex;\n  justify-content: center;\n  padding: 0.5rem;\n}\n\n.fake-button {\n  display: inline-block;\n  padding: 0.625rem 1.5rem;\n  border-radius: var(--shape-sm);\n  background-color: var(--background-brand-primary);\n  color: var(--text-neutral-white-fixed);\n  font-size: var(--text-body-md);\n  font-weight: 600;\n  line-height: 1.5rem;\n}\n\n/* Code */\n\n.code {\n  display: block;\n  width: max-content;\n  min-width: 100%;\n  padding: 0.5rem 0.25rem;\n}\n\n.code-line {\n  display: grid;\n  grid-template-columns: 2.75rem 1fr;\n  align-items: center;\n  width: 100%;\n  min-height: 1.5rem;\n  margin: 0;\n  padding: 0;\n  border: 0;\n  border-inline-start: 3px solid transparent;\n  background: transparent;\n  color: var(--text-neutral-primary);\n  font-family: var(--font-family-code);\n  font-size: 0.8125rem;\n  line-height: 1.5rem;\n  text-align: start;\n}\n\n.line-number {\n  padding-inline: 0.5rem;\n  color: var(--block-color, var(--text-neutral-quaternary));\n  font-weight: 700;\n  text-align: end;\n}\n\n.line-text {\n  padding-inline: 0.5rem 0.75rem;\n  font-family: inherit;\n  white-space: pre;\n}\n\n.code-line.is-match {\n  position: relative;\n  z-index: 1;\n  border-inline-start-color: var(--border-brand-primary);\n  border-radius: 0.25rem;\n  background-color: var(--background-brand-light);\n  box-shadow: 0 0 8px 1px var(--border-brand-mid);\n  cursor: pointer;\n  transition: var(--transition-colors);\n}\n\ndiv.code-line.is-match {\n  cursor: default;\n}\n\n.code-line.is-selected {\n  border-inline-start-color: var(--border-selected-primary);\n  background-color: var(--background-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n.code-line.is-selected .line-number {\n  color: var(--text-selected-primary);\n}\n\n/* Connector */\n\n.connector {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  overflow: visible;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity 0.25s ease;\n}\n\n.connector.is-visible {\n  opacity: 1;\n}\n\n.connector-glow,\n.connector-line {\n  fill: none;\n  stroke-linecap: round;\n}\n\n.connector-glow {\n  stroke: var(--border-brand-mid);\n  stroke-width: 10;\n  opacity: 0.5;\n}\n\n.connector-line {\n  stroke: var(--border-brand-primary);\n  stroke-width: 3;\n}\n\n.connector-dot {\n  fill: var(--border-brand-primary);\n}\n\n/* Confetti */\n\n.confetti {\n  position: fixed;\n  inset: 0;\n  z-index: 10;\n  overflow: hidden;\n  pointer-events: none;\n}\n\n.confetti-piece {\n  position: absolute;\n  top: -16px;\n  inset-inline-start: var(--start);\n  width: 8px;\n  height: 12px;\n  opacity: 0;\n  animation: confetti-fall var(--duration) ease-in var(--delay) both;\n}\n\n.confetti-piece.color-0 {\n  background-color: var(--confetti-brand);\n}\n\n.confetti-piece.color-1 {\n  background-color: var(--confetti-success);\n}\n\n.confetti-piece.color-2 {\n  background-color: var(--confetti-orange);\n}\n\n.confetti-piece.color-3 {\n  background-color: var(--confetti-info);\n}\n\n@keyframes confetti-fall {\n  0% {\n    opacity: 1;\n    transform: translate(0, 0) rotate(0deg);\n  }\n\n  85% {\n    opacity: 1;\n  }\n\n  100% {\n    opacity: 0;\n    transform: translate(var(--drift), 100vh) rotate(540deg);\n  }\n}\n\n@media (max-width: 640px) {\n  body {\n    padding: 0.5rem;\n  }\n\n  .split {\n    grid-template-columns: minmax(0, 1fr);\n    gap: 2.5rem;\n  }\n\n  .alert {\n    grid-template-columns: auto 1fr;\n  }\n\n  .alert .outline-button {\n    grid-column: 2;\n    justify-self: start;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .confetti {\n    display: none;\n  }\n\n  .code-line.is-match,\n  .chip,\n  .bubble,\n  .outline-button,\n  .connector {\n    transition: none;\n  }\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const CODE_LINES = [\n  { text: '<body>', block: 'page' },\n  { text: '  <!-- header -->', block: 'header' },\n  { text: '  <header class=\"header\">', block: 'header' },\n  { text: '    <p>Save Maple Park</p>', block: 'header' },\n  { text: '  </header>', block: 'header' },\n  { text: '  <!-- hero -->', block: 'hero' },\n  { text: '  <section class=\"hero\">', block: 'hero' },\n  { text: '    <h1>Keep our park green</h1>', block: 'hero' },\n  { text: '    <p>Join neighbors who care.</p>', block: 'hero' },\n  { text: '  </section>', block: 'hero' },\n  { text: '  <!-- feature cards -->', block: 'cards' },\n  { text: '  <section class=\"feature-cards\">', block: 'cards' },\n  { text: '    <div class=\"card\">Clean paths</div>', block: 'cards' },\n  { text: '    <div class=\"card\">New trees</div>', block: 'cards' },\n  { text: '  </section>', block: 'cards' },\n  { text: '  <!-- call-to-action -->', block: 'cta' },\n  { text: '  <a class=\"call-to-action\">', block: 'cta' },\n  { text: '    Join the cleanup', block: 'cta' },\n  { text: '  </a>', block: 'cta' },\n  { text: '</body>', block: 'page' }\n];\n\nconst BLOCK_NAMES = {\n  page: 'body',\n  header: 'header',\n  hero: 'hero',\n  cards: 'feature cards',\n  cta: 'call-to-action'\n};\n\nconst ROUNDS = [\n  {\n    block: 'hero',\n    clue: 'Find the big section at the top that welcomes visitors.',\n    takeaway: 'The name in the code matches the name of the section on the page.'\n  },\n  {\n    block: 'cta',\n    clue: 'Find the section that asks visitors to do something.',\n    takeaway: 'Section names are written right in the code.'\n  },\n  {\n    block: 'cards',\n    clue: 'Find the row of small boxes that share key points.',\n    takeaway: 'A fuller name finds fewer, better matches.'\n  }\n];\n\nconst BONUS_ROUND = 3;\nconst BUBBLE_COUNT = 4;\nconst CONFETTI_COUNT = 28;\nconst CONFETTI_DURATION = 3000;\n\nconst REQUESTS = {\n  all: ['header', 'hero', 'cards', 'cta'],\n  top: ['header', 'hero'],\n  hero: ['hero']\n};\n\nconst MESSAGES = {\n  typeName: 'Type a section name. Lines with that name will glow.',\n  clickLine: 'Click a glowing line to see its section on the page.',\n  lookInCode: 'No lines match. Look through the code for a section name that fits the clue.',\n  noMatch: 'No lines match.',\n  matchOne: (count) => `${count} line glows.`,\n  matchOther: (count) => `${count} lines glow.`,\n  found: (name, takeaway) => `Found it! That is the ${name}. ${takeaway}`,\n  alreadyFound: (name) => `That is the ${name}.`,\n  wrongSection: (name) => `That is the ${name}. Read the clue again.`,\n  clueLabel: (step, total) => `Clue ${step} of ${total}`,\n  bonusLabel: 'Bonus round',\n  doneLabel: 'All done',\n  nextClue: 'Next clue',\n  startBonus: 'Bonus round',\n  playAgain: 'Play again',\n  requestClue: 'Which request points to just one section?',\n  requestHow: 'Tap a request to see which code lines it matches.',\n  requestMany: (count) => `That could mean ${count} sections. Which one do you want to change?`,\n  requestOne: (name) => `That points to one section: the ${name}. Naming a section points to one place, so use section names when you ask AI to change your page.`\n};\n\nfunction normalize(text) {\n  return text.toLowerCase().replace(/[\\s_-]+/g, '');\n}\n\nfunction findMatches(query, lines) {\n  const needle = normalize(query);\n  if (!needle) {\n    return [];\n  }\n  const matches = [];\n  lines.forEach((line, index) => {\n    if (normalize(line.text).includes(needle)) {\n      matches.push(index);\n    }\n  });\n  return matches;\n}\n\nfunction findBlockLines(blockIds, lines) {\n  const matches = [];\n  lines.forEach((line, index) => {\n    if (blockIds.includes(line.block)) {\n      matches.push(index);\n    }\n  });\n  return matches;\n}\n\nfunction init() {\n  const stepLabel = document.getElementById('step-label');\n  const bubbles = document.querySelectorAll('.bubble');\n  const clue = document.getElementById('clue');\n  const statusAlert = document.getElementById('status-alert');\n  const alertText = document.getElementById('alert-text');\n  const alertAction = document.getElementById('alert-action');\n  const search = document.getElementById('search');\n  const searchBox = document.getElementById('search-box');\n  const matchCount = document.getElementById('match-count');\n  const requestTray = document.getElementById('request-tray');\n  const requestChips = document.querySelectorAll('[data-request]');\n  const split = document.getElementById('split');\n  const codeScroll = document.getElementById('code-scroll');\n  const code = document.getElementById('code');\n  const samplePage = document.querySelector('.sample-page');\n  const connector = document.getElementById('connector');\n  const connectorGlow = document.getElementById('connector-glow');\n  const connectorLine = document.getElementById('connector-line');\n  const connectorStart = document.getElementById('connector-start');\n  const connectorEnd = document.getElementById('connector-end');\n  const confetti = document.getElementById('confetti');\n\n  if (!stepLabel || !clue || !statusAlert || !alertText || !alertAction || !search || !searchBox ||\n      !matchCount || !requestTray || !split || !codeScroll || !code || !samplePage || !connector ||\n      !confetti || bubbles.length !== BUBBLE_COUNT) {\n    document.body.textContent = 'This activity could not load. Try refreshing the page.';\n    return;\n  }\n\n  const numberFormat = new Intl.NumberFormat(document.documentElement.lang || 'en');\n  const pluralRules = new Intl.PluralRules(document.documentElement.lang || 'en');\n  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');\n  let roundIndex = 0;\n  let roundDone = false;\n  let gameDone = false;\n  let currentAction = null;\n  let selectedRow = null;\n  let litSections = [];\n  let confettiTimer = null;\n\n  function getBlockElement(blockId) {\n    return blockId === 'page' ? samplePage : document.querySelector(`.block[data-block=\"${blockId}\"]`);\n  }\n\n  function hideConnector() {\n    connector.classList.remove('is-visible');\n  }\n\n  function drawConnector() {\n    if (!selectedRow || litSections.length === 0) {\n      hideConnector();\n      return;\n    }\n\n    const splitBox = split.getBoundingClientRect();\n    const paneBox = codeScroll.getBoundingClientRect();\n    const rowBox = selectedRow.getBoundingClientRect();\n    const blockBox = litSections[0].getBoundingClientRect();\n\n    if (rowBox.bottom < paneBox.top || rowBox.top > paneBox.bottom) {\n      hideConnector();\n      return;\n    }\n\n    const rowMiddle = rowBox.top + rowBox.height / 2 - splitBox.top;\n    const blockMiddle = blockBox.top + blockBox.height / 2 - splitBox.top;\n    let path;\n    let startX;\n    let startY;\n    let endX;\n    let endY;\n\n    if (blockBox.right <= rowBox.left) {\n      startX = rowBox.left - splitBox.left;\n      startY = rowMiddle;\n      endX = blockBox.right - splitBox.left;\n      endY = blockMiddle;\n      const reach = Math.max(24, (startX - endX) / 2);\n      path = `M ${startX} ${startY} C ${startX - reach} ${startY}, ${endX + reach} ${endY}, ${endX} ${endY}`;\n    } else if (blockBox.left >= rowBox.right) {\n      startX = rowBox.right - splitBox.left;\n      startY = rowMiddle;\n      endX = blockBox.left - splitBox.left;\n      endY = blockMiddle;\n      const reach = Math.max(24, (endX - startX) / 2);\n      path = `M ${startX} ${startY} C ${startX + reach} ${startY}, ${endX - reach} ${endY}, ${endX} ${endY}`;\n    } else {\n      startX = rowBox.left - splitBox.left + 24;\n      startY = rowBox.top - splitBox.top;\n      endX = Math.min(Math.max(startX, blockBox.left - splitBox.left + 12), blockBox.right - splitBox.left - 12);\n      endY = blockBox.bottom - splitBox.top;\n      const reach = Math.max(24, (startY - endY) / 2);\n      path = `M ${startX} ${startY} C ${startX} ${startY - reach}, ${endX} ${endY + reach}, ${endX} ${endY}`;\n    }\n\n    connectorGlow.setAttribute('d', path);\n    connectorLine.setAttribute('d', path);\n    connectorStart.setAttribute('cx', String(startX));\n    connectorStart.setAttribute('cy', String(startY));\n    connectorEnd.setAttribute('cx', String(endX));\n    connectorEnd.setAttribute('cy', String(endY));\n    connector.classList.add('is-visible');\n  }\n\n  function clearSelection() {\n    if (selectedRow) {\n      selectedRow.classList.remove('is-selected');\n      selectedRow.removeAttribute('aria-current');\n    }\n    litSections.forEach((section) => section.classList.remove('is-lit'));\n    selectedRow = null;\n    litSections = [];\n    hideConnector();\n  }\n\n  function renderCode(matches, isInteractive) {\n    const matchSet = new Set(matches);\n    const fragment = document.createDocumentFragment();\n\n    CODE_LINES.forEach((line, index) => {\n      const isMatch = matchSet.has(index);\n      const row = document.createElement(isMatch && isInteractive ? 'button' : 'div');\n      const lineNumber = document.createElement('span');\n      const lineText = document.createElement('code');\n\n      row.className = 'code-line';\n      row.dataset.block = line.block;\n      row.dataset.index = String(index);\n      lineNumber.className = 'line-number';\n      lineNumber.textContent = numberFormat.format(index + 1);\n      lineText.className = 'line-text';\n      lineText.textContent = line.text;\n\n      if (isMatch) {\n        row.classList.add('is-match');\n      }\n      if (isMatch && isInteractive) {\n        row.type = 'button';\n        row.setAttribute('aria-label', `Line ${numberFormat.format(index + 1)}: ${line.text.trim()}`);\n      }\n\n      row.append(lineNumber, lineText);\n      fragment.append(row);\n    });\n\n    code.textContent = '';\n    code.append(fragment);\n  }\n\n  function updateBubbles() {\n    bubbles.forEach((bubble, index) => {\n      let state = 'todo';\n      if (index < roundIndex || (index === roundIndex && (roundDone || gameDone))) {\n        state = 'done';\n      } else if (index === roundIndex) {\n        state = 'current';\n      }\n      bubble.dataset.state = state;\n    });\n  }\n\n  function setAlert(sentiment, text) {\n    statusAlert.dataset.sentiment = sentiment;\n    alertText.textContent = text;\n    alertAction.hidden = !currentAction;\n    if (currentAction) {\n      alertAction.textContent = currentAction.label;\n    }\n  }\n\n  function launchConfetti() {\n    if (reducedMotion.matches) {\n      return;\n    }\n    const fragment = document.createDocumentFragment();\n    for (let i = 0; i < CONFETTI_COUNT; i += 1) {\n      const piece = document.createElement('span');\n      piece.className = `confetti-piece color-${i % 4}`;\n      piece.style.setProperty('--start', `${Math.round(Math.random() * 100)}%`);\n      piece.style.setProperty('--drift', `${Math.round(Math.random() * 160 - 80)}px`);\n      piece.style.setProperty('--delay', `${(Math.random() * 0.4).toFixed(2)}s`);\n      piece.style.setProperty('--duration', `${(1.6 + Math.random()).toFixed(2)}s`);\n      fragment.append(piece);\n    }\n    confetti.append(fragment);\n    window.clearTimeout(confettiTimer);\n    confettiTimer = window.setTimeout(() => {\n      confetti.textContent = '';\n    }, CONFETTI_DURATION);\n  }\n\n  function startRound(index, shouldFocus) {\n    roundIndex = index;\n    roundDone = false;\n    currentAction = null;\n    clearSelection();\n    search.hidden = false;\n    requestTray.hidden = true;\n    searchBox.value = '';\n    matchCount.textContent = '';\n    renderCode([], true);\n    stepLabel.textContent = MESSAGES.clueLabel(numberFormat.format(index + 1), numberFormat.format(ROUNDS.length));\n    clue.textContent = ROUNDS[index].clue;\n    setAlert('neutral', MESSAGES.typeName);\n    updateBubbles();\n    if (shouldFocus) {\n      searchBox.focus();\n    }\n  }\n\n  function startBonus() {\n    roundIndex = BONUS_ROUND;\n    roundDone = false;\n    currentAction = null;\n    clearSelection();\n    search.hidden = true;\n    matchCount.textContent = '';\n    requestTray.hidden = false;\n    renderCode([], false);\n    stepLabel.textContent = MESSAGES.bonusLabel;\n    clue.textContent = MESSAGES.requestClue;\n    setAlert('neutral', MESSAGES.requestHow);\n    updateBubbles();\n    requestChips[0].focus();\n  }\n\n  function restart() {\n    gameDone = false;\n    requestChips.forEach((chip) => chip.setAttribute('aria-pressed', 'false'));\n    startRound(0, true);\n  }\n\n  function giveFeedback(blockId) {\n    const round = ROUNDS[roundIndex];\n    const name = BLOCK_NAMES[blockId];\n\n    if (roundDone) {\n      setAlert('success', MESSAGES.alreadyFound(name));\n    } else if (blockId === round.block) {\n      roundDone = true;\n      currentAction = {\n        kind: 'next',\n        label: roundIndex < ROUNDS.length - 1 ? MESSAGES.nextClue : MESSAGES.startBonus\n      };\n      setAlert('success', MESSAGES.found(name, round.takeaway));\n      updateBubbles();\n    } else {\n      setAlert('warning', MESSAGES.wrongSection(name));\n    }\n  }\n\n  function selectRow(row) {\n    clearSelection();\n    const blockId = CODE_LINES[Number(row.dataset.index)].block;\n    const section = getBlockElement(blockId);\n    selectedRow = row;\n    litSections = [section];\n    row.classList.add('is-selected');\n    row.setAttribute('aria-current', 'true');\n    section.classList.add('is-lit');\n    drawConnector();\n    giveFeedback(blockId);\n  }\n\n  function describeMatches(query, matches) {\n    if (!query.trim()) {\n      return '';\n    }\n    if (matches.length === 0) {\n      return MESSAGES.noMatch;\n    }\n    const count = numberFormat.format(matches.length);\n    return pluralRules.select(matches.length) === 'one' ? MESSAGES.matchOne(count) : MESSAGES.matchOther(count);\n  }\n\n  function runSearch() {\n    clearSelection();\n    const query = searchBox.value;\n    const matches = findMatches(query, CODE_LINES);\n    renderCode(matches, true);\n    matchCount.textContent = describeMatches(query, matches);\n\n    if (matches.length > 0) {\n      setAlert(roundDone ? 'success' : 'neutral', MESSAGES.clickLine);\n    } else if (query.trim()) {\n      setAlert('warning', MESSAGES.lookInCode);\n    } else {\n      setAlert(roundDone ? 'success' : 'neutral', MESSAGES.typeName);\n    }\n  }\n\n  function showRequest(chip) {\n    const blockIds = REQUESTS[chip.dataset.request];\n    if (!blockIds) {\n      return;\n    }\n    clearSelection();\n    renderCode(findBlockLines(blockIds, CODE_LINES), false);\n    litSections = blockIds.map(getBlockElement);\n    litSections.forEach((section) => section.classList.add('is-lit'));\n    requestChips.forEach((other) => {\n      other.setAttribute('aria-pressed', String(other === chip));\n    });\n\n    if (blockIds.length > 1) {\n      setAlert('info', MESSAGES.requestMany(numberFormat.format(blockIds.length)));\n      return;\n    }\n\n    if (!gameDone) {\n      gameDone = true;\n      currentAction = { kind: 'restart', label: MESSAGES.playAgain };\n      stepLabel.textContent = MESSAGES.doneLabel;\n      updateBubbles();\n      launchConfetti();\n    }\n    setAlert('success', MESSAGES.requestOne(BLOCK_NAMES[blockIds[0]]));\n  }\n\n  searchBox.addEventListener('input', runSearch);\n\n  alertAction.addEventListener('click', () => {\n    if (!currentAction) {\n      return;\n    }\n    if (currentAction.kind === 'restart') {\n      restart();\n    } else if (roundIndex < ROUNDS.length - 1) {\n      startRound(roundIndex + 1, true);\n    } else {\n      startBonus();\n    }\n  });\n\n  requestChips.forEach((chip) => {\n    chip.addEventListener('click', () => showRequest(chip));\n  });\n\n  code.addEventListener('click', (event) => {\n    const row = event.target.closest('.code-line.is-match');\n    if (row && row.tagName === 'BUTTON') {\n      selectRow(row);\n    }\n  });\n\n  codeScroll.addEventListener('scroll', drawConnector);\n  window.addEventListener('resize', drawConnector);\n  if (typeof ResizeObserver === 'function') {\n    new ResizeObserver(drawConnector).observe(split);\n  }\n\n  startRound(0, false);\n}\n\ninit();\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    },
    "long_instructions": "#### Find it in the Code\r\n\r\nYou’ll learn that every section of a page has a name in the code. Knowing the names helps you find a section and ask AI to change it.\r\n\r\n1. Read the clue at the top.\r\n2. Type the name of the section it describes into the search box. Lines with that name will glow.\r\n3. Click a glowing line. The section lights up on the page.\r\n4. Press “Next clue.” Keep going through the bonus round.\r\n\r\n*Example: Search for “header” to see its lines glow.*\r\n\r\n**Check your prompt:** Does your search word match the section’s name in the code?",
