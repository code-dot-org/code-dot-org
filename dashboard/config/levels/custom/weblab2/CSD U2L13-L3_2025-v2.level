        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    \n    <!-- parent container with 3 child div tags -->\n    <div class=\"flex-shrink\">\n      <div>1</div>\n      <div>2</div>\n      <div>3</div>\n    </div>\n    \n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* 1) Add a rule in the CSS file for the third child item using its class attribute as the selector. */\n\n/* 2) Give the third child item a flex-shrink property with a value of 4. */\n\n.flex-shrink {\n  /* We gave the parent div container a background color so you can see how the items are positioned within it */\n  background: #b691d6;\n  display: flex;\n  padding: 5px;\n}\n\n/* styled child divs in parent continer */\n.flex-shrink > div {\n  background-color: aliceblue;\n  margin: 5px;\n  width: 45%;\n  text-align: center;\n  line-height: 55px;\n  font-size: 20px;\n  border-style: solid;\n  font-family: sans-serif;\n}\n\n/* ADD CODE BELOW to give the 3rd child item a flex-shrink of 4 */",
          "folderId": "0",
          "active": true
        }
      },
