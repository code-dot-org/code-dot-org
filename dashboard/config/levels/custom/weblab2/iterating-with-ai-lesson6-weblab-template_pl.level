      "files": {
        "1": {
          "id": "1",
          "name": "script.js",
          "contents": "let jobs = data;\nlet resultCount   = document.getElementById(\"resultCount\");\n\nlet btnDistance   = document.getElementById(\"btnDistance\");\nlet btnExperience = document.getElementById(\"btnExperience\");\nlet btnSchedule   = document.getElementById(\"btnSchedule\");\n\n\n\n// Filter 'Within 10 miles'\nconst filterByDistance = () => {\n  let results = [];\n\n  for (let i = 0; i < jobs.length; i++) {\n    if (jobs[i].distance <= 10) {\n      results.push(jobs[i]);\n    }\n  }\n\n  setActiveButton(btnDistance);\n  renderResults(results);\n};\n\n\n// Filter '3+ years exp'\nconst filterByExperience = () => {\n  let results = [];\n\n  for (let i = 0; i < jobs.length; i++) {\n    if (jobs[i].experience >= 3) {\n      results.push(jobs[i]);\n    }\n  }\n\n  setActiveButton(btnExperience);\n  renderResults(results);\n};\n\n\n// Filter 'Weekday afternoons'\nconst filterBySchedule = () => {\n  let results = [];\n\n  for (let i = 0; i < jobs.length; i++) {\n    if (jobs[i].schedule === \"weekday-afternoon\") {\n      results.push(jobs[i]);\n    }\n  }\n\n  setActiveButton(btnSchedule);\n  renderResults(results);\n};\n\n\n\n// Event Handlers\nbtnDistance.addEventListener(\"click\", filterByDistance);\nbtnExperience.addEventListener(\"click\", filterByExperience);\nbtnSchedule.addEventListener(\"click\", filterBySchedule);\n\n\n\nrenderResults(jobs);\n",
          "folderId": "0",
          "active": true
        },
        "2": {
          "id": "2",
          "name": "helpers.js",
          "contents": "// Tracks which button is currently active\nlet activeBtn = null;\n\n\n// Highlights the clicked button and clears the others\nconst setActiveButton = (btn) => {\n  activeBtn = btn;\n  btnDistance.classList.remove(\"is-active\");\n  btnExperience.classList.remove(\"is-active\");\n  btnSchedule.classList.remove(\"is-active\");\n  btn.classList.add(\"is-active\");\n};\n\n\n// Updates the result count and renders job cards\nconst renderResults = (results) => {\n\n  // Update the count line\n  const countEl = document.getElementById(\"resultCount\");\n  if (results.length === jobs.length) {\n    countEl.textContent = `Showing all ${results.length} opportunities`;\n  } else if (results.length === 0) {\n    countEl.textContent = \"No results\";\n  } else {\n    countEl.textContent = `${results.length} of ${jobs.length} opportunities`;\n  }\n\n  // Clear existing cards\n  const grid = document.getElementById(\"cards\");\n  grid.innerHTML = \"\";\n\n  // Empty state\n  if (results.length === 0) {\n    grid.innerHTML = `\n      <div class=\"state-empty\">\n        <p class=\"state-title\">No results</p>\n        <p class=\"state-sub\">Try a different filter.</p>\n      </div>`;\n    return;\n  }\n\n  // Build one card per result\n  for (let i = 0; i < results.length; i++) {\n    let job = results[i];\n\n    let scheduleLabel = job.schedule === \"weekday-morning\"\n      ? \"Weekday mornings\"\n      : \"Weekday afternoons\";\n\n    let card = document.createElement(\"div\");\n    card.className = \"card\";\n    card.style.animationDelay = `${i * 35}ms`;\n\n    card.innerHTML = `\n      <div class=\"card-icon\">${job.icon}</div>\n      <div class=\"card-body\">\n        <div class=\"card-title\">${job.title}</div>\n        <div class=\"card-company\">${job.company}</div>\n        <p class=\"card-desc\">${job.description}</p>\n        <div class=\"card-meta\">\n          <span class=\"meta-tag\">${job.distance} mi</span>\n          <span class=\"meta-tag\">${scheduleLabel}</span>\n          <span class=\"meta-tag\">${job.experience}+ yr exp</span>\n          <span class=\"meta-tag\">${job.category}</span>\n        </div>\n      </div>\n      <div class=\"card-pay\">${job.pay}</div>`;\n\n    grid.appendChild(card);\n  }\n\n};\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "data.js",
          "contents": "let data = [\n\n  // RETAIL\n  { title: \"Bookstore Associate\",       company: \"Page & Spine Books\",       description: \"Help customers find books, restock shelves, process purchases.\",           category: \"Retail\",       distance: 1,  schedule: \"weekday-morning\",   experience: 1, pay: \"$14/hr\", icon: \"📖\" },\n  { title: \"Grocery Stock Clerk\",       company: \"FreshMart\",                description: \"Stock shelves, manage inventory, assist shoppers on the floor.\",            category: \"Retail\",       distance: 2,  schedule: \"weekday-morning\",   experience: 1, pay: \"$13/hr\", icon: \"🛒\" },\n  { title: \"Clothing Store Assistant\",  company: \"Urban Thread\",              description: \"Assist customers with styling, maintain displays, handle register.\",        category: \"Retail\",       distance: 3,  schedule: \"weekday-afternoon\", experience: 1, pay: \"$14/hr\", icon: \"👕\" },\n  { title: \"Electronics Sales Rep\",     company: \"Circuit City\",              description: \"Advise customers on devices, process returns, hit weekly sales goals.\",     category: \"Retail\",       distance: 4,  schedule: \"weekday-afternoon\", experience: 3, pay: \"$17/hr\", icon: \"💻\" },\n  { title: \"Sporting Goods Associate\",  company: \"ProGear\",                   description: \"Set up equipment displays, assist customers, manage backstock.\",            category: \"Retail\",       distance: 8,  schedule: \"weekday-morning\",   experience: 1, pay: \"$13/hr\", icon: \"⚽\" },\n\n  // FOOD SERVICE\n  { title: \"Café Counter Staff\",        company: \"Groundwork Coffee\",         description: \"Take orders, prep drinks, keep the counter clean and stocked.\",            category: \"Food Service\", distance: 1,  schedule: \"weekday-morning\",   experience: 1, pay: \"$13/hr\", icon: \"☕\" },\n  { title: \"Restaurant Host\",           company: \"Harbor Grill\",              description: \"Greet guests, manage seating, coordinate with front-of-house staff.\",      category: \"Food Service\", distance: 2,  schedule: \"weekday-afternoon\", experience: 1, pay: \"$13/hr\", icon: \"🍽️\" },\n  { title: \"Kitchen Prep Assistant\",    company: \"Harvest Table\",             description: \"Chop vegetables, prep sauces, clean kitchen equipment.\",                   category: \"Food Service\", distance: 6,  schedule: \"weekday-morning\",   experience: 3, pay: \"$15/hr\", icon: \"🔪\" },\n  { title: \"Bakery Assistant\",          company: \"Rise & Shine Bakery\",       description: \"Package baked goods, assist with early morning prep, serve customers.\",    category: \"Food Service\", distance: 4,  schedule: \"weekday-morning\",   experience: 1, pay: \"$14/hr\", icon: \"🥐\" },\n  { title: \"Smoothie Bar Staff\",        company: \"Blend Studio\",              description: \"Blend orders, maintain health standards, handle transactions.\",             category: \"Food Service\", distance: 9,  schedule: \"weekday-afternoon\", experience: 1, pay: \"$13/hr\", icon: \"🥤\" },\n\n  // OFFICE\n  { title: \"Front Desk Receptionist\",   company: \"Westside Medical Group\",    description: \"Answer phones, schedule appointments, greet patients.\",                   category: \"Office\",       distance: 2,  schedule: \"weekday-morning\",   experience: 1, pay: \"$15/hr\", icon: \"📋\" },\n  { title: \"Data Entry Clerk\",          company: \"Allied Insurance\",          description: \"Enter and verify records, maintain spreadsheets, file documents.\",         category: \"Office\",       distance: 5,  schedule: \"weekday-afternoon\", experience: 1, pay: \"$14/hr\", icon: \"⌨️\" },\n  { title: \"Filing & Records Clerk\",    company: \"City Hall\",                 description: \"Organize and archive public records, assist administrative staff.\",        category: \"Office\",       distance: 7,  schedule: \"weekday-morning\",   experience: 3, pay: \"$16/hr\", icon: \"🗂️\" },\n  { title: \"Office Supply Runner\",      company: \"Nexus Consulting\",          description: \"Restock supplies, run errands between offices, support admin team.\",       category: \"Office\",       distance: 3,  schedule: \"weekday-afternoon\", experience: 1, pay: \"$13/hr\", icon: \"📦\" },\n\n  // OUTDOORS\n  { title: \"Park Maintenance Aide\",     company: \"City Parks Dept.\",          description: \"Clean pathways, pick up litter, assist with equipment upkeep.\",            category: \"Outdoors\",     distance: 2,  schedule: \"weekday-morning\",   experience: 1, pay: \"$14/hr\", icon: \"🌳\" },\n  { title: \"Landscape Crew Member\",     company: \"GreenEdge\",                 description: \"Mow, trim, and maintain commercial and residential properties.\",           category: \"Outdoors\",     distance: 11, schedule: \"weekday-morning\",   experience: 3, pay: \"$16/hr\", icon: \"🌿\" },\n  { title: \"Farmers Market Assistant\",  company: \"Valley Fresh Market\",       description: \"Set up vendor stalls, assist sellers, handle customer questions.\",         category: \"Outdoors\",     distance: 4,  schedule: \"weekday-morning\",   experience: 1, pay: \"$13/hr\", icon: \"🥦\" },\n\n  // TECH\n  { title: \"IT Help Desk Assistant\",    company: \"Meridian Tech\",             description: \"Troubleshoot hardware and software issues for office staff.\",              category: \"Tech\",         distance: 12, schedule: \"weekday-afternoon\", experience: 3, pay: \"$18/hr\", icon: \"🖥️\" },\n  { title: \"Library Tech Support\",      company: \"Central Public Library\",    description: \"Help patrons use library computers, printers, and digital resources.\",    category: \"Tech\",         distance: 2,  schedule: \"weekday-afternoon\", experience: 1, pay: \"$14/hr\", icon: \"📡\" },\n  { title: \"Computer Lab Monitor\",      company: \"Lincoln Community Center\",  description: \"Supervise computer lab, assist users, keep equipment in working order.\",  category: \"Tech\",         distance: 3,  schedule: \"weekday-morning\",   experience: 1, pay: \"$13/hr\", icon: \"🖱️\" },\n\n  // SUPPORT\n  { title: \"After-School Program Aide\", company: \"Bright Futures\",            description: \"Support students with homework, lead activities, coordinate with staff.\",  category: \"Support\",      distance: 1,  schedule: \"weekday-afternoon\", experience: 1, pay: \"$14/hr\", icon: \"🎒\" },\n  { title: \"Summer Camp Counselor\",     company: \"Camp Ridgeline\",            description: \"Lead outdoor activities, supervise campers, assist lead counselors.\",      category: \"Support\",      distance: 8,  schedule: \"weekday-morning\",   experience: 3, pay: \"$15/hr\", icon: \"⛺\" },\n  { title: \"Community Center Staff\",    company: \"Eastside Community Hub\",    description: \"Coordinate drop-in programs, manage sign-ins, support event setup.\",      category: \"Support\",      distance: 3,  schedule: \"weekday-afternoon\", experience: 1, pay: \"$13/hr\", icon: \"🏠\" },\n  { title: \"Youth Sports Referee\",      company: \"City Rec League\",           description: \"Officiate youth soccer and basketball games, track scores.\",               category: \"Support\",      distance: 5,  schedule: \"weekday-afternoon\", experience: 1, pay: \"$14/hr\", icon: \"🏅\" },\n  { title: \"Animal Shelter Helper\",     company: \"Paws & Care Shelter\",       description: \"Feed and care for animals, assist with adoptions, clean kennels.\",        category: \"Support\",      distance: 2,  schedule: \"weekday-morning\",   experience: 3, pay: \"$15/hr\", icon: \"🐾\" }\n\n];\n",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "style.css",
          "contents": "/*\n  OpportunityMatch — style.css\n  Light, minimal, editorial. Looks like a real product.\n*/\n\n:root {\n  --bg:      #f7f6f3;\n  --surface: #ffffff;\n  --border:  #e4e2dc;\n  --ink:     #1a1a1a;\n  --ink-2:   #4a4a4a;\n  --muted:   #888580;\n  --accent:  #2563eb;\n}\n\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\nbody {\n  font-family: \"Georgia\", serif;\n  background: var(--bg);\n  color: var(--ink);\n  min-height: 100vh;\n  -webkit-font-smoothing: antialiased;\n}\n\n/* ── Header ─────────────────────────────────────────── */\n.site-header {\n  background: var(--surface);\n  border-bottom: 1px solid var(--border);\n  position: sticky;\n  top: 0;\n  z-index: 50;\n}\n\n.header-inner {\n  max-width: 800px;\n  margin: 0 auto;\n  padding: 14px 24px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.logo { display: flex; align-items: center; gap: 10px; }\n\n.logo-mark {\n  width: 28px;\n  height: 28px;\n  background: var(--ink);\n  color: #fff;\n  border-radius: 7px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: bold;\n  font-size: 0.9rem;\n  flex-shrink: 0;\n}\n\n.logo-text {\n  font-size: 1rem;\n  font-weight: bold;\n  letter-spacing: -0.3px;\n}\n\n.header-tag {\n  font-family: \"Trebuchet MS\", sans-serif;\n  font-size: 0.75rem;\n  color: var(--muted);\n}\n\n/* ── Hero ───────────────────────────────────────────── */\n.hero {\n  background: var(--surface);\n  border-bottom: 1px solid var(--border);\n  padding: 52px 24px 48px;\n}\n\n.hero-inner { max-width: 800px; margin: 0 auto; }\n\n.hero-eyebrow {\n  font-family: \"Trebuchet MS\", sans-serif;\n  font-size: 0.75rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1.5px;\n  color: var(--accent);\n  margin-bottom: 12px;\n}\n\n.hero-title {\n  font-size: clamp(1.9rem, 4vw, 2.8rem);\n  font-weight: bold;\n  line-height: 1.15;\n  letter-spacing: -0.5px;\n  margin-bottom: 10px;\n}\n\n.hero-sub {\n  font-family: \"Trebuchet MS\", sans-serif;\n  font-size: 0.95rem;\n  color: var(--ink-2);\n}\n\n/* ── Main ───────────────────────────────────────────── */\n.main {\n  max-width: 800px;\n  margin: 0 auto;\n  padding: 28px 24px 80px;\n}\n\n/* ── Toolbar ────────────────────────────────────────── */\n.toolbar {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-bottom: 20px;\n}\n\n.filter-btn {\n  font-family: \"Trebuchet MS\", sans-serif;\n  font-size: 0.85rem;\n  font-weight: 600;\n  padding: 8px 18px;\n  border-radius: 999px;\n  border: 1.5px solid var(--border);\n  background: var(--surface);\n  color: var(--ink-2);\n  cursor: pointer;\n  transition: border-color 0.12s, color 0.12s, background 0.12s;\n}\n\n.filter-btn:hover {\n  border-color: var(--ink);\n  color: var(--ink);\n}\n\n.filter-btn.is-active {\n  background: var(--ink);\n  border-color: var(--ink);\n  color: #fff;\n}\n\n/* ── Result count ───────────────────────────────────── */\n.result-count {\n  font-family: \"Trebuchet MS\", sans-serif;\n  font-size: 0.8rem;\n  color: var(--muted);\n  margin-bottom: 16px;\n}\n\n/* ── Cards ──────────────────────────────────────────── */\n.cards {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.card {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  padding: 18px 20px;\n  display: flex;\n  align-items: flex-start;\n  gap: 14px;\n  transition: box-shadow 0.15s, border-color 0.15s;\n  animation: fadeUp 0.2s ease both;\n}\n\n@keyframes fadeUp {\n  from { opacity: 0; transform: translateY(5px); }\n  to   { opacity: 1; transform: translateY(0); }\n}\n\n.card:hover {\n  box-shadow: 0 4px 14px rgba(0,0,0,0.08);\n  border-color: #ccc;\n}\n\n.card-icon {\n  font-size: 1.5rem;\n  width: 42px;\n  height: 42px;\n  background: var(--bg);\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.card-body { flex: 1; min-width: 0; }\n\n.card-title {\n  font-size: 0.97rem;\n  font-weight: bold;\n  margin-bottom: 2px;\n}\n\n.card-company {\n  font-family: \"Trebuchet MS\", sans-serif;\n  font-size: 0.78rem;\n  color: var(--muted);\n  margin-bottom: 6px;\n}\n\n.card-desc {\n  font-size: 0.85rem;\n  color: var(--ink-2);\n  line-height: 1.5;\n  margin-bottom: 10px;\n}\n\n.card-meta {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 5px;\n}\n\n.meta-tag {\n  font-family: \"Trebuchet MS\", sans-serif;\n  font-size: 0.7rem;\n  font-weight: 600;\n  padding: 3px 9px;\n  border-radius: 999px;\n  border: 1px solid var(--border);\n  background: var(--bg);\n  color: var(--ink-2);\n}\n\n.card-pay {\n  font-family: \"Trebuchet MS\", sans-serif;\n  font-size: 0.88rem;\n  font-weight: 700;\n  color: var(--ink);\n  white-space: nowrap;\n  align-self: center;\n  flex-shrink: 0;\n}\n\n/* ── Empty state ────────────────────────────────────── */\n.state-empty {\n  padding: 48px 20px;\n  text-align: center;\n}\n\n.state-title {\n  font-size: 1rem;\n  font-weight: bold;\n  margin-bottom: 4px;\n}\n\n.state-sub {\n  font-family: \"Trebuchet MS\", sans-serif;\n  font-size: 0.85rem;\n  color: var(--muted);\n}\n\n/* ── Responsive ─────────────────────────────────────── */\n@media (max-width: 560px) {\n  .hero { padding: 36px 18px 32px; }\n  .main { padding: 20px 16px 60px; }\n  .card { flex-wrap: wrap; }\n  .card-pay { width: 100%; }\n  .header-tag { display: none; }\n}\n",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>OpportunityMatch</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n\n  <header class=\"site-header\">\n    <div class=\"header-inner\">\n      <div class=\"logo\">\n        <span class=\"logo-text\">OpportunityMatch</span>\n      </div>\n    </div>\n  </header>\n\n\n\n  <main class=\"main\">\n\n    <div class=\"toolbar\">\n      <button class=\"filter-btn\" id=\"btnDistance\">Within 10 miles</button>\n      <button class=\"filter-btn\" id=\"btnExperience\">3+ years exp</button>\n      <button class=\"filter-btn\" id=\"btnSchedule\">Weekday afternoons</button>\n    </div>\n\n    <p class=\"result-count\" id=\"resultCount\"></p>\n\n    <div class=\"cards\" id=\"cards\"></div>\n\n  </main>\n\n  <script src=\"data.js\" ></script>\n  <script src=\"helpers.js\"></script>\n  <script src=\"script.js\"></script>\n\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "1"
      ]
    },
    "name_suffix": "_pl"
  },
  "published": true,
