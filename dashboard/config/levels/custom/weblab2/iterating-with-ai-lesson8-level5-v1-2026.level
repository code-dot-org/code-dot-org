          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Shop Helper</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"data.js\" defer></script>\n  <script src=\"helpers.js\" defer></script>\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <div class=\"app-container\">\n    <header>\n      <h1>Shop Helper</h1>\n      <p>Filter items to find what you need.</p>\n    </header>\n\n    <div class=\"controls\">\n      <div class=\"filter-group\">\n        <button id=\"filterElecBtn\" class=\"btn filter-btn\">Electronics</button>\n        <button id=\"filterHomeBtn\" class=\"btn filter-btn\">Home</button>\n        <button id=\"filterCheapBtn\" class=\"btn filter-btn\">Under $50</button>\n      </div>\n\n      <div class=\"action-group\">\n        <button id=\"undoBtn\" class=\"btn undo-btn\">↩ Undo</button>\n        <button id=\"resetBtn\" class=\"btn reset-btn\">Reset All</button>\n      </div>\n    </div>\n\n    <div id=\"pillContainer\" class=\"pill-area\"></div>\n\n    <div id=\"productContainer\" class=\"product-grid\"></div>\n  </div>\n\n</body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// STATE Variables\nlet currentProducts = products.slice();\nlet activeFilters = [];\nlet historyStack = [];\n\n// DOM Elements\nconst productContainer = document.querySelector(\"#productContainer\");\nconst pillContainer = document.querySelector(\"#pillContainer\");\nconst undoBtn = document.querySelector(\"#undoBtn\");\nconst resetBtn = document.querySelector(\"#resetBtn\");\n\n// 1. Render Function\nconst updateUI = () => {\n  productContainer.innerHTML = \"\";\n  currentProducts.forEach(item => productContainer.appendChild(createCard(item)));\n\n  pillContainer.innerHTML = \"\";\n  activeFilters.forEach(text => pillContainer.appendChild(createPill(text)));\n};\n\n// 2. Filter Logic\nconst applyFilter = (filterFn, filterName) => {\n\n  // Apply changes\n  currentProducts = currentProducts.filter(filterFn);\n  activeFilters.push(filterName);\n\n  updateUI();\n};\n\n// 3. Event Listeners\ndocument.querySelector(\"#filterElecBtn\").addEventListener(\"click\", () => {\n  applyFilter(item => item.category === \"Electronics\", \"Electronics\");\n});\n\ndocument.querySelector(\"#filterHomeBtn\").addEventListener(\"click\", () => {\n  applyFilter(item => item.category === \"Home\", \"Home\");\n});\n\ndocument.querySelector(\"#filterCheapBtn\").addEventListener(\"click\", () => {\n  applyFilter(item => item.price < 50, \"Under $50\");\n});\n\n// Undo Button\nundoBtn.addEventListener(\"click\", () => {\n\n});\n\n// Reset Button\nresetBtn.addEventListener(\"click\", () => {\n  currentProducts = products.slice();\n  activeFilters = [];\n  historyStack = [];\n  updateUI();\n});\n\nupdateUI();\n",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  font-family: 'Inter', sans-serif;\n  background-color: #0f0f0f;\n  color: #f5f5f5;\n  min-height: 100vh;\n  padding: 24px 16px;\n}\n\n.app-container {\n  max-width: 640px;\n  margin: 0 auto;\n}\n\nheader {\n  margin-bottom: 32px;\n}\n\nheader h1 {\n  font-size: 1.75rem;\n  font-weight: 700;\n  letter-spacing: -0.5px;\n}\n\nheader p {\n  color: #a3a3a3;\n  font-size: 0.9rem;\n  margin-top: 4px;\n}\n\n.controls {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  margin-bottom: 16px;\n}\n\n@media (min-width: 480px) {\n  .controls {\n    flex-direction: row;\n    justify-content: space-between;\n    align-items: center;\n  }\n}\n\n.filter-group, .action-group {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.btn {\n  padding: 8px 16px;\n  border: 1px solid #2a2a2a;\n  border-radius: 999px;\n  cursor: pointer;\n  font-family: 'Inter', sans-serif;\n  font-weight: 600;\n  font-size: 0.85rem;\n  transition: all 0.15s ease;\n}\n\n.filter-btn {\n  background-color: #1a1a1a;\n  color: #f5f5f5;\n}\n\n.filter-btn:hover {\n  background-color: #2a2a2a;\n  border-color: #a855f7;\n}\n\n.undo-btn {\n  background-color: #1a1a1a;\n  color: #f5f5f5;\n}\n\n.undo-btn:hover {\n  background-color: #2a2a2a;\n}\n\n.reset-btn {\n  background-color: #a855f7;\n  color: #fff;\n  border-color: #a855f7;\n}\n\n.reset-btn:hover {\n  background-color: #9333ea;\n  border-color: #9333ea;\n}\n\n/* Pill area */\n.pill-area {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  min-height: 28px;\n  margin-bottom: 20px;\n}\n\n.pill {\n  background-color: #a855f7;\n  color: #fff;\n  padding: 4px 12px;\n  border-radius: 999px;\n  font-size: 0.8rem;\n  font-weight: 500;\n  animation: fadeIn 0.2s ease;\n}\n\n@keyframes fadeIn {\n  from { opacity: 0; transform: translateY(-4px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* Product grid */\n.product-grid {\n  display: grid;\n  gap: 8px;\n}\n\n.product-card {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 16px;\n  background: #1a1a1a;\n  border: 1px solid #2a2a2a;\n  border-radius: 12px;\n  transition: border-color 0.15s ease;\n}\n\n.product-card:hover {\n  border-color: #3a3a3a;\n}\n\n.price {\n  font-weight: 700;\n  color: #a855f7;\n}\n",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "data.js",
          "contents": "const products = [\n  { id: 1, name: \"Wireless Earbuds\", category: \"Electronics\", price: 45 },\n  { id: 2, name: \"Smart Speaker\", category: \"Electronics\", price: 89 },\n  { id: 3, name: \"Coffee Maker\", category: \"Home\", price: 35 },\n  { id: 4, name: \"Blender\", category: \"Home\", price: 60 },\n  { id: 5, name: \"Desk Lamp\", category: \"Home\", price: 25 },\n  { id: 6, name: \"Portable Charger\", category: \"Electronics\", price: 20 }\n];\n",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
        "5": {
          "id": "5",
          "name": "helpers.js",
          "contents": "const createCard = (item) => {\n  const card = document.createElement(\"div\");\n  card.className = \"product-card\";\n  card.innerHTML = `<span>${item.name}</span><span class=\"price\">$${item.price}</span>`;\n  return card;\n};\n\nconst createPill = (text) => {\n  const pill = document.createElement(\"span\");\n  pill.className = \"pill\";\n  pill.textContent = text;\n  return pill;\n};\n",
          "folderId": "0",
          "active": false,
          "type": "support"
        }
      },
      "openFiles": [
        "2"
      ]
    },
