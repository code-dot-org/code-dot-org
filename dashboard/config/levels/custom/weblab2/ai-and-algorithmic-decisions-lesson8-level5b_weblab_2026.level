      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>StreamLogic | Content Filter Engine</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n    <nav class=\"top-nav\" id=\"topNavigation\">\n        <div class=\"nav-left\">\n            <button class=\"icon-btn\" id=\"menuButton\" aria-label=\"Menu\">\n                <svg viewBox=\"0 0 24 24\" class=\"yt-icon\"><path fill=\"currentColor\" d=\"M21 6H3V5h18v1zm0 5H3v1h18v-1zm0 6H3v1h18v-1z\"></path></svg>\n            </button>\n        </div>\n        <div class=\"nav-center\">\n            <div class=\"search-box\" id=\"searchContainer\">\n                <div class=\"search-input-wrapper\">\n                    <span class=\"search-pill\">me <button id=\"clearSearchBtn\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\"><path fill=\"currentColor\" d=\"M12.71 12l4.15-4.15-.71-.71L12 11.29 7.85 7.15l-.71.71L11.29 12l-4.15 4.15.71.71L12 12.71l4.15 4.15.71-.71L12.71 12z\"></path></svg></button></span>\n                    <input type=\"text\" id=\"searchInput\" placeholder=\"Search\">\n                </div>\n                <button class=\"search-btn\" id=\"submitSearchButton\">\n                    <svg viewBox=\"0 0 24 24\" class=\"yt-icon\"><path fill=\"currentColor\" d=\"M20.87 20.15l-5.59-5.59C16.35 13.35 17 11.75 17 10c0-3.87-3.13-7-7-7s-7 3.13-7 7 3.13 7 7 7c1.75 0 3.35-.65 4.56-1.71l5.59 5.59.71-.71zM10 16c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6z\"></path></svg>\n                </button>\n            </div>\n            <button class=\"icon-btn mic-btn\" id=\"voiceSearchButton\">\n                <svg viewBox=\"0 0 24 24\" class=\"yt-icon\"><path fill=\"currentColor\" d=\"M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z\"></path><path fill=\"currentColor\" d=\"M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z\"></path></svg>\n            </button>\n        </div>\n        <div class=\"nav-right\">\n            <button class=\"create-btn\" id=\"createVideoButton\">\n                <svg viewBox=\"0 0 24 24\" class=\"yt-icon\"><path fill=\"currentColor\" d=\"M14 13h-3v3H9v-3H6v-2h3V8h2v3h3v2zm3-7H3v12h14v-6.39l4 1.83V8.56l-4 1.83V6m2-2v16H1V4h18z\"></path></svg> Create\n            </button>\n            <button class=\"icon-btn notification\" id=\"notificationsButton\">\n                <svg viewBox=\"0 0 24 24\" class=\"yt-icon\"><path fill=\"currentColor\" d=\"M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z\"></path></svg>\n                <span class=\"badge\" id=\"notificationBadge\">1</span>\n            </button>\n            <div class=\"user-avatar\" id=\"userProfileIcon\">J</div>\n        </div>\n    </nav>\n\n    <main class=\"app-container\">\n        <section class=\"video-column\">\n            \n            <div class=\"player-wrapper\" id=\"videoPlayerArea\">\n                \n                <div id=\"videoContentArea\" class=\"content-container\">\n                    <img class=\"content-bg\" id=\"videoBackground\" src=\"\" alt=\"Video Snapshot\">\n                    \n                    <div class=\"content-overlay\">\n                        <h2 id=\"videoMessage\" class=\"video-message\"></h2>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"video-meta\" id=\"videoMetadata\">\n                <h1 class=\"video-title\" id=\"videoTitle\">World's Most Dangerous Sharks MEGA EPISODE - Top 4 Full Episodes | Sharkfest</h1>\n                \n                <div class=\"action-row\">\n                    <div class=\"channel-info\" id=\"channelInfoBlock\">\n                        <img src=\"https://picsum.photos/seed/natgeo/50/50\" alt=\"Channel Avatar\" class=\"channel-avatar\" id=\"channelAvatar\">\n                        <div class=\"channel-text\">\n                            <div class=\"channel-name\" id=\"channelName\">National Geographic <svg viewBox=\"0 0 24 24\" width=\"14\" height=\"14\" style=\"color: #aaaaaa; vertical-align: text-bottom;\"><path fill=\"currentColor\" d=\"M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zM9.8 17.3l-4.2-4.1L7 11.8l2.8 2.7L17 7.4l1.4 1.5-8.6 8.4z\"></path></svg></div>\n                            <div class=\"channel-subs\" id=\"channelSubCount\">26M subscribers</div>\n                        </div>\n                        <button class=\"subscribe-btn\" id=\"subscribeButton\">Subscribe</button>\n                    </div>\n                    \n                    <div class=\"action-buttons\">\n                        <div class=\"pill-group\" id=\"votingPill\">\n                            <button class=\"pill-btn like-btn\" id=\"likeButton\">\n                                <svg viewBox=\"0 0 24 24\" class=\"yt-icon\"><path fill=\"currentColor\" d=\"M18.77,11h-4.23l1.52-4.94C16.38,5.03,15.54,4,14.38,4c-0.58,0-1.14,0.24-1.52,0.65L7,11H3v10h4h1h9.43 c1.06,0,1.98-0.67,2.19-1.61l1.34-6C21.23,12.15,20.18,11,18.77,11z M7,20H4v-8h3V20z M19.98,13.17l-1.34,6 C18.54,19.65,18.03,20,17.43,20H8v-8.61l5.6-6.06C13.84,5.09,14.11,5,14.38,5c0.26,0,0.5,0.11,0.63,0.3 c0.07,0.1,0.15,0.26,0.09,0.47l-1.52,4.94L13.18,12h1.35h4.23c0.41,0,0.8,0.17,1.03,0.46C19.92,12.61,20.05,12.86,19.98,13.17z\"></path></svg> 9.6K\n                            </button>\n                            <div class=\"divider\"></div>\n                            <button class=\"pill-btn dislike-btn\" id=\"dislikeButton\">\n                                <svg viewBox=\"0 0 24 24\" class=\"yt-icon\"><path fill=\"currentColor\" d=\"M17,4h-1H6.57C5.5,4,4.59,4.67,4.38,5.61l-1.34,6C2.77,12.85,3.82,14,5.23,14h4.23l-1.52,4.94C7.62,19.97,8.46,21,9.62,21 c0.58,0,1.14-0.24,1.52-0.65L17,14h4V4H17z M10.4,19.67C10.21,19.88,9.92,20,9.62,20c-0.26,0-0.5-0.11-0.63-0.3 c-0.07-0.1-0.15-0.26-0.09-0.47l1.52-4.94l0.4-1.29H9.46H5.23c-0.41,0-0.8-0.17-1.03-0.46c-0.12-0.15-0.25-0.4-0.18-0.71l1.34-6 C5.46,5.35,5.97,5,6.57,5H16v8.61L10.4,19.67z M20,13h-3V5h3V13z\"></path></svg>\n                            </button>\n                        </div>\n                        <button class=\"pill-btn standalone\" id=\"shareButton\">\n                            <svg viewBox=\"0 0 24 24\" class=\"yt-icon\"><path fill=\"currentColor\" d=\"M15 5.63L20.66 12 15 18.37V14h-1c-3.96 0-7.14 1-9.75 3.09 1.84-4.07 5.11-6.4 9.89-7.1l.86-.13V5.63M14 3v6C6.22 10.13 3.11 15.33 2 21c2.78-3.97 6.44-6 12-6v6l8-9-8-9z\"></path></svg> Share\n                        </button>\n                        <button class=\"pill-btn standalone\" id=\"moreOptionsButton\">\n                            <svg viewBox=\"0 0 24 24\" class=\"yt-icon\"><path fill=\"currentColor\" d=\"M12 16.5c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5-1.5-.67-1.5-1.5.67-1.5 1.5-1.5zM10.5 12c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5-.67-1.5-1.5-1.5-1.5.67-1.5 1.5zm0-6c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5-.67-1.5-1.5-1.5-1.5.67-1.5 1.5z\"></path></svg>\n                        </button>\n                    </div>\n                </div>\n\n                <div class=\"description-box\" id=\"videoDescriptionBox\">\n                    <div class=\"desc-stats\"><strong>4,172,796 views &nbsp; Jul 4, 2024</strong> &nbsp; <span class=\"tags\">#NationalGeographic #MegaEpisode #SharkWeek</span></div>\n                    \n                </div>\n            </div>\n        </section>\n    </main>\n\n    <div class=\"logic-lab\" id=\"logicLabPanel\">\n        <h3>🛠 Content Filter Lab <button id=\"toggleLabMinimize\" class=\"lab-toggle-btn\">−</button></h3>\n        <p>Test the nested <code>if/else</code> content logic:</p>\n        \n        <div class=\"control-row\">\n            <label>conditionA</label>\n            <button id=\"toggleA\" class=\"lab-btn\">FALSE</button>\n        </div>\n\n        <div class=\"control-row\">\n            <label>conditionB</label>\n            <button id=\"toggleB\" class=\"lab-btn\">FALSE</button>\n        </div>\n\n    </div>\n\n    <script src=\"script.js\"></script>\n    <script src=\"lab-overlay.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "// State Variables\nlet conditionA = false;\nlet conditionB = false;\n\n// UI Element References\nconst videoMessage = document.getElementById(\"videoMessage\");\nconst videoBackground = document.getElementById(\"videoBackground\");\n\n// Function to update the video content based on logical conditions\nconst updateAppUI = () => {\n    \n\n\n\n  \n  \n\n};\n\n\n\nupdateAppUI();",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "lab-overlay.js",
          "contents": "// ==========================================\n// LAB OVERLAY CONTROLS\n// ==========================================\n\n// Select DOM Elements\nconst btnA = document.getElementById('toggleA');\nconst btnB = document.getElementById('toggleB');\nconst statusDisplay = document.getElementById('logicStatus');\nconst toggleMinimizeBtn = document.getElementById('toggleLabMinimize');\nconst logicLabPanel = document.getElementById('logicLabPanel');\n\n// 1. Minimize/Expand Logic for the Lab Window\ntoggleMinimizeBtn.addEventListener('click', () => {\n    logicLabPanel.classList.toggle('minimized');\n    \n    if (logicLabPanel.classList.contains('minimized')) {\n        toggleMinimizeBtn.innerText = '+';\n    } else {\n        toggleMinimizeBtn.innerText = '−';\n    }\n});\n\n// 2. Toggle Logic for \"conditionA\"\nbtnA.addEventListener('click', () => {\n    // Toggle the global variable (defined in script.js)\n    conditionA = !conditionA;\n    \n    // Update Button Text\n    btnA.innerText = conditionA ? \"TRUE\" : \"FALSE\";\n    \n    // Toggle the active class (turns the button green)\n    if (conditionA) {\n        btnA.classList.add('active'); \n    } else {\n        btnA.classList.remove('active'); \n    }\n    \n    // Trigger updates\n    updateAppUI();\n    updateLabStatus();\n});\n\n// 3. Toggle Logic for \"conditionB\"\nbtnB.addEventListener('click', () => {\n    // Toggle the global variable (defined in script.js)\n    conditionB = !conditionB;\n    \n    // Update Button Text\n    btnB.innerText = conditionB ? \"TRUE\" : \"FALSE\";\n    \n    // Toggle the active class (turns the button green)\n    if (conditionB) {\n        btnB.classList.add('active'); \n    } else {\n        btnB.classList.remove('active'); \n    }\n    \n    // Trigger updates\n    updateAppUI();\n    updateLabStatus();\n});\n\n// 4. Update the visual Engine Status in the Lab Panel\nfunction updateLabStatus() {\n    \n    // Mirrored Nested Logic for the Status Display\n    if (conditionA) {\n        \n        if (conditionB) {\n            statusDisplay.innerText = \"State: conditionA && conditionB\";\n            statusDisplay.style.color = \"#00ba7c\"; // Green\n        } else {\n            statusDisplay.innerText = \"State: conditionA && !conditionB\";\n            statusDisplay.style.color = \"#1d9bf0\"; // Blue\n        }\n\n    } else {\n        \n        if (conditionB) {\n            statusDisplay.innerText = \"State: !conditionA && conditionB\";\n            statusDisplay.style.color = \"#ffd400\"; // Yellow\n        } else {\n            statusDisplay.innerText = \"State: !conditionA && !conditionB\";\n            statusDisplay.style.color = \"#f91880\"; // Pink/Red\n        }\n\n    }\n}\n\n// Initialize the lab status text on first page load\nupdateLabStatus();",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
        "4": {
          "id": "4",
          "name": "style.css",
          "contents": ":root {\n    --yt-bg: #0f0f0f;\n    --yt-text: #ffffff;\n    --yt-text-gray: #aaaaaa;\n    --yt-border: #3f3f3f;\n    --yt-pill-bg: #272727;\n    --yt-pill-hover: #3f3f3f;\n    --ad-bg: #a3a8a9;\n    --ad-text: #ffffff;\n    --blue-link: #3ea6ff;\n}\n\n* { \n    box-sizing: border-box; \n    margin: 0; \n    padding: 0; \n}\n\nbody {\n    background-color: var(--yt-bg);\n    color: var(--yt-text);\n    font-family: \"Roboto\", Arial, sans-serif;\n    -webkit-font-smoothing: antialiased;\n    overflow-x: hidden;\n}\n\n/* Icons */\n.yt-icon {\n    width: 24px;\n    height: 24px;\n    color: var(--yt-text);\n}\n\n/* =========================================\n   TOP NAVIGATION (Desktop)\n   ========================================= */\n.top-nav {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 0 16px;\n    height: 56px;\n    background: var(--yt-bg);\n    position: sticky;\n    top: 0;\n    z-index: 100;\n}\n\n.nav-left, .nav-center, .nav-right { \n    display: flex; \n    align-items: center; \n}\n\n.nav-center {\n    flex: 1; \n    justify-content: flex-end; \n}\n\n.icon-btn {\n    background: transparent;\n    border: none;\n    cursor: pointer;\n    padding: 8px;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n.icon-btn:hover { background: var(--yt-pill-bg); }\n\n.logo { display: flex; align-items: center; margin-left: 16px; cursor: pointer; }\n.logo-text { font-weight: bold; font-size: 20px; margin-left: 4px; letter-spacing: -1px; }\n\n/* Search Area */\n.search-box { display: flex; align-items: center; }\n\n.search-input-wrapper {\n    display: flex;\n    align-items: center;\n    background: #121212;\n    border: 1px solid var(--yt-border);\n    border-radius: 40px 0 0 40px;\n    padding: 2px 16px;\n    width: 500px;\n    height: 40px;\n}\n\n.search-pill {\n    background: transparent;\n    color: var(--yt-text);\n    border: 1px solid var(--yt-border);\n    padding: 2px 8px;\n    border-radius: 16px;\n    font-size: 14px;\n    display: flex;\n    align-items: center;\n    margin-right: 8px;\n}\n\n#clearSearchBtn { background: none; border: none; color: var(--yt-text); cursor: pointer; margin-left: 4px; display: flex; }\n\n.search-input-wrapper input { background: transparent; border: none; color: white; font-size: 16px; outline: none; width: 100%; }\n\n.search-btn {\n    background: #222222;\n    border: 1px solid var(--yt-border);\n    border-left: none;\n    padding: 0 20px;\n    height: 40px;\n    border-radius: 0 40px 40px 0;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n}\n\n.mic-btn { background: #181818; margin-left: 8px; }\n\n/* Right Nav Actions */\n.create-btn {\n    background: transparent;\n    color: var(--yt-text);\n    border: none;\n    display: flex;\n    align-items: center;\n    font-weight: 500;\n    font-size: 14px;\n    cursor: pointer;\n    padding: 6px 12px;\n    border-radius: 18px;\n    margin-left: 16px;\n}\n.create-btn:hover { background: var(--yt-pill-bg); }\n.create-btn .yt-icon { margin-right: 6px; }\n\n.notification { position: relative; margin: 0 16px; }\n.badge {\n    position: absolute;\n    top: 0;\n    right: 0;\n    background: #cc0000;\n    color: white;\n    font-size: 10px;\n    padding: 2px 5px;\n    border-radius: 10px;\n    border: 2px solid var(--yt-bg);\n}\n\n.user-avatar {\n    width: 32px;\n    height: 32px;\n    border-radius: 50%;\n    background-color: #f4511e;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: 500;\n}\n\n/* =========================================\n   MAIN LAYOUT & VIDEO PLAYER\n   ========================================= */\n.app-container { max-width: 1280px; margin: 0 auto; padding: 24px; }\n\n.player-wrapper {\n    width: 100%;\n    aspect-ratio: 16/9;\n    background: #000;\n    border-radius: 12px;\n    position: relative;\n    overflow: hidden;\n}\n\n/* Centered Ad UI */\n.ad-container {\n    position: absolute;\n    top: 0; left: 0; width: 100%; height: 100%;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n}\n\n.ad-bg {\n    position: absolute;\n    top: 0; \n    left: 0; \n    width: 100%; \n    height: 100%;\n    object-fit: cover; /* This makes the <img> act like a background! */\n    z-index: 1;\n    background-color: var(--ad-bg); /* Acts as a fallback color while the image loads */\n}\n\n.ad-content {\n    position: relative;\n    z-index: 2;\n    display: flex;\n    flex: 1;\n    padding: 20px 40px;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n}\n\n.ad-message {\n    font-size: 24px;\n    font-weight: 500;\n    line-height: 1.4;\n    color: var(--ad-text);\n    text-shadow: 1px 1px 4px rgba(0,0,0,0.6);\n}\n\n.ad-bottom {\n    position: relative;\n    z-index: 2;\n    display: flex;\n    justify-content: space-between;\n    align-items: flex-end;\n    padding: 20px;\n}\n\n.ad-info { font-size: 14px; color: white; opacity: 0.9; }\n\n.skip-btn {\n    background: rgba(0, 0, 0, 0.6);\n    color: white;\n    border: none;\n    padding: 10px 20px;\n    border-radius: 20px;\n    font-size: 16px;\n    font-weight: 500;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n}\n.skip-btn:hover { background: rgba(0, 0, 0, 0.8); }\n\n/* =========================================\n   VIDEO METADATA & ACTIONS\n   ========================================= */\n.video-meta { padding: 16px 0; }\n.video-title { font-size: 20px; font-weight: 700; margin-bottom: 12px; }\n\n.action-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 16px;\n}\n\n.channel-info { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }\n.channel-avatar { width: 40px; height: 40px; border-radius: 50%; }\n.channel-text { display: flex; flex-direction: column; }\n.channel-name { font-weight: 500; font-size: 16px; white-space: nowrap; }\n.channel-subs { font-size: 12px; color: var(--yt-text-gray); white-space: nowrap; }\n\n.subscribe-btn {\n    background: white;\n    color: black;\n    border: none;\n    padding: 10px 16px;\n    border-radius: 20px;\n    font-weight: 500;\n    font-size: 14px;\n    cursor: pointer;\n    margin-left: 12px;\n}\n\n.action-buttons { display: flex; gap: 8px; flex-wrap: wrap; }\n\n.pill-group {\n    display: flex;\n    background: var(--yt-pill-bg);\n    border-radius: 20px;\n    align-items: center;\n    flex-shrink: 0;\n}\n\n.pill-btn {\n    background: transparent;\n    color: white;\n    border: none;\n    padding: 8px 16px;\n    font-size: 14px;\n    font-weight: 500;\n    cursor: pointer;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    flex-shrink: 0;\n}\n\n.pill-btn:hover { background: var(--yt-pill-hover); }\n.pill-group .like-btn { border-radius: 20px 0 0 20px; }\n.pill-group .dislike-btn { border-radius: 0 20px 20px 0; padding: 8px 12px; }\n.divider { width: 1px; height: 24px; background: #3f3f3f; }\n.standalone { background: var(--yt-pill-bg); border-radius: 20px; }\n.standalone:hover { background: var(--yt-pill-hover); }\n\n/* Description Box */\n.description-box {\n    background: var(--yt-pill-bg);\n    padding: 12px;\n    border-radius: 12px;\n    font-size: 14px;\n    line-height: 1.5;\n}\n\n.desc-stats { margin-bottom: 4px; }\n.tags { color: var(--blue-link); }\n.description-box a { color: var(--blue-link); text-decoration: none; }\n.rating-tag { margin-top: 12px; font-weight: 500; color: var(--yt-text-gray); }\n.tv-pg { color: var(--blue-link); margin-left: 8px; }\n\n/* =========================================\n   LOGIC LAB STYLES\n   ========================================= */\n.logic-lab {\n    position: fixed;\n    bottom: 20px;\n    right: 20px;\n    background: #16181c;\n    color: #e7e9ea;\n    padding: 20px;\n    border-radius: 16px;\n    width: 320px;\n    box-shadow: 0 0 15px rgba(0, 0, 0, 0.8);\n    z-index: 1000;\n    border: 1px solid #2f3336;\n    transition: height 0.3s ease, padding 0.3s ease;\n}\n\n.logic-lab.minimized { height: 56px; overflow: hidden; padding: 16px 20px; }\n\n.logic-lab h3 {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 15px;\n    font-size: 1.1rem;\n    border-bottom: 1px solid #2f3336;\n    padding-bottom: 10px;\n}\n\n.logic-lab.minimized h3 { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }\n\n.lab-toggle-btn { background: transparent; border: none; color: inherit; cursor: pointer; font-size: 1.5rem; line-height: 1; }\n\n.logic-lab p { font-size: 14px; color: #71767b; margin-bottom: 15px; }\n\n.control-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; font-size: 15px; }\n\n.lab-btn {\n    padding: 6px 12px;\n    cursor: pointer;\n    background: #f91880;\n    color: #ffffff;\n    border: 1px solid #f91880;\n    font-weight: bold;\n    width: 80px;\n    border-radius: 9999px;\n    transition: all 0.2s;\n}\n\n.lab-btn.active { background: #00ba7c; border: 1px solid #00ba7c; }\n\n.outcome-box { margin-top: 15px; padding-top: 15px; border-top: 1px solid #2f3336; font-size: 14px; }\n\n#logicStatus { margin-top: 8px; font-weight: bold; line-height: 1.4; color: #1d9bf0;}\n\n.logic-lab.minimized p,\n.logic-lab.minimized .control-row,\n.logic-lab.minimized .outcome-box { display: none; }\n\n/* =========================================\n   MOBILE RESPONSIVENESS (Optimized for 350px)\n   ========================================= */\n@media screen and (max-width: 600px) {\n    /* Compress Nav & Hide Desktop Elements */\n    .top-nav { padding: 0 16px; }\n    .search-input-wrapper, \n    .create-btn, \n    .notification, \n    .logo-text { \n        display: none; \n    }\n    \n    /* Left side (Menu + Logo) */\n    .nav-left { gap: 16px; }\n    .logo { margin-left: 0; }\n    .logo .yt-icon { width: 30px; height: 22px; }\n    \n    /* Right side (Search + Mic... then Avatar) */\n    .nav-center {\n        gap: 12px; \n        margin-right: 24px; \n    }\n    \n    .search-box { margin-right: 0; }\n    .search-btn { background: transparent; border: none; padding: 8px; }\n    \n    /* Specific styling for the mic circle */\n    .mic-btn { \n        background: #1f1f1f; \n        width: 40px; \n        height: 40px; \n        border-radius: 50%;\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        padding: 0;\n        margin-left: 0;\n    }\n    \n    /* Match specific orange avatar */\n    .user-avatar { background-color: #e65124; }\n    \n    /* Full Bleed Player */\n    .app-container { padding: 0; }\n    .player-wrapper { border-radius: 0; }\n    \n    /* Centered Message Engine */\n    .ad-content { padding: 10px 15px; }\n    .ad-message { font-size: 14px; }\n    \n    .ad-bottom { padding: 8px 15px; }\n    .ad-info { font-size: 10px; }\n    .skip-btn { font-size: 12px; padding: 6px 12px; }\n    .skip-btn svg { width: 14px; height: 14px; }\n    \n    /* Mobile Metadata & Horizontal Scrolling Buttons */\n    .video-meta { padding: 12px; padding-bottom: 80px; }\n    .video-title { font-size: 18px; }\n    \n    .action-row { flex-direction: column; align-items: flex-start; gap: 16px; }\n    \n    .action-buttons {\n        width: 100%;\n        overflow-x: auto; \n        padding-bottom: 8px;\n        -webkit-overflow-scrolling: touch;\n        flex-wrap: nowrap; /* Ensures pills stay in a single row to swipe */\n    }\n    .action-buttons::-webkit-scrollbar { display: none; }\n    \n    /* Bottom Sheet Logic Lab */\n    .logic-lab {\n        width: 100%;\n        bottom: 0;\n        right: 0;\n        border-radius: 16px 16px 0 0;\n        border-left: none;\n        border-right: none;\n        border-bottom: none;\n        padding: 16px;\n        box-shadow: 0 -5px 15px rgba(0,0,0,0.8);\n    }\n    .logic-lab.minimized { width: 100%; border-radius: 0; }\n}\n\n/* =========================================\n   MAIN LAYOUT & VIDEO CONTENT\n   ========================================= */\n.app-container { max-width: 1280px; margin: 0 auto; }\n\n/* Centered Content UI */\n\n.content-overlay {\n    position: absolute; /* Changed to absolute to lock it over the image */\n    top: 0; left: 0; width: 100%; height: 100%;\n    z-index: 2; /* Forces it above the image */\n    display: flex;\n    padding: 20px 40px;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n\n}\n\n.video-message {\n    font-size: 24px;\n    font-weight: 500;\n    line-height: 1.4;\n    color: var(--content-text);\n    text-shadow: 1px 1px 4px rgba(0,0,0,0.8);\n    z-index: 3; /* Extra safety to keep text on top */\n}\n\n.content-bg {\n    position: absolute;\n    top: 0; \n    left: 0; \n    width: 100%; \n    height: 100%;\n    object-fit: contain; /* This zooms out to fit the whole image inside the box */\n    object-position: center; /* Keeps the image perfectly centered */\n    z-index: 1;\n    background-color: #000000; /* Ensures any empty space around the image is black */\n}",
          "folderId": "0",
          "active": false
        },
