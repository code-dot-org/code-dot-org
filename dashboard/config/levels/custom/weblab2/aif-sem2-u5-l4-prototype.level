  "properties": {
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "then.js",
          "language": "js",
          "contents": "function startQuest() {\n  let status = \"Fresh\"; // This variable changes along the way\n\n  fetch('https://api.quest.com/map')\n    .then(response => response.json())\n    .then(mapData => {\n      status = \"Tired\"; // Update status\n      displayText(\"Found map to \" + mapData.location + \". Status: \" + status);\n      \n      // We must return BOTH pieces of data to the next step\n      return fetch('https://api.quest.com/key/' + mapData.location)\n        .then(response => response.json())\n        .then(keyData => {\n          // If we didn't nest this, we'd lose access to the 'status' above!\n          status = \"Exhausted\"; \n          displayText(\"Got \" + keyData.type + \" key. Final Status: \" + status);\n          openChest(keyData.id);\n        });\n    })\n    .catch(error => {\n      displayText(\"Quest failed: \" + error);\n    });\n}",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "async.js",
          "language": "js",
          "contents": "async function startQuest() {\n  try {\n    let status = \"Fresh\";\n\n    const mapRes = await fetch('https://api.quest.com/map');\n    const mapData = await mapRes.json();\n    \n    status = \"Tired\"; // Update it naturally\n    displayText(\"Found map to \" + mapData.location + \". Status: \" + status);\n\n    const keyRes = await fetch('https://api.quest.com/key/' + mapData.location);\n    const keyData = await keyRes.json();\n\n    status = \"Exhausted\"; // Update it again\n    displayText(\"Got \" + keyData.type + \" key. Final Status: \" + status);\n    \n    openChest(keyData.id);\n\n  } catch (error) {\n    displayText(\"Quest failed: \" + error);\n  }\n}",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2"
      ]
    },
