<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-07-10T19:01:40.000Z",
  "level_num": "custom",
  "user_id": 18762,
  "properties": {
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Joke Machine 3000</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n\n  <header class=\"site-header\">\n    <div class=\"marquee-bar\" aria-hidden=\"true\">\n      <span>✦ ha ✦ heh ✦ lol ✦ haha ✦ omg ✦ rofl ✦ tee-hee ✦ ha ✦ heh ✦ lol ✦ haha ✦ omg ✦ rofl ✦ tee-hee ✦ </span>\n    </div>\n\n  </header>\n\n  <main class=\"main-content\">\n\n    <div class=\"stage\" aria-live=\"polite\" aria-atomic=\"true\">\n      <div class=\"curtain curtain-left\" aria-hidden=\"true\"></div>\n      <div class=\"curtain curtain-right\" aria-hidden=\"true\"></div>\n\n      <div class=\"joke-card\" id=\"jokeCard\">\n        <p class=\"joke-label\" aria-hidden=\"true\">SETUP</p>\n        <p class=\"joke-setup\" id=\"setup\">Your joke setup will appear here.</p>\n        <hr class=\"joke-divider\" />\n        <p class=\"joke-label\" aria-hidden=\"true\">PUNCHLINE</p>\n        <p class=\"joke-punchline\" id=\"punchline\">…and the punchline will land here.</p>\n      </div>\n    </div>\n\n    <div class=\"controls\">\n      <button id=\"btn\">\n        <span class=\"btn-icon\">🎭</span> Click here for a joke\n      </button>\n\n    </div>\n\n  </main>\n\n\n  <script src=\"script.js\"></script>\n</body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": ":root {\n  --cream:    #FDF6E3;\n  --ink:      #1A1208;\n  --crimson:  #C0392B;\n  --gold:     #E4A800;\n  --blush:    #F9E2D2;\n  --muted:    #7A6652;\n  --card-bg:  #FFFDF7;\n  --radius:   14px;\n}\n\n\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\nbody {\n  font-family: 'Georgia', 'Times New Roman', serif;\n  background: var(--cream);\n  color: var(--ink);\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n}\n\n\n.marquee-bar {\n  background: var(--crimson);\n  color: #fff;\n  font-family: system-ui, sans-serif;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  overflow: hidden;\n  white-space: nowrap;\n  padding: 6px 0;\n}\n\n.marquee-bar span {\n  display: inline-block;\n  animation: marquee 18s linear infinite;\n}\n\n@keyframes marquee {\n  from { transform: translateX(0); }\n  to   { transform: translateX(-50%); }\n}\n\n\n.site-header {\n  border-bottom: 2px solid var(--ink);\n}\n\n.header-inner {\n  padding: 40px 32px 36px;\n  max-width: 720px;\n  margin: 0 auto;\n}\n\n.eyebrow {\n  font-family: system-ui, sans-serif;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.18em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin-bottom: 12px;\n}\n\n.site-title {\n  font-size: clamp(52px, 10vw, 96px);\n  font-weight: 900;\n  line-height: 0.95;\n  letter-spacing: -0.02em;\n  text-transform: uppercase;\n  margin-bottom: 20px;\n}\n\n.site-title em {\n  font-style: italic;\n  color: var(--crimson);\n}\n\n.site-tagline {\n  font-size: 16px;\n  color: var(--muted);\n  line-height: 1.5;\n}\n\n\n.main-content {\n  flex: 1;\n  max-width: 720px;\n  margin: 0 auto;\n  width: 100%;\n  padding: 48px 32px;\n  display: flex;\n  flex-direction: column;\n  gap: 36px;\n}\n\n\n.stage {\n  position: relative;\n  overflow: hidden;\n  border-radius: var(--radius);\n  border: 2px solid var(--ink);\n  background: var(--card-bg);\n  box-shadow: 6px 6px 0 var(--ink);\n}\n\n.curtain {\n  position: absolute;\n  top: 0;\n  height: 100%;\n  width: 50%;\n  background: var(--crimson);\n  transition: transform 0.55s cubic-bezier(0.7, 0, 0.3, 1);\n  z-index: 2;\n  pointer-events: none;\n}\n\n.curtain-left  { left: 0;  transform: translateX(-100%); }\n.curtain-right { right: 0; transform: translateX(100%);  }\n\n/* When loading, curtains close */\n.stage.loading .curtain-left  { transform: translateX(0); }\n.stage.loading .curtain-right { transform: translateX(0); }\n\n\n.joke-card {\n  padding: 36px 40px;\n}\n\n.joke-label {\n  font-family: system-ui, sans-serif;\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin-bottom: 10px;\n}\n\n.joke-setup {\n  font-size: 22px;\n  line-height: 1.45;\n  font-weight: 400;\n  margin-bottom: 24px;\n  min-height: 2.9em;\n  color: var(--ink);\n}\n\n.joke-divider {\n  border: none;\n  border-top: 1px dashed #C5B8A8;\n  margin-bottom: 24px;\n}\n\n.joke-punchline {\n  font-size: 26px;\n  line-height: 1.3;\n  font-weight: 700;\n  font-style: italic;\n  color: var(--crimson);\n  min-height: 2.6em;\n}\n\n/* ────────────────────────────────────────\n   CONTROLS\n──────────────────────────────────────── */\n.controls {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n  flex-wrap: wrap;\n}\n\nbutton {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 14px 28px;\n  font-family: system-ui, sans-serif;\n  font-size: 16px;\n  font-weight: 700;\n  letter-spacing: 0.04em;\n  background: var(--gold);\n  color: var(--ink);\n  border: 2px solid var(--ink);\n  border-radius: 100px;\n  cursor: pointer;\n  box-shadow: 4px 4px 0 var(--ink);\n  transition: transform 0.1s, box-shadow 0.1s;\n}\n\nbutton:hover {\n  transform: translate(-2px, -2px);\n  box-shadow: 6px 6px 0 var(--ink);\n}\n\nbutton:active {\n  transform: translate(1px, 1px);\n  box-shadow: 2px 2px 0 var(--ink);\n}\n\nbutton:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n  transform: none;\n  box-shadow: 4px 4px 0 var(--ink);\n}\n\n.btn-icon {\n  font-size: 20px;\n}\n\n.fetch-status {\n  font-family: system-ui, sans-serif;\n  font-size: 13px;\n  font-weight: 600;\n  color: var(--muted);\n  letter-spacing: 0.04em;\n}\n\n\n.site-footer {\n  border-top: 2px solid var(--ink);\n  background: var(--gold);\n  text-align: center;\n  padding: 10px;\n  font-family: system-ui, sans-serif;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--ink);\n}\n\n\n@media (prefers-reduced-motion: reduce) {\n  .marquee-bar span { animation: none; }\n  .curtain { transition: none; }\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const btn = document.getElementById(\"btn\");\nconst setup = document.getElementById(\"setup\");\nconst punchline = document.getElementById(\"punchline\");\n\nbtn.addEventListener(\"click\", () => {\n\n\n  fetch(\"https://official-joke-api.appspot.com/random_joke\")\n    .then(response => response.json())\n    .then(data => {\n      setup.textContent = data.setup;\n      punchline.textContent = data.punchline;\n    });\n});",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "3"
      ]
    },
    "encrypted": "false",
    "long_instructions": "\r\n### **Refactor the Code**\r\n\r\nThe `.then()` promise chain in `script.js` works, but there's a cleaner way to write it. \r\n\r\nUse AI Tutor to rewrite the fetch logic using `async` and `await`.\r\n\r\n:::details [Hint]\r\nLook at the current code and notice the flow. \r\nAsk the AI tutor to rewite the logic using async and await. \r\n\r\nThe app will function the same, but the new code is clearer. \r\n:::\r\n\r\n\r\n",
