      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    \n    <!-- parent container with 3 child paragraph tags -->\n    <div class=\"basis-auto\">\n      <p>child</p>\n      <p>child</p>\n      <p>child</p>\n    </div>\n    \n    <!-- parent container with 3 child paragraph tags -->\n    <div class=\"basis-fixed\">\n      <p>child</p>\n      <p>child</p>\n      <p>child</p>\n    </div>\n\n\n    \n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* 1) Add the flex-basis property to the first container and set value to auto */ \n.basis-auto > p {\nflex-basis: auto;\n}\n\n\n/* 2) Add the flex-basis property to the second container and set value to 150px */\n.basis-fixed > p {\n  flex-basis: 150px;\n}\n\n\n/* styled parent containers */\n.basis-auto, .basis-fixed {\n  background: #b691d6;\n  display: flex;\n  padding: 5px;\n  margin: 10px;\n}\n\n/* styled paragraphs */\np {\n  background-color: aliceblue;\n  margin: 5px;\n  padding: 5px;\n  text-align: center;\n  font-size: 20px;\n  border-style: solid;\n  font-family: sans-serif; \n\n}",
          "folderId": "0",
          "active": true
        }
