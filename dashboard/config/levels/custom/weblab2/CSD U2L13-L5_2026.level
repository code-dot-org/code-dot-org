      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    \n    <!-- parent container with 6 child div tags -->\n    <!-- 1) Give the second child item inside the \"flex-align\" parent a class attribute of \"align\" -->\n    <div class=\"flex-align\">\n      <div>1</div>\n      <div>2</div>\n      <div>3</div>\n      <div>4</div>\n      <div>5</div>\n      <div>6</div>\n    </div>\n    \n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* 1) Add a rule in the CSS file for the second child item using its class attribute as the selector. */\n\n/* 2) Give the item the align-self property. */\n\n/* 3) Try out the different values */\n\n.flex-align {\n  /* We gave the parent div container a background color so you can see how the items are positioned within it */\n  background: #b691d6;\n  display: flex;\n  padding: 5px;\n  height: 500px;\n  align-items: flex-start;\n}\n\n/* styled child divs in parent continer */\n.flex-align > div {\n  background-color: aliceblue;\n  margin: 5px;\n  width: 100px;\n  text-align: center;\n  line-height: 80px;\n  font-size: 20px;\n  border-style: solid;\n  font-family: sans-serif;\n}\n\n/* ADD CODE BELOW to self-align the second item */",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2"
      ]
    },
