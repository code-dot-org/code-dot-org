    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Student Activity Board</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Mono:wght@400;700&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n  <main class=\"board\">\n    <header>\n      <h1>📢 NOTICE BOARD</h1>\n      <div class=\"subtitle\">TOP 3 FEATURED ACTIVITIES</div>\n    </header>\n\n    <div id=\"feed\">\n      <div class=\"card featured-spot\" id=\"slot1\">\n        <div class=\"sticker\">TOP PICK</div>\n        <div class=\"card-content\">\n          <h2 id=\"slot1-name\">Loading...</h2>\n          <div class=\"tag\" id=\"slot1-category\">...</div>\n        </div>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"rank\">#2</div>\n        <div class=\"card-content\">\n          <h2 id=\"slot2-name\">Loading...</h2>\n          <div class=\"tag\" id=\"slot2-category\">...</div>\n        </div>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"rank\">#3</div>\n        <div class=\"card-content\">\n          <h2 id=\"slot3-name\">Loading...</h2>\n          <div class=\"tag\" id=\"slot3-category\">...</div>\n        </div>\n      </div>\n    </div>\n  </main>\n\n  <script src=\"script.js\" defer></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// DATA: A List of Objects\nlet activities = [\n  { name: \"Football\", category: \"Sports\", members: 62},\n  { name: \"Basketball\", category: \"Sports\", members: 12},\n  { name: \"Track Team\", category: \"Sports\", members: 120},\n  { name: \"Robotics Club\", category: \"STEM\", members: 24},\n  { name: \"Jazz Band\", category: \"Arts\", members: 78}\n];\n\n// ------------------------------------------------------------------\n\n\n\n// ------------------------------------------------------------------\n// VIEW LOGIC\n// ------------------------------------------------------------------\n\nconst renderFeatured = () => {\n  document.getElementById(\"slot1-name\").textContent = activities[0].name;\n  document.getElementById(\"slot1-category\").textContent = activities[0].category;\n\n  document.getElementById(\"slot2-name\").textContent = activities[1].name;\n  document.getElementById(\"slot2-category\").textContent = activities[1].category;\n\n  document.getElementById(\"slot3-name\").textContent = activities[2].name;\n  document.getElementById(\"slot3-category\").textContent = activities[2].category;\n};\n\nrenderFeatured();",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": ":root {\n  --bg-color: #ffd700; /* School Bus Yellow */\n  --card-bg: #ffffff;\n  --text-color: #000000;\n  --accent-1: #ff6b6b; /* Red */\n  --accent-2: #4ecdc4; /* Teal */\n  --border-thick: 3px solid #000;\n  --shadow-hard: 6px 6px 0px #000;\n}\n\nbody {\n  background-color: var(--bg-color);\n  background-image: radial-gradient(#000 10%, transparent 11%);\n  background-size: 20px 20px; /* Dot pattern */\n  font-family: 'Space Mono', monospace;\n  color: var(--text-color);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  min-height: 100vh;\n  margin: 0;\n}\n\n.board {\n  background: #fff;\n  border: var(--border-thick);\n  box-shadow: var(--shadow-hard);\n  padding: 30px;\n  width: 100%;\n  max-width: 500px;\n}\n\nheader {\n  text-align: center;\n  margin-bottom: 25px;\n  border-bottom: var(--border-thick);\n  padding-bottom: 20px;\n}\n\nh1 {\n  font-family: 'Archivo Black', sans-serif;\n  font-size: 2.5rem;\n  margin: 0;\n  text-transform: uppercase;\n  line-height: 1;\n}\n\n.subtitle {\n  background: #000;\n  color: #fff;\n  display: inline-block;\n  padding: 5px 10px;\n  font-weight: bold;\n  transform: rotate(-2deg);\n  margin-top: 10px;\n}\n\n#feed {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n\n.card {\n  background: var(--card-bg);\n  border: var(--border-thick);\n  padding: 15px;\n  display: flex;\n  align-items: center;\n  gap: 15px;\n  transition: transform 0.2s;\n}\n\n.card:hover {\n  transform: translate(-2px, -2px);\n  box-shadow: 4px 4px 0 rgba(0,0,0,0.2);\n}\n\n/* Special styling for the top spot */\n.featured-spot {\n  background-color: var(--accent-2);\n  transform: scale(1.05);\n  box-shadow: var(--shadow-hard);\n  position: relative;\n}\n\n.featured-spot:hover {\n  transform: scale(1.05) translate(-2px, -2px);\n}\n\n.sticker {\n  position: absolute;\n  top: -10px;\n  right: -10px;\n  background: var(--accent-1);\n  color: white;\n  padding: 5px 10px;\n  font-weight: bold;\n  font-size: 0.8rem;\n  border: var(--border-thick);\n  transform: rotate(5deg);\n}\n\n.rank {\n  font-size: 1.5rem;\n  font-weight: bold;\n  font-family: 'Archivo Black', sans-serif;\n  opacity: 0.3;\n}\n\n.card-content {\n  flex-grow: 1;\n}\n\nh2 {\n  font-size: 1.1rem;\n  margin: 0 0 5px 0;\n}\n\n.tag {\n  display: inline-block;\n  font-size: 0.75rem;\n  border: 1px solid #000;\n  padding: 2px 8px;\n  background: #fff;\n  text-transform: uppercase;\n  font-weight: bold;\n}",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    },
