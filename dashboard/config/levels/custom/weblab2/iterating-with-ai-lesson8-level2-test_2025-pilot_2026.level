    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Space Supply Co.</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <link href=\"https://fonts.googleapis.com/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap\" rel=\"stylesheet\">\n</head>\n<body>\n\n  <header>\n    <h1>SPACE SUPPLY CO.</h1>\n    <p>Mission Provisions</p>\n  </header>\n\n  <main>\n    <div class=\"controls\">\n      <div class=\"filter-group\">\n        <label for=\"categorySelect\">Filter by Category:</label>\n        <select id=\"categorySelect\">\n          <option value=\"\" disabled selected>Select Category...</option>\n          <option value=\"Gear\">Gear</option>\n          <option value=\"Food\">Food</option>\n          <option value=\"Tech\">Tech</option>\n        </select>\n      </div>\n      \n      <button id=\"resetBtn\">↺ Reset Mission</button>\n    </div>\n\n    <div id=\"productContainer\" class=\"product-grid\">\n      </div>\n  </main>\n\n    <script src=\"data.js\" defer></script>\n  <script src=\"helpers.js\" defer></script>\n  <script src=\"script.js\" defer></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* style.css */\n:root {\n  --bg-color: #0b0d17;\n  --card-bg: #1c1f33;\n  --accent: #00f0ff;\n  --text: #d0d6e0;\n  --font-main: 'Space Mono', monospace;\n}\n\nbody {\n  background-color: var(--bg-color);\n  color: var(--text);\n  font-family: var(--font-main);\n  margin: 0;\n  padding: 20px;\n}\n\nheader {\n  text-align: center;\n  margin-bottom: 40px;\n  border-bottom: 2px solid var(--accent);\n  padding-bottom: 20px;\n}\n\nh1 {\n  color: var(--accent);\n  margin: 0;\n  font-size: 2.5rem;\n  text-transform: uppercase;\n  letter-spacing: -2px;\n}\n\n.controls {\n  display: flex;\n  justify-content: center;\n  gap: 20px;\n  margin-bottom: 30px;\n  align-items: center;\n}\n\nselect, button {\n  font-family: var(--font-main);\n  padding: 10px 15px;\n  border: 2px solid var(--accent);\n  background: transparent;\n  color: var(--accent);\n  font-size: 1rem;\n  cursor: pointer;\n  border-radius: 4px;\n}\n\nbutton:hover {\n  background: var(--accent);\n  color: var(--bg-color);\n}\n\n.product-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));\n  gap: 20px;\n  max-width: 1000px;\n  margin: 0 auto;\n}\n\n.card {\n  background-color: var(--card-bg);\n  padding: 20px;\n  border: 1px solid #333;\n  border-radius: 8px;\n  text-align: center;\n}\n\n.card h3 {\n  color: #fff;\n  margin-top: 0;\n}\n\n.tag {\n  display: inline-block;\n  background-color: rgba(0, 240, 255, 0.1);\n  color: var(--accent);\n  padding: 4px 8px;\n  font-size: 0.8rem;\n  border-radius: 4px;\n  margin-top: 10px;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "// DOM Elements\nconst container = document.querySelector(\"#productContainer\");\nconst categorySelect = document.querySelector(\"#categorySelect\");\nconst resetBtn = document.querySelector(\"#resetBtn\");\n\nlet currentProducts = [];\n\nfor (let i = 0; i < originalProducts.length; i++) {\n  currentProducts.push(originalProducts[i]);\n}\n\n// Loops through currentProducts and renders elements to the screen\nconst renderProducts = () => {\n  container.innerHTML = \"\";\n  for (let i = 0; i < currentProducts.length; i++) {\n    container.appendChild(createCard(currentProducts[i]));\n  }\n};\n\n// Event listener for category dropdown\ncategorySelect.addEventListener(\"change\", () => {\n  const selectedCategory = categorySelect.value;\n\n  currentProducts = originalProducts.filter((item) => {\n    return item.category === selectedCategory;\n  });\n\n  renderProducts();\n});\n\n// Event listener for the reset button\nresetBtn.addEventListener(\"click\", () => {\n\n  renderProducts();\n});\n\nrenderProducts();\n",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
          "name": "data.js",
          "contents": "const originalProducts = [\n  { name: \"Gravity Boots\", category: \"Gear\", price: 150 },\n  { name: \"Dehydrated Ice Cream\", category: \"Food\", price: 5 },\n  { name: \"Quantum Radio\", category: \"Tech\", price: 300 },\n  { name: \"Oxygen Tank\", category: \"Gear\", price: 80 },\n  { name: \"Mars Rations\", category: \"Food\", price: 12 },\n  { name: \"Holo-Map\", category: \"Tech\", price: 500 }\n];\n",
          "folderId": "0",
          "active": false,
          "type": "starter"
        },
        "5": {
          "id": "5",
          "name": "helpers.js",
          "contents": "const createCard = (item) => {\n  const card = document.createElement(\"div\");\n  card.classList.add(\"card\");\n  card.innerHTML = `\n    <h3>${item.name}</h3>\n    <p>Price: ${item.price} Credits</p>\n    <span class=\"tag\">${item.category}</span>\n  `;\n  return card;\n};\n",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "3"
      ]
    },
