  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-03-20T23:44:47.000Z",
  "level_num": "custom",
  "user_id": 18603,
  "properties": {
    "encrypted": "false",
    "long_instructions": "## Movie Spoiler Checker\r\n\r\n\r\n**Background:**\r\nYou built a simple app that checks whether or not to show the user a post about a movie.\r\n\r\nThe app shows two decisions:\r\n\r\n1. Have you finished the movie?\r\n2. Does the post have spoiler tags?\r\n\r\n---\r\n\r\n**Do This:**\r\n\r\n1. **Test Each Path**: Click through the different combinations of \"Yes\" and \"No\" in the app.\r\n\r\n2. **Fill in the Logic Table**: In your [Nested Conditionals Activity Guide](https://docs.google.com/document/d/1MBVchKlQvfBe9Ob3wpiyhog1sjZHmup_wcrIqH7HtEQ/edit?usp=sharing), describe the outcome of each combination of \"Yes\" or \"No\" and check that the code works as expected.\r\n\r\n3. **Read the Code**: Use **AI Chat** to help you understand the nested `if/else` statements.",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "code",
    "ai_tutor_mode": "tutor",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "placeholderText": "",
      "multipleChoiceOptions": [
        ""
      ],
      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false,
      "allowMultipleAttempts": false
    },
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>Movie Spoiler Checker</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <div class=\"container\">\n      <div class=\"image-section\">\n        <img id=\"img-finished-spoiler\"     class=\"hide\" src=\"finished-spoiler.png\"     alt=\"Finished + Spoilers\">\n        <img id=\"img-finished-nospoiler\"   class=\"hide\" src=\"finished-nospoiler.png\"   alt=\"Finished + No Spoilers\">\n        <img id=\"img-unfinished-spoiler\"   class=\"hide\" src=\"unfinished-spoiler.png\"   alt=\"Unfinished + Spoilers\">\n        <img id=\"img-unfinished-nospoiler\" class=\"hide\" src=\"unfinished-nospoiler.png\" alt=\"Unfinished + No Spoilers\">\n      </div>\n\n      <div class=\"questions-section\">\n        <div class=\"question-group\">\n          <p class=\"question-text\">Have you finished the movie?</p>\n          <div class=\"button-group\">\n            <button id=\"movie-no\">No</button>\n            <button id=\"movie-yes\">Yes</button>\n          </div>\n        </div>\n\n        <div class=\"question-group\">\n          <p class=\"question-text\">Does the post contain spoiler tags?</p>\n          <div class=\"button-group\">\n            <button id=\"spoiler-no\">No</button>\n            <button id=\"spoiler-yes\">Yes</button>\n          </div>\n        </div>\n      </div>\n    </div>\n    <script src=\"script.js\"></script>\n  </body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// The variables start as 'null' so no button is selected by default.\nlet finishedMovie = null;\nlet hasSpoilerTags = null;\n\n// Reference the HTML elements we want to control.\nconst movieYesBtn    = document.getElementById(\"movie-yes\");\nconst movieNoBtn     = document.getElementById(\"movie-no\");\nconst spoilerYesBtn  = document.getElementById(\"spoiler-yes\");\nconst spoilerNoBtn   = document.getElementById(\"spoiler-no\");\n\nconst imgFinishedSpoiler = document.getElementById(\"img-finished-spoiler\");\nconst imgFinishedNoSpoiler = document.getElementById(\"img-finished-nospoiler\");\nconst imgUnfinishedSpoiler = document.getElementById(\"img-unfinished-spoiler\");\nconst imgUnfinishedNoSpoiler = document.getElementById(\"img-unfinished-nospoiler\");\n\n// This function runs every time a button is clicked. \n// It checks the state and updates the screen so it matches.\nconst updateDisplay = (finished, spoiler) => {\n  \n  // Update state variables \"finished\" and \"spoiler\" only if a new value was passed in\n  if (finished !== undefined) finishedMovie = finished;\n  if (spoiler !== undefined) hasSpoilerTags = spoiler;\n  \n  // RESET: Remove fill from all buttons and hide all images\n  movieYesBtn.classList.remove(\"btn-primary\");\n  movieNoBtn.classList.remove(\"btn-primary\");\n  spoilerYesBtn.classList.remove(\"btn-primary\");\n  spoilerNoBtn.classList.remove(\"btn-primary\");\n\n  imgFinishedSpoiler.classList.replace(\"show\", \"hide\");\n  imgFinishedNoSpoiler.classList.replace(\"show\", \"hide\");\n  imgUnfinishedSpoiler.classList.replace(\"show\", \"hide\");\n  imgUnfinishedNoSpoiler.classList.replace(\"show\", \"hide\");\n\n  // We use nested \"if/else\" (like a decision tree) to see which buttons and image to turn on.\n  if (finishedMovie === true) {\n   \n    // If the movie is finished, highlight the \"Yes\" button\n    movieYesBtn.classList.add(\"btn-primary\");\n\n    if (hasSpoilerTags === true) {\n      // If the post contains spoilers, highlight the \"Yes\" button\n      spoilerYesBtn.classList.add(\"btn-primary\");\n      imgFinishedSpoiler.classList.replace(\"hide\", \"show\");\n    \n    } else if (hasSpoilerTags === false) {\n     \n      // Otherwise, highlight \"No\"\n      spoilerNoBtn.classList.add(\"btn-primary\");\n      imgFinishedNoSpoiler.classList.replace(\"hide\", \"show\");\n    }\n\n  } else if (finishedMovie === false) {\n   \n    // If the movie is NOT finished, highlight the \"No\" button\n    movieNoBtn.classList.add(\"btn-primary\");\n    \n    // If the post contains spoilers, highlight the \"Yes\" button\n    \n    if (hasSpoilerTags === true) {\n      spoilerYesBtn.classList.add(\"btn-primary\");\n      imgUnfinishedSpoiler.classList.replace(\"hide\", \"show\");\n    \n      // Otherwise, highlight \"No\"\n    } else if (hasSpoilerTags === false) {\n      spoilerNoBtn.classList.add(\"btn-primary\");\n      imgUnfinishedNoSpoiler.classList.replace(\"hide\", \"show\");\n    }\n  }\n};\n\n// Event handlers\nmovieYesBtn.addEventListener(\"click\", () => updateDisplay(true, undefined));\nmovieNoBtn.addEventListener(\"click\", () => updateDisplay(false, undefined));\nspoilerYesBtn.addEventListener(\"click\", () => updateDisplay(undefined, true));\nspoilerNoBtn.addEventListener(\"click\", () => updateDisplay(undefined, false));\n\n// Call the function once manually when the page first loads\nupdateDisplay();",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  margin: 0;\n  padding: 20px;\n  font-family: Arial, sans-serif;\n  background-color: #f5f5f5;\n}\n\n.image-section {\n  width: 100%;\n  background-color: #e8e8e8;\n  border: 1px solid #ccc;\n  min-height: 300px;\n}\n\n\nbutton {\n  background-color: white;\n  border: 2px solid #333;\n  border-radius: 8px;\n  padding: 8px 20px;\n  margin-right: 10px;\n  cursor: pointer;\n  font-size: 14px;\n}\n\n.btn-primary {\n  background-color: #90ee90;\n}\n\n\n/* ----- Visibility Control ----- */\n\n.hide {\n  display: none;\n}\n\n.show {\n  display: block;\n  opacity: 1;\n}",
          "folderId": "0",
          "active": false
        },
