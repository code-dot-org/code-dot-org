<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2025-11-14T15:38:40.000Z",
  "level_num": "custom",
  "user_id": 22366,
  "properties": {
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>CineMix — Tonight’s Picks</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <header class=\"topbar\">\n    <div class=\"brand\">🍿 CineMix</div>\n    <div class=\"subtitle\">Tonight’s Picks</div>\n    <button id=\"prefBtn\" class=\"btn ghost\">Preferences</button>\n  </header>\n\n  <section id=\"prefs\" class=\"prefs hidden\">\n    <div class=\"prefs-inner\">\n      <h2>Preferences</h2>\n      <div class=\"grid2\">\n        <div class=\"control\">\n          <label>Minimum rating</label>\n          <input id=\"minRating\" type=\"range\" min=\"1\" max=\"5\" step=\"0.5\" value=\"4\" />\n          <div class=\"hint\"><span id=\"minRatingVal\">4</span> / 5</div>\n        </div>\n        <div class=\"control\">\n          <label>Max price to rent ($)</label>\n          <input id=\"maxPrice\" type=\"range\" min=\"10\" max=\"120\" step=\"10\" value=\"60\" />\n          <div class=\"hint\">$<span id=\"maxPriceVal\">60</span></div>\n        </div>\n      </div>\n\n      <div class=\"grid2\">\n        <div class=\"control\">\n          <label>Transparency label</label>\n          <input id=\"labelText\" type=\"text\" value=\"Mix of affordable and highly-rated picks\" />\n          <div class=\"hint\">Shown to users under the results.</div>\n        </div>\n        <div class=\"control switcher\">\n          <label>Use clean data (fixes names/types)</label>\n          <label class=\"switch\">\n            <input id=\"useClean\" type=\"checkbox\" />\n            <span class=\"slider\"></span>\n          </label>\n          <div class=\"hint\">Off = messy real-world feed; On = same items with a good schema.</div>\n        </div>\n      </div>\n\n      <div class=\"controls\">\n        <button id=\"applyBtn\" class=\"btn\">Apply</button>\n        <button id=\"resetBtn\" class=\"btn secondary\">Reset</button>\n      </div>\n    </div>\n  </section>\n\n  <main class=\"wrap\">\n    <section class=\"meta\">\n      <div class=\"kvs\">\n        <span>Included</span><strong id=\"includedCount\">0</strong>\n      </div>\n      <div class=\"kvs\">\n        <span>Flagged</span><strong id=\"flaggedCount\">0</strong>\n      </div>\n      <div class=\"kvs\">\n        <span>Warnings</span><strong id=\"warningCount\">0</strong>\n      </div>\n    </section>\n\n    <section id=\"cards\" class=\"gridCards\"></section>\n\n    <section class=\"footerNote\">\n      <div class=\"pill\" id=\"transparency\">Filters: rating ≥ 4, price ≤ $60. Label: Mix of affordable and highly-rated picks</div>\n      <p class=\"muted small\">CineMix surfaces a blend of budget-friendly and well-reviewed titles. Sponsored items may appear as “featured”.</p>\n    </section>\n  </main>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>\n\n",
          "active": true,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "js",
          "contents": ":root{\n  --bg:#f7f8fc; --ink:#1f2937; --muted:#6b7280; --accent:#2563eb;\n  --card:#fff; --border:#e5e7eb; --good:#16a34a; --warn:#b91c1c; --chip:#0ea5e9;\n}\n*{box-sizing:border-box}\nbody{margin:0; font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif; color:var(--ink); background:var(--bg)}\n.small{font-size:.9rem}\n.muted{color:var(--muted)}\n\n.topbar{\n  display:flex; align-items:center; justify-content:space-between;\n  padding:12px 16px; background:#ffffff; border-bottom:1px solid var(--border);\n  position:sticky; top:0; z-index:10;\n}\n.brand{font-weight:800; font-size:1.1rem}\n.subtitle{color:var(--muted)}\n\n.btn{\n  padding:9px 12px; border-radius:10px; border:1px solid var(--accent);\n  background:var(--accent); color:#fff; cursor:pointer; font-weight:600;\n}\n.btn.secondary{background:#fff; color:var(--accent); border-color:var(--border)}\n.btn.ghost{background:#fff; color:var(--ink); border-color:var(--border)}\n\n.prefs{background:#fff; border-bottom:1px solid var(--border)}\n.hidden{display:none}\n.prefs-inner{max-width:1100px; margin:0 auto; padding:16px}\n.grid2{display:grid; gap:12px}\n@media(min-width:900px){ .grid2{grid-template-columns:1fr 1fr} }\n.control label{display:block; font-weight:600; margin-bottom:6px}\n.hint{font-size:.85rem; color:var(--muted)}\n.controls{display:flex; gap:8px; margin-top:10px}\n\n.switcher{display:flex; align-items:center; gap:10px}\n.switch{position:relative; display:inline-block; width:46px; height:24px}\n.switch input{display:none}\n.slider{position:absolute; cursor:pointer; inset:0; background:#e5e7eb; border-radius:24px; transition:.2s}\n.slider:before{content:\"\"; position:absolute; height:18px; width:18px; left:3px; top:3px; background:#fff; border-radius:50%; transition:.2s}\n.switch input:checked + .slider{background:var(--accent)}\n.switch input:checked + .slider:before{transform:translateX(22px)}\n\n.wrap{max-width:1100px; margin:18px auto; padding:0 16px; display:grid; gap:16px}\n.meta{display:flex; gap:12px; flex-wrap:wrap}\n.kvs{background:#fff; border:1px solid var(--border); border-radius:10px; padding:8px 10px; min-width:140px; display:flex; justify-content:space-between}\n.gridCards{display:grid; gap:14px}\n@media(min-width:720px){ .gridCards{grid-template-columns:1fr 1fr} }\n@media(min-width:1040px){ .gridCards{grid-template-columns:1fr 1fr 1fr} }\n\n.card{\n  background:#fff; border:1px solid var(--border); border-radius:12px; padding:12px;\n  box-shadow:0 6px 24px rgba(0,0,0,.06); display:grid; gap:10px;\n}\n.poster{\n  width:100%; height:148px; border-radius:10px; background:\n    linear-gradient(120deg, #e2e8f0, #cbd5e1);\n}\n.row{display:flex; align-items:center; justify-content:space-between; gap:10px}\n.title{font-weight:800}\n.badge{display:inline-block; padding:2px 8px; border-radius:999px; border:1px solid var(--border); font-size:.8rem; color:var(--muted)}\n.badge.good{color:#065f46; border-color:#a7f3d0; background:#ecfdf5}\n.badge.warn{color:#7f1d1d; border-color:#fecaca; background:#fef2f2}\n.badge.info{color:#0c4a6e; border-color:#bae6fd; background:#ecfeff}\n\n.footerNote{display:grid; gap:8px; margin:6px 0 24px}\n.pill{display:inline-block; padding:6px 10px; border:1px solid var(--border); border-radius:999px; background:#fff}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "// ====== Utilities ======\nconst $ = (id) => document.getElementById(id);\nconst copyObj = (o) => JSON.parse(JSON.stringify(o));\n\n// ====== Data (Broken vs Clean) ======\nconst BROKEN = [\n  { itemName: \"EcoBottle\", rating: \"5\", price: \"Low\", bestSeller: \"Yes\" },\n  { name: \"SmartLamp\", stars: 4, price: 70, bestSeller: true },\n  { product: \"NotebookPro\", stars: \"three\", price: \"High\", bestSeller: false },\n  { item: \"TinySpeaker\", stars: 4.5, cost: \"medium\", top: \"yes\" }\n];\n\nconst CLEAN = [\n  { title: \"EcoBottle\", rating: 5, price: 20, isBestSeller: true },\n  { title: \"SmartLamp\", rating: 4, price: 70, isBestSeller: true },\n  { title: \"NotebookPro\", rating: 3, price: 120, isBestSeller: false },\n  { title: \"TinySpeaker\", rating: 4.5, price: 50, isBestSeller: true }\n];\n\n// ====== State ======\nlet useClean = false;\nlet minRating = 4;\nlet maxPrice = 60;\nlet labelText = \"Mix of affordable and highly-rated picks\";\n\n// ====== Elements ======\nconst prefBtn = $(\"prefBtn\");\nconst prefs = $(\"prefs\");\nconst minRatingEl = $(\"minRating\");\nconst minRatingVal = $(\"minRatingVal\");\nconst maxPriceEl = $(\"maxPrice\");\nconst maxPriceVal = $(\"maxPriceVal\");\nconst labelTextEl = $(\"labelText\");\nconst useCleanEl = $(\"useClean\");\n\nconst applyBtn = $(\"applyBtn\");\nconst resetBtn = $(\"resetBtn\");\n\nconst cards = $(\"cards\");\nconst includedCount = $(\"includedCount\");\nconst flaggedCount = $(\"flaggedCount\");\nconst warningCount = $(\"warningCount\");\nconst transparency = $(\"transparency\");\n\n// ====== Helpers ======\nconst normalizeNumber = (v) => {\n  if (typeof v === \"number\") return v;\n  if (typeof v === \"string\") {\n    const s = v.toLowerCase();\n    if (s === \"low\") return 20;\n    if (s === \"medium\") return 60;\n    if (s === \"high\") return 120;\n    const n = Number(v);\n    if (!isNaN(n)) return n;\n  }\n  return NaN;\n};\n\nconst normalizeBoolean = (v) => {\n  if (typeof v === \"boolean\") return v;\n  if (typeof v === \"string\") {\n    const s = v.toLowerCase();\n    if (s === \"yes\" || s === \"true\") return true;\n    if (s === \"no\" || s === \"false\") return false;\n  }\n  return false;\n};\n\n// Map any record to a common shape (title, rating, price, isBestSeller) + warnings\nconst mapRecord = (raw, cleanMode) => {\n  if (cleanMode) {\n    const title = raw.title ? String(raw.title) : \"\";\n    const rating = typeof raw.rating === \"number\" ? raw.rating : NaN;\n    const price = typeof raw.price === \"number\" ? raw.price : NaN;\n    const isBestSeller = !!raw.isBestSeller;\n\n    const warnTitle = title === \"\";\n    const warnRating = isNaN(rating);\n    const warnPrice = isNaN(price);\n\n    const warnings = warnTitle || warnRating || warnPrice;\n    return { title, rating, price, isBestSeller, warnings };\n  }\n\n  // broken mapping guesses field names/types\n  let title = \"\";\n  if (raw.itemName) title = String(raw.itemName);\n  else if (raw.name) title = String(raw.name);\n  else if (raw.product) title = String(raw.product);\n  else if (raw.item) title = String(raw.item);\n\n  let rating = NaN;\n  if (raw.stars !== undefined) rating = normalizeNumber(raw.stars);\n  else if (raw.rating !== undefined) rating = normalizeNumber(raw.rating);\n\n  let price = NaN;\n  if (raw.price !== undefined) price = normalizeNumber(raw.price);\n  else if (raw.cost !== undefined) price = normalizeNumber(raw.cost);\n\n  let isBestSeller = false;\n  if (raw.bestSeller !== undefined) isBestSeller = normalizeBoolean(raw.bestSeller);\n  if (raw.top !== undefined) {\n    const t = normalizeBoolean(raw.top);\n    if (t === true) isBestSeller = true;\n  }\n\n  const warnTitle = title === \"\";\n  const warnRating = isNaN(rating);\n  const warnPrice = isNaN(price);\n  const warnings = warnTitle || warnRating || warnPrice;\n\n  return { title, rating, price, isBestSeller, warnings };\n};\n\nconst recommend = (rows, ratingMin, priceMax) => {\n  const out = [];\n  for (let i = 0; i < rows.length; i++) {\n    const r = rows[i];\n    let status = \"flagged\";\n    let message = \"Niche or unclear — needs better data.\";\n\n    const ratingOk = !isNaN(r.rating) && r.rating >= ratingMin;\n    const priceOk = !isNaN(r.price) && r.price <= priceMax;\n    const bestOk = r.isBestSeller === true;\n\n    if ((ratingOk && priceOk) || bestOk) {\n      status = \"included\";\n      message = \"Recommended: meets your rules\";\n      if (bestOk === true) {\n        message = \"Recommended: featured best-seller\";\n      }\n    }\n\n    out.push({ ...r, status, message });\n  }\n  return out;\n};\n\nconst render = () => {\n  const raw = useClean ? CLEAN : BROKEN;\n  const mapped = [];\n  for (let i = 0; i < raw.length; i++) {\n    const rec = mapRecord(raw[i], useClean);\n    mapped.push(rec);\n  }\n  const recs = recommend(mapped, minRating, maxPrice);\n\n  // counts\n  let inc = 0, flag = 0, warn = 0;\n  for (let i = 0; i < recs.length; i++) {\n    if (recs[i].status === \"included\") inc = inc + 1;\n    else flag = flag + 1;\n    if (recs[i].warnings === true) warn = warn + 1;\n  }\n  includedCount.textContent = String(inc);\n  flaggedCount.textContent = String(flag);\n  warningCount.textContent = String(warn);\n\n  // cards\n  cards.innerHTML = \"\";\n  for (let i = 0; i < recs.length; i++) {\n    const r = recs[i];\n    const card = document.createElement(\"article\");\n    card.className = \"card\";\n\n    const poster = document.createElement(\"div\");\n    poster.className = \"poster\";\n\n    const top = document.createElement(\"div\");\n    top.className = \"row\";\n    const title = document.createElement(\"div\");\n    title.className = \"title\";\n    title.textContent = r.title === \"\" ? \"(missing title)\" : r.title;\n    const chips = document.createElement(\"div\");\n\n    const chipRating = document.createElement(\"span\");\n    chipRating.className = \"badge\";\n    if (!isNaN(r.rating)) chipRating.textContent = \"rating: \" + r.rating + \" / 5\";\n    else chipRating.textContent = \"rating: unknown\";\n\n    const chipPrice = document.createElement(\"span\");\n    chipPrice.className = \"badge\";\n    if (!isNaN(r.price)) chipPrice.textContent = \"price: $\" + r.price;\n    else chipPrice.textContent = \"price: unknown\";\n\n    chips.appendChild(chipRating);\n    chips.appendChild(chipPrice);\n\n    if (r.isBestSeller === true) {\n      const chipBest = document.createElement(\"span\");\n      chipBest.className = \"badge info\";\n      chipBest.textContent = \"featured\";\n      chips.appendChild(chipBest);\n    }\n    if (r.warnings === true) {\n      const chipWarn = document.createElement(\"span\");\n      chipWarn.className = \"badge warn\";\n      chipWarn.textContent = \"data warning\";\n      chips.appendChild(chipWarn);\n    }\n\n    const msg = document.createElement(\"div\");\n    msg.textContent = r.message;\n    if (r.status === \"included\") msg.className = \"small good\";\n    if (r.status === \"flagged\") msg.className = \"small\";\n\n    top.appendChild(title);\n    top.appendChild(chips);\n\n    card.appendChild(poster);\n    card.appendChild(top);\n    card.appendChild(msg);\n    cards.appendChild(card);\n  }\n\n  transparency.textContent =\n    \"Filters: rating ≥ \" + minRating + \", price ≤ $\" + maxPrice + \". Label: \" + labelText;\n};\n\n// ====== Events ======\n$(\"prefBtn\").addEventListener(\"click\", () => {\n  if (prefs.classList.contains(\"hidden\")) {\n    prefs.classList.remove(\"hidden\");\n  } else {\n    prefs.classList.add(\"hidden\");\n  }\n});\n\nminRatingEl.addEventListener(\"input\", () => {\n  minRating = Number(minRatingEl.value);\n  minRatingVal.textContent = String(minRating);\n});\nmaxPriceEl.addEventListener(\"input\", () => {\n  maxPrice = Number(maxPriceEl.value);\n  maxPriceVal.textContent = String(maxPrice);\n});\nlabelTextEl.addEventListener(\"input\", () => {\n  labelText = labelTextEl.value;\n});\nuseCleanEl.addEventListener(\"change\", () => {\n  useClean = useCleanEl.checked;\n});\n\n$(\"applyBtn\").addEventListener(\"click\", () => {\n  render();\n  prefs.classList.add(\"hidden\");\n});\n$(\"resetBtn\").addEventListener(\"click\", () => {\n  minRating = 4;\n  maxPrice = 60;\n  labelText = \"Mix of affordable and highly-rated picks\";\n  useClean = false;\n\n  minRatingEl.value = \"4\";\n  maxPriceEl.value = \"60\";\n  labelTextEl.value = labelText;\n  useCleanEl.checked = false;\n\n  minRatingVal.textContent = \"4\";\n  maxPriceVal.textContent = \"60\";\n\n  render();\n  prefs.classList.add(\"hidden\");\n});\n\n// ====== Boot ======\nconst start = () => {\n  minRatingVal.textContent = \"4\";\n  maxPriceVal.textContent = \"60\";\n  render();\n};\nstart();\n",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    }
  },
  "published": true,
  "audit_log": "[{\"changed_at\":\"2025-11-14 16:07:01 +0000\",\"changed\":[],\"changed_by_id\":22366,\"changed_by_email\":\"joi.anderson@code.org\"}]"
}]]></config>
