      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Movie Night Picker</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <div id=\"screen\">\n    <h1>🍿 Movie Picker</h1>\n    <p>Filter your watchlist</p>\n    \n    <div class=\"controls\">\n      <label>By Genre:</label>\n      <button id=\"genreBtn\">Show \"Sci-Fi\" Movies</button>\n      \n      <label>By Year:</label>\n      <button id=\"yearBtn\" class=\"secondary\">Show Recent (> 2020)</button>\n    </div>\n    \n    <div class=\"display-area\">\n      <h3>Results:</h3>\n      <ul id=\"results\">\n        <li><em>Movies will appear here...</em></li>\n      </ul>\n    </div>\n  </div>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "const movies = [\n  { title: \"Galaxy Wars\", genre: \"Sci-Fi\", year: 2017 },\n  { title: \"Love in the City\", genre: \"Romance\", year: 2018 },\n  { title: \"Space Trek\", genre: \"Sci-Fi\", year: 2018 },\n  { title: \"The Funny Guy\", genre: \"Comedy\", year: 2019 },\n  { title: \"Mystery Mansion\", genre: \"Mystery\", year: 2021 },\n  { title: \"Cosmic Voyage\", genre: \"Sci-Fi\", year: 2023 }\n];\n\nconst genreBtn = document.querySelector(\"#genreBtn\");\nconst yearBtn = document.querySelector(\"#yearBtn\");\nconst resultsList = document.querySelector(\"#results\");\n\nconst filterByGenre = (movies, genre) => {\n  \n};\n\n\ngenreBtn.addEventListener(\"click\", () => {\n  const matchedMovies = filterByGenre(movies, \"Sci-Fi\")\n  updateScreen(matchedMovies);\n});\n\nconst filterByYear = (movies, year) => {\n  \n}\nyearBtn.addEventListener(\"click\", () => {\n  const post2020Movies = filterByYear(movies, 2020);\n  updateScreen(post2020Movies);\n});\n\nfunction updateScreen(items) {\n  resultsList.innerHTML = \"\";\n  items.map((item) => {\n    resultsList.innerHTML += `<li>${item.title} (${item.year})</li>`;\n  });\n}",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "/* Google Fonts */\n@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;700&display=swap');\n\n:root {\n  --bg-dark: #0b0c10;\n  --card-dark: #1f2833;\n  --neon-blue: #66fcf1;\n  --muted-text: #c5c6c7;\n  --action-green: #45a29e;\n  --action-purple: #9d00ff; /* New color for secondary action */\n}\n\nbody {\n  font-family: 'Space Grotesk', sans-serif;\n  background-color: var(--bg-dark);\n  color: white;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  min-height: 100vh;\n  margin: 0;\n}\n\n#screen {\n  background-color: var(--card-dark);\n  padding: 2rem;\n  border-radius: 12px;\n  width: 340px;\n  box-shadow: 0 0 20px rgba(102, 252, 241, 0.1);\n  border: 1px solid #333;\n}\n\nh1 {\n  margin: 0;\n  color: var(--neon-blue);\n  font-size: 1.8rem;\n  text-align: center;\n}\n\np {\n  color: var(--muted-text);\n  text-align: center;\n  margin-top: 0.5rem;\n  font-size: 0.9rem;\n  margin-bottom: 1.5rem;\n}\n\n.controls {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n}\n\nlabel {\n  font-size: 0.75rem;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  color: var(--muted-text);\n  margin-top: 0.5rem;\n}\n\nbutton {\n  background-color: var(--action-green);\n  color: #fff;\n  border: none;\n  padding: 10px 20px;\n  border-radius: 8px;\n  font-family: inherit;\n  font-weight: bold;\n  font-size: 1rem;\n  cursor: pointer;\n  width: 100%;\n  transition: 0.2s;\n}\n\n/* Secondary button style for the \"Student Task\" */\nbutton.secondary {\n  background-color: transparent;\n  border: 2px solid var(--action-green);\n  color: var(--action-green);\n}\n\nbutton:hover {\n  filter: brightness(1.2);\n  transform: translateY(-2px);\n}\n\nbutton.secondary:hover {\n  background-color: var(--action-green);\n  color: white;\n}\n\n.display-area {\n  margin-top: 1.5rem;\n  background: rgba(0,0,0,0.2);\n  padding: 1rem;\n  border-radius: 8px;\n  min-height: 100px;\n}\n\nh3 {\n  margin: 0 0 0.5rem 0;\n  font-size: 1rem;\n  color: var(--muted-text);\n  border-bottom: 1px solid #444;\n  padding-bottom: 0.5rem;\n}\n\nul {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\nli {\n  padding: 0.4rem 0;\n  border-bottom: 1px solid #333;\n  font-size: 0.95rem;\n}\n\nli:last-child {\n  border-bottom: none;\n}",
          "folderId": "0",
          "active": false
