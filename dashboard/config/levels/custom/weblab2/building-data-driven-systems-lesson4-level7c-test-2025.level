      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Character Level Up</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n  <div class=\"card\">\n    <h2>Player Profile</h2>\n    <div class=\"avatar\">👾</div>\n    <div class=\"stats\">\n      <p>Tag: <span id=\"display-tag\"></span></p>\n      <p>Lvl: <span id=\"display-level\"></span></p>\n      <p>VIP: <span id=\"display-vip\"></span></p>\n    </div>\n  </div>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// Object\nconst player = {\n  gamertag: \"Guest_User\",\n  level: 1,\n  isVip: false\n};\n\n// Update\n\n\n\n// Render function\nfunction render() {\n  document.getElementById(\"display-tag\").textContent = player.gamertag;\n  document.getElementById(\"display-level\").textContent = player.level;  \n  if (player.isVip) {\n    document.getElementById(\"display-vip\").textContent = \"Active\";\n  } else {\n    document.getElementById(\"display-vip\").textContent = \"None\";\n  }\n\n}\n\nrender();",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: 'Courier New', Courier, monospace;\n  background-color: #1a1a1a;\n  color: #0f0; /* Matrix green text */\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  height: 100vh;\n  margin: 0;\n}\n\n.card {\n  background-color: #2b2b2b;\n  width: 300px;\n  padding: 20px;\n  border: 2px solid #0f0;\n  border-radius: 4px;\n  box-shadow: 0 0 20px rgba(0, 255, 0, 0.2);\n  text-align: center;\n}\n\nh2 {\n  margin-top: 0;\n  text-transform: uppercase;\n  border-bottom: 1px solid #0f0;\n  padding-bottom: 10px;\n}\n\n.avatar {\n  font-size: 4rem;\n  margin: 10px 0;\n}\n\n.stats p {\n  background: #000;\n  padding: 10px;\n  margin: 10px 0;\n  border-radius: 4px;\n  display: flex;\n  justify-content: space-between;\n  border: 1px solid #333;\n}\n\nspan {\n  font-weight: bold;\n  color: #fff;\n  text-shadow: 0 0 5px #fff;\n}",
          "folderId": "0",
          "active": false
        }
      },
