        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Four Ways There</title>\n<meta name=\"description\" content=\"Most families drive alone because it's all they know. Find your way to school, then bring a neighbor along.\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Overpass:wght@700;800;900&family=Public+Sans:wght@400;700&display=swap\">\n<link rel=\"stylesheet\" href=\"style.css\">\n<script src=\"script.js\" defer></script>\n</head>\n<body>\n<main class=\"page\">\n  <header class=\"intro\">\n    <h1>Four ways to school.</h1>\n    <p class=\"psa\">Most families drive alone because it's all they know. Find your way to school, then bring a neighbor along.</p>\n  </header>\n\n  <section class=\"stage\" aria-label=\"Find your way quiz\">\n    <div class=\"stage-map\">\n      <svg id=\"route-map\" viewBox=\"-200 30 1000 400\" preserveAspectRatio=\"xMidYMid slice\" role=\"img\" aria-label=\"Map of the neighborhood with four routes from home to Ridgeview High School: walk through the park, bike along the creek, school bus along Alder Street, and drive on the main road.\">\n        <defs id=\"map-masks\"></defs>\n\n        <!-- Ground: routes live in x 0-600, y 0-420; streets and blocks keep going on both sides so the map can fill a wide stage -->\n        <rect x=\"-600\" y=\"-100\" width=\"1800\" height=\"700\" fill=\"var(--map-block)\"/>\n        <rect x=\"116\" y=\"196\" width=\"168\" height=\"118\" fill=\"var(--map-park)\"/>\n        <g fill=\"var(--map-tree)\">\n          <circle cx=\"140\" cy=\"222\" r=\"8\"/>\n          <circle cx=\"168\" cy=\"290\" r=\"8\"/>\n          <circle cx=\"250\" cy=\"226\" r=\"8\"/>\n          <circle cx=\"232\" cy=\"296\" r=\"8\"/>\n          <circle cx=\"262\" cy=\"270\" r=\"8\"/>\n          <circle cx=\"150\" cy=\"256\" r=\"8\"/>\n        </g>\n        <g fill=\"var(--map-bldg)\">\n          <rect x=\"18\" y=\"14\" width=\"70\" height=\"30\"/>\n          <rect x=\"130\" y=\"14\" width=\"60\" height=\"28\"/>\n          <rect x=\"312\" y=\"14\" width=\"96\" height=\"30\"/>\n          <rect x=\"18\" y=\"84\" width=\"70\" height=\"80\"/>\n          <rect x=\"130\" y=\"84\" width=\"140\" height=\"34\"/>\n          <rect x=\"312\" y=\"84\" width=\"96\" height=\"80\"/>\n          <rect x=\"312\" y=\"210\" width=\"50\" height=\"40\"/>\n          <rect x=\"454\" y=\"210\" width=\"40\" height=\"24\"/>\n          <rect x=\"18\" y=\"210\" width=\"70\" height=\"84\"/>\n          <!-- Texture outside the route area -->\n          <rect x=\"-500\" y=\"14\" width=\"60\" height=\"30\"/>\n          <rect x=\"-400\" y=\"84\" width=\"110\" height=\"80\"/>\n          <rect x=\"-250\" y=\"14\" width=\"110\" height=\"30\"/>\n          <rect x=\"-250\" y=\"84\" width=\"110\" height=\"34\"/>\n          <rect x=\"-100\" y=\"84\" width=\"80\" height=\"80\"/>\n          <rect x=\"-500\" y=\"210\" width=\"60\" height=\"84\"/>\n          <rect x=\"-400\" y=\"210\" width=\"110\" height=\"40\"/>\n          <rect x=\"-250\" y=\"230\" width=\"110\" height=\"70\"/>\n          <rect x=\"-100\" y=\"210\" width=\"80\" height=\"40\"/>\n          <rect x=\"-400\" y=\"344\" width=\"110\" height=\"50\"/>\n          <rect x=\"-250\" y=\"344\" width=\"60\" height=\"40\"/>\n          <rect x=\"-100\" y=\"344\" width=\"80\" height=\"60\"/>\n          <rect x=\"620\" y=\"14\" width=\"60\" height=\"30\"/>\n          <rect x=\"620\" y=\"84\" width=\"60\" height=\"80\"/>\n          <rect x=\"720\" y=\"210\" width=\"110\" height=\"70\"/>\n          <rect x=\"720\" y=\"344\" width=\"80\" height=\"50\"/>\n        </g>\n        <path d=\"M -600 360 C -380 430, -120 455, 120 420 C 200 380, 290 410, 340 360 S 410 270, 490 255 S 570 225, 620 196 S 820 150, 1000 130\" fill=\"none\" stroke=\"var(--map-creek)\" stroke-width=\"12\"/>\n\n        <!-- Streets -->\n        <g stroke=\"var(--map-street)\" fill=\"none\">\n          <path d=\"M -600 60 H 1200\" stroke-width=\"12\"/>\n          <path d=\"M -600 190 H 1200\" stroke-width=\"12\"/>\n          <path d=\"M -600 320 H 1200\" stroke-width=\"24\"/>\n          <path d=\"M 110 -100 V 600\" stroke-width=\"12\"/>\n          <path d=\"M 290 -100 V 600\" stroke-width=\"12\"/>\n          <path d=\"M 430 -100 V 600\" stroke-width=\"12\"/>\n          <path d=\"M 560 -100 V 600\" stroke-width=\"12\"/>\n          <path d=\"M -420 -100 V 600\" stroke-width=\"12\"/>\n          <path d=\"M -270 -100 V 600\" stroke-width=\"12\"/>\n          <path d=\"M -120 -100 V 600\" stroke-width=\"12\"/>\n          <path d=\"M 700 -100 V 600\" stroke-width=\"12\"/>\n          <path d=\"M 850 -100 V 600\" stroke-width=\"12\"/>\n        </g>\n\n        <!-- Routes and \"not an option\" labels are drawn by script.js -->\n        <g id=\"map-routes\"></g>\n        <g id=\"map-out-labels\"></g>\n\n        <!-- School -->\n        <rect x=\"446\" y=\"72\" width=\"102\" height=\"26\" rx=\"4\" fill=\"var(--pin)\"/>\n        <text class=\"pin-label school-label\" x=\"497\" y=\"86\" text-anchor=\"middle\" dominant-baseline=\"central\">RIDGEVIEW HIGH</text>\n        <path d=\"M 465 120 L 497 104 L 529 120 Z\" fill=\"var(--pin)\"/>\n        <rect x=\"465\" y=\"120\" width=\"64\" height=\"40\" fill=\"var(--pin)\" stroke=\"var(--casing)\" stroke-width=\"3\"/>\n        <rect x=\"490\" y=\"138\" width=\"14\" height=\"22\" fill=\"var(--casing)\"/>\n        <rect x=\"472\" y=\"128\" width=\"11\" height=\"9\" fill=\"var(--casing)\"/>\n        <rect x=\"511\" y=\"128\" width=\"11\" height=\"9\" fill=\"var(--casing)\"/>\n\n        <!-- Home -->\n        <rect x=\"14\" y=\"380\" width=\"96\" height=\"30\" rx=\"4\" fill=\"var(--pin)\"/>\n        <path d=\"M 26 401 V 393 L 34 387 L 42 393 V 401 Z\" fill=\"none\" stroke=\"var(--casing)\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n        <text class=\"pin-label\" x=\"52\" y=\"396\" dominant-baseline=\"central\">HOME</text>\n\n        <g id=\"map-marker-layer\"></g>\n      </svg>\n    </div>\n\n    <ul class=\"scoreboard\" id=\"scoreboard\" aria-label=\"Points so far\"></ul>\n\n    <div class=\"quiz-sign\" id=\"quiz-sign\">\n      <p class=\"load-message\" id=\"load-message\">This activity didn't load. Try reloading the page.</p>\n    </div>\n  </section>\n\n  <footer>The neighborhood, Ridgeview High and its school bus route are made up for this example.</footer>\n</main>\n\n<!-- Pictograms: one consistent 2px stroke set -->\n<template id=\"icon-walk\">\n  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n    <circle cx=\"13.5\" cy=\"4\" r=\"2\"/><path d=\"M12.5 7.5 L11 14 L8 21\"/><path d=\"M11 14 L14.5 17 L15.5 21\"/><path d=\"M8 11.5 L12.3 8.3 L15 11.5 L17.5 12.5\"/>\n  </svg>\n</template>\n<template id=\"icon-bike\">\n  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n    <circle cx=\"5.5\" cy=\"16\" r=\"3.8\"/><circle cx=\"18.5\" cy=\"16\" r=\"3.8\"/>\n    <path d=\"M5.5 16 L9.5 9.5 H16 L18.5 16\"/><path d=\"M9.5 9.5 L12.5 16 L16 9.5\"/>\n    <path d=\"M8 6.5 H11\"/><path d=\"M9.3 6.5 L9.5 9.5\"/><path d=\"M16 9.5 L15 6 H17.5\"/>\n  </svg>\n</template>\n<template id=\"icon-transit\">\n  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n    <rect x=\"5\" y=\"3\" width=\"14\" height=\"15\" rx=\"2\"/><path d=\"M5 11 H19\"/><path d=\"M9 6.5 H15\"/>\n    <circle cx=\"8.5\" cy=\"14.5\" r=\".6\" fill=\"currentColor\"/><circle cx=\"15.5\" cy=\"14.5\" r=\".6\" fill=\"currentColor\"/>\n    <path d=\"M7.5 18 V21 M16.5 18 V21\"/>\n  </svg>\n</template>\n<template id=\"icon-carpool\">\n  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n    <path d=\"M3 16.5 V12.5 L5.6 7 H18.4 L21 12.5 V16.5 Z\"/><path d=\"M3 12.5 H21\"/>\n    <circle cx=\"7.5\" cy=\"16.5\" r=\"2\" fill=\"currentColor\"/><circle cx=\"16.5\" cy=\"16.5\" r=\"2\" fill=\"currentColor\"/>\n  </svg>\n</template>\n<template id=\"icon-cross\">\n  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3.5\" stroke-linecap=\"round\" aria-hidden=\"true\" focusable=\"false\">\n    <path d=\"M6 6 L18 18 M18 6 L6 18\"/>\n  </svg>\n</template>\n<template id=\"icon-arrow-back\">\n  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n    <path d=\"M19 12 H5 M11 6 L5 12 L11 18\"/>\n  </svg>\n</template>\n<template id=\"icon-arrow-next\">\n  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\" focusable=\"false\">\n    <path d=\"M5 12 H19 M13 6 L19 12 L13 18\"/>\n  </svg>\n</template>\n</body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "\"use strict\";\n\n/* =====================================================================\n   DATA: edit these to change the quiz. Everything below reads from them.\n   ===================================================================== */\n\nconst MODE_IDS = [\"walk\", \"bike\", \"transit\", \"carpool\"]; // also the tie-break order\n\nconst MODES = {\n  walk:    { id: \"walk\",    label: \"Walk\",    headline: \"Walk it.\",        firstStep: \"Walk the route once on a weekend to time it.\" },\n  bike:    { id: \"bike\",    label: \"Bike\",    headline: \"Ride it.\",        firstStep: \"Ride the route on a weekend using the quietest streets.\" },\n  transit: { id: \"transit\", label: \"Bus\",     headline: \"Take the bus.\",   firstStep: \"Find your school bus stop and pickup time.\" },\n  carpool: { id: \"carpool\", label: \"Carpool\", headline: \"Share the ride.\", firstStep: \"Message one neighbor. We wrote one for you.\" },\n};\n\n// Points per answer for walk / bike / transit / carpool.\n// OUT removes that mode from the result.\nconst OUT = \"out\";\nconst WEIGHTS = {\n  distance: {\n    close:  { walk: 4,   bike: 2,   transit: 0,   carpool: 0 },\n    mile:   { walk: 2,   bike: 4,   transit: 1,   carpool: 1 },\n    few:    { walk: -3,  bike: 2,   transit: 3,   carpool: 2 },\n    far:    { walk: OUT, bike: -2,  transit: 3,   carpool: 4 },\n  },\n  weather: {\n    mild:   { walk: 1,   bike: 2,   transit: 0,   carpool: 0 },\n    rainy:  { walk: -1,  bike: -2,  transit: 2,   carpool: 2 },\n    hot:    { walk: -1,  bike: 0,   transit: 1,   carpool: 1 },\n    cold:   { walk: -2,  bike: -3,  transit: 2,   carpool: 2 },\n  },\n  bus: {\n    near:   { walk: 0,   bike: 0,   transit: 4,   carpool: 0 },\n    far:    { walk: 0,   bike: 0,   transit: 1,   carpool: 0 },\n    none:   { walk: 0,   bike: 0,   transit: OUT, carpool: 0 },\n    unsure: { walk: 0,   bike: 0,   transit: 0,   carpool: 0 },\n  },\n  bikeRide: {\n    safe:   { walk: 0,   bike: 3,   transit: 0,   carpool: 0 },\n    busy:   { walk: 0,   bike: -1,  transit: 0,   carpool: 0 },\n    none:   { walk: 0,   bike: OUT, transit: 0,   carpool: 0 },\n  },\n  neighbors: {\n    several:{ walk: 1,   bike: 1,   transit: 0,   carpool: 4 },\n    few:    { walk: 0,   bike: 0,   transit: 0,   carpool: 2 },\n    unknown:{ walk: 0,   bike: 0,   transit: 0,   carpool: 0 },\n  },\n};\n\n// A reason only shows if it backs up the winning mode with +2 points or more.\nconst QUESTIONS = [\n  { id: \"distance\", prompt: \"How far is school?\", options: [\n    { id: \"close\", label: \"Under ½ mile\", reasons: { walk: \"School is close enough to walk.\", bike: \"It's a short, easy ride.\" } },\n    { id: \"mile\",  label: \"½ to 1½ miles\", reasons: { walk: \"About a mile is an easy walk.\", bike: \"At about a mile, biking beats the drop-off line.\" } },\n    { id: \"few\",   label: \"1½ to 4 miles\", reasons: { bike: \"A few miles is an easy ride on quiet streets.\", transit: \"A few miles is just right for the school bus.\", carpool: \"A few miles is a short drive to share.\" } },\n    { id: \"far\",   label: \"Over 4 miles\", reasons: { transit: \"The school bus covers the long trip for you.\", carpool: \"It's a long way, so share the car.\" } },\n  ]},\n  { id: \"weather\", prompt: \"What are mornings like right now?\", options: [\n    { id: \"mild\",  label: \"Mild and dry\", reasons: { bike: \"Mild, dry mornings are great for riding.\" } },\n    { id: \"rainy\", label: \"Rainy\", reasons: { transit: \"The school bus keeps you dry.\", carpool: \"Sharing a ride beats waiting in the rain.\" } },\n    { id: \"hot\",   label: \"Hot\", reasons: {} },\n    { id: \"cold\",  label: \"Cold or icy\", reasons: { transit: \"The school bus keeps you off icy sidewalks.\", carpool: \"A warm car beats an icy walk.\" } },\n  ]},\n  { id: \"bus\", prompt: \"Does a school bus stop near you?\", options: [\n    { id: \"near\",   label: \"Yes, close by\", reasons: { transit: \"A school bus stops close to your home.\" } },\n    { id: \"far\",    label: \"Yes, but it's a long walk\", reasons: {} },\n    { id: \"none\",   label: \"No\", reasons: {} },\n    { id: \"unsure\", label: \"Not sure\", reasons: {} },\n  ]},\n  { id: \"bikeRide\", prompt: \"Do you have a bike and a safe way to ride?\", options: [\n    { id: \"safe\", label: \"Yes, quiet streets\", reasons: { bike: \"You have a bike and a calm way to ride.\" } },\n    { id: \"busy\", label: \"Yes, but busy roads\", reasons: {} },\n    { id: \"none\", label: \"No bike\", reasons: {} },\n  ]},\n  { id: \"neighbors\", prompt: \"Do families nearby go to Ridgeview?\", options: [\n    { id: \"several\", label: \"Yes, several\", reasons: { carpool: \"Several families nearby go the same way.\" } },\n    { id: \"few\",     label: \"One or two\", reasons: { carpool: \"One neighbor is enough to start a carpool.\" } },\n    { id: \"unknown\", label: \"Don't know\", reasons: {} },\n  ]},\n];\n\nconst NEIGHBOR_MESSAGE = \"Hi! We live on [your street] and go to Ridgeview too. Want to try sharing the morning drive (or walking together) a couple of days a week? We could take turns.\";\n\nconst FALLBACK_REASON = \"It's your best fit out of the options you have.\";\n\n// Route lines live in x 0-600, y 0-420 of the map.\nconst ROUTES = {\n  walk:    { d: \"M 88 372 L 116 312 L 284 198 H 486 V 160\", outAt: [200, 255] },\n  bike:    { d: \"M 104 372 C 170 368, 270 396, 326 348 S 398 262, 478 245 Q 514 238 514 205 V 160\", outAt: [250, 395] },\n  transit: { d: \"M 56 372 V 313 H 430 V 118 H 465\", outAt: [360, 292], stops: [[220, 313], [430, 232], [430, 146]] },\n  carpool: { d: \"M 72 372 V 328 H 562 V 140 H 529\", outAt: [400, 352] },\n};\n\n// Pure function: answers in, results out.\n// answers looks like { distance: \"mile\", weather: \"rainy\", ... }\nfunction scoreAnswers(answers) {\n  const scores = { walk: 0, bike: 0, transit: 0, carpool: 0 };\n  const ruledOut = {};\n  const picked = [];\n  QUESTIONS.forEach((q, qIndex) => {\n    const option = q.options.find((o) => o.id === answers[q.id]);\n    if (!option) return;\n    const points = WEIGHTS[q.id][option.id];\n    MODE_IDS.forEach((m) => {\n      if (points[m] === OUT) ruledOut[m] = true;\n      else scores[m] += points[m];\n    });\n    picked.push({ qIndex, option, points });\n  });\n  // Highest score first; ties go to the earlier mode in MODE_IDS\n  const ranked = MODE_IDS\n    .filter((m) => !ruledOut[m])\n    .sort((a, b) => scores[b] - scores[a] || MODE_IDS.indexOf(a) - MODE_IDS.indexOf(b));\n  const winner = ranked[0]; // carpool can't be ruled out, so there's always a winner\n  const reasons = picked\n    .filter((p) => p.points[winner] !== OUT && p.points[winner] >= 2 && p.option.reasons[winner])\n    .sort((a, b) => b.points[winner] - a.points[winner] || a.qIndex - b.qIndex)\n    .map((p) => p.option.reasons[winner]);\n  return { scores, ruledOut, ranked, reasons };\n}\n\n/* =====================================================================\n   HELPERS\n   ===================================================================== */\nconst SVG_NS = \"http://www.w3.org/2000/svg\";\nconst WIDE_QUERY = \"(min-width: 1240px)\";\nconst DRAW_ON_MS = 500 * 3 + 700;\nconst numberFormat = new Intl.NumberFormat(document.documentElement.lang || \"en\");\n\nfunction mediaMatches(query) {\n  return !!(window.matchMedia && window.matchMedia(query).matches);\n}\n\nfunction prefersReducedMotion() {\n  return mediaMatches(\"(prefers-reduced-motion: reduce)\");\n}\n\nfunction onMediaChange(query, handler) {\n  if (!window.matchMedia) return;\n  const mq = window.matchMedia(query);\n  if (mq.addEventListener) mq.addEventListener(\"change\", handler);\n  else mq.addListener(handler);\n}\n\nfunction createSvg(tag, attrs) {\n  const el = document.createElementNS(SVG_NS, tag);\n  Object.keys(attrs || {}).forEach((name) => el.setAttribute(name, attrs[name]));\n  return el;\n}\n\nfunction createEl(tag, className, text) {\n  const el = document.createElement(tag);\n  if (className) el.className = className;\n  if (text !== undefined) el.textContent = text;\n  return el;\n}\n\nfunction cloneIcon(name) {\n  return document.getElementById(`icon-${name}`).content.firstElementChild.cloneNode(true);\n}\n\nfunction createBadge(mode) {\n  const badge = createEl(\"span\", `badge ${mode}`);\n  badge.appendChild(cloneIcon(mode));\n  return badge;\n}\n\nfunction round2(n) {\n  return Math.round(n * 100) / 100;\n}\n\n/* =====================================================================\n   THE MAP\n   ===================================================================== */\nconst map = {\n  svg: null,\n  masks: null,\n  outLayer: null,\n  markerLayer: null,\n  routes: {},       // mode -> { group, track, kind, parts, chevrons, chevronWidth }\n  drawing: false,   // the four routes draw one after another on load\n  redraw: null,     // on the result, the winner redraws before the marker travels it\n  winner: null,\n  marker: null,\n  timers: { start: 0, end: 0, raf: 0 },\n};\n\nfunction initMap() {\n  map.svg = document.getElementById(\"route-map\");\n  map.masks = document.getElementById(\"map-masks\");\n  map.outLayer = document.getElementById(\"map-out-labels\");\n  map.markerLayer = document.getElementById(\"map-marker-layer\");\n  const routesLayer = document.getElementById(\"map-routes\");\n\n  MODE_IDS.forEach((mode) => {\n    const group = createSvg(\"g\", { class: \"route\" });\n    // Invisible copy of the route that chevrons and the result marker follow\n    const track = createSvg(\"path\", { d: ROUTES[mode].d, fill: \"none\", stroke: \"none\" });\n    group.appendChild(track);\n    routesLayer.appendChild(group);\n    map.routes[mode] = { group, track, kind: null, parts: {}, chevrons: null, chevronWidth: null };\n  });\n\n  applyMapFraming();\n  onMediaChange(WIDE_QUERY, applyMapFraming);\n\n  if (!prefersReducedMotion()) {\n    map.drawing = true;\n    setTimeout(() => {\n      map.drawing = false;\n      syncMasks();\n    }, DRAW_ON_MS);\n  }\n}\n\n// Wide stage: routes sit on the right and the sign stands on the left.\n// Banner: routes centered with a little street texture on each side.\nfunction applyMapFraming() {\n  const wide = mediaMatches(WIDE_QUERY);\n  map.svg.setAttribute(\"viewBox\", wide ? \"-520 20 1140 400\" : \"-200 30 1000 400\");\n  map.svg.setAttribute(\"preserveAspectRatio\", wide ? \"xMaxYMid slice\" : \"xMidYMid slice\");\n}\n\n// Lowest live score draws at 3px, highest at 9px\nfunction routeWidths(scores, ruledOut) {\n  const widths = { walk: 6, bike: 6, transit: 6, carpool: 6 };\n  if (!scores) return widths;\n  const live = MODE_IDS.filter((m) => !ruledOut[m]);\n  const vals = live.map((m) => scores[m]);\n  const lo = Math.min(...vals);\n  const hi = Math.max(...vals);\n  live.forEach((m) => { widths[m] = hi === lo ? 5 : 3 + (6 * (scores[m] - lo)) / (hi - lo); });\n  return widths;\n}\n\n/* Route lines: walk = dashed, bike = chevrons, bus = thick + stops,\n   carpool = double line. Never color alone. */\nfunction routePath(d, stroke, roundCaps) {\n  const attrs = { d, fill: \"none\", stroke, \"stroke-linejoin\": \"round\" };\n  if (roundCaps) attrs[\"stroke-linecap\"] = \"round\";\n  return createSvg(\"path\", attrs);\n}\n\nfunction buildRouteLine(entry, mode, out) {\n  const d = ROUTES[mode].d;\n  const parts = {};\n  if (out) {\n    parts.out = createSvg(\"path\", { d, fill: \"none\", stroke: \"var(--out)\", \"stroke-dasharray\": \"4 6\" });\n    parts.out.style.strokeWidth = \"3px\";\n  } else if (mode === \"walk\") {\n    parts.casing = routePath(d, \"var(--casing)\", false);\n    parts.line = routePath(d, \"var(--walk)\", false);\n  } else if (mode === \"bike\") {\n    parts.casing = routePath(d, \"var(--casing)\", true);\n    parts.line = routePath(d, \"var(--bike)\", true);\n  } else if (mode === \"transit\") {\n    parts.casing = routePath(d, \"var(--casing)\", true);\n    parts.line = routePath(d, \"var(--transit)\", true);\n    parts.stops = ROUTES[mode].stops.map(([x, y]) =>\n      createSvg(\"circle\", { cx: x, cy: y, fill: \"#fff\", stroke: \"var(--casing)\", \"stroke-width\": \"2.5\" }));\n  } else {\n    parts.casing = routePath(d, \"var(--casing)\", false);\n    parts.line = routePath(d, \"var(--carpool)\", false);\n    parts.inner = routePath(d, \"var(--casing)\", false);\n  }\n  return parts;\n}\n\nfunction routeLineElements(entry) {\n  const p = entry.parts;\n  const els = [p.out, p.casing, p.line, p.inner].concat(p.stops || [], entry.chevrons ? [entry.chevrons] : []);\n  return els.filter(Boolean);\n}\n\nfunction setRouteWidth(entry, mode, w) {\n  const p = entry.parts;\n  if (p.out) return;\n  if (mode === \"walk\") {\n    p.casing.style.strokeWidth = `${w + 4}px`;\n    p.line.style.strokeWidth = `${w}px`;\n    p.line.style.strokeDasharray = `${Math.max(8, w * 1.8)} ${Math.max(5, w * 1.1)}`;\n  } else if (mode === \"bike\") {\n    p.casing.style.strokeWidth = `${w + 4}px`;\n    p.line.style.strokeWidth = `${w}px`;\n    setChevrons(entry, w);\n  } else if (mode === \"transit\") {\n    p.casing.style.strokeWidth = `${w + 7}px`;\n    p.line.style.strokeWidth = `${w + 3}px`;\n    const r = (w + 3) / 2 + 3;\n    p.stops.forEach((stop) => {\n      stop.setAttribute(\"r\", round2(r));\n      stop.style.r = `${r}px`;\n    });\n  } else {\n    p.casing.style.strokeWidth = `${w + 9}px`;\n    p.line.style.strokeWidth = `${w + 5}px`;\n    p.inner.style.strokeWidth = `${Math.max(1.5, w - 3)}px`;\n  }\n}\n\n// Small chevrons along the bike route, sized from the line width (only on lines 5px or wider)\nfunction setChevrons(entry, w) {\n  if (w < 5) {\n    if (entry.chevrons) entry.chevrons.remove();\n    entry.chevrons = null;\n    entry.chevronWidth = null;\n    return;\n  }\n  if (entry.chevrons && entry.chevronWidth === w) return;\n  if (entry.chevrons) entry.chevrons.remove();\n  entry.chevrons = buildChevrons(entry.track, w);\n  entry.chevronWidth = w;\n  entry.group.appendChild(entry.chevrons);\n}\n\nfunction buildChevrons(track, w) {\n  const size = w * 2.6;\n  const spacing = size * 1.25;\n  const depth = round2(size * 0.09);\n  const half = round2(size * 0.17);\n  const len = track.getTotalLength();\n  const group = createSvg(\"g\", { class: \"chevrons\", \"stroke-width\": round2(size * 0.1) });\n  for (let at = 8 + size * 0.15, count = 0; at < len && count < 50; at += spacing, count += 1) {\n    const p = track.getPointAtLength(at);\n    const q = track.getPointAtLength(Math.min(len, at + 1));\n    const angle = Math.atan2(q.y - p.y, q.x - p.x) * 180 / Math.PI;\n    group.appendChild(createSvg(\"path\", {\n      d: `M ${-depth} ${-half} L ${depth} 0 L ${-depth} ${half}`,\n      transform: `translate(${round2(p.x)} ${round2(p.y)}) rotate(${round2(angle)})`,\n    }));\n  }\n  return group;\n}\n\nfunction updateRoute(mode, w, out, dim) {\n  const entry = map.routes[mode];\n  entry.group.classList.toggle(\"dim\", dim);\n  const kind = out ? \"out\" : \"live\";\n  if (entry.kind !== kind) {\n    routeLineElements(entry).forEach((el) => el.remove());\n    entry.chevrons = null;\n    entry.chevronWidth = null;\n    entry.parts = buildRouteLine(entry, mode, out);\n    entry.kind = kind;\n    routeLineElements(entry).forEach((el) => entry.group.appendChild(el));\n  }\n  setRouteWidth(entry, mode, w);\n}\n\nfunction renderOutLabels(ruledOut) {\n  map.outLayer.replaceChildren();\n  MODE_IDS.filter((m) => ruledOut[m]).forEach((m) => {\n    const [x, y] = ROUTES[m].outAt;\n    const label = createSvg(\"g\", { transform: `translate(${x} ${y})` });\n    label.appendChild(createSvg(\"rect\", { x: -58, y: -12, width: 116, height: 24, rx: 4, fill: \"var(--pin)\" }));\n    label.appendChild(createSvg(\"path\", { class: \"out-cross\", d: \"M -42.5 -3.5 L -35.5 3.5 M -35.5 -3.5 L -42.5 3.5\" }));\n    const text = createSvg(\"text\", { class: \"out-label\", x: 6, \"text-anchor\": \"middle\", \"dominant-baseline\": \"central\" });\n    text.textContent = \"not an option\";\n    label.appendChild(text);\n    map.outLayer.appendChild(label);\n  });\n}\n\nfunction maskFor(mode, index) {\n  if (map.drawing) return { id: `m-${mode}`, delay: 200 + index * 500 };\n  if (map.redraw === mode) return { id: `m-${mode}-win`, delay: 0 };\n  return null;\n}\n\nfunction createMask(mode, mask) {\n  const el = createSvg(\"mask\", { id: mask.id, maskUnits: \"userSpaceOnUse\", x: -600, y: -100, width: 1800, height: 700 });\n  const reveal = createSvg(\"path\", {\n    class: \"reveal\", d: ROUTES[mode].d, pathLength: 1, fill: \"none\",\n    stroke: \"#fff\", \"stroke-width\": 44, \"stroke-linejoin\": \"round\",\n  });\n  reveal.style.animationDelay = `${mask.delay}ms`;\n  el.appendChild(reveal);\n  return el;\n}\n\n// Keeps the reveal masks in step with the drawing/redraw state; a mask that stays keeps its running animation\nfunction syncMasks() {\n  const wanted = {};\n  MODE_IDS.forEach((mode, i) => {\n    const mask = maskFor(mode, i);\n    const group = map.routes[mode].group;\n    if (!mask) {\n      group.removeAttribute(\"mask\");\n      return;\n    }\n    wanted[mask.id] = true;\n    if (!document.getElementById(mask.id)) map.masks.appendChild(createMask(mode, mask));\n    group.setAttribute(\"mask\", `url(#${mask.id})`);\n  });\n  Array.from(map.masks.children).forEach((el) => {\n    if (!wanted[el.id]) el.remove();\n  });\n}\n\nfunction showMarker(mode) {\n  const [, x, y] = ROUTES[mode].d.split(\" \");\n  map.marker = createSvg(\"g\", { transform: `translate(${x} ${y})` });\n  map.marker.appendChild(createSvg(\"circle\", { r: 10, fill: \"var(--pin)\", stroke: \"var(--casing)\", \"stroke-width\": 3 }));\n  map.markerLayer.appendChild(map.marker);\n}\n\nfunction hideMarker() {\n  if (map.marker) map.marker.remove();\n  map.marker = null;\n}\n\nfunction stopWinnerAnimation() {\n  clearTimeout(map.timers.start);\n  clearTimeout(map.timers.end);\n  cancelAnimationFrame(map.timers.raf);\n  hideMarker();\n  if (map.redraw) {\n    map.redraw = null;\n    syncMasks();\n  }\n}\n\n// On the result: redraw the winner, then a marker travels it once\nfunction setWinner(winner) {\n  if (winner === map.winner) return;\n  stopWinnerAnimation();\n  map.winner = winner;\n  if (!winner || prefersReducedMotion()) return;\n  map.redraw = winner;\n  syncMasks();\n  map.timers.start = setTimeout(() => {\n    map.redraw = null;\n    syncMasks();\n    const path = map.routes[winner].track;\n    const len = path.getTotalLength();\n    showMarker(winner);\n    let t0 = 0;\n    const step = (now) => {\n      if (!t0) t0 = now;\n      const p = Math.min(1, (now - t0) / 1500);\n      const eased = p < 0.5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2;\n      const pt = path.getPointAtLength(eased * len);\n      if (map.marker) map.marker.setAttribute(\"transform\", `translate(${pt.x} ${pt.y})`);\n      if (p < 1) map.timers.raf = requestAnimationFrame(step);\n      else map.timers.end = setTimeout(hideMarker, 500);\n    };\n    map.timers.raf = requestAnimationFrame(step);\n  }, 650);\n}\n\nfunction renderMap(result, hasAnswers, winner) {\n  const widths = routeWidths(hasAnswers ? result.scores : null, result.ruledOut);\n  if (winner) widths[winner] = 9;\n  MODE_IDS.forEach((m) => updateRoute(m, widths[m], !!result.ruledOut[m], !!winner && winner !== m));\n  renderOutLabels(result.ruledOut);\n  syncMasks();\n  setWinner(winner);\n}\n\n/* =====================================================================\n   SCOREBOARD: live points per mode, so players see answers add up\n   ===================================================================== */\nconst scoreboard = {}; // mode -> { item, points, key }\n\nfunction initScoreboard() {\n  const list = document.getElementById(\"scoreboard\");\n  MODE_IDS.forEach((m) => {\n    const item = document.createElement(\"li\");\n    item.appendChild(createBadge(m));\n    item.appendChild(createEl(\"span\", \"sr-only\", `${MODES[m].label}: `));\n    list.appendChild(item);\n    scoreboard[m] = { item, points: null, key: null };\n  });\n}\n\nfunction createPoints(mode, result) {\n  if (result.ruledOut[mode]) {\n    const cross = createEl(\"span\", \"pts pts-out\");\n    cross.setAttribute(\"role\", \"img\");\n    cross.setAttribute(\"aria-label\", \"not an option\");\n    cross.appendChild(cloneIcon(\"cross\"));\n    return cross;\n  }\n  // A fresh element each time the number changes, so the pop animation replays\n  return createEl(\"span\", \"pts pop\", numberFormat.format(result.scores[mode]));\n}\n\nfunction renderScoreboard(result) {\n  MODE_IDS.forEach((m) => {\n    const entry = scoreboard[m];\n    const out = !!result.ruledOut[m];\n    entry.item.className = out ? \"is-out\" : \"\";\n    const key = out ? \"out\" : String(result.scores[m]);\n    if (entry.key === key) return;\n    const points = createPoints(m, result);\n    if (entry.points) entry.points.replaceWith(points);\n    else entry.item.appendChild(points);\n    entry.points = points;\n    entry.key = key;\n  });\n}\n\n/* =====================================================================\n   QUIZ STATE\n   ===================================================================== */\nconst initialQuiz = { step: 0, answers: {}, done: false };\n\nfunction quizReducer(state, action) {\n  switch (action.type) {\n    case \"ANSWER\": return { ...state, answers: { ...state.answers, [action.qid]: action.optionId } };\n    case \"NEXT\":\n      if (!state.answers[QUESTIONS[state.step].id]) return state;\n      if (state.step === QUESTIONS.length - 1) return { ...state, done: true };\n      return { ...state, step: state.step + 1 };\n    case \"BACK\": return { ...state, step: Math.max(0, state.step - 1) }; // answers are kept\n    case \"RESTART\": return initialQuiz;\n    default: return state;\n  }\n}\n\nlet state = initialQuiz;\nconst sign = { root: null, heading: null, options: [], nextButton: null };\n\nfunction dispatch(action) {\n  const next = quizReducer(state, action);\n  if (next === state) return;\n  const prev = state;\n  state = next;\n  render(prev);\n}\n\n/* =====================================================================\n   QUESTION PANEL\n   ===================================================================== */\n\n// Five little stops on a line: passed ones filled, current one ringed\nfunction createProgressLine(step) {\n  const gap = 24;\n  const r = 6;\n  const w = gap * (QUESTIONS.length - 1) + 2 * (r + 4);\n  const svg = createSvg(\"svg\", { width: w, height: 24, viewBox: `0 0 ${w} 24`, \"aria-hidden\": \"true\", focusable: \"false\" });\n  svg.appendChild(createSvg(\"path\", { d: `M ${r + 4} 12 H ${w - r - 4}`, stroke: \"#B4C0C9\", \"stroke-width\": 4 }));\n  svg.appendChild(createSvg(\"path\", { d: `M ${r + 4} 12 H ${r + 4 + gap * step}`, stroke: \"var(--sign-ink)\", \"stroke-width\": 4 }));\n  QUESTIONS.forEach((q, i) => {\n    svg.appendChild(createSvg(\"circle\", {\n      cx: r + 4 + gap * i,\n      cy: 12,\n      r: i === step ? r + 2 : r,\n      fill: i < step ? \"var(--sign-ink)\" : \"var(--sign)\",\n      stroke: i <= step ? \"var(--sign-ink)\" : \"#B4C0C9\",\n      \"stroke-width\": i === step ? 4 : 3,\n    }));\n  });\n  return svg;\n}\n\nfunction isFocusVisible(el) {\n  try {\n    return el.matches(\":focus-visible\");\n  } catch (error) {\n    return true;\n  }\n}\n\nfunction createOption(question, option) {\n  const label = createEl(\"label\", \"opt\");\n  const input = document.createElement(\"input\");\n  input.type = \"radio\";\n  input.name = question.id;\n  input.value = option.id;\n  input.addEventListener(\"change\", () => dispatch({ type: \"ANSWER\", qid: question.id, optionId: option.id }));\n  const showRing = () => label.classList.toggle(\"is-focus-visible\", isFocusVisible(input));\n  input.addEventListener(\"focus\", showRing);\n  input.addEventListener(\"keyup\", showRing);\n  input.addEventListener(\"blur\", () => label.classList.remove(\"is-focus-visible\"));\n  label.appendChild(input);\n  label.appendChild(createEl(\"span\", \"\", option.label));\n  return { label, input, optionId: option.id };\n}\n\nfunction renderQuestion() {\n  const step = state.step;\n  const q = QUESTIONS[step];\n  const form = document.createElement(\"form\");\n  form.addEventListener(\"submit\", (event) => {\n    event.preventDefault();\n    dispatch({ type: \"NEXT\" });\n  });\n\n  const progress = createEl(\"div\", \"progress\");\n  progress.appendChild(createProgressLine(step));\n  const current = numberFormat.format(step + 1);\n  const total = numberFormat.format(QUESTIONS.length);\n  progress.appendChild(createEl(\"p\", \"progress-text\", `Question ${current} of ${total}`));\n  form.appendChild(progress);\n\n  const fieldset = document.createElement(\"fieldset\");\n  const legend = document.createElement(\"legend\");\n  const heading = createEl(\"h2\", \"q-prompt\", q.prompt);\n  heading.id = \"quiz-heading\";\n  heading.tabIndex = -1;\n  legend.appendChild(heading);\n  fieldset.appendChild(legend);\n  const options = createEl(\"div\", \"options\");\n  sign.options = q.options.map((o) => createOption(q, o));\n  sign.options.forEach((o) => options.appendChild(o.label));\n  fieldset.appendChild(options);\n  form.appendChild(fieldset);\n\n  const nav = createEl(\"div\", \"q-nav\");\n  if (step > 0) {\n    const back = createEl(\"button\", \"btn btn-text\");\n    back.type = \"button\";\n    back.appendChild(cloneIcon(\"arrow-back\"));\n    back.appendChild(document.createTextNode(\"Back\"));\n    back.addEventListener(\"click\", () => dispatch({ type: \"BACK\" }));\n    nav.appendChild(back);\n  } else {\n    nav.appendChild(document.createElement(\"span\"));\n  }\n  const next = createEl(\"button\", \"btn btn-dark\", step === QUESTIONS.length - 1 ? \"Show my way\" : \"Next\");\n  next.type = \"submit\";\n  next.appendChild(cloneIcon(\"arrow-next\"));\n  nav.appendChild(next);\n  form.appendChild(nav);\n\n  sign.heading = heading;\n  sign.nextButton = next;\n  sign.root.replaceChildren(form);\n  updateSelection();\n}\n\n// Answering keeps the same panel; only the checked card and the Next button change\nfunction updateSelection() {\n  const chosen = state.answers[QUESTIONS[state.step].id];\n  sign.options.forEach((o) => {\n    const checked = o.optionId === chosen;\n    o.input.checked = checked;\n    o.label.classList.toggle(\"is-checked\", checked);\n  });\n  sign.nextButton.disabled = !chosen;\n}\n\n/* =====================================================================\n   RESULT\n   ===================================================================== */\n\n// Copies the neighbor message; if the clipboard is blocked (common in iframes), shows it selected instead\nfunction createCopyMessage() {\n  const button = createEl(\"button\", \"btn btn-dark\", \"Copy a message for a neighbor\");\n  button.type = \"button\";\n  const status = createEl(\"p\", \"copy-status\");\n  status.setAttribute(\"role\", \"status\");\n  let mode = \"idle\"; // idle | copied | manual\n  let area = null;\n\n  const setMode = (nextMode) => {\n    if (nextMode === mode) return;\n    mode = nextMode;\n    button.textContent = mode === \"copied\" ? \"Copied\" : \"Copy a message for a neighbor\";\n    if (mode === \"copied\") status.textContent = \"Copied. Paste it into a text to a neighbor.\";\n    else if (mode === \"manual\") status.textContent = \"Press Ctrl+C (or Command+C) to copy.\";\n    else status.textContent = \"\";\n    if (mode === \"manual\") {\n      area = createEl(\"textarea\", \"manual-copy\");\n      area.readOnly = true;\n      area.rows = 4;\n      area.value = NEIGHBOR_MESSAGE;\n      area.setAttribute(\"aria-label\", \"Message for a neighbor\");\n      status.before(area);\n      area.focus();\n      area.select();\n    } else if (area) {\n      area.remove();\n      area = null;\n    }\n  };\n\n  button.addEventListener(\"click\", async () => {\n    try {\n      if (navigator.clipboard && navigator.clipboard.writeText) {\n        await navigator.clipboard.writeText(NEIGHBOR_MESSAGE);\n        setMode(\"copied\");\n        return;\n      }\n    } catch (error) {\n      // Clipboard blocked: fall through to the manual copy box\n    }\n    setMode(\"manual\");\n  });\n\n  return [button, status];\n}\n\nfunction renderResult(result) {\n  const winner = result.ranked[0];\n  const mode = MODES[winner];\n  const wrap = document.createElement(\"div\");\n\n  const kicker = createEl(\"p\", \"result-kicker\", \"Your way there\");\n  kicker.setAttribute(\"aria-hidden\", \"true\");\n  wrap.appendChild(kicker);\n\n  const heading = createEl(\"h2\", `result-mode ${winner}`);\n  heading.id = \"quiz-heading\";\n  heading.tabIndex = -1;\n  heading.appendChild(createEl(\"span\", \"sr-only\", \"Your way there: \"));\n  heading.appendChild(createBadge(winner));\n  heading.appendChild(createEl(\"span\", \"word\", mode.label));\n  wrap.appendChild(heading);\n\n  wrap.appendChild(createEl(\"p\", \"result-headline\", mode.headline));\n\n  const lines = createEl(\"ul\", \"result-lines\");\n  const why = document.createElement(\"li\");\n  why.appendChild(createEl(\"b\", \"\", \"Why\"));\n  why.appendChild(document.createTextNode(result.reasons[0] || FALLBACK_REASON));\n  const first = document.createElement(\"li\");\n  first.appendChild(createEl(\"b\", \"\", \"First step\"));\n  first.appendChild(document.createTextNode(mode.firstStep));\n  lines.appendChild(why);\n  lines.appendChild(first);\n  wrap.appendChild(lines);\n\n  const row = createEl(\"div\", \"btn-row\");\n  if (winner === \"carpool\") createCopyMessage().forEach((el) => row.appendChild(el));\n  const restart = createEl(\"button\", \"btn btn-line\", \"Start over\");\n  restart.type = \"button\";\n  restart.addEventListener(\"click\", () => dispatch({ type: \"RESTART\" }));\n  row.appendChild(restart);\n  wrap.appendChild(row);\n\n  sign.heading = heading;\n  sign.options = [];\n  sign.nextButton = null;\n  sign.root.replaceChildren(wrap);\n}\n\n/* =====================================================================\n   APP\n   ===================================================================== */\nfunction render(prev) {\n  const result = scoreAnswers(state.answers); // derived, never stored\n  const hasAnswers = Object.keys(state.answers).length > 0;\n  const winner = state.done ? result.ranked[0] : null;\n\n  renderMap(result, hasAnswers, winner);\n  renderScoreboard(result);\n\n  const screenChanged = !prev || prev.step !== state.step || prev.done !== state.done;\n  if (!screenChanged) {\n    updateSelection();\n    return;\n  }\n  if (state.done) {\n    sign.root.setAttribute(\"aria-live\", \"polite\");\n    renderResult(result);\n  } else {\n    sign.root.removeAttribute(\"aria-live\");\n    renderQuestion();\n  }\n  // Move focus to the new question (or the result) when the screen changes, but not on first load\n  if (prev) sign.heading.focus();\n}\n\nfunction init() {\n  sign.root = document.getElementById(\"quiz-sign\");\n  const loadMessage = document.getElementById(\"load-message\");\n  try {\n    initMap();\n    initScoreboard();\n    render(null);\n  } catch (error) {\n    sign.root.replaceChildren(loadMessage);\n    throw error;\n  }\n}\n\ninit();\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": "/* ============ TOKENS: \"before sunrise\" ============ */\n:root {\n  --ground: #101A22;        /* page background */\n  --text: #E9EEF2;\n  --text-soft: #A7B4BF;\n  /* Route colors, bright for lines on the dark map */\n  --walk: #4CB877;\n  --bike: #F2793A;\n  --transit: #F2C230;\n  --carpool: #6E9BEA;\n  --out: #7D8C98;\n  /* Darker versions for text on the light sign (3:1+ at large sizes) */\n  --walk-ink: #2F7D4F;\n  --bike-ink: #C24A15;\n  --carpool-ink: #2C5AA0;\n  /* Map */\n  --map-block: #1F2F3A;\n  --map-bldg: #273945;\n  --map-street: #0A1218;\n  --map-park: #22402F;\n  --map-tree: #2E5A3F;\n  --map-creek: #2B4D61;\n  --casing: #101A22;\n  --pin: #E9EEF2;\n  /* The quiz sign */\n  --sign: #E9EEF2;\n  --sign-ink: #101A22;\n  --sign-soft: #4B5A66;     /* 6:1 on the sign */\n  --sign-line: #B4C0C9;\n  --sign-hover: #DDE5EB;\n  --sign-ink-hover: #24343F;\n  --white: #fff;\n  --focus: #6E9BEA;\n  --display: \"Overpass\", \"Trebuchet MS\", \"Segoe UI\", sans-serif;\n  --body: \"Public Sans\", \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n}\n\n/* ============ BASE ============ */\n*, *::before, *::after { box-sizing: border-box; }\nbody { margin: 0; background: var(--ground); color: var(--text); font: 400 18px/1.5 var(--body); overflow-x: hidden; }\nh1, h2, h3, p, ul, ol { margin: 0; }\nbutton, textarea { font: inherit; color: inherit; }\n:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }\n[tabindex=\"-1\"]:focus:not(:focus-visible) { outline: none; }\n.sr-only { position: absolute !important; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }\n.page { max-width: 1320px; margin: 0 auto; padding: 32px 24px 28px; }\n\n/* ============ INTRO: one headline, one problem/solution/audience line ============ */\n.intro { display: flex; flex-direction: column; gap: 14px; margin-bottom: 28px; }\nh1 { font: 800 clamp(46px, 6.6vw, 92px)/.95 var(--display); letter-spacing: -.03em; }\n.psa { font-size: 22px; color: var(--text); }\n\n/* ============ STAGE: the map, with the quiz as a sign on it ============ */\n.stage { position: relative; border-radius: 6px; overflow: hidden; background: var(--map-block); }\n.stage-map svg { display: block; width: 100%; }\n\n/* Wide screens: the map fills the stage and the sign stands on its start side */\n@media (min-width: 1240px) {\n  /* No aspect-ratio here: combined with min-height it forced the stage wider than the window */\n  .stage { display: flex; align-items: center; min-height: 460px; }\n  .stage-map { position: absolute; inset: 0; }\n  .stage-map svg { height: 100%; }\n  .quiz-sign { position: relative; width: 400px; margin: 24px 28px; }\n  .scoreboard { position: absolute; inset-inline-end: 20px; inset-block-end: 18px; }\n}\n/* Everything narrower (including lesson iframes): map banner, then the sign */\n@media (max-width: 1239px) {\n  .stage-map svg { height: clamp(230px, 44vw, 420px); }\n  .scoreboard { border-top: 2px solid var(--map-street); justify-content: center; flex-wrap: wrap; }\n  .quiz-sign { border-radius: 0 0 6px 6px; }\n}\n\n/* ============ SCOREBOARD: makes \"answers add points\" visible ============ */\n.scoreboard {\n  display: flex; gap: 6px; padding: 8px; background: var(--ground);\n  border-radius: 6px; list-style: none;\n}\n.scoreboard li {\n  display: flex; align-items: center; gap: 8px; padding-block: 4px; padding-inline: 4px 10px; min-width: 76px;\n  font: 900 24px/1 var(--display); font-variant-numeric: tabular-nums;\n}\n.scoreboard .badge { width: 32px; height: 32px; }\n.scoreboard .badge svg { width: 20px; height: 20px; }\n.scoreboard .is-out { color: var(--text-soft); }\n.scoreboard .is-out .badge { background: var(--out); }\n.scoreboard .pts { display: inline-block; padding-top: 3px; }\n.scoreboard .pts-out { padding-top: 0; }\n.pts-out svg { display: block; width: 18px; height: 18px; }\n.pop { animation: pop 380ms cubic-bezier(.2,1.6,.4,1); }\n@keyframes pop { 0% { transform: scale(1.6); } 100% { transform: scale(1); } }\n\n/* ============ THE QUIZ SIGN ============ */\n.quiz-sign {\n  --focus: #2C5AA0;                         /* darker focus ring on the light sign */\n  background: var(--sign); color: var(--sign-ink);\n  border-radius: 6px; padding: 24px 26px 24px;\n  box-shadow: inset 0 0 0 4px var(--sign), inset 0 0 0 6px var(--sign-ink); /* sign pinstripe, not a drop shadow */\n}\n.load-message { font: 700 18px/1.4 var(--body); }\n.progress { display: flex; align-items: center; gap: 14px; }\n.progress svg { flex: none; }\n.progress-text { font: 800 14px/1 var(--display); letter-spacing: .12em; text-transform: uppercase; color: var(--sign-soft); padding-top: 2px; }\nfieldset { border: 0; padding: 0; margin: 0; min-width: 0; }\nlegend { padding: 0; width: 100%; }\n.q-prompt { font: 800 28px/1.1 var(--display); letter-spacing: -.01em; margin: 16px 0 16px; }\n\n/* Answers: big tap-cards. Each is a native radio inside a label. */\n.options { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }\n.opt {\n  display: flex; align-items: center; gap: 12px; min-height: 64px; padding: 10px 14px;\n  background: var(--white); border: 2px solid var(--sign-ink); border-radius: 4px; cursor: pointer;\n  font: 700 18px/1.2 var(--body);\n}\n.opt:hover { background: var(--sign-hover); }\n/* script.js toggles these classes on the label (stands in for :has(), which older browsers lack) */\n.opt.is-checked { background: var(--sign-ink); color: var(--white); }\n.opt.is-focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }\n.opt input {\n  appearance: none; -webkit-appearance: none; flex: none; margin: 0;\n  width: 22px; height: 22px; border-radius: 999px; border: 2px solid currentColor;\n  color: inherit; /* follow the card's text color, so the radio turns white on a selected (dark) card */\n  display: grid; place-items: center;\n}\n.opt input::before { content: \"\"; width: 10px; height: 10px; border-radius: 999px; background: currentColor; transform: scale(0); }\n.opt input:checked::before { transform: scale(1); }\n.opt input:focus-visible { outline: none; }\n\n.q-nav { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-top: 18px; }\n.btn {\n  display: inline-flex; align-items: center; justify-content: center; gap: 8px;\n  min-height: 50px; padding: 13px 22px 10px; border-radius: 4px; cursor: pointer;\n  font: 800 18px/1 var(--display); border: 2px solid var(--sign-ink);\n}\n/* Arrow icons: 1em wide like the text arrows they replace, lifted to sit on the text's optical center */\n.btn svg { flex: none; width: 1em; height: 1em; margin-block-start: -3px; }\n.btn-dark { background: var(--sign-ink); color: var(--white); }\n.btn-dark:hover { background: var(--sign-ink-hover); }\n.btn-dark:disabled { background: transparent; color: var(--sign-soft); border-color: var(--sign-line); cursor: not-allowed; }\n.btn-line { background: transparent; color: var(--sign-ink); }\n.btn-line:hover { background: var(--sign-hover); }\n.btn-text { background: none; border-color: transparent; color: var(--sign-ink); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 2px; padding-inline: 6px; }\n.btn-row { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }\n\n/* Result */\n.result-kicker { font: 800 14px/1 var(--display); letter-spacing: .12em; text-transform: uppercase; color: var(--sign-soft); }\n.result-mode {\n  display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin: 10px 0 2px;\n  font: 900 clamp(44px, 4.2vw, 56px)/.9 var(--display); letter-spacing: -.01em; text-transform: uppercase;\n}\n.result-mode .badge { width: 60px; height: 60px; }\n.result-mode .badge svg { width: 36px; height: 36px; }\n.result-mode .word { padding-top: .1em; }\n.result-mode.walk { color: var(--walk-ink); }\n.result-mode.bike { color: var(--bike-ink); }\n.result-mode.carpool { color: var(--carpool-ink); }\n.result-mode.transit .word { background: var(--transit); padding: .12em .14em 0; border-radius: 4px; }\n.result-headline { font: 800 24px/1.1 var(--display); margin-bottom: 14px; }\n.result-lines { list-style: none; padding: 0; display: grid; gap: 8px; }\n.result-lines b { font: 800 14px/1 var(--display); letter-spacing: .1em; text-transform: uppercase; color: var(--sign-soft); display: block; margin-bottom: 3px; }\n.copy-status { font-size: 15px; color: var(--sign-soft); margin-top: 10px; min-height: 22px; }\n.manual-copy { width: 100%; margin-top: 10px; padding: 10px 12px; border: 2px solid var(--sign-ink); border-radius: 4px; background: var(--white); color: var(--sign-ink); font-size: 16px; }\n\n.badge { flex: none; display: inline-grid; place-items: center; border-radius: 4px; color: var(--ground); }\n.badge.walk { background: var(--walk); }\n.badge.bike { background: var(--bike); }\n.badge.transit { background: var(--transit); }\n.badge.carpool { background: var(--carpool); }\n\n/* Map text and motion */\n.pin-label { font: 900 13.5px var(--display); letter-spacing: .1em; fill: var(--ground); }\n.pin-label.school-label { font-size: 11px; letter-spacing: .05em; }\n.out-label { font: 700 12px var(--body); fill: var(--ground); }\n.out-cross { fill: none; stroke: var(--ground); stroke-width: 1.6; stroke-linecap: round; }\n.chevrons { fill: none; stroke: var(--casing); }\n.route { transition: opacity .45s ease; }\n.route.dim { opacity: .2; }\n.route path, .route circle { transition: stroke-width .35s ease, stroke-dasharray .35s ease, r .35s ease; }\n.reveal { stroke-dasharray: 1 1; stroke-dashoffset: 1; animation: draw 600ms ease-out forwards; }\n@keyframes draw { to { stroke-dashoffset: 0; } }\n\nfooter { margin-top: 18px; font-size: 15px; color: var(--text-soft); }\n\n/* ============ SMALL SCREENS ============ */\n@media (max-width: 599px) {\n  .page { padding: 24px 16px; }\n  .psa { font-size: 19px; }\n  .stage-map svg { height: auto; aspect-ratio: 3 / 2; } /* 3:2 shows the whole route area (home to school) */\n  .quiz-sign { padding: 20px 18px; }\n  .q-prompt { font-size: 25px; }\n  .options { grid-template-columns: 1fr; }\n  .opt { min-height: 56px; }\n  .q-nav .btn-dark { flex: 1; }\n  .scoreboard li { min-width: 0; padding-inline-end: 6px; font-size: 21px; }\n}\n\n/* ============ REDUCED MOTION ============ */\n@media (prefers-reduced-motion: reduce) {\n  .reveal { animation: none; stroke-dashoffset: 0; }\n  .route path, .route circle { transition: none; }\n  .pop { animation: none; }\n  /* Only the opacity fade on the result map remains */\n}\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
