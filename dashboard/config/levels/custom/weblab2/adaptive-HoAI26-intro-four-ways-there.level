        "3"
      ]
    }
  },
  "audit_log": "[{\"changed_at\":\"2026-10-20 18:32:27 +0000\",\"changed\":[],\"changed_by_id\":19429,\"changed_by_email\":\"liam.fryemason+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-20 18:33:15 +0000\",\"changed\":[],\"changed_by_id\":19429,\"changed_by_email\":\"liam.fryemason+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-23 00:04:12 +0000\",\"changed\":[\"ai_tutor_prompt_settings\"],\"changed_by_id\":19429,\"changed_by_email\":\"liam.fryemason+levelbuilder@code.org\"}]"
}]]></config>
