  "properties": {
    "encrypted": "false",
    "long_instructions": "#Update and Evolve an Object\r\n1. **Update the Object:** In the \"Update\" section, use dot notation or bracket notation to set update the object properties.\r\n2. **Add a Feature:** Create a new property on the object for an extra feature \r\n3. **Update the Screen:** Use AI to assist with creating a new HTML element to display your new property inside the `render()` function.\r\n4. **Test:** Run the code to verify the card shows the proper updates\r\n",
    "submittable": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
    "disable_edit_run_for_submission": "false",
    "ai_tutor_mode": "engineer",
    "predict_settings": {
