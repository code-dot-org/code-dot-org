      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>StepStreak</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <svg class=\"svg-defs\" aria-hidden=\"true\" focusable=\"false\">\n    <defs>\n      <linearGradient id=\"flame-gradient\" x1=\"0\" y1=\"1\" x2=\"0\" y2=\"0\">\n        <stop offset=\"0\" stop-color=\"#e63946\"/>\n        <stop offset=\"0.55\" stop-color=\"#ff8c00\"/>\n        <stop offset=\"1\" stop-color=\"#ffd23f\"/>\n      </linearGradient>\n    </defs>\n  </svg>\n\n  <main class=\"app\">\n    <div class=\"phone\">\n      <header class=\"app-header\">\n        <div class=\"header-top\">\n          <div class=\"brand\">\n            <h1 class=\"app-name\" id=\"app-name\"></h1>\n            <p class=\"greeting\" id=\"greeting\"></p>\n          </div>\n          <p class=\"streak-badge\" id=\"streak-badge\">\n            <span class=\"streak-icon\" id=\"streak-icon\"></span>\n            <span class=\"streak-count\" id=\"streak-count\"></span>\n          </p>\n        </div>\n        <p class=\"tagline\" id=\"tagline\"></p>\n        <svg class=\"header-waves\" viewBox=\"0 0 400 40\" preserveAspectRatio=\"none\" aria-hidden=\"true\" focusable=\"false\">\n          <path class=\"wave-back\" d=\"M0 18 C50 6 100 30 150 18 S250 6 300 18 S375 28 400 16 V40 H0 Z\"/>\n          <path class=\"wave-front\" d=\"M0 26 C50 14 100 38 150 26 S250 14 300 26 S375 36 400 24 V40 H0 Z\"/>\n        </svg>\n      </header>\n\n      <section class=\"panel week-panel\" aria-labelledby=\"week-heading\">\n        <h2 class=\"panel-heading\" id=\"week-heading\"></h2>\n        <p class=\"hint\" id=\"week-hint\"></p>\n        <div class=\"week\" id=\"week\" role=\"group\" aria-labelledby=\"week-heading\"></div>\n      </section>\n\n      <section class=\"panel result\" id=\"result\" aria-labelledby=\"result-heading\" hidden>\n        <h2 class=\"panel-heading\" id=\"result-heading\"></h2>\n        <p class=\"result-activity\" id=\"result-activity\"></p>\n        <dl class=\"stats\">\n          <div class=\"stat stat-steps\">\n            <dt>\n              <span class=\"stat-icon\" id=\"stat-steps-icon\"></span>\n              <span id=\"stat-steps-label\"></span>\n            </dt>\n            <dd id=\"stat-steps\"></dd>\n          </div>\n          <div class=\"stat stat-minutes\">\n            <dt>\n              <span class=\"stat-icon\" id=\"stat-minutes-icon\"></span>\n              <span id=\"stat-minutes-label\"></span>\n            </dt>\n            <dd id=\"stat-minutes\"></dd>\n          </div>\n          <div class=\"stat stat-floors\">\n            <dt>\n              <span class=\"stat-icon\" id=\"stat-floors-icon\"></span>\n              <span id=\"stat-floors-label\"></span>\n            </dt>\n            <dd id=\"stat-floors\"></dd>\n          </div>\n        </dl>\n        <div class=\"verdict\" id=\"verdict\">\n          <span class=\"verdict-icon\" id=\"verdict-icon\"></span>\n          <div class=\"verdict-text\">\n            <p class=\"verdict-title\" id=\"verdict-title\"></p>\n            <p class=\"verdict-message\">\n              <span id=\"verdict-message\"></span>\n              <span class=\"verdict-flame\" id=\"verdict-flame\"></span>\n            </p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"panel\" aria-labelledby=\"activity-heading\">\n        <h2 class=\"panel-heading\" id=\"activity-heading\"></h2>\n        <div class=\"activities\" id=\"activities\" role=\"group\" aria-labelledby=\"activity-heading\"></div>\n      </section>\n    </div>\n\n    <section class=\"ending\" id=\"ending\" aria-labelledby=\"ending-heading\" hidden>\n      <span class=\"ending-icon\" id=\"ending-icon\"></span>\n      <div>\n        <h2 class=\"ending-heading\" id=\"ending-heading\"></h2>\n        <p id=\"ending-message\"></p>\n      </div>\n    </section>\n\n    <p class=\"load-error\" id=\"load-error\" role=\"alert\">Sorry, this app didn't load. Try refreshing the page.</p>\n    <div class=\"visually-hidden\" id=\"announcer\" aria-live=\"polite\" aria-atomic=\"true\"></div>\n  </main>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "\"use strict\";\n\n/* ------------------------------------------------------------------\n   Student-facing text. Translate or edit wording here.\n   ------------------------------------------------------------------ */\nconst STRINGS = {\n  appName: \"StepStreak\",\n  greeting: \"Hi, Marisol!\",\n  tagline: \"Log your day to keep your streak going!\",\n  streakCount: (count) => `Streak: ${count}`,\n\n  weekHeading: \"This week\",\n  weekHint: \"Pick a day. Then pick what you did.\",\n  days: [\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\", \"Sunday\"],\n  daysShort: [\"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\", \"Sat\", \"Sun\"],\n  dayStatusEmpty: \"not logged yet\",\n  dayStatusActive: \"Active Day\",\n  dayStatusRest: \"Rest Day\",\n  dayButtonLabel: (day, status) => `${day}, ${status}`,\n\n  activityHeading: (day) => `What did you do on ${day}?`,\n  activities: {\n    swimming: \"Swimming practice (2 hours)\",\n    soccer: \"Soccer practice\",\n    running: \"Running\",\n    walking: \"Walking\",\n    biking: \"Biking\",\n    wheelchairBasketball: \"Wheelchair basketball\",\n    gaming: \"Gaming / hanging out\",\n    sick: \"Sick day\"\n  },\n\n  summaryHeading: (day) => `Your day: ${day}`,\n  statSteps: \"Steps\",\n  statWalkingMinutes: \"Walking minutes\",\n  statFloorsClimbed: \"Floors climbed\",\n\n  verdictActiveTitle: \"Active Day\",\n  verdictActiveMessage: \"Nice work! Streak +1\",\n  verdictRestTitle: \"Rest Day\",\n  verdictRestMessage: \"Take it easy! Your streak is paused.\",\n\n  resultAnnouncement: (day, activity, steps, minutes, floors, title, message) =>\n    `${day}: ${activity}. Steps: ${steps}. Walking minutes: ${minutes}. Floors climbed: ${floors}. ${title}. ${message}`,\n\n  endingHeading: \"Next step\",\n  endingMessage:\n    \"Write down what happened in your case file. Then go to the next level to look at the data behind this app.\"\n};\n\n/* ------------------------------------------------------------------\n   The app's decision rule.\n   Matches the AI Studio tree trained on Steps, Walking Minutes, and\n   Floors Climbed. If the tree splits differently, change it here.\n   Returns \"active\" or \"rest\".\n   ------------------------------------------------------------------ */\nfunction appVerdict(steps, walkingMinutes, floorsClimbed) {\n  return steps >= 6650 ? \"active\" : \"rest\";\n}\n\n/* ------------------------------------------------------------------\n   Activity data (Lesson 10 dataset averages).\n   ------------------------------------------------------------------ */\nconst ACTIVITIES = [\n  { id: \"swimming\", icon: \"swim\", steps: 2975, walkingMinutes: 19, floorsClimbed: 2 },\n  { id: \"soccer\", icon: \"soccer\", steps: 11614, walkingMinutes: 70, floorsClimbed: 7 },\n  { id: \"running\", icon: \"run\", steps: 13975, walkingMinutes: 94, floorsClimbed: 9 },\n  { id: \"walking\", icon: \"walk\", steps: 10407, walkingMinutes: 84, floorsClimbed: 9 },\n  { id: \"biking\", icon: \"bike\", steps: 3500, walkingMinutes: 24, floorsClimbed: 2 },\n  { id: \"wheelchairBasketball\", icon: \"wheelchair\", steps: 350, walkingMinutes: 0, floorsClimbed: 0 },\n  { id: \"gaming\", icon: \"gaming\", steps: 3433, walkingMinutes: 23, floorsClimbed: 2 },\n  { id: \"sick\", icon: \"sick\", steps: 860, walkingMinutes: 5, floorsClimbed: 1 }\n];\n\n/* The ending prompt appears once this many days are logged,\n   as long as one of them is this activity. */\nconst ENDING_MIN_DAYS = 4;\nconst ENDING_REQUIRED_ACTIVITY = \"swimming\";\n\n/* ------------------------------------------------------------------\n   Icons (24x24, built as inline SVG). Shapes are outlined unless\n   marked solid. A shape can also set its own fill.\n   ------------------------------------------------------------------ */\nconst ICONS = {\n  swim: [\n    [\"circle\", { cx: 17.5, cy: 6.5, r: 2.4, solid: true }],\n    [\"path\", { d: \"M3.5 13l5.5-5.5 3.5 3.5 4.5-2.5\" }],\n    [\"path\", { d: \"M2 16.5c1.7 0 1.7-1.5 3.3-1.5s1.7 1.5 3.4 1.5 1.7-1.5 3.3-1.5 1.7 1.5 3.3 1.5 1.7-1.5 3.4-1.5 1.6 1.5 3.3 1.5\" }],\n    [\"path\", { d: \"M2 20.5c1.7 0 1.7-1.5 3.3-1.5s1.7 1.5 3.4 1.5 1.7-1.5 3.3-1.5 1.7 1.5 3.3 1.5 1.7-1.5 3.4-1.5 1.6 1.5 3.3 1.5\" }]\n  ],\n  soccer: [\n    [\"circle\", { cx: 12, cy: 12, r: 9.5 }],\n    [\"path\", { d: \"M12 7.6l3.4 2.5-1.3 4h-4.2l-1.3-4z\", solid: true }],\n    [\"path\", { d: \"M12 7.6V2.5M15.4 10.1l4.8-1.6M14.1 14.1l3 4.2M9.9 14.1l-3 4.2M8.6 10.1L3.8 8.5\" }]\n  ],\n  run: [\n    [\"circle\", { cx: 15.5, cy: 4.5, r: 2.4, solid: true }],\n    [\"path\", { d: \"M13 8.5l-2.8 5.2 4 2.5-1.6 5.8\" }],\n    [\"path\", { d: \"M13 8.5l3.4 3.2 3.4-1.2M10.2 13.7l-4.7 1.6\" }],\n    [\"path\", { d: \"M2 8.5h4M2.8 11.5h3\" }]\n  ],\n  walk: [\n    [\"circle\", { cx: 12.5, cy: 4.5, r: 2.4, solid: true }],\n    [\"path\", { d: \"M12.5 8.5v5.5L10 21.5M12.5 14l3.5 7.5\" }],\n    [\"path\", { d: \"M12.5 9.5l-3.5 3.5M12.5 9.5l3.5 3\" }]\n  ],\n  bike: [\n    [\"circle\", { cx: 5.8, cy: 16, r: 4 }],\n    [\"circle\", { cx: 18.2, cy: 16, r: 4 }],\n    [\"path\", { d: \"M5.8 16l3.7-6.5h6.2l2.5 6.5M9.5 9.5L12 16H5.8M14 6.2h3l-1.3 3.3\" }],\n    [\"circle\", { cx: 12, cy: 16, r: 1.3, solid: true }]\n  ],\n  wheelchair: [\n    [\"circle\", { cx: 8.5, cy: 3.8, r: 2.2, solid: true }],\n    [\"path\", { d: \"M8.5 7.2v5.3h5.2l2.6 5\" }],\n    [\"path\", { d: \"M6.2 10.3a5.4 5.4 0 1 0 6.6 7.9\" }],\n    [\"circle\", { cx: 19, cy: 6, r: 2.8, solid: true }]\n  ],\n  gaming: [\n    [\"path\", { d: \"M7 7h10a5 5 0 0 1 5 5v1.5a4 4 0 0 1-7.2 2.4L14 15h-4l-.8.9A4 4 0 0 1 2 13.5V12a5 5 0 0 1 5-5z\" }],\n    [\"path\", { d: \"M7.5 9.8v4M5.5 11.8h4\" }],\n    [\"circle\", { cx: 16.2, cy: 10.6, r: 1.2, solid: true }],\n    [\"circle\", { cx: 18.4, cy: 13, r: 1.2, solid: true }]\n  ],\n  sick: [\n    [\"path\", { d: \"M10 14.3V4.5a2 2 0 0 1 4 0v9.8a4.2 4.2 0 1 1-4 0z\" }],\n    [\"circle\", { cx: 12, cy: 17.7, r: 2, solid: true }],\n    [\"path\", { d: \"M12 15.5V8.5\" }],\n    [\"path\", { d: \"M17 5.5h3M17 9h2\" }]\n  ],\n  check: [[\"path\", { d: \"M5 12.5l4.5 4.5L19 7.5\", \"stroke-width\": 3.2 }]],\n  moon: [\n    [\"path\", { d: \"M19.5 14.5A8 8 0 1 1 9.5 4.5a6.5 6.5 0 0 0 10 10z\", solid: true }],\n    [\"circle\", { cx: 18, cy: 5, r: 1, solid: true }]\n  ],\n  empty: [[\"circle\", { cx: 12, cy: 12, r: 7.5, \"stroke-dasharray\": \"3 3\" }]],\n  flame: [\n    [\n      \"path\",\n      {\n        d: \"M12 1.5c1.2 3.8 6.5 6 6.5 12.2a6.5 6.5 0 0 1-13 0c0-3.4 1.7-5.2 3-6.9.5 2.3 1.7 3.4 2.9 3.4 0-3.4-1-6.2.6-8.7z\",\n        fill: \"url(#flame-gradient)\",\n        stroke: \"none\"\n      }\n    ],\n    [\"path\", { d: \"M12 12.5c.8 1.8 3 2.8 3 5.4a3 3 0 0 1-6 0c0-1.9 1.5-2.9 3-5.4z\", fill: \"#fff3b0\", stroke: \"none\" }]\n  ],\n  steps: [\n    [\"ellipse\", { cx: 8.3, cy: 8.5, rx: 2.6, ry: 4.2, solid: true }],\n    [\"ellipse\", { cx: 8.6, cy: 15.6, rx: 1.8, ry: 1.4, solid: true }],\n    [\"ellipse\", { cx: 15.7, cy: 11.5, rx: 2.6, ry: 4.2, solid: true }],\n    [\"ellipse\", { cx: 15.4, cy: 18.6, rx: 1.8, ry: 1.4, solid: true }]\n  ],\n  clock: [\n    [\"circle\", { cx: 12, cy: 12, r: 9 }],\n    [\"path\", { d: \"M12 7v5l3.5 2.2\" }]\n  ],\n  stairs: [[\"path\", { d: \"M3 20.5h5v-5h4.5v-5H17v-5h4\", \"stroke-width\": 2.6 }]],\n  notebook: [\n    [\"rect\", { x: 5, y: 3, width: 14, height: 18, rx: 2 }],\n    [\"path\", { d: \"M9 8h6M9 12h6M9 16h3\" }],\n    [\"path\", { d: \"M3 7h3M3 12h3M3 17h3\" }]\n  ]\n};\n\nconst SVG_NS = \"http://www.w3.org/2000/svg\";\n\nfunction createIcon(name) {\n  const svg = document.createElementNS(SVG_NS, \"svg\");\n  svg.setAttribute(\"viewBox\", \"0 0 24 24\");\n  svg.setAttribute(\"fill\", \"none\");\n  svg.setAttribute(\"stroke\", \"currentColor\");\n  svg.setAttribute(\"stroke-width\", \"2.2\");\n  svg.setAttribute(\"stroke-linecap\", \"round\");\n  svg.setAttribute(\"stroke-linejoin\", \"round\");\n  svg.setAttribute(\"aria-hidden\", \"true\");\n  svg.setAttribute(\"focusable\", \"false\");\n\n  ICONS[name].forEach(([tag, attrs]) => {\n    const shape = document.createElementNS(SVG_NS, tag);\n    Object.entries(attrs).forEach(([key, value]) => {\n      if (key === \"solid\") {\n        shape.setAttribute(\"fill\", \"currentColor\");\n        shape.setAttribute(\"stroke\", \"none\");\n      } else {\n        shape.setAttribute(key, String(value));\n      }\n    });\n    svg.appendChild(shape);\n  });\n  return svg;\n}\n\nfunction setIcon(container, name) {\n  container.textContent = \"\";\n  container.appendChild(createIcon(name));\n}\n\n/* ------------------------------------------------------------------\n   State (in memory only).\n   ------------------------------------------------------------------ */\nconst state = {\n  week: new Array(7).fill(null), // activity id logged for each day, or null\n  selectedDay: 0,\n  endingShown: false\n};\n\nconst numberFormat = new Intl.NumberFormat(document.documentElement.lang || undefined);\nconst els = {};\n\nfunction getActivity(id) {\n  return ACTIVITIES.find((activity) => activity.id === id);\n}\n\nfunction verdictFor(activity) {\n  return appVerdict(activity.steps, activity.walkingMinutes, activity.floorsClimbed);\n}\n\nfunction dayVerdict(dayIndex) {\n  const id = state.week[dayIndex];\n  return id ? verdictFor(getActivity(id)) : null;\n}\n\nfunction streakCount() {\n  return state.week.filter((_, index) => dayVerdict(index) === \"active\").length;\n}\n\n/* ------------------------------------------------------------------\n   Rendering\n   ------------------------------------------------------------------ */\nfunction renderStaticText() {\n  document.title = STRINGS.appName;\n  els.appName.textContent = STRINGS.appName;\n  els.greeting.textContent = STRINGS.greeting;\n  els.tagline.textContent = STRINGS.tagline;\n  els.weekHeading.textContent = STRINGS.weekHeading;\n  els.weekHint.textContent = STRINGS.weekHint;\n  els.statStepsLabel.textContent = STRINGS.statSteps;\n  els.statMinutesLabel.textContent = STRINGS.statWalkingMinutes;\n  els.statFloorsLabel.textContent = STRINGS.statFloorsClimbed;\n  els.endingHeading.textContent = STRINGS.endingHeading;\n  els.endingMessage.textContent = STRINGS.endingMessage;\n  setIcon(els.streakIcon, \"flame\");\n  setIcon(els.verdictFlame, \"flame\");\n  setIcon(els.statStepsIcon, \"steps\");\n  setIcon(els.statMinutesIcon, \"clock\");\n  setIcon(els.statFloorsIcon, \"stairs\");\n  setIcon(els.endingIcon, \"notebook\");\n}\n\nfunction buildWeek() {\n  STRINGS.days.forEach((day, index) => {\n    const button = document.createElement(\"button\");\n    button.type = \"button\";\n    button.className = \"day\";\n    button.dataset.day = String(index);\n\n    const name = document.createElement(\"span\");\n    name.className = \"day-name\";\n    name.textContent = STRINGS.daysShort[index];\n\n    const icon = document.createElement(\"span\");\n    icon.className = \"day-icon\";\n\n    button.append(name, icon);\n    button.addEventListener(\"click\", () => selectDay(index));\n    els.week.appendChild(button);\n  });\n}\n\nfunction buildActivities() {\n  ACTIVITIES.forEach((activity) => {\n    const button = document.createElement(\"button\");\n    button.type = \"button\";\n    button.className = `activity tile-${activity.icon}`;\n\n    const icon = document.createElement(\"span\");\n    icon.className = \"activity-icon\";\n    setIcon(icon, activity.icon);\n\n    const label = document.createElement(\"span\");\n    label.textContent = STRINGS.activities[activity.id];\n\n    button.append(icon, label);\n    button.addEventListener(\"click\", () => logActivity(activity.id));\n    els.activities.appendChild(button);\n  });\n}\n\nfunction renderWeek() {\n  const buttons = els.week.querySelectorAll(\".day\");\n  buttons.forEach((button, index) => {\n    const verdict = dayVerdict(index);\n    let status = STRINGS.dayStatusEmpty;\n    let iconName = \"empty\";\n\n    button.classList.remove(\"day-empty\", \"day-active\", \"day-rest\");\n    if (verdict === \"active\") {\n      status = STRINGS.dayStatusActive;\n      iconName = \"check\";\n      button.classList.add(\"day-active\");\n    } else if (verdict === \"rest\") {\n      status = STRINGS.dayStatusRest;\n      iconName = \"moon\";\n      button.classList.add(\"day-rest\");\n    } else {\n      button.classList.add(\"day-empty\");\n    }\n\n    setIcon(button.querySelector(\".day-icon\"), iconName);\n    button.setAttribute(\"aria-label\", STRINGS.dayButtonLabel(STRINGS.days[index], status));\n    button.setAttribute(\"aria-pressed\", index === state.selectedDay ? \"true\" : \"false\");\n  });\n\n  const count = streakCount();\n  els.streakCount.textContent = STRINGS.streakCount(count);\n  els.activityHeading.textContent = STRINGS.activityHeading(STRINGS.days[state.selectedDay]);\n}\n\nfunction renderResult(dayIndex) {\n  const activity = getActivity(state.week[dayIndex]);\n  const verdict = verdictFor(activity);\n  const isActive = verdict === \"active\";\n  const day = STRINGS.days[dayIndex];\n  const steps = numberFormat.format(activity.steps);\n  const minutes = numberFormat.format(activity.walkingMinutes);\n  const floors = numberFormat.format(activity.floorsClimbed);\n  const title = isActive ? STRINGS.verdictActiveTitle : STRINGS.verdictRestTitle;\n  const message = isActive ? STRINGS.verdictActiveMessage : STRINGS.verdictRestMessage;\n\n  els.resultHeading.textContent = STRINGS.summaryHeading(day);\n  els.resultActivity.textContent = STRINGS.activities[activity.id];\n  els.statSteps.textContent = steps;\n  els.statMinutes.textContent = minutes;\n  els.statFloors.textContent = floors;\n\n  els.verdict.className = isActive ? \"verdict verdict-active\" : \"verdict verdict-rest\";\n  setIcon(els.verdictIcon, isActive ? \"check\" : \"moon\");\n  els.verdictTitle.textContent = title;\n  els.verdictMessage.textContent = message;\n  els.verdictFlame.hidden = !isActive;\n\n  // Re-trigger the entrance animation.\n  els.result.hidden = true;\n  void els.result.offsetWidth;\n  els.result.hidden = false;\n  els.result.scrollIntoView({ block: \"nearest\" });\n\n  return STRINGS.resultAnnouncement(\n    day,\n    STRINGS.activities[activity.id],\n    steps,\n    minutes,\n    floors,\n    title,\n    message\n  );\n}\n\nfunction shouldShowEnding() {\n  const loggedDays = state.week.filter((id) => id !== null).length;\n  return loggedDays >= ENDING_MIN_DAYS && state.week.indexOf(ENDING_REQUIRED_ACTIVITY) !== -1;\n}\n\nfunction announce(text) {\n  els.announcer.textContent = \"\";\n  window.setTimeout(() => {\n    els.announcer.textContent = text;\n  }, 50);\n}\n\n/* ------------------------------------------------------------------\n   Actions\n   ------------------------------------------------------------------ */\nfunction selectDay(index) {\n  state.selectedDay = index;\n  renderWeek();\n}\n\nfunction nextEmptyDay(fromIndex) {\n  for (let step = 1; step <= 7; step += 1) {\n    const index = (fromIndex + step) % 7;\n    if (state.week[index] === null) {\n      return index;\n    }\n  }\n  return fromIndex;\n}\n\nfunction popStreakBadge() {\n  els.streakBadge.classList.remove(\"streak-pop\");\n  void els.streakBadge.offsetWidth;\n  els.streakBadge.classList.add(\"streak-pop\");\n}\n\nfunction logActivity(activityId) {\n  const dayIndex = state.selectedDay;\n  const previousStreak = streakCount();\n  state.week[dayIndex] = activityId;\n\n  let announcement = renderResult(dayIndex);\n\n  if (!state.endingShown && shouldShowEnding()) {\n    state.endingShown = true;\n    els.ending.hidden = false;\n    announcement = `${announcement} ${STRINGS.endingMessage}`;\n  }\n\n  state.selectedDay = nextEmptyDay(dayIndex);\n  renderWeek();\n  if (streakCount() > previousStreak) {\n    popStreakBadge();\n  }\n  announce(announcement);\n}\n\n/* ------------------------------------------------------------------\n   Startup\n   ------------------------------------------------------------------ */\nfunction cacheElements() {\n  const ids = {\n    appName: \"app-name\",\n    greeting: \"greeting\",\n    tagline: \"tagline\",\n    streakIcon: \"streak-icon\",\n    streakCount: \"streak-count\",\n    weekHeading: \"week-heading\",\n    weekHint: \"week-hint\",\n    week: \"week\",\n    result: \"result\",\n    resultHeading: \"result-heading\",\n    resultActivity: \"result-activity\",\n    statStepsLabel: \"stat-steps-label\",\n    statMinutesLabel: \"stat-minutes-label\",\n    statFloorsLabel: \"stat-floors-label\",\n    statStepsIcon: \"stat-steps-icon\",\n    statMinutesIcon: \"stat-minutes-icon\",\n    statFloorsIcon: \"stat-floors-icon\",\n    endingIcon: \"ending-icon\",\n    streakBadge: \"streak-badge\",\n    statSteps: \"stat-steps\",\n    statMinutes: \"stat-minutes\",\n    statFloors: \"stat-floors\",\n    verdict: \"verdict\",\n    verdictIcon: \"verdict-icon\",\n    verdictTitle: \"verdict-title\",\n    verdictMessage: \"verdict-message\",\n    verdictFlame: \"verdict-flame\",\n    activityHeading: \"activity-heading\",\n    activities: \"activities\",\n    ending: \"ending\",\n    endingHeading: \"ending-heading\",\n    endingMessage: \"ending-message\",\n    announcer: \"announcer\",\n    loadError: \"load-error\"\n  };\n  Object.entries(ids).forEach(([key, id]) => {\n    els[key] = document.getElementById(id);\n    if (!els[key]) {\n      throw new Error(`Missing element #${id}`);\n    }\n  });\n}\n\nfunction init() {\n  cacheElements();\n  renderStaticText();\n  buildWeek();\n  buildActivities();\n  renderWeek();\n  els.loadError.hidden = true;\n}\n\ntry {\n  init();\n} catch (error) {\n  console.error(error);\n}",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": ":root {\n  /* Base */\n  --color-page: #d7f3fa;\n  --color-surface: #ffffff;\n  --color-text: #13213a;\n  --color-muted: #47566b;\n  --color-border: #cbdbe7;\n\n  /* Pool */\n  --color-navy: #0f2d5c;\n  --color-navy-light: #1b4f8f;\n  --color-aqua: #00b4d8;\n  --color-aqua-soft: #e3f8fd;\n  --color-foam: #9fe8f7;\n\n  /* Verdicts */\n  --color-active: #157a3a;\n  --color-active-deep: #0f5f2c;\n  --color-active-soft: #dcf6e4;\n  --color-rest: #4a5868;\n  --color-rest-deep: #333f4c;\n  --color-rest-soft: #e7ebf0;\n\n  /* Streak */\n  --color-flame-text: #b3360a;\n  --color-sun: #ffd23f;\n\n  /* Activity tiles (white icons on these all pass 3:1) */\n  --tile-swim: #0077b6;\n  --tile-soccer: #2b8a3e;\n  --tile-run: #d9480f;\n  --tile-walk: #7b2cbf;\n  --tile-bike: #a86400;\n  --tile-wheelchair: #c2185b;\n  --tile-gaming: #4c1d95;\n  --tile-sick: #3d6670;\n\n  /* Stats */\n  --stat-steps: #0077b6;\n  --stat-minutes: #7b2cbf;\n  --stat-floors: #d9480f;\n\n  --radius-phone: 28px;\n  --radius-chip: 16px;\n  --font-body: system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  background-color: var(--color-page);\n  background-image: radial-gradient(circle at 20% 10%, #f1fcff 0, rgba(241, 252, 255, 0) 45%),\n    radial-gradient(circle at 90% 90%, #b8ecf7 0, rgba(184, 236, 247, 0) 50%);\n  color: var(--color-text);\n  font-family: var(--font-body);\n  font-size: 1rem;\n  line-height: 1.4;\n}\n\nh1,\nh2,\np,\ndl,\ndd {\n  margin: 0;\n}\n\n.svg-defs {\n  position: absolute;\n  width: 0;\n  height: 0;\n  overflow: hidden;\n}\n\n.app {\n  max-width: 480px;\n  margin-inline: auto;\n  padding: 12px;\n}\n\n.phone {\n  background: var(--color-surface);\n  border: 3px solid var(--color-navy);\n  border-radius: var(--radius-phone);\n  box-shadow: 0 8px 0 var(--color-navy);\n  overflow: hidden;\n}\n\n/* Header */\n\n.app-header {\n  position: relative;\n  padding: 18px 18px 40px;\n  background: linear-gradient(160deg, var(--color-navy-light) 0%, var(--color-navy) 70%);\n  color: #ffffff;\n}\n\n.header-top {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px 12px;\n}\n\n.app-name {\n  font-size: 1.85rem;\n  font-weight: 900;\n  font-style: italic;\n  letter-spacing: -0.02em;\n  line-height: 1;\n  text-shadow: 3px 3px 0 var(--color-aqua);\n}\n\n.greeting {\n  margin-block-start: 6px;\n  font-size: 1.05rem;\n  font-weight: 600;\n}\n\n.tagline {\n  margin-block-start: 10px;\n  color: var(--color-foam);\n  font-weight: 700;\n}\n\n.streak-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 4px 14px 4px 6px;\n  border-radius: 999px;\n  background: #ffffff;\n  border: 3px solid var(--color-sun);\n  color: var(--color-flame-text);\n  font-weight: 900;\n  font-size: 1.15rem;\n}\n\n.streak-icon svg {\n  display: block;\n  width: 34px;\n  height: 34px;\n}\n\n.streak-pop {\n  animation: streak-pop 0.5s ease-out;\n}\n\n.header-waves {\n  position: absolute;\n  inset-inline: 0;\n  bottom: -1px;\n  width: 100%;\n  height: 32px;\n}\n\n.wave-back {\n  fill: var(--color-aqua);\n  opacity: 0.55;\n}\n\n.wave-front {\n  fill: var(--color-surface);\n}\n\n/* Panels */\n\n.panel {\n  padding: 16px 18px;\n}\n\n.panel + .panel {\n  border-top: 2px dashed var(--color-border);\n}\n\n.panel-heading {\n  font-size: 1.15rem;\n  font-weight: 800;\n  color: var(--color-navy);\n  margin-block-end: 4px;\n}\n\n.hint {\n  color: var(--color-muted);\n  font-size: 0.95rem;\n  margin-block-end: 10px;\n}\n\n.week-panel {\n  padding-block-start: 6px;\n}\n\n/* Week tracker */\n\n.week {\n  display: grid;\n  grid-template-columns: repeat(7, minmax(0, 1fr));\n  gap: 6px;\n}\n\n.day {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 4px;\n  min-height: 68px;\n  padding: 7px 2px 6px;\n  border: 2px solid var(--color-border);\n  border-radius: var(--radius-chip);\n  background: var(--color-surface);\n  color: var(--color-text);\n  font: inherit;\n  font-size: 0.85rem;\n  font-weight: 800;\n  cursor: pointer;\n  overflow-wrap: anywhere;\n  transition: transform 0.1s ease-out;\n}\n\n.day:active {\n  transform: translateY(2px);\n}\n\n.day-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 30px;\n  height: 30px;\n  border-radius: 50%;\n}\n\n.day-icon svg {\n  width: 20px;\n  height: 20px;\n}\n\n.day-empty .day-icon {\n  color: var(--color-muted);\n}\n\n.day-active {\n  background: var(--color-active-soft);\n  border-color: var(--color-active);\n}\n\n.day-active .day-icon {\n  background: var(--color-active);\n  color: #ffffff;\n}\n\n.day-rest {\n  background: var(--color-rest-soft);\n  border-color: var(--color-rest);\n}\n\n.day-rest .day-icon {\n  background: var(--color-rest);\n  color: #ffffff;\n}\n\n.day[aria-pressed=\"true\"] {\n  border-color: var(--color-navy);\n  box-shadow: 0 0 0 3px var(--color-aqua);\n  transform: translateY(-3px);\n}\n\n.day[aria-pressed=\"true\"] .day-name {\n  color: var(--color-navy);\n  text-decoration: underline;\n  text-decoration-thickness: 3px;\n  text-decoration-color: var(--color-aqua);\n  text-underline-offset: 3px;\n}\n\n/* Activity picker */\n\n.activities {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 10px;\n  margin-block-start: 10px;\n}\n\n.activity {\n  --tile: var(--color-navy);\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  min-height: 60px;\n  padding: 8px 10px;\n  border: 2px solid var(--tile);\n  border-bottom-width: 5px;\n  border-radius: var(--radius-chip);\n  background: var(--color-surface);\n  color: var(--color-text);\n  font: inherit;\n  font-size: 0.95rem;\n  font-weight: 700;\n  text-align: start;\n  cursor: pointer;\n  transition: transform 0.1s ease-out;\n}\n\n.activity:hover {\n  background: var(--color-aqua-soft);\n}\n\n.activity:active {\n  transform: translateY(3px);\n}\n\n.activity-icon {\n  flex: none;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 40px;\n  height: 40px;\n  border-radius: 12px;\n  background: var(--tile);\n  color: #ffffff;\n  transform: rotate(-6deg);\n}\n\n.activity-icon svg {\n  width: 26px;\n  height: 26px;\n  transform: rotate(6deg);\n}\n\n.tile-swim {\n  --tile: var(--tile-swim);\n}\n\n.tile-soccer {\n  --tile: var(--tile-soccer);\n}\n\n.tile-run {\n  --tile: var(--tile-run);\n}\n\n.tile-walk {\n  --tile: var(--tile-walk);\n}\n\n.tile-bike {\n  --tile: var(--tile-bike);\n}\n\n.tile-wheelchair {\n  --tile: var(--tile-wheelchair);\n}\n\n.tile-gaming {\n  --tile: var(--tile-gaming);\n}\n\n.tile-sick {\n  --tile: var(--tile-sick);\n}\n\n/* Result card */\n\n.result {\n  background: var(--color-aqua-soft);\n  animation: result-in 0.25s ease-out;\n}\n\n.result-activity {\n  color: var(--color-muted);\n  font-weight: 700;\n  margin-block-end: 12px;\n}\n\n.stats {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 8px;\n}\n\n.stat {\n  --stat: var(--color-navy);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: space-between;\n  gap: 2px;\n  padding: 10px 6px 12px;\n  border-radius: var(--radius-chip);\n  border-top: 5px solid var(--stat);\n  background: var(--color-surface);\n  text-align: center;\n}\n\n.stat-steps {\n  --stat: var(--stat-steps);\n}\n\n.stat-minutes {\n  --stat: var(--stat-minutes);\n}\n\n.stat-floors {\n  --stat: var(--stat-floors);\n}\n\n.stat dt {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 2px;\n  font-size: 0.85rem;\n  font-weight: 600;\n  color: var(--color-muted);\n}\n\n.stat-icon {\n  color: var(--stat);\n}\n\n.stat-icon svg {\n  display: block;\n  width: 24px;\n  height: 24px;\n}\n\n.stat dd {\n  font-size: 1.45rem;\n  font-weight: 900;\n  color: var(--color-text);\n}\n\n.verdict {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-block-start: 12px;\n  padding: 12px 14px;\n  border-radius: var(--radius-chip);\n  color: #ffffff;\n}\n\n.verdict-icon {\n  flex: none;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 48px;\n  height: 48px;\n  border-radius: 50%;\n  background: #ffffff;\n}\n\n.verdict-icon svg {\n  width: 30px;\n  height: 30px;\n}\n\n.verdict-title {\n  font-size: 1.3rem;\n  font-weight: 900;\n  font-style: italic;\n}\n\n.verdict-message {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 4px;\n  font-weight: 600;\n}\n\n.verdict-flame svg {\n  display: block;\n  width: 24px;\n  height: 24px;\n}\n\n.verdict-active {\n  background: linear-gradient(135deg, var(--color-active) 0%, var(--color-active-deep) 100%);\n  box-shadow: 0 4px 0 var(--color-active-deep);\n}\n\n.verdict-active .verdict-icon {\n  color: var(--color-active);\n}\n\n.verdict-rest {\n  background: linear-gradient(135deg, var(--color-rest) 0%, var(--color-rest-deep) 100%);\n  box-shadow: 0 4px 0 var(--color-rest-deep);\n}\n\n.verdict-rest .verdict-icon {\n  color: var(--color-rest);\n}\n\n/* Ending prompt */\n\n.ending {\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n  margin-block-start: 18px;\n  padding: 14px 16px;\n  border: 2px solid #b58a00;\n  border-radius: 6px;\n  background: #fff6c9;\n  box-shadow: 4px 4px 0 #b58a00;\n  transform: rotate(-1deg);\n}\n\n.ending-icon {\n  flex: none;\n  color: #8a5a00;\n}\n\n.ending-icon svg {\n  display: block;\n  width: 30px;\n  height: 30px;\n}\n\n.ending-heading {\n  font-size: 1.1rem;\n  font-weight: 800;\n  margin-block-end: 4px;\n}\n\n/* Shared */\n\nbutton:focus-visible {\n  outline: 3px solid var(--color-navy);\n  outline-offset: 3px;\n}\n\n.load-error {\n  margin-block-start: 12px;\n  padding: 12px;\n  border-radius: 12px;\n  background: var(--color-surface);\n  font-weight: 600;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n[hidden] {\n  display: none !important;\n}\n\n@keyframes result-in {\n  from {\n    opacity: 0;\n    transform: translateY(6px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@keyframes streak-pop {\n  0% {\n    transform: scale(1);\n  }\n  40% {\n    transform: scale(1.25) rotate(-4deg);\n  }\n  100% {\n    transform: scale(1);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .result,\n  .streak-pop {\n    animation: none;\n  }\n\n  .day,\n  .activity {\n    transition: none;\n  }\n\n  .day[aria-pressed=\"true\"] {\n    transform: none;\n  }\n}\n\n@media (max-width: 360px) {\n  .day {\n    font-size: 0.75rem;\n  }\n\n  .activities {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    },
    "thumbnail_url": "https://images.code.org/d7ebca61dfefa8f83b2c886db2f687c6-StepSteak-2.jpg"
  },
  "audit_log": "[{\"changed_at\":\"2026-11-04 19:43:27 +0000\",\"changed\":[\"long_instructions\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-11-04 19:45:29 +0000\",\"changed\":[],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-11-04 19:46:59 +0000\",\"changed\":[],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-11-04 20:09:57 +0000\",\"changed\":[\"start_sources\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-11-04 20:10:23 +0000\",\"changed\":[\"widget_view\",\"require_edit_to_continue\",\"ai_tutor_prompt_settings\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-11-04 20:32:29 +0000\",\"changed\":[\"bubble_choice_description\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-11-04 20:33:57 +0000\",\"changed\":[\"bubble_choice_description\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-11-05 15:54:05 +0000\",\"changed\":[\"thumbnail_url\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"}]"
}]]></config>
