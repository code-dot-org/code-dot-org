      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Pizza Order</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <main class=\"app\">\n    <section class=\"order-card\">\n      <p class=\"eyebrow\">Online Ordering</p>\n      <h1>Build Your Pizza</h1>\n      <p class=\"subtitle\">\n        Choose your size and topping, then place your order.\n      </p>\n\n      <div class=\"form-group\">\n        <label for=\"sizeSelect\">Choose Size</label>\n        <select id=\"sizeSelect\">\n          <option value=\"Small\">Small</option>\n          <option value=\"Medium\">Medium</option>\n          <option value=\"Large\">Large</option>\n        </select>\n      </div>\n\n      <div class=\"form-group\">\n        <label for=\"toppingSelect\">Choose Topping</label>\n        <select id=\"toppingSelect\">\n          <option value=\"Pepperoni\">Pepperoni</option>\n          <option value=\"Olives\">Olives</option>\n          <option value=\"Veggies\">Veggies</option>\n        </select>\n      </div>\n\n      <button id=\"orderBtn\">Place Order</button>\n\n      <div class=\"summary-box\">\n        <p class=\"summary-label\">Order Summary</p>\n        <p id=\"output\">Your pizza order will appear here.</p>\n      </div>\n    </section>\n  </main>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// --- SELECT ELEMENTS ---\nconst sizeSelect = document.getElementById(\"sizeSelect\");\nconst toppingSelect = document.getElementById(\"toppingSelect\");\nconst orderBtn = document.getElementById(\"orderBtn\");\nconst outputElement = document.getElementById(\"output\");\n\n// --- FUNCTION WITH PARAMETERS ---\n\n\n\n\n\n// --- EVENT LISTENER ---\norderBtn.addEventListener(\"click\", () => {\n  const selectedSize = sizeSelect.value;\n  const selectedTopping = toppingSelect.value;\n  orderPizza(selectedSize, selectedTopping);\n});\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  font-family: Arial, sans-serif;\n  background: #f7f3ee;\n  color: #2b2b2b;\n}\n\n.app {\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 24px;\n}\n\n.order-card {\n  width: 100%;\n  max-width: 430px;\n  background: #ffffff;\n  border-radius: 18px;\n  padding: 28px;\n  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);\n}\n\n.eyebrow {\n  margin: 0 0 8px;\n  font-size: 12px;\n  font-weight: bold;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  color: #c4572e;\n}\n\nh1 {\n  margin: 0 0 8px;\n  font-size: 32px;\n}\n\n.subtitle {\n  margin: 0 0 24px;\n  color: #666;\n  line-height: 1.5;\n}\n\n.form-group {\n  margin-bottom: 18px;\n}\n\nlabel {\n  display: block;\n  margin-bottom: 8px;\n  font-weight: bold;\n  font-size: 14px;\n}\n\nselect {\n  width: 100%;\n  padding: 12px 14px;\n  font-size: 16px;\n  border: 1px solid #d8d8d8;\n  border-radius: 10px;\n  background: #fffdfb;\n}\n\nbutton {\n  width: 100%;\n  margin-top: 8px;\n  padding: 12px 16px;\n  font-size: 16px;\n  font-weight: bold;\n  border: none;\n  border-radius: 10px;\n  cursor: pointer;\n  background: #c4572e;\n  color: white;\n}\n\nbutton:hover {\n  background: #a94722;\n}\n\n.summary-box {\n  margin-top: 22px;\n  padding: 16px;\n  background: #fff4ec;\n  border-radius: 12px;\n}\n\n.summary-label {\n  margin: 0 0 8px;\n  font-size: 12px;\n  font-weight: bold;\n  text-transform: uppercase;\n  letter-spacing: 0.8px;\n  color: #9a4a2d;\n}\n\n#output {\n  margin: 0;\n  font-size: 18px;\n  font-weight: bold;\n  line-height: 1.4;\n}",
          "folderId": "0",
          "active": false
        },
        "4": {
