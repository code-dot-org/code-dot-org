<Weblab2>
  <config><![CDATA[{
  "published": true,
  "game_id": 74,
  "created_at": "2026-10-16T21:20:44.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": "true",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Prompt to Page</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"app\" data-destination=\"bake-sale\">\n    <h1 class=\"visually-hidden\">Prompt to Page</h1>\n    <p id=\"app-error\" class=\"app-error\" role=\"alert\" hidden></p>\n\n    <!-- Author preview only. script.js shows this when CONFIG.showDestinationPicker is true. -->\n    <div id=\"preview-bar\" class=\"preview-bar\" hidden>\n      <label class=\"overline\" for=\"destination-select\">Example Site Type</label>\n      <span class=\"select-wrap\">\n        <select id=\"destination-select\" class=\"select\"></select>\n        <svg class=\"select-chevron\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n          <path d=\"M6 9l6 6 6-6\"></path>\n        </svg>\n      </span>\n    </div>\n\n    <div class=\"workspace\">\n      <!-- Prompt card -->\n      <section class=\"card prompt-card\" aria-labelledby=\"prompt-heading\">\n        <header class=\"card-header\">\n          <h2 id=\"prompt-heading\" class=\"overline\">Sample prompt</h2>\n          <button id=\"reset-button\" class=\"outline-button header-action\" type=\"button\">Reset</button>\n        </header>\n        <div class=\"card-body\">\n          <div class=\"prompt-well\">\n            <p id=\"prompt-text\" class=\"prompt-text\"></p>\n            <p id=\"prompt-ghost\" class=\"prompt-text prompt-ghost\" aria-hidden=\"true\"></p>\n          </div>\n\n          <fieldset class=\"chip-set\">\n            <legend class=\"visually-hidden\">Tap a chip, then choose a detail</legend>\n            <div id=\"chip-grid\" class=\"chip-grid\"></div>\n          </fieldset>\n\n          <div id=\"options\" class=\"options\">\n            <p id=\"options-empty\" class=\"options-empty\">Pick a chip to see your options.</p>\n            <div id=\"options-body\" class=\"options-body\" role=\"group\" aria-labelledby=\"options-title\" hidden>\n              <p id=\"options-title\" class=\"options-title\"></p>\n              <div id=\"option-row\" class=\"option-row\"></div>\n            </div>\n          </div>\n\n        </div>\n      </section>\n\n      <!-- Spark between prompt and page -->\n      <div class=\"spark-zone\" aria-hidden=\"true\">\n        <span class=\"spark-line\"></span>\n        <span id=\"spark\" class=\"spark\">\n          <span class=\"spark-ring\"></span>\n          <svg class=\"spark-core\" viewBox=\"0 0 24 24\" focusable=\"false\">\n            <path d=\"M12 2c.6 5.4 4.6 9.4 10 10-5.4.6-9.4 4.6-10 10-.6-5.4-4.6-9.4-10-10 5.4-.6 9.4-4.6 10-10z\"></path>\n          </svg>\n        </span>\n        <span class=\"spark-line\"></span>\n      </div>\n\n      <!-- Sample page card -->\n      <section class=\"card page-card\" aria-labelledby=\"page-heading\">\n        <header class=\"card-header\">\n          <h2 id=\"page-heading\" class=\"overline\">Sample page: <span id=\"dest-label\"></span></h2>\n        </header>\n        <div class=\"card-body\">\n          <div id=\"page-frame\" class=\"page-frame\" role=\"img\">\n            <span id=\"sample-page\" class=\"sp\"></span>\n          </div>\n\n          <section class=\"effects-section\" aria-labelledby=\"effects-heading\">\n            <h3 id=\"effects-heading\" class=\"overline effects-heading\">What each detail did</h3>\n            <ul id=\"effects\" class=\"effects\"></ul>\n          </section>\n        </div>\n      </section>\n    </div>\n\n    <p id=\"announcer\" class=\"visually-hidden\" aria-live=\"polite\"></p>\n  </main>\n</body>\n</html>\n",
          "folderId": "0",
          "active": true
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "const CONFIG = {\n  defaultDestination: \"bake-sale\",\n  // Shows a dropdown above the cards so an author can preview each destination.\n  // Set to false when the widget ships inside a lesson; the destination then\n  // comes from ?destination=... in the URL or data-destination on <main>.\n  showDestinationPicker: true,\n  popVolume: 0.06,\n  popMs: 600,\n  newBitMs: 400,\n  flashMs: 1800,\n  rowMs: 1200\n};\n\nconst SVG_NS = \"http://www.w3.org/2000/svg\";\n\n// The four kinds of detail a student can add to a prompt.\n// who = the headline and intro words, feel = color and style,\n// parts = the pieces on the page, content = the words and numbers.\nconst LAYERS = [\n  {\n    id: \"who\",\n    label: \"Who it's for\",\n    question: \"Who is it for?\",\n    guess: \"Nothing says who it's for, so there are no words written for anyone.\",\n    note: \"No audience, so generic words.\",\n    flashLabel: \"Who it's for\"\n  },\n  {\n    id: \"feel\",\n    label: \"The feel\",\n    question: \"What should it feel like?\",\n    guess: \"No feel yet, so the page stays plain black and white.\",\n    note: \"No feel, so black and white.\",\n    flashLabel: \"The feel\"\n  },\n  {\n    id: \"parts\",\n    label: \"The parts\",\n    question: \"What parts should it have?\",\n    guess: \"No parts yet, so the page is just a few lines of text.\",\n    note: \"No parts, so just text.\",\n    flashLabel: \"The parts\"\n  },\n  {\n    id: \"content\",\n    label: \"The content\",\n    question: \"What should it say?\",\n    guess: \"No content yet, so there are no real words or numbers.\",\n    note: \"No content, so no real words.\",\n    flashLabel: \"The content\"\n  }\n];\n\n// The feel options share four looks, so the same words give the same look everywhere.\nconst PALETTES = {\n  warm: \"warm pinks and oranges with rounded corners\",\n  bold: \"bright purple and orange with very round corners\",\n  fresh: \"fresh greens with soft corners\",\n  clean: \"cool grays and blue with sharp corners\"\n};\n\n// Short, at-a-glance versions of the feel effects.\nconst PALETTE_NOTES = {\n  warm: \"Warm pinks and oranges, round corners.\",\n  bold: \"Bright purple and orange, very round.\",\n  fresh: \"Fresh greens, soft corners.\",\n  clean: \"Cool grays and blue, sharp corners.\"\n};\n\n// Line icons (24 x 24 grid). Chips, prompt details, flashes, and the effects list share these.\nconst ICONS = {\n  who: '<circle cx=\"12\" cy=\"8\" r=\"3.5\"/><path d=\"M5 20c0-3.6 3-6 7-6s7 2.4 7 6\"/>',\n  feel: '<path d=\"M12 3s6 6.2 6 10.2A6 6 0 0 1 6 13.2C6 9.2 12 3 12 3z\"/>',\n  parts:\n    '<rect x=\"3.5\" y=\"3.5\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"13.5\" y=\"3.5\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"3.5\" y=\"13.5\" width=\"7\" height=\"7\" rx=\"1.5\"/><rect x=\"13.5\" y=\"13.5\" width=\"7\" height=\"7\" rx=\"1.5\"/>',\n  content: '<path d=\"M4 6h16M4 12h16M4 18h10\"/>',\n  check: '<path d=\"M5 12.5l4.5 4.5L19 7.5\"/>',\n  chevron: '<path d=\"M6 9l6 6 6-6\"/>'\n};\n\n// Simple glyphs for the sample pages (24 x 24 grid).\nconst GLYPHS = {\n  cookie:\n    '<circle cx=\"12\" cy=\"12\" r=\"8.5\"/><circle class=\"g-fill\" cx=\"9\" cy=\"10\" r=\"1\"/><circle class=\"g-fill\" cx=\"14.5\" cy=\"9\" r=\"1\"/><circle class=\"g-fill\" cx=\"13\" cy=\"14.5\" r=\"1\"/><circle class=\"g-fill\" cx=\"8.8\" cy=\"15\" r=\"0.8\"/>',\n  brownie: '<rect x=\"4\" y=\"6\" width=\"16\" height=\"12\" rx=\"2\"/><path d=\"M4 12h16M9 6v12M15 6v12\"/>',\n  roll: '<circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"M12 12a1.5 1.5 0 0 1 3 0 3.5 3.5 0 0 1-7 0 5.5 5.5 0 0 1 11 0\"/>',\n  cupcake:\n    '<path d=\"M7.5 12.5h9l-1.2 7a1 1 0 0 1-1 .8H9.7a1 1 0 0 1-1-.8z\"/><path d=\"M6 12.5a3.2 3.2 0 0 1 1.6-5.6 4.2 4.2 0 0 1 8.8 0A3.2 3.2 0 0 1 18 12.5z\"/><circle class=\"g-fill\" cx=\"12\" cy=\"4.4\" r=\"1\"/>',\n  pie: '<path d=\"M12 12V3.5A8.5 8.5 0 1 0 20.5 12z\"/><path d=\"M14.5 9.5V4.2a8.5 8.5 0 0 1 5.3 5.3z\"/>',\n  donut: '<circle cx=\"12\" cy=\"12\" r=\"8.5\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/>',\n  wheel: '<circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"M12 3.5v17M3.5 12h17\"/>',\n  tree: '<path d=\"M12 3l5.5 7h-3l4 6h-13l4-6h-3z\"/><path d=\"M12 16v5\"/>',\n  sun: '<circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8\"/>',\n  cloud: '<path d=\"M7 18h10a4 4 0 0 0 .6-7.95A5.5 5.5 0 0 0 7.1 9.1 4.5 4.5 0 0 0 7 18z\"/>',\n  rain: '<path d=\"M7 15h10a4 4 0 0 0 .6-7.95A5.5 5.5 0 0 0 7.1 6.1 4.5 4.5 0 0 0 7 15z\"/><path d=\"M8 18l-1 3M12 18l-1 3M16 18l-1 3\"/>',\n  search: '<circle cx=\"11\" cy=\"11\" r=\"6\"/><path d=\"M20 20l-4.2-4.2\"/>'\n};\n\n// All student-facing copy lives here so it is easy to edit.\n// Every layer has three options. A prompt sentence, the page it makes, and an\n// \"effect\" line that says what the choice did.\nconst DESTINATIONS = {\n  \"bake-sale\": {\n    label: \"Bake sale site\",\n    kind: \"bake-sale\",\n    base: \"Make a website for a bake sale.\",\n    who: [\n      {\n        label: \"Neighbors and families\",\n        note: \"Headline speaks to neighbors and families.\",\n        sentence: \"It's for neighbors and their families.\",\n        headline: \"Treats for the whole neighborhood\",\n        sub: \"Bring the family and pick something sweet.\",\n        effect: \"The headline now talks to neighbors and families.\"\n      },\n      {\n        label: \"Kids and parents\",\n        note: \"Headline speaks to kids, with a note for parents.\",\n        sentence: \"It's for kids and their parents.\",\n        headline: \"Yum! Pick your favorite treat\",\n        sub: \"Ask a grown-up to help you reserve one.\",\n        effect: \"The headline now talks to kids, with a note for parents.\"\n      },\n      {\n        label: \"Students between classes\",\n        note: \"Headline speaks to busy students.\",\n        sentence: \"It's for students grabbing a snack between classes.\",\n        headline: \"A quick snack between classes\",\n        sub: \"Reserve one now and pick it up in the hallway.\",\n        effect: \"The headline now talks to busy students.\"\n      }\n    ],\n    feel: [\n      { label: \"Warm and friendly\", sentence: \"It should feel warm and friendly.\", palette: \"warm\" },\n      { label: \"Bold and playful\", sentence: \"It should feel bold and playful.\", palette: \"bold\" },\n      { label: \"Clean and simple\", sentence: \"It should feel clean and simple.\", palette: \"clean\" }\n    ],\n    parts: [\n      {\n        label: \"Photo cards\",\n        note: \"3 photo cards + a Reserve button.\",\n        sentence: \"Add a photo card for each treat and a button to reserve one.\",\n        variant: \"cards\",\n        effect: \"Three treat cards with photos, and a Reserve button.\"\n      },\n      {\n        label: \"A simple menu\",\n        note: \"A plain menu. No photos, no button.\",\n        sentence: \"Add a simple menu list with the treat names and prices.\",\n        variant: \"list\",\n        effect: \"A plain menu list. No photos and no button.\"\n      },\n      {\n        label: \"One featured treat\",\n        note: \"1 big treat + an Order button.\",\n        sentence: \"Add one big featured treat with an order button.\",\n        variant: \"featured\",\n        effect: \"One big featured treat, and an Order button.\"\n      }\n    ],\n    content: [\n      {\n        label: \"Cookies, brownies, rolls\",\n        note: \"Cookies, brownies, rolls, with prices.\",\n        sentence: \"Show lemon cookies for $2, brownies for $3, and cinnamon rolls for $4, with pickup on Saturday at 10 a.m.\",\n        effect: \"The page now shows lemon cookies, brownies, and cinnamon rolls, with prices and a pickup time.\",\n        data: {\n          url: \"sunnysidebakes.org\",\n          items: [\n            { name: \"Lemon cookies\", price: \"$2\", glyph: \"cookie\" },\n            { name: \"Brownies\", price: \"$3\", glyph: \"brownie\" },\n            { name: \"Cinnamon rolls\", price: \"$4\", glyph: \"roll\" }\n          ],\n          info: \"Pickup Saturday at 10 a.m.\"\n        }\n      },\n      {\n        label: \"Cupcakes, pie, muffins\",\n        note: \"Cupcakes, pie, muffins, with prices.\",\n        sentence: \"Show cupcakes for $3, apple pie for $5, and banana muffins for $2, with pickup on Sunday at noon.\",\n        effect: \"The page now shows cupcakes, apple pie, and banana muffins, with prices and a pickup time.\",\n        data: {\n          url: \"sunnysidebakes.org\",\n          items: [\n            { name: \"Cupcakes\", price: \"$3\", glyph: \"cupcake\" },\n            { name: \"Apple pie\", price: \"$5\", glyph: \"pie\" },\n            { name: \"Banana muffins\", price: \"$2\", glyph: \"cupcake\" }\n          ],\n          info: \"Pickup Sunday at noon\"\n        }\n      },\n      {\n        label: \"Vegan treats\",\n        note: \"Vegan donuts, oat bars, tarts, with prices.\",\n        sentence: \"Show vegan donuts for $2, oat bars for $3, and fruit tarts for $4, with pickup on Friday at 3 p.m.\",\n        effect: \"The page now shows vegan donuts, oat bars, and fruit tarts, with prices and a pickup time.\",\n        data: {\n          url: \"sunnysidebakes.org\",\n          items: [\n            { name: \"Vegan donuts\", price: \"$2\", glyph: \"donut\" },\n            { name: \"Oat bars\", price: \"$3\", glyph: \"brownie\" },\n            { name: \"Fruit tarts\", price: \"$4\", glyph: \"pie\" }\n          ],\n          info: \"Pickup Friday at 3 p.m.\"\n        }\n      }\n    ]\n  },\n\n  \"decision-wheel\": {\n    label: \"Decision wheel\",\n    kind: \"decision-wheel\",\n    base: \"Make a decision wheel.\",\n    who: [\n      {\n        label: \"Friends\",\n        note: \"Headline speaks to friends.\",\n        sentence: \"It's for friends who can't agree on a plan.\",\n        headline: \"Can't decide? Let the wheel pick.\",\n        sub: \"Made for friends who never agree.\",\n        effect: \"The headline now talks to friends.\"\n      },\n      {\n        label: \"A family\",\n        note: \"Headline speaks to a family.\",\n        sentence: \"It's for a family deciding what to have for dinner.\",\n        headline: \"What's for dinner tonight?\",\n        sub: \"Give everyone a say, then let the wheel choose.\",\n        effect: \"The headline now talks to a family.\"\n      },\n      {\n        label: \"A class\",\n        note: \"Headline speaks to a class.\",\n        sentence: \"It's for a class choosing who goes first.\",\n        headline: \"Who goes first?\",\n        sub: \"Fair and fast for the whole class.\",\n        effect: \"The headline now talks to a class.\"\n      }\n    ],\n    feel: [\n      { label: \"Playful and bright\", sentence: \"It should feel playful and bright.\", palette: \"bold\" },\n      { label: \"Warm and cozy\", sentence: \"It should feel warm and cozy.\", palette: \"warm\" },\n      { label: \"Clean and modern\", sentence: \"It should feel clean and modern.\", palette: \"clean\" }\n    ],\n    parts: [\n      {\n        label: \"A spinning wheel\",\n        note: \"A spinning wheel + a Spin button.\",\n        sentence: \"Add a wheel that spins and a Spin button.\",\n        variant: \"wheel\",\n        effect: \"A wheel with colored slices, a pointer, and a Spin button.\"\n      },\n      {\n        label: \"A list of choices\",\n        note: \"A plain list + a Pick for me button.\",\n        sentence: \"Add a list of the choices and a Pick for me button.\",\n        variant: \"list\",\n        effect: \"A plain list of the choices, and a Pick for me button.\"\n      },\n      {\n        label: \"One big button\",\n        note: \"A big Spin button + an answer box.\",\n        sentence: \"Add one big Spin button and a box that shows the answer.\",\n        variant: \"big\",\n        effect: \"One big Spin button, and a box for the answer.\"\n      }\n    ],\n    content: [\n      {\n        label: \"Friday plans\",\n        note: \"Pizza, bowling, movie, picnic.\",\n        sentence: \"Put pizza, bowling, a movie, and a picnic on it, and show the answer Bowling.\",\n        effect: \"The page now has pizza, bowling, a movie, and a picnic as the choices.\",\n        data: {\n          url: \"fridaywheel.org\",\n          options: [\"Pizza\", \"Bowling\", \"Movie\", \"Picnic\"],\n          result: \"Tonight: Bowling\"\n        }\n      },\n      {\n        label: \"Dinner ideas\",\n        note: \"Tacos, pasta, soup, salad.\",\n        sentence: \"Put tacos, pasta, soup, and salad on it, and show the answer Tacos.\",\n        effect: \"The page now has tacos, pasta, soup, and salad as the choices.\",\n        data: {\n          url: \"dinnerwheel.org\",\n          options: [\"Tacos\", \"Pasta\", \"Soup\", \"Salad\"],\n          result: \"Tonight: Tacos\"\n        }\n      },\n      {\n        label: \"Team colors\",\n        note: \"Red, Blue, Green, Gold.\",\n        sentence: \"Put the team colors Red, Blue, Green, and Gold on it, and show the answer Blue.\",\n        effect: \"The page now has Red, Blue, Green, and Gold as the choices.\",\n        data: {\n          url: \"firstupwheel.org\",\n          options: [\"Red\", \"Blue\", \"Green\", \"Gold\"],\n          result: \"First up: Blue\"\n        }\n      }\n    ]\n  },\n\n  \"save-the-park\": {\n    label: \"Save-the-park page\",\n    kind: \"save-the-park\",\n    base: \"Make a page to save Maple Park.\",\n    who: [\n      {\n        label: \"Neighbors\",\n        note: \"Headline speaks to neighbors.\",\n        sentence: \"It's for neighbors who can sign up and help.\",\n        headline: \"Help keep Maple Park open\",\n        sub: \"Neighbors are signing to protect a place everyone shares.\",\n        effect: \"The headline now talks to neighbors.\"\n      },\n      {\n        label: \"City leaders\",\n        note: \"Headline speaks to city leaders.\",\n        sentence: \"It's for city leaders who decide what happens to the park.\",\n        headline: \"Maple Park matters to this town\",\n        sub: \"Here is why the council should keep it open.\",\n        effect: \"The headline now talks to city leaders.\"\n      },\n      {\n        label: \"Kids who play there\",\n        note: \"Headline speaks to kids.\",\n        sentence: \"It's for kids who play there.\",\n        headline: \"Keep Maple Park open!\",\n        sub: \"Sign up so kids can keep playing here.\",\n        effect: \"The headline now talks to kids.\"\n      }\n    ],\n    feel: [\n      { label: \"Hopeful and green\", sentence: \"It should feel hopeful and green.\", palette: \"fresh\" },\n      { label: \"Warm and welcoming\", sentence: \"It should feel warm and welcoming.\", palette: \"warm\" },\n      { label: \"Serious and clear\", sentence: \"It should feel serious and clear.\", palette: \"clean\" }\n    ],\n    parts: [\n      {\n        label: \"Sign button and bar\",\n        note: \"A Sign button + a progress bar.\",\n        sentence: \"Add a Sign button and a bar that shows how many neighbors have signed.\",\n        variant: \"meter\",\n        effect: \"A Sign button, and a progress bar.\"\n      },\n      {\n        label: \"A sign-up form\",\n        note: \"A name box + a Sign button.\",\n        sentence: \"Add a sign-up form with a name box and a Sign button.\",\n        variant: \"form\",\n        effect: \"A sign-up form with a name box and a Sign button.\"\n      },\n      {\n        label: \"Photo and Share button\",\n        note: \"A big photo + a Share button.\",\n        sentence: \"Add a big park photo and a Share button.\",\n        variant: \"photo\",\n        effect: \"A big photo, and a Share button.\"\n      }\n    ],\n    content: [\n      {\n        label: \"The playground\",\n        note: \"Playground, 1,204 of 1,500 signed.\",\n        sentence: \"Say it has the only playground on Elm Street, and show 1,204 of 1,500 signatures.\",\n        effect: \"The page now talks about the playground, and shows 1,204 of 1,500 signatures.\",\n        data: {\n          url: \"savemaplepark.org\",\n          desc: \"It has the only playground on Elm Street.\",\n          count: \"1,204 of 1,500 neighbors have signed\",\n          progress: 0.8\n        }\n      },\n      {\n        label: \"The old oak tree\",\n        note: \"Oak tree, 856 of 1,000 signed.\",\n        sentence: \"Say it has the tallest oak tree in town, and show 856 of 1,000 signatures.\",\n        effect: \"The page now talks about the oak tree, and shows 856 of 1,000 signatures.\",\n        data: {\n          url: \"savemaplepark.org\",\n          desc: \"It has the tallest oak tree in town.\",\n          count: \"856 of 1,000 neighbors have signed\",\n          progress: 0.86\n        }\n      },\n      {\n        label: \"The garden\",\n        note: \"Community garden, 312 of 500 signed.\",\n        sentence: \"Say it has a community garden, and show 312 of 500 signatures.\",\n        effect: \"The page now talks about the garden, and shows 312 of 500 signatures.\",\n        data: {\n          url: \"savemaplepark.org\",\n          desc: \"It has a community garden for everyone.\",\n          count: \"312 of 500 neighbors have signed\",\n          progress: 0.62\n        }\n      }\n    ]\n  },\n\n  \"weather-checker\": {\n    label: \"Weather checker\",\n    kind: \"weather-checker\",\n    base: \"Make a weather checker.\",\n    who: [\n      {\n        label: \"Kids before school\",\n        note: \"Headline speaks to kids on school mornings.\",\n        sentence: \"It's for kids checking before school.\",\n        headline: \"Know before you head out\",\n        sub: \"A quick look for school-day mornings.\",\n        effect: \"The headline now talks to kids on school mornings.\"\n      },\n      {\n        label: \"Hikers\",\n        note: \"Headline speaks to hikers.\",\n        sentence: \"It's for hikers planning a trip.\",\n        headline: \"Plan your hike with confidence\",\n        sub: \"See if the trail will be dry, warm, and clear.\",\n        effect: \"The headline now talks to hikers.\"\n      },\n      {\n        label: \"Gardeners\",\n        note: \"Headline speaks to gardeners.\",\n        sentence: \"It's for gardeners deciding when to water.\",\n        headline: \"Should you water today?\",\n        sub: \"Check for rain before you grab the hose.\",\n        effect: \"The headline now talks to gardeners.\"\n      }\n    ],\n    feel: [\n      { label: \"Calm and clear\", sentence: \"It should feel calm and clear.\", palette: \"clean\" },\n      { label: \"Sunny and cheerful\", sentence: \"It should feel sunny and cheerful.\", palette: \"warm\" },\n      { label: \"Bold and energetic\", sentence: \"It should feel bold and energetic.\", palette: \"bold\" }\n    ],\n    parts: [\n      {\n        label: \"Search box and cards\",\n        note: \"A search box + 3 day cards.\",\n        sentence: \"Add a city search box and a card for each of the next few days.\",\n        variant: \"search-days\",\n        effect: \"A search box, and three day cards.\"\n      },\n      {\n        label: \"One big card\",\n        note: \"One big card for today.\",\n        sentence: \"Add one big card for today's weather.\",\n        variant: \"today\",\n        effect: \"One big card for today's weather.\"\n      },\n      {\n        label: \"Search box and list\",\n        note: \"A search box + a list of days.\",\n        sentence: \"Add a city search box and a list of the next few days.\",\n        variant: \"search-list\",\n        effect: \"A search box, and a list of the next days.\"\n      }\n    ],\n    content: [\n      {\n        label: \"Chicago, cloudy\",\n        note: \"Chicago, 34\\u00B0F, cloudy, rain Wednesday.\",\n        sentence: \"Show Chicago at 34\\u00B0F and cloudy, with rain on Wednesday.\",\n        effect: \"The page now shows Chicago at 34\\u00B0F and cloudy, with rain on Wednesday.\",\n        data: {\n          url: \"morningweather.org\",\n          city: \"Chicago\",\n          temp: \"34\\u00B0F\",\n          cond: \"Cloudy in Chicago\",\n          nowGlyph: \"cloud\",\n          days: [\n            { name: \"Tue\", temp: \"36\\u00B0F\", glyph: \"cloud\" },\n            { name: \"Wed\", temp: \"41\\u00B0F\", glyph: \"rain\" },\n            { name: \"Thu\", temp: \"38\\u00B0F\", glyph: \"sun\" }\n          ]\n        }\n      },\n      {\n        label: \"Seattle, rainy\",\n        note: \"Seattle, 52\\u00B0F, rainy, sun Thursday.\",\n        sentence: \"Show Seattle at 52\\u00B0F and rainy, with sun on Thursday.\",\n        effect: \"The page now shows Seattle at 52\\u00B0F and rainy, with sun on Thursday.\",\n        data: {\n          url: \"morningweather.org\",\n          city: \"Seattle\",\n          temp: \"52\\u00B0F\",\n          cond: \"Rainy in Seattle\",\n          nowGlyph: \"rain\",\n          days: [\n            { name: \"Tue\", temp: \"50\\u00B0F\", glyph: \"rain\" },\n            { name: \"Wed\", temp: \"53\\u00B0F\", glyph: \"cloud\" },\n            { name: \"Thu\", temp: \"57\\u00B0F\", glyph: \"sun\" }\n          ]\n        }\n      },\n      {\n        label: \"Phoenix, sunny\",\n        note: \"Phoenix, 95\\u00B0F, sunny, clouds Wednesday.\",\n        sentence: \"Show Phoenix at 95\\u00B0F and sunny, with clouds on Wednesday.\",\n        effect: \"The page now shows Phoenix at 95\\u00B0F and sunny, with clouds on Wednesday.\",\n        data: {\n          url: \"morningweather.org\",\n          city: \"Phoenix\",\n          temp: \"95\\u00B0F\",\n          cond: \"Sunny in Phoenix\",\n          nowGlyph: \"sun\",\n          days: [\n            { name: \"Tue\", temp: \"96\\u00B0F\", glyph: \"sun\" },\n            { name: \"Wed\", temp: \"92\\u00B0F\", glyph: \"cloud\" },\n            { name: \"Thu\", temp: \"97\\u00B0F\", glyph: \"sun\" }\n          ]\n        }\n      }\n    ]\n  }\n};\n\nconst state = {\n  destinationId: CONFIG.defaultDestination,\n  choices: { who: null, feel: null, parts: null, content: null },\n  openLayer: null\n};\n\nconst refs = {};\nlet audioCtx = null;\nlet popTimer = null;\nlet flashTimer = null;\nlet slotOrder = 0;\n\n// ---------- Helpers ----------\n\nfunction el(tag, className, text) {\n  const node = document.createElement(tag);\n  if (className) {\n    node.className = className;\n  }\n  if (text != null) {\n    node.textContent = text;\n  }\n  return node;\n}\n\nfunction iconSvg(name, className) {\n  const svg = document.createElementNS(SVG_NS, \"svg\");\n  svg.setAttribute(\"viewBox\", \"0 0 24 24\");\n  svg.setAttribute(\"aria-hidden\", \"true\");\n  svg.setAttribute(\"focusable\", \"false\");\n  svg.setAttribute(\"class\", `ico ${className || \"\"}`.trim());\n  svg.innerHTML = ICONS[name] || \"\";\n  return svg;\n}\n\nfunction glyph(name) {\n  const svg = document.createElementNS(SVG_NS, \"svg\");\n  svg.setAttribute(\"viewBox\", \"0 0 24 24\");\n  svg.setAttribute(\"aria-hidden\", \"true\");\n  svg.setAttribute(\"focusable\", \"false\");\n  svg.innerHTML = GLYPHS[name] || \"\";\n  return svg;\n}\n\nfunction svgNode(tag, attrs, className) {\n  const node = document.createElementNS(SVG_NS, tag);\n  Object.keys(attrs).forEach((key) => node.setAttribute(key, attrs[key]));\n  if (className) {\n    node.setAttribute(\"class\", className);\n  }\n  return node;\n}\n\nfunction currentDestination() {\n  return DESTINATIONS[state.destinationId];\n}\n\nfunction layerById(id) {\n  return LAYERS.find((layer) => layer.id === id);\n}\n\n// The option a student picked for a layer, or null.\nfunction chosen(layerId) {\n  const index = state.choices[layerId];\n  return index == null ? null : currentDestination()[layerId][index];\n}\n\nfunction effectText(layerId, option) {\n  if (layerId === \"feel\") {\n    return `The page now uses ${PALETTES[option.palette]}, with a matching headline style.`;\n  }\n  return option.effect;\n}\n\nfunction shortNote(layerId, option) {\n  return layerId === \"feel\" ? PALETTE_NOTES[option.palette] : option.note;\n}\n\nfunction showError(message) {\n  refs.error.textContent = message;\n  refs.error.hidden = false;\n}\n\nfunction announce(message) {\n  // Clear first so repeated messages are still read.\n  refs.announcer.textContent = \"\";\n  window.setTimeout(() => {\n    refs.announcer.textContent = message;\n  }, 50);\n}\n\nfunction promptString() {\n  const dest = currentDestination();\n  const parts = [dest.base];\n  LAYERS.forEach((layer) => {\n    const option = chosen(layer.id);\n    if (option) {\n      parts.push(option.sentence);\n    }\n  });\n  return parts.join(\" \");\n}\n\nfunction detailsSummary() {\n  const active = LAYERS.filter((layer) => chosen(layer.id)).map(\n    (layer) => `${layer.label.toLowerCase()}: ${chosen(layer.id).label}`\n  );\n  if (active.length === 0) {\n    return \"A very basic wireframe with a title and a few lines of text.\";\n  }\n  return `Details so far: ${active.join(\"; \")}.`;\n}\n\nfunction resolveDestination() {\n  const fromUrl = new URLSearchParams(window.location.search).get(\"destination\");\n  if (fromUrl && DESTINATIONS[fromUrl]) {\n    return fromUrl;\n  }\n  const fromAttr = refs.app.dataset.destination;\n  if (fromAttr && DESTINATIONS[fromAttr]) {\n    return fromAttr;\n  }\n  return CONFIG.defaultDestination;\n}\n\n// ---------- Chips and options ----------\n\nfunction buildChips() {\n  refs.chipGrid.textContent = \"\";\n  refs.chips = LAYERS.map((layer) => {\n    const button = el(\"button\", \"chip\");\n    button.type = \"button\";\n    button.dataset.layer = layer.id;\n    button.setAttribute(\"aria-expanded\", \"false\");\n    button.setAttribute(\"aria-controls\", \"options\");\n    button.append(\n      iconSvg(layer.id, \"chip-icon\"),\n      el(\"span\", \"chip-label\", layer.label),\n      iconSvg(\"chevron\", \"chip-end chip-chevron\"),\n      iconSvg(\"check\", \"chip-end chip-check\")\n    );\n    button.addEventListener(\"click\", () => toggleOpen(layer.id));\n    refs.chipGrid.append(button);\n    return button;\n  });\n}\n\nfunction renderChips() {\n  refs.chips.forEach((button) => {\n    const id = button.dataset.layer;\n    button.dataset.set = String(state.choices[id] != null);\n    button.setAttribute(\"aria-expanded\", String(state.openLayer === id));\n  });\n}\n\nfunction renderOptions() {\n  const id = state.openLayer;\n  if (!id) {\n    refs.optionsEmpty.hidden = false;\n    refs.optionsBody.hidden = true;\n    return;\n  }\n  const layer = layerById(id);\n  const options = currentDestination()[id];\n  refs.optionsEmpty.hidden = true;\n  refs.optionsBody.hidden = false;\n  refs.optionsTitle.textContent = layer.question;\n  refs.optionRow.textContent = \"\";\n  options.forEach((option, index) => {\n    const button = el(\"button\", \"option\", option.label);\n    button.type = \"button\";\n    button.setAttribute(\"aria-pressed\", String(state.choices[id] === index));\n    button.addEventListener(\"click\", () => choose(id, index));\n    refs.optionRow.append(button);\n  });\n}\n\n// ---------- Prompt ----------\n\nfunction bitNode(layerId, sentence) {\n  const bit = el(\"span\", \"prompt-bit\");\n  // The icon and the first word stay together so the icon never sits alone at a line end.\n  const space = sentence.indexOf(\" \");\n  const lead = el(\"span\", \"prompt-lead\");\n  lead.append(iconSvg(layerId, \"prompt-icon\"), document.createTextNode(space === -1 ? sentence : sentence.slice(0, space)));\n  bit.append(lead);\n  if (space !== -1) {\n    bit.append(document.createTextNode(sentence.slice(space)));\n  }\n  return bit;\n}\n\nfunction buildPrompt() {\n  const dest = currentDestination();\n  refs.promptText.textContent = \"\";\n  refs.promptGhost.textContent = \"\";\n\n  refs.promptText.append(el(\"span\", \"prompt-base\", dest.base));\n  refs.promptGhost.append(el(\"span\", \"prompt-base\", dest.base));\n\n  LAYERS.forEach((layer) => {\n    const option = chosen(layer.id);\n    if (option) {\n      const bit = bitNode(layer.id, option.sentence);\n      bit.dataset.bit = layer.id;\n      refs.promptText.append(document.createTextNode(\" \"), bit);\n    }\n\n    // The ghost always holds the longest sentence for every layer, so the\n    // well never changes height as details come and go.\n    const longest = dest[layer.id].reduce((a, b) => (b.sentence.length > a.sentence.length ? b : a));\n    refs.promptGhost.append(document.createTextNode(\" \"), bitNode(layer.id, longest.sentence));\n  });\n}\n\nfunction markNewBit(layerId) {\n  const bit = refs.promptText.querySelector(`[data-bit=\"${layerId}\"]`);\n  if (bit) {\n    bit.classList.add(\"is-new\");\n    window.setTimeout(() => bit.classList.remove(\"is-new\"), CONFIG.newBitMs);\n  }\n}\n\n// ---------- What each detail did ----------\n\nfunction renderEffects(changedId) {\n  refs.effects.textContent = \"\";\n  LAYERS.forEach((layer) => {\n    const option = chosen(layer.id);\n    const item = el(\"li\", `effect ${option ? \"is-set\" : \"is-empty\"}`);\n    item.dataset.layer = layer.id;\n\n    const icon = el(\"span\", \"effect-icon\");\n    icon.append(iconSvg(layer.id));\n\n    const copy = el(\"span\", \"effect-copy\");\n    copy.append(\n      el(\"span\", \"effect-label\", layer.label),\n      el(\"span\", \"effect-text\", option ? shortNote(layer.id, option) : layer.note)\n    );\n\n    item.append(icon, copy);\n    if (layer.id === changedId) {\n      item.classList.add(\"is-new\");\n      window.setTimeout(() => item.classList.remove(\"is-new\"), CONFIG.rowMs);\n    }\n    refs.effects.append(item);\n  });\n}\n\n// ---------- Sample page ----------\n\nfunction slotValue(slot) {\n  const dest = currentDestination();\n  const who = chosen(\"who\") || dest.who[0];\n  const data = (chosen(\"content\") || dest.content[0]).data;\n  const [head, index, field] = slot.split(\".\");\n  const n = Number(index);\n  switch (head) {\n    case \"headline\":\n      return who.headline;\n    case \"sub\":\n      return who.sub;\n    case \"url\":\n      return data.url;\n    case \"plain\":\n      return plainLines(dest.kind, data)[n] || \"\";\n    case \"item\":\n      return data.items[n][field];\n    case \"info\":\n      return data.info;\n    case \"opt\":\n      return data.options[n];\n    case \"result\":\n      return data.result;\n    case \"desc\":\n      return data.desc;\n    case \"count\":\n      return data.count;\n    case \"city\":\n      return data.city;\n    case \"temp\":\n      return data.temp;\n    case \"cond\":\n      return data.cond;\n    case \"day\":\n      return data.days[n][field];\n    default:\n      return \"\";\n  }\n}\n\nfunction glyphValue(slot) {\n  const data = (chosen(\"content\") || currentDestination().content[0]).data;\n  const [head, index] = slot.split(\".\");\n  if (head === \"item\") {\n    return data.items[Number(index)].glyph;\n  }\n  if (head === \"day\") {\n    return data.days[Number(index)].glyph;\n  }\n  return data.nowGlyph;\n}\n\n// With no parts, the page is only these plain lines of text.\nfunction plainLines(kind, data) {\n  switch (kind) {\n    case \"bake-sale\":\n      return [...data.items.map((item) => `${item.name}: ${item.price}`), data.info];\n    case \"decision-wheel\":\n      return data.options.slice();\n    case \"save-the-park\":\n      return [data.desc, data.count];\n    default:\n      return [`${data.temp} in ${data.city}`, data.cond, data.days.map((d) => `${d.name} ${d.temp}`).join(\", \")];\n  }\n}\n\nfunction plainCount(kind) {\n  return { \"bake-sale\": 4, \"decision-wheel\": 4, \"save-the-park\": 2, \"weather-checker\": 3 }[kind];\n}\n\n// A text piece tied to a layer. Gray bar when the layer is off, words when on.\nfunction textSlot(slot, className) {\n  const node = el(\"span\", `t ${className}`);\n  node.dataset.slot = slot;\n  node.style.setProperty(\"--d\", String(slotOrder));\n  slotOrder += 1;\n  return node;\n}\n\nfunction glyphSlot(slot, className) {\n  const node = el(\"span\", `media ${className}`);\n  node.dataset.glyphSlot = slot;\n  return node;\n}\n\nfunction buildWheel() {\n  const cx = 100;\n  const cy = 110;\n  const r = 88;\n  const count = 4;\n  const svg = svgNode(\"svg\", { viewBox: \"0 0 200 210\", \"aria-hidden\": \"true\", focusable: \"false\" }, \"wheel\");\n\n  const point = (angle, radius) => {\n    const rad = (angle * Math.PI) / 180;\n    return [cx + radius * Math.cos(rad), cy + radius * Math.sin(rad)];\n  };\n\n  for (let i = 0; i < count; i += 1) {\n    const start = -90 + (i * 360) / count;\n    const end = -90 + ((i + 1) * 360) / count;\n    const [x0, y0] = point(start, r);\n    const [x1, y1] = point(end, r);\n    const d = `M${cx} ${cy} L${x0.toFixed(2)} ${y0.toFixed(2)} A${r} ${r} 0 0 1 ${x1.toFixed(2)} ${y1.toFixed(2)} Z`;\n    svg.append(svgNode(\"path\", { d }, `wedge wedge-${i}`));\n  }\n\n  for (let i = 0; i < count; i += 1) {\n    const mid = -90 + ((i + 0.5) * 360) / count;\n    const [x, y] = point(mid, r * 0.6);\n    const text = svgNode(\"text\", { x: x.toFixed(2), y: y.toFixed(2) }, \"wedge-label\");\n    text.dataset.slot = `opt.${i}`;\n    svg.append(text);\n  }\n\n  svg.append(svgNode(\"circle\", { cx, cy, r: 9 }, \"wheel-hub\"));\n  svg.append(svgNode(\"path\", { d: \"M92 14 L108 14 L100 34 Z\" }, \"wheel-pointer\"));\n  return svg;\n}\n\nfunction searchRow() {\n  const row = el(\"span\", \"search-row\");\n  const field = el(\"span\", \"box field\");\n  field.append(glyph(\"search\"), textSlot(\"city\", \"t-content field-text\"));\n  row.append(field, el(\"span\", \"btn\", \"Check\"));\n  return row;\n}\n\nfunction dayCards() {\n  const days = el(\"span\", \"days\");\n  for (let i = 0; i < 3; i += 1) {\n    const card = el(\"span\", \"box day\");\n    card.append(textSlot(`day.${i}.name`, \"t-content\"), glyphSlot(`day.${i}`, \"day-media\"), textSlot(`day.${i}.temp`, \"t-content\"));\n    days.append(card);\n  }\n  return days;\n}\n\nfunction dayList() {\n  const list = el(\"span\", \"menu-list\");\n  for (let i = 0; i < 3; i += 1) {\n    const row = el(\"span\", \"box menu-row\");\n    const main = el(\"span\", \"row-main\");\n    main.append(glyphSlot(`day.${i}`, \"row-media\"), textSlot(`day.${i}.name`, \"t-content\"));\n    row.append(main, textSlot(`day.${i}.temp`, \"t-content\"));\n    list.append(row);\n  }\n  return list;\n}\n\n// Each destination has three part layouts. Parts are the pieces; content is the words in them.\nconst PART_BUILDERS = {\n  \"bake-sale\": {\n    cards: (box) => {\n      const items = el(\"span\", \"items\");\n      for (let i = 0; i < 3; i += 1) {\n        const card = el(\"span\", \"box item\");\n        card.append(\n          glyphSlot(`item.${i}`, \"item-media\"),\n          textSlot(`item.${i}.name`, \"t-content item-name\"),\n          textSlot(`item.${i}.price`, \"t-content item-price\")\n        );\n        items.append(card);\n      }\n      const row = el(\"span\", \"order-row\");\n      row.append(el(\"span\", \"btn\", \"Reserve a treat\"), textSlot(\"info\", \"t-content\"));\n      box.append(items, row);\n    },\n    list: (box) => {\n      const list = el(\"span\", \"menu-list\");\n      for (let i = 0; i < 3; i += 1) {\n        const row = el(\"span\", \"box menu-row\");\n        row.append(textSlot(`item.${i}.name`, \"t-content\"), textSlot(`item.${i}.price`, \"t-content\"));\n        list.append(row);\n      }\n      box.append(list, textSlot(\"info\", \"t-content\"));\n    },\n    featured: (box) => {\n      const card = el(\"span\", \"box featured\");\n      const copy = el(\"span\", \"featured-copy\");\n      copy.append(\n        textSlot(\"item.0.name\", \"t-content featured-name\"),\n        textSlot(\"item.0.price\", \"t-content\"),\n        el(\"span\", \"btn\", \"Order now\")\n      );\n      card.append(glyphSlot(\"item.0\", \"featured-media\"), copy);\n      box.append(card, textSlot(\"info\", \"t-content\"));\n    }\n  },\n\n  \"decision-wheel\": {\n    wheel: (box) => {\n      const layout = el(\"span\", \"wheel-layout\");\n      const side = el(\"span\", \"wheel-side\");\n      side.append(el(\"span\", \"btn\", \"Spin\"), textSlot(\"result\", \"t-content\"));\n      layout.append(buildWheel(), side);\n      box.append(layout);\n    },\n    list: (box) => {\n      const list = el(\"span\", \"menu-list\");\n      for (let i = 0; i < 4; i += 1) {\n        const row = el(\"span\", \"box menu-row\");\n        row.append(textSlot(`opt.${i}`, \"t-content\"));\n        list.append(row);\n      }\n      box.append(list, el(\"span\", \"btn\", \"Pick for me\"));\n    },\n    big: (box) => {\n      const wrap = el(\"span\", \"big-spin\");\n      const result = el(\"span\", \"box result-box\");\n      result.append(textSlot(\"result\", \"t-content\"));\n      wrap.append(el(\"span\", \"btn btn-big\", \"Spin\"), result);\n      box.append(wrap);\n    }\n  },\n\n  \"save-the-park\": {\n    meter: (box) => {\n      const block = el(\"span\", \"meter-block\");\n      const meter = el(\"span\", \"meter\");\n      const fill = el(\"span\", \"meter-fill\");\n      fill.dataset.fillSlot = \"progress\";\n      meter.append(fill);\n      block.append(meter, textSlot(\"count\", \"t-content meter-count\"));\n      box.append(textSlot(\"desc\", \"t-content\"), block, el(\"span\", \"btn\", \"Sign to save the park\"));\n    },\n    form: (box) => {\n      const field = el(\"span\", \"box field\");\n      field.append(el(\"span\", \"field-hint\", \"Your name\"));\n      box.append(textSlot(\"desc\", \"t-content\"), field, el(\"span\", \"btn\", \"Sign\"));\n    },\n    photo: (box) => {\n      const media = el(\"span\", \"media park-media\");\n      media.append(glyph(\"tree\"));\n      box.append(media, textSlot(\"desc\", \"t-content\"), el(\"span\", \"btn\", \"Share this page\"));\n    }\n  },\n\n  \"weather-checker\": {\n    \"search-days\": (box) => {\n      box.append(searchRow(), dayCards());\n    },\n    today: (box) => {\n      const card = el(\"span\", \"box now now-big\");\n      const copy = el(\"span\", \"now-copy\");\n      copy.append(textSlot(\"temp\", \"t-content now-temp\"), textSlot(\"cond\", \"t-content\"));\n      card.append(glyphSlot(\"now\", \"now-media\"), copy);\n      box.append(card);\n    },\n    \"search-list\": (box) => {\n      box.append(searchRow(), dayList());\n    }\n  }\n};\n\nfunction buildPage() {\n  const dest = currentDestination();\n  const root = refs.samplePage;\n  root.textContent = \"\";\n  slotOrder = 0;\n\n  const chrome = el(\"span\", \"sp-chrome\");\n  const url = el(\"span\", \"page-url\");\n  url.append(textSlot(\"url\", \"t-content url-text\"));\n  chrome.append(url);\n\n  const hero = el(\"span\", \"sp-hero\");\n  hero.append(textSlot(\"headline\", \"t-who sp-headline\"), textSlot(\"sub\", \"t-who sp-sub\"));\n\n  const main = el(\"span\", \"sp-main\");\n  const plain = el(\"span\", \"plain\");\n  for (let i = 0; i < plainCount(dest.kind); i += 1) {\n    plain.append(textSlot(`plain.${i}`, \"t-content\"));\n  }\n  main.append(plain, el(\"span\", \"parts\"));\n\n  root.append(chrome, hero, main);\n  buildParts();\n}\n\nfunction buildParts() {\n  const dest = currentDestination();\n  const variant = (chosen(\"parts\") || dest.parts[0]).variant;\n  const parts = refs.samplePage.querySelector(\".parts\");\n  parts.textContent = \"\";\n  PART_BUILDERS[dest.kind][variant](parts);\n  applyContent();\n}\n\n// Writes the right words and glyphs into every slot. When a layer is off, the\n// words still sit there (hidden behind gray bars) so the bars have a natural size.\nfunction applyContent() {\n  const root = refs.samplePage;\n  root.querySelectorAll(\"[data-slot]\").forEach((node) => {\n    node.textContent = slotValue(node.dataset.slot);\n  });\n  root.querySelectorAll(\"[data-glyph-slot]\").forEach((holder) => {\n    const name = glyphValue(holder.dataset.glyphSlot);\n    if (holder.dataset.glyph !== name) {\n      holder.replaceChildren(glyph(name));\n      holder.dataset.glyph = name;\n    }\n  });\n  const data = (chosen(\"content\") || currentDestination().content[0]).data;\n  root.querySelectorAll(\"[data-fill-slot]\").forEach((node) => {\n    node.style.setProperty(\"--fill\", `${Math.round(data.progress * 100)}%`);\n  });\n}\n\nfunction renderPage() {\n  const root = refs.samplePage;\n  const feel = chosen(\"feel\");\n  root.dataset.destination = state.destinationId;\n  root.dataset.who = chosen(\"who\") ? \"on\" : \"off\";\n  root.dataset.parts = chosen(\"parts\") ? \"on\" : \"off\";\n  root.dataset.content = chosen(\"content\") ? \"on\" : \"off\";\n  root.dataset.palette = feel ? feel.palette : \"\";\n  refs.destLabel.textContent = currentDestination().label;\n  refs.pageFrame.setAttribute(\"aria-label\", `Sample page: ${currentDestination().label}. ${detailsSummary()}`);\n}\n\n// Outlines the part of the page a change reached, with a tag naming the chip.\nfunction flashLayer(layerId) {\n  const root = refs.samplePage;\n  window.clearTimeout(flashTimer);\n  clearFlash();\n\n  const targets = {\n    who: root.querySelector(\".sp-hero\"),\n    feel: root,\n    parts: root.querySelector(\".sp-main\"),\n    content: root.querySelector(\".sp-main\")\n  };\n  const target = targets[layerId];\n  const tag = el(\"span\", \"flash-tag\");\n  tag.append(iconSvg(layerId), document.createTextNode(layerById(layerId).flashLabel));\n  target.classList.add(\"flash\");\n  target.append(tag);\n  flashTimer = window.setTimeout(clearFlash, CONFIG.flashMs);\n}\n\nfunction clearFlash() {\n  refs.samplePage.querySelectorAll(\".flash-tag\").forEach((tag) => tag.remove());\n  refs.samplePage.classList.remove(\"flash\");\n  refs.samplePage.querySelectorAll(\".flash\").forEach((node) => node.classList.remove(\"flash\"));\n}\n\n// ---------- Spark and sound ----------\n\nfunction playPop(isOn) {\n  try {\n    const AudioContextClass = window.AudioContext || window.webkitAudioContext;\n    if (!AudioContextClass) {\n      return;\n    }\n    audioCtx = audioCtx || new AudioContextClass();\n    if (audioCtx.state === \"suspended\") {\n      audioCtx.resume();\n    }\n    const now = audioCtx.currentTime;\n    const osc = audioCtx.createOscillator();\n    const gain = audioCtx.createGain();\n    // A short falling blip. Adding or changing a detail is a little higher than taking one out.\n    const startHz = isOn ? 720 : 520;\n    const endHz = isOn ? 360 : 260;\n    osc.type = \"sine\";\n    osc.frequency.setValueAtTime(startHz, now);\n    osc.frequency.exponentialRampToValueAtTime(endHz, now + 0.09);\n    gain.gain.setValueAtTime(0.0001, now);\n    gain.gain.exponentialRampToValueAtTime(CONFIG.popVolume, now + 0.008);\n    gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.14);\n    osc.connect(gain);\n    gain.connect(audioCtx.destination);\n    osc.start(now);\n    osc.stop(now + 0.16);\n  } catch (err) {\n    // Sound is optional. The spark still pops.\n  }\n}\n\nfunction popSpark(isOn) {\n  const spark = refs.spark;\n  spark.classList.remove(\"pop\");\n  // Force a reflow so the animation restarts on quick taps.\n  void spark.offsetWidth;\n  spark.classList.add(\"pop\");\n  window.clearTimeout(popTimer);\n  popTimer = window.setTimeout(() => spark.classList.remove(\"pop\"), CONFIG.popMs);\n  playPop(isOn);\n}\n\n// ---------- Actions ----------\n\nfunction toggleOpen(layerId) {\n  state.openLayer = state.openLayer === layerId ? null : layerId;\n  renderChips();\n  renderOptions();\n}\n\nfunction choose(layerId, index) {\n  const layer = layerById(layerId);\n  const wasSet = state.choices[layerId] != null;\n  const clearing = state.choices[layerId] === index;\n  state.choices[layerId] = clearing ? null : index;\n\n  buildPrompt();\n  if (!clearing) {\n    markNewBit(layerId);\n  }\n  if (layerId === \"parts\") {\n    buildParts();\n  } else {\n    applyContent();\n  }\n  renderChips();\n  renderOptions();\n  renderPage();\n  renderEffects(layerId);\n  flashLayer(layerId);\n  popSpark(!clearing);\n\n  let message;\n  if (clearing) {\n    message = `Took out ${layer.label.toLowerCase()}. ${layer.guess}`;\n  } else {\n    const option = chosen(layerId);\n    message = `${wasSet ? \"Changed\" : \"Added\"} ${layer.label.toLowerCase()}: ${option.label}. ${effectText(layerId, option)} Everything else stayed the same.`;\n  }\n  announce(`${message} The prompt now reads: ${promptString()}`);\n}\n\nfunction resetAll() {\n  LAYERS.forEach((layer) => {\n    state.choices[layer.id] = null;\n  });\n  state.openLayer = null;\n  buildPrompt();\n  buildParts();\n  renderChips();\n  renderOptions();\n  renderPage();\n  renderEffects(null);\n  clearFlash();\n  announce(\"Reset. The page is a very basic wireframe again.\");\n}\n\nfunction changeDestination(id) {\n  if (!DESTINATIONS[id]) {\n    return;\n  }\n  state.destinationId = id;\n  LAYERS.forEach((layer) => {\n    state.choices[layer.id] = null;\n  });\n  state.openLayer = null;\n  buildPrompt();\n  buildPage();\n  renderChips();\n  renderOptions();\n  renderPage();\n  renderEffects(null);\n  clearFlash();\n  announce(`Switched to the ${currentDestination().label.toLowerCase()}. The page is a very basic wireframe.`);\n}\n\n// ---------- Init ----------\n\nfunction bindEvents() {\n  refs.reset.addEventListener(\"click\", resetAll);\n  refs.destinationSelect.addEventListener(\"change\", () => changeDestination(refs.destinationSelect.value));\n}\n\nfunction setupDestinationPicker() {\n  Object.keys(DESTINATIONS).forEach((id) => {\n    const option = el(\"option\", null, DESTINATIONS[id].label);\n    option.value = id;\n    refs.destinationSelect.append(option);\n  });\n  refs.destinationSelect.value = state.destinationId;\n  refs.previewBar.hidden = !CONFIG.showDestinationPicker;\n}\n\nfunction init() {\n  try {\n    refs.app = document.querySelector(\".app\");\n    refs.error = document.getElementById(\"app-error\");\n    refs.announcer = document.getElementById(\"announcer\");\n    refs.promptText = document.getElementById(\"prompt-text\");\n    refs.promptGhost = document.getElementById(\"prompt-ghost\");\n    refs.chipGrid = document.getElementById(\"chip-grid\");\n    refs.optionsEmpty = document.getElementById(\"options-empty\");\n    refs.optionsBody = document.getElementById(\"options-body\");\n    refs.optionsTitle = document.getElementById(\"options-title\");\n    refs.optionRow = document.getElementById(\"option-row\");\n    refs.reset = document.getElementById(\"reset-button\");\n    refs.spark = document.getElementById(\"spark\");\n    refs.pageFrame = document.getElementById(\"page-frame\");\n    refs.samplePage = document.getElementById(\"sample-page\");\n    refs.destLabel = document.getElementById(\"dest-label\");\n    refs.effects = document.getElementById(\"effects\");\n    refs.previewBar = document.getElementById(\"preview-bar\");\n    refs.destinationSelect = document.getElementById(\"destination-select\");\n\n    state.destinationId = resolveDestination();\n\n    setupDestinationPicker();\n    buildChips();\n    buildPrompt();\n    buildPage();\n    renderChips();\n    renderOptions();\n    renderPage();\n    renderEffects(null);\n    bindEvents();\n  } catch (err) {\n    console.error(err);\n    if (refs.error) {\n      showError(\"Something went wrong loading this activity. Reload the page to try again.\");\n    }\n  }\n}\n\ninit();\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": "/* ==========================================================\n   CADS design tokens (manifest v0.1.0)\n   Copied from the CADS runtime. Light theme only.\n   Do not edit values here; change styling by choosing a different\n   token in the rules further down.\n   ========================================================== */\n\n:root{\n  --brand-purple-5: #e4e2f8;\n  --brand-purple-10: #cac6f5;\n  --brand-purple-20: #aca8ea;\n  --brand-purple-30: #928cef;\n  --brand-purple-40: #6f67d9;\n  --brand-purple-50: #4c42cf;\n  --brand-purple-60: #4238c4;\n  --brand-purple-70: #3228b7;\n  --brand-purple-80: #2b1e9f;\n  --brand-purple-90: #1d1590;\n  --brand-purple-95: #1f1976;\n  --brand-orange-5: #ffe3ce;\n  --brand-orange-10: #ffd2b3;\n  --brand-orange-20: #ffbd8a;\n  --brand-orange-30: #ffa868;\n  --brand-orange-40: #ff8b38;\n  --brand-orange-50: #f46800;\n  --brand-orange-60: #d15900;\n  --brand-orange-70: #b34800;\n  --brand-orange-80: #942f00;\n  --brand-orange-90: #701c00;\n  --brand-orange-95: #611d00;\n  --brand-pink-5: #fbdae8;\n  --brand-pink-10: #f3c3d8;\n  --brand-pink-20: #eea1c3;\n  --brand-pink-30: #f07fb0;\n  --brand-pink-40: #eb5895;\n  --brand-pink-50: #e11970;\n  --brand-pink-60: #ce035b;\n  --brand-pink-70: #b5004f;\n  --brand-pink-80: #a10448;\n  --brand-pink-90: #8d003d;\n  --brand-pink-95: #7d0c3d;\n  --neutral-base-black: #121212;\n  --neutral-base-true-black: #000000;\n  --neutral-base-white: #ffffff;\n  --neutral-black-alpha-5: #1212120d;\n  --neutral-black-alpha-10: #1212121a;\n  --neutral-black-alpha-20: #12121233;\n  --neutral-black-alpha-30: #1212124d;\n  --neutral-black-alpha-40: #12121266;\n  --neutral-black-alpha-50: #12121280;\n  --neutral-black-alpha-60: #12121299;\n  --neutral-black-alpha-70: #121212b2;\n  --neutral-black-alpha-80: #121212cc;\n  --neutral-black-alpha-90: #121212e5;\n  --neutral-black-alpha-95: #121212f2;\n  --neutral-gray-5: #f1f2f4;\n  --neutral-gray-10: #e1e3e6;\n  --neutral-gray-20: #d3d6da;\n  --neutral-gray-30: #b7bcc2;\n  --neutral-gray-40: #9ea5ad;\n  --neutral-gray-50: #87909a;\n  --neutral-gray-60: #6e7782;\n  --neutral-gray-70: #596069;\n  --neutral-gray-80: #4b5258;\n  --neutral-gray-90: #363b40;\n  --neutral-gray-95: #282b2f;\n  --neutral-white-alpha-5: #ffffff0d;\n  --neutral-white-alpha-10: #ffffff1a;\n  --neutral-white-alpha-20: #ffffff33;\n  --neutral-white-alpha-30: #ffffff4d;\n  --neutral-white-alpha-40: #ffffff66;\n  --neutral-white-alpha-50: #ffffff80;\n  --neutral-white-alpha-60: #ffffff99;\n  --neutral-white-alpha-70: #ffffffb2;\n  --neutral-white-alpha-80: #ffffffcc;\n  --neutral-white-alpha-90: #ffffffe5;\n  --neutral-white-alpha-95: #fffffff2;\n  --sentiment-error-5: #ffdada;\n  --sentiment-error-10: #fac2c2;\n  --sentiment-error-20: #f69898;\n  --sentiment-error-30: #f37272;\n  --sentiment-error-40: #ef4848;\n  --sentiment-error-50: #eb1414;\n  --sentiment-error-60: #d31212;\n  --sentiment-error-70: #b30f0f;\n  --sentiment-error-80: #8d0c0c;\n  --sentiment-error-90: #6c0909;\n  --sentiment-error-95: #620202;\n  --sentiment-information-5: #d5efff;\n  --sentiment-information-10: #b8e5ff;\n  --sentiment-information-20: #94d7ff;\n  --sentiment-information-30: #6fcaff;\n  --sentiment-information-40: #38b3ff;\n  --sentiment-information-50: #0099f3;\n  --sentiment-information-60: #0082e5;\n  --sentiment-information-70: #1570d1;\n  --sentiment-information-80: #0855b2;\n  --sentiment-information-90: #0b43a3;\n  --sentiment-information-95: #06338d;\n  --sentiment-success-5: #d8ffdc;\n  --sentiment-success-10: #c4f1ca;\n  --sentiment-success-20: #9be3a3;\n  --sentiment-success-30: #7cdb87;\n  --sentiment-success-40: #4fcf5d;\n  --sentiment-success-50: #34bd43;\n  --sentiment-success-60: #2da43a;\n  --sentiment-success-70: #258830;\n  --sentiment-success-80: #1f7028;\n  --sentiment-success-90: #17541e;\n  --sentiment-success-95: #003f25;\n  --sentiment-warning-5: #fff5da;\n  --sentiment-warning-10: #ffecb8;\n  --sentiment-warning-20: #ffe08a;\n  --sentiment-warning-30: #ffd35c;\n  --sentiment-warning-40: #fdc835;\n  --sentiment-warning-50: #f5c000;\n  --sentiment-warning-60: #edaf02;\n  --sentiment-warning-70: #cf8e02;\n  --sentiment-warning-80: #b27a01;\n  --sentiment-warning-90: #885d02;\n  --sentiment-warning-95: #654500;\n}\n\n:root,[data-theme=Light]{\n  --background-neutral-primary: var(--neutral-base-white);\n  --background-neutral-secondary: var(--neutral-gray-5);\n  --background-neutral-tertiary: var(--neutral-gray-10);\n  --background-neutral-quaternary: var(--neutral-gray-20);\n  --background-neutral-quinary: var(--neutral-gray-30);\n  --background-neutral-senary: var(--neutral-gray-50);\n  --background-neutral-septenary: var(--neutral-gray-70);\n  --background-neutral-octonary: var(--neutral-gray-80);\n  --background-neutral-primary-inverse: var(--neutral-base-black);\n  --background-neutral-true-base: var(--neutral-base-black);\n  --background-neutral-black-fixed: var(--neutral-base-black);\n  --background-neutral-white-fixed: var(--neutral-base-white);\n  --background-neutral-alpha-5: var(--neutral-black-alpha-5);\n  --background-neutral-alpha-10: var(--neutral-black-alpha-10);\n  --background-neutral-alpha-20: var(--neutral-black-alpha-20);\n  --background-neutral-alpha-30: var(--neutral-black-alpha-30);\n  --background-neutral-alpha-40: var(--neutral-black-alpha-40);\n  --background-neutral-alpha-50: var(--neutral-black-alpha-50);\n  --background-neutral-alpha-60: var(--neutral-black-alpha-60);\n  --background-neutral-alpha-70: var(--neutral-black-alpha-70);\n  --background-neutral-alpha-80: var(--neutral-black-alpha-80);\n  --background-neutral-alpha-90: var(--neutral-black-alpha-90);\n  --background-neutral-alpha-95: var(--neutral-black-alpha-95);\n  --background-brand-primary: var(--brand-purple-50);\n  --background-brand-light: var(--brand-purple-5);\n  --background-brand-mid: var(--brand-purple-20);\n  --background-brand-strong: var(--brand-purple-80);\n  --background-error-primary: var(--sentiment-error-50);\n  --background-error-light: var(--sentiment-error-5);\n  --background-error-mid: var(--sentiment-error-30);\n  --background-error-strong: var(--sentiment-error-70);\n  --background-warning-primary: var(--sentiment-warning-50);\n  --background-warning-light: var(--sentiment-warning-5);\n  --background-warning-mid: var(--sentiment-warning-30);\n  --background-warning-strong: var(--sentiment-warning-70);\n  --background-success-primary: var(--sentiment-success-70);\n  --background-success-light: var(--sentiment-success-5);\n  --background-success-mid: var(--sentiment-success-30);\n  --background-success-strong: var(--sentiment-success-90);\n  --background-info-primary: var(--sentiment-information-70);\n  --background-info-light: var(--sentiment-information-5);\n  --background-info-mid: var(--sentiment-information-30);\n  --background-info-strong: var(--sentiment-information-90);\n  --background-selected-primary: var(--brand-purple-80);\n  --background-selected-strong: var(--brand-purple-95);\n  --background-selected-primary-inverse: var(--sentiment-success-5);\n  --background-disabled-brand: var(--brand-purple-5);\n  --background-disabled-error: var(--sentiment-error-5);\n  --background-disabled-info: var(--sentiment-information-5);\n  --background-disabled-neutral: var(--neutral-gray-20);\n  --background-disabled-orange: var(--brand-orange-5);\n  --background-disabled-pink: var(--brand-pink-5);\n  --background-disabled-success: var(--sentiment-success-5);\n  --background-disabled-warning: var(--sentiment-warning-5);\n  --background-accent-orange-primary: var(--brand-orange-50);\n  --background-accent-orange-light: var(--brand-orange-5);\n  --background-accent-orange-mid: var(--brand-orange-30);\n  --background-accent-orange-strong: var(--brand-orange-70);\n  --background-accent-pink-primary: var(--brand-pink-50);\n  --background-accent-pink-light: var(--brand-pink-5);\n  --background-accent-pink-mid: var(--brand-pink-30);\n  --background-accent-pink-strong: var(--brand-pink-70);\n  --border-neutral-primary: var(--neutral-gray-20);\n  --border-neutral-secondary: var(--neutral-gray-40);\n  --border-neutral-solid: var(--neutral-base-black);\n  --border-neutral-black-fixed: var(--neutral-base-black);\n  --border-neutral-white-fixed: var(--neutral-base-white);\n  --border-brand-primary: var(--brand-purple-50);\n  --border-brand-light: var(--brand-purple-10);\n  --border-brand-mid: var(--brand-purple-30);\n  --border-brand-strong: var(--brand-purple-70);\n  --border-error-primary: var(--sentiment-error-50);\n  --border-error-light: var(--sentiment-error-10);\n  --border-error-mid: var(--sentiment-error-20);\n  --border-error-strong: var(--sentiment-error-70);\n  --border-warning-primary: var(--sentiment-warning-50);\n  --border-warning-light: var(--sentiment-warning-10);\n  --border-warning-mid: var(--sentiment-warning-30);\n  --border-warning-strong: var(--sentiment-warning-70);\n  --border-success-primary: var(--sentiment-success-50);\n  --border-success-light: var(--sentiment-success-10);\n  --border-success-mid: var(--sentiment-success-30);\n  --border-success-strong: var(--sentiment-success-70);\n  --border-info-primary: var(--sentiment-information-50);\n  --border-info-light: var(--sentiment-information-10);\n  --border-info-mid: var(--sentiment-information-30);\n  --border-info-strong: var(--sentiment-information-70);\n  --border-focused-primary: var(--brand-purple-50);\n  --border-selected-primary: var(--brand-purple-80);\n  --border-selected-strong: var(--brand-purple-95);\n  --border-selected-primary-inverse: var(--sentiment-success-5);\n  --border-disabled-brand: var(--brand-purple-5);\n  --border-disabled-error: var(--sentiment-error-5);\n  --border-disabled-info: var(--sentiment-information-5);\n  --border-disabled-neutral: var(--neutral-gray-20);\n  --border-disabled-orange: var(--brand-orange-5);\n  --border-disabled-pink: var(--brand-pink-5);\n  --border-disabled-success: var(--sentiment-success-5);\n  --border-disabled-warning: var(--sentiment-warning-5);\n  --border-focused-inverse: var(--sentiment-success-5);\n  --border-accent-orange-primary: var(--brand-orange-50);\n  --border-accent-orange-light: var(--brand-orange-10);\n  --border-accent-orange-mid: var(--brand-orange-30);\n  --border-accent-orange-strong: var(--brand-orange-70);\n  --border-accent-pink-primary: var(--brand-pink-50);\n  --border-accent-pink-light: var(--brand-pink-10);\n  --border-accent-pink-mid: var(--brand-pink-30);\n  --border-accent-pink-strong: var(--brand-pink-70);\n  --text-neutral-primary: var(--neutral-base-black);\n  --text-neutral-secondary: var(--neutral-gray-90);\n  --text-neutral-tertiary: var(--neutral-gray-80);\n  --text-neutral-quaternary: var(--neutral-gray-70);\n  --text-neutral-primary-inverse: var(--neutral-base-white);\n  --text-neutral-placeholder: var(--neutral-gray-40);\n  --text-neutral-black-fixed: var(--neutral-base-black);\n  --text-neutral-white-fixed: var(--neutral-base-white);\n  --text-brand-primary: var(--brand-purple-50);\n  --text-brand-secondary: var(--brand-purple-90);\n  --text-brand-primary-fixed: var(--brand-purple-50);\n  --text-error-primary: var(--sentiment-error-50);\n  --text-error-secondary: var(--sentiment-error-70);\n  --text-error-primary-fixed: var(--sentiment-error-50);\n  --text-warning-primary: var(--sentiment-warning-50);\n  --text-warning-secondary: var(--sentiment-warning-90);\n  --text-warning-primary-fixed: var(--sentiment-warning-50);\n  --text-success-primary: var(--sentiment-success-70);\n  --text-success-secondary: var(--sentiment-success-90);\n  --text-success-primary-fixed: var(--sentiment-success-70);\n  --text-info-primary: var(--sentiment-information-70);\n  --text-info-secondary: var(--sentiment-information-90);\n  --text-info-primary-fixed: var(--sentiment-information-70);\n  --text-selected-primary: var(--sentiment-success-5);\n  --text-selected-primary-inverse: var(--brand-purple-95);\n  --text-disabled-brand: var(--brand-purple-5);\n  --text-disabled-error: var(--sentiment-error-5);\n  --text-disabled-info: var(--sentiment-information-5);\n  --text-disabled-neutral: var(--neutral-gray-20);\n  --text-disabled-neutral-inverse: var(--neutral-base-white);\n  --text-disabled-orange: var(--brand-orange-5);\n  --text-disabled-pink: var(--brand-pink-5);\n  --text-disabled-success: var(--sentiment-success-5);\n  --text-disabled-warning: var(--sentiment-warning-5);\n  --text-accent-orange-primary: var(--brand-orange-50);\n  --text-accent-orange-secondary: var(--brand-orange-70);\n  --text-accent-orange-primary-fixed: var(--brand-orange-50);\n  --text-accent-pink-primary: var(--brand-pink-50);\n  --text-accent-pink-secondary: var(--brand-pink-70);\n  --text-accent-pink-primary-fixed: var(--brand-pink-50);\n}\n\n:root{\n  --font-family-main: \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-family-heading: \"Space Grotesk\", \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-family-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\n  --font-weight-thin: 100;\n  --font-weight-extra-light: 200;\n  --font-weight-light: 300;\n  --font-weight-regular: 400;\n  --font-weight-medium: 500;\n  --font-weight-semi-bold: 600;\n  --font-weight-bold: 700;\n  --font-weight-extra-bold: 800;\n  --font-weight-black: 900;\n  --font-size-body-xs: .75rem;\n  --font-size-body-sm: .875rem;\n  --font-size-body-md: 1rem;\n  --font-size-body-lg: 1.125rem;\n}\n\n:root{\n  --text-heading-xxl: 3rem;\n  --text-heading-xl: 2.375rem;\n  --text-heading-lg: 1.75rem;\n  --text-heading-md: 1.5rem;\n  --text-heading-sm: 1.375rem;\n  --text-heading-xs: 1.25rem;\n  --leading-heading-xxl: 3.25rem;\n  --leading-heading-xl: 2.5rem;\n  --leading-heading-lg: 2.25rem;\n  --leading-heading-md: 2rem;\n  --leading-heading-sm: 1.875rem;\n  --leading-heading-xs: 1.75rem;\n  --text-body-lg: 1.125rem;\n  --text-body-md: 1rem;\n  --text-body-sm: .875rem;\n  --text-body-xs: .75rem;\n  --text-body-xxs: .625rem;\n  --leading-body-lg: 1.75rem;\n  --leading-body-md: 1.5rem;\n  --leading-body-sm: 1.375rem;\n  --leading-body-xs: 1.125rem;\n  --leading-body-xxs: 1rem;\n  --tracking-heading-display: -.01em;\n  --tracking-overline: .08em;\n  --tracking-none: 0;\n}\n\n:root{\n  --shape-sm: .375rem;\n  --shape-md: .5rem;\n  --shape-lg: .625rem;\n  --shape-xl: .75rem;\n  --shape-round: 62.4375rem;\n  --spacing-p-xxs: .5rem;\n  --spacing-p-xs: 1rem;\n  --spacing-p-s: 1.5rem;\n  --spacing-p-m: 2rem;\n  --spacing-p-l: 2.5rem;\n  --spacing-p-xl: 3rem;\n  --spacing-p-xxl: 3.5rem;\n  --spacing-p-xxxl: 4rem;\n  --shadow-sm: 0 4px 7px rgb(0 0 0 / 7%), 0 2px 2px rgb(0 0 0 / 7%);\n  --shadow-md: 0 10px 15px -3px rgb(0 0 0 / 10%), 0 4px 6px -4px rgb(0 0 0 / 10%);\n  --shadow-lg: 0 20px 25px -5px rgb(0 0 0 / 10%), 0 8px 10px -6px rgb(0 0 0 / 10%);\n}\n\n:root{\n  --duration-instant: 0ms;\n  --duration-fast: .1s;\n  --duration-short: .15s;\n  --duration-medium: .2s;\n  --easing-standard: cubic-bezier(.4, 0, .2, 1);\n  --easing-emphasized: cubic-bezier(.2, 0, 0, 1);\n  --easing-out: cubic-bezier(.23, 1, .32, 1);\n  --motion-press-scale: .97;\n  --motion-press-duration: .15s;\n  --motion-press-easing: cubic-bezier(.23, 1, .32, 1);\n  --motion-surface-from-scale: .96;\n  --motion-surface-duration: .2s;\n  --motion-surface-easing: cubic-bezier(.23, 1, .32, 1);\n  --motion-indicator-duration: .2s;\n  --motion-indicator-easing: cubic-bezier(.2, 0, 0, 1);\n  --motion-fade-duration: .1s;\n  --motion-fade-easing: cubic-bezier(.23, 1, .32, 1);\n  --motion-highlight-chase-duration: .1s;\n  --motion-highlight-chase-easing: cubic-bezier(.23, 1, .32, 1);\n  --transition-colors: background-color var(--duration-short) var(--easing-standard), color var(--duration-short) var(--easing-standard), border-color var(--duration-short) var(--easing-standard), box-shadow var(--duration-short) var(--easing-standard), opacity var(--duration-short) var(--easing-standard);\n  --transition-fade: background-color var(--motion-fade-duration) var(--motion-fade-easing), color var(--motion-fade-duration) var(--motion-fade-easing), border-color var(--motion-fade-duration) var(--motion-fade-easing), opacity var(--motion-fade-duration) var(--motion-fade-easing);\n  --transition-press: transform var(--motion-press-duration) var(--motion-press-easing);\n  --transition-surface: opacity var(--motion-surface-duration) var(--motion-surface-easing), transform var(--motion-surface-duration) var(--motion-surface-easing);\n  --transition-indicator: left var(--motion-indicator-duration) var(--motion-indicator-easing), width var(--motion-indicator-duration) var(--motion-indicator-easing), transform var(--motion-indicator-duration) var(--motion-indicator-easing), background-color var(--duration-short) var(--easing-standard);\n  --transition-highlight-chase: top var(--motion-highlight-chase-duration) var(--motion-highlight-chase-easing), height var(--motion-highlight-chase-duration) var(--motion-highlight-chase-easing), opacity var(--motion-highlight-chase-duration) var(--motion-highlight-chase-easing);\n}\n\n:root{\n  --ring: var(--border-focused-primary);\n  --control-height-large: 48px;\n  --control-height-medium: 40px;\n  --control-height-small: 32px;\n  --control-height-extra-small: 24px;\n  --control-height-l: 48px;\n  --control-height-m: 40px;\n  --control-height-s: 32px;\n  --control-height-xs: 24px;\n  --z-drawer: 1200;\n  --z-modal: 1300;\n  --z-dropdown: 1300;\n  --z-popover: 1300;\n  --z-toast: 1400;\n  --z-tooltip: 1500;\n  --font-fa-free: \"Font Awesome 7 Free\";\n  --font-fa-pro: \"Font Awesome 7 Pro\";\n  --font-fa-brands: \"Font Awesome 7 Brands\";\n  --syntax-attribute: #B34800;\n  --syntax-comment: #69788A;\n  --syntax-keyword: #4C42CF;\n  --syntax-number: #0B43A3;\n  --syntax-property: #B5004F;\n  --syntax-punctuation: #596069;\n  --syntax-selector: #1A7F85;\n  --syntax-string: #1F7028;\n  --syntax-tag: #3228B7;\n  --syntax-value: #1570D1;\n}\n\n/* ==========================================================\n   CADS references (manifest v0.1.0)\n   Tokens: everything below uses CADS variables, no hex colors.\n   Recipes rebuilt in plain CSS from the CADS manifest and runtime:\n     Chip (large, thick label): .chip, and .option at medium size\n     Button (outlined, secondary, small): .outline-button\n     Dropdown trigger (small): .select\n     Focus ring: 2px gap + 2px --ring on every control\n   Patterns from the CodeAI UI guide:\n     Card with hairline and radius-md, 40px header, overline label,\n     gray inner well, selected tokens for chosen state, no brand fills\n     for selection.\n   Not CADS: the sample page (.sp) is mock content. It borrows primitive\n   brand and sentiment tokens as its four \"feels\". Where the manifest gave\n   no value (large chip padding, option font size) the value is approximate.\n   Fonts: Geist and Space Grotesk are named by the tokens but not loaded.\n   ========================================================== */\n\n/* ==========================================================\n   Base\n   ========================================================== */\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\nhtml {\n  font-size: 100%;\n}\n\nbody {\n  margin: 0;\n  background: var(--background-neutral-secondary);\n  color: var(--text-neutral-primary);\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-md);\n  line-height: var(--leading-body-md);\n}\n\nh1,\nh2,\nh3,\np {\n  margin: 0;\n}\n\nul {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\nbutton,\ninput,\nselect {\n  font: inherit;\n}\n\n[hidden] {\n  display: none !important;\n}\n\n.visually-hidden {\n  position: absolute;\n  inline-size: 1px;\n  block-size: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n}\n\n/* Shared line-icon style */\n.ico {\n  flex: none;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* CADS focus recipe: 2px gap, then a 2px ring (never removed) */\n.chip:focus-visible,\n.option:focus-visible,\n.outline-button:focus-visible,\n.select:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--background-neutral-primary), 0 0 0 4px var(--ring);\n}\n\n/* ==========================================================\n   Layout (lab territory: tight chrome, airy content)\n   ========================================================== */\n\n.app {\n  max-inline-size: 80rem;\n  margin-inline: auto;\n  padding: var(--spacing-p-xs);\n}\n\n/* Narrow: prompt above page. Wide: prompt and options on the left, sample page on the right. */\n.workspace {\n  display: grid;\n}\n\n@media (min-width: 48rem) {\n  .workspace {\n    grid-template-columns: minmax(0, 1fr) 3rem minmax(0, 1.15fr);\n    align-items: start;\n  }\n}\n\n.app-error {\n  margin-block-end: var(--spacing-p-xs);\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border: 1px solid var(--border-error-mid);\n  border-radius: var(--shape-md);\n  background: var(--background-error-light);\n  color: var(--text-error-secondary);\n  font-size: var(--text-body-sm);\n  line-height: var(--leading-body-sm);\n}\n\n/* Overline: the CodeAI grouping device */\n.overline {\n  font-size: var(--text-body-xs);\n  line-height: var(--leading-body-xs);\n  font-weight: var(--font-weight-semi-bold);\n  letter-spacing: var(--tracking-overline);\n  text-transform: uppercase;\n  color: var(--text-neutral-quaternary);\n}\n\n/* Card: white fill, 1px hairline, radius-md; 40px header with centered overline */\n.card {\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n  overflow: hidden;\n}\n\n.card-header {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-block-size: 2.5rem;\n  padding-inline: var(--spacing-p-xs);\n  border-block-end: 1px solid var(--border-neutral-primary);\n  text-align: center;\n}\n\n.card-body {\n  display: grid;\n  gap: var(--spacing-p-xs);\n  padding: var(--spacing-p-xs);\n}\n\n.header-action {\n  position: absolute;\n  inset-inline-end: 0.5rem;\n}\n\n/* Author preview bar */\n.preview-bar {\n  display: flex;\n  align-items: center;\n  justify-content: flex-start;\n  gap: var(--spacing-p-xxs);\n  margin-block-end: var(--spacing-p-xxs);\n}\n\n/* Dropdown trigger recipe (small) */\n.select-wrap {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n}\n\n.select {\n  appearance: none;\n  block-size: var(--control-height-small);\n  padding-inline: 0.75rem 2rem;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-sm);\n  line-height: var(--leading-body-sm);\n  cursor: pointer;\n  transition: var(--transition-colors);\n}\n\n.select:hover {\n  background: var(--background-neutral-tertiary);\n}\n\n.select-chevron {\n  position: absolute;\n  inset-inline-end: 0.5rem;\n  inline-size: 1rem;\n  block-size: 1rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n  color: var(--text-neutral-primary);\n  pointer-events: none;\n}\n\n/* ==========================================================\n   Prompt card\n   ========================================================== */\n\n/* Gray inner well. The ghost copy holds the height of the longest possible\n   prompt so nothing below jumps while details change. */\n.prompt-well {\n  display: grid;\n  padding: var(--spacing-p-xs);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-secondary);\n}\n\n.prompt-well > * {\n  grid-area: 1 / 1;\n}\n\n.prompt-text {\n  font-size: var(--text-body-md);\n  line-height: var(--leading-body-md);\n  color: var(--text-neutral-primary);\n}\n\n.prompt-ghost {\n  visibility: hidden;\n  pointer-events: none;\n}\n\n/* Each detail in the prompt carries its chip's icon, so it can be traced to the page */\n.prompt-bit {\n  padding: 0.05em 0.3em;\n  border-block-end: 2px solid var(--border-selected-primary);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-primary);\n  -webkit-box-decoration-break: clone;\n  box-decoration-break: clone;\n}\n\n.prompt-lead {\n  white-space: nowrap;\n}\n\n.prompt-icon {\n  display: inline-block;\n  inline-size: 0.9em;\n  block-size: 0.9em;\n  margin-inline-end: 0.3em;\n  vertical-align: -0.1em;\n  color: var(--text-neutral-quaternary);\n}\n\n.prompt-bit.is-new {\n  animation: bit-in var(--duration-medium) var(--easing-out);\n}\n\n@keyframes bit-in {\n  from {\n    opacity: 0;\n    transform: translateY(0.25rem);\n  }\n  to {\n    opacity: 1;\n    transform: none;\n  }\n}\n\n/* Chip fieldset */\n.chip-set {\n  min-inline-size: 0;\n  margin: 0;\n  padding: 0;\n  border: 0;\n}\n\n.chip-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: var(--spacing-p-xxs);\n}\n\n/* Chip recipe: large (48px), thick label, primary color.\n   Unselected: white, solid hairline. Selected: selected tokens, never brand.\n   Here \"selected\" means the chip has a choice in the prompt. */\n.chip,\n.option {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.5rem;\n  border: 1px solid var(--border-neutral-solid);\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font-family: var(--font-family-main);\n  font-weight: var(--font-weight-semi-bold);\n  white-space: nowrap;\n  cursor: pointer;\n  transition: var(--transition-colors), var(--transition-press);\n}\n\n.chip {\n  block-size: var(--control-height-large);\n  padding-inline: 1rem;\n  font-size: var(--text-body-md);\n  line-height: var(--leading-body-md);\n}\n\n/* Option chip: medium (40px) */\n.option {\n  block-size: var(--control-height-medium);\n  padding-inline: 0.875rem;\n  font-size: var(--text-body-sm);\n  line-height: var(--leading-body-sm);\n  white-space: normal;\n  text-align: center;\n}\n\n.chip:hover,\n.option:hover {\n  background: var(--background-neutral-tertiary);\n}\n\n/* The open chip: a 2px selected border, same outer size */\n.chip[aria-expanded=\"true\"]:not([data-set=\"true\"]) {\n  border: 2px solid var(--border-selected-primary);\n  padding-inline: calc(1rem - 1px);\n}\n\n.chip[data-set=\"true\"],\n.option[aria-pressed=\"true\"] {\n  border-color: transparent;\n  background: var(--background-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n.chip[data-set=\"true\"]:hover,\n.option[aria-pressed=\"true\"]:hover {\n  background: var(--background-selected-strong);\n}\n\n.chip[data-set=\"true\"][aria-expanded=\"true\"] {\n  box-shadow: inset 0 0 0 2px var(--border-selected-strong);\n}\n\n.chip:active,\n.option:active {\n  transform: scale(var(--motion-press-scale));\n}\n\n.chip-icon,\n.chip-end {\n  inline-size: 1.25rem;\n  block-size: 1.25rem;\n}\n\n.chip-end {\n  margin-inline-start: auto;\n}\n\n.chip-label {\n  margin-inline-end: auto;\n}\n\n/* End icon: chevron while empty (turns when open), check once a choice is made.\n   The check keeps the choice from relying on color alone. */\n.chip[data-set=\"true\"] .chip-chevron,\n.chip:not([data-set=\"true\"]) .chip-check {\n  display: none;\n}\n\n.chip[aria-expanded=\"true\"] .chip-chevron {\n  transform: rotate(180deg);\n}\n\n/* Options panel */\n.options {\n  display: grid;\n  align-content: start;\n  min-block-size: 6rem;\n  padding: var(--spacing-p-xs);\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n}\n\n.options-empty {\n  align-self: center;\n  justify-self: center;\n  font-size: var(--text-body-sm);\n  line-height: var(--leading-body-sm);\n  color: var(--text-neutral-quaternary);\n  text-align: center;\n}\n\n.options-body {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n}\n\n.options-title {\n  font-weight: var(--font-weight-semi-bold);\n  color: var(--text-neutral-primary);\n}\n\n.option-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-p-xxs);\n}\n\n/* Button recipe: outlined, secondary, small (32px) */\n.outline-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  block-size: var(--control-height-small);\n  padding-inline: 0.75rem;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-sm);\n  line-height: var(--leading-body-sm);\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n  transition: var(--transition-colors);\n}\n\n.outline-button:hover {\n  background: var(--background-neutral-tertiary);\n}\n\n.outline-button:active {\n  background: var(--background-neutral-quaternary);\n}\n\n/* ==========================================================\n   Spark (a simple abstract spark stands in for the AI)\n   ========================================================== */\n\n.spark-zone {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n\n.spark-line {\n  inline-size: 0;\n  block-size: 1rem;\n  border-inline-start: 2px dotted var(--border-neutral-secondary);\n}\n\n@media (min-width: 48rem) {\n  .spark-zone {\n    flex-direction: row;\n    align-self: start;\n    margin-block-start: 8rem;\n  }\n\n  .spark-line {\n    inline-size: 0.25rem;\n    block-size: 0;\n    border-inline-start: 0;\n    border-block-start: 2px dotted var(--border-neutral-secondary);\n  }\n}\n\n.spark {\n  position: relative;\n  display: grid;\n  place-items: center;\n  inline-size: 2.5rem;\n  block-size: 2.5rem;\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-primary);\n  box-shadow: var(--shadow-sm);\n  transition: var(--transition-colors);\n}\n\n.spark-core {\n  inline-size: 1.25rem;\n  block-size: 1.25rem;\n  fill: var(--background-accent-orange-primary);\n  animation: spark-idle 2.4s ease-in-out infinite;\n}\n\n.spark-ring {\n  position: absolute;\n  inset: 0;\n  border: 2px solid var(--border-accent-orange-mid);\n  border-radius: var(--shape-round);\n  opacity: 0;\n}\n\n.spark.pop .spark-core {\n  animation: spark-pop 0.45s var(--easing-out);\n}\n\n.spark.pop .spark-ring {\n  animation: spark-ring 0.55s var(--easing-out);\n}\n\n@keyframes spark-idle {\n  0%,\n  100% {\n    transform: scale(0.94);\n    opacity: 0.8;\n  }\n  50% {\n    transform: scale(1.08);\n    opacity: 1;\n  }\n}\n\n@keyframes spark-pop {\n  0% {\n    transform: scale(1) rotate(0deg);\n  }\n  35% {\n    transform: scale(1.5) rotate(25deg);\n  }\n  100% {\n    transform: scale(1) rotate(0deg);\n  }\n}\n\n@keyframes spark-ring {\n  from {\n    transform: scale(0.7);\n    opacity: 0.8;\n  }\n  to {\n    transform: scale(2);\n    opacity: 0;\n  }\n}\n\n/* ==========================================================\n   Page card: frame and \"what each detail did\"\n   ========================================================== */\n\n.page-frame {\n  border: 2px solid var(--border-neutral-primary);\n  border-radius: var(--shape-lg);\n  background: var(--background-neutral-primary);\n  overflow: hidden;\n}\n\n.effects-section {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n}\n\n.effects-heading {\n  text-align: start;\n}\n\n/* Notes: a label and one short takeaway each. Two across, so all four show at once. */\n.effects {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n}\n\n.page-card .card-body {\n  container-type: inline-size;\n}\n\n@container (min-width: 36rem) {\n  .effects {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n.effect {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  gap: 0.75rem;\n  align-items: center;\n  padding: 0.5rem 0.75rem;\n  border: 1px solid var(--border-neutral-primary);\n  border-inline-start: 4px solid var(--border-selected-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n}\n\n.effect.is-empty {\n  border: 1px dashed var(--border-neutral-secondary);\n  background: var(--background-neutral-secondary);\n}\n\n.effect.is-new {\n  animation: effect-in 1.2s var(--easing-out);\n}\n\n@keyframes effect-in {\n  from {\n    background-color: var(--background-neutral-quaternary);\n  }\n  to {\n    background-color: var(--background-neutral-primary);\n  }\n}\n\n.effect-icon {\n  display: grid;\n  place-items: center;\n  inline-size: 2rem;\n  block-size: 2rem;\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-tertiary);\n  color: var(--text-neutral-quaternary);\n}\n\n.effect.is-set .effect-icon {\n  background: var(--background-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n.effect-icon svg {\n  inline-size: 1.125rem;\n  block-size: 1.125rem;\n}\n\n.effect-copy {\n  display: grid;\n  gap: 0.125rem;\n}\n\n.effect-label {\n  font-size: var(--text-body-xs);\n  line-height: var(--leading-body-xs);\n  font-weight: var(--font-weight-semi-bold);\n  letter-spacing: var(--tracking-overline);\n  text-transform: uppercase;\n  color: var(--text-neutral-quaternary);\n}\n\n.effect-text {\n  font-size: var(--text-body-md);\n  line-height: var(--leading-body-md);\n  font-weight: var(--font-weight-semi-bold);\n  color: var(--text-neutral-primary);\n}\n\n.effect.is-empty .effect-text {\n  font-weight: var(--font-weight-regular);\n  color: var(--text-neutral-tertiary);\n}\n\n/* ==========================================================\n   Sample page\n   Four layers, each driven by a data attribute on .sp:\n     data-who      the headline and intro words\n     data-parts    the pieces on the page (otherwise only plain text)\n     data-content  the words and numbers\n     data-palette  the feel: warm, bold, fresh or clean\n   With nothing chosen the page is a title and a few plain lines.\n   ========================================================== */\n\n.sp {\n  position: relative;\n  display: block;\n  /* wireframe defaults, all neutral tokens */\n  --sp-bg: var(--background-neutral-primary);\n  --sp-hero: var(--background-neutral-primary);\n  --sp-card: var(--background-neutral-primary);\n  --sp-media: var(--background-neutral-tertiary);\n  --sp-line: var(--border-neutral-primary);\n  --sp-accent: var(--background-neutral-primary-inverse);\n  --sp-on-accent: var(--text-neutral-primary-inverse);\n  --sp-head: var(--text-neutral-primary);\n  --sp-glyph: var(--text-neutral-quaternary);\n  --sp-radius: var(--shape-sm);\n  --sp-heading-font: var(--font-family-main);\n  --sp-w1: var(--background-neutral-tertiary);\n  --sp-w2: var(--background-neutral-quaternary);\n  --sp-w3: var(--background-neutral-quinary);\n  --sp-w4: var(--background-neutral-quaternary);\n  background: var(--sp-bg);\n  color: var(--text-neutral-primary);\n  font-size: var(--text-body-sm);\n  line-height: var(--leading-body-sm);\n}\n\n/* The four feels. Same words, same look, on every destination. */\n.sp[data-palette=\"warm\"] {\n  --sp-hero: var(--brand-pink-5);\n  --sp-media: var(--brand-orange-10);\n  --sp-line: var(--brand-orange-20);\n  --sp-accent: var(--brand-pink-60);\n  --sp-on-accent: var(--text-neutral-white-fixed);\n  --sp-head: var(--brand-pink-80);\n  --sp-glyph: var(--brand-orange-70);\n  --sp-radius: var(--shape-xl);\n  --sp-heading-font: var(--font-family-heading);\n  --sp-w1: var(--brand-pink-60);\n  --sp-w2: var(--brand-orange-70);\n  --sp-w3: var(--brand-pink-80);\n  --sp-w4: var(--brand-orange-80);\n}\n\n.sp[data-palette=\"bold\"] {\n  --sp-hero: var(--brand-purple-5);\n  --sp-media: var(--brand-purple-10);\n  --sp-line: var(--brand-purple-20);\n  --sp-accent: var(--brand-purple-60);\n  --sp-on-accent: var(--text-neutral-white-fixed);\n  --sp-head: var(--brand-purple-80);\n  --sp-glyph: var(--brand-purple-60);\n  --sp-radius: var(--shape-xl);\n  --sp-heading-font: var(--font-family-heading);\n  --sp-w1: var(--brand-purple-60);\n  --sp-w2: var(--brand-pink-60);\n  --sp-w3: var(--brand-orange-70);\n  --sp-w4: var(--sentiment-success-70);\n}\n\n.sp[data-palette=\"fresh\"] {\n  --sp-hero: var(--sentiment-success-5);\n  --sp-media: var(--sentiment-success-10);\n  --sp-line: var(--sentiment-success-20);\n  --sp-accent: var(--sentiment-success-70);\n  --sp-on-accent: var(--text-neutral-white-fixed);\n  --sp-head: var(--sentiment-success-90);\n  --sp-glyph: var(--sentiment-success-70);\n  --sp-radius: var(--shape-lg);\n  --sp-heading-font: var(--font-family-heading);\n  --sp-w1: var(--sentiment-success-70);\n  --sp-w2: var(--sentiment-success-90);\n  --sp-w3: var(--sentiment-information-70);\n  --sp-w4: var(--sentiment-success-80);\n}\n\n.sp[data-palette=\"clean\"] {\n  --sp-hero: var(--background-neutral-secondary);\n  --sp-media: var(--sentiment-information-5);\n  --sp-line: var(--border-neutral-primary);\n  --sp-accent: var(--sentiment-information-70);\n  --sp-on-accent: var(--text-neutral-white-fixed);\n  --sp-head: var(--text-neutral-primary);\n  --sp-glyph: var(--sentiment-information-70);\n  --sp-radius: var(--shape-sm);\n  --sp-heading-font: var(--font-family-main);\n  --sp-w1: var(--sentiment-information-70);\n  --sp-w2: var(--sentiment-information-90);\n  --sp-w3: var(--neutral-gray-70);\n  --sp-w4: var(--sentiment-information-80);\n}\n\n/* Text: gray bar when its layer is off, words when on. The --d index staggers the fill. */\n.t {\n  display: block;\n  inline-size: fit-content;\n  max-inline-size: 100%;\n  border-radius: var(--shape-sm);\n  transition:\n    color var(--duration-medium) var(--easing-standard) calc(var(--d, 0) * 60ms),\n    background-color var(--duration-medium) var(--easing-standard) calc(var(--d, 0) * 60ms);\n}\n\n.sp[data-who=\"off\"] .t-who,\n.sp[data-content=\"off\"] .t-content {\n  background-color: var(--background-neutral-quaternary);\n  color: transparent;\n}\n\n.sp[data-who=\"on\"] .t-who,\n.sp[data-content=\"on\"] .t-content {\n  background-color: transparent;\n}\n\n/* Flash: shows which part of the page a change reached */\n.flash {\n  outline: 3px solid var(--border-selected-primary);\n  outline-offset: -3px;\n}\n\n.flash-tag {\n  position: absolute;\n  inset-block-start: 0.5rem;\n  inset-inline-end: 0.5rem;\n  z-index: 2;\n  display: inline-flex;\n  align-items: center;\n  gap: 0.25rem;\n  block-size: 1.5rem;\n  padding-inline: 0.5rem;\n  border-radius: var(--shape-sm);\n  background: var(--background-selected-primary);\n  color: var(--text-selected-primary);\n  font-size: var(--text-body-xs);\n  line-height: var(--leading-body-xs);\n  font-weight: var(--font-weight-semi-bold);\n  white-space: nowrap;\n}\n\n.flash-tag svg {\n  inline-size: 0.875rem;\n  block-size: 0.875rem;\n}\n\n.sp-hero .flash-tag {\n  inset-block-start: auto;\n  inset-block-end: 0.5rem;\n}\n\n/* Frame pieces */\n.sp-chrome {\n  display: flex;\n  align-items: center;\n  min-block-size: 2.5rem;\n  padding: 0.5rem 0.75rem;\n  border-block-end: 1px solid var(--border-neutral-primary);\n  background: var(--background-neutral-secondary);\n}\n\n.page-url {\n  display: flex;\n  flex: 1;\n  align-items: center;\n  max-inline-size: 16rem;\n  min-block-size: 1.5rem;\n  padding: 0.125rem 0.5rem;\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-primary);\n}\n\n.url-text {\n  font-size: var(--text-body-xs);\n  line-height: var(--leading-body-xs);\n}\n\n.sp-hero {\n  position: relative;\n  display: grid;\n  gap: 0.5rem;\n  justify-items: start;\n  padding: 1rem 0.875rem;\n  background: var(--sp-hero);\n  transition: var(--transition-colors);\n}\n\n.sp-headline {\n  font-family: var(--sp-heading-font);\n  font-size: var(--text-heading-xs);\n  line-height: var(--leading-heading-xs);\n  font-weight: var(--font-weight-semi-bold);\n  color: var(--sp-head);\n}\n\n.sp-sub {\n  color: var(--text-neutral-secondary);\n}\n\n.sp-main {\n  position: relative;\n  display: block;\n  padding: 0.875rem;\n  min-block-size: 8.5rem;\n}\n\n@media (min-width: 40rem) {\n  .sp-headline {\n    font-size: var(--text-heading-sm);\n    line-height: var(--leading-heading-sm);\n  }\n}\n\n/* Parts off: the page is only plain text lines.\n   Parts on: the pieces replace them. */\n.plain {\n  display: grid;\n  gap: 0.5rem;\n  justify-items: start;\n}\n\n.sp[data-parts=\"on\"] .plain,\n.sp[data-parts=\"off\"] .parts {\n  display: none;\n}\n\n.parts {\n  display: grid;\n  gap: 0.75rem;\n  animation: parts-in var(--duration-medium) var(--easing-out);\n}\n\n@keyframes parts-in {\n  from {\n    opacity: 0;\n    transform: translateY(0.375rem);\n  }\n  to {\n    opacity: 1;\n    transform: none;\n  }\n}\n\n/* Shared pieces */\n.box {\n  border: 1px solid var(--sp-line);\n  border-radius: var(--sp-radius);\n  background: var(--sp-card);\n  box-shadow: var(--shadow-sm);\n  transition: var(--transition-colors);\n}\n\n.media {\n  display: grid;\n  place-items: center;\n  border-radius: var(--sp-radius);\n  background: var(--sp-media);\n  color: var(--sp-glyph);\n  transition: var(--transition-colors);\n}\n\n.media svg {\n  inline-size: 55%;\n  block-size: 55%;\n  max-inline-size: 2.5rem;\n  max-block-size: 2.5rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.75;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.media .g-fill {\n  fill: currentColor;\n  stroke: none;\n}\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  justify-self: start;\n  min-inline-size: 7rem;\n  min-block-size: 2.25rem;\n  padding: 0.25rem 1rem;\n  border-radius: var(--sp-radius);\n  background: var(--sp-accent);\n  color: var(--sp-on-accent);\n  font-weight: var(--font-weight-semi-bold);\n  transition: var(--transition-colors);\n}\n\n.btn-big {\n  min-block-size: 3.25rem;\n  min-inline-size: 12rem;\n  font-size: var(--text-body-lg);\n}\n\n.menu-list {\n  display: grid;\n  gap: 0.5rem;\n}\n\n.menu-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.75rem;\n  padding: 0.5rem 0.75rem;\n}\n\n.order-row {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.75rem;\n}\n\n/* Bake sale */\n.items {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 0.5rem;\n}\n\n.item {\n  display: grid;\n  gap: 0.375rem;\n  align-content: start;\n  padding: 0.5rem;\n}\n\n.item-media {\n  aspect-ratio: 4 / 3;\n}\n\n.item-name {\n  font-size: var(--text-body-xs);\n  line-height: var(--leading-body-xs);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.item-price {\n  font-size: var(--text-body-xs);\n  line-height: var(--leading-body-xs);\n}\n\n.featured {\n  display: grid;\n  grid-template-columns: minmax(0, 8rem) minmax(0, 1fr);\n  gap: 0.75rem;\n  align-items: center;\n  padding: 0.625rem;\n}\n\n.featured-media {\n  aspect-ratio: 1;\n}\n\n.featured-copy {\n  display: grid;\n  gap: 0.25rem;\n  justify-items: start;\n}\n\n.featured-name {\n  font-family: var(--sp-heading-font);\n  font-size: var(--text-body-lg);\n  line-height: var(--leading-body-lg);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n/* Decision wheel */\n.wheel-layout {\n  display: grid;\n  grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);\n  gap: 1rem;\n  align-items: center;\n}\n\n.wheel {\n  display: block;\n  inline-size: 100%;\n  block-size: auto;\n}\n\n.wedge {\n  fill: var(--wf);\n  stroke: var(--background-neutral-primary);\n  stroke-width: 2;\n  transition: fill var(--duration-medium) var(--easing-standard);\n}\n\n.wedge-0 { --wf: var(--sp-w1); }\n.wedge-1 { --wf: var(--sp-w2); }\n.wedge-2 { --wf: var(--sp-w3); }\n.wedge-3 { --wf: var(--sp-w4); }\n\n.wheel-hub {\n  fill: var(--background-neutral-primary);\n  stroke: var(--border-neutral-secondary);\n  stroke-width: 2;\n}\n\n.wheel-pointer {\n  fill: var(--text-neutral-primary);\n}\n\n.wedge-label {\n  fill: var(--text-neutral-white-fixed);\n  font-family: var(--font-family-main);\n  font-size: 11px;\n  font-weight: var(--font-weight-semi-bold);\n  text-anchor: middle;\n  dominant-baseline: middle;\n  transition: opacity var(--duration-medium) var(--easing-standard);\n}\n\n/* Slice labels hide until the content layer is on */\n.sp[data-content=\"off\"] .wedge-label {\n  opacity: 0;\n}\n\n.wheel-side {\n  display: grid;\n  gap: 0.75rem;\n  justify-items: start;\n}\n\n.big-spin {\n  display: grid;\n  gap: 0.75rem;\n  justify-items: center;\n}\n\n.result-box {\n  inline-size: 100%;\n  padding: 1rem;\n  text-align: center;\n}\n\n.result-box .t {\n  margin-inline: auto;\n  font-family: var(--sp-heading-font);\n  font-size: var(--text-body-lg);\n  line-height: var(--leading-body-lg);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n/* Save the park */\n.park-media {\n  block-size: 6rem;\n}\n\n.park-media svg {\n  max-inline-size: 3rem;\n  max-block-size: 3rem;\n}\n\n.meter-block {\n  display: grid;\n  gap: 0.375rem;\n}\n\n.meter {\n  block-size: 0.75rem;\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-tertiary);\n  overflow: hidden;\n}\n\n.meter-fill {\n  display: block;\n  inline-size: var(--fill);\n  block-size: 100%;\n  border-radius: var(--shape-round);\n  background: var(--sp-accent);\n}\n\n.meter-count {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.field {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  min-block-size: 2.25rem;\n  padding: 0.25rem 0.75rem;\n}\n\n.field-hint {\n  color: var(--text-neutral-quaternary);\n}\n\n/* Weather checker */\n.search-row {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.search-row .field {\n  flex: 1 1 8rem;\n}\n\n.field svg {\n  flex: none;\n  inline-size: 1rem;\n  block-size: 1rem;\n  fill: none;\n  stroke: var(--text-neutral-quaternary);\n  stroke-width: 2;\n  stroke-linecap: round;\n}\n\n.now {\n  display: flex;\n  align-items: center;\n  gap: 0.875rem;\n  padding: 0.625rem;\n}\n\n.now-big {\n  gap: 1.25rem;\n  padding: 1rem;\n}\n\n.now-media {\n  flex: none;\n  inline-size: 4rem;\n  block-size: 4rem;\n}\n\n.now-big .now-media {\n  inline-size: 6rem;\n  block-size: 6rem;\n}\n\n.now-copy {\n  display: grid;\n  gap: 0.25rem;\n  justify-items: start;\n}\n\n.now-temp {\n  font-family: var(--sp-heading-font);\n  font-size: var(--text-heading-xs);\n  line-height: var(--leading-heading-xs);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.now-big .now-temp {\n  font-size: var(--text-heading-lg);\n  line-height: var(--leading-heading-lg);\n}\n\n.days {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 0.5rem;\n}\n\n.day {\n  display: grid;\n  justify-items: center;\n  gap: 0.25rem;\n  padding: 0.5rem;\n  font-size: var(--text-body-xs);\n  line-height: var(--leading-body-xs);\n}\n\n.day-media {\n  inline-size: 2.25rem;\n  block-size: 2.25rem;\n}\n\n.row-media {\n  flex: none;\n  inline-size: 1.75rem;\n  block-size: 1.75rem;\n}\n\n.row-main {\n  display: flex;\n  flex: 1;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n/* ==========================================================\n   Reduced motion\n   ========================================================== */\n\n@media (prefers-reduced-motion: reduce) {\n  .spark-core,\n  .spark.pop .spark-core,\n  .spark.pop .spark-ring,\n  .prompt-bit.is-new,\n  .effect.is-new,\n  .parts {\n    animation: none;\n  }\n\n  .spark.pop {\n    background: var(--background-accent-orange-light);\n  }\n\n  .t,\n  .sp *,\n  .chip,\n  .option {\n    transition-duration: 0.01ms;\n    transition-delay: 0s;\n  }\n\n  .chip:active,\n  .option:active {\n    transform: none;\n  }\n}\n",
          "folderId": "0",
          "active": false
        }
      },
