      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Show / Hide Information</title>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n  <div class=\"app\">\n    <h2>Help & FAQs</h2>\n\n    <div class=\"faq-item\">\n      <button id=\"question1\">What is this app?</button>\n      <p id=\"answer1\">\n        This app helps you read and customize your experience.\n      </p>\n    </div>\n\n    <div class=\"faq-item\">\n      <button id=\"question2\">How do I change settings?</button>\n      <p id=\"answer2\">\n        Use the buttons at the top of the page to adjust your preferences.\n      </p>\n    </div>\n\n  </div>\n\n  <script src=\"script.js\"></script>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  font-family: Arial, sans-serif;\n  background: linear-gradient(180deg, #1f2125 0%, #2d3035 100%);\n  color: #ffffff;\n  padding: 32px 16px;\n}\n\n.app {\n  max-width: 600px;\n  margin: 0 auto;\n}\n\nh2 {\n  margin-bottom: 24px;\n  font-size: 2.2rem;\n}\n\n.faq-item {\n  margin-bottom: 16px;\n}\n\nbutton {\n  width: 100%;\n  text-align: left;\n  padding: 16px;\n  font-size: 1rem;\n  font-weight: 600;\n  border: none;\n  border-radius: 12px;\n  background: #4a4d52;\n  color: white;\n  cursor: pointer;\n  transition: background 0.15s ease, transform 0.1s ease;\n}\n\nbutton:hover {\n  background: #5a5d63;\n  transform: translateY(-1px);\n}\n\np {\n  margin: 8px 0 0 0;\n  padding: 14px;\n  background: #f8f5ef;\n  color: #222;\n  border-radius: 12px;\n  line-height: 1.6;\n  display: none; /* hidden by default */\n}\n\n@media (max-width: 500px) {\n  h2 {\n    font-size: 1.8rem;\n  }\n\n  button {\n    padding: 14px;\n  }\n\n  p {\n    padding: 12px;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const question1 = document.getElementById(\"question1\");\nconst answer1 = document.getElementById(\"answer1\");\n\nconst question2 = document.getElementById(\"question2\");\nconst answer2 = document.getElementById(\"answer2\");\n\nconst toggleAnswer = (answer) => {\n  if (answer.style.display === \"block\") {\n    answer.style.display = \"none\";\n  } else {\n    answer.style.display = \"block\";\n  }\n};\n\nquestion1.addEventListener(\"click\", () => {\n  toggleAnswer(answer1);\n});\n\nquestion2.addEventListener(\"click\", () => {\n  toggleAnswer(answer2);\n});",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "3"
      ]
    },
