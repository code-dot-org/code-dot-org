    "display_name": "Social Web App",
    "bubble_choice_description": "Complete the `script.js` code to make your Social Web App work.",
    "thumbnail_url": "https://images.code.org/51f0c5daa347323528b7b432245b791d-Screenshot 2025-10-16 at 5.47.47 PM.png",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Keep the Streak</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <main class=\"wrap\">\n    <h1>Keep the Streak 🔥</h1>\n\n    <section class=\"card\">\n      <h2>Streak Counter</h2>\n\n      <div class=\"streak-display\">\n        <span id=\"streakCount\">0</span>\n      </div>\n\n      <div class=\"buttons\">\n        <button id=\"streakBtn\" class=\"btn flame\">+1 Streak</button>\n        <button id=\"boostBtn\"  class=\"btn boost\">+5 Boost</button>\n        <button id=\"resetBtn\"  class=\"btn reset\">Reset</button>\n      </div>\n\n      <p class=\"hint\">Tap to stack your streaks. Boost for a fiery +5. Don’t let the streak burn out!</p>\n    </section>\n  </main>\n\n  <script src=\"script.js\"></script>\n</body>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// variable for streak\n\n\n\n// references to display element and buttons\nconst streakCount = document.getElementById('streakCount'); // display\nconst streakBtn     = document.getElementById('streakBtn');   // +1\nconst boostBtn   = document.getElementById('boostBtn');    // +5\nconst resetBtn    = document.getElementById('resetBtn');    // reset\n\n\n// increases streak by 1 and updates the display\nstreakBtn.addEventListener('click', () => {\n\n\n  \n});\n\n// increases streaks by 5 and updates the display\nboostBtn.addEventListener('click', () => {\n\n\n  \n});\n\n// resets streaks to 0 and updates the display\nresetBtn.addEventListener('click', () => {\n\n  \n\n});\n",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": ":root{\n  --bg: #0b0f14;              /* deep charcoal */\n  --ink: #e5e7eb;             /* light ink */\n  --accent: #ff3d00;          /* neon lava */\n  --accent2: #ff8a00;         /* hot ember */\n  --reset: #7c8590;           /* cool gray */\n  --shadow: 0 18px 40px rgba(0,0,0,.5);\n  --glow: 0 0 12px rgba(255,61,0,.45), 0 0 28px rgba(255,138,0,.35);\n}\n\n*{ box-sizing: border-box; }\n\nhtml, body { height: 100%; }\n\nbody{\n  margin: 0;\n  background:\n    radial-gradient(1000px 600px at 85% -10%, rgba(255,61,0,.18), transparent 60%),\n    radial-gradient(900px 500px at 10% 110%, rgba(255,138,0,.15), transparent 60%),\n    var(--bg);\n  color: var(--ink);\n  font-family: \"Chakra Petch\", system-ui, sans-serif;\n  display: grid;\n  place-items: start center;\n  padding-top: 7vh;\n}\n\nh1{\n  font-family: \"Russo One\", system-ui, sans-serif;\n  font-weight: 700;\n  letter-spacing: .5px;\n  margin: 0 0 1.2rem;\n  font-size: clamp(1.8rem, 3vw, 2.6rem);\n  text-transform: uppercase;\n  background: linear-gradient(90deg, #fff, #ffd4c2 30%, #ffa366 60%, #ff3d00 90%);\n  -webkit-background-clip: text;\n  background-clip: text;\n  color: transparent;\n  text-shadow: 0 2px 18px rgba(255,61,0,.15);\n}\n\n.card{\n  width: min(520px, 92vw);\n  background:\n    linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.02)),\n    rgba(255,255,255,.02);\n  border: 1px solid rgba(255,255,255,.08);\n  border-radius: 22px;\n  padding: 1.6rem 1.4rem 1.25rem;\n  box-shadow: var(--shadow);\n  backdrop-filter: blur(6px);\n}\n\n.card h2{\n  margin: 0 0 .75rem;\n  font-weight: 700;\n  letter-spacing: .5px;\n  color: #ffecd6;\n}\n\n.streak-display{\n  display: grid;\n  place-items: center;\n  height: clamp(120px, 24vw, 160px);\n  margin: .6rem 0 1.2rem;\n  border-radius: 16px;\n  border: 2px solid rgba(255,138,0,.45);\n  background:\n    radial-gradient(120% 160% at 50% 0%, rgba(255,138,0,.18), rgba(255,61,0,.12) 60%, rgba(0,0,0,.1) 100%),\n    linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.02));\n  box-shadow: inset 0 0 22px rgba(255,61,0,.18);\n}\n\n.streak-display span{\n  font-family: \"Russo One\", system-ui, sans-serif;\n  font-size: clamp(3.5rem, 12vw, 5rem);\n  line-height: 1;\n  color: #fff7f0;\n  text-shadow: 0 0 10px rgba(255,138,0,.35), 0 0 22px rgba(255,61,0,.25);\n}\n\n.buttons{\n  display: grid;\n  grid-template-columns: 1fr 1fr 1fr;\n  gap: .75rem;\n}\n\n.btn{\n  appearance: none;\n  border: none;\n  cursor: pointer;\n  border-radius: 14px;\n  padding: .8rem 1rem;\n  font-weight: 700;\n  color: #0b0f14;\n  transition: transform .08s ease, box-shadow .2s ease, filter .2s ease;\n  box-shadow: 0 6px 18px rgba(0,0,0,.35);\n}\n\n.btn:active{ transform: translateY(1px) scale(.99); }\n\n.flame{\n  background: linear-gradient(180deg, #ffbd59, #ff6a00);\n  box-shadow: var(--glow);\n}\n\n.flame:hover{\n  filter: brightness(1.05);\n  box-shadow: 0 0 12px rgba(255,189,89,.45), 0 0 28px rgba(255,106,0,.35);\n}\n\n.boost{\n  background: linear-gradient(180deg, #ffd166, #ff3d00);\n  box-shadow: var(--glow);\n}\n\n.boost:hover{\n  filter: brightness(1.06);\n  box-shadow: 0 0 12px rgba(255,209,102,.45), 0 0 30px rgba(255,61,0,.4);\n}\n\n.reset{\n  background: linear-gradient(180deg, #9aa3ad, #6b7280);\n  color: #f3f4f6;\n}\n\n.reset:hover{\n  filter: brightness(1.05);\n}\n\n.hint{\n  margin: 1rem 0 0;\n  font-size: .95rem;\n  color: #cbd5e1;\n  opacity: .9;\n}\n",
          "folderId": "0",
          "active": false
        }
