  "properties": {
    "display_name": "Scenario 2",
    "bubble_choice_description": "Create fallback content that appears when an image or file does not load.",
    "thumbnail_url": "https://images.code.org/28aa14482d96880dacc49d4463a06850-ChatGPT Image Jul 1, 2026, 08_16_21 PM.png",
    "encrypted": "false",
    "submittable": "false",
