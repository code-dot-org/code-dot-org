    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>VibeCheck: For You Feed</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <div class=\"phone-container\">\n    <header class=\"app-header\">\n      <div class=\"tab\">Following</div>\n      <div class=\"tab active\">For You</div>\n    </header>\n\n    <div id=\"feed-container\">\n      </div>\n    \n    <nav class=\"bottom-nav\">\n      <span>🏠</span>\n      <span>🔎</span>\n      <span class=\"plus-btn\">+</span>\n      <span>💬</span>\n      <span>👤</span>\n    </nav>\n  </div>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "//  Dataset\n//  Schema: id, author, likes, shares, views, hoursAgo, category\nconst allPosts = [\n  { id: 1, author: \"@dance_queen\", likes: 4500, shares: 1200, views: 25000, hoursAgo: 2, category: \"dance\" },\n  { id: 2, author: \"@news_bot\", likes: 20, shares: 5, views: 500, hoursAgo: 120, category: \"news\" },\n  { id: 3, author: \"@comedy_central\", likes: 12000, shares: 4500, views: 60000, hoursAgo: 5, category: \"humor\" },\n  { id: 4, author: \"@spam_king\", likes: 0, shares: 0, views: 10, hoursAgo: 1, category: \"spam\" },\n  { id: 5, author: \"@tech_guru\", likes: 850, shares: 200, views: 5000, hoursAgo: 6, category: \"tech\" },\n  { id: 6, author: \"@retro_gamer\", likes: 3200, shares: 400, views: 15000, hoursAgo: 12, category: \"gaming\" },\n  { id: 7, author: \"@fashion_icon\", likes: 5000, shares: 1000, views: 40000, hoursAgo: 48, category: \"fashion\" },\n  { id: 8, author: \"@cooking_mama\", likes: 900, shares: 300, views: 8000, hoursAgo: 3, category: \"food\" },\n  { id: 9, author: \"@politics_daily\", likes: 45, shares: 10, views: 1200, hoursAgo: 25, category: \"news\" },\n  { id: 10, author: \"@skater_boi\", likes: 1500, shares: 150, views: 9000, hoursAgo: 8, category: \"sports\" },\n  { id: 11, author: \"@cat_lovers\", likes: 25000, shares: 8000, views: 100000, hoursAgo: 1, category: \"animals\" },\n  { id: 12, author: \"@crypto_bro\", likes: 2, shares: 0, views: 50, hoursAgo: 10, category: \"finance\" },\n  { id: 13, author: \"@travel_bug\", likes: 6700, shares: 2100, views: 35000, hoursAgo: 23, category: \"travel\" },\n  { id: 14, author: \"@history_buff\", likes: 300, shares: 20, views: 2000, hoursAgo: 168, category: \"education\" },\n  { id: 15, author: \"@fitness_jim\", likes: 420, shares: 50, views: 3000, hoursAgo: 4, category: \"fitness\" },\n  { id: 16, author: \"@artist_anna\", likes: 1100, shares: 220, views: 6500, hoursAgo: 15, category: \"art\" },\n  { id: 17, author: \"@doggo_daily\", likes: 14000, shares: 3000, views: 55000, hoursAgo: 2, category: \"animals\" },\n  { id: 18, author: \"@movie_critic\", likes: 50, shares: 5, views: 400, hoursAgo: 72, category: \"movies\" },\n  { id: 19, author: \"@prank_patrol\", likes: 8900, shares: 4000, views: 45000, hoursAgo: 10, category: \"humor\" },\n  { id: 20, author: \"@science_today\", likes: 600, shares: 120, views: 4000, hoursAgo: 20, category: \"education\" },\n  { id: 21, author: \"@car_enthusiast\", likes: 2200, shares: 500, views: 12000, hoursAgo: 50, category: \"cars\" },\n  { id: 22, author: \"@music_vibes\", likes: 3100, shares: 900, views: 18000, hoursAgo: 7, category: \"music\" },\n  { id: 23, author: \"@gardening_pro\", likes: 75, shares: 10, views: 600, hoursAgo: 9, category: \"lifestyle\" },\n  { id: 24, author: \"@marketing_guru\", likes: 10, shares: 1, views: 100, hoursAgo: 1, category: \"business\" },\n  { id: 25, author: \"@viral_clips\", likes: 50000, shares: 15000, views: 250000, hoursAgo: 1, category: \"humor\" }\n];\n\n// Render Cards\nconst renderFeed = (posts) => {\n  const htmlCards = posts.map(post => `\n    <div class=\"post-card\">\n       <div class=\"video-placeholder\">${post.category}</div>\n       <div class=\"overlay\">\n         <h3>${post.author}</h3>\n         <p>❤️ ${post.likes} | ↗️ ${post.shares} | 🕒 ${post.hoursAgo}h ago</p>\n       </div>\n    </div>\n  `);\n  document.getElementById(\"feed-container\").innerHTML = htmlCards.join(\"\");\n};\n\n// Initial Render\nrenderFeed(allPosts); \n\n// 1. FILTER\n\n\n// 2. SORT\n\n\n// 3. PIPELINE\n\n",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "/* style.css */\n:root {\n  --bg-color: #000000;\n  --text-color: #ffffff;\n  --accent-color: #fe2c55; /* VibeCheck Red */\n  --card-bg: #1a1a1a;\n  --nav-height: 60px;\n}\n\nbody {\n  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n  background-color: #333;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  height: 100vh;\n  margin: 0;\n}\n\n/* Phone Simulator */\n.phone-container {\n  width: 320px;\n  height: 600px;\n  background-color: var(--bg-color);\n  color: var(--text-color);\n  border-radius: 20px;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  position: relative;\n  box-shadow: 0 10px 25px rgba(0,0,0,0.5);\n}\n\n/* Header Tabs */\n.app-header {\n  display: flex;\n  justify-content: center;\n  gap: 20px;\n  padding: 15px 0;\n  font-weight: bold;\n  font-size: 1.1rem;\n  border-bottom: 1px solid #333;\n  background-color: rgba(0,0,0,0.8);\n  z-index: 10;\n}\n\n.tab {\n  opacity: 0.5;\n  cursor: pointer;\n}\n\n.tab.active {\n  opacity: 1;\n  text-decoration: underline;\n  text-decoration-color: var(--accent-color);\n  text-underline-offset: 5px;\n}\n\n/* Feed List */\n#feed-container {\n  flex: 1;\n  overflow-y: auto;\n  padding-bottom: var(--nav-height);\n  scroll-behavior: smooth;\n}\n\n#feed-container::-webkit-scrollbar {\n  display: none;\n}\n\n/* Post Card Styling */\n.post-card {\n  position: relative;\n  margin-bottom: 2px;\n  background-color: var(--card-bg);\n  height: 200px;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n}\n\n.video-placeholder {\n  background-color: #2a2a2a;\n  height: 100%;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  font-size: 2rem;\n  color: #555;\n  text-transform: uppercase;\n  letter-spacing: 2px;\n}\n\n.overlay {\n  position: absolute;\n  bottom: 10px;\n  left: 10px;\n  text-shadow: 1px 1px 3px rgba(0,0,0,0.8);\n  pointer-events: none;\n}\n\n.overlay h3 {\n  margin: 0;\n  font-size: 1rem;\n}\n\n.overlay p {\n  margin: 5px 0 0;\n  font-size: 0.8rem;\n  opacity: 0.9;\n}\n\n/* Bottom Navigation */\n.bottom-nav {\n  height: var(--nav-height);\n  background-color: #000;\n  display: flex;\n  justify-content: space-around;\n  align-items: center;\n  border-top: 1px solid #333;\n  position: absolute;\n  bottom: 0;\n  width: 100%;\n  z-index: 20;\n}\n\n.plus-btn {\n  background: linear-gradient(90deg, #00f2ea, #fe2c55);\n  padding: 0 12px;\n  border-radius: 4px;\n  color: white;\n  font-weight: bold;\n  font-size: 1.2rem;\n}",
          "folderId": "0",
          "active": false
        },
