        "b7393ade-473b-4e3e-adb0-7e8e5fe25d95": {
          "id": "b7393ade-473b-4e3e-adb0-7e8e5fe25d95",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Broken Feature Page</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <h1>Welcome to Our Site</h1>\n    <p>This page should have a working button below that changes the text.</p>\n    <div class=\"feature-box\">\n        <p id=\"message\">Initial message here!</p>\n        <button id=\"actionButton\">CLick Me to chAnge Text</button>\n    </div>\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "55f104f1-3cd3-4e64-9361-b82d01e7305d": {
          "id": "55f104f1-3cd3-4e64-9361-b82d01e7305d",
          "name": "style.css",
          "contents": "body {\n    font-family: Arial, sans-serif;\n    margin: 20px;\n    background-color: #f8f8f8;\n    color: #333;\n}\n\nh1 {\n    color: #007bff;\n}\n\n.feature-box {\n    border: 1px solid #ccc;\n    padding: 20px;\n    margin-top: 20px;\n    background-color: #fff;\n    border-radius: 8px;\n}\n\n#message {\n    font-size: 1.2em;\n    margin-bottom: 15px;\n    color: #555;\n}\n\n#actionButton {\n    background-color: #f44336; /* Red background, but text is invisible */\n    color: #f44336; /* Text color matches background */\n    padding: 10px 15px;\n    border: none;\n    border-radius: 5px;\n    cursor: pointer;\n    font-size: 0.1em; /* Very small text */\n    opacity: 0.5;\n    text-transform: lowercase; /* Inconsistent capitalization */\n}",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "18b24fd1-a31c-4a47-bd13-818e859bfd90": {
          "id": "18b24fd1-a31c-4a47-bd13-818e859bfd90",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const button = document.getElementById('actionButton');\n    const message = document.getElementById('message');\n\n    button.addEventListener('click', () => {\n        // This part is intentionally left broken for the student to report\n        message.textContent = 'Oh dear, this text should have changed properly!';\n        // The script itself works, but the visual aspects of the button are broken\n    });\n});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
