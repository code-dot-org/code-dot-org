          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n</head>\n<body>\n  <!-- All the visible content of your web page will go here! -->\n</body>\n</html>",
