    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Online resources — Hardware Troubleshooting</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n<script src=\"script.js\" defer></script>\n</head>\n<body>\n<div class=\"app\">\n\n  <main class=\"app-main\">\n\n    <p class=\"app-error\" id=\"app-error\" role=\"alert\" hidden></p>\n\n    <div class=\"research-top\">\n      <div class=\"client-bar\">\n        <div class=\"client-bar-text\">\n          <h1 class=\"client-bar-name\" id=\"client-name\"></h1>\n          <p class=\"client-bar-meta\" id=\"client-meta\"></p>\n        </div>\n      </div>\n\n      <div class=\"tablist\" role=\"tablist\" aria-label=\"Research sources\" id=\"tablist\">\n        <button type=\"button\" class=\"tab\" role=\"tab\" id=\"tab-board\" aria-controls=\"panel-board\" aria-selected=\"true\" data-tab=\"board\">Message board</button>\n        <button type=\"button\" class=\"tab\" role=\"tab\" id=\"tab-chat\" aria-controls=\"panel-chat\" aria-selected=\"false\" tabindex=\"-1\" data-tab=\"chat\">Chat</button>\n        <button type=\"button\" class=\"tab\" role=\"tab\" id=\"tab-manual\" aria-controls=\"panel-manual\" aria-selected=\"false\" tabindex=\"-1\" data-tab=\"manual\">Manual</button>\n      </div>\n    </div>\n\n    <div class=\"panel panel-board\" role=\"tabpanel\" id=\"panel-board\" aria-labelledby=\"tab-board\" tabindex=\"0\">\n      <div class=\"site-chrome board-chrome\">\n        <svg class=\"brand-mark\" viewBox=\"0 0 20 20\" aria-hidden=\"true\" focusable=\"false\">\n          <rect x=\"1\" y=\"1\" width=\"18\" height=\"18\" rx=\"5\" fill=\"currentColor\"></rect>\n          <path d=\"M5.5 7.5h9M5.5 10.5h9M5.5 13.5h5.5\" stroke=\"#FFFFFF\" stroke-width=\"1.6\" stroke-linecap=\"round\" fill=\"none\"></path>\n        </svg>\n        <p class=\"brand-name\">Threadline</p>\n        <h2 class=\"board-community\" id=\"board-community\"></h2>\n      </div>\n\n      <div id=\"board-list-view\">\n        <ul class=\"thread-list\" id=\"thread-list\"></ul>\n      </div>\n\n      <div id=\"board-thread-view\" hidden>\n        <button type=\"button\" class=\"back-button\" id=\"thread-back\">Back to all threads</button>\n        <article class=\"thread\" id=\"thread-detail\"></article>\n      </div>\n    </div>\n\n    <div class=\"panel panel-chat\" role=\"tabpanel\" id=\"panel-chat\" aria-labelledby=\"tab-chat\" tabindex=\"0\" hidden>\n      <div class=\"site-chrome chat-chrome\">\n        <svg class=\"brand-mark\" viewBox=\"0 0 20 20\" aria-hidden=\"true\" focusable=\"false\">\n          <circle cx=\"7.5\" cy=\"7.5\" r=\"5.5\" fill=\"currentColor\"></circle>\n          <circle cx=\"13\" cy=\"12.5\" r=\"5.5\" fill=\"currentColor\" opacity=\"0.55\"></circle>\n        </svg>\n        <p class=\"brand-name\">Huddle</p>\n        <h2 class=\"chat-server\" id=\"chat-server\"></h2>\n      </div>\n\n      <div class=\"chat-body\">\n        <div class=\"channel-strip\" role=\"group\" aria-label=\"Channels\" id=\"channel-strip\"></div>\n        <div class=\"chat-main\">\n          <h3 class=\"channel-name\" id=\"channel-name\"></h3>\n          <p class=\"visually-hidden\" aria-live=\"polite\" id=\"channel-status\"></p>\n          <ul class=\"message-list\" id=\"message-list\"></ul>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"panel panel-manual\" role=\"tabpanel\" id=\"panel-manual\" aria-labelledby=\"tab-manual\" tabindex=\"0\" hidden>\n      <div class=\"manual-head\">\n        <p class=\"manual-manufacturer\" id=\"manual-manufacturer\"></p>\n        <h2 class=\"manual-model\" id=\"manual-model\"></h2>\n        <h3 class=\"manual-chapter\" id=\"manual-chapter\"></h3>\n      </div>\n      <div class=\"manual-sections\" id=\"manual-sections\"></div>\n      <div class=\"manual-table\" id=\"manual-table\"></div>\n      <div class=\"manual-callout\" id=\"manual-callout\"></div>\n      <footer class=\"manual-footer\">\n        <p id=\"manual-page\"></p>\n      </footer>\n    </div>\n\n  </main>\n</div>\n</body>\n</html>",
          "active": true,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "/* CodeAI palette. Brand fonts (Space Grotesk / Geist) are not loaded: Web Lab\n   forbids external requests. Upload the TTFs to the project and add @font-face\n   with relative paths to restore them. */\n:root {\n  --purple-light: #E4E2F8;\n  --purple-mid: #ACA8EA;\n  --purple: #4C42CF;\n  --purple-dark: #1F1976;\n  --blue-light: #D5EFFF;\n  --blue-mid: #6FCAFF;\n  --blue-dark: #06338D;\n  --green-light: #CCF1D0;\n  --green-mid: #7CDB87;\n  --green-dark: #003F25;\n  --orange-light: #FFE3CE;\n  --orange-mid: #FFA868;\n  --orange-dark: #611D00;\n  --white: #FFFFFF;\n  --black: #000000;\n\n  --focus: var(--purple-dark);\n\n  --font-ui: system-ui, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n  --font-doc: Georgia, \"Times New Roman\", serif;\n\n  --radius: 10px;\n}\n\n* {\n  box-sizing: border-box;\n}\n\n/* The pinned bar would otherwise obscure an element the browser scrolls to,\n   including a newly focused one. Roughly the pinned height at each size. */\nhtml {\n  scroll-padding-block-start: 9rem;\n}\n\n/* Narrow viewports wrap the tabs onto a second row, so the pinned bar is\n   taller. Each value errs high: over-padding only lands the target a little\n   lower in the viewport, while under-padding leaves it under the bar. */\n@media (max-width: 30rem) {\n  html {\n    scroll-padding-block-start: 12rem;\n  }\n}\n\n@media (max-height: 30rem) {\n  html {\n    scroll-padding-block-start: 8rem;\n  }\n}\n\n@media (max-width: 30rem) and (max-height: 30rem) {\n  html {\n    scroll-padding-block-start: 9.5rem;\n  }\n}\n\n[hidden] {\n  display: none;\n}\n\nbody {\n  margin: 0;\n  padding: 0;\n  background-color: var(--white);\n  color: var(--black);\n  font-family: var(--font-ui);\n  font-size: 1rem;\n  line-height: 1.5;\n}\n\n.app {\n  max-width: 60rem;\n  margin-inline: auto;\n  padding-inline: 0.75rem;\n  padding-block: 0.75rem 3rem;\n}\n\n:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 2px;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n\n/* ---------- app header ---------- */\n\n.app-error {\n  margin: 0 0 1rem;\n  padding: 0.75rem 1rem;\n  border-inline-start: 5px solid var(--orange-dark);\n  background-color: var(--orange-light);\n  color: var(--orange-dark);\n  border-radius: var(--radius);\n}\n\n/* ---------- client picker ---------- */\n\n/* ---------- research screen: client bar and tabs ---------- */\n\n.research-top {\n  position: sticky;\n  inset-block-start: 0;\n  z-index: 10;\n  background-color: var(--white);\n  padding-block-end: 0.5rem;\n}\n\n/* Short viewports - a landscape phone, or a laptop at 200% zoom - get a\n   compacted bar rather than losing the pin. That is exactly the case where\n   scrolling back up to reach the tabs costs the most. */\n@media (max-height: 30rem) {\n  .research-top {\n    padding-block-end: 0.375rem;\n  }\n\n  .client-bar {\n    padding: 0.375rem 0.75rem;\n  }\n\n  .client-bar-text {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: baseline;\n    gap: 0 0.5rem;\n  }\n\n  .client-bar-name {\n    font-size: 1rem;\n  }\n\n  .client-bar-meta {\n    font-size: 0.8125rem;\n  }\n\n  .tablist {\n    margin-block-start: 0.375rem;\n  }\n\n  .tab {\n    min-height: 40px;\n  }\n}\n\n.client-bar {\n  padding: 0.625rem 0.875rem;\n  border-radius: var(--radius);\n  background-color: var(--purple);\n  color: var(--white);\n}\n\n.client-bar-name {\n  margin: 0;\n  font-size: 1.125rem;\n  line-height: 1.25;\n  letter-spacing: -0.01em;\n}\n\n.client-bar-meta {\n  margin: 0;\n  font-size: 0.9375rem;\n}\n\n.tablist {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.375rem;\n  margin-block-start: 0.5rem;\n}\n\n.tab {\n  flex: 1 1 auto;\n  min-width: 6.5rem;\n  min-height: 44px;\n  font-family: inherit;\n  font-size: 0.9375rem;\n  font-weight: 600;\n  padding: 0.5rem 0.75rem;\n  border: 2px solid var(--purple);\n  border-radius: var(--radius);\n  background-color: var(--white);\n  color: var(--purple-dark);\n  cursor: pointer;\n  transition: background-color 120ms linear;\n}\n\n.tab:hover {\n  background-color: var(--purple-light);\n}\n\n.tab[aria-selected=\"true\"] {\n  background-color: var(--purple-dark);\n  border-color: var(--purple-dark);\n  color: var(--white);\n}\n\n.tab[aria-selected=\"true\"]:hover {\n  background-color: var(--purple-dark);\n}\n\n.panel {\n  margin-block-start: 0.75rem;\n  border-radius: var(--radius);\n  overflow: hidden;\n}\n\n/* ---------- shared platform chrome ---------- */\n\n.site-chrome {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.5rem 0.625rem;\n  padding: 0.75rem 0.875rem;\n}\n\n.brand-mark {\n  width: 22px;\n  height: 22px;\n  flex: none;\n}\n\n.brand-name {\n  margin: 0;\n  font-weight: 700;\n  letter-spacing: -0.01em;\n}\n\n/* ---------- message board (Threadline) ---------- */\n\n.panel-board {\n  background-color: var(--purple-light);\n  border: 2px solid var(--purple-mid);\n}\n\n.board-chrome {\n  background-color: var(--white);\n  border-block-end: 2px solid var(--purple-mid);\n  color: var(--purple);\n}\n\n.board-community {\n  margin: 0;\n  font-size: 0.9375rem;\n  font-weight: 600;\n  color: var(--purple-dark);\n  flex-basis: 100%;\n}\n\n@media (min-width: 30rem) {\n  .board-community {\n    flex-basis: auto;\n    margin-inline-start: auto;\n  }\n}\n\n.thread-list {\n  list-style: none;\n  margin: 0;\n  padding: 0.75rem;\n  display: grid;\n  gap: 0.625rem;\n}\n\n.thread-row {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.75rem;\n  width: 100%;\n  text-align: start;\n  font-family: inherit;\n  font-size: 1rem;\n  padding: 0.75rem;\n  border: 1px solid var(--purple);\n  border-radius: var(--radius);\n  background-color: var(--white);\n  color: var(--black);\n  cursor: pointer;\n  transition: background-color 120ms linear;\n}\n\n.thread-row:hover {\n  background-color: var(--purple-light);\n}\n\n.vote-pill {\n  flex: none;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  min-width: 3.5rem;\n  padding: 0.25rem;\n  border-radius: 8px;\n  background-color: var(--purple-light);\n  color: var(--purple-dark);\n  font-size: 0.8125rem;\n  font-weight: 700;\n  line-height: 1.2;\n  text-align: center;\n}\n\n.vote-icon {\n  width: 12px;\n  height: 12px;\n  flex: none;\n  fill: var(--purple);\n}\n\n.vote-pill .vote-icon {\n  margin-block-end: 0.125rem;\n}\n\n.thread-row-body {\n  min-width: 0;\n}\n\n.thread-row-title {\n  display: block;\n  font-weight: 700;\n  color: var(--purple-dark);\n  line-height: 1.3;\n}\n\n.thread-row-meta {\n  display: block;\n  font-size: 0.875rem;\n  color: var(--black);\n  margin-block-start: 0.25rem;\n}\n\n.thread-tag {\n  display: inline-block;\n  margin-block-start: 0.375rem;\n  padding: 0.125rem 0.5rem;\n  border-radius: 999px;\n  background-color: var(--green-light);\n  color: var(--green-dark);\n  font-size: 0.75rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n\n#board-thread-view {\n  padding: 0.75rem;\n}\n\n.back-button {\n  font-family: inherit;\n  font-size: 0.9375rem;\n  font-weight: 600;\n  min-height: 44px;\n  padding: 0.5rem 0.875rem;\n  border: 2px solid var(--purple);\n  border-radius: var(--radius);\n  background-color: var(--white);\n  color: var(--purple-dark);\n  cursor: pointer;\n  transition: background-color 120ms linear;\n}\n\n.back-button:hover {\n  background-color: var(--white);\n  border-color: var(--purple-dark);\n}\n\n.thread {\n  margin-block-start: 0.75rem;\n  padding: 0.875rem;\n  border: 1px solid var(--purple-mid);\n  border-radius: var(--radius);\n  background-color: var(--white);\n}\n\n.thread-title {\n  margin: 0;\n  font-size: 1.125rem;\n  line-height: 1.3;\n  color: var(--purple-dark);\n}\n\n.thread-byline {\n  margin: 0.375rem 0 0;\n  font-size: 0.875rem;\n}\n\n.thread-stats {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.25rem 0.75rem;\n  margin: 0.25rem 0 0;\n  font-size: 0.875rem;\n  font-weight: 600;\n  color: var(--purple-dark);\n}\n\n.thread-stats .thread-tag {\n  margin-block-start: 0;\n}\n\n.thread-body {\n  margin: 0.75rem 0 0;\n}\n\n.comments-heading {\n  margin: 1.25rem 0 0.5rem;\n  font-size: 1rem;\n  color: var(--purple-dark);\n}\n\n.comment-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  gap: 0.625rem;\n}\n\n.comment {\n  padding: 0.625rem 0.75rem;\n  border-inline-start: 3px solid var(--purple-mid);\n  background-color: var(--purple-light);\n  border-radius: 0 var(--radius) var(--radius) 0;\n}\n\n.comment-byline {\n  margin: 0;\n  font-size: 0.875rem;\n  font-weight: 600;\n  color: var(--purple-dark);\n}\n\n.comment-votes {\n  display: flex;\n  align-items: center;\n  gap: 0.25rem;\n  margin: 0.125rem 0 0;\n  font-size: 0.8125rem;\n}\n\n.comment-body {\n  margin: 0.375rem 0 0;\n}\n\n.reply-list {\n  list-style: none;\n  margin: 0.625rem 0 0;\n  padding: 0;\n  margin-inline-start: 1rem;\n  display: grid;\n  gap: 0.625rem;\n}\n\n.reply {\n  padding: 0.625rem 0.75rem;\n  border-inline-start: 3px solid var(--purple);\n  background-color: var(--white);\n  border-radius: 0 var(--radius) var(--radius) 0;\n}\n\n/* ---------- chat (Huddle) ---------- */\n\n.panel-chat {\n  background-color: var(--purple-dark);\n  border: 2px solid var(--purple-dark);\n  color: var(--purple-light);\n}\n\n.panel-chat :focus-visible {\n  outline-color: var(--white);\n}\n\n.chat-chrome {\n  background-color: var(--purple);\n  color: var(--white);\n}\n\n.chat-server {\n  margin: 0;\n  font-size: 0.9375rem;\n  font-weight: 600;\n  flex-basis: 100%;\n}\n\n@media (min-width: 30rem) {\n  .chat-server {\n    flex-basis: auto;\n    margin-inline-start: auto;\n  }\n}\n\n.chat-body {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 0;\n}\n\n.channel-strip {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.375rem;\n  padding: 0.75rem;\n  border-block-end: 1px solid var(--purple);\n}\n\n.channel-button {\n  font-family: inherit;\n  font-size: 0.9375rem;\n  font-weight: 600;\n  min-height: 44px;\n  padding: 0.375rem 0.75rem;\n  border: 2px solid var(--purple-mid);\n  border-radius: var(--radius);\n  background-color: var(--purple-dark);\n  color: var(--purple-light);\n  cursor: pointer;\n  transition: background-color 120ms linear;\n}\n\n.channel-button:hover {\n  background-color: var(--purple);\n}\n\n.channel-button[aria-pressed=\"true\"] {\n  background-color: var(--purple-light);\n  border-color: var(--purple-light);\n  color: var(--purple-dark);\n}\n\n.chat-main {\n  padding: 0.75rem 0.875rem 1rem;\n  min-width: 0;\n}\n\n.channel-name {\n  margin: 0 0 0.75rem;\n  font-size: 1rem;\n  color: var(--white);\n}\n\n.message-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.message {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.625rem;\n  margin-block-start: 0.875rem;\n}\n\n.message-grouped {\n  margin-block-start: 0.25rem;\n}\n\n.avatar {\n  flex: none;\n  width: 34px;\n  height: 34px;\n  border-radius: 999px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 0.75rem;\n  font-weight: 700;\n  color: var(--purple-dark);\n}\n\n.avatar-color-1 {\n  background-color: var(--purple-mid);\n}\n\n.avatar-color-2 {\n  background-color: var(--blue-mid);\n}\n\n.avatar-color-3 {\n  background-color: var(--green-mid);\n}\n\n.avatar-color-4 {\n  background-color: var(--orange-mid);\n}\n\n.author-color-1 {\n  color: var(--purple-mid);\n}\n\n.author-color-2 {\n  color: var(--blue-mid);\n}\n\n.author-color-3 {\n  color: var(--green-mid);\n}\n\n.author-color-4 {\n  color: var(--orange-mid);\n}\n\n.message-content {\n  min-width: 0;\n}\n\n.message-byline {\n  margin: 0;\n  font-size: 0.9375rem;\n}\n\n.message-author {\n  font-weight: 700;\n}\n\n.message-time {\n  color: var(--purple-mid);\n  font-size: 0.8125rem;\n  margin-inline-start: 0.375rem;\n}\n\n.message-body {\n  margin: 0.125rem 0 0;\n}\n\n.day-divider {\n  margin-block-start: 1rem;\n  padding-block: 0.375rem;\n  border-block-start: 1px solid var(--purple);\n  color: var(--purple-mid);\n  font-size: 0.8125rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n}\n\n@media (min-width: 40rem) {\n  .chat-body {\n    grid-template-columns: 12rem 1fr;\n  }\n\n  .channel-strip {\n    flex-direction: column;\n    flex-wrap: nowrap;\n    align-items: stretch;\n    border-block-end: 0;\n    border-inline-end: 1px solid var(--purple);\n  }\n}\n\n/* ---------- manual ---------- */\n\n.panel-manual {\n  background-color: var(--white);\n  border: 2px solid var(--purple-dark);\n  font-family: var(--font-doc);\n  padding: 1rem 1.125rem 1.25rem;\n}\n\n.manual-head {\n  border-block-end: 2px solid var(--purple-dark);\n  padding-block-end: 0.625rem;\n}\n\n.manual-manufacturer {\n  margin: 0;\n  font-family: var(--font-ui);\n  font-size: 0.8125rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  color: var(--purple-dark);\n}\n\n.manual-model {\n  margin: 0.25rem 0 0;\n  font-size: 1.375rem;\n  line-height: 1.2;\n  color: var(--black);\n}\n\n.manual-chapter {\n  margin: 0.375rem 0 0;\n  font-size: 1rem;\n  font-style: italic;\n  font-weight: 400;\n  color: var(--black);\n}\n\n.manual-section {\n  margin-block-start: 1.125rem;\n}\n\n.manual-section-heading {\n  margin: 0 0 0.375rem;\n  font-size: 1.0625rem;\n  color: var(--black);\n}\n\n.section-number {\n  color: var(--purple-dark);\n  margin-inline-end: 0.375rem;\n}\n\n.manual-paragraph {\n  margin: 0 0 0.5rem;\n  max-width: 42rem;\n}\n\n.manual-table {\n  margin-block-start: 1.5rem;\n}\n\n.manual-table table {\n  border-collapse: collapse;\n  width: 100%;\n}\n\n.manual-table caption {\n  text-align: start;\n  font-family: var(--font-ui);\n  font-size: 0.8125rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  color: var(--purple-dark);\n  padding-block-end: 0.375rem;\n}\n\n.manual-table th,\n.manual-table td {\n  border: 1px solid var(--purple-dark);\n  padding: 0.4375rem 0.625rem;\n  text-align: start;\n  vertical-align: top;\n}\n\n.manual-table thead th {\n  background-color: var(--purple-light);\n  color: var(--black);\n}\n\n.manual-table tbody th {\n  font-weight: 400;\n}\n\n.callout {\n  margin-block-start: 1.5rem;\n  padding: 0.75rem 0.875rem;\n  border-radius: var(--radius);\n  border-inline-start: 5px solid;\n}\n\n.callout-note {\n  background-color: var(--blue-light);\n  border-inline-start-color: var(--blue-dark);\n  color: var(--blue-dark);\n}\n\n.callout-warning {\n  background-color: var(--orange-light);\n  border-inline-start-color: var(--orange-dark);\n  color: var(--orange-dark);\n}\n\n.callout-kind {\n  margin: 0;\n  font-family: var(--font-ui);\n  font-size: 0.75rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n}\n\n.callout-title {\n  margin: 0.125rem 0 0;\n  font-size: 1rem;\n  font-weight: 700;\n}\n\n.callout-body {\n  margin: 0.375rem 0 0;\n}\n\n.manual-footer {\n  margin-block-start: 1.75rem;\n  border-block-start: 1px solid var(--purple-dark);\n  padding-block-start: 0.5rem;\n  font-family: var(--font-ui);\n  font-size: 0.8125rem;\n  color: var(--purple-dark);\n}\n\n.manual-footer p {\n  margin: 0;\n  text-align: end;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .tab,\n  .thread-row,\n  .back-button,\n  .channel-button {\n    transition: none;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const CLIENT = {\n  name: \"Dr. Amara Wanjiru\",\n  role: \"Veterinarian\",\n  device: \"FieldPad rugged tablet\",\n\n  board: {\n    community: \"c/VetFieldTech\",\n    threads: [\n      {\n        id: \"t1\",\n        title: \"Tablet gets worse as the day goes on — anyone else?\",\n        author: \"kimani_ambulatory\",\n        timestamp: \"3 days ago\",\n        votes: 52,\n        tag: \"Solved\",\n        body: \"Twelve years of ambulatory work and this one is new to me. The tablet is fine first thing. By my last call it is unusable. Same story every day this month, and I have not dropped it or got it wet.\",\n        comments: [\n          {\n            author: \"highplains_dvm\",\n            timestamp: \"3 days ago\",\n            votes: 31,\n            body: \"Check whether it is dropping into a power-saving mode. Mine was doing it for months and I never noticed, because the only thing that tells you is a tiny icon.\",\n            replies: [\n              {\n                author: \"quietwater_vet\",\n                timestamp: \"2 days ago\",\n                votes: 14,\n                body: \"Worth adding that mine turned out to be a charging problem rather than a battery problem. Completely different fix.\"\n              }\n            ]\n          },\n          {\n            author: \"NewGradNadia\",\n            timestamp: \"3 days ago\",\n            votes: 9,\n            body: \"Could it just be memory? Mine gets slow when I have a lot of files open at once.\",\n            replies: [\n              {\n                author: \"highplains_dvm\",\n                timestamp: \"3 days ago\",\n                votes: 17,\n                body: \"Then it would slow down whenever you had a lot open, not at the same time every single day.\"\n              }\n            ]\n          },\n          {\n            /* [noise] */\n            author: \"GoatsAndGates\",\n            timestamp: \"2 days ago\",\n            votes: 3,\n            body: \"Off topic, but what rugged case do you all use? Mine has been stepped on twice this week.\"\n          }\n        ]\n      },\n      {\n        id: \"t2\",\n        title: \"Records arriving a day late\",\n        author: \"RuralRoundsRosa\",\n        timestamp: \"1 week ago\",\n        votes: 23,\n        body: \"The entries I write up after lunch turn up at the practice the next day. Not all of them, and not always the same ones. The office says nothing has changed at their end.\",\n        comments: [\n          {\n            author: \"twoRoadsVet\",\n            timestamp: \"1 week ago\",\n            votes: 14,\n            body: \"Coverage maps make rural areas look a lot better than they really are. If the tablet cannot reach a network, it just waits until it can.\"\n          },\n          {\n            /* [software -> L5] */\n            author: \"ClinicAdminBea\",\n            timestamp: \"6 days ago\",\n            votes: 6,\n            body: \"Check whether your records app uploads while it is closed. Ours does not, and nobody told us.\"\n          }\n        ]\n      }\n    ]\n  },\n\n  chat: {\n    server: \"FieldPad Users\",\n    channels: [\n      {\n        name: \"#troubleshooting\",\n        messages: [\n          { author: \"RuthK\", initials: \"RK\", timestamp: \"Tuesday 9:14\", dayLabel: \"Tuesday\", body: \"My tablet is fine at eight in the morning and useless by four in the afternoon. Where do I even start?\" },\n          { author: \"DevN\", initials: \"DN\", timestamp: \"Tuesday 9:31\", body: \"If it is slow at a certain time of day, rather than slow whenever you have a lot open, stop looking at memory.\" },\n          { author: \"RuthK\", initials: \"RK\", timestamp: \"Tuesday 9:33\", body: \"What else would it be?\" },\n          { author: \"DevN\", initials: \"DN\", timestamp: \"Tuesday 9:35\", body: \"A power-saving mode, nine times out of ten. And it will not tell you that it switched on.\" }\n        ]\n      },\n      {\n        name: \"#field-tips\",\n        messages: [\n          /* [noise] */\n          { author: \"SamO\", initials: \"SO\", timestamp: \"Monday 16:02\", dayLabel: \"Monday\", body: \"Screen protectors for working outdoors: matte or glossy?\" },\n          { author: \"PriyaM\", initials: \"PM\", timestamp: \"Monday 16:20\", body: \"Matte, no question. A glossy one is basically a mirror once the sun is on it.\" },\n          { author: \"DevN\", initials: \"DN\", timestamp: \"Monday 17:41\", body: \"Reminder that most sockets built into a car or a truck put out nowhere near enough power for these tablets. People assume that plugged in means charging.\" }\n        ]\n      }\n    ]\n  },\n\n  manual: {\n    manufacturer: \"FieldPad Industries\",\n    model: \"FieldPad 7 Rugged Tablet\",\n    chapter: \"Chapter 4 — Power Management\",\n    page: 31,\n    sections: [\n      {\n        number: \"4.1\",\n        title: \"Charging\",\n        paragraphs: [\n          \"This tablet needs a 30 W charger. A socket that supplies less than 10 W cannot keep up with normal use, even when the tablet stays plugged in all day. Most sockets built into cars and trucks supply less than 10 W.\",\n          \"Use the charger supplied with the tablet.\"\n        ]\n      },\n      {\n        number: \"4.2\",\n        title: \"Battery health\",\n        paragraphs: [\n          \"When the battery can no longer hold 80% of the charge it held when new, a battery health warning appears in Settings. The warning stays there until the battery is replaced.\"\n        ]\n      },\n      {\n        number: \"4.3\",\n        title: \"Battery Saver\",\n        paragraphs: [\n          \"Battery Saver turns itself on whenever the charge drops below 30%.\",\n          \"While it is on, the tablet slows its processor, limits how bright the display can get, and pauses the uploads that normally happen in the background. Uploads stay paused until the tablet is charged.\"\n        ]\n      },\n      {\n        number: \"4.4\",\n        title: \"Overheating protection\",\n        paragraphs: [\n          \"If the inside of the tablet gets hotter than its operating limit, a temperature warning appears on the screen and the tablet runs more slowly until it cools down.\"\n        ]\n      }\n    ],\n    table: {\n      caption: \"Battery Saver — what changes\",\n      columns: [\"Setting\", \"Normal\", \"Battery Saver\"],\n      rows: [\n        [\"Processor speed\", \"100%\", \"60%\"],\n        [\"Maximum display brightness\", \"100%\", \"40%\"],\n        [\"Background upload\", \"Runs continuously\", \"Paused\"],\n        [\"On-screen notice\", \"None\", \"Small status icon only\"]\n      ]\n    },\n    callout: {\n      kind: \"warning\",\n      title: \"Battery Saver does not announce itself\",\n      body: \"Apart from a small status icon, nothing on the screen tells you that Battery Saver is on. Users often report its effects without realising what is causing them.\"\n    }\n  }\n};\n\n/* ---------- constants ---------- */\n\nconst SVG_NS = \"http://www.w3.org/2000/svg\";\n\n/* Authors are assigned one of four colour classes defined in style.css. Each\n   colour is verified at 4.5:1 or better against the dark chat panel, which\n   rules out the saturated colours real chat apps use. The author name is\n   always visible, so colour is never the only way to tell authors apart. */\nconst AUTHOR_COLOR_COUNT = 4;\n\nconst CALLOUT_KIND_LABELS = {\n  note: \"Note\",\n  warning: \"Warning\"\n};\n\nconst numberFormat = new Intl.NumberFormat();\nconst pluralRules = new Intl.PluralRules();\n\n/* ---------- state ---------- */\n\nconst state = {\n  activeTab: \"board\",\n  openThreadId: null\n};\n\nlet authorColorNumbers = new Map();\n\n/* ---------- element references ---------- */\n\nconst appError = document.getElementById(\"app-error\");\nconst clientName = document.getElementById(\"client-name\");\nconst clientMeta = document.getElementById(\"client-meta\");\n\nconst tablist = document.getElementById(\"tablist\");\nconst tabs = [...tablist.querySelectorAll(\".tab\")];\nconst panels = {\n  board: document.getElementById(\"panel-board\"),\n  chat: document.getElementById(\"panel-chat\"),\n  manual: document.getElementById(\"panel-manual\")\n};\n\nconst boardCommunity = document.getElementById(\"board-community\");\nconst boardListView = document.getElementById(\"board-list-view\");\nconst boardThreadView = document.getElementById(\"board-thread-view\");\nconst threadList = document.getElementById(\"thread-list\");\nconst threadDetail = document.getElementById(\"thread-detail\");\nconst threadBackButton = document.getElementById(\"thread-back\");\n\nconst chatServer = document.getElementById(\"chat-server\");\nconst channelStrip = document.getElementById(\"channel-strip\");\nconst channelName = document.getElementById(\"channel-name\");\nconst channelStatus = document.getElementById(\"channel-status\");\nconst messageList = document.getElementById(\"message-list\");\n\nconst manualManufacturer = document.getElementById(\"manual-manufacturer\");\nconst manualModel = document.getElementById(\"manual-model\");\nconst manualChapter = document.getElementById(\"manual-chapter\");\nconst manualSections = document.getElementById(\"manual-sections\");\nconst manualTable = document.getElementById(\"manual-table\");\nconst manualCallout = document.getElementById(\"manual-callout\");\nconst manualPage = document.getElementById(\"manual-page\");\n\n/* ---------- small helpers ---------- */\n\nfunction createElement(tag, className, text) {\n  const element = document.createElement(tag);\n  if (className) {\n    element.className = className;\n  }\n  if (text !== undefined) {\n    element.textContent = text;\n  }\n  return element;\n}\n\nfunction clear(element) {\n  while (element.firstChild) {\n    element.removeChild(element.firstChild);\n  }\n}\n\nfunction createUpvoteIcon() {\n  const svg = document.createElementNS(SVG_NS, \"svg\");\n  svg.setAttribute(\"viewBox\", \"0 0 12 12\");\n  svg.setAttribute(\"class\", \"vote-icon\");\n  svg.setAttribute(\"aria-hidden\", \"true\");\n  svg.setAttribute(\"focusable\", \"false\");\n  const path = document.createElementNS(SVG_NS, \"path\");\n  path.setAttribute(\"d\", \"M6 1.5 11 8.5H1z\");\n  svg.appendChild(path);\n  return svg;\n}\n\nfunction voteCountLabel(count) {\n  const value = numberFormat.format(count);\n  if (pluralRules.select(count) === \"one\") {\n    return `${value} vote`;\n  }\n  return `${value} votes`;\n}\n\nfunction commentCountLabel(count) {\n  const value = numberFormat.format(count);\n  if (pluralRules.select(count) === \"one\") {\n    return `${value} comment`;\n  }\n  return `${value} comments`;\n}\n\nfunction countComments(thread) {\n  return thread.comments.reduce(function (total, comment) {\n    const replies = comment.replies ? comment.replies.length : 0;\n    return total + 1 + replies;\n  }, 0);\n}\n\nfunction showError(message) {\n  appError.textContent = message;\n  appError.hidden = false;\n}\n\nfunction runSafely(action) {\n  try {\n    action();\n  } catch (error) {\n    showError(\"Something went wrong in this activity. Reload the page to start again.\");\n  }\n}\n\n/* ---------- message board ---------- */\n\nfunction renderBoard(board) {\n  boardCommunity.textContent = board.community;\n  renderThreadList(board);\n  showThreadList(false);\n}\n\nfunction renderThreadList(board) {\n  clear(threadList);\n  board.threads.forEach(function (thread) {\n    const item = document.createElement(\"li\");\n    const button = createElement(\"button\", \"thread-row\");\n    button.type = \"button\";\n    button.setAttribute(\"data-thread-id\", thread.id);\n\n    const votePill = createElement(\"span\", \"vote-pill\");\n    votePill.appendChild(createUpvoteIcon());\n    votePill.appendChild(createElement(\"span\", null, voteCountLabel(thread.votes)));\n    button.appendChild(votePill);\n\n    const body = createElement(\"span\", \"thread-row-body\");\n    body.appendChild(createElement(\"span\", \"thread-row-title\", thread.title));\n    body.appendChild(createElement(\"span\", \"thread-row-meta\", `Posted by ${thread.author} ${thread.timestamp}`));\n    body.appendChild(createElement(\"span\", \"thread-row-meta\", commentCountLabel(countComments(thread))));\n    if (thread.tag) {\n      body.appendChild(createElement(\"span\", \"thread-tag\", thread.tag));\n    }\n    button.appendChild(body);\n\n    item.appendChild(button);\n    threadList.appendChild(item);\n  });\n}\n\nfunction createComment(comment, className) {\n  const wrapper = createElement(\"div\", className);\n  wrapper.appendChild(createElement(\"p\", \"comment-byline\", `${comment.author} ${comment.timestamp}`));\n\n  const votes = createElement(\"p\", \"comment-votes\");\n  votes.appendChild(createUpvoteIcon());\n  votes.appendChild(createElement(\"span\", null, voteCountLabel(comment.votes)));\n  wrapper.appendChild(votes);\n\n  wrapper.appendChild(createElement(\"p\", \"comment-body\", comment.body));\n  return wrapper;\n}\n\nfunction openThread(thread) {\n  clear(threadDetail);\n\n  const heading = createElement(\"h3\", \"thread-title\", thread.title);\n  heading.tabIndex = -1;\n  threadDetail.appendChild(heading);\n\n  threadDetail.appendChild(createElement(\"p\", \"thread-byline\", `Posted by ${thread.author} ${thread.timestamp}`));\n\n  const stats = createElement(\"p\", \"thread-stats\");\n  stats.appendChild(createElement(\"span\", null, voteCountLabel(thread.votes)));\n  stats.appendChild(createElement(\"span\", null, commentCountLabel(countComments(thread))));\n  if (thread.tag) {\n    stats.appendChild(createElement(\"span\", \"thread-tag\", thread.tag));\n  }\n  threadDetail.appendChild(stats);\n\n  threadDetail.appendChild(createElement(\"p\", \"thread-body\", thread.body));\n  threadDetail.appendChild(createElement(\"h4\", \"comments-heading\", commentCountLabel(countComments(thread))));\n\n  const list = createElement(\"ul\", \"comment-list\");\n  thread.comments.forEach(function (comment) {\n    const item = document.createElement(\"li\");\n    item.appendChild(createComment(comment, \"comment\"));\n    if (comment.replies && comment.replies.length > 0) {\n      const replyList = createElement(\"ul\", \"reply-list\");\n      comment.replies.forEach(function (reply) {\n        const replyItem = document.createElement(\"li\");\n        replyItem.appendChild(createComment(reply, \"reply\"));\n        replyList.appendChild(replyItem);\n      });\n      item.appendChild(replyList);\n    }\n    list.appendChild(item);\n  });\n  threadDetail.appendChild(list);\n\n  state.openThreadId = thread.id;\n  showThreadList(true);\n  heading.focus();\n}\n\nfunction showThreadList(threadIsOpen) {\n  boardListView.hidden = threadIsOpen;\n  boardThreadView.hidden = !threadIsOpen;\n}\n\nfunction closeThread() {\n  const openId = state.openThreadId;\n  state.openThreadId = null;\n  showThreadList(false);\n  const row = threadList.querySelector(`[data-thread-id=\"${openId}\"]`);\n  if (row) {\n    row.focus();\n  }\n}\n\n/* ---------- chat ---------- */\n\nfunction buildAuthorColorMap(chat) {\n  const colorByAuthor = new Map();\n  chat.channels.forEach(function (channel) {\n    channel.messages.forEach(function (message) {\n      if (!colorByAuthor.has(message.author)) {\n        colorByAuthor.set(message.author, (colorByAuthor.size % AUTHOR_COLOR_COUNT) + 1);\n      }\n    });\n  });\n  return colorByAuthor;\n}\n\nfunction renderChat(chat) {\n  chatServer.textContent = chat.server;\n  authorColorNumbers = buildAuthorColorMap(chat);\n\n  clear(channelStrip);\n  chat.channels.forEach(function (channel, index) {\n    const button = createElement(\"button\", \"channel-button\", channel.name);\n    button.type = \"button\";\n    button.setAttribute(\"data-channel-index\", String(index));\n    button.setAttribute(\"aria-pressed\", index === 0 ? \"true\" : \"false\");\n    channelStrip.appendChild(button);\n  });\n\n  renderChannel(chat, 0, false);\n}\n\nfunction renderChannel(chat, index, announce) {\n  const channel = chat.channels[index];\n  if (!channel) {\n    return;\n  }\n\n  channelName.textContent = channel.name;\n\n  [...channelStrip.querySelectorAll(\".channel-button\")].forEach(function (button) {\n    const buttonIndex = Number(button.getAttribute(\"data-channel-index\"));\n    button.setAttribute(\"aria-pressed\", buttonIndex === index ? \"true\" : \"false\");\n  });\n\n  clear(messageList);\n  let previousAuthor = null;\n  channel.messages.forEach(function (message) {\n    if (message.dayLabel) {\n      const divider = document.createElement(\"li\");\n      divider.className = \"day-divider\";\n      divider.textContent = message.dayLabel;\n      messageList.appendChild(divider);\n      previousAuthor = null;\n    }\n\n    const item = document.createElement(\"li\");\n    item.className = message.author === previousAuthor ? \"message message-grouped\" : \"message\";\n\n    const colorNumber = authorColorNumbers.get(message.author) || 1;\n    const avatar = createElement(\"span\", `avatar avatar-color-${colorNumber}`, message.initials);\n    avatar.setAttribute(\"aria-hidden\", \"true\");\n    item.appendChild(avatar);\n\n    const content = createElement(\"div\", \"message-content\");\n    const byline = createElement(\"p\", \"message-byline\");\n    byline.appendChild(createElement(\"span\", `message-author author-color-${colorNumber}`, message.author));\n    byline.appendChild(createElement(\"span\", \"message-time\", message.timestamp));\n    content.appendChild(byline);\n    content.appendChild(createElement(\"p\", \"message-body\", message.body));\n    item.appendChild(content);\n\n    messageList.appendChild(item);\n    previousAuthor = message.author;\n  });\n\n  if (announce) {\n    channelStatus.textContent = `Now showing the ${channel.name} channel.`;\n  }\n}\n\n/* ---------- manual ---------- */\n\nfunction renderManual(manual) {\n  manualManufacturer.textContent = manual.manufacturer;\n  manualModel.textContent = manual.model;\n  manualChapter.textContent = manual.chapter;\n\n  clear(manualSections);\n  manual.sections.forEach(function (section) {\n    const wrapper = createElement(\"section\", \"manual-section\");\n    const heading = createElement(\"h4\", \"manual-section-heading\");\n    heading.appendChild(createElement(\"span\", \"section-number\", section.number));\n    heading.appendChild(createElement(\"span\", null, section.title));\n    wrapper.appendChild(heading);\n    section.paragraphs.forEach(function (paragraph) {\n      wrapper.appendChild(createElement(\"p\", \"manual-paragraph\", paragraph));\n    });\n    manualSections.appendChild(wrapper);\n  });\n\n  clear(manualTable);\n  manualTable.appendChild(createSpecTable(manual.table));\n\n  clear(manualCallout);\n  manualCallout.appendChild(createCallout(manual.callout));\n\n  manualPage.textContent = `Page ${numberFormat.format(manual.page)}`;\n}\n\nfunction createSpecTable(spec) {\n  const table = document.createElement(\"table\");\n  table.appendChild(createElement(\"caption\", null, spec.caption));\n\n  const thead = document.createElement(\"thead\");\n  const headRow = document.createElement(\"tr\");\n  spec.columns.forEach(function (column) {\n    const th = createElement(\"th\", null, column);\n    th.setAttribute(\"scope\", \"col\");\n    headRow.appendChild(th);\n  });\n  thead.appendChild(headRow);\n  table.appendChild(thead);\n\n  const tbody = document.createElement(\"tbody\");\n  spec.rows.forEach(function (row) {\n    const tr = document.createElement(\"tr\");\n    row.forEach(function (cell, cellIndex) {\n      if (cellIndex === 0) {\n        const th = createElement(\"th\", null, cell);\n        th.setAttribute(\"scope\", \"row\");\n        tr.appendChild(th);\n      } else {\n        tr.appendChild(createElement(\"td\", null, cell));\n      }\n    });\n    tbody.appendChild(tr);\n  });\n  table.appendChild(tbody);\n\n  return table;\n}\n\nfunction createCallout(callout) {\n  const kindLabel = CALLOUT_KIND_LABELS[callout.kind] || CALLOUT_KIND_LABELS.note;\n  const wrapper = createElement(\"aside\", `callout callout-${callout.kind}`);\n  wrapper.appendChild(createElement(\"p\", \"callout-kind\", kindLabel));\n  wrapper.appendChild(createElement(\"p\", \"callout-title\", callout.title));\n  wrapper.appendChild(createElement(\"p\", \"callout-body\", callout.body));\n  return wrapper;\n}\n\n/* ---------- tabs ---------- */\n\nfunction activateTab(name, moveFocus) {\n  const isChanging = state.activeTab !== name;\n\n  tabs.forEach(function (tab) {\n    const tabName = tab.getAttribute(\"data-tab\");\n    const selected = tabName === name;\n    tab.setAttribute(\"aria-selected\", selected ? \"true\" : \"false\");\n    tab.tabIndex = selected ? 0 : -1;\n    panels[tabName].hidden = !selected;\n    if (selected && moveFocus) {\n      tab.focus();\n    }\n  });\n\n  state.activeTab = name;\n\n  /* Land at the top of the panel just chosen. The place that matters inside a\n     panel - which thread is open, which channel is selected - lives in the DOM\n     and survives the switch untouched. Restoring a remembered scroll offset\n     instead would leave the focused tab off-screen (WCAG 2.4.11). */\n  if (isChanging) {\n    window.scrollTo(0, 0);\n  }\n}\n\nfunction moveTabFocus(currentIndex, offset) {\n  const nextIndex = (currentIndex + offset + tabs.length) % tabs.length;\n  activateTab(tabs[nextIndex].getAttribute(\"data-tab\"), true);\n}\n\n/* ---------- wiring ---------- */\n\nfunction attachListeners() {\n  threadList.addEventListener(\"click\", function (event) {\n    const row = event.target.closest(\".thread-row\");\n    if (!row) {\n      return;\n    }\n    runSafely(function () {\n      const threadId = row.getAttribute(\"data-thread-id\");\n      const thread = CLIENT.board.threads.find(function (candidate) {\n        return candidate.id === threadId;\n      });\n      if (thread) {\n        openThread(thread);\n      }\n    });\n  });\n\n  threadBackButton.addEventListener(\"click\", function () {\n    runSafely(closeThread);\n  });\n\n  channelStrip.addEventListener(\"click\", function (event) {\n    const button = event.target.closest(\".channel-button\");\n    if (!button) {\n      return;\n    }\n    runSafely(function () {\n      renderChannel(CLIENT.chat, Number(button.getAttribute(\"data-channel-index\")), true);\n    });\n  });\n\n  tablist.addEventListener(\"click\", function (event) {\n    const tab = event.target.closest(\".tab\");\n    if (!tab) {\n      return;\n    }\n    runSafely(function () {\n      activateTab(tab.getAttribute(\"data-tab\"), false);\n    });\n  });\n\n  tablist.addEventListener(\"keydown\", function (event) {\n    const tab = event.target.closest(\".tab\");\n    if (!tab) {\n      return;\n    }\n    const index = tabs.indexOf(tab);\n    if (event.key === \"ArrowRight\") {\n      event.preventDefault();\n      moveTabFocus(index, 1);\n    } else if (event.key === \"ArrowLeft\") {\n      event.preventDefault();\n      moveTabFocus(index, -1);\n    } else if (event.key === \"Home\") {\n      event.preventDefault();\n      activateTab(tabs[0].getAttribute(\"data-tab\"), true);\n    } else if (event.key === \"End\") {\n      event.preventDefault();\n      activateTab(tabs[tabs.length - 1].getAttribute(\"data-tab\"), true);\n    }\n  });\n}\n\nfunction init() {\n  if (!CLIENT || !CLIENT.board || !CLIENT.chat || !CLIENT.manual) {\n    showError(\"This activity has no research sources to show. Ask your teacher for help.\");\n    return;\n  }\n\n  clientName.textContent = CLIENT.name;\n  clientMeta.textContent = `${CLIENT.role} — ${CLIENT.device}`;\n\n  renderBoard(CLIENT.board);\n  renderChat(CLIENT.chat);\n  renderManual(CLIENT.manual);\n\n  attachListeners();\n}\n\nrunSafely(init);",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    }
  },
  "audit_log": "[{\"changed_at\":\"2026-09-03T19:30:46.860+00:00\",\"changed\":[\"cloned from \\\"Extra links ai-and-the-systems-that-power-it-lesson3-online-resources\\\"\"],\"cloned_from\":\"Extra links ai-and-the-systems-that-power-it-lesson3-online-resources\"},{\"changed_at\":\"2026-09-03 19:31:11 +0000\",\"changed\":[\"long_instructions\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-09-03 19:34:19 +0000\",\"changed\":[\"long_instructions\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-09-03 19:35:29 +0000\",\"changed\":[\"widget_view\",\"initial_view_mode\",\"ai_tutor_prompt_settings\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"}]"
}]]></config>
