  "properties": {
    "encrypted": "false",
    "long_instructions": "# Online Resources \r\n\r\nExamine the following online resources to see if they assist you with troubleshooting:\r\n* **Threadline** message board\r\n* **Huddle** chat\r\n* **FieldPad** user manual\r\n\r\nAdd evidence to your activity guide that supports your troubleshooting process.",
    "offer_browser_tts": "false",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "true",
    "require_edit_to_continue": "true",
    "initial_view_mode": "preview",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "placeholderText": "",
      "multipleChoiceOptions": [
