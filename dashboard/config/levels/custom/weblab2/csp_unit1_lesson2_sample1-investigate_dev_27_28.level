          "contents": "const soundData = {\n  singleUse: { type: 'audio/wav', data: '' },\n  refillable: { type: 'audio/wav', data: '' },\n  faucet: { type: 'audio/wav', data: '' },\n  shower: { type: 'audio/wav', data: '' },\n  timer: { type: 'audio/wav', data: '' }\n};\n",
