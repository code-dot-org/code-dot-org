      "files": {
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": ":root {\n  --indigo: #3743c4;\n  --indigo-dark: #2a3399;\n  --indigo-tint: #e8eafc;\n  --ink: #1c2233;\n  --muted: #3f4a5e;\n  --surface: #ffffff;\n  --page: #eef1f6;\n  --border: #7a869c;\n  --success-bg: #e3f4ea;\n  --success-ink: #14532d;\n  --success-border: #2f7d4f;\n  --warn-bg: #fdecec;\n  --warn-ink: #7f1d1d;\n  --warn-border: #b42318;\n  --alert-bg: #fff4e0;\n  --alert-ink: #7a3e00;\n  --alert-border: #b45309;\n  --water: rgba(47, 143, 216, 0.6);\n  --radius: 0.75rem;\n}\n\n[hidden] {\n  display: none !important;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  display: flex;\n  justify-content: center;\n  align-items: flex-start;\n  padding: 1rem;\n  background: var(--page);\n  color: var(--ink);\n  font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif;\n  font-size: 1rem;\n  line-height: 1.45;\n}\n\n.app {\n  width: 100%;\n  max-width: 28rem;\n  min-height: 36rem;\n  display: flex;\n  flex-direction: column;\n  background: var(--surface);\n  border-radius: 1.5rem;\n  box-shadow: 0 8px 24px rgba(28, 34, 51, 0.18);\n  overflow: hidden;\n}\n\n.app-header {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.75rem;\n  padding: 1rem 1.25rem;\n  background: var(--indigo);\n  color: #ffffff;\n}\n\n.app-title {\n  margin: 0;\n  font-size: 1.25rem;\n  line-height: 1.2;\n}\n\n.language-toggle {\n  display: flex;\n  gap: 0.375rem;\n}\n\n.language-button {\n  min-height: 2.75rem;\n  padding-inline: 0.875rem;\n  border: 2px solid #ffffff;\n  border-radius: 999px;\n  background: transparent;\n  color: #ffffff;\n  font: inherit;\n  font-size: 0.9375rem;\n  cursor: pointer;\n}\n\n.language-button[aria-pressed=\"true\"] {\n  background: #ffffff;\n  color: var(--indigo-dark);\n  font-weight: 700;\n}\n\n.language-button:focus-visible {\n  outline: 3px solid #ffffff;\n  outline-offset: 2px;\n}\n\n.notice {\n  margin: 1rem 1.25rem 0;\n  padding: 0.75rem 1rem;\n  border-radius: var(--radius);\n  background: var(--warn-bg);\n  color: var(--warn-ink);\n  font-weight: 600;\n}\n\n.status {\n  margin: 0.75rem 1.25rem 0;\n  padding: 0.75rem 1rem;\n  min-height: 3.5rem;\n  border-inline-start: 4px solid var(--indigo);\n  border-radius: 0.375rem;\n  background: var(--indigo-tint);\n  color: var(--ink);\n  font-weight: 600;\n}\n\n.status:empty {\n  visibility: hidden;\n}\n\n.screen {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 0.875rem;\n  padding: 1rem 1.25rem 1.25rem;\n}\n\n.screen h2 {\n  margin: 0;\n  font-size: 1.375rem;\n  line-height: 1.25;\n}\n\n.screen h2:focus {\n  outline: none;\n}\n\n.screen p {\n  margin: 0;\n}\n\n.instruction {\n  color: var(--muted);\n  font-weight: 600;\n}\n\n.hero-image {\n  display: block;\n  width: 100%;\n  height: auto;\n  aspect-ratio: 16 / 9;\n  object-fit: contain;\n  border-radius: var(--radius);\n  background: #e2e8f0;\n}\n\n.screen-actions {\n  display: flex;\n  justify-content: flex-end;\n  margin-top: auto;\n  padding-top: 0.5rem;\n}\n\n.primary-button {\n  min-width: 6rem;\n  min-height: 2.75rem;\n  padding: 0.5rem 1.5rem;\n  border: 2px solid var(--indigo);\n  border-radius: var(--radius);\n  background: var(--indigo);\n  color: #ffffff;\n  font: inherit;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n.primary-button:hover {\n  background: var(--indigo-dark);\n  border-color: var(--indigo-dark);\n}\n\n.primary-button:focus-visible,\n.choice-button:focus-visible {\n  outline: 3px solid var(--indigo);\n  outline-offset: 2px;\n}\n\n.choice-row,\n.scene-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));\n  gap: 0.75rem;\n}\n\n.choice-button {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 0.375rem;\n  min-height: 2.75rem;\n  padding: 0.75rem;\n  border: 2px solid var(--border);\n  border-radius: var(--radius);\n  background: var(--surface);\n  color: var(--ink);\n  font: inherit;\n  text-align: center;\n  cursor: pointer;\n}\n\n.choice-button:hover {\n  background: var(--indigo-tint);\n}\n\n.choice-image {\n  width: 4.5rem;\n  height: 4.5rem;\n  object-fit: contain;\n}\n\n.choice-label {\n  font-weight: 700;\n}\n\n.choice-caption {\n  color: var(--muted);\n  font-size: 0.9375rem;\n}\n\n.choice-note {\n  padding: 0.125rem 0.625rem;\n  border-radius: 999px;\n  font-size: 0.875rem;\n  font-weight: 700;\n}\n\n.choice-button.is-rejected {\n  border-color: var(--warn-border);\n  background: var(--warn-bg);\n}\n\n.is-rejected .choice-note {\n  background: var(--warn-ink);\n  color: #ffffff;\n}\n\n.choice-button.is-chosen {\n  border-color: var(--success-border);\n  background: var(--success-bg);\n}\n\n.is-chosen .choice-note {\n  background: var(--success-ink);\n  color: #ffffff;\n}\n\n.choice-button.is-active {\n  border-color: var(--indigo);\n  background: var(--indigo-tint);\n}\n\n.choice-button.is-done {\n  border-color: var(--alert-border);\n  background: var(--alert-bg);\n}\n\n.is-done .choice-note {\n  background: var(--alert-ink);\n  color: #ffffff;\n}\n\n.timer-display {\n  font-size: 2.25rem;\n  font-weight: 700;\n  font-variant-numeric: tabular-nums;\n  line-height: 1.1;\n}\n\n.station {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));\n  gap: 0.75rem;\n  align-items: stretch;\n}\n\n.bottle-slot {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 0.375rem;\n  min-height: 8rem;\n  padding: 0.75rem;\n  border: 2px dashed var(--border);\n  border-radius: var(--radius);\n  text-align: center;\n}\n\n.slot-empty {\n  color: var(--muted);\n}\n\n.slot-note {\n  font-weight: 700;\n  color: var(--success-ink);\n}\n\n.slot-bottle {\n  position: relative;\n  width: 5rem;\n  height: 5rem;\n  overflow: hidden;\n}\n\n.slot-image {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n}\n\n.water {\n  position: absolute;\n  inset: 0;\n  background: var(--water);\n  transform: scaleY(0);\n  transform-origin: bottom;\n  transition: transform 1.2s ease-out;\n}\n\n.slot-bottle.is-full .water {\n  transform: scaleY(0.85);\n}\n\n.drop {\n  position: absolute;\n  top: 0;\n  inset-inline-start: 45%;\n  width: 0.6rem;\n  height: 0.6rem;\n  border-radius: 50%;\n  background: #1f6fb2;\n  opacity: 0;\n}\n\n.drop-two {\n  margin-inline-start: 0.9rem;\n  animation-delay: 0.3s;\n}\n\n.slot-bottle.is-filling .drop {\n  animation: drip 0.9s ease-in 3;\n}\n\n@keyframes drip {\n  from {\n    transform: translateY(0);\n    opacity: 1;\n  }\n\n  to {\n    transform: translateY(3.5rem);\n    opacity: 0;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .water {\n    transition: none;\n  }\n\n  .slot-bottle.is-filling .drop {\n    animation: none;\n  }\n}\n\n@media (max-width: 22rem) {\n  body {\n    padding: 0;\n  }\n\n  .app {\n    border-radius: 0;\n  }\n}\n",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Water Conservation Tips</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"sounds.js\" defer></script>\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"app\">\n    <header class=\"app-header\">\n      <h1 class=\"app-title\" data-i18n=\"title\">Water Conservation Tips</h1>\n      <div class=\"language-toggle\" role=\"group\" aria-label=\"Language\" data-i18n-label=\"languageGroupLabel\">\n        <button type=\"button\" class=\"language-button\" data-language=\"en\" aria-pressed=\"true\" data-i18n=\"languageEnglish\">English</button>\n        <button type=\"button\" class=\"language-button\" data-language=\"es\" aria-pressed=\"false\" data-i18n=\"languageSpanish\">Spanish</button>\n      </div>\n    </header>\n\n    <noscript><p class=\"notice\">This app needs JavaScript to run.</p></noscript>\n    <p id=\"app-error\" class=\"notice\" hidden>Something went wrong loading this app. Please refresh the page.</p>\n\n    <p id=\"status\" class=\"status\" role=\"status\" aria-live=\"polite\"></p>\n\n    <section id=\"screen-home\" class=\"screen\" aria-labelledby=\"home-heading\">\n      <h2 id=\"home-heading\" tabindex=\"-1\" data-i18n=\"homeHeading\">Let's get started</h2>\n      <p data-i18n=\"homeText\">It's important that we all do our part to use less water. Click through this app for tips for conservation ideas.</p>\n      <img class=\"hero-image\" src=\"faucet.jpg\" width=\"320\" height=\"180\" alt=\"A stream of water pouring into a glass\" data-i18n-alt=\"heroAlt\">\n      <div class=\"screen-actions\">\n        <button type=\"button\" id=\"home-next-button\" class=\"primary-button\" data-i18n=\"next\">Next</button>\n      </div>\n    </section>\n\n    <section id=\"screen-bottle\" class=\"screen\" aria-labelledby=\"bottle-heading\" hidden>\n      <h2 id=\"bottle-heading\" tabindex=\"-1\" data-i18n=\"bottleHeading\">Tip 1: Use a refillable bottle</h2>\n      <p data-i18n=\"bottleText\">Instead of buying disposable water bottles, use a refillable bottle. Single-use water bottles fill our landfills and trap valuable water.</p>\n      <p class=\"instruction\" data-i18n=\"bottleInstruction\">Choose the correct water bottle. Then click the faucet to fill.</p>\n\n      <div class=\"choice-row\">\n        <button type=\"button\" id=\"single-use-button\" class=\"choice-button\">\n          <img class=\"choice-image\" src=\"single-use-bottle.png\" width=\"96\" height=\"96\" alt=\"\">\n          <span class=\"choice-label\" data-i18n=\"singleUseLabel\">Single-use bottle</span>\n          <span id=\"single-use-note\" class=\"choice-note\" data-i18n=\"rejectedNote\" hidden>Not this one</span>\n        </button>\n        <button type=\"button\" id=\"refillable-button\" class=\"choice-button\" aria-pressed=\"false\">\n          <img class=\"choice-image\" src=\"refillable-bottle.png\" width=\"96\" height=\"96\" alt=\"\">\n          <span class=\"choice-label\" data-i18n=\"refillableLabel\">Refillable bottle</span>\n          <span id=\"refillable-note\" class=\"choice-note\" data-i18n=\"selectedNote\" hidden>Selected</span>\n        </button>\n      </div>\n\n      <div class=\"station\">\n        <button type=\"button\" id=\"faucet-button\" class=\"choice-button\">\n          <img class=\"choice-image\" src=\"faucet-2.png\" width=\"96\" height=\"96\" alt=\"\">\n          <span class=\"choice-label\" data-i18n=\"faucetLabel\">Faucet</span>\n        </button>\n        <div class=\"bottle-slot\">\n          <p id=\"slot-empty\" class=\"slot-empty\" data-i18n=\"slotEmpty\">Your bottle will appear here.</p>\n          <div id=\"slot-bottle\" class=\"slot-bottle\" hidden>\n            <img class=\"slot-image\" src=\"refillable-bottle.png\" width=\"96\" height=\"96\" alt=\"\">\n            <span class=\"water\" aria-hidden=\"true\"></span>\n            <span class=\"drop drop-one\" aria-hidden=\"true\"></span>\n            <span class=\"drop drop-two\" aria-hidden=\"true\"></span>\n          </div>\n          <p id=\"slot-full\" class=\"slot-note\" data-i18n=\"bottleFull\" hidden>Full</p>\n        </div>\n      </div>\n\n      <div class=\"screen-actions\">\n        <button type=\"button\" id=\"bottle-next-button\" class=\"primary-button\" data-i18n=\"next\">Next</button>\n      </div>\n    </section>\n\n    <section id=\"screen-shower\" class=\"screen\" aria-labelledby=\"shower-heading\" hidden>\n      <h2 id=\"shower-heading\" tabindex=\"-1\" data-i18n=\"showerHeading\">Tip 2: Take shorter showers</h2>\n      <p data-i18n=\"showerText\">Another way to conserve water is to take shorter showers. Try setting a timer to five minutes!</p>\n      <p class=\"instruction\" data-i18n=\"showerInstruction\">Click on the timer.</p>\n\n      \n      <div class=\"scene-grid\">\n        <button type=\"button\" id=\"shower-button\" class=\"choice-button\">\n          \n<img id=\"shower-image\" class=\"scene-image\" src=\"shower-occupied.jpg\" width=\"144\" height=\"144\"\n     alt=\"A bathtub with the shower curtain closed and a rubber duck blurred behind it\"\n     data-i18n-alt=\"showerAltClosed\" data-open-src=\"duck.jpg\" data-closed-src=\"shower-occupied.jpg\">\n          <span class=\"choice-label\" data-i18n=\"showerLabel\">Shower</span>\n          <span id=\"shower-caption\" class=\"choice-caption\" data-i18n=\"showerCaptionIdle\">Someone is in the shower.</span>\n        </button>\n        <button type=\"button\" id=\"timer-button\" class=\"choice-button\">\n          <span class=\"choice-label\" data-i18n=\"timerLabel\">Timer</span>\n          <span id=\"timer-display\" class=\"timer-display\" data-i18n=\"timerStart\">5:00</span>\n          <span id=\"timer-note\" class=\"choice-note\" data-i18n=\"timerNote\" hidden>Time is up</span>\n        </button>\n      </div>\n\n      <div class=\"screen-actions\">\n        <button type=\"button\" id=\"home-button\" class=\"primary-button\" data-i18n=\"home\">Home</button>\n      </div>\n    </section>\n  </main>\n</body>\n</html>\n",
          "folderId": "0",
          "active": true
        },
