        "12": {
          "id": "12",
          "name": "script.js",
          "contents": "const translations = {\n  en: {\n    title: 'Water Conservation Tips',\n    languageGroupLabel: 'Language',\n    languageEnglish: 'English',\n    languageSpanish: 'Spanish',\n    next: 'Next',\n    home: 'Home',\n    homeHeading: \"Let's get started\",\n    homeText: \"It's important that we all do our part to use less water. Click through this app for tips for conservation ideas.\",\n    heroAlt: 'A stream of water pouring into a glass',\n    bottleHeading: 'Tip 1: Use a refillable bottle',\n    bottleText: 'Instead of buying disposable water bottles, use a refillable bottle. Single-use water bottles fill our landfills and trap valuable water.',\n    bottleInstruction: 'Choose the correct water bottle. Then click the faucet to fill.',\n    singleUseLabel: 'Single-use bottle',\n    refillableLabel: 'Refillable bottle',\n    faucetLabel: 'Faucet',\n    rejectedNote: 'Not this one',\n    selectedNote: 'Selected',\n    slotEmpty: 'Your bottle will appear here.',\n    bottleFull: 'Full',\n    singleUseRejected: 'Single-use bottles fill our landfills. Try the refillable bottle.',\n    bottleChosen: 'You chose the refillable bottle. Now click the faucet to fill it.',\n    chooseFirst: 'Choose the correct bottle first.',\n    bottleFilled: 'The refillable bottle is full.',\n    showerHeading: 'Tip 2: Take shorter showers',\n    showerText: 'Another way to conserve water is to take shorter showers. Try setting a timer to five minutes!',\n    showerInstruction: 'Click on the timer.',\n    showerLabel: 'Shower',\n    showerCaptionIdle: 'Someone is in the shower.',\n    showerCaptionDone: 'The shower is finished.',\n    showerAltClosed: 'A bathtub with the shower curtain closed and a rubber duck blurred behind it',\n    showerAltOpen: 'A yellow rubber duck',\n    showerRunning: 'The shower is running.',\n    timerLabel: 'Timer',\n    timerStart: '5:00',\n    timerEnd: '0:00',\n    timerNote: 'Time is up',\n    timerDone: 'The timer ran out. A five-minute shower saves water.'\n  },\n  es: {\n    title: 'Consejos para la conservación del agua',\n    languageGroupLabel: 'Idioma',\n    languageEnglish: 'Inglés',\n    languageSpanish: 'Español',\n    next: 'Siguiente',\n    home: 'Inicio',\n    homeHeading: 'Empecemos',\n    homeText: 'Es importante que todos hagamos nuestra parte para usar menos agua. Recorra esta aplicación para ver ideas para conservar el agua.',\n    heroAlt: 'Un chorro de agua cayendo en un vaso',\n    bottleHeading: 'Consejo 1: Use una botella recargable',\n    bottleText: 'En lugar de comprar botellas de agua desechables, use una botella recargable. Las botellas de agua de un solo uso llenan nuestros vertederos y atrapan agua valiosa.',\n    bottleInstruction: 'Elija la botella de agua correcta. Luego haga clic en el grifo para llenarla.',\n    singleUseLabel: 'Botella de un solo uso',\n    refillableLabel: 'Botella recargable',\n    faucetLabel: 'Grifo',\n    rejectedNote: 'Esta no',\n    selectedNote: 'Elegida',\n    slotEmpty: 'Su botella aparecerá aquí.',\n    bottleFull: 'Llena',\n    singleUseRejected: 'Las botellas de un solo uso llenan nuestros vertederos. Pruebe la botella recargable.',\n    bottleChosen: 'Eligió la botella recargable. Ahora haga clic en el grifo para llenarla.',\n    chooseFirst: 'Primero elija la botella correcta.',\n    bottleFilled: 'La botella recargable está llena.',\n    showerHeading: 'Consejo 2: Tome duchas más cortas',\n    showerText: 'Otra forma de conservar el agua es tomar duchas más cortas. ¡Pruebe a configurar un temporizador de cinco minutos!',\n    showerInstruction: 'Haga clic en el temporizador.',\n    showerLabel: 'Ducha',\n    showerCaptionIdle: 'Alguien está en la ducha.',\n    showerCaptionDone: 'La ducha terminó.',\n    showerAltClosed: 'Una bañera con la cortina de la ducha cerrada y un patito de goma borroso detrás',\n    showerAltOpen: 'Un patito de goma amarillo',\n    showerRunning: 'La ducha está abierta.',\n    timerLabel: 'Temporizador',\n    timerStart: '5:00',\n    timerEnd: '0:00',\n    timerNote: 'Se acabó el tiempo',\n    timerDone: 'El temporizador terminó. Una ducha de cinco minutos ahorra agua.'\n  }\n};\n\nconst state = {\n  language: 'en',\n  statusKey: '',\n  bottleChosen: false,\n  timerDone: false\n};\n\nconst byId = (id) => document.getElementById(id);\n\nconst soundUrls = {};\n\nfunction getSoundUrl(key) {\n  if (!soundUrls[key]) {\n    const sound = soundData[key];\n    const bytes = Uint8Array.from(atob(sound.data), (character) => character.charCodeAt(0));\n    soundUrls[key] = URL.createObjectURL(new Blob([bytes], { type: sound.type }));\n  }\n  return soundUrls[key];\n}\n\nfunction playSound(key) {\n  try {\n    const playback = new Audio(getSoundUrl(key)).play();\n    if (playback && typeof playback.catch === 'function') {\n      playback.catch(() => {});\n    }\n  } catch (error) {\n    // Sound is optional: the status message carries the same feedback.\n  }\n}\n\nfunction translate(key) {\n  const table = translations[state.language];\n  return (table && table[key]) || translations.en[key] || '';\n}\n\nfunction translateElement(element) {\n  const { i18n, i18nAlt, i18nLabel } = element.dataset;\n  if (i18n) {\n    element.textContent = translate(i18n);\n  }\n  if (i18nAlt) {\n    element.alt = translate(i18nAlt);\n  }\n  if (i18nLabel) {\n    element.setAttribute('aria-label', translate(i18nLabel));\n  }\n}\n\nfunction setTranslationKey(element, attribute, key) {\n  element.dataset[attribute] = key;\n  translateElement(element);\n}\n\nfunction renderStatus() {\n  byId('status').textContent = state.statusKey ? translate(state.statusKey) : '';\n}\n\nfunction setStatus(key) {\n  state.statusKey = key;\n  renderStatus();\n}\n\nfunction applyTranslations() {\n  document.documentElement.lang = state.language;\n  document.title = translate('title');\n  document\n    .querySelectorAll('[data-i18n], [data-i18n-alt], [data-i18n-label]')\n    .forEach(translateElement);\n  renderStatus();\n}\n\nfunction setLanguage(language) {\n  state.language = language;\n  document.querySelectorAll('.language-button').forEach((button) => {\n    button.setAttribute('aria-pressed', String(button.dataset.language === language));\n  });\n  applyTranslations();\n}\n\nfunction showScreen(screenId) {\n  document.querySelectorAll('.screen').forEach((screen) => {\n    screen.hidden = screen.id !== screenId;\n  });\n  setStatus('');\n  window.scrollTo(0, 0);\n  byId(screenId).querySelector('h2').focus();\n}\n\nfunction rejectSingleUse() {\n  byId('single-use-button').classList.add('is-rejected');\n  byId('single-use-note').hidden = false;\n  playSound('singleUse');\n  setStatus('singleUseRejected');\n}\n\nfunction chooseRefillable() {\n  const button = byId('refillable-button');\n  state.bottleChosen = true;\n  button.classList.add('is-chosen');\n  button.setAttribute('aria-pressed', 'true');\n  byId('refillable-note').hidden = false;\n  byId('slot-empty').hidden = true;\n  byId('slot-bottle').hidden = false;\n  playSound('refillable');\n  setStatus('bottleChosen');\n}\n\nfunction fillBottle() {\n  if (!state.bottleChosen) {\n    setStatus('chooseFirst');\n    return;\n  }\n  byId('slot-bottle').classList.add('is-filling', 'is-full');\n  byId('slot-full').hidden = false;\n  playSound('faucet');\n  setStatus('bottleFilled');\n}\n\nfunction resetBottleScene() {\n  const refillable = byId('refillable-button');\n  state.bottleChosen = false;\n  byId('single-use-button').classList.remove('is-rejected');\n  byId('single-use-note').hidden = true;\n  refillable.classList.remove('is-chosen');\n  refillable.setAttribute('aria-pressed', 'false');\n  byId('refillable-note').hidden = true;\n  byId('slot-empty').hidden = false;\n  byId('slot-bottle').hidden = true;\n  byId('slot-bottle').classList.remove('is-filling', 'is-full');\n  byId('slot-full').hidden = true;\n}\n\nfunction runShower() {\n  byId('shower-button').classList.add('is-active');\n  playSound('shower');\n  setStatus('showerRunning');\n}\n\nfunction finishTimer() {\n  const image = byId('shower-image');\n  state.timerDone = true;\n  byId('timer-button').classList.add('is-done');\n  byId('timer-note').hidden = false;\n  setTranslationKey(byId('timer-display'), 'i18n', 'timerEnd');\n  image.src = image.dataset.openSrc;\n  setTranslationKey(image, 'i18nAlt', 'showerAltOpen');\n  setTranslationKey(byId('shower-caption'), 'i18n', 'showerCaptionDone');\n  playSound('timer');\n  setStatus('timerDone');\n}\n\nfunction resetShowerScene() {\n  const image = byId('shower-image');\n  state.timerDone = false;\n  byId('shower-button').classList.remove('is-active');\n  byId('timer-button').classList.remove('is-done');\n  byId('timer-note').hidden = true;\n  setTranslationKey(byId('timer-display'), 'i18n', 'timerStart');\n  image.src = image.dataset.closedSrc;\n  setTranslationKey(image, 'i18nAlt', 'showerAltClosed');\n  setTranslationKey(byId('shower-caption'), 'i18n', 'showerCaptionIdle');\n}\n\nfunction goHome() {\n  resetBottleScene();\n  resetShowerScene();\n  showScreen('screen-home');\n}\n\nfunction init() {\n  document.querySelectorAll('.language-button').forEach((button) => {\n    button.addEventListener('click', () => setLanguage(button.dataset.language));\n  });\n  byId('home-next-button').addEventListener('click', () => showScreen('screen-bottle'));\n  byId('bottle-next-button').addEventListener('click', () => showScreen('screen-shower'));\n  byId('home-button').addEventListener('click', goHome);\n  byId('single-use-button').addEventListener('click', rejectSingleUse);\n  byId('refillable-button').addEventListener('click', chooseRefillable);\n  byId('faucet-button').addEventListener('click', fillBottle);\n  byId('shower-button').addEventListener('click', runShower);\n  byId('timer-button').addEventListener('click', finishTimer);\n}\n\ntry {\n  init();\n} catch (error) {\n  byId('app-error').hidden = false;\n  document.querySelectorAll('.screen').forEach((screen) => {\n    screen.hidden = true;\n  });\n}\n",
