<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2025-11-07T18:35:11.000Z",
  "level_num": "custom",
  "user_id": 22366,
  "properties": {
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Local Volunteer Finder</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n  <h1>Find Volunteer Opportunities</h1>\n\n  <label>Cause\n    <select id=\"cause-filter\">\n      <option value=\"\">Any</option>\n      <option>Animals</option>\n      <option>Environment</option>\n      <option>Community</option>\n      <option>Education</option>\n    </select>\n  </label>\n\n  <label>Max Miles from School\n    <input id=\"miles-filter\" type=\"number\" value=\"10\" min=\"1\">\n  </label>\n\n  <button id=\"apply-button\">Apply Filters</button>\n\n  <hr>\n\n  <h2>Results</h2>\n  \n  <p id=\"active-filters\"></p>\n  \n  <p id=\"count\"></p>\n\n  <ul id=\"list\"></ul>\n\n  <p id=\"empty-message\"></p>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "process.md",
          "language": "md",
          "contents": "Add your changes to process.md",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "// The dataset of volunteer opportunities\nconst opportunities = [\n  { \n    name: \"City Animal Shelter\", \n    location: \"Downtown\", \n    cause: \"Animals\", \n    miles: 3, \n    hours: \"Weekends\" \n  },\n  { \n    name: \"Park Cleanup Crew\", \n    location: \"Greenwood Park\", \n    cause: \"Environment\", \n    miles: 5, \n    hours: \"Sat AM\" \n  },\n  { \n    name: \"Community Food Bank\", \n    location: \"West Side\", \n    cause: \"Community\", \n    miles: 8, \n    hours: \"Weekdays\" \n  },\n  { \n    name: \"Reading Partners\", \n    location: \"Local Library\", \n    cause: \"Education\", \n    miles: 2, \n    hours: \"Tues/Thurs PM\" \n  },\n  { \n    name: \"RiverKeepers\", \n    location: \"Riverfront\", \n    cause: \"Environment\", \n    miles: 12, \n    hours: \"Weekends\" \n  }\n];\n\n// Get references to DOM elements\nconst causeEl = document.getElementById(\"cause-filter\");\nconst milesEl = document.getElementById(\"miles-filter\");\nconst applyBtn = document.getElementById(\"apply-button\");\n\nconst listEl = document.getElementById(\"list\");\nconst activeEl = document.getElementById(\"active-filters\");\nconst countEl = document.getElementById(\"count\");\nconst emptyEl = document.getElementById(\"empty-message\");\n\n\n// Build a readable summary of the active filters\nconst describeFilters = (filters) => {\n  let text = \"Cause: \";\n  \n  if (filters.cause === \"\") {\n    text += \"Any\";\n  } else {\n    text += filters.cause;\n  }\n\n  text += \" | Max Miles: \" + filters.miles;\n  return text;\n};\n\n// Render results, counts, and empty state\nconst render = (filtered, total, filters) => {\n  // Clear previous results\n  listEl.innerHTML = \"\";\n  emptyEl.textContent = \"\";\n\n  // Update text for active filters and count\n  activeEl.textContent = \"Active filters — \" + describeFilters(filters);\n  countEl.textContent = \"Showing \" + filtered.length + \" of \" + total + \" opportunity(s).\";\n\n  // Handle the empty state\n  if (filtered.length === 0) {\n    emptyEl.textContent = \"No results found. Try changing your filters.\";\n    return; // Stop here if no results\n  }\n\n  // Build the HTML for the list\n  let html = \"\";\n  for (let i = 0; i < filtered.length; i++) {\n    const op = filtered[i];\n    \n    // Create an <li> for each opportunity\n    html += \"<li>\" + \n      \"<strong>\" + op.name + \"</strong> (\" + op.cause + \")\" +\n      \"<br>\" + \n      op.location + \" — \" + op.miles + \" miles away\" +\n      \"</li>\";\n  }\n\n  // Add the new HTML to the page\n  listEl.innerHTML = html;\n};\n\nconst matchesFilters = (record, filters) => {\n  let causeMatches = false;\n  let withinMiles = false;\n  if (filters.cause == \"\" || filters.cause == record.cause) {\n    causeMatches = true;\n  }\n  if (record.miles < filters.miles) {\n    withinMiles = true;\n  }\n  return causeMatches && withinMiles;\n}\n\n// --- This is the function we need to build ---\n\nconst applyFilters = () => {\n  // 1. Get the current filter values\n  const filters = {\n    cause: causeEl.value,\n    miles: Number(milesEl.value)\n  };\n\n  // 2. Use .filter() to create a new array\n  const filtered = opportunities.filter((op) => {\n    return matchesFilters(op, filters);\n  });\n\n  // 3. Render the new results!\n  render(filtered, opportunities.length, filters);\n};\n\n// --- Event Listener ---\n// Run the applyFilters function when the button is clicked\napplyBtn.addEventListener(\"click\", applyFilters);",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "style.css",
          "language": "css",
          "contents": "/* --- Basic Setup --- */\nbody {\n  font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto,\n    sans-serif;\n  line-height: 1.6;\n  background-color: #fff; /* White background */\n  color: #222; /* Dark gray text */\n  max-width: 650px; /* Constrain width for readability */\n  margin: 0 auto; /* Center the content */\n  padding: 20px;\n}\n\nh1, h2 {\n  border-bottom: 1px solid #eee;\n  padding-bottom: 5px;\n}\n\n/* --- Filter Controls --- */\nlabel {\n  display: block; /* Stack controls vertically */\n  margin-bottom: 15px;\n  font-weight: bold;\n}\n\nselect,\ninput[type=\"number\"] {\n  display: block;\n  width: 100%;\n  padding: 8px;\n  margin-top: 4px;\n  font-size: 1rem;\n  /* Ensures padding doesn't break the width */\n  box-sizing: border-box; \n}\n\nbutton {\n  display: block;\n  width: 100%;\n  padding: 12px;\n  font-size: 1.1rem;\n  font-weight: bold;\n  cursor: pointer;\n  background-color: #f0f0f0;\n  border: 1px solid #ccc;\n  border-radius: 4px;\n}\n\nbutton:hover {\n  background-color: #e0e0e0;\n}\n\nhr {\n  margin: 25px 0;\n  border: none;\n  border-top: 1px solid #eee;\n}\n\n/* --- Results Area --- */\n#list {\n  list-style-type: none; /* Remove bullets */\n  padding-left: 0;\n}\n\n#list li {\n  border: 1px solid #ccc;\n  border-radius: 4px;\n  padding: 16px;\n  margin-bottom: 10px;\n}\n\n/* Make the opportunity name bigger */\n#list li strong {\n  font-size: 1.2rem;\n  display: block; /* Puts it on its own line */\n  margin-bottom: 5px;\n  color: #000;\n}\n\n/* --- Helper Text --- */\n#active-filters {\n  font-style: italic;\n  color: #555;\n  font-size: 0.9rem;\n}\n\n#count {\n  font-weight: bold;\n}\n\n#empty-message {\n  font-style: italic;\n  color: #777;\n  text-align: center;\n  padding: 20px;\n  background-color: #f9f9f9;\n  border: 1px dashed #ccc;\n  border-radius: 4px;\n}",
          "folderId": "0",
          "active": true
        }
      },
