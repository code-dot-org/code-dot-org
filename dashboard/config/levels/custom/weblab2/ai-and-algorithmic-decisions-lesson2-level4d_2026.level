        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Chaos Classifier</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n    <script defer src=\"script.js\"></script>\n  </head>\n  <body>\n    <h1 class=\"title\">🫠 Chaos Classifier</h1>\n    <main class=\"container\">\n      <section class=\"left\">\n        <img id=\"image\" class=\"image\" src=\"images/default.png\" alt=\"Chaos classifier illustration\" />\n      </section>\n      <section class=\"right\">\n        <p class=\"prompt\">Which one are you right now?</p>\n        <div class=\"buttons\">\n          <button id=\"dramaButton\" type=\"button\">💬 Friend Drama</button>\n          <button id=\"sleepButton\" type=\"button\">😵 Can't Sleep</button>\n          <button id=\"chargerButton\" type=\"button\">🔋 Lost Your Charger</button>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>",
          "folderId": "0",
          "active": true
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\nhtml,\nbody {\n  height: 100%;\n}\nbody {\n  margin: 0;\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n  background: #fde68a;\n  color: #1f2937;\n}\n.title {\n  text-align: center;\n  margin: 16px 0 0;\n  font-size: 1.75rem;\n  letter-spacing: 0.5px;\n  color: #0f172a;\n}\n.container {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 24px;\n  padding: 24px;\n  max-width: 1000px;\n  margin: 0 auto;\n}\n.left {\n  background: #fff;\n  border: 1px solid #e5e7eb;\n  border-radius: 12px;\n  padding: 16px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n}\n.image {\n  display: block;\n  max-width: 100%;\n  height: auto;\n  border-radius: 8px;\n  object-fit: contain;\n  transition: opacity 300ms ease;\n}\n.right {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  gap: 24px;\n}\n.prompt {\n  margin: 0;\n  font-size: 0.95rem;\n  color: #6b7280;\n}\n.buttons {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  width: 240px;\n  margin-inline: auto;\n}\n.buttons button {\n  padding: 12px 16px;\n  font-size: 1rem;\n  border-radius: 10px;\n  border: 1px solid #1f2937;\n  background: #ffffff;\n  color: #111827;\n  cursor: pointer;\n  transition: background-color 120ms ease, color 120ms ease, border-color 120ms ease;\n}\n.buttons button:hover {\n  background: #f59e0b;\n  border-color: #f59e0b;\n  color: #fff;\n}\n.buttons button:active {\n  transform: translateY(1px);\n}\n@media (max-width: 800px) {\n  .container {\n    grid-template-columns: 1fr;\n  }\n  .buttons {\n    width: 100%;\n  }\n}",
          "folderId": "0",
          "active": false
        },
