    "encrypted": "false",
    "display_name": "Chaos Classifier",
    "bubble_choice_description": "Build a Chaos Classifier where clicking each situation button swaps the image to match that chaos.",
    "thumbnail_url": "https://images.code.org/c771762ef422bbfac683bc217cf5eaf8-default.png",
    "submittable": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
    "disable_edit_run_for_submission": "false",
    "ai_tutor_mode": "tutor",
