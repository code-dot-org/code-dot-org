<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-10-16T21:26:09.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": true,
    "start_sources": {
      "folders": {
      },
      "files": {
        "2904cb0e-7974-4d3a-b931-ec62a00ac2cd": {
          "id": "2904cb0e-7974-4d3a-b931-ec62a00ac2cd",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Plan vs Result</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <div class=\"container\">\n        <h1>Plan vs. AI Result</h1>\n\n        <div class=\"panel plan-section\">\n            <h2>Your Plan</h2>\n            <p id=\"plan-text\">I want a simple page with a <strong>purple header</strong> saying <strong>'My Cool Project'</strong>, and a <strong>big yellow button</strong> saying <strong>'Start Now'</strong>.</p>\n        </div>\n\n        <div class=\"panel result-section\">\n            <h2>AI Result</h2>\n            <div class=\"simulated-page\">\n                <header class=\"result-part\" data-match-id=\"header-style\"> \n                    <h1 class=\"result-part\" data-match-id=\"header-text\">My Cool <span style=\"color: #cc0000;\">Venture</span></h1>\n                </header>\n                <p>Explore exciting new possibilities.</p>\n                <button class=\"result-part\" data-match-id=\"button-style\">Click <span style=\"color: #00cc00;\">Here</span></button>\n            </div>\n            <div class=\"match-instructions\">Click parts that match your plan:</div>\n        </div>\n\n        <div class=\"panel decision-section\">\n            <h2>Your Decision</h2>\n            <div class=\"decision-buttons\">\n                <button id=\"keepBtn\">Keep It</button>\n                <button id=\"redirectBtn\">Redirect It</button>\n                <button id=\"editBtn\">Edit It</button>\n            </div>\n        </div>\n\n        <div class=\"panel response-section\">\n            <h2>Page Response</h2>\n            <p id=\"response-message\">Make your choices above.</p>\n        </div>\n    </div>\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "d524400d-4949-4ff4-8854-5a836145dc5c": {
          "id": "d524400d-4949-4ff4-8854-5a836145dc5c",
          "name": "style.css",
          "contents": "body {\n    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n    margin: 0;\n    padding: 20px;\n    background-color: #eef2f5;\n    color: #333;\n    display: flex;\n    justify-content: center;\n    align-items: flex-start;\n    min-height: 100vh;\n}\n\n.container {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    grid-template-rows: auto auto auto;\n    gap: 20px;\n    max-width: 900px;\n    width: 100%;\n    background-color: #fff;\n    border-radius: 10px;\n    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);\n    padding: 25px;\n}\n\nh1 {\n    grid-column: 1 / -1;\n    text-align: center;\n    color: #2c3e50;\n    margin-top: 0;\n    margin-bottom: 25px;\n}\n\n.panel {\n    background-color: #f8f9fa;\n    border: 1px solid #dee2e6;\n    border-radius: 8px;\n    padding: 20px;\n    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);\n}\n\nh2 {\n    color: #34495e;\n    margin-top: 0;\n    border-bottom: 1px solid #e9ecef;\n    padding-bottom: 10px;\n    margin-bottom: 15px;\n}\n\n.plan-section {\n    grid-column: 1 / 2;\n}\n\n.result-section {\n    grid-column: 2 / 3;\n}\n\n.simulated-page {\n    border: 1px dashed #ccc;\n    padding: 15px;\n    margin-top: 15px;\n    background-color: #fff;\n    border-radius: 5px;\n    text-align: center;\n}\n\n.simulated-page header {\n    background-color: #6a5acd; /* Default: blue-ish purple */\n    color: white;\n    padding: 15px 10px;\n    margin-bottom: 15px;\n    cursor: pointer;\n    transition: background-color 0.2s ease;\n}\n\n.simulated-page header h1 {\n    margin: 0;\n    font-size: 1.8em;\n    color: white; /* Ensure text is white */\n    cursor: pointer;\n}\n\n.simulated-page p {\n    font-size: 0.95em;\n    color: #555;\n    margin-bottom: 15px;\n}\n\n.simulated-page button {\n    background-color: #ffeb3b; /* Default: yellow */\n    color: #333;\n    border: none;\n    padding: 10px 20px;\n    font-size: 1em;\n    border-radius: 5px;\n    cursor: pointer;\n    transition: background-color 0.2s ease, transform 0.1s ease;\n}\n\n.simulated-page button:hover {\n    transform: translateY(-1px);\n}\n\n.result-part {\n    outline: 2px solid transparent; /* Default, no outline */\n    transition: outline-color 0.2s ease;\n}\n\n.result-part.matched {\n    outline-color: #28a745;\n    outline-offset: 3px;\n    box-shadow: 0 0 0 2px #28a745;\n}\n\n.match-instructions {\n    font-size: 0.85em;\n    color: #6c757d;\n    margin-top: 15px;\n    text-align: center;\n}\n\n.decision-section {\n    grid-column: 1 / 2;\n}\n\n.decision-buttons {\n    display: flex;\n    justify-content: space-around;\n    gap: 10px;\n    margin-top: 15px;\n}\n\n.decision-buttons button {\n    flex: 1;\n    padding: 12px 15px;\n    font-size: 1em;\n    border: none;\n    border-radius: 5px;\n    cursor: pointer;\n    transition: background-color 0.2s ease, transform 0.1s ease;\n    color: white;\n}\n\n#keepBtn {\n    background-color: #28a745;\n}\n#keepBtn:hover {\n    background-color: #218838;\n    transform: translateY(-1px);\n}\n\n#redirectBtn {\n    background-color: #ffc107;\n    color: #333;\n}\n#redirectBtn:hover {\n    background-color: #e0a800;\n    transform: translateY(-1px);\n}\n\n#editBtn {\n    background-color: #007bff;\n}\n#editBtn:hover {\n    background-color: #0056b3;\n    transform: translateY(-1px);\n}\n\n.response-section {\n    grid-column: 2 / 3;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: center;\n    text-align: center;\n}\n\n#response-message {\n    font-size: 1.1em;\n    font-weight: bold;\n    color: #34495e;\n    margin: 0;\n}\n\n/* Specific styles for the simulated page to show changes */\n.simulated-page.kept header {\n    background-color: #6a1b9a; /* Darker purple */\n}\n.simulated-page.kept header h1 {\n    color: white;\n}\n.simulated-page.kept button {\n    background-color: #fbc02d; /* Darker yellow */\n    color: #333;\n}\n\n.simulated-page.redirected {\n    opacity: 0.6;\n    filter: blur(1px);\n}\n\n.simulated-page.edited .result-part {\n    border: 2px dashed #007bff;\n    outline: none;\n}\n",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "cdee4012-01cf-4f2d-9acc-2bbac1fc393e": {
          "id": "cdee4012-01cf-4f2d-9acc-2bbac1fc393e",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const resultParts = document.querySelectorAll('.result-part');\n    const keepBtn = document.getElementById('keepBtn');\n    const redirectBtn = document.getElementById('redirectBtn');\n    const editBtn = document.getElementById('editBtn');\n    const responseMessage = document.getElementById('response-message');\n    const simulatedPage = document.querySelector('.simulated-page');\n\n    resultParts.forEach(part => {\n        part.addEventListener('click', () => {\n            part.classList.toggle('matched');\n        });\n    });\n\n    keepBtn.addEventListener('click', () => {\n        responseMessage.textContent = \"Great! The page is kept as is.\";\n        simulatedPage.classList.remove('redirected', 'edited');\n        simulatedPage.classList.add('kept');\n        // Simulate final look based on matched parts\n        simulatedPage.querySelector('header').style.backgroundColor = '#6a1b9a'; // Purple\n        simulatedPage.querySelector('h1').textContent = 'My Cool Project';\n        simulatedPage.querySelector('button').style.backgroundColor = '#fbc02d'; // Yellow\n        simulatedPage.querySelector('button').textContent = 'Start Now';\n    });\n\n    redirectBtn.addEventListener('click', () => {\n        responseMessage.textContent = \"Okay, let's try a new prompt!\";\n        simulatedPage.classList.remove('kept', 'edited');\n        simulatedPage.classList.add('redirected');\n        // Reset to original AI result for redirect\n        simulatedPage.querySelector('header').style.backgroundColor = '#6a5acd';\n        simulatedPage.querySelector('h1').innerHTML = 'My Cool <span style=\"color: #cc0000;\">Venture</span>';\n        simulatedPage.querySelector('button').style.backgroundColor = '#ffeb3b';\n        simulatedPage.querySelector('button').innerHTML = 'Click <span style=\"color: #00cc00;\">Here</span>';\n    });\n\n    editBtn.addEventListener('click', () => {\n        responseMessage.textContent = \"Ready for your manual edits!\";\n        simulatedPage.classList.remove('kept', 'redirected');\n        simulatedPage.classList.add('edited');\n        // Reset to original AI result for edit\n        simulatedPage.querySelector('header').style.backgroundColor = '#6a5acd';\n        simulatedPage.querySelector('h1').innerHTML = 'My Cool <span style=\"color: #cc0000;\">Venture</span>';\n        simulatedPage.querySelector('button').style.backgroundColor = '#ffeb3b';\n        simulatedPage.querySelector('button').innerHTML = 'Click <span style=\"color: #00cc00;\">Here</span>';\n    });\n\n    // Initial state reset for interactive widget\n    function resetWidget() {\n        resultParts.forEach(part => part.classList.remove('matched'));\n        simulatedPage.classList.remove('kept', 'redirected', 'edited');\n        responseMessage.textContent = \"Make your choices above.\";\n        // Ensure original AI result is shown\n        simulatedPage.querySelector('header').style.backgroundColor = '#6a5acd';\n        simulatedPage.querySelector('h1').innerHTML = 'My Cool <span style=\"color: #cc0000;\">Venture</span>';\n        simulatedPage.querySelector('button').style.backgroundColor = '#ffeb3b';\n        simulatedPage.querySelector('button').innerHTML = 'Click <span style=\"color: #00cc00;\">Here</span>';\n    }\n\n    // You might want to call resetWidget() on page load or after a decision to allow re-testing\n    resetWidget();\n});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
