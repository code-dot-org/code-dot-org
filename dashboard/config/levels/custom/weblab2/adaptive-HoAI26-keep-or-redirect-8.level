<Weblab2>
  <config><![CDATA[{
  "published": true,
  "game_id": 74,
  "created_at": "2026-10-16T21:26:09.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": "true",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "style.css",
          "contents": "@font-face {\n  font-family: \"Geist\";\n  src: url(\"Geist-VariableFont_wght.ttf\") format(\"truetype\");\n  font-weight: 100 900;\n  font-style: normal;\n  font-display: swap;\n}\n\n:root {\n  /* CADS semantic tokens, runtime 0.1.0 */\n  --background-neutral-primary: #ffffff;\n  --background-neutral-secondary: #f1f2f4;\n  --background-neutral-tertiary: #e1e3e6;\n  --background-brand-light: #e4e2f8;\n  --background-success-light: #d8ffdc;\n  --background-success-mid: #7cdb87;\n  --background-success-strong: #17541e;\n  --background-selected-primary: #2b1e9f;\n  --background-warning-light: #fff5da;\n  --background-error-light: #ffdada;\n  --border-neutral-primary: #d3d6da;\n  --border-neutral-secondary: #9ea5ad;\n  --border-neutral-solid: #121212;\n  --border-brand-mid: #928cef;\n  --border-focused-primary: #4c42cf;\n  --border-selected-primary: #2b1e9f;\n  --text-neutral-primary: #121212;\n  --text-neutral-secondary: #363b40;\n  --text-neutral-quaternary: #596069;\n  --text-brand-secondary: #1d1590;\n  --text-selected-primary: #d8ffdc;\n  --font-family-main: \"Geist\", \"Noto Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n  --font-size-body-xs: 0.75rem;\n  --font-size-body-sm: 0.875rem;\n  --font-size-body-md: 1rem;\n  --font-weight-medium: 500;\n  --font-weight-semi-bold: 600;\n  --shape-sm: 0.375rem;\n  --shape-md: 0.5rem;\n  --shape-round: 62.4375rem;\n  --shadow-md: 0 10px 15px -3px rgb(0 0 0 / 10%), 0 4px 6px -4px rgb(0 0 0 / 10%);\n  --spacing-p-xxs: 0.5rem;\n  --spacing-p-xs: 1rem;\n  --control-height-small: 2rem;\n  --control-height-extra-small: 1.5rem;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  padding: var(--spacing-p-xxs);\n  background: var(--background-neutral-secondary);\n  color: var(--text-neutral-primary);\n  font-family: var(--font-family-main);\n  font-size: var(--font-size-body-sm);\n  line-height: 1.4;\n}\n\n:focus-visible {\n  outline: 2px solid var(--border-focused-primary);\n  outline-offset: 2px;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.widget {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  gap: var(--spacing-p-xxs);\n  align-items: start;\n}\n\n@media (min-width: 721px) {\n  .widget {\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);\n  }\n}\n\n.load-error {\n  grid-column: 1 / -1;\n  margin: 0;\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-error-light);\n  color: var(--text-neutral-secondary);\n}\n\n/* Panel: white bordered card with a centered overline header */\n.panel {\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n  overflow: hidden;\n}\n\n.overline {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 2.5rem;\n  margin: 0;\n  border-bottom: 1px solid var(--border-neutral-primary);\n  color: var(--text-neutral-quaternary);\n  font-size: var(--font-size-body-xs);\n  font-weight: var(--font-weight-semi-bold);\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.panel-body {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-p-xs);\n  padding: var(--spacing-p-xs);\n}\n\n/* Field wrapper */\n.field {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n  margin: 0;\n}\n\n.field-label {\n  color: var(--text-neutral-secondary);\n  font-size: var(--font-size-body-sm);\n  font-weight: var(--font-weight-medium);\n}\n\n.helper {\n  margin: 0;\n  color: var(--text-neutral-quaternary);\n  font-size: var(--font-size-body-xs);\n}\n\n.control {\n  width: 100%;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font-family: inherit;\n  font-size: var(--font-size-body-sm);\n}\n\n.select,\n.input {\n  min-height: var(--control-height-small);\n  padding: 0 0.75rem;\n}\n\n.textarea {\n  padding: 0.5rem 0.75rem;\n  resize: vertical;\n}\n\n.control::placeholder {\n  color: var(--text-neutral-quaternary);\n}\n\n.add-row {\n  display: flex;\n  gap: var(--spacing-p-xxs);\n}\n\n/* Button: outlined, small */\n.button {\n  flex: none;\n  min-height: var(--control-height-small);\n  padding: 0 0.75rem;\n  border: 1px solid var(--border-neutral-solid);\n  border-radius: var(--shape-sm);\n  background: transparent;\n  color: var(--text-neutral-primary);\n  font-family: inherit;\n  font-size: var(--font-size-body-sm);\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n}\n\n.button:hover {\n  background: var(--background-neutral-secondary);\n}\n\n/* Idea cards on the shelf */\n.shelf {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-p-xxs);\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.idea {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.375rem;\n  min-height: 2.25rem;\n  max-width: 100%;\n  padding: 0.375rem 0.75rem;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-secondary);\n  font-family: inherit;\n  font-size: var(--font-size-body-sm);\n  text-align: start;\n  cursor: pointer;\n}\n\n/* Icon tile: filled glyph in a rounded square */\n.type-icon {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 1.25rem;\n  height: 1.25rem;\n  border-radius: 0.25rem;\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n}\n\n.type-icon svg {\n  width: 0.75rem;\n  height: 0.75rem;\n}\n\n.idea:hover {\n  background: var(--background-neutral-secondary);\n}\n\n/* Selected chrome uses the CADS selected token set */\n.idea[aria-pressed=\"true\"] {\n  border-color: var(--border-selected-primary);\n  background: var(--background-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n.idea.is-dragging {\n  opacity: 0.4;\n}\n\n.idea-ghost {\n  position: fixed;\n  top: 0;\n  left: 0;\n  z-index: 10;\n  max-width: 14rem;\n  box-shadow: var(--shadow-md);\n  pointer-events: none;\n}\n\n.empty-note {\n  margin: 0;\n  color: var(--text-neutral-quaternary);\n}\n\n/* Tag */\n.tag {\n  flex: none;\n  padding: 0.0625rem 0.375rem;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-tertiary);\n  color: var(--text-neutral-primary);\n  font-size: var(--font-size-body-xs);\n  font-weight: var(--font-weight-medium);\n}\n\n/* Board: gray wells holding white sub-cards */\n.zones {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  gap: var(--spacing-p-xxs);\n}\n\n@media (min-width: 900px), (min-width: 481px) and (max-width: 720px) {\n  .zones {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n.zone {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-p-xxs);\n  padding: 0.75rem;\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-secondary);\n}\n\n.zone.is-over {\n  outline: 2px dashed var(--border-brand-mid);\n  background: var(--background-brand-light);\n}\n\n.zone-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--spacing-p-xxs);\n}\n\n.zone-heading {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  min-width: 0;\n}\n\n/* Icon tile: filled glyph in a rounded square */\n.zone-icon {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--control-height-extra-small);\n  height: var(--control-height-extra-small);\n  border-radius: var(--shape-sm);\n}\n\n.zone-icon svg {\n  width: 0.875rem;\n  height: 0.875rem;\n}\n\n.zone-icon-next {\n  background: var(--background-success-light);\n  color: var(--background-success-strong);\n}\n\n.zone-icon-later {\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n}\n\n.zone-title {\n  margin: 0;\n  font-size: var(--font-size-body-md);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.zone-note {\n  color: var(--text-neutral-quaternary);\n  font-size: var(--font-size-body-xs);\n}\n\n.pinned {\n  display: flex;\n  flex-direction: column;\n  gap: 0.375rem;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.pinned-card {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.5rem;\n  padding: 0.5rem 0.375rem 0.5rem 0.75rem;\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-secondary);\n}\n\n.pinned-card-next {\n  border-inline-start: 3px solid var(--background-success-mid);\n}\n\n.pinned-card-later {\n  border-inline-start: 3px solid var(--border-brand-mid);\n}\n\n.pinned-card-next .pin-icon {\n  color: var(--background-success-strong);\n}\n\n.pinned-card-later .pin-icon {\n  color: var(--text-brand-secondary);\n}\n\n.pin-icon {\n  flex: none;\n  width: 1rem;\n  height: 1rem;\n  margin-block-start: 0.125rem;\n  color: var(--text-neutral-quaternary);\n}\n\n.pinned-body {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 0.25rem;\n}\n\n.pinned-text {\n  overflow-wrap: break-word;\n}\n\n.remove-button {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--control-height-extra-small);\n  height: var(--control-height-extra-small);\n  padding: 0;\n  border: 0;\n  border-radius: var(--shape-sm);\n  background: transparent;\n  color: var(--text-neutral-quaternary);\n  cursor: pointer;\n}\n\n.remove-button:hover {\n  background: var(--background-neutral-tertiary);\n  color: var(--text-neutral-primary);\n}\n\n.remove-button svg {\n  width: 0.875rem;\n  height: 0.875rem;\n}\n\n/* Empty state: invitational dashed ghost action */\n.drop-button {\n  min-height: 2.5rem;\n  padding: 0.5rem 0.75rem;\n  border: 1.5px dashed var(--border-neutral-secondary);\n  border-radius: var(--shape-sm);\n  background: transparent;\n  color: var(--text-neutral-quaternary);\n  font-family: inherit;\n  font-size: var(--font-size-body-sm);\n}\n\n.drop-button:enabled {\n  border-color: var(--border-brand-mid);\n  background: var(--background-brand-light);\n  color: var(--text-neutral-primary);\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n}\n\n/* Alert: warning banner for the gentle hint */\n.hint {\n  margin: 0;\n}\n\n.hint:not(:empty) {\n  padding: var(--spacing-p-xxs) 0.75rem;\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-sm);\n  background: var(--background-warning-light);\n  color: var(--text-neutral-secondary);\n}\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "const STORAGE_KEY = 'pause-and-plan';\nconst MAX_NEXT = 3;\nconst DRAG_THRESHOLD = 6;\nconst SVG_NS = 'http://www.w3.org/2000/svg';\n\nconst ZONE_NAMES = {\n  next: 'Up next',\n  later: 'Save for later',\n};\n\nconst SIZE_LABELS = {\n  2: 'Bigger',\n};\n\nconst PLAN_PLACEHOLDERS = {\n  interactive: 'keep a score and let visitors play again.',\n  style: 'use calm colors and bigger text.',\n  story: 'open with a headline that says what it is for.',\n  code: 'find the error in the console and fix it.',\n};\n\n// size: 1 is a quick change, 2 is bigger\n// type: part of the page, look, words, what a visitor does, or behind the scenes\nconst IDEAS = {\n  interactive: [\n    { id: 'interactive-more', text: 'More options in your list', size: 1, type: 'part' },\n    { id: 'interactive-add', text: 'Let visitors add their own option', size: 2, type: 'action' },\n    { id: 'interactive-norepeat', text: 'Never pick the same option twice in a row', size: 2, type: 'behind' },\n    { id: 'interactive-score', text: 'A score or counter', size: 1, type: 'part' },\n    { id: 'interactive-end', text: 'A rule that ends the round', size: 2, type: 'behind' },\n    { id: 'interactive-recent', text: 'Show the last three picks', size: 2, type: 'part' },\n    { id: 'interactive-bar', text: 'A progress bar or count', size: 1, type: 'part' },\n    { id: 'interactive-reset', text: 'A play again button', size: 1, type: 'action' },\n  ],\n  style: [\n    { id: 'style-space', text: 'More space between sections', size: 1, type: 'look' },\n    { id: 'style-align', text: 'Line up the cards under the hero', size: 1, type: 'look' },\n    { id: 'style-order', text: 'Put the parts in a clearer order', size: 1, type: 'part' },\n    { id: 'style-palette', text: 'One color palette used everywhere', size: 1, type: 'look' },\n    { id: 'style-same', text: 'Same corners, fonts and buttons everywhere', size: 1, type: 'look' },\n    { id: 'style-text', text: 'Bigger, clearer text', size: 1, type: 'look' },\n    { id: 'style-contrast', text: 'Darker text on a lighter background', size: 1, type: 'look' },\n    { id: 'style-phone', text: 'Make it fit a phone-size screen', size: 2, type: 'look' },\n  ],\n  story: [\n    { id: 'story-headline', text: 'A headline that says what it is for', size: 1, type: 'words' },\n    { id: 'story-sub', text: 'A short line about who it is for', size: 1, type: 'words' },\n    { id: 'story-voice', text: 'A first line that sets the tone', size: 1, type: 'words' },\n    { id: 'story-button', text: 'A button that says exactly what to do', size: 1, type: 'words' },\n    { id: 'story-place', text: 'Put the button where eyes land', size: 1, type: 'part' },\n    { id: 'story-quote', text: 'A short story or quote', size: 1, type: 'words' },\n    { id: 'story-closing', text: 'A closing line people remember', size: 1, type: 'words' },\n    { id: 'story-rewrite', text: 'Rewrite every section in one voice', size: 2, type: 'words' },\n  ],\n  code: [\n    { id: 'code-console', text: 'Open the console and look for errors', size: 1, type: 'behind' },\n    { id: 'code-fixerror', text: 'Fix the first error you find', size: 2, type: 'behind' },\n    { id: 'code-find', text: 'Find the code for one block', size: 1, type: 'behind' },\n    { id: 'code-name', text: 'Give a block a clearer name', size: 1, type: 'behind' },\n    { id: 'code-comment', text: 'Add a comment that explains a block', size: 1, type: 'behind' },\n    { id: 'code-edit', text: 'Change one line of code by hand', size: 2, type: 'behind' },\n    { id: 'code-undo', text: 'Undo your last change, then check', size: 1, type: 'behind' },\n    { id: 'code-message', text: 'A friendly message when something goes wrong', size: 2, type: 'words' },\n  ],\n};\n\nconst TYPE_ICON_SHAPES = {\n  part: [{ d: 'M2 2h5v5H2zM9 2h5v5H9zM2 9h5v5H2zM9 9h5v5H9z' }],\n  look: [{ d: 'M8 1.5c2.2 3 4.5 5.1 4.5 7.6a4.5 4.5 0 0 1-9 0C3.5 6.6 5.8 4.5 8 1.5z' }],\n  words: [{ d: 'M3 2.5h10A1.5 1.5 0 0 1 14.5 4v6a1.5 1.5 0 0 1-1.5 1.5H8.6L5 14.5v-3H3A1.5 1.5 0 0 1 1.5 10V4A1.5 1.5 0 0 1 3 2.5z' }],\n  action: [{ d: 'M3 2l10 5.6-4.3 1.2 2.4 4.5-1.8 1-2.4-4.5L3.6 12.4z' }],\n  behind: [{ d: 'M3 2.5h10A1.5 1.5 0 0 1 14.5 4v8a1.5 1.5 0 0 1-1.5 1.5H3A1.5 1.5 0 0 1 1.5 12V4A1.5 1.5 0 0 1 3 2.5zM4.4 5.4l2.4 2.1-2.4 2.1-.8-.9L5 7.5 3.6 6.3zM7.5 9.6H11v1.1H7.5z', 'fill-rule': 'evenodd' }],\n  own: [{ d: 'M11.3 2.2a1.4 1.4 0 0 1 2 0l.5.5a1.4 1.4 0 0 1 0 2L6 12.5l-3.5 1 1-3.5z' }],\n};\n\nconst ICON_SHAPES = {\n  pin: [\n    ['path', { d: 'M8 10.5v4' }],\n    ['path', { d: 'M5 1.5h6M6 1.5V6L4 8.5v2h8v-2L10 6V1.5' }],\n  ],\n  close: [['path', { d: 'M4 4l8 8M12 4l-8 8' }]],\n};\n\nconst DESTINATION_KEYS = Object.keys(IDEAS);\nconst memoryStore = { value: null };\nconst elements = {};\nlet state;\nlet selectedId = null;\nlet suppressClick = false;\nlet drag = null;\n\nfunction createDefaultState() {\n  const boards = {};\n  for (const key of DESTINATION_KEYS) {\n    boards[key] = { placements: {}, custom: [], plan: '' };\n  }\n  return { destination: DESTINATION_KEYS[0], boards };\n}\n\nfunction normalizeState(raw) {\n  const base = createDefaultState();\n  if (!raw || typeof raw !== 'object') return base;\n  if (DESTINATION_KEYS.includes(raw.destination)) base.destination = raw.destination;\n  for (const key of DESTINATION_KEYS) {\n    const saved = raw.boards?.[key];\n    if (!saved) continue;\n    const custom = Array.isArray(saved.custom)\n      ? saved.custom\n          .filter((item) => item && typeof item.id === 'string' && typeof item.text === 'string')\n          .map((item) => ({ id: item.id, text: item.text.slice(0, 40), size: 1, type: 'own' }))\n      : [];\n    const knownIds = new Set([...IDEAS[key], ...custom].map((idea) => idea.id));\n    const placements = {};\n    for (const [id, zone] of Object.entries(saved.placements ?? {})) {\n      if (knownIds.has(id) && Object.hasOwn(ZONE_NAMES, zone)) placements[id] = zone;\n    }\n    base.boards[key] = {\n      placements,\n      custom,\n      plan: typeof saved.plan === 'string' ? saved.plan.slice(0, 140) : '',\n    };\n  }\n  return base;\n}\n\nfunction readStored() {\n  try {\n    const raw = window.localStorage.getItem(STORAGE_KEY);\n    return raw ? JSON.parse(raw) : null;\n  } catch (error) {\n    return memoryStore.value;\n  }\n}\n\nfunction writeStored(value) {\n  memoryStore.value = value;\n  try {\n    window.localStorage.setItem(STORAGE_KEY, JSON.stringify(value));\n  } catch (error) {\n    // Storage can be blocked in the sandbox, so the board lives in memory.\n  }\n}\n\nfunction currentBoard() {\n  return state.boards[state.destination];\n}\n\nfunction getIdeas() {\n  return [...IDEAS[state.destination], ...currentBoard().custom];\n}\n\nfunction findIdea(id) {\n  return getIdeas().find((idea) => idea.id === id);\n}\n\nfunction createElement(tagName, className, text) {\n  const element = document.createElement(tagName);\n  if (className) element.className = className;\n  if (text) element.textContent = text;\n  return element;\n}\n\nfunction createSvg(className) {\n  const svg = document.createElementNS(SVG_NS, 'svg');\n  svg.setAttribute('viewBox', '0 0 16 16');\n  svg.setAttribute('aria-hidden', 'true');\n  if (className) svg.setAttribute('class', className);\n  return svg;\n}\n\nfunction createIcon(name, className) {\n  const svg = createSvg(className);\n  svg.setAttribute('fill', 'none');\n  svg.setAttribute('stroke', 'currentColor');\n  svg.setAttribute('stroke-width', '1.75');\n  svg.setAttribute('stroke-linecap', 'round');\n  for (const [shapeName, attributes] of ICON_SHAPES[name]) {\n    const shape = document.createElementNS(SVG_NS, shapeName);\n    for (const [key, value] of Object.entries(attributes)) shape.setAttribute(key, String(value));\n    svg.append(shape);\n  }\n  return svg;\n}\n\nfunction createTypeIcon(type) {\n  const tile = createElement('span', 'type-icon');\n  const svg = createSvg();\n  svg.setAttribute('fill', 'currentColor');\n  for (const attributes of TYPE_ICON_SHAPES[type]) {\n    const path = document.createElementNS(SVG_NS, 'path');\n    for (const [key, value] of Object.entries(attributes)) path.setAttribute(key, value);\n    svg.append(path);\n  }\n  tile.append(svg);\n  return tile;\n}\n\nfunction createSizeTag(idea) {\n  if (!SIZE_LABELS[idea.size]) return null;\n  return createElement('span', 'tag', SIZE_LABELS[idea.size]);\n}\n\nfunction createShelfItem(idea) {\n  const item = document.createElement('li');\n  const button = createElement('button', 'idea');\n  button.type = 'button';\n  button.dataset.id = idea.id;\n  button.setAttribute('aria-pressed', String(idea.id === selectedId));\n  button.append(createTypeIcon(idea.type));\n  button.append(createElement('span', 'idea-text', idea.text));\n  const tag = createSizeTag(idea);\n  if (tag) button.append(tag);\n  item.append(button);\n  return item;\n}\n\nfunction createPinnedCard(idea, zone) {\n  const item = createElement('li', `pinned-card pinned-card-${zone}`);\n  const body = createElement('div', 'pinned-body');\n  body.append(createElement('span', 'pinned-text', idea.text));\n  const tag = createSizeTag(idea);\n  if (tag) body.append(tag);\n  item.append(createIcon('pin', 'pin-icon'));\n  item.append(body);\n  const remove = createElement('button', 'remove-button');\n  remove.type = 'button';\n  remove.dataset.remove = idea.id;\n  remove.setAttribute('aria-label', `Remove ${idea.text} from ${ZONE_NAMES[zone]}`);\n  remove.append(createIcon('close'));\n  item.append(remove);\n  return item;\n}\n\nfunction renderShelf() {\n  const board = currentBoard();\n  const shelfIdeas = getIdeas().filter((idea) => !board.placements[idea.id]);\n  elements.shelf.replaceChildren(...shelfIdeas.map(createShelfItem));\n  elements.shelfEmpty.hidden = shelfIdeas.length > 0;\n}\n\nfunction renderZones() {\n  const board = currentBoard();\n  const ideas = getIdeas();\n  const selected = findIdea(selectedId);\n  for (const zone of Object.keys(ZONE_NAMES)) {\n    const placed = ideas.filter((idea) => board.placements[idea.id] === zone);\n    elements.lists[zone].replaceChildren(...placed.map((idea) => createPinnedCard(idea, zone)));\n    const button = elements.placeButtons[zone];\n    button.disabled = !selected;\n    button.textContent = selected ? `Place ${selected.text} here` : 'Choose or drag an idea';\n  }\n}\n\nfunction getHint() {\n  const board = currentBoard();\n  const nextIdeas = getIdeas().filter((idea) => board.placements[idea.id] === 'next');\n  if (nextIdeas.length > MAX_NEXT) return 'That is a lot to build next. Which ones can wait?';\n  const biggerIdeas = nextIdeas.filter((idea) => idea.size > 1);\n  if (biggerIdeas.length > 1) return 'More than one bigger idea can take a while. Which one can wait?';\n  return '';\n}\n\nfunction renderBoard() {\n  renderShelf();\n  renderZones();\n  elements.hint.textContent = getHint();\n}\n\nfunction syncFields() {\n  elements.destination.value = state.destination;\n  elements.planText.value = currentBoard().plan;\n  elements.planText.placeholder = PLAN_PLACEHOLDERS[state.destination];\n}\n\nfunction save() {\n  writeStored(state);\n}\n\nfunction announce(message) {\n  elements.status.textContent = '';\n  window.setTimeout(() => {\n    elements.status.textContent = message;\n  }, 50);\n}\n\nfunction findShelfButton(id) {\n  return elements.shelf.querySelector(`[data-id=\"${CSS.escape(id)}\"]`);\n}\n\nfunction focusNextIdea() {\n  const first = elements.shelf.querySelector('.idea');\n  (first || elements.customIdea).focus();\n}\n\nfunction toggleSelection(id) {\n  selectedId = selectedId === id ? null : id;\n  renderBoard();\n  const button = findShelfButton(id);\n  if (button) button.focus();\n}\n\nfunction placeIdea(id, zone) {\n  const idea = findIdea(id);\n  if (!idea) return;\n  currentBoard().placements[id] = zone;\n  selectedId = null;\n  save();\n  renderBoard();\n  announce(`Added ${idea.text} to ${ZONE_NAMES[zone]}.`);\n}\n\nfunction removeIdea(id) {\n  const idea = findIdea(id);\n  if (!idea) return;\n  delete currentBoard().placements[id];\n  save();\n  renderBoard();\n  announce(`${idea.text} is back in your ideas.`);\n  const button = findShelfButton(id);\n  if (button) button.focus();\n}\n\nfunction addCustomIdea(event) {\n  event.preventDefault();\n  const text = elements.customIdea.value.trim();\n  if (!text) {\n    elements.hint.textContent = 'Type an idea first.';\n    elements.customIdea.focus();\n    return;\n  }\n  const board = currentBoard();\n  board.custom.push({ id: `custom-${Date.now()}-${board.custom.length}`, text, size: 1, type: 'own' });\n  elements.customIdea.value = '';\n  save();\n  renderBoard();\n  announce(`Added ${text} to your ideas.`);\n}\n\nfunction changeDestination() {\n  state.destination = elements.destination.value;\n  selectedId = null;\n  save();\n  syncFields();\n  renderBoard();\n  announce(`Showing ideas for ${elements.destination.selectedOptions[0].textContent}.`);\n}\n\nfunction zoneAt(x, y) {\n  const target = document.elementFromPoint(x, y);\n  const zone = target ? target.closest('[data-zone]') : null;\n  return zone ? zone.dataset.zone : null;\n}\n\nfunction highlightZone(name) {\n  for (const zone of elements.zones) {\n    zone.classList.toggle('is-over', zone.dataset.zone === name);\n  }\n}\n\nfunction endDrag() {\n  if (!drag) return;\n  document.removeEventListener('pointermove', onPointerMove);\n  document.removeEventListener('pointerup', onPointerUp);\n  document.removeEventListener('pointercancel', endDrag);\n  if (drag.ghost) drag.ghost.remove();\n  drag.button.classList.remove('is-dragging');\n  highlightZone(null);\n  drag = null;\n}\n\nfunction onPointerMove(event) {\n  if (!drag) return;\n  if (!drag.ghost) {\n    const moved = Math.hypot(event.clientX - drag.startX, event.clientY - drag.startY);\n    if (moved < DRAG_THRESHOLD) return;\n    drag.ghost = drag.button.cloneNode(true);\n    drag.ghost.removeAttribute('data-id');\n    drag.ghost.setAttribute('aria-hidden', 'true');\n    drag.ghost.tabIndex = -1;\n    drag.ghost.classList.add('idea-ghost');\n    document.body.append(drag.ghost);\n    drag.button.classList.add('is-dragging');\n  }\n  drag.ghost.style.transform = `translate(${event.clientX + 8}px, ${event.clientY + 8}px)`;\n  highlightZone(zoneAt(event.clientX, event.clientY));\n}\n\nfunction onPointerUp(event) {\n  if (!drag) return;\n  const dragged = Boolean(drag.ghost);\n  const zone = dragged ? zoneAt(event.clientX, event.clientY) : null;\n  const { id } = drag;\n  endDrag();\n  if (!dragged) return;\n  suppressClick = true;\n  window.setTimeout(() => {\n    suppressClick = false;\n  }, 0);\n  if (zone) placeIdea(id, zone);\n}\n\nfunction onShelfPointerDown(event) {\n  if (event.pointerType === 'touch' || event.button !== 0) return;\n  const button = event.target.closest('.idea');\n  if (!button) return;\n  drag = { id: button.dataset.id, button, startX: event.clientX, startY: event.clientY, ghost: null };\n  document.addEventListener('pointermove', onPointerMove);\n  document.addEventListener('pointerup', onPointerUp);\n  document.addEventListener('pointercancel', endDrag);\n}\n\nfunction onShelfClick(event) {\n  const button = event.target.closest('.idea');\n  if (!button || suppressClick) return;\n  toggleSelection(button.dataset.id);\n}\n\nfunction onZonesClick(event) {\n  const placeButton = event.target.closest('[data-place]');\n  if (placeButton && selectedId) {\n    placeIdea(selectedId, placeButton.dataset.place);\n    focusNextIdea();\n    return;\n  }\n  const removeButton = event.target.closest('[data-remove]');\n  if (removeButton) removeIdea(removeButton.dataset.remove);\n}\n\nfunction onPlanInput() {\n  currentBoard().plan = elements.planText.value;\n  save();\n}\n\nfunction onKeydown(event) {\n  if (event.key !== 'Escape' || !selectedId) return;\n  selectedId = null;\n  renderBoard();\n}\n\nfunction init() {\n  elements.destination = document.getElementById('destination');\n  elements.shelf = document.getElementById('shelf');\n  elements.shelfEmpty = document.getElementById('shelf-empty');\n  elements.addForm = document.getElementById('add-form');\n  elements.customIdea = document.getElementById('custom-idea');\n  elements.planText = document.getElementById('plan-text');\n  elements.hint = document.getElementById('hint');\n  elements.status = document.getElementById('status');\n  elements.zones = document.querySelectorAll('[data-zone]');\n  elements.lists = {\n    next: document.querySelector('[data-list=\"next\"]'),\n    later: document.querySelector('[data-list=\"later\"]'),\n  };\n  elements.placeButtons = {\n    next: document.querySelector('[data-place=\"next\"]'),\n    later: document.querySelector('[data-place=\"later\"]'),\n  };\n\n  state = normalizeState(readStored());\n  syncFields();\n  renderBoard();\n\n  elements.destination.addEventListener('change', changeDestination);\n  elements.shelf.addEventListener('pointerdown', onShelfPointerDown);\n  elements.shelf.addEventListener('click', onShelfClick);\n  document.querySelector('.zones').addEventListener('click', onZonesClick);\n  elements.addForm.addEventListener('submit', addCustomIdea);\n  elements.planText.addEventListener('input', onPlanInput);\n  document.addEventListener('keydown', onKeydown);\n}\n\ntry {\n  init();\n} catch (error) {\n  const loadError = document.getElementById('load-error');\n  if (loadError) loadError.hidden = false;\n}\n",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Pause and plan</title>\n  <style>\n@font-face {\n  font-family: \"Geist\";\n  src: url(\"data:font/ttf;base64,\") format(\"truetype\");\n  font-weight: 100 900;\n  font-style: normal;\n  font-display: swap;\n}\n\n:root {\n  /* CADS semantic tokens, runtime 0.1.0 */\n  --background-neutral-primary: #ffffff;\n  --background-neutral-secondary: #f1f2f4;\n  --background-neutral-tertiary: #e1e3e6;\n  --background-brand-light: #e4e2f8;\n  --background-success-light: #d8ffdc;\n  --background-success-mid: #7cdb87;\n  --background-success-strong: #17541e;\n  --background-selected-primary: #2b1e9f;\n  --background-warning-light: #fff5da;\n  --background-error-light: #ffdada;\n  --border-neutral-primary: #d3d6da;\n  --border-neutral-secondary: #9ea5ad;\n  --border-neutral-solid: #121212;\n  --border-brand-mid: #928cef;\n  --border-focused-primary: #4c42cf;\n  --border-selected-primary: #2b1e9f;\n  --text-neutral-primary: #121212;\n  --text-neutral-secondary: #363b40;\n  --text-neutral-quaternary: #596069;\n  --text-brand-secondary: #1d1590;\n  --text-selected-primary: #d8ffdc;\n  --font-family-main: \"Geist\", \"Noto Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n  --font-size-body-xs: 0.75rem;\n  --font-size-body-sm: 0.875rem;\n  --font-size-body-md: 1rem;\n  --font-weight-medium: 500;\n  --font-weight-semi-bold: 600;\n  --shape-sm: 0.375rem;\n  --shape-md: 0.5rem;\n  --shape-round: 62.4375rem;\n  --shadow-md: 0 10px 15px -3px rgb(0 0 0 / 10%), 0 4px 6px -4px rgb(0 0 0 / 10%);\n  --spacing-p-xxs: 0.5rem;\n  --spacing-p-xs: 1rem;\n  --control-height-small: 2rem;\n  --control-height-extra-small: 1.5rem;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  padding: var(--spacing-p-xxs);\n  background: var(--background-neutral-secondary);\n  color: var(--text-neutral-primary);\n  font-family: var(--font-family-main);\n  font-size: var(--font-size-body-sm);\n  line-height: 1.4;\n}\n\n:focus-visible {\n  outline: 2px solid var(--border-focused-primary);\n  outline-offset: 2px;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.widget {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  gap: var(--spacing-p-xxs);\n  align-items: start;\n}\n\n@media (min-width: 721px) {\n  .widget {\n    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);\n  }\n}\n\n.load-error {\n  grid-column: 1 / -1;\n  margin: 0;\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-error-light);\n  color: var(--text-neutral-secondary);\n}\n\n/* Panel: white bordered card with a centered overline header */\n.panel {\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n  overflow: hidden;\n}\n\n.overline {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 2.5rem;\n  margin: 0;\n  border-bottom: 1px solid var(--border-neutral-primary);\n  color: var(--text-neutral-quaternary);\n  font-size: var(--font-size-body-xs);\n  font-weight: var(--font-weight-semi-bold);\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.panel-body {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-p-xs);\n  padding: var(--spacing-p-xs);\n}\n\n/* Field wrapper */\n.field {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n  margin: 0;\n}\n\n.field-label {\n  color: var(--text-neutral-secondary);\n  font-size: var(--font-size-body-sm);\n  font-weight: var(--font-weight-medium);\n}\n\n.helper {\n  margin: 0;\n  color: var(--text-neutral-quaternary);\n  font-size: var(--font-size-body-xs);\n}\n\n.control {\n  width: 100%;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font-family: inherit;\n  font-size: var(--font-size-body-sm);\n}\n\n.select,\n.input {\n  min-height: var(--control-height-small);\n  padding: 0 0.75rem;\n}\n\n.textarea {\n  padding: 0.5rem 0.75rem;\n  resize: vertical;\n}\n\n.control::placeholder {\n  color: var(--text-neutral-quaternary);\n}\n\n.add-row {\n  display: flex;\n  gap: var(--spacing-p-xxs);\n}\n\n/* Button: outlined, small */\n.button {\n  flex: none;\n  min-height: var(--control-height-small);\n  padding: 0 0.75rem;\n  border: 1px solid var(--border-neutral-solid);\n  border-radius: var(--shape-sm);\n  background: transparent;\n  color: var(--text-neutral-primary);\n  font-family: inherit;\n  font-size: var(--font-size-body-sm);\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n}\n\n.button:hover {\n  background: var(--background-neutral-secondary);\n}\n\n/* Idea cards on the shelf */\n.shelf {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-p-xxs);\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.idea {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.375rem;\n  min-height: 2.25rem;\n  max-width: 100%;\n  padding: 0.375rem 0.75rem;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-secondary);\n  font-family: inherit;\n  font-size: var(--font-size-body-sm);\n  text-align: start;\n  cursor: pointer;\n}\n\n/* Icon tile: filled glyph in a rounded square */\n.type-icon {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 1.25rem;\n  height: 1.25rem;\n  border-radius: 0.25rem;\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n}\n\n.type-icon svg {\n  width: 0.75rem;\n  height: 0.75rem;\n}\n\n.idea:hover {\n  background: var(--background-neutral-secondary);\n}\n\n/* Selected chrome uses the CADS selected token set */\n.idea[aria-pressed=\"true\"] {\n  border-color: var(--border-selected-primary);\n  background: var(--background-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n.idea.is-dragging {\n  opacity: 0.4;\n}\n\n.idea-ghost {\n  position: fixed;\n  top: 0;\n  left: 0;\n  z-index: 10;\n  max-width: 14rem;\n  box-shadow: var(--shadow-md);\n  pointer-events: none;\n}\n\n.empty-note {\n  margin: 0;\n  color: var(--text-neutral-quaternary);\n}\n\n/* Tag */\n.tag {\n  flex: none;\n  padding: 0.0625rem 0.375rem;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-tertiary);\n  color: var(--text-neutral-primary);\n  font-size: var(--font-size-body-xs);\n  font-weight: var(--font-weight-medium);\n}\n\n/* Board: gray wells holding white sub-cards */\n.zones {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  gap: var(--spacing-p-xxs);\n}\n\n@media (min-width: 900px), (min-width: 481px) and (max-width: 720px) {\n  .zones {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n.zone {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-p-xxs);\n  padding: 0.75rem;\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-secondary);\n}\n\n.zone.is-over {\n  outline: 2px dashed var(--border-brand-mid);\n  background: var(--background-brand-light);\n}\n\n.zone-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--spacing-p-xxs);\n}\n\n.zone-heading {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  min-width: 0;\n}\n\n/* Icon tile: filled glyph in a rounded square */\n.zone-icon {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--control-height-extra-small);\n  height: var(--control-height-extra-small);\n  border-radius: var(--shape-sm);\n}\n\n.zone-icon svg {\n  width: 0.875rem;\n  height: 0.875rem;\n}\n\n.zone-icon-next {\n  background: var(--background-success-light);\n  color: var(--background-success-strong);\n}\n\n.zone-icon-later {\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n}\n\n.zone-title {\n  margin: 0;\n  font-size: var(--font-size-body-md);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.zone-note {\n  color: var(--text-neutral-quaternary);\n  font-size: var(--font-size-body-xs);\n}\n\n.pinned {\n  display: flex;\n  flex-direction: column;\n  gap: 0.375rem;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.pinned-card {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.5rem;\n  padding: 0.5rem 0.375rem 0.5rem 0.75rem;\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-secondary);\n}\n\n.pinned-card-next {\n  border-inline-start: 3px solid var(--background-success-mid);\n}\n\n.pinned-card-later {\n  border-inline-start: 3px solid var(--border-brand-mid);\n}\n\n.pinned-card-next .pin-icon {\n  color: var(--background-success-strong);\n}\n\n.pinned-card-later .pin-icon {\n  color: var(--text-brand-secondary);\n}\n\n.pin-icon {\n  flex: none;\n  width: 1rem;\n  height: 1rem;\n  margin-block-start: 0.125rem;\n  color: var(--text-neutral-quaternary);\n}\n\n.pinned-body {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 0.25rem;\n}\n\n.pinned-text {\n  overflow-wrap: break-word;\n}\n\n.remove-button {\n  flex: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: var(--control-height-extra-small);\n  height: var(--control-height-extra-small);\n  padding: 0;\n  border: 0;\n  border-radius: var(--shape-sm);\n  background: transparent;\n  color: var(--text-neutral-quaternary);\n  cursor: pointer;\n}\n\n.remove-button:hover {\n  background: var(--background-neutral-tertiary);\n  color: var(--text-neutral-primary);\n}\n\n.remove-button svg {\n  width: 0.875rem;\n  height: 0.875rem;\n}\n\n/* Empty state: invitational dashed ghost action */\n.drop-button {\n  min-height: 2.5rem;\n  padding: 0.5rem 0.75rem;\n  border: 1.5px dashed var(--border-neutral-secondary);\n  border-radius: var(--shape-sm);\n  background: transparent;\n  color: var(--text-neutral-quaternary);\n  font-family: inherit;\n  font-size: var(--font-size-body-sm);\n}\n\n.drop-button:enabled {\n  border-color: var(--border-brand-mid);\n  background: var(--background-brand-light);\n  color: var(--text-neutral-primary);\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n}\n\n/* Alert: warning banner for the gentle hint */\n.hint {\n  margin: 0;\n}\n\n.hint:not(:empty) {\n  padding: var(--spacing-p-xxs) 0.75rem;\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-sm);\n  background: var(--background-warning-light);\n  color: var(--text-neutral-secondary);\n}\n\n  </style>\n</head>\n<body>\n  <main class=\"widget\">\n    <h1 class=\"visually-hidden\">Pause and plan</h1>\n    <p id=\"load-error\" class=\"load-error\" role=\"alert\" hidden>Something went wrong loading this activity. Please reload the page.</p>\n\n    <section class=\"panel\" aria-labelledby=\"ideas-title\">\n      <h2 id=\"ideas-title\" class=\"overline\">Your ideas</h2>\n      <div class=\"panel-body\">\n        <div class=\"field\">\n          <label class=\"field-label\" for=\"destination\">Preview destination</label>\n          <select id=\"destination\" class=\"control select\">\n            <option value=\"interactive\">Interactive elements</option>\n            <option value=\"style\">Style and design</option>\n            <option value=\"story\">Story and message</option>\n            <option value=\"code\">Under the hood</option>\n          </select>\n        </div>\n\n        <ul id=\"shelf\" class=\"shelf\" aria-label=\"Ideas to place\"></ul>\n        <p id=\"shelf-empty\" class=\"empty-note\" hidden>All of your ideas are on the board.</p>\n\n        <form id=\"add-form\" class=\"field\" novalidate>\n          <label class=\"field-label\" for=\"custom-idea\">Add your own idea</label>\n          <div class=\"add-row\">\n            <input id=\"custom-idea\" class=\"control input\" type=\"text\" maxlength=\"40\" autocomplete=\"off\" placeholder=\"A short idea\">\n            <button type=\"submit\" class=\"button\">Add</button>\n          </div>\n        </form>\n      </div>\n    </section>\n\n    <section class=\"panel\" aria-labelledby=\"board-title\">\n      <h2 id=\"board-title\" class=\"overline\">Your plan</h2>\n      <div class=\"panel-body\">\n        <div class=\"zones\">\n          <section class=\"zone\" data-zone=\"next\" aria-labelledby=\"next-title\">\n            <header class=\"zone-header\">\n              <div class=\"zone-heading\">\n                <span class=\"zone-icon zone-icon-next\" aria-hidden=\"true\">\n                  <svg viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M2.5 7h7.2L7.4 4.7l1.3-1.3L13.5 8.2l-4.8 4.8-1.3-1.3L9.7 9.4H2.5z\"/></svg>\n                </span>\n                <h3 id=\"next-title\" class=\"zone-title\">Up next</h3>\n              </div>\n              <span class=\"zone-note\">Up to 3</span>\n            </header>\n            <ul class=\"pinned\" data-list=\"next\" aria-label=\"Up next\"></ul>\n            <button type=\"button\" class=\"drop-button\" data-place=\"next\" disabled>Choose or drag an idea</button>\n          </section>\n\n          <section class=\"zone\" data-zone=\"later\" aria-labelledby=\"later-title\">\n            <header class=\"zone-header\">\n              <div class=\"zone-heading\">\n                <span class=\"zone-icon zone-icon-later\" aria-hidden=\"true\">\n                  <svg viewBox=\"0 0 16 16\" fill=\"currentColor\"><path d=\"M4.2 2.5h7.6c.4 0 .7.3.7.7v10.1c0 .5-.6.8-1 .4L8 10.5l-3.5 3.2c-.4.4-1 .1-1-.4V3.2c0-.4.3-.7.7-.7z\"/></svg>\n                </span>\n                <h3 id=\"later-title\" class=\"zone-title\">Save for later</h3>\n              </div>\n            </header>\n            <ul class=\"pinned\" data-list=\"later\" aria-label=\"Save for later\"></ul>\n            <button type=\"button\" class=\"drop-button\" data-place=\"later\" disabled>Choose or drag an idea</button>\n          </section>\n        </div>\n\n        <p id=\"hint\" class=\"hint\" aria-live=\"polite\"></p>\n\n        <div class=\"field\">\n          <label class=\"field-label\" for=\"plan-text\">Next, I want my site to...</label>\n          <textarea id=\"plan-text\" class=\"control textarea\" rows=\"3\" maxlength=\"140\" aria-describedby=\"plan-help\"></textarea>\n          <p id=\"plan-help\" class=\"helper\">Think about who it is for, how it should feel, which parts it needs, and what a visitor does.</p>\n        </div>\n      </div>\n    </section>\n\n    <p id=\"status\" class=\"visually-hidden\" role=\"status\"></p>\n  </main>\n  <script>\nconst STORAGE_KEY = 'pause-and-plan';\nconst MAX_NEXT = 3;\nconst DRAG_THRESHOLD = 6;\nconst SVG_NS = 'http://www.w3.org/2000/svg';\n\nconst ZONE_NAMES = {\n  next: 'Up next',\n  later: 'Save for later',\n};\n\nconst SIZE_LABELS = {\n  2: 'Bigger',\n};\n\nconst PLAN_PLACEHOLDERS = {\n  interactive: 'keep a score and let visitors play again.',\n  style: 'use calm colors and bigger text.',\n  story: 'open with a headline that says what it is for.',\n  code: 'find the error in the console and fix it.',\n};\n\n// size: 1 is a quick change, 2 is bigger\n// type: part of the page, look, words, what a visitor does, or behind the scenes\nconst IDEAS = {\n  interactive: [\n    { id: 'interactive-more', text: 'More options in your list', size: 1, type: 'part' },\n    { id: 'interactive-add', text: 'Let visitors add their own option', size: 2, type: 'action' },\n    { id: 'interactive-norepeat', text: 'Never pick the same option twice in a row', size: 2, type: 'behind' },\n    { id: 'interactive-score', text: 'A score or counter', size: 1, type: 'part' },\n    { id: 'interactive-end', text: 'A rule that ends the round', size: 2, type: 'behind' },\n    { id: 'interactive-recent', text: 'Show the last three picks', size: 2, type: 'part' },\n    { id: 'interactive-bar', text: 'A progress bar or count', size: 1, type: 'part' },\n    { id: 'interactive-reset', text: 'A play again button', size: 1, type: 'action' },\n  ],\n  style: [\n    { id: 'style-space', text: 'More space between sections', size: 1, type: 'look' },\n    { id: 'style-align', text: 'Line up the cards under the hero', size: 1, type: 'look' },\n    { id: 'style-order', text: 'Put the parts in a clearer order', size: 1, type: 'part' },\n    { id: 'style-palette', text: 'One color palette used everywhere', size: 1, type: 'look' },\n    { id: 'style-same', text: 'Same corners, fonts and buttons everywhere', size: 1, type: 'look' },\n    { id: 'style-text', text: 'Bigger, clearer text', size: 1, type: 'look' },\n    { id: 'style-contrast', text: 'Darker text on a lighter background', size: 1, type: 'look' },\n    { id: 'style-phone', text: 'Make it fit a phone-size screen', size: 2, type: 'look' },\n  ],\n  story: [\n    { id: 'story-headline', text: 'A headline that says what it is for', size: 1, type: 'words' },\n    { id: 'story-sub', text: 'A short line about who it is for', size: 1, type: 'words' },\n    { id: 'story-voice', text: 'A first line that sets the tone', size: 1, type: 'words' },\n    { id: 'story-button', text: 'A button that says exactly what to do', size: 1, type: 'words' },\n    { id: 'story-place', text: 'Put the button where eyes land', size: 1, type: 'part' },\n    { id: 'story-quote', text: 'A short story or quote', size: 1, type: 'words' },\n    { id: 'story-closing', text: 'A closing line people remember', size: 1, type: 'words' },\n    { id: 'story-rewrite', text: 'Rewrite every section in one voice', size: 2, type: 'words' },\n  ],\n  code: [\n    { id: 'code-console', text: 'Open the console and look for errors', size: 1, type: 'behind' },\n    { id: 'code-fixerror', text: 'Fix the first error you find', size: 2, type: 'behind' },\n    { id: 'code-find', text: 'Find the code for one block', size: 1, type: 'behind' },\n    { id: 'code-name', text: 'Give a block a clearer name', size: 1, type: 'behind' },\n    { id: 'code-comment', text: 'Add a comment that explains a block', size: 1, type: 'behind' },\n    { id: 'code-edit', text: 'Change one line of code by hand', size: 2, type: 'behind' },\n    { id: 'code-undo', text: 'Undo your last change, then check', size: 1, type: 'behind' },\n    { id: 'code-message', text: 'A friendly message when something goes wrong', size: 2, type: 'words' },\n  ],\n};\n\nconst TYPE_ICON_SHAPES = {\n  part: [{ d: 'M2 2h5v5H2zM9 2h5v5H9zM2 9h5v5H2zM9 9h5v5H9z' }],\n  look: [{ d: 'M8 1.5c2.2 3 4.5 5.1 4.5 7.6a4.5 4.5 0 0 1-9 0C3.5 6.6 5.8 4.5 8 1.5z' }],\n  words: [{ d: 'M3 2.5h10A1.5 1.5 0 0 1 14.5 4v6a1.5 1.5 0 0 1-1.5 1.5H8.6L5 14.5v-3H3A1.5 1.5 0 0 1 1.5 10V4A1.5 1.5 0 0 1 3 2.5z' }],\n  action: [{ d: 'M3 2l10 5.6-4.3 1.2 2.4 4.5-1.8 1-2.4-4.5L3.6 12.4z' }],\n  behind: [{ d: 'M3 2.5h10A1.5 1.5 0 0 1 14.5 4v8a1.5 1.5 0 0 1-1.5 1.5H3A1.5 1.5 0 0 1 1.5 12V4A1.5 1.5 0 0 1 3 2.5zM4.4 5.4l2.4 2.1-2.4 2.1-.8-.9L5 7.5 3.6 6.3zM7.5 9.6H11v1.1H7.5z', 'fill-rule': 'evenodd' }],\n  own: [{ d: 'M11.3 2.2a1.4 1.4 0 0 1 2 0l.5.5a1.4 1.4 0 0 1 0 2L6 12.5l-3.5 1 1-3.5z' }],\n};\nconst ICON_SHAPES = {\n  pin: [\n    ['path', { d: 'M8 10.5v4' }],\n    ['path', { d: 'M5 1.5h6M6 1.5V6L4 8.5v2h8v-2L10 6V1.5' }],\n  ],\n  close: [['path', { d: 'M4 4l8 8M12 4l-8 8' }]],\n};\n\nconst DESTINATION_KEYS = Object.keys(IDEAS);\nconst memoryStore = { value: null };\nconst elements = {};\nlet state;\nlet selectedId = null;\nlet suppressClick = false;\nlet drag = null;\n\nfunction createDefaultState() {\n  const boards = {};\n  for (const key of DESTINATION_KEYS) {\n    boards[key] = { placements: {}, custom: [], plan: '' };\n  }\n  return { destination: DESTINATION_KEYS[0], boards };\n}\n\nfunction normalizeState(raw) {\n  const base = createDefaultState();\n  if (!raw || typeof raw !== 'object') return base;\n  if (DESTINATION_KEYS.includes(raw.destination)) base.destination = raw.destination;\n  for (const key of DESTINATION_KEYS) {\n    const saved = raw.boards?.[key];\n    if (!saved) continue;\n    const custom = Array.isArray(saved.custom)\n      ? saved.custom\n          .filter((item) => item && typeof item.id === 'string' && typeof item.text === 'string')\n          .map((item) => ({ id: item.id, text: item.text.slice(0, 40), size: 1, type: 'own' }))\n      : [];\n    const knownIds = new Set([...IDEAS[key], ...custom].map((idea) => idea.id));\n    const placements = {};\n    for (const [id, zone] of Object.entries(saved.placements ?? {})) {\n      if (knownIds.has(id) && Object.hasOwn(ZONE_NAMES, zone)) placements[id] = zone;\n    }\n    base.boards[key] = {\n      placements,\n      custom,\n      plan: typeof saved.plan === 'string' ? saved.plan.slice(0, 140) : '',\n    };\n  }\n  return base;\n}\n\nfunction readStored() {\n  try {\n    const raw = window.localStorage.getItem(STORAGE_KEY);\n    return raw ? JSON.parse(raw) : null;\n  } catch (error) {\n    return memoryStore.value;\n  }\n}\n\nfunction writeStored(value) {\n  memoryStore.value = value;\n  try {\n    window.localStorage.setItem(STORAGE_KEY, JSON.stringify(value));\n  } catch (error) {\n    // Storage can be blocked in the sandbox, so the board lives in memory.\n  }\n}\n\nfunction currentBoard() {\n  return state.boards[state.destination];\n}\n\nfunction getIdeas() {\n  return [...IDEAS[state.destination], ...currentBoard().custom];\n}\n\nfunction findIdea(id) {\n  return getIdeas().find((idea) => idea.id === id);\n}\n\nfunction createElement(tagName, className, text) {\n  const element = document.createElement(tagName);\n  if (className) element.className = className;\n  if (text) element.textContent = text;\n  return element;\n}\n\nfunction createSvg(className) {\n  const svg = document.createElementNS(SVG_NS, 'svg');\n  svg.setAttribute('viewBox', '0 0 16 16');\n  svg.setAttribute('aria-hidden', 'true');\n  if (className) svg.setAttribute('class', className);\n  return svg;\n}\n\nfunction createIcon(name, className) {\n  const svg = createSvg(className);\n  svg.setAttribute('fill', 'none');\n  svg.setAttribute('stroke', 'currentColor');\n  svg.setAttribute('stroke-width', '1.75');\n  svg.setAttribute('stroke-linecap', 'round');\n  for (const [shapeName, attributes] of ICON_SHAPES[name]) {\n    const shape = document.createElementNS(SVG_NS, shapeName);\n    for (const [key, value] of Object.entries(attributes)) shape.setAttribute(key, String(value));\n    svg.append(shape);\n  }\n  return svg;\n}\n\nfunction createTypeIcon(type) {\n  const tile = createElement('span', 'type-icon');\n  const svg = createSvg();\n  svg.setAttribute('fill', 'currentColor');\n  for (const attributes of TYPE_ICON_SHAPES[type]) {\n    const path = document.createElementNS(SVG_NS, 'path');\n    for (const [key, value] of Object.entries(attributes)) path.setAttribute(key, value);\n    svg.append(path);\n  }\n  tile.append(svg);\n  return tile;\n}\n\nfunction createSizeTag(idea) {\n  if (!SIZE_LABELS[idea.size]) return null;\n  return createElement('span', 'tag', SIZE_LABELS[idea.size]);\n}\n\nfunction createShelfItem(idea) {\n  const item = document.createElement('li');\n  const button = createElement('button', 'idea');\n  button.type = 'button';\n  button.dataset.id = idea.id;\n  button.setAttribute('aria-pressed', String(idea.id === selectedId));\n  button.append(createTypeIcon(idea.type));\n  button.append(createElement('span', 'idea-text', idea.text));\n  const tag = createSizeTag(idea);\n  if (tag) button.append(tag);\n  item.append(button);\n  return item;\n}\n\nfunction createPinnedCard(idea, zone) {\n  const item = createElement('li', `pinned-card pinned-card-${zone}`);\n  const body = createElement('div', 'pinned-body');\n  body.append(createElement('span', 'pinned-text', idea.text));\n  const tag = createSizeTag(idea);\n  if (tag) body.append(tag);\n  item.append(createIcon('pin', 'pin-icon'));\n  item.append(body);\n  const remove = createElement('button', 'remove-button');\n  remove.type = 'button';\n  remove.dataset.remove = idea.id;\n  remove.setAttribute('aria-label', `Remove ${idea.text} from ${ZONE_NAMES[zone]}`);\n  remove.append(createIcon('close'));\n  item.append(remove);\n  return item;\n}\n\nfunction renderShelf() {\n  const board = currentBoard();\n  const shelfIdeas = getIdeas().filter((idea) => !board.placements[idea.id]);\n  elements.shelf.replaceChildren(...shelfIdeas.map(createShelfItem));\n  elements.shelfEmpty.hidden = shelfIdeas.length > 0;\n}\n\nfunction renderZones() {\n  const board = currentBoard();\n  const ideas = getIdeas();\n  const selected = findIdea(selectedId);\n  for (const zone of Object.keys(ZONE_NAMES)) {\n    const placed = ideas.filter((idea) => board.placements[idea.id] === zone);\n    elements.lists[zone].replaceChildren(...placed.map((idea) => createPinnedCard(idea, zone)));\n    const button = elements.placeButtons[zone];\n    button.disabled = !selected;\n    button.textContent = selected ? `Place ${selected.text} here` : 'Choose or drag an idea';\n  }\n}\n\nfunction getHint() {\n  const board = currentBoard();\n  const nextIdeas = getIdeas().filter((idea) => board.placements[idea.id] === 'next');\n  if (nextIdeas.length > MAX_NEXT) return 'That is a lot to build next. Which ones can wait?';\n  const biggerIdeas = nextIdeas.filter((idea) => idea.size > 1);\n  if (biggerIdeas.length > 1) return 'More than one bigger idea can take a while. Which one can wait?';\n  return '';\n}\n\nfunction renderBoard() {\n  renderShelf();\n  renderZones();\n  elements.hint.textContent = getHint();\n}\n\nfunction syncFields() {\n  elements.destination.value = state.destination;\n  elements.planText.value = currentBoard().plan;\n  elements.planText.placeholder = PLAN_PLACEHOLDERS[state.destination];\n}\n\nfunction save() {\n  writeStored(state);\n}\n\nfunction announce(message) {\n  elements.status.textContent = '';\n  window.setTimeout(() => {\n    elements.status.textContent = message;\n  }, 50);\n}\n\nfunction findShelfButton(id) {\n  return elements.shelf.querySelector(`[data-id=\"${CSS.escape(id)}\"]`);\n}\n\nfunction focusNextIdea() {\n  const first = elements.shelf.querySelector('.idea');\n  (first || elements.customIdea).focus();\n}\n\nfunction toggleSelection(id) {\n  selectedId = selectedId === id ? null : id;\n  renderBoard();\n  const button = findShelfButton(id);\n  if (button) button.focus();\n}\n\nfunction placeIdea(id, zone) {\n  const idea = findIdea(id);\n  if (!idea) return;\n  currentBoard().placements[id] = zone;\n  selectedId = null;\n  save();\n  renderBoard();\n  announce(`Added ${idea.text} to ${ZONE_NAMES[zone]}.`);\n}\n\nfunction removeIdea(id) {\n  const idea = findIdea(id);\n  if (!idea) return;\n  delete currentBoard().placements[id];\n  save();\n  renderBoard();\n  announce(`${idea.text} is back in your ideas.`);\n  const button = findShelfButton(id);\n  if (button) button.focus();\n}\n\nfunction addCustomIdea(event) {\n  event.preventDefault();\n  const text = elements.customIdea.value.trim();\n  if (!text) {\n    elements.hint.textContent = 'Type an idea first.';\n    elements.customIdea.focus();\n    return;\n  }\n  const board = currentBoard();\n  board.custom.push({ id: `custom-${Date.now()}-${board.custom.length}`, text, size: 1, type: 'own' });\n  elements.customIdea.value = '';\n  save();\n  renderBoard();\n  announce(`Added ${text} to your ideas.`);\n}\n\nfunction changeDestination() {\n  state.destination = elements.destination.value;\n  selectedId = null;\n  save();\n  syncFields();\n  renderBoard();\n  announce(`Showing ideas for ${elements.destination.selectedOptions[0].textContent}.`);\n}\n\nfunction zoneAt(x, y) {\n  const target = document.elementFromPoint(x, y);\n  const zone = target ? target.closest('[data-zone]') : null;\n  return zone ? zone.dataset.zone : null;\n}\n\nfunction highlightZone(name) {\n  for (const zone of elements.zones) {\n    zone.classList.toggle('is-over', zone.dataset.zone === name);\n  }\n}\n\nfunction endDrag() {\n  if (!drag) return;\n  document.removeEventListener('pointermove', onPointerMove);\n  document.removeEventListener('pointerup', onPointerUp);\n  document.removeEventListener('pointercancel', endDrag);\n  if (drag.ghost) drag.ghost.remove();\n  drag.button.classList.remove('is-dragging');\n  highlightZone(null);\n  drag = null;\n}\n\nfunction onPointerMove(event) {\n  if (!drag) return;\n  if (!drag.ghost) {\n    const moved = Math.hypot(event.clientX - drag.startX, event.clientY - drag.startY);\n    if (moved < DRAG_THRESHOLD) return;\n    drag.ghost = drag.button.cloneNode(true);\n    drag.ghost.removeAttribute('data-id');\n    drag.ghost.setAttribute('aria-hidden', 'true');\n    drag.ghost.tabIndex = -1;\n    drag.ghost.classList.add('idea-ghost');\n    document.body.append(drag.ghost);\n    drag.button.classList.add('is-dragging');\n  }\n  drag.ghost.style.transform = `translate(${event.clientX + 8}px, ${event.clientY + 8}px)`;\n  highlightZone(zoneAt(event.clientX, event.clientY));\n}\n\nfunction onPointerUp(event) {\n  if (!drag) return;\n  const dragged = Boolean(drag.ghost);\n  const zone = dragged ? zoneAt(event.clientX, event.clientY) : null;\n  const { id } = drag;\n  endDrag();\n  if (!dragged) return;\n  suppressClick = true;\n  window.setTimeout(() => {\n    suppressClick = false;\n  }, 0);\n  if (zone) placeIdea(id, zone);\n}\n\nfunction onShelfPointerDown(event) {\n  if (event.pointerType === 'touch' || event.button !== 0) return;\n  const button = event.target.closest('.idea');\n  if (!button) return;\n  drag = { id: button.dataset.id, button, startX: event.clientX, startY: event.clientY, ghost: null };\n  document.addEventListener('pointermove', onPointerMove);\n  document.addEventListener('pointerup', onPointerUp);\n  document.addEventListener('pointercancel', endDrag);\n}\n\nfunction onShelfClick(event) {\n  const button = event.target.closest('.idea');\n  if (!button || suppressClick) return;\n  toggleSelection(button.dataset.id);\n}\n\nfunction onZonesClick(event) {\n  const placeButton = event.target.closest('[data-place]');\n  if (placeButton && selectedId) {\n    placeIdea(selectedId, placeButton.dataset.place);\n    focusNextIdea();\n    return;\n  }\n  const removeButton = event.target.closest('[data-remove]');\n  if (removeButton) removeIdea(removeButton.dataset.remove);\n}\n\nfunction onPlanInput() {\n  currentBoard().plan = elements.planText.value;\n  save();\n}\n\nfunction onKeydown(event) {\n  if (event.key !== 'Escape' || !selectedId) return;\n  selectedId = null;\n  renderBoard();\n}\n\nfunction init() {\n  elements.destination = document.getElementById('destination');\n  elements.shelf = document.getElementById('shelf');\n  elements.shelfEmpty = document.getElementById('shelf-empty');\n  elements.addForm = document.getElementById('add-form');\n  elements.customIdea = document.getElementById('custom-idea');\n  elements.planText = document.getElementById('plan-text');\n  elements.hint = document.getElementById('hint');\n  elements.status = document.getElementById('status');\n  elements.zones = document.querySelectorAll('[data-zone]');\n  elements.lists = {\n    next: document.querySelector('[data-list=\"next\"]'),\n    later: document.querySelector('[data-list=\"later\"]'),\n  };\n  elements.placeButtons = {\n    next: document.querySelector('[data-place=\"next\"]'),\n    later: document.querySelector('[data-place=\"later\"]'),\n  };\n\n  state = normalizeState(readStored());\n  syncFields();\n  renderBoard();\n\n  elements.destination.addEventListener('change', changeDestination);\n  elements.shelf.addEventListener('pointerdown', onShelfPointerDown);\n  elements.shelf.addEventListener('click', onShelfClick);\n  document.querySelector('.zones').addEventListener('click', onZonesClick);\n  elements.addForm.addEventListener('submit', addCustomIdea);\n  elements.planText.addEventListener('input', onPlanInput);\n  document.addEventListener('keydown', onKeydown);\n}\n\ntry {\n  init();\n} catch (error) {\n  const loadError = document.getElementById('load-error');\n  if (loadError) loadError.hidden = false;\n}\n\n  </script>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    },
    "long_instructions": "###Pause and plan\r\n\r\nYou’ve already started your website. Before you keep building, take a minute to think about what’s next. A short plan makes your next change easier to ask for and easier to judge.\r\n\r\n**Do this**\r\n\r\n1. Place 2 or 3 ideas you want next in Up next. Drag them, or choose an idea and then choose a spot.\r\n2. Put good ideas that can wait in Save for later.\r\n3. Finish “Next, I want my site to...” in your own words.",
