      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false
    },
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Recipe Matchmaker</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <div class=\"app-container\">\n    <header>\n      <h1>👨‍🍳 Recipe Matchmaker</h1>\n      <p>Find the perfect meal for your time & fridge.</p>\n    </header>\n\n    <main>\n      <div class=\"controls\">\n        <div class=\"input-group\">\n          <label for=\"timeInput\">Max Prep Time (mins)</label>\n          <input type=\"number\" id=\"timeInput\" placeholder=\"e.g. 30\" min=\"0\">\n        </div>\n\n        <div class=\"input-group\">\n          <label for=\"ingredientsInput\">I have this ingredient:</label>\n          <input type=\"text\" id=\"ingredientsInput\" placeholder=\"e.g. Chicken, Eggs...\">\n        </div>\n\n        <button id=\"findRecipesButton\">Find Recipes</button>\n      </div>\n\n      <div class=\"output-section\">\n        <h3 id=\"countLabel\">Results: 0</h3>\n        <pre id=\"resultsArea\">Enter preferences to see recipes...</pre>\n      </div>\n    </main>\n  </div>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// Data Setup\nconst recipes = [\n  { title: \"Quick Omelet\", ingredients: \"Eggs, Cheese, Butter\", prepTime: 10, dietType: \"Vegetarian\" },\n  { title: \"Chicken Stir Fry\", ingredients: \"Chicken, Soy Sauce, Peppers\", prepTime: 25, dietType: \"Meat\" },\n  { title: \"Grilled Cheese\", ingredients: \"Bread, Cheese, Butter\", prepTime: 15, dietType: \"Vegetarian\" },\n  { title: \"Beef Stew\", ingredients: \"Beef, Potatoes, Carrots\", prepTime: 120, dietType: \"Meat\" },\n  { title: \"Mystery Salad\", ingredients: \"Lettuce, ???\", dietType: \"Vegetarian\" }, // Missing prepTime!\n  { title: \"Grandma's Secret\", prepTime: 60, dietType: \"Unknown\" } // Missing ingredients!\n];\n\n// Element Selection\nconst timeInput = document.querySelector(\"#timeInput\");\nconst ingredientsInput = document.querySelector(\"#ingredientsInput\");\nconst findRecipesButton = document.querySelector(\"#findRecipesButton\");\nconst resultsArea = document.querySelector(\"#resultsArea\");\nconst countLabel = document.querySelector(\"#countLabel\");\n\n// Helper Functions\n\nconst filterByTime = (recipe, maxTime) => {\n\n};\n\nconst filterByIngredients = (recipe, userIngredient) => {\n\n};\n\n// Event Listener\n\nfindRecipesButton.addEventListener(\"click\", () => {\n  // Get values\n  const maxTime = Number(timeInput.value);\n  const userIng = ingredientsInput.value;\n  \n  // Create results list\n  const results = recipes.map((recipe) => {\n    \n    return \"\"; \n  });\n\n  // Update Screen\n  resultsArea.textContent = results.join(\"\\n\");\n  \n});",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "/* style.css */\n:root {\n  --primary: #d35400; /* Burnt Orange */\n  --secondary: #e67e22;\n  --accent: #27ae60; /* Food Green */\n  --bg: #fdf5e6; /* Old Lace */\n  --card-bg: #ffffff;\n  --text: #2c3e50;\n}\n\nbody {\n  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n  background-color: var(--bg);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  min-height: 100vh;\n  margin: 0;\n  color: var(--text);\n}\n\n.app-container {\n  background-color: var(--card-bg);\n  width: 400px;\n  padding: 2rem;\n  border-radius: 12px;\n  box-shadow: 0 10px 25px rgba(0,0,0,0.1);\n  border-top: 5px solid var(--primary);\n}\n\nheader {\n  text-align: center;\n  margin-bottom: 2rem;\n}\n\nh1 {\n  margin: 0;\n  color: var(--primary);\n  font-size: 1.8rem;\n}\n\np {\n  color: #7f8c8d;\n}\n\n.input-group {\n  margin-bottom: 1.2rem;\n}\n\nlabel {\n  display: block;\n  font-weight: bold;\n  margin-bottom: 0.5rem;\n  color: var(--text);\n}\n\ninput {\n  width: 100%;\n  padding: 0.8rem;\n  border: 2px solid #bdc3c7;\n  border-radius: 8px;\n  font-size: 1rem;\n  box-sizing: border-box;\n}\n\ninput:focus {\n  border-color: var(--secondary);\n  outline: none;\n}\n\nbutton {\n  width: 100%;\n  padding: 1rem;\n  background-color: var(--accent);\n  color: white;\n  border: none;\n  border-radius: 8px;\n  font-size: 1.1rem;\n  font-weight: bold;\n  cursor: pointer;\n  transition: background 0.2s;\n  margin-top: 0.5rem;\n}\n\nbutton:hover {\n  background-color: #219150;\n}\n\n.output-section {\n  margin-top: 2rem;\n  background-color: #f8f9fa;\n  padding: 1rem;\n  border-radius: 8px;\n  border: 1px solid #e1e1e1;\n  min-height: 120px;\n}\n\nh3 {\n  margin-top: 0;\n  color: var(--primary);\n  border-bottom: 2px solid #eee;\n  padding-bottom: 0.5rem;\n}\n\n#resultsArea {\n  white-space: pre-wrap;\n  font-family: 'Courier New', Courier, monospace;\n  color: #555;\n  line-height: 1.5;\n}",
          "folderId": "0",
          "active": false
        },
        "4": {
