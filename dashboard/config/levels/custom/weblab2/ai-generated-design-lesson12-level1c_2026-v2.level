      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Bloom & Balance Blog</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n  <!-- Header -->\n  <header class=\"site-header\">\n    <div class=\"container nav-container\">\n      <div class=\"site-branding\">\n        <img src=\"images/icons/logo.png\" alt=\"Bloom and Balance logo\" class=\"logo\">\n        <h1 class=\"site-title\">Bloom &amp; Balance</h1>\n      </div>\n\n      <nav class=\"main-nav\">\n        <ul>\n          <li>\n            <a href=\"index.html\">\n              <img src=\"images/icons/home-icon.png\" alt=\"Home icon\">\n              Home\n            </a>\n          </li>\n          <li>\n            <a href=\"post.html\">\n              <img src=\"images/icons/article.png\" alt=\"Articles icon\">\n              Articles\n            </a>\n          </li>\n        </ul>\n      </nav>\n    </div>\n  </header>\n\n  <!-- Hero -->\n  <section class=\"hero\">\n    <div class=\"container\">\n      <img src=\"images/hero.jpg\" alt=\"Aesthetic pink study desk with laptop and notebook\" class=\"hero-image\">\n      <div class=\"hero-text\">\n        <p class=\"tagline\">Study tips, routines, and small habits for a more balanced school week.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- Main Layout -->\n  <main class=\"container page-layout\">\n\n    <!-- Blog Content -->\n    <section class=\"blog-content\">\n      <h2>Latest Posts</h2>\n\n      <article class=\"post-preview\">\n        <img src=\"images/post1.jpg\" alt=\"Open journal with colorful markers on a desk\" class=\"preview-image\">\n        <div class=\"preview-text\">\n          <h3><a href=\"post.html\">How I Actually Stay Focused While Studying</a></h3>\n          <p>\n            Staying focused after school sounds simple until your phone starts buzzing, your snacks disappear,\n            and your brain decides it is suddenly the perfect time to reorganize your desk. These are a few\n            realistic habits that help me settle in and actually finish my work.\n          </p>\n          <a href=\"post.html\" class=\"read-more\">Read More</a>\n        </div>\n      </article>\n\n      <article class=\"post-preview\">\n        <img src=\"images/post2.jpg\" alt=\"Iced coffee and laptop on a wooden table\" class=\"preview-image\">\n        <div class=\"preview-text\">\n          <h3><a href=\"post.html\">My After-School Reset Routine</a></h3>\n          <p>\n            I used to go straight from school stress into homework panic, which made every afternoon feel rushed.\n            Now I follow a short reset routine that helps me recharge, get organized, and start my evening with\n            a lot less pressure.\n          </p>\n        </div>\n      </article>\n\n      <article class=\"post-preview\">\n        <img src=\"images/post3.jpg\" alt=\"Open book with coffee on a cozy blanket\" class=\"preview-image\">\n        <div class=\"preview-text\">\n          <h3><a href=\"post.html\">Notes That Actually Help You Remember Things</a></h3>\n          <p>\n            Pretty notes can be fun, but they do not always help when it is time to review for a quiz. I have\n            been experimenting with simpler note-taking strategies that make it easier to find key ideas, review\n            faster, and remember what I studied later.\n          </p>\n        </div>\n      </article>\n    </section>\n\n    <!-- Sidebar -->\n    <aside class=\"sidebar\">\n      <div class=\"sidebar-card about-card\">\n        <img src=\"images/sidebar.jpg\" alt=\"Small plant on a clean desk setup\" class=\"sidebar-image\">\n        <h3>About the Blog</h3>\n        <p>\n          Bloom &amp; Balance is a student lifestyle blog with simple ideas for managing school, staying organized,\n          and creating routines that feel realistic.\n        </p>\n      </div>\n\n      <div class=\"sidebar-card\">\n        <h3>Featured Topic</h3>\n        <p>\n          This month’s theme is building better study habits without making your schedule feel overwhelming.\n        </p>\n      </div>\n    </aside>\n\n  </main>\n\n  <!-- Footer -->\n  <footer class=\"site-footer\">\n    <div class=\"container\">\n      <p>&copy; 2026 Bloom &amp; Balance Blog. All rights reserved.</p>\n    </div>\n  </footer>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
