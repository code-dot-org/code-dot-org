      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <meta charset=\"utf-8\">\n    <title>Create Your Own Eligibility Rule</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    <h1>Create Your Own</h1>\n\n    <p>Design your own eligibility rule using the inputs below, or modify them to fit your idea.</p>\n\n    <label>\n      <input id=\"optionA\" type=\"checkbox\">\n      Option A\n    </label>\n\n    <label>\n      <input id=\"optionB\" type=\"checkbox\">\n      Option B\n    </label>\n\n    <label>\n      <input id=\"optionC\" type=\"checkbox\">\n      Option C\n    </label>\n\n    <label>\n      Age:\n      <input id=\"age\" type=\"number\" min=\"0\" value=\"25\">\n    </label>\n\n    <button id=\"runBtn\">Run</button>\n\n    <p id=\"message\">—</p>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "const optionA = document.getElementById(\"optionA\");\nconst optionB = document.getElementById(\"optionB\");\nconst optionC = document.getElementById(\"optionC\");\nconst age = document.getElementById(\"age\");\nconst message = document.getElementById(\"message\");\nconst runBtn = document.getElementById(\"runBtn\");\n\nconst eligible = () => {\n  const a = optionA.checked;\n  const b = optionB.checked;\n  const c = optionC.checked;\n  const ageValue = Number(age.value);\n\n\n  \n}\n\nrunBtn.addEventListener(\"click\", eligible);",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: sans-serif;\n  text-align: center;\n  padding: 2rem;\n  background-color: #f9f9f9;\n}\n\nh1 {\n  margin-bottom: 1rem;\n}\n\np {\n  max-width: 400px;\n  margin: 0 auto 1rem;\n  font-size: 0.9rem;\n}\n\nlabel {\n  display: block;\n  margin: 0.5rem 0;\n}\n\ninput[type=\"number\"] {\n  padding: 0.4rem;\n  margin-left: 0.5rem;\n}\n\nbutton {\n  margin-top: 1rem;\n  padding: 0.5rem 1rem;\n  border: 1px solid #ccc;\n  border-radius: 6px;\n  background-color: #f2f2f2;\n  cursor: pointer;\n}\n\nbutton:hover {\n  background-color: #e2e2e2;\n}\n\n#message {\n  margin-top: 1rem;\n  font-weight: bold;\n}\n",
          "folderId": "0",
          "active": false
