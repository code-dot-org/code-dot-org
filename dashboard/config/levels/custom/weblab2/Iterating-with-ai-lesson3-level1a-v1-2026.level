      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>BOSS FIGHT: Shadow Overlord</title>\n\n  <!-- Press Start 2P — retro pixel-art font used for all game text -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap\" rel=\"stylesheet\" />\n\n  <!-- All visual styling lives in style.css -->\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n\n  <!-- Outer wrapper: centers the game panel on the dark background -->\n  <div id=\"game-container\">\n\n    <!-- Title bar sits above the canvas -->\n    <div id=\"title-bar\">\n      <span id=\"title-text\">&#9876; BOSS FIGHT: SHADOW OVERLORD &#9876;</span>\n    </div>\n\n    <div id=\"canvas-wrapper\">\n\n      <canvas id=\"game-canvas\" width=\"800\" height=\"400\"></canvas>\n\n      <div id=\"result-overlay\" class=\"hidden\" role=\"dialog\" aria-label=\"Game result\">\n        <!-- Filled dynamically by helpers.js showVictoryOverlay() / showOverflowOverlay() -->\n      </div>\n\n    </div><!-- end #canvas-wrapper -->\n\n  </div><!-- end #game-container -->\n\n\n  <script src=\"helpers.js\"></script>\n\n</body>\n</html>\n",
          "active": false,
          "folderId": "0",
          "type": "support"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "/*\n  style.css — BOSS FIGHT: Shadow Overlord\n  =========================================\n  Color palette:\n    Page background:  #0a0a0f  (almost black with a blue tint)\n    Panel background: #0d0d18\n    Purple glow:      #6600cc\n    Gold accent:      #ffcc00\n    Text:             #e0d8ff  (soft lavender-white)\n*/\n\n\n/* === Reset & Base === */\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\n/* Deep dark background — the dungeon void surrounding the game */\nbody {\n  background-color: #0a0a0f;\n  color: #e0d8ff;\n  font-family: 'Press Start 2P', monospace;\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 20px;\n\n  /* Subtle dot-grid background texture — makes the void feel like space */\n  background-image: radial-gradient(rgba(102, 0, 204, 0.12) 1px, transparent 1px);\n  background-size: 28px 28px;\n}\n\n\n/* === Game Container — the framed panel holding the title + canvas === */\n\n#game-container {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  /* Purple outer glow — the signature visual of the game panel */\n  filter: drop-shadow(0 0 40px rgba(102, 0, 204, 0.6));\n  position: relative;\n}\n\n\n/* === Title Bar === */\n\n#title-bar {\n  width: 800px;\n  max-width: 100%;\n  background: linear-gradient(90deg, #0d0010, #1a0030, #0d0010);\n  border: 2px solid #6600cc;\n  border-bottom: none;\n  padding: 10px 20px;\n  text-align: center;\n}\n\n#title-text {\n  font-family: 'Press Start 2P', monospace;\n  font-size: clamp(8px, 1.4vw, 12px);\n  color: #cc88ff;\n  letter-spacing: 3px;\n  text-shadow:\n    0 0 8px #9933ff,\n    0 0 20px rgba(153, 51, 255, 0.5);\n}\n\n\n/* === The Game Canvas === */\n\n#game-canvas {\n  display: block;\n  /* Scale to fit narrower screens while keeping the aspect ratio */\n  max-width: 100%;\n  height: auto;\n  border: 2px solid #6600cc;\n  /* The main purple glow that makes the canvas feel alive */\n  box-shadow:\n    0 0 40px rgba(102, 0, 204, 0.7),\n    0 0 80px rgba(102, 0, 204, 0.3),\n    inset 0 0 20px rgba(0, 0, 0, 0.8);\n  background: #080810; /* fallback before canvas draws */\n  image-rendering: pixelated; /* keep pixel art crisp when scaled */\n  image-rendering: crisp-edges;\n}\n\n\n/* === Canvas Wrapper ===\n   Wraps the canvas and overlay so the overlay can be positioned\n   exactly over the canvas using position:absolute. */\n\n#canvas-wrapper {\n  position: relative;\n  display: block;\n  line-height: 0; /* removes gap below the inline canvas element */\n}\n\n\n/* === Result Overlay ===\n   Sits directly on top of the canvas, matching it exactly.\n   helpers.js removes \"hidden\" and adds either \"victory\" or \"overflow\". */\n\n#result-overlay {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  pointer-events: none; /* let clicks pass through while hidden */\n  overflow: hidden;\n}\n\n/* When the overlay becomes visible, re-enable pointer events */\n#result-overlay:not(.hidden) {\n  pointer-events: auto;\n}\n\n/* The inner content box — absolutely fills the overlay's padded area */\n#result-overlay .overlay-inner {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 16px;\n  padding: 30px;\n  text-align: center;\n  animation: overlay-fade-in 0.6s ease forwards;\n}\n\n/* Hidden state: completely invisible and non-interactive */\n#result-overlay.hidden {\n  display: none;\n}\n\n/* Victory overlay: golden glow */\n#result-overlay.victory .overlay-inner {\n  background: rgba(10, 8, 0, 0.88);\n  border: 3px solid #ffcc00;\n  box-shadow:\n    inset 0 0 60px rgba(255, 204, 0, 0.15),\n    0 0 40px rgba(255, 204, 0, 0.4);\n}\n\n/* Overflow / infinite loop overlay: blood red */\n#result-overlay.overflow .overlay-inner {\n  background: rgba(12, 0, 0, 0.9);\n  border: 3px solid #cc0000;\n  box-shadow:\n    inset 0 0 60px rgba(200, 0, 0, 0.15),\n    0 0 40px rgba(200, 0, 0, 0.5);\n}\n\n@keyframes overlay-fade-in {\n  from { opacity: 0; transform: scale(0.96); }\n  to   { opacity: 1; transform: scale(1); }\n}\n\n\n/* === Overlay Text Styles === */\n\n.overlay-icon {\n  font-size: clamp(28px, 5vw, 48px);\n  line-height: 1;\n  margin-bottom: 4px;\n}\n\n.overlay-title {\n  font-family: 'Press Start 2P', monospace;\n  font-size: clamp(10px, 2.2vw, 20px);\n  letter-spacing: 3px;\n  line-height: 1.6;\n}\n\n#result-overlay.victory  .overlay-title { color: #ffcc00; text-shadow: 0 0 16px #ffcc00, 0 0 40px rgba(255,204,0,0.5); }\n#result-overlay.overflow .overlay-title { color: #ff3333; text-shadow: 0 0 16px #ff3333, 0 0 40px rgba(255,50,50,0.5); }\n\n.overlay-subtitle {\n  font-family: 'Press Start 2P', monospace;\n  font-size: clamp(7px, 1.2vw, 10px);\n  line-height: 1.8;\n  letter-spacing: 1px;\n}\n\n#result-overlay.victory  .overlay-subtitle { color: #ffe680; }\n#result-overlay.overflow .overlay-subtitle { color: #ff9999; }\n\n/* PLAY AGAIN button */\n.overlay-btn {\n  font-family: 'Press Start 2P', monospace;\n  font-size: clamp(7px, 1.2vw, 10px);\n  letter-spacing: 2px;\n  padding: 12px 28px;\n  border: none;\n  border-radius: 4px;\n  cursor: pointer;\n  margin-top: 8px;\n  transition: transform 0.1s ease, filter 0.2s ease, box-shadow 0.2s ease;\n}\n\n#result-overlay.victory  .overlay-btn {\n  background: linear-gradient(135deg, #a07800, #ffcc00);\n  color: #0a0800;\n  box-shadow: 0 0 20px rgba(255, 204, 0, 0.6);\n}\n\n#result-overlay.overflow .overlay-btn {\n  background: linear-gradient(135deg, #660000, #cc2200);\n  color: #ffdddd;\n  box-shadow: 0 0 20px rgba(200, 0, 0, 0.6);\n}\n\n.overlay-btn:hover {\n  filter: brightness(1.2);\n  transform: translateY(-2px);\n}\n\n.overlay-btn:active {\n  transform: translateY(1px);\n  filter: brightness(0.9);\n}\n\n\n/* === Responsive scaling for small screens === */\n\n@media (max-width: 860px) {\n  #title-bar {\n    width: 100%;\n  }\n}\n\n@media (max-width: 500px) {\n  body {\n    padding: 8px;\n  }\n\n  #title-text {\n    font-size: 7px;\n    letter-spacing: 1px;\n  }\n}\n",
          "folderId": "0",
          "active": true,
          "type": "support"
        },
        "3": {
          "id": "3",
          "name": "helpers.js",
          "contents": "// ============================================================\n//  helpers.js — BOSS FIGHT: Shadow Overlord — Game Engine\n//  ============================================================\n//  This is the game engine. Students do NOT edit this file.\n//\n//  How the game works:\n//    1. script.js runs immediately on page load.\n//       Its while loop calls spawnEnemy() and attackBoss() each round.\n//       Those functions do NOT draw anything — they push events\n//       into the gameEvents array.\n//    2. After the loop ends, script.js calls showResult().\n//       showResult() starts animateEvents(), which replays the\n//       battle one event at a time using setInterval (~120ms each).\n//    3. The canvas is redrawn every frame via requestAnimationFrame,\n//       which handles the breathing animation, glows, and particles.\n//\n//  Key concepts demonstrated:\n//    - Event queue / animation decoupling\n//    - Pixel art rendering with Canvas 2D\n//    - requestAnimationFrame game loop\n//    - Sprite drawing via 2D color arrays\n// ============================================================\n\n\n// ── Canvas setup ─────────────────────────────────────────────\n\nconst canvas  = document.getElementById('game-canvas');\nconst ctx     = canvas.getContext('2d');\n\n// Width and height of the canvas in CSS pixels\nconst CW = 800;\nconst CH = 400;\n\n// How many screen pixels each sprite \"pixel\" occupies\n// A scale of 3 means each sprite pixel = a 3x3 block on screen\nconst SCALE = 3;\n\n\n// ============================================================\n//  PIXEL ART SPRITES\n//\n//  Each sprite is a 2D array of strings.\n//  Each string is a hex color like '#ff0000'.\n//  null means transparent — nothing is drawn for that cell.\n//  Rows top-to-bottom, columns left-to-right.\n//\n//  Naming convention: SPRITE_<NAME>\n// ============================================================\n\n\n// ── Boss Sprite — Shadow Overlord (~16 wide x 20 tall pixels) ──\n// A large demonic skull face. Dark purple body, bone-white skull,\n// glowing crimson eye sockets, twisted horns.\nconst SPRITE_BOSS = [\n  // Row 0-1: twisted horns on each side\n  [null,  null,  '#1a0033','#2d0055', null,  null,  null,  null,  null,  null,  null,  null,  '#2d0055','#1a0033', null,  null ],\n  [null,  '#1a0033','#3d0077','#5500aa','#2d0055', null,  null,  null,  null,  null,  null,  '#2d0055','#5500aa','#3d0077','#1a0033', null ],\n  // Row 2-3: top of skull, glowing purple aura\n  ['#1a0033','#3d0077','#7700cc','#9900ee','#7700cc','#4400aa','#2d0055','#2d0055','#4400aa','#7700cc','#9900ee','#7700cc','#3d0077','#1a0033', null,  null ],\n  ['#2d0055','#5500aa','#9900ee','#aa00ff','#cc44ff','#aa00ff','#9900ee','#9900ee','#aa00ff','#cc44ff','#aa00ff','#9900ee','#5500aa','#2d0055', null,  null ],\n  // Row 4-5: forehead — bone white skull begins\n  ['#3d0077','#7700cc','#c8b8d8','#ddd0ee','#eee8ff','#ddd0ee','#c8b8d8','#c8b8d8','#ddd0ee','#eee8ff','#ddd0ee','#c8b8d8','#7700cc','#3d0077', null,  null ],\n  ['#4400aa','#9900ee','#ddd0ee','#eee8ff','#ffffff','#f8f0ff','#eee8ff','#eee8ff','#f8f0ff','#ffffff','#eee8ff','#ddd0ee','#9900ee','#4400aa', null,  null ],\n  // Row 6-7: eye sockets — glowing red\n  ['#2d0055','#7700cc','#c8b8d8','#cc0000','#ff2200','#ff5500','#c8b8d8','#c8b8d8','#ff5500','#ff2200','#cc0000','#c8b8d8','#7700cc','#2d0055', null,  null ],\n  ['#2d0055','#7700cc','#c8b8d8','#ff2200','#ff6600','#ffaa00','#c8b8d8','#c8b8d8','#ffaa00','#ff6600','#ff2200','#c8b8d8','#7700cc','#2d0055', null,  null ],\n  // Row 8-9: cheekbones and nose cavity\n  ['#2d0055','#5500aa','#c8b8d8','#ddd0ee','#eee8ff','#ddd0ee','#4400aa','#4400aa','#ddd0ee','#eee8ff','#ddd0ee','#c8b8d8','#5500aa','#2d0055', null,  null ],\n  ['#1a0033','#3d0077','#9900ee','#c8b8d8','#eee8ff','#c8b8d8','#5500aa','#5500aa','#c8b8d8','#eee8ff','#c8b8d8','#9900ee','#3d0077','#1a0033', null,  null ],\n  // Row 10-11: wide grinning jaw\n  ['#1a0033','#2d0055','#7700cc','#9900ee','#ddd0ee','#eee8ff','#c8b8d8','#c8b8d8','#eee8ff','#ddd0ee','#9900ee','#7700cc','#2d0055','#1a0033', null,  null ],\n  ['#1a0033','#2d0055','#5500aa','#9900ee','#cc00ff','#ddd0ee','#eee8ff','#eee8ff','#ddd0ee','#cc00ff','#9900ee','#5500aa','#2d0055','#1a0033', null,  null ],\n  // Row 12-13: sharp teeth row\n  [null,  '#1a0033','#3d0077','#ddd0ee','#ffffff','#2d0055','#9900ee','#9900ee','#2d0055','#ffffff','#ddd0ee','#3d0077','#1a0033', null,  null,  null ],\n  [null,  null,  '#2d0055','#ffffff','#ddd0ee','#3d0077','#9900ee','#9900ee','#3d0077','#ddd0ee','#ffffff','#2d0055', null,  null,  null,  null ],\n  // Row 14-15: lower jaw / chin\n  [null,  null,  '#1a0033','#3d0077','#7700cc','#5500aa','#3d0077','#3d0077','#5500aa','#7700cc','#3d0077','#1a0033', null,  null,  null,  null ],\n  [null,  null,  null,  '#1a0033','#3d0077','#7700cc','#5500aa','#5500aa','#7700cc','#3d0077','#1a0033', null,  null,  null,  null,  null ],\n  // Row 16-17: neck / body stump\n  [null,  null,  null,  null,  '#1a0033','#3d0077','#5500aa','#5500aa','#3d0077','#1a0033', null,  null,  null,  null,  null,  null ],\n  [null,  null,  null,  null,  '#0d0022','#2d0055','#3d0077','#3d0077','#2d0055','#0d0022', null,  null,  null,  null,  null,  null ],\n  // Row 18-19: bottom of body — fades out\n  [null,  null,  null,  null,  null,  '#0d0022','#1a0033','#1a0033','#0d0022', null,  null,  null,  null,  null,  null,  null ],\n  [null,  null,  null,  null,  null,  null,  '#080011','#080011', null,  null,  null,  null,  null,  null,  null,  null ],\n];\n\n\n// ── Hero Sprite — Armored Knight (~10 wide x 14 tall pixels) ──\n// Blue/silver plate armor, white visor slit, sword held at side.\nconst SPRITE_HERO = [\n  // Row 0-1: helmet top\n  [null,  '#334466','#446688','#5577aa','#5577aa','#446688','#334466', null,  null,  null ],\n  ['#223355','#446688','#6699cc','#88aadd','#88aadd','#6699cc','#446688','#223355', null,  null ],\n  // Row 2: visor / face plate with white eye slit\n  ['#334466','#5577aa','#88aadd','#eeeeff','#eeeeff','#88aadd','#5577aa','#334466', null,  null ],\n  // Row 3: neck/chin guard\n  [null,  '#334466','#5577aa','#6699cc','#6699cc','#5577aa','#334466', null,  null,  null ],\n  // Row 4-5: shoulder pauldrons + chest plate\n  ['#223355','#5577aa','#88aadd','#aabbdd','#aabbdd','#88aadd','#5577aa','#223355', '#ccccdd','#aaaacc' ],\n  ['#334466','#6699cc','#aabbdd','#ccddf0','#ccddf0','#aabbdd','#6699cc','#334466', '#ddddee','#ccccdd' ],\n  // Row 6-7: torso armor\n  ['#334466','#5577aa','#88aadd','#aabbdd','#aabbdd','#88aadd','#5577aa','#334466', null,  null ],\n  ['#223355','#446688','#6699cc','#88aadd','#88aadd','#6699cc','#446688','#223355', null,  null ],\n  // Row 8: belt/waist plate\n  ['#334466','#446688','#5577aa','#6699cc','#6699cc','#5577aa','#446688','#334466', null,  null ],\n  // Row 9-10: tassets (thigh guards) with leg gap\n  ['#223355','#446688','#6699cc','#88aadd', null,  '#88aadd','#446688','#223355', null,  null ],\n  ['#334466','#5577aa','#88aadd','#aabbdd', null,  '#aabbdd','#5577aa','#334466', null,  null ],\n  // Row 11-12: greaves (leg armor)\n  [null,  '#334466','#5577aa','#6699cc', null,  '#6699cc','#5577aa','#334466', null,  null ],\n  [null,  '#223355','#446688','#5577aa', null,  '#5577aa','#446688','#223355', null,  null ],\n  // Row 13: boots / feet\n  [null,  '#1a2233','#334466','#446688', null,  '#446688','#334466','#1a2233', null,  null ],\n];\n\n\n// ── Enemy Sprites — Shadow Imp walk cycle (2 frames, 10 wide x 12 tall) ──\n// Frame 0: legs together (neutral stride — feet below center)\n// Frame 1: legs spread wide (full stride — feet pushed outward)\n// The engine alternates between frames every 8 canvas ticks (~7.5fps).\n\n// Shared upper body rows (rows 0-8) — identical across both frames\nconst _ENEMY_TOP = [\n  // Row 0: tiny horn tips\n  ['#440000', null,  null,  null,  null,  null,  null,  null,  null,  '#440000'],\n  // Row 1: horns\n  ['#660000','#440000', null,  null,  null,  null,  null,  null,  '#440000','#660000'],\n  // Row 2-3: head\n  ['#880000','#aa2200','#cc3300','#cc3300','#cc3300','#cc3300','#cc3300','#aa2200','#880000', null ],\n  ['#aa2200','#cc3300','#ff5500','#ffaa00','#cc3300','#cc3300','#ffaa00','#ff5500','#cc3300','#880000'],\n  // Row 4: eyes glowing yellow\n  ['#660000','#aa2200','#ffee00','#ffff00','#aa2200','#aa2200','#ffff00','#ffee00','#aa2200','#660000'],\n  // Row 5: body + wings\n  ['#880000','#cc3300','#ff5500','#dd4400','#aa2200','#aa2200','#dd4400','#ff5500','#cc3300','#880000'],\n  // Row 6-7: wider body, wings extend\n  ['#440000','#880000','#cc3300','#ff5500','#dd4400','#dd4400','#ff5500','#cc3300','#880000','#440000'],\n  ['#440000','#660000','#aa2200','#cc3300','#ff5500','#ff5500','#cc3300','#aa2200','#660000','#440000'],\n  // Row 8: belly / lower body\n  [null,  '#440000','#880000','#cc3300','#dd4400','#dd4400','#cc3300','#880000','#440000', null ],\n];\n\n// Frame 0 — legs centered/together beneath the body\nconst SPRITE_ENEMY = _ENEMY_TOP.concat([\n  // Row 9: legs side-by-side, close to center\n  [null,  null,  '#440000','#880000','#aa2200','#aa2200','#880000','#440000', null,  null ],\n  // Row 10: feet below legs\n  [null,  '#330000','#440000','#660000','#880000','#880000','#660000','#440000','#330000', null ],\n  // Row 11: claws\n  ['#220000','#330000', null,  '#440000', null,  null,  '#440000', null,  '#330000','#220000'],\n]);\n\n// Frame 1 — legs spread wide (full stride)\nconst SPRITE_ENEMY_B = _ENEMY_TOP.concat([\n  // Row 9: legs pushed outward to each side\n  ['#440000','#880000','#aa2200', null,  null,  null,  '#aa2200','#880000','#440000', null ],\n  // Row 10: feet planted wide apart\n  ['#330000','#440000','#660000','#880000', null,  '#880000','#660000','#440000','#330000', null ],\n  // Row 11: outer claws only (inner gap shows the stride)\n  ['#220000','#330000','#440000', null,  null,  null,  '#440000','#330000','#220000', null ],\n]);\n\n// Animation frame array — indexed by e.frame (0 or 1)\nconst SPRITE_ENEMY_FRAMES = [SPRITE_ENEMY, SPRITE_ENEMY_B];\n\n\n// ── Projectile Sprite — Glowing Red Orb (~5 wide x 5 tall pixels) ──\n// Boss shoots these at the heroes when attacking.\nconst SPRITE_PROJECTILE = [\n  [null,  '#ff2200','#ff4400', '#ff2200', null  ],\n  ['#ff2200','#ff6600','#ffaa00','#ff6600','#ff2200'],\n  ['#ff4400','#ffaa00','#ffffff','#ffaa00','#ff4400'],\n  ['#ff2200','#ff6600','#ffaa00','#ff6600','#ff2200'],\n  [null,  '#ff2200','#ff4400', '#ff2200', null  ],\n];\n\n\n// ============================================================\n//  SPRITE DRAWING UTILITY\n//\n//  drawSprite(spriteArray, x, y, scale, alphaMultiplier)\n//  Renders a 2D color array onto the canvas at position (x, y).\n//\n//  Parameters:\n//    spriteArray     — 2D array of hex color strings / null\n//    x, y            — top-left corner in canvas pixels\n//    scale           — how many canvas pixels per sprite pixel\n//    alphaMultiplier — 0.0 to 1.0, lets us fade sprites in/out\n// ============================================================\nfunction drawSprite(spriteArray, x, y, scale, alphaMultiplier) {\n\n  // Default alpha to fully opaque if not provided\n  if (alphaMultiplier === undefined) {\n    alphaMultiplier = 1.0;\n  }\n\n  // Loop through every row and column in the sprite array\n  for (let row = 0; row < spriteArray.length; row++) {\n    for (let col = 0; col < spriteArray[row].length; col++) {\n\n      const color = spriteArray[row][col];\n\n      // null means transparent — skip this cell\n      if (color === null) continue;\n\n      // Parse the hex color and apply the alpha multiplier\n      // This lets us fade sprites when the boss takes damage or dies\n      ctx.globalAlpha = alphaMultiplier;\n      ctx.fillStyle = color;\n\n      // Each sprite \"pixel\" is a scale×scale block on the canvas\n      ctx.fillRect(\n        Math.floor(x + col * scale),\n        Math.floor(y + row * scale),\n        scale,\n        scale\n      );\n    }\n  }\n\n  // Always reset globalAlpha after drawing so other code isn't affected\n  ctx.globalAlpha = 1.0;\n}\n\n\n// ============================================================\n//  GAME STATE\n//  These variables are reset by runGame() at the start of each run.\n// ============================================================\n\n// The array that the while loop fills with battle events.\n// Each event is an object: { type, round, enemyName, damage, bossHPAfter, ... }\nlet gameEvents = [];\n\n// Safety cap — spawnEnemy() stops the loop if this exceeds 200\nlet iterationCount = 0;\nlet safetyCapHit   = false;\n\n// Live enemies currently sliding across the screen during animation\n// Each entry: { x, y, speed, alpha, spriteScale, name }\nlet activeEnemies = [];\n\n// Projectiles flying from boss toward heroes during animation\n// Each entry: { x, y, speed, alpha }\nlet activeProjectiles = [];\n\n// Particle effects — used for the victory explosion and damage hits\n// Each entry: { x, y, vx, vy, color, alpha, size, life, maxLife }\nlet particles = [];\n\n// Boss visual state — updated during animation playback\nlet bossFlashTimer  = 0;   // frames remaining for the red damage flash\nlet bossAlpha       = 1.0; // fades to 0 during the defeat animation\nlet bossDefeatedAnim = false; // true once defeat animation starts\nlet screenShake     = 0;   // pixels of random offset during screen shake\nlet redVignetteAlpha = 0;  // intensity of the red overflow vignette (0–0.7)\n\n// Animation timing\nlet frameCount = 0; // incremented every requestAnimationFrame tick\n\n// The source string of script.js, fetched once on load so runGame() can re-eval it\nlet studentCodeSource = null;\n\n// Flag: has the initial fetch + run happened?\nlet firstRunDone = false;\n\n\n// ============================================================\n//  BACKGROUND DRAWING\n//  drawBackground()\n//  Paints the dungeon stone wall and floor onto the canvas.\n//  Called every frame before drawing sprites.\n// ============================================================\nfunction drawBackground() {\n\n  // ── Sky / upper area: dark dungeon stone ──\n  const bgGrad = ctx.createLinearGradient(0, 0, 0, CH);\n  bgGrad.addColorStop(0,   '#08080e');\n  bgGrad.addColorStop(0.7, '#0d0d18');\n  bgGrad.addColorStop(1,   '#0a0810');\n  ctx.fillStyle = bgGrad;\n  ctx.fillRect(0, 0, CW, CH);\n\n  // ── Brick texture on walls ──\n  // Draw a grid of slightly lighter rectangles to look like stone blocks.\n  ctx.fillStyle = 'rgba(80, 60, 100, 0.07)';\n  const brickW = 50;\n  const brickH = 22;\n  for (let row = 0; row < Math.ceil(CH * 0.72 / brickH); row++) {\n    // Odd rows are offset by half a brick width (running bond pattern)\n    const offsetX = (row % 2 === 0) ? 0 : brickW / 2;\n    for (let col = -1; col < Math.ceil(CW / brickW) + 1; col++) {\n      const bx = col * brickW + offsetX;\n      const by = row * brickH;\n      // Draw brick outline\n      ctx.strokeStyle = 'rgba(100, 80, 120, 0.09)';\n      ctx.lineWidth = 1;\n      ctx.strokeRect(bx + 1, by + 1, brickW - 2, brickH - 2);\n    }\n  }\n\n  // ── Ground line ──\n  // A horizontal line at 75% down — separates wall from floor\n  const groundY = Math.floor(CH * 0.75);\n\n  // Dark floor fill below the ground line\n  ctx.fillStyle = '#06060a';\n  ctx.fillRect(0, groundY, CW, CH - groundY);\n\n  // The ground line itself — glows slightly purple\n  ctx.strokeStyle = 'rgba(102, 0, 204, 0.4)';\n  ctx.lineWidth = 2;\n  ctx.beginPath();\n  ctx.moveTo(0, groundY);\n  ctx.lineTo(CW, groundY);\n  ctx.stroke();\n\n  // Subtle floor glow along the ground line\n  const floorGlow = ctx.createLinearGradient(0, groundY, 0, groundY + 40);\n  floorGlow.addColorStop(0, 'rgba(102, 0, 204, 0.12)');\n  floorGlow.addColorStop(1, 'transparent');\n  ctx.fillStyle = floorGlow;\n  ctx.fillRect(0, groundY, CW, 40);\n}\n\n\n// ============================================================\n//  HERO DRAWING\n//  drawHeroes(breathOffset)\n//  Draws the single hero on the left side of the canvas.\n//  breathOffset is a small vertical oscillation for idle animation.\n// ============================================================\n\n// Fixed hero X so projectile spawn and drawing share the same anchor\nconst HERO_X = 50;\n\nfunction drawHeroes(breathOffset) {\n\n  const groundY = Math.floor(CH * 0.75);\n  const heroH   = SPRITE_HERO.length * SCALE; // 14 * 3 = 42px\n\n  const bob   = Math.sin(frameCount * 0.035) * 2;\n  const heroY = groundY - heroH + Math.round(breathOffset + bob);\n  drawSprite(SPRITE_HERO, HERO_X, heroY, SCALE, 1.0);\n}\n\n\n// ============================================================\n//  BOSS DRAWING\n//  drawBoss()\n//  Draws the Shadow Overlord on the right side of the canvas.\n//  Handles the purple glow, damage flash, and defeat fade.\n// ============================================================\nfunction drawBoss() {\n\n  const groundY = Math.floor(CH * 0.75);\n\n  const bossH = SPRITE_BOSS.length    * SCALE; // 20 * 3 = 60px\n  const bossW = SPRITE_BOSS[0].length * SCALE; // 16 * 3 = 48px\n\n  // Boss sits at right side, slightly elevated (floating feel)\n  const bossX = CW - bossW - 50;\n  // Gentle vertical float using a slow sine wave\n  const floatY = Math.sin(frameCount * 0.02) * 4;\n  const bossY  = Math.floor(groundY - bossH - 20 + floatY);\n\n  // ── Purple glow behind the boss ──\n  // Draw a radial gradient \"aura\" before the sprite\n  const glowPulse = 0.5 + 0.5 * Math.sin(frameCount * 0.04);\n  const glowRadius = bossW * 1.4 + glowPulse * 15;\n  const bossCenterX = bossX + bossW / 2;\n  const bossCenterY = bossY + bossH / 2;\n\n  const bossGlow = ctx.createRadialGradient(\n    bossCenterX, bossCenterY, 0,\n    bossCenterX, bossCenterY, glowRadius\n  );\n  bossGlow.addColorStop(0, 'rgba(102, 0, 204, ' + (0.25 + glowPulse * 0.15) + ')');\n  bossGlow.addColorStop(1, 'transparent');\n  ctx.fillStyle = bossGlow;\n  ctx.beginPath();\n  ctx.ellipse(bossCenterX, bossCenterY, glowRadius, glowRadius * 0.8, 0, 0, Math.PI * 2);\n  ctx.fill();\n\n  // ── Damage flash overlay ──\n  // When the boss takes a hit, bossFlashTimer > 0 and we tint the sprite red\n  let flashAlpha = 0;\n  if (bossFlashTimer > 0) {\n    flashAlpha = bossFlashTimer / 12;\n    bossFlashTimer--;\n  }\n\n  // Draw the boss sprite (fades out during defeat animation)\n  drawSprite(SPRITE_BOSS, bossX, bossY, SCALE, bossAlpha);\n\n  // If flashing, draw a red rectangle on top at low opacity\n  if (flashAlpha > 0) {\n    ctx.globalAlpha = flashAlpha * 0.6 * bossAlpha;\n    ctx.fillStyle = '#ff0000';\n    ctx.fillRect(bossX, bossY, bossW, bossH);\n    ctx.globalAlpha = 1.0;\n  }\n}\n\n\n// ============================================================\n//  HP BAR DRAWING\n//  drawHPBar(currentHP, maxHP, roundNum)\n//  Draws the boss HP bar and round counter at the top of the canvas.\n// ============================================================\nfunction drawHPBar(currentHP, maxHP, roundNum) {\n\n  const barX = 16;\n  const barY = 14;\n  const barW = 440;\n  const barH = 20;\n\n  // ── HP label ──\n  ctx.fillStyle = '#cc88ff';\n  ctx.font = '9px \"Press Start 2P\"';\n  ctx.fillText('BOSS HP', barX, barY + barH - 6);\n\n  const labelW = 72; // approximate width of \"BOSS HP\" text\n  const trackX  = barX + labelW + 8;\n  const trackW  = barW - labelW - 8;\n\n  // ── Bar track (dark background) ──\n  ctx.fillStyle = '#1a001a';\n  ctx.fillRect(trackX, barY, trackW, barH);\n  ctx.strokeStyle = 'rgba(155, 0, 204, 0.6)';\n  ctx.lineWidth = 1;\n  ctx.strokeRect(trackX, barY, trackW, barH);\n\n  // ── HP fill ──\n  const hpFraction = Math.max(0, Math.min(1, currentHP / maxHP));\n  // Color shifts from green (full) to red (empty)\n  const red   = Math.round(180 + (1 - hpFraction) * 75);\n  const green = Math.round(hpFraction * 180);\n  ctx.fillStyle = 'rgb(' + red + ',' + green + ',20)';\n  ctx.fillRect(trackX + 1, barY + 1, Math.floor((trackW - 2) * hpFraction), barH - 2);\n\n  // ── HP number ──\n  ctx.fillStyle = '#ffffff';\n  ctx.font = '8px \"Press Start 2P\"';\n  ctx.fillText(currentHP + '/' + maxHP, trackX + trackW + 8, barY + barH - 6);\n\n  // ── Round counter (top right) ──\n  ctx.fillStyle = '#aa88ff';\n  ctx.font = '9px \"Press Start 2P\"';\n  const roundLabel = 'ROUND ' + roundNum;\n  const textWidth = ctx.measureText(roundLabel).width;\n  ctx.fillText(roundLabel, CW - textWidth - 16, barY + barH - 6);\n}\n\n\n// ============================================================\n//  ACTIVE ENEMY DRAWING + MOVEMENT\n//  updateAndDrawEnemies()\n//  Moves each active enemy sprite leftward and draws it.\n//  Enemies that reach x < -40 are removed from the array.\n// ============================================================\nfunction updateAndDrawEnemies() {\n\n  const survivors = [];\n\n  for (let i = 0; i < activeEnemies.length; i++) {\n    const e = activeEnemies[i];\n\n    // Move left each frame\n    e.x -= e.speed;\n\n    // Advance the walk-cycle frame counter (8 canvas ticks per frame = ~7.5fps)\n    e.frameTimer++;\n    if (e.frameTimer >= 8) {\n      e.frameTimer = 0;\n      e.frame = (e.frame === 0) ? 1 : 0;\n    }\n\n    // Vertical stomp: drop slightly on frame 0, lift on frame 1 — sells the footfall\n    const stomp = (e.frame === 0) ? 2 : -1;\n    const drawY = e.y + stomp;\n\n    // Draw the enemy using the current walk frame\n    if (e.alpha > 0) {\n      drawSprite(SPRITE_ENEMY_FRAMES[e.frame], Math.floor(e.x), Math.floor(drawY), e.spriteScale, e.alpha);\n    }\n\n    // Keep enemies that are still on screen and visible\n    if (e.x > -50 && e.alpha > 0) {\n      survivors.push(e);\n    }\n  }\n\n  activeEnemies = survivors;\n}\n\n\n// ============================================================\n//  PROJECTILE DRAWING + MOVEMENT\n//  updateAndDrawProjectiles()\n//  Moves hero fireballs rightward toward the boss.\n//  When a fireball reaches the boss, it triggers the boss flash,\n//  updates the HP bar, and spawns an impact particle burst.\n// ============================================================\n\n// X coordinate where a fireball is considered to have hit the boss.\n// Boss left edge is roughly CW - (bossW) - 50; we hit a little in front.\nconst BOSS_HIT_X = CW - SPRITE_BOSS[0].length * SCALE - 60;\n\nfunction updateAndDrawProjectiles() {\n\n  const survivors = [];\n\n  for (let i = 0; i < activeProjectiles.length; i++) {\n    const p = activeProjectiles[i];\n\n    // Fireballs travel right toward the boss\n    p.x += p.speed;\n\n    // ── Impact check ──\n    // When the fireball crosses the boss's front edge for the first time,\n    // trigger the boss-hit effects and mark it triggered so it only fires once.\n    if (!p.triggered && p.x >= BOSS_HIT_X) {\n      p.triggered     = true;\n      bossFlashTimer  = 12;\n\n      // Spawn a bright orange burst at the point of impact\n      spawnParticles(\n        BOSS_HIT_X + 8, p.y + 8,\n        12, ['#ff2200', '#ff6600', '#ffaa00', '#ffffff'],\n        4, 22\n      );\n    }\n\n    // Keep the fireball alive until it has fully crossed through the boss\n    if (p.x < CW + 20) {\n      // Draw a glowing aura behind the sprite for the fireball trail\n      const glowAlpha = p.triggered ? Math.max(0, 1 - (p.x - BOSS_HIT_X) / 60) : 1.0;\n      if (glowAlpha > 0) {\n        ctx.globalAlpha = glowAlpha * 0.45;\n        ctx.fillStyle = '#ff6600';\n        ctx.beginPath();\n        ctx.arc(p.x + 7, p.y + 7, 11, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.globalAlpha = 1.0;\n\n        drawSprite(SPRITE_PROJECTILE, Math.floor(p.x), Math.floor(p.y), 3, glowAlpha);\n        survivors.push(p);\n      }\n    }\n  }\n\n  activeProjectiles = survivors;\n}\n\n\n// ============================================================\n//  PARTICLE SYSTEM\n//  spawnParticles(x, y, count, colors, speed, life)\n//  Creates burst particles at position (x, y).\n//\n//  updateAndDrawParticles()\n//  Moves, fades, and draws all active particles each frame.\n// ============================================================\nfunction spawnParticles(x, y, count, colors, speed, life) {\n\n  for (let i = 0; i < count; i++) {\n    const angle = Math.random() * Math.PI * 2;\n    const s = speed * (0.4 + Math.random() * 0.8);\n    particles.push({\n      x:    x,\n      y:    y,\n      vx:   Math.cos(angle) * s,\n      vy:   Math.sin(angle) * s - speed * 0.3, // slight upward bias\n      color: colors[Math.floor(Math.random() * colors.length)],\n      alpha: 1.0,\n      size:  2 + Math.random() * 3,\n      life:  life,\n      maxLife: life,\n    });\n  }\n}\n\nfunction updateAndDrawParticles() {\n\n  const survivors = [];\n\n  for (let i = 0; i < particles.length; i++) {\n    const p = particles[i];\n    p.x    += p.vx;\n    p.y    += p.vy;\n    p.vy   += 0.18; // gravity\n    p.life -= 1;\n    p.alpha = p.life / p.maxLife;\n\n    if (p.life > 0) {\n      ctx.globalAlpha = p.alpha;\n      ctx.fillStyle   = p.color;\n      ctx.fillRect(Math.floor(p.x), Math.floor(p.y), Math.ceil(p.size), Math.ceil(p.size));\n      survivors.push(p);\n    }\n  }\n\n  ctx.globalAlpha = 1.0;\n  particles = survivors;\n}\n\n\n// ============================================================\n//  SCREEN EFFECTS\n//  drawRedVignette()\n//  Draws a red border vignette when the overflow cap is hit.\n//  Intensity is controlled by redVignetteAlpha (0–0.7).\n// ============================================================\nfunction drawRedVignette() {\n\n  if (redVignetteAlpha <= 0) return;\n\n  const grad = ctx.createRadialGradient(CW/2, CH/2, CH * 0.3, CW/2, CH/2, CW * 0.8);\n  grad.addColorStop(0, 'transparent');\n  grad.addColorStop(1, 'rgba(180, 0, 0, ' + redVignetteAlpha + ')');\n  ctx.fillStyle = grad;\n  ctx.fillRect(0, 0, CW, CH);\n}\n\n\n// ============================================================\n//  VICTORY OVERLAY  (HTML layer)\n//  showVictoryOverlay(roundCount)\n//  Injects the victory HTML into #result-overlay and shows it.\n// ============================================================\nfunction showVictoryOverlay(roundCount) {\n\n  const overlay = document.getElementById('result-overlay');\n  if (!overlay) return;\n\n  overlay.className = 'victory';\n\n  overlay.innerHTML =\n    '<div class=\"overlay-inner\">' +\n      '<div class=\"overlay-icon\">&#x1F451;</div>' +\n      '<div class=\"overlay-title\">BOSS DEFEATED!</div>' +\n      '<div class=\"overlay-subtitle\">' +\n        'The Shadow Overlord fell in ' + roundCount + ' rounds.<br>' +\n        'The realm is saved.' +\n      '</div>' +\n      '<button class=\"overlay-btn\" onclick=\"runGame()\">&#x25BA; PLAY AGAIN</button>' +\n    '</div>';\n}\n\n\n// ============================================================\n//  OVERFLOW OVERLAY  (HTML layer)\n//  showOverflowOverlay(roundCount)\n//  Injects the infinite-loop game-over HTML and shows it.\n// ============================================================\nfunction showOverflowOverlay(roundCount) {\n\n  const overlay = document.getElementById('result-overlay');\n  if (!overlay) return;\n\n  overlay.className = 'overflow';\n\n  overlay.innerHTML =\n    '<div class=\"overlay-inner\">' +\n      '<div class=\"overlay-icon\">&#x2620;</div>' +\n      '<div class=\"overlay-title\">INFINITE LOOP DETECTED</div>' +\n      '<div class=\"overlay-subtitle\">' +\n        roundCount + ' ITERATIONS — NO END IN SIGHT' +\n      '</div>' +\n      '<button class=\"overlay-btn\" onclick=\"runGame()\">&#x25BA; TRY AGAIN</button>' +\n    '</div>';\n}\n\n\n// ============================================================\n//  MAIN RENDER LOOP\n//  renderFrame(displayHP, displayRound)\n//  Draws one complete frame onto the canvas.\n//  Called every requestAnimationFrame tick.\n//\n//  displayHP    — current HP value to show in the bar\n//  displayRound — current round number to show\n// ============================================================\n\n// These \"display\" variables are updated by animateEvents() and read by renderFrame()\nlet displayHP    = 100;\nlet displayRound = 0;\n\nfunction renderFrame() {\n\n  frameCount++;\n\n  // Apply screen shake: translate the entire canvas context by a small random amount\n  ctx.save();\n  if (screenShake > 0) {\n    const dx = (Math.random() - 0.5) * screenShake * 2;\n    const dy = (Math.random() - 0.5) * screenShake * 2;\n    ctx.translate(dx, dy);\n    screenShake = Math.max(0, screenShake - 0.5);\n  }\n\n  // 1. Draw the dungeon background\n  drawBackground();\n\n  // 2. Draw all active enemy sprites moving across the screen\n  updateAndDrawEnemies();\n\n  // 3. Draw all fireballs flying from hero to boss\n  updateAndDrawProjectiles();\n\n  // 4. Draw the hero party on the left\n  drawHeroes(0);\n\n  // 5. Draw the boss (unless fully faded out)\n  if (bossAlpha > 0) {\n    drawBoss();\n  }\n\n  // 6. Draw particle effects on top of everything\n  updateAndDrawParticles();\n\n  // 7. Draw screen effects (red vignette for overflow)\n  drawRedVignette();\n\n  // 8. Draw the HUD (HP bar + round counter) last so it's always on top\n  drawHPBar(displayHP, 100, displayRound);\n\n  ctx.restore();\n}\n\n\n// ============================================================\n//  EVENT QUEUE ANIMATOR\n//  animateEvents()\n//  After the while loop finishes and gameEvents is populated,\n//  this function processes one event every EVENT_INTERVAL ms,\n//  updating the visual state and driving the animations.\n// ============================================================\nconst EVENT_INTERVAL = 120; // milliseconds between events\n\nfunction animateEvents() {\n\n  console.log('animateEvents() — processing', gameEvents.length, 'events');\n\n  let eventIndex = 0;\n\n  const ticker = setInterval(function() {\n\n    // Process the next event in the queue\n    if (eventIndex < gameEvents.length) {\n\n      const ev = gameEvents[eventIndex];\n      eventIndex++;\n\n      console.log('Animating event', eventIndex, '/', gameEvents.length, ':', ev.type, ev);\n\n      if (ev.type === 'spawn') {\n        // ── Spawn event: a new enemy rushes toward the heroes ──\n        const groundY  = Math.floor(CH * 0.75);\n        const enemyH   = SPRITE_ENEMY.length * SCALE;\n        const enemySpd = 1.5 + Math.random() * 1.2;\n\n        // Enemies start near the boss and charge left\n        activeEnemies.push({\n          x:           CW - 120 - Math.random() * 60,\n          y:           groundY - enemyH,\n          speed:       enemySpd,\n          alpha:       1.0,\n          spriteScale: SCALE,\n          name:        ev.enemyName,\n          frame:       0,\n          frameTimer:  Math.floor(Math.random() * 8), // stagger so not all in sync\n        });\n\n        // Increment the displayed round counter\n        displayRound = ev.round;\n\n      } else if (ev.type === 'attack') {\n        // ── Attack event: hero fires a fireball at the boss ──\n\n        // Update the HP bar display value\n        displayHP = ev.bossHPAfter;\n\n        // Spawn a fireball flying from the hero toward the boss.\n        // Boss flash is NOT triggered here — it fires when the fireball\n        // visually reaches the boss in updateAndDrawProjectiles().\n        const groundY  = Math.floor(CH * 0.75);\n        const heroH    = SPRITE_HERO.length * SCALE;\n        activeProjectiles.push({\n          x:         HERO_X + SPRITE_HERO[0].length * SCALE, // right edge of hero\n          y:         groundY - heroH + Math.floor(heroH * 0.35), // mid-chest height\n          speed:     4 + Math.random() * 2,\n          alpha:     1.0,\n          triggered: false, // becomes true once the fireball hits the boss\n          bossHP:    ev.bossHPAfter, // carried so we know what HP to display on impact\n        });\n\n      } else if (ev.type === 'defeat') {\n        // ── Defeat event: boss dies ──\n        // Start fading the boss sprite out\n        bossDefeatedAnim = true;\n\n        // Spawn a big explosion of gold particles\n        const bossW  = SPRITE_BOSS[0].length * SCALE;\n        const groundY = Math.floor(CH * 0.75);\n        spawnParticles(\n          CW - bossW / 2 - 50, groundY - 60,\n          60, ['#ffcc00', '#ffaa00', '#ffffff', '#ff8800', '#ffff88'],\n          7, 80\n        );\n\n      } else if (ev.type === 'result') {\n        // ── Result event: game over — show the final overlay ──\n\n        if (ev.safetyCapHit) {\n          // Overflow — intensify the red vignette then show overlay\n          redVignetteAlpha = 0.6;\n          screenShake      = 8;\n\n          // Enemies fill the arena chaotically during overflow\n          const groundY = Math.floor(CH * 0.75);\n          const enemyH  = SPRITE_ENEMY.length * SCALE;\n          for (let j = 0; j < 10; j++) {\n            activeEnemies.push({\n              x:           Math.random() * CW,\n              y:           groundY - enemyH - Math.random() * 60,\n              speed:       2 + Math.random() * 3,\n              alpha:       0.8,\n              spriteScale: SCALE,\n              name:        'overflow',\n              frame:       Math.floor(Math.random() * 2),\n              frameTimer:  Math.floor(Math.random() * 8),\n            });\n          }\n\n          // Short delay so the chaos is visible before the overlay\n          setTimeout(function() { showOverflowOverlay(ev.round); }, 1200);\n\n        } else if (ev.bossDefeated) {\n          // Victory — show the golden overlay after a brief pause\n          setTimeout(function() { showVictoryOverlay(ev.round); }, 900);\n\n        } else {\n          // Edge case: loop ended but neither condition matched\n          setTimeout(function() { showVictoryOverlay(ev.round); }, 900);\n        }\n\n        // Stop the event ticker — all events have been processed\n        clearInterval(ticker);\n        return;\n      }\n\n    } else {\n      // We ran out of events without hitting a 'result' — safety fallback\n      clearInterval(ticker);\n    }\n\n  }, EVENT_INTERVAL);\n}\n\n\n// ============================================================\n//  PUBLIC FUNCTIONS CALLED BY STUDENT CODE\n//  These run synchronously during the while loop in script.js.\n//  They do NOT draw anything — they only push events.\n// ============================================================\n\n\n// ────────────────────────────────────────────────────────────\n// spawnEnemy(round)\n//\n// Called each iteration of the while loop.\n// Increments the iteration counter and pushes a 'spawn' event.\n// If the iteration count exceeds 200, forces the loop to stop.\n//\n// Parameters:\n//   round — the current while loop iteration number\n// ────────────────────────────────────────────────────────────\nfunction spawnEnemy(round) {\n\n  iterationCount++;\n  console.log('spawnEnemy — iteration:', iterationCount, '| round:', round);\n\n  // ── Safety cap: stop the loop before the browser freezes ──\n  if (iterationCount > 200) {\n    safetyCapHit = true;\n    // Writing to bossDefeated exits the while loop because\n    // the student's code uses eval() so their variables are global\n    bossDefeated = true; // eslint-disable-line no-undef\n    console.warn('SAFETY CAP HIT at iteration', iterationCount, '— forcing bossDefeated = true');\n    return;\n  }\n\n  // Pick a random fantasy enemy name\n  const prefixes = ['Shadow','Dark','Cursed','Void','Nether','Phantom','Blighted','Infernal','Hollow','Dread'];\n  const suffixes = ['Wraith','Imp','Specter','Shade','Fiend','Golem','Lurker','Revenant','Stalker','Horror'];\n  const name = prefixes[Math.floor(Math.random() * prefixes.length)] + ' '\n             + suffixes[Math.floor(Math.random() * suffixes.length)];\n\n  // Push the spawn event — animateEvents() will turn it into a moving sprite\n  gameEvents.push({ type: 'spawn', round: round, enemyName: name });\n}\n\n\n// ────────────────────────────────────────────────────────────\n// attackBoss(round)\n//\n// Called each iteration after spawnEnemy().\n// Deals 10–20 damage, clamps bossHP to 0, and pushes an 'attack' event.\n//\n// Parameters:\n//   round — current iteration (used for logging)\n// ────────────────────────────────────────────────────────────\nfunction attackBoss(round) {\n\n  const damage = Math.floor(Math.random() * 11) + 10; // 10–20\n\n  // Read and modify the student's bossHP variable\n  // This works because student code is eval'd into the same scope\n  bossHP = bossHP - damage; // eslint-disable-line no-undef\n  if (bossHP < 0) {\n    bossHP = 0; // eslint-disable-line no-undef\n  }\n\n  console.log('attackBoss — round:', round, '| damage:', damage, '| bossHP now:', bossHP);\n\n  gameEvents.push({\n    type:        'attack',\n    round:       round,\n    damage:      damage,\n    bossHPAfter: bossHP, // eslint-disable-line no-undef\n  });\n}\n\n\n// ────────────────────────────────────────────────────────────\n// showResult(round)\n//\n// Called once after the while loop ends.\n// Pushes a 'result' event and then starts the animation engine.\n//\n// Parameters:\n//   round — final loop iteration count\n// ────────────────────────────────────────────────────────────\nfunction showResult(round) {\n\n  console.log(\n    'showResult — round:', round,\n    '| bossDefeated:', (typeof bossDefeated !== 'undefined') ? bossDefeated : '(not defined)', // eslint-disable-line no-undef\n    '| safetyCapHit:', safetyCapHit\n  );\n\n  // If the boss was defeated legitimately, push a 'defeat' event\n  // so the animation engine can play the boss-death effect\n  if (typeof bossDefeated !== 'undefined' && bossDefeated === true && !safetyCapHit) { // eslint-disable-line no-undef\n    gameEvents.push({ type: 'defeat' });\n  }\n\n  // Push the final result event — animateEvents() shows the overlay when it reaches this\n  gameEvents.push({\n    type:         'result',\n    round:        round,\n    safetyCapHit: safetyCapHit,\n    bossDefeated: (typeof bossDefeated !== 'undefined') ? bossDefeated : false, // eslint-disable-line no-undef\n  });\n\n  // Kick off the animated battle replay\n  animateEvents();\n}\n\n\n// ============================================================\n//  RENDER LOOP STARTUP\n//  Starts requestAnimationFrame immediately on page load.\n//  This keeps the canvas alive and animates sprites/particles\n//  even while the event queue is being processed.\n// ============================================================\nfunction startRenderLoop() {\n\n  function tick() {\n    // If the boss defeat animation is running, fade it out gradually\n    if (bossDefeatedAnim && bossAlpha > 0) {\n      bossAlpha = Math.max(0, bossAlpha - 0.012);\n    }\n\n    renderFrame();\n    requestAnimationFrame(tick);\n  }\n\n  requestAnimationFrame(tick);\n}\n\n// Start the render loop right away\nstartRenderLoop();\n\n\n// ============================================================\n//  runGame()\n//  Called by the \"PLAY AGAIN\" button in the result overlay.\n//  Re-fetches (or reuses) the student's script.js source,\n//  resets all state, and re-evals the code.\n// ============================================================\nfunction runGame() {\n\n  console.log('--- runGame() called ---');\n\n  // ── Reset all animation and game state ──\n  gameEvents         = [];\n  iterationCount     = 0;\n  safetyCapHit       = false;\n  activeEnemies      = [];\n  activeProjectiles  = [];\n  particles          = [];\n  bossFlashTimer     = 0;\n  bossAlpha          = 1.0;\n  bossDefeatedAnim   = false;\n  screenShake        = 0;\n  redVignetteAlpha   = 0;\n  displayHP          = 100;\n  displayRound       = 0;\n\n  // ── Hide the result overlay ──\n  const overlay = document.getElementById('result-overlay');\n  if (overlay) {\n    overlay.className = 'hidden';\n    overlay.innerHTML = '';\n  }\n\n  // ── Re-run the student code ──\n  if (studentCodeSource) {\n    evalStudentCode(studentCodeSource);\n  } else {\n    // First time or fetch failed — try fetching again\n    fetchAndRunStudentCode();\n  }\n}\n\n\n// ────────────────────────────────────────────────────────────\n// evalStudentCode(source)\n//\n// Strips 'let' and 'const' from variable declarations so the\n// student's bossHP, bossDefeated, and round variables become\n// globals that attackBoss() and spawnEnemy() can read and write.\n//\n// This is an intentional teaching pattern — eval() lets students\n// run real JS code without a build step or server.\n// Never use eval() with untrusted input in a real production app.\n// ────────────────────────────────────────────────────────────\nfunction evalStudentCode(source) {\n\n  // Strip 'let' and 'const' so declarations become implicit globals\n  const executableCode = source\n    .replace(/\\blet\\b/g, '')\n    .replace(/\\bconst\\b/g, '');\n\n  console.log('evalStudentCode — running', executableCode.length, 'characters of student code');\n\n  try {\n    eval(executableCode); // eslint-disable-line no-eval\n    console.log('Student code finished executing successfully.');\n  } catch (err) {\n    console.error('Error in student code:', err.toString());\n    // Show the error as a canvas overlay so the student knows something went wrong\n    showErrorOnCanvas(err.toString());\n  }\n}\n\n\n// ────────────────────────────────────────────────────────────\n// showErrorOnCanvas(message)\n//\n// When student code has a syntax error, this draws a simple\n// error message directly onto the canvas so students can see it\n// without any HTML clutter.\n// ────────────────────────────────────────────────────────────\nfunction showErrorOnCanvas(message) {\n\n  // Draw a dark error box in the center of the canvas\n  ctx.fillStyle = 'rgba(10, 0, 0, 0.85)';\n  ctx.fillRect(20, CH / 2 - 60, CW - 40, 120);\n  ctx.strokeStyle = '#cc0000';\n  ctx.lineWidth = 2;\n  ctx.strokeRect(20, CH / 2 - 60, CW - 40, 120);\n\n  ctx.fillStyle = '#ff4444';\n  ctx.font = '10px \"Press Start 2P\"';\n  ctx.fillText('CODE ERROR', 36, CH / 2 - 32);\n\n  ctx.fillStyle = '#ffaaaa';\n  ctx.font = '8px \"Press Start 2P\"';\n\n  // Wrap the error message across multiple lines\n  const words = message.split(' ');\n  let line = '';\n  let lineY = CH / 2 - 8;\n  const maxW = CW - 80;\n\n  for (let w = 0; w < words.length; w++) {\n    const test = line + words[w] + ' ';\n    if (ctx.measureText(test).width > maxW && line !== '') {\n      ctx.fillText(line, 36, lineY);\n      line  = words[w] + ' ';\n      lineY += 18;\n      if (lineY > CH / 2 + 50) break; // stop if we run out of box space\n    } else {\n      line = test;\n    }\n  }\n  if (line.trim()) {\n    ctx.fillText(line, 36, lineY);\n  }\n}\n\n\n// ────────────────────────────────────────────────────────────\n// fetchAndRunStudentCode()\n//\n// Fetches script.js via the Fetch API, stores its source, and\n// evals it. This is how the game gets the student's code on\n// first load and for subsequent \"Play Again\" reruns.\n// ────────────────────────────────────────────────────────────\nfunction fetchAndRunStudentCode() {\n\n  // Add a cache-busting timestamp so the browser always gets the latest save\n  const url = 'script.js?t=' + Date.now();\n\n  console.log('Fetching student code from', url);\n\n  fetch(url)\n    .then(function(response) {\n      if (!response.ok) {\n        throw new Error('Could not load script.js (HTTP ' + response.status + ')');\n      }\n      return response.text();\n    })\n    .then(function(source) {\n      studentCodeSource = source;\n      console.log('script.js fetched —', source.length, 'characters');\n      evalStudentCode(source);\n    })\n    .catch(function(err) {\n      console.error('fetchAndRunStudentCode failed:', err);\n      showErrorOnCanvas('Could not load script.js: ' + err.message);\n    });\n}\n\n\n// ============================================================\n//  BOOTSTRAP\n//  When helpers.js finishes loading, it immediately fetches\n//  script.js, stores its source, and evals it.\n//\n//  Why fetch+eval instead of <script src=\"script.js\">?\n//    Because a <script> tag executes 'let bossHP = 100' as a\n//    block-scoped declaration, so bossHP lives in script scope —\n//    NOT on window.  attackBoss() and spawnEnemy() reference bossHP\n//    as a global (window.bossHP), so they would see undefined.\n//\n//    By stripping 'let'/'const' before eval(), the declarations\n//    become bare assignments (bossHP = 100), which write to\n//    window.bossHP — exactly where the helper functions look.\n//\n//  Cache-bust parameter ensures students always get their latest save.\n// ============================================================\nfetchAndRunStudentCode();\n",
          "folderId": "0",
          "active": false,
          "type": "starter"
        },
        "4": {
          "id": "4",
          "name": "script.js",
          "contents": "// Boss starts with 100 HP. Enemies keep spawning until boss is defeated.\nlet bossHP = 100;\nlet bossDefeated = false;\nlet round = 0;\n\nwhile (bossDefeated === false) {\n    round++;\n    spawnEnemy(round);\n    attackBoss(round);\n  // What information should the loop use to decide when the battle is over?\n\n    \n}\n\nshowResult(round);\n",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "4",
        "2"
      ]
    },
