<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-10-23T16:05:30.000Z",
  "level_num": "custom",
  "user_id": 18603,
  "properties": {
    "encrypted": "false",
    "long_instructions": "# Pixel Plaza Chat\r\n\r\nExplore this simulated chat from a game called Pixel Plaza. With your partner, determine the types of messages that the chat system blocks or hides.\r\n",
    "offer_browser_tts": "false",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "true",
    "require_edit_to_continue": "true",
    "initial_view_mode": "split",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "placeholderText": "",
      "multipleChoiceOptions": [
        ""
      ],
      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false
    },
    "ai_tutor_prompt_settings": {
      "answerTypes": [
        "ask"
      ],
      "answerTypeCustomizations": {
      }
    },
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Pixel Plaza Chat</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"app\" id=\"app\">\n    <h1 class=\"visually-hidden\" data-copy=\"appTitle\"></h1>\n\n    <div class=\"rail\">\n      <section class=\"progress-box\" id=\"progress-box\" aria-labelledby=\"progress-heading\">\n        <h2 class=\"visually-hidden\" id=\"progress-heading\" data-copy=\"progressHeading\"></h2>\n        <div class=\"set-row\">\n          <ol class=\"progress-dots\" id=\"progress-dots\" aria-hidden=\"true\"></ol>\n          <p class=\"set-count\" id=\"set-count\"></p>\n        </div>\n        <p class=\"goal\" id=\"goal\"></p>\n        <p class=\"found-count\" id=\"found-count\"></p>\n      </section>\n\n      <section class=\"tray-section\" id=\"tray-section\" aria-labelledby=\"tray-heading\">\n        <h2 class=\"visually-hidden\" id=\"tray-heading\" data-copy=\"trayHeading\"></h2>\n        <p class=\"hint\" id=\"hint\" data-copy=\"hint\"></p>\n        <ul class=\"tray\" id=\"tray\"></ul>\n      </section>\n\n      <section class=\"panel think\" id=\"think\" aria-labelledby=\"think-heading\" hidden>\n        <h2 class=\"panel-heading\" id=\"think-heading\" tabindex=\"-1\" data-copy=\"thinkHeading\"></h2>\n        <ul class=\"think-pair\" id=\"think-pair\"></ul>\n        <p class=\"think-question\" id=\"think-question\"></p>\n        <p class=\"think-talk\" data-copy=\"thinkTalk\"></p>\n        <button type=\"button\" class=\"think-next\" id=\"think-next\" hidden></button>\n      </section>\n\n      <section class=\"panel done\" id=\"done\" aria-labelledby=\"done-heading\" hidden>\n        <h2 class=\"panel-heading\" id=\"done-heading\" tabindex=\"-1\" data-copy=\"doneHeading\"></h2>\n        <p class=\"done-text\" data-copy=\"doneText\"></p>\n      </section>\n\n      <p class=\"status\" id=\"status\" role=\"status\" aria-live=\"polite\"></p>\n\n      <button type=\"button\" class=\"start-over\" id=\"start-over\" data-copy=\"startOver\"></button>\n    </div>\n\n    <section class=\"chat\" aria-labelledby=\"chat-title\">\n      <div class=\"chat-titlebar\">\n        <span class=\"window-dots\" aria-hidden=\"true\"><span></span><span></span><span></span></span>\n        <h2 class=\"chat-title\" id=\"chat-title\" data-copy=\"chatTitle\"></h2>\n      </div>\n      <p class=\"chat-with\" data-copy=\"chatWith\"></p>\n      <ol class=\"feed\" id=\"feed\"></ol>\n      <div class=\"send-area\">\n        <button type=\"button\" class=\"send-zone\" id=\"send-zone\" data-copy=\"send\"></button>\n        <div class=\"mute-panel\" id=\"mute-panel\" tabindex=\"-1\" hidden>\n          <p class=\"mute-title\" id=\"mute-title\"></p>\n          <div class=\"mute-bar\" aria-hidden=\"true\"><div class=\"mute-bar-fill\" id=\"mute-fill\"></div></div>\n          <p class=\"mute-count\" id=\"mute-count\"></p>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <p class=\"app-error\" id=\"app-error\" role=\"alert\" hidden>Something went wrong while loading this activity. Try reloading the page.</p>\n  <noscript><p class=\"app-error\">This activity needs JavaScript to run. Ask your teacher for help.</p></noscript>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "'use strict';\n\nconst COPY = {\n  appTitle: 'Pixel Plaza',\n  progressHeading: 'Progress',\n  trayHeading: 'Messages you can send',\n  chatTitle: 'Pixel Plaza Chat',\n  chatWith: 'Chatting with Sam (friend) and the Plaza',\n  feedLabel: 'Chat messages',\n  hint: 'Pick a message, then send it.',\n  send: 'Send',\n  sendSelected: (text) => `Send: ${text}`,\n  report: 'Report',\n  reportLabel: (name) => `Report the message from ${name}`,\n  startOver: 'Start over',\n  input: 'Input',\n  output: 'Output',\n  tags: {\n    sent: 'Sent',\n    blocked: 'Blocked',\n    hidden: 'Hidden',\n    changed: 'Changed',\n    muted: 'Muted',\n    reported: 'Reported',\n  },\n  hiddenNote: 'Other players can’t see this message.',\n  setCount: (current, total) => `Set ${current} of ${total}`,\n  goal: {\n    one: () => 'Find the message the chat stops.',\n    other: (count) => `Find the ${count} messages the chat stops.`,\n  },\n  foundCount: (found, total) => `${found} of ${total} found`,\n  thinkHeading: 'Stop and think',\n  thinkTalk: 'Talk about it with your partner.',\n  next: 'Next messages',\n  finish: 'Finish',\n  newSet: (current) => `Set ${current}. You have new messages to try.`,\n  doneHeading: 'All done!',\n  doneText: 'You tried every set. Good job!',\n  typing: (name) => `${name} is typing`,\n  result: (text, output) => `You sent: ${text}. Output: ${output}.`,\n  resultChanged: (text, newText) => `You sent: ${text}. Output: Changed. It now says: ${newText}.`,\n  mutedTitle: (minutes) => `Muted for ${minutes} minutes`,\n  mutedNow: (minutes) => `You are muted for ${minutes} minutes.`,\n  minutesLeft: {\n    one: (minutes) => `${minutes} minute left`,\n    other: (minutes) => `${minutes} minutes left`,\n  },\n  unmuted: 'You can chat again.',\n  incoming: (name, text) => `${name} says: ${text}`,\n  reportThanks: 'Thanks! This helps the chat get better.',\n  reset: 'The chat started over.',\n};\n\nconst CONFIG = {\n  feedLimit: 20,\n  hiddenLimit: 3,\n  mute: { minutesShown: 10, seconds: 10 },\n  timing: {\n    outputDelayMs: 500,\n    replyDelayMs: 700,\n    typingMs: 1100,\n    replyGapMs: 600,\n    thinkDelayMs: 1400,\n    nextButtonDelayMs: 5000,\n  },\n  rules: {\n    phoneDigits: 10,\n    linkPatterns: ['.com', '.net', '.org', 'www.'],\n    bannedWords: ['trash'],\n  },\n  players: {\n    you: { name: 'You', initial: 'Y', color: '#4c42cf' },\n    sam: { name: 'Sam (friend)', initial: 'S', color: '#06338d' },\n    blaze: { name: 'Blaze77', initial: 'B', color: '#611d00' },\n    kat: { name: 'PixelKat', initial: 'P', color: '#7d0c3d' },\n  },\n  // Each round shows its messages together. The widget works out which ones the chat\n  // stops by running the rules, and the round ends once every stopped message has been sent.\n  // Aim for 2 that go through and 2 that get stopped by the same step.\n  rounds: [\n    {\n      think: 'One of these is mean and one isn’t. Why did the chat block both?',\n      messages: [\n        { text: 'gg that was so fun', replies: [{ from: 'sam', text: 'ya that was crazy' }, { from: 'kat', text: 'gg' }] },\n        { text: 'that boss fight was so hard', replies: [{ from: 'sam', text: 'fr i almost died like 5 times' }] },\n        { text: 'ur trash at this game', putsSomeoneDown: true },\n        { text: 'brb gotta take out the trash' },\n      ],\n    },\n    {\n      think: 'Neither of these is mean. What made the chat block them?',\n      messages: [\n        { text: 'i have 2500 coins', replies: [{ from: 'sam', text: 'whoa how' }, { from: 'blaze', text: 'thats it? i have 9000' }] },\n        { text: 'WE WON!!!', replies: [{ from: 'sam', text: 'lets gooo' }, { from: 'kat', text: 'gg that was close' }] },\n        { text: 'text me 5551234567' },\n        { text: 'my high score is 1234567890!!' },\n      ],\n    },\n    {\n      think: 'Both of these got blocked. What is the same about them?',\n      messages: [\n        { text: 'my build is at coolbuilds dot com', replies: [{ from: 'sam', text: 'omg ur castle is so cool' }, { from: 'kat', text: 'how did u make the bridge' }] },\n        { text: 'who wants to build with me', replies: [{ from: 'sam', text: 'me!!' }, { from: 'kat', text: 'i can help after this round' }] },\n        { text: 'check out my build at coolbuilds.com' },\n        { text: 'join my server at www.blockparty.net' },\n      ],\n    },\n    {\n      think: 'How do you think the chat knew to block these two?',\n      messages: [\n        { text: 'how do u get coins fast', replies: [{ from: 'kat', text: 'do the daily quests' }, { from: 'sam', text: 'ya the quests are easy' }] },\n        { text: 'i got a free skin from the event', replies: [{ from: 'sam', text: 'wait which one' }, { from: 'kat', text: 'the dragon one?? so jealous' }] },\n        { text: 'FREE COINS go to coins dot net', looksLikeScam: true },\n        { text: 'send me ur password and ill give u 5000 coins', looksLikeScam: true },\n      ],\n    },\n    {\n      think: 'These got hidden, not blocked. What is different about them?',\n      messages: [\n        { text: 'ur so good at this', replies: [{ from: 'sam', text: 'thx lol' }] },\n        { text: 'can i be on ur team?', replies: [{ from: 'blaze', text: 'no ur team is so slow lol' }, { from: 'sam', text: 'u can be on mine' }] },\n        { text: 'nobody wants u on our team', putsSomeoneDown: true },\n        { text: 'go away no one likes u', putsSomeoneDown: true },\n      ],\n    },\n    {\n      think: 'You got muted. Was that fair? Who decided that should happen?',\n      messages: [\n        { text: 'sam ur so funny', replies: [{ from: 'sam', text: 'i know lol' }] },\n        { text: 'wanna play again?', replies: [{ from: 'sam', text: 'ya one more' }, { from: 'kat', text: 'me too' }] },\n        { text: 'ur so bad at this lol', putsSomeoneDown: true },\n        { text: 'sam u fell in the lava AGAIN lol', putsSomeoneDown: true },\n      ],\n    },\n  ],\n};\n\nconst SVG_NS = 'http://www.w3.org/2000/svg';\nconst DRAG_THRESHOLD_PX = 8;\nconst CLICK_AFTER_DRAG_MS = 400;\nconst CAUGHT = ['blocked', 'hidden'];\n\nconst locale = document.documentElement.lang || 'en';\nconst numberFormat = new Intl.NumberFormat(locale);\nconst pluralRules = new Intl.PluralRules(locale);\nconst messagesById = {};\nconst timers = new Set();\nlet rounds = [];\nlet els = {};\nlet state = createState();\n\nfunction createState() {\n  return {\n    roundIndex: 0,\n    order: [],\n    found: new Set(),\n    roundLocked: false,\n    thinkPending: false,\n    selectedId: null,\n    hiddenCount: 0,\n    muted: false,\n    muteInterval: null,\n    replyQueue: [],\n    replying: false,\n    drag: null,\n    dragEndedAt: -Infinity,\n  };\n}\n\n/* Setup */\n\nfunction init() {\n  els = {\n    progressBox: document.getElementById('progress-box'),\n    progressDots: document.getElementById('progress-dots'),\n    setCount: document.getElementById('set-count'),\n    goal: document.getElementById('goal'),\n    foundCount: document.getElementById('found-count'),\n    traySection: document.getElementById('tray-section'),\n    hint: document.getElementById('hint'),\n    tray: document.getElementById('tray'),\n    think: document.getElementById('think'),\n    thinkHeading: document.getElementById('think-heading'),\n    thinkPair: document.getElementById('think-pair'),\n    thinkQuestion: document.getElementById('think-question'),\n    thinkNext: document.getElementById('think-next'),\n    done: document.getElementById('done'),\n    doneHeading: document.getElementById('done-heading'),\n    status: document.getElementById('status'),\n    startOver: document.getElementById('start-over'),\n    feed: document.getElementById('feed'),\n    sendZone: document.getElementById('send-zone'),\n    mutePanel: document.getElementById('mute-panel'),\n    muteTitle: document.getElementById('mute-title'),\n    muteFill: document.getElementById('mute-fill'),\n    muteCount: document.getElementById('mute-count'),\n  };\n  Object.keys(els).forEach((key) => {\n    if (!els[key]) {\n      throw new Error(`Missing element: ${key}`);\n    }\n  });\n\n  buildRounds();\n  fillStaticCopy();\n  bindEvents();\n  resetActivity(false);\n}\n\nfunction buildRounds() {\n  rounds = CONFIG.rounds.map((round, roundIndex) => {\n    const ids = round.messages.map((message, messageIndex) => {\n      const id = `r${roundIndex + 1}m${messageIndex + 1}`;\n      if (typeof message.text !== 'string' || !message.text) {\n        throw new Error(`Message ${id} needs text.`);\n      }\n      (message.replies || []).forEach((reply) => {\n        if (!CONFIG.players[reply.from]) {\n          throw new Error(`Unknown player in a reply to ${id}: ${reply.from}`);\n        }\n      });\n      messagesById[id] = Object.assign({ id, looksLikeScam: false, putsSomeoneDown: false, replies: [] }, message);\n      return id;\n    });\n    const caughtIds = ids.filter((id) => CAUGHT.includes(runChatRules(messagesById[id]).outcome));\n    if (caughtIds.length === 0) {\n      throw new Error(`Round ${roundIndex + 1} needs at least one message the chat stops.`);\n    }\n    return { think: round.think, ids, caughtIds };\n  });\n}\n\nfunction fillStaticCopy() {\n  document.querySelectorAll('[data-copy]').forEach((el) => {\n    el.textContent = COPY[el.dataset.copy];\n  });\n  els.feed.setAttribute('aria-label', COPY.feedLabel);\n  els.muteTitle.textContent = COPY.mutedTitle(numberFormat.format(CONFIG.mute.minutesShown));\n}\n\nfunction bindEvents() {\n  els.tray.addEventListener('click', onTrayClick);\n  els.tray.addEventListener('pointerdown', onTrayPointerDown);\n  document.addEventListener('pointermove', onPointerMove);\n  document.addEventListener('pointerup', onPointerUp);\n  document.addEventListener('pointercancel', cancelDrag);\n  document.addEventListener('keydown', onKeyDown);\n  els.sendZone.addEventListener('click', onSendZoneClick);\n  els.feed.addEventListener('click', onFeedClick);\n  els.thinkNext.addEventListener('click', onThinkNext);\n  els.startOver.addEventListener('click', () => resetActivity(true));\n}\n\nfunction resetActivity(announce) {\n  clearTimers();\n  cancelDrag();\n  state = createState();\n\n  els.feed.textContent = '';\n  els.hint.hidden = false;\n  els.mutePanel.hidden = true;\n  els.sendZone.hidden = false;\n  els.done.hidden = true;\n\n  startRound();\n  if (announce) {\n    setStatus(COPY.reset);\n  } else {\n    els.status.textContent = '';\n  }\n}\n\n/* Timers */\n\nfunction later(fn, ms) {\n  const id = setTimeout(() => {\n    timers.delete(id);\n    fn();\n  }, ms);\n  timers.add(id);\n}\n\nfunction clearTimers() {\n  timers.forEach((id) => clearTimeout(id));\n  timers.clear();\n  clearInterval(state.muteInterval);\n}\n\n/* Chat rules */\n\nfunction isAllCaps(text) {\n  return text === text.toUpperCase() && text !== text.toLowerCase();\n}\n\nfunction hasPhoneNumber(text) {\n  return new RegExp(`\\\\d{${CONFIG.rules.phoneDigits},}`).test(text);\n}\n\nfunction hasLink(text) {\n  const lower = text.toLowerCase();\n  return CONFIG.rules.linkPatterns.some((pattern) => lower.includes(pattern));\n}\n\nfunction hasBannedWord(text) {\n  const words = text.toLowerCase().match(/[\\p{L}\\p{N}']+/gu) || [];\n  return words.some((word) => CONFIG.rules.bannedWords.includes(word));\n}\n\nfunction runChatRules(message) {\n  let text = message.text;\n  let changed = false;\n\n  if (isAllCaps(text)) {\n    text = text.toLowerCase();\n    changed = true;\n  }\n  if (hasPhoneNumber(text) || hasLink(text) || hasBannedWord(text) || message.looksLikeScam) {\n    return { outcome: 'blocked', text, changed };\n  }\n  if (message.putsSomeoneDown) {\n    return { outcome: 'hidden', text, changed };\n  }\n  return { outcome: changed ? 'changed' : 'sent', text, changed };\n}\n\n/* Rounds */\n\nfunction currentRound() {\n  return rounds[state.roundIndex];\n}\n\nfunction startRound() {\n  state.found = new Set();\n  state.roundLocked = false;\n  state.thinkPending = false;\n  state.selectedId = null;\n  state.order = shuffle(currentRound().ids);\n\n  els.think.hidden = true;\n  els.traySection.hidden = false;\n  renderTray();\n  setStickersDisabled(state.muted);\n  renderProgress();\n  updateSelection();\n}\n\nfunction renderProgress() {\n  const round = currentRound();\n  const total = rounds.length;\n\n  els.progressDots.textContent = '';\n  rounds.forEach((r, index) => {\n    const dot = document.createElement('li');\n    dot.className = 'progress-dot';\n    if (index < state.roundIndex || (index === state.roundIndex && state.roundLocked)) {\n      dot.classList.add('is-done');\n    } else if (index === state.roundIndex) {\n      dot.classList.add('is-current');\n    }\n    els.progressDots.appendChild(dot);\n  });\n\n  els.setCount.textContent = COPY.setCount(numberFormat.format(state.roundIndex + 1), numberFormat.format(total));\n  const caughtCount = round.caughtIds.length;\n  const goalText = COPY.goal[pluralRules.select(caughtCount)] || COPY.goal.other;\n  els.goal.textContent = goalText(numberFormat.format(caughtCount));\n  els.foundCount.textContent = COPY.foundCount(numberFormat.format(state.found.size), numberFormat.format(caughtCount));\n}\n\nfunction popProgress() {\n  els.progressBox.classList.remove('is-popping');\n  void els.progressBox.offsetWidth;\n  els.progressBox.classList.add('is-popping');\n}\n\nfunction maybeShowThink() {\n  if (!state.thinkPending || state.muted) {\n    return;\n  }\n  state.thinkPending = false;\n  showThink();\n}\n\nfunction showThink() {\n  const round = currentRound();\n  els.thinkPair.textContent = '';\n  round.caughtIds.forEach((id) => {\n    const message = messagesById[id];\n    const result = runChatRules(message);\n    const li = document.createElement('li');\n    li.className = 'think-item';\n    li.appendChild(makeBubble(result.text, result.outcome));\n    const tag = makeTag(result.outcome);\n    tag.classList.remove('tag-pop');\n    li.appendChild(tag);\n    els.thinkPair.appendChild(li);\n  });\n  els.thinkQuestion.textContent = round.think;\n  els.thinkNext.textContent = state.roundIndex === rounds.length - 1 ? COPY.finish : COPY.next;\n  els.thinkNext.hidden = true;\n\n  els.traySection.hidden = true;\n  els.think.hidden = false;\n  els.thinkHeading.focus();\n  later(() => {\n    els.thinkNext.hidden = false;\n  }, CONFIG.timing.nextButtonDelayMs);\n}\n\nfunction onThinkNext() {\n  if (state.roundIndex === rounds.length - 1) {\n    showDone();\n  } else {\n    state.roundIndex += 1;\n    startRound();\n    setStatus(COPY.newSet(numberFormat.format(state.roundIndex + 1)));\n    const firstSticker = els.tray.querySelector('.sticker');\n    if (firstSticker) {\n      firstSticker.focus();\n    }\n  }\n  later(pumpReplies, CONFIG.timing.replyDelayMs);\n}\n\nfunction showDone() {\n  els.think.hidden = true;\n  els.done.hidden = false;\n  els.doneHeading.focus();\n}\n\n/* Tray and selection */\n\nfunction renderTray() {\n  els.tray.textContent = '';\n  state.order.forEach((id) => {\n    const li = document.createElement('li');\n    const button = document.createElement('button');\n    button.type = 'button';\n    button.className = 'sticker';\n    button.dataset.id = id;\n    button.textContent = messagesById[id].text;\n    button.setAttribute('aria-pressed', 'false');\n    li.appendChild(button);\n    els.tray.appendChild(li);\n  });\n}\n\nfunction setStickersDisabled(disabled) {\n  els.tray.querySelectorAll('.sticker').forEach((button) => {\n    button.disabled = disabled;\n  });\n}\n\nfunction canSend() {\n  return !state.muted && !state.roundLocked;\n}\n\nfunction selectMessage(id) {\n  state.selectedId = id;\n  updateSelection();\n}\n\nfunction clearSelection() {\n  state.selectedId = null;\n  updateSelection();\n}\n\nfunction updateSelection() {\n  els.tray.querySelectorAll('.sticker').forEach((button) => {\n    button.setAttribute('aria-pressed', String(button.dataset.id === state.selectedId));\n  });\n  const selected = messagesById[state.selectedId];\n  els.sendZone.classList.toggle('is-open', Boolean(selected));\n  if (selected) {\n    els.sendZone.setAttribute('aria-label', COPY.sendSelected(selected.text));\n  } else {\n    els.sendZone.removeAttribute('aria-label');\n  }\n}\n\nfunction onTrayClick(event) {\n  const button = event.target.closest('.sticker');\n  if (!button || !canSend()) {\n    return;\n  }\n  if (performance.now() - state.dragEndedAt < CLICK_AFTER_DRAG_MS) {\n    return;\n  }\n  const id = button.dataset.id;\n  if (state.selectedId === id) {\n    sendMessage(id);\n  } else {\n    selectMessage(id);\n  }\n}\n\nfunction onSendZoneClick() {\n  if (state.selectedId) {\n    sendMessage(state.selectedId);\n  } else if (canSend()) {\n    setStatus(COPY.hint);\n  }\n}\n\nfunction onKeyDown(event) {\n  if (event.key === 'Escape') {\n    cancelDrag();\n    clearSelection();\n  }\n}\n\n/* Dragging */\n\nfunction onTrayPointerDown(event) {\n  const button = event.target.closest('.sticker');\n  if (!button || button.disabled || !canSend()) {\n    return;\n  }\n  if (event.pointerType === 'mouse' && event.button !== 0) {\n    return;\n  }\n  state.drag = { id: button.dataset.id, startX: event.clientX, startY: event.clientY, ghost: null };\n}\n\nfunction onPointerMove(event) {\n  const drag = state.drag;\n  if (!drag) {\n    return;\n  }\n  if (!drag.ghost) {\n    const distance = Math.hypot(event.clientX - drag.startX, event.clientY - drag.startY);\n    if (distance < DRAG_THRESHOLD_PX) {\n      return;\n    }\n    drag.ghost = createGhost(drag.id);\n    selectMessage(drag.id);\n  }\n  event.preventDefault();\n  moveGhost(drag.ghost, event.clientX, event.clientY);\n  els.sendZone.classList.toggle('is-over', isOverSendZone(event.clientX, event.clientY));\n}\n\nfunction onPointerUp(event) {\n  const drag = state.drag;\n  if (!drag) {\n    return;\n  }\n  const droppedOnSend = Boolean(drag.ghost) && isOverSendZone(event.clientX, event.clientY);\n  if (drag.ghost) {\n    state.dragEndedAt = performance.now();\n  }\n  cancelDrag();\n  if (droppedOnSend) {\n    sendMessage(drag.id);\n  }\n}\n\nfunction cancelDrag() {\n  if (state.drag && state.drag.ghost) {\n    state.drag.ghost.remove();\n  }\n  state.drag = null;\n  if (els.sendZone) {\n    els.sendZone.classList.remove('is-over');\n  }\n}\n\nfunction createGhost(id) {\n  const ghost = document.createElement('div');\n  ghost.className = 'sticker-ghost';\n  ghost.setAttribute('aria-hidden', 'true');\n  ghost.textContent = messagesById[id].text;\n  document.body.appendChild(ghost);\n  return ghost;\n}\n\nfunction moveGhost(ghost, x, y) {\n  const left = x - ghost.offsetWidth / 2;\n  const top = y - ghost.offsetHeight / 2;\n  ghost.style.transform = `translate(${left}px, ${top}px) rotate(-4deg)`;\n}\n\nfunction isOverSendZone(x, y) {\n  if (els.sendZone.hidden) {\n    return false;\n  }\n  const rect = els.sendZone.getBoundingClientRect();\n  return x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom;\n}\n\n/* Sending */\n\nfunction sendMessage(id) {\n  const message = messagesById[id];\n  if (!canSend() || !message) {\n    return;\n  }\n  clearSelection();\n  els.hint.hidden = true;\n\n  const result = runChatRules(message);\n  let startsMute = false;\n  if (result.outcome === 'hidden') {\n    state.hiddenCount += 1;\n    if (state.hiddenCount >= CONFIG.hiddenLimit) {\n      state.muted = true;\n      startsMute = true;\n    }\n  }\n\n  let endsRound = false;\n  if (CAUGHT.includes(result.outcome)) {\n    state.found.add(id);\n    if (state.found.size === currentRound().caughtIds.length) {\n      state.roundLocked = true;\n      state.thinkPending = true;\n      endsRound = true;\n    }\n  }\n\n  const item = addOwnMessage(message.text);\n  later(() => showResult(item, message, result, startsMute, endsRound), CONFIG.timing.outputDelayMs);\n}\n\nfunction showResult(item, message, result, startsMute, endsRound) {\n  if (result.changed) {\n    item.bubble.textContent = result.text;\n  }\n  item.result.hidden = false;\n  item.result.appendChild(makeTag(result.outcome));\n\n  if (result.outcome === 'blocked') {\n    item.bubble.classList.add('is-blocked', 'is-shaking');\n  } else if (result.outcome === 'hidden') {\n    item.bubble.classList.add('is-hidden');\n    item.note.hidden = false;\n  }\n\n  let announcement = result.outcome === 'changed'\n    ? COPY.resultChanged(message.text, result.text)\n    : COPY.result(message.text, COPY.tags[result.outcome]);\n\n  if (startsMute) {\n    item.result.appendChild(makeTag('muted'));\n    announcement = `${announcement} ${COPY.mutedNow(numberFormat.format(CONFIG.mute.minutesShown))}`;\n  }\n\n  if (CAUGHT.includes(result.outcome)) {\n    renderProgress();\n    popProgress();\n  }\n  if (endsRound) {\n    clearSelection();\n    setStickersDisabled(true);\n    later(maybeShowThink, CONFIG.timing.thinkDelayMs);\n  }\n\n  setStatus(announcement);\n  if (startsMute) {\n    startMute();\n  }\n  if (result.outcome === 'sent' || result.outcome === 'changed') {\n    queueReplies(message.replies);\n  }\n  scrollFeedToEnd();\n}\n\n/* Feed */\n\nfunction addOwnMessage(text) {\n  const li = document.createElement('li');\n  li.className = 'msg msg-self';\n  li.appendChild(makeAvatar(CONFIG.players.you));\n\n  const body = document.createElement('div');\n  body.className = 'msg-body';\n  body.appendChild(makeMeta(CONFIG.players.you.name, COPY.input));\n\n  const bubble = makeBubble(text, null);\n  body.appendChild(bubble);\n\n  const result = document.createElement('div');\n  result.className = 'msg-result';\n  result.hidden = true;\n  const outputLabel = document.createElement('span');\n  outputLabel.className = 'io-label';\n  outputLabel.textContent = COPY.output;\n  result.appendChild(outputLabel);\n  body.appendChild(result);\n\n  const note = document.createElement('p');\n  note.className = 'msg-note';\n  note.textContent = COPY.hiddenNote;\n  note.hidden = true;\n  body.appendChild(note);\n\n  li.appendChild(body);\n  appendToFeed(li);\n  return { bubble, result, note };\n}\n\nfunction addOtherMessage(reply) {\n  const player = CONFIG.players[reply.from];\n  const li = document.createElement('li');\n  li.className = 'msg msg-other';\n  li.appendChild(makeAvatar(player));\n\n  const body = document.createElement('div');\n  body.className = 'msg-body';\n  body.appendChild(makeMeta(player.name, null));\n\n  const bubble = document.createElement('p');\n  bubble.className = 'bubble';\n  bubble.textContent = reply.text;\n  body.appendChild(bubble);\n\n  const actions = document.createElement('div');\n  actions.className = 'msg-actions';\n  const report = document.createElement('button');\n  report.type = 'button';\n  report.className = 'report-button';\n  report.textContent = COPY.report;\n  report.setAttribute('aria-label', COPY.reportLabel(player.name));\n  actions.appendChild(report);\n  body.appendChild(actions);\n\n  li.appendChild(body);\n  appendToFeed(li);\n  setStatus(COPY.incoming(player.name, reply.text));\n}\n\nfunction addTyping(playerKey) {\n  const player = CONFIG.players[playerKey];\n  const li = document.createElement('li');\n  li.className = 'msg msg-other typing';\n  li.setAttribute('aria-hidden', 'true');\n  li.appendChild(makeAvatar(player));\n\n  const text = document.createElement('p');\n  text.className = 'typing-text';\n  text.textContent = COPY.typing(player.name);\n  const dots = document.createElement('span');\n  dots.className = 'typing-dots';\n  for (let i = 0; i < 3; i += 1) {\n    dots.appendChild(document.createElement('span'));\n  }\n  text.appendChild(dots);\n  li.appendChild(text);\n\n  appendToFeed(li);\n  return li;\n}\n\nfunction makeBubble(text, outcome) {\n  const bubble = document.createElement('p');\n  bubble.className = 'bubble bubble-self';\n  if (outcome === 'blocked') {\n    bubble.classList.add('is-blocked');\n  } else if (outcome === 'hidden') {\n    bubble.classList.add('is-hidden');\n  }\n  bubble.textContent = text;\n  return bubble;\n}\n\nfunction makeMeta(name, label) {\n  const meta = document.createElement('p');\n  meta.className = 'msg-meta';\n  const nameEl = document.createElement('span');\n  nameEl.className = 'msg-name';\n  nameEl.textContent = name;\n  meta.appendChild(nameEl);\n  if (label) {\n    const labelEl = document.createElement('span');\n    labelEl.className = 'io-label';\n    labelEl.textContent = label;\n    meta.appendChild(labelEl);\n  }\n  return meta;\n}\n\nfunction makeTag(kind) {\n  const tag = document.createElement('span');\n  tag.className = `tag tag-pop tag-${kind}`;\n  tag.textContent = COPY.tags[kind];\n  return tag;\n}\n\nfunction makeAvatar(player) {\n  const svg = document.createElementNS(SVG_NS, 'svg');\n  svg.setAttribute('class', 'avatar');\n  svg.setAttribute('viewBox', '0 0 40 40');\n  svg.setAttribute('aria-hidden', 'true');\n  svg.setAttribute('focusable', 'false');\n\n  const circle = document.createElementNS(SVG_NS, 'circle');\n  circle.setAttribute('cx', '20');\n  circle.setAttribute('cy', '20');\n  circle.setAttribute('r', '18.5');\n  circle.setAttribute('fill', player.color);\n  circle.setAttribute('stroke', '#1f1976');\n  circle.setAttribute('stroke-width', '2');\n  svg.appendChild(circle);\n\n  const letter = document.createElementNS(SVG_NS, 'text');\n  letter.setAttribute('x', '20');\n  letter.setAttribute('y', '21');\n  letter.setAttribute('text-anchor', 'middle');\n  letter.setAttribute('dominant-baseline', 'central');\n  letter.setAttribute('fill', '#ffffff');\n  letter.setAttribute('font-size', '18');\n  letter.setAttribute('font-weight', '700');\n  letter.textContent = player.initial;\n  svg.appendChild(letter);\n  return svg;\n}\n\nfunction appendToFeed(li) {\n  els.feed.appendChild(li);\n  while (els.feed.children.length > CONFIG.feedLimit) {\n    els.feed.removeChild(els.feed.firstElementChild);\n  }\n  scrollFeedToEnd();\n}\n\nfunction scrollFeedToEnd() {\n  els.feed.scrollTop = els.feed.scrollHeight;\n}\n\n/* Replies from other players */\n\nfunction isChatPaused() {\n  return state.muted || state.roundLocked;\n}\n\nfunction queueReplies(replies) {\n  if (!replies.length) {\n    return;\n  }\n  state.replyQueue.push(...replies);\n  later(pumpReplies, CONFIG.timing.replyDelayMs);\n}\n\nfunction pumpReplies() {\n  if (state.replying || isChatPaused() || state.replyQueue.length === 0) {\n    return;\n  }\n  state.replying = true;\n  const reply = state.replyQueue.shift();\n  const typing = addTyping(reply.from);\n  later(() => {\n    typing.remove();\n    addOtherMessage(reply);\n    state.replying = false;\n    later(pumpReplies, CONFIG.timing.replyGapMs);\n  }, CONFIG.timing.typingMs);\n}\n\nfunction onFeedClick(event) {\n  const button = event.target.closest('.report-button');\n  if (!button || button.getAttribute('aria-disabled') === 'true') {\n    return;\n  }\n  button.setAttribute('aria-disabled', 'true');\n  button.parentNode.appendChild(makeTag('reported'));\n  setStatus(COPY.reportThanks);\n}\n\n/* Mute */\n\nfunction startMute() {\n  const focusWasInSendPath = els.tray.contains(document.activeElement) || document.activeElement === els.sendZone;\n  setStickersDisabled(true);\n  clearSelection();\n  els.sendZone.hidden = true;\n  els.mutePanel.hidden = false;\n\n  const durationMs = CONFIG.mute.seconds * 1000;\n  const endsAt = Date.now() + durationMs;\n  const fill = els.muteFill;\n  fill.style.transition = 'none';\n  fill.style.transform = 'scaleX(1)';\n  void fill.offsetWidth;\n  fill.style.transition = `transform ${CONFIG.mute.seconds}s linear`;\n  fill.style.transform = 'scaleX(0)';\n\n  updateMuteCount(endsAt);\n  clearInterval(state.muteInterval);\n  state.muteInterval = setInterval(() => updateMuteCount(endsAt), 1000);\n  later(endMute, durationMs);\n\n  if (focusWasInSendPath) {\n    els.mutePanel.focus();\n  }\n}\n\nfunction updateMuteCount(endsAt) {\n  const remaining = Math.max(0, endsAt - Date.now());\n  const minutes = Math.ceil((remaining / (CONFIG.mute.seconds * 1000)) * CONFIG.mute.minutesShown);\n  const formatter = COPY.minutesLeft[pluralRules.select(minutes)] || COPY.minutesLeft.other;\n  els.muteCount.textContent = formatter(numberFormat.format(minutes));\n}\n\nfunction endMute() {\n  const focusWasOnPanel = document.activeElement === els.mutePanel;\n  clearInterval(state.muteInterval);\n  state.muteInterval = null;\n  state.muted = false;\n  state.hiddenCount = 0;\n\n  els.mutePanel.hidden = true;\n  els.sendZone.hidden = false;\n  setStickersDisabled(state.roundLocked);\n  setStatus(COPY.unmuted);\n\n  if (state.thinkPending) {\n    later(maybeShowThink, CONFIG.timing.thinkDelayMs);\n    return;\n  }\n  if (focusWasOnPanel) {\n    const firstSticker = els.tray.querySelector('.sticker');\n    if (firstSticker) {\n      firstSticker.focus();\n    }\n  }\n  later(pumpReplies, CONFIG.timing.replyDelayMs);\n}\n\n/* Helpers */\n\nfunction setStatus(text) {\n  els.status.textContent = '';\n  later(() => {\n    els.status.textContent = text;\n  }, 50);\n}\n\nfunction shuffle(items) {\n  const copy = items.slice();\n  for (let i = copy.length - 1; i > 0; i -= 1) {\n    const j = Math.floor(Math.random() * (i + 1));\n    const temp = copy[i];\n    copy[i] = copy[j];\n    copy[j] = temp;\n  }\n  return copy;\n}\n\nfunction showLoadError(error) {\n  const app = document.getElementById('app');\n  const message = document.getElementById('app-error');\n  if (app) {\n    app.hidden = true;\n  }\n  if (message) {\n    message.hidden = false;\n  }\n  console.error(error);\n}\n\ntry {\n  init();\n} catch (error) {\n  showLoadError(error);\n}",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": ":root {\n  --purple-light: #e4e2f8;\n  --purple-mid: #aca8ea;\n  --purple: #4c42cf;\n  --purple-dark: #1f1976;\n  --ink: #1a1730;\n  --ink-soft: #4a4670;\n  --surface: #ffffff;\n  --page: #f5f4fc;\n  --hidden-bubble: #e4e2f8;\n\n  --success-bg: #ccf1d0;\n  --success-ink: #003f25;\n  --error-bg: #ffdcdc;\n  --error-ink: #8a1020;\n  --warning-bg: #ffefa8;\n  --warning-ink: #4f3b00;\n  --info-bg: #d5efff;\n  --info-ink: #06338d;\n  --neutral-bg: #26232f;\n  --neutral-ink: #ffffff;\n  --neutral-track: #575266;\n\n  --focus: #e11970;\n  --shadow-hard: 3px 3px 0 var(--purple-dark);\n  --radius: 0.75rem;\n  --font: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans\", Arial, sans-serif;\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nbody {\n  margin: 0;\n  font-family: var(--font);\n  font-size: 1rem;\n  line-height: 1.4;\n  color: var(--ink);\n  background: var(--page);\n}\n\nbutton {\n  font: inherit;\n}\n\n:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 3px;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n/* Layout */\n\n.app {\n  display: grid;\n  grid-template-columns: minmax(15rem, 20rem) minmax(0, 1fr);\n  gap: 1.25rem;\n  align-items: start;\n  max-width: 68rem;\n  margin-inline: auto;\n  padding: 1rem;\n}\n\n.rail {\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n  min-width: 0;\n}\n\n/* Progress */\n\n.progress-box {\n  padding: 0.75rem 0.9rem;\n  background: var(--surface);\n  border: 2px solid var(--purple-dark);\n  border-radius: var(--radius);\n  box-shadow: var(--shadow-hard);\n}\n\n.progress-box.is-popping {\n  animation: rail-pop 0.35s ease-out;\n}\n\n.set-row {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.6rem;\n  margin-block-end: 0.5rem;\n}\n\n.progress-dots {\n  display: flex;\n  gap: 0.4rem;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.progress-dot {\n  width: 0.95rem;\n  height: 0.95rem;\n  border: 2px solid var(--purple);\n  border-radius: 50%;\n  background: var(--surface);\n}\n\n.progress-dot.is-current {\n  border-width: 3px;\n  background: var(--purple-light);\n}\n\n.progress-dot.is-done {\n  background: var(--purple);\n}\n\n.set-count,\n.found-count {\n  margin: 0;\n  font-size: 0.9rem;\n  color: var(--ink-soft);\n}\n\n.set-count {\n  font-weight: 700;\n}\n\n.goal {\n  margin: 0 0 0.35rem;\n  font-weight: 700;\n  font-size: 1.05rem;\n  color: var(--purple-dark);\n}\n\n/* Think and done panels */\n\n.panel {\n  padding: 0.9rem;\n  background: var(--surface);\n  border: 3px solid var(--purple);\n  border-radius: var(--radius);\n  box-shadow: var(--shadow-hard);\n  animation: rail-pop 0.35s ease-out;\n}\n\n.panel-heading {\n  margin: 0 0 0.7rem;\n  font-size: 1.25rem;\n  color: var(--purple-dark);\n}\n\n.panel-heading:focus:not(:focus-visible) {\n  outline: none;\n}\n\n.think-pair {\n  display: flex;\n  flex-direction: column;\n  gap: 0.7rem;\n  margin: 0 0 0.85rem;\n  padding: 0;\n  list-style: none;\n}\n\n.think-item {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.think-question {\n  margin: 0 0 0.35rem;\n  font-weight: 700;\n  font-size: 1.05rem;\n}\n\n.think-talk,\n.done-text {\n  margin: 0 0 0.85rem;\n  color: var(--ink-soft);\n}\n\n.done-text {\n  margin: 0;\n}\n\n.think-next {\n  min-height: 2.75rem;\n  padding: 0.4rem 1.1rem;\n  font-weight: 800;\n  color: var(--surface);\n  background: var(--purple);\n  border: 2px solid var(--purple-dark);\n  border-radius: 0.6rem;\n  box-shadow: var(--shadow-hard);\n  cursor: pointer;\n}\n\n.think-next:hover {\n  background: var(--purple-dark);\n}\n\n/* Message tray */\n\n.hint {\n  margin: 0 0 0.5rem;\n  font-weight: 600;\n  color: var(--purple-dark);\n}\n\n.tray {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 0.65rem;\n  max-height: 26rem;\n  margin: 0;\n  padding: 0.4rem 0.5rem 0.6rem 0.25rem;\n  overflow-y: auto;\n  list-style: none;\n}\n\n.sticker,\n.sticker-ghost {\n  min-height: 2.75rem;\n  padding: 0.45rem 0.8rem;\n  font-weight: 700;\n  text-align: start;\n  color: var(--ink);\n  background: var(--surface);\n  border: 2px solid var(--purple-dark);\n  border-radius: 0.6rem;\n  box-shadow: var(--shadow-hard);\n}\n\n.sticker {\n  --tilt: -1.5deg;\n  cursor: grab;\n  transform: rotate(var(--tilt));\n  touch-action: pan-y;\n  -webkit-user-select: none;\n  user-select: none;\n  overflow-wrap: anywhere;\n}\n\n.tray li:nth-child(even) .sticker {\n  --tilt: 1.2deg;\n}\n\n.tray li:nth-child(3n) .sticker {\n  --tilt: 0.5deg;\n}\n\n.sticker:hover {\n  background: var(--purple-light);\n}\n\n.sticker[aria-pressed=\"true\"] {\n  color: var(--surface);\n  background: var(--purple);\n  animation: wiggle 0.4s ease-in-out;\n}\n\n.sticker:disabled {\n  cursor: not-allowed;\n  color: var(--ink-soft);\n  background: var(--purple-light);\n  border-style: dashed;\n  box-shadow: none;\n}\n\n.sticker-ghost {\n  position: fixed;\n  top: 0;\n  left: 0;\n  z-index: 10;\n  max-width: 18rem;\n  pointer-events: none;\n  background: var(--purple);\n  color: var(--surface);\n  opacity: 0.95;\n}\n\n/* Status and start over */\n\n.status {\n  min-height: 1.5em;\n  margin: 0;\n  font-weight: 600;\n  color: var(--purple-dark);\n}\n\n.start-over {\n  align-self: flex-start;\n  min-height: 2.25rem;\n  padding: 0.25rem 0.5rem;\n  color: var(--purple-dark);\n  font-weight: 700;\n  text-decoration: underline;\n  text-underline-offset: 0.2em;\n  background: none;\n  border: 0;\n  cursor: pointer;\n}\n\n/* Chat window */\n\n.chat {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  overflow: hidden;\n  background: var(--purple-light);\n  border: 4px solid var(--purple);\n  border-radius: 1rem;\n  box-shadow: 5px 5px 0 var(--purple-dark);\n}\n\n.chat-titlebar {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  padding: 0.5rem 0.9rem;\n  color: var(--surface);\n  background: var(--purple);\n}\n\n.window-dots {\n  display: flex;\n  gap: 0.35rem;\n}\n\n.window-dots span {\n  width: 0.7rem;\n  height: 0.7rem;\n  border-radius: 50%;\n  background: #f07fb0;\n}\n\n.window-dots span:nth-child(2) {\n  background: #ffa868;\n}\n\n.window-dots span:nth-child(3) {\n  background: #7cdb87;\n}\n\n.chat-title {\n  margin: 0;\n  font-size: 1.1rem;\n}\n\n.chat-with {\n  margin: 0;\n  padding: 0.45rem 0.9rem;\n  font-size: 0.9rem;\n  color: var(--purple-dark);\n  background: var(--surface);\n  border-block-end: 2px solid var(--purple-mid);\n}\n\n.feed {\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n  height: clamp(16rem, 55vh, 32rem);\n  margin: 0;\n  padding: 1rem;\n  overflow-y: auto;\n  list-style: none;\n}\n\n/* Messages */\n\n.msg {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.5rem;\n}\n\n.msg-self {\n  flex-direction: row-reverse;\n}\n\n.avatar {\n  flex: none;\n  width: 2.25rem;\n  height: 2.25rem;\n}\n\n.msg-body {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 0.3rem;\n  max-width: min(28rem, 85%);\n  min-width: 0;\n}\n\n.msg-self .msg-body {\n  align-items: flex-end;\n}\n\n.msg-meta {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  gap: 0.5rem;\n  margin: 0;\n  font-size: 0.85rem;\n}\n\n.msg-name {\n  font-weight: 700;\n  color: var(--purple-dark);\n}\n\n.io-label {\n  font-size: 0.75rem;\n  font-weight: 700;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n  color: var(--ink-soft);\n}\n\n.bubble {\n  margin: 0;\n  padding: 0.5rem 0.85rem;\n  color: var(--purple-dark);\n  background: var(--surface);\n  border: 2px solid var(--purple-dark);\n  border-radius: 1rem;\n  overflow-wrap: anywhere;\n}\n\n.bubble-self {\n  color: var(--surface);\n  background: var(--purple);\n}\n\n.bubble-self.is-blocked {\n  border-color: var(--error-ink);\n  text-decoration: line-through;\n  text-decoration-thickness: 2px;\n}\n\n.bubble-self.is-hidden {\n  color: var(--ink-soft);\n  background: var(--hidden-bubble);\n  border-style: dashed;\n  border-color: var(--ink-soft);\n}\n\n.bubble.is-shaking {\n  animation: shake 0.4s ease-in-out;\n}\n\n.msg-result,\n.msg-actions {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.typing {\n  align-items: center;\n}\n\n.typing-text {\n  margin: 0;\n  font-size: 0.85rem;\n  font-style: italic;\n  color: var(--ink-soft);\n}\n\n.typing-dots {\n  display: inline-flex;\n  gap: 0.2rem;\n  margin-inline-start: 0.3rem;\n}\n\n.typing-dots span {\n  width: 0.35rem;\n  height: 0.35rem;\n  border-radius: 50%;\n  background: var(--ink-soft);\n  animation: typing 1s ease-in-out infinite;\n}\n\n.typing-dots span:nth-child(2) {\n  animation-delay: 0.2s;\n}\n\n.typing-dots span:nth-child(3) {\n  animation-delay: 0.4s;\n}\n\n.msg-note {\n  margin: 0;\n  font-size: 0.85rem;\n  color: var(--ink-soft);\n}\n\n.report-button {\n  min-height: 1.75rem;\n  padding: 0.15rem 0.6rem;\n  font-size: 0.85rem;\n  font-weight: 700;\n  color: var(--purple-dark);\n  background: var(--surface);\n  border: 2px solid var(--purple-dark);\n  border-radius: 0.4rem;\n  cursor: pointer;\n}\n\n.report-button:hover {\n  background: var(--purple-light);\n}\n\n.report-button[aria-disabled=\"true\"] {\n  color: var(--ink-soft);\n  border-style: dashed;\n  cursor: default;\n}\n\n/* Output tags */\n\n.tag {\n  display: inline-block;\n  padding: 0.1rem 0.55rem;\n  font-size: 0.85rem;\n  font-weight: 800;\n  border: 2px solid currentColor;\n  border-radius: 0.4rem;\n  box-shadow: 2px 2px 0 currentColor;\n  transform: rotate(-3deg);\n}\n\n.tag-pop {\n  animation: tag-pop 0.35s ease-out both;\n}\n\n.tag-sent {\n  color: var(--success-ink);\n  background: var(--success-bg);\n}\n\n.tag-blocked {\n  color: var(--error-ink);\n  background: var(--error-bg);\n}\n\n.tag-hidden {\n  color: var(--warning-ink);\n  background: var(--warning-bg);\n}\n\n.tag-changed {\n  color: var(--info-ink);\n  background: var(--info-bg);\n}\n\n.tag-muted {\n  color: var(--neutral-ink);\n  background: var(--neutral-bg);\n  border-color: var(--neutral-bg);\n  box-shadow: 2px 2px 0 var(--purple-dark);\n}\n\n.tag-reported {\n  color: var(--purple-dark);\n  background: var(--purple-light);\n}\n\n/* Send area */\n\n.send-area {\n  padding: 0.75rem;\n  background: var(--surface);\n  border-block-start: 2px solid var(--purple-mid);\n}\n\n.send-zone {\n  width: 100%;\n  min-height: 3.25rem;\n  font-size: 1.1rem;\n  font-weight: 800;\n  color: var(--purple-dark);\n  background: var(--surface);\n  border: 3px solid var(--purple-mid);\n  border-radius: var(--radius);\n  cursor: pointer;\n}\n\n.send-zone.is-open {\n  background: var(--page);\n  border-color: var(--purple);\n  border-style: dashed;\n}\n\n.send-zone.is-over {\n  color: var(--surface);\n  background: var(--purple);\n}\n\n.mute-panel {\n  min-height: 3.25rem;\n  padding: 0.6rem 0.9rem;\n  color: var(--neutral-ink);\n  background: var(--neutral-bg);\n  border-radius: var(--radius);\n}\n\n.mute-title {\n  margin: 0 0 0.4rem;\n  font-weight: 800;\n}\n\n.mute-bar {\n  height: 0.6rem;\n  overflow: hidden;\n  background: var(--neutral-track);\n  border-radius: 999px;\n}\n\n.mute-bar-fill {\n  height: 100%;\n  background: var(--purple-mid);\n  transform-origin: left center;\n}\n\n[dir=\"rtl\"] .mute-bar-fill {\n  transform-origin: right center;\n}\n\n.mute-count {\n  display: none;\n  margin: 0;\n}\n\n/* Error */\n\n.app-error {\n  max-width: 40rem;\n  margin: 2rem auto;\n  padding: 1rem;\n  font-weight: 700;\n  color: var(--error-ink);\n  background: var(--error-bg);\n  border: 2px solid var(--error-ink);\n  border-radius: var(--radius);\n}\n\n/* Animations */\n\n@keyframes wiggle {\n  0% { transform: rotate(var(--tilt)); }\n  30% { transform: rotate(-4deg); }\n  60% { transform: rotate(3deg); }\n  100% { transform: rotate(var(--tilt)); }\n}\n\n@keyframes shake {\n  0%, 100% { transform: translateX(0); }\n  20% { transform: translateX(-6px); }\n  40% { transform: translateX(6px); }\n  60% { transform: translateX(-4px); }\n  80% { transform: translateX(4px); }\n}\n\n@keyframes tag-pop {\n  0% { opacity: 0; transform: rotate(-3deg) scale(0.4); }\n  70% { opacity: 1; transform: rotate(-3deg) scale(1.15); }\n  100% { opacity: 1; transform: rotate(-3deg) scale(1); }\n}\n\n@keyframes typing {\n  0%, 60%, 100% { opacity: 0.3; }\n  30% { opacity: 1; }\n}\n\n@keyframes rail-pop {\n  0%, 100% { transform: scale(1); }\n  50% { transform: scale(1.04); }\n}\n\n/* Narrow screens */\n\n@media (max-width: 48rem) {\n  .app {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .tray {\n    flex-direction: row;\n    flex-wrap: wrap;\n    max-height: none;\n    overflow: visible;\n  }\n\n  .msg-body {\n    max-width: 90%;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n\n  .mute-bar {\n    display: none;\n  }\n\n  .mute-count {\n    display: block;\n  }\n}",
          "folderId": "0",
          "active": false
        }
