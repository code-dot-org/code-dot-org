      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    \n    <!-- Title -->\n    <h1>How Well Do You Know The Wonders Of The World?</h1>\n    \n    <!-- User Instructions -->\n    <p>Take a look through the images below and see how many of them you can name. Scroll to the bottom of the page to see the answers</p>\n    \n    <!-- Image gallery --> <!-- 1) Put all of the images inside a container -->\n\n      <img src=\"acropolis_athens.jpg\" alt=\"Acropolis\">\n      <img src=\"victoria_falls.jpg\" alt=\"Victoria Falls\">\n      <img src=\"angkor_wat.jpg\" alt=\"Angkor Wat\">\n      <img src=\"taj_mahal.jpg\" alt=\"Taj Mahal\">\n      <img src=\"aurora_borealis.jpg\" alt=\"Aurora Borealis\">\n      <img src=\"roman_coliseum.jpg\" alt=\"Coliseum\">\n      <img src=\"chichen_itza.jpg\" alt=\"Chichen Itza\">\n      <img src=\"petra.jpg\" alt=\"Petra\">\n      <img src=\"giza_pyramid.jpg\" alt=\"Pyramid of Giza\">\n      <img src=\"moai_statues.jpg\" alt=\"Moai Statues\">\n      <img src=\"grand_canyon.jpg\" alt=\"Grand Canyon\">\n      <img src=\"machu_picchu.jpg\" alt=\"Machu Picchu\">\n      <img src=\"great_barrier_reef.jpg\" alt=\"Great Barrier Reef\">\n      <img src=\"library_of_celsus.jpg\" alt=\"Library of Celsus\">\n      <img src=\"great_wall_china.jpg\" alt=\"Great Wall of China\"> \n\n    \n   <!-- image citation -->\n    <p class=\"citations\">All images CC0 from free-images.com</p>\n    \n    <!-- Answers -->\n    <div class=\"answers\">\n      <p class=\"answers\">The answers below match the images moving left to right, row by row:</p>\n      <p class=\"answers\">Angkor Wat - Roman Coliseum - Pyramid of Giza - Machu Picchu - Great Wall of China</p>\n      <p class=\"answers\">Victoria Falls - Aurora Borealis -  Petra - Grand Canyon - Library of Celsus</p>\n      <p class=\"answers\">Acropolis - Taj Mahal - Chichen Itza - Moai Statues - Great Barrier Reef</p>\n    </div>\n    \n    \n\n    \n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* background color */\nbody {\n  background: #edfcff;\n}\n\n/* paragraph styling */\np {\n  font-family: sans-serif;\n  font-size: 24px;\n  text-align: center;\n}\n\n/* title style */\nh1 {\n  font-family: sans-serif;\n  font-size: 42px;\n  text-align: center;\n}\n\n/* image border style */\nimg {\n  border-style: solid;\n  border-radius: 10px;\n}\n\n/* height expanded for all divs to help with image layout as well as ensuring user will have to scroll to see the answers */\ndiv {\n  height: 500px;\n}\n\n/* 2) Style the container's layout so that the layout of the images matches the order of the answers */\n/* image container style */\n\n\n\n/* citation style */\n.citations {\n  font-size: 10px;\n  font-style: italic;\n  margin: 50px;\n}\n\n/* answers style */\n.answers {\n  display: flex;\n  flex-direction: column;\n  flex-wrap: nowrap;\n  align-items: center;\n  justify-content: flex-end;\n  font-size: 12px;\n  font-family: monospace;\n  \n}",
