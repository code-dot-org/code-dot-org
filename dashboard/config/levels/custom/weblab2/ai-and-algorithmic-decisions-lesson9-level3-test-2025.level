    "start_sources": {
      "folders": {
        "1": {
          "id": "1",
          "name": "sample_flowcharts",
          "parentId": "0",
          "open": false
        }
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Code Your Rule</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <main class=\"wrap\">\n    <section class=\"card\">\n\n      <!-- Condition Inputs -->\n      <div class=\"control\">\n        <label>\n          <input type=\"checkbox\" id=\"condA\" />\n          Condition A\n        </label>\n      </div>\n\n      <div class=\"control\">\n        <label>\n          <input type=\"checkbox\" id=\"condB\" />\n          Condition B\n        </label>\n      </div>\n\n      <!-- Run Button -->\n      <button id=\"btnRun\">Run</button>\n\n      <!-- Result Area -->\n      <p id=\"result\" class=\"result\">Result will appear here.</p>\n\n      <!-- Optional image area -->\n      <img id=\"heroImg\" class=\"hidden\" src=\"\" alt=\"\" />\n    </section>\n  </main>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
