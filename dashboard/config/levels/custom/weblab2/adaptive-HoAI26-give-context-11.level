<Weblab2>
  <config><![CDATA[{
  "published": true,
  "game_id": 74,
  "created_at": "2026-10-16T21:28:16.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": "true",
    "start_sources": {
      "folders": {
      },
      "files": {
        "affb34dc-57d5-4422-a61a-45b0e81bf297": {
          "id": "affb34dc-57d5-4422-a61a-45b0e81bf297",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Bug Report Widget</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <div class=\"container\">\n        <h1>Build a Bug Report</h1>\n\n        <div class=\"problem-area\">\n            <h2>Sample Broken Feature</h2>\n            <p>Imagine this is a page feature that's not working right.</p>\n            <button class=\"broken-button\">Broken Button</button>\n            <p>This button should be <strong>red</strong>, but it's currently <strong>blue</strong>!</p>\n            <p class=\"instruction\">Help me fix it by describing the problem.</p>\n        </div>\n\n        <div class=\"report-builder\">\n            <div class=\"report-part\" id=\"expected-section\">\n                <h3>1. What did you expect?</h3>\n                <p>The \"Broken Button\" should be red.</p>\n                <button class=\"add-button\" data-report-id=\"expected\">Add to report</button>\n            </div>\n            <div class=\"report-part\" id=\"happened-section\">\n                <h3>2. What happened?</h3>\n                <p>The \"Broken Button\" is blue.</p>\n                <button class=\"add-button\" data-report-id=\"happened\">Add to report</button>\n            </div>\n            <div class=\"report-part\" id=\"where-section\">\n                <h3>3. Where did it happen?</h3>\n                <p>On the \"Sample Broken Feature\" section, the \"Broken Button\".</p>\n                <button class=\"add-button\" data-report-id=\"where\">Add to report</button>\n            </div>\n        </div>\n\n        <div class=\"ai-response\">\n            <h2>AI Assistant Reply:</h2>\n            <p id=\"ai-message\">Click an \"Add to report\" button to start building your bug report.</p>\n        </div>\n    </div>\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "bc3c872a-0ba4-426c-a9da-310589018a61": {
          "id": "bc3c872a-0ba4-426c-a9da-310589018a61",
          "name": "style.css",
          "contents": "body {\n    font-family: sans-serif;\n    margin: 0;\n    padding: 20px;\n    background-color: #f4f7f6;\n    color: #333;\n    display: flex;\n    justify-content: center;\n    align-items: flex-start;\n    min-height: 100vh;\n}\n\n.container {\n    background-color: #ffffff;\n    border-radius: 10px;\n    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);\n    max-width: 900px;\n    width: 100%;\n    padding: 25px;\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 20px;\n}\n\nh1 {\n    text-align: center;\n    color: #2c3e50;\n    margin-top: 0;\n    margin-bottom: 25px;\n}\n\n.problem-area {\n    border: 1px solid #e0e0e0;\n    border-radius: 8px;\n    padding: 20px;\n    background-color: #fff8e1; /* Light yellow background to indicate 'problem' */\n    text-align: center;\n    margin-bottom: 20px;\n}\n\n.problem-area h2 {\n    color: #d35400; /* Orange for problem header */\n    margin-top: 0;\n}\n\n.broken-button {\n    background-color: #3498db; /* Blue, but should be red */\n    color: white;\n    padding: 10px 20px;\n    border: none;\n    border-radius: 5px;\n    font-size: 1em;\n    margin: 10px 0;\n    cursor: not-allowed; /* Indicate it's not clickable for interaction */\n}\n\n.instruction {\n    font-style: italic;\n    color: #666;\n    margin-top: 15px;\n}\n\n.report-builder {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n    gap: 15px;\n    margin-bottom: 20px;\n}\n\n.report-part {\n    border: 1px solid #cfd8dc;\n    border-radius: 8px;\n    padding: 15px;\n    background-color: #e3f2fd; /* Light blue */\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    transition: background-color 0.2s, border-color 0.2s;\n}\n\n.report-part.reported {\n    background-color: #d4edda; /* Light green when reported */\n    border-color: #28a745;\n}\n\n.report-part h3 {\n    color: #2196f3;\n    margin-top: 0;\n    margin-bottom: 10px;\n}\n\n.report-part p {\n    font-size: 0.9em;\n    line-height: 1.4;\n    flex-grow: 1;\n}\n\n.add-button {\n    background-color: #007bff;\n    color: white;\n    padding: 8px 15px;\n    border: none;\n    border-radius: 5px;\n    cursor: pointer;\n    font-size: 0.9em;\n    align-self: flex-start; /* Align button to start */\n    transition: background-color 0.2s;\n}\n\n.add-button:hover {\n    background-color: #0056b3;\n}\n\n.add-button.reported {\n    background-color: #28a745; /* Green when reported */\n    cursor: default;\n}\n.add-button.reported:hover {\n    background-color: #28a745;\n}\n\n.ai-response {\n    border: 1px solid #cfd8dc;\n    border-radius: 8px;\n    padding: 20px;\n    background-color: #f0f4f7;\n    text-align: center;\n}\n\n.ai-response h2 {\n    color: #546e7a;\n    margin-top: 0;\n    margin-bottom: 15px;\n}\n\n#ai-message {\n    font-size: 1.1em;\n    font-weight: bold;\n    color: #455a64;\n    min-height: 3em; /* Give some space for multi-line messages */\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "055b4499-e02d-4f77-8290-4e898524c0ee": {
          "id": "055b4499-e02d-4f77-8290-4e898524c0ee",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const addButtonElements = document.querySelectorAll('.add-button');\n    const aiMessageElement = document.getElementById('ai-message');\n    const reportedParts = new Set(); // To keep track of which parts have been reported\n\n    const updateAiMessage = () => {\n        let message = \"Click an 'Add to report' button to start building your bug report.\";\n        const count = reportedParts.size;\n\n        if (count === 1) {\n            message = \"Okay, I see you've reported one part. I need more context to help!\";\n        } else if (count === 2) {\n            message = \"Getting closer! With two pieces of context, I can start to understand.\";\n        } else if (count === 3) {\n            message = \"Excellent! You've provided all three parts. I can now give a helpful suggestion: Check the CSS for '.broken-button' and change its 'background-color' to red!\";\n        }\n        aiMessageElement.textContent = message;\n    };\n\n    addButtonElements.forEach(button => {\n        button.addEventListener('click', () => {\n            const reportId = button.dataset.reportId;\n            const parentReportPart = button.closest('.report-part');\n\n            // Toggle reported state\n            if (reportedParts.has(reportId)) {\n                reportedParts.delete(reportId);\n                button.classList.remove('reported');\n                parentReportPart.classList.remove('reported');\n                button.textContent = 'Add to report';\n            } else {\n                reportedParts.add(reportId);\n                button.classList.add('reported');\n                parentReportPart.classList.add('reported');\n                button.textContent = 'Added';\n            }\n            updateAiMessage();\n        });\n    });\n\n    // Initial message on load\n    updateAiMessage();\n});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
        "affb34dc-57d5-4422-a61a-45b0e81bf297",
        "bc3c872a-0ba4-426c-a9da-310589018a61",
        "055b4499-e02d-4f77-8290-4e898524c0ee"
      ]
    },
    "long_instructions": "Widget: \r\n\r\nWhat students do: tap the blocks on a sample page. Each block pops forward with a name tag and a one-line job, like \"Hero: the first thing you see.\" After all four, they pick which block they would change first. No score. How it looks: a bright sample page with four softly outlined blocks that wiggle on tap, with name tags that look like stickers. The sample page matches the destination. For Under the hood, a \"show the code\" toggle reveals each block's name in the code. Builds on: naming a block and what it is for, in the words of objective 3.",
