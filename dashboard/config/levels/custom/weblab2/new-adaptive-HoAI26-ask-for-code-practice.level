  "properties": {
    "require_edit_to_continue": true,
    "start_sources": {
      "folders": {
      },
      "files": {
        "24be1f63-66e6-47be-81b0-bdff911eddda": {
          "id": "24be1f63-66e6-47be-81b0-bdff911eddda",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Ask for Code Practice</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <h1>Generated Code Preview</h1>\n\n    <div class=\"code-output-area\">\n        <h2>Code Generated by AI:</h2>\n        <pre><code id=\"codeOutput\" class=\"language-html\">&lt;button&gt;Click Me&lt;/button&gt;</code></pre>\n        <p>This is what the button looks like when rendered:</p>\n        <div id=\"renderedButtonContainer\">\n            <button id=\"dynamicButton\">Click Me</button>\n        </div>\n    </div>\n\n    <div class=\"prompt-controls\">\n        <h2>Prompt Dial: Code Details</h2>\n        <p>Imagine you're asking the AI for a button.</p>\n        <div class=\"control-item\">\n            <label for=\"redColor\">Add Red Color (e.g., \"...and make it red\")</label>\n            <label class=\"switch\">\n                <input type=\"checkbox\" id=\"redColor\">\n                <span class=\"slider\"></span>\n            </label>\n        </div>\n        <div class=\"control-item\">\n            <label for=\"boldText\">Add Bold Text (e.g., \"...with bold text\")</label>\n            <label class=\"switch\">\n                <input type=\"checkbox\" id=\"boldText\">\n                <span class=\"slider\"></span>\n            </label>\n        </div>\n    </div>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "e08ac668-c7bc-49e3-aa6f-6eae7c2ee615": {
          "id": "e08ac668-c7bc-49e3-aa6f-6eae7c2ee615",
          "name": "style.css",
          "contents": "body {\n    font-family: Arial, sans-serif;\n    margin: 20px;\n    background-color: #f8f8f8;\n    color: #333;\n    line-height: 1.6;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    min-height: calc(100vh - 40px);\n}\n\nh1 {\n    color: #0056b3;\n    margin-bottom: 30px;\n}\n\n.code-output-area {\n    background-color: #fff;\n    padding: 25px;\n    border-radius: 10px;\n    box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n    margin-bottom: 30px;\n    width: 80%;\n    max-width: 600px;\n}\n\n.code-output-area h2 {\n    color: #4CAF50;\n    margin-top: 0;\n}\n\npre {\n    background-color: #eef;\n    border: 1px solid #ddd;\n    padding: 15px;\n    border-radius: 5px;\n    overflow-x: auto;\n    margin-bottom: 15px;\n}\n\ncode {\n    font-family: 'Courier New', monospace;\n    color: #333;\n}\n\n#renderedButtonContainer {\n    margin-top: 20px;\n    border-top: 1px dashed #ccc;\n    padding-top: 20px;\n    text-align: center;\n}\n\n#dynamicButton {\n    padding: 10px 20px;\n    border: none;\n    border-radius: 5px;\n    cursor: pointer;\n    font-size: 1em;\n    transition: all 0.3s ease;\n}\n\n/* Prompt Dial Controls Styling */\n.prompt-controls {\n    background-color: #fff;\n    padding: 25px;\n    border-radius: 10px;\n    box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n    display: flex;\n    flex-direction: column;\n    gap: 15px;\n    width: 80%;\n    max-width: 600px;\n}\n.prompt-controls p {\n    font-style: italic;\n    color: #666;\n}\n.control-item {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n}\n.control-item label {\n    font-size: 1.1em;\n    color: #555;\n}\n.switch {\n    position: relative;\n    display: inline-block;\n    width: 40px;\n    height: 24px;\n}\n.switch input {\n    opacity: 0;\n    width: 0;\n    height: 0;\n}\n.slider {\n    position: absolute;\n    cursor: pointer;\n    top: 0;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    background-color: #ccc;\n    -webkit-transition: .4s;\n    transition: .4s;\n    border-radius: 24px;\n}\n.slider:before {\n    position: absolute;\n    content: \"\";\n    height: 16px;\n    width: 16px;\n    left: 4px;\n    bottom: 4px;\n    background-color: white;\n    -webkit-transition: .4s;\n    transition: .4s;\n    border-radius: 50%;\n}\ninput:checked + .slider {\n    background-color: #2196F3;\n}\ninput:focus + .slider {\n    box-shadow: 0 0 1px #2196F3;\n}\ninput:checked + .slider:before {\n    -webkit-transform: translateX(16px);\n    -ms-transform: translateX(16px);\n    transform: translateX(16px);\n}\n",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "e8aad8e2-fa3a-4dd0-b530-c04a81def90d": {
          "id": "e8aad8e2-fa3a-4dd0-b530-c04a81def90d",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const codeOutput = document.getElementById('codeOutput');\n    const dynamicButton = document.getElementById('dynamicButton');\n    const redColorToggle = document.getElementById('redColor');\n    const boldTextToggle = document.getElementById('boldText');\n\n    function updateButtonAndCode() {\n        let buttonText = \"Click Me\";\n        let styles = [];\n        let codeSnippet = '';\n\n        if (redColorToggle.checked) {\n            styles.push('background-color: red;');\n            styles.push('color: white;');\n        } else {\n            styles.push('background-color: #007bff;'); // Default blue\n            styles.push('color: white;');\n        }\n\n        if (boldTextToggle.checked) {\n            styles.push('font-weight: bold;');\n        }\n\n        const styleAttribute = styles.length > 0 ? ` style=\"${styles.join(' ')}\"` : '';\n        codeSnippet = `&lt;button${styleAttribute}&gt;${buttonText}&lt;/button&gt;`;\n\n        // Update the displayed code snippet\n        codeOutput.innerHTML = codeSnippet;\n\n        // Update the actual button's appearance\n        dynamicButton.style.cssText = styles.join(' '); // Apply styles directly\n        dynamicButton.textContent = buttonText;\n    }\n\n    redColorToggle.addEventListener('change', updateButtonAndCode);\n    boldTextToggle.addEventListener('change', updateButtonAndCode);\n\n    // Initial update\n    updateButtonAndCode();\n});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
        "24be1f63-66e6-47be-81b0-bdff911eddda",
        "e08ac668-c7bc-49e3-aa6f-6eae7c2ee615",
        "e8aad8e2-fa3a-4dd0-b530-c04a81def90d"
      ]
    },
    "long_instructions": "TODOs:\r\n- Open index.html to view the sample page and the prompt dial controls.\r\n- Toggle the \"Add Red Color\" switch and observe how the code snippet changes.\r\n- Toggle the \"Add Bold Text\" switch and see its effect on the displayed code.\r\n- Toggle both switches to see the combined effect on the code.\r\n- Understand how adding specific details to a prompt generates different code.",
