    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <meta charset=\"utf-8\">\n    <title>Population Tracker</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    <div class=\"container\">\n      \n      <div id=\"header-section\">\n        <h1 id=\"title-section\">Title</h1>\n        <p id=\"date-section\">Date</p>\n      </div>\n      \n      <div class=\"controls\">\n        <div id=\"status\">Status: </div>\n        <button id=\"fetch-btn\">Get Live Census</button>\n      </div>\n\n      <div id=\"results\"></div>\n      \n    </div>\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: sans-serif;\n  background: #f0f2f5;\n  display: flex;\n  justify-content: center;\n  padding-top: 40px;\n}\n\n.container {\n  background: white;\n  width: 400px;\n  padding: 30px;\n  border-radius: 12px;\n  box-shadow: 0 4px 15px rgba(0,0,0,0.1);\n}\n\n#header-section h1 { color: #1a73e8; margin-bottom: 5px; }\n#header-section p { color: #666; margin-top: 0; }\n\n#status {\n  background: #eee;\n  padding: 10px;\n  border-radius: 6px;\n  margin-bottom: 10px;\n  font-weight: bold;\n  font-size: 0.9rem;\n}\n\nbutton {\n  background: #1a73e8;\n  color: white;\n  border: none;\n  padding: 12px;\n  width: 100%;\n  border-radius: 6px;\n  font-size: 1rem;\n  cursor: pointer;\n}\nbutton:hover { background: #1557b0; }\n\n/* Visual Cues for Data Source */\n.result-card {\n  padding: 10px;\n  margin-top: 10px;\n  border-left: 5px solid #ccc;\n  background: #f9f9f9;\n}\n.live-data { border-left-color: #34a853; } /* Green */\n.backup-data { border-left-color: #fbbc05; } /* Orange */",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const apiEndpoint = \"https://restcountries.com/v3.1/all?fields=name,population\";\nconst outputElement = document.getElementById(\"results\");\nconst statusElement = document.getElementById(\"status\");\nconst headerElement = document.getElementById(\"header-section\");\nconst title = document.getElementById(\"title-section\");\nconst date = document.getElementById(\"date-section\");\n\nconst appConfig = {\n  title: \"Global Population Tracker\",\n  date: \"2026 Census\"\n};\n\nconst renderAppShell = () => {\n  title.innerHTML = appConfig.title;\n  date.innerHTML = appConfig.date;\n};\n\n\nrenderAppShell();\n\n",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
          "name": "sample_data.json",
          "language": "json",
          "contents": "[\n  {\n    \"name\": {\n      \"common\": \"Vatican City\",\n      \"official\": \"Vatican City State\",\n      \"nativeName\": {\n        \"ita\": {\n          \"official\": \"Stato della Città del Vaticano\",\n          \"common\": \"Vaticano\"\n        },\n        \"lat\": {\n          \"official\": \"Status Civitatis Vaticanæ\",\n          \"common\": \"Vaticanæ\"\n        }\n      }\n    },\n    \"population\": 882\n  },\n  {\n    \"name\": {\n      \"common\": \"Belgium\",\n      \"official\": \"Kingdom of Belgium\",\n      \"nativeName\": {\n        \"deu\": {\n          \"official\": \"Königreich Belgien\",\n          \"common\": \"Belgien\"\n        },\n        \"fra\": {\n          \"official\": \"Royaume de Belgique\",\n          \"common\": \"Belgique\"\n        },\n        \"nld\": {\n          \"official\": \"Koninkrijk België\",\n          \"common\": \"België\"\n        }\n      }\n    },\n    \"population\": 11825551\n  },\n  {\n    \"name\": {\n      \"common\": \"Comoros\",\n      \"official\": \"Union of the Comoros\",\n      \"nativeName\": {\n        \"ara\": {\n          \"official\": \"الاتحاد القمري\",\n          \"common\": \"القمر‎\"\n        },\n        \"fra\": {\n          \"official\": \"Union des Comores\",\n          \"common\": \"Comores\"\n        },\n        \"zdj\": {\n          \"official\": \"Udzima wa Komori\",\n          \"common\": \"Komori\"\n        }\n      }\n    },\n    \"population\": 919901\n  },\n  {\n    \"name\": {\n      \"common\": \"Puerto Rico\",\n      \"official\": \"Commonwealth of Puerto Rico\",\n      \"nativeName\": {\n        \"eng\": {\n          \"official\": \"Commonwealth of Puerto Rico\",\n          \"common\": \"Puerto Rico\"\n        },\n        \"spa\": {\n          \"official\": \"Estado Libre Asociado de Puerto Rico\",\n          \"common\": \"Puerto Rico\"\n        }\n      }\n    },\n    \"population\": 3203295\n  },\n  {\n    \"name\": {\n      \"common\": \"United St