      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Andre's Week</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <div class=\"app\">\n    <header id=\"app-header\" class=\"app-header sky-afternoon\">\n      <svg class=\"sky-scene\" viewBox=\"0 0 480 150\" preserveAspectRatio=\"xMidYMax slice\" aria-hidden=\"true\" focusable=\"false\">\n        <defs>\n          <linearGradient id=\"sky-gradient\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0\" class=\"sky-top\"></stop>\n            <stop offset=\"1\" class=\"sky-bottom\"></stop>\n          </linearGradient>\n          <mask id=\"moon-mask\">\n            <rect x=\"-20\" y=\"-20\" width=\"40\" height=\"40\" fill=\"#ffffff\"></rect>\n            <circle cx=\"7\" cy=\"-5\" r=\"12\" fill=\"#000000\"></circle>\n          </mask>\n        </defs>\n        <rect width=\"480\" height=\"150\" fill=\"url(#sky-gradient)\"></rect>\n        <g class=\"stars\">\n          <circle cx=\"40\" cy=\"30\" r=\"1.8\"></circle>\n          <circle cx=\"120\" cy=\"18\" r=\"1.4\"></circle>\n          <circle cx=\"190\" cy=\"44\" r=\"1.8\"></circle>\n          <circle cx=\"250\" cy=\"22\" r=\"1.2\"></circle>\n          <circle cx=\"310\" cy=\"50\" r=\"1.6\"></circle>\n          <circle cx=\"420\" cy=\"26\" r=\"1.4\"></circle>\n          <circle cx=\"455\" cy=\"60\" r=\"1.2\"></circle>\n          <circle cx=\"160\" cy=\"70\" r=\"1.2\"></circle>\n        </g>\n        <circle class=\"sun\" cx=\"290\" cy=\"68\" r=\"18\"></circle>\n        <g class=\"moon\">\n          <circle cx=\"0\" cy=\"0\" r=\"15\" mask=\"url(#moon-mask)\"></circle>\n        </g>\n        <path class=\"hill-back\" d=\"M0 118 C80 90 150 96 230 112 C310 128 390 96 480 104 L480 150 L0 150 Z\"></path>\n        <path class=\"hill-front\" d=\"M0 134 C100 116 190 124 280 134 C360 142 420 126 480 130 L480 150 L0 150 Z\"></path>\n        <g class=\"house\">\n          <rect class=\"house-wall\" x=\"352\" y=\"96\" width=\"70\" height=\"44\" rx=\"3\"></rect>\n          <path class=\"house-roof\" d=\"M344 99 L387 70 L430 99 Z\"></path>\n          <rect class=\"house-window\" x=\"362\" y=\"106\" width=\"16\" height=\"14\" rx=\"2\"></rect>\n          <rect class=\"house-window\" x=\"396\" y=\"106\" width=\"16\" height=\"14\" rx=\"2\"></rect>\n          <rect class=\"house-door\" x=\"381\" y=\"121\" width=\"12\" height=\"19\" rx=\"2\"></rect>\n        </g>\n      </svg>\n      <div class=\"header-content\">\n        <h1 id=\"app-title\" class=\"app-title\"></h1>\n        <p class=\"clock\">\n          <span id=\"clock-icon\" class=\"clock-icon\"></span>\n          <span id=\"clock-label\" class=\"visually-hidden\"></span>\n          <span id=\"clock-time\"></span>\n        </p>\n      </div>\n    </header>\n\n    <noscript><p class=\"load-error\">This activity needs JavaScript to run.</p></noscript>\n    <p id=\"load-error\" class=\"load-error\" role=\"alert\" hidden></p>\n\n    <main class=\"app-main\">\n      <div class=\"stage\">\n\n      <section id=\"screen-intro\" class=\"screen\" aria-labelledby=\"intro-heading\">\n        <div class=\"screen-head\">\n          <span id=\"intro-tile\" class=\"tile tile-violet\"></span>\n          <h2 id=\"intro-heading\" tabindex=\"-1\"></h2>\n        </div>\n        <div id=\"intro-body\" class=\"stack\"></div>\n        <button id=\"start-button\" class=\"button-primary\" type=\"button\">\n          <span id=\"start-icon\" class=\"button-icon\"></span>\n          <span id=\"start-label\"></span>\n        </button>\n      </section>\n\n      <section id=\"screen-task\" class=\"screen\" aria-labelledby=\"task-heading\" hidden>\n        <div class=\"screen-head\">\n          <span id=\"task-tile\" class=\"tile\"></span>\n          <div>\n            <p id=\"task-progress\" class=\"progress-text\"></p>\n            <h2 id=\"task-heading\" tabindex=\"-1\"></h2>\n          </div>\n        </div>\n        <p class=\"task-time\"><span id=\"task-time-icon\" class=\"task-time-icon\"></span><span id=\"task-time\"></span></p>\n        <div class=\"story-note\">\n          <p id=\"task-due\" class=\"story-due\"></p>\n          <p id=\"task-note\"></p>\n        </div>\n        <h3 id=\"choice-heading\"></h3>\n        <div class=\"choices\" role=\"group\" aria-labelledby=\"choice-heading\">\n          <button type=\"button\" class=\"choice\" data-method=\"app\">\n            <span class=\"tile choice-tile tile-teal\"></span>\n            <span class=\"choice-text\">\n              <span class=\"choice-label\"></span>\n              <span class=\"choice-hint\"></span>\n            </span>\n          </button>\n          <button type=\"button\" class=\"choice\" data-method=\"paper\">\n            <span class=\"tile choice-tile tile-pink\"></span>\n            <span class=\"choice-text\">\n              <span class=\"choice-label\"></span>\n              <span class=\"choice-hint\"></span>\n            </span>\n          </button>\n          <button type=\"button\" class=\"choice\" data-method=\"skip\">\n            <span class=\"tile choice-tile tile-ink\"></span>\n            <span class=\"choice-text\">\n              <span class=\"choice-label\"></span>\n              <span class=\"choice-hint\"></span>\n            </span>\n          </button>\n        </div>\n      </section>\n\n      <section id=\"screen-report\" class=\"screen\" aria-labelledby=\"report-heading\" hidden>\n        <h2 id=\"report-heading\" tabindex=\"-1\"></h2>\n        <p id=\"report-intro\"></p>\n\n        <div class=\"report-cards\">\n          <article class=\"card card-gradebook\" aria-labelledby=\"gradebook-title\">\n            <h3 id=\"gradebook-title\" class=\"gradebook-title\"></h3>\n            <p id=\"gradebook-label\" class=\"card-label\"></p>\n            <p class=\"gradebook-value\">\n              <span id=\"gradebook-icon\" class=\"gradebook-stamp\"></span>\n              <span id=\"gradebook-value\"></span>\n            </p>\n            <p id=\"gradebook-count\" class=\"gradebook-count\"></p>\n            <p id=\"gradebook-note\" class=\"card-note\"></p>\n          </article>\n\n          <article id=\"app-card\" class=\"card card-app\" aria-labelledby=\"app-card-title\">\n            <div class=\"app-bar\">\n              <span id=\"app-logo\" class=\"app-logo\"></span>\n              <h3 id=\"app-card-title\" class=\"app-bar-title\"></h3>\n            </div>\n            <div class=\"app-body\">\n              <p id=\"app-card-label\" class=\"card-label\"></p>\n              <p class=\"status-pill\">\n                <span id=\"app-status-icon\" class=\"status-icon\"></span>\n                <span id=\"app-status-text\"></span>\n              </p>\n            </div>\n          </article>\n        </div>\n\n        <article id=\"email\" class=\"email\" aria-labelledby=\"email-heading\" hidden>\n          <div class=\"email-top\">\n            <span id=\"email-icon\" class=\"tile tile-orange\"></span>\n            <h3 id=\"email-heading\" class=\"email-heading\"></h3>\n          </div>\n          <dl class=\"email-meta\">\n            <dt id=\"email-from-label\"></dt>\n            <dd id=\"email-from\"></dd>\n            <dt id=\"email-to-label\"></dt>\n            <dd id=\"email-to\"></dd>\n            <dt id=\"email-subject-label\"></dt>\n            <dd id=\"email-subject\" class=\"email-subject\"></dd>\n          </dl>\n          <div id=\"email-body\" class=\"email-body stack\"></div>\n        </article>\n\n        <section id=\"ending\" class=\"ending\" aria-labelledby=\"ending-heading\" hidden>\n          <span id=\"ending-icon\" class=\"tile tile-ink\"></span>\n          <div>\n            <h3 id=\"ending-heading\"></h3>\n            <p id=\"ending-body\"></p>\n          </div>\n        </section>\n\n        <button id=\"retry-button\" class=\"button-primary\" type=\"button\">\n          <span id=\"retry-icon\" class=\"button-icon\"></span>\n          <span id=\"retry-label\"></span>\n        </button>\n      </section>\n\n      </div>\n\n      <section class=\"planner\" aria-labelledby=\"planner-heading\">\n        <h2 id=\"planner-heading\" class=\"planner-heading\"></h2>\n        <ol id=\"planner-list\" class=\"planner-list\"></ol>\n      </section>\n    </main>\n\n    <div id=\"announcer\" class=\"visually-hidden\" aria-live=\"polite\"></div>\n  </div>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "'use strict';\n\n/* ============================================================\n   STUDENT-FACING TEXT\n   Every string students see lives in this object.\n   ============================================================ */\nconst LOCALE = 'en-US';\n\nconst STRINGS = {\n  pageTitle: \"Andre's Week\",\n  appTitle: \"Andre's Week\",\n  clockLabel: 'Story time:',\n  clock: (day, time) => `${day}, ${time}`,\n  loadError: 'Something went wrong loading this activity. Try refreshing the page.',\n\n  intro: {\n    heading: 'You have 5 assignments due this week',\n    body: [\n      'Your family shares one phone, and your mom uses it for work until 9 PM.',\n      'Each night, you decide what to do about the assignment that is due.'\n    ],\n    start: 'Start Monday'\n  },\n\n  task: {\n    progress: (number, total) => `Assignment ${number} of ${total}`,\n    heading: (day, title) => `${day}: ${title}`,\n    time: (time) => `It's ${time}.`,\n    question: 'What do you do?'\n  },\n\n  methods: {\n    app: {\n      label: 'Finish it and upload it in OnTrack',\n      hint: 'Use the family phone.',\n      hintNoPhone: \"The phone isn't free tonight.\"\n    },\n    paper: {\n      label: 'Finish it and turn it in on paper',\n      hint: 'Hand it to your teacher in class tomorrow.'\n    },\n    skip: {\n      label: 'Skip it',\n      hint: \"You won't turn anything in.\"\n    }\n  },\n\n  // One entry per assignment, in the same order as WEEK below.\n  // Each note must match that night's phoneFree setting in WEEK.\n  assignments: [\n    {\n      title: 'Math worksheet',\n      due: 'Your math worksheet is due tomorrow.',\n      note: \"Mom's shift ended early today. She says you can use the phone for a few minutes.\"\n    },\n    {\n      title: 'Reading log',\n      due: 'Your reading log is due tomorrow.',\n      note: \"Mom is on a long work call tonight. You can't use the phone.\"\n    },\n    {\n      title: 'Science lab questions',\n      due: 'Your science lab questions are due tomorrow.',\n      note: 'You had soccer practice after school, so you started late. Mom is done with work, so the phone is free.'\n    },\n    {\n      title: 'Spanish vocab practice',\n      due: 'Your Spanish vocab practice is due tomorrow.',\n      note: 'You helped your little sister with her homework first. The phone is free now.'\n    },\n    {\n      title: 'History paragraph',\n      due: 'Your history paragraph is due tomorrow.',\n      note: \"Mom fell asleep with the phone in her room. You don't want to wake her up.\"\n    }\n  ],\n\n  planner: {\n    heading: \"This week's homework\",\n    notStarted: 'Not started',\n    current: 'Working on it',\n    uploaded: (time) => `Uploaded at ${time}`,\n    paper: 'Turned in on paper',\n    skipped: 'Skipped'\n  },\n\n  report: {\n    heading: 'Friday report',\n    intro: \"Here's how your week looks to your teacher and to the OnTrack app.\",\n    gradebookTitle: \"Teacher's Gradebook\",\n    gradebookLabel: 'Finished all work',\n    gradebookAnswer: {\n      yes: 'Yes',\n      no: 'No'\n    },\n    gradebookCount: (done, total) => `${done} of ${total}`,\n    gradebookNote: 'Official school record',\n    appTitle: 'OnTrack',\n    appLabel: 'Status this week',\n    status: {\n      onTrack: 'On Track',\n      needsCheckIn: 'Needs Check-in'\n    },\n    announce: (answer, done, total, status) =>\n      `Friday report. Teacher's gradebook: Finished all work, ${answer}, ${done} of ${total}. OnTrack status: ${status}.`,\n    emailAnnounce: 'OnTrack also sent an email to your mom.',\n    retry: 'Try the week again'\n  },\n\n  email: {\n    heading: 'Email sent to your mom',\n    fromLabel: 'From:',\n    from: 'OnTrack',\n    toLabel: 'To:',\n    to: 'Mom',\n    subjectLabel: 'Subject:',\n    subject: 'Andre needs a check-in',\n    greeting: 'Hi!',\n    notice: 'OnTrack noticed Andre may be falling behind this week.',\n    // The clue matches whichever part of the decision rule flagged Andre.\n    // It hints at what the app looks at without explaining the rule.\n    clues: {\n      notAllInApp: \"We didn't get all of Andre's assignments through OnTrack this week.\",\n      lateInApp: 'Andre turned in some of his assignments later in the evening than usual.'\n    },\n    request: 'Please check in with him about his homework.'\n  },\n\n  ending: {\n    heading: 'Case file',\n    body: 'Write down what happened in your case file. Then go to the next level to look at the data behind this app.'\n  }\n};\n\n/* ============================================================\n   APP DECISION RULE\n   Matches the AI Studio tree trained on Submitted in App,\n   Submit Time, and Minutes in App. If the tree changes,\n   update this function.\n   On Track only if all 5 were submitted in the app, none after 9 PM.\n   The reason picks which clue goes in the email to Mom.\n   ============================================================ */\nconst STATUS = {\n  ON_TRACK: 'onTrack',\n  NEEDS_CHECK_IN: 'needsCheckIn'\n};\n\nconst REASON = {\n  NOT_ALL_IN_APP: 'notAllInApp',\n  LATE_IN_APP: 'lateInApp'\n};\n\nfunction appStatus(submittedInApp, submittedAfter9PM) {\n  if (submittedInApp < 5) return { status: STATUS.NEEDS_CHECK_IN, reason: REASON.NOT_ALL_IN_APP };\n  if (submittedAfter9PM) return { status: STATUS.NEEDS_CHECK_IN, reason: REASON.LATE_IN_APP };\n  return { status: STATUS.ON_TRACK, reason: null };\n}\n\n/* ============================================================\n   STORY TIMELINE\n   Story time for each night (month is 0-based: 10 = November).\n   Times get later as the week goes on. phoneFree: false means\n   the app upload is unavailable that night.\n   ============================================================ */\nconst WEEK = [\n  { subject: 'math', phoneFree: true, finishedAt: new Date(2026, 10, 9, 19, 15) },      // Monday 7:15 PM\n  { subject: 'reading', phoneFree: false, finishedAt: new Date(2026, 10, 10, 20, 30) }, // Tuesday 8:30 PM\n  { subject: 'science', phoneFree: true, finishedAt: new Date(2026, 10, 11, 21, 25) },  // Wednesday 9:25 PM\n  { subject: 'spanish', phoneFree: true, finishedAt: new Date(2026, 10, 12, 21, 50) },  // Thursday 9:50 PM\n  { subject: 'history', phoneFree: false, finishedAt: new Date(2026, 10, 12, 22, 20) }  // Thursday 10:20 PM\n];\n\n// Header sky scene: the first phase whose hour limit is above the story hour wins.\nconst SKY_PHASES = [\n  { name: 'afternoon', beforeHour: 17 },\n  { name: 'evening', beforeHour: 20 },\n  { name: 'dusk', beforeHour: 21 },\n  { name: 'night', beforeHour: 24 }\n];\n\nconst WEEK_START = new Date(2026, 10, 9, 15, 30);  // Monday after school\nconst REPORT_TIME = new Date(2026, 10, 13, 15, 0); // Friday after school\nconst LATE_HOUR = 21;            // 9 PM, used by the app's decision rule\nconst TRIES_BEFORE_ENDING = 2;\n\n/* ============================================================\n   APP LOGIC\n   ============================================================ */\nconst METHOD = {\n  APP: 'app',\n  PAPER: 'paper',\n  SKIP: 'skip'\n};\n\nconst SCREENS = ['intro', 'task', 'report'];\n\nconst state = {\n  phase: 'intro',\n  current: 0,\n  results: [],\n  tries: 0\n};\n\nconst dayFormat = new Intl.DateTimeFormat(LOCALE, { weekday: 'long' });\nconst timeFormat = new Intl.DateTimeFormat(LOCALE, { hour: 'numeric', minute: '2-digit' });\nconst numberFormat = new Intl.NumberFormat(LOCALE);\n\nconst SVG_NS = 'http://www.w3.org/2000/svg';\nconst ICON_SHAPES = {\n  clock: [['circle', { cx: 12, cy: 12, r: 9 }], ['path', { d: 'M12 7v5l3.5 2' }]],\n  check: [['path', { d: 'M5.5 12.5l4.5 4.5L18.5 8' }]],\n  alert: [['circle', { cx: 12, cy: 12, r: 9 }], ['path', { d: 'M12 7.5v5.5' }], ['path', { d: 'M12 16.5v.01' }]],\n  done: [['circle', { cx: 12, cy: 12, r: 9 }], ['path', { d: 'M7.5 12.5l3 3 6-6.5' }]],\n  current: [['circle', { cx: 12, cy: 12, r: 9 }], ['circle', { cx: 12, cy: 12, r: 4, class: 'icon-fill' }]],\n  pending: [['circle', { cx: 12, cy: 12, r: 9 }]],\n  missed: [['circle', { cx: 12, cy: 12, r: 9 }], ['path', { d: 'M9 9l6 6 M15 9l-6 6' }]],\n  skip: [['path', { d: 'M5 6.5l6 5.5-6 5.5z' }], ['path', { d: 'M12.5 6.5l6 5.5-6 5.5z' }]],\n  backpack: [\n    ['path', { d: 'M6.5 9.5a5.5 5.5 0 0 1 11 0v10A1.5 1.5 0 0 1 16 21H8a1.5 1.5 0 0 1-1.5-1.5z' }],\n    ['path', { d: 'M9.5 4.5V3h5v1.5' }],\n    ['path', { d: 'M9 14h6v3.5H9z' }]\n  ],\n  play: [['path', { d: 'M8 5.5v13l10.5-6.5z', class: 'icon-fill' }]],\n  retry: [['path', { d: 'M4.5 12a7.5 7.5 0 1 0 2.2-5.3' }], ['path', { d: 'M4.5 4.5V9H9' }]],\n  phoneUpload: [\n    ['rect', { x: 6, y: 2.5, width: 12, height: 19, rx: 2.5 }],\n    ['path', { d: 'M12 15V8.5' }],\n    ['path', { d: 'M9.25 11l2.75-2.75L14.75 11' }],\n    ['path', { d: 'M10.5 18.5h3' }]\n  ],\n  paper: [\n    ['path', { d: 'M6.5 3h7.5l4 4v14h-11.5z' }],\n    ['path', { d: 'M14 3v4h4' }],\n    ['path', { d: 'M9.5 12h5 M9.5 15.5h5' }]\n  ],\n  calculator: [\n    ['rect', { x: 5, y: 3, width: 14, height: 18, rx: 2 }],\n    ['path', { d: 'M8.5 6.5h7v3h-7z' }],\n    ['path', { d: 'M8.5 13.5h.01 M12 13.5h.01 M15.5 13.5h.01 M8.5 17h.01 M12 17h.01 M15.5 17h.01' }]\n  ],\n  book: [\n    ['path', { d: 'M12 6.5C10 5 7 4.5 3.5 5v13c3.5-.5 6.5 0 8.5 1.5 2-1.5 5-2 8.5-1.5V5c-3.5-.5-6.5 0-8.5 1.5z' }],\n    ['path', { d: 'M12 6.5v13' }]\n  ],\n  flask: [\n    ['path', { d: 'M9.5 3h5' }],\n    ['path', { d: 'M10.5 3v5.5L5 18.5A1.8 1.8 0 0 0 6.6 21h10.8a1.8 1.8 0 0 0 1.6-2.5L13.5 8.5V3' }],\n    ['path', { d: 'M7.5 15h9' }]\n  ],\n  speech: [\n    ['path', { d: 'M5 4.5h14A1.5 1.5 0 0 1 20.5 6v8.5A1.5 1.5 0 0 1 19 16h-7l-4.5 3.5V16H5a1.5 1.5 0 0 1-1.5-1.5V6A1.5 1.5 0 0 1 5 4.5z' }],\n    ['path', { d: 'M8 10.25h.01 M12 10.25h.01 M16 10.25h.01' }]\n  ],\n  landmark: [\n    ['path', { d: 'M3.5 9.5L12 4l8.5 5.5z' }],\n    ['path', { d: 'M6 9.5v8 M10 9.5v8 M14 9.5v8 M18 9.5v8' }],\n    ['path', { d: 'M3.5 20.5h17' }]\n  ],\n  target: [\n    ['circle', { cx: 12, cy: 12, r: 9 }],\n    ['circle', { cx: 12, cy: 12, r: 5 }],\n    ['circle', { cx: 12, cy: 12, r: 1.75, class: 'icon-fill' }]\n  ],\n  envelope: [['rect', { x: 3, y: 5.5, width: 18, height: 13, rx: 2 }], ['path', { d: 'M3.5 7l8.5 6 8.5-6' }]],\n  folder: [\n    ['path', { d: 'M3.5 7A1.5 1.5 0 0 1 5 5.5h4.5l2 2.5H19a1.5 1.5 0 0 1 1.5 1.5v8A1.5 1.5 0 0 1 19 19H5a1.5 1.5 0 0 1-1.5-1.5z' }],\n    ['path', { d: 'M8 13.5h8' }]\n  ]\n};\n\nconst SUBJECT_ICONS = {\n  math: 'calculator',\n  reading: 'book',\n  science: 'flask',\n  spanish: 'speech',\n  history: 'landmark'\n};\n\nconst METHOD_ICONS = {\n  app: 'phoneUpload',\n  paper: 'paper',\n  skip: 'skip'\n};\n\nfunction $(id) {\n  return document.getElementById(id);\n}\n\nfunction createIcon(name) {\n  const svg = document.createElementNS(SVG_NS, 'svg');\n  svg.setAttribute('viewBox', '0 0 24 24');\n  svg.setAttribute('aria-hidden', 'true');\n  svg.setAttribute('focusable', 'false');\n  svg.setAttribute('class', `icon icon-${name}`);\n  ICON_SHAPES[name].forEach(([tag, attrs]) => {\n    const shape = document.createElementNS(SVG_NS, tag);\n    Object.entries(attrs).forEach(([key, value]) => shape.setAttribute(key, String(value)));\n    svg.appendChild(shape);\n  });\n  return svg;\n}\n\nfunction setText(id, text) {\n  $(id).textContent = text;\n}\n\nfunction fillParagraphs(container, paragraphs) {\n  container.replaceChildren();\n  paragraphs.forEach((text) => {\n    const p = document.createElement('p');\n    p.textContent = text;\n    container.appendChild(p);\n  });\n}\n\nfunction formatNumber(value) {\n  return numberFormat.format(value);\n}\n\nfunction isLate(date) {\n  return date.getHours() >= LATE_HOUR;\n}\n\nfunction choiceButton(method) {\n  return document.querySelector(`.choice[data-method=\"${method}\"]`);\n}\n\nfunction announce(text) {\n  const region = $('announcer');\n  region.textContent = '';\n  window.setTimeout(() => {\n    region.textContent = text;\n  }, 100);\n}\n\nfunction applyStaticStrings() {\n  document.title = STRINGS.pageTitle;\n\n  const staticText = {\n    'app-title': STRINGS.appTitle,\n    'clock-label': STRINGS.clockLabel,\n    'intro-heading': STRINGS.intro.heading,\n    'start-label': STRINGS.intro.start,\n    'choice-heading': STRINGS.task.question,\n    'report-heading': STRINGS.report.heading,\n    'report-intro': STRINGS.report.intro,\n    'gradebook-title': STRINGS.report.gradebookTitle,\n    'gradebook-label': STRINGS.report.gradebookLabel,\n    'gradebook-note': STRINGS.report.gradebookNote,\n    'app-card-title': STRINGS.report.appTitle,\n    'app-card-label': STRINGS.report.appLabel,\n    'email-heading': STRINGS.email.heading,\n    'email-from-label': STRINGS.email.fromLabel,\n    'email-from': STRINGS.email.from,\n    'email-to-label': STRINGS.email.toLabel,\n    'email-to': STRINGS.email.to,\n    'email-subject-label': STRINGS.email.subjectLabel,\n    'email-subject': STRINGS.email.subject,\n    'ending-heading': STRINGS.ending.heading,\n    'ending-body': STRINGS.ending.body,\n    'retry-label': STRINGS.report.retry,\n    'planner-heading': STRINGS.planner.heading\n  };\n  Object.entries(staticText).forEach(([id, text]) => setText(id, text));\n\n  fillParagraphs($('intro-body'), STRINGS.intro.body);\n\n  Object.values(METHOD).forEach((method) => {\n    const button = choiceButton(method);\n    button.querySelector('.choice-label').textContent = STRINGS.methods[method].label;\n    button.querySelector('.choice-tile').appendChild(createIcon(METHOD_ICONS[method]));\n  });\n\n  const staticIcons = {\n    'clock-icon': 'clock',\n    'task-time-icon': 'clock',\n    'intro-tile': 'backpack',\n    'start-icon': 'play',\n    'retry-icon': 'retry',\n    'app-logo': 'target',\n    'email-icon': 'envelope',\n    'ending-icon': 'folder'\n  };\n  Object.entries(staticIcons).forEach(([id, icon]) => $(id).appendChild(createIcon(icon)));\n}\n\nfunction bindEvents() {\n  $('start-button').addEventListener('click', startWeek);\n  $('retry-button').addEventListener('click', startWeek);\n  Object.values(METHOD).forEach((method) => {\n    choiceButton(method).addEventListener('click', () => chooseMethod(method));\n  });\n}\n\nfunction showScreen(name, moveFocus) {\n  SCREENS.forEach((screen) => {\n    $(`screen-${screen}`).hidden = screen !== name;\n  });\n  if (moveFocus) {\n    $(`${name}-heading`).focus();\n  }\n}\n\nfunction renderClock(date) {\n  setText('clock-time', STRINGS.clock(dayFormat.format(date), timeFormat.format(date)));\n\n  const hour = date.getHours();\n  const phase = SKY_PHASES.find((candidate) => hour < candidate.beforeHour);\n  const header = $('app-header');\n  SKY_PHASES.forEach((candidate) => {\n    header.classList.toggle(`sky-${candidate.name}`, candidate === phase);\n  });\n}\n\nfunction setSubjectTile(element, subject) {\n  Object.keys(SUBJECT_ICONS).forEach((name) => {\n    element.classList.toggle(`subject-${name}`, name === subject);\n  });\n  element.replaceChildren(createIcon(SUBJECT_ICONS[subject]));\n}\n\nfunction plannerStatus(index) {\n  const result = state.results[index];\n  if (result) {\n    if (result.method === METHOD.SKIP) {\n      return { icon: 'missed', className: 'is-skipped', text: STRINGS.planner.skipped };\n    }\n    if (result.method === METHOD.PAPER) {\n      return { icon: 'done', className: 'is-done', text: STRINGS.planner.paper };\n    }\n    return {\n      icon: 'done',\n      className: 'is-done',\n      text: STRINGS.planner.uploaded(timeFormat.format(result.uploadedAt))\n    };\n  }\n  if (state.phase === 'task' && index === state.current) {\n    return { icon: 'current', className: 'is-current', text: STRINGS.planner.current };\n  }\n  return { icon: 'pending', className: '', text: STRINGS.planner.notStarted };\n}\n\nfunction renderPlanner() {\n  const list = $('planner-list');\n  list.replaceChildren();\n\n  STRINGS.assignments.forEach((assignment, index) => {\n    const status = plannerStatus(index);\n    const item = document.createElement('li');\n    item.className = 'planner-item';\n    if (status.className) item.classList.add(status.className);\n    if (status.className === 'is-current') item.setAttribute('aria-current', 'step');\n\n    const tileWrap = document.createElement('span');\n    tileWrap.className = 'planner-tile';\n    const tile = document.createElement('span');\n    tile.className = 'tile tile-small';\n    setSubjectTile(tile, WEEK[index].subject);\n    tileWrap.appendChild(tile);\n\n    if (status.icon !== 'pending') {\n      const mark = document.createElement('span');\n      mark.className = 'planner-mark';\n      mark.appendChild(createIcon(status.icon));\n      tileWrap.appendChild(mark);\n    }\n\n    const text = document.createElement('span');\n    text.className = 'planner-text';\n    const title = document.createElement('span');\n    title.className = 'planner-title';\n    title.textContent = assignment.title;\n    const statusText = document.createElement('span');\n    statusText.className = 'planner-status';\n    statusText.textContent = status.text;\n    text.append(title, statusText);\n\n    item.append(tileWrap, text);\n    list.appendChild(item);\n  });\n}\n\nfunction startWeek() {\n  state.phase = 'task';\n  state.current = 0;\n  state.results = [];\n  renderTask();\n}\n\nfunction renderTask() {\n  const index = state.current;\n  const assignment = STRINGS.assignments[index];\n  const finishedAt = WEEK[index].finishedAt;\n\n  setText('task-progress', STRINGS.task.progress(formatNumber(index + 1), formatNumber(WEEK.length)));\n  setText('task-heading', STRINGS.task.heading(dayFormat.format(finishedAt), assignment.title));\n  setText('task-time', STRINGS.task.time(timeFormat.format(finishedAt)));\n  setText('task-due', assignment.due);\n  setText('task-note', assignment.note);\n  renderChoices(WEEK[index].phoneFree);\n  setSubjectTile($('task-tile'), WEEK[index].subject);\n\n  renderClock(finishedAt);\n  renderPlanner();\n  showScreen('task', true);\n}\n\nfunction renderChoices(phoneFree) {\n  Object.values(METHOD).forEach((method) => {\n    const button = choiceButton(method);\n    const text = STRINGS.methods[method];\n    const unavailable = method === METHOD.APP && !phoneFree;\n    button.disabled = unavailable;\n    button.querySelector('.choice-hint').textContent = unavailable ? text.hintNoPhone : text.hint;\n  });\n}\n\nfunction chooseMethod(method) {\n  if (choiceButton(method).disabled) return;\n\n  // An app upload happens at the story time shown; students can't change it.\n  const uploadedAt = method === METHOD.APP ? WEEK[state.current].finishedAt : null;\n\n  state.results[state.current] = { method, uploadedAt };\n  state.current += 1;\n\n  if (state.current < WEEK.length) {\n    renderTask();\n  } else {\n    renderReport();\n  }\n}\n\nfunction renderReport() {\n  state.phase = 'report';\n  state.tries += 1;\n\n  const total = WEEK.length;\n  const done = state.results.filter((result) => result.method !== METHOD.SKIP).length;\n  const submittedInApp = state.results.filter((result) => result.method === METHOD.APP).length;\n  const submittedAfter9PM = state.results.some(\n    (result) => result.uploadedAt !== null && isLate(result.uploadedAt)\n  );\n  const decision = appStatus(submittedInApp, submittedAfter9PM);\n  const status = decision.status;\n  const needsCheckIn = status === STATUS.NEEDS_CHECK_IN;\n  const statusText = STRINGS.report.status[status];\n  const showEnding = state.tries >= TRIES_BEFORE_ENDING;\n\n  const allDone = done === total;\n  const gradebookAnswer = allDone ? STRINGS.report.gradebookAnswer.yes : STRINGS.report.gradebookAnswer.no;\n  setText('gradebook-value', gradebookAnswer);\n  setText('gradebook-count', STRINGS.report.gradebookCount(formatNumber(done), formatNumber(total)));\n  const stamp = $('gradebook-icon');\n  stamp.classList.toggle('is-incomplete', !allDone);\n  stamp.replaceChildren(createIcon(allDone ? 'check' : 'alert'));\n\n  if (needsCheckIn) {\n    const email = STRINGS.email;\n    fillParagraphs($('email-body'), [email.greeting, email.notice, email.clues[decision.reason], email.request]);\n  }\n\n  const card = $('app-card');\n  card.classList.toggle('is-warn', needsCheckIn);\n  card.classList.toggle('is-ok', !needsCheckIn);\n  $('app-status-icon').replaceChildren(createIcon(needsCheckIn ? 'alert' : 'check'));\n  setText('app-status-text', statusText);\n\n  $('email').hidden = !needsCheckIn;\n  $('ending').hidden = !showEnding;\n\n  renderClock(REPORT_TIME);\n  renderPlanner();\n  showScreen('report', true);\n\n  const messages = [\n    STRINGS.report.announce(gradebookAnswer, formatNumber(done), formatNumber(total), statusText)\n  ];\n  if (needsCheckIn) messages.push(STRINGS.report.emailAnnounce);\n  if (showEnding) messages.push(STRINGS.ending.body);\n  announce(messages.join(' '));\n}\n\nfunction showLoadError() {\n  const box = $('load-error');\n  if (!box) return;\n  box.textContent = STRINGS.loadError;\n  box.hidden = false;\n  SCREENS.forEach((screen) => {\n    const section = $(`screen-${screen}`);\n    if (section) section.hidden = true;\n  });\n}\n\nfunction init() {\n  try {\n    applyStaticStrings();\n    bindEvents();\n    renderClock(WEEK_START);\n    renderPlanner();\n    showScreen('intro', false);\n  } catch (error) {\n    console.error(error);\n    showLoadError();\n  }\n}\n\ninit();",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": ":root {\n  --page: #f2eeff;\n  --page-dot: #d8cfff;\n  --surface: #ffffff;\n  --ink: #1d1b4b;\n  --muted: #4e4a6b;\n  --line: #c9c1ec;\n  --shadow: #bfb2ff;\n\n  --violet: #5b3bd6;\n  --violet-dark: #4528b5;\n  --teal: #0f7a6c;\n  --pink: #d1366e;\n  --orange: #c95400;\n  --blue: #2f6fd6;\n  --sun: #ffd23f;\n  --sticky: #fff4c2;\n  --disabled: #8a8799;\n\n  --done-ink: #0b6b5e;\n  --ok-bg: #e3f7ef;\n  --ok-ink: #0b5e52;\n  --ok-line: #12957f;\n  --warn-bg: #fff1e0;\n  --warn-ink: #9a3a00;\n  --warn-line: #e36a00;\n\n  --paper-line: #cfe0ff;\n  --paper-margin: #f28b9b;\n\n  --radius-big: 18px;\n  --radius: 12px;\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nhtml {\n  -webkit-text-size-adjust: 100%;\n}\n\nbody {\n  margin: 0;\n  background-color: var(--page);\n  background-image: radial-gradient(var(--page-dot) 1.3px, transparent 1.5px);\n  background-size: 18px 18px;\n  color: var(--ink);\n  font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif;\n  font-size: 1rem;\n  line-height: 1.5;\n}\n\nh1,\nh2,\nh3,\np {\n  margin-block: 0;\n}\n\nh1,\nh2,\nh3 {\n  font-weight: 800;\n  letter-spacing: -0.01em;\n}\n\n.app {\n  max-width: 50rem;\n  margin-inline: auto;\n  padding: 0.5rem;\n}\n\n/* Assignment pane and weekly checklist sit side by side so the\n   activity fits a short Chromebook screen. Stacks only when very narrow. */\n.app-main {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) clamp(8.75rem, 37%, 14rem);\n  gap: 0.625rem;\n  align-items: start;\n  margin-block-start: 0.625rem;\n}\n\n@media (max-width: 22rem) {\n  .app-main {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n\n/* ---------- Sky header ---------- */\n\n.app-header {\n  position: relative;\n  overflow: hidden;\n  min-height: 6rem;\n  border: 3px solid var(--ink);\n  border-radius: var(--radius-big);\n  box-shadow: 5px 5px 0 var(--ink);\n}\n\n.sky-scene {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n}\n\n.header-content {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 0.375rem;\n  padding: 0.5rem 0.625rem;\n}\n\n.app-title {\n  padding: 0.25rem 0.75rem;\n  background: var(--surface);\n  border: 3px solid var(--ink);\n  border-radius: 10px;\n  box-shadow: 3px 3px 0 var(--ink);\n  font-size: 1.25rem;\n  line-height: 1.2;\n  transform: rotate(-2deg);\n}\n\n.clock {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.375rem;\n  padding: 0.2rem 0.7rem;\n  background: var(--ink);\n  border-radius: 999px;\n  color: #ffffff;\n  font-size: 0.9375rem;\n  font-weight: 700;\n  font-variant-numeric: tabular-nums;\n}\n\n.clock-icon {\n  display: inline-flex;\n  color: var(--sun);\n}\n\n.sky-top,\n.sky-bottom {\n  transition: stop-color 600ms ease;\n}\n\n.sun,\n.moon,\n.stars,\n.hill-back,\n.hill-front,\n.house-window {\n  transition: fill 600ms ease, opacity 600ms ease, transform 600ms ease;\n}\n\n.sun {\n  fill: var(--sun);\n}\n\n.moon {\n  fill: #fff6d5;\n  opacity: 0;\n  transform: translate(300px, 64px);\n}\n\n.stars {\n  fill: #ffffff;\n  opacity: 0;\n}\n\n.house-wall {\n  fill: #ffe9d1;\n}\n\n.house-roof {\n  fill: var(--pink);\n}\n\n.house-door {\n  fill: var(--violet);\n}\n\n.house-window {\n  fill: #a9c8f2;\n}\n\n.sky-afternoon .sky-top { stop-color: #4fb3ff; }\n.sky-afternoon .sky-bottom { stop-color: #c6ecff; }\n.sky-afternoon .hill-back { fill: #5cc47a; }\n.sky-afternoon .hill-front { fill: #2e9a5e; }\n\n.sky-evening .sky-top { stop-color: #ff6f61; }\n.sky-evening .sky-bottom { stop-color: #ffcf7a; }\n.sky-evening .sun { fill: #ff9a3c; transform: translate(-25px, 30px); }\n.sky-evening .hill-back { fill: #8a5bb8; }\n.sky-evening .hill-front { fill: #5d3a91; }\n.sky-evening .house-window { fill: var(--sun); }\n\n.sky-dusk .sky-top { stop-color: #33238a; }\n.sky-dusk .sky-bottom { stop-color: #d15d9b; }\n.sky-dusk .sun { opacity: 0; transform: translate(-40px, 60px); }\n.sky-dusk .moon { opacity: 1; }\n.sky-dusk .stars { opacity: 0.5; }\n.sky-dusk .hill-back { fill: #4a2f86; }\n.sky-dusk .hill-front { fill: #2c1d5e; }\n.sky-dusk .house-window { fill: var(--sun); }\n\n.sky-night .sky-top { stop-color: #0d0a33; }\n.sky-night .sky-bottom { stop-color: #3a2a86; }\n.sky-night .sun { opacity: 0; transform: translate(-40px, 60px); }\n.sky-night .moon { opacity: 1; }\n.sky-night .stars { opacity: 1; }\n.sky-night .hill-back { fill: #2a1f66; }\n.sky-night .hill-front { fill: #17123f; }\n.sky-night .house-window { fill: var(--sun); }\n\n/* ---------- Icons and tiles ---------- */\n\n.icon {\n  width: 1.25em;\n  height: 1.25em;\n  flex: none;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2.25;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.icon-fill {\n  fill: currentColor;\n  stroke: none;\n}\n\n.tile {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  flex: none;\n  width: 2.5rem;\n  height: 2.5rem;\n  border: 2px solid var(--ink);\n  border-radius: 10px;\n  color: #ffffff;\n  font-size: 1.25rem;\n}\n\n.tile-small {\n  width: 1.875rem;\n  height: 1.875rem;\n  border-radius: 8px;\n  font-size: 1rem;\n}\n\n.tile-violet,\n.subject-math { background: var(--violet); }\n.tile-teal,\n.subject-science { background: var(--teal); }\n.tile-pink,\n.subject-reading { background: var(--pink); }\n.tile-orange,\n.subject-spanish { background: var(--orange); }\n.subject-history { background: var(--blue); }\n.tile-ink { background: var(--ink); color: var(--sun); }\n\n/* ---------- Screens ---------- */\n\n.load-error {\n  margin-block-start: 0.625rem;\n  padding: 0.75rem 1rem;\n  background: var(--warn-bg);\n  border: 3px solid var(--warn-line);\n  border-radius: var(--radius);\n  color: var(--warn-ink);\n  font-weight: 700;\n}\n\n.screen,\n.planner {\n  padding: 0.75rem;\n  background: var(--surface);\n  border: 3px solid var(--ink);\n  border-radius: var(--radius-big);\n  box-shadow: 4px 4px 0 var(--shadow);\n}\n\n.screen {\n  animation: pop-in 220ms ease-out;\n}\n\n.screen > * + *,\n.stack > * + * {\n  margin-block-start: 0.625rem;\n}\n\n.screen h2 {\n  font-size: 1.15rem;\n  line-height: 1.25;\n}\n\n.screen h3 {\n  font-size: 1.0625rem;\n}\n\n.screen-head {\n  display: flex;\n  align-items: center;\n  gap: 0.625rem;\n}\n\n.progress-text {\n  color: var(--muted);\n  font-size: 0.9375rem;\n  font-weight: 700;\n}\n\n.task-time {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.35rem 0.9rem 0.35rem 0.6rem;\n  background: var(--ink);\n  border-radius: 999px;\n  color: #ffffff;\n  font-size: 1rem;\n  font-weight: 800;\n  font-variant-numeric: tabular-nums;\n}\n\n.task-time-icon {\n  display: inline-flex;\n  color: var(--sun);\n}\n\n.story-note {\n  position: relative;\n  padding: 0.75rem 0.75rem 0.625rem;\n  background: var(--sticky);\n  border: 2px solid var(--ink);\n  border-radius: 6px;\n}\n\n.story-due {\n  font-weight: 700;\n}\n\n.story-note::before {\n  content: \"\";\n  position: absolute;\n  inset-block-start: -0.55rem;\n  inset-inline-start: 1rem;\n  width: 3.5rem;\n  height: 1rem;\n  background: var(--shadow);\n  border: 2px solid var(--ink);\n  border-radius: 3px;\n  transform: rotate(-4deg);\n}\n\n/* ---------- Buttons ---------- */\n\n.button-primary {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.5rem;\n  width: 100%;\n  min-height: 48px;\n  padding: 0.625rem 1rem;\n  background: var(--violet);\n  border: 3px solid var(--ink);\n  border-radius: 14px;\n  box-shadow: 4px 4px 0 var(--ink);\n  color: #ffffff;\n  font: inherit;\n  font-size: 1.0625rem;\n  font-weight: 800;\n  cursor: pointer;\n  transition: transform 120ms ease, box-shadow 120ms ease;\n}\n\n.button-primary:hover {\n  background: var(--violet-dark);\n}\n\n.button-primary:active {\n  transform: translate(3px, 3px);\n  box-shadow: 1px 1px 0 var(--ink);\n}\n\n.button-icon {\n  display: inline-flex;\n  color: var(--sun);\n}\n\n.choices {\n  display: flex;\n  flex-direction: column;\n  gap: 0.625rem;\n}\n\n.choice {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  width: 100%;\n  min-height: 56px;\n  padding: 0.5rem 0.75rem;\n  background: var(--surface);\n  border: 3px solid var(--ink);\n  border-radius: 14px;\n  box-shadow: 4px 4px 0 var(--ink);\n  color: var(--ink);\n  font: inherit;\n  text-align: start;\n  cursor: pointer;\n  transition: transform 120ms ease, box-shadow 120ms ease;\n}\n\n.choice:hover {\n  background: #f7f4ff;\n}\n\n.choice:active {\n  transform: translate(3px, 3px);\n  box-shadow: 1px 1px 0 var(--ink);\n}\n\n.choice:disabled {\n  background: #efedf5;\n  border-style: dashed;\n  border-color: var(--disabled);\n  box-shadow: none;\n  color: var(--muted);\n  cursor: not-allowed;\n  transform: none;\n}\n\n.choice:disabled .choice-tile {\n  background: var(--disabled);\n  border-color: var(--disabled);\n  color: #ffffff;\n}\n\n.choice-text {\n  display: flex;\n  flex-direction: column;\n  gap: 0.125rem;\n}\n\n.choice-label {\n  font-weight: 800;\n}\n\n.choice-hint {\n  color: var(--muted);\n  font-size: 0.9375rem;\n}\n\n:focus-visible {\n  outline: 3px solid var(--violet);\n  outline-offset: 3px;\n}\n\nh2:focus-visible {\n  border-radius: 4px;\n}\n\n/* ---------- Friday report ---------- */\n\n.report-cards {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(9.75rem, 1fr));\n  gap: 0.875rem;\n}\n\n.card {\n  overflow: hidden;\n  border: 3px solid var(--ink);\n  border-radius: var(--radius);\n  box-shadow: 4px 4px 0 var(--ink);\n}\n\n.card-label,\n.card-note {\n  color: var(--muted);\n  font-size: 0.875rem;\n  font-weight: 600;\n}\n\n.card-gradebook {\n  padding: 0.75rem 0.75rem 0.75rem 2.25rem;\n  background-color: var(--surface);\n  background-image:\n    linear-gradient(90deg, transparent 1.5rem, var(--paper-margin) 1.5rem, var(--paper-margin) calc(1.5rem + 2px), transparent calc(1.5rem + 2px)),\n    repeating-linear-gradient(180deg, transparent 0, transparent 1.45rem, var(--paper-line) 1.45rem, var(--paper-line) calc(1.45rem + 1px));\n}\n\n.card-gradebook > * + * {\n  margin-block-start: 0.25rem;\n}\n\n.gradebook-title {\n  color: var(--blue);\n  font-family: Georgia, \"Times New Roman\", serif;\n  font-size: 1.0625rem;\n  letter-spacing: 0;\n}\n\n.gradebook-value {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  font-size: 1.75rem;\n  font-weight: 800;\n  line-height: 1.2;\n}\n\n.gradebook-count {\n  font-size: 1rem;\n  font-weight: 700;\n}\n\n.gradebook-stamp {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 2.25rem;\n  height: 2.25rem;\n  background: var(--teal);\n  border: 2px solid var(--ink);\n  border-radius: 50%;\n  color: #ffffff;\n  font-size: 1.125rem;\n  transform: rotate(-8deg);\n}\n\n.gradebook-stamp.is-incomplete {\n  background: var(--orange);\n}\n\n.card-app {\n  display: flex;\n  flex-direction: column;\n  background: var(--surface);\n}\n\n.app-bar {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.5rem 0.75rem;\n  background: var(--ink);\n  color: #ffffff;\n}\n\n.app-logo {\n  display: inline-flex;\n  color: #5fe0c6;\n  font-size: 1.25rem;\n}\n\n.app-bar-title {\n  font-size: 1rem;\n}\n\n.app-body {\n  flex: 1 1 auto;\n  padding: 0.75rem;\n}\n\n.app-body > * + * {\n  margin-block-start: 0.5rem;\n}\n\n.status-pill {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.375rem;\n  padding: 0.3rem 0.75rem;\n  background: var(--surface);\n  border: 3px solid currentColor;\n  border-radius: 999px;\n  font-weight: 800;\n}\n\n.status-icon {\n  display: inline-flex;\n}\n\n.card-app.is-ok .app-body {\n  background: var(--ok-bg);\n}\n\n.card-app.is-ok .status-pill {\n  color: var(--ok-ink);\n  border-color: var(--ok-line);\n}\n\n.card-app.is-warn .app-body {\n  background: var(--warn-bg);\n}\n\n.card-app.is-warn .status-pill {\n  color: var(--warn-ink);\n  border-color: var(--warn-line);\n}\n\n.email {\n  padding: 0.875rem;\n  background: var(--surface);\n  border: 3px solid var(--ink);\n  border-radius: var(--radius);\n  box-shadow: 4px 4px 0 var(--warn-line);\n}\n\n.email-top {\n  display: flex;\n  align-items: center;\n  gap: 0.625rem;\n}\n\n.email-heading {\n  font-size: 1rem;\n}\n\n.email-meta {\n  display: grid;\n  grid-template-columns: auto 1fr;\n  gap: 0.125rem 0.5rem;\n  margin: 0.75rem 0 0;\n  padding-block-start: 0.625rem;\n  border-block-start: 2px dashed var(--line);\n  font-size: 0.9375rem;\n}\n\n.email-meta dt {\n  color: var(--muted);\n  font-weight: 600;\n}\n\n.email-meta dd {\n  margin: 0;\n  overflow-wrap: anywhere;\n}\n\n.email-subject {\n  font-weight: 800;\n}\n\n.email-body {\n  margin-block-start: 0.75rem;\n  padding-block-start: 0.75rem;\n  border-block-start: 2px dashed var(--line);\n}\n\n.ending {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.75rem;\n  padding: 0.875rem;\n  background: var(--sticky);\n  border: 3px solid var(--ink);\n  border-radius: var(--radius);\n}\n\n.ending h3 + p {\n  margin-block-start: 0.25rem;\n}\n\n/* ---------- Weekly checklist ---------- */\n\n.planner {\n  padding: 0.625rem;\n}\n\n.planner-heading {\n  font-size: 1rem;\n  line-height: 1.25;\n}\n\n.planner-list {\n  margin: 0.375rem 0 0;\n  padding: 0;\n  list-style: none;\n}\n\n.planner-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.5rem;\n  padding: 0.375rem;\n  border: 2px solid transparent;\n  border-block-end-color: var(--line);\n  border-block-end-style: dashed;\n}\n\n.planner-item:last-child {\n  border-block-end-color: transparent;\n}\n\n.planner-item.is-current {\n  background: var(--sticky);\n  border: 2px solid var(--ink);\n  border-radius: 10px;\n}\n\n.planner-tile {\n  position: relative;\n  display: inline-flex;\n  flex: none;\n}\n\n.planner-mark {\n  position: absolute;\n  inset-block-end: -0.35rem;\n  inset-inline-end: -0.35rem;\n  display: inline-flex;\n  padding: 1px;\n  background: var(--surface);\n  border-radius: 50%;\n  font-size: 0.875rem;\n}\n\n.planner-item.is-done .planner-mark {\n  color: var(--teal);\n}\n\n.planner-item.is-current .planner-mark {\n  color: var(--violet);\n}\n\n.planner-item.is-skipped .planner-mark {\n  color: var(--orange);\n}\n\n.planner-text {\n  flex: 1 1 auto;\n  min-width: 0;\n  line-height: 1.3;\n}\n\n.planner-title {\n  display: block;\n  font-size: 0.875rem;\n  font-weight: 800;\n}\n\n.planner-status {\n  display: block;\n  color: var(--muted);\n  font-size: 0.8125rem;\n}\n\n.planner-item.is-done .planner-status {\n  color: var(--done-ink);\n  font-weight: 600;\n}\n\n.planner-item.is-skipped .planner-status {\n  color: var(--warn-ink);\n  font-weight: 600;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n@keyframes pop-in {\n  from {\n    opacity: 0;\n    transform: scale(0.97);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .screen {\n    animation: none;\n  }\n\n  .sky-top,\n  .sky-bottom,\n  .sun,\n  .moon,\n  .stars,\n  .hill-back,\n  .hill-front,\n  .house-window,\n  .button-primary,\n  .choice {\n    transition: none;\n  }\n}",
