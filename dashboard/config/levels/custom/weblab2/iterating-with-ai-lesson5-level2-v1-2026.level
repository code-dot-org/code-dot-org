      "files": {
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const checkIns = [\n  {\n    student: \"Maya\",\n    teamCode: \"B\",\n    checkInBlock: \"AM\",\n    pointsEarned: 18\n  },\n  {\n    student: \"Jordan\",\n    teamCode: null,\n    checkInBlock: \"PM\",\n    pointsEarned: 21\n  },\n  {\n    student: \"Avery\",\n    teamCode: \"G\",\n    checkInBlock: null,\n    pointsEarned: 19\n  },\n  {\n    student: \"Luis\",\n    teamCode: \"R\",\n    checkInBlock: \"AM\",\n    pointsEarned: null\n  }\n];\n\nshowCheckInCards(checkIns);\n",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
          "name": "notes.md",
          "contents": "For the Check-In Records dataset\n* What values did AI Tutor fill in? Do they seem reasonable? Why or why not?\n\n\n* Were there any values AI Tutor filled in that surprised you?\n\n\n* What information do you think AI Tutor used to make its guesses?\n\n\n",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>Missing Data and Labels</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    <main class=\"layout\">\n      <section>\n        <h2>Check-In Records</h2>\n        <div id=\"check-in-records\" class=\"card-grid\"></div>\n      </section>\n    </main>\n\n    <script src=\"helpers.js\" defer></script>\n    <script src=\"script.js\" defer></script>\n  </body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "6": {
          "id": "6",
          "name": "style.css",
          "contents": "body {\n  font-family: Arial, sans-serif;\n  margin: 0;\n  padding: 32px;\n  background: #eef2f7;\n  color: #222;\n}\n\n.layout {\n  max-width: 1000px;\n  margin: 0 auto;\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 24px;\n}\n\nsection {\n  background: #ffffff;\n  border: 1px solid #d7deea;\n  border-radius: 16px;\n  padding: 24px;\n  box-shadow: 0 8px 24px rgba(31, 41, 55, 0.08);\n}\n\nh2 {\n  margin: 0 0 18px;\n  font-size: 1.3rem;\n  color: #1f2937;\n}\n\n.card-grid {\n  display: grid;\n  gap: 14px;\n}\n\n.card {\n  background: #f9fafb;\n  border: 1px solid #e1e7ef;\n  border-radius: 12px;\n  padding: 16px;\n}\n\n.card p {\n  margin: 8px 0;\n  line-height: 1.4;\n}\n\n.label {\n  font-weight: bold;\n  color: #374151;\n}\n\n.missing {\n  color: #9a3412;\n  font-style: italic;\n}\n\n@media (max-width: 800px) {\n  body {\n    padding: 20px;\n  }\n\n  .layout {\n    grid-template-columns: 1fr;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "7": {
          "id": "7",
          "name": "helpers.js",
          "contents": "function showValue(value) {\n  if (value === null) {\n    return \"<span class='missing'>Missing data</span>\";\n  }\n\n  return value;\n}\n\nfunction showCheckInCards(checkIns) {\n  const checkInRecords = document.querySelector(\"#check-in-records\");\n\n  for (let i = 0; i < checkIns.length; i++) {\n    checkInRecords.innerHTML += `\n      <div class=\"card\">\n        <p><strong>Student:</strong> ${showValue(checkIns[i].student)}</p>\n        <p><strong>Team Code:</strong> ${showValue(checkIns[i].teamCode)}</p>\n        <p><strong>Check-In Block:</strong> ${showValue(checkIns[i].checkInBlock)}</p>\n        <p><strong>Points Earned:</strong> ${showValue(checkIns[i].pointsEarned)}</p>\n      </div>\n    `;\n  }\n}",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "3",
        "4"
      ]
    },
