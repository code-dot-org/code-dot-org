          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Color Fill Bar Loop</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <h1>Progress Bar</h1>\n\n  <div id=\"bar-container\">\n    <div id=\"bar\"></div>\n  </div>\n  <br/>\n    <button id=\"runLoop\">Run Loop</button>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: system-ui, sans-serif;\n  background: #f6f9fc;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  height: 100vh;\n}\n\nh1 {\n  margin-bottom: 10px;\n}\n\n#bar-container {\n  width: 300px;\n  height: 30px;\n  background: repeating-linear-gradient(\n    to right,\n    #e0e0e0,\n    #e0e0e0 29px,\n    #ff0000 30px\n  );\n  border-radius: 8px;\n  overflow: hidden;\n  margin-top: 20px;\n  box-shadow: inset 0 0 4px rgba(0, 0, 0, 0.1);\n}\n\n#bar {\n  width: 0%;\n  height: 100%;\n  background: #6dd5fa;\n  transition: width 0.2s ease;\n}\n\nbutton {\n  background: #2980b9;\n  color: white;\n  border: none;\n  padding: 10px 18px;\n  border-radius: 6px;\n  cursor: pointer;\n  font-size: 1rem;\n}\n\nbutton:hover {\n  background: #2573a8;\n}\n",
          "folderId": "0",
          "active": false
        },
