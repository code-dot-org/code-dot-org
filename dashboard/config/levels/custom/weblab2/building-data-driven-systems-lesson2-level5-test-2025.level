    "start_sources": {
      "folders": {
        "1": {
          "id": "1",
          "name": "images",
          "parentId": "0"
        }
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Debug: Tech Store</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n  <header>\n    <h1>Tech Head's Gear Store</h1>\n  </header>\n\n  <main id=\"storefront\">\n    \n    <div class=\"product-card\" id=\"card-1\">\n      <img id=\"img-1\" src=\"/images/laptop.png\" alt=\"\">\n      <h2 id=\"name-1\">Loading...</h2>\n      <p id=\"desc-1\"></p>\n      <p class=\"price\" id=\"price-1\"></p>\n    </div>\n\n    <div class=\"product-card\" id=\"card-2\">\n      <img id=\"img-2\" src=\"/images/headphones.png\" alt=\"\">\n      <h2 id=\"name-2\">Loading...</h2>\n      <p id=\"desc-2\"></p>\n      <p class=\"price\" id=\"price-2\"></p>\n    </div>\n\n    <div class=\"product-card\" id=\"card-3\">\n      <img id=\"img-3\" src=\"/images/camera.png\" alt=\"\">\n      <h2 id=\"name-3\">Loading...</h2>\n      <p id=\"desc-3\"></p>\n      <p class=\"price\" id=\"price-3\"></p>\n    </div>\n\n  </main>\n\n  <script src=\"script.js\" defer></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// DATA: Parallel Arrays\nconst names = [\"Laptop\", \"Headphones\", \"Camera\"];\nconst prices = [899.99, 49.99]; \nconst images = [\n  \"https://code.org/images/laptop.png\",\n  \"https://code.org/images/headphones.png\",\n  \"https://code.org/images/camera.png\"\n];\nconst descriptions = [\n  \"Powerful computer for gamers.\",\n  \"Noise-cancelling audio. 3D sound.\",\n  \"Perfect for vlogging.\"\n];\n\n// DISPLAY\n// --- Product 1 (Index 0) ---\ndocument.querySelector(\"#name-1\").textContent = names[0];\ndocument.querySelector(\"#img-1\").src = images[0];\ndocument.querySelector(\"#desc-1\").textContent = descriptions[0];\ndocument.querySelector(\"#price-1\").textContent = \"$\" + prices[0];\n\n// --- Product 2 (Index 1) ---\ndocument.querySelector(\"#name-2\").textContent = names[1];\ndocument.querySelector(\"#img-2\").src = images[2]; //\ndocument.querySelector(\"#desc-2\").textContent = descriptions[1];\ndocument.querySelector(\"#price-2\").textContent = \"$\" + prices[1];\n\n// --- Product 3 (Index 2) ---\ndocument.querySelector(\"#name-3\").textContent = names[2];\ndocument.querySelector(\"#img-3\").src = images[2];\ndocument.querySelector(\"#desc-3\").textContent = descriptions[2];\ndocument.querySelector(\"#price-3\").textContent = \"$\" + prices[2];",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": ":root {\n  --primary: #333;\n  --accent: #e74c3c;\n  --bg: #f0f2f5;\n}\n\nbody {\n  font-family: 'Segoe UI', sans-serif;\n  background-color: var(--bg);\n  color: var(--primary);\n  text-align: center;\n  margin: 0;\n  padding: 20px;\n}\n\nheader { \n  margin-bottom: 30px; \n}\n\n#storefront {\n  display: flex;\n  justify-content: center;\n  gap: 20px;\n  flex-wrap: wrap;\n}\n\n.product-card {\n  background: white;\n  border-radius: 8px;\n  border: 1px solid #ccc;\n  padding: 15px;\n  width: 220px;\n  text-align: left;\n  box-shadow: 0 4px 6px rgba(0,0,0,0.1);\n}\n\n.product-card img {\n  width: 100%;\n  height: 150px;\n  object-fit: contain; /* Keeps images from looking squashed */\n  background: #fff;\n  margin-bottom: 10px;\n}\n\n.product-card h2 {\n  font-size: 1.25rem;\n  margin: 5px 0;\n}\n\n.product-card p {\n  font-size: 0.9rem;\n  color: #666;\n  margin: 5px 0 10px 0;\n}\n\n.price {\n  font-size: 1.1rem;\n  color: var(--accent);\n  font-weight: bold;\n}",
          "folderId": "0",
          "active": false
        },
