          "contents": "{\n  \"schemaVersion\": 1,\n  \"configId\": \"codeai-default\",\n  \"theme\": {\n    \"background\": \"#E4E2F8\",\n    \"cardFace\": \"#FFFFFF\",\n    \"textColor\": \"#000000\",\n    \"accent\": \"#4C42CF\",\n    \"frameColors\": {\n      \"word\": \"#0099F3\",\n      \"definition\": \"#003F25\",\n      \"example\": \"#F46800\",\n      \"image\": \"#4C42CF\"\n    },\n    \"fontFamily\": \"system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif\",\n    \"wordSize\": \"large\",\n    \"textAlign\": \"center\",\n    \"textPosition\": \"center\",\n    \"cornerRadius\": \"medium\"\n  },\n  \"controls\": {\n    \"shuffle\": true,\n    \"flipDirection\": true,\n    \"progressCounter\": true,\n    \"markKnown\": true,\n    \"wordBank\": true\n  },\n  \"startFlipped\": false,\n  \"startShuffled\": true,\n  \"randomizeTypes\": false,\n  \"randomizeAlternates\": true,\n  \"studentStylePicker\": false,\n  \"lessonPicker\": true,\n  \"practiceModes\": [\n    \"definition-word\",\n    \"example-word\"\n  ],\n  \"sessionSize\": 10\n}",
