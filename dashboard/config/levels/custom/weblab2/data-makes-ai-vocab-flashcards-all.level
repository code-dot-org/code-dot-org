  "user_id": 18603,
  "properties": {
    "encrypted": "false",
    "long_instructions": "# Vocabulary Practice Flashcards\r\n\r\n* Select the last lesson that you have completed. These flashcards will include all vocabulary up to and including that lesson.\r\n\r\n* Select whether you would like to practice by looking at definition of the vocabulary word or  actual examples of the vocabulary word.\r\n\r\n* You can update your settings at any time by using the controls underneath the deck.",
    "offer_browser_tts": "false",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "true",
    "widget_view": "true",
    "require_edit_to_continue": "false",
    "initial_view_mode": "split",
    "hide_ai_tutor": "true",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "placeholderText": "",
      "multipleChoiceOptions": [
        ""
      ],
      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false
    },
    "ai_tutor_prompt_settings": {
      "answerTypes": [
        "ask"
      ],
      "answerTypeCustomizations": {
      }
    },
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en-US\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Vocabulary cards</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"app\" id=\"app\">\n    <div class=\"app-column\">\n    <h1 class=\"deck-title\" id=\"deck-title\">Vocabulary cards</h1>\n\n    <section class=\"setup\" id=\"setup\" aria-labelledby=\"setup-title\" hidden>\n      <h2 class=\"setup-title\" id=\"setup-title\">Pick what to practice</h2>\n      <div class=\"setup-field\" id=\"lesson-field\">\n        <label class=\"setup-label\" for=\"lesson-select\" id=\"lesson-label\">Which lesson are you on?</label>\n        <select class=\"setup-select\" id=\"lesson-select\" aria-describedby=\"setup-count\"></select>\n      </div>\n      <fieldset class=\"setup-field\" id=\"mode-field\">\n        <legend class=\"setup-label\" id=\"mode-legend\">What do you want to see first?</legend>\n        <div class=\"mode-options\" id=\"mode-options\"></div>\n      </fieldset>\n      <p class=\"setup-count\" id=\"setup-count\" aria-live=\"polite\"></p>\n      <p class=\"setup-error\" id=\"setup-error\" aria-live=\"assertive\"></p>\n      <button type=\"button\" class=\"btn btn-start\" id=\"btn-start\">\n        <span class=\"btn-label\">Start practicing</span>\n      </button>\n    </section>\n\n    <div class=\"stage\">\n      <div class=\"card\" id=\"card\" tabindex=\"0\" role=\"group\" aria-labelledby=\"deck-title\" hidden>\n        <div class=\"card-inner\">\n          <section class=\"card-face card-front\" id=\"card-front\">\n            <span class=\"card-label\"></span>\n            <div class=\"card-content\"></div>\n            <p class=\"card-hint\"></p>\n          </section>\n          <section class=\"card-face card-back\" id=\"card-back\" aria-hidden=\"true\">\n            <span class=\"card-label\"></span>\n            <div class=\"card-content\"></div>\n          </section>\n        </div>\n      </div>\n\n      <div class=\"message\" id=\"message\" tabindex=\"-1\">\n        <p class=\"message-text\" id=\"message-text\">Loading cards...</p>\n        <p class=\"message-detail\" id=\"message-detail\" hidden></p>\n        <div class=\"message-actions\" id=\"message-actions\" hidden>\n          <button type=\"button\" class=\"btn\" id=\"finish-restart\">\n            <span class=\"btn-label\">Start over</span>\n            <span class=\"btn-key\">R</span>\n          </button>\n          <button type=\"button\" class=\"btn btn-secondary\" id=\"finish-review\" hidden>\n            <span class=\"btn-label\"></span>\n          </button>\n          <button type=\"button\" class=\"btn btn-secondary\" id=\"finish-new\" hidden>\n            <span class=\"btn-label\"></span>\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"controls controls-primary\">\n      <button type=\"button\" class=\"btn\" id=\"btn-back\" disabled>\n        <span class=\"btn-label\">Back</span>\n        <span class=\"btn-key\">Left</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-flip\" id=\"btn-flip\" disabled>\n        <span class=\"btn-label\">Flip</span>\n        <span class=\"btn-key\">Space</span>\n      </button>\n      <button type=\"button\" class=\"btn\" id=\"btn-next\" disabled>\n        <span class=\"btn-label\">Next</span>\n        <span class=\"btn-key\">Right</span>\n      </button>\n    </div>\n\n    <fieldset class=\"controls controls-secondary\" id=\"options\">\n      <legend class=\"visually-hidden\" id=\"options-legend\">Card options</legend>\n      <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-shuffle\" disabled>\n        <span class=\"btn-label\">Shuffle</span>\n        <span class=\"btn-key\">S</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-direction\" disabled>\n        <span class=\"btn-label\">Start from definition</span>\n        <span class=\"btn-key\">F</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-secondary btn-toggle\" id=\"btn-known\" aria-pressed=\"false\" disabled>\n        <span class=\"btn-label\">\n          <svg class=\"check-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2.5 8.5l3.5 3.5 7.5-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          <span class=\"btn-text\">Got it</span>\n        </span>\n        <span class=\"btn-key\">K</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-restart\" disabled>\n        <span class=\"btn-label\">Start over</span>\n        <span class=\"btn-key\">R</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-setup\" hidden>\n        <span class=\"btn-label\">Change lesson</span>\n        <span class=\"btn-key\">L</span>\n      </button>\n    </fieldset>\n\n    <fieldset class=\"style-picker\" id=\"style-picker\" hidden>\n      <legend class=\"visually-hidden\" id=\"style-legend\">Practice with</legend>\n      <button type=\"button\" class=\"chip\" data-kind=\"definition\" aria-pressed=\"true\">\n        <span class=\"btn-label\">\n          <svg class=\"check-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2.5 8.5l3.5 3.5 7.5-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          <span class=\"btn-text\">Definitions</span>\n        </span>\n        <span class=\"btn-key\">1</span>\n      </button>\n      <button type=\"button\" class=\"chip\" data-kind=\"example\" aria-pressed=\"true\">\n        <span class=\"btn-label\">\n          <svg class=\"check-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2.5 8.5l3.5 3.5 7.5-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          <span class=\"btn-text\">Examples</span>\n        </span>\n        <span class=\"btn-key\">2</span>\n      </button>\n      <button type=\"button\" class=\"chip\" data-kind=\"image\" aria-pressed=\"true\">\n        <span class=\"btn-label\">\n          <svg class=\"check-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2.5 8.5l3.5 3.5 7.5-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          <span class=\"btn-text\">Pictures</span>\n        </span>\n        <span class=\"btn-key\">3</span>\n      </button>\n    </fieldset>\n\n    <div class=\"status\" aria-live=\"polite\">\n      <p class=\"counter\" id=\"counter\"></p>\n      <p class=\"visually-hidden\" id=\"sr-status\"></p>\n    </div>\n    </div>\n\n    <aside class=\"word-bank\" id=\"word-bank\" aria-labelledby=\"word-bank-title\" hidden>\n      <h2 class=\"word-bank-title\" id=\"word-bank-title\">Word bank</h2>\n      <p class=\"word-bank-summary\" id=\"word-bank-summary\"></p>\n      <div class=\"word-bank-scroll\" id=\"word-bank-scroll\" tabindex=\"0\" role=\"region\" aria-labelledby=\"word-bank-title\">\n        <ul class=\"word-bank-list\" id=\"word-bank-list\"></ul>\n      </div>\n    </aside>\n  </main>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "\"use strict\";\n\nconst STRINGS = {\n  pageTitle: \"Vocabulary cards\",\n  loading: \"Loading cards...\",\n  loadErrorDeck: \"The cards didn’t load. Ask your teacher to check deck.json.\",\n  loadErrorConfig: \"The cards didn’t load. Ask your teacher to check config.json.\",\n  kindLabels: {\n    word: \"WORD\",\n    definition: \"DEFINITION\",\n    example: \"EXAMPLE\",\n    image: \"IMAGE\"\n  },\n  kindNames: {\n    word: \"Word\",\n    definition: \"Definition\",\n    example: \"Example\",\n    image: \"Picture\"\n  },\n  hints: {\n    word: \"Guess the word\",\n    definition: \"Guess the definition\",\n    example: \"Guess the example\"\n  },\n  back: \"Back\",\n  flip: \"Flip\",\n  next: \"Next\",\n  keys: {\n    back: \"Left\",\n    flip: \"Space\",\n    next: \"Right\",\n    shuffle: \"S\",\n    direction: \"F\",\n    known: \"K\",\n    restart: \"R\",\n    setup: \"L\"\n  },\n  optionsLegend: \"Card options\",\n  shuffle: \"Shuffle\",\n  startFrom: {\n    word: \"Start from word\",\n    definition: \"Start from definition\",\n    example: \"Start from example\"\n  },\n  gotIt: \"Got it\",\n  startOver: \"Start over\",\n  counter: (position, total) => `Card ${position} of ${total}`,\n  leftToLearn: {\n    one: (count) => `${count} left to learn`,\n    other: (count) => `${count} left to learn`\n  },\n  finished: {\n    one: () => \"You went through the only card\",\n    other: (count) => `You went through all ${count} cards`\n  },\n  allKnown: \"You marked every card. Nice work.\",\n  roundProgress: (seen, total) => `You’ve seen ${seen} of ${total} words so far.`,\n  newRound: (count) => (count === 1 ? \"Try 1 new word\" : `Try ${count} new words`),\n  setupRound: (size, count) => `You’ll practice ${size} random words at a time, out of ${count}.`,\n  setupRoundThrough: (size, count, lesson) => `You’ll practice ${size} random words at a time, out of ${count} from Lessons 1 to ${lesson}.`,\n  reviewUnknown: {\n    one: () => \"Review the 1 you haven’t marked\",\n    other: (count) => `Review the ${count} you haven’t marked`\n  },\n  faceAnnouncement: (kindName, content) => `${kindName}: ${content}`,\n  cardAnnouncement: (position, face, hint) => `${position}. ${face} ${hint}.`,\n  flipAnnouncement: (face) => `Other side. ${face}`,\n  shuffledAnnouncement: (position) => `Cards shuffled. ${position}.`,\n  knownAnnouncement: \"Marked as known.\",\n  unknownAnnouncement: \"Not marked as known.\",\n  firstCardAnnouncement: \"This is the first card.\",\n  pictureMissing: \"Picture not available.\",\n  styleLegend: \"Practice with\",\n  kindChips: {\n    definition: \"Definitions\",\n    example: \"Examples\",\n    image: \"Pictures\"\n  },\n  kindChipKeys: {\n    definition: \"1\",\n    example: \"2\",\n    image: \"3\"\n  },\n  kindOnAnnouncement: {\n    one: (label, count) => `${label} on. ${count} card in play.`,\n    other: (label, count) => `${label} on. ${count} cards in play.`\n  },\n  kindOffAnnouncement: {\n    one: (label, count) => `${label} off. ${count} card in play.`,\n    other: (label, count) => `${label} off. ${count} cards in play.`\n  },\n  keepOneKind: \"Keep at least one kind turned on.\",\n  wordBankTitle: \"Word bank\",\n  wordBankDone: (seen, total) => `Done: ${seen} of ${total}`,\n  wordBankKnown: (known) => `Got it: ${known}`,\n  wordStatusSeen: \"done\",\n  wordStatusKnown: \"Got it\",\n  setupTitle: \"Pick what to practice\",\n  lessonQuestion: \"Which lesson are you on?\",\n  lessonPlaceholder: \"Pick a lesson\",\n  lessonOption: (number, title) => (title ? `Lesson ${number}: ${title}` : `Lesson ${number}`),\n  modeQuestion: \"What do you want to see first?\",\n  modeNames: {\n    \"word-definition\": \"Word → Definition\",\n    \"definition-word\": \"Definition → Word\",\n    \"image-word\": \"Picture → Word\",\n    \"example-word\": \"Example → Word\",\n    \"word-example\": \"Word → Example\"\n  },\n  modeDescriptions: {\n    \"word-definition\": \"Read a word, then say what it means.\",\n    \"definition-word\": \"Read a definition, then guess the word.\",\n    \"image-word\": \"Look at a picture, then guess the word.\",\n    \"example-word\": \"Read an example, then guess the word.\",\n    \"word-example\": \"Read a word, then think of an example.\"\n  },\n  setupCount: {\n    one: (count) => `You’ll practice ${count} word.`,\n    other: (count) => `You’ll practice ${count} words.`\n  },\n  setupCountThrough: {\n    one: (lesson, count) => `You’ll practice ${count} word from Lessons 1 to ${lesson}.`,\n    other: (lesson, count) => `You’ll practice ${count} words from Lessons 1 to ${lesson}.`\n  },\n  pickLessonFirst: \"Pick your lesson first.\",\n  noWordsForChoice: \"There are no words for that choice yet. Try a different lesson or a different way to practice.\",\n  startPracticing: \"Start practicing\",\n  changeLesson: \"Change lesson\"\n};\n\nconst CARD_TYPES = {\n  \"word-definition\": { front: \"word\", back: \"definition\", mirror: \"definition-word\" },\n  \"definition-word\": { front: \"definition\", back: \"word\", mirror: \"word-definition\" },\n  \"image-word\": { front: \"image\", back: \"word-definition\", mirror: null },\n  \"example-word\": { front: \"example\", back: \"word\", mirror: \"word-example\" },\n  \"word-example\": { front: \"word\", back: \"example\", mirror: \"example-word\" }\n};\n\nconst DEFAULT_CONFIG = {\n  theme: {\n    background: \"#E4E2F8\",\n    cardFace: \"#FFFFFF\",\n    textColor: \"#000000\",\n    accent: \"#4C42CF\",\n    frameColors: {\n      word: \"#0099F3\",\n      definition: \"#003F25\",\n      example: \"#F46800\",\n      image: \"#4C42CF\"\n    },\n    fontFamily: \"system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif\",\n    wordSize: \"large\",\n    textAlign: \"center\",\n    textPosition: \"center\",\n    cornerRadius: \"medium\"\n  },\n  controls: {\n    shuffle: true,\n    flipDirection: true,\n    progressCounter: true,\n    markKnown: true,\n    wordBank: false\n  },\n  startFlipped: false,\n  startShuffled: false,\n  randomizeTypes: false,\n  randomizeAlternates: true,\n  studentStylePicker: false,\n  sessionSize: 0,\n  lessonPicker: false,\n  practiceModes: []\n};\n\nconst ENUMS = {\n  wordSize: [\"medium\", \"large\", \"xlarge\"],\n  textAlign: [\"start\", \"center\"],\n  textPosition: [\"top\", \"center\"],\n  cornerRadius: [\"none\", \"medium\", \"round\"]\n};\n\nconst TYPE_NAMES = Object.keys(CARD_TYPES);\nconst KIND_TYPES = {\n  definition: [\"word-definition\", \"definition-word\"],\n  example: [\"example-word\", \"word-example\"],\n  image: [\"image-word\"]\n};\nconst PICKER_KINDS = [\"definition\", \"example\", \"image\"];\nconst RTL_LANGUAGES = [\"ar\", \"dv\", \"fa\", \"he\", \"ps\", \"ur\", \"yi\"];\nconst SVG_NS = \"http://www.w3.org/2000/svg\";\n\nconst state = {\n  ready: false,\n  config: DEFAULT_CONFIG,\n  title: STRINGS.pageTitle,\n  cards: [],\n  typesInPlay: TYPE_NAMES.slice(),\n  pass: [],\n  showing: null,\n  lastPicks: new Map(),\n  lessons: [],\n  lesson: null,\n  mode: null,\n  onSetup: false,\n  seen: new Set(),\n  session: null,\n  pickerKinds: [],\n  selectedKinds: new Set(),\n  index: 0,\n  flipped: false,\n  reversed: false,\n  finished: false,\n  known: new Set()\n};\n\nconst els = {};\n\ndocument.addEventListener(\"DOMContentLoaded\", init);\n\nfunction init() {\n  cacheElements();\n  applyStrings();\n  bindEvents();\n  showMessage(STRINGS.loading);\n  loadData();\n}\n\nfunction cacheElements() {\n  const ids = [\n    \"app\", \"deck-title\", \"card\", \"card-front\", \"card-back\", \"message\", \"message-text\",\n    \"message-detail\", \"message-actions\", \"finish-restart\", \"finish-review\", \"finish-new\", \"btn-back\",\n    \"btn-flip\", \"btn-next\", \"options\", \"options-legend\", \"btn-shuffle\", \"btn-direction\",\n    \"btn-known\", \"btn-restart\", \"counter\", \"sr-status\", \"style-picker\", \"style-legend\",\n    \"setup\", \"setup-title\", \"lesson-field\", \"lesson-label\", \"lesson-select\", \"mode-field\", \"mode-legend\",\n    \"mode-options\", \"setup-count\", \"setup-error\", \"btn-start\", \"btn-setup\",\n    \"word-bank\", \"word-bank-title\", \"word-bank-summary\", \"word-bank-scroll\", \"word-bank-list\"\n  ];\n  ids.forEach((id) => {\n    els[toCamel(id)] = document.getElementById(id);\n  });\n}\n\nfunction toCamel(id) {\n  return id.replace(/-([a-z])/g, (match, letter) => letter.toUpperCase());\n}\n\nfunction applyStrings() {\n  document.title = STRINGS.pageTitle;\n  els.deckTitle.textContent = STRINGS.pageTitle;\n  setButtonText(els.btnBack, STRINGS.back, STRINGS.keys.back);\n  setButtonText(els.btnFlip, STRINGS.flip, STRINGS.keys.flip);\n  setButtonText(els.btnNext, STRINGS.next, STRINGS.keys.next);\n  setButtonText(els.btnShuffle, STRINGS.shuffle, STRINGS.keys.shuffle);\n  setButtonText(els.btnDirection, STRINGS.startFrom.definition, STRINGS.keys.direction);\n  setButtonText(els.btnKnown, STRINGS.gotIt, STRINGS.keys.known);\n  setButtonText(els.btnRestart, STRINGS.startOver, STRINGS.keys.restart);\n  setButtonText(els.finishRestart, STRINGS.startOver, STRINGS.keys.restart);\n  els.optionsLegend.textContent = STRINGS.optionsLegend;\n  els.styleLegend.textContent = STRINGS.styleLegend;\n  els.setupTitle.textContent = STRINGS.setupTitle;\n  els.wordBankTitle.textContent = STRINGS.wordBankTitle;\n  els.lessonLabel.textContent = STRINGS.lessonQuestion;\n  els.modeLegend.textContent = STRINGS.modeQuestion;\n  setButtonText(els.btnStart, STRINGS.startPracticing);\n  setButtonText(els.btnSetup, STRINGS.changeLesson, STRINGS.keys.setup);\n  kindChips().forEach((chip) => {\n    const kind = chip.getAttribute(\"data-kind\");\n    setButtonText(chip, STRINGS.kindChips[kind], STRINGS.kindChipKeys[kind]);\n  });\n}\n\nfunction kindChips() {\n  return Array.prototype.slice.call(els.stylePicker.querySelectorAll(\".chip\"));\n}\n\nfunction setButtonText(button, label, key) {\n  const text = button.querySelector(\".btn-text\") || button.querySelector(\".btn-label\");\n  text.textContent = label;\n  const keyEl = button.querySelector(\".btn-key\");\n  if (keyEl) {\n    keyEl.textContent = key;\n  }\n}\n\nfunction bindEvents() {\n  els.btnBack.addEventListener(\"click\", goBack);\n  els.btnFlip.addEventListener(\"click\", flip);\n  els.btnNext.addEventListener(\"click\", goNext);\n  els.btnShuffle.addEventListener(\"click\", shuffleCards);\n  els.btnDirection.addEventListener(\"click\", switchDirection);\n  els.btnKnown.addEventListener(\"click\", toggleKnown);\n  els.btnRestart.addEventListener(\"click\", startOver);\n  els.btnSetup.addEventListener(\"click\", showSetup);\n  els.finishNew.addEventListener(\"click\", newRound);\n  els.btnStart.addEventListener(\"click\", startFromSetup);\n  els.lessonSelect.addEventListener(\"change\", updateSetupCount);\n  els.modeOptions.addEventListener(\"change\", updateSetupCount);\n  kindChips().forEach((chip) => {\n    chip.addEventListener(\"click\", () => toggleKind(chip.getAttribute(\"data-kind\")));\n  });\n  els.finishRestart.addEventListener(\"click\", startOver);\n  els.finishReview.addEventListener(\"click\", reviewUnknown);\n  document.addEventListener(\"keydown\", handleKeydown);\n}\n\n/* Loading */\n\nasync function loadData() {\n  let config;\n  try {\n    config = normalizeConfig(await fetchJson(\"config.json\"));\n  } catch (error) {\n    console.error(\"config.json could not be loaded:\", error);\n    showMessage(STRINGS.loadErrorConfig);\n    return;\n  }\n\n  let deck;\n  try {\n    deck = normalizeDeck(await fetchJson(\"deck.json\"));\n  } catch (error) {\n    console.error(\"deck.json could not be loaded:\", error);\n    showMessage(STRINGS.loadErrorDeck);\n    return;\n  }\n\n  start(config, deck);\n}\n\nasync function fetchJson(path) {\n  const response = await fetch(path, { cache: \"no-store\" });\n  if (!response.ok) {\n    throw new Error(`${path} returned status ${response.status}`);\n  }\n  return response.json();\n}\n\nfunction normalizeConfig(raw) {\n  if (!isObject(raw)) {\n    throw new Error(\"config.json must be a JSON object.\");\n  }\n  const theme = isObject(raw.theme) ? raw.theme : {};\n  const frames = isObject(theme.frameColors) ? theme.frameColors : {};\n  const controls = isObject(raw.controls) ? raw.controls : {};\n  const defaults = DEFAULT_CONFIG;\n\n  return {\n    theme: {\n      background: pickColor(theme.background, defaults.theme.background),\n      cardFace: pickColor(theme.cardFace, defaults.theme.cardFace),\n      textColor: pickColor(theme.textColor, defaults.theme.textColor),\n      accent: pickColor(theme.accent, defaults.theme.accent),\n      frameColors: {\n        word: pickColor(frames.word, defaults.theme.frameColors.word),\n        definition: pickColor(frames.definition, defaults.theme.frameColors.definition),\n        example: pickColor(frames.example, defaults.theme.frameColors.example),\n        image: pickColor(frames.image, defaults.theme.frameColors.image)\n      },\n      fontFamily: pickFont(theme.fontFamily, defaults.theme.fontFamily),\n      wordSize: pickEnum(theme.wordSize, \"wordSize\", defaults.theme.wordSize),\n      textAlign: pickEnum(theme.textAlign, \"textAlign\", defaults.theme.textAlign),\n      textPosition: pickEnum(theme.textPosition, \"textPosition\", defaults.theme.textPosition),\n      cornerRadius: pickEnum(theme.cornerRadius, \"cornerRadius\", defaults.theme.cornerRadius)\n    },\n    controls: {\n      shuffle: pickBoolean(controls.shuffle, defaults.controls.shuffle),\n      flipDirection: pickBoolean(controls.flipDirection, defaults.controls.flipDirection),\n      progressCounter: pickBoolean(controls.progressCounter, defaults.controls.progressCounter),\n      markKnown: pickBoolean(controls.markKnown, defaults.controls.markKnown),\n      wordBank: pickBoolean(controls.wordBank, defaults.controls.wordBank)\n    },\n    startFlipped: pickBoolean(raw.startFlipped, defaults.startFlipped),\n    startShuffled: pickBoolean(raw.startShuffled, defaults.startShuffled),\n    randomizeTypes: pickBoolean(raw.randomizeTypes, defaults.randomizeTypes),\n    randomizeAlternates: pickBoolean(raw.randomizeAlternates, defaults.randomizeAlternates),\n    studentStylePicker: pickBoolean(raw.studentStylePicker, defaults.studentStylePicker),\n    sessionSize: typeof raw.sessionSize === \"number\" && Math.floor(raw.sessionSize) === raw.sessionSize && raw.sessionSize >= 0\n      ? raw.sessionSize\n      : defaults.sessionSize,\n    lessonPicker: pickBoolean(raw.lessonPicker, defaults.lessonPicker),\n    practiceModes: Array.isArray(raw.practiceModes)\n      ? TYPE_NAMES.filter((type) => raw.practiceModes.indexOf(type) !== -1)\n      : defaults.practiceModes.slice()\n  };\n}\n\nfunction normalizeDeck(raw) {\n  if (!isObject(raw) || !Array.isArray(raw.cards)) {\n    throw new Error(\"deck.json needs a \\\"cards\\\" list.\");\n  }\n  const cards = [];\n  raw.cards.forEach((rawCard, position) => {\n    const card = normalizeCard(rawCard);\n    const problem = card ? findCardProblem(card) : \"it is not an object\";\n    if (problem) {\n      console.warn(`Skipping card ${position + 1} in deck.json: ${problem}`);\n      return;\n    }\n    cards.push(card);\n  });\n  if (cards.length === 0) {\n    throw new Error(\"deck.json has no usable cards.\");\n  }\n  const typesInPlay = Array.isArray(raw.typesInPlay)\n    ? raw.typesInPlay.filter((type) => Boolean(CARD_TYPES[type]))\n    : [];\n  return {\n    title: isFilledString(raw.title) ? raw.title.trim() : STRINGS.pageTitle,\n    lang: isFilledString(raw.lang) ? raw.lang.trim() : \"\",\n    lessons: normalizeLessons(raw.lessons),\n    typesInPlay: typesInPlay.length > 0 ? typesInPlay : TYPE_NAMES.slice(),\n    cards\n  };\n}\n\nfunction normalizeLessons(raw) {\n  if (!Array.isArray(raw)) {\n    return [];\n  }\n  const seen = {};\n  const lessons = [];\n  raw.forEach((lesson) => {\n    if (!isObject(lesson) || !isLessonNumber(lesson.number) || seen[lesson.number]) {\n      return;\n    }\n    seen[lesson.number] = true;\n    lessons.push({ number: lesson.number, title: isFilledString(lesson.title) ? lesson.title.trim() : \"\" });\n  });\n  return lessons.sort((a, b) => a.number - b.number);\n}\n\nfunction isLessonNumber(value) {\n  return typeof value === \"number\" && Math.floor(value) === value && value > 0;\n}\n\nfunction normalizeCard(raw) {\n  if (!isObject(raw)) {\n    return null;\n  }\n  return {\n    id: raw.id,\n    type: raw.type,\n    word: raw.word,\n    lesson: isLessonNumber(raw.lesson) ? raw.lesson : null,\n    definitions: toList(raw.definitions, raw.definition).filter(isFilledString),\n    examples: toList(raw.examples, raw.example).map(normalizeExample).filter(Boolean),\n    images: toList(raw.images, raw.image).filter((image) => isObject(image) && isFilledString(image.svg) && isFilledString(image.alt))\n  };\n}\n\nfunction normalizeExample(entry) {\n  if (isFilledString(entry)) {\n    return { text: entry.trim(), lesson: null };\n  }\n  if (isObject(entry) && isFilledString(entry.text)) {\n    return { text: entry.text.trim(), lesson: isLessonNumber(entry.lesson) ? entry.lesson : null };\n  }\n  return null;\n}\n\nfunction availableEntries(card, field) {\n  const list = card[field];\n  if (field !== \"examples\" || state.lesson === null) {\n    return list;\n  }\n  return list.filter((entry) => entry.lesson === null || entry.lesson <= state.lesson);\n}\n\nfunction toList(list, single) {\n  if (Array.isArray(list)) {\n    return list;\n  }\n  return single === undefined ? [] : [single];\n}\n\nfunction findCardProblem(card) {\n  if (!isFilledString(card.id)) {\n    return \"it has no id\";\n  }\n  if (!isFilledString(card.word)) {\n    return \"it has no word\";\n  }\n  if (!CARD_TYPES[card.type]) {\n    return `\"${card.type}\" is not a card type`;\n  }\n  if (!cardFits(card, card.type)) {\n    return `it is missing content its ${card.type} type needs (images also need alt text)`;\n  }\n  return \"\";\n}\n\nfunction cardFits(card, typeName) {\n  const type = CARD_TYPES[typeName];\n  const kinds = [type.front, type.back];\n  if (kinds.indexOf(\"definition\") !== -1 && card.definitions.length === 0) {\n    return false;\n  }\n  if (kinds.indexOf(\"example\") !== -1 && availableEntries(card, \"examples\").length === 0) {\n    return false;\n  }\n  if (kinds.indexOf(\"image\") !== -1 && card.images.length === 0) {\n    return false;\n  }\n  return true;\n}\n\nfunction isObject(value) {\n  return value !== null && typeof value === \"object\" && !Array.isArray(value);\n}\n\nfunction isFilledString(value) {\n  return typeof value === \"string\" && value.trim() !== \"\";\n}\n\nfunction pickColor(value, fallback) {\n  return typeof value === \"string\" && /^#[0-9a-f]{6}$/i.test(value.trim()) ? value.trim() : fallback;\n}\n\nfunction pickFont(value, fallback) {\n  return typeof value === \"string\" && /^[\\w\\s,'\"-]+$/.test(value) ? value : fallback;\n}\n\nfunction pickEnum(value, name, fallback) {\n  return ENUMS[name].indexOf(value) !== -1 ? value : fallback;\n}\n\nfunction pickBoolean(value, fallback) {\n  return typeof value === \"boolean\" ? value : fallback;\n}\n\n/* Setup */\n\nfunction start(config, deck) {\n  state.config = config;\n  state.title = deck.title;\n  state.cards = deck.cards;\n  state.lessons = deck.lessons;\n  state.typesInPlay = deck.typesInPlay;\n  state.mode = config.practiceModes.length === 1 ? config.practiceModes[0] : null;\n  state.reversed = config.startFlipped;\n  refreshPicker();\n\n  applyLanguage(deck.lang);\n  applyTheme(config.theme);\n  applyControls(config.controls);\n\n  document.title = deck.title;\n  els.deckTitle.textContent = deck.title;\n\n  state.ready = true;\n  setButtonsDisabled(false);\n  if (needsSetup()) {\n    buildSetup();\n    showSetup();\n    return;\n  }\n  drawSession();\n  applyControls(config.controls);\n  beginPass(startingCards());\n  els.card.focus();\n}\n\nfunction refreshPicker() {\n  state.pickerKinds = state.config.studentStylePicker && !state.mode ? availableKinds() : [];\n  state.selectedKinds = new Set(state.pickerKinds);\n}\n\nfunction lessonCards() {\n  if (state.lesson === null) {\n    return state.cards;\n  }\n  return state.cards.filter((card) => card.lesson === null || card.lesson <= state.lesson);\n}\n\nfunction activeCards() {\n  const cards = lessonCards();\n  return state.session ? cards.filter((card) => state.session.has(card.id)) : cards;\n}\n\nfunction drawSession() {\n  const size = state.config.sessionSize;\n  const pool = playableCards(lessonCards());\n  if (!size || pool.length <= size) {\n    state.session = null;\n    return;\n  }\n  const rank = (card) => (state.known.has(card.id) ? 2 : state.seen.has(card.id) ? 1 : 0);\n  const picked = shuffled(pool).sort((a, b) => rank(a) - rank(b)).slice(0, size);\n  state.session = new Set(picked.map((card) => card.id));\n}\n\nfunction newRound() {\n  if (!state.ready || !state.session) {\n    return;\n  }\n  drawSession();\n  refreshPicker();\n  applyControls(state.config.controls);\n  beginPass(startingCards());\n  els.card.focus();\n}\n\nfunction startingCards() {\n  const cards = activeCards();\n  return state.config.startShuffled ? shuffled(cards) : cards.slice();\n}\n\n/* Start screen */\n\nfunction lessonPickerOn() {\n  return state.config.lessonPicker && state.lessons.length > 0;\n}\n\nfunction modePickerOn() {\n  return state.config.practiceModes.length > 1;\n}\n\nfunction needsSetup() {\n  return lessonPickerOn() || modePickerOn();\n}\n\nfunction buildSetup() {\n  els.lessonField.hidden = !lessonPickerOn();\n  const options = [new Option(STRINGS.lessonPlaceholder, \"\")];\n  state.lessons.forEach((lesson) => {\n    options.push(new Option(STRINGS.lessonOption(lesson.number, lesson.title), String(lesson.number)));\n  });\n  els.lessonSelect.replaceChildren(...options);\n\n  els.modeField.hidden = !modePickerOn();\n  els.modeOptions.replaceChildren(...state.config.practiceModes.map((type, index) => {\n    const input = document.createElement(\"input\");\n    input.type = \"radio\";\n    input.name = \"practice-mode\";\n    input.value = type;\n    input.checked = index === 0;\n    const text = document.createElement(\"span\");\n    text.append(textElement(\"span\", \"mode-name\", STRINGS.modeNames[type]), textElement(\"span\", \"mode-desc\", STRINGS.modeDescriptions[type]));\n    const label = document.createElement(\"label\");\n    label.className = \"mode-option\";\n    label.setAttribute(\"data-kind\", CARD_TYPES[type].front);\n    label.append(input, text);\n    return label;\n  }));\n}\n\nfunction showSetup() {\n  if (!state.ready || !needsSetup()) {\n    return;\n  }\n  state.onSetup = true;\n  els.app.setAttribute(\"data-screen\", \"setup\");\n  els.setup.hidden = false;\n  els.lessonSelect.value = state.lesson === null ? \"\" : String(state.lesson);\n  if (state.mode && modePickerOn()) {\n    const current = els.modeOptions.querySelector(`input[value=\"${state.mode}\"]`);\n    if (current) {\n      current.checked = true;\n    }\n  }\n  els.setupError.textContent = \"\";\n  updateSetupCount();\n  const target = lessonPickerOn() ? els.lessonSelect : els.modeOptions.querySelector(\"input:checked\") || els.btnStart;\n  target.focus();\n}\n\nfunction setupChoice() {\n  const lessonValue = els.lessonSelect.value;\n  const checked = els.modeOptions.querySelector(\"input:checked\");\n  return {\n    lesson: lessonPickerOn() && lessonValue !== \"\" ? Number(lessonValue) : null,\n    mode: modePickerOn() ? (checked ? checked.value : state.config.practiceModes[0]) : state.mode\n  };\n}\n\nfunction countFor(choice) {\n  const saved = { lesson: state.lesson, mode: state.mode };\n  state.lesson = choice.lesson;\n  state.mode = choice.mode;\n  const count = playableCards(lessonCards()).length;\n  state.lesson = saved.lesson;\n  state.mode = saved.mode;\n  return count;\n}\n\nfunction updateSetupCount() {\n  els.setupError.textContent = \"\";\n  const choice = setupChoice();\n  if (lessonPickerOn() && choice.lesson === null) {\n    els.setupCount.textContent = \"\";\n    return;\n  }\n  const count = countFor(choice);\n  const size = state.config.sessionSize;\n  const through = choice.lesson !== null && choice.lesson > state.lessons[0].number;\n  if (size && count > size) {\n    els.setupCount.textContent = through\n      ? STRINGS.setupRoundThrough(size, count, choice.lesson)\n      : STRINGS.setupRound(size, count);\n    return;\n  }\n  els.setupCount.textContent = through\n    ? plural(STRINGS.setupCountThrough, count, choice.lesson)\n    : plural(STRINGS.setupCount, count);\n}\n\nfunction startFromSetup() {\n  const choice = setupChoice();\n  if (lessonPickerOn() && choice.lesson === null) {\n    els.setupError.textContent = STRINGS.pickLessonFirst;\n    els.lessonSelect.focus();\n    return;\n  }\n  if (countFor(choice) === 0) {\n    els.setupError.textContent = STRINGS.noWordsForChoice;\n    return;\n  }\n  state.lesson = choice.lesson;\n  state.mode = choice.mode;\n  state.reversed = state.config.startFlipped;\n  state.onSetup = false;\n  drawSession();\n  refreshPicker();\n  applyControls(state.config.controls);\n  els.setup.hidden = true;\n  els.app.removeAttribute(\"data-screen\");\n  beginPass(startingCards());\n  els.card.focus();\n}\n\nfunction applyLanguage(lang) {\n  if (!lang) {\n    return;\n  }\n  document.documentElement.lang = lang;\n  const base = lang.split(\"-\")[0].toLowerCase();\n  document.documentElement.dir = RTL_LANGUAGES.indexOf(base) !== -1 ? \"rtl\" : \"ltr\";\n}\n\nfunction applyTheme(theme) {\n  const root = document.documentElement.style;\n  root.setProperty(\"--bg\", theme.background);\n  root.setProperty(\"--card-face\", theme.cardFace);\n  root.setProperty(\"--text\", theme.textColor);\n  root.setProperty(\"--accent\", theme.accent);\n  root.setProperty(\"--accent-text\", readableTextOn(theme.accent));\n  root.setProperty(\"--font\", theme.fontFamily);\n  Object.keys(theme.frameColors).forEach((kind) => {\n    root.setProperty(`--frame-${kind}`, theme.frameColors[kind]);\n    root.setProperty(`--label-text-${kind}`, readableTextOn(theme.frameColors[kind]));\n  });\n  els.app.setAttribute(\"data-word-size\", theme.wordSize);\n  els.app.setAttribute(\"data-text-align\", theme.textAlign);\n  els.app.setAttribute(\"data-text-position\", theme.textPosition);\n  els.app.setAttribute(\"data-corner-radius\", theme.cornerRadius);\n}\n\nfunction readableTextOn(hex) {\n  const luminance = relativeLuminance(hex);\n  const withBlack = (luminance + 0.05) / 0.05;\n  const withWhite = 1.05 / (luminance + 0.05);\n  return withBlack >= withWhite ? \"#000000\" : \"#FFFFFF\";\n}\n\nfunction relativeLuminance(hex) {\n  const channels = [1, 3, 5].map((start) => {\n    const value = parseInt(hex.slice(start, start + 2), 16) / 255;\n    return value <= 0.03928 ? value / 12.92 : Math.pow((value + 0.055) / 1.055, 2.4);\n  });\n  return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2];\n}\n\nfunction applyControls(controls) {\n  els.btnShuffle.hidden = !controls.shuffle;\n  els.btnDirection.hidden = !controls.flipDirection || !activeCards().some(canMirror);\n  els.btnSetup.hidden = !needsSetup();\n  els.btnKnown.hidden = !controls.markKnown;\n  els.counter.hidden = false;\n  els.stylePicker.hidden = !pickerActive();\n  kindChips().forEach((chip) => {\n    const kind = chip.getAttribute(\"data-kind\");\n    chip.hidden = state.pickerKinds.indexOf(kind) === -1;\n    chip.setAttribute(\"aria-pressed\", state.selectedKinds.has(kind) ? \"true\" : \"false\");\n  });\n}\n\nfunction availableKinds() {\n  return PICKER_KINDS.filter((kind) => state.typesInPlay.some((type) => {\n    return KIND_TYPES[kind].indexOf(type) !== -1 && activeCards().some((card) => cardFits(card, type));\n  }));\n}\n\nfunction pickerActive() {\n  return state.config.studentStylePicker && !state.mode && state.pickerKinds.length > 1;\n}\n\nfunction allowedTypes() {\n  const allowed = [];\n  state.selectedKinds.forEach((kind) => {\n    KIND_TYPES[kind].forEach((type) => allowed.push(type));\n  });\n  return state.typesInPlay.filter((type) => allowed.indexOf(type) !== -1);\n}\n\nfunction hasMirror(typeName) {\n  return Boolean(CARD_TYPES[typeName].mirror);\n}\n\nfunction possibleTypes(card) {\n  if (state.mode) {\n    return cardFits(card, state.mode) ? [state.mode] : [];\n  }\n  if (pickerActive()) {\n    const fitting = allowedTypes().filter((type) => cardFits(card, type));\n    if (state.config.randomizeTypes) {\n      return fitting;\n    }\n    return fitting.indexOf(card.type) !== -1 ? [card.type] : fitting.slice(0, 1);\n  }\n  if (!state.config.randomizeTypes) {\n    return [card.type];\n  }\n  const options = state.typesInPlay.filter((type) => cardFits(card, type));\n  return options.length > 0 ? options : [card.type];\n}\n\nfunction isPlayable(card) {\n  return possibleTypes(card).length > 0;\n}\n\nfunction playableCards(cards) {\n  return cards.filter(isPlayable);\n}\n\nfunction nextPlayableIndex(from, step) {\n  for (let i = from; i >= 0 && i < state.pass.length; i += step) {\n    if (isPlayable(state.pass[i])) {\n      return i;\n    }\n  }\n  return -1;\n}\n\nfunction canMirror(card) {\n  return possibleTypes(card).some(hasMirror);\n}\n\nfunction setButtonsDisabled(disabled) {\n  [els.btnBack, els.btnFlip, els.btnNext, els.btnShuffle, els.btnDirection, els.btnKnown, els.btnRestart]\n    .forEach((button) => {\n      button.disabled = disabled;\n    });\n}\n\n/* Passes through the deck */\n\nfunction beginPass(cards) {\n  state.pass = cards;\n  state.index = Math.max(0, nextPlayableIndex(0, 1));\n  state.finished = false;\n  showCard({ redraw: true, announce: true });\n}\n\nfunction currentCard() {\n  return state.finished ? null : state.pass[state.index] || null;\n}\n\nfunction effectiveType(showing) {\n  const type = CARD_TYPES[showing.type];\n  return state.reversed && type.mirror ? type.mirror : showing.type;\n}\n\nfunction drawShowing(card) {\n  const fitting = possibleTypes(card);\n  const options = fitting.length > 0 ? fitting : [card.type];\n  const type = options[Math.floor(Math.random() * options.length)];\n  const typeInfo = CARD_TYPES[type];\n  const kinds = [typeInfo.front, typeInfo.back];\n  const usesDefinition = kinds.indexOf(\"definition\") !== -1 || kinds.indexOf(\"word-definition\") !== -1;\n  return {\n    card,\n    type,\n    definition: usesDefinition ? pickEntry(card, \"definitions\") : card.definitions[0],\n    example: exampleText(kinds.indexOf(\"example\") !== -1 ? pickEntry(card, \"examples\") : availableEntries(card, \"examples\")[0]),\n    image: kinds.indexOf(\"image\") !== -1 ? pickEntry(card, \"images\") : card.images[0]\n  };\n}\n\nfunction exampleText(entry) {\n  return entry ? entry.text : undefined;\n}\n\nfunction pickEntry(card, field) {\n  const list = availableEntries(card, field);\n  if (list.length === 0) {\n    return undefined;\n  }\n  if (list.length === 1 || !state.config.randomizeAlternates) {\n    return list[0];\n  }\n  const key = `${card.id}:${field}`;\n  const last = state.lastPicks.get(key);\n  const choices = list.filter((entry) => entry !== last);\n  const pick = choices[Math.floor(Math.random() * choices.length)];\n  state.lastPicks.set(key, pick);\n  return pick;\n}\n\nfunction showCard(options) {\n  const card = currentCard();\n  if (!card) {\n    return;\n  }\n  if (options.redraw || !state.showing || state.showing.card !== card) {\n    state.showing = drawShowing(card);\n  }\n  const showing = state.showing;\n  const type = CARD_TYPES[effectiveType(showing)];\n\n  els.message.hidden = true;\n  els.card.hidden = false;\n\n  els.card.classList.add(\"no-animation\");\n  state.flipped = false;\n  els.card.classList.remove(\"is-flipped\");\n  fillFace(els.cardFront, type.front, showing);\n  fillFace(els.cardBack, type.back, showing);\n  els.cardFront.querySelector(\".card-hint\").textContent = STRINGS.hints[primaryKind(type.back)];\n  setFaceVisibility();\n  void els.card.offsetWidth;\n  els.card.classList.remove(\"no-animation\");\n\n  updateControls();\n  updateCounter();\n\n  if (options.announce) {\n    announce(STRINGS.cardAnnouncement(positionText(), describeFace(type.front, showing), STRINGS.hints[primaryKind(type.back)]));\n  }\n}\n\nfunction primaryKind(kind) {\n  return kind === \"word-definition\" ? \"word\" : kind;\n}\n\nfunction fillFace(face, kind, showing) {\n  const labelKind = primaryKind(kind);\n  face.setAttribute(\"data-kind\", labelKind);\n  face.querySelector(\".card-label\").textContent = STRINGS.kindLabels[labelKind];\n  face.querySelector(\".card-content\").replaceChildren(...buildContent(kind, showing));\n}\n\nfunction buildContent(kind, showing) {\n  if (kind === \"word\") {\n    return [textElement(\"p\", \"content-word\", showing.card.word)];\n  }\n  if (kind === \"definition\") {\n    return [textElement(\"p\", \"content-text\", showing.definition)];\n  }\n  if (kind === \"example\") {\n    return [textElement(\"p\", \"content-text\", showing.example)];\n  }\n  if (kind === \"image\") {\n    const svg = buildSvg(showing.image);\n    return [svg || textElement(\"p\", \"content-text\", showing.image.alt || STRINGS.pictureMissing)];\n  }\n  const nodes = [textElement(\"p\", \"content-word\", showing.card.word)];\n  if (isFilledString(showing.definition)) {\n    nodes.push(textElement(\"p\", \"content-sub\", showing.definition));\n  }\n  return nodes;\n}\n\nfunction textElement(tag, className, text) {\n  const element = document.createElement(tag);\n  element.className = className;\n  element.textContent = text;\n  return element;\n}\n\nfunction buildSvg(image) {\n  if (!image || typeof image.svg !== \"string\" || /<\\s*script/i.test(image.svg)) {\n    return null;\n  }\n  let source = image.svg.trim();\n  if (!/xmlns\\s*=/.test(source)) {\n    source = source.replace(/^<svg/i, `<svg xmlns=\"${SVG_NS}\"`);\n  }\n  const parsed = new DOMParser().parseFromString(source, \"image/svg+xml\");\n  const root = parsed.documentElement;\n  if (!root || root.namespaceURI !== SVG_NS || root.localName !== \"svg\") {\n    return null;\n  }\n  if (parsed.getElementsByTagName(\"parsererror\").length > 0 || root.getElementsByTagName(\"script\").length > 0) {\n    return null;\n  }\n  stripUnsafeSvg(root);\n  const svg = document.importNode(root, true);\n  svg.removeAttribute(\"width\");\n  svg.removeAttribute(\"height\");\n  svg.setAttribute(\"role\", \"img\");\n  svg.setAttribute(\"aria-label\", image.alt);\n  svg.setAttribute(\"focusable\", \"false\");\n  svg.setAttribute(\"class\", \"content-image\");\n  return svg;\n}\n\nfunction stripUnsafeSvg(root) {\n  const blocked = [\"script\", \"foreignObject\", \"iframe\", \"object\", \"embed\", \"image\", \"text\", \"style\"];\n  blocked.forEach((tag) => {\n    Array.prototype.slice.call(root.getElementsByTagName(tag)).forEach((node) => node.remove());\n  });\n  [root].concat(Array.prototype.slice.call(root.getElementsByTagName(\"*\"))).forEach((node) => {\n    Array.prototype.slice.call(node.attributes).forEach((attribute) => {\n      const name = attribute.name.toLowerCase();\n      const value = attribute.value.trim();\n      const isHandler = name.indexOf(\"on\") === 0;\n      const isExternalLink = (name === \"href\" || name === \"xlink:href\") && value.charAt(0) !== \"#\";\n      const isExternalUrl = /url\\(\\s*['\"]?(?!#)/i.test(value);\n      if (isHandler || isExternalLink || isExternalUrl) {\n        node.removeAttribute(attribute.name);\n      }\n    });\n  });\n}\n\nfunction setFaceVisibility() {\n  els.cardFront.setAttribute(\"aria-hidden\", state.flipped ? \"true\" : \"false\");\n  els.cardBack.setAttribute(\"aria-hidden\", state.flipped ? \"false\" : \"true\");\n}\n\nfunction describeFace(kind, showing) {\n  const labelKind = primaryKind(kind);\n  const word = showing.card.word;\n  let content;\n  if (kind === \"word\") {\n    content = word;\n  } else if (kind === \"definition\") {\n    content = showing.definition;\n  } else if (kind === \"example\") {\n    content = showing.example;\n  } else if (kind === \"image\") {\n    content = showing.image.alt;\n  } else {\n    content = isFilledString(showing.definition) ? `${endSentence(word)} ${showing.definition}` : word;\n  }\n  return endSentence(STRINGS.faceAnnouncement(STRINGS.kindNames[labelKind], content));\n}\n\nfunction endSentence(text) {\n  const trimmed = text.trim();\n  return /[.!?”\"]$/.test(trimmed) ? trimmed : `${trimmed}.`;\n}\n\n/* Actions */\n\nfunction flip() {\n  const card = currentCard();\n  if (!state.ready || !card) {\n    return;\n  }\n  state.flipped = !state.flipped;\n  els.card.classList.toggle(\"is-flipped\", state.flipped);\n  setFaceVisibility();\n  renderWordBank();\n  const type = CARD_TYPES[effectiveType(state.showing)];\n  const kind = state.flipped ? type.back : type.front;\n  announce(STRINGS.flipAnnouncement(describeFace(kind, state.showing)));\n}\n\nfunction goNext() {\n  if (!state.ready || state.finished) {\n    return;\n  }\n  const card = currentCard();\n  if (card) {\n    state.seen.add(card.id);\n  }\n  const next = nextPlayableIndex(state.index + 1, 1);\n  if (next === -1) {\n    showFinish();\n    return;\n  }\n  state.index = next;\n  showCard({ redraw: true, announce: true });\n}\n\nfunction goBack() {\n  if (!state.ready) {\n    return;\n  }\n  if (state.finished) {\n    const last = nextPlayableIndex(state.pass.length - 1, -1);\n    if (last === -1) {\n      return;\n    }\n    state.finished = false;\n    state.index = last;\n    showCard({ redraw: true, announce: true });\n    els.card.focus();\n    return;\n  }\n  const previous = nextPlayableIndex(state.index - 1, -1);\n  if (previous === -1) {\n    announce(STRINGS.firstCardAnnouncement);\n    return;\n  }\n  state.index = previous;\n  showCard({ redraw: true, announce: true });\n}\n\nfunction shuffleCards() {\n  if (!state.ready || !state.config.controls.shuffle) {\n    return;\n  }\n  const wasFinished = state.finished;\n  state.pass = shuffled(state.pass);\n  state.index = Math.max(0, nextPlayableIndex(0, 1));\n  state.finished = false;\n  showCard({ redraw: true });\n  if (wasFinished) {\n    els.card.focus();\n  }\n  announce(STRINGS.shuffledAnnouncement(positionText()));\n}\n\nfunction switchDirection() {\n  if (!state.ready || !state.config.controls.flipDirection || els.btnDirection.hidden) {\n    return;\n  }\n  state.reversed = !state.reversed;\n  if (state.finished) {\n    updateControls();\n    return;\n  }\n  showCard({ redraw: false });\n  const type = CARD_TYPES[effectiveType(state.showing)];\n  announce(STRINGS.cardAnnouncement(positionText(), describeFace(type.front, state.showing), STRINGS.hints[primaryKind(type.back)]));\n}\n\nfunction toggleKnown() {\n  const card = currentCard();\n  if (!state.ready || !card || !state.config.controls.markKnown) {\n    return;\n  }\n  const nowKnown = !state.known.has(card.id);\n  if (nowKnown) {\n    state.known.add(card.id);\n  } else {\n    state.known.delete(card.id);\n  }\n  updateControls();\n  updateCounter();\n  announce(nowKnown ? STRINGS.knownAnnouncement : STRINGS.unknownAnnouncement);\n}\n\nfunction startOver() {\n  if (!state.ready || state.onSetup) {\n    return;\n  }\n  beginPass(startingCards());\n  els.card.focus();\n}\n\nfunction reviewUnknown() {\n  const remaining = playableCards(activeCards()).filter((card) => !state.known.has(card.id));\n  if (remaining.length === 0) {\n    return;\n  }\n  beginPass(remaining);\n  els.card.focus();\n}\n\nfunction toggleKind(kind) {\n  if (!state.ready || !pickerActive() || state.pickerKinds.indexOf(kind) === -1) {\n    return;\n  }\n  const label = STRINGS.kindChips[kind];\n  if (state.selectedKinds.has(kind)) {\n    if (state.selectedKinds.size === 1) {\n      announce(STRINGS.keepOneKind);\n      return;\n    }\n    state.selectedKinds.delete(kind);\n  } else {\n    state.selectedKinds.add(kind);\n  }\n  const on = state.selectedKinds.has(kind);\n  applyControls(state.config.controls);\n  updateControls();\n  updateCounter();\n  const count = playableCards(activeCards()).length;\n  announce(plural(on ? STRINGS.kindOnAnnouncement : STRINGS.kindOffAnnouncement, count, label));\n}\n\nfunction shuffled(cards) {\n  const result = cards.slice();\n  for (let i = result.length - 1; i > 0; i -= 1) {\n    const j = Math.floor(Math.random() * (i + 1));\n    const temp = result[i];\n    result[i] = result[j];\n    result[j] = temp;\n  }\n  return result;\n}\n\n/* Finish and messages */\n\nfunction showFinish() {\n  state.finished = true;\n  state.flipped = false;\n  const total = playableCards(state.pass).length;\n  const unknownCount = playableCards(activeCards()).filter((card) => !state.known.has(card.id)).length;\n  const markKnown = state.config.controls.markKnown;\n\n  els.card.hidden = true;\n  els.message.hidden = false;\n  els.messageText.textContent = plural(STRINGS.finished, total);\n  const pool = playableCards(lessonCards());\n  const poolSeen = pool.filter((card) => state.seen.has(card.id) || state.known.has(card.id)).length;\n  const details = [];\n  if (markKnown && unknownCount === 0) {\n    details.push(STRINGS.allKnown);\n  }\n  if (state.session) {\n    details.push(STRINGS.roundProgress(poolSeen, pool.length));\n  }\n  els.messageDetail.hidden = details.length === 0;\n  els.messageDetail.textContent = details.join(\" \");\n  els.finishNew.hidden = !state.session;\n  els.finishNew.classList.toggle(\"btn-secondary\", !state.session);\n  els.finishRestart.hidden = Boolean(state.session);\n  if (state.session) {\n    els.messageActions.insertBefore(els.finishNew, els.messageActions.firstChild);\n  }\n  setButtonText(els.finishNew, STRINGS.newRound(Math.min(state.config.sessionSize, pool.length)));\n  els.messageActions.hidden = false;\n  els.message.classList.add(\"is-finish\");\n  els.finishReview.hidden = !(markKnown && unknownCount > 0);\n  setButtonText(els.finishReview, plural(STRINGS.reviewUnknown, unknownCount));\n\n  updateControls();\n  updateCounter();\n  els.message.focus();\n  announce(els.messageText.textContent);\n}\n\nfunction showMessage(text) {\n  els.card.hidden = true;\n  els.message.hidden = false;\n  els.messageText.textContent = text;\n  els.messageDetail.hidden = true;\n  els.messageActions.hidden = true;\n  els.message.classList.remove(\"is-finish\");\n  els.counter.hidden = true;\n}\n\nfunction plural(forms, count, ...extra) {\n  const lang = document.documentElement.lang || undefined;\n  const category = new Intl.PluralRules(lang).select(count);\n  const form = forms[category] || forms.other;\n  const formatted = new Intl.NumberFormat(lang).format(count);\n  return extra.length ? form(extra[0], formatted) : form(formatted);\n}\n\n/* Display state */\n\nfunction updateControls() {\n  const card = currentCard();\n  setAriaDisabled(els.btnBack, !state.finished && nextPlayableIndex(state.index - 1, -1) === -1);\n  setAriaDisabled(els.btnFlip, !card);\n  setAriaDisabled(els.btnNext, !card);\n  setAriaDisabled(els.btnKnown, !card);\n  els.btnKnown.setAttribute(\"aria-pressed\", card && state.known.has(card.id) ? \"true\" : \"false\");\n  setButtonText(els.btnDirection, directionLabel(), STRINGS.keys.direction);\n}\n\nfunction setAriaDisabled(button, disabled) {\n  if (disabled) {\n    button.setAttribute(\"aria-disabled\", \"true\");\n  } else {\n    button.removeAttribute(\"aria-disabled\");\n  }\n}\n\nfunction directionLabel() {\n  let typeName = null;\n  if (currentCard() && state.showing && hasMirror(state.showing.type)) {\n    typeName = state.showing.type;\n  } else {\n    const card = state.pass.filter(canMirror)[0] || activeCards().filter(canMirror)[0];\n    typeName = card ? possibleTypes(card).filter(hasMirror)[0] : null;\n  }\n  if (!typeName) {\n    return STRINGS.startFrom.word;\n  }\n  const shown = state.reversed ? CARD_TYPES[typeName].mirror : typeName;\n  return STRINGS.startFrom[CARD_TYPES[CARD_TYPES[shown].mirror].front];\n}\n\nfunction positionText() {\n  const format = new Intl.NumberFormat(document.documentElement.lang || undefined);\n  const playable = playableCards(state.pass);\n  const before = playableCards(state.pass.slice(0, state.index)).length;\n  const position = Math.max(1, before + (isPlayable(state.pass[state.index]) ? 1 : 0));\n  return STRINGS.counter(format.format(position), format.format(playable.length));\n}\n\nfunction updateCounter() {\n  const parts = [];\n  if (state.config.controls.progressCounter && !state.finished) {\n    parts.push(positionText());\n  }\n  if (state.config.controls.markKnown) {\n    const left = playableCards(activeCards()).filter((card) => !state.known.has(card.id)).length;\n    parts.push(plural(STRINGS.leftToLearn, left));\n  }\n  els.counter.replaceChildren(...parts.map((text) => textElement(\"span\", \"counter-part\", text)));\n  els.counter.hidden = parts.length === 0;\n  renderWordBank();\n}\n\nfunction renderWordBank() {\n  const on = state.config.controls.wordBank;\n  els.wordBank.hidden = !on;\n  els.app.classList.toggle(\"has-word-bank\", on);\n  if (!on) {\n    return;\n  }\n  const markKnown = state.config.controls.markKnown;\n  const current = currentCard();\n  const lang = document.documentElement.lang || undefined;\n  const cards = playableCards(activeCards()).slice().sort((a, b) => a.word.localeCompare(b.word, lang));\n  let currentItem = null;\n  const items = cards.map((card) => {\n    const known = markKnown && state.known.has(card.id);\n    const seen = state.seen.has(card.id);\n    const item = document.createElement(\"li\");\n    item.className = \"bank-word\";\n    item.classList.toggle(\"is-seen\", seen && !known);\n    item.classList.toggle(\"is-known\", known);\n    item.append(textElement(\"span\", \"bank-word-text\", card.word));\n    if (known) {\n      item.append(starIcon(), textElement(\"span\", \"visually-hidden\", `, ${STRINGS.wordStatusKnown}`));\n    } else if (seen) {\n      item.append(textElement(\"span\", \"visually-hidden\", `, ${STRINGS.wordStatusSeen}`));\n    }\n    if (current && state.flipped && card.id === current.id) {\n      item.classList.add(\"is-current\");\n      item.setAttribute(\"aria-current\", \"true\");\n      currentItem = item;\n    }\n    return item;\n  });\n  els.wordBankList.replaceChildren(...items);\n  const seenCount = cards.filter((card) => state.seen.has(card.id) || (markKnown && state.known.has(card.id))).length;\n  const knownCount = markKnown ? cards.filter((card) => state.known.has(card.id)).length : 0;\n  const summary = [textElement(\"span\", \"word-bank-stat\", STRINGS.wordBankDone(seenCount, cards.length))];\n  if (markKnown) {\n    summary.push(textElement(\"span\", \"word-bank-stat\", STRINGS.wordBankKnown(knownCount)));\n  }\n  els.wordBankSummary.replaceChildren(...summary);\n  if (currentItem) {\n    scrollBankTo(currentItem);\n  }\n}\n\nfunction scrollBankTo(item) {\n  const box = els.wordBankScroll;\n  if (box.scrollHeight <= box.clientHeight) {\n    return;\n  }\n  const top = item.offsetTop - box.offsetTop;\n  if (top < box.scrollTop) {\n    box.scrollTop = top - 8;\n  } else if (top + item.offsetHeight > box.scrollTop + box.clientHeight) {\n    box.scrollTop = top + item.offsetHeight - box.clientHeight + 8;\n  }\n}\n\nfunction starIcon() {\n  const svg = document.createElementNS(SVG_NS, \"svg\");\n  svg.setAttribute(\"viewBox\", \"0 0 20 20\");\n  svg.setAttribute(\"class\", \"bank-star\");\n  svg.setAttribute(\"aria-hidden\", \"true\");\n  svg.setAttribute(\"focusable\", \"false\");\n  const path = document.createElementNS(SVG_NS, \"path\");\n  path.setAttribute(\"d\", \"M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8L10 14.9l-5.2 2.7 1-5.8L1.6 7.7l5.8-.8z\");\n  svg.append(path);\n  return svg;\n}\n\nfunction announce(text) {\n  els.srStatus.textContent = \"\";\n  window.setTimeout(() => {\n    els.srStatus.textContent = text;\n  }, 50);\n}\n\n/* Keyboard */\n\nfunction handleKeydown(event) {\n  if (!state.ready || state.onSetup || event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey) {\n    return;\n  }\n  if (isTextEntry(event.target)) {\n    return;\n  }\n  const onControl = event.target instanceof Element && event.target.closest(\"button, a, select, summary\");\n  const key = event.key;\n  const controls = state.config.controls;\n\n  if (key === \" \" || key === \"Enter\") {\n    if (onControl) {\n      return;\n    }\n    event.preventDefault();\n    flip();\n  } else if (key === \"ArrowRight\") {\n    event.preventDefault();\n    goNext();\n  } else if (key === \"ArrowLeft\") {\n    event.preventDefault();\n    goBack();\n  } else if ((key === \"s\" || key === \"S\") && controls.shuffle) {\n    shuffleCards();\n  } else if ((key === \"f\" || key === \"F\") && controls.flipDirection) {\n    switchDirection();\n  } else if ((key === \"k\" || key === \"K\") && controls.markKnown) {\n    toggleKnown();\n  } else if (key === \"r\" || key === \"R\") {\n    startOver();\n  } else if ((key === \"l\" || key === \"L\") && needsSetup()) {\n    showSetup();\n  } else if (key === \"1\" || key === \"2\" || key === \"3\") {\n    toggleKind(PICKER_KINDS[Number(key) - 1]);\n  }\n}\n\nfunction isTextEntry(target) {\n  if (!(target instanceof Element)) {\n    return false;\n  }\n  return target.isContentEditable || target.matches(\"input, textarea, select\");\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": ":root {\n  --bg: #E4E2F8;\n  --card-face: #FFFFFF;\n  --text: #000000;\n  --accent: #4C42CF;\n  --accent-text: #FFFFFF;\n  --frame-word: #0099F3;\n  --frame-definition: #003F25;\n  --frame-example: #F46800;\n  --frame-image: #4C42CF;\n  --label-text-word: #000000;\n  --label-text-definition: #FFFFFF;\n  --label-text-example: #000000;\n  --label-text-image: #FFFFFF;\n  --font: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nhtml {\n  -webkit-text-size-adjust: 100%;\n  text-size-adjust: 100%;\n}\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  background: var(--bg);\n  color: var(--text);\n  font-family: var(--font);\n  line-height: 1.4;\n}\n\n.app {\n  --word-size: clamp(1.75rem, 7cqw, 3rem);\n  --body-size: clamp(1rem, 3.6cqw, 1.375rem);\n  --sub-size: clamp(0.95rem, 3cqw, 1.125rem);\n  --radius: 16px;\n  --content-justify: center;\n  --content-align: center;\n  --text-align: center;\n  width: 100%;\n  max-width: 640px;\n  margin-inline: auto;\n  padding-block: 16px 24px;\n  padding-inline: 16px;\n  font-family: var(--font);\n  color: var(--text);\n}\n\n.app-column {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n\n.deck-title {\n  order: 1;\n}\n\n.style-picker {\n  order: 2;\n}\n\n.setup {\n  order: 3;\n}\n\n.stage {\n  order: 3;\n}\n\n.controls-primary {\n  order: 4;\n}\n\n.controls-secondary {\n  order: 5;\n}\n\n.status {\n  order: 6;\n}\n\n.app[data-word-size=\"medium\"] {\n  --word-size: clamp(1.5rem, 5.5cqw, 2.25rem);\n}\n\n.app[data-word-size=\"xlarge\"] {\n  --word-size: clamp(2rem, 9cqw, 3.75rem);\n}\n\n.app[data-corner-radius=\"none\"] {\n  --radius: 0px;\n}\n\n.app[data-corner-radius=\"round\"] {\n  --radius: 32px;\n}\n\n.app[data-text-align=\"start\"] {\n  --content-align: flex-start;\n  --text-align: start;\n}\n\n.app[data-text-position=\"top\"] {\n  --content-justify: flex-start;\n}\n\n.deck-title {\n  margin-block: 0 14px;\n  font-size: clamp(1.5rem, 5vw, 2rem);\n  line-height: 1.2;\n  text-align: center;\n}\n\n.stage {\n  container-type: inline-size;\n  width: 100%;\n  max-width: 560px;\n  margin-inline: auto;\n}\n\n/* Card */\n\n.card {\n  position: relative;\n  width: 100%;\n  border-radius: var(--radius);\n  perspective: 1400px;\n}\n\n.card:focus {\n  outline: none;\n}\n\n.card:focus-visible {\n  outline: 4px solid var(--text);\n  outline-offset: 4px;\n}\n\n.card-inner {\n  display: grid;\n  height: clamp(180px, min(66.667cqw, 100vh - 330px), 380px);\n  transform-style: preserve-3d;\n  transition: transform 0.5s ease;\n}\n\n.card.is-flipped .card-inner {\n  transform: rotateY(180deg);\n}\n\n.card.no-animation .card-inner {\n  transition: none;\n}\n\n.card-face {\n  --frame: var(--frame-word);\n  --label-text: var(--label-text-word);\n  position: relative;\n  grid-area: 1 / 1;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  padding-block: 2.75rem 0.75rem;\n  padding-inline: 1.25rem;\n  border: 8px solid var(--frame);\n  border-radius: var(--radius);\n  background: var(--card-face);\n  color: var(--text);\n  -webkit-backface-visibility: hidden;\n  backface-visibility: hidden;\n}\n\n.card-back {\n  transform: rotateY(180deg);\n}\n\n.card-face[data-kind=\"definition\"] {\n  --frame: var(--frame-definition);\n  --label-text: var(--label-text-definition);\n}\n\n.card-face[data-kind=\"example\"] {\n  --frame: var(--frame-example);\n  --label-text: var(--label-text-example);\n}\n\n.card-face[data-kind=\"image\"] {\n  --frame: var(--frame-image);\n  --label-text: var(--label-text-image);\n}\n\n.card-label {\n  position: absolute;\n  inset-block-start: 0;\n  inset-inline-start: 0;\n  padding-block: 0.3rem 0.4rem;\n  padding-inline: 0.9rem;\n  border-end-end-radius: 10px;\n  background: var(--frame);\n  color: var(--label-text);\n  font-size: 0.85rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  line-height: 1.2;\n}\n\n.app[data-corner-radius=\"none\"] .card-label {\n  border-end-end-radius: 0;\n}\n\n.card-content {\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  justify-content: var(--content-justify);\n  align-items: var(--content-align);\n  gap: 0.5rem;\n  min-height: 0;\n  text-align: var(--text-align);\n}\n\n.content-word {\n  margin: 0;\n  max-width: 100%;\n  font-size: var(--word-size);\n  font-weight: 700;\n  line-height: 1.1;\n  overflow-wrap: anywhere;\n}\n\n.content-text {\n  margin: 0;\n  max-width: 36ch;\n  font-size: var(--body-size);\n  line-height: 1.4;\n}\n\n.content-sub {\n  margin: 0;\n  max-width: 40ch;\n  font-size: var(--sub-size);\n  line-height: 1.4;\n}\n\n.content-image {\n  display: block;\n  width: clamp(96px, 30cqw, 168px);\n  height: auto;\n  max-height: 100%;\n}\n\n.card-hint {\n  margin-block: 0.75rem 0;\n  font-size: 0.95rem;\n  font-weight: 600;\n  text-align: center;\n}\n\n/* Loading, error, and finish states */\n\n.message {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 1rem;\n  min-height: clamp(180px, min(66.667cqw, 100vh - 330px), 380px);\n  padding: 1.5rem;\n  border: 3px dashed var(--text);\n  border-radius: var(--radius);\n  background: var(--card-face);\n  color: var(--text);\n  text-align: center;\n}\n\n.message:focus {\n  outline: none;\n}\n\n.message:focus-visible {\n  outline: 4px solid var(--text);\n  outline-offset: 4px;\n}\n\n.message-text {\n  margin: 0;\n  font-size: var(--body-size);\n  font-weight: 700;\n}\n\n.message-detail {\n  margin: 0;\n}\n\n.message-actions {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 12px;\n}\n\n/* Buttons */\n\n.controls {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 10px;\n  margin-block: 14px 0;\n  margin-inline: auto;\n  max-width: 560px;\n}\n\n.controls-secondary {\n  min-width: 0;\n  padding: 0;\n  border: 0;\n}\n\n.btn {\n  display: inline-flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 2px;\n  min-width: 88px;\n  min-height: 48px;\n  padding-block: 4px;\n  padding-inline: 18px;\n  border: 3px solid var(--accent);\n  border-radius: 12px;\n  background: var(--accent);\n  color: var(--accent-text);\n  font: inherit;\n  font-weight: 700;\n  line-height: 1.2;\n  cursor: pointer;\n  touch-action: manipulation;\n}\n\n.btn-flip {\n  min-width: 112px;\n}\n\n.btn-secondary {\n  min-width: 0;\n  min-height: 44px;\n  padding-inline: 12px;\n  font-size: 0.95rem;\n  border-color: var(--text);\n  background: var(--card-face);\n  color: var(--text);\n}\n\n.btn-toggle[aria-pressed=\"true\"] {\n  border-color: var(--accent);\n  background: var(--accent);\n  color: var(--accent-text);\n}\n\n.btn:focus {\n  outline: none;\n}\n\n.btn:focus-visible {\n  outline: 3px solid var(--text);\n  outline-offset: 3px;\n}\n\n.btn:disabled,\n.btn[aria-disabled=\"true\"] {\n  cursor: not-allowed;\n  opacity: 0.45;\n}\n\n.btn-label {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.btn-key {\n  font-size: 0.75rem;\n  font-weight: 500;\n}\n\n.check-icon {\n  display: none;\n  width: 1em;\n  height: 1em;\n}\n\n.btn-toggle[aria-pressed=\"true\"] .check-icon {\n  display: block;\n}\n\n/* Style picker */\n\n.style-picker {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 10px;\n  min-width: 0;\n  margin-block: 0 18px;\n  margin-inline: 0;\n  padding: 0;\n  border: 0;\n}\n\n.chip {\n  --chip-frame: var(--frame-definition);\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  min-height: 44px;\n  padding-block: 6px;\n  padding-inline: 12px 14px;\n  border: 2px dashed var(--text);\n  border-inline-start: 10px solid var(--chip-frame);\n  border-radius: 10px;\n  background: transparent;\n  color: var(--text);\n  font: inherit;\n  font-weight: 700;\n  line-height: 1.2;\n  cursor: pointer;\n  touch-action: manipulation;\n}\n\n.chip[data-kind=\"example\"] {\n  --chip-frame: var(--frame-example);\n}\n\n.chip[data-kind=\"image\"] {\n  --chip-frame: var(--frame-image);\n}\n\n.chip[aria-pressed=\"true\"] {\n  border-block-style: solid;\n  border-inline-end-style: solid;\n  background: var(--card-face);\n}\n\n.chip[aria-pressed=\"true\"] .check-icon {\n  display: block;\n}\n\n.chip:focus {\n  outline: none;\n}\n\n.chip:focus-visible {\n  outline: 3px solid var(--text);\n  outline-offset: 3px;\n}\n\n/* Status */\n\n.status {\n  margin-block-start: 16px;\n  text-align: center;\n}\n\n.counter {\n  margin: 0;\n  font-weight: 600;\n}\n\n.counter-part + .counter-part {\n  margin-inline-start: 1.25em;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .card-inner {\n    transition: none;\n  }\n}\n\n/* Start screen */\n\n.app[data-screen=\"setup\"] .stage,\n.app[data-screen=\"setup\"] .controls,\n.app[data-screen=\"setup\"] .style-picker,\n.app[data-screen=\"setup\"] .status {\n  display: none;\n}\n\n.setup {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n  width: 100%;\n  max-width: 560px;\n  margin-inline: auto;\n  padding: 20px;\n  border: 3px solid var(--text);\n  border-radius: var(--radius);\n  background: var(--card-face);\n  color: var(--text);\n}\n\n.setup-title {\n  margin: 0;\n  font-size: 1.375rem;\n  line-height: 1.2;\n}\n\n.setup-field {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  min-width: 0;\n  margin: 0;\n  padding: 0;\n  border: 0;\n}\n\n.setup-label {\n  padding: 0;\n  font-size: 1.0625rem;\n  font-weight: 700;\n}\n\n.setup-select {\n  width: 100%;\n  min-height: 48px;\n  padding-block: 8px;\n  padding-inline: 12px;\n  border: 2px solid var(--text);\n  border-radius: 10px;\n  background: var(--card-face);\n  color: var(--text);\n  font: inherit;\n  font-size: 1rem;\n}\n\n.setup-select:focus {\n  outline: none;\n}\n\n.setup-select:focus-visible {\n  outline: 3px solid var(--text);\n  outline-offset: 3px;\n}\n\n.mode-options {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));\n  gap: 10px;\n}\n\n.mode-option {\n  --chip-frame: var(--frame-definition);\n  position: relative;\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  min-height: 48px;\n  padding-block: 10px;\n  padding-inline: 12px;\n  border: 2px solid var(--text);\n  border-inline-start: 10px solid var(--chip-frame);\n  border-radius: 10px;\n  cursor: pointer;\n}\n\n.mode-option[data-kind=\"example\"] {\n  --chip-frame: var(--frame-example);\n}\n\n.mode-option[data-kind=\"image\"] {\n  --chip-frame: var(--frame-image);\n}\n\n.mode-option[data-kind=\"word\"] {\n  --chip-frame: var(--frame-word);\n}\n\n.mode-option input {\n  flex: none;\n  width: 20px;\n  height: 20px;\n  margin: 2px 0 0;\n  accent-color: var(--accent);\n}\n\n.mode-option input:focus {\n  outline: none;\n}\n\n.mode-option input:focus-visible {\n  outline: 3px solid var(--text);\n  outline-offset: 2px;\n}\n\n.mode-name {\n  display: block;\n  font-weight: 700;\n}\n\n.mode-desc {\n  display: block;\n  font-size: 0.95rem;\n}\n\n.setup-count,\n.setup-error {\n  margin: 0;\n  font-weight: 600;\n}\n\n.setup-count:empty,\n.setup-error:empty {\n  display: none;\n}\n\n.setup-error {\n  padding-inline-start: 10px;\n  border-inline-start: 4px solid var(--text);\n}\n\n.btn-start {\n  align-self: center;\n  min-width: 200px;\n}\n\n/* Word bank */\n\n.word-bank {\n  order: 7;\n  width: 100%;\n  max-width: 560px;\n  margin-block: 18px 0;\n  margin-inline: auto;\n}\n\n.app[data-screen=\"setup\"] .word-bank {\n  display: none;\n}\n\n.word-bank-title {\n  margin: 0;\n  font-size: 1.0625rem;\n  line-height: 1.2;\n}\n\n.word-bank-stat {\n  display: inline-block;\n  margin-inline-end: 12px;\n}\n\n.word-bank-summary {\n  margin-block: 2px 8px;\n  margin-inline: 0;\n  font-size: 0.875rem;\n  font-weight: 600;\n}\n\n.word-bank-scroll {\n  border-radius: 10px;\n}\n\n.word-bank-scroll:focus {\n  outline: none;\n}\n\n.word-bank-scroll:focus-visible {\n  outline: 3px solid var(--text);\n  outline-offset: 3px;\n}\n\n.word-bank-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin: 0;\n  padding-block: 6px;\n  padding-inline: 6px;\n  list-style: none;\n}\n\n.bank-word {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  min-height: 34px;\n  padding-block: 4px;\n  padding-inline: 10px;\n  border: 2px solid var(--text);\n  border-radius: 8px;\n  background: var(--card-face);\n  color: var(--text);\n  box-shadow: 3px 3px 0 var(--text);\n  font-size: 0.95rem;\n  font-weight: 700;\n  line-height: 1.2;\n}\n\n.bank-word.is-seen {\n  border-style: dashed;\n  background: var(--bg);\n  box-shadow: none;\n}\n\n.bank-word.is-known {\n  border-color: var(--accent);\n  box-shadow: 3px 3px 0 var(--accent);\n}\n\n.bank-word.is-current {\n  outline: 3px solid var(--frame-word);\n  outline-offset: 3px;\n}\n\n.bank-star {\n  flex: none;\n  width: 18px;\n  height: 18px;\n  fill: var(--accent);\n}\n\n@media (min-width: 500px) {\n  .app.has-word-bank:not([data-screen=\"setup\"]) {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) 150px;\n    column-gap: 16px;\n    align-items: start;\n    max-width: 820px;\n  }\n\n  .app.has-word-bank:not([data-screen=\"setup\"]) > .word-bank {\n    max-width: none;\n    margin-block: 0;\n  }\n\n  .app.has-word-bank .word-bank-scroll {\n    max-height: calc(100vh - 110px);\n    overflow-y: auto;\n  }\n\n  .app.has-word-bank .word-bank-list {\n    flex-direction: column;\n    flex-wrap: nowrap;\n    align-items: flex-start;\n  }\n}\n\n@media (min-width: 500px) and (max-width: 759px) {\n  .app.has-word-bank:not([data-screen=\"setup\"]) .deck-title {\n    font-size: 1.25rem;\n    margin-block-end: 10px;\n  }\n\n  .app.has-word-bank:not([data-screen=\"setup\"]) .card-inner {\n    height: clamp(160px, min(66.667cqw, 100vh - 370px), 380px);\n  }\n\n  .app.has-word-bank:not([data-screen=\"setup\"]) .controls {\n    gap: 8px;\n  }\n\n  .app.has-word-bank:not([data-screen=\"setup\"]) .btn-secondary {\n    padding-inline: 10px;\n    font-size: 0.875rem;\n  }\n\n  .app.has-word-bank:not([data-screen=\"setup\"]) .controls-primary .btn {\n    min-width: 80px;\n    padding-inline: 14px;\n  }\n\n  .app.has-word-bank:not([data-screen=\"setup\"]) .controls-primary .btn-flip {\n    min-width: 100px;\n  }\n}\n\n@media (min-width: 760px) {\n  .app.has-word-bank:not([data-screen=\"setup\"]) {\n    grid-template-columns: minmax(0, 1fr) 190px;\n    column-gap: 24px;\n  }\n}\n\n.message-actions .btn {\n  min-height: 44px;\n}\n\n.message.is-finish {\n  gap: 0.5rem;\n  padding-block: 0.75rem;\n  padding-inline: 1rem;\n}\n\n.message.is-finish .message-actions {\n  gap: 8px;\n}",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "deck.json",
          "contents": "{\n  \"schemaVersion\": 2,\n  \"deckId\": \"data-makes-ai-vocabulary\",\n  \"title\": \"Data Makes AI vocabulary\",\n  \"lang\": \"en-US\",\n  \"typesInPlay\": [\n    \"definition-word\",\n    \"example-word\"\n  ],\n  \"lessons\": [\n    {\n      \"number\": 1,\n      \"title\": \"Sorting by Rules\"\n    },\n    {\n      \"number\": 2,\n      \"title\": \"Reading a Decision Tree\"\n    },\n    {\n      \"number\": 3,\n      \"title\": \"Who Writes the Rules?\"\n    },\n    {\n      \"number\": 4,\n      \"title\": \"Learning from Examples\"\n    },\n    {\n      \"number\": 5,\n      \"title\": \"Curating Your Own Dataset\"\n    },\n    {\n      \"number\": 6,\n      \"title\": \"Balanced vs. Unbalanced Data\"\n    },\n    {\n      \"number\": 7,\n      \"title\": \"How to Train Your Decision Tree\"\n    },\n    {\n      \"number\": 8,\n      \"title\": \"Testing and Tracing Predictions\"\n    },\n    {\n      \"number\": 9,\n      \"title\": \"Combining Features\"\n    },\n    {\n      \"number\": 10,\n      \"title\": \"Accuracy ≠ Fairness\"\n    },\n    {\n      \"number\": 11,\n      \"title\": \"Tracing Bias to Outcome\"\n    },\n    {\n      \"number\": 12,\n      \"title\": \"Project Launch and Problem Selection\"\n    },\n    {\n      \"number\": 13,\n      \"title\": \"Data Curation and Model Training\"\n    },\n    {\n      \"number\": 14,\n      \"title\": \"Testing, Tracing, and Auditing\"\n    },\n    {\n      \"number\": 15,\n      \"title\": \"Reflection and Presentation\"\n    }\n  ],\n  \"cards\": [\n    {\n      \"id\": \"feature\",\n      \"type\": \"definition-word\",\n      \"word\": \"feature\",\n      \"lesson\": 1,\n      \"definitions\": [\n        \"A characteristic you can observe about something.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"When you sorted the monster cards, you checked things like how many eyes each monster had and whether it had wings.\",\n          \"lesson\": 1\n        },\n        {\n          \"text\": \"One question in the spam flowchart asks whether an email has lots of exclamation points. That’s one thing the flowchart looks at.\",\n          \"lesson\": 2\n        },\n        {\n          \"text\": \"In the muggy weather data, temperature and humidity were each something you could measure about a day.\",\n          \"lesson\": 9\n        },\n        {\n          \"text\": \"Each Starfall Arena character has a speed, a weapon type, and a team. Those are the details your tree can ask about.\",\n          \"lesson\": 12\n        }\n      ]\n    },\n    {\n      \"id\": \"data\",\n      \"type\": \"definition-word\",\n      \"word\": \"data\",\n      \"lesson\": 1,\n      \"definitions\": [\n        \"Information that has been collected and recorded.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"Before sorting, your group wrote down every monster’s color, size, and number of legs on a chart.\",\n          \"lesson\": 1\n        },\n        {\n          \"text\": \"Your class asked students their height and favorite song, then put all the answers in a table.\",\n          \"lesson\": 3\n        },\n        {\n          \"text\": \"A table lists the weight, color, and shape of 40 pieces of fruit that someone measured and wrote down.\",\n          \"lesson\": 4\n        },\n        {\n          \"text\": \"Players answered a survey about which Starfall Arena character they play most, and every answer went into one big table.\",\n          \"lesson\": 12\n        }\n      ]\n    },\n    {\n      \"id\": \"classification\",\n      \"type\": \"definition-word\",\n      \"word\": \"classification\",\n      \"lesson\": 1,\n      \"definitions\": [\n        \"Sorting something into a category based on its features.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"You put each monster card in the “friendly” pile or the “scary” pile based on what it looked like.\",\n          \"lesson\": 1\n        },\n        {\n          \"text\": \"An email filter decides whether each new message belongs in the inbox or the spam folder.\",\n          \"lesson\": 2\n        },\n        {\n          \"text\": \"A program looks at a piece of fruit and decides whether it goes in the apple group or the orange group.\",\n          \"lesson\": 4\n        },\n        {\n          \"text\": \"A project model reads a text message and decides whether it’s sarcastic or sincere.\",\n          \"lesson\": 12\n        }\n      ]\n    },\n    {\n      \"id\": \"branching-logic\",\n      \"type\": \"definition-word\",\n      \"word\": \"branching logic\",\n      \"lesson\": 1,\n      \"definitions\": [\n        \"A way of making decisions using yes or no questions, where each answer sends you in a different direction.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"In the monster game, a yes to “Does it have wings?” sent the card left, and a no sent it right to a different question.\",\n          \"lesson\": 1\n        },\n        {\n          \"text\": \"The spam flowchart asks if the sender is in your contacts. A yes leads to one question, and a no leads to another.\",\n          \"lesson\": 2\n        },\n        {\n          \"text\": \"When you trained your model in AI Lab, it split the rows with a yes-or-no question, and each answer led down its own path.\",\n          \"lesson\": 7\n        }\n      ]\n    },\n    {\n      \"id\": \"decision-tree\",\n      \"type\": \"definition-word\",\n      \"word\": \"decision tree\",\n      \"lesson\": 2,\n      \"definitions\": [\n        \"A series of questions about features. Each answer leads to another question or a prediction.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"The spam flowchart starts with “Is the sender in your contacts?” and keeps asking until it ends at “spam” or “not spam.”\",\n          \"lesson\": 2\n        },\n        {\n          \"text\": \"You drew a flowchart that asks “Does it have fur?” and then “Does it bark?” until it lands on an animal.\",\n          \"lesson\": 2\n        },\n        {\n          \"text\": \"After you clicked Train in AI Lab, a diagram of questions appeared, and every path ended in an answer at the bottom.\",\n          \"lesson\": 7\n        },\n        {\n          \"text\": \"Your Starfall Arena model asks whether a character is fast, then asks about weapon type, and ends with a yes or a no.\",\n          \"lesson\": 12\n        }\n      ]\n    },\n    {\n      \"id\": \"label\",\n      \"type\": \"definition-word\",\n      \"word\": \"label\",\n      \"lesson\": 2,\n      \"definitions\": [\n        \"The category that a system predicts based on its features.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"Each monster card ended up as “friendly” or “scary.” Those two words were the groups you were sorting into.\",\n          \"lesson\": 1\n        },\n        {\n          \"text\": \"In the spam flowchart, every path ends in one of two answers: “spam” or “not spam.”\",\n          \"lesson\": 2\n        },\n        {\n          \"text\": \"When you built your own dataset, you wrote the right answer next to each example, like “sarcastic” or “sincere.”\",\n          \"lesson\": 5\n        },\n        {\n          \"text\": \"In Starfall Arena, the last column says “yes” or “no” for whether a player picked that character as their main.\",\n          \"lesson\": 12\n        }\n      ]\n    },\n    {\n      \"id\": \"prediction\",\n      \"type\": \"definition-word\",\n      \"word\": \"prediction\",\n      \"lesson\": 2,\n      \"definitions\": [\n        \"The best guess based on the data available.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"You follow the spam flowchart for a new email, and it ends at “spam.” That’s the flowchart’s best guess.\",\n          \"lesson\": 2\n        },\n        {\n          \"text\": \"The song model guesses a new student’s favorite song from their height, even though height has nothing to do with music.\",\n          \"lesson\": 3\n        },\n        {\n          \"text\": \"You give your model a row it has never seen, and it says this player will pick the character as their main.\",\n          \"lesson\": 8\n        },\n        {\n          \"text\": \"A classmate types a made-up joke into your model, and it guesses “kind of funny.”\",\n          \"lesson\": 14\n        }\n      ]\n    },\n    {\n      \"id\": \"algorithm\",\n      \"type\": \"definition-word\",\n      \"word\": \"algorithm\",\n      \"lesson\": 3,\n      \"definitions\": [\n        \"A set of step-by-step instructions or rules a computer follows to solve a problem.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"To sort the monster cards, you read a card, checked its color, put it in the matching pile, then grabbed the next one.\",\n          \"lesson\": 1\n        },\n        {\n          \"text\": \"The spam flowchart is a list of questions the computer goes through in the same order for every email.\",\n          \"lesson\": 2\n        },\n        {\n          \"text\": \"A song picker checks the student’s grade, then their height, then chooses a song from a list, step by step.\",\n          \"lesson\": 3\n        },\n        {\n          \"text\": \"When you click Train, AI Lab picks the best question, splits the rows, and keeps repeating those steps.\",\n          \"lesson\": 7\n        }\n      ]\n    },\n    {\n      \"id\": \"human-written-rule\",\n      \"type\": \"definition-word\",\n      \"word\": \"human-written rule\",\n      \"lesson\": 3,\n      \"definitions\": [\n        \"A rule that a person decides on and writes for the computer to follow.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"When you sorted the monster cards, your group agreed that any monster with horns goes in the “scary” pile.\",\n          \"lesson\": 1\n        },\n        {\n          \"text\": \"Whoever built the spam flowchart decided that emails from unknown senders always get an extra check.\",\n          \"lesson\": 2\n        },\n        {\n          \"text\": \"Your class decided that any song with a fast beat goes on the gym playlist, then typed that into the program.\",\n          \"lesson\": 3\n        }\n      ]\n    },\n    {\n      \"id\": \"computer-learned-rule\",\n      \"type\": \"definition-word\",\n      \"word\": \"computer-learned rule\",\n      \"lesson\": 3,\n      \"definitions\": [\n        \"A rule a computer figures out by finding patterns in lots of examples.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"After studying the survey, the computer decided taller students like a certain song, only because the basketball team was in the data.\",\n          \"lesson\": 3\n        },\n        {\n          \"text\": \"A program that only studied apples starts calling everything round and red an apple, since that’s the only pattern it found.\",\n          \"lesson\": 4\n        },\n        {\n          \"text\": \"AI Lab looked at your examples and figured out on its own that “Is the character fast?” was a good first question.\",\n          \"lesson\": 7\n        },\n        {\n          \"text\": \"When you traced a prediction, you found your model was following a pattern in your examples that no person ever told it.\",\n          \"lesson\": 8\n        }\n      ]\n    },\n    {\n      \"id\": \"record\",\n      \"type\": \"definition-word\",\n      \"word\": \"record\",\n      \"lesson\": 4,\n      \"definitions\": [\n        \"One entry in a dataset that holds the features and label for one item.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"One line of the song survey shows a single student’s height, grade, and favorite song.\",\n          \"lesson\": 3\n        },\n        {\n          \"text\": \"In the fruit table, one row lists a single fruit’s weight, color, and shape, and says whether it’s an apple or an orange.\",\n          \"lesson\": 4\n        },\n        {\n          \"text\": \"When you added one example to your dataset, you filled in every column for it, including the right answer at the end.\",\n          \"lesson\": 5\n        },\n        {\n          \"text\": \"Row 42 in Starfall Arena is one player: their age group, the character’s speed and weapon, and “yes” for picking it.\",\n          \"lesson\": 12\n        }\n      ]\n    },\n    {\n      \"id\": \"training-data\",\n      \"type\": \"definition-word\",\n      \"word\": \"training data\",\n      \"lesson\": 4,\n      \"definitions\": [\n        \"The set or collection of data used to train an AI model to recognize patterns or make predictions.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"The song model studied answers from the basketball team and a first-grade class, so that’s all it knows about music taste.\",\n          \"lesson\": 3\n        },\n        {\n          \"text\": \"A model that learned only from apples can’t tell you anything about oranges, because it never saw one.\",\n          \"lesson\": 4\n        },\n        {\n          \"text\": \"The rows AI Lab studied to build your tree, which is every row except the ones at the bottom it saved for checking.\",\n          \"lesson\": 7\n        },\n        {\n          \"text\": \"For your project, you picked the examples your model would learn from before you clicked Train.\",\n          \"lesson\": 13\n        }\n      ]\n    },\n    {\n      \"id\": \"balanced-data\",\n      \"type\": \"definition-word\",\n      \"word\": \"balanced data\",\n      \"lesson\": 6,\n      \"definitions\": [\n        \"Training data with enough records of each category.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"A fixed song survey that asks students from every grade, not just the basketball team and first graders.\",\n          \"lesson\": 3\n        },\n        {\n          \"text\": \"A fruit set with 30 apples and 30 oranges, so the model learns about each kind of fruit equally.\",\n          \"lesson\": 4\n        },\n        {\n          \"text\": \"In the comparison, the fixed dataset had about 50 “yes” rows and 50 “no” rows, so the model saw plenty of both.\",\n          \"lesson\": 6\n        },\n        {\n          \"text\": \"Your Starfall Arena survey included about the same number of younger and older players, so both groups shaped the model.\",\n          \"lesson\": 12\n        }\n      ]\n    },\n    {\n      \"id\": \"unbalanced-data\",\n      \"type\": \"definition-word\",\n      \"word\": \"unbalanced data\",\n      \"lesson\": 6,\n      \"definitions\": [\n        \"Training data where records of one category show up much more often than the others.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"The song survey only asked the basketball team and a first-grade class, so most students’ music tastes were left out.\",\n          \"lesson\": 3\n        },\n        {\n          \"text\": \"A fruit set with 95 apples and 5 oranges, so the model calls almost everything an apple.\",\n          \"lesson\": 4\n        },\n        {\n          \"text\": \"In the comparison, one dataset had 80 “yes” rows and only 10 “no” rows, and that model said yes to nearly everything.\",\n          \"lesson\": 6\n        },\n        {\n          \"text\": \"Most Starfall Arena survey answers came from one group of players, so the model mostly learned what they like.\",\n          \"lesson\": 12\n        }\n      ]\n    },\n    {\n      \"id\": \"tracing\",\n      \"type\": \"definition-word\",\n      \"word\": \"tracing\",\n      \"lesson\": 8,\n      \"definitions\": [\n        \"Following a prediction backward, through the tree’s questions, to the training data that produced it.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"Your model said “no” for a player, so you followed its questions back up the tree to the rows that led there.\",\n          \"lesson\": 8\n        },\n        {\n          \"text\": \"After following two predictions back through the tree, you wrote what you’d change in the training data to get a different answer.\",\n          \"lesson\": 8\n        },\n        {\n          \"text\": \"To explain your comic, you followed the unfair decision back through the model to the examples that taught it.\",\n          \"lesson\": 11\n        },\n        {\n          \"text\": \"A classmate tricked your model, so you walked back through each question it asked to see why it fell for it.\",\n          \"lesson\": 14\n        }\n      ]\n    },\n    {\n      \"id\": \"test-data\",\n      \"type\": \"definition-word\",\n      \"word\": \"test data\",\n      \"lesson\": 8,\n      \"definitions\": [\n        \"Examples kept out of training and used to check how well a model works.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"To check the fruit model, you give it five fruits it never saw while learning and count how many it gets right.\",\n          \"lesson\": 4\n        },\n        {\n          \"text\": \"AI Lab keeps the last rows of your dataset out of learning, then checks its guesses on just those rows.\",\n          \"lesson\": 8\n        },\n        {\n          \"text\": \"Before trusting your model, you set aside a few rows it never studied and saw how many it guessed correctly.\",\n          \"lesson\": 8\n        },\n        {\n          \"text\": \"The trick cards your classmates wrote are brand-new examples your model never saw, used to find out how well it really works.\",\n          \"lesson\": 14\n        }\n      ]\n    },\n    {\n      \"id\": \"combined-feature\",\n      \"type\": \"definition-word\",\n      \"word\": \"combined feature\",\n      \"lesson\": 9,\n      \"definitions\": [\n        \"A new feature built by joining two or more features.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"Temperature and humidity were joined into one new column called “mugginess,” which the model could ask about.\",\n          \"lesson\": 9\n        },\n        {\n          \"text\": \"For the monster cards, you added up horns and claws to make one new column called “spikiness.”\",\n          \"lesson\": 9\n        },\n        {\n          \"text\": \"In Starfall Arena, you merged a character’s speed and attack power into one column called “overall strength.”\",\n          \"lesson\": 12\n        }\n      ]\n    },\n    {\n      \"id\": \"model-card\",\n      \"type\": \"definition-word\",\n      \"word\": \"model card\",\n      \"lesson\": 9,\n      \"definitions\": [\n        \"A short document that explains what a model does, what data it was trained on, and who it might work well or badly for.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"You picked three emojis for your model: one for what it does well, one for where it falls short, and one for who it might fail.\",\n          \"lesson\": 9\n        },\n        {\n          \"text\": \"A face filter app comes with a page saying it learned from 10,000 selfies, works best in bright light, and struggles with glasses.\",\n          \"lesson\": 9\n        },\n        {\n          \"text\": \"A short page for your Starfall Arena model says what it predicts, who answered the survey, and which players it might get wrong.\",\n          \"lesson\": 12\n        },\n        {\n          \"text\": \"Before presenting, you wrote a few sentences about what your model does, what it learned from, and who it works best for.\",\n          \"lesson\": 15\n        }\n      ]\n    },\n    {\n      \"id\": \"stakeholder\",\n      \"type\": \"definition-word\",\n      \"word\": \"stakeholder\",\n      \"lesson\": 10,\n      \"definitions\": [\n        \"Anyone affected by what a model does.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"When a school uses an app to pick students for an advanced class, students, parents, and teachers all feel the effects of its choices.\",\n          \"lesson\": 10\n        },\n        {\n          \"text\": \"In your comic, the kid who got the unfair result is one of the people the model’s decision affects.\",\n          \"lesson\": 11\n        },\n        {\n          \"text\": \"On your gap map, you listed everyone your model will affect, including players who never took the survey.\",\n          \"lesson\": 12\n        },\n        {\n          \"text\": \"During the peer audit, one person played the Affected User, someone the model might treat unfairly.\",\n          \"lesson\": 14\n        }\n      ]\n    },\n    {\n      \"id\": \"audit\",\n      \"type\": \"definition-word\",\n      \"word\": \"audit\",\n      \"lesson\": 10,\n      \"definitions\": [\n        \"A careful investigation of a model to find patterns of failure and trace them back to their cause.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"You checked which groups your model got wrong most often, then traced those mistakes back to the training data.\",\n          \"lesson\": 10\n        },\n        {\n          \"text\": \"In your text exchange, the person checking the project asks the builder why the model keeps getting older players wrong.\",\n          \"lesson\": 12\n        },\n        {\n          \"text\": \"With your role card, you tried tricky inputs on a classmate’s model and wrote down every time it failed and why.\",\n          \"lesson\": 14\n        },\n        {\n          \"text\": \"After checking a classmate’s model, you wrote what you tested, what went wrong, and who could be hurt by it.\",\n          \"lesson\": 14\n        }\n      ]\n    },\n    {\n      \"id\": \"ethics\",\n      \"type\": \"definition-word\",\n      \"word\": \"ethics\",\n      \"lesson\": 11,\n      \"definitions\": [\n        \"Principles that guide people to make fair, responsible, and honest decisions.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"Before using a camera that tracks who is late to class, a principal asks whether it’s fair, whether students know about it, and who could get hurt.\",\n          \"lesson\": 11\n        },\n        {\n          \"text\": \"Your class talked about whether it’s okay for a model to make choices about people who were never in its data.\",\n          \"lesson\": 11\n        },\n        {\n          \"text\": \"When choosing your project, you asked whether your model could hurt anyone and whether it should be built at all.\",\n          \"lesson\": 12\n        },\n        {\n          \"text\": \"In your reflection, you explained what you were responsible for as the builder, not just whether the model worked.\",\n          \"lesson\": 15\n        }\n      ]\n    },\n    {\n      \"id\": \"bias\",\n      \"type\": \"definition-word\",\n      \"word\": \"bias\",\n      \"lesson\": 11,\n      \"definitions\": [\n        \"When a model gives unfair results to one group again and again.\"\n      ],\n      \"examples\": [\n        {\n          \"text\": \"The song model keeps guessing wrong for every student who isn’t on the basketball team or in first grade.\",\n          \"lesson\": 3\n        },\n        {\n          \"text\": \"A model scored 90 percent overall, but it was wrong for almost every player from the smaller group.\",\n          \"lesson\": 10\n        },\n        {\n          \"text\": \"Your comic showed a model that kept turning down one group of kids, with a caption explaining the data that caused it.\",\n          \"lesson\": 11\n        },\n        {\n          \"text\": \"Your Starfall Arena model keeps getting younger players wrong because so few of them answered the survey.\",\n          \"lesson\": 12\n        }\n      ]\n    }\n  ]\n}",
          "folderId": "0",
          "active": false
        },
