  "properties": {
    "encrypted": "false",
    "long_instructions": "**Snippet 1: Demonstrating Asynchronous Order (Non-Blocking)**\r\n\r\nThis code uses an arrow function for the event listener and the `setTimeout` callback. The visual output order proves the non-blocking nature.",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
