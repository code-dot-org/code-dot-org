    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "script.js",
          "language": "js",
          "contents": "const outputElement = document.getElementById('status-output');\n\nconst logToDOM = (message) => {\n    outputElement.innerHTML += `<p>${message}</p>`;\n};\n\n\ndocument.getElementById('start-button').addEventListener('click', () => {\n    \n    outputElement.innerHTML = '';\n\n    logToDOM(\"1️⃣ Script Started (Synchronous code runs immediately)\");\n    outputElement.style.borderColor = 'orange';\n\n    // The function is DEFERRED and runs LATER (after 2 seconds).\n    setTimeout(() => {\n        logToDOM(\"4️⃣ The 'API Response' has finally arrived! (Asynchronous)\");\n    }, 2000); // 2000ms delay\n\n    // This code runs immediately, before the 2-second timer finishes.\n  \n    logToDOM(\"2️⃣ Code continues running immediately (Non-Blocking).\");\n  \n    logToDOM(\"3️⃣ The browser is free to update the UI and respond to user clicks.\");\n    \n});",
          "folderId": "0",
          "active": true
        },
        "2": {
          "id": "2",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n  </head>\n  <body>\n    <div id=\"status-output\" style=\"min-height: 100px; border: 1px solid #ccc; padding: 10px;\">\n    </div>\n    <br/>\n    <button id=\"start-button\"> ▶ Run Code</button>\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "2",
        "1"
      ]
    }
