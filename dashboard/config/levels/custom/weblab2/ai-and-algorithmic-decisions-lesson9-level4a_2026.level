  <config><![CDATA[{
  "published": true,
  "game_id": 74,
  "created_at": "2026-04-16T16:50:32.000Z",
  "level_num": "custom",
  "user_id": 18762,
  "properties": {
    "require_edit_to_continue": "true",
    "display_name": "Movie Admission",
    "bubble_choice_description": "Code an app that determines whether a customer can enter a movie.",
    "thumbnail_url": "https://images.code.org/a938f395f155cf5dcc1a8aa32456918a-movie.png",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>CineKiosk | Admission Engine</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n    <nav class=\"top-nav\" id=\"topNavigation\">\n        <div class=\"nav-left\">\n            <div class=\"logo\">\n                <span class=\"logo-text\">CineKiosk Agent</span>\n            </div>\n        </div>\n        <div class=\"nav-right\">\n            <div class=\"kiosk-id\">Kiosk #04 - Entrance A</div>\n        </div>\n    </nav>\n\n    <main class=\"app-container\">\n        <section class=\"kiosk-column\">\n            \n            <div class=\"display-wrapper\" id=\"kioskDisplayArea\">\n                <div id=\"contentArea\" class=\"content-container\">\n                    <div class=\"content-overlay\">\n                        <h2 id=\"entryMessage\" class=\"entry-message\">Waiting for scan...</h2>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"movie-meta\" id=\"movieMetadata\">\n                <h1 class=\"movie-title\" id=\"movieTitle\">The Last Warrior (2026)</h1>\n                \n                <div class=\"action-row\">\n                    <div class=\"movie-info\">\n                        <div class=\"info-badge rating\">R</div>\n                        <div class=\"info-badge time\">1h 55m</div>\n                        <div class=\"info-badge theater\">Regal River Point • Auditorium 12</div>\n                    </div>\n                    \n                    <div class=\"action-buttons\">\n                        <button class=\"pill-btn standalone\" id=\"helpButton\">\n                             Need Help?\n                        </button>\n                    </div>\n                </div>\n\n                <div class=\"description-box\" id=\"movieDescriptionBox\">\n                    <div class=\"desc-stats\"><strong>Showtime:</strong> Thursday, Apr 16 at 11:35 AM</div>\n                    <div class=\"rating-warning\"><strong>Note:</strong> This film is rated R. Guests must be 17+ or accompanied by a guardian.</div>\n                </div>\n            </div>\n        </section>\n    </main>\n\n    <div class=\"logic-lab\" id=\"logicLabPanel\">\n        <h3>🛠 Admission Logic Lab <button id=\"toggleLabMinimize\" class=\"lab-toggle-btn\">−</button></h3>\n        <p>Test the nested <code>if/else</code> flowchart logic:</p>\n        \n        <div class=\"control-row\">\n            <label>meetsAge</label>\n            <button id=\"toggleAge\" class=\"lab-btn\">FALSE</button>\n        </div>\n\n        <div class=\"control-row\">\n            <label>hasTicket</label>\n            <button id=\"toggleTicket\" class=\"lab-btn\">FALSE</button>\n        </div>\n\n        <div class=\"outcome-box\">\n            <div id=\"logicStatus\"></div>\n        </div>\n    </div>\n\n    <script src=\"script.js\"></script>\n    <script src=\"lab-overlay.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "// State Variables\nlet meetsAge = false;\nlet hasTicket = false;\n\n// UI Element References\nconst entryMessage = document.getElementById(\"entryMessage\");\nconst kioskDisplayArea = document.getElementById(\"kioskDisplayArea\");\n\n// Function to update the admission logic\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n// Initialize App\nupdateAppUI();",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "lab-overlay.js",
          "contents": "// ==========================================\n// LAB OVERLAY CONTROLS\n// ==========================================\n\n// Select DOM Elements\nconst btnAge = document.getElementById('toggleAge');\nconst btnTicket = document.getElementById('toggleTicket');\nconst statusDisplay = document.getElementById('logicStatus');\nconst toggleMinimizeBtn = document.getElementById('toggleLabMinimize');\nconst logicLabPanel = document.getElementById('logicLabPanel');\n\n// 1. Minimize/Expand Logic for the Lab Window\ntoggleMinimizeBtn.addEventListener('click', () => {\n    logicLabPanel.classList.toggle('minimized');\n    \n    if (logicLabPanel.classList.contains('minimized')) {\n        toggleMinimizeBtn.innerText = '+';\n    } else {\n        toggleMinimizeBtn.innerText = '−';\n    }\n});\n\n// 2. Toggle Logic for \"meetsAge\"\nbtnAge.addEventListener('click', () => {\n    meetsAge = !meetsAge; // Toggle global variable\n    \n    btnAge.innerText = meetsAge ? \"TRUE\" : \"FALSE\";\n    \n    if (meetsAge) {\n        btnAge.classList.add('active'); \n    } else {\n        btnAge.classList.remove('active'); \n    }\n    \n    updateAppUI();\n    updateLabStatus();\n});\n\n// 3. Toggle Logic for \"hasTicket\"\nbtnTicket.addEventListener('click', () => {\n    hasTicket = !hasTicket; // Toggle global variable\n    \n    btnTicket.innerText = hasTicket ? \"TRUE\" : \"FALSE\";\n    \n    if (hasTicket) {\n        btnTicket.classList.add('active'); \n    } else {\n        btnTicket.classList.remove('active'); \n    }\n    \n    updateAppUI();\n    updateLabStatus();\n});\n\n// 4. Update the visual Engine Status in the Lab Panel\nfunction updateLabStatus() {\n    \n    // Simplified logic to match the main script\n    if (meetsAge && hasTicket) {\n        statusDisplay.innerText = \"State: Requirements Met\";\n        statusDisplay.style.color = \"#00ba7c\"; // Green\n    } else {\n        statusDisplay.innerText = \"State: Condition(s) Not Met\";\n        statusDisplay.style.color = \"#ff0000\"; // True Red\n    }\n}\n\n// Initialize lab status text\nupdateLabStatus();",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
        "4": {
          "id": "4",
          "name": "style.css",
          "contents": ":root {\n    --app-bg: #111418;\n    --app-surface: #1e2329;\n    --app-text: #ffffff;\n    --app-text-gray: #aeb5bc;\n    --brand-orange: #f26f21;\n    --status-red:  #d93025;\n    --status-green: #1e8e3e;\n}\n\n* { \n    box-sizing: border-box; \n    margin: 0; \n    padding: 0; \n}\n\nbody {\n    background-color: var(--app-bg);\n    color: var(--app-text);\n    font-family: \"Helvetica Neue\", Arial, sans-serif;\n    -webkit-font-smoothing: antialiased;\n}\n\n/* =========================================\n   TOP NAVIGATION\n   ========================================= */\n.top-nav {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 0 24px;\n    height: 64px;\n    background: var(--app-surface);\n    border-bottom: 2px solid var(--brand-orange);\n}\n\n.logo-text { \n    font-weight: 800; \n    font-size: 22px; \n    color: var(--brand-orange);\n    text-transform: uppercase;\n    letter-spacing: 1px;\n}\n\n.kiosk-id {\n    font-size: 14px;\n    color: var(--app-text-gray);\n    font-weight: 500;\n}\n\n/* =========================================\n   MAIN LAYOUT & KIOSK DISPLAY\n   ========================================= */\n.app-container { max-width: 1000px; margin: 40px auto; padding: 0 24px; }\n\n.display-wrapper {\n    width: 100%;\n    aspect-ratio: 21/9;\n    background: #000;\n    border-radius: 16px;\n    position: relative;\n    overflow: hidden;\n    transition: all 0.3s ease;\n    border: 4px solid #333;\n}\n\n/* Kiosk Status States */\n.display-wrapper.status-allowed {\n    background-color: rgba(30, 142, 62, 0.1);\n    border-color: var(--status-green);\n}\n\n.display-wrapper.status-denied {\n    background-color: rgba(217, 48, 37, 0.1);\n    border-color: var(--status-red);\n}\n\n.content-overlay {\n    position: absolute;\n    top: 0; left: 0; width: 100%; height: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-align: center;\n}\n\n.entry-message {\n    font-size: 32px;\n    font-weight: 700;\n    line-height: 1.5;\n    white-space: pre-line; /* Allows the \\n in JS to break to a new line */\n}\n\n.status-allowed .entry-message { color: var(--status-green); }\n.status-denied .entry-message { color: var(--status-red); }\n\n/* =========================================\n   MOVIE METADATA\n   ========================================= */\n.movie-meta { padding: 32px 0; }\n.movie-title { font-size: 28px; font-weight: 800; margin-bottom: 16px; }\n\n.action-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 24px;\n}\n\n.movie-info { display: flex; gap: 12px; }\n\n.info-badge {\n    background: var(--app-surface);\n    padding: 8px 16px;\n    border-radius: 8px;\n    font-weight: 600;\n    font-size: 14px;\n}\n\n.info-badge.rating { border: 1px solid var(--app-text); }\n\n.pill-btn {\n    background: var(--app-surface);\n    color: white;\n    border: 1px solid #444;\n    padding: 10px 20px;\n    border-radius: 8px;\n    font-size: 14px;\n    font-weight: 600;\n    cursor: pointer;\n}\n\n.pill-btn:hover { background: #333; }\n\n.description-box {\n    background: var(--app-surface);\n    padding: 20px;\n    border-radius: 12px;\n    font-size: 15px;\n    line-height: 1.6;\n    border-left: 4px solid var(--brand-orange);\n}\n\n.rating-warning { margin-top: 8px; color: #ff9800; }\n\n/* =========================================\n   LOGIC LAB STYLES\n   ========================================= */\n.logic-lab {\n    position: fixed;\n    bottom: 20px;\n    right: 20px;\n    background: #16181c;\n    color: #e7e9ea;\n    padding: 20px;\n    border-radius: 16px;\n    width: 320px;\n    box-shadow: 0 0 15px rgba(0, 0, 0, 0.8);\n    z-index: 1000;\n    border: 1px solid #2f3336;\n    transition: height 0.3s ease, padding 0.3s ease;\n}\n\n.logic-lab.minimized { height: 56px; overflow: hidden; padding: 16px 20px; }\n\n.logic-lab h3 {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 15px;\n    font-size: 1.1rem;\n    border-bottom: 1px solid #2f3336;\n    padding-bottom: 10px;\n}\n\n.logic-lab.minimized h3 { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }\n\n.lab-toggle-btn { background: transparent; border: none; color: inherit; cursor: pointer; font-size: 1.5rem; line-height: 1; }\n\n.logic-lab p { font-size: 14px; color: #71767b; margin-bottom: 15px; }\n\n.control-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; font-size: 15px; }\n\n.lab-btn {\n    padding: 6px 12px;\n    cursor: pointer;\n    background: #ff0000; \n    color: #ffffff;\n    border: 1px solid #ff0000;\n    font-weight: bold;\n    width: 80px;\n    border-radius: 9999px;\n    transition: all 0.2s;\n}\n\n/* The active (TRUE) state remains green */\n.lab-btn.active { \n    background: #00ba7c; \n    border: 1px solid #00ba7c; \n}\n\n\n.outcome-box { margin-top: 15px; padding-top: 15px; border-top: 1px solid #2f3336; font-size: 14px; }\n\n#logicStatus { margin-top: 8px; font-weight: bold; line-height: 1.4; color: #1d9bf0;}\n\n.logic-lab.minimized p,\n.logic-lab.minimized .control-row,\n.logic-lab.minimized .outcome-box { display: none; }",
          "folderId": "0",
          "active": false
        }
      },
