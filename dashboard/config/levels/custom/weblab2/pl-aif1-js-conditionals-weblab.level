          "name": "style.css",
          "contents": "* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  font-family: system-ui, -apple-system, sans-serif;\n  color: #1f1f1f;\n  background-color: #fcfcfc;\n  padding: 0 20px 40px;\n}\n\n.app-shell {\n  max-width: 1100px;\n  margin: 0 auto;\n}\n\n/* Header & Pill Bubble */\n.site-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 30px 0;\n}\n\n.logo {\n  font-size: 1.5rem;\n  font-weight: 900;\n  letter-spacing: 2px;\n}\n\n.header-favorites-btn {\n  position: relative;\n  background: none;\n  border: none;\n  cursor: pointer;\n  padding: 8px;\n}\n\n.header-favorites-btn svg {\n  width: 28px;\n  height: 28px;\n  stroke: black;\n  stroke-width: 2;\n  fill: none;\n}\n\n.count-bubble {\n  position: absolute;\n  top: 0;\n  right: 0;\n  background-color: black;\n  color: white;\n  font-size: 11px;\n  font-weight: bold;\n  width: 20px;\n  height: 20px;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border: 2px solid white;\n}\n\n/* Breadcrumbs */\n.breadcrumbs {\n  font-size: 12px;\n  color: #777;\n  margin-bottom: 25px;\n}\n\n.breadcrumbs span {\n  margin: 0 5px;\n}\n\n/* Toolbar */\n.toolbar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 25px;\n}\n\n.toolbar-btn {\n  background: white;\n  border: 1px solid #ddd;\n  padding: 8px 16px;\n  cursor: pointer;\n  font-size: 14px;\n}\n\n.style-count {\n  font-size: 12px;\n  color: #888;\n}\n\n/* Grid */\n.card-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 30px;\n}\n\n.item-card {\n  display: flex;\n  flex-direction: column;\n}\n\n.image-wrap {\n  position: relative;\n  aspect-ratio: 3 / 4;\n  background-color: #f0f0f0;\n  overflow: hidden;\n}\n\n.item-image {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n/* Heart Buttons */\n.heart-btn {\n  position: absolute;\n  top: 15px;\n  right: 15px;\n  width: 44px;\n  height: 44px;\n  background: white;\n  border: none;\n  border-radius: 50%;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow: 0 4px 10px rgba(0,0,0,0.1);\n  transition: transform 0.2s;\n}\n\n.heart-btn:hover {\n  transform: scale(1.1);\n}\n\n.heart-btn svg {\n  width: 20px;\n  height: 20px;\n  stroke: black;\n  stroke-width: 2;\n  /* Magic: This allows JS .style.fill to work */\n  fill: inherit; \n}\n\n/* Item Labels */\n.item-info {\n  padding: 15px 0;\n}\n\n.item-title {\n  font-size: 16px;\n  font-weight: 500;\n  margin-bottom: 5px;\n}\n\n.price {\n  font-weight: 700;\n  font-size: 15px;\n}\n\n.badge-container {\n  display: flex;\n  gap: 8px;\n  margin-top: 10px;\n}\n\n.badge {\n  font-size: 10px;\n  font-weight: 700;\n  padding: 4px 8px;\n}\n\n.badge-outline {\n  border: 1px solid #ddd;\n}\n\n.badge-solid {\n  background: #eee;\n}\n\n@media (max-width: 300px) {\n  .card-grid { grid-template-columns: 1fr; }\n}",
