          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Everyday Basics</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body id=\"mainBody\">\n  <div class=\"app-shell\">\n\n    <header id=\"siteHeader\" class=\"site-header\">\n      <h2 id=\"siteLogo\" class=\"logo\">H&HEM</h2>\n      \n      <button id=\"headerFavoritesBtn\" class=\"header-favorites-btn\" aria-label=\"View saved favorites\">\n        <svg viewBox=\"0 0 24 24\">\n          <path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"/>\n        </svg>\n        <span id=\"favoritesCountBubble\" class=\"count-bubble\">0</span>\n      </button>\n    </header>\n    \n    <nav id=\"breadcrumbNav\" class=\"breadcrumbs\">\n      Home <span id=\"breadcrumbSeparator1\">&rsaquo;</span> Clothing <span id=\"breadcrumbSeparator2\">&rsaquo;</span> Unisex <span id=\"breadcrumbSeparator3\">&rsaquo;</span> Everyday Basics\n    </nav>\n\n    <div class=\"toolbar\">\n      <div class=\"toolbar-actions\">\n        <button id=\"sortButton\" class=\"toolbar-btn\">Sort <span id=\"sortIcon\">&#8693;</span></button>\n        <button id=\"filterButton\" class=\"toolbar-btn\">Filter <span id=\"filterIcon\">▼</span></button>\n      </div>\n      <div class=\"style-count\">1,402 styles found</div>\n    </div>\n\n    <main id=\"productGrid\" class=\"card-grid\">\n      <article id=\"productCard1\" class=\"item-card\">\n        <div class=\"image-wrap\">\n          <img id=\"productImage1\" class=\"item-image\" src=\"images/item1.png\" alt=\"White t-shirt\" />\n          <button id=\"heartButton1\" class=\"heart-btn\" aria-label=\"Save for later\" style=\"fill: none;\">\n            <svg viewBox=\"0 0 24 24\"><path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"/></svg>\n          </button>\n        </div>\n        <div class=\"item-info\">\n          <h2 id=\"productTitle1\" class=\"item-title\">Heavyweight Boxy Fit T-Shirt in Classic White</h2>\n          <p id=\"productPrice1\" class=\"price\">$35.00</p>\n        </div>\n      </article>\n\n      <article id=\"productCard2\" class=\"item-card\">\n        <div class=\"image-wrap\">\n          <img id=\"productImage2\" class=\"item-image\" src=\"images/item2.png\" alt=\"Gray hoodie\" />\n          <button id=\"heartButton2\" class=\"heart-btn\" aria-label=\"Save for later\" style=\"fill: none;\">\n            <svg viewBox=\"0 0 24 24\"><path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"/></svg>\n          </button>\n        </div>\n        <div class=\"item-info\">\n          <h2 id=\"productTitle2\" class=\"item-title\">Oversized Premium Fleece Hoodie in Heather Gray</h2>\n          <p id=\"productPrice2\" class=\"price\">$65.00</p>\n          <div class=\"badge-container\">\n            <span id=\"product2BadgeMoreColors\" class=\"badge badge-outline\">MORE COLORS</span>\n            <span id=\"product2BadgeSellingFast\" class=\"badge badge-solid\">SELLING FAST</span>\n          </div>\n        </div>\n      </article>\n\n      <article id=\"productCard3\" class=\"item-card\">\n        <div class=\"image-wrap\">\n          <img id=\"productImage3\" class=\"item-image\" src=\"images/item3.png\" alt=\"Blue jeans\" />\n          <button id=\"heartButton3\" class=\"heart-btn\" aria-label=\"Save for later\" style=\"fill: none;\">\n            <svg viewBox=\"0 0 24 24\"><path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"/></svg>\n          </button>\n        </div>\n        <div class=\"item-info\">\n          <h2 id=\"productTitle3\" class=\"item-title\">Straight Leg Washed Vintage Denim Jeans</h2>\n          <p id=\"productPrice3\" class=\"price\">$89.99</p>\n          <div class=\"badge-container\">\n            <span id=\"product3BadgeSellingFast\" class=\"badge badge-solid\">SELLING FAST</span>\n          </div>\n        </div>\n      </article>\n\n      <article id=\"productCard4\" class=\"item-card\">\n        <div class=\"image-wrap\">\n          <img id=\"productImage4\" class=\"item-image\" src=\"images/item4.png\" alt=\"White sneakers\" />\n          <button id=\"heartButton4\" class=\"heart-btn\" aria-label=\"Save for later\" style=\"fill: none;\">\n            <svg viewBox=\"0 0 24 24\"><path d=\"M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z\"/></svg>\n          </button>\n        </div>\n        <div class=\"item-info\">\n          <h2 id=\"productTitle4\" class=\"item-title\">Chunky Minimalist Everyday Sneakers in Off-White</h2>\n          <p id=\"productPrice4\" class=\"price\">$110.00</p>\n          <div class=\"badge-container\">\n            <span id=\"product4BadgeSellingFast\" class=\"badge badge-solid\">SELLING FAST</span>\n          </div>\n        </div>\n      </article>\n    </main>\n    \n  </div>\n  \n  <script src=\"script.js\"></script>\n</body>\n</html>",
