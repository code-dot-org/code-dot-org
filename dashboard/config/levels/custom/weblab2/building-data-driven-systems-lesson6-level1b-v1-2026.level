      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Volunteer Board</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <main class=\"app\">\n      <header class=\"app-header\">\n        <p class=\"eyebrow\">Community Connect</p>\n        <h1>Volunteer Board</h1>\n        <p class=\"subtitle\">Find ways to help out near you.</p>\n      </header>\n\n      <section class=\"opportunities-section\">\n        <h2>Open Opportunities</h2>\n        <div id=\"opportunityContainer\" class=\"opportunity-container\"></div>\n      </section>\n    </main>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  font-family: Inter, Arial, sans-serif;\n  background: #eef7f1;\n  color: #1f2937;\n}\n\n.app {\n  max-width: 480px;\n  margin: 0 auto;\n  min-height: 100vh;\n  background: #fbfdfb;\n}\n\n.app-header {\n  padding: 28px 20px 18px;\n  background: #1f7a4d;\n  color: white;\n}\n\n.eyebrow {\n  margin: 0 0 4px;\n  font-size: 0.8rem;\n  text-transform: uppercase;\n  color: #d8f3df;\n}\n\n.app-header h1 {\n  margin: 0;\n  font-size: 1.8rem;\n  font-weight: 700;\n}\n\n.subtitle {\n  margin: 6px 0 0;\n  font-size: 0.95rem;\n  color: #e9f8ed;\n}\n\n.opportunities-section {\n  padding: 20px;\n}\n\n.opportunities-section h2 {\n  margin: 0 0 12px;\n  font-size: 1.1rem;\n  font-weight: 700;\n}\n\n.opportunity-container {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n\n.opportunity-card {\n  display: flex;\n  gap: 14px;\n  padding: 14px;\n  border-radius: 18px;\n  background: #ffffff;\n  border: 1px solid #dce9df;\n}\n\n.opportunity-image {\n  width: 92px;\n  height: 92px;\n  border-radius: 14px;\n  object-fit: cover;\n  flex-shrink: 0;\n}\n\n.opportunity-content {\n  flex: 1;\n}\n\n.opportunity-time {\n  margin: 0 0 4px;\n  font-size: 0.78rem;\n  font-weight: 700;\n  color: #1f7a4d;\n}\n\n.opportunity-title {\n  margin: 0 0 5px;\n  font-size: 1.05rem;\n  font-weight: 700;\n}\n\n.opportunity-role,\n.opportunity-location {\n  margin: 0;\n  font-size: 0.9rem;\n  color: #5f6f65;\n  line-height: 1.35;\n}\n\n.opportunity-location {\n  margin-top: 5px;\n  font-weight: 600;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const opportunityContainer = document.getElementById(\"opportunityContainer\");\n\nconst volunteerOpportunities = [\n  {\n    organization: \"City Food Pantry\",\n    image: \"images/food-pantry.png\",\n    role: \"Pack grocery boxes\",\n    location: \"Downtown Center\",\n    time: \"Saturday, 10 AM\"\n  },\n  {\n    organization: \"Park Cleanup Crew\",\n    image: \"images/park-cleanup.png\",\n    role: \"Help clean up the park\",\n    location: \"Riverside Park\",\n    time: \"Sunday, 9 AM\"\n  },\n  {\n    organization: \"Animal Shelter\",\n    image: \"images/animal-shelter.png\",\n    role: \"Walk dogs and sort supplies\",\n    location: \"Westside Shelter\",\n    time: \"Wednesday, 4 PM\"\n  }\n];\n\nconst opportunityCards = volunteerOpportunities.map((opportunity) => {\n  return `\n    <div class=\"opportunity-card\">\n      <img class=\"opportunity-image\" src=\"${opportunity.image}\" alt=\"${opportunity.organization}\">\n      <div class=\"opportunity-content\">\n        <p class=\"opportunity-time\">${opportunity.time}</p>\n        <h3 class=\"opportunity-title\">${opportunity.organization}</h3>\n        <p class=\"opportunity-role\">${opportunity.role}</p>\n        <p class=\"opportunity-location\">${opportunity.location}</p>\n      </div>\n    </div>\n  `;\n});\n\nopportunityContainer.innerHTML = opportunityCards.join(\"\");",
          "folderId": "0",
          "active": true
        },
