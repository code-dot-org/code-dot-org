  "properties": {
    "encrypted": "false",
    "long_instructions": "## Explore `.map()`\r\n\r\n### Do This:\r\n\r\n- Look at the `volunteerOpportunities` array.\r\n- Find the `.map()` code.\r\n- Look at the opportunity cards on the page.\r\n\r\n### Think:\r\n\r\n- How many cards are created?\r\n- What is changing in each card?\r\n- What seems to be repeating?",
    "submittable": "false",
    "hide_share_and_remix": "false",
    "disable_edit_run_for_submission": "false",
