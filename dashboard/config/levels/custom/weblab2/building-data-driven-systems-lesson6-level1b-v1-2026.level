      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Volunteer Board</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <main class=\"app\">\n      <header class=\"app-header\">\n        <p class=\"eyebrow\">Community Connect</p>\n        <h1>Volunteer Board</h1>\n        <p class=\"subtitle\">Find ways to help out near you.</p>\n      </header>\n\n      <section class=\"opportunities-section\">\n        <h2>Open Opportunities</h2>\n        <div id=\"opportunityContainer\" class=\"opportunity-container\"></div>\n      </section>\n    </main>\n\n    <script src=\"helpers.js\"></script>\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  font-family: Inter, Arial, sans-serif;\n  background: #eef7f1;\n  color: #1f2937;\n}\n\n.app {\n  max-width: 480px;\n  margin: 0 auto;\n  min-height: 100vh;\n  background: #fbfdfb;\n}\n\n.app-header {\n  padding: 28px 20px 18px;\n  background: #1f7a4d;\n  color: white;\n}\n\n.eyebrow {\n  margin: 0 0 4px;\n  font-size: 0.8rem;\n  text-transform: uppercase;\n  color: #d8f3df;\n}\n\n.app-header h1 {\n  margin: 0;\n  font-size: 1.8rem;\n  font-weight: 700;\n}\n\n.subtitle {\n  margin: 6px 0 0;\n  font-size: 0.95rem;\n  color: #e9f8ed;\n}\n\n.opportunities-section {\n  padding: 20px;\n}\n\n.opportunities-section h2 {\n  margin: 0 0 12px;\n  font-size: 1.1rem;\n  font-weight: 700;\n}\n\n.opportunity-container {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n\n.opportunity-card {\n  display: flex;\n  gap: 14px;\n  padding: 14px;\n  border-radius: 18px;\n  background: #ffffff;\n  border: 1px solid #dce9df;\n}\n\n.opportunity-image {\n  width: 92px;\n  height: 92px;\n  border-radius: 14px;\n  object-fit: cover;\n  flex-shrink: 0;\n}\n\n.opportunity-content {\n  flex: 1;\n}\n\n.opportunity-time {\n  margin: 0 0 4px;\n  font-size: 0.78rem;\n  font-weight: 700;\n  color: #1f7a4d;\n}\n\n.opportunity-title {\n  margin: 0 0 5px;\n  font-size: 1.05rem;\n  font-weight: 700;\n}\n\n.opportunity-role,\n.opportunity-location {\n  margin: 0;\n  font-size: 0.9rem;\n  color: #5f6f65;\n  line-height: 1.35;\n}\n\n.opportunity-location {\n  margin-top: 5px;\n  font-weight: 600;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const volunteerOpportunities = [\n  {\n    organization: \"City Food Pantry\",\n    image: \"images/food-pantry.png\",\n    role: \"Pack grocery boxes\",\n    location: \"Downtown Center\",\n    time: \"Saturday, 10 AM\"\n  },\n  {\n    organization: \"Park Cleanup Crew\",\n    image: \"images/park-cleanup.png\",\n    role: \"Help clean up the park\",\n    location: \"Riverside Park\",\n    time: \"Sunday, 9 AM\"\n  },\n  {\n    organization: \"Animal Shelter\",\n    image: \"images/animal-shelter.png\",\n    role: \"Walk dogs and sort supplies\",\n    location: \"Westside Shelter\",\n    time: \"Wednesday, 4 PM\"\n  }\n];\n\nvolunteerOpportunities.map(opportunity => {\n  createCard(opportunity.image, opportunity.organization, opportunity.role, opportunity.location, opportunity.time);\n});",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
          "name": "food-pantry.png",
          "contents": "",
          "folderId": "1",
          "url": "/level_starter_assets/building-data-driven-systems-lesson6-level1b-v1-2026/uuid/01adda7d-a6c4-454c-bda0-fa3f91ce8224.png",
          "type": "starter",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "animal-shelter.png",
          "contents": "",
          "folderId": "1",
          "url": "/level_starter_assets/building-data-driven-systems-lesson6-level1b-v1-2026/uuid/6d2dcf41-8342-4a2d-b6c5-36d16b6634fc.png",
          "type": "starter",
          "active": false
        },
        "6": {
          "id": "6",
          "name": "park-cleanup.png",
          "contents": "",
          "folderId": "1",
          "url": "/level_starter_assets/building-data-driven-systems-lesson6-level1b-v1-2026/uuid/a322e0c1-e13d-4cb4-846d-10638840769f.png",
          "type": "starter",
          "active": false
        },
        "7": {
          "id": "7",
          "name": "helpers.js",
          "contents": "let cardCount = 0;\n\nconst createCard = (imageSrc, organization, role, location, time) => {\n  const container = document.getElementById(\"opportunityContainer\");\n\n  const card = document.createElement(\"div\");\n  card.className = \"opportunity-card\";\n  card.id = \"card\" + cardCount;\n\n  const image = document.createElement(\"img\");\n  image.className = \"opportunity-image\";\n  image.id = \"image\" + cardCount;\n  image.src = imageSrc;\n  image.alt = organization;\n\n  const content = document.createElement(\"div\");\n  content.className = \"opportunity-content\";\n  content.id = \"content\" + cardCount;\n\n  const timeEl = document.createElement(\"p\");\n  timeEl.className = \"opportunity-time\";\n  timeEl.id = \"time\" + cardCount;\n  timeEl.textContent = time;\n\n  const title = document.createElement(\"h3\");\n  title.className = \"opportunity-title\";\n  title.id = \"title\" + cardCount;\n  title.textContent = organization;\n\n  const roleEl = document.createElement(\"p\");\n  roleEl.className = \"opportunity-role\";\n  roleEl.id = \"role\" + cardCount;\n  roleEl.textContent = role;\n\n  const locationEl = document.createElement(\"p\");\n  locationEl.className = \"opportunity-location\";\n  locationEl.id = \"location\" + cardCount;\n  locationEl.textContent = location;\n\n  content.appendChild(timeEl);\n  content.appendChild(title);\n  content.appendChild(roleEl);\n  content.appendChild(locationEl);\n\n  card.appendChild(image);\n  card.appendChild(content);\n\n  container.appendChild(card);\n\n  cardCount++;\n};",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "3"
      ]
    },
