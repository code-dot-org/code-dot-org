      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Streamline: For You Feed</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n\n<body id=\"mainBody\">\n  <div id=\"appShell\" class=\"app-shell\">\n\n    <header id=\"siteHeader\" class=\"site-header\">\n      <h1 id=\"siteLogo\" class=\"logo\">STREAMLINE</h1>\n\n      <nav id=\"mainNav\" class=\"main-nav\">\n        <span id=\"navHome\">Home</span>\n        <span id=\"navMovies\">Movies</span>\n        <span id=\"navForYou\" class=\"active-nav\">For You</span>\n        <span id=\"navMyList\">My List</span>\n      </nav>\n    </header>\n\n    <section id=\"heroSection\" class=\"hero-section\">\n      <p id=\"heroEyebrow\" class=\"hero-eyebrow\">For You Feed</p>\n      <h2 id=\"heroTitle\" class=\"hero-title\">Design a movie feed that feels personalized.</h2>\n      <p id=\"heroText\" class=\"hero-text\">\n        Choose which movies belong in the feed, then sort them so the best matches appear first.\n      </p>\n    </section>\n\n    <section id=\"controlSection\" class=\"control-section\">\n      <div id=\"feedControls\" class=\"feed-controls\">\n        <button id=\"showAllBtn\" class=\"feed-chip secondary-chip\" type=\"button\">\n          All Movies\n        </button>\n\n        <button id=\"buildFeedBtn\" class=\"feed-chip primary-chip\" type=\"button\">\n          Run For You Feed\n        </button>\n      </div>\n\n      <p id=\"movieCount\" class=\"movie-count\">0 movies found</p>\n    </section>\n\n    <main id=\"movieGrid\" class=\"movie-grid\" aria-live=\"polite\"></main>\n\n  </div>\n\n  <script src=\"data.js\"></script>\n  <script src=\"helpers.js\"></script>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// This array controls which movies are currently shown.\nlet displayMovies = [];\n\n// Build your For You feed algorithm here.\n// Use your plan from prompt.md before asking AI Tutor for help.\nconst buildForYouFeed = () => {\n  displayMovies = [];\n\n  // 1. FILTER\n  // Use movies.map() to go through each movie.\n  // Use an if statement to decide which movies belong in your feed.\n  // Use displayMovies.push(movie) to keep matching movies.\n\n\n\n\n\n\n\n  // 2. SORT\n  // Use displayMovies.sort() to choose what appears first.\n  // Example sort ideas:\n  // - highest rating first\n  // - newest year first\n  // - alphabetical by title\n\n\n\n\n\n\n\n  // 3. RENDER\n  // Keep this as the last line of your function.\n  renderMovies();\n};\n\n// Run the For You feed when the button is clicked.\ndocument.getElementById(\"buildFeedBtn\").addEventListener(\"click\", buildForYouFeed);\n\n// Show all movies when the app first loads.\nshowAllMovies();",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\n:root {\n  --bg-color: #050505;\n  --card-bg: #151515;\n  --card-hover: #202020;\n  --text-color: #ffffff;\n  --muted-text: #b8b8b8;\n  --accent-color: #e50914;\n  --accent-green: #46d369;\n  --border-color: #333333;\n}\n\nbody {\n  font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  background-color: var(--bg-color);\n  color: var(--text-color);\n}\n\n.app-shell {\n  width: 100%;\n  max-width: 420px;\n  margin: 0 auto;\n  padding: 0 14px 32px;\n}\n\n/* Header */\n.site-header {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  padding: 18px 0 14px;\n}\n\n.logo {\n  color: var(--accent-color);\n  font-size: 22px;\n  font-weight: 900;\n  letter-spacing: 1px;\n  flex-shrink: 0;\n}\n\n.main-nav {\n  display: flex;\n  gap: 12px;\n  color: #d7d7d7;\n  font-size: 12px;\n  overflow-x: auto;\n  white-space: nowrap;\n}\n\n.main-nav span {\n  flex-shrink: 0;\n}\n\n.active-nav {\n  color: white;\n  font-weight: 800;\n}\n\n/* Hero */\n.hero-section {\n  min-height: 170px;\n  padding: 28px 18px 22px;\n  background:\n    linear-gradient(to right, rgba(5, 5, 5, 1), rgba(5, 5, 5, 0.72), rgba(5, 5, 5, 1)),\n    linear-gradient(135deg, #3a0f18, #111827, #050505);\n  border-radius: 16px;\n  margin-bottom: 18px;\n}\n\n.hero-eyebrow {\n  color: var(--accent-color);\n  font-weight: 800;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  font-size: 11px;\n  margin-bottom: 10px;\n}\n\n.hero-title {\n  font-size: 28px;\n  line-height: 1.05;\n  margin-bottom: 12px;\n}\n\n.hero-text {\n  color: #d4d4d4;\n  font-size: 13px;\n  line-height: 1.45;\n}\n\n/* Controls */\n.control-section {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 11px;\n  margin-bottom: 16px;\n}\n\n.feed-controls {\n  width: 100%;\n  display: flex;\n  flex-wrap: nowrap;\n  gap: 8px;\n  overflow-x: auto;\n  padding-bottom: 4px;\n}\n\n.feed-chip {\n  flex-shrink: 0;\n  border-radius: 999px;\n  padding: 8px 13px;\n  font-size: 13px;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n.primary-chip {\n  border: 1px solid var(--accent-color);\n  background-color: var(--accent-color);\n  color: white;\n}\n\n.secondary-chip {\n  border: 1px solid #444444;\n  background-color: #171717;\n  color: white;\n}\n\n.feed-chip:hover {\n  background-color: #2b2b2b;\n  border-color: #777777;\n}\n\n.primary-chip:hover {\n  background-color: #b80710;\n  border-color: #b80710;\n}\n\n.feed-chip:focus {\n  outline: 2px solid white;\n  outline-offset: 2px;\n}\n\n.movie-count {\n  color: var(--muted-text);\n  font-size: 12px;\n  white-space: nowrap;\n}\n\n/* Movie Grid */\n.movie-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 12px;\n}\n\n.movie-card {\n  background-color: var(--card-bg);\n  border-radius: 9px;\n  overflow: hidden;\n  transition: transform 0.2s, background-color 0.2s;\n}\n\n.movie-card:hover {\n  transform: scale(1.02);\n  background-color: var(--card-hover);\n}\n\n.poster-wrap {\n  position: relative;\n  aspect-ratio: 2 / 3;\n  background-color: #222222;\n  overflow: hidden;\n}\n\n.poster-image {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.movie-badge {\n  position: absolute;\n  top: 8px;\n  left: 8px;\n  background-color: var(--accent-color);\n  color: white;\n  font-size: 10px;\n  font-weight: 800;\n  padding: 3px 6px;\n  border-radius: 4px;\n}\n\n.movie-info {\n  padding: 9px;\n}\n\n.movie-title {\n  font-size: 14px;\n  line-height: 1.25;\n  margin-bottom: 6px;\n}\n\n.movie-meta {\n  color: var(--muted-text);\n  font-size: 12px;\n  margin-bottom: 5px;\n}\n\n.movie-rating {\n  color: var(--accent-green);\n  font-size: 12px;\n  font-weight: 700;\n}\n\n/* Extra-small windows */\n@media (max-width: 330px) {\n  .app-shell {\n    padding: 0 10px 28px;\n  }\n\n  .site-header {\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 8px;\n  }\n\n  .hero-title {\n    font-size: 24px;\n  }\n\n  .movie-grid {\n    gap: 10px;\n  }\n\n  .movie-title {\n    font-size: 13px;\n  }\n}\n\n/* Tablet and desktop */\n@media (min-width: 520px) {\n  .app-shell {\n    max-width: 760px;\n    padding: 0 22px 44px;\n  }\n\n  .site-header {\n    justify-content: space-between;\n  }\n\n  .main-nav {\n    font-size: 14px;\n    gap: 18px;\n  }\n\n  .hero-title {\n    font-size: 36px;\n    max-width: 620px;\n  }\n\n  .hero-text {\n    font-size: 15px;\n    max-width: 580px;\n  }\n\n  .control-section {\n    flex-direction: row;\n    justify-content: space-between;\n    align-items: center;\n  }\n\n  .feed-controls {\n    width: auto;\n  }\n\n  .movie-grid {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 16px;\n  }\n}\n\n@media (min-width: 900px) {\n  .app-shell {\n    max-width: 1100px;\n  }\n\n  .movie-grid {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 18px;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "prompt.md",
          "language": "md",
          "contents": "# Clarify\n*\n*\n\n# Hone\n*\n*\n\n# Apply\n*\n*\n\n# Transfer\n\n\n",
