        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>Inventory Check</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    <h1>Supply Inspector</h1>\n    \n    <div class=\"display-box\">\n      <h2>Item Inspection</h2>\n      <div class=\"info-row\">\n        <strong>Name:</strong> <span id=\"name-display\"></span>\n      </div>\n      <div class=\"info-row\">\n        <strong>Category:</strong> <span id=\"cat-display\"></span>\n      </div>\n      <div class=\"info-row\">\n        <strong>Location:</strong> <span id=\"loc-display\"></span>\n      </div>\n    </div>\n\n    <script src=\"script.js\" defer></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* style.css */\nbody {\n  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\n  background-color: #f4f4f9;\n  color: #333;\n  text-align: center;\n  padding: 20px;\n}\n\nh1 {\n  color: #2c3e50;\n  margin-bottom: 30px;\n}\n\n.display-box {\n  background-color: white;\n  width: 300px;\n  margin: 0 auto;\n  padding: 20px;\n  border-radius: 8px;\n  box-shadow: 0 4px 15px rgba(0,0,0,0.1);\n  text-align: left;\n  border-left: 5px solid #3498db;\n}\n\nh2 {\n  margin-top: 0;\n  color: #3498db;\n  border-bottom: 1px solid #eee;\n  padding-bottom: 10px;\n}\n\n.info-row {\n  margin: 15px 0;\n  font-size: 1.1em;\n}\n\nstrong {\n  color: #555;\n  display: inline-block;\n  width: 90px;\n}\n\nspan {\n  color: #e74c3c; /* Red color to highlight the data (or lack thereof) */\n  font-weight: bold;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "\nconst supplies = [\n  { id: 1, name: \"Markers\", category: \"Art\", location: \"Cabinet A\" },\n  { id: 2, name: \"Microscopes\", category: \"Science\", location: \"Under Lab Bench\" },\n  { id: 3, name: \"Soccer Balls\", location: \"Gym Closet\" }, // missing category\n  { id: 4, category: \"Art\", location: \"Cabinet B\" } // missing name\n];\n\n// --- Retrieval functions: get an item by index, id, and name ---\nconst getItemByIndex = (index) => {\n  return supplies[index];\n}\n\nconst getItemById = (id) => {\n  \n};\n\nconst getItemByName = (name) => {\n  \n}\n\n//DOM elements\nconst nameDisplay = document.getElementById(\"name-display\");\nconst catDisplay = document.getElementById(\"cat-display\");\nconst locDisplay = document.getElementById(\"loc-display\");\n\n// Calls to retrieval functions\nconst myItem = getItemByIndex(2);\n\n// Display its details on the screen\nnameDisplay.textContent = myItem.name;\ncatDisplay.textContent = myItem.category;\nlocDisplay.textContent = myItem.location;",
          "folderId": "0",
          "active": true
        }
