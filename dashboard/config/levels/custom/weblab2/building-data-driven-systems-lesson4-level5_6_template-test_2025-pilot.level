        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<link href=\"https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600&family=Quicksand:wght@400;600&display=swap\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"style.css\">\n\n<section class=\"dessert-card\">\n  <h2>Current Dessert</h2>\n  <p><strong>Name:</strong> <span id=\"dessertName\"></span></p>\n  <p><strong>Flavor:</strong> <span id=\"dessertFlavor\"></span></p>\n  <p><strong>Frozen?</strong> <span id=\"dessertFrozen\"></span></p>\n</section>\n\n<div class=\"controls\">\n  <button id=\"rename\">Rename to \"Cookie Sundae\"</button>\n  <button id=\"toggle-frozen\">Toggle Frozen Status</button>\n  <button id=\"recategorize\">Change Flavor (Bracket Notation)</button>\n</div>\n\n<script src=\"script.js\" defer></script>\n  ",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* Dessert Theme Styling */\nbody {\n  font-family: 'Quicksand', sans-serif;\n  background-color: #fff5f8; /* Light pink background */\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  height: 100vh;\n  margin: 0;\n  gap: 20px;\n}\n\n.dessert-card {\n  background-color: white;\n  border: 4px solid #f8a5c2; /* Darker pink border */\n  border-radius: 20px;\n  padding: 30px;\n  width: 300px;\n  box-shadow: 0 8px 16px rgba(246, 107, 157, 0.2);\n  text-align: center;\n}\n\nh2 {\n  font-family: 'Fredoka', sans-serif;\n  color: #c44569; /* Deep berry color */\n  margin-top: 0;\n  font-size: 2em;\n}\n\np {\n  color: #596275;\n  font-size: 1.1em;\n  margin: 15px 0;\n  border-bottom: 2px dashed #f1f2f6;\n  padding-bottom: 10px;\n}\n\nstrong {\n  color: #c44569;\n}\n\nspan {\n  font-weight: 600;\n  color: #303952;\n}\n\n/* Button Controls Styling */\n.controls {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  width: 300px;\n}\n\nbutton {\n  background-color: #f78fb3;\n  color: white;\n  border: none;\n  padding: 12px;\n  border-radius: 10px;\n  font-family: 'Quicksand', sans-serif;\n  font-weight: 600;\n  cursor: pointer;\n  transition: background-color 0.2s;\n  font-size: 0.95em;\n}\n\nbutton:hover {\n  background-color: #e66767;\n}",
          "folderId": "0",
