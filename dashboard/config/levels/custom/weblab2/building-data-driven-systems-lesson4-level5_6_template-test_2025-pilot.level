        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "// --- Parallel Arrays (Reference Data) ---\nconst dessertNames = [\"Brownie\", \"Cupcake\", \"Ice Cream\"];\nconst dessertFlavors = [\"Chocolate\", \"Vanilla\", \"Strawberry\"];\nconst dessertIsFrozen = [false, false, true];\n\n//Dessert object\n\n//Render function to display object properties\nconst render = () => {\n  const nameSpan = document.querySelector(\"#dessertName\");\n  const flavorSpan = document.querySelector(\"#dessertFlavor\");\n  const frozenSpan = document.querySelector(\"#dessertFrozen\");\n\n  nameSpan.textContent = \"\";\n  flavorSpan.textContent = \"\";\n\n  if (true) {\n    frozenSpan.textContent = \"Yes\";\n  } else {\n    frozenSpan.textContent = \"No\";\n  }\n};\n\nrender();",
          "folderId": "0",
          "active": true
