    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Undo with Filter Pills</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <div class=\"app-container\">\n    <header>\n      <h1>Shop Helper</h1>\n      <p>Filter items to find what you need.</p>\n    </header>\n\n    <div class=\"controls\">\n      <div class=\"filter-group\">\n        <button id=\"filterElecBtn\" class=\"btn filter-btn\">Electronics</button>\n        <button id=\"filterHomeBtn\" class=\"btn filter-btn\">Home</button>\n        <button id=\"filterCheapBtn\" class=\"btn filter-btn\">Under $50</button>\n      </div>\n      \n      <div class=\"action-group\">\n        <button id=\"undoBtn\" class=\"btn undo-btn\">Undo</button>\n        <button id=\"resetBtn\" class=\"btn reset-btn\">Reset All</button>\n      </div>\n    </div>\n\n    <div id=\"pillContainer\" class=\"pill-area\">\n      </div>\n\n    <div id=\"productContainer\" class=\"product-grid\">\n      </div>\n  </div>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "const products = [\n  { id: 1, name: \"Wireless Earbuds\", category: \"Electronics\", price: 45 },\n  { id: 2, name: \"Smart Speaker\", category: \"Electronics\", price: 89 },\n  { id: 3, name: \"Coffee Maker\", category: \"Home\", price: 35 },\n  { id: 4, name: \"Blender\", category: \"Home\", price: 60 },\n  { id: 5, name: \"Desk Lamp\", category: \"Home\", price: 25 },\n  { id: 6, name: \"Portable Charger\", category: \"Electronics\", price: 20 }\n];\n\n// STATE Variables\nlet currentProducts = products.slice(); \nlet activeFilters = [];\nlet historyStack = [];\n\n// DOM Elements\nconst productContainer = document.querySelector(\"#productContainer\");\nconst pillContainer = document.querySelector(\"#pillContainer\");\nconst undoBtn = document.querySelector(\"#undoBtn\");\nconst resetBtn = document.querySelector(\"#resetBtn\");\n\n// 1. Render Function\nconst updateUI = () => {\n  productContainer.innerHTML = \"\";\n  currentProducts.forEach(item => {\n    const card = document.createElement(\"div\");\n    card.className = \"product-card\";\n    card.innerHTML = `<span>${item.name}</span><span class=\"price\">$${item.price}</span>`;\n    productContainer.appendChild(card);\n  });\n\n  pillContainer.innerHTML = \"\";\n  activeFilters.forEach(text => {\n    const pill = document.createElement(\"span\");\n    pill.className = \"pill\";\n    pill.textContent = text;\n    pillContainer.appendChild(pill);\n  });\n};\n\n// 2. Filter Logic\nconst applyFilter = (filterFn, filterName) => {\n  \n  // Apply changes\n  currentProducts = currentProducts.filter(filterFn);\n  activeFilters.push(filterName);\n  \n  updateUI();\n};\n\n// 3. Event Listeners\ndocument.querySelector(\"#filterElecBtn\").addEventListener(\"click\", () => {\n  applyFilter(item => item.category === \"Electronics\", \"Electronics\");\n});\n\ndocument.querySelector(\"#filterHomeBtn\").addEventListener(\"click\", () => {\n  applyFilter(item => item.category === \"Home\", \"Home\");\n});\n\ndocument.querySelector(\"#filterCheapBtn\").addEventListener(\"click\", () => {\n  applyFilter(item => item.price < 50, \"Under $50\");\n});\n\n// Undo Button\nundoBtn.addEventListener(\"click\", () => {\n\n});\n\n// Reset Button\nresetBtn.addEventListener(\"click\", () => {\n  currentProducts = products.slice();\n  activeFilters = []; \n  historyStack = [];\n  updateUI();\n});\n\nupdateUI();",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n  background-color: #f4f4f9;\n  color: #333;\n  margin: 0;\n  display: flex;\n  justify-content: center;\n  padding: 20px;\n}\n\n.app-container {\n  background: white;\n  width: 100%;\n  max-width: 600px;\n  padding: 2rem;\n  border-radius: 12px;\n  box-shadow: 0 4px 15px rgba(0,0,0,0.1);\n}\n\nheader h1 { margin-top: 0; color: #2c3e50; }\n\n.controls {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: 1rem;\n  margin-bottom: 1rem;\n}\n\n.filter-group, .action-group {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n}\n\n.btn {\n  padding: 8px 14px;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  font-weight: 600;\n  font-size: 0.9rem;\n}\n\n.filter-btn { background-color: #e0e7ff; color: #3730a3; }\n.filter-btn:hover { background-color: #c7d2fe; }\n\n.undo-btn { background-color: #f59e0b; color: white; }\n.reset-btn { background-color: #ef4444; color: white; }\n\n/* Pill Styles */\n.pill-area {\n  display: flex;\n  gap: 8px;\n  margin-bottom: 1.5rem;\n  min-height: 30px; /* Space reserver */\n}\n\n.pill {\n  background-color: #3730a3;\n  color: white;\n  padding: 4px 12px;\n  border-radius: 16px;\n  font-size: 0.85rem;\n  display: flex;\n  align-items: center;\n  animation: fadeIn 0.3s ease;\n}\n\n@keyframes fadeIn {\n  from { opacity: 0; transform: translateY(-5px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n.product-grid { display: grid; gap: 10px; }\n\n.product-card {\n  display: flex;\n  justify-content: space-between;\n  padding: 12px;\n  background: #f8fafc;\n  border: 1px solid #e2e8f0;\n  border-radius: 8px;\n}\n\n.price { font-weight: bold; color: #059669; }",
          "folderId": "0",
          "active": true
        }
      },
