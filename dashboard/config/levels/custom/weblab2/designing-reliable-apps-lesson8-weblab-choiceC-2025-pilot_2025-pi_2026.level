  "user_id": 18762,
  "properties": {
    "display_name": "The Retry",
    "bubble_choice_description": "Wire up a \"Try Again\" button to the fetch function.",
    "thumbnail_url": "https://images.code.org/c0157e87655d0920cd8adfcb0714eb00-Pasted Graphic 1 2.png",
    "encrypted": "false",
    "submittable": "false",
