        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n<head>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <h1>Seasons!</h1>\n  <h5>Changing, Fleeting, Cycle</h5> \n\n<!-- Winter-->\n  <h2 class=\"winter\">Winter</h2>\n  <h5 class=\"winter\">arctic</h5>\n  <h5 class=\"winter\">cozy</h5>\n  <h5 class=\"winter\">enchanted</h5>\n  <h5 class=\"winter\">snowy</h5>\n  <h5 class=\"winter\">white</h5>\n  <img class=\"winter\" src=\"winter.jpg\"\n       alt=\"Winter woods\">\n\n  <p>from EpicV27 on Wikimedia Commons - GFDL</p>\n\n<!-- Spring-->\n  <h2 class=\"spring\">Spring</h2>\n  <h5 class=\"spring\">blooming</h5>\n  <h5 class=\"spring\">flourishing </h5>\n  <h5 class=\"spring\">invigorating</h5>\n  <h5 class=\"spring\">pretty</h5>\n  <h5 class=\"spring\">rainy</h5>\n  <img class=\"spring\" src=\"spring.jpg\"\n       alt=\"Spring Flowers\" >\n\n<p>from Pexels - CC0</p>\n\n  <!-- Summer-->\n  <h2 class=\"summer\">Summer</h2>\n  <h5 class=\"summer\">beautiful</h5>\n  <h5 class=\"summer\">bright</h5>\n  <h5 class=\"summer\">cheerful</h5>\n  <h5 class=\"summer\">hot</h5>\n  <h5 class=\"summer\">sunny</h5>\n  <img  class=\"summer\" src=\"summer.jpg\"\n       alt=\"Summer Beach\" >\n\n<p>from Rukiasan on StockKite - CC0</p>\n\n  <!-- Autumn-->\n  <h2 class=\"autumn\">Autumn</h2>\n  <h5 class=\"autumn\">brisk</h5>\n  <h5 class=\"autumn\">changing</h5>\n  <h5 class=\"autumn\">colorful</h5>\n  <h5 class=\"autumn\">crisp </h5>\n  <h5 class=\"autumn\">vibrant</h5>\n  <img class=\"autumn\" class=\"autumn\" src=\"autumn.jpeg\" \n       alt=\"Bench in fall\" >\n\n<p>from Pexels - CC0</p>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body{\n  text-align: center;\n  background-color: gray;\n}\nimg {\n  width: 500px;\n  border-color:black;\n  border-style: ridge;\n  border-width: 5px;\n}\nh1 {\n  font-size: 50px;\n}\nh2 {\n  font-size: 40px;\n}\nh5 {\n  font-size: 15px;\n} \n\n.winter {\n  color: lightskyblue;\n  border-color: lightskyblue;\n} \n\n.spring {\n  color: lightgreen;\n  border-color: lightgreen;\n}\n\n.autunm {\n  color: firebrick;\n  border-color: firebrick;\n}\n\n.summer {\n  color: gold;\n  border-color: gold;\n}\n\n",
          "folderId": "0",
          "active": true
