  "user_id": 22366,
  "properties": {
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>StarSage: Zodiac Fortune Teller</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n    <script defer src=\"script.js\"></script>\n  </head>\n  <body>\n    <h1 class=\"title\">StarSage: Zodiac Fortune Teller</h1>\n    <main class=\"container\">\n      <section class=\"left\">\n        <img id=\"main-img\" src=\"main-image.png\" alt=\"Crystal ball illustration\" />\n      </section>\n      <section class=\"right\">\n        <div id=\"output\" class=\"output\" aria-live=\"polite\">Choose your sign to reveal today's fortune.</div>\n        <div class=\"buttons\">\n          <button id=\"aries-btn\" type=\"button\">Aries</button>\n          <button id=\"taurus-btn\" type=\"button\">Taurus</button>\n          <button id=\"gemini-btn\" type=\"button\">Gemini</button>\n          <button id=\"cancer-btn\" type=\"button\">Cancer</button>\n          <button id=\"leo-btn\" type=\"button\">Leo</button>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// SELECTORS and LISTENERS: connect user actions (clicks) to handlers for the Aries button\ndocument.querySelector('#aries-btn').addEventListener('click', () => {\n  // UI CHANGE: update text for Aries\n  document.querySelector('#output').textContent = 'Aries fortune: A bold choice brings a pleasant surprise. Start small, but start today.';\n});\n\n// TODO: Attach an event listener to the Taurus button\n\n  // TODO: update text for Taurus\n\n// TODO: Attach an event listener to the Gemini button\n\n  // TODO: update text for Gemini\n\n// TODO: Attach an event listener to the Cancer button\n\n  // TODO: update text for Cancer\n\n// TODO: Attach an event listener to the Leo button\n\n  // TODO: update text for Leo\n\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "* { box-sizing: border-box; }\nhtml, body { height: 100%; }\nbody { margin: 0; font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; background: #f3e8ff; color: #222; }\n\n.title { text-align: center; margin: 16px 0 0; font-size: 1.75rem; letter-spacing: 0.5px; }\n\n.container { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding: 24px; max-width: 1000px; margin: 0 auto; }\n.left { background: #fff; border: 2px solid #ddd; border-radius: 12px; padding: 16px; display: flex; align-items: center; justify-content: center; overflow: hidden; }\n#main-img { display: block; max-width: 100%; height: auto; border-radius: 8px; object-fit: contain; }\n\n.right { display: flex; flex-direction: column; gap: 24px; }\n.output { min-height: 120px; border: 2px dashed #9aa4b2; border-radius: 12px; padding: 16px; background: #fff; font-size: 1.1rem; line-height: 1.4; }\n\n.buttons { display: flex; flex-direction: column; gap: 12px; width: 240px; margin-inline: auto; }\n.buttons button { padding: 12px 16px; font-size: 1rem; border-radius: 12px; border: 2px solid #333; background: #fff; cursor: pointer; }\n.buttons button:hover { background: #f0f4ff; }\n.buttons button:active { transform: translateY(1px); }\n\n@media (max-width: 800px) {\n  .container { grid-template-columns: 1fr; }\n  .buttons { width: 100%; }\n}",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "main-image.png",
          "language": "png",
          "contents": "",
          "folderId": "0",
          "url": "/level_starter_assets/ai-and-algorithmic-decisions-lesson2-level5-choiceb-test-2025/uuid/77a6944a-4430-4099-8ec8-f46f4b956351.png",
          "type": "starter",
