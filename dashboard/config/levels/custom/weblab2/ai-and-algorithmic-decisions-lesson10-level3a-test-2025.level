      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <meta charset=\"utf-8\">\n    <title>Fee Waiver – Eligibility</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    <h1>Fee Waiver Checker</h1>\n\n    <label>\n      Income ($):\n      <input id=\"income\" type=\"number\" min=\"0\" value=\"44000\">\n    </label>\n\n    <label>\n      Family size:\n      <input id=\"familySize\" type=\"number\" min=\"1\" value=\"4\">\n    </label>\n\n    <label>\n      <input id=\"feesDue\" type=\"checkbox\">\n      Owes past-due fees\n    </label>\n\n    <button id=\"runBtn\">Run</button>\n\n    <p id=\"message\">—</p>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: sans-serif;\n  text-align: center;\n  padding: 2rem;\n  background-color: #f9f9f9;\n}\n\nh1 {\n  margin-bottom: 1rem;\n}\n\nlabel {\n  display: block;\n  margin: 0.5rem 0;\n}\n\ninput[type=\"number\"] {\n  padding: 0.4rem;\n  margin-left: 0.5rem;\n}\n\nbutton {\n  margin-top: 1rem;\n  padding: 0.5rem 1rem;\n  border: 1px solid #ccc;\n  border-radius: 6px;\n  background-color: #f2f2f2;\n  cursor: pointer;\n}\n\nbutton:hover {\n  background-color: #e2e2e2;\n}\n\n#message {\n  margin-top: 1rem;\n  font-weight: bold;\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const income = document.getElementById(\"income\");\nconst familySize = document.getElementById(\"familySize\");\nconst feesDue = document.getElementById(\"feesDue\");\nconst message = document.getElementById(\"message\");\nconst runBtn = document.getElementById(\"runBtn\");\n\nconst eligible = () => {\n  // Use these variables in your logic\n  const incomeValue = Number(income.value);\n  const familyValue = Number(familySize.value);\n  const owesFees = feesDue.checked;\n\n\n\n  \n}\n\nrunBtn.addEventListener(\"click\", eligible);\n",
          "folderId": "0",
          "active": true
        }
      },
