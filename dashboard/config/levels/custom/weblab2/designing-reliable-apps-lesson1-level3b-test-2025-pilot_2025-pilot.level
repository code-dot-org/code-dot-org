          "contents": "[\n  {\n    \"_id\": 7848,\n    \"films\": [\n      \"Rudyard Kipling's The Jungle Book\"\n    ],\n    \"shortFilms\": [],\n    \"tvShows\": [],\n    \"videoGames\": [],\n    \"parkAttractions\": [],\n    \"allies\": [],\n    \"enemies\": [],\n    \"name\": \"Baloo\",\n    \"imageUrl\": \"https://static.wikia.nocookie.net/disney/images/2/2b/Real_Baloo.jpg\",\n    \"url\": \"https://api.disneyapi.dev/characters/7848\"\n  },\n  {\n    \"_id\": 7849,\n    \"films\": [],\n    \"shortFilms\": [],\n    \"tvShows\": [\n      \"TaleSpin\",\n      \"Chibi Tiny Tales\"\n    ],\n    \"videoGames\": [\n      \"TaleSpin (NES video game)\",\n      \"TaleSpin (Sega Genesis Video Game)\",\n      \"Disney Emoji Blitz\",\n      \"Disney Mirrorverse\"\n    ],\n    \"parkAttractions\": [],\n    \"allies\": [],\n    \"enemies\": [],\n    \"name\": \"Baloo\",\n    \"imageUrl\": \"https://static.wikia.nocookie.net/disney/images/4/41/Profile-_TS_Baloo.jpg\",\n    \"url\": \"https://api.disneyapi.dev/characters/7849\"\n  },\n  {\n    \"_id\": 7850,\n    \"films\": [\n      \"The Jungle Book (2016 film)\",\n      \"The Jungle Book 2 (live-action film)\",\n      \"Chip 'n Dale Rescue Rangers (film)\"\n    ],\n    \"shortFilms\": [],\n    \"tvShows\": [],\n    \"videoGames\": [\n      \"The Jungle Book: Mowgli's Run\",\n      \"Disney Crossy Road\"\n    ],\n    \"parkAttractions\": [],\n    \"allies\": [],\n    \"enemies\": [],\n    \"name\": \"Baloo\",\n    \"imageUrl\": \"https://static.wikia.nocookie.net/disney/images/9/9f/The_Jungle_Book_Textless_Character_Poster_02.jpg\",\n    \"url\": \"https://api.disneyapi.dev/characters/7850\"\n  },\n  {\n    \"_id\": 7851,\n    \"films\": [\n      \"The Jungle Book: Mowgli's Story\"\n    ],\n    \"shortFilms\": [],\n    \"tvShows\": [],\n    \"videoGames\": [],\n    \"parkAttractions\": [],\n    \"allies\": [],\n    \"enemies\": [],\n    \"name\": \"Baloo\",\n    \"imageUrl\": \"https://static.wikia.nocookie.net/disney/images/5/59/The_Jungle_Book_-_Mowgli%27s_Story_-_Baloo.jpg\",\n    \"url\": \"https://api.disneyapi.dev/characters/7851\"\n  }\n]",
