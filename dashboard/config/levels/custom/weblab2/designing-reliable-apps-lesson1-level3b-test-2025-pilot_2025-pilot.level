        "5": {
          "id": "5",
          "name": "documentation.md",
          "language": "md",
          "contents": "| Name | Description | Type |\n| :--- | :--- | :--- |\n| **_id** | The unique identifier for the character. | integer |\n| **url** | The API endpoint URL for the character. | string |\n| **name** | The name of the character. | string |\n| **sourceUrl** | The link to the character's source/fandom page. | string |\n| **films** | A list of films the character has appeared in. | list [string] |\n| **shortFilms** | A list of short films the character has appeared in. | list [string] |\n| **tvShows** | A list of TV shows the character has appeared in. | list [string] |\n| **videoGames** | A list of video games the character has appeared in. | list [string] |\n| **alignment** | The character's affiliation (e.g., hero or villain). | string |\n| **parkAttractions** | Disney park attractions featuring the character. | list [string] |\n| **allies** | A list of the character's known allies. | list [string] |\n| **enemies** | A list of the character's known enemies. | list [string] |",
          "folderId": "0",
          "active": false
