      "files": {
        "1": {
          "id": "1",
          "name": "script.js",
          "contents": "// Select elements\nconst lengthInput = document.getElementById(\"passwordLengthInput\");\nconst generateButton = document.getElementById(\"generateButton\");\nconst passwordDisplay = document.getElementById(\"passwordDisplay\");\nconst lengthMessage = document.getElementById(\"lengthMessage\");\n\n// Arrow function to generate a random password\nconst generatePassword = () => {\n  passwordDisplay.textContent = \"\";\n  lengthMessage.textContent = \"\";\n\n  const length = Number(lengthInput.value);\n  const chars = \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789\";\n\n  let password = \"\";\n\n  for (let i = 0; i < length - 1; i++) {\n    const randomIndex = Math.floor(Math.random() * chars.length);\n    password += chars[randomIndex];\n  }\n\n  passwordDisplay.textContent = password;\n\n  // Show expected vs. actual length\n  lengthMessage.textContent = \"Expected length: \" + length + \" | Actual length: \" + password.length;\n};\n\n// Add event listener for button\ngenerateButton.addEventListener(\"click\", generatePassword);\n",
          "folderId": "0",
          "active": true
        },
        "2": {
          "id": "2",
          "name": "index.html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\" />\n    <title>Password Generator</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <div class=\"phone\">\n      <header>\n        <h1>Password Generator</h1>\n        <p>Create a password with the number of characters you enter.</p>\n      </header>\n\n      <main>\n        <section class=\"generator\">\n          <label for=\"passwordLengthInput\">Password length</label>\n          <input id=\"passwordLengthInput\" type=\"number\" min=\"1\" max=\"20\" value=\"8\" />\n\n          <button id=\"generateButton\">Generate Password</button>\n\n          <div class=\"output\">\n            <p class=\"label\">Your password</p>\n            <div id=\"passwordDisplay\" class=\"password-box\"></div>\n            <p id=\"lengthMessage\" class=\"status\"></p>\n          </div>\n        </section>\n      </main>\n    </div>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": "* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nbody {\n  font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", \"Segoe UI\", sans-serif;\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: linear-gradient(160deg, #1c1c2e 0%, #2d2d44 100%);\n  padding: 20px;\n}\n\n.phone {\n  width: 100%;\n  max-width: 390px;\n  background: rgba(255, 255, 255, 0.06);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  border-radius: 36px;\n  padding: 32px 24px;\n  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);\n}\n\nheader h1 {\n  font-size: 28px;\n  font-weight: 700;\n  color: #ffffff;\n  letter-spacing: -0.5px;\n}\n\nheader p {\n  margin-top: 8px;\n  font-size: 15px;\n  color: rgba(235, 235, 245, 0.6);\n  line-height: 1.4;\n}\n\n.generator {\n  margin-top: 28px;\n}\n\nlabel {\n  display: block;\n  font-size: 13px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  color: rgba(235, 235, 245, 0.5);\n  margin-bottom: 10px;\n}\n\n#passwordLengthInput {\n  width: 100%;\n  font-size: 17px;\n  color: #ffffff;\n  background: rgba(118, 118, 128, 0.24);\n  border: none;\n  border-radius: 14px;\n  padding: 14px 16px;\n  outline: none;\n}\n\n#passwordLengthInput:focus {\n  box-shadow: 0 0 0 2px #0a84ff;\n}\n\n#generateButton {\n  width: 100%;\n  margin-top: 20px;\n  font-size: 17px;\n  font-weight: 600;\n  color: #ffffff;\n  background: #0a84ff;\n  border: none;\n  border-radius: 14px;\n  padding: 16px;\n  cursor: pointer;\n  transition: transform 0.1s ease, background 0.2s ease;\n}\n\n#generateButton:hover {\n  background: #0a7aff;\n}\n\n#generateButton:active {\n  transform: scale(0.97);\n}\n\n.output {\n  margin-top: 28px;\n}\n\n.output .label {\n  font-size: 13px;\n  font-weight: 600;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n  color: rgba(235, 235, 245, 0.5);\n  margin-bottom: 10px;\n}\n\n.password-box {\n  min-height: 56px;\n  display: flex;\n  align-items: center;\n  font-family: \"SF Mono\", ui-monospace, monospace;\n  font-size: 19px;\n  color: #30d158;\n  word-break: break-all;\n  background: rgba(118, 118, 128, 0.24);\n  border-radius: 14px;\n  padding: 16px;\n}\n\n.status {\n  margin-top: 12px;\n  font-size: 13px;\n  color: rgba(235, 235, 245, 0.6);\n}\n",
