<Weblab2>
  <config><![CDATA[{
  "published": true,
  "game_id": 74,
  "created_at": "2026-07-01T20:46:35.000Z",
  "level_num": "custom",
  "user_id": 18762,
  "properties": {
    "start_sources": {
