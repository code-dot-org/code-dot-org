<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-11-03T04:26:50.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": "true",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "script.js",
          "contents": "'use strict';\n\n/* ------------------------------------------------------------------ *\n * Settings\n * ------------------------------------------------------------------ */\n\nconst CONFIG = {\n  // Set to false to skip the intro page.\n  startWithIntro: true,\n  // Different headline and button combinations students must try on each website.\n  combosNeeded: 3,\n  // Time the cursor spends gliding to the button, in milliseconds.\n  glideMs: 900,\n  pressMs: 200,\n};\n\n/* ------------------------------------------------------------------ *\n * Copy shared by the whole widget\n * ------------------------------------------------------------------ */\n\nconst COPY = {\n  errorBanner: 'Something went wrong loading this activity. Try refreshing the page.',\n\n  resultEmpty: 'Try a label. The cursor will press the button.',\n  triedMark: 'tried',\n  // A small checklist says what is left before the next website\n  goalsLeadMove: 'To move on:',\n  goalsLeadFinish: 'To finish:',\n  goalCombos: (tried, needed) => (tried >= needed\n    ? `${tried} combinations tried`\n    : `Try ${needed} combinations: ${tried} of ${needed}`),\n  goalStrong: (reached) => (reached ? 'Built a Strong website' : 'Build a Strong website'),\n  goalDone: 'done',\n  goalNotYet: 'not yet',\n  siteCount: (number, total) => `Website ${number} of ${total}`,\n  nextWebsite: 'Next website',\n  finishLabel: 'Finish',\n\n  checkPurpose: 'What it’s for',\n  checkVerb: 'Action word',\n  checkNext: 'Next step',\n  yes: 'Yes',\n  notYet: 'Not yet',\n  visitorThinks: 'A visitor thinks:',\n  friendlyNote: 'Friendly note:',\n\n  // Strength is how many of the three checks say Yes\n  strengthWords: ['Not clear yet', 'Weak', 'Getting stronger', 'Strong'],\n  strengthLabel: (word, count, total) => `Strength: ${word}. ${count} of ${total} checks.`,\n\n  announceHeadline: (headline, guess, strength) => `Headline: ${headline}. A visitor thinks: ${guess} ${strength}`,\n  announceLabel: (label, note, title, line, strength) => `Button label: ${label}. ${note} ${title} ${line} ${strength}`,\n  announceSite: (count, headline, label) => `${count}. Headline: ${headline}. Button label: ${label}.`,\n  announceWebsiteDone: 'You tried three combinations and built a Strong website. Press Next website.',\n  announceLastDone: 'You tried three combinations and built a Strong website. Press Finish.',\n  announceNeedStrong: 'You tried three combinations. Now build a Strong website.',\n};\n\n/* ------------------------------------------------------------------ *\n * Copy for the sample page (save the park)\n * ------------------------------------------------------------------ */\n\nconst START_HEADLINE = 'welcome';\nconst START_LABEL = 'click';\n\nconst WELCOME = {\n  id: 'welcome',\n  text: 'Welcome!',\n  purpose: false,\n  guess: 'Welcome to what? I can’t tell what this is for.',\n};\n\n// Button labels that work the same on every page\nconst GENERIC = {\n  click: {\n    id: 'click',\n    text: 'Click here',\n    verb: false,\n    next: false,\n    note: 'Visitors can’t tell what happens. Try an action word.',\n    resultTitle: 'A new page opens.',\n    resultLine: 'A visitor wonders: What is this?',\n  },\n  learn: {\n    id: 'learn',\n    text: 'Learn more',\n    verb: true,\n    next: false,\n    note: 'Learn is an action word. But learn what? Name the next step.',\n    resultTitle: 'An info page opens.',\n    resultLine: 'A visitor wonders: What do I do with it?',\n  },\n  submit: {\n    id: 'submit',\n    text: 'Submit',\n    verb: true,\n    next: false,\n    note: 'Submit is an action word. But submit what? Name the next step.',\n    resultTitle: 'Something is sent.',\n    resultLine: 'A visitor wonders: What did I just send?',\n  },\n};\n\nconst PAGES = [\n  {\n    id: 'park',\n    url: 'saveparks.web',\n    theme: 'park',\n    headlines: [\n      {\n        id: 'belongs',\n        text: 'Maple Park belongs to everyone',\n        purpose: false,\n        guess: 'This is about a park. What am I supposed to do?',\n      },\n      WELCOME,\n      {\n        id: 'save',\n        text: 'Help save Maple Park',\n        purpose: true,\n        guess: 'This site is about saving a park, and I can help.',\n      },\n    ],\n    labels: [\n      GENERIC.learn,\n      {\n        id: 'sign',\n        text: 'Sign the petition',\n        verb: true,\n        next: true,\n        note: '“Sign” says what to do. “The petition” says what is next.',\n        resultTitle: 'A petition form opens.',\n        resultLine: 'A visitor adds their name to save the park.',\n      },\n      GENERIC.click,\n      GENERIC.submit,\n      {\n        id: 'cleanup',\n        text: 'Come to the cleanup',\n        verb: true,\n        next: true,\n        note: '“Come” says what to do. “The cleanup” says what is next.',\n        resultTitle: 'A cleanup sign-up opens.',\n        resultLine: 'A visitor picks a day to help.',\n      },\n    ],\n  },\n  {\n    id: 'club',\n    url: 'roboticsclub.web',\n    theme: 'club',\n    headlines: [\n      WELCOME,\n      {\n        id: 'ideas',\n        text: 'Big ideas get built',\n        purpose: false,\n        guess: 'That sounds exciting. But what is it, and what do I do?',\n      },\n      {\n        id: 'join',\n        text: 'Join the Robotics Club',\n        purpose: true,\n        guess: 'This is a robotics club, and I can join it.',\n      },\n    ],\n    labels: [\n      GENERIC.click,\n      {\n        id: 'find',\n        text: 'Find my club',\n        verb: true,\n        next: true,\n        note: '“Find” says what to do. “My club” says what is next.',\n        resultTitle: 'A club finder opens.',\n        resultLine: 'A visitor sees which club meets today.',\n      },\n      GENERIC.learn,\n      {\n        id: 'joinclub',\n        text: 'Join the club',\n        verb: true,\n        next: true,\n        note: '“Join” says what to do. “The club” says what is next.',\n        resultTitle: 'A sign-up form opens.',\n        resultLine: 'A visitor adds their name to the club list.',\n      },\n      GENERIC.submit,\n    ],\n  },\n  {\n    id: 'art',\n    url: 'artshow.web',\n    theme: 'art',\n    headlines: [\n      {\n        id: 'feelings',\n        text: 'Colors and feelings',\n        purpose: false,\n        guess: 'That sounds artistic. But what is this site for?',\n      },\n      WELCOME,\n      {\n        id: 'share',\n        text: 'Share your art with the school',\n        purpose: true,\n        guess: 'This is a place to share art, and I can add mine.',\n      },\n    ],\n    labels: [\n      GENERIC.submit,\n      {\n        id: 'upload',\n        text: 'Upload my art',\n        verb: true,\n        next: true,\n        note: '“Upload” says what to do. “My art” says what is next.',\n        resultTitle: 'An upload form opens.',\n        resultLine: 'A visitor adds a picture of their art.',\n      },\n      GENERIC.click,\n      {\n        id: 'explore',\n        text: 'Explore',\n        verb: true,\n        next: false,\n        note: 'Explore is an action word. But explore what? Name the next step.',\n        resultTitle: 'A page of artwork opens.',\n        resultLine: 'A visitor wonders: What do I do here?',\n      },\n      {\n        id: 'gallery',\n        text: 'See the gallery',\n        verb: true,\n        next: true,\n        note: '“See” says what to do. “The gallery” says what is next.',\n        resultTitle: 'The gallery opens.',\n        resultLine: 'A visitor scrolls through student art.',\n      },\n    ],\n  },\n];\n\n/* ------------------------------------------------------------------ *\n * State and constants\n * ------------------------------------------------------------------ */\n\nconst SVG_NS = 'http://www.w3.org/2000/svg';\n\nconst state = {\n  page: 0,\n  pages: PAGES.map(() => ({\n    headline: START_HEADLINE,\n    label: START_LABEL,\n    tried: new Set(),\n    combos: new Set(),\n    headlinePicked: false,\n    reachedStrong: false,\n  })),\n  completed: false,\n  timers: [],\n};\n\nconst els = {};\n\n/* ------------------------------------------------------------------ *\n * Helpers\n * ------------------------------------------------------------------ */\n\nfunction el(tag, className, text) {\n  const node = document.createElement(tag);\n  if (className) node.className = className;\n  if (text !== undefined) node.textContent = text;\n  return node;\n}\n\nfunction icon(id) {\n  const svg = document.createElementNS(SVG_NS, 'svg');\n  svg.setAttribute('class', 'icon');\n  svg.setAttribute('aria-hidden', 'true');\n  svg.setAttribute('focusable', 'false');\n  const use = document.createElementNS(SVG_NS, 'use');\n  use.setAttribute('href', `#${id}`);\n  svg.append(use);\n  return svg;\n}\n\nfunction pageData() {\n  return PAGES[state.page];\n}\n\nfunction pageState(index) {\n  return state.pages[index === undefined ? state.page : index];\n}\n\nfunction headlineData() {\n  return pageData().headlines.find((item) => item.id === pageState().headline);\n}\n\nfunction labelData() {\n  return pageData().labels.find((item) => item.id === pageState().label);\n}\n\nfunction prefersReducedMotion() {\n  return window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n}\n\nfunction announce(message) {\n  els.announcer.textContent = '';\n  // A short delay makes repeated messages get read again\n  window.setTimeout(() => { els.announcer.textContent = message; }, 30);\n}\n\nfunction clearTimers() {\n  state.timers.forEach((id) => window.clearTimeout(id));\n  state.timers = [];\n}\n\nfunction later(fn, ms) {\n  state.timers.push(window.setTimeout(fn, ms));\n}\n\nfunction strength() {\n  const label = labelData();\n  return (headlineData().purpose ? 1 : 0) + (label.verb ? 1 : 0) + (label.next ? 1 : 0);\n}\n\nfunction strengthText() {\n  const count = strength();\n  return COPY.strengthLabel(COPY.strengthWords[count], count, 3);\n}\n\n// A combination is one headline with one button label. The starting page does not count.\nfunction noteCombo() {\n  const current = pageState();\n  if (current.headline === START_HEADLINE && current.label === START_LABEL) return;\n  current.combos.add(`${current.headline}|${current.label}`);\n}\n\n// A website is done after enough combinations, a headline and a label picked,\n// and a Strong website built at least once\nfunction isPageDone(index) {\n  const current = pageState(index);\n  return current.combos.size >= CONFIG.combosNeeded\n    && current.headlinePicked\n    && current.tried.size > 0\n    && current.reachedStrong;\n}\n\nfunction combosMet() {\n  return pageState().combos.size >= CONFIG.combosNeeded;\n}\n\n// Remember that a Strong website was built, even if the student changes it afterward\nfunction noteStrong() {\n  if (strength() === 3) pageState().reachedStrong = true;\n}\n\nfunction isLastPage() {\n  return state.page === PAGES.length - 1;\n}\n\n/* ------------------------------------------------------------------ *\n * Option chips (headline and button label)\n * ------------------------------------------------------------------ */\n\nfunction renderHeadlines() {\n  els.headlines.replaceChildren();\n  pageData().headlines.forEach((item) => {\n    const chip = el('button', 'chip chip-small', item.text);\n    chip.type = 'button';\n    chip.dataset.id = item.id;\n    chip.setAttribute('aria-pressed', String(item.id === pageState().headline));\n    els.headlines.append(chip);\n  });\n}\n\nfunction renderLabels() {\n  els.labels.replaceChildren();\n  pageData().labels.forEach((item) => {\n    const chip = el('button', 'chip chip-small');\n    chip.type = 'button';\n    chip.dataset.id = item.id;\n    chip.setAttribute('aria-pressed', String(item.id === pageState().label));\n    if (pageState().tried.has(item.id)) {\n      chip.append(icon('icon-check'), el('span', '', item.text), el('span', 'visually-hidden', ` (${COPY.triedMark})`));\n    } else {\n      chip.append(el('span', '', item.text));\n    }\n    els.labels.append(chip);\n  });\n}\n\n/* ------------------------------------------------------------------ *\n * The sample page and the feedback strip\n * ------------------------------------------------------------------ */\n\nfunction renderSite() {\n  els.siteCount.textContent = COPY.siteCount(state.page + 1, PAGES.length);\n  els.siteUrl.textContent = pageData().url;\n  els.siteBody.dataset.theme = pageData().theme;\n  els.siteHeadline.textContent = headlineData().text;\n  els.siteButton.textContent = labelData().text;\n}\n\nfunction checkRow(tagKey, text, yes) {\n  const row = el('li', 'check');\n  const tag = el('span', 'part-tag', text);\n  tag.dataset.part = tagKey;\n  const status = el('span', yes ? 'check-status is-yes' : 'check-status is-not-yet');\n  status.append(icon(yes ? 'icon-check' : 'icon-missed'), el('span', '', yes ? COPY.yes : COPY.notYet));\n  row.append(tag, status);\n  return row;\n}\n\nfunction noteWithLead(node, lead, text) {\n  node.replaceChildren(el('strong', '', lead), document.createTextNode(` ${text}`));\n}\n\nfunction renderReport() {\n  const headline = headlineData();\n  const label = labelData();\n\n  els.reportHeadline.textContent = `“${headline.text}”`;\n  els.reportButton.textContent = `“${label.text}”`;\n\n  els.checksHeadline.replaceChildren(checkRow('purpose', COPY.checkPurpose, headline.purpose));\n  els.checksButton.replaceChildren(\n    checkRow('verb', COPY.checkVerb, label.verb),\n    checkRow('next', COPY.checkNext, label.next)\n  );\n  noteWithLead(els.noteHeadline, COPY.visitorThinks, headline.guess);\n  noteWithLead(els.noteButton, COPY.friendlyNote, label.note);\n\n  const count = strength();\n  els.meter.dataset.level = String(count);\n  els.meter.setAttribute('aria-label', strengthText());\n  els.meterWord.textContent = COPY.strengthWords[count];\n}\n\nfunction goalItem(done, text) {\n  const item = el('li', done ? 'goal is-done' : 'goal');\n  item.append(\n    icon(done ? 'icon-check' : 'icon-open'),\n    el('span', '', text),\n    el('span', 'visually-hidden', ` (${done ? COPY.goalDone : COPY.goalNotYet})`)\n  );\n  return item;\n}\n\nfunction renderProgress() {\n  const current = pageState();\n  const goals = el('ul', 'goals');\n  goals.append(\n    goalItem(combosMet(), COPY.goalCombos(current.combos.size, CONFIG.combosNeeded)),\n    goalItem(current.reachedStrong, COPY.goalStrong(current.reachedStrong))\n  );\n  els.progress.replaceChildren(\n    el('strong', '', isLastPage() ? COPY.goalsLeadFinish : COPY.goalsLeadMove),\n    goals\n  );\n\n  // The button to move on arrives once both goals are met\n  els.advance.hidden = !isPageDone(state.page);\n  els.advance.textContent = isLastPage() ? COPY.finishLabel : COPY.nextWebsite;\n}\n\n/* ------------------------------------------------------------------ *\n * The cursor glides to the button and opens a small result card\n * ------------------------------------------------------------------ */\n\nfunction closeResult() {\n  els.result.dataset.open = 'false';\n}\n\nfunction openResult() {\n  const label = labelData();\n  els.resultTitle.textContent = label.resultTitle;\n  els.resultLine.textContent = label.resultLine;\n  els.result.dataset.open = 'true';\n}\n\nfunction placeCursor(x, y) {\n  els.cursor.style.setProperty('--x', `${Math.round(x)}px`);\n  els.cursor.style.setProperty('--y', `${Math.round(y)}px`);\n}\n\n// A quick highlight points back to the part of the page the student just changed\nfunction flash(node) {\n  node.classList.remove('flash');\n  // Reading the layout restarts the animation when the same part changes twice\n  node.getBoundingClientRect();\n  node.classList.add('flash');\n  window.setTimeout(() => node.classList.remove('flash'), 800);\n}\n\nfunction playCursor() {\n  clearTimers();\n  closeResult();\n  els.siteButton.classList.remove('is-pressed');\n\n  els.cursor.classList.add('is-active');\n  const body = els.siteBody.getBoundingClientRect();\n  const button = els.siteButton.getBoundingClientRect();\n  // Land near the button's lower right corner so the label stays readable\n  const endX = button.left - body.left + button.width * 0.82;\n  const endY = button.top - body.top + button.height * 0.7;\n\n  if (prefersReducedMotion()) {\n    placeCursor(endX, endY);\n    openResult();\n    return;\n  }\n\n  // Start away from the button, then glide to it\n  els.cursor.classList.add('is-reset');\n  placeCursor(body.width - 40, body.height - 48);\n  // Force the browser to apply the start position before the glide\n  els.cursor.getBoundingClientRect();\n  els.cursor.classList.remove('is-reset');\n  placeCursor(endX, endY);\n\n  later(() => els.siteButton.classList.add('is-pressed'), CONFIG.glideMs);\n  later(() => {\n    els.siteButton.classList.remove('is-pressed');\n    openResult();\n  }, CONFIG.glideMs + CONFIG.pressMs);\n}\n\n/* ------------------------------------------------------------------ *\n * Student choices\n * ------------------------------------------------------------------ */\n\nfunction announceProgress(message, wasDone, wasCombosMet) {\n  let text = message;\n  if (!wasDone && isPageDone(state.page)) {\n    text += ` ${isLastPage() ? COPY.announceLastDone : COPY.announceWebsiteDone}`;\n  } else if (!wasCombosMet && combosMet() && !pageState().reachedStrong) {\n    text += ` ${COPY.announceNeedStrong}`;\n  }\n  announce(text);\n}\n\nfunction pickHeadline(id) {\n  const current = pageState();\n  if (id === current.headline && current.headlinePicked) return;\n  const wasDone = isPageDone(state.page);\n  const wasCombosMet = combosMet();\n  current.headline = id;\n  current.headlinePicked = true;\n  noteCombo();\n  noteStrong();\n  renderHeadlines();\n  renderSite();\n  flash(els.siteHeadline);\n  renderReport();\n  renderProgress();\n  const data = headlineData();\n  announceProgress(COPY.announceHeadline(data.text, data.guess, strengthText()), wasDone, wasCombosMet);\n}\n\nfunction pickLabel(id) {\n  const current = pageState();\n  const wasDone = isPageDone(state.page);\n  const wasCombosMet = combosMet();\n  current.label = id;\n  if (id !== START_LABEL) current.tried.add(id);\n  noteCombo();\n  noteStrong();\n  renderLabels();\n  renderSite();\n  flash(els.siteButton);\n  renderReport();\n  renderProgress();\n  playCursor();\n  const data = labelData();\n  announceProgress(\n    COPY.announceLabel(data.text, data.note, data.resultTitle, data.resultLine, strengthText()),\n    wasDone,\n    wasCombosMet\n  );\n}\n\n// Move on to the next website. On the last one this finishes the activity.\nfunction advance() {\n  if (!isPageDone(state.page)) return;\n  if (isLastPage()) {\n    finish();\n    return;\n  }\n  clearTimers();\n  closeResult();\n  els.cursor.classList.remove('is-active');\n  state.page += 1;\n  renderAll();\n  const first = els.headlines.querySelector('.chip');\n  if (first) first.focus();\n  announce(COPY.announceSite(COPY.siteCount(state.page + 1, PAGES.length), headlineData().text, labelData().text));\n}\n\n/* ------------------------------------------------------------------ *\n * Finish and the takeaway page\n * ------------------------------------------------------------------ */\n\nfunction markComplete() {\n  if (state.completed) return;\n  state.completed = true;\n  // Completion is the only thing recorded. Hook this up to the level's completion call.\n  try {\n    document.dispatchEvent(new CustomEvent('widget:complete'));\n    if (window.parent && window.parent !== window) {\n      window.parent.postMessage({ type: 'widget-complete' }, '*');\n    }\n  } catch (error) {\n    // Completion is best effort and must never break the activity\n  }\n}\n\nfunction finish() {\n  clearTimers();\n  markComplete();\n  els.widget.dataset.stage = 'done';\n  els.takeaway.focus();\n}\n\n/* ------------------------------------------------------------------ *\n * Start up\n * ------------------------------------------------------------------ */\n\nfunction renderAll() {\n  renderHeadlines();\n  renderLabels();\n  renderSite();\n  renderReport();\n  renderProgress();\n  els.resultEmpty.textContent = COPY.resultEmpty;\n}\n\nfunction cacheElements() {\n  const ids = {\n    widget: 'widget',\n    errorBanner: 'error-banner',\n    announcer: 'announcer',\n    introStart: 'intro-start',\n    siteCount: 'site-count',\n    siteUrl: 'site-url',\n    siteBody: 'site-body',\n    siteHeadline: 'site-headline',\n    siteButton: 'site-button',\n    result: 'result',\n    resultEmpty: 'result-empty',\n    resultTitle: 'result-title',\n    resultLine: 'result-line',\n    cursor: 'cursor',\n    headlines: 'headlines',\n    labels: 'labels',\n    progress: 'progress',\n    advance: 'advance',\n    reportHeadline: 'report-headline',\n    reportButton: 'report-button',\n    checksHeadline: 'checks-headline',\n    checksButton: 'checks-button',\n    noteHeadline: 'note-headline',\n    noteButton: 'note-button',\n    meter: 'meter',\n    meterWord: 'meter-word',\n    takeaway: 'takeaway',\n  };\n  Object.keys(ids).forEach((name) => {\n    els[name] = document.getElementById(ids[name]);\n    if (!els[name]) throw new Error(`Missing element: ${ids[name]}`);\n  });\n}\n\nfunction startPractice() {\n  els.widget.dataset.stage = 'practice';\n  const first = els.headlines.querySelector('.chip');\n  if (first) first.focus();\n}\n\nfunction bindEvents() {\n  els.introStart.addEventListener('click', startPractice);\n  els.advance.addEventListener('click', advance);\n  els.headlines.addEventListener('click', (event) => {\n    const chip = event.target.closest('.chip');\n    if (!chip) return;\n    pickHeadline(chip.dataset.id);\n    const again = els.headlines.querySelector(`[data-id=\"${chip.dataset.id}\"]`);\n    if (again) again.focus();\n  });\n  els.labels.addEventListener('click', (event) => {\n    const chip = event.target.closest('.chip');\n    if (!chip) return;\n    pickLabel(chip.dataset.id);\n    const again = els.labels.querySelector(`[data-id=\"${chip.dataset.id}\"]`);\n    if (again) again.focus();\n  });\n}\n\nfunction init() {\n  try {\n    cacheElements();\n    bindEvents();\n    renderAll();\n    els.widget.dataset.stage = CONFIG.startWithIntro ? 'intro' : 'practice';\n  } catch (error) {\n    const banner = document.getElementById('error-banner');\n    if (banner) {\n      banner.textContent = COPY.errorBanner;\n      banner.hidden = false;\n    }\n  }\n}\n\ninit();\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Headline and button</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <svg class=\"sprite\" aria-hidden=\"true\" focusable=\"false\">\n    <symbol id=\"icon-check\" viewBox=\"0 0 24 24\">\n      <path d=\"M5 12.5l4.5 4.5L19 7.5\"/>\n    </symbol>\n    <symbol id=\"icon-cross\" viewBox=\"0 0 24 24\">\n      <path d=\"M6 6l12 12M18 6L6 18\"/>\n    </symbol>\n    <symbol id=\"icon-open\" viewBox=\"0 0 24 24\">\n      <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n    </symbol>\n    <symbol id=\"icon-missed\" viewBox=\"0 0 24 24\">\n      <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n      <path d=\"M8 12h8\"/>\n    </symbol>\n  </svg>\n\n  <main class=\"widget\" id=\"widget\" data-stage=\"intro\">\n    <h1 class=\"visually-hidden\">Headline and button</h1>\n\n    <p class=\"error-banner\" id=\"error-banner\" role=\"alert\" hidden></p>\n    <p class=\"visually-hidden\" id=\"announcer\" aria-live=\"polite\"></p>\n\n    <section class=\"intro-page\" id=\"intro-page\" aria-labelledby=\"intro-title\">\n      <p><span class=\"tag\">Practice</span></p>\n      <h2 class=\"intro-title\" id=\"intro-title\">Make a page say what to do next</h2>\n      <p class=\"intro-lead\">A <strong>call to action</strong> is a button label that starts with an action word and says what happens next.</p>\n      <ol class=\"intro-list\">\n        <li>Read the website like a visitor.</li>\n        <li>Try three headline and button combinations.</li>\n        <li>Build a Strong website. Then go to the next one.</li>\n      </ol>\n      <button class=\"btn btn-contained\" id=\"intro-start\" type=\"button\">Start</button>\n    </section>\n\n    <header class=\"intro\">\n      <p class=\"intro-steps\"><span class=\"tag\">Practice</span><strong>Do This:</strong> On each website, try three combinations and build a Strong one.</p>\n      <button class=\"btn btn-contained btn-small\" id=\"advance\" type=\"button\" hidden>Next website</button>\n    </header>\n\n    <section class=\"practice\" id=\"practice\" aria-label=\"Practice\">\n      <div class=\"layout\">\n        <div class=\"left\">\n          <section class=\"site-frame\" aria-label=\"Sample website\">\n            <div class=\"site-bar\">\n              <p class=\"site-count\" id=\"site-count\"></p>\n              <span class=\"site-url\" id=\"site-url\"></span>\n            </div>\n            <div class=\"site-body\" id=\"site-body\">\n              <div class=\"scene\" aria-hidden=\"true\"></div>\n              <p class=\"site-headline\" id=\"site-headline\"></p>\n              <span class=\"site-button\" id=\"site-button\"></span>\n              <div class=\"result\" id=\"result\" data-open=\"false\">\n                <p class=\"result-empty\" id=\"result-empty\"></p>\n                <div class=\"result-card\" id=\"result-card\">\n                  <p class=\"result-title\" id=\"result-title\"></p>\n                  <p class=\"result-line\" id=\"result-line\"></p>\n                </div>\n              </div>\n              <svg class=\"cursor\" id=\"cursor\" viewBox=\"0 0 20 24\" aria-hidden=\"true\" focusable=\"false\">\n                <path d=\"M2 2v17l4.5-4 3 7 3-1.4-3-6.8H16z\"/>\n              </svg>\n            </div>\n          </section>\n          <p class=\"ux-line\">UX writers choose the words on buttons so apps are clear to use.</p>\n        </div>\n\n        <section class=\"card choices\" aria-label=\"Your choices\">\n          <div class=\"group\" role=\"group\" aria-labelledby=\"headline-label\">\n            <p class=\"group-label\" id=\"headline-label\"><span class=\"step\" aria-hidden=\"true\">1</span>Pick the best headline.</p>\n            <div class=\"options\" id=\"headlines\"></div>\n          </div>\n          <div class=\"group\" role=\"group\" aria-labelledby=\"label-label\">\n            <p class=\"group-label\" id=\"label-label\"><span class=\"step\" aria-hidden=\"true\">2</span>Try a button label.</p>\n            <div class=\"options\" id=\"labels\"></div>\n          </div>\n        </section>\n      </div>\n\n      <section class=\"card report\" aria-labelledby=\"report-title\">\n        <div class=\"report-top\">\n        <div class=\"report-head\">\n          <h2 id=\"report-title\">Website report</h2>\n          <div class=\"meter\" id=\"meter\" role=\"img\" aria-label=\"\" data-level=\"0\">\n            <span class=\"meter-text\" aria-hidden=\"true\"><span class=\"meter-label\">Strength:</span> <span class=\"meter-word\" id=\"meter-word\"></span></span>\n            <span class=\"meter-bars\" aria-hidden=\"true\"><span class=\"meter-seg\"></span><span class=\"meter-seg\"></span><span class=\"meter-seg\"></span></span>\n          </div>\n        </div>\n        <div class=\"progress-row\">\n          <div class=\"progress\" id=\"progress\"></div>\n        </div>\n        </div>\n        <div class=\"report-rows\">\n          <div class=\"report-row\">\n            <div class=\"report-main\">\n              <p class=\"report-part\"><span class=\"report-name\">Headline</span><span class=\"report-choice\" id=\"report-headline\"></span></p>\n              <ul class=\"checks\" id=\"checks-headline\"></ul>\n            </div>\n            <p class=\"report-note\" id=\"note-headline\"></p>\n          </div>\n          <div class=\"report-row\">\n            <div class=\"report-main\">\n              <p class=\"report-part\"><span class=\"report-name\">Button label</span><span class=\"report-choice\" id=\"report-button\"></span></p>\n              <ul class=\"checks\" id=\"checks-button\"></ul>\n            </div>\n            <p class=\"report-note\" id=\"note-button\"></p>\n          </div>\n        </div>\n      </section>\n    </section>\n\n    <section class=\"takeaway-page\" id=\"takeaway\" aria-labelledby=\"takeaway-title\" tabindex=\"-1\">\n      <h2 class=\"intro-title\" id=\"takeaway-title\">Takeaway: Clear words tell visitors what to do next</h2>\n      <p class=\"intro-lead\">A clear headline says what the site is for. A button that starts with an action word and names the next step tells visitors what happens when they click.</p>\n      <p class=\"takeaway-parts\">\n        <span class=\"part-tag\" data-part=\"purpose\">What it’s for</span>\n        <span class=\"part-tag\" data-part=\"verb\">Action word</span>\n        <span class=\"part-tag\" data-part=\"next\">Next step</span>\n      </p>\n      <p class=\"takeaway-next\"><strong>Press Continue to go to your project.</strong></p>\n    </section>\n  </main>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": "/*\n * CADS tokens\n * Copied from the CADS runtime (manifest 0.1.0), light theme. Only the tokens\n * that this stylesheet uses, and the tokens they refer to, are included.\n * Do not change values here. Change the component styles below instead.\n */\n\n:root {\n  /* Palette */\n  --brand-purple-5: #e4e2f8;\n  --brand-purple-20: #aca8ea;\n  --brand-purple-30: #928cef;\n  --brand-purple-50: #4c42cf;\n  --brand-purple-80: #2b1e9f;\n  --brand-purple-90: #1d1590;\n  --brand-orange-5: #ffe3ce;\n  --brand-orange-30: #ffa868;\n  --brand-pink-5: #fbdae8;\n  --brand-pink-30: #f07fb0;\n  --neutral-base-black: #121212;\n  --neutral-base-white: #ffffff;\n  --neutral-gray-5: #f1f2f4;\n  --neutral-gray-20: #d3d6da;\n  --neutral-gray-40: #9ea5ad;\n  --neutral-gray-70: #596069;\n  --neutral-gray-80: #4b5258;\n  --sentiment-error-5: #ffdada;\n  --sentiment-error-50: #eb1414;\n  --sentiment-error-70: #b30f0f;\n  --sentiment-information-5: #d5efff;\n  --sentiment-information-70: #1570d1;\n  --sentiment-success-5: #d8ffdc;\n  --sentiment-success-30: #7cdb87;\n  --sentiment-success-70: #258830;\n  --sentiment-success-90: #17541e;\n  --sentiment-warning-30: #ffd35c;\n  --sentiment-warning-90: #885d02;\n\n  /* Color roles (light theme) */\n  --background-neutral-primary: var(--neutral-base-white);\n  --background-neutral-secondary: var(--neutral-gray-5);\n  --background-brand-primary: var(--brand-purple-50);\n  --background-brand-light: var(--brand-purple-5);\n  --background-brand-mid: var(--brand-purple-20);\n  --background-brand-strong: var(--brand-purple-80);\n  --background-error-light: var(--sentiment-error-5);\n  --background-warning-mid: var(--sentiment-warning-30);\n  --background-success-primary: var(--sentiment-success-70);\n  --background-success-mid: var(--sentiment-success-30);\n  --background-info-primary: var(--sentiment-information-70);\n  --background-info-light: var(--sentiment-information-5);\n  --background-selected-primary: var(--brand-purple-80);\n  --background-accent-orange-light: var(--brand-orange-5);\n  --background-accent-orange-mid: var(--brand-orange-30);\n  --background-accent-pink-light: var(--brand-pink-5);\n  --background-accent-pink-mid: var(--brand-pink-30);\n  --border-neutral-primary: var(--neutral-gray-20);\n  --border-neutral-secondary: var(--neutral-gray-40);\n  --border-neutral-solid: var(--neutral-base-black);\n  --border-brand-mid: var(--brand-purple-30);\n  --border-error-primary: var(--sentiment-error-50);\n  --border-focused-primary: var(--brand-purple-50);\n  --border-selected-primary: var(--brand-purple-80);\n  --border-accent-orange-mid: var(--brand-orange-30);\n  --border-accent-pink-mid: var(--brand-pink-30);\n  --text-neutral-primary: var(--neutral-base-black);\n  --text-neutral-tertiary: var(--neutral-gray-80);\n  --text-neutral-quaternary: var(--neutral-gray-70);\n  --text-neutral-white-fixed: var(--neutral-base-white);\n  --text-brand-primary: var(--brand-purple-50);\n  --text-brand-secondary: var(--brand-purple-90);\n  --text-error-secondary: var(--sentiment-error-70);\n  --text-warning-secondary: var(--sentiment-warning-90);\n  --text-success-secondary: var(--sentiment-success-90);\n  --text-selected-primary: var(--sentiment-success-5);\n\n  /* Type, shape, spacing, motion and control size */\n  --font-family-main: \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-family-heading: \"Space Grotesk\", \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-weight-semi-bold: 600;\n  --font-weight-bold: 700;\n  --text-heading-sm: 1.375rem;\n  --text-heading-xs: 1.25rem;\n  --leading-heading-sm: 1.875rem;\n  --leading-heading-xs: 1.75rem;\n  --text-body-lg: 1.125rem;\n  --text-body-md: 1rem;\n  --leading-body-lg: 1.75rem;\n  --leading-body-md: 1.5rem;\n  --shape-sm: .375rem;\n  --shape-md: .5rem;\n  --shape-lg: .625rem;\n  --shape-round: 62.4375rem;\n  --spacing-p-xxs: .5rem;\n  --spacing-p-xs: 1rem;\n  --spacing-p-s: 1.5rem;\n  --duration-short: .15s;\n  --duration-medium: .2s;\n  --easing-standard: cubic-bezier(.4, 0, .2, 1);\n  --easing-out: cubic-bezier(.23, 1, .32, 1);\n  --motion-press-scale: .97;\n  --motion-press-duration: .15s;\n  --motion-press-easing: cubic-bezier(.23, 1, .32, 1);\n  --transition-colors: background-color var(--duration-short) var(--easing-standard), color var(--duration-short) var(--easing-standard), border-color var(--duration-short) var(--easing-standard), box-shadow var(--duration-short) var(--easing-standard), opacity var(--duration-short) var(--easing-standard);\n  --transition-press: transform var(--motion-press-duration) var(--motion-press-easing);\n  --control-height-large: 48px;\n  --control-height-medium: 40px;\n  --control-height-small: 32px;\n  --control-height-extra-small: 24px;\n}\n\n/*\n * Component styles\n *\n * What is CADS here:\n *   - Every color, type size, spacing, radius, control height, motion and\n *     focus value comes from the CADS tokens above. No hard-coded colors.\n *   - Spacing uses the CADS scale: 16px between groups, 8px inside a group.\n *\n * What was rebuilt from the CADS manifest (Web Lab has no CADS components):\n *   - Button: contained primary, medium.\n *   - Chip: the headline and button label options (selected tokens when on).\n *   - Tag: the check names in the page report.\n *   - Card surface for the choices panel and the page report.\n *\n * What was approximated:\n *   - Geist and Space Grotesk are named by the CADS font tokens, but Web Lab\n *     blocks outside fonts, so the fallback stack in the token applies.\n *   - Tag and chip text is 16px, not the 12 to 14px CADS sizes, to meet the\n *     16px minimum.\n *   - The icons are inline SVG, not Font Awesome.\n *   - The sample page (scene, headline, button, cursor and result card) and\n *     the strength meter are custom pieces built only from CADS tokens.\n */\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nhtml {\n  font-size: 100%;\n}\n\nbody {\n  margin: 0;\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-md);\n  line-height: var(--leading-body-md);\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n\n.sprite {\n  position: absolute;\n  width: 0;\n  height: 0;\n  overflow: hidden;\n}\n\n.icon {\n  flex: none;\n  width: 1.25rem;\n  height: 1.25rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\np {\n  margin: 0;\n}\n\n/* ---------- Layout ---------- */\n\n.widget {\n  display: grid;\n  gap: var(--spacing-p-xs);\n  max-width: 55rem;\n  margin: 0 auto;\n  padding: var(--spacing-p-xs);\n}\n\n.error-banner {\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border: 1px solid var(--border-error-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-error-light);\n  color: var(--text-error-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n/* ---------- Buttons (CADS Button recipe) ---------- */\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--spacing-p-xxs);\n  min-height: var(--control-height-medium);\n  padding: 0 var(--spacing-p-xs);\n  border: 1px solid transparent;\n  border-radius: var(--shape-sm);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n  transition: var(--transition-colors), var(--transition-press);\n}\n\n.btn:active {\n  transform: scale(var(--motion-press-scale));\n}\n\n.btn-large {\n  min-height: var(--control-height-large);\n  font-size: var(--text-body-lg);\n}\n\n.btn-small {\n  min-height: var(--control-height-small);\n}\n\n.btn-contained {\n  background: var(--background-brand-primary);\n  color: var(--text-neutral-white-fixed);\n}\n\n.btn-contained:hover {\n  background: var(--background-brand-strong);\n}\n\n.btn-outlined {\n  border-color: var(--border-neutral-solid);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n}\n\n.btn-outlined:hover {\n  background: var(--background-neutral-secondary);\n}\n\n.btn-text {\n  background: transparent;\n  color: var(--text-brand-primary);\n}\n\n.btn-text:hover {\n  background: var(--background-brand-light);\n}\n\n.btn:focus-visible,\n.chip:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--background-neutral-primary), 0 0 0 4px var(--border-focused-primary);\n}\n\n/* ---------- Header ---------- */\n\n.intro {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--spacing-p-xxs) var(--spacing-p-xs);\n  min-height: calc(var(--control-height-small) + var(--spacing-p-xs) * 2 + 2px);\n  padding: var(--spacing-p-xs);\n  border: 1px solid var(--border-brand-mid);\n  border-radius: var(--shape-lg);\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n}\n\n.intro .tag {\n  background: var(--background-neutral-primary);\n}\n\n.tag {\n  display: inline-flex;\n  align-items: center;\n  min-height: var(--control-height-extra-small);\n  padding: 0 var(--spacing-p-xxs);\n  border: 1px solid var(--border-brand-mid);\n  line-height: calc(var(--control-height-extra-small) - 2px);\n  border-radius: var(--shape-sm);\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.intro-steps .tag {\n  margin-inline-end: var(--spacing-p-xxs);\n}\n\n.intro-steps {\n  margin: 0;\n}\n\n.intro-page,\n.takeaway-page {\n  display: grid;\n  justify-items: start;\n  align-content: start;\n  gap: var(--spacing-p-xs);\n  max-width: 32rem;\n  padding: var(--spacing-p-xs) 0;\n}\n\n.intro-page p,\n.takeaway-page p {\n  margin: 0;\n}\n\n.intro-title {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-sm);\n  font-weight: var(--font-weight-bold);\n  line-height: var(--leading-heading-sm);\n}\n\n.intro-list {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  margin: 0;\n  padding-inline-start: var(--spacing-p-s);\n}\n\n.intro-list li::marker {\n  font-weight: var(--font-weight-bold);\n}\n\n.takeaway-page:focus {\n  outline: none;\n}\n\n.takeaway-parts {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-p-xxs);\n}\n\n.takeaway-parts .part-tag {\n  margin-inline-end: 0;\n}\n\n.takeaway-next {\n  font-size: var(--text-body-lg);\n  line-height: var(--leading-body-lg);\n}\n\n.widget:not([data-stage=\"intro\"]) .intro-page,\n.widget:not([data-stage=\"done\"]) .takeaway-page,\n.widget[data-stage=\"intro\"] .intro,\n.widget[data-stage=\"intro\"] .practice,\n.widget[data-stage=\"done\"] .intro,\n.widget[data-stage=\"done\"] .practice {\n  display: none;\n}\n\n/* ---------- Practice layout ---------- */\n\n.practice {\n  display: grid;\n  gap: var(--spacing-p-xs);\n}\n\n.layout {\n  display: grid;\n  grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);\n  gap: var(--spacing-p-xs);\n  align-items: start;\n}\n\n.left {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  min-width: 0;\n}\n\n.card {\n  min-width: 0;\n  padding: var(--spacing-p-xs);\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-lg);\n  background: var(--background-neutral-primary);\n}\n\n.ux-line {\n  max-width: 34rem;\n  color: var(--text-neutral-tertiary);\n  text-wrap: balance;\n}\n\n/* ---------- Sample page (a picture of a website) ---------- */\n\n.site-frame {\n  overflow: hidden;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-lg);\n  background: var(--background-neutral-primary);\n}\n\n.site-bar {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--spacing-p-xxs) var(--spacing-p-xs);\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border-bottom: 1px solid var(--border-neutral-primary);\n  background: var(--background-neutral-secondary);\n}\n\n.site-count {\n  font-weight: var(--font-weight-bold);\n}\n\n.site-url {\n  color: var(--text-neutral-tertiary);\n}\n\n.site-body {\n  position: relative;\n  display: grid;\n  justify-items: start;\n  align-content: start;\n  gap: var(--spacing-p-xxs);\n  padding: var(--spacing-p-xs);\n  overflow: hidden;\n}\n\n.scene {\n  position: relative;\n  justify-self: stretch;\n  height: 2.5rem;\n  overflow: hidden;\n  border-radius: var(--shape-md);\n  background: var(--background-info-light);\n}\n\n.scene::before {\n  content: \"\";\n  position: absolute;\n  inset-block-start: var(--spacing-p-xxs);\n  inset-inline-end: var(--spacing-p-s);\n  width: 1.25rem;\n  height: 1.25rem;\n  border-radius: 50%;\n  background: var(--background-warning-mid);\n}\n\n.scene::after {\n  content: \"\";\n  position: absolute;\n  inset-block-end: -1.25rem;\n  inset-inline-start: -15%;\n  width: 130%;\n  height: 2.25rem;\n  border-radius: 50%;\n  background: var(--background-success-mid);\n}\n\n/* Each example page has its own little picture */\n.site-body[data-theme=\"club\"] .scene {\n  background: var(--background-brand-light);\n}\n\n.site-body[data-theme=\"club\"] .scene::before {\n  inset-block-start: var(--spacing-p-xxs);\n  inset-inline-start: var(--spacing-p-xs);\n  inset-inline-end: auto;\n  width: 1.5rem;\n  height: 1.5rem;\n  border-radius: var(--shape-sm);\n  background: var(--background-brand-mid);\n}\n\n.site-body[data-theme=\"club\"] .scene::after {\n  inset-block-start: var(--spacing-p-xxs);\n  inset-block-end: auto;\n  inset-inline-start: 4rem;\n  width: 1.5rem;\n  height: 1.5rem;\n  border-radius: 50%;\n  background: var(--background-accent-orange-mid);\n}\n\n.site-body[data-theme=\"art\"] .scene {\n  background: linear-gradient(90deg, var(--background-accent-pink-mid) 0 34%, var(--background-accent-orange-mid) 0 67%, var(--background-warning-mid) 0);\n}\n\n.site-body[data-theme=\"art\"] .scene::before,\n.site-body[data-theme=\"art\"] .scene::after {\n  display: none;\n}\n\n.site-headline {\n  min-height: var(--leading-heading-sm);\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-sm);\n  font-weight: var(--font-weight-bold);\n  line-height: var(--leading-heading-sm);\n}\n\n.site-button {\n  display: inline-flex;\n  align-items: center;\n  min-height: var(--control-height-medium);\n  padding: 0 var(--spacing-p-xs);\n  border-radius: var(--shape-md);\n  background: var(--background-info-primary);\n  color: var(--text-neutral-white-fixed);\n  font-weight: var(--font-weight-semi-bold);\n  transition: transform var(--motion-press-duration) var(--motion-press-easing);\n}\n\n.site-button.is-pressed {\n  transform: scale(var(--motion-press-scale));\n}\n\n/* The small result card opens after the cursor presses the button */\n.result {\n  justify-self: stretch;\n  min-height: calc(var(--leading-body-md) * 2 + var(--spacing-p-xxs) * 2 + 2px);\n}\n\n.result-empty,\n.result-card {\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border: 1px solid;\n  border-radius: var(--shape-md);\n}\n\n.result-empty {\n  border-color: var(--border-neutral-secondary);\n  border-style: dashed;\n  color: var(--text-neutral-quaternary);\n}\n\n.result-card {\n  border-color: var(--border-neutral-primary);\n  background: var(--background-neutral-secondary);\n}\n\n.result-title {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.result[data-open=\"false\"] .result-card,\n.result[data-open=\"true\"] .result-empty {\n  display: none;\n}\n\n.result[data-open=\"true\"] .result-card {\n  animation: pop 0.3s var(--easing-out);\n}\n\n.cursor {\n  position: absolute;\n  inset-block-start: 0;\n  inset-inline-start: 0;\n  width: 1.25rem;\n  height: 1.5rem;\n  fill: var(--text-neutral-primary);\n  stroke: var(--background-neutral-primary);\n  stroke-linejoin: round;\n  stroke-width: 1.5;\n  pointer-events: none;\n  opacity: 0;\n  transform: translate(var(--x, 0), var(--y, 0));\n  transition: transform 0.9s var(--easing-out);\n}\n\n.cursor.is-active {\n  opacity: 1;\n}\n\n.cursor.is-reset {\n  transition: none;\n}\n\n/* A quick highlight on the part of the page the student just changed */\n.flash {\n  position: relative;\n}\n\n.flash::after {\n  content: \"\";\n  position: absolute;\n  inset: -2px;\n  border-radius: var(--shape-sm);\n  background: var(--background-brand-mid);\n  opacity: 0;\n  pointer-events: none;\n  animation: flash 0.7s var(--easing-out);\n}\n\n@keyframes flash {\n  0% {\n    opacity: 0.7;\n  }\n\n  100% {\n    opacity: 0;\n  }\n}\n\n@keyframes pop {\n  0% {\n    opacity: 0;\n    transform: translateY(var(--spacing-p-xxs)) scale(0.96);\n  }\n\n  100% {\n    opacity: 1;\n    transform: none;\n  }\n}\n\n/* ---------- Choices (CADS Chip recipe) ---------- */\n\n.choices {\n  display: grid;\n  gap: var(--spacing-p-xs);\n}\n\n.group {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n}\n\n.group-label {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.step {\n  display: inline-grid;\n  flex: none;\n  place-items: center;\n  width: 1.5rem;\n  height: 1.5rem;\n  border: 1px solid var(--border-neutral-solid);\n  border-radius: 50%;\n  font-weight: var(--font-weight-bold);\n  line-height: 1;\n}\n\n.options {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-p-xxs);\n}\n\n/* Reserve the rows the chips can wrap onto, so nothing moves when a check appears */\n#headlines {\n  min-height: calc(var(--control-height-small) * 2 + var(--spacing-p-xxs));\n}\n\n#labels {\n  min-height: calc(var(--control-height-small) * 3 + var(--spacing-p-xxs) * 2);\n}\n\n.chip {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  min-height: var(--control-height-medium);\n  padding: 0 var(--spacing-p-xs);\n  border: 1px solid var(--border-neutral-solid);\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n  transition: var(--transition-colors), var(--transition-press);\n}\n\n.chip-small {\n  min-height: var(--control-height-small);\n  padding: 0 var(--spacing-p-xxs);\n}\n\n.chip:hover:not([aria-pressed=\"true\"]) {\n  background: var(--background-neutral-secondary);\n}\n\n.chip:active {\n  transform: scale(var(--motion-press-scale));\n}\n\n.chip[aria-pressed=\"true\"] {\n  border-color: var(--border-selected-primary);\n  background: var(--background-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n.progress-row {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--spacing-p-xxs) var(--spacing-p-xs);\n  min-height: var(--control-height-small);\n}\n\n.progress {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--spacing-p-xxs) var(--spacing-p-xs);\n  min-height: var(--leading-body-md);\n}\n\n.goals {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-p-xxs) var(--spacing-p-xs);\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.goal {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n}\n\n.goal .icon {\n  width: 1.25rem;\n  height: 1.25rem;\n  color: var(--text-neutral-tertiary);\n}\n\n.goal.is-done {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.goal.is-done .icon {\n  color: var(--text-success-secondary);\n  stroke-width: 3;\n}\n\n/* ---------- Page report ---------- */\n\n.report {\n  display: grid;\n  gap: var(--spacing-p-xs);\n}\n\n.report-top {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n}\n\n.report-head {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--spacing-p-xxs) var(--spacing-p-xs);\n}\n\n.report-head h2 {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-xs);\n  line-height: var(--leading-heading-xs);\n}\n\n.progress {\n  color: var(--text-neutral-tertiary);\n}\n\n/* Strength meter: three segments fill as more checks say Yes */\n.meter {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  margin-inline-start: auto;\n}\n\n.meter-label,\n.meter-word {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.meter-bars {\n  display: inline-flex;\n  gap: var(--spacing-p-xxs);\n}\n\n.meter-seg {\n  width: 2rem;\n  height: 0.75rem;\n  border: 1px solid var(--border-neutral-solid);\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-primary);\n  transition: background-color var(--duration-medium) var(--easing-standard);\n}\n\n.meter[data-level=\"1\"] .meter-seg:nth-child(-n + 1) {\n  background: var(--background-warning-mid);\n}\n\n.meter[data-level=\"2\"] .meter-seg:nth-child(-n + 2) {\n  background: var(--background-info-primary);\n}\n\n.meter[data-level=\"3\"] .meter-seg {\n  background: var(--background-success-primary);\n}\n\n.meter-text {\n  min-width: 14rem;\n  text-align: end;\n}\n\n.report-rows {\n  display: grid;\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n}\n\n.report-row {\n  display: grid;\n  grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);\n  gap: var(--spacing-p-xs);\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n}\n\n.report-row + .report-row {\n  border-top: 1px solid var(--border-neutral-primary);\n}\n\n.report-main {\n  display: grid;\n  align-content: start;\n  gap: var(--spacing-p-xxs);\n  min-width: 0;\n}\n\n.report-name {\n  margin-inline-end: var(--spacing-p-xxs);\n  font-weight: var(--font-weight-bold);\n}\n\n.report-note {\n  min-height: calc(var(--leading-body-md) * 2);\n  color: var(--text-neutral-primary);\n}\n\n.checks {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-p-xxs) var(--spacing-p-xs);\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.check {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n}\n\n.check-status {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.check-status .icon {\n  width: 1rem;\n  height: 1rem;\n  stroke-width: 3;\n}\n\n.check-status.is-yes {\n  color: var(--text-success-secondary);\n}\n\n.check-status.is-not-yet {\n  color: var(--text-warning-secondary);\n}\n\n/* ---------- Tags (CADS Tag recipe) ---------- */\n\n.part-tag {\n  display: inline-block;\n  padding: 0 var(--spacing-p-xxs);\n  border: 1px solid;\n  border-radius: var(--shape-sm);\n  color: var(--text-neutral-primary);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: calc(var(--control-height-extra-small) - 2px);\n}\n\n.part-tag[data-part=\"verb\"] {\n  border-color: var(--border-brand-mid);\n  background: var(--background-brand-light);\n}\n\n.part-tag[data-part=\"next\"] {\n  border-color: var(--border-accent-orange-mid);\n  background: var(--background-accent-orange-light);\n}\n\n.part-tag[data-part=\"purpose\"] {\n  border-color: var(--border-accent-pink-mid);\n  background: var(--background-accent-pink-light);\n}\n\n/* ---------- Small screens ---------- */\n\n@media (max-width: 47.99rem) {\n  .layout,\n  .report-row {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .meter {\n    margin-inline-start: 0;\n  }\n\n  .meter-text {\n    min-width: 0;\n    text-align: start;\n  }\n\n  .site-headline {\n    min-height: calc(var(--leading-heading-sm) * 2);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n\n  .btn:active,\n  .chip:active {\n    transform: none;\n  }\n}\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    },
