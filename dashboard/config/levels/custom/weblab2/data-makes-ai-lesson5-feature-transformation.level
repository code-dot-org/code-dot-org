  "properties": {
    "encrypted": "false",
    "long_instructions": "# Numbers Into Categories\r\nIt is helpful to use categories in order to describe a range of the data. \r\n* Explore creating different group sizes and names to describe the data.\r\n* Click the **Kid** and **Parent** buttons. Why might the sizes and names be different?\r\n\r\n",
    "offer_browser_tts": "false",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "true",
    "require_edit_to_continue": "true",
    "initial_view_mode": "split",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "placeholderText": "",
      "multipleChoiceOptions": [
        ""
      ],
      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false
