    },
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Smart Room Inspector: Turn Numbers into Groups</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <div class=\"app\">\n    <header class=\"top-bar\">\n      <svg class=\"brand-logo\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" focusable=\"false\">\n        <defs>\n          <linearGradient id=\"logo-gradient\" x1=\"0\" y1=\"1\" x2=\"1\" y2=\"0\">\n            <stop offset=\"0\" stop-color=\"#f9ce34\"></stop>\n            <stop offset=\"0.5\" stop-color=\"#ee2a7b\"></stop>\n            <stop offset=\"1\" stop-color=\"#6228d7\"></stop>\n          </linearGradient>\n        </defs>\n        <path d=\"M3 10V5a2 2 0 0 1 2-2h5M22 3h5a2 2 0 0 1 2 2v5M29 22v5a2 2 0 0 1-2 2h-5M10 29H5a2 2 0 0 1-2-2v-5\" fill=\"none\" stroke=\"url(#logo-gradient)\" stroke-width=\"3\" stroke-linecap=\"round\"></path>\n        <path d=\"M9 15.5 16 9.5l7 6V23H9z\" fill=\"none\" stroke=\"url(#logo-gradient)\" stroke-width=\"2.5\" stroke-linejoin=\"round\"></path>\n      </svg>\n      <div class=\"brand-text\">\n        <p class=\"brand-name\">Numbers into Categories</p>\n        <h1 class=\"page-title\">Smart Room Inspector</h1>\n      </div>\n      <div id=\"perspective-buttons\" class=\"perspective-buttons\" role=\"group\" aria-label=\"See another point of view\" hidden>\n        <button type=\"button\" class=\"perspective-button\" data-perspective=\"kid\" aria-pressed=\"false\">\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n            <circle cx=\"12\" cy=\"10\" r=\"3.5\"></circle>\n            <path d=\"M6.5 21c0-3.6 2.4-6.5 5.5-6.5s5.5 2.9 5.5 6.5\"></path>\n            <path d=\"M8.5 7.5c1-2 2.2-3 3.5-3s2.5 1 3.5 3\"></path>\n          </svg>\n          <span>Kid</span>\n        </button>\n        <button type=\"button\" class=\"perspective-button\" data-perspective=\"parent\" aria-pressed=\"false\">\n          <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n            <circle cx=\"12\" cy=\"6\" r=\"3\"></circle>\n            <path d=\"M5 22v-4.5c0-3.8 3-6.5 7-6.5s7 2.7 7 6.5V22\"></path>\n            <path d=\"M12 11l-1.2 3.5L12 18l1.2-3.5z\"></path>\n          </svg>\n          <span>Parent</span>\n        </button>\n      </div>\n    </header>\n\n\n    <p id=\"error-message\" class=\"error-message\" role=\"alert\" hidden></p>\n\n    <main class=\"workspace\">\n      <section class=\"panel groups-panel\" aria-labelledby=\"groups-heading\">\n        <div class=\"panel-header\">\n          <h2 id=\"groups-heading\">Your Categories</h2>\n          <button type=\"button\" id=\"reset-button\" class=\"text-button\">Start over</button>\n        </div>\n\n        <ol id=\"group-list\" class=\"group-list\"></ol>\n\n        <div class=\"group-actions\">\n          <button type=\"button\" id=\"add-group-button\" class=\"secondary-button\">Add a Category</button>\n        </div>\n      </section>\n\n      <section class=\"panel table-panel\" aria-labelledby=\"table-heading\">\n        <div class=\"panel-header\">\n          <h2 id=\"table-heading\">Room data</h2>\n          <button type=\"button\" id=\"sort-button\" class=\"text-button\" aria-pressed=\"false\">Sort by items on floor</button>\n        </div>\n        <div class=\"table-wrap\">\n          <table class=\"data-table\">\n            <caption class=\"visually-hidden\">Each room, how many items are on its floor, and the group it belongs to</caption>\n            <thead>\n              <tr>\n                <th scope=\"col\">Room</th>\n                <th scope=\"col\" class=\"number-col\">Items on floor</th>\n                <th scope=\"col\" class=\"new-col\">Floor mess</th>\n              </tr>\n            </thead>\n            <tbody id=\"table-body\"></tbody>\n          </table>\n        </div>\n      </section>\n    </main>\n\n    <p id=\"announcer\" class=\"visually-hidden\" aria-live=\"polite\"></p>\n  </div>\n</body>\n</html>",
          "active": true,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "\"use strict\";\n\n// Set to false to hide the Kid and Parent buttons.\nconst SHOW_PERSPECTIVES = true;\n\nconst ROOMS = [\n  { id: \"room-1\", name: \"One\", items: 4 },\n  { id: \"room-2\", name: \"Two\", items: 12 },\n  { id: \"room-3\", name: \"Three\", items: 0 },\n  { id: \"room-4\", name: \"Four\", items: 7 },\n  { id: \"room-5\", name: \"Five\", items: 19 },\n  { id: \"room-6\", name: \"Six\", items: 3 },\n  { id: \"room-7\", name: \"Seven\", items: 9 },\n  { id: \"room-8\", name: \"Eight\", items: 15 },\n  { id: \"room-9\", name: \"Nine\", items: 1 },\n  { id: \"room-10\", name: \"Ten\", items: 24 }\n];\n\nconst LOWEST_VALUE = 0;\nconst HIGHEST_TOP = 23;\nconst MAX_GROUPS = 4;\nconst MIN_GROUPS = 2;\nconst DEFAULT_GROUPS = [\n  { name: \"Little\", top: 3 },\n  { name: \"Some\", top: 9 },\n  { name: \"Lots\", top: null }\n];\n\nconst PERSPECTIVES = {\n  kid: {\n    announcement: \"Here is how a kid might group the rooms.\",\n    groups: [\n      { name: \"Clean\", top: 14 },\n      { name: \"Okay\", top: 21 },\n      { name: \"Messy\", top: null }\n    ]\n  },\n  parent: {\n    announcement: \"Here is how a parent might group the rooms.\",\n    groups: [\n      { name: \"Clean\", top: 2 },\n      { name: \"Messy\", top: 8 },\n      { name: \"Disaster\", top: null }\n    ]\n  }\n};\n\nconst numberFormat = new Intl.NumberFormat(document.documentElement.lang);\nconst pluralRules = new Intl.PluralRules(document.documentElement.lang);\nconst listFormat = typeof Intl.ListFormat === \"function\"\n  ? new Intl.ListFormat(document.documentElement.lang, { style: \"long\", type: \"conjunction\" })\n  : null;\n\nconst state = {\n  groups: [],\n  nextGroupId: 1,\n  sortByItems: false,\n  movedRoomIds: []\n};\n\nconst els = {};\n\nfunction formatNumber(value) {\n  return numberFormat.format(value);\n}\n\nfunction formatList(items) {\n  return listFormat ? listFormat.format(items) : items.join(\", \");\n}\n\n// Colors run from green (fewest items) to red (most items), whatever the number of groups.\nconst COLOR_SLOTS_BY_COUNT = {\n  2: [1, 4],\n  3: [1, 2, 4],\n  4: [1, 2, 3, 4]\n};\n\nfunction colorSlotFor(index) {\n  const slots = COLOR_SLOTS_BY_COUNT[state.groups.length] || COLOR_SLOTS_BY_COUNT[4];\n  return slots[index];\n}\n\nfunction createGroup(name, top) {\n  const group = { id: state.nextGroupId, name, top };\n  state.nextGroupId += 1;\n  return group;\n}\n\nfunction loadGroups(groups) {\n  state.groups = [];\n  groups.forEach((group) => {\n    state.groups.push(createGroup(group.name, group.top));\n  });\n  state.movedRoomIds = [];\n}\n\nfunction resetGroups() {\n  loadGroups(DEFAULT_GROUPS);\n}\n\nfunction groupStart(index) {\n  return index === 0 ? LOWEST_VALUE : state.groups[index - 1].top + 1;\n}\n\nfunction isLastGroup(index) {\n  return index === state.groups.length - 1;\n}\n\nfunction topLimits(index) {\n  const min = groupStart(index);\n  const nextGroupTop = state.groups[index + 1] ? state.groups[index + 1].top : null;\n  const max = nextGroupTop === null ? HIGHEST_TOP : nextGroupTop - 1;\n  return { min, max };\n}\n\nfunction findGroupIndex(value) {\n  for (let i = 0; i < state.groups.length - 1; i += 1) {\n    if (value <= state.groups[i].top) {\n      return i;\n    }\n  }\n  return state.groups.length - 1;\n}\n\nfunction groupDisplayName(index) {\n  const name = state.groups[index].name.trim();\n  return name || `Group ${formatNumber(index + 1)}`;\n}\n\nfunction rangeText(index) {\n  const start = formatNumber(groupStart(index));\n  if (isLastGroup(index)) {\n    return `${start} and up`;\n  }\n  return `${start} to ${formatNumber(state.groups[index].top)}`;\n}\n\nfunction currentAssignments() {\n  const assignments = {};\n  ROOMS.forEach((room) => {\n    assignments[room.id] = state.groups[findGroupIndex(room.items)].id;\n  });\n  return assignments;\n}\n\nfunction makeIcon(pathData) {\n  const ns = \"http://www.w3.org/2000/svg\";\n  const svg = document.createElementNS(ns, \"svg\");\n  svg.setAttribute(\"viewBox\", \"0 0 16 16\");\n  svg.setAttribute(\"aria-hidden\", \"true\");\n  svg.setAttribute(\"focusable\", \"false\");\n  const path = document.createElementNS(ns, \"path\");\n  path.setAttribute(\"d\", pathData);\n  path.setAttribute(\"stroke\", \"currentColor\");\n  path.setAttribute(\"stroke-width\", \"2.5\");\n  path.setAttribute(\"stroke-linecap\", \"round\");\n  path.setAttribute(\"fill\", \"none\");\n  svg.appendChild(path);\n  return svg;\n}\n\nfunction makeIconButton(className, label, pathData, onClick) {\n  const button = document.createElement(\"button\");\n  button.type = \"button\";\n  button.className = `icon-button ${className}`;\n  button.setAttribute(\"aria-label\", label);\n  button.appendChild(makeIcon(pathData));\n  button.addEventListener(\"click\", onClick);\n  return button;\n}\n\nfunction buildGroupCard(group, index) {\n  const item = document.createElement(\"li\");\n  item.className = `group-card group-color-${colorSlotFor(index)}`;\n\n  const nameLabel = document.createElement(\"label\");\n  nameLabel.className = \"visually-hidden\";\n  nameLabel.htmlFor = `group-name-${group.id}`;\n  nameLabel.textContent = `Group ${index + 1} name`;\n\n  const nameInput = document.createElement(\"input\");\n  nameInput.type = \"text\";\n  nameInput.id = `group-name-${group.id}`;\n  nameInput.className = \"group-name\";\n  nameInput.maxLength = 16;\n  nameInput.autocomplete = \"off\";\n  nameInput.placeholder = \"Name\";\n  nameInput.value = group.name;\n  nameInput.addEventListener(\"input\", () => {\n    group.name = nameInput.value;\n    setActivePerspective(null);\n    renderTable();\n  });\n\n  const range = document.createElement(\"div\");\n  range.className = \"range\";\n  const rangeLabel = document.createElement(\"span\");\n  rangeLabel.className = \"range-text\";\n  range.appendChild(rangeLabel);\n\n  if (!isLastGroup(index)) {\n    const topLabel = document.createElement(\"label\");\n    topLabel.className = \"visually-hidden\";\n    topLabel.htmlFor = `group-top-${group.id}`;\n    topLabel.textContent = `Highest number in group ${index + 1}`;\n\n    const topInput = document.createElement(\"input\");\n    topInput.type = \"number\";\n    topInput.id = `group-top-${group.id}`;\n    topInput.inputMode = \"numeric\";\n    topInput.step = \"1\";\n    topInput.addEventListener(\"change\", () => {\n      const value = parseInt(topInput.value, 10);\n      changeTop(index, Number.isNaN(value) ? group.top : value);\n    });\n\n    range.append(\n      makeIconButton(\"lower-button\", `Lower the highest number in group ${index + 1}`, \"M3 8h10\", () => changeTop(index, group.top - 1)),\n      topLabel,\n      topInput,\n      makeIconButton(\"raise-button\", `Raise the highest number in group ${index + 1}`, \"M3 8h10M8 3v10\", () => changeTop(index, group.top + 1))\n    );\n  }\n\n  item.append(nameLabel, nameInput, range);\n\n  if (state.groups.length > MIN_GROUPS) {\n    item.appendChild(makeIconButton(\"remove-button\", `Remove group ${index + 1}`, \"M4 4l8 8M12 4l-8 8\", () => removeGroup(index)));\n  }\n\n  return item;\n}\n\nfunction renderGroups() {\n  els[\"group-list\"].textContent = \"\";\n  state.groups.forEach((group, index) => {\n    els[\"group-list\"].appendChild(buildGroupCard(group, index));\n  });\n  updateGroupDetails();\n}\n\nfunction updateGroupDetails() {\n  const cards = els[\"group-list\"].children;\n  state.groups.forEach((group, index) => {\n    const card = cards[index];\n    const start = formatNumber(groupStart(index));\n    const rangeLabel = card.querySelector(\".range-text\");\n    if (isLastGroup(index)) {\n      rangeLabel.textContent = `${start} and up`;\n      return;\n    }\n    const limits = topLimits(index);\n    rangeLabel.textContent = `${start} to`;\n    const input = card.querySelector(\"input[type='number']\");\n    input.min = String(limits.min);\n    input.max = String(limits.max);\n    input.value = String(group.top);\n    card.querySelector(\".lower-button\").setAttribute(\"aria-disabled\", String(group.top <= limits.min));\n    card.querySelector(\".raise-button\").setAttribute(\"aria-disabled\", String(group.top >= limits.max));\n  });\n  els[\"add-group-button\"].disabled = state.groups.length >= MAX_GROUPS || !lastGroupCanSplit();\n}\n\nfunction lastGroupCanSplit() {\n  return groupStart(state.groups.length - 1) <= HIGHEST_TOP;\n}\n\nfunction renderTable() {\n  const rows = state.sortByItems\n    ? [...ROOMS].sort((a, b) => a.items - b.items)\n    : ROOMS;\n  const body = els[\"table-body\"];\n  body.textContent = \"\";\n\n  rows.forEach((room) => {\n    const index = findGroupIndex(room.items);\n    const row = document.createElement(\"tr\");\n    const moved = state.movedRoomIds.indexOf(room.id) !== -1;\n    if (moved) {\n      row.className = \"row-moved\";\n    }\n\n    const idCell = document.createElement(\"th\");\n    idCell.scope = \"row\";\n    idCell.textContent = room.name;\n\n    const itemsCell = document.createElement(\"td\");\n    itemsCell.className = \"number-col\";\n    itemsCell.textContent = formatNumber(room.items);\n\n    const groupCell = document.createElement(\"td\");\n    groupCell.className = \"group-cell\";\n    const chip = document.createElement(\"span\");\n    chip.className = `group-chip group-color-${colorSlotFor(index)}`;\n    if (!state.groups[index].name.trim()) {\n      chip.classList.add(\"is-unnamed\");\n    }\n    chip.textContent = groupDisplayName(index);\n    groupCell.appendChild(chip);\n\n    if (moved) {\n      const tag = document.createElement(\"span\");\n      tag.className = \"moved-tag\";\n      tag.textContent = \"Moved\";\n      groupCell.appendChild(tag);\n    }\n\n    row.append(idCell, itemsCell, groupCell);\n    body.appendChild(row);\n  });\n}\n\nfunction trackMoves(before) {\n  const after = currentAssignments();\n  state.movedRoomIds = ROOMS\n    .filter((room) => before[room.id] !== after[room.id])\n    .map((room) => room.id);\n}\n\nfunction movedSentence() {\n  const moved = ROOMS\n    .filter((room) => state.movedRoomIds.indexOf(room.id) !== -1)\n    .map((room) => room.name);\n  if (moved.length === 0) {\n    return \"No rooms changed groups.\";\n  }\n  if (pluralRules.select(moved.length) === \"one\") {\n    return `Room ${moved[0]} changed groups.`;\n  }\n  return `Rooms ${formatList(moved)} changed groups.`;\n}\n\nfunction announce(message) {\n  els.announcer.textContent = \"\";\n  window.setTimeout(() => {\n    els.announcer.textContent = message;\n  }, 50);\n}\n\nfunction changeTop(index, requested) {\n  const group = state.groups[index];\n  const limits = topLimits(index);\n  const value = Math.min(Math.max(requested, limits.min), limits.max);\n\n  if (value === group.top) {\n    updateGroupDetails();\n    if (requested > limits.max) {\n      announce(`Group ${index + 1} can't go any higher. The next group needs at least one number.`);\n    } else if (requested < limits.min) {\n      announce(`Group ${index + 1} can't go any lower. It needs at least one number.`);\n    }\n    return;\n  }\n\n  const before = currentAssignments();\n  group.top = value;\n  setActivePerspective(null);\n  trackMoves(before);\n  updateGroupDetails();\n  renderTable();\n  announce(`Group ${index + 1} now covers ${rangeText(index)}. ${movedSentence()}`);\n}\n\nfunction addGroup() {\n  if (state.groups.length >= MAX_GROUPS || !lastGroupCanSplit()) {\n    return;\n  }\n  const before = currentAssignments();\n  const lastIndex = state.groups.length - 1;\n  const start = groupStart(lastIndex);\n  state.groups[lastIndex].top = start + Math.floor((HIGHEST_TOP - start) / 2);\n  state.groups.push(createGroup(\"\", null));\n  setActivePerspective(null);\n  trackMoves(before);\n  renderGroups();\n  renderTable();\n\n  const newIndex = state.groups.length - 1;\n  els[\"group-list\"].children[newIndex].querySelector(\"input[type='text']\").focus();\n  announce(`Added group ${newIndex + 1}. It covers ${rangeText(newIndex)}. ${movedSentence()}`);\n}\n\nfunction removeGroup(index) {\n  if (state.groups.length <= MIN_GROUPS) {\n    return;\n  }\n  const before = currentAssignments();\n  if (isLastGroup(index)) {\n    state.groups.pop();\n    state.groups[state.groups.length - 1].top = null;\n  } else {\n    const removedTop = state.groups[index].top;\n    state.groups.splice(index, 1);\n    if (index > 0) {\n      state.groups[index - 1].top = removedTop;\n    }\n  }\n  trackMoves(before);\n  setActivePerspective(null);\n  renderGroups();\n  renderTable();\n\n  const focusIndex = Math.min(index, state.groups.length - 1);\n  els[\"group-list\"].children[focusIndex].querySelector(\"input[type='text']\").focus();\n  announce(`Removed group ${index + 1}. ${movedSentence()}`);\n}\n\nfunction toggleSort() {\n  state.sortByItems = !state.sortByItems;\n  els[\"sort-button\"].setAttribute(\"aria-pressed\", String(state.sortByItems));\n  els[\"sort-button\"].textContent = state.sortByItems ? \"Sort by room\" : \"Sort by items on floor\";\n  renderTable();\n  announce(state.sortByItems\n    ? \"The table is now sorted from fewest items to most items.\"\n    : \"The table is now back in room order.\");\n}\n\nfunction setActivePerspective(key) {\n  document.querySelectorAll(\".perspective-button\").forEach((button) => {\n    button.setAttribute(\"aria-pressed\", String(button.dataset.perspective === key));\n  });\n}\n\nfunction showPerspective(key) {\n  const perspective = PERSPECTIVES[key];\n  loadGroups(perspective.groups);\n  setActivePerspective(key);\n  renderGroups();\n  renderTable();\n  announce(perspective.announcement);\n}\n\nfunction setUpPerspectives() {\n  const container = document.getElementById(\"perspective-buttons\");\n  if (!SHOW_PERSPECTIVES || !container) {\n    return;\n  }\n  container.hidden = false;\n  container.querySelectorAll(\".perspective-button\").forEach((button) => {\n    button.addEventListener(\"click\", () => showPerspective(button.dataset.perspective));\n  });\n}\n\nfunction startOver() {\n  resetGroups();\n  setActivePerspective(null);\n  renderGroups();\n  renderTable();\n  announce(\"Your groups are back to how they started.\");\n}\n\nfunction showError() {\n  const message = document.getElementById(\"error-message\");\n  if (message) {\n    message.textContent = \"Something went wrong loading this activity. Please reload the page and try again.\";\n    message.hidden = false;\n  }\n}\n\nfunction init() {\n  try {\n    [\"group-list\", \"add-group-button\", \"table-body\", \"sort-button\", \"reset-button\", \"announcer\"].forEach((id) => {\n      els[id] = document.getElementById(id);\n      if (!els[id]) {\n        throw new Error(`Missing element: ${id}`);\n      }\n    });\n\n    els[\"add-group-button\"].addEventListener(\"click\", addGroup);\n    els[\"sort-button\"].addEventListener(\"click\", toggleSort);\n    els[\"reset-button\"].addEventListener(\"click\", startOver);\n\n    setUpPerspectives();\n    resetGroups();\n    renderGroups();\n    renderTable();\n  } catch (error) {\n    showError();\n  }\n}\n\ninit();",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": ":root {\n  --color-bg: #fafafa;\n  --color-surface: #ffffff;\n  --color-border: #dbdbdb;\n  --color-text: #262626;\n  --color-muted: #595959;\n  --color-accent: #c0186a;\n  --color-focus: #0b57d0;\n  --color-error-bg: #fdecea;\n  --color-error-text: #8a1c12;\n  --group-1-bg: #dcf3e3;\n  --group-1-edge: #1e7b3c;\n  --group-1-text: #12512a;\n  --group-2-bg: #fff1c2;\n  --group-2-edge: #9a6b00;\n  --group-2-text: #5c4100;\n  --group-3-bg: #ffe0c7;\n  --group-3-edge: #c2560c;\n  --group-3-text: #7a3306;\n  --group-4-bg: #fddcdc;\n  --group-4-edge: #c0262d;\n  --group-4-text: #7f1419;\n  --radius: 12px;\n  --font: \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\nhtml,\nbody {\n  margin: 0;\n}\n\nbody {\n  background: var(--color-bg);\n  color: var(--color-text);\n  font-family: var(--font);\n  font-size: 0.9375rem;\n  line-height: 1.4;\n}\n\n.app {\n  max-width: 1000px;\n  margin: 0 auto;\n  padding: 6px 14px 8px;\n}\n\n.top-bar {\n  display: flex;\n  margin-block-end: 8px;\n  align-items: center;\n  gap: 10px;\n  padding-block-end: 6px;\n  border-block-end: 1px solid var(--color-border);\n}\n\n.brand-logo {\n  width: 32px;\n  height: 32px;\n  flex-shrink: 0;\n}\n\n.brand-name {\n  margin: 0;\n  font-size: 0.75rem;\n  font-weight: 600;\n  color: var(--color-muted);\n}\n\n.page-title {\n  margin: 0;\n  font-size: 1.25rem;\n  line-height: 1.2;\n}\n\n.error-message {\n  margin: 0 0 10px;\n  padding: 10px 12px;\n  border-radius: var(--radius);\n  background: var(--color-error-bg);\n  color: var(--color-error-text);\n}\n\n.workspace {\n  display: grid;\n  grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);\n  gap: 12px;\n  align-items: start;\n}\n\n.panel {\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius);\n  padding: 8px 12px 10px;\n}\n\n.panel-header {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 6px;\n  margin-block-end: 6px;\n}\n\n.panel-header h2 {\n  margin: 0;\n  font-size: 1rem;\n}\n\ninput[type=\"text\"],\ninput[type=\"number\"] {\n  min-height: 32px;\n  padding: 3px 8px;\n  border: 1px solid #8e8e8e;\n  border-radius: 8px;\n  background: var(--color-surface);\n  color: var(--color-text);\n  font: inherit;\n}\n\ninput[type=\"number\"] {\n  width: 3.25em;\n  text-align: center;\n  -moz-appearance: textfield;\n}\n\ninput[type=\"number\"]::-webkit-inner-spin-button,\ninput[type=\"number\"]::-webkit-outer-spin-button {\n  -webkit-appearance: none;\n  margin: 0;\n}\n\n.group-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  gap: 6px;\n}\n\n.group-card {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto auto;\n  align-items: center;\n  gap: 6px;\n  border-radius: 10px;\n  border-inline-start: 6px solid var(--group-edge);\n  background: var(--group-bg);\n  color: var(--group-text);\n  padding: 6px 8px;\n}\n\n.group-name {\n  width: 100%;\n  min-width: 0;\n  font-weight: 600;\n}\n\n.range {\n  display: inline-flex;\n  justify-self: end;\n  justify-content: flex-end;\n  min-width: 10.25em;\n  align-items: center;\n  gap: 4px;\n}\n\n.range-text {\n  min-width: 3.25em;\n  text-align: end;\n  font-weight: 600;\n  white-space: nowrap;\n}\n\n.group-color-1 {\n  --group-bg: var(--group-1-bg);\n  --group-edge: var(--group-1-edge);\n  --group-text: var(--group-1-text);\n}\n\n.group-color-2 {\n  --group-bg: var(--group-2-bg);\n  --group-edge: var(--group-2-edge);\n  --group-text: var(--group-2-text);\n}\n\n.group-color-3 {\n  --group-bg: var(--group-3-bg);\n  --group-edge: var(--group-3-edge);\n  --group-text: var(--group-3-text);\n}\n\n.group-color-4 {\n  --group-bg: var(--group-4-bg);\n  --group-edge: var(--group-4-edge);\n  --group-text: var(--group-4-text);\n}\n\n.icon-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 32px;\n  height: 32px;\n  padding: 0;\n  border: 1px solid var(--group-edge, #8e8e8e);\n  border-radius: 50%;\n  background: var(--color-surface);\n  color: var(--group-text, var(--color-text));\n  cursor: pointer;\n}\n\n.icon-button svg {\n  width: 16px;\n  height: 16px;\n}\n\n.remove-button {\n  border-color: transparent;\n  background: transparent;\n}\n\n.icon-button[aria-disabled=\"true\"] {\n  opacity: 0.4;\n  cursor: not-allowed;\n}\n\n.group-actions {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 6px 10px;\n  margin-block-start: 8px;\n}\n\n.secondary-button {\n  min-height: 36px;\n  padding: 6px 14px;\n  border: 0;\n  border-radius: 8px;\n  background: var(--color-accent);\n  color: #ffffff;\n  font: inherit;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.secondary-button:disabled {\n  background: #c7c7c7;\n  color: #3d3d3d;\n  cursor: not-allowed;\n}\n\n.text-button {\n  min-height: 30px;\n  padding: 2px 6px;\n  border: 0;\n  border-radius: 6px;\n  background: transparent;\n  color: var(--color-accent);\n  font: inherit;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.table-wrap {\n  overflow-x: auto;\n}\n\n.data-table {\n  width: 100%;\n  border-collapse: collapse;\n}\n\n.data-table th,\n.data-table td {\n  padding: 4px 8px;\n  border-block-end: 1px solid #efefef;\n  text-align: start;\n}\n\n.data-table thead th {\n  font-size: 0.8125rem;\n  color: var(--color-muted);\n  border-block-end: 1px solid var(--color-border);\n}\n\n.data-table .number-col {\n  text-align: end;\n  font-variant-numeric: tabular-nums;\n}\n\n.data-table .new-col {\n  color: var(--color-accent);\n}\n\n.group-cell {\n  white-space: nowrap;\n}\n\n.group-chip {\n  display: inline-block;\n  padding: 1px 10px;\n  border-radius: 999px;\n  border: 1px solid var(--group-edge);\n  background: var(--group-bg);\n  color: var(--group-text);\n  font-weight: 600;\n  font-size: 0.875rem;\n}\n\n.group-chip.is-unnamed {\n  font-weight: 400;\n  font-style: italic;\n}\n\n.row-moved th,\n.row-moved td {\n  background: #fffbe0;\n}\n\n.moved-tag {\n  margin-inline-start: 6px;\n  font-size: 0.75rem;\n  font-weight: 700;\n  color: #6b4e00;\n}\n\nbutton:focus-visible,\ninput:focus-visible {\n  outline: 3px solid var(--color-focus);\n  outline-offset: 2px;\n}\n\n.perspective-buttons {\n  display: flex;\n  gap: 6px;\n  margin-inline-start: auto;\n}\n\n.perspective-buttons[hidden] {\n  display: none;\n}\n\n.perspective-button {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  min-height: 32px;\n  padding: 3px 10px 3px 8px;\n  border: 1px solid var(--color-border);\n  border-radius: 999px;\n  background: var(--color-surface);\n  color: var(--color-text);\n  font: inherit;\n  font-size: 0.8125rem;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.perspective-button svg {\n  width: 18px;\n  height: 18px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.perspective-button[aria-pressed=\"true\"] {\n  border-color: var(--color-accent);\n  background: var(--color-accent);\n  color: #ffffff;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n@media (max-width: 600px) {\n  .workspace {\n    grid-template-columns: 1fr;\n  }\n}",
          "folderId": "0",
          "active": false
        },
