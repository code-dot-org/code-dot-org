      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <meta charset=\"utf-8\" />\n    <title id=\"pageTitle\">Campus Jobs</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <main id=\"mainContainer\" class=\"page\">\n      <header id=\"header\">\n        <h1 id=\"heading\">Latest Campus Jobs</h1>\n        <p id=\"subtitle\">Check out today’s featured jobs.</p>\n      </header>\n\n      <section id=\"cardContainer\" class=\"card-container\"></section>\n    </main>\n\n    <script src=\"helpers.js\"></script>\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  margin: 0;\n  font-family: Arial, sans-serif;\n  background: #eef1f6;\n  color: #14213d;\n}\n\n#mainContainer {\n  max-width: 1100px;\n  margin: 0 auto;\n  padding: 32px 16px 40px;\n}\n\n#header {\n  margin-bottom: 20px;\n}\n\n#heading {\n  margin: 0 0 8px;\n  font-size: 2rem;\n}\n\n#subtitle {\n  margin: 0;\n  font-size: 0.95rem;\n  color: #5f687a;\n}\n\n/* ---------- CARD VIEW ---------- */\n\n#cardContainer {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(260px, 320px));\n  gap: 20px;\n}\n\n.card {\n  background: #ffffff;\n  border-radius: 16px;\n  padding: 12px;\n  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);\n}\n\n.card-image {\n  width: 100%;\n  height: 200px;\n  object-fit: cover;\n  border-radius: 12px;\n}\n\n.card-body {\n  padding: 12px 4px 0;\n}\n\n.card-title {\n  margin: 0 0 6px;\n  font-size: 1.4rem;\n}\n\n.card-description {\n  margin: 0 0 12px;\n  font-size: 0.9rem;\n  color: #5f687a;\n}\n\n.card-badge {\n  display: inline-block;\n  padding: 4px 10px;\n  border-radius: 8px;\n  background: #e6f4ea;\n  color: #2e7d32;\n  font-size: 0.75rem;\n  font-weight: 600;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const campusJobs = [\n  {\n    company: \"Campus Café\",\n    role: \"Barista\",\n    location: \"Student Center\",\n    pay: \"$14/hr\",\n    image: \"images/cafe.png\"\n  },\n  {\n    company: \"University Library\",\n    role: \"Front Desk Assistant\",\n    location: \"Main Library\",\n    pay: \"$13/hr\",\n    image: \"images/library.png\"\n  },\n  {\n    company: \"IT Help Desk\",\n    role: \"Tech Support\",\n    location: \"Tech Building\",\n    pay: \"$15/hr\",\n    image: \"images/it.png\"\n  }\n];\n\ncampusJobs.map(job => {\n  createCard(job.image, job.company, job.role, job.pay)\n}) \n",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
          "name": "library.png",
          "contents": "",
          "folderId": "1",
          "url": "/level_starter_assets/building-data-driven-systems-lesson6-level1c-v1-2026/uuid/4e05d0dd-9298-45df-8ee7-ea887b451afc.png",
          "type": "starter",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "it.png",
          "contents": "",
          "folderId": "1",
          "url": "/level_starter_assets/building-data-driven-systems-lesson6-level1c-v1-2026/uuid/3014deb7-6bbe-4c77-84dc-b9538fe38d7d.png",
          "type": "starter",
          "active": false
        },
        "6": {
          "id": "6",
          "name": "cafe.png",
          "contents": "",
          "folderId": "1",
          "url": "/level_starter_assets/building-data-driven-systems-lesson6-level1c-v1-2026/uuid/c83b7ed7-5628-4722-b1a8-1a7edb9e7d67.png",
          "type": "starter",
          "active": false
        },
        "7": {
          "id": "7",
          "name": "helpers.js",
          "contents": "let cardCount = 0;\n\nconst createCard = (imageSrc, title, description, badgeText) => {\n  const container = document.getElementById(\"cardContainer\");\n\n  const card = document.createElement(\"article\");\n  card.className = \"card\";\n  card.id = \"card\" + cardCount;\n\n  const image = document.createElement(\"img\");\n  image.className = \"card-image\";\n  image.id = \"image\" + cardCount;\n  image.src = imageSrc;\n  image.alt = title;\n\n  const body = document.createElement(\"div\");\n  body.className = \"card-body\";\n  body.id = \"body\" + cardCount;\n\n  const heading = document.createElement(\"h2\");\n  heading.className = \"card-title\";\n  heading.id = \"title\" + cardCount;\n  heading.textContent = title;\n\n  const descriptionEl = document.createElement(\"p\");\n  descriptionEl.className = \"card-description\";\n  descriptionEl.id = \"description\" + cardCount;\n  descriptionEl.textContent = description;\n\n  const badge = document.createElement(\"div\");\n  badge.className = \"card-badge\";\n  badge.id = \"badge\" + cardCount;\n  badge.textContent = badgeText;\n\n  body.appendChild(heading);\n  body.appendChild(descriptionEl);\n  body.appendChild(badge);\n\n  card.appendChild(image);\n  card.appendChild(body);\n\n  container.appendChild(card);\n\n  cardCount++;\n};",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "3"
      ]
    },
