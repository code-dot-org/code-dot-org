      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Campus Jobs</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <main class=\"app\">\n      <header class=\"app-header\">\n        <p class=\"eyebrow\">Student Work Hub</p>\n        <h1>Campus Jobs</h1>\n        <p class=\"subtitle\">Find part-time jobs around campus.</p>\n      </header>\n\n      <section class=\"jobs-section\">\n        <h2>Open Positions</h2>\n        <div id=\"jobContainer\" class=\"job-container\"></div>\n      </section>\n    </main>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  font-family: Inter, Arial, sans-serif;\n  background: #f4f6fb;\n  color: #1f2937;\n}\n\n.app {\n  max-width: 480px;\n  margin: 0 auto;\n  min-height: 100vh;\n  background: #ffffff;\n}\n\n/* Header */\n.app-header {\n  padding: 26px 20px 18px;\n  border-bottom: 1px solid #e5e7eb;\n  background: #eef2ff;\n}\n\n.eyebrow {\n  margin: 0 0 4px;\n  font-size: 0.8rem;\n  text-transform: uppercase;\n  color: #6366f1;\n}\n\n.app-header h1 {\n  margin: 0;\n  font-size: 1.8rem;\n  font-weight: 700;\n}\n\n.subtitle {\n  margin: 6px 0 0;\n  font-size: 0.95rem;\n  color: #6b7280;\n}\n\n/* Section */\n.jobs-section {\n  padding: 20px;\n}\n\n.jobs-section h2 {\n  margin: 0 0 12px;\n  font-size: 1.1rem;\n  font-weight: 700;\n}\n\n/* Container */\n.job-container {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n/* Card */\n.job-card {\n  display: flex;\n  gap: 12px;\n  padding: 12px;\n  border-radius: 14px;\n  border: 1px solid #e5e7eb;\n  background: #ffffff;\n}\n\n/* Image */\n.job-image {\n  width: 72px;\n  height: 72px;\n  border-radius: 12px;\n  object-fit: cover;\n  flex-shrink: 0;\n}\n\n/* Content */\n.job-content {\n  flex: 1;\n}\n\n.job-role {\n  margin: 0 0 2px;\n  font-size: 1rem;\n  font-weight: 700;\n}\n\n.job-company {\n  margin: 0;\n  font-size: 0.85rem;\n  color: #6366f1;\n  font-weight: 600;\n}\n\n.job-location {\n  margin: 4px 0 0;\n  font-size: 0.85rem;\n  color: #6b7280;\n}\n\n.job-pay {\n  margin: 6px 0 0;\n  font-size: 0.9rem;\n  font-weight: 700;\n  color: #111827;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const jobContainer = document.getElementById(\"jobContainer\");\n\nconst campusJobs = [\n  {\n    company: \"Campus Café\",\n    role: \"Barista\",\n    location: \"Student Center\",\n    pay: \"$14/hr\",\n    image: \"images/cafe.png\"\n  },\n  {\n    company: \"University Library\",\n    role: \"Front Desk Assistant\",\n    location: \"Main Library\",\n    pay: \"$13/hr\",\n    image: \"images/library.png\"\n  },\n  {\n    company: \"IT Help Desk\",\n    role: \"Tech Support\",\n    location: \"Tech Building\",\n    pay: \"$15/hr\",\n    image: \"images/it.png\"\n  }\n];\n\nconst jobCards = campusJobs.map((job) => {\n  return `\n    <div class=\"job-card\">\n      <img class=\"job-image\" src=\"${job.image}\" alt=\"${job.company}\">\n      <div class=\"job-content\">\n        <h3 class=\"job-role\">${job.role}</h3>\n        <p class=\"job-company\">${job.company}</p>\n        <p class=\"job-location\">${job.location}</p>\n        <p class=\"job-pay\">${job.pay}</p>\n      </div>\n    </div>\n  `;\n});\n\njobContainer.innerHTML = jobCards.join(\"\");",
          "folderId": "0",
          "active": true
        },
