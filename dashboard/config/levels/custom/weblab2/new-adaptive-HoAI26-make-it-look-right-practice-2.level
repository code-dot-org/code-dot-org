<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-11-03T03:31:48.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": true,
    "start_sources": {
      "folders": {
      },
      "files": {
        "62d0a8cf-afb6-4846-82fb-34f69e92c3ea": {
          "id": "62d0a8cf-afb6-4846-82fb-34f69e92c3ea",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Readability Practice</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <h1>Make It Look Right: Readability</h1>\n    <p>Use the toggles to see how text and background colors affect readability, then apply a fix.</p>\n\n    <div class=\"content-box\" id=\"textContainer\">\n        <h2>The Quick Brown Fox Jumps Over The Lazy Dog</h2>\n        <p>This is an example paragraph. The purpose here is to observe how different text and background color combinations impact the ease with which you can read this content.</p>\n        <p>Good contrast is essential for accessibility and a positive user experience. Without enough contrast, readers might struggle to understand the message or strain their eyes.</p>\n    </div>\n\n    <div class=\"prompt-controls\">\n        <h2>Readability Controls</h2>\n        <div class=\"control-item\">\n            <label for=\"lowContrastLight\">Low Contrast (Light)</label>\n            <label class=\"switch\">\n                <input type=\"checkbox\" id=\"lowContrastLight\">\n                <span class=\"slider\"></span>\n            </label>\n        </div>\n        <div class=\"control-item\">\n            <label for=\"lowContrastDark\">Low Contrast (Dark)</label>\n            <label class=\"switch\">\n                <input type=\"checkbox\" id=\"lowContrastDark\">\n                <span class=\"slider\"></span>\n            </label>\n        </div>\n        <div class=\"control-item\">\n            <label for=\"highContrastFix\">Apply High Contrast Fix</label>\n            <label class=\"switch\">\n                <input type=\"checkbox\" id=\"highContrastFix\">\n                <span class=\"slider\"></span>\n            </label>\n        </div>\n    </div>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "45edee84-c8d6-40e2-88b4-8dce45754c04": {
          "id": "45edee84-c8d6-40e2-88b4-8dce45754c04",
          "name": "style.css",
          "contents": "body {\n    font-family: Arial, sans-serif;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    min-height: 100vh;\n    background-color: #f4f4f4;\n    color: #333;\n    margin: 0;\n    padding: 20px;\n    box-sizing: border-box;\n}\n\nh1 {\n    color: #0056b3;\n    margin-bottom: 10px;\n}\n\np {\n    margin-bottom: 25px;\n    text-align: center;\n    max-width: 600px;\n}\n\n.content-box {\n    background-color: white;\n    color: #333; /* Default readable contrast */\n    padding: 30px;\n    border-radius: 10px;\n    box-shadow: 0 4px 10px rgba(0,0,0,0.1);\n    margin-bottom: 30px;\n    width: 90%;\n    max-width: 600px;\n    line-height: 1.6;\n    transition: background-color 0.3s ease, color 0.3s ease;\n}\n\n.content-box h2 {\n    margin-top: 0;\n    font-size: 1.8em;\n}\n\n/* Low Contrast (Light) */\n.content-box.bad-contrast-light {\n    background-color: #f8f8f8;\n    color: #ccc;\n}\n\n/* Low Contrast (Dark) */\n.content-box.bad-contrast-dark {\n    background-color: #444;\n    color: #666;\n}\n\n/* High Contrast Fix */\n.content-box.fixed-contrast {\n    background-color: black;\n    color: white;\n}\n\n/* Prompt Dial Controls Styling (reused from previous levels) */\n.prompt-controls {\n    background-color: #fff;\n    padding: 25px;\n    border-radius: 10px;\n    box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n    display: flex;\n    flex-direction: column;\n    gap: 15px;\n    width: 90%;\n    max-width: 600px;\n}\n.prompt-controls p {\n    font-style: italic;\n    color: #666;\n    margin-top: 0;\n    margin-bottom: 5px;\n}\n.control-item {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n}\n.control-item label {\n    font-size: 1.1em;\n    color: #555;\n}\n.switch {\n    position: relative;\n    display: inline-block;\n    width: 40px;\n    height: 24px;\n}\n.switch input {\n    opacity: 0;\n    width: 0;\n    height: 0;\n}\n.slider {\n    position: absolute;\n    cursor: pointer;\n    top: 0;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    background-color: #ccc;\n    -webkit-transition: .4s;\n    transition: .4s;\n    border-radius: 24px;\n}\n.slider:before {\n    position: absolute;\n    content: \"\";\n    height: 16px;\n    width: 16px;\n    left: 4px;\n    bottom: 4px;\n    background-color: white;\n    -webkit-transition: .4s;\n    transition: .4s;\n    border-radius: 50%;\n}\ninput:checked + .slider {\n    background-color: #2196F3;\n}\ninput:focus + .slider {\n    box-shadow: 0 0 1px #2196F3;\n}\ninput:checked + .slider:before {\n    -webkit-transform: translateX(16px);\n    -ms-transform: translateX(16px);\n    transform: translateX(16px);\n}\n",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "21723921-3748-4786-b7e4-577dc54f9e6d": {
          "id": "21723921-3748-4786-b7e4-577dc54f9e6d",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const textContainer = document.getElementById('textContainer');\n    const lowContrastLightToggle = document.getElementById('lowContrastLight');\n    const lowContrastDarkToggle = document.getElementById('lowContrastDark');\n    const highContrastFixToggle = document.getElementById('highContrastFix');\n\n    function updateReadability() {\n        // Remove all relevant classes first\n        textContainer.classList.remove('bad-contrast-light', 'bad-contrast-dark', 'fixed-contrast');\n\n        if (highContrastFixToggle.checked) {\n            textContainer.classList.add('fixed-contrast');\n            // When fix is on, ensure other low contrast toggles are off and disabled\n            lowContrastLightToggle.checked = false;\n            lowContrastDarkToggle.checked = false;\n            lowContrastLightToggle.disabled = true;\n            lowContrastDarkToggle.disabled = true;\n        } else {\n            // Re-enable low contrast toggles if fix is off\n            lowContrastLightToggle.disabled = false;\n            lowContrastDarkToggle.disabled = false;\n\n            if (lowContrastLightToggle.checked) {\n                textContainer.classList.add('bad-contrast-light');\n                lowContrastDarkToggle.checked = false; // Ensure mutual exclusivity\n            } else if (lowContrastDarkToggle.checked) {\n                textContainer.classList.add('bad-contrast-dark');\n                lowContrastLightToggle.checked = false; // Ensure mutual exclusivity\n            }\n        }\n    }\n\n    // Event listeners for low contrast toggles to handle mutual exclusivity and update\n    lowContrastLightToggle.addEventListener('change', () => {\n        if (lowContrastLightToggle.checked) {\n            lowContrastDarkToggle.checked = false; // Uncheck the other if this is checked\n        }\n        updateReadability();\n    });\n\n    lowContrastDarkToggle.addEventListener('change', () => {\n        if (lowContrastDarkToggle.checked) {\n            lowContrastLightToggle.checked = false; // Uncheck the other if this is checked\n        }\n        updateReadability();\n    });\n\n    // Event listener for the fix toggle\n    highContrastFixToggle.addEventListener('change', updateReadability);\n\n    // Initial update to set correct state\n    updateReadability();\n});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
        "62d0a8cf-afb6-4846-82fb-34f69e92c3ea",
        "45edee84-c8d6-40e2-88b4-8dce45754c04",
        "21723921-3748-4786-b7e4-577dc54f9e6d"
      ]
    },
    "long_instructions": "TODOs:\r\n- Open index.html to view the sample text and readability controls.\r\n- Toggle \"Low Contrast (Light)\" to see an example of hard-to-read text.\r\n- Toggle \"Low Contrast (Dark)\" to see another example of poor contrast.\r\n- Observe how these combinations make the content difficult to read.\r\n- Toggle \"Apply High Contrast Fix\" to instantly make the text clear and readable.\r\n- Understand how selecting the right prompt can ensure good contrast and readability.",
