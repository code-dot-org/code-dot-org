        "19": {
          "id": "19",
          "name": "styles.css",
          "contents": "/* styles.css\n   Intentionally BAD UX defaults (for the APP preview only):\n   - Low contrast\n   - Tiny text + poor font choice\n   - Cramped spacing\n   - Awkward nav placement + tiny tap targets\n\n   NOTE: The control panel is intentionally styled to be clean/readable\n   so students can use it without fighting it.\n*/\n\n/* ================= */\n/* App Theme Defaults */\n/* ================= */\n:root{\n  --bg:#f6f6f6;\n  --text:#cfcfcf;\n  --muted:#d7d7d7;\n\n  --border:#efefef;\n  --card:#f7f7f7;\n\n  --btn-bg:#e9e9e9;\n  --btn-text:#d8d8d8;\n  --btn-border:#ededed;\n\n  --base:12px;\n  --lh:1.1;\n  --gap:6px;\n\n  /* nav sizing vars (JS can update these) */\n  --nav-font:9px;\n  --nav-icon:16px;\n\n  --card-text: 11px;\n  --card-lh: 1.10;\n}\n\n*{box-sizing:border-box;}\n\nbody{\n  margin:0;\n  background:#fff;\n}\n\n/* ======================= */\n/* Split Layout (Controls | App) */\n/* ======================= */\n.layout{\n  display:grid;\n  grid-template-columns: 340px 1fr;\n  min-height:100vh;\n}\n\n/* ======================= */\n/* CONTROL PANEL (GOOD UI) */\n/* ======================= */\n.controls{\n  background:#0f172a;\n  color:#e5e7eb;\n  padding:16px;\n  border-right:1px solid #0b1220;\n  position:sticky;\n  top:0;\n  height:100vh;\n  overflow:auto;\n\n  font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, \"Noto Sans\", \"Liberation Sans\", sans-serif;\n  line-height:1.4;\n}\n\n.controls h2{\n  margin:0 0 12px 0;\n  font-size:16px;\n  font-weight:650;\n  letter-spacing:0.2px;\n}\n\n.control-group{\n  background:#111c34;\n  border:1px solid rgba(255,255,255,0.08);\n  border-radius:10px;\n  padding:12px;\n  margin-bottom:12px;\n}\n\n.control-group h3{\n  margin:0 0 10px 0;\n  font-size:13px;\n  font-weight:650;\n  color:#f3f4f6;\n}\n\n.controls label{\n  display:block;\n  margin:10px 0 6px 0;\n  font-size:12px;\n  color:#d1d5db;\n}\n\n.controls select{\n  width:100%;\n  padding:8px 10px;\n  border-radius:8px;\n  border:1px solid rgba(255,255,255,0.12);\n  background:#0b1220;\n  color:#f3f4f6;\n  outline:none;\n}\n\n.controls input[type=\"range\"]{\n  width:100%;\n}\n\n.controls input[type=\"checkbox\"]{\n  transform: translateY(1px);\n  margin-right:8px;\n}\n\n.controls button{\n  width:100%;\n  padding:9px 10px;\n  border-radius:10px;\n  border:1px solid rgba(255,255,255,0.14);\n  background:#111827;\n  color:#f3f4f6;\n  font-size:13px;\n  font-weight:600;\n  cursor:pointer;\n  margin-top:8px;\n}\n\n.controls button:hover{\n  background:#0b1220;\n}\n\n.controls button:active{\n  transform: translateY(1px);\n}\n\n/* ======================= */\n/* APP PREVIEW WRAPPER */\n/* (Bad UX styles scoped here) */\n/* ======================= */\n.app{\n  background:var(--bg);\n  color:var(--text);\n  font-family:\"Times New Roman\", Times, serif;\n  font-size:var(--base);\n  line-height:var(--lh);\n  min-height:100vh;\n}\n\n/* =============== */\n/* Header (cramped) */\n/* =============== */\n.app header{\n  display:flex;\n  justify-content:space-between;\n  align-items:center;\n  padding:6px 6px 2px 6px;\n  border-bottom:1px solid var(--border);\n  background:transparent;\n}\n\n.app header img{\n  width:28px;\n  height:28px;\n}\n\n.app header span{\n  font-size:12px;\n  font-weight:400;\n  margin-left:4px;\n}\n\n.app header a{\n  color:var(--muted);\n  text-decoration:none;\n  font-size:10px;\n}\n\n/* ===== */\n/* Hero  */\n/* ===== */\n.app section{\n  padding:8px;\n}\n\n.app section img{\n  width:100%;\n  height:auto;\n  display:block;\n  border:1px solid var(--border);\n}\n\n.app section h1{\n  margin:6px 0 4px 0;\n  font-size:16px;\n  font-weight:400;\n}\n\n.app section p{\n  margin:0;\n  font-size:12px;\n  color:var(--muted);\n}\n\n/* Make hero text hard to read on top of the image */\n.app section:nth-of-type(1){\n  position:relative;\n  padding:0;\n}\n\n.app section:nth-of-type(1) img{\n  height:280px;\n  object-fit:cover;\n  filter:contrast(0.9) brightness(1.05);\n}\n\n.app section:nth-of-type(1) div{\n  position:absolute;\n  top:18px;\n  left:10px;\n  max-width:280px;\n  padding:6px 8px;\n  background:rgba(255,255,255,0.25);\n  border:1px solid rgba(255,255,255,0.25);\n}\n\n/* ========= */\n/* Filters   */\n/* ========= */\n.app section:nth-of-type(2){\n  border:1px solid var(--border);\n  background:var(--card);\n  margin:6px;\n  padding:6px;\n}\n\n.app section:nth-of-type(2) h2{\n  margin:0 0 6px 0;\n  font-size:12px;\n  font-weight:400;\n}\n\n.app section:nth-of-type(2) input,\n.app section:nth-of-type(2) select{\n  font-size:11px;\n  padding:3px 4px;\n  border:1px solid var(--border);\n  background:#fafafa;\n  color:#bdbdbd;\n  width:120px;\n  margin-right:4px;\n  margin-bottom:4px;\n}\n\n.app section:nth-of-type(2) button{\n  border:1px solid var(--btn-border);\n  background:var(--btn-bg);\n  color:var(--btn-text);\n  font-size:11px;\n  padding:4px 6px;\n  cursor:pointer;\n}\n\n/* ========= */\n/* Pet Grid  */\n/* ========= */\n.app main{\n  padding:8px;\n  padding-bottom:80px;\n  display:grid;\n  grid-template-columns:repeat(3, 1fr);\n  gap:var(--gap);\n}\n\n.app article{\n  background:var(--card);\n  border:1px solid var(--border);\n  padding:6px;\n}\n\n.app article img{\n  width:100%;\n  height:160px;\n  object-fit:cover;\n  border:1px solid var(--border);\n}\n\n/* Toggle: show full portrait photos (no cropping) */\n.app.fit-portrait article img{\n  height:260px;        /* taller so portraits can fit */\n  object-fit:contain;  /* no cropping */\n  background:#fff;     /* letterbox */\n}\n\n.app article h3{\n  margin:6px 0 2px 0;\n  font-size: calc(var(--card-text) + 2px);\n  font-weight:400;\n}\n\n.app article p{\n  margin:0 0 4px 0;\n  font-size: var(--card-text);\n  line-height: var(--card-lh);\n  color:var(--muted);\n}\n\n.app article button{\n  border:1px solid var(--btn-border);\n  background:var(--btn-bg);\n  color:var(--btn-text);\n  font-size:11px;\n  padding:4px 6px;\n  cursor:pointer;\n  margin-right:4px;\n}\n\n.app article button:active{\n  transform:translateY(1px);\n}\n\n/* ======= */\n/* Footer  */\n/* ======= */\n.app footer{\n  padding:10px 8px;\n  border-top:1px solid var(--border);\n  color:var(--muted);\n  font-size:11px;\n}\n\n/* ======================= */\n/* NAV (base not fixed; class controls position) */\n/* ======================= */\n.app nav{\n  height:54px;\n  background:#f2f2f2;\n  border-top:1px solid var(--border);\n  display:flex;\n  justify-content:space-around;\n  align-items:center;\n  padding:2px 4px;\n}\n\n.app nav.nav-bottom{\n  position:fixed;\n  left:0;\n  right:0;\n  bottom:0;\n}\n\n.app nav.nav-top{\n  position:sticky;\n  top:0;\n  z-index:10;\n}\n\n.app nav a{\n  width:54px;\n  text-align:center;\n  text-decoration:none;\n  color:var(--text);\n  font-size:var(--nav-font);\n  line-height:1.0;\n}\n\n.app nav img{\n  width:var(--nav-icon);\n  height:var(--nav-icon);\n  display:block;\n  margin:0 auto 2px auto;\n  opacity:0.55;\n}\n\n.app.nav-is-top main{\n  padding-bottom:8px;\n}\n\n/* ======================= */\n/* Optional: simple responsive fallback */\n/* ======================= */\n@media (max-width: 900px){\n  .layout{\n    grid-template-columns: 1fr;\n  }\n  .controls{\n    position:static;\n    height:auto;\n  }\n}",
          "folderId": "0",
          "active": false
        },
