        "16": {
          "id": "16",
          "name": "controls.js",
          "contents": "// controls.js\n// Baseline BAD = slider midpoint.\n// Left = worse, Right = better.\n// Applies changes only to .app.\n\nconst $ = (id) => document.getElementById(id);\n\nconst app = document.querySelector(\".app\");\nconst nav = document.querySelector(\".app nav\");\nconst backItem = document.querySelector(\".app .nav-back\");\n\n// Remember where nav originally lived so we can restore it.\nconst navPlaceholder = document.createComment(\"nav-placeholder\");\nif (app && nav) {\n  nav.parentNode.insertBefore(navPlaceholder, nav);\n} else {\n  console.error(\"Missing .app or .app nav in HTML.\");\n}\n\nfunction setVar(name, value) {\n  if (!app) return;\n  app.style.setProperty(name, value);\n}\n\nfunction setBackVisibility(isVisible) {\n  if (!backItem) return;\n  backItem.style.display = isVisible ? \"\" : \"none\";\n}\n\nfunction moveNavToTop() {\n  if (!app || !nav) return;\n  const header = app.querySelector(\"header\");\n  if (header) header.after(nav); // nav right under header\n}\n\nfunction moveNavToBottom() {\n  if (!navPlaceholder || !nav) return;\n  navPlaceholder.parentNode.insertBefore(nav, navPlaceholder);\n}\n\nfunction setNavPosition(position) {\n  if (!nav || !app) return;\n\n  nav.classList.remove(\"nav-top\", \"nav-bottom\");\n\n  if (position === \"top\") {\n    moveNavToTop();\n    nav.classList.add(\"nav-top\");\n    app.classList.add(\"nav-is-top\");\n  } else {\n    moveNavToBottom();\n    nav.classList.add(\"nav-bottom\");\n    app.classList.remove(\"nav-is-top\");\n  }\n}\n\n/* ============\n   Helpers\n   ============ */\nfunction clamp(n, min, max) {\n  return Math.min(max, Math.max(min, n));\n}\n\nfunction lerp(a, b, t) {\n  return a + (b - a) * t;\n}\n\n// Map slider value to left/right of midpoint.\n// Returns t in [-1, +1], where 0 = midpoint\nfunction signedT(value, min, max) {\n  const mid = (min + max) / 2;\n  if (value === mid) return 0;\n\n  if (value < mid) {\n    // left half => 0..-1\n    return -((mid - value) / (mid - min));\n  }\n  // right half => 0..+1\n  return (value - mid) / (max - mid);\n}\n\n/* ============\n   Baselines (your current \"bad\" state)\n   These are the values at slider midpoint.\n   ============ */\nconst BASE_BAD = {\n  cardTextPx: 11,\n  cardLineHeight: 1.10,\n  gapPx: 6,\n\n  // contrast \"bad palette\"\n  bg: [246, 246, 246],\n  text: [207, 207, 207],\n  muted: [215, 215, 215],\n  btnBg: [233, 233, 233],\n  btnText: [216, 216, 216],\n\n  navFontPx: 9,\n  navIconPx: 16,\n};\n\n// Worse (left end) + Better (right end) targets\nconst TARGETS = {\n  cardTextPx: { worse: 8, better: 18 },\n  cardLineHeight: { worse: 1.00, better: 1.80 },\n  gapPx: { worse: 0, better: 28 },\n\n  // Contrast: left end = even LOWER contrast than baseline,\n  // right end = clear contrast.\n  paletteWorse: {\n    bg: [242, 242, 242],\n    text: [225, 225, 225],\n    muted: [230, 230, 230],\n    btnBg: [238, 238, 238],\n    btnText: [228, 228, 228],\n  },\n  paletteBetter: {\n    bg: [255, 255, 255],\n    text: [34, 34, 34],\n    muted: [68, 68, 68],\n    btnBg: [31, 31, 31],\n    btnText: [255, 255, 255],\n  },\n\n  navFontPx: { worse: 7, better: 16 },\n  navIconPx: { worse: 12, better: 32 },\n};\n\nfunction rgb(arr) {\n  return `rgb(${arr[0]}, ${arr[1]}, ${arr[2]})`;\n}\n\nfunction mixRGB(from, to, t) {\n  return [\n    Math.round(lerp(from[0], to[0], t)),\n    Math.round(lerp(from[1], to[1], t)),\n    Math.round(lerp(from[2], to[2], t)),\n  ];\n}\n\n/* ============\n   Apply functions (midpoint = bad baseline)\n   Slider min/max are taken from the HTML attributes.\n   ============ */\nfunction applyTextSize() {\n  const el = $(\"textSize\");\n  const v = Number(el.value);\n  const min = Number(el.min);\n  const max = Number(el.max);\n  const t = signedT(v, min, max);\n\n  let px;\n  if (t < 0) px = lerp(BASE_BAD.cardTextPx, TARGETS.cardTextPx.worse, -t);\n  else px = lerp(BASE_BAD.cardTextPx, TARGETS.cardTextPx.better, t);\n\n  setVar(\"--card-text\", `${px.toFixed(0)}px`);\n}\n\nfunction applyLineHeight() {\n  const el = $(\"lineHeight\");\n  const v = Number(el.value);\n  const min = Number(el.min);\n  const max = Number(el.max);\n  const t = signedT(v, min, max);\n\n  let lh;\n  if (t < 0) lh = lerp(BASE_BAD.cardLineHeight, TARGETS.cardLineHeight.worse, -t);\n  else lh = lerp(BASE_BAD.cardLineHeight, TARGETS.cardLineHeight.better, t);\n\n  setVar(\"--card-lh\", lh.toFixed(2));\n}\n\nfunction applySpacing() {\n  const el = $(\"spacing\");\n  const v = Number(el.value);\n  const min = Number(el.min);\n  const max = Number(el.max);\n  const t = signedT(v, min, max);\n\n  let gap;\n  if (t < 0) gap = lerp(BASE_BAD.gapPx, TARGETS.gapPx.worse, -t);\n  else gap = lerp(BASE_BAD.gapPx, TARGETS.gapPx.better, t);\n\n  setVar(\"--gap\", `${gap.toFixed(0)}px`);\n}\n\nfunction applyContrast() {\n  const el = $(\"contrast\");\n  const v = Number(el.value);\n  const min = Number(el.min);\n  const max = Number(el.max);\n  const t = signedT(v, min, max);\n\n  // Convert t (-1..+1) to blend from:\n  // worse -> baseline -> better\n  // We’ll blend baseline toward worse or better based on sign.\n  const worse = TARGETS.paletteWorse;\n  const better = TARGETS.paletteBetter;\n\n  const blendToward = (baseArr, targetArr, amt) => mixRGB(baseArr, targetArr, amt);\n\n  const bg = t < 0 ? blendToward(BASE_BAD.bg, worse.bg, -t) : blendToward(BASE_BAD.bg, better.bg, t);\n  const text = t < 0 ? blendToward(BASE_BAD.text, worse.text, -t) : blendToward(BASE_BAD.text, better.text, t);\n  const muted = t < 0 ? blendToward(BASE_BAD.muted, worse.muted, -t) : blendToward(BASE_BAD.muted, better.muted, t);\n  const btnBg = t < 0 ? blendToward(BASE_BAD.btnBg, worse.btnBg, -t) : blendToward(BASE_BAD.btnBg, better.btnBg, t);\n  const btnText = t < 0 ? blendToward(BASE_BAD.btnText, worse.btnText, -t) : blendToward(BASE_BAD.btnText, better.btnText, t);\n\n  setVar(\"--bg\", rgb(bg));\n  setVar(\"--text\", rgb(text));\n  setVar(\"--muted\", rgb(muted));\n  setVar(\"--btn-bg\", rgb(btnBg));\n  setVar(\"--btn-text\", rgb(btnText));\n}\n\nfunction applyNavSize() {\n  const el = $(\"navSize\");\n  const v = Number(el.value);\n  const min = Number(el.min);\n  const max = Number(el.max);\n  const t = signedT(v, min, max);\n\n  let fontPx, iconPx;\n  if (t < 0) {\n    fontPx = lerp(BASE_BAD.navFontPx, TARGETS.navFontPx.worse, -t);\n    iconPx = lerp(BASE_BAD.navIconPx, TARGETS.navIconPx.worse, -t);\n  } else {\n    fontPx = lerp(BASE_BAD.navFontPx, TARGETS.navFontPx.better, t);\n    iconPx = lerp(BASE_BAD.navIconPx, TARGETS.navIconPx.better, t);\n  }\n\n  setVar(\"--nav-font\", `${fontPx.toFixed(0)}px`);\n  setVar(\"--nav-icon\", `${iconPx.toFixed(0)}px`);\n}\n\nfunction applyAll() {\n  applyTextSize();\n  applyLineHeight();\n  applySpacing();\n  applyContrast();\n  applyNavSize();\n}\n\n/* ============\n   Reset + Initialization\n   ============ */\nfunction applyBadBaseline() {\n  // Force the app into the BAD baseline values (not slider ends)\n  setVar(\"--card-text\", `${BASE_BAD.cardTextPx}px`);\n  setVar(\"--card-lh\", `${BASE_BAD.cardLineHeight.toFixed(2)}`);\n  setVar(\"--gap\", `${BASE_BAD.gapPx}px`);\n\n  setVar(\"--bg\", rgb(BASE_BAD.bg));\n  setVar(\"--text\", rgb(BASE_BAD.text));\n  setVar(\"--muted\", rgb(BASE_BAD.muted));\n  setVar(\"--btn-bg\", rgb(BASE_BAD.btnBg));\n  setVar(\"--btn-text\", rgb(BASE_BAD.btnText));\n\n  setVar(\"--nav-font\", `${BASE_BAD.navFontPx}px`);\n  setVar(\"--nav-icon\", `${BASE_BAD.navIconPx}px`);\n\n  setNavPosition(\"bottom\");\n  setBackVisibility(true);\n}\n\nfunction setSlidersToMidpoints() {\n  const mids = (id) => {\n    const el = $(id);\n    const min = Number(el.min);\n    const max = Number(el.max);\n    el.value = String((min + max) / 2);\n  };\n\n  // Put sliders at midpoint (which represents BAD baseline)\n  mids(\"navSize\");\n  mids(\"textSize\");\n  mids(\"lineHeight\");\n  mids(\"spacing\");\n  mids(\"contrast\");\n\n  // Nav position baseline = bottom (bad)\n  $(\"navPosition\").value = \"bottom\";\n  $(\"showBack\").checked = true;\n}\n\nfunction wireControls() {\n  $(\"textSize\").addEventListener(\"input\", applyTextSize);\n  $(\"lineHeight\").addEventListener(\"input\", applyLineHeight);\n  $(\"spacing\").addEventListener(\"input\", applySpacing);\n  $(\"contrast\").addEventListener(\"input\", applyContrast);\n\n  $(\"navPosition\").addEventListener(\"change\", (e) => \n    setNavPosition(e.target.value)\n  );\n\n  $(\"navSize\").addEventListener(\"input\", applyNavSize);\n\n  $(\"showBack\").addEventListener(\"change\", (e) => \n    setBackVisibility(e.target.checked)\n  );\n\n  /* ===== NEW: Portrait image toggle ===== */\n  $(\"portraitFit\").addEventListener(\"change\", (e) => {\n    app.classList.toggle(\"fit-portrait\", e.target.checked);\n  });\n\n  $(\"reset\").addEventListener(\"click\", () => {\n    setSlidersToMidpoints();\n    applyBadBaseline();\n\n    // Make sure portrait toggle resets to BAD baseline (cropped)\n    if ($(\"portraitFit\")) $(\"portraitFit\").checked = false;\n    app.classList.remove(\"fit-portrait\");\n  });\n}\n\nwireControls();\n\n// Initialize: sliders at midpoint (represents BAD baseline), and app is BAD baseline.\nsetSlidersToMidpoints();\napplyBadBaseline();\n\n// After baseline is applied, re-apply mapping so midpoint truly equals baseline (no drift)\napplyAll();",
          "folderId": "0",
          "active": false
        },
