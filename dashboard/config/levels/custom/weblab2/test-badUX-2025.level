      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Adopt-a-Pet</title>\n  <link rel=\"stylesheet\" href=\"styles.css\" />\n  <script defer src=\"controls.js\"></script>\n</head>\n\n<body>\n\n  <div class=\"layout\">\n    <!-- CONTROL PANEL -->\n    <aside class=\"controls\" aria-label=\"Design controls\">\n      <h2>Redesign Controls</h2>\n\n      <div class=\"control-group\">\n        <h3>Navigation</h3>\n\n        <label for=\"navPosition\">Nav position</label>\n        <select id=\"navPosition\">\n          <option value=\"bottom\">Bottom</option>\n          <option value=\"top\">Top</option>\n        </select>\n\n        <label for=\"navSize\">Nav size</label>\n        <input id=\"navSize\" type=\"range\" min=\"10\" max=\"20\" value=\"9\" />\n        <label>\n          <input id=\"showBack\" type=\"checkbox\" checked />\n          Show “Back”\n        </label>\n      </div>\n\n      <div class=\"control-group\">\n        <h3>Readability</h3>\n\n        <label for=\"textSize\">Text size</label>\n        <input id=\"textSize\" type=\"range\" min=\"12\" max=\"20\" value=\"12\" />\n\n        <label for=\"lineHeight\">Line spacing</label>\n        <input id=\"lineHeight\" type=\"range\" min=\"11\" max=\"18\" value=\"11\" />\n        \n        <label for=\"spacing\">Spacing</label>\n        <input id=\"spacing\" type=\"range\" min=\"6\" max=\"28\" value=\"6\" />\n\n        <label>\n        <input id=\"portraitFit\" type=\"checkbox\" />\n        Gallery Card Orientation\n        </label>\n      </div>\n\n      <div class=\"control-group\">\n        <h3>Color Contrast</h3>\n\n        <label for=\"contrast\">Contrast</label>\n        <input id=\"contrast\" type=\"range\" min=\"0\" max=\"100\" value=\"0\" />\n\n      </div>\n\n      <div class=\"control-group\">\n        <button id=\"reset\" type=\"button\">Reset to Bad</button>\n      </div>\n    </aside>\n\n    <!-- APP PREVIEW -->\n    <div class=\"app\" aria-label=\"Adopt a Pet App\">\n\n      <!-- Header -->\n      <header>\n        <div>\n          <img src=\"assets/logo.png\" alt=\"PawPrint Shelter Logo\">\n          <span>PawPrint Shelter</span>\n        </div>\n        <div>\n          <a href=\"#contact\">Contact</a>\n        </div>\n      </header>\n\n      <!-- Hero Section -->\n      <section>\n        <img src=\"assets/hero-dog.jpg\" alt=\"Happy dog ready for adoption\">\n        <div>\n          <h1>Adopt a Pet Today</h1>\n          <p>Find your new best friend. Browse our available dogs and cats below.</p>\n        </div>\n      </section>\n\n      <!-- Filters -->\n      <section>\n        <h2>Search</h2>\n        <input type=\"text\" placeholder=\"Search by name\">\n        <select>\n          <option>All Animals</option>\n          <option>Dogs</option>\n          <option>Cats</option>\n        </select>\n        <select>\n          <option>All Ages</option>\n          <option>Puppy / Kitten</option>\n          <option>Young</option>\n          <option>Adult</option>\n          <option>Senior</option>\n        </select>\n        <button>Apply</button>\n      </section>\n\n      <!-- Pet Grid -->\n      <main>\n        <article>\n          <img src=\"assets/adopt-dog-1.jpg\" alt=\"Rocky the dog\">\n          <h3>Rocky</h3>\n          <p>Breed: Labrador Mix</p>\n          <p>Age: 2 years</p>\n          <p>\n            Rocky is energetic and loves long walks, squeaky toys, meeting new people,\n            playing fetch endlessly, and sitting right in the middle of wherever you\n            are trying to walk because he thinks he is much smaller than he actually is.\n          </p>\n          <button>Adopt Me</button>\n          <button>Learn More</button>\n        </article>\n\n        <article>\n          <img src=\"assets/adopt-dog-2.jpg\" alt=\"Bella the dog\">\n          <h3>Bella</h3>\n          <p>Breed: Golden Retriever</p>\n          <p>Age: 4 years</p>\n          <p>\n            Bella is calm, affectionate, and enjoys being around families. She loves\n            belly rubs, gentle walks, and will happily follow you from room to room\n            just to make sure she is included in absolutely everything.\n          </p>\n          <button>Adopt Me</button>\n          <button>Learn More</button>\n        </article>\n\n        <article>\n          <img src=\"assets/adopt-dog-3.jpg\" alt=\"Max the dog\">\n          <h3>Max</h3>\n          <p>Breed: German Shepherd</p>\n          <p>Age: 1 year</p>\n          <p>\n            Max is smart and highly trainable. He needs an active home where he can\n            learn new skills, play outside, and burn off energy throughout the day.\n            He thrives with structure and clear expectations.\n          </p>\n          <button>Adopt Me</button>\n          <button>Learn More</button>\n        </article>\n\n        <article>\n          <img src=\"assets/adopt-cat-1.jpg\" alt=\"Luna the cat\">\n          <h3>Luna</h3>\n          <p>Breed: Domestic Short Hair</p>\n          <p>Age: 3 years</p>\n          <p>\n            Luna is quiet and observant. She enjoys sunny windowsills, gentle pets,\n            and curling up next to you in the evenings. She would do best in a calm\n            home where she can relax at her own pace.\n          </p>\n          <button>Adopt Me</button>\n          <button>Learn More</button>\n        </article>\n\n        <article>\n          <img src=\"assets/adopt-cat-2.jpg\" alt=\"Milo the cat\">\n          <h3>Milo</h3>\n          <p>Breed: Tabby</p>\n          <p>Age: 6 months</p>\n          <p>\n            Milo is playful, curious, and always exploring. He loves chasing toy mice,\n            climbing onto shelves he probably should not be on, and investigating\n            every bag that enters the house.\n          </p>\n          <button>Adopt Me</button>\n          <button>Learn More</button>\n        </article>\n\n        <article>\n          <img src=\"assets/adopt-cat-3.jpg\" alt=\"Chloe the cat\">\n          <h3>Chloe</h3>\n          <p>Breed: Siamese Mix</p>\n          <p>Age: 5 years</p>\n          <p>\n            Chloe is affectionate and talkative. She enjoys interactive play and will\n            happily keep you company throughout the day. She bonds closely with her\n            person and loves attention.\n          </p>\n          <button>Adopt Me</button>\n          <button>Learn More</button>\n        </article>\n      </main>\n\n      <!-- Navigation -->\n      <nav>\n        <a href=\"#\">\n          <img src=\"assets/home.png\" alt=\"Home icon\">\n          <div>Home</div>\n        </a>\n        <a href=\"#\">\n          <img src=\"assets/dogs.png\" alt=\"Dogs icon\">\n          <div>Dogs</div>\n        </a>\n        <a href=\"#\">\n          <img src=\"assets/cats.png\" alt=\"Cats icon\">\n          <div>Cats</div>\n        </a>\n        <a href=\"#\">\n          <img src=\"assets/small-pets.png\" alt=\"Small pets icon\">\n          <div>Small Pets</div>\n        </a>\n        <a class=\"nav-back\" href=\"#\">\n          <img src=\"assets/back.png\" alt=\"Back icon\">\n          <div>Back</div>\n        </a>\n      </nav>\n\n      <!-- Footer -->\n      <footer id=\"contact\">\n        <p>PawPrint Shelter</p>\n        <p>123 Rescue Lane</p>\n        <p>Open 7 Days a Week</p>\n        <p>Email: adopt@pawprint.org</p>\n      </footer>\n\n    </div>\n  </div>\n\n</body>\n</html>",
          "active": true,
          "folderId": "0"
        },
