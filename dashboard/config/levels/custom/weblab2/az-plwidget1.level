  "audit_log": "[{\"changed_at\":\"2026-09-16T17:27:48.590+00:00\",\"changed\":[\"cloned from \\\"ai-and-the-systems-that-power-it-lesson2-weblab-1\\\"\"],\"cloned_from\":\"ai-and-the-systems-that-power-it-lesson2-weblab-1\"},{\"changed_at\":\"2026-09-16 17:29:04 +0000\",\"changed\":[],\"changed_by_id\":10559,\"changed_by_email\":\"aryanna@code.org\"},{\"changed_at\":\"2026-09-16 17:33:48 +0000\",\"changed\":[\"start_sources\"],\"changed_by_id\":10559,\"changed_by_email\":\"aryanna@code.org\"},{\"changed_at\":\"2026-09-16 17:33:49 +0000\",\"changed\":[\"long_instructions\"],\"changed_by_id\":10559,\"changed_by_email\":\"aryanna@code.org\"},{\"changed_at\":\"2026-09-16 17:34:28 +0000\",\"changed\":[],\"changed_by_id\":10559,\"changed_by_email\":\"aryanna@code.org\"},{\"changed_at\":\"2026-09-16 17:34:28 +0000\",\"changed\":[\"generate_outline\"],\"changed_by_id\":10559,\"changed_by_email\":\"aryanna@code.org\"},{\"changed_at\":\"2026-09-16 18:05:35 +0000\",\"changed\":[\"start_sources\"],\"changed_by_id\":10559,\"changed_by_email\":\"aryanna@code.org\"},{\"changed_at\":\"2026-09-16 18:13:06 +0000\",\"changed\":[\"start_sources\"],\"changed_by_id\":10559,\"changed_by_email\":\"aryanna@code.org\"},{\"changed_at\":\"2026-09-16 18:13:30 +0000\",\"changed\":[\"long_instructions\"],\"changed_by_id\":10559,\"changed_by_email\":\"aryanna@code.org\"},{\"changed_at\":\"2026-09-16 18:13:45 +0000\",\"changed\":[],\"changed_by_id\":10559,\"changed_by_email\":\"aryanna@code.org\"},{\"changed_at\":\"2026-09-16 18:13:57 +0000\",\"changed\":[\"teacher_markdown\"],\"changed_by_id\":10559,\"changed_by_email\":\"aryanna@code.org\"},{\"changed_at\":\"2026-09-16 18:14:00 +0000\",\"changed\":[],\"changed_by_id\":10559,\"changed_by_email\":\"aryanna@code.org\"},{\"changed_at\":\"2026-09-16 18:14:57 +0000\",\"changed\":[\"initial_view_mode\",\"teacher_markdown\"],\"changed_by_id\":10559,\"changed_by_email\":\"aryanna@code.org\"},{\"changed_at\":\"2026-09-16 18:44:23 +0000\",\"changed\":[],\"