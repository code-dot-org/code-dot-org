  "created_at": "2026-04-14T18:01:22.000Z",
  "level_num": "custom",
  "user_id": 18762,
  "properties": {
    "require_edit_to_continue": "true",
    "display_name": "Shopping Cart",
    "bubble_choice_description": "Use AI to turn your shopping cart flowchart into working code.",
    "thumbnail_url": "https://images.code.org/f4f1437e3ab04fea936c4b2faa1e98c9-Screenshot 2026-04-14 at 5.18.09 PM.png",
    "start_sources": {
      "folders": {
        "1": {
          "id": "1",
          "name": "images",
          "parentId": "0",
          "open": false
        }
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Shopping Cart</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <main class=\"app\">\n    <header class=\"topbar\">\n      <button class=\"cart-button\" id=\"cartButton\" type=\"button\" aria-label=\"Shopping cart\">\n        <span class=\"cart-icon\">🛒</span>\n        <span class=\"cart-badge\" id=\"cartBadge\">0</span>\n      </button>\n    </header>\n\n    <section class=\"section-header\">\n      <h1>Ice Cream</h1>\n    </section>\n\n    <section class=\"products\">\n      <article class=\"product-card\">\n        <img\n          src=\"images/product1.png\"\n          alt=\"Ben & Jerry's Half Baked ice cream\"\n          class=\"product-image\"\n        />\n        <button\n          class=\"add-button\"\n          id=\"addButton1\"\n          type=\"button\"\n          aria-label=\"Add Ben & Jerry's Half Baked Chocolate Brownie\"\n        >\n          +\n        </button>\n        <p class=\"price\">$7<sup>99</sup></p>\n        <h2>Ben &amp; Jerry's Half Baked Chocolate Brownie</h2>\n      </article>\n\n      <article class=\"product-card\">\n        <img\n          src=\"images/product2.png\"\n          alt=\"Ben & Jerry's Milk & Cookies ice cream\"\n          class=\"product-image\"\n        />\n        <button\n          class=\"add-button\"\n          id=\"addButton2\"\n          type=\"button\"\n          aria-label=\"Add Ben & Jerry's Milk & Cookies Vanilla Ice Cream\"\n        >\n          +\n        </button>\n        <p class=\"price\">$9<sup>19</sup></p>\n        <h2>Ben &amp; Jerry's Milk &amp; Cookies Vanilla Ice Cream</h2>\n      </article>\n\n      <article class=\"product-card\">\n        <img\n          src=\"images/product3.png\"\n          alt=\"Ben & Jerry's The Tonight Dough ice cream\"\n          class=\"product-image\"\n        />\n        <button\n          class=\"add-button\"\n          id=\"addButton3\"\n          type=\"button\"\n          aria-label=\"Add Ben & Jerry's The Tonight Dough\"\n        >\n          +\n        </button>\n        <p class=\"price\">$7<sup>99</sup></p>\n        <h2>Ben &amp; Jerry's The Tonight Dough</h2>\n      </article>\n    </section>\n  </main>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n}\n\nbody {\n  background: #ffffff;\n  color: #1f1f1f;\n}\n\n/* Layout */\n.app {\n  max-width: 400px;\n  margin: 0 auto;\n  padding: 16px;\n}\n\n/* Top bar */\n.topbar {\n  display: flex;\n  justify-content: flex-end;\n  margin-bottom: 16px;\n}\n\n.cart-button {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  background: #eb1700;\n  color: white;\n  border: none;\n  border-radius: 20px;\n  padding: 8px 12px;\n  font-size: 14px;\n  font-weight: 600;\n}\n\n/* Header */\n.section-header {\n  margin-bottom: 16px;\n}\n\n.section-header h1 {\n  font-size: 26px;\n  font-weight: 700;\n}\n\n/* Products → 2 column grid */\n.products {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px;\n}\n\n/* Card */\n.product-card {\n  background: #ffffff;\n  border: 1px solid #e9e9e9;\n  border-radius: 18px;\n  padding: 12px;\n  position: relative;\n}\n\n/* Image */\n.product-image {\n  width: 100%;\n  height: 120px;\n  object-fit: contain;\n  margin-bottom: 10px;\n}\n\n/* Add button */\n.add-button {\n  position: absolute;\n  top: 80px;\n  right: 10px;\n  width: 36px;\n  height: 36px;\n  border-radius: 999px;\n  border: 1px solid #ececec;\n  background: #ffffff;\n  font-size: 22px;\n  cursor: pointer;\n  box-shadow: 0 3px 8px rgba(0,0,0,0.08);\n}\n\n/* Price */\n.price {\n  font-size: 16px;\n  font-weight: 700;\n  margin-bottom: 4px;\n}\n\n.price sup {\n  font-size: 10px;\n}\n\n/* Title */\n.product-card h2 {\n  font-size: 14px;\n  font-weight: 500;\n  color: #444;\n  line-height: 1.3;\n}\n\n#cartButton {\n  visibility: hidden;\n}",
          "folderId": "0",
          "active": false
        },
