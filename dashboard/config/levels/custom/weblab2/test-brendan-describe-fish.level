          "id": "00c94e94-dcd9-4653-84ea-c9fe291d14eb",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>My Awesome Pet Fish Page</title>\n</head>\n<body>\n  <!-- All the visible content of your web page will go here! -->\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        }
