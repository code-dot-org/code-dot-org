        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n    <div class=\"comparison-container\">\n        <div class=\"card\">\n            <img src=\"web2.png\" alt=\"Web Design #1\">\n        </div>\n        \n        <div class=\"card\">\n            <img src=\"web1.png\" alt=\"Web Design #2\">\n\n        </div>\n    </div>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "/* Centers the container on the page */\nbody {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    min-height: 100vh;\n    margin: 0;\n    background-color: #f4f4f4;\n    font-family: sans-serif;\n}\n\n.comparison-container {\n    display: flex;\n    justify-content: center;\n    /* This creates the physical space between the two cards */\n    gap: 40px; \n    padding: 40px;\n    background-color: #f0f0f0; /* Optional: light grey background to make cards pop */\n}\n\n.card {\n    /* flex: 1; -> Remove or comment this out if they are overlapping */\n    width: 45%; /* Limits each card to slightly less than half the screen */\n    background: #ffffff; \n    /* Optional: Adding a subtle shadow helps define the 'page' boundary */\n    box-shadow: 0 10px 30px rgba(0,0,0,0.1);\n    border-radius: 8px;\n    overflow: hidden;\n    display: flex;\n}\n\n.equal-height-img {\n    width: 100%;\n    height: 600px; /* Adjust height as needed */\n    object-fit: cover;\n    object-position: top;\n    display: block;\n}\n\n/* Ensure they stack on mobile so they don't get too thin */\n@media (max-width: 800px) {\n    .comparison-container {\n        flex-direction: column;\n        align-items: center;\n    }\n    .card {\n        width: 90%;\n    }\n}\n\n",
          "folderId": "0",
          "active": true
        },
