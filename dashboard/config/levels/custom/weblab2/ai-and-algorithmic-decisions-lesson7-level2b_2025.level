  "user_id": 18603,
  "properties": {
    "encrypted": "false",
    "long_instructions": "## Redesign for a User\r\n\r\nExamine this course portal web application and review the User Persona below.\r\n\r\nWork with AI to implement one accessibility fix that would help the user to interact with the app better.\r\n\r\n## User Persona\r\n\r\nJamal, Age 17 — low vision\r\n\r\nZooms pages and prefers roomy line height; needs larger baseline text and high-contrast foreground/background to keep edges crisp.\r\n\r\nHelps: Font Size; Contrast.",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
    "ai_tutor_mode": "suggest",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "allowMultipleAttempts": false,
      "placeholderText": "",
      "multipleChoiceOptions": [
        ""
      ],
      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false
    },
    "display_name": "User: Jamal",
    "bubble_choice_description": "Jamal needs to choose an article to read for his science class from a selection offered by a news website.",
    "thumbnail_url": "https://images.code.org/208030c4089319b46224687d95b67707-aiChat.png",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n<head>\n  <title>Daily News Headlines</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <div class=\"header\">\n    <h1>Daily News Headlines</h1>\n  </div>\n\n  <div class=\"controls\">\n    <button id=\"contrast-btn\">Toggle High Contrast</button>\n    <button id=\"font-size-btn\">Toggle Large Text</button>\n    <button id=\"image-alt-btn\">Toggle Image Descriptions</button>\n  </div>\n\n  <div class=\"article\">\n    <img class=\"article-image\" id=\"article-1-img\" src=\"high-temperature.png\" />\n    <div id=\"article-1-alt\" class=\"hidden\">\n      [Image: Scientists examining climate data on computer screens]\n    </div>\n    <div class=\"article-title\">Climate Scientists Report Record Temperatures</div>\n    <div class=\"article-preview\">\n      New data shows global temperatures reached unprecedented levels this summer,\n      prompting urgent calls for climate action from researchers worldwide.\n    </div>\n    <button class=\"read-more\" id=\"read-more-1\">Read More</button>\n    <div class=\"full-content hidden\" id=\"full-content-1\">\n      The latest climate report reveals that average global temperatures this summer\n      exceeded previous records by a significant margin. Scientists emphasize the\n      need for immediate action to reduce carbon emissions and implement sustainable\n      practices across all sectors of society.\n    </div>\n  </div>\n\n  <div class=\"article\">\n    <img class=\"article-image\" id=\"article-2-img\" src=\"technology_program.png\" />\n    <div id=\"article-2-alt\" class=\"hidden\">\n      [Image: Students using laptops in a modern classroom]\n    </div>\n    <div class=\"article-title\">Schools Adopt New Technology Programs</div>\n    <div class=\"article-preview\">\n      Local schools are implementing innovative technology programs to enhance\n      student learning and prepare them for future careers in the digital age.\n    </div>\n    <button class=\"read-more\" id=\"read-more-2\">Read More</button>\n    <div class=\"full-content hidden\" id=\"full-content-2\">\n      The district has invested in new computer labs and coding classes for students\n      of all ages. Teachers report increased engagement and improved problem-solving\n      skills among students participating in these programs.\n    </div>\n  </div>\n\n  <div class=\"article\">\n    <img class=\"article-image\" id=\"article-3-img\" src=\"tree.png\" />\n    <div id=\"article-3-alt\" class=\"hidden\">\n      [Image: Community volunteers planting trees in a park]\n    </div>\n    <div class=\"article-title\">Community Volunteers Plant 1000 Trees</div>\n    <div class=\"article-preview\">\n      Volunteers gathered over the weekend to plant trees throughout the city,\n      contributing to environmental conservation and urban beautification efforts.\n    </div>\n    <button class=\"read-more\" id=\"read-more-3\">Read More</button>\n    <div class=\"full-content hidden\" id=\"full-content-3\">\n      The tree-planting initiative brought together residents of all ages who worked\n      together to green their neighborhoods. Organizers plan to continue the program\n      monthly to further improve air quality and provide shade in public spaces.\n    </div>\n  </div>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "const readMore1 = document.querySelector(\"#read-more-1\");\nconst readMore2 = document.querySelector(\"#read-more-2\");\nconst readMore3 = document.querySelector(\"#read-more-3\");\nconst fullContent1 = document.querySelector(\"#full-content-1\");\nconst fullContent2 = document.querySelector(\"#full-content-2\");\nconst fullContent3 = document.querySelector(\"#full-content-3\");\n\nreadMore1.addEventListener(\"click\", () => {\n  fullContent1.classList.toggle(\"hidden\");\n});\n\nreadMore2.addEventListener(\"click\", () => {\n  fullContent2.classList.toggle(\"hidden\");\n});\n\nreadMore3.addEventListener(\"click\", () => {\n  fullContent3.classList.toggle(\"hidden\");\n});\n",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  margin: 0;\n  padding: 20px;\n  background: white;\n  color: #ccc;\n  font-family: Arial, sans-serif;\n  font-size: 10px;\n  line-height: 1.2;\n}\n\n.header {\n  text-align: center;\n  margin-bottom: 20px;\n  padding: 10px;\n  background: #ddd;\n  color: #bbb;\n}\n\n.controls {\n  margin-bottom: 20px;\n  padding: 10px;\n  background: #f5f5f5;\n}\n\n.controls button {\n  margin-right: 10px;\n  padding: 5px 10px;\n  font-size: 10px;\n  background: #e0e0e0;\n  color: #999;\n  border: 1px solid #ccc;\n  cursor: pointer;\n}\n\n.article {\n  margin-bottom: 20px;\n  padding: 15px;\n  background: #f9f9f9;\n  border: 1px solid #e0e0e0;\n}\n\n.article-title {\n  font-size: 12px;\n  font-weight: bold;\n  margin-bottom: 5px;\n  color: #aaa;\n}\n\n.article-preview {\n  font-size: 9px;\n  color: #bbb;\n  margin-bottom: 10px;\n  line-height: 1.1;\n}\n\n.article-image {\n  width: 100px;\n  height: 75px;\n  margin-bottom: 10px;\n  background: #ddd;\n}\n\n.read-more {\n  font-size: 9px;\n  color: #999;\n  background: #e8e8e8;\n  border: 1px solid #ccc;\n  padding: 3px 8px;\n  cursor: pointer;\n}\n\n.full-content {\n  margin-top: 10px;\n  font-size: 9px;\n  color: #bbb;\n  line-height: 1.1;\n}\n\n.hidden {\n  display: none;\n}\n\n.high-contrast {\n  background: white;\n  color: black;\n}\n\n.high-contrast .header {\n  background: black;\n  color: white;\n}\n\n.high-contrast .controls {\n  background: white;\n}\n\n.high-contrast .controls button {\n  background: white;\n  color: black;\n  border: 2px solid black;\n}\n\n.high-contrast .article {\n  background: white;\n  border: 2px solid black;\n}\n\n.high-contrast .article-title {\n  color: black;\n}\n\n.high-contrast .article-preview {\n  color: black;\n}\n\n.high-contrast .read-more {\n  color: black;\n  background: white;\n  border: 2px solid black;\n}\n\n.high-contrast .full-content {\n  color: black;\n}\n\n.large-text {\n  font-size: 16px;\n}\n\n.large-text .header {\n  font-size: 24px;\n}\n\n.large-text .controls button {\n  font-size: 14px;\n  padding: 8px 12px;\n}\n\n.large-text .article-title {\n  font-size: 20px;\n  line-height: 1.4;\n}\n\n.large-text .article-preview {\n  font-size: 16px;\n  line-height: 1.5;\n}\n\n.large-text .read-more {\n  font-size: 14px;\n  padding: 6px 12px;\n}\n\n.large-text .full-content {\n  font-size: 16px;\n  line-height: 1.5;\n}\n",
          "folderId": "0",
          "active": false
        },
