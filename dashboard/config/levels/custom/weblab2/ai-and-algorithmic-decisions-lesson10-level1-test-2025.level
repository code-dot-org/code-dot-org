      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false
    },
    "display_name": "Toggle Thinking",
    "bubble_choice_description": "See how one click updates the app's state and changes what you see on screen.",
    "thumbnail_url": "https://images.code.org/b8254dcc5d40be2469c4dc3010be16c2-toggle.png",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>Light / Dark Mode Toggle</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body class=\"light\">\n    <button id=\"btnToggle\">\n      <img id=\"sunIcon\" class=\"show\" src=\"sun.png\" alt=\"Light mode icon\">\n      <img id=\"moonIcon\" class=\"hidden\" src=\"moon.png\" alt=\"Dark mode icon\">\n      Toggle Mode\n    </button>\n\n    <div id=\"statePill\">isOn: false</div>\n    <p>This page switches between light and dark mode when you click the button.</p>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* ---------- Layout ---------- */\nbody {\n  font-family: sans-serif;\n  text-align: center;\n  padding: 3rem;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  min-height: 100vh;\n  transition: background-color 0.4s, color 0.4s;\n}\n\n/* ---------- Button ---------- */\nbutton {\n  background: none;\n  border: 2px solid #ccc;\n  padding: 0.6rem 1rem;\n  border-radius: 8px;\n  cursor: pointer;\n  font-size: 1rem;\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  color: inherit; /* follows light/dark text */\n  transition: background-color 0.3s, border-color 0.3s, color 0.3s;\n}\n\nbutton:hover {\n  background-color: rgba(128, 128, 128, 0.2);\n  border-color: #aaa;\n}\n\n/* ---------- Icons ---------- */\nbutton img {\n  width: 24px;\n  height: 24px;\n}\n\n.hidden {\n  display: none;\n}\n\n/* ---------- Themes ---------- */\n.light {\n  background-color: white;\n  color: black;\n}\n\n.dark {\n  background-color: black;\n  color: white;\n}\n\n/* ---------- State Pill ---------- */\n#statePill {\n  display: inline-block;\n  margin: 1rem;\n  padding: 0.3rem 0.8rem;\n  border-radius: 1rem;\n  background: #eee;\n  color: #333;\n  transition: background 0.4s, color 0.4s;\n}\n\n.dark #statePill {\n  background: #444;\n  color: white;\n}\n\n\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "let isOn = false;\n\nconst btnToggle = document.getElementById(\"btnToggle\");\nconst sunIcon = document.getElementById(\"sunIcon\");\nconst moonIcon = document.getElementById(\"moonIcon\");\nconst statePill = document.getElementById(\"statePill\");\nconst body = document.body;\n\nbtnToggle.addEventListener(\"click\", () => {\n\n  isOn = !isOn;\n\n  if (isOn) {\n    body.classList.replace(\"light\", \"dark\");\n    sunIcon.classList.add(\"hidden\");\n    moonIcon.classList.remove(\"hidden\");\n  } else {\n    body.classList.replace(\"dark\", \"light\");\n    sunIcon.classList.remove(\"hidden\");\n    moonIcon.classList.add(\"hidden\");\n  }\n\n  statePill.textContent = \"isOn: \" + isOn;\n});\n",
          "folderId": "0",
          "active": true
        },
