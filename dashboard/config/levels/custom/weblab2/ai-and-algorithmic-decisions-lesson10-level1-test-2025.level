  "properties": {
    "encrypted": "false",
    "long_instructions": "## Toggle Thinking\r\n\r\n**Do This:**\r\n\r\n1. Click the **Light/Dark** button to test what happens.\r\n\r\n2. Watch how the screen, icon, and isOn pill change.\r\n\r\n3. On your handout, fill in the pattern:\r\n\r\n   **Event → State flip → Render change**",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
    "ai_tutor_mode": "outline",
    "predict_settings": {
