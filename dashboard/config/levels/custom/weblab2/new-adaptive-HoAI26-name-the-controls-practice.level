<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-11-03T03:27:45.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": true,
    "start_sources": {
      "folders": {
      },
      "files": {
        "6ed314c6-5267-446e-8bc7-e676ae4df227": {
          "id": "6ed314c6-5267-446e-8bc7-e676ae4df227",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Name the Controls</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <h1>Name the Interactive Parts</h1>\n    <p>Click on different parts of the wheel page to learn their names and jobs.</p>\n\n    <div class=\"interactive-area\">\n        <div class=\"wheel-container\" id=\"wheelArea\">\n            <div class=\"segment\" id=\"segment1\">Option 1</div>\n            <div class=\"segment\" id=\"segment2\">Option 2</div>\n            <div class=\"segment\" id=\"segment3\">Option 3</div>\n            <div class=\"segment\" id=\"segment4\">Option 4</div>\n        </div>\n        <button class=\"control-button\" id=\"spinButton\">Spin Wheel</button>\n        <div class=\"result-display\" id=\"resultArea\">Result: Pending...</div>\n    </div>\n\n    <div class=\"info-box\">\n        <h2>Selected Control Info:</h2>\n        <p><strong>Name:</strong> <span id=\"controlName\">Click an element</span></p>\n        <p><strong>Job:</strong> <span id=\"controlJob\">To see its name and what it does.</span></p>\n    </div>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "5c38c8f4-45e1-4c52-9e54-5dccec0be9c1": {
          "id": "5c38c8f4-45e1-4c52-9e54-5dccec0be9c1",
          "name": "style.css",
          "contents": "body {\n    font-family: sans-serif;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    min-height: 100vh;\n    background-color: #f4f4f4;\n    color: #333;\n    margin: 0;\n    padding: 20px;\n    box-sizing: border-box;\n}\n\nh1 {\n    color: #0056b3;\n    margin-bottom: 10px;\n}\n\np {\n    margin-bottom: 25px;\n    text-align: center;\n}\n\n.interactive-area {\n    background-color: #fff;\n    padding: 30px;\n    border-radius: 10px;\n    box-shadow: 0 4px 10px rgba(0,0,0,0.1);\n    margin-bottom: 30px;\n    width: 90%;\n    max-width: 400px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 20px;\n}\n\n.wheel-container {\n    position: relative;\n    width: 250px;\n    height: 250px;\n    border-radius: 50%;\n    background-color: #e0e0e0;\n    border: 5px solid #bbb;\n    overflow: hidden;\n    cursor: pointer;\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: center;\n    align-items: center;\n    box-shadow: inset 0 0 10px rgba(0,0,0,0.2);\n}\n\n.segment {\n    width: 50%;\n    height: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: bold;\n    color: #555;\n    font-size: 0.9em;\n    border: 1px solid #ccc;\n    box-sizing: border-box;\n    background-color: #f9f9f9;\n    cursor: pointer;\n}\n\n.segment:nth-child(1) { background-color: #FFDDC1; }\n.segment:nth-child(2) { background-color: #FFABAB; }\n.segment:nth-child(3) { background-color: #B5EAD7; }\n.segment:nth-child(4) { background-color: #CCE2FF; }\n\n.control-button {\n    background-color: #007bff;\n    color: white;\n    padding: 12px 25px;\n    border: none;\n    border-radius: 5px;\n    font-size: 1.1em;\n    cursor: pointer;\n    transition: background-color 0.3s ease;\n}\n\n.control-button:hover {\n    background-color: #0056b3;\n}\n\n.result-display {\n    background-color: #e9ecef;\n    padding: 15px;\n    border-radius: 5px;\n    border: 1px dashed #adb5bd;\n    width: 80%;\n    text-align: center;\n    font-size: 1em;\n    color: #495057;\n    cursor: pointer;\n}\n\n.info-box {\n    background-color: #e2f0fb;\n    border: 1px solid #a8d5f7;\n    padding: 20px;\n    border-radius: 8px;\n    width: 90%;\n    max-width: 400px;\n    box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n}\n\n.info-box h2 {\n    color: #007bff;\n    margin-top: 0;\n    margin-bottom: 15px;\n    border-bottom: 1px solid #a8d5f7;\n    padding-bottom: 10px;\n}\n\n.info-box p {\n    text-align: left;\n    margin-bottom: 10px;\n    font-size: 1em;\n}\n\n.info-box strong {\n    color: #0056b3;\n}\n",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "ca911718-01c2-45a6-bd72-7eab4319d338": {
          "id": "ca911718-01c2-45a6-bd72-7eab4319d338",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const wheelArea = document.getElementById('wheelArea');\n    const segments = document.querySelectorAll('.segment');\n    const spinButton = document.getElementById('spinButton');\n    const resultArea = document.getElementById('resultArea');\n    const controlNameSpan = document.getElementById('controlName');\n    const controlJobSpan = document.getElementById('controlJob');\n\n    function updateInfo(name, job) {\n        controlNameSpan.textContent = name;\n        controlJobSpan.textContent = job;\n    }\n\n    wheelArea.addEventListener('click', (event) => {\n        // Check if a segment was clicked first\n        if (event.target.classList.contains('segment')) {\n            updateInfo(\"Option Segment\", \"Represents a single choice on the wheel.\");\n        } else if (event.target.id === 'wheelArea') {\n            // If the wheel container itself was clicked (not a segment child)\n            updateInfo(\"Wheel Area\", \"Displays the options for selection.\");\n        }\n    });\n\n    spinButton.addEventListener('click', () => {\n        updateInfo(\"Spin Button\", \"Starts the wheel's action.\");\n    });\n\n    resultArea.addEventListener('click', () => {\n        updateInfo(\"Result Display\", \"Shows the outcome of the wheel's action.\");\n    });\n\n    // Initial message\n    updateInfo(\"Click an element\", \"To see its name and what it does.\");\n});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
        "6ed314c6-5267-446e-8bc7-e676ae4df227",
        "5c38c8f4-45e1-4c52-9e54-5dccec0be9c1",
        "ca911718-01c2-45a6-bd72-7eab4319d338"
      ]
    },
    "long_instructions": "TODOs:\r\n- Open index.html to view the interactive wheel page.\r\n- Click on the central wheel area, individual segments, the 'Spin Wheel' button, and the 'Result' display.\r\n- Observe the 'Name' and 'Job' information that appears for each part you click.\r\n- Understand the function of each interactive control on the page.",
