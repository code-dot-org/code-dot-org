  <config><![CDATA[{
  "published": true,
  "game_id": 74,
  "created_at": "2025-11-24T18:16:47.000Z",
  "level_num": "custom",
  "user_id": 18762,
  "properties": {
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Bake Sale Filter</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <main>\n    <h1>Bake Sale Menu</h1>\n\n    <div class=\"controls\">\n      <button id=\"filterBtn\">Filter: Nut-Free</button>\n      <button id=\"resetBtn\" class=\"secondary\">Reset Data</button>\n    </div>\n\n    <div class=\"menu-container\">\n      <ul id=\"menuList\">\n        </ul>\n    </div>\n  </main>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: sans-serif;\n  background-color: #fff4e6;\n  color: #4a4a4a;\n  margin: 0;\n  padding: 20px;\n  display: flex;\n  justify-content: center;\n}\n\nmain {\n  background: white;\n  padding: 2rem;\n  border-radius: 12px;\n  box-shadow: 0 4px 6px rgba(0,0,0,0.05);\n  width: 100%;\n  max-width: 450px;\n}\n\nh1 {\n  color: #d35400;\n  margin-top: 0;\n  margin-bottom: 20px;\n}\n\n.controls {\n  display: flex;\n  gap: 10px;\n  margin-bottom: 20px;\n}\n\nbutton {\n  background-color: #d35400;\n  color: white;\n  border: none;\n  padding: 8px 16px;\n  border-radius: 4px;\n  cursor: pointer;\n  font-weight: bold;\n  font-size: 1rem;\n}\n\nbutton:hover {\n  background-color: #a04000;\n}\n\nbutton.secondary {\n  background-color: #95a5a6;\n}\n\nul {\n  list-style: none;\n  padding: 0;\n  border-top: 2px solid #eee;\n}\n\nli {\n  padding: 15px 10px;\n  border-bottom: 1px solid #eee;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.allergen-tag {\n  background-color: #ffeaa7;\n  padding: 4px 8px;\n  border-radius: 12px;\n  font-size: 0.85rem;\n  color: #d35400;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "// 1. DOM Elements\nconst menuList = document.querySelector(\"#menuList\");\nconst filterBtn = document.querySelector(\"#filterBtn\");\nconst resetBtn = document.querySelector(\"#resetBtn\");\n\n// 2. Data: Array of objects\nlet bakedGoods = [\n  { name: \"Peanut Butter Cookies\", allergens: \"Nuts\" },\n  { name: \"Lemon Bars\", allergens: \"Dairy\" },\n  { name: \"Almond Croissant\", allergens: \"Nuts\" },\n  { name: \"Sugar Cookies\", allergens: \"Gluten\" },\n  { name: \"Pecan Pie\", allergens: \"Nuts\" }\n];\n\n// 3. Event Listeners\nfilterBtn.addEventListener(\"click\", () => {\n  filterNutFree();\n});\n\n// BUGGY CODE - This should show the original full list again but it doesn't!\nresetBtn.addEventListener(\"click\", () => {\n  renderMenu(bakedGoods);\n});\n\n// 4. Functions\n\n// BUGGY CODE - This shouldn't permanently change the original dataset but it does!\nfunction filterNutFree() {\n  let safeItems = [];\n  \n  for (let i = 0; i < bakedGoods.length; i++) {\n    if (bakedGoods[i].allergens !== \"Nuts\") {\n      safeItems.push(bakedGoods[i]);\n    }\n  }\n  \n  bakedGoods = safeItems;\n  \n  renderMenu(bakedGoods);\n}\n\n// Helper to display the list\nfunction renderMenu(list) {\n  menuList.innerHTML = \"\";\n  \n  for (let i = 0; i < list.length; i++) {\n    const item = list[i];\n    const li = document.createElement(\"li\");\n    \n    li.innerHTML = `\n      <span>${item.name}</span>\n      <span class=\"allergen-tag\">Contains: ${item.allergens}</span>\n    `;\n    \n    menuList.appendChild(li);\n  }\n}\n\n// Initial Render\nrenderMenu(bakedGoods);",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    },
