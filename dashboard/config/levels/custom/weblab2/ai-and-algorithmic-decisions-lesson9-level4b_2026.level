<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-04-16T16:50:40.000Z",
  "level_num": "custom",
  "user_id": 18762,
  "properties": {
    "require_edit_to_continue": "true",
    "display_name": "Free Shipping",
    "bubble_choice_description": "Code an app that determines if an order qualifies for free shipping.",
    "thumbnail_url": "https://images.code.org/2bc4cc6f6a672e423a4cf36d712456e3-shipping.png",
    "encrypted": "false",
    "long_instructions": "## Free Shipping\r\n\r\n#### Do This:\r\n\r\n1. Upload your free shipping flowchart to AI. Then prompt AI with your free shipping rule (using either AND or OR).\r\n\r\n2. Before accepting the code, carefully check that the outcomes match all four branches of your flowchart:\r\n\r\n   * isOverFifty = True, hasCoupon = True\r\n   * isOverFifty = True, hasCoupon = False\r\n   * isOverFifty = False, hasCoupon = True\r\n   * isOverFifty = False, hasCoupon = False\r\n\r\n3. Use AI to explain the code and fix any bugs.",
    "offer_browser_tts": "false",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "placeholderText": "",
      "multipleChoiceOptions": [
        ""
      ],
      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false
    },
    "ai_tutor_prompt_settings": {
      "answerTypes": [
        "buildJavaScript",
        "documentation",
        "explainCode"
      ],
      "answerTypeCustomizations": {
        "buildJavaScript": "Use && or || operators instead of nested conditionals"
      }
    },
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Order Summary | Thread & Co.</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600&display=swap\" rel=\"stylesheet\">    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n    <aside class=\"logic-lab\" id=\"logicLabPanel\">\n        <div class=\"lab-header\">\n            <h3>Promo Engine</h3>\n            <button id=\"toggleLabMinimize\">−</button>\n        </div>\n        \n        <div class=\"lab-content\">\n            <div class=\"control-group\">\n                <label>Order > $50</label>\n                <button id=\"toggleA\" class=\"lab-btn\">FALSE</button>\n            </div>\n\n            <div class=\"control-group\">\n                <label>Has Coupon</label>\n                <button id=\"toggleB\" class=\"lab-btn\">FALSE</button>\n            </div>\n\n            <div class=\"status-box\">\n                <code>eval(isOverFifty || hasCoupon)</code>\n                <p id=\"logicStatus\">false</p>\n            </div>\n        </div>\n    </aside>\n\n    <main class=\"summary-container\">\n        <header class=\"merchant-header\">\n            <div class=\"back-arrow\">←</div>\n            <div class=\"store-brand\">\n                <div class=\"store-logo\">T</div>\n                <span class=\"store-name\">Thread & Co.</span>\n                <span class=\"test-badge\">TEST MODE</span>\n            </div>\n        </header>\n\n        <section class=\"hero-total\">\n            <p class=\"pay-label\">Total to Pay</p>\n            <h1 id=\"totalDisplay\">$75.00</h1>\n        </section>\n\n        <section class=\"checkout-details\">\n            <div class=\"line-item\">\n                <div class=\"item-info\">\n                    <img src=\"hoodie.png\" alt=\"Hoodie\" class=\"item-thumb\">\n                    <div>\n                        <p class=\"item-title\">Essential Oversized Hoodie</p>\n                        <p class=\"item-meta\">Heather Gray • Large</p>\n                    </div>\n                </div>\n                <span class=\"item-price\">$65.00</span>\n            </div>\n\n            <div class=\"divider\"></div>\n\n            <div class=\"price-row\">\n                <span>Subtotal</span>\n                <span>$65.00</span>\n            </div>\n\n            <div class=\"price-row\" id=\"shippingRow\">\n                <div>\n                    <span>Shipping</span>\n                    <p class=\"sub-text\" id=\"shippingType\">Standard shipping (3-5 business days)</p>\n                </div>\n                <span id=\"shippingCost\">$10.00</span>\n            </div>\n\n            <div class=\"divider\"></div>\n\n            <div class=\"price-row total-row\">\n                <span>Total due</span>\n                <span id=\"finalTotal\">$75.00</span>\n            </div>\n        </section>\n\n        <footer class=\"stripe-footer\">\n            <span>Powered by <strong>stripe</strong></span>\n            <span class=\"footer-links\">Terms Privacy</span>\n        </footer>\n    </main>\n\n    <script src=\"script.js\"></script>\n    <script src=\"lab-overlay.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": ":root {\n    --text-main: #1a1f36;\n    --text-sub: #697386;\n    --stripe-blue: #007fff;\n    --border-color: #e6ebf1;\n    --lab-bg: #111111;\n    --lab-btn-contrast: #f4f4f4; /* High contrast light gray */\n}\n\nbody {\n    background-color: white;\n    color: var(--text-main);\n    font-family: 'Public Sans', -apple-system, sans-serif;\n    margin: 0;\n    display: flex; /* Flex layout to separate lab and app */\n    min-height: 100vh;\n}\n\n/* --- LOGIC LAB (Side Panel) --- */\n.logic-lab {\n    width: 240px; /* Narrower sidebar */\n    background: var(--lab-bg);\n    color: white;\n    padding: 24px 16px;\n    border-right: 1px solid #333;\n    display: flex;\n    flex-direction: column;\n    z-index: 1000;\n}\n\n.logic-lab.minimized { width: 60px; overflow: hidden; }\n.logic-lab.minimized .lab-content { display: none; }\n\n.lab-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 30px;\n}\n\n.lab-header h3 { font-size: 14px; text-transform: uppercase; letter-spacing: 1px; }\n\n.lab-toggle-btn { background: transparent; border: none; color: white; cursor: pointer; font-size: 20px; }\n\n.control-group {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 20px;\n}\n\n.control-group label { font-size: 13px; color: #aaa; }\n\n.lab-btn {\n    background: var(--lab-btn-contrast);\n    color: #111;\n    border: none;\n    padding: 6px 12px;\n    border-radius: 4px;\n    font-weight: 700;\n    font-size: 11px;\n    cursor: pointer;\n    min-width: 60px;\n    transition: background 0.2s;\n}\n\n.lab-btn.active {\n    background: var(--stripe-blue);\n    color: white;\n}\n\n.status-box {\n    margin-top: 30px;\n    padding-top: 20px;\n    border-top: 1px solid #333;\n    text-align: center;\n}\n\n#logicStatus { font-weight: bold; font-size: 24px; font-family: monospace; margin-top: 10px; }\n\n/* --- SUMMARY APP (Pushed Right) --- */\n.summary-container {\n    flex: 1; /* Occupies remaining space */\n    padding: 80px 40px;\n    max-width: 540px;\n    margin: 0 auto;\n}\n\n.merchant-header { display: flex; align-items: center; gap: 15px; margin-bottom: 40px; }\n.store-brand { display: flex; align-items: center; gap: 8px; }\n.store-logo { width: 28px; height: 28px; background: #3c4257; color: white; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-weight: bold; }\n.store-name { font-weight: 600; font-size: 15px; }\n.test-badge { background: #fffaea; color: #8a6d1c; font-size: 10px; font-weight: bold; padding: 2px 6px; border-radius: 4px; }\n\n.hero-total h1 { font-size: 48px; font-weight: 600; margin: 0; }\n.pay-label { color: var(--text-sub); font-size: 15px; margin-bottom: 8px; }\n\n.item-thumb { width: 64px; height: 64px; object-fit: cover; border-radius: 8px; border: 1px solid var(--border-color); }\n.line-item { display: flex; justify-content: space-between; align-items: center; margin-top: 40px; }\n.item-info { display: flex; gap: 16px; align-items: center; }\n.item-title { font-weight: 500; font-size: 15px; margin: 0; }\n.item-meta { color: var(--text-sub); font-size: 13px; margin-top: 2px; }\n\n.divider { height: 1px; background: var(--border-color); margin: 32px 0; }\n.price-row { display: flex; justify-content: space-between; font-size: 14px; margin-bottom: 16px; }\n.sub-text { color: var(--text-sub); font-size: 12px; margin-top: 4px; }\n.total-row { font-weight: 600; font-size: 18px; color: var(--text-main); }\n.free-highlight { color: #228403; font-weight: 600; }\n\n.stripe-footer { margin-top: 80px; display: flex; justify-content: space-between; font-size: 12px; color: var(--text-sub); border-top: 1px solid var(--border-color); padding-top: 20px; }",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "// State Variables\nlet isOverFifty = false;\nlet hasCoupon = false;\n\n// UI Elements\nconst totalDisplay = document.getElementById(\"totalDisplay\");\nconst finalTotal = document.getElementById(\"finalTotal\");\nconst shippingCost = document.getElementById(\"shippingCost\");\nconst shippingType = document.getElementById(\"shippingType\");\n\nconst BASE_PRICE = 65.00;\nconst STANDARD_SHIPPING = 10.00;\n\n// Function to update the free shipping logic\n\n\n\n\n\n\n\n\nupdateAppUI();",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
          "name": "lab-overlay.js",
          "contents": "const btnA = document.getElementById('toggleA');\nconst btnB = document.getElementById('toggleB');\nconst statusDisplay = document.getElementById('logicStatus');\nconst toggleMinimizeBtn = document.getElementById('toggleLabMinimize');\nconst logicLabPanel = document.getElementById('logicLabPanel');\n\n// Lab Window Interaction\ntoggleMinimizeBtn.addEventListener('click', () => {\n    logicLabPanel.classList.toggle('minimized');\n    toggleMinimizeBtn.innerText = logicLabPanel.classList.contains('minimized') ? '+' : '−';\n});\n\n// Toggle Events\nbtnA.addEventListener('click', () => {\n    isOverFifty = !isOverFifty;\n    btnA.innerText = isOverFifty ? \"TRUE\" : \"FALSE\";\n    btnA.classList.toggle('active');\n    updateAppUI();\n    updateLabStatus();\n});\n\nbtnB.addEventListener('click', () => {\n    hasCoupon = !hasCoupon;\n    btnB.innerText = hasCoupon ? \"TRUE\" : \"FALSE\";\n    btnB.classList.toggle('active');\n    updateAppUI();\n    updateLabStatus();\n});\n\nfunction updateLabStatus() {\n    const result = isOverFifty || hasCoupon;\n    statusDisplay.innerText = result.toString();\n    statusDisplay.style.color = result ? \"#007fff\" : \"#ff4e4e\";\n}",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
        "5": {
