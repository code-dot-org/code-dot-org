      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Food Allergy Tracker</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <div id=\"app\">\n    <h1>Food Allergy Tracker</h1>\n    <p class=\"subtitle\">Tracking safe foods using Parallel Arrays</p>\n\n    <div class=\"card\" id=\"card-0\">\n      <h3>Item #0</h3>\n      <p><strong>Food:</strong> <span id=\"name-0\">...</span></p>\n      <p><strong>Ingredients:</strong> <span id=\"ingredients-0\">...</span></p>\n      <p><strong>Safe?</strong> <span id=\"safe-0\">...</span></p>\n    </div>\n\n    <div class=\"card\" id=\"card-1\">\n      <h3>Item #1</h3>\n      <p><strong>Food:</strong> <span id=\"name-1\">...</span></p>\n      <p><strong>Ingredients:</strong> <span id=\"ingredients-1\">...</span></p>\n      <p><strong>Safe?</strong> <span id=\"safe-1\">...</span></p>\n    </div>\n\n    <div class=\"card\" id=\"card-2\">\n      <h3>Item #2</h3>\n      <p><strong>Food:</strong> <span id=\"name-2\">...</span></p>\n      <p><strong>Ingredients:</strong> <span id=\"ingredients-2\">...</span></p>\n      <p><strong>Safe?</strong> <span id=\"safe-2\">...</span></p>\n    </div>\n\n  </div>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// 1. Data: Parallel Arrays representing the Schema\nconst foodNames = [\"Peanut Butter Bar\", \"Apple Slices\", \"Cheese Pizza\"];\nconst ingredients = [\"Oats, Peanuts, Honey\", \"Red Delicious Apple\", \"Dough, Tomato, Cheese\"];\nconst isSafe = [false, true, true]; // Schema assumes 'true' means safe to eat\n\n// 2. Wire up Card 0 (Manual Indexing)\n// Select Elements\nconst name0 = document.querySelector(\"#name-0\");\nconst ing0 = document.querySelector(\"#ingredients-0\");\nconst safe0 = document.querySelector(\"#safe-0\");\n\n// Update Text\nname0.innerText = foodNames[0];\ning0.innerText = ingredients[0];\nsafe0.innerText = isSafe[0];\n\n// 3. Wire up Card 1 (Manual Indexing)\nconst name1 = document.querySelector(\"#name-1\");\nconst ing1 = document.querySelector(\"#ingredients-1\");\nconst safe1 = document.querySelector(\"#safe-1\");\n\nname1.innerText = foodNames[1];\ning1.innerText = ingredients[1];\nsafe1.innerText = isSafe[1];\n\n// 4. Wire up Card 2 (Manual Indexing)\nconst name2 = document.querySelector(\"#name-2\");\nconst ing2 = document.querySelector(\"#ingredients-2\");\nconst safe2 = document.querySelector(\"#safe-2\");\n\nname2.innerText = foodNames[2];\ning2.innerText = ingredients[2];\nsafe2.innerText = isSafe[2];",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "/* Global Styles */\nbody {\n  font-family: 'Verdana', sans-serif;\n  background-color: #fdf6e3;\n  color: #333;\n  display: flex;\n  justify-content: center;\n  padding: 20px;\n}\n\n#app {\n  width: 100%;\n  max-width: 500px;\n}\n\nh1 {\n  text-align: center;\n  color: #d35400;\n  margin-bottom: 5px;\n}\n\n.subtitle {\n  text-align: center;\n  font-style: italic;\n  color: #7f8c8d;\n  margin-bottom: 30px;\n}\n\n/* Card Styles */\n.card {\n  background: white;\n  border-left: 8px solid #bdc3c7; /* Default gray */\n  border-radius: 8px;\n  box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n  margin-bottom: 20px;\n  padding: 15px 20px;\n}\n\n.card h3 {\n  margin-top: 0;\n  border-bottom: 1px solid #eee;\n  padding-bottom: 10px;\n  color: #2c3e50;\n}\n\np {\n  margin: 8px 0;\n  font-size: 0.95rem;\n}\n\nspan {\n  font-weight: bold;\n  color: #2980b9;\n}",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "exemplar.js",
          "language": "js",
          "contents": "// EXEMPLAR SOLUTION\n\n// 1. Schema Arrays (Parallel Arrays)\n// We use matching indexes to link data. Index 0 is the first shoe, etc.\nconst names = [\"Air Strider\", \"Zoom Vibe\", \"Retro High\"];\nconst prices = [\"$120\", \"$95\", \"$150\"];\nconst colors = [\"#FF5733\", \"#33FF57\", \"#3357FF\"]; // Hex codes for colors\n\n// 2. Wire up Card 1 (Index 0)\nconst name1 = document.querySelector(\"#card1-name\");\nconst price1 = document.querySelector(\"#card1-price\");\nconst color1 = document.querySelector(\"#card1-color\");\n\nname1.textContent = names[0];\nprice1.textContent = prices[0];\ncolor1.style.backgroundColor = colors[0];\n\n// 3. Wire up Card 2 (Index 1)\nconst name2 = document.querySelector(\"#card2-name\");\nconst price2 = document.querySelector(\"#card2-price\");\nconst color2 = document.querySelector(\"#card2-color\");\n\nname2.textContent = names[1];\nprice2.textContent = prices[1];\ncolor2.style.backgroundColor = colors[1];\n\n// 4. Wire up Card 3 (Index 2)\nconst name3 = document.querySelector(\"#card3-name\");\nconst price3 = document.querySelector(\"#card3-price\");\nconst color3 = document.querySelector(\"#card3-color\");\n\nname3.textContent = names[2];\nprice3.textContent = prices[2];\ncolor3.style.backgroundColor = colors[2];",
          "folderId": "0",
          "active": false
        },
