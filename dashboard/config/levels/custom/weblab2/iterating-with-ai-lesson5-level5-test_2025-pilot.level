      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>Movie Cards</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    \n    <h1>Movie Collection</h1>\n    \n    <div id=\"cards-container\"></div>\n\n    <script src=\"script.js\" defer></script>\n  </body>\n</html>\n  ",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: sans-serif;\n  background-color: #f4f4f9;\n  padding: 20px;\n}\n\nh1 {\n  text-align: center;\n  color: #333;\n}\n\n/* Container to hold all cards */\n#cards-container {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 20px;\n}\n\n/* Individual Card Styling */\n.card {\n  background: white;\n  border: 1px solid #ddd;\n  border-radius: 8px;\n  width: 250px;\n  overflow: hidden; /* Keeps image corners rounded */\n  box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n  display: flex;\n  flex-direction: column;\n}\n\n.card-image {\n  width: 100%;\n  height: 150px;\n  object-fit: cover; /* Ensures placeholder/image fills area nicely */\n  background-color: #eee;\n}\n\n.card-content {\n  padding: 15px;\n}\n\n.card-title {\n  margin-top: 0;\n  font-size: 1.2em;\n  color: #222;\n}\n\n.card-meta {\n  font-size: 0.9em;\n  color: #666;\n  margin-bottom: 10px;\n  font-style: italic;\n}\n\n.card-rating {\n  font-weight: bold;\n  color: #007bff; /* Blue for emphasis */\n  margin-bottom: 10px;\n}\n\n.card-summary {\n  font-size: 0.9em;\n  line-height: 1.4;\n  color: #444;\n}\n\n.read-more-btn {\n  display: inline-block;\n  margin-top: 10px;\n  padding: 8px 12px;\n  background-color: transparent;\n  border: 1px solid #333;\n  border-radius: 20px;\n  text-decoration: none;\n  color: #333;\n  font-size: 0.85em;\n  width: fit-content;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "// DATASET\n// Includes records with valid data and records with nulls to test fallbacks\nconst movies = [\n  {\n    title: \"Galaxy Quest\",\n    genre: \"Sci-Fi\",\n    runtimeMinutes: 102,\n    rating: 4.5,\n    imageURL: \"galaxy_quest.jpg\",\n    summary: \"A washed-up TV crew is mistaken for real heroes.\"\n  },\n  {\n    title: \"The Lost City\",\n    genre: \"Adventure\",\n    runtimeMinutes: 112,\n    rating: null, \n    imageURL: \"lost_city.jpg\",\n    summary: \"An author gets kidnapped in the jungle.\"\n  },\n  {\n    title: \"Mystery of the Deep\",\n    genre: \"Documentary\",\n    runtimeMinutes: 45,\n    rating: 3.8,\n    imageURL: null,\n    summary: \"Exploring the bottom of the Mariana Trench.\"\n  },\n  {\n    title: \"Speed Racer\",\n    genre: \"Action\",\n    runtimeMinutes: 120,\n    rating: 2.5,\n    imageURL: \"speed_racer.jpg\",\n    summary: null\n  },\n  {\n    title: \"Cooking 101\",\n    genre: \"Educational\",\n    runtimeMinutes: null,\n    rating: 5.0,\n    imageURL: null,\n    summary: \"Learn to cook basic meals in under 30 minutes.\"\n  },\n  {\n    title: \"The Silent Forest\",\n    genre: \"Horror\",\n    runtimeMinutes: 95,\n    rating: null,\n    imageURL: null,\n    summary: \"Something lurks in the trees behind the cabin.\"\n  },\n  {\n    title: \"Code Warriors\",\n    genre: \"Sci-Fi\",\n    runtimeMinutes: 140,\n    rating: 4.9,\n    imageURL: \"\",\n    summary: \"Hackers fight to save the digital world.\"\n  },\n  {\n    title: \"Midnight Jazz\",\n    genre: \"Music\",\n    runtimeMinutes: 180,\n    rating: null,\n    imageURL: \"jazz.jpg\",\n    summary: null\n  },\n  {\n    title: \"Sunny Days\",\n    genre: \"Comedy\",\n    runtimeMinutes: 88,\n    rating: 3.2,\n    imageURL: \"sunny_days.jpg\",\n    summary: \"A family vacation goes wrong in hilarious ways.\"\n  },\n  {\n    title: \"Untitled Project\",\n    genre: \"Unknown\",\n    runtimeMinutes: 0,\n    rating: null,\n    imageURL: null,\n    summary: null\n  }\n];\n\n// Select the container\nconst container = document.querySelector(\"#cards-container\");\n\n// LOOP THROUGH THE DATA\n\n\n\n\n  // --- FALLBACK LOGIC ---\n\n\n\n\n  // --- CREATE CARD ---\n\n\n\n\n",
          "folderId": "0",
          "active": true
        },
