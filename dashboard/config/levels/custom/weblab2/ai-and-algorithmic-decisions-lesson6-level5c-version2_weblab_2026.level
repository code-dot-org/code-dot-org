        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const productiveBtn = document.getElementById('productiveBtn');\nconst restorativeBtn = document.getElementById('restorativeBtn');\nconst centeredBtn = document.getElementById('centeredBtn');\nconst activeBtn = document.getElementById('activeBtn');\n\nproductiveBtn.addEventListener(\"click\", () => {\n    // call your function here\n});\nrestorativeBtn.addEventListener(\"click\", () => {\n    // call your function here\n});\ncenteredBtn.addEventListener(\"click\", () => {\n    // call your function here\n});\nactiveBtn.addEventListener(\"click\", () => {\n    // call your function here\n});\n",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "style.css",
          "contents": ":root {\n    --lab-bg: #fdfdfd;\n    --lab-card: #ffffff;\n    --lab-text-main: #1a1a1a;\n    --lab-text-muted: #757575;\n    --lab-accent: #8e9481; /* Sage neutral */\n    --lab-border: #eeeeee;\n    --lab-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);\n}\n\n* {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n}\n\nbody {\n    font-family: 'Inter', sans-serif;\n    background-color: #f5f5f5;\n    color: var(--lab-text-main);\n    line-height: 1.6;\n}\n\n/* App Shell */\n.app-shell {\n    width: min(100%, 1000px);\n    margin: 0 auto;\n    background: var(--lab-bg);\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n    box-shadow: 0 0 40px rgba(0,0,0,0.05);\n}\n\n/* Fixed Top */\n.fixed-top {\n    position: sticky;\n    top: 0;\n    z-index: 100;\n    background: var(--lab-bg);\n    border-bottom: 1px solid var(--lab-border);\n}\n\n.navbar {\n    padding: 20px;\n    text-align: center;\n}\n\n.nav-title {\n    font-size: 0.75rem;\n    letter-spacing: 0.3em;\n    font-weight: 600;\n    color: var(--lab-text-main);\n}\n\n/* Status Panel */\n.status-panel {\n    padding: 20px 40px 30px;\n}\n\n.status-grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 20px;\n    max-width: 600px;\n    margin: 0 auto;\n}\n\n.status-block {\n    text-align: center;\n}\n\n.status-label {\n    font-size: 0.65rem;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    color: var(--lab-text-muted);\n    margin-bottom: 8px;\n}\n\n.status-panel h2 {\n    font-family: 'Playfair Display', serif;\n    font-size: 1.8rem;\n    font-weight: 400;\n    font-style: italic;\n}\n\n/* Hero Section */\n.hero-banner {\n    height: 300px;\n    background-size: cover;\n    background-position: center;\n    position: relative;\n    display: flex;\n    align-items: flex-end;\n    padding: 40px;\n}\n\n.hero-overlay h2 {\n    font-family: 'Playfair Display', serif;\n    font-size: 2.5rem;\n    font-weight: 400;\n    margin-bottom: 5px;\n}\n\n.hero-overlay p {\n    font-size: 0.95rem;\n    color: #1a1a1a; /* Near black for maximum contrast */\n    font-weight: 600;\n    /* This creates a soft white 'halo' around the letters */\n    text-shadow: \n        0px 0px 8px rgba(255, 255, 255, 0.8),\n        0px 0px 4px rgba(255, 255, 255, 0.5);\n}\n\n/* Entry Grid */\n.menu-section {\n    padding: 40px;\n}\n\n.menu-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n    gap: 30px;\n}\n\n.entry-card {\n    background: var(--lab-card);\n    border: 1px solid var(--lab-border);\n    transition: transform 0.3s ease;\n}\n\n.entry-card:hover {\n    transform: translateY(-5px);\n}\n\n.entry-card img {\n    width: 100%;\n    aspect-ratio: 1/1;\n    object-fit: cover;\n    display: block;\n}\n\n.entry-info {\n    padding: 20px;\n    text-align: center;\n}\n\n.entry-info h3 {\n    font-size: 1rem;\n    margin-bottom: 5px;\n    font-weight: 600;\n}\n\n.entry-info p {\n    font-size: 0.8rem;\n    color: var(--lab-text-muted);\n    margin-bottom: 15px;\n}\n\n/* Log Button */\n.log-btn {\n    background: none;\n    border: 1px solid var(--lab-text-main);\n    padding: 8px 20px;\n    font-size: 0.7rem;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    cursor: pointer;\n    transition: all 0.3s ease;\n}\n\n.log-btn:hover {\n    background: var(--lab-text-main);\n    color: white;\n}\n\n/* Responsive */\n@media (max-width: 600px) {\n    .status-panel { padding: 20px; }\n    .hero-banner { height: 200px; padding: 20px; }\n    .hero-overlay h2 { font-size: 1.8rem; }\n    .menu-section { padding: 20px; }\n    .menu-grid { grid-template-columns: 1fr 1fr; gap: 15px; }\n}\n",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Habit Lab | Daily Log</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Playfair+Display:ital,wght@0,400;1,400&display=swap\" rel=\"stylesheet\">\n</head>\n<body>\n    <div class=\"app-shell\">\n        <header class=\"fixed-top\">\n            <nav class=\"navbar\">\n                <div class=\"nav-title\">HABIT LAB</div>\n            </nav>\n            <div class=\"status-panel\">\n                <div class=\"status-grid\">\n                    <div class=\"status-block\">\n                        <p class=\"status-label\">Current Vibe</p>\n                        <h2 id=\"vibeDisplay\">—</h2>\n                    </div>\n                    <div class=\"status-block\">\n                        <p class=\"status-label\">Recovery</p>\n                        <h2 id=\"recoveryDisplay\">0 hrs</h2>\n                    </div>\n                </div>\n            </div>\n        </header>\n        <main class=\"scroll-content\">\n            <div class=\"hero-banner\" style=\"background-image: url('images/hero-minimal.png');\">\n                <div class=\"hero-overlay\">\n                    <h2>The Daily Log</h2>\n                    <p>Select an entry to capture your day.</p>\n                </div>\n            </div>\n            <section class=\"menu-section\">\n                <div class=\"menu-grid\">\n                    <div class=\"entry-card\">\n                        <img src=\"images/entry-1.png\" alt=\"Water with lemon\">\n                        <div class=\"entry-info\">\n                            <h3>Productive</h3>\n                            <p>Focused & high energy.</p>\n                            <p class=\"recovery-meta\">Recovery: 6 hrs</p>\n                            <button id=\"productiveBtn\" class=\"log-btn\">Log Entry</button>\n                        </div>\n                    </div>\n                    <div class=\"entry-card\">\n                        <img src=\"images/entry-2.png\" alt=\"White linens\">\n                        <div class=\"entry-info\">\n                            <h3>Restorative</h3>\n                            <p>Slow-paced & calm.</p>\n                            <p class=\"recovery-meta\">Recovery: 9 hrs</p>\n                            <button id=\"restorativeBtn\" class=\"log-btn\">Log Entry</button>\n                        </div>\n                    </div>\n                    <div class=\"entry-card\">\n                        <img src=\"images/entry-3.png\" alt=\"Lit candle\">\n                        <div class=\"entry-info\">\n                            <h3>Centered</h3>\n                            <p>Balanced & present.</p>\n                            <p class=\"recovery-meta\">Recovery: 7 hrs</p>\n                            <button id=\"centeredBtn\" class=\"log-btn\">Log Entry</button>\n                        </div>\n                    </div>\n                    <div class=\"entry-card\">\n                        <img src=\"images/entry-4.png\" alt=\"City motion\">\n                        <div class=\"entry-info\">\n                            <h3>Active</h3>\n                            <p>On the move & busy.</p>\n                            <p class=\"recovery-meta\">Recovery: 5 hrs</p>\n                            <button id=\"activeBtn\" class=\"log-btn\">Log Entry</button>\n                        </div>\n                    </div>\n                </div>\n            </section>\n        </main>\n    </div>\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "active": false
        },
