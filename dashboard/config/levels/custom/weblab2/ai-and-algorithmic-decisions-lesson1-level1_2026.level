      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>RemindMe</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <header class=\"site-header\">\n    <div class=\"brand\">Remind<span>Me</span></div>\n\n    <nav class=\"top-nav\" aria-label=\"Main navigation\">\n      <button class=\"nav-btn\" type=\"button\">🏠 <span>Home</span></button>\n      <a class=\"nav-btn\" href=\"about.html\">❓ <span>About</span></a>\n      <button id=\"themeToggle\" class=\"nav-btn theme-btn\" type=\"button\">🌓 <span>Theme</span></button>\n    </nav>\n  </header>\n\n  <main class=\"page-shell\">\n    <section class=\"workspace-header\">\n      <div>\n        <p class=\"eyebrow\">Task Panel</p>\n        <h1>Reminders</h1>\n        <p class=\"workspace-subtitle\">Manage tasks, add reminders, and keep track of what still needs attention.</p>\n      </div>\n    </section>\n\n    <section class=\"workspace-grid\">\n      <aside class=\"control-column\">\n        <section class=\"card form-card\" aria-labelledby=\"add-title\">\n          <h2 id=\"add-title\">Add Reminder</h2>\n\n          <label for=\"title\" class=\"field-label\">Title</label>\n          <input\n            type=\"text\"\n            id=\"title\"\n            placeholder=\"e.g., Finish history outline\"\n          />\n\n          <div class=\"actions primary-actions\">\n            <button id=\"saveBtn\" class=\"btn btn-secondary\" title=\"Saves (maybe)\" type=\"button\">Save</button>\n            <button id=\"addBtn\" class=\"btn btn-primary\" title=\"Click twice?\" type=\"button\">Add</button>\n          </div>\n\n          <div class=\"actions secondary-actions\">\n            <button id=\"clearBtn\" class=\"btn btn-outline\" type=\"button\">Clear All</button>\n            <button id=\"shuffleBtn\" class=\"btn btn-ghost\" type=\"button\">Shuffle</button>\n            <button id=\"helpBtn\" class=\"btn btn-icon\" type=\"button\" aria-label=\"Help\">?</button>\n          </div>\n        </section>\n\n        <section class=\"card status-card\" aria-labelledby=\"status-title\">\n          <div class=\"status-header\">\n            <h2 id=\"status-title\">Status</h2>\n            <span class=\"status-pill\">Live</span>\n          </div>\n          <p id=\"hint\" class=\"hint\">Tip: Use Add to add a reminder. Or maybe Save?</p>\n        </section>\n      </aside>\n\n      <section class=\"card list-card\" aria-labelledby=\"list-title\">\n        <div class=\"list-header\">\n          <h2 id=\"list-title\">Reminders</h2>\n          <span class=\"list-badge\">Today</span>\n        </div>\n\n        <p class=\"list-subtitle\">Your latest reminder activity appears here.</p>\n\n        <ul id=\"list\" class=\"reminder-list\" aria-live=\"polite\"></ul>\n        <p id=\"emptyState\" class=\"empty-state\">No reminders yet. Add your first one from the panel on the left.</p>\n      </section>\n    </section>\n  </main>\n\n  <footer class=\"site-footer\">\n    <p>© 2025 RemindMe</p>\n    <a href=\"about.html\">About</a>\n  </footer>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": ":root {\n  --bg: #f4f6fb;\n  --surface: #ffffff;\n  --surface-soft: #eef2f8;\n  --text: #172033;\n  --muted: #667085;\n  --border: #d8deea;\n  --primary: #3867e8;\n  --primary-dark: #244fc7;\n  --shadow: 0 10px 28px rgba(23, 32, 51, 0.08);\n  --radius: 20px;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  font-family: Arial, Helvetica, sans-serif;\n  background: var(--bg);\n  color: var(--text);\n}\n\n.site-header {\n  background: rgba(255, 255, 255, 0.94);\n  border-bottom: 1px solid var(--border);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  padding: 18px 28px;\n}\n\n.brand {\n  font-size: 2rem;\n  font-weight: 800;\n  letter-spacing: -0.03em;\n}\n\n.brand span {\n  color: var(--primary);\n}\n\n.top-nav {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex-wrap: wrap;\n}\n\n.nav-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  background: transparent;\n  border: 1px solid transparent;\n  color: var(--text);\n  text-decoration: none;\n  font-size: 1rem;\n  font-weight: 600;\n  padding: 12px 16px;\n  border-radius: 14px;\n  cursor: pointer;\n}\n\n.theme-btn,\n.top-nav .nav-btn:last-child {\n  border-color: var(--border);\n  background: rgba(255, 255, 255, 0.75);\n}\n\n.page-shell {\n  max-width: 1380px;\n  margin: 0 auto;\n  padding: 24px 20px 72px;\n}\n\n.workspace-header {\n  margin-bottom: 20px;\n}\n\n.eyebrow {\n  margin: 0 0 8px;\n  font-size: 0.85rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n\n.workspace-header h1 {\n  margin: 0 0 8px;\n  font-size: 2.6rem;\n  line-height: 1.05;\n  letter-spacing: -0.04em;\n}\n\n.workspace-subtitle {\n  margin: 0;\n  max-width: 700px;\n  font-size: 1.08rem;\n  color: var(--muted);\n}\n\n.workspace-grid {\n  display: grid;\n  grid-template-columns: 430px 1fr;\n  gap: 24px;\n  align-items: start;\n}\n\n.control-column {\n  display: grid;\n  gap: 18px;\n}\n\n.card {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius);\n  box-shadow: var(--shadow);\n  padding: 28px;\n}\n\n.card h2 {\n  margin: 0 0 18px;\n  font-size: 1.95rem;\n  letter-spacing: -0.03em;\n}\n\n.field-label {\n  display: block;\n  margin-bottom: 10px;\n  font-size: 1rem;\n  font-weight: 700;\n}\n\ninput {\n  width: 100%;\n  border: 1px solid var(--border);\n  border-radius: 14px;\n  background: #fff;\n  padding: 16px 18px;\n  font-size: 1.02rem;\n  color: var(--text);\n  outline: none;\n}\n\ninput::placeholder {\n  color: #8a93a5;\n}\n\n.actions {\n  display: flex;\n  gap: 12px;\n  flex-wrap: wrap;\n  margin-top: 16px;\n  position: relative;\n}\n\n.primary-actions {\n  margin-top: 18px;\n}\n\n.secondary-actions {\n  margin-top: 12px;\n}\n\n.btn {\n  border: none;\n  border-radius: 14px;\n  padding: 14px 18px;\n  font-size: 1rem;\n  font-weight: 700;\n  cursor: pointer;\n  transition: transform 0.15s ease, box-shadow 0.15s ease;\n}\n\n.btn:hover {\n  transform: translateY(-1px);\n}\n\n.btn-primary {\n  background: var(--primary);\n  color: #fff;\n}\n\n.btn-secondary {\n  background: #edf2ff;\n  color: var(--text);\n  position: relative;\n  transition: left 0.15s ease, top 0.15s ease, transform 0.15s ease;\n}\n\n.btn-outline {\n  background: transparent;\n  color: var(--primary);\n  border: 2px solid var(--primary);\n}\n\n.btn-ghost {\n  background: #f7f8fc;\n  color: var(--text);\n  border: 1px solid var(--border);\n}\n\n.btn-icon {\n  background: #f7f8fc;\n  color: var(--muted);\n  border: 1px solid var(--border);\n  min-width: 56px;\n}\n\n.status-card {\n  padding-top: 22px;\n  padding-bottom: 22px;\n  background: linear-gradient(180deg, #ffffff 0%, #f8faff 100%);\n}\n\n.status-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 12px;\n}\n\n.status-header h2 {\n  margin: 0;\n  font-size: 1.5rem;\n}\n\n.status-pill {\n  display: inline-block;\n  padding: 7px 10px;\n  border-radius: 999px;\n  background: var(--surface-soft);\n  color: var(--muted);\n  font-size: 0.82rem;\n  font-weight: 700;\n}\n\n.hint {\n  margin: 0;\n  min-height: 24px;\n  font-size: 0.97rem;\n  color: var(--muted);\n  line-height: 1.45;\n}\n\n.list-card {\n  min-height: 520px;\n}\n\n.list-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.list-badge {\n  display: inline-block;\n  padding: 8px 12px;\n  border-radius: 999px;\n  background: var(--surface-soft);\n  color: var(--muted);\n  font-size: 0.92rem;\n  font-weight: 700;\n}\n\n.list-subtitle {\n  margin: 4px 0 22px;\n  color: var(--muted);\n  font-size: 1rem;\n}\n\n.reminder-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.reminder-list li {\n  margin: 0 0 12px;\n  padding: 14px 16px;\n  background: #f7f9fd;\n  border: 1px solid var(--border);\n  border-radius: 14px;\n  cursor: pointer;\n  font-size: 1rem;\n}\n\n.reminder-list li.done {\n  color: #a8afbf;\n  text-decoration: line-through;\n}\n\n.empty-state {\n  margin-top: 16px;\n  color: var(--muted);\n  font-size: 1rem;\n}\n\n.site-footer {\n  border-top: 1px solid var(--border);\n  padding: 26px 20px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  color: var(--text);\n}\n\n.site-footer a {\n  color: var(--text);\n  text-decoration: none;\n}\n\n.about-shell {\n  padding: 40px 20px 80px;\n}\n\n.about-card {\n  max-width: 760px;\n  margin: 0 auto;\n  line-height: 1.6;\n}\n\n.about-card ul {\n  padding-left: 24px;\n}\n\n#confirmYes,\n#confirmNo {\n  margin-left: 10px;\n  border: 1px solid var(--border);\n  background: #fff;\n  color: var(--text);\n  border-radius: 10px;\n  padding: 8px 12px;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n@media (max-width: 980px) {\n  .workspace-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .workspace-header h1 {\n    font-size: 2.2rem;\n  }\n\n  .site-header {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "console.log(\"📦 script loaded\");\n\nconst titleInput = document.getElementById(\"title\");\nconst list = document.getElementById(\"list\");\nconst emptyState = document.getElementById(\"emptyState\");\n\nconst saveBtn = document.getElementById(\"saveBtn\");\nconst addBtn = document.getElementById(\"addBtn\");\nconst clearBtn = document.getElementById(\"clearBtn\");\nconst shuffleBtn = document.getElementById(\"shuffleBtn\");\nconst helpBtn = document.getElementById(\"helpBtn\");\nconst themeToggle = document.getElementById(\"themeToggle\");\nconst hint = document.getElementById(\"hint\");\n\nconst updateEmptyState = () => {\n  if (!emptyState) return;\n  emptyState.style.display = list.children.length === 0 ? \"block\" : \"none\";\n};\n\nconst addItem = (text) => {\n  const li = document.createElement(\"li\");\n  li.textContent = text || \"Untitled\";\n  li.addEventListener(\"click\", () => li.classList.toggle(\"done\"));\n  list.appendChild(li);\n  updateEmptyState();\n};\n\n// SAVE BUTTON: still runs away\nsaveBtn.addEventListener(\"mouseenter\", () => {\n  const dx = Math.random() < 0.5 ? -70 : 70;\n  const dy = Math.random() < 0.5 ? -12 : 12;\n  saveBtn.style.left = (parseInt(saveBtn.style.left || 0, 10) + dx) + \"px\";\n  saveBtn.style.top = (parseInt(saveBtn.style.top || 0, 10) + dy) + \"px\";\n});\n\nsaveBtn.addEventListener(\"click\", () => {\n  alert(\"Saved! (But nothing was actually added.)\");\n});\n\n// ADD BUTTON: still requires double click\nlet armed = false;\nlet armTimer = null;\n\naddBtn.addEventListener(\"click\", () => {\n  if (!armed) {\n    armed = true;\n    hint.textContent = \"Click Add again quickly to confirm.\";\n    armTimer = setTimeout(() => {\n      armed = false;\n      hint.textContent = \"Tip: Use Add to add a reminder. Or maybe Save?\";\n    }, 1000);\n    return;\n  }\n\n  clearTimeout(armTimer);\n  armed = false;\n  addItem(titleInput.value.trim());\n  titleInput.value = \"\";\n  hint.textContent = \"Reminder added. Or at least, this time it was.\";\n});\n\n// Inline confirm\nfunction inlineConfirm(message, onYes, onNo) {\n  hint.innerHTML = `\n    ${message}\n    <button id=\"confirmYes\" type=\"button\">Yes</button>\n    <button id=\"confirmNo\" type=\"button\">No</button>\n  `;\n  const yes = document.getElementById(\"confirmYes\");\n  const no = document.getElementById(\"confirmNo\");\n  yes.onclick = () => {\n    onYes();\n    hint.textContent = \"\";\n  };\n  no.onclick = () => {\n    if (onNo) onNo();\n    hint.textContent = \"\";\n  };\n}\n\n// CLEAR ALL: still removes one random item\nclearBtn.addEventListener(\"click\", () => {\n  const proceed = () => {\n    const items = Array.from(list.querySelectorAll(\"li\"));\n    if (items.length === 0) {\n      hint.textContent = \"No reminders to clear.\";\n      return;\n    }\n\n    const idx = Math.floor(Math.random() * items.length);\n    const removedText = items[idx].textContent;\n    items[idx].remove();\n    updateEmptyState();\n\n    const remaining = Array.from(list.querySelectorAll(\"li\")).map((li) => li.textContent);\n    hint.textContent = remaining.length\n      ? `Removed: \"${removedText}\". Remaining: ${remaining.join(\" • \")}`\n      : `Removed: \"${removedText}\". No reminders left.`;\n  };\n\n  try {\n    if (typeof window.confirm === \"function\") {\n      const ok = window.confirm(\"Clear all reminders?\");\n      if (ok) proceed();\n    } else {\n      inlineConfirm(\"Clear all reminders?\", proceed);\n    }\n  } catch {\n    inlineConfirm(\"Clear all reminders?\", proceed);\n  }\n});\n\n// SHUFFLE: still randomizes list and unexpectedly changes page color\nshuffleBtn.addEventListener(\"click\", () => {\n  const items = Array.from(list.children);\n\n  for (let i = items.length - 1; i > 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    list.insertBefore(items[j], items[i]);\n  }\n\n  document.body.style.backgroundColor = `hsl(${Math.floor(Math.random() * 360)}, 45%, 92%)`;\n});\n\n// HELP: still vague\nconst confusingTips = [\n  \"Tip: Try clicking everything to see what works!\",\n  \"Some buttons behave differently than expected.\",\n  \"Try Save… or maybe Add?\",\n];\n\nhelpBtn.addEventListener(\"mouseenter\", () => {\n  const tip = confusingTips[Math.floor(Math.random() * confusingTips.length)];\n  hint.textContent = tip;\n});\n\n// THEME: still confusing label / unclear state\nthemeToggle.addEventListener(\"click\", () => {\n  const isMuted = document.body.style.filter !== \"grayscale(1)\";\n  document.body.style.filter = isMuted ? \"grayscale(1)\" : \"grayscale(0)\";\n  themeToggle.innerHTML = \"🌓 <span>Theme</span>\";\n});\n\nupdateEmptyState();",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "about.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>About — RemindMe</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <header class=\"site-header\">\n    <div class=\"brand\">Remind<span>Me</span></div>\n\n    <nav class=\"top-nav\" aria-label=\"Main navigation\">\n      <a class=\"nav-btn\" href=\"index.html\">🏠 <span>Home</span></a>\n      <button class=\"nav-btn\" type=\"button\">❓ <span>About</span></button>\n      <button class=\"nav-btn theme-btn\" type=\"button\">🌓 <span>Theme</span></button>\n    </nav>\n  </header>\n\n  <main class=\"about-shell\">\n    <section class=\"card about-card\">\n      <h1>About RemindMe</h1>\n      <p>\n        RemindMe helps users keep track of tasks and deadlines in one simple place.\n        Add reminders, manage your list, and stay organized throughout the day.\n      </p>\n\n      <h2>Features</h2>\n      <ul>\n        <li>Create and manage reminders</li>\n        <li>Reorder tasks with a quick shuffle tool</li>\n        <li>Try different theme options</li>\n        <li>Access helpful guidance from the help menu</li>\n      </ul>\n\n      <p>\n        Our goal is to make task management feel simple, flexible, and easy to use.\n      </p>\n\n      <p><a href=\"index.html\">Return to the app →</a></p>\n    </section>\n  </main>\n\n  <footer class=\"site-footer\">\n    <p>© 2025 RemindMe</p>\n    <a href=\"about.html\">About</a>\n  </footer>\n</body>\n</html>",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [

      ]
    },
    "long_instructions": "## Explore Web App\r\n\r\nGo to Level 2 and try to use the web app.\r\n\r\nRefer to your activity guide for what to pay attention to.\r\n\r\nThen move on to Level 3.",
    "name_suffix": "_2026",
    "ai_tutor_prompt_settings": {
      "answerTypes": [
        "ask"
      ],
      "answerTypeCustomizations": {
        "ask": "Students are exploring two versions of a web app and comparing how the interactions affect the user experience. Ask questions that prompt them to identify what feels confusing or helpful when they interact with the app, but do not explain the issues or tell them which version is better."
      }
    }
  },
  "audit_log": "[{\"changed_at\":\"2026-03-20T23:40:26.161+00:00\",\"changed\":[\"cloned from \\\"ai-and-algorithmic-decisions-lesson1-level1_2025\\\"\"],\"cloned_from\":\"ai-and-algorithmic-decisions-lesson1-level1_2025\"},{\"changed_at\":\"2026-03-27 23:08:06 +0000\",\"changed\":[\"start_sources\"],\"changed_by_id\":18602,\"changed_by_email\":\"angelina+levelbuilder@code.org\"},{\"changed_at\":\"2026-03-27 23:18:49 +0000\",\"changed\":[\"long_instructions\"],\"changed_by_id\":18602,\"changed_by_email\":\"angelina+levelbuilder@code.org\"},{\"changed_at\":\"2026-03-27 23:19:54 +0000\",\"changed\":[\"long_instructions\"],\"changed_by_id\":18602,\"changed_by_email\":\"angelina+levelbuilder@code.org\"},{\"changed_at\":\"2026-03-29 22:14:11 +0000\",\"changed\":[\"widget_view\"],\"changed_by_id\":18602,\"changed_by_email\":\"angelina+levelbuilder@code.org\"}]"
}]]></config>
