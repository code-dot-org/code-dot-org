        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>LunchLine</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <svg class=\"icon-sprite\" aria-hidden=\"true\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\">\n    <defs>\n      <g id=\"pizza-base\">\n        <path d=\"M9 15 Q32 3 55 15 L34 58 Q32 62 30 58 Z\" fill=\"#FFD45C\" stroke=\"#2B1B3D\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n        <path d=\"M24 44 Q25 50 27 46 Q28 41 30 44\" fill=\"#FFD45C\" stroke=\"#2B1B3D\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n        <path d=\"M7 14 Q32 1 57 14 L54 21 Q32 9 10 21 Z\" fill=\"#E59A45\" stroke=\"#2B1B3D\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n        <path d=\"M15 14 Q32 7 49 14\" fill=\"none\" stroke=\"#F7C27A\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n      </g>\n    </defs>\n\n    <symbol id=\"icon-logo\" viewBox=\"0 0 64 64\">\n      <rect x=\"4\" y=\"12\" width=\"56\" height=\"42\" rx=\"10\" fill=\"#FF8A3D\" stroke=\"#2B1B3D\" stroke-width=\"3\"/>\n      <rect x=\"10\" y=\"18\" width=\"24\" height=\"30\" rx=\"5\" fill=\"#FFF3C4\" stroke=\"#2B1B3D\" stroke-width=\"2\"/>\n      <rect x=\"38\" y=\"18\" width=\"16\" height=\"13\" rx=\"4\" fill=\"#FFF3C4\" stroke=\"#2B1B3D\" stroke-width=\"2\"/>\n      <rect x=\"38\" y=\"35\" width=\"16\" height=\"13\" rx=\"4\" fill=\"#FFF3C4\" stroke=\"#2B1B3D\" stroke-width=\"2\"/>\n      <path d=\"M22 26 Q15 33 22 40 Q29 33 22 26 Z\" fill=\"#E23E7B\"/>\n      <circle cx=\"46\" cy=\"24.5\" r=\"3.5\" fill=\"#2E9B5A\"/>\n      <circle cx=\"46\" cy=\"41.5\" r=\"3.5\" fill=\"#FFC21A\"/>\n    </symbol>\n\n    <symbol id=\"icon-tray\" viewBox=\"0 0 64 64\">\n      <rect x=\"3\" y=\"14\" width=\"58\" height=\"38\" rx=\"9\" fill=\"#14A394\" stroke=\"#2B1B3D\" stroke-width=\"2.5\"/>\n      <rect x=\"8\" y=\"19\" width=\"24\" height=\"28\" rx=\"5\" fill=\"#DDF7F2\" stroke=\"#2B1B3D\" stroke-width=\"2\"/>\n      <rect x=\"36\" y=\"19\" width=\"20\" height=\"12\" rx=\"4\" fill=\"#DDF7F2\" stroke=\"#2B1B3D\" stroke-width=\"2\"/>\n      <rect x=\"36\" y=\"35\" width=\"20\" height=\"12\" rx=\"4\" fill=\"#DDF7F2\" stroke=\"#2B1B3D\" stroke-width=\"2\"/>\n      <path d=\"M13 40 L20 24 L27 40 Z\" fill=\"#FFD45C\" stroke=\"#2B1B3D\" stroke-width=\"1.5\" stroke-linejoin=\"round\"/>\n      <circle cx=\"20\" cy=\"33\" r=\"2\" fill=\"#E0473C\"/>\n      <ellipse cx=\"46\" cy=\"25\" rx=\"6\" ry=\"3.5\" fill=\"#E59A45\"/>\n      <circle cx=\"43\" cy=\"41\" r=\"3\" fill=\"#2E9B5A\"/>\n      <circle cx=\"49\" cy=\"41\" r=\"3\" fill=\"#2E9B5A\"/>\n    </symbol>\n\n    <symbol id=\"icon-lunchbox\" viewBox=\"0 0 64 64\">\n      <path d=\"M22 18 V12 a4 4 0 0 1 4 -4 h12 a4 4 0 0 1 4 4 V18\" fill=\"none\" stroke=\"#2B1B3D\" stroke-width=\"3.5\" stroke-linecap=\"round\"/>\n      <rect x=\"5\" y=\"17\" width=\"54\" height=\"38\" rx=\"8\" fill=\"#E23E7B\" stroke=\"#2B1B3D\" stroke-width=\"2.5\"/>\n      <rect x=\"5\" y=\"29\" width=\"54\" height=\"5\" fill=\"#B0245A\"/>\n      <path d=\"M5 29 H59\" stroke=\"#2B1B3D\" stroke-width=\"2\"/>\n      <rect x=\"26\" y=\"25\" width=\"12\" height=\"12\" rx=\"3\" fill=\"#FFC21A\" stroke=\"#2B1B3D\" stroke-width=\"2\"/>\n      <circle cx=\"16\" cy=\"45\" r=\"3\" fill=\"#FFB3CF\"/>\n      <circle cx=\"26\" cy=\"47\" r=\"2\" fill=\"#FFB3CF\"/>\n      <circle cx=\"48\" cy=\"44\" r=\"2.5\" fill=\"#FFB3CF\"/>\n      <path d=\"M11 21 h10\" stroke=\"#FF8FB6\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n    </symbol>\n\n    <symbol id=\"icon-leaf\" viewBox=\"0 0 64 64\">\n      <path d=\"M12 52 C10 26 26 10 54 9 C55 37 40 54 12 52 Z\" fill=\"#3DBE5E\" stroke=\"#2B1B3D\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n      <path d=\"M14 50 C24 38 34 28 46 18\" fill=\"none\" stroke=\"#1E6B30\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n      <path d=\"M26 38 L24 28 M33 31 L33 22 M30 41 L40 40 M37 34 L46 32\" stroke=\"#1E6B30\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n      <path d=\"M20 22 Q26 15 34 13\" fill=\"none\" stroke=\"#B9F0C5\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n    </symbol>\n\n    <symbol id=\"icon-drumstick\" viewBox=\"0 0 64 64\">\n      <path d=\"M20 44 C10 34 16 12 34 9 C52 6 60 22 52 34 C46 43 30 50 20 44 Z\" fill=\"#D9792F\" stroke=\"#2B1B3D\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n      <path d=\"M26 18 Q34 13 42 15\" fill=\"none\" stroke=\"#F5B26B\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n      <path d=\"M22 42 L12 52\" stroke=\"#2B1B3D\" stroke-width=\"9\" stroke-linecap=\"round\"/>\n      <path d=\"M22 42 L12 52\" stroke=\"#FFF6E8\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n      <circle cx=\"9\" cy=\"51\" r=\"4.5\" fill=\"#FFF6E8\" stroke=\"#2B1B3D\" stroke-width=\"2\"/>\n      <circle cx=\"13\" cy=\"56\" r=\"4.5\" fill=\"#FFF6E8\" stroke=\"#2B1B3D\" stroke-width=\"2\"/>\n    </symbol>\n\n    <symbol id=\"icon-star\" viewBox=\"0 0 64 64\">\n      <path d=\"M32 4 L40 22 L59 24 L45 37 L49 57 L32 47 L15 57 L19 37 L5 24 L24 22 Z\" fill=\"#FFC21A\" stroke=\"#2B1B3D\" stroke-width=\"3\" stroke-linejoin=\"round\"/>\n      <path d=\"M32 14 L36 24\" stroke=\"#FFF1B0\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n      <circle cx=\"26\" cy=\"33\" r=\"2.2\" fill=\"#2B1B3D\"/>\n      <circle cx=\"38\" cy=\"33\" r=\"2.2\" fill=\"#2B1B3D\"/>\n      <path d=\"M27 39 Q32 43 37 39\" fill=\"none\" stroke=\"#2B1B3D\" stroke-width=\"2.2\" stroke-linecap=\"round\"/>\n    </symbol>\n\n    <symbol id=\"icon-check\" viewBox=\"0 0 32 32\">\n      <circle cx=\"16\" cy=\"16\" r=\"14\" fill=\"#2E9B5A\" stroke=\"#2B1B3D\" stroke-width=\"2.5\"/>\n      <path d=\"M9 16.5 L14 21 L23 11\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"3.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n    </symbol>\n\n    <symbol id=\"icon-megaphone\" viewBox=\"0 0 64 64\">\n      <path d=\"M8 26 H18 L44 12 V52 L18 38 H8 Z\" fill=\"#FFC21A\" stroke=\"#2B1B3D\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n      <rect x=\"44\" y=\"10\" width=\"6\" height=\"44\" rx=\"3\" fill=\"#FF8A3D\" stroke=\"#2B1B3D\" stroke-width=\"2.5\"/>\n      <path d=\"M16 38 L20 52 H28 L25 40\" fill=\"#FFC21A\" stroke=\"#2B1B3D\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n      <path d=\"M55 22 L61 18 M56 32 H63 M55 42 L61 46\" stroke=\"#FFFFFF\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n    </symbol>\n\n    <symbol id=\"icon-folder\" viewBox=\"0 0 64 64\">\n      <path d=\"M5 16 a4 4 0 0 1 4 -4 h16 l6 6 h24 a4 4 0 0 1 4 4 v30 a4 4 0 0 1 -4 4 H9 a4 4 0 0 1 -4 -4 Z\" fill=\"#E8B964\" stroke=\"#2B1B3D\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n      <rect x=\"12\" y=\"14\" width=\"40\" height=\"22\" rx=\"2\" fill=\"#FFFFFF\" stroke=\"#2B1B3D\" stroke-width=\"2\" transform=\"rotate(-4 32 25)\"/>\n      <path d=\"M17 21 H40 M17 26 H46\" stroke=\"#7F6BB3\" stroke-width=\"2\" stroke-linecap=\"round\" transform=\"rotate(-4 32 25)\"/>\n      <path d=\"M5 26 H59 V52 a4 4 0 0 1 -4 4 H9 a4 4 0 0 1 -4 -4 Z\" fill=\"#F5CE7E\" stroke=\"#2B1B3D\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n      <circle cx=\"49\" cy=\"44\" r=\"7\" fill=\"none\" stroke=\"#2B1B3D\" stroke-width=\"3\"/>\n      <path d=\"M54 49 L59 54\" stroke=\"#2B1B3D\" stroke-width=\"3.5\" stroke-linecap=\"round\"/>\n    </symbol>\n\n    <symbol id=\"icon-pepperoni-pizza\" viewBox=\"0 0 64 64\">\n      <use href=\"#pizza-base\"/>\n      <circle cx=\"24\" cy=\"25\" r=\"5\" fill=\"#E0473C\" stroke=\"#2B1B3D\" stroke-width=\"2\"/>\n      <circle cx=\"39\" cy=\"27\" r=\"5\" fill=\"#E0473C\" stroke=\"#2B1B3D\" stroke-width=\"2\"/>\n      <circle cx=\"32\" cy=\"40\" r=\"4.5\" fill=\"#E0473C\" stroke=\"#2B1B3D\" stroke-width=\"2\"/>\n      <circle cx=\"22.5\" cy=\"23.5\" r=\"1.4\" fill=\"#FF9D8F\"/>\n      <circle cx=\"37.5\" cy=\"25.5\" r=\"1.4\" fill=\"#FF9D8F\"/>\n    </symbol>\n\n    <symbol id=\"icon-cheese-pizza\" viewBox=\"0 0 64 64\">\n      <use href=\"#pizza-base\"/>\n      <ellipse cx=\"25\" cy=\"26\" rx=\"4\" ry=\"2.5\" fill=\"#FFF0B0\"/>\n      <ellipse cx=\"38\" cy=\"29\" rx=\"4\" ry=\"2.5\" fill=\"#FFF0B0\"/>\n      <ellipse cx=\"32\" cy=\"38\" rx=\"3\" ry=\"2\" fill=\"#FFF0B0\"/>\n      <circle cx=\"30\" cy=\"24\" r=\"1.5\" fill=\"#E8A928\"/>\n      <circle cx=\"35\" cy=\"45\" r=\"1.5\" fill=\"#E8A928\"/>\n    </symbol>\n\n    <symbol id=\"icon-nuggets\" viewBox=\"0 0 64 64\">\n      <path d=\"M40 40 H58 L55 56 H43 Z\" fill=\"#E0473C\" stroke=\"#2B1B3D\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n      <ellipse cx=\"49\" cy=\"40\" rx=\"9\" ry=\"3\" fill=\"#B52A22\" stroke=\"#2B1B3D\" stroke-width=\"2\"/>\n      <path d=\"M5 33 C4 24 12 19 19 22 C27 25 27 35 21 39 C14 43 6 41 5 33 Z\" fill=\"#E8A04A\" stroke=\"#2B1B3D\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n      <path d=\"M22 18 C24 9 35 7 40 13 C45 19 41 28 33 28 C25 29 20 25 22 18 Z\" fill=\"#F0B35E\" stroke=\"#2B1B3D\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n      <path d=\"M14 47 C15 39 26 36 32 41 C37 46 34 55 26 56 C18 57 13 53 14 47 Z\" fill=\"#E8A04A\" stroke=\"#2B1B3D\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n      <circle cx=\"12\" cy=\"29\" r=\"1.3\" fill=\"#B86E22\"/>\n      <circle cx=\"17\" cy=\"34\" r=\"1.3\" fill=\"#B86E22\"/>\n      <circle cx=\"30\" cy=\"16\" r=\"1.3\" fill=\"#B86E22\"/>\n      <circle cx=\"35\" cy=\"21\" r=\"1.3\" fill=\"#B86E22\"/>\n      <circle cx=\"22\" cy=\"47\" r=\"1.3\" fill=\"#B86E22\"/>\n      <circle cx=\"27\" cy=\"51\" r=\"1.3\" fill=\"#B86E22\"/>\n    </symbol>\n\n    <symbol id=\"icon-taco\" viewBox=\"0 0 64 64\">\n      <path d=\"M8 34 Q12 26 18 31 Q22 23 28 29 Q32 22 37 29 Q42 23 46 31 Q52 26 56 34 Z\" fill=\"#3DBE5E\" stroke=\"#2B1B3D\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n      <circle cx=\"22\" cy=\"31\" r=\"3.5\" fill=\"#E0473C\" stroke=\"#2B1B3D\" stroke-width=\"1.5\"/>\n      <circle cx=\"40\" cy=\"30\" r=\"3.5\" fill=\"#E0473C\" stroke=\"#2B1B3D\" stroke-width=\"1.5\"/>\n      <path d=\"M10 35 Q32 27 54 35 L54 38 L10 38 Z\" fill=\"#8A4B2A\" stroke=\"#2B1B3D\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n      <path d=\"M4 52 C4 38 16 30 32 30 C48 30 60 38 60 52 Z\" fill=\"#FFC14D\" stroke=\"#2B1B3D\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n      <path d=\"M10 47 C12 40 20 35 30 34\" fill=\"none\" stroke=\"#FFE3A3\" stroke-width=\"3\" stroke-linecap=\"round\"/>\n      <circle cx=\"40\" cy=\"45\" r=\"1.5\" fill=\"#D9932A\"/>\n      <circle cx=\"48\" cy=\"47\" r=\"1.5\" fill=\"#D9932A\"/>\n      <circle cx=\"30\" cy=\"47\" r=\"1.5\" fill=\"#D9932A\"/>\n    </symbol>\n\n    <symbol id=\"icon-burger\" viewBox=\"0 0 64 64\">\n      <path d=\"M8 28 C8 10 56 10 56 28 Z\" fill=\"#F0A245\" stroke=\"#2B1B3D\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n      <path d=\"M17 19 Q22 14 30 13\" fill=\"none\" stroke=\"#FFCF85\" stroke-width=\"2.5\" stroke-linecap=\"round\"/>\n      <ellipse cx=\"24\" cy=\"21\" rx=\"1.6\" ry=\"1\" fill=\"#FFF6E8\"/>\n      <ellipse cx=\"34\" cy=\"18\" rx=\"1.6\" ry=\"1\" fill=\"#FFF6E8\"/>\n      <ellipse cx=\"42\" cy=\"22\" rx=\"1.6\" ry=\"1\" fill=\"#FFF6E8\"/>\n      <path d=\"M6 30 Q11 26 16 30 Q21 26 26 30 Q31 26 36 30 Q41 26 46 30 Q51 26 58 30 L58 33 L6 33 Z\" fill=\"#3DBE5E\" stroke=\"#2B1B3D\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n      <path d=\"M8 33 H56 L50 38 L44 42 L40 38 H8 Z\" fill=\"#FFC21A\" stroke=\"#2B1B3D\" stroke-width=\"2\" stroke-linejoin=\"round\"/>\n      <rect x=\"7\" y=\"37\" width=\"50\" height=\"8\" rx=\"4\" fill=\"#7A3E1E\" stroke=\"#2B1B3D\" stroke-width=\"2.5\"/>\n      <path d=\"M8 47 H56 C56 54 52 56 48 56 H16 C12 56 8 54 8 47 Z\" fill=\"#F0A245\" stroke=\"#2B1B3D\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n    </symbol>\n\n    <symbol id=\"icon-veggie-wrap\" viewBox=\"0 0 64 64\">\n      <path d=\"M12 52 L26 8 L54 18 L38 58 Z\" fill=\"#F3E0B5\" stroke=\"#2B1B3D\" stroke-width=\"2.5\" stroke-linejoin=\"round\"/>\n      <ellipse cx=\"40\" cy=\"13\" rx=\"14\" ry=\"6\" transform=\"rotate(20 40 13)\" fill=\"#3DBE5E\" stroke=\"#2B1B3D\" stroke-width=\"2\"/>\n      <circle cx=\"36\" cy=\"12\" r=\"3\" fill=\"#E0473C\"/>\n      <circle cx=\"45\" cy=\"15\" r=\"2.5\" fill=\"#FFC21A\"/>\n    </symbol>\n\n    <symbol id=\"icon-burrito\" viewBox=\"0 0 64 64\">\n      <rect x=\"6\" y=\"20\" width=\"52\" height=\"26\" rx=\"13\" fill=\"#F3E0B5\" stroke=\"#2B1B3D\" stroke-width=\"2.5\"/>\n      <path d=\"M20 22 L24 44 M32 21 L35 45 M44 22 L46 44\" stroke=\"#D9BE86\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n    </symbol>\n\n    <symbol id=\"icon-salad\" viewBox=\"0 0 64 64\">\n      <path d=\"M14 30 Q18 16 26 24 Q30 12 38 22 Q46 16 50 30 Z\" fill=\"#3DBE5E\" stroke=\"#2B1B3D\" stroke-width=\"2\"/>\n      <circle cx=\"26\" cy=\"27\" r=\"3.5\" fill=\"#E0473C\"/>\n      <path d=\"M6 30 H58 C58 45 46 54 32 54 C18 54 6 45 6 30 Z\" fill=\"#4C8DF0\" stroke=\"#2B1B3D\" stroke-width=\"2.5\"/>\n    </symbol>\n  </svg>\n\n  <div class=\"app\">\n    <header class=\"app-header\">\n      <svg class=\"app-logo\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#icon-logo\"></use></svg>\n      <h1 class=\"app-title\" data-string=\"appName\"></h1>\n      <button type=\"button\" id=\"switch-button\" class=\"button button-small header-button\" data-string=\"switchButton\" hidden></button>\n    </header>\n    <svg class=\"header-wave\" viewBox=\"0 0 480 18\" preserveAspectRatio=\"none\" aria-hidden=\"true\" focusable=\"false\">\n      <path d=\"M0 0 H480 V6 Q460 18 440 6 Q420 -6 400 6 Q380 18 360 6 Q340 -6 320 6 Q300 18 280 6 Q260 -6 240 6 Q220 18 200 6 Q180 -6 160 6 Q140 18 120 6 Q100 -6 80 6 Q60 18 40 6 Q20 -6 0 6 Z\"/>\n    </svg>\n\n    <main class=\"app-main\">\n      <section id=\"ending-panel\" class=\"ending-panel\" aria-labelledby=\"ending-heading\" hidden>\n        <svg class=\"ending-icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#icon-folder\"></use></svg>\n        <div>\n          <h2 id=\"ending-heading\" class=\"ending-heading\" data-string=\"endingHeading\"></h2>\n          <p data-string=\"endingText\"></p>\n        </div>\n      </section>\n      <p id=\"load-message\" class=\"load-message\">Loading...</p>\n\n      <section id=\"setup-screen\" class=\"screen\" aria-labelledby=\"setup-heading\" hidden>\n        <div class=\"setup-intro\">\n          <span id=\"setup-avatar\" class=\"avatar\" aria-hidden=\"true\"></span>\n          <div>\n            <h2 id=\"setup-heading\" class=\"screen-heading\" tabindex=\"-1\" data-string=\"setupHeading\"></h2>\n            <p id=\"profile-name\" class=\"profile-name\"></p>\n          </div>\n        </div>\n\n        <div id=\"profile-form\" class=\"profile-form\">\n          <fieldset class=\"choice-group choice-group-lunch\">\n            <legend data-string=\"lunchLegend\"></legend>\n            <label class=\"choice\">\n              <input type=\"radio\" name=\"lunch\" value=\"buys\">\n              <span class=\"choice-bubble\"><svg class=\"choice-icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#icon-tray\"></use></svg></span>\n              <span class=\"choice-text\" data-string=\"lunchBuys\"></span>\n              <svg class=\"choice-check\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#icon-check\"></use></svg>\n            </label>\n            <label class=\"choice\">\n              <input type=\"radio\" name=\"lunch\" value=\"home\">\n              <span class=\"choice-bubble\"><svg class=\"choice-icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#icon-lunchbox\"></use></svg></span>\n              <span class=\"choice-text\" data-string=\"lunchHome\"></span>\n              <svg class=\"choice-check\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#icon-check\"></use></svg>\n            </label>\n          </fieldset>\n\n          <fieldset class=\"choice-group choice-group-diet\">\n            <legend data-string=\"dietLegend\"></legend>\n            <label class=\"choice\">\n              <input type=\"radio\" name=\"diet\" value=\"meat\">\n              <span class=\"choice-bubble\"><svg class=\"choice-icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#icon-drumstick\"></use></svg></span>\n              <span class=\"choice-text\" data-string=\"dietMeat\"></span>\n              <svg class=\"choice-check\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#icon-check\"></use></svg>\n            </label>\n            <label class=\"choice\">\n              <input type=\"radio\" name=\"diet\" value=\"vegetarian\">\n              <span class=\"choice-bubble\"><svg class=\"choice-icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#icon-leaf\"></use></svg></span>\n              <span class=\"choice-text\" data-string=\"dietVegetarian\"></span>\n              <svg class=\"choice-check\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#icon-check\"></use></svg>\n            </label>\n          </fieldset>\n\n          <button type=\"button\" id=\"save-button\" class=\"button button-primary\" data-string=\"saveButton\"></button>\n        </div>\n      </section>\n\n      <section id=\"home-screen\" class=\"screen home-screen\" aria-labelledby=\"home-heading\" hidden>\n        <div class=\"profile-card\">\n          <span id=\"home-avatar\" class=\"avatar\" aria-hidden=\"true\"></span>\n          <div class=\"profile-card-body\">\n            <h2 id=\"home-heading\" class=\"screen-heading\" tabindex=\"-1\"></h2>\n            <ul class=\"profile-chips\">\n              <li class=\"chip\">\n                <svg id=\"lunch-chip-icon\" class=\"chip-icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#icon-tray\"></use></svg>\n                <span id=\"lunch-chip-text\"></span>\n              </li>\n              <li class=\"chip\">\n                <svg id=\"diet-chip-icon\" class=\"chip-icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#icon-leaf\"></use></svg>\n                <span id=\"diet-chip-text\"></span>\n              </li>\n            </ul>\n          </div>\n        </div>\n\n        <div class=\"home-columns\">\n          <section class=\"menu-section picks-section\" aria-labelledby=\"picks-heading\">\n            <h3 id=\"picks-heading\" class=\"section-heading picks-heading\">\n              <svg class=\"heading-star\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#icon-star\"></use></svg>\n              <span data-string=\"picksHeading\"></span>\n            </h3>\n            <ul id=\"picks-list\" class=\"picks-list\"></ul>\n          </section>\n          <div class=\"menu-column\">\n            <div class=\"banner\">\n              <svg class=\"banner-icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#icon-megaphone\"></use></svg>\n              <p class=\"banner-text\"><strong class=\"banner-title\" data-string=\"bannerTitle\"></strong> <span data-string=\"bannerText\"></span></p>\n            </div>\n\n            <section class=\"menu-section\" aria-labelledby=\"menu-heading\">\n              <h3 id=\"menu-heading\" class=\"section-heading\" data-string=\"menuHeading\"></h3>\n              <ul id=\"menu-tray\" class=\"menu-tray\"></ul>\n              <p id=\"removed-line\" class=\"removed-line\"></p>\n            </section>\n          </div>\n        </div>\n      </section>\n\n      <p id=\"status\" class=\"visually-hidden\" aria-live=\"polite\"></p>\n    </main>\n  </div>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "'use strict';\n\n/* ---------- Text (translate here) ---------- */\n\nconst STRINGS = {\n  appName: 'LunchLine',\n  setupHeading: 'Set up your LunchLine profile',\n  profileNameLine: 'Profile name: {name}',\n  lunchLegend: 'Lunch',\n  lunchBuys: 'Buys school lunch',\n  lunchHome: 'Brings lunch from home',\n  dietLegend: 'Diet',\n  dietMeat: 'Eats meat',\n  dietVegetarian: 'Vegetarian',\n  saveButton: 'Save and see menu',\n  greeting: 'Hi, {name}!',\n  bannerTitle: 'Menu update!',\n  bannerText: 'We kept the lunches students said they\\u2019d buy.',\n  menuHeading: 'This week\\u2019s menu',\n  removedLine: 'Removed this week: {items}.',\n  picksHeading: 'Picked for you',\n  pickBadge: 'Picked for you',\n  vegetarianTag: 'Vegetarian',\n  switchButton: 'Switch profile',\n  menuLoaded: 'Menu loaded for {name}.',\n  endingHeading: 'Next step',\n  endingText: 'Write down what happened in your case file. Then go to the next level to look at the data behind this app.',\n  loadError: 'LunchLine didn\\u2019t load. Try reloading the page.',\n  // The first name is always Jonah. Later profiles use the rest in order.\n  profileNames: ['Jonah', 'Ava', 'Marcus', 'Sofia', 'Dev', 'Lena'],\n  items: {\n    pepperoniPizza: 'Pepperoni pizza',\n    chickenNuggets: 'Chicken nuggets',\n    beefTacos: 'Beef tacos',\n    cheesePizza: 'Cheese pizza',\n    cheeseburger: 'Cheeseburger',\n    veggieWrap: 'Veggie wrap',\n    beanCheeseBurrito: 'Bean and cheese burrito',\n    gardenSalad: 'Garden salad'\n  }\n};\n\n/* ---------- Menu data ---------- */\n\nconst MENU = [\n  { id: 'pepperoniPizza', icon: 'icon-pepperoni-pizza', vegetarian: false, wouldBuyRate: 1.0 },\n  { id: 'chickenNuggets', icon: 'icon-nuggets', vegetarian: false, wouldBuyRate: 0.9 },\n  { id: 'beefTacos', icon: 'icon-taco', vegetarian: false, wouldBuyRate: 0.9 },\n  { id: 'cheesePizza', icon: 'icon-cheese-pizza', vegetarian: true, wouldBuyRate: 0.82 },\n  { id: 'cheeseburger', icon: 'icon-burger', vegetarian: false, wouldBuyRate: 0.8 },\n  { id: 'veggieWrap', icon: 'icon-veggie-wrap', vegetarian: true, wouldBuyRate: 0.36 },\n  { id: 'beanCheeseBurrito', icon: 'icon-burrito', vegetarian: true, wouldBuyRate: 0.36 },\n  { id: 'gardenSalad', icon: 'icon-salad', vegetarian: true, wouldBuyRate: 0.1 }\n];\n\n/* ---------- App decision rule ----------\n   Edit these two functions if the AI Studio tree changes.\n   The profile is intentionally not used: every student gets the same menu and picks. */\n\nfunction keepItem(wouldBuyRate) {\n  // An item stays on the menu if at least half of students would buy it.\n  return wouldBuyRate >= 0.5;\n}\n\nfunction recommendations(keptItems) {\n  // The three highest-rated kept items, for everyone.\n  return [...keptItems]\n    .sort((a, b) => b.wouldBuyRate - a.wouldBuyRate)\n    .slice(0, 3);\n}\n\n/* ---------- Settings ---------- */\n\n// Different profile combinations the student must try before the ending prompt appears.\nconst PROFILES_BEFORE_ENDING = 2;\n\n// Avatar color themes, one per profile in order (see .avatar-* classes in style.css).\nconst AVATAR_THEMES = ['grape', 'pink', 'teal', 'orange', 'blue', 'green'];\n\n// Starting choices for each new profile: the first one is Jonah's, then untried combinations.\nconst PROFILE_SUGGESTIONS = [\n  { lunch: 'home', diet: 'vegetarian' },\n  { lunch: 'buys', diet: 'meat' },\n  { lunch: 'buys', diet: 'vegetarian' },\n  { lunch: 'home', diet: 'meat' }\n];\n\n/* ---------- State ---------- */\n\nconst state = {\n  profileCount: 0,\n  name: '',\n  avatarTheme: AVATAR_THEMES[0],\n  triedCombos: new Set(),\n  endingShown: false\n};\n\nconst els = {};\n\n/* ---------- Helpers ---------- */\n\nfunction format(template, values) {\n  return template.replace(/\\{(\\w+)\\}/g, (match, key) => (key in values ? values[key] : match));\n}\n\nfunction setIcon(svgElement, iconId) {\n  svgElement.querySelector('use').setAttribute('href', `#${iconId}`);\n}\n\nfunction createIcon(iconId, className) {\n  const svgNs = 'http://www.w3.org/2000/svg';\n  const svg = document.createElementNS(svgNs, 'svg');\n  svg.setAttribute('class', className);\n  svg.setAttribute('aria-hidden', 'true');\n  svg.setAttribute('focusable', 'false');\n  const use = document.createElementNS(svgNs, 'use');\n  use.setAttribute('href', `#${iconId}`);\n  svg.appendChild(use);\n  return svg;\n}\n\nfunction renderAvatar(element, name, theme) {\n  element.textContent = name.charAt(0);\n  element.className = `avatar avatar-${theme}`;\n}\n\nfunction comboKey(profile) {\n  return `${profile.lunch}-${profile.diet}`;\n}\n\nfunction announce(message) {\n  els.status.textContent = '';\n  // Clearing first makes screen readers repeat the same message if it comes again.\n  window.setTimeout(() => {\n    els.status.textContent = message;\n  }, 50);\n}\n\nfunction formatList(names) {\n  if (typeof Intl !== 'undefined' && Intl.ListFormat) {\n    return new Intl.ListFormat(document.documentElement.lang || 'en', { style: 'short', type: 'unit' }).format(names);\n  }\n  return names.join(', ');\n}\n\n/* ---------- Profile setup ---------- */\n\nfunction nextProfileName() {\n  const names = STRINGS.profileNames;\n  return names[state.profileCount % names.length];\n}\n\nfunction suggestedProfile() {\n  const untried = PROFILE_SUGGESTIONS.find((profile) => !state.triedCombos.has(comboKey(profile)));\n  return untried || PROFILE_SUGGESTIONS[state.profileCount % PROFILE_SUGGESTIONS.length];\n}\n\nfunction setChoice(groupName, value) {\n  const inputs = els.form.querySelectorAll(`input[name=\"${groupName}\"]`);\n  inputs.forEach((input) => {\n    input.checked = input.value === value;\n  });\n  updateSelectedStyles();\n}\n\nfunction updateSelectedStyles() {\n  els.form.querySelectorAll('.choice').forEach((label) => {\n    const input = label.querySelector('input');\n    label.classList.toggle('is-selected', input.checked);\n  });\n}\n\nfunction showSetup(moveFocus = true) {\n  state.name = nextProfileName();\n  state.avatarTheme = AVATAR_THEMES[state.profileCount % AVATAR_THEMES.length];\n  renderAvatar(els.setupAvatar, state.name, state.avatarTheme);\n  els.profileName.textContent = format(STRINGS.profileNameLine, { name: state.name });\n\n  const suggestion = suggestedProfile();\n  setChoice('lunch', suggestion.lunch);\n  setChoice('diet', suggestion.diet);\n\n  showScreen(els.setupScreen, els.setupHeading, moveFocus);\n}\n\nfunction readProfile() {\n  const lunch = els.form.querySelector('input[name=\"lunch\"]:checked');\n  const diet = els.form.querySelector('input[name=\"diet\"]:checked');\n  return {\n    name: state.name,\n    lunch: lunch ? lunch.value : 'buys',\n    diet: diet ? diet.value : 'meat'\n  };\n}\n\n/* ---------- Menu screen ---------- */\n\nfunction renderProfileCard(profile) {\n  els.homeHeading.textContent = format(STRINGS.greeting, { name: profile.name });\n  renderAvatar(els.homeAvatar, profile.name, state.avatarTheme);\n\n  const buysLunch = profile.lunch === 'buys';\n  setIcon(els.lunchChipIcon, buysLunch ? 'icon-tray' : 'icon-lunchbox');\n  els.lunchChipText.textContent = buysLunch ? STRINGS.lunchBuys : STRINGS.lunchHome;\n\n  const vegetarian = profile.diet === 'vegetarian';\n  setIcon(els.dietChipIcon, vegetarian ? 'icon-leaf' : 'icon-drumstick');\n  els.dietChipText.textContent = vegetarian ? STRINGS.dietVegetarian : STRINGS.dietMeat;\n}\n\nfunction createVegetarianTag() {\n  const tag = document.createElement('span');\n  tag.className = 'veg-tag';\n  tag.appendChild(createIcon('icon-leaf', 'veg-tag-icon'));\n  const text = document.createElement('span');\n  text.textContent = STRINGS.vegetarianTag;\n  tag.appendChild(text);\n  return tag;\n}\n\nfunction createMenuItem(item, className) {\n  const li = document.createElement('li');\n  li.className = className;\n  li.appendChild(createIcon(item.icon, 'food-icon'));\n\n  const text = document.createElement('span');\n  text.className = 'food-text';\n  li.appendChild(text);\n\n  const name = document.createElement('span');\n  name.className = 'food-name';\n  name.textContent = STRINGS.items[item.id];\n  text.appendChild(name);\n\n  if (item.vegetarian) {\n    text.appendChild(createVegetarianTag());\n  }\n  return li;\n}\n\nfunction renderMenu(keptItems, removedItems) {\n  els.menuTray.textContent = '';\n  keptItems.forEach((item) => {\n    els.menuTray.appendChild(createMenuItem(item, 'tray-well'));\n  });\n\n  const removedNames = [...removedItems]\n    .sort((a, b) => a.wouldBuyRate - b.wouldBuyRate)\n    .map((item) => STRINGS.items[item.id]);\n  els.removedLine.hidden = removedNames.length === 0;\n  els.removedLine.textContent = format(STRINGS.removedLine, { items: formatList(removedNames) });\n}\n\nfunction renderPicks(picks) {\n  els.picksList.textContent = '';\n  picks.forEach((item) => {\n    const li = createMenuItem(item, 'pick-card');\n    const badge = createIcon('icon-star', 'pick-star');\n    li.insertBefore(badge, li.firstChild);\n\n    const label = document.createElement('span');\n    label.className = 'visually-hidden';\n    label.textContent = STRINGS.pickBadge;\n    li.appendChild(label);\n\n    els.picksList.appendChild(li);\n  });\n}\n\nfunction showHome(profile) {\n  const keptItems = MENU.filter((item) => keepItem(item.wouldBuyRate));\n  const removedItems = MENU.filter((item) => !keepItem(item.wouldBuyRate));\n\n  renderProfileCard(profile);\n  renderMenu(keptItems, removedItems);\n  renderPicks(recommendations(keptItems));\n  showScreen(els.homeScreen, els.homeHeading);\n\n  state.triedCombos.add(comboKey(profile));\n  state.profileCount += 1;\n\n  const messages = [format(STRINGS.menuLoaded, { name: profile.name })];\n  if (!state.endingShown && state.triedCombos.size >= PROFILES_BEFORE_ENDING) {\n    state.endingShown = true;\n    els.endingPanel.hidden = false;\n    messages.push(STRINGS.endingText);\n  }\n  announce(messages.join(' '));\n}\n\n/* ---------- Screens ---------- */\n\nfunction showScreen(screen, heading, moveFocus = true) {\n  [els.setupScreen, els.homeScreen].forEach((section) => {\n    section.hidden = section !== screen;\n  });\n  els.switchButton.hidden = screen !== els.homeScreen;\n  window.scrollTo(0, 0);\n  if (moveFocus) {\n    heading.focus();\n  }\n}\n\nfunction fillStaticStrings() {\n  document.querySelectorAll('[data-string]').forEach((element) => {\n    const text = STRINGS[element.dataset.string];\n    if (typeof text === 'string') {\n      element.textContent = text;\n    }\n  });\n  document.title = STRINGS.appName;\n}\n\n/* ---------- Start ---------- */\n\nfunction cacheElements() {\n  const byId = (id) => document.getElementById(id);\n  els.loadMessage = byId('load-message');\n  els.setupScreen = byId('setup-screen');\n  els.setupHeading = byId('setup-heading');\n  els.setupAvatar = byId('setup-avatar');\n  els.profileName = byId('profile-name');\n  els.form = byId('profile-form');\n  els.saveButton = byId('save-button');\n  els.homeScreen = byId('home-screen');\n  els.homeHeading = byId('home-heading');\n  els.homeAvatar = byId('home-avatar');\n  els.lunchChipIcon = byId('lunch-chip-icon');\n  els.lunchChipText = byId('lunch-chip-text');\n  els.dietChipIcon = byId('diet-chip-icon');\n  els.dietChipText = byId('diet-chip-text');\n  els.menuTray = byId('menu-tray');\n  els.removedLine = byId('removed-line');\n  els.picksList = byId('picks-list');\n  els.switchButton = byId('switch-button');\n  els.endingPanel = byId('ending-panel');\n  els.status = byId('status');\n}\n\nfunction init() {\n  cacheElements();\n  fillStaticStrings();\n\n  els.form.addEventListener('change', updateSelectedStyles);\n  // A plain button click, not a form submit: sandboxed iframes like Web Lab's can block form submission.\n  els.saveButton.addEventListener('click', () => showHome(readProfile()));\n  els.switchButton.addEventListener('click', () => showSetup());\n\n  els.loadMessage.hidden = true;\n  // Don't move focus on first load; the student hasn't done anything yet.\n  showSetup(false);\n}\n\ndocument.addEventListener('DOMContentLoaded', () => {\n  try {\n    init();\n  } catch (error) {\n    const message = document.getElementById('load-message');\n    if (message) {\n      message.hidden = false;\n      message.textContent = STRINGS.loadError;\n    }\n  }\n});",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": ":root {\n  --ink: #2B1B3D;\n  --ink-soft: #5A4870;\n  --grape: #5B2FB5;\n  --grape-dark: #3D1F80;\n  --lemon: #FFF4CC;\n  --lemon-dot: #FFE38F;\n  --tangerine: #FF8A3D;\n  --pink: #C81E5B;\n  --pink-light: #FFE0EC;\n  --teal: #0F8F82;\n  --teal-dark: #0A6158;\n  --sun-light: #FFF0B8;\n  --mint: #DDF7F2;\n  --veg: #1E6B30;\n  --veg-bg: #DDF5DD;\n  --white: #FFFFFF;\n  --focus: #1A5FB4;\n  --radius-big: 18px;\n  --radius: 12px;\n  --pop-shadow: 0 3px 0 var(--ink);\n  --font: \"Trebuchet MS\", \"Segoe UI\", Roboto, system-ui, sans-serif;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml {\n  -webkit-text-size-adjust: 100%;\n}\n\nbody {\n  margin: 0;\n  background-color: var(--lemon);\n  background-image: radial-gradient(var(--lemon-dot) 3px, transparent 3.5px);\n  background-size: 26px 26px;\n  color: var(--ink);\n  font-family: var(--font);\n  font-size: 1rem;\n  line-height: 1.35;\n}\n\n.icon-sprite {\n  position: absolute;\n  width: 0;\n  height: 0;\n  overflow: hidden;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n[hidden] {\n  display: none !important;\n}\n\n.app {\n  max-width: 960px;\n  margin: 0 auto;\n}\n\n/* Header */\n\n.app-header {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  min-height: 52px;\n  padding: 6px 12px 2px;\n  background: var(--grape);\n  color: var(--white);\n}\n\n.app-logo {\n  width: 36px;\n  height: 36px;\n  flex-shrink: 0;\n  transform: rotate(-6deg);\n}\n\n.app-title {\n  margin: 0;\n  font-size: 1.4rem;\n  font-weight: 800;\n  line-height: 1.2;\n  text-shadow: 2px 2px 0 var(--grape-dark);\n}\n\n.header-button {\n  margin-inline-start: auto;\n  white-space: nowrap;\n  background: var(--white);\n  color: var(--grape-dark);\n  box-shadow: 0 3px 0 var(--grape-dark);\n}\n\n.header-button:hover {\n  background: var(--sun-light);\n}\n\n.header-button:focus-visible {\n  outline-color: var(--sun-light);\n}\n\n.header-wave {\n  display: block;\n  width: 100%;\n  height: 10px;\n  fill: var(--grape);\n}\n\n.app-main {\n  padding: 6px 12px 12px;\n}\n\n.load-message {\n  margin: 0;\n  padding: 12px;\n  background: var(--white);\n  border: 3px solid var(--ink);\n  border-radius: var(--radius);\n}\n\n.screen {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.screen-heading {\n  margin: 0;\n  font-size: 1.2rem;\n  font-weight: 800;\n  line-height: 1.2;\n}\n\n.screen-heading:focus {\n  outline: none;\n}\n\n.screen-heading:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 3px;\n  border-radius: 4px;\n}\n\n/* Avatars */\n\n.avatar {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 42px;\n  height: 42px;\n  flex-shrink: 0;\n  border: 3px solid var(--ink);\n  border-radius: 50%;\n  box-shadow: 0 2px 0 var(--ink);\n  color: var(--white);\n  font-size: 1.25rem;\n  font-weight: 800;\n}\n\n.avatar-grape { background: var(--grape); }\n.avatar-pink { background: var(--pink); }\n.avatar-teal { background: var(--teal-dark); }\n.avatar-orange { background: #B34A00; }\n.avatar-blue { background: #1F5FC4; }\n.avatar-green { background: var(--veg); }\n\n/* Profile setup */\n\n.setup-intro {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.profile-name {\n  margin: 0;\n  color: var(--ink-soft);\n  font-weight: 700;\n  font-size: 0.95rem;\n}\n\n.profile-form {\n  display: grid;\n  gap: 10px;\n}\n\n.choice-group {\n  margin: 0;\n  padding: 8px 10px 10px;\n  border: 3px solid var(--ink);\n  border-radius: var(--radius-big);\n  box-shadow: var(--pop-shadow);\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 8px;\n}\n\n.choice-group-lunch {\n  background: var(--pink-light);\n}\n\n.choice-group-diet {\n  background: var(--mint);\n}\n\n.choice-group legend {\n  /* A floated legend becomes a normal grid item, so it can sit inside the border. */\n  float: left;\n  grid-column: 1 / -1;\n  padding: 0 2px;\n  font-weight: 800;\n  font-size: 1.05rem;\n}\n\n.choice {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n  min-height: 92px;\n  padding: 10px 8px 8px;\n  text-align: center;\n  background: var(--white);\n  border: 2px solid var(--ink);\n  border-radius: var(--radius);\n  cursor: pointer;\n}\n\n.choice-text {\n  font-weight: 700;\n  font-size: 0.95rem;\n}\n\n.choice input {\n  position: absolute;\n  top: 8px;\n  inset-inline-start: 8px;\n  width: 20px;\n  height: 20px;\n  margin: 0;\n  accent-color: var(--grape);\n  cursor: pointer;\n}\n\n.choice input:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 3px;\n}\n\n.choice-bubble {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 42px;\n  height: 42px;\n  border-radius: 50%;\n  background: var(--lemon);\n}\n\n.choice-icon {\n  width: 34px;\n  height: 34px;\n}\n\n.choice-check {\n  position: absolute;\n  top: 6px;\n  inset-inline-end: 6px;\n  width: 24px;\n  height: 24px;\n  visibility: hidden;\n}\n\n.choice.is-selected {\n  background: var(--sun-light);\n  border-width: 3px;\n  box-shadow: 0 3px 0 var(--ink);\n}\n\n.choice.is-selected .choice-bubble {\n  background: var(--white);\n}\n\n.choice.is-selected .choice-check {\n  visibility: visible;\n}\n\n/* Buttons */\n\n.button {\n  min-height: 46px;\n  padding: 8px 20px;\n  border: 3px solid var(--ink);\n  border-radius: 999px;\n  box-shadow: var(--pop-shadow);\n  font: inherit;\n  font-weight: 800;\n  font-size: 1.05rem;\n  cursor: pointer;\n}\n\n.button:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 4px;\n}\n\n.button:active {\n  box-shadow: 0 1px 0 var(--ink);\n  transform: translateY(2px);\n}\n\n.button-primary {\n  background: var(--grape);\n  color: var(--white);\n}\n\n.button-primary:hover {\n  background: var(--grape-dark);\n}\n\n.button-secondary {\n  background: var(--white);\n  color: var(--grape-dark);\n}\n\n.button-secondary:hover {\n  background: var(--pink-light);\n}\n\n.button-small {\n  min-height: 40px;\n  padding: 6px 12px;\n  border-width: 2px;\n  font-size: 0.9rem;\n}\n\n/* Menu screen: profile card */\n\n.profile-card {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 6px 10px;\n  background: var(--white);\n  border: 3px solid var(--ink);\n  border-radius: var(--radius);\n  box-shadow: var(--pop-shadow);\n}\n\n.profile-card-body {\n  flex: 1;\n  min-width: 0;\n}\n\n.profile-card .screen-heading {\n  font-size: 1.05rem;\n}\n\n.profile-card .avatar {\n  width: 38px;\n  height: 38px;\n  font-size: 1.1rem;\n}\n\n.profile-chips {\n  list-style: none;\n  margin: 2px 0 0;\n  padding: 0;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px;\n}\n\n.chip {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  padding: 1px 8px 1px 3px;\n  background: var(--lemon);\n  border: 2px solid var(--ink);\n  border-radius: 999px;\n  font-size: 0.8rem;\n  font-weight: 700;\n}\n\n.chip-icon {\n  width: 20px;\n  height: 20px;\n}\n\n/* Banner */\n\n.banner {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 5px 10px;\n  background: var(--pink);\n  color: var(--white);\n  border: 3px solid var(--ink);\n  border-radius: var(--radius);\n  box-shadow: var(--pop-shadow);\n  transform: rotate(-0.6deg);\n}\n\n.banner-icon {\n  width: 30px;\n  height: 30px;\n  flex-shrink: 0;\n}\n\n.banner-text {\n  margin: 0;\n  font-size: 0.9rem;\n}\n\n.banner-title {\n  font-weight: 800;\n}\n\n/* Menu and picks */\n\n.home-columns {\n  display: grid;\n  gap: 10px;\n}\n\n.menu-column {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.menu-section {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.section-heading {\n  margin: 0;\n  font-size: 1.05rem;\n  font-weight: 800;\n}\n\n.menu-tray {\n  list-style: none;\n  margin: 0;\n  padding: 8px;\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(132px, 1fr));\n  gap: 6px;\n  background: var(--teal);\n  border: 3px solid var(--ink);\n  border-radius: var(--radius-big);\n  box-shadow: var(--pop-shadow);\n}\n\n.tray-well,\n.pick-card {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  align-items: center;\n  column-gap: 6px;\n  row-gap: 3px;\n}\n\n/* The name sits beside the icon; the vegetarian tag gets its own full-width row. */\n.food-text {\n  display: contents;\n}\n\n.veg-tag {\n  grid-column: 1 / -1;\n  justify-self: start;\n}\n\n.tray-well {\n  min-height: 44px;\n  padding: 3px 6px;\n  background: #FFF8E6;\n  border: 2px solid var(--teal-dark);\n  border-radius: var(--radius);\n  box-shadow: inset 0 3px 0 rgba(10, 97, 88, 0.25);\n}\n\n.tray-well:nth-child(5n + 2) { background: #FFE9F1; }\n.tray-well:nth-child(5n + 3) { background: #E6F0FF; }\n.tray-well:nth-child(5n + 4) { background: #E5F8E5; }\n.tray-well:nth-child(5n + 5) { background: #F1E8FF; }\n\n.food-icon {\n  width: 30px;\n  height: 30px;\n  flex-shrink: 0;\n}\n\n.food-name {\n  font-weight: 800;\n  font-size: 0.85rem;\n  line-height: 1.2;\n}\n\n.veg-tag {\n  display: inline-flex;\n  align-items: center;\n  gap: 3px;\n  padding: 0 6px 0 3px;\n  background: var(--veg-bg);\n  color: var(--veg);\n  border: 2px solid var(--veg);\n  border-radius: 999px;\n  font-size: 0.75rem;\n  font-weight: 800;\n}\n\n.veg-tag-icon {\n  width: 14px;\n  height: 14px;\n}\n\n.removed-line {\n  margin: 0;\n  padding: 0 2px;\n  color: var(--ink-soft);\n  font-size: 0.8rem;\n}\n\n.picks-section {\n  padding: 8px 10px 10px;\n  background: var(--grape);\n  border: 3px solid var(--ink);\n  border-radius: var(--radius-big);\n  box-shadow: var(--pop-shadow);\n}\n\n.picks-heading {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  color: var(--white);\n}\n\n.heading-star {\n  width: 26px;\n  height: 26px;\n  transform: rotate(-10deg);\n}\n\n.picks-list {\n  list-style: none;\n  margin: 0;\n  padding: 4px 2px 0;\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 8px;\n}\n\n.pick-card {\n  position: relative;\n  grid-template-columns: minmax(0, 1fr);\n  justify-items: center;\n  padding: 7px 4px 5px;\n  text-align: center;\n  background: var(--white);\n  border: 3px solid var(--ink);\n  border-radius: var(--radius);\n  box-shadow: 0 3px 0 var(--grape-dark);\n}\n\n.pick-star {\n  position: absolute;\n  top: -9px;\n  inset-inline-end: -5px;\n  width: 26px;\n  height: 26px;\n  transform: rotate(12deg);\n}\n\n/* Ending: shown at the top so students see it without scrolling. */\n\n.ending-panel {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  margin-bottom: 10px;\n  padding: 6px 10px;\n  background: var(--white);\n  border: 3px solid var(--ink);\n  border-inline-start: 10px solid var(--tangerine);\n  border-radius: var(--radius);\n  box-shadow: var(--pop-shadow);\n}\n\n.ending-icon {\n  width: 34px;\n  height: 34px;\n  flex-shrink: 0;\n}\n\n.ending-heading {\n  margin: 0;\n  font-size: 1rem;\n  font-weight: 800;\n}\n\n.ending-panel p {\n  margin: 0;\n  font-size: 0.85rem;\n}\n\n/* Wider screens: use the extra width instead of stacking everything. */\n\n@media (min-width: 640px) {\n  .profile-form {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    align-items: start;\n  }\n\n  .profile-form .button {\n    grid-column: 1 / -1;\n    justify-self: center;\n    min-width: 280px;\n  }\n\n  .home-columns {\n    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);\n    align-items: start;\n  }\n\n  .picks-list {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .pick-card {\n    grid-template-columns: auto minmax(0, 1fr);\n    justify-items: start;\n    padding: 6px 10px;\n    text-align: start;\n  }\n\n  .food-icon {\n    width: 40px;\n    height: 40px;\n  }\n\n  .food-name {\n    font-size: 0.95rem;\n  }\n}\n\n/* Very narrow screens */\n\n@media (max-width: 360px) {\n  .picks-list {\n    gap: 6px;\n  }\n\n  .food-icon {\n    width: 30px;\n    height: 30px;\n  }\n}\n\n/* Motion: menu items pop onto the tray each time the menu screen opens. */\n\n@media (prefers-reduced-motion: no-preference) {\n  .tray-well,\n  .pick-card {\n    animation: pop-in 320ms cubic-bezier(0.34, 1.56, 0.64, 1) both;\n  }\n\n  .tray-well:nth-child(2) { animation-delay: 60ms; }\n  .tray-well:nth-child(3) { animation-delay: 120ms; }\n  .tray-well:nth-child(4) { animation-delay: 180ms; }\n  .tray-well:nth-child(5) { animation-delay: 240ms; }\n  .pick-card:nth-child(1) { animation-delay: 320ms; }\n  .pick-card:nth-child(2) { animation-delay: 380ms; }\n  .pick-card:nth-child(3) { animation-delay: 440ms; }\n\n  .choice.is-selected .choice-check {\n    animation: pop-in 220ms cubic-bezier(0.34, 1.56, 0.64, 1);\n  }\n\n  .ending-panel {\n    animation: pop-in 360ms cubic-bezier(0.34, 1.56, 0.64, 1);\n  }\n\n  .button {\n    transition: transform 80ms ease-out, box-shadow 80ms ease-out;\n  }\n\n  @keyframes pop-in {\n    from {\n      opacity: 0;\n      transform: scale(0.7);\n    }\n    to {\n      opacity: 1;\n      transform: scale(1);\n    }\n  }\n}",
          "folderId": "0",
          "active": true
        }
