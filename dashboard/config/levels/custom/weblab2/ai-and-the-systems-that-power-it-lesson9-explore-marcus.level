        "6": {
          "id": "6",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Exploring an AI Model: Marcus Reyes</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body data-scene=\"explore-marcus\">\n  <header class=\"app-bar\">\n    <div class=\"app-bar-inner\">\n      <h1>Exploring an AI Model</h1>\n      <button type=\"button\" class=\"button button--secondary\" id=\"remind-button\" aria-haspopup=\"dialog\">Remind me</button>\n    </div>\n  </header>\n  <main id=\"app\">\n    <p>Loading the activity.</p>\n    <noscript><p class=\"error-message\">This activity needs JavaScript. Ask your teacher for help.</p></noscript>\n  </main>\n  <p id=\"status\" class=\"visually-hidden\" role=\"status\" aria-live=\"polite\"></p>\n  <dialog id=\"remind\" class=\"remind\" aria-labelledby=\"remind-title\">\n    <div class=\"remind-inner\">\n      <div class=\"remind-header\">\n        <h2 id=\"remind-title\">Remind me</h2>\n        <button type=\"button\" class=\"button button--secondary\" id=\"remind-close\">Close</button>\n      </div>\n      <div id=\"remind-body\" class=\"remind-body\"></div>\n    </div>\n  </dialog>\n</body>\n</html>\n",
