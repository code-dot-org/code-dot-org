      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>BOSS FIGHT: Shadow Overlord</title>\n\n  <!-- Press Start 2P — retro pixel-art font used for all game text -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link href=\"https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap\" rel=\"stylesheet\" />\n\n  <!-- All visual styling lives in style.css -->\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n\n  <!-- Outer wrapper: centers the game panel on the dark background -->\n  <div id=\"game-container\">\n\n    <!-- Title bar sits above the canvas -->\n    <div id=\"title-bar\">\n      <span id=\"title-text\">&#9876; BOSS FIGHT: SHADOW OVERLORD &#9876;</span>\n    </div>\n\n    <div id=\"canvas-wrapper\">\n\n      <canvas id=\"game-canvas\" width=\"800\" height=\"400\"></canvas>\n\n      <div id=\"result-overlay\" class=\"hidden\" role=\"dialog\" aria-label=\"Game result\">\n        <!-- Filled dynamically by helpers.js showVictoryOverlay() / showOverflowOverlay() -->\n      </div>\n\n    </div><!-- end #canvas-wrapper -->\n\n  </div><!-- end #game-container -->\n\n\n  <script src=\"helpers.js\"></script>\n\n</body>\n</html>\n",
          "active": false,
          "folderId": "0",
          "type": "support"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "*,\n*::before,\n*::after {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  background-color: #0a0a0f;\n  color: #e0d8ff;\n  font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 16px;\n  background-image: radial-gradient(rgba(102, 0, 204, 0.12) 1px, transparent 1px);\n  background-size: 28px 28px;\n}\n\n#game-container {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  filter: drop-shadow(0 0 40px rgba(102, 0, 204, 0.6));\n  position: relative;\n  width: 100%;\n  max-width: 800px;\n}\n\n#title-bar {\n  width: 100%;\n  background: linear-gradient(90deg, #0d0010, #1a0030, #0d0010);\n  border: 2px solid #6600cc;\n  border-bottom: none;\n  padding: 12px 16px;\n  text-align: center;\n}\n\n#title-text {\n  font-family: 'Press Start 2P', monospace;\n  font-size: clamp(10px, 2.4vw, 14px);\n  color: #cc88ff;\n  letter-spacing: 2px;\n  line-height: 1.6;\n  text-shadow:\n    0 0 8px #9933ff,\n    0 0 20px rgba(153, 51, 255, 0.5);\n}\n\n#game-canvas {\n  display: block;\n  max-width: 100%;\n  height: auto;\n  border: 2px solid #6600cc;\n  box-shadow:\n    0 0 40px rgba(102, 0, 204, 0.7),\n    0 0 80px rgba(102, 0, 204, 0.3),\n    inset 0 0 20px rgba(0, 0, 0, 0.8);\n  background: #080810;\n  image-rendering: pixelated;\n  image-rendering: crisp-edges;\n}\n\n#canvas-wrapper {\n  position: relative;\n  display: block;\n  width: 100%;\n  line-height: 0;\n}\n\n#result-overlay {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n  overflow: hidden;\n}\n\n#result-overlay:not(.hidden) {\n  pointer-events: auto;\n}\n\n#result-overlay.hidden {\n  display: none;\n}\n\n#result-overlay .overlay-inner {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 14px;\n  padding: 24px;\n  text-align: center;\n  animation: overlay-fade-in 0.6s ease forwards;\n}\n\n#result-overlay.victory .overlay-inner {\n  background: rgba(10, 8, 0, 0.88);\n  border: 3px solid #ffcc00;\n  box-shadow:\n    inset 0 0 60px rgba(255, 204, 0, 0.15),\n    0 0 40px rgba(255, 204, 0, 0.4);\n}\n\n#result-overlay.overflow .overlay-inner {\n  background: rgba(12, 0, 0, 0.9);\n  border: 3px solid #cc0000;\n  box-shadow:\n    inset 0 0 60px rgba(200, 0, 0, 0.15),\n    0 0 40px rgba(200, 0, 0, 0.5);\n}\n\n@keyframes overlay-fade-in {\n  from {\n    opacity: 0;\n    transform: scale(0.96);\n  }\n\n  to {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n\n.overlay-icon {\n  font-size: clamp(32px, 7vw, 52px);\n  line-height: 1;\n  margin-bottom: 4px;\n}\n\n.overlay-title {\n  font-family: 'Press Start 2P', monospace;\n  font-size: clamp(12px, 3vw, 22px);\n  letter-spacing: 2px;\n  line-height: 1.6;\n}\n\n#result-overlay.victory .overlay-title {\n  color: #ffcc00;\n  text-shadow:\n    0 0 16px #ffcc00,\n    0 0 40px rgba(255, 204, 0, 0.5);\n}\n\n#result-overlay.overflow .overlay-title {\n  color: #ff3333;\n  text-shadow:\n    0 0 16px #ff3333,\n    0 0 40px rgba(255, 50, 50, 0.5);\n}\n\n.overlay-subtitle {\n  font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  font-size: clamp(14px, 3vw, 18px);\n  line-height: 1.5;\n  letter-spacing: 0;\n  max-width: 32rem;\n}\n\n#result-overlay.victory .overlay-subtitle {\n  color: #ffe680;\n}\n\n#result-overlay.overflow .overlay-subtitle {\n  color: #ff9999;\n}\n\n.overlay-btn {\n  font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  font-size: clamp(14px, 3vw, 17px);\n  font-weight: 700;\n  letter-spacing: 0.5px;\n  padding: 12px 24px;\n  border: none;\n  border-radius: 6px;\n  cursor: pointer;\n  margin-top: 8px;\n  min-height: 44px;\n  transition:\n    transform 0.1s ease,\n    filter 0.2s ease,\n    box-shadow 0.2s ease;\n}\n\n#result-overlay.victory .overlay-btn {\n  background: linear-gradient(135deg, #a07800, #ffcc00);\n  color: #0a0800;\n  box-shadow: 0 0 20px rgba(255, 204, 0, 0.6);\n}\n\n#result-overlay.overflow .overlay-btn {\n  background: linear-gradient(135deg, #660000, #cc2200);\n  color: #ffdddd;\n  box-shadow: 0 0 20px rgba(200, 0, 0, 0.6);\n}\n\n.overlay-btn:hover {\n  filter: brightness(1.2);\n  transform: translateY(-2px);\n}\n\n.overlay-btn:active {\n  transform: translateY(1px);\n  filter: brightness(0.9);\n}\n\n.overlay-btn:focus-visible {\n  outline: 3px solid #ffffff;\n  outline-offset: 4px;\n}\n\n@media (max-width: 500px) {\n  body {\n    padding: 8px;\n    justify-content: flex-start;\n  }\n\n  #title-bar {\n    padding: 10px 8px;\n  }\n\n  #title-text {\n    font-size: 10px;\n    letter-spacing: 1px;\n    line-height: 1.5;\n  }\n\n  #result-overlay .overlay-inner {\n    gap: 10px;\n    padding: 16px;\n  }\n\n  .overlay-title {\n    font-size: 12px;\n    letter-spacing: 1px;\n  }\n\n  .overlay-subtitle {\n    font-size: 14px;\n  }\n\n  .overlay-btn {\n    font-size: 14px;\n    padding: 10px 18px;\n  }\n}",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
        "3": {
          "id": "3",
          "name": "helpers.js",
          "contents": "// ============================================================\n//  helpers.js — BOSS FIGHT: Shadow Overlord — Game Engine\n//  ============================================================\n//  This is the game engine. Students do NOT edit this file.\n//\n//  How the game works:\n//    1. script.js runs immediately on page load.\n//       Its while loop calls spawnEnemy() and attackBoss() each round.\n//       Those functions do NOT draw anything — they push events\n//       into the gameEvents array.\n//    2. After the loop ends, script.js calls showResult().\n//       showResult() starts animateEvents(), which replays the\n//       battle one event at a time using setInterval (~120ms each).\n//    3. The canvas is redrawn every frame via requestAnimationFrame,\n//       which handles the breathing animation, glows, and particles.\n//\n//  Key concepts demonstrated:\n//    - Event queue / animation decoupling\n//    - Pixel art rendering with Canvas 2D\n//    - requestAnimationFrame game loop\n//    - Sprite drawing via 2D color arrays\n// ============================================================\n\n\n// ── Canvas setup ─────────────────────────────────────────────\n\nconst canvas  = document.getElementById('game-canvas');\nconst ctx     = canvas.getContext('2d');\n\n// Width and height of the canvas in CSS pixels\nconst CW = 800;\nconst CH = 400;\n\n// How many screen pixels each sprite \"pixel\" occupies\n// A scale of 3 means each sprite pixel = a 3x3 block on screen\nconst SCALE = 3;\n\n\n// ============================================================\n//  PIXEL ART SPRITES\n//\n//  Each sprite is a 2D array of strings.\n//  Each string is a hex color like '#ff0000'.\n//  null means transparent — nothing is drawn for that cell.\n//  Rows top-to-bottom, columns left-to-right.\n//\n//  Naming convention: SPRITE_<NAME>\n// ============================================================\n\n\n// ── Boss Sprite — Shadow Overlord (~16 wide x 20 tall pixels) ──\n// A large demonic skull face. Dark purple body, bone-white skull,\n// glowing crimson eye sockets, twisted horns.\nconst SPRITE_BOSS = [\n  [null, null, '#1a0033', '#2d0055', null, null, null, null, null, null, null, null, '#2d0055', '#1a0033', null, null],\n  [null, '#1a0033', '#3d0077', '#5500aa', '#2d0055', null, null, null, null, null, null, '#2d0055', '#5500aa', '#3d0077', '#1a0033', null],\n  ['#1a0033', '#3d0077', '#7700cc', '#9900ee', '#7700cc', '#4400aa', '#2d0055', '#2d0055', '#4400aa', '#7700cc', '#9900ee', '#7700cc', '#3d0077', '#1a0033', null, null],\n  ['#2d0055', '#5500aa', '#9900ee', '#aa00ff', '#cc44ff', '#aa00ff', '#9900ee', '#9900ee', '#aa00ff', '#cc44ff', '#aa00ff', '#9900ee', '#5500aa', '#2d0055', null, null],\n  ['#3d0077', '#7700cc', '#c8b8d8', '#ddd0ee', '#eee8ff', '#ddd0ee', '#c8b8d8', '#c8b8d8', '#ddd0ee', '#eee8ff', '#ddd0ee', '#c8b8d8', '#7700cc', '#3d0077', null, null],\n  ['#4400aa', '#9900ee', '#ddd0ee', '#eee8ff', '#ffffff', '#f8f0ff', '#eee8ff', '#eee8ff', '#f8f0ff', '#ffffff', '#eee8ff', '#ddd0ee', '#9900ee', '#4400aa', null, null],\n  ['#2d0055', '#7700cc', '#c8b8d8', '#cc0000', '#ff2200', '#ff5500', '#c8b8d8', '#c8b8d8', '#ff5500', '#ff2200', '#cc0000', '#c8b8d8', '#7700cc', '#2d0055', null, null],\n  ['#2d0055', '#7700cc', '#c8b8d8', '#ff2200', '#ff6600', '#ffaa00', '#c8b8d8', '#c8b8d8', '#ffaa00', '#ff6600', '#ff2200', '#c8b8d8', '#7700cc', '#2d0055', null, null],\n  ['#2d0055', '#5500aa', '#c8b8d8', '#ddd0ee', '#eee8ff', '#ddd0ee', '#4400aa', '#4400aa', '#ddd0ee', '#eee8ff', '#ddd0ee', '#c8b8d8', '#5500aa', '#2d0055', null, null],\n  ['#1a0033', '#3d0077', '#9900ee', '#c8b8d8', '#eee8ff', '#c8b8d8', '#5500aa', '#5500aa', '#c8b8d8', '#eee8ff', '#c8b8d8', '#9900ee', '#3d0077', '#1a0033', null, null],\n  ['#1a0033', '#2d0055', '#7700cc', '#9900ee', '#ddd0ee', '#eee8ff', '#c8b8d8', '#c8b8d8', '#eee8ff', '#ddd0ee', '#9900ee', '#7700cc', '#2d0055', '#1a0033', null, null],\n  ['#1a0033', '#2d0055', '#5500aa', '#9900ee', '#cc00ff', '#ddd0ee', '#eee8ff', '#eee8ff', '#ddd0ee', '#cc00ff', '#9900ee', '#5500aa', '#2d0055', '#1a0033', null, null],\n  [null, '#1a0033', '#3d0077', '#ddd0ee', '#ffffff', '#2d0055', '#9900ee', '#9900ee', '#2d0055', '#ffffff', '#ddd0ee', '#3d0077', '#1a0033', null, null, null],\n  [null, null, '#2d0055', '#ffffff', '#ddd0ee', '#3d0077', '#9900ee', '#9900ee', '#3d0077', '#ddd0ee', '#ffffff', '#2d0055', null, null, null, null],\n  [null, null, '#1a0033', '#3d0077', '#7700cc', '#5500aa', '#3d0077', '#3d0077', '#5500aa', '#7700cc', '#3d0077', '#1a0033', null, null, null, null],\n  [null, null, null, '#1a0033', '#3d0077', '#7700cc', '#5500aa', '#5500aa', '#7700cc', '#3d0077', '#1a0033', null, null, null, null, null],\n  [null, null, null, null, '#1a0033', '#3d0077', '#5500aa', '#5500aa', '#3d0077', '#1a0033', null, null, null, null, null, null],\n  [null, null, null, null, '#0d0022', '#2d0055', '#3d0077', '#3d0077', '#2d0055', '#0d0022', null, null, null, null, null, null],\n  [null, null, null, null, null, '#0d0022', '#1a0033', '#1a0033', '#0d0022', null, null, null, null, null, null, null],\n  [null, null, null, null, null, null, '#080011', '#080011', null, null, null, null, null, null, null, null],\n];\n\n\n// ── Hero Sprite — Armored Knight (~10 wide x 14 tall pixels) ──\nconst SPRITE_HERO = [\n  [null, '#334466', '#446688', '#5577aa', '#5577aa', '#446688', '#334466', null, null, null],\n  ['#223355', '#446688', '#6699cc', '#88aadd', '#88aadd', '#6699cc', '#446688', '#223355', null, null],\n  ['#334466', '#5577aa', '#88aadd', '#eeeeff', '#eeeeff', '#88aadd', '#5577aa', '#334466', null, null],\n  [null, '#334466', '#5577aa', '#6699cc', '#6699cc', '#5577aa', '#334466', null, null, null],\n  ['#223355', '#5577aa', '#88aadd', '#aabbdd', '#aabbdd', '#88aadd', '#5577aa', '#223355', '#ccccdd', '#aaaacc'],\n  ['#334466', '#6699cc', '#aabbdd', '#ccddf0', '#ccddf0', '#aabbdd', '#6699cc', '#334466', '#ddddee', '#ccccdd'],\n  ['#334466', '#5577aa', '#88aadd', '#aabbdd', '#aabbdd', '#88aadd', '#5577aa', '#334466', null, null],\n  ['#223355', '#446688', '#6699cc', '#88aadd', '#88aadd', '#6699cc', '#446688', '#223355', null, null],\n  ['#334466', '#446688', '#5577aa', '#6699cc', '#6699cc', '#5577aa', '#446688', '#334466', null, null],\n  ['#223355', '#446688', '#6699cc', '#88aadd', null, '#88aadd', '#446688', '#223355', null, null],\n  ['#334466', '#5577aa', '#88aadd', '#aabbdd', null, '#aabbdd', '#5577aa', '#334466', null, null],\n  [null, '#334466', '#5577aa', '#6699cc', null, '#6699cc', '#5577aa', '#334466', null, null],\n  [null, '#223355', '#446688', '#5577aa', null, '#5577aa', '#446688', '#223355', null, null],\n  [null, '#1a2233', '#334466', '#446688', null, '#446688', '#334466', '#1a2233', null, null],\n];\n\n\n// ── Enemy Sprites — Shadow Imp walk cycle ──\nconst _ENEMY_TOP = [\n  ['#440000', null, null, null, null, null, null, null, null, '#440000'],\n  ['#660000', '#440000', null, null, null, null, null, null, '#440000', '#660000'],\n  ['#880000', '#aa2200', '#cc3300', '#cc3300', '#cc3300', '#cc3300', '#cc3300', '#aa2200', '#880000', null],\n  ['#aa2200', '#cc3300', '#ff5500', '#ffaa00', '#cc3300', '#cc3300', '#ffaa00', '#ff5500', '#cc3300', '#880000'],\n  ['#660000', '#aa2200', '#ffee00', '#ffff00', '#aa2200', '#aa2200', '#ffff00', '#ffee00', '#aa2200', '#660000'],\n  ['#880000', '#cc3300', '#ff5500', '#dd4400', '#aa2200', '#aa2200', '#dd4400', '#ff5500', '#cc3300', '#880000'],\n  ['#440000', '#880000', '#cc3300', '#ff5500', '#dd4400', '#dd4400', '#ff5500', '#cc3300', '#880000', '#440000'],\n  ['#440000', '#660000', '#aa2200', '#cc3300', '#ff5500', '#ff5500', '#cc3300', '#aa2200', '#660000', '#440000'],\n  [null, '#440000', '#880000', '#cc3300', '#dd4400', '#dd4400', '#cc3300', '#880000', '#440000', null],\n];\n\nconst SPRITE_ENEMY = _ENEMY_TOP.concat([\n  [null, null, '#440000', '#880000', '#aa2200', '#aa2200', '#880000', '#440000', null, null],\n  [null, '#330000', '#440000', '#660000', '#880000', '#880000', '#660000', '#440000', '#330000', null],\n  ['#220000', '#330000', null, '#440000', null, null, '#440000', null, '#330000', '#220000'],\n]);\n\nconst SPRITE_ENEMY_B = _ENEMY_TOP.concat([\n  ['#440000', '#880000', '#aa2200', null, null, null, '#aa2200', '#880000', '#440000', null],\n  ['#330000', '#440000', '#660000', '#880000', null, '#880000', '#660000', '#440000', '#330000', null],\n  ['#220000', '#330000', '#440000', null, null, null, '#440000', '#330000', '#220000', null],\n]);\n\nconst SPRITE_ENEMY_FRAMES = [SPRITE_ENEMY, SPRITE_ENEMY_B];\n\n\n// ── Projectile Sprite — Glowing Red Orb ──\nconst SPRITE_PROJECTILE = [\n  [null, '#ff2200', '#ff4400', '#ff2200', null],\n  ['#ff2200', '#ff6600', '#ffaa00', '#ff6600', '#ff2200'],\n  ['#ff4400', '#ffaa00', '#ffffff', '#ffaa00', '#ff4400'],\n  ['#ff2200', '#ff6600', '#ffaa00', '#ff6600', '#ff2200'],\n  [null, '#ff2200', '#ff4400', '#ff2200', null],\n];\n\n\n// ============================================================\n//  SPRITE DRAWING UTILITY\n// ============================================================\nconst drawSprite = (spriteArray, x, y, scale, alphaMultiplier) => {\n  if (alphaMultiplier === undefined) {\n    alphaMultiplier = 1.0;\n  }\n\n  for (let row = 0; row < spriteArray.length; row++) {\n    for (let col = 0; col < spriteArray[row].length; col++) {\n      const color = spriteArray[row][col];\n      if (color === null) continue;\n\n      ctx.globalAlpha = alphaMultiplier;\n      ctx.fillStyle = color;\n\n      ctx.fillRect(\n        Math.floor(x + col * scale),\n        Math.floor(y + row * scale),\n        scale,\n        scale\n      );\n    }\n  }\n\n  ctx.globalAlpha = 1.0;\n};\n\n\n// ============================================================\n//  GAME STATE\n// ============================================================\nlet gameEvents = [];\nlet iterationCount = 0;\nlet safetyCapHit = false;\n\nlet activeEnemies = [];\nlet activeProjectiles = [];\nlet particles = [];\n\nlet bossFlashTimer = 0;\nlet bossAlpha = 1.0;\nlet bossDefeatedAnim = false;\nlet screenShake = 0;\nlet redVignetteAlpha = 0;\n\nlet frameCount = 0;\nlet studentCodeSource = null;\nlet firstRunDone = false;\n\n\n// ============================================================\n//  BACKGROUND DRAWING\n// ============================================================\nconst drawBackground = () => {\n  const bgGrad = ctx.createLinearGradient(0, 0, 0, CH);\n  bgGrad.addColorStop(0, '#08080e');\n  bgGrad.addColorStop(0.7, '#0d0d18');\n  bgGrad.addColorStop(1, '#0a0810');\n  ctx.fillStyle = bgGrad;\n  ctx.fillRect(0, 0, CW, CH);\n\n  ctx.fillStyle = 'rgba(80, 60, 100, 0.07)';\n  const brickW = 50;\n  const brickH = 22;\n  for (let row = 0; row < Math.ceil(CH * 0.72 / brickH); row++) {\n    const offsetX = (row % 2 === 0) ? 0 : brickW / 2;\n    for (let col = -1; col < Math.ceil(CW / brickW) + 1; col++) {\n      const bx = col * brickW + offsetX;\n      const by = row * brickH;\n      ctx.strokeStyle = 'rgba(100, 80, 120, 0.09)';\n      ctx.lineWidth = 1;\n      ctx.strokeRect(bx + 1, by + 1, brickW - 2, brickH - 2);\n    }\n  }\n\n  const groundY = Math.floor(CH * 0.75);\n\n  ctx.fillStyle = '#06060a';\n  ctx.fillRect(0, groundY, CW, CH - groundY);\n\n  ctx.strokeStyle = 'rgba(102, 0, 204, 0.4)';\n  ctx.lineWidth = 2;\n  ctx.beginPath();\n  ctx.moveTo(0, groundY);\n  ctx.lineTo(CW, groundY);\n  ctx.stroke();\n\n  const floorGlow = ctx.createLinearGradient(0, groundY, 0, groundY + 40);\n  floorGlow.addColorStop(0, 'rgba(102, 0, 204, 0.12)');\n  floorGlow.addColorStop(1, 'transparent');\n  ctx.fillStyle = floorGlow;\n  ctx.fillRect(0, groundY, CW, 40);\n};\n\n\n// ============================================================\n//  HERO DRAWING\n// ============================================================\nconst HERO_X = 50;\n\nconst drawHeroes = (breathOffset) => {\n  const groundY = Math.floor(CH * 0.75);\n  const heroH = SPRITE_HERO.length * SCALE;\n\n  const bob = Math.sin(frameCount * 0.035) * 2;\n  const heroY = groundY - heroH + Math.round(breathOffset + bob);\n\n  drawSprite(SPRITE_HERO, HERO_X, heroY, SCALE, 1.0);\n};\n\n\n// ============================================================\n//  BOSS DRAWING\n// ============================================================\nconst drawBoss = () => {\n  const groundY = Math.floor(CH * 0.75);\n\n  const bossH = SPRITE_BOSS.length * SCALE;\n  const bossW = SPRITE_BOSS[0].length * SCALE;\n\n  const bossX = CW - bossW - 50;\n  const floatY = Math.sin(frameCount * 0.02) * 4;\n  const bossY = Math.floor(groundY - bossH - 20 + floatY);\n\n  const glowPulse = 0.5 + 0.5 * Math.sin(frameCount * 0.04);\n  const glowRadius = bossW * 1.4 + glowPulse * 15;\n  const bossCenterX = bossX + bossW / 2;\n  const bossCenterY = bossY + bossH / 2;\n\n  const bossGlow = ctx.createRadialGradient(\n    bossCenterX, bossCenterY, 0,\n    bossCenterX, bossCenterY, glowRadius\n  );\n\n  bossGlow.addColorStop(0, 'rgba(102, 0, 204, ' + (0.25 + glowPulse * 0.15) + ')');\n  bossGlow.addColorStop(1, 'transparent');\n\n  ctx.fillStyle = bossGlow;\n  ctx.beginPath();\n  ctx.ellipse(bossCenterX, bossCenterY, glowRadius, glowRadius * 0.8, 0, 0, Math.PI * 2);\n  ctx.fill();\n\n  let flashAlpha = 0;\n  if (bossFlashTimer > 0) {\n    flashAlpha = bossFlashTimer / 12;\n    bossFlashTimer--;\n  }\n\n  drawSprite(SPRITE_BOSS, bossX, bossY, SCALE, bossAlpha);\n\n  if (flashAlpha > 0) {\n    ctx.globalAlpha = flashAlpha * 0.6 * bossAlpha;\n    ctx.fillStyle = '#ff0000';\n    ctx.fillRect(bossX, bossY, bossW, bossH);\n    ctx.globalAlpha = 1.0;\n  }\n};\n\n// ============================================================\n//  HP BAR DRAWING\n// ============================================================\nconst drawHPBar = (currentHP, maxHP, roundNum) => {\n  const barX = 16;\n  const barY = 14;\n  const barW = 360;\n  const barH = 20;\n\n  ctx.fillStyle = '#cc88ff';\n  ctx.font = '14px \"Press Start 2P\"';\n  ctx.fillText('BOSS HP', barX, barY + barH - 6);\n\n  const labelW = 90;\n  const trackX = barX + labelW + 12;\n  const trackW = barW - labelW - 12;\n\n  ctx.fillStyle = '#1a001a';\n  ctx.fillRect(trackX, barY, trackW, barH);\n  ctx.strokeStyle = 'rgba(155, 0, 204, 0.6)';\n  ctx.lineWidth = 1;\n  ctx.strokeRect(trackX, barY, trackW, barH);\n\n  const hpFraction = Math.max(0, Math.min(1, currentHP / maxHP));\n  const red = Math.round(180 + (1 - hpFraction) * 75);\n  const green = Math.round(hpFraction * 180);\n\n  ctx.fillStyle = 'rgb(' + red + ',' + green + ',20)';\n  ctx.fillRect(trackX + 1, barY + 1, Math.floor((trackW - 2) * hpFraction), barH - 2);\n\n  ctx.fillStyle = '#ffffff';\n  ctx.font = '8px \"Press Start 2P\"';\n  ctx.fillText(currentHP + '/' + maxHP, trackX + trackW + 8, barY + barH - 6);\n\n  ctx.fillStyle = '#aa88ff';\n  ctx.font = '9px \"Press Start 2P\"';\n  const roundLabel = 'ROUND ' + roundNum;\n  const textWidth = ctx.measureText(roundLabel).width;\n  ctx.fillText(roundLabel, CW - textWidth - 16, barY + barH - 6);\n};\n\n\n// ============================================================\n//  ACTIVE ENEMY DRAWING + MOVEMENT\n// ============================================================\nconst updateAndDrawEnemies = () => {\n  const survivors = [];\n\n  for (let i = 0; i < activeEnemies.length; i++) {\n    const e = activeEnemies[i];\n\n    e.x -= e.speed;\n\n    e.frameTimer++;\n    if (e.frameTimer >= 8) {\n      e.frameTimer = 0;\n      e.frame = (e.frame === 0) ? 1 : 0;\n    }\n\n    const stomp = (e.frame === 0) ? 2 : -1;\n    const drawY = e.y + stomp;\n\n    if (e.alpha > 0) {\n      drawSprite(SPRITE_ENEMY_FRAMES[e.frame], Math.floor(e.x), Math.floor(drawY), e.spriteScale, e.alpha);\n    }\n\n    if (e.x > -50 && e.alpha > 0) {\n      survivors.push(e);\n    }\n  }\n\n  activeEnemies = survivors;\n};\n\n\n// ============================================================\n//  PROJECTILE DRAWING + MOVEMENT\n// ============================================================\nconst BOSS_HIT_X = CW - SPRITE_BOSS[0].length * SCALE - 60;\n\nconst updateAndDrawProjectiles = () => {\n  const survivors = [];\n\n  for (let i = 0; i < activeProjectiles.length; i++) {\n    const p = activeProjectiles[i];\n\n    p.x += p.speed;\n\n    if (!p.triggered && p.x >= BOSS_HIT_X) {\n      p.triggered = true;\n      bossFlashTimer = 12;\n\n      spawnParticles(\n        BOSS_HIT_X + 8,\n        p.y + 8,\n        12,\n        ['#ff2200', '#ff6600', '#ffaa00', '#ffffff'],\n        4,\n        22\n      );\n    }\n\n    if (p.x < CW + 20) {\n      const glowAlpha = p.triggered ? Math.max(0, 1 - (p.x - BOSS_HIT_X) / 60) : 1.0;\n\n      if (glowAlpha > 0) {\n        ctx.globalAlpha = glowAlpha * 0.45;\n        ctx.fillStyle = '#ff6600';\n        ctx.beginPath();\n        ctx.arc(p.x + 7, p.y + 7, 11, 0, Math.PI * 2);\n        ctx.fill();\n        ctx.globalAlpha = 1.0;\n\n        drawSprite(SPRITE_PROJECTILE, Math.floor(p.x), Math.floor(p.y), 3, glowAlpha);\n        survivors.push(p);\n      }\n    }\n  }\n\n  activeProjectiles = survivors;\n};\n\n\n// ============================================================\n//  PARTICLE SYSTEM\n// ============================================================\nconst spawnParticles = (x, y, count, colors, speed, life) => {\n  for (let i = 0; i < count; i++) {\n    const angle = Math.random() * Math.PI * 2;\n    const s = speed * (0.4 + Math.random() * 0.8);\n\n    particles.push({\n      x: x,\n      y: y,\n      vx: Math.cos(angle) * s,\n      vy: Math.sin(angle) * s - speed * 0.3,\n      color: colors[Math.floor(Math.random() * colors.length)],\n      alpha: 1.0,\n      size: 2 + Math.random() * 3,\n      life: life,\n      maxLife: life,\n    });\n  }\n};\n\nconst updateAndDrawParticles = () => {\n  const survivors = [];\n\n  for (let i = 0; i < particles.length; i++) {\n    const p = particles[i];\n\n    p.x += p.vx;\n    p.y += p.vy;\n    p.vy += 0.18;\n    p.life -= 1;\n    p.alpha = p.life / p.maxLife;\n\n    if (p.life > 0) {\n      ctx.globalAlpha = p.alpha;\n      ctx.fillStyle = p.color;\n      ctx.fillRect(Math.floor(p.x), Math.floor(p.y), Math.ceil(p.size), Math.ceil(p.size));\n      survivors.push(p);\n    }\n  }\n\n  ctx.globalAlpha = 1.0;\n  particles = survivors;\n};\n\n\n// ============================================================\n//  SCREEN EFFECTS\n// ============================================================\nconst drawRedVignette = () => {\n  if (redVignetteAlpha <= 0) return;\n\n  const grad = ctx.createRadialGradient(CW / 2, CH / 2, CH * 0.3, CW / 2, CH / 2, CW * 0.8);\n  grad.addColorStop(0, 'transparent');\n  grad.addColorStop(1, 'rgba(180, 0, 0, ' + redVignetteAlpha + ')');\n\n  ctx.fillStyle = grad;\n  ctx.fillRect(0, 0, CW, CH);\n};\n\n\n// ============================================================\n//  VICTORY OVERLAY\n// ============================================================\nconst showVictoryOverlay = (roundCount) => {\n  const overlay = document.getElementById('result-overlay');\n  if (!overlay) return;\n\n  overlay.className = 'victory';\n\n  overlay.innerHTML =\n    '<div class=\"overlay-inner\">' +\n      '<div class=\"overlay-icon\">&#x1F451;</div>' +\n      '<div class=\"overlay-title\">BOSS DEFEATED!</div>' +\n      '<div class=\"overlay-subtitle\">' +\n        'The Shadow Overlord fell in ' + roundCount + ' rounds.<br>' +\n        'The realm is saved.' +\n      '</div>' +\n      '<button class=\"overlay-btn\" onclick=\"runGame()\">&#x25BA; PLAY AGAIN</button>' +\n    '</div>';\n};\n\n\n// ============================================================\n//  OVERFLOW OVERLAY\n// ============================================================\nconst showOverflowOverlay = (roundCount) => {\n  const overlay = document.getElementById('result-overlay');\n  if (!overlay) return;\n\n  overlay.className = 'overflow';\n\n  overlay.innerHTML =\n    '<div class=\"overlay-inner\">' +\n      '<div class=\"overlay-icon\">&#x2620;</div>' +\n      '<div class=\"overlay-title\">INFINITE LOOP DETECTED</div>' +\n      '<div class=\"overlay-subtitle\">' +\n        roundCount + ' ITERATIONS — NO END IN SIGHT' +\n      '</div>' +\n      '<button class=\"overlay-btn\" onclick=\"runGame()\">&#x25BA; TRY AGAIN</button>' +\n    '</div>';\n};\n\n\n// ============================================================\n//  MAIN RENDER LOOP\n// ============================================================\nlet displayHP = 100;\nlet displayRound = 0;\n\nconst renderFrame = () => {\n  frameCount++;\n\n  ctx.save();\n\n  if (screenShake > 0) {\n    const dx = (Math.random() - 0.5) * screenShake * 2;\n    const dy = (Math.random() - 0.5) * screenShake * 2;\n    ctx.translate(dx, dy);\n    screenShake = Math.max(0, screenShake - 0.5);\n  }\n\n  drawBackground();\n  updateAndDrawEnemies();\n  updateAndDrawProjectiles();\n  drawHeroes(0);\n\n  if (bossAlpha > 0) {\n    drawBoss();\n  }\n\n  updateAndDrawParticles();\n  drawRedVignette();\n  drawHPBar(displayHP, 100, displayRound);\n\n  ctx.restore();\n};\n\n\n// ============================================================\n//  EVENT QUEUE ANIMATOR\n// ============================================================\nconst EVENT_INTERVAL = 120;\n\nconst animateEvents = () => {\n  console.log('animateEvents() — processing', gameEvents.length, 'events');\n\n  let eventIndex = 0;\n\n  const ticker = setInterval(() => {\n    if (eventIndex < gameEvents.length) {\n      const ev = gameEvents[eventIndex];\n      eventIndex++;\n\n      console.log('Animating event', eventIndex, '/', gameEvents.length, ':', ev.type, ev);\n\n      if (ev.type === 'spawn') {\n        const groundY = Math.floor(CH * 0.75);\n        const enemyH = SPRITE_ENEMY.length * SCALE;\n        const enemySpd = 1.5 + Math.random() * 1.2;\n\n        activeEnemies.push({\n          x: CW - 120 - Math.random() * 60,\n          y: groundY - enemyH,\n          speed: enemySpd,\n          alpha: 1.0,\n          spriteScale: SCALE,\n          name: ev.enemyName,\n          frame: 0,\n          frameTimer: Math.floor(Math.random() * 8),\n        });\n\n        displayRound = ev.round;\n\n      } else if (ev.type === 'attack') {\n        displayHP = ev.bossHPAfter;\n\n        const groundY = Math.floor(CH * 0.75);\n        const heroH = SPRITE_HERO.length * SCALE;\n\n        activeProjectiles.push({\n          x: HERO_X + SPRITE_HERO[0].length * SCALE,\n          y: groundY - heroH + Math.floor(heroH * 0.35),\n          speed: 4 + Math.random() * 2,\n          alpha: 1.0,\n          triggered: false,\n          bossHP: ev.bossHPAfter,\n        });\n\n      } else if (ev.type === 'defeat') {\n        bossDefeatedAnim = true;\n\n        const bossW = SPRITE_BOSS[0].length * SCALE;\n        const groundY = Math.floor(CH * 0.75);\n\n        spawnParticles(\n          CW - bossW / 2 - 50,\n          groundY - 60,\n          60,\n          ['#ffcc00', '#ffaa00', '#ffffff', '#ff8800', '#ffff88'],\n          7,\n          80\n        );\n\n      } else if (ev.type === 'result') {\n        if (ev.safetyCapHit) {\n          redVignetteAlpha = 0.6;\n          screenShake = 8;\n\n          const groundY = Math.floor(CH * 0.75);\n          const enemyH = SPRITE_ENEMY.length * SCALE;\n\n          for (let j = 0; j < 10; j++) {\n            activeEnemies.push({\n              x: Math.random() * CW,\n              y: groundY - enemyH - Math.random() * 60,\n              speed: 2 + Math.random() * 3,\n              alpha: 0.8,\n              spriteScale: SCALE,\n              name: 'overflow',\n              frame: Math.floor(Math.random() * 2),\n              frameTimer: Math.floor(Math.random() * 8),\n            });\n          }\n\n          setTimeout(() => {\n            showOverflowOverlay(ev.round);\n          }, 1200);\n\n        } else if (ev.bossDefeated) {\n          setTimeout(() => {\n            showVictoryOverlay(ev.round);\n          }, 900);\n\n        } else {\n          setTimeout(() => {\n            showVictoryOverlay(ev.round);\n          }, 900);\n        }\n\n        clearInterval(ticker);\n        return;\n      }\n\n    } else {\n      clearInterval(ticker);\n    }\n  }, EVENT_INTERVAL);\n};\n\n// ============================================================\n//  PUBLIC FUNCTIONS CALLED BY STUDENT CODE\n// ============================================================\n\n// ────────────────────────────────────────────────────────────\n// spawnEnemy(round)\n//\n// Called each iteration of the while loop.\n// Increments the iteration counter and pushes a 'spawn' event.\n// If the iteration count exceeds 200, forces the loop to stop.\n// ────────────────────────────────────────────────────────────\nconst spawnEnemy = (round) => {\n  iterationCount++;\n  console.log('spawnEnemy — iteration:', iterationCount, '| round:', round);\n\n  if (iterationCount > 200) {\n    safetyCapHit = true;\n\n    // Writing to bossDefeated exits the while loop because\n    // the student's code is evaled so their variables are available here.\n    bossDefeated = true; // eslint-disable-line no-undef\n\n    console.warn('SAFETY CAP HIT at iteration', iterationCount, '— forcing bossDefeated = true');\n    return;\n  }\n\n  const prefixes = ['Shadow', 'Dark', 'Cursed', 'Void', 'Nether', 'Phantom', 'Blighted', 'Infernal', 'Hollow', 'Dread'];\n  const suffixes = ['Wraith', 'Imp', 'Specter', 'Shade', 'Fiend', 'Golem', 'Lurker', 'Revenant', 'Stalker', 'Horror'];\n\n  const name = prefixes[Math.floor(Math.random() * prefixes.length)] + ' '\n             + suffixes[Math.floor(Math.random() * suffixes.length)];\n\n  gameEvents.push({\n    type: 'spawn',\n    round: round,\n    enemyName: name,\n  });\n};\n\n\n// ────────────────────────────────────────────────────────────\n// attackBoss(round)\n//\n// Called each iteration after spawnEnemy().\n// Deals 10–20 damage, clamps bossHP to 0, and pushes an 'attack' event.\n// ────────────────────────────────────────────────────────────\nconst attackBoss = (round) => {\n  const damage = Math.floor(Math.random() * 11) + 10;\n\n  bossHP = bossHP - damage; // eslint-disable-line no-undef\n  if (bossHP < 0) {\n    bossHP = 0; // eslint-disable-line no-undef\n  }\n\n  console.log('attackBoss — round:', round, '| damage:', damage, '| bossHP now:', bossHP);\n\n  gameEvents.push({\n    type: 'attack',\n    round: round,\n    damage: damage,\n    bossHPAfter: bossHP, // eslint-disable-line no-undef\n  });\n};\n\n\n// ────────────────────────────────────────────────────────────\n// showResult(round)\n//\n// Called once after the while loop ends.\n// Pushes a 'result' event and then starts the animation engine.\n// ────────────────────────────────────────────────────────────\nconst showResult = (round) => {\n  console.log(\n    'showResult — round:', round,\n    '| bossDefeated:', (typeof bossDefeated !== 'undefined') ? bossDefeated : '(not defined)', // eslint-disable-line no-undef\n    '| safetyCapHit:', safetyCapHit\n  );\n\n  if (typeof bossDefeated !== 'undefined' && bossDefeated === true && !safetyCapHit) { // eslint-disable-line no-undef\n    gameEvents.push({ type: 'defeat' });\n  }\n\n  gameEvents.push({\n    type: 'result',\n    round: round,\n    safetyCapHit: safetyCapHit,\n    bossDefeated: (typeof bossDefeated !== 'undefined') ? bossDefeated : false, // eslint-disable-line no-undef\n  });\n\n  animateEvents();\n};\n\n\n// Make these available to the student code and inline Play Again buttons.\nwindow.spawnEnemy = spawnEnemy;\nwindow.attackBoss = attackBoss;\nwindow.showResult = showResult;\n\n\n// ============================================================\n//  RENDER LOOP STARTUP\n// ============================================================\nconst startRenderLoop = () => {\n  const tick = () => {\n    if (bossDefeatedAnim && bossAlpha > 0) {\n      bossAlpha = Math.max(0, bossAlpha - 0.012);\n    }\n\n    renderFrame();\n    requestAnimationFrame(tick);\n  };\n\n  requestAnimationFrame(tick);\n};\n\n\n// ============================================================\n//  runGame()\n//  Called by the \"PLAY AGAIN\" button in the result overlay.\n// ============================================================\nconst runGame = () => {\n  console.log('--- runGame() called ---');\n\n  gameEvents = [];\n  iterationCount = 0;\n  safetyCapHit = false;\n  activeEnemies = [];\n  activeProjectiles = [];\n  particles = [];\n  bossFlashTimer = 0;\n  bossAlpha = 1.0;\n  bossDefeatedAnim = false;\n  screenShake = 0;\n  redVignetteAlpha = 0;\n  displayHP = 100;\n  displayRound = 0;\n\n  const overlay = document.getElementById('result-overlay');\n  if (overlay) {\n    overlay.className = 'hidden';\n    overlay.innerHTML = '';\n  }\n\n  if (studentCodeSource) {\n    evalStudentCode(studentCodeSource);\n  } else {\n    fetchAndRunStudentCode();\n  }\n};\n\nwindow.runGame = runGame;\n\n\n// ────────────────────────────────────────────────────────────\n// evalStudentCode(source)\n//\n// Strips 'let' and 'const' from variable declarations so the\n// student's bossHP, bossDefeated, and round variables become\n// available to the helper code.\n// ────────────────────────────────────────────────────────────\nconst evalStudentCode = (source) => {\n  const executableCode = source\n    .replace(/\\blet\\b/g, '')\n    .replace(/\\bconst\\b/g, '');\n\n  console.log('evalStudentCode — running', executableCode.length, 'characters of student code');\n\n  try {\n    eval(executableCode); // eslint-disable-line no-eval\n    console.log('Student code finished executing successfully.');\n  } catch (err) {\n    console.error('Error in student code:', err.toString());\n    showErrorOnCanvas(err.toString());\n  }\n};\n\n\n// ────────────────────────────────────────────────────────────\n// showErrorOnCanvas(message)\n//\n// When student code has a syntax error, this draws a simple\n// error message directly onto the canvas.\n// ────────────────────────────────────────────────────────────\nconst showErrorOnCanvas = (message) => {\n  ctx.fillStyle = 'rgba(10, 0, 0, 0.85)';\n  ctx.fillRect(20, CH / 2 - 60, CW - 40, 120);\n  ctx.strokeStyle = '#cc0000';\n  ctx.lineWidth = 2;\n  ctx.strokeRect(20, CH / 2 - 60, CW - 40, 120);\n\n  ctx.fillStyle = '#ff4444';\n  ctx.font = '10px \"Press Start 2P\"';\n  ctx.fillText('CODE ERROR', 36, CH / 2 - 32);\n\n  ctx.fillStyle = '#ffaaaa';\n  ctx.font = '8px \"Press Start 2P\"';\n\n  const words = message.split(' ');\n  let line = '';\n  let lineY = CH / 2 - 8;\n  const maxW = CW - 80;\n\n  for (let w = 0; w < words.length; w++) {\n    const test = line + words[w] + ' ';\n\n    if (ctx.measureText(test).width > maxW && line !== '') {\n      ctx.fillText(line, 36, lineY);\n      line = words[w] + ' ';\n      lineY += 18;\n\n      if (lineY > CH / 2 + 50) break;\n    } else {\n      line = test;\n    }\n  }\n\n  if (line.trim()) {\n    ctx.fillText(line, 36, lineY);\n  }\n};\n\n\n// ────────────────────────────────────────────────────────────\n// fetchAndRunStudentCode()\n//\n// Fetches script.js, stores its source, and evals it.\n// ────────────────────────────────────────────────────────────\nconst fetchAndRunStudentCode = () => {\n  const url = 'script.js?t=' + Date.now();\n\n  console.log('Fetching student code from', url);\n\n  fetch(url)\n    .then((response) => {\n      if (!response.ok) {\n        throw new Error('Could not load script.js (HTTP ' + response.status + ')');\n      }\n\n      return response.text();\n    })\n    .then((source) => {\n      studentCodeSource = source;\n      console.log('script.js fetched —', source.length, 'characters');\n      evalStudentCode(source);\n    })\n    .catch((err) => {\n      console.error('fetchAndRunStudentCode failed:', err);\n      showErrorOnCanvas('Could not load script.js: ' + err.message);\n    });\n};\n\n\n// ============================================================\n//  BOOTSTRAP\n// ============================================================\nstartRenderLoop();\nfetchAndRunStudentCode();",
          "folderId": "0",
          "active": true,
          "type": "support"
        },
        "4": {
          "id": "4",
          "name": "script.js",
          "contents": "// Boss starts with 100 HP. Enemies keep spawning until boss is defeated.\nlet bossHP = 100;\nlet bossDefeated = false;\nlet round = 0;\n\nwhile (bossDefeated === false) {\n    round++;\n    spawnEnemy(round);\n    attackBoss(round);\n  // What information should the loop use to decide when the battle is over?\n\n    \n}\n\nshowResult(round);\n",
          "folderId": "0",
          "active": false
        }
      },
