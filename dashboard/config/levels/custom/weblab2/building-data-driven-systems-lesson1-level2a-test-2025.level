  "properties": {
    "encrypted": "false",
    "long_instructions": "#Music Magazine\r\n\r\n###Do This:\r\n\r\n1. Fill your Arrays: Create 2 arrays (`headlines`, `taglines`) with 3 items each. Ensure index 0 in all lists matches the same story.\r\n\r\n2. Pick Index: Create a variable `let index = 0;` to track the current cover.\r\n\r\n3. Update Page: Use document.querySelector and your index variable to:\r\n\t* Set `#headline` text to `headlines[index]`.\r\n    * Set `#coverImage` src to `images[index]`.\r\n    * Set `#tagline` text to `taglines[index]`.\r\n\r\n4. Show Count: Update `#count` text to display the total number of covers using `.length.`\r\n",
    "submittable": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
    "disable_edit_run_for_submission": "false",
