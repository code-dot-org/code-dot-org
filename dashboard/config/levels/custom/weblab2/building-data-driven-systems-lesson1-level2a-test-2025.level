      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Music Magazine Cover</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <main class=\"magazine-container\">\n    <header class=\"masthead\">\n      <h1 id=\"magTitle\">Top Tracks Weekly</h1>\n      <p class=\"issue-date\">Volume 42 • Special Edition</p>\n    </header>\n\n    <div class=\"cover-content\">\n      <img id=\"coverImage\" src=\"/images/cover1a.png\" alt=\"Magazine Cover Image\">\n      \n      <div class=\"text-overlay\">\n        <h2 id=\"headline\"></h2>\n        <p id=\"tagline\"></p>\n      </div>\n    </div>\n\n    <footer class=\"stats\">\n      <p id=\"count\"></p>\n    </footer>\n  </main>\n\n</body>\n</html>",
          "active": true,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// MUSIC MAGAZINE: Parallel Arrays\n\n// Data Arrays\nconst coverImages = [\n  \"/images/cover1a.png\",\n  \"/images/cover2a.png\",\n  \"/images/cover3a.png\"\n];\nconst headlines = [];\nconst taglines = [];\n\n\n\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: 'Arial', sans-serif;\n  background-color: #333;\n  color: white;\n  display: flex;\n  justify-content: center;\n  padding: 20px;\n}\n\n.magazine-container {\n  background-color: #1a1a1a; /* Dark theme for Music Mag */\n  width: 350px;\n  padding: 20px;\n  border: 2px solid #fff;\n  text-align: center;\n  box-shadow: 0 0 20px rgba(0,0,0,0.5);\n}\n\n.masthead h1 {\n  font-family: 'Georgia', serif;\n  font-size: 2.5rem;\n  margin-bottom: 5px;\n  color: #e91e63; /* Vibrant accent color */\n  text-transform: uppercase;\n  letter-spacing: 2px;\n}\n\n.issue-date {\n  border-top: 1px solid #555;\n  border-bottom: 1px solid #555;\n  padding: 5px;\n  font-size: 0.8rem;\n  color: #ccc;\n  margin-bottom: 20px;\n}\n\n#coverImage {\n  width: 100%;\n  height: auto;\n  border: 4px solid #fff;\n  margin-bottom: 15px;\n}\n\n#headline {\n  font-size: 1.8rem;\n  color: #ffeb3b; /* Yellow for high impact */\n  margin: 10px 0;\n  line-height: 1.1;\n}\n\n#tagline {\n  font-size: 1.1rem;\n  font-style: italic;\n  color: #fff;\n}\n\n.stats {\n  margin-top: 30px;\n  font-size: 0.9rem;\n  color: #888;\n}",
          "folderId": "0",
          "active": false
        },
