        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html> \n<html> \n<head>\n   <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <h1>Fun Fruits!</h1> \n  \n  <p>Here are some fun fruits. Can you match the fruit to the name?</p>\n  <img src=\"durian.jpg\"  alt=\"Durian\">  \n  <img src=\"buddhashand.jpg\" alt=\"buddhashand\">\n  <img src=\"hornfruit.jpg\" alt=\"hornfruit\">\n  <img src=\"starfruit.jpg\" alt=\"starfruit\">\n  <img src=\"rambutan.jpg\" alt=\"rambutan\">\n<hr>\n  <p>Durian</p>\n  <p>Buddha's Hand</p>\n  <p>Horn Fruit</p>\n  <p>Carambola</p>\n  <p>Rambutan</p>\n  <hr>\n  <h6>Picture 1 - Francis Chung - flickr - CC-BY</h6>\n  <h6>Picture 4 - Kaldari - Wikimedia Commons - Public Domain</h6>\n  <h6>Picture 2 - Lebensmittelfotos - pixabay - Pixabay License</h6>\n  <h6>Picture 3 - icon0com - pxhere - CC0</h6>\n  <h6>Picture 5 - maxipixel - CC0 Public Domain</h6>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  background-color: lightblue;\n}\n\nh1 {\n    font-family: sans-serif;\n}\n\nh2 {\nfont-family: sans-serif;\n}\nhr {\n  width: 100%;\n}\n\nimg {\n  float: left;\n  height: 100\n  margin: 10px;\n  border-color: green;\n  border-width: 4px;\n  border-style: double;\n  border-radius: 20px;\n}\n\np {\n    text-align: left;\n    font-family: fantasy;\n    font-size: 14px;\n}",
