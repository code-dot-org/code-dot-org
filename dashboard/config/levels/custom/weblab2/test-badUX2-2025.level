      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Paws & Friends Adoption</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n\n  <body>\n    <nav class=\"nav\">\n      <div class=\"nav-left\">\n        <span class=\"brand\">Paws & Friends</span>\n      </div>\n\n      <div class=\"nav-links\" aria-label=\"Primary\">\n        <a class=\"nav-link\" href=\"#home\">\n          <img src=\"assets/home.png\" alt=\"\" />\n          <span>Home</span>\n        </a>\n        <a class=\"nav-link\" href=\"#dogs\">\n          <img src=\"assets/dogs.png\" alt=\"\" />\n          <span>Dogs</span>\n        </a>\n        <a class=\"nav-link\" href=\"#cats\">\n          <img src=\"assets/cats.png\" alt=\"\" />\n          <span>Cats</span>\n        </a>\n        <a class=\"nav-link\" href=\"#small-pets\">\n          <img src=\"assets/small-pets.png\" alt=\"\" />\n          <span>Small Pets</span>\n        </a>\n        <a class=\"nav-link\" href=\"#contact\">\n          <img src=\"assets/contact.png\" alt=\"\" />\n          <span>Contact</span>\n        </a>\n      </div>\n    </nav>\n\n    <header id=\"home\" class=\"hero\">\n      <div class=\"hero-content\">\n        <p class=\"hero-eyebrow\">Adopt • Foster • Volunteer</p>\n        <h1>Find your next best friend.</h1>\n        <p class=\"hero-sub\">Browse adoptable pets and start an application in minutes.</p>\n        <div class=\"hero-actions\">\n          <a class=\"btn primary\" href=\"#dogs\">Browse Dogs</a>\n          <a class=\"btn ghost\" href=\"#contact\">Contact</a>\n        </div>\n      </div>\n    </header>\n\n    <main>\n      <section id=\"dogs\" class=\"section\">\n        <div class=\"section-head\">\n          <div>\n            <h2>Dogs Available</h2>\n          </div>\n\n          <div class=\"filters\" aria-label=\"Filters\">\n            <button class=\"filter-btn\" data-filter=\"small\" type=\"button\">Small</button>\n            <button class=\"filter-btn\" data-filter=\"kids\" type=\"button\">Good with Kids</button>\n            <button class=\"filter-btn\" data-filter=\"under2\" type=\"button\">Under 2</button>\n          </div>\n        </div>\n\n        <!-- No results count on purpose -->\n        <div class=\"cards\" aria-label=\"Dog cards\">\n          <!-- Dog 1: Frenchie hoodie (cozy, calm) -->\n          <article class=\"card\" data-small=\"true\" data-kids=\"true\" data-under2=\"false\">\n            <img src=\"assets/dog1-adoption.jpg\" alt=\"Bean, a small dog available for adoption\" />\n            <div class=\"card-body\">\n              <div class=\"card-top\">\n                <h3>Bean</h3>\n                <span class=\"pill\">Small</span>\n              </div>\n\n              <p class=\"meta\">Age: 2 years • Temperament: mellow</p>\n\n              <div class=\"badges\">\n                <span class=\"badge ok\">Family home</span>\n                <span class=\"badge meh\">Low energy</span>\n              </div>\n\n              <p class=\"desc\">\n                Bean prefers quiet evenings and short walks. He settles quickly and likes staying close.\n              </p>\n\n              <div class=\"card-actions\">\n                <button class=\"btn small primary adopt-btn\" type=\"button\">Adopt</button>\n                <button class=\"btn small ghost details-btn\" type=\"button\">Details</button>\n              </div>\n\n              <div class=\"details hidden\">\n                <p class=\"details-text\">\n                  Notes: does well indoors • has lived with children before • enjoys routine\n                </p>\n              </div>\n            </div>\n          </article>\n\n          <!-- Dog 2: Corgi (friendly, confident) -->\n          <article class=\"card\" data-small=\"false\" data-kids=\"true\" data-under2=\"false\">\n            <img src=\"assets/dog2-adoption.jpg\" alt=\"Sunny, a dog available for adoption\" />\n            <div class=\"card-body\">\n              <div class=\"card-top\">\n                <h3>Sunny</h3>\n                <span class=\"pill\">30 lbs</span>\n              </div>\n\n              <ul class=\"meta-list\">\n                <li>3 years old</li>\n                <li>Outgoing</li>\n                <li>Very social</li>\n              </ul>\n\n              <p class=\"desc\">\n                Sunny loves meeting new people and adapts quickly. Great for an active, busy household.\n              </p>\n\n              <div class=\"card-actions\">\n                <button class=\"btn small primary adopt-btn\" type=\"button\">Adopt</button>\n                <button class=\"btn small ghost details-btn\" type=\"button\">Details</button>\n              </div>\n\n              <div class=\"details hidden\">\n                <p class=\"details-text\">\n                  Notes: enjoys play time • has spent time around kids • confident indoors\n                </p>\n              </div>\n            </div>\n          </article>\n\n          <!-- Dog 3: Terrier portrait (smart, focused) -->\n          <article class=\"card\" data-small=\"true\" data-kids=\"false\" data-under2=\"true\">\n            <img src=\"assets/dog3-adoption.jpg\" alt=\"Dash, a dog available for adoption\" />\n            <div class=\"card-body\">\n              <div class=\"card-top\">\n                <h3>Dash</h3>\n                <span class=\"pill\">Compact</span>\n              </div>\n\n              <p class=\"meta\">Age: 1 yr • Traits: observant, quick learner</p>\n\n              <p class=\"desc\">\n                Dash is bright and attentive. He enjoys structured activities and responds well to training.\n              </p>\n\n              <div class=\"card-actions\">\n                <button class=\"btn small primary adopt-btn\" type=\"button\">Adopt</button>\n                <button class=\"btn small ghost details-btn\" type=\"button\">Details</button>\n              </div>\n\n              <div class=\"details hidden\">\n                <p class=\"details-text\">\n                  Notes: ongoing training • prefers calm routines • bonds closely with his person\n                </p>\n              </div>\n            </div>\n          </article>\n\n          <!-- Dog 4: Fluffy running (playful, energetic) -->\n          <article class=\"card\" data-small=\"true\" data-kids=\"true\" data-under2=\"true\">\n            <img src=\"assets/dog4-adoption.jpg\" alt=\"Milo, a dog available for adoption\" />\n            <div class=\"card-body\">\n              <div class=\"card-top\">\n                <h3>Milo</h3>\n                <span class=\"pill\">Under 2</span>\n              </div>\n\n              <ul class=\"meta-list\">\n                <li>Young</li>\n                <li>Very active</li>\n                <li>Playful</li>\n              </ul>\n\n              <p class=\"desc\">\n                Milo is happiest outside and loves to run. He’d do best with daily activity and attention.\n              </p>\n\n              <div class=\"card-actions\">\n                <button class=\"btn small primary adopt-btn\" type=\"button\">Adopt</button>\n                <button class=\"btn small ghost details-btn\" type=\"button\">Details</button>\n              </div>\n\n              <div class=\"details hidden\">\n                <p class=\"details-text\">\n                  Notes: social with people • learns fast • has done well around kids in foster care\n                </p>\n              </div>\n            </div>\n          </article>\n\n          <!-- Dog 5: Intense tan/white (serious, needs structure) -->\n          <article class=\"card\" data-small=\"false\" data-kids=\"false\" data-under2=\"false\">\n            <img src=\"assets/dog5-adoption.jpg\" alt=\"Ranger, a dog available for adoption\" />\n            <div class=\"card-body\">\n              <div class=\"card-top\">\n                <h3>Ranger</h3>\n                <span class=\"pill\">Medium</span>\n              </div>\n\n              <p class=\"meta\">4 yrs • Loyal • Focused</p>\n\n              <p class=\"desc\">\n                Ranger is attentive and steady with people he trusts. He thrives with clear boundaries.\n              </p>\n\n              <div class=\"card-actions\">\n                <button class=\"btn small primary adopt-btn\" type=\"button\">Adopt</button>\n                <button class=\"btn small ghost details-btn\" type=\"button\">Details</button>\n              </div>\n\n              <div class=\"details hidden\">\n                <p class=\"details-text\">\n                  Notes: best with consistent handling • prefers predictable environments\n                </p>\n              </div>\n            </div>\n          </article>\n\n          <!-- Dog 6: Chihuahua lounging (tiny, quiet) -->\n          <article class=\"card\" data-small=\"true\" data-kids=\"false\" data-under2=\"false\">\n            <img src=\"assets/dog6-adoption.jpg\" alt=\"Poppy, a small dog available for adoption\" />\n            <div class=\"card-body\">\n              <div class=\"card-top\">\n                <h3>Poppy</h3>\n                <span class=\"pill\">Mini</span>\n              </div>\n\n              <p class=\"meta\">Age: 5 • Quiet temperament</p>\n\n              <p class=\"desc\">\n                Poppy likes calm spaces and gentle handling. She enjoys lounging and short strolls.\n              </p>\n\n              <div class=\"card-actions\">\n                <button class=\"btn small primary adopt-btn\" type=\"button\">Adopt</button>\n                <button class=\"btn small ghost details-btn\" type=\"button\">Details</button>\n              </div>\n\n              <div class=\"details hidden\">\n                <p class=\"details-text\">\n                  Notes: sensitive personality • settles best in quieter homes\n                </p>\n              </div>\n            </div>\n          </article>\n        </div>\n      </section>\n\n      <section id=\"cats\" class=\"section\">\n        <div class=\"section-head\">\n          <div>\n            <h2>Cats Available</h2>\n            <p class=\"section-sub muted\">Some profiles may be shorter while we update records.</p>\n          </div>\n        </div>\n\n        <div class=\"cards\" aria-label=\"Cat cards\">\n          <!-- Cat 1: calico outdoors -->\n          <article class=\"card\">\n            <img src=\"assets/adopt-cat-1.jpg\" alt=\"Juniper, a cat available for adoption\" />\n            <div class=\"card-body\">\n              <div class=\"card-top\">\n                <h3>Juniper</h3>\n                <span class=\"pill\">Adult</span>\n              </div>\n\n              <p class=\"meta\">Temperament: watchful • Likes: windows</p>\n\n              <p class=\"desc\">\n                Juniper is calm and observant. She warms up slowly and enjoys a quiet space to settle in.\n              </p>\n\n              <div class=\"card-actions\">\n                <button class=\"btn small primary adopt-btn\" type=\"button\">Adopt</button>\n                <button class=\"btn small ghost details-btn\" type=\"button\">Details</button>\n              </div>\n\n              <div class=\"details hidden\">\n                <p class=\"details-text\">\n                  Notes: independent • gentle once comfortable • enjoys calm routines\n                </p>\n              </div>\n            </div>\n          </article>\n\n          <!-- Cat 2: kitten reaching -->\n          <article class=\"card\">\n            <img src=\"assets/adopt-cat-2.jpg\" alt=\"Pip, a cat available for adoption\" />\n            <div class=\"card-body\">\n              <div class=\"card-top\">\n                <h3>Pip</h3>\n                <span class=\"pill\">Kitten</span>\n              </div>\n\n              <ul class=\"meta-list\">\n                <li>Playful</li>\n                <li>Curious</li>\n                <li>Climber</li>\n              </ul>\n\n              <p class=\"desc\">\n                Pip is always on the move and loves toys that dangle. Quick to explore and investigate.\n              </p>\n\n              <div class=\"card-actions\">\n                <button class=\"btn small primary adopt-btn\" type=\"button\">Adopt</button>\n                <button class=\"btn small ghost details-btn\" type=\"button\">Details</button>\n              </div>\n\n              <div class=\"details hidden\">\n                <p class=\"details-text\">\n                  Notes: high play drive • learning boundaries • loves interactive play\n                </p>\n              </div>\n            </div>\n          </article>\n\n          <!-- Cat 3: tabby on stairs -->\n          <article class=\"card\">\n            <img src=\"assets/adopt-cat-3.jpg\" alt=\"Maple, a cat available for adoption\" />\n            <div class=\"card-body\">\n              <div class=\"card-top\">\n                <h3>Maple</h3>\n                <span class=\"pill\">2 yrs</span>\n              </div>\n\n              <p class=\"meta\">Personality: friendly • Best with: attention</p>\n\n              <p class=\"desc\">\n                Maple is affectionate and likes being near people. She’ll follow you around and ask for pets.\n              </p>\n\n              <div class=\"card-actions\">\n                <button class=\"btn small primary adopt-btn\" type=\"button\">Adopt</button>\n                <button class=\"btn small ghost details-btn\" type=\"button\">Details</button>\n              </div>\n\n              <div class=\"details hidden\">\n                <p class=\"details-text\">\n                  Notes: confident indoors • adjusts quickly • enjoys company\n                </p>\n              </div>\n            </div>\n          </article>\n        </div>\n      </section>\n\n      <section id=\"small-pets\" class=\"section muted-section\">\n        <h2>Small Pets</h2>\n        <p class=\"muted\">Small pets are currently being updated. Check back soon.</p>\n      </section>\n\n      <section id=\"contact\" class=\"section contact\">\n        <h2>Contact</h2>\n        <p class=\"muted\">\n          Questions? Email the shelter. Adoption appointments available weekdays.\n        </p>\n\n        <div class=\"contact-card\">\n          <p class=\"contact-title\">Start Adoption</p>\n          <p class=\"contact-sub\">We’ll get back to you in 1–3 business days.</p>\n          <button id=\"contactStart\" class=\"btn primary\" type=\"button\">Start Adoption Process</button>\n          <p class=\"tiny\">\n            Tip: If you already picked a dog, click “Adopt” on their card first.\n          </p>\n        </div>\n      </section>\n    </main>\n\n    <footer class=\"footer\">\n      <p class=\"footer-text\">© Paws & Friends Shelter • Hours vary</p>\n    </footer>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
