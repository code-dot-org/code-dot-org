        "18": {
          "id": "18",
          "name": "style.css",
          "contents": ":root {\n  --bg: #0b1220;\n  --panel: #111a2c;\n  --card: #0f172a;\n  --text: #e8eefc;\n  --muted: #a8b3d6;\n  --border: rgba(255, 255, 255, 0.12);\n  --primary: #3b82f6;\n  --primary-2: #2563eb;\n  --ghost: rgba(255, 255, 255, 0.08);\n}\n\n* { box-sizing: border-box; }\n\nhtml { scroll-behavior: smooth; }\n\nbody {\n  margin: 0;\n  font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, Helvetica, sans-serif;\n  background: radial-gradient(1200px 600px at 20% 0%, #122040, #070b14);\n  color: var(--text);\n}\n\n/* NAV */\n.nav {\n  position: sticky;\n  top: 0;\n  z-index: 10;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 14px;\n  padding: 10px 14px;\n  background: rgba(10, 14, 26, 0.78);\n  backdrop-filter: blur(10px);\n  border-bottom: 1px solid var(--border);\n}\n\n.brand {\n  font-weight: 700;\n  letter-spacing: 0.2px;\n}\n\n.nav-links {\n  display: flex;\n  gap: 10px;\n  align-items: center;\n}\n\n.nav-link {\n  display: inline-flex;\n  align-items: center;\n  gap: 8px;\n  padding: 8px 10px;\n  border-radius: 10px;\n  color: var(--text);\n  text-decoration: none;\n  border: 1px solid transparent;\n}\n\n.nav-link:hover {\n  background: rgba(255,255,255,0.06);\n  border-color: rgba(255,255,255,0.10);\n}\n\n.nav-link img {\n  width: 18px;\n  height: 18px;\n  opacity: 0.9;\n}\n\n.nav-link span {\n  font-size: 13px;\n}\n\n/* HERO */\n.hero {\n  min-height: 64vh;\n  display: grid;\n  place-items: end start;\n  background:\n    linear-gradient(180deg, rgba(0,0,0,0.10), rgba(0,0,0,0.75)),\n    url(\"assets/hero-dog.jpg\");\n  background-size: cover;\n  background-position: center;\n  padding: 22px 14px 34px 14px;\n  border-bottom: 1px solid var(--border);\n}\n\n.hero-content {\n  max-width: 720px;\n  background: rgba(17, 26, 44, 0.62);\n  border: 1px solid rgba(255,255,255,0.12);\n  border-radius: 18px;\n  padding: 16px 16px 14px 16px;\n}\n\n.hero-eyebrow {\n  margin: 0 0 6px 0;\n  color: var(--muted);\n  font-size: 12px;\n  letter-spacing: 0.3px;\n}\n\n.hero h1 {\n  margin: 0 0 8px 0;\n  font-size: 34px;\n  line-height: 1.05;\n}\n\n.hero-sub {\n  margin: 0 0 14px 0;\n  color: #c8d2f0;\n  font-size: 14px;\n}\n\n.hero-actions {\n  display: flex;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n/* SECTIONS */\n.section {\n  padding: 18px 14px 22px 14px;\n  max-width: 1100px;\n  margin: 0 auto;\n}\n\n.section-head {\n  display: flex;\n  align-items: end;\n  justify-content: space-between;\n  gap: 16px;\n  flex-wrap: wrap;\n  margin-bottom: 14px;\n}\n\nh2 { margin: 0; font-size: 22px; }\n\n.section-sub {\n  margin: 6px 0 0 0;\n  color: #c8d2f0;\n  font-size: 14px;\n}\n\n.muted { color: var(--muted); }\n\n.muted-section {\n  opacity: 0.92;\n  border: 1px dashed rgba(255,255,255,0.12);\n  border-radius: 18px;\n  margin-top: 12px;\n  margin-bottom: 12px;\n}\n\n/* FILTERS (polished look) */\n.filters {\n  display: flex;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.filter-btn {\n  border: 1px solid rgba(255,255,255,0.14);\n  background: rgba(255,255,255,0.06);\n  color: var(--text);\n  padding: 10px 12px;\n  border-radius: 999px;\n  font-size: 13px;\n  cursor: pointer;\n}\n\n.filter-btn:hover {\n  background: rgba(255,255,255,0.10);\n}\n\n.filter-btn.active {\n  background: linear-gradient(180deg, var(--primary), var(--primary-2));\n  border-color: rgba(255,255,255,0.20);\n}\n\n/* CARDS */\n.cards {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 14px;\n}\n\n.card {\n  background: rgba(17, 26, 44, 0.65);\n  border: 1px solid rgba(255,255,255,0.12);\n  border-radius: 18px;\n  overflow: hidden;\n}\n\n/* slightly shorter images so 9 cards doesn't become a scroll-marathon */\n.card img {\n  width: 100%;\n  height: 165px;\n  object-fit: cover;\n  display: block;\n}\n\n.card-body {\n  padding: 12px 12px 14px 12px;\n}\n\n.card-top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n}\n\n.card h3 {\n  margin: 0;\n  font-size: 18px;\n}\n\n.pill {\n  font-size: 12px;\n  padding: 6px 10px;\n  border-radius: 999px;\n  border: 1px solid rgba(255,255,255,0.14);\n  background: rgba(255,255,255,0.06);\n  color: #dbe6ff;\n  white-space: nowrap;\n}\n\n.meta {\n  margin: 8px 0 8px 0;\n  color: #c8d2f0;\n  font-size: 13px;\n}\n\n.meta-list {\n  margin: 10px 0 10px 18px;\n  padding: 0;\n  color: #c8d2f0;\n  font-size: 13px;\n}\n\n.badges {\n  display: flex;\n  gap: 8px;\n  flex-wrap: wrap;\n  margin: 8px 0 10px 0;\n}\n\n.badge {\n  font-size: 12px;\n  padding: 6px 10px;\n  border-radius: 999px;\n  border: 1px solid rgba(255,255,255,0.12);\n  background: rgba(255,255,255,0.05);\n}\n\n.badge.ok { border-color: rgba(59,130,246,0.5); }\n.badge.meh { border-color: rgba(255,255,255,0.16); color: #b8c3e7; }\n\n.desc {\n  margin: 0 0 12px 0;\n  color: #dbe6ff;\n  font-size: 13px;\n  line-height: 1.3;\n}\n\n/* subtle friction: buttons look equal weight, primary isn't super dominant */\n.card-actions {\n  display: flex;\n  gap: 10px;\n}\n\n.btn {\n  border: 1px solid rgba(255,255,255,0.14);\n  background: rgba(255,255,255,0.06);\n  color: var(--text);\n  padding: 10px 12px;\n  border-radius: 12px;\n  text-decoration: none;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  cursor: pointer;\n}\n\n.btn.small {\n  padding: 9px 10px;\n  border-radius: 12px;\n  font-size: 13px;\n}\n\n.btn.primary {\n  background: linear-gradient(180deg, var(--primary), var(--primary-2));\n  border-color: rgba(255,255,255,0.18);\n}\n\n.btn.ghost {\n  background: rgba(255,255,255,0.04);\n}\n\n.btn:disabled {\n  opacity: 0.75;\n  cursor: not-allowed;\n}\n\n/* details */\n.details {\n  margin-top: 10px;\n  padding-top: 10px;\n  border-top: 1px solid rgba(255,255,255,0.10);\n}\n\n.details-text {\n  margin: 0;\n  color: #c8d2f0;\n  font-size: 13px;\n}\n\n.hidden { display: none; }\n\n/* status area (if used) */\n.status {\n  min-height: 22px;\n  margin-top: 12px;\n  color: rgba(232, 238, 252, 0.78);\n  font-size: 13px;\n}\n\n/* contact */\n.contact-card {\n  margin-top: 10px;\n  max-width: 520px;\n  background: rgba(17, 26, 44, 0.55);\n  border: 1px solid rgba(255,255,255,0.12);\n  border-radius: 18px;\n  padding: 14px;\n}\n\n.contact-title { margin: 0 0 4px 0; font-weight: 700; }\n.contact-sub { margin: 0 0 12px 0; color: #c8d2f0; font-size: 13px; }\n.tiny { margin: 10px 0 0 0; color: rgba(168, 179, 214, 0.85); font-size: 12px; }\n\n.footer {\n  border-top: 1px solid rgba(255,255,255,0.10);\n  padding: 16px 14px;\n  color: rgba(168, 179, 214, 0.9);\n  text-align: center;\n}\n\n/* Responsive */\n@media (max-width: 980px) {\n  .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n}\n\n@media (max-width: 640px) {\n  .cards { grid-template-columns: 1fr; }\n  .nav-link span { display: none; } /* polished app vibe, but also slightly annoying */\n  .hero h1 { font-size: 28px; }\n  .card img { height: 175px; } /* keep images readable on mobile */\n}",
          "folderId": "0",
          "active": false
        },
        "19": {
          "id": "19",
          "name": "script.js",
          "contents": "// Deceptive UX behaviors for Lesson 2:\n// 1) Filters LOOK stacked (multiple appear active) but LOGIC is single-filter.\n// 2) Adopt button gives ambiguous feedback (no real confirmation).\n// 3) Details toggles add click-work.\n// 4) Nav annoyance: \"Dogs\" scroll lands slightly off.\n\nconst filterButtons = Array.from(document.querySelectorAll(\".filter-btn\"));\n\n// IMPORTANT: only filter DOG cards (cats shouldn't disappear)\nconst dogCards = Array.from(document.querySelectorAll(\"#dogs .card\"));\n\nconst adoptButtons = Array.from(document.querySelectorAll(\".adopt-btn\"));\nconst detailsButtons = Array.from(document.querySelectorAll(\".details-btn\"));\n\nlet currentFilter = null;\n\n// --- Helper: apply ONLY ONE filter at a time (even if multiple buttons look active) ---\nfunction applyFilter(filterName) {\n  currentFilter = filterName;\n\n  dogCards.forEach((card) => {\n    const isMatch =\n      filterName === null || card.dataset[filterName] === \"true\"; // data-small / data-kids / data-under2\n    card.style.display = isMatch ? \"\" : \"none\";\n  });\n}\n\n// --- Filters: buttons can LOOK active together, but filter logic replaces silently ---\nfilterButtons.forEach((btn) => {\n  btn.addEventListener(\"click\", () => {\n    const filterName = btn.dataset.filter;\n\n    // Visual lie: toggle active class on THIS button only (others stay active too).\n    btn.classList.toggle(\"active\");\n\n    // Logic truth: replace currentFilter with the last clicked filter.\n    // Slight extra frustration: clicking the currently-active filter doesn't reliably \"clear\" results.\n    const shouldClear = currentFilter === filterName && Math.random() < 0.25;\n    applyFilter(shouldClear ? null : filterName);\n\n    // Mild disorientation: sometimes nudge scroll a bit\n    if (Math.random() < 0.35) {\n      window.scrollBy(0, -40);\n    }\n  });\n});\n\n// --- Details toggles: adds click work to find info ---\ndetailsButtons.forEach((btn) => {\n  btn.addEventListener(\"click\", () => {\n    const card = btn.closest(\".card\");\n    const details = card.querySelector(\".details\");\n    if (!details) return;\n    details.classList.toggle(\"hidden\");\n    // No label change on purpose (slightly annoying)\n  });\n});\n\n// --- Adopt buttons: ambiguous feedback ---\nadoptButtons.forEach((btn) => {\n  btn.addEventListener(\"click\", () => {\n    btn.textContent = \"Submitted\";\n    btn.disabled = true;\n\n    // Feels like it did something, but doesn't clarify next step\n    if (Math.random() < 0.5) {\n      const contact = document.getElementById(\"contact\");\n      if (contact) contact.scrollIntoView({ behavior: \"smooth\" });\n    }\n  });\n});\n\n// --- Nav annoyance: \"Dogs\" anchor lands slightly off ---\nconst dogsLink = document.querySelector('a[href=\"#dogs\"]');\nif (dogsLink) {\n  dogsLink.addEventListener(\"click\", (e) => {\n    e.preventDefault();\n    const dogsSection = document.getElementById(\"dogs\");\n    if (!dogsSection) return;\n    const y = dogsSection.getBoundingClientRect().top + window.scrollY - 120; // slightly too high\n    window.scrollTo({ top: y, behavior: \"smooth\" });\n  });\n}\n\n// Contact CTA: looks helpful but doesn't really progress\nconst contactStart = document.getElementById(\"contactStart\");\nif (contactStart) {\n  contactStart.addEventListener(\"click\", () => {\n    // do nothing visible on purpose\n  });\n}",
          "folderId": "0",
          "active": true
        },
