      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Paws & Friends Adoption</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n\n  <body>\n    <nav class=\"nav\">\n      <div class=\"nav-left\">\n        <span class=\"brand\">Paws & Friends</span>\n      </div>\n\n      <div class=\"nav-links\" aria-label=\"Primary\">\n        <a class=\"nav-link\" href=\"#home\">\n          <img src=\"assets/home.png\" alt=\"\" />\n          <span>Home</span>\n        </a>\n        <a class=\"nav-link\" href=\"#dogs\">\n          <img src=\"assets/dogs.png\" alt=\"\" />\n          <span>Dogs</span>\n        </a>\n        <a class=\"nav-link\" href=\"#cats\">\n          <img src=\"assets/cats.png\" alt=\"\" />\n          <span>Cats</span>\n        </a>\n        <a class=\"nav-link\" href=\"#small-pets\">\n          <img src=\"assets/small-pets.png\" alt=\"\" />\n          <span>Small Pets</span>\n        </a>\n        <a class=\"nav-link\" href=\"#contact\">\n          <img src=\"assets/contact.png\" alt=\"\" />\n          <span>Contact</span>\n        </a>\n      </div>\n    </nav>\n\n    <header id=\"home\" class=\"hero\">\n      <div class=\"hero-content\">\n        <p class=\"hero-eyebrow\">Adopt • Foster • Volunteer</p>\n        <h1>Find your next best friend.</h1>\n        <p class=\"hero-sub\">Browse adoptable pets and start an application in minutes.</p>\n        <div class=\"hero-actions\">\n          <a class=\"btn primary\" href=\"#dogs\">Browse Dogs</a>\n          <a class=\"btn ghost\" href=\"#contact\">Contact</a>\n        </div>\n      </div>\n    </header>\n\n    <main>\n      <section id=\"dogs\" class=\"section\">\n        <div class=\"section-head\">\n          <div>\n            <h2>Dogs Available</h2>\n          </div>\n\n          <!-- Polished-looking filters -->\n          <div class=\"filters\" aria-label=\"Filters\">\n            <button class=\"filter-btn\" data-filter=\"small\" type=\"button\">Small</button>\n            <button class=\"filter-btn\" data-filter=\"kids\" type=\"button\">Good with Kids</button>\n            <button class=\"filter-btn\" data-filter=\"under2\" type=\"button\">Under 2</button>\n          </div>\n        </div>\n\n        <!-- No results count on purpose -->\n        <div class=\"cards\" aria-label=\"Dog cards\">\n          <!-- Card 1 -->\n          <article\n            class=\"card\"\n            data-small=\"true\"\n            data-kids=\"true\"\n            data-under2=\"false\"\n          >\n            <img src=\"assets/adopt-dog-1.jpg\" alt=\"Milo, a dog available for adoption\" />\n            <div class=\"card-body\">\n              <div class=\"card-top\">\n                <h3>Milo</h3>\n                <span class=\"pill\">Small</span>\n              </div>\n\n              <!-- Inconsistency: short tidy meta -->\n              <p class=\"meta\">Age: 2 years • Temperament: calm</p>\n\n              <div class=\"badges\">\n                <span class=\"badge ok\">Good w/ kids</span>\n                <span class=\"badge meh\">Low shed?</span>\n              </div>\n\n              <p class=\"desc\">\n                Milo loves short walks and quiet evenings. He’s friendly and does well with children.\n              </p>\n\n              <div class=\"card-actions\">\n                <button class=\"btn small primary adopt-btn\" type=\"button\">Adopt</button>\n                <button class=\"btn small ghost details-btn\" type=\"button\">Details</button>\n              </div>\n\n              <div class=\"details hidden\">\n                <p class=\"details-text\">\n                  Notes: calm indoors • Enjoys routines • Has lived with children before\n                </p>\n              </div>\n            </div>\n          </article>\n\n          <!-- Card 2 -->\n          <article\n            class=\"card\"\n            data-small=\"false\"\n            data-kids=\"true\"\n            data-under2=\"true\"\n          >\n            <img src=\"assets/adopt-dog-2.jpg\" alt=\"Luna, a dog available for adoption\" />\n            <div class=\"card-body\">\n              <div class=\"card-top\">\n                <h3>Luna</h3>\n                <!-- Inconsistency: size as weight -->\n                <span class=\"pill\">22 lbs</span>\n              </div>\n\n              <!-- Inconsistency: different meta style + order -->\n              <ul class=\"meta-list\">\n                <li>Young</li>\n                <li>High energy</li>\n                <li>Kid-friendly</li>\n              </ul>\n\n              <!-- Inconsistency: kids info only implied here -->\n              <p class=\"desc\">\n                Luna is playful and loves people. Great fit if you like an active companion.\n              </p>\n\n              <div class=\"card-actions\">\n                <button class=\"btn small primary adopt-btn\" type=\"button\">Adopt</button>\n                <button class=\"btn small ghost details-btn\" type=\"button\">Details</button>\n              </div>\n  \n              <div class=\"details hidden\">\n                <p class=\"details-text\">\n                  Notes: high energy • Learns fast • Has done well around kids in foster care\n                </p>\n              </div>\n            </div>\n          </article>\n\n          <!-- Card 3 -->\n          <article\n            class=\"card\"\n            data-small=\"true\"\n            data-kids=\"false\"\n            data-under2=\"true\"\n          >\n            <img src=\"assets/adopt-dog-3.jpg\" alt=\"Pepper, a dog available for adoption\" />\n            <div class=\"card-body\">\n              <div class=\"card-top\">\n                <h3>Pepper</h3>\n                <!-- Inconsistency: vague size label -->\n                <span class=\"pill\">Compact</span>\n              </div>\n\n              <!-- Inconsistency: missing obvious “kids” label on the surface -->\n              <p class=\"meta\">\n                Age: 1 • Traits: curious, bold, learns fast\n              </p>\n\n              <p class=\"desc\">\n                Pepper is energetic and loves attention. Very smart and eager to learn new tricks.\n              </p>\n\n              <div class=\"card-actions\">\n                <button class=\"btn small primary adopt-btn\" type=\"button\">Adopt</button>\n                <button class=\"btn small ghost details-btn\" type=\"button\">Details</button>\n              </div>\n\n              <div class=\"details hidden\">\n                <p class=\"details-text\">\n                  Notes: very curious • Working on leash manners • Best with confident handlers\n                </p>\n              </div>\n            </div>\n          </article>\n        </div>\n        \n      </section>\n\n      <section id=\"cats\" class=\"section muted-section\">\n        <h2>Cats</h2>\n        <p class=\"muted\">Cats are currently being updated. Check back soon.</p>\n      </section>\n\n      <section id=\"small-pets\" class=\"section muted-section\">\n        <h2>Small Pets</h2>\n        <p class=\"muted\">Small pets are currently being updated. Check back soon.</p>\n      </section>\n\n      <section id=\"contact\" class=\"section contact\">\n        <h2>Contact</h2>\n        <p class=\"muted\">\n          Questions? Email the shelter. Adoption appointments available weekdays.\n        </p>\n\n        <!-- Deceptive: looks like the next step, but doesn't actually help -->\n        <div class=\"contact-card\">\n          <p class=\"contact-title\">Start Adoption</p>\n          <p class=\"contact-sub\">We’ll get back to you in 1–3 business days.</p>\n          <button id=\"contactStart\" class=\"btn primary\" type=\"button\">Start Adoption Process</button>\n          <p class=\"tiny\">\n            Tip: If you already picked a dog, click “Adopt” on their card first.\n          </p>\n        </div>\n      </section>\n    </main>\n\n    <footer class=\"footer\">\n      <p class=\"footer-text\">© Paws & Friends Shelter • Hours vary</p>\n    </footer>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
