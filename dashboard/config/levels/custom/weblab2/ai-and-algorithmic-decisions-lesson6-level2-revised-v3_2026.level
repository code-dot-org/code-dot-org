        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Function Machine</title>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <link rel=\"stylesheet\" href=\"./style.css\">\n</head>\n<body>\n\n  <main class=\"container\">\n\n    <h1>Function Machine</h1>\n    <p class=\"subtitle\">Run a function, then unlock customization.</p>\n\n    <img id=\"machineImage\" src=\"images/basic-machine.png\" alt=\"Function Machine\">\n\n    <!-- Function Selector -->\n    <div class=\"controls\">\n      <label for=\"functionSelect\">Choose a function:</label>\n      <select id=\"functionSelect\">\n        <option value=\"pizza\">Make Pizza</option>\n        <option value=\"shirt\">Make Shirt</option>\n      </select>\n    </div>\n\n    <!-- Buttons -->\n    <div class=\"buttonRow\">\n      <button id=\"runButton\">Run Function</button>\n      <button id=\"unlockButton\">Unlock Customization</button>\n    </div>\n\n    <!-- Parameters -->\n    <div id=\"parameterArea\" class=\"hidden\">\n\n      <!-- Pizza Controls -->\n      <div id=\"pizzaControls\">\n        <div class=\"controls\">\n          <label for=\"pizzaTopping\">Choose a topping:</label>\n          <select id=\"pizzaTopping\">\n            <option value=\"cheese\">Cheese</option>\n            <option value=\"pepperoni\">Pepperoni</option>\n          </select>\n        </div>\n\n        <div class=\"controls\">\n          <label for=\"pizzaQuantity\">Quantity:</label>\n          <input id=\"pizzaQuantity\" type=\"number\" min=\"1\" value=\"1\">\n        </div>\n      </div>\n\n      <!-- Shirt Controls -->\n      <div id=\"shirtControls\" class=\"hidden\">\n        <div class=\"controls\">\n          <label for=\"shirtColor\">Choose a color:</label>\n          <select id=\"shirtColor\">\n            <option value=\"white\">White</option>\n            <option value=\"red\">Red</option>\n          </select>\n        </div>\n      </div>\n\n    </div>\n\n    <!-- Output -->\n    <div id=\"outputArea\" class=\"textArea\">\n      Click \"Run Function\" to begin.\n    </div>\n\n    <img id=\"resultImage\" src=\"images/cheese-pizza.png\" alt=\"Result\">\n\n  </main>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
