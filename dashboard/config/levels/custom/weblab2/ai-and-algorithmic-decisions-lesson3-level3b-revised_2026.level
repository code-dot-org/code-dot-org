      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Fitness Tracker</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <header class=\"topbar\">\n    <div>\n      <p class=\"eyebrow\">Daily Fitness Dashboard</p>\n      <h1 id=\"userNameDisplay\">Alex</h1>\n      <p class=\"planText\">Plan: <span id=\"planDisplay\">Beginner</span></p>\n    </div>\n\n    <div class=\"hintBox\">\n      <h2>Goal</h2>\n      <p>Track your progress as your workout stats change during the day.</p>\n    </div>\n  </header>\n\n  <main class=\"layout\">\n    <section class=\"statsStrip\">\n      <div class=\"statPanel\">\n        <div class=\"statHeader\">\n          <div class=\"iconWrap\">\n            <img src=\"images/steps-icon.png\" alt=\"Steps icon\" class=\"statIcon\">\n          </div>\n          <p class=\"statLabel\">Steps</p>\n        </div>\n\n        <p class=\"statValue\" id=\"stepsDisplay\">2000</p>\n        <p class=\"statHint\">Walk should add steps. Run should add a larger amount. Stretch should add a smaller amount.</p>\n      </div>\n\n      <div class=\"statPanel\">\n        <div class=\"statHeader\">\n          <div class=\"iconWrap\">\n            <img src=\"images/water-icon.png\" alt=\"Water icon\" class=\"statIcon\">\n          </div>\n          <p class=\"statLabel\">Water Glasses</p>\n        </div>\n\n        <p class=\"statValue\" id=\"waterDisplay\">3</p>\n        <p class=\"statHint\">Drink Water should increase this value.</p>\n      </div>\n\n      <div class=\"statPanel\">\n        <div class=\"statHeader\">\n          <div class=\"iconWrap\">\n            <img src=\"images/streak-icon.png\" alt=\"Workout streak icon\" class=\"statIcon\">\n          </div>\n          <p class=\"statLabel\">Workout Streak</p>\n        </div>\n\n        <p class=\"statValue\" id=\"streakDisplay\">5</p>\n        <p class=\"statHint\">Complete Workout should increase your streak by 1.</p>\n      </div>\n    </section>\n\n    <section class=\"actionsArea\">\n      <div class=\"actionGroup\">\n        <h2>Movement</h2>\n        <div class=\"buttonRow\">\n          <button id=\"walkButton\">Walk</button>\n          <button id=\"runButton\">Run</button>\n          <button id=\"stretchButton\">Stretch</button>\n        </div>\n      </div>\n\n      <div class=\"actionGroup\">\n        <h2>Habits</h2>\n        <div class=\"buttonRow\">\n          <button id=\"drinkButton\">Drink Water</button>\n          <button id=\"workoutButton\">Complete Workout</button>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n  font-family: Arial, sans-serif;\n}\n\nbody {\n  background: #eef4f8;\n  color: #1f2a33;\n  min-height: 100vh;\n}\n\n.topbar {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: 20px;\n  padding: 28px;\n  background: #1f3c88;\n  color: white;\n}\n\n.eyebrow {\n  font-size: 0.85rem;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  opacity: 0.85;\n  margin-bottom: 8px;\n}\n\n.topbar h1 {\n  font-size: 2.1rem;\n  margin-bottom: 8px;\n}\n\n.planText {\n  font-size: 1rem;\n}\n\n.hintBox {\n  max-width: 320px;\n  background: rgba(255, 255, 255, 0.14);\n  border: 2px solid rgba(255, 255, 255, 0.18);\n  border-radius: 14px;\n  padding: 16px;\n}\n\n.hintBox h2 {\n  font-size: 1rem;\n  margin-bottom: 8px;\n}\n\n.layout {\n  max-width: 1050px;\n  margin: 0 auto;\n  padding: 24px;\n  display: grid;\n  gap: 24px;\n}\n\n.statsStrip {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 18px;\n}\n\n.statPanel {\n  background: white;\n  border-radius: 18px;\n  padding: 20px;\n  border-top: 8px solid #4da3ff;\n  box-shadow: 0 6px 18px rgba(31, 42, 51, 0.08);\n}\n\n.statHeader {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 14px;\n}\n\n.iconWrap {\n  width: 46px;\n  height: 46px;\n  border-radius: 12px;\n  background: #f3f7fb;\n  border: 2px solid #d7e4f2;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.statIcon {\n  width: 26px;\n  height: 26px;\n  object-fit: contain;\n}\n\n.statLabel {\n  font-size: 0.95rem;\n  color: #5d6b78;\n  font-weight: bold;\n}\n\n.statValue {\n  font-size: 2.6rem;\n  font-weight: bold;\n  margin-bottom: 12px;\n}\n\n.statHint {\n  font-size: 0.92rem;\n  color: #4f5f6d;\n  line-height: 1.4;\n}\n\n.actionsArea {\n  background: white;\n  border-radius: 18px;\n  padding: 24px;\n  box-shadow: 0 6px 18px rgba(31, 42, 51, 0.08);\n  display: grid;\n  gap: 22px;\n}\n\n.actionGroup h2 {\n  margin-bottom: 12px;\n  font-size: 1.1rem;\n}\n\n.buttonRow {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n\nbutton {\n  border: none;\n  border-radius: 12px;\n  padding: 12px 18px;\n  font-size: 1rem;\n  font-weight: bold;\n  cursor: pointer;\n  background: #1f3c88;\n  color: white;\n  transition: opacity 0.15s ease, transform 0.15s ease;\n}\n\nbutton:hover {\n  opacity: 0.92;\n}\n\nbutton:active {\n  transform: translateY(1px);\n}\n\n@media (max-width: 800px) {\n  .topbar {\n    flex-direction: column;\n  }\n\n  .statsStrip {\n    grid-template-columns: 1fr;\n  }\n\n  .hintBox {\n    max-width: 100%;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "// Starting state\nlet steps = 2000;\nconst water = 3;\nlet streak = \"5\";\n\nlet userName = \"Alex\";\nlet plan = \"Beginner\";\n\n// Page elements\nconst stepsDisplay = document.getElementById(\"stepsDisplay\");\nconst waterDisplay = document.getElementById(\"waterDisplay\");\nconst streakDisplay = document.getElementById(\"streakDisplay\");\n\nconst userNameDisplay = document.getElementById(\"userNameDisplay\");\nconst planDisplay = document.getElementById(\"planDisplay\");\n\nconst walkButton = document.getElementById(\"walkButton\");\nconst runButton = document.getElementById(\"runButton\");\nconst stretchButton = document.getElementById(\"stretchButton\");\nconst drinkButton = document.getElementById(\"drinkButton\");\nconst workoutButton = document.getElementById(\"workoutButton\");\n\n// Update the screen\nfunction updateScreen() {\n  stepsDisplay.textContent = steps;\n  waterDisplay.textContent = water;\n  streakDisplay.textContent = streak;\n\n  userNameDisplay.textContent = \"userName\";\n  planDisplay.textContent = plan;\n}\n\n// Movement buttons\nwalkButton.addEventListener(\"click\", function () {\n  steps = steps + 1000;\n  updateScreen();\n});\n\nrunButton.addEventListener(\"click\", function () {\n  steps = steps - 2000;\n  updateScreen();\n});\n\nstretchButton.addEventListener(\"click\", function () {\n  steps = 500;\n  updateScreen();\n});\n\n// Habit buttons\ndrinkButton.addEventListener(\"click\", function () {\n  water = water + 1;\n  updateScreen();\n});\n\nworkoutButton.addEventListener(\"click\", function () {\n  streak = streak + 1;\n  updateScreen();\n});\n\n// Show starting state\nupdateScreen();",
          "folderId": "0",
          "active": false
        },
        "11": {
