        "9": {
          "id": "9",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Hamilton Township Improvement Project</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"sounds.js\" defer></script>\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"app\">\n    <header class=\"app-header\">\n      <h1 class=\"app-title\">Hamilton Township Improvement Project</h1>\n    </header>\n\n    <noscript><p class=\"notice\">This app needs JavaScript to run.</p></noscript>\n    <p id=\"app-error\" class=\"notice\" hidden>Something went wrong loading this app. Please refresh the page.</p>\n\n    <section id=\"screen-home\" class=\"screen\" aria-labelledby=\"home-heading\">\n      <div class=\"intro\">\n        <h2 id=\"home-heading\" tabindex=\"-1\">Flower baskets</h2>\n        <p>Here in beautiful, sunny Hamilton our residents are working hard to add beauty to our city streets. The current plan approved by the town committee involves placing baskets of flowers on all street lamp posts located on Main and Cross streets from May through October.</p>\n      </div>\n\n      <div class=\"color-picker\">\n        <div class=\"color-controls\" role=\"group\" aria-label=\"Flower color\">\n          <div id=\"swatch\" class=\"swatch\" data-color=\"red\"></div>\n          <p id=\"swatch-caption\" class=\"swatch-caption\" role=\"status\" aria-live=\"polite\">The flowers are red.</p>\n          <button type=\"button\" class=\"color-button\" data-color=\"red\" data-sound=\"sound-red.wav\" data-message=\"The flowers are red.\" aria-pressed=\"true\">Red</button>\n          <button type=\"button\" class=\"color-button\" data-color=\"blue\" data-sound=\"sound-blue.wav\" data-message=\"The flowers are blue.\" aria-pressed=\"false\">Blue</button>\n          <button type=\"button\" class=\"color-button\" data-color=\"purple\" data-sound=\"sound-purple.wav\" data-message=\"The flowers are purple.\" aria-pressed=\"false\">Purple</button>\n        </div>\n        <div class=\"color-hint\">\n          <img class=\"hint-image\" src=\"flowers.jpg\" width=\"500\" height=\"519\" alt=\"A basket of flowers hanging from a lamp post hook\">\n          <p>Click to see the different color options for the flowers</p>\n        </div>\n      </div>\n\n      <div class=\"screen-actions\">\n        <button type=\"button\" class=\"primary-button\" data-go=\"screen-trash\">Next</button>\n      </div>\n    </section>\n\n    <section id=\"screen-trash\" class=\"screen\" aria-labelledby=\"trash-heading\" hidden>\n      <h2 id=\"trash-heading\" tabindex=\"-1\">Keep our town clean</h2>\n      <p>Making our town more beautiful starts with each and every one of our residents taking pride in their surroundings. If you see trash, pick it up and throw it away. If you see a can or a bottle that can be recycled, please make the effort to place that item in the recycling bins we have placed around town. Click below to make sure you know where to place any trash you find on the streets.</p>\n\n      <div class=\"picture-row\">\n        <button type=\"button\" class=\"picture-button\" data-message=\"Recycling Bin: Put in here any items that can be recycled.\">\n          <img class=\"picture-image\" src=\"recycle.jpg\" width=\"500\" height=\"752\" alt=\"A green recycling bin with a recycling symbol\">\n        </button>\n        <button type=\"button\" class=\"picture-button\" data-sound=\"sound-power-down.wav\" data-message=\"New flower baskets: No trash belongs here!\">\n          <img class=\"picture-image\" src=\"flowers-screen2.jpg\" width=\"500\" height=\"524\" alt=\"A basket of red flowers\">\n        </button>\n        <button type=\"button\" class=\"picture-button\" data-message=\"Trash Can: Throw away all trash in the blue bins.\">\n          <img class=\"picture-image\" src=\"trash.jpg\" width=\"500\" height=\"727\" alt=\"A blue mesh trash can\">\n        </button>\n      </div>\n\n      <p id=\"picture-info\" class=\"picture-info\" role=\"status\" aria-live=\"polite\">Click on one of the pictures</p>\n\n      <div class=\"screen-actions\">\n        <button type=\"button\" class=\"primary-button\" data-go=\"screen-garden\">Next</button>\n      </div>\n    </section>\n\n    <section id=\"screen-garden\" class=\"screen\" aria-labelledby=\"garden-heading\" hidden>\n      <h2 id=\"garden-heading\" tabindex=\"-1\">Community garden</h2>\n      <p>The town is also working on improving the quality of life for the residents with a community garden. If you are interested in volunteering to help weed, plant, or harvest, please stop by the town office.</p>\n      <img class=\"garden-image\" src=\"vines.jpg\" width=\"984\" height=\"500\" alt=\"A sketch of six climbing vines tied to a trellis\">\n      <div class=\"screen-actions\">\n        <button type=\"button\" class=\"primary-button\" data-go=\"screen-home\">Home</button>\n      </div>\n    </section>\n  </main>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "10": {
          "id": "10",
          "name": "script.js",
          "contents": "const byId = (id) => document.getElementById(id);\n\nconst soundUrls = {};\n\nfunction getSoundUrl(name) {\n  if (!soundUrls[name]) {\n    const sound = soundData[name];\n    const bytes = Uint8Array.from(atob(sound.data), (character) => character.charCodeAt(0));\n    soundUrls[name] = URL.createObjectURL(new Blob([bytes], { type: sound.type }));\n  }\n  return soundUrls[name];\n}\n\nfunction playSound(button) {\n  if (!button.dataset.sound) {\n    return;\n  }\n  try {\n    const playback = new Audio(getSoundUrl(button.dataset.sound)).play();\n    if (playback && typeof playback.catch === 'function') {\n      playback.catch(() => {});\n    }\n  } catch (error) {\n    // Sound is optional: the text on screen carries the same feedback.\n  }\n}\n\nfunction showScreen(screenId) {\n  document.querySelectorAll('.screen').forEach((screen) => {\n    screen.hidden = screen.id !== screenId;\n  });\n  window.scrollTo(0, 0);\n  byId(screenId).querySelector('h2').focus();\n}\n\nfunction chooseColor(button) {\n  document.querySelectorAll('.color-button').forEach((other) => {\n    other.setAttribute('aria-pressed', String(other === button));\n  });\n  byId('swatch').dataset.color = button.dataset.color;\n  byId('swatch-caption').textContent = button.dataset.message;\n  playSound(button);\n}\n\nfunction showPictureInfo(button) {\n  byId('picture-info').textContent = button.dataset.message;\n  playSound(button);\n}\n\nfunction init() {\n  document.querySelectorAll('[data-go]').forEach((button) => {\n    button.addEventListener('click', () => showScreen(button.dataset.go));\n  });\n  document.querySelectorAll('.color-button').forEach((button) => {\n    button.addEventListener('click', () => chooseColor(button));\n  });\n  document.querySelectorAll('.picture-button').forEach((button) => {\n    button.addEventListener('click', () => showPictureInfo(button));\n  });\n}\n\ntry {\n  init();\n} catch (error) {\n  byId('app-error').hidden = false;\n  document.querySelectorAll('.screen').forEach((screen) => {\n    screen.hidden = true;\n  });\n}\n",
          "folderId": "0",
          "active": true
        },
        "11": {
          "id": "11",
          "name": "sounds.js",
          "contents": "const soundData = {\n  'sound-blue.wav': { type: 'audio/wav', data: '' },\n  'sound-power-down.wav': { type: 'audio/wav', data: '' },\n  'sound-purple.wav': { type: 'audio/wav', data: '' },\n  'sound-red.wav': { type: 'audio/wav', data: '' }\n};\n",
