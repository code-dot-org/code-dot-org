        "2": {
          "id": "2",
          "name": "style.css",
          "contents": ":root {\n  --indigo: #3743c4;\n  --indigo-dark: #2a3399;\n  --indigo-tint: #e8eafc;\n  --ink: #1c2233;\n  --muted: #3f4a5e;\n  --surface: #ffffff;\n  --page: #eef1f6;\n  --tan: #efdecc;\n  --border: #7a869c;\n  --warn-bg: #fdecec;\n  --warn-ink: #7f1d1d;\n  --radius: 0.75rem;\n}\n\n[hidden] {\n  display: none !important;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  display: flex;\n  justify-content: center;\n  align-items: flex-start;\n  padding: 1rem;\n  background: var(--page);\n  color: var(--ink);\n  font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif;\n  font-size: 1rem;\n  line-height: 1.45;\n}\n\n.app {\n  width: 100%;\n  max-width: 28rem;\n  min-height: 36rem;\n  display: flex;\n  flex-direction: column;\n  background: var(--surface);\n  border-radius: 1.5rem;\n  box-shadow: 0 8px 24px rgba(28, 34, 51, 0.18);\n  overflow: hidden;\n}\n\n.app-header {\n  padding: 1rem 1.25rem;\n  background: var(--indigo);\n  color: #ffffff;\n}\n\n.app-title {\n  margin: 0;\n  font-size: 1.25rem;\n  line-height: 1.2;\n}\n\n.notice {\n  margin: 1rem 1.25rem 0;\n  padding: 0.75rem 1rem;\n  border-radius: var(--radius);\n  background: var(--warn-bg);\n  color: var(--warn-ink);\n  font-weight: 600;\n}\n\n.screen {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n  padding: 1.25rem;\n}\n\n.screen h2 {\n  margin: 0;\n  font-size: 1.375rem;\n  line-height: 1.25;\n}\n\n.screen h2:focus {\n  outline: none;\n}\n\n.screen p {\n  margin: 0;\n}\n\n.intro {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  margin: -1.25rem -1.25rem 0;\n  padding: 1.25rem;\n  background: var(--tan);\n}\n\n.color-picker {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 1.25rem;\n}\n\n.color-controls {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  flex: 1 1 8rem;\n}\n\n.swatch {\n  width: 100%;\n  height: 6rem;\n  border: 2px solid var(--ink);\n  border-radius: var(--radius);\n}\n\n.swatch[data-color=\"red\"] {\n  background: #d62020;\n}\n\n.swatch[data-color=\"blue\"] {\n  background: #1d4ed8;\n}\n\n.swatch[data-color=\"purple\"] {\n  background: #7e22ce;\n}\n\n.swatch-caption {\n  font-weight: 700;\n}\n\n.color-button {\n  min-height: 2.75rem;\n  padding: 0.5rem 1rem;\n  border: 2px solid var(--indigo);\n  border-radius: var(--radius);\n  background: var(--surface);\n  color: var(--indigo-dark);\n  font: inherit;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.color-button:hover {\n  background: var(--indigo-tint);\n}\n\n.color-button[aria-pressed=\"true\"] {\n  background: var(--indigo);\n  color: #ffffff;\n  font-weight: 700;\n}\n\n.color-hint {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.5rem;\n  flex: 1 1 8rem;\n  text-align: center;\n}\n\n.hint-image {\n  width: 100%;\n  max-width: 7rem;\n  height: auto;\n}\n\n.picture-row {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 0.75rem;\n  align-items: end;\n}\n\n.picture-button {\n  display: flex;\n  align-items: flex-end;\n  justify-content: center;\n  min-height: 2.75rem;\n  padding: 0.5rem;\n  border: 2px solid var(--border);\n  border-radius: var(--radius);\n  background: var(--surface);\n  cursor: pointer;\n}\n\n.picture-button:hover {\n  background: var(--indigo-tint);\n}\n\n.picture-image {\n  width: 100%;\n  height: auto;\n}\n\n.picture-info {\n  min-height: 3.5rem;\n  padding: 0.75rem 1rem;\n  border-inline-start: 4px solid var(--indigo);\n  border-radius: 0.375rem;\n  background: var(--indigo-tint);\n  font-weight: 600;\n}\n\n.garden-image {\n  display: block;\n  width: 100%;\n  height: auto;\n}\n\n.screen-actions {\n  display: flex;\n  justify-content: center;\n  margin-top: auto;\n  padding-top: 0.5rem;\n}\n\n.primary-button {\n  min-width: 8rem;\n  min-height: 2.75rem;\n  padding: 0.5rem 1.5rem;\n  border: 2px solid var(--indigo);\n  border-radius: var(--radius);\n  background: var(--indigo);\n  color: #ffffff;\n  font: inherit;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n.primary-button:hover {\n  background: var(--indigo-dark);\n  border-color: var(--indigo-dark);\n}\n\n.primary-button:focus-visible,\n.color-button:focus-visible,\n.picture-button:focus-visible {\n  outline: 3px solid var(--indigo);\n  outline-offset: 2px;\n}\n\n@media (max-width: 22rem) {\n  body {\n    padding: 0;\n  }\n\n  .app {\n    border-radius: 0;\n  }\n}\n",
