        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    \n    <!-- div container with a class attribute around the 10 images -->\n    <div class=\"container-1\">\n      <img src=\"one.jpg\" alt=\"one\">\n      <img src=\"two.jpg\" alt=\"two\">\n      <img src=\"three.jpg\" alt=\"three\">\n      <img src=\"four.jpg\" alt=\"four\">\n      <img src=\"five.jpg\" alt=\"five\">\n      <img src=\"six.jpg\" alt=\"six\">\n      <img src=\"seven.jpg\" alt=\"seven\">\n      <img src=\"eight.jpg\" alt=\"eight\">\n      <img src=\"nine.jpg\" alt=\"nine\">\n      <img src=\"ten.jpg\" alt=\"ten\">\n \n    </div>\n    \n    <!-- div container with a class attribute around the 10 images -->\n    <div class=\"container-2\">\n      <img src=\"one.jpg\" alt=\"one\">\n      <img src=\"two.jpg\" alt=\"two\">\n      <img src=\"three.jpg\" alt=\"three\">\n      <img src=\"four.jpg\" alt=\"four\">\n      <img src=\"five.jpg\" alt=\"five\">\n      <img src=\"six.jpg\" alt=\"six\">\n      <img src=\"seven.jpg\" alt=\"seven\">\n      <img src=\"eight.jpg\" alt=\"eight\">\n      <img src=\"nine.jpg\" alt=\"nine\">\n      <img src=\"ten.jpg\" alt=\"ten\">\n    </div>\n    \n    <!-- div container with a class attribute around the 10 images -->\n    <div class=\"container-3\">\n      <img src=\"one.jpg\" alt=\"one\">\n      <img src=\"two.jpg\" alt=\"two\">\n      <img src=\"three.jpg\" alt=\"three\">\n      <img src=\"four.jpg\" alt=\"four\">\n      <img src=\"five.jpg\" alt=\"five\">\n      <img src=\"six.jpg\" alt=\"six\">\n      <img src=\"seven.jpg\" alt=\"seven\">\n      <img src=\"eight.jpg\" alt=\"eight\">\n      <img src=\"nine.jpg\" alt=\"nine\">\n      <img src=\"ten.jpg\" alt=\"ten\">\n    </div>\n    \n    <!-- div container with a class attribute around the 10 images -->\n    <div class=\"container-4\">\n      <img src=\"one.jpg\" alt=\"one\">\n      <img src=\"two.jpg\" alt=\"two\">\n      <img src=\"three.jpg\" alt=\"three\">\n      <img src=\"four.jpg\" alt=\"four\">\n      <img src=\"five.jpg\" alt=\"five\">\n      <img src=\"six.jpg\" alt=\"six\">\n      <img src=\"seven.jpg\" alt=\"seven\">\n      <img src=\"eight.jpg\" alt=\"eight\">\n      <img src=\"nine.jpg\" alt=\"nine\">\n      <img src=\"ten.jpg\" alt=\"ten\">\n    </div>\n    \n    <!-- div container with a class attribute around the 10 images -->\n    <div class=\"container-5\">\n      <img src=\"one.jpg\" alt=\"one\">\n      <img src=\"two.jpg\" alt=\"two\">\n      <img src=\"three.jpg\" alt=\"three\">\n      <img src=\"four.jpg\" alt=\"four\">\n      <img src=\"five.jpg\" alt=\"five\">\n      <img src=\"six.jpg\" alt=\"six\">\n      <img src=\"seven.jpg\" alt=\"seven\">\n      <img src=\"eight.jpg\" alt=\"eight\">\n      <img src=\"nine.jpg\" alt=\"nine\">\n      <img src=\"ten.jpg\" alt=\"ten\">\n    </div>\n    \n    <!-- div container with a class attribute around the 10 images -->\n    <div class=\"container-6\">\n      <img src=\"one.jpg\" alt=\"one\">\n      <img src=\"two.jpg\" alt=\"two\">\n      <img src=\"three.jpg\" alt=\"three\">\n      <img src=\"four.jpg\" alt=\"four\">\n      <img src=\"five.jpg\" alt=\"five\">\n      <img src=\"six.jpg\" alt=\"six\">\n      <img src=\"seven.jpg\" alt=\"seven\">\n      <img src=\"eight.jpg\" alt=\"eight\">\n      <img src=\"nine.jpg\" alt=\"nine\">\n      <img src=\"ten.jpg\" alt=\"ten\">\n    </div>\n    \n\n    \n    \n  </body>\n</html>",
