          "contents": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>My Starter Project</title><link rel=\"stylesheet\" href=\"style.css\"></head><body><header><h1>Welcome to Your Project</h1></header><main><p>This is a simple starting point. You can change anything here!</p><button id=\"actionButton\">Get Started</button></main><script src=\"script.js\"></script></body></html>",
