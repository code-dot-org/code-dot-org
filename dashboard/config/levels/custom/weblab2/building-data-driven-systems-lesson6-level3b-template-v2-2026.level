      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Bike Rental Queue</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n\n  <body>\n    <main class=\"phone\">\n      <header class=\"app-header\">\n        <div class=\"brand-icon\">🚲</div>\n        <div>\n          <h1>Bike Rental Queue</h1>\n          <p>Manage bike rentals in the order riders checked in.</p>\n        </div>\n      </header>\n\n      <section class=\"rentals-section\">\n        <div class=\"section-header\">\n          <div class=\"section-title\">\n            <span class=\"section-icon\">📋</span>\n            <h2>Waiting Riders</h2>\n          </div>\n          <span id=\"rentalCount\" class=\"rental-count\">0 Rentals</span>\n        </div>\n\n        <div id=\"rentalList\" class=\"rental-list\"></div>\n      </section>\n\n      <section class=\"actions-section\">\n        <div class=\"section-title\">\n          <span class=\"section-icon\">⚙️</span>\n          <h2>Queue Actions</h2>\n        </div>\n\n        <div class=\"button-row\">\n          <button id=\"completeOldestButton\" class=\"action-button complete-button\">\n            <span>✓</span>\n            Start Oldest Rental\n          </button>\n\n          <button id=\"removeNewestButton\" class=\"action-button remove-button\">\n            <span>✕</span>\n            Remove Newest Rider\n          </button>\n        </div>\n\n        <div class=\"info-box\">\n          <span>ⓘ</span>\n          <p>Riders are helped from oldest check-in at the top to newest at the bottom.</p>\n        </div>\n      </section>\n    </main>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  font-family: Inter, Arial, sans-serif;\n  background: #0f172a;\n  color: #111827;\n}\n\nbutton {\n  font: inherit;\n  cursor: pointer;\n}\n\n.phone {\n  width: 100%;\n  min-height: 100vh;\n  background: #ffffff;\n}\n\n.app-header {\n  display: flex;\n  gap: 18px;\n  align-items: center;\n  padding: 44px 28px 34px;\n  background: #0f766e;\n  color: #ffffff;\n}\n\n.brand-icon {\n  width: 64px;\n  height: 64px;\n  border: 4px solid #ffffff;\n  border-radius: 16px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 32px;\n  flex-shrink: 0;\n}\n\n.app-header h1 {\n  margin: 0 0 6px;\n  font-size: 1.75rem;\n  line-height: 1.05;\n}\n\n.app-header p {\n  margin: 0;\n  font-size: 1rem;\n  opacity: 0.95;\n}\n\n.rentals-section,\n.actions-section {\n  padding: 30px 28px;\n}\n\n.section-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 22px;\n}\n\n.section-title {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.section-icon {\n  font-size: 1.8rem;\n}\n\n.section-title h2 {\n  margin: 0;\n  font-size: 1.35rem;\n}\n\n.rental-count {\n  background: #ccfbf1;\n  color: #0f766e;\n  padding: 8px 14px;\n  border-radius: 10px;\n  font-weight: 800;\n  white-space: nowrap;\n}\n\n.rental-list {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.rental-item {\n  display: grid;\n  grid-template-columns: 34px 44px 1fr auto;\n  align-items: center;\n  gap: 12px;\n  padding: 14px;\n  background: #f8fafc;\n  border: 1px solid #e5e7eb;\n  border-radius: 16px;\n}\n\n.rental-number {\n  width: 28px;\n  height: 28px;\n  border-radius: 999px;\n  background: #0f766e;\n  color: white;\n  display: grid;\n  place-items: center;\n  font-weight: 800;\n}\n\n.rental-icon {\n  font-size: 1.8rem;\n}\n\n.rental-name {\n  font-weight: 800;\n}\n\n.rental-details,\n.rental-time {\n  color: #64748b;\n  font-size: 0.9rem;\n}\n\n.actions-section {\n  background: #f8fafc;\n  border-top: 1px solid #e5e7eb;\n}\n\n.button-row {\n  display: flex;\n  gap: 12px;\n  margin: 18px 0;\n  flex-wrap: wrap;\n}\n\n.action-button {\n  border: 0;\n  border-radius: 12px;\n  padding: 12px 16px;\n  font-weight: 800;\n  color: white;\n  box-shadow: 0 6px 14px rgba(15, 23, 42, 0.12);\n}\n\n.complete-button {\n  background: #0f766e;\n}\n\n.remove-button {\n  background: #dc2626;\n}\n\n.info-box {\n  display: flex;\n  gap: 10px;\n  align-items: flex-start;\n  padding: 14px;\n  background: #ecfeff;\n  color: #155e75;\n  border-radius: 14px;\n  border: 1px solid #a5f3fc;\n}\n\n.info-box p {\n  margin: 0;\n}",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "script.js",
          "contents": "// Use rentalList in renderRentals\nconst rentalList = document.getElementById(\"rentalList\");\nconst rentalCount = document.getElementById(\"rentalCount\");\n\n// You will connect these buttons to your app in Level 4.\nconst completeOldestButton = document.getElementById(\"completeOldestButton\");\nconst removeNewestButton = document.getElementById(\"removeNewestButton\");\n\nconst rentals = [\n  {\n    icon: \"🚲\",\n    rider: \"Ava M.\",\n    bikeType: \"City Bike\",\n    station: \"Riverfront Dock\",\n    time: \"9:10 AM\"\n  },\n  {\n    icon: \"🚴\",\n    rider: \"Leo T.\",\n    bikeType: \"Road Bike\",\n    station: \"Market Square\",\n    time: \"9:18 AM\"\n  },\n  {\n    icon: \"🚲\",\n    rider: \"Nora P.\",\n    bikeType: \"E-Bike\",\n    station: \"Central Park\",\n    time: \"9:26 AM\"\n  },\n  {\n    icon: \"🚴\",\n    rider: \"Mateo R.\",\n    bikeType: \"Cargo Bike\",\n    station: \"Westside Hub\",\n    time: \"9:37 AM\"\n  }\n];\n\n// This function is already done for you.\n// Call it in renderRentals.\nconst createRentalCard = (rental, index) => {\n  return `\n    <div class=\"rental-item\">\n      <div class=\"rental-number\">${index + 1}</div>\n      <div class=\"rental-icon\">${rental.icon}</div>\n      <div>\n        <div class=\"rental-name\">${rental.rider}</div>\n        <div class=\"rental-details\">${rental.bikeType}</div>\n        <div class=\"rental-details\">${rental.station}</div>\n      </div>\n      <div class=\"rental-time\">${rental.time}</div>\n    </div>\n  `;\n};\n\n// TODO:\n// Inside renderRentals(), use .map() to render each rental.\n// Each rental should create one card using createRentalCard(rental, index).\n// Display all the cards inside rentalList.\nconst renderRentals = () => {\n\n\n\n  rentalCount.textContent = `${rentals.length} Rentals`;\n};\n\nrenderRentals();",
          "folderId": "0",
