      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Adventure Valley</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <header>\n    <h1>Adventure Valley</h1>\n  </header>\n\n  <main>\n    <section id=\"dashboardCard\">\n      <div id=\"avatarPanel\">\n        <img src=\"images/player-avatar.png\" alt=\"Player avatar\">\n      </div>\n\n      <div id=\"infoPanel\">\n        <div id=\"playerInfo\">\n          <h2 id=\"usernameDisplay\">GamerGirl</h2>\n          <p id=\"rankDisplay\">Rookie Explorer</p>\n        </div>\n\n        <div class=\"statBox\">\n          <img src=\"images/heart.png\" alt=\"Heart icon\" class=\"statIcon\">\n\n          <div class=\"statMain\">\n            <h3>Health</h3>\n            <p id=\"healthDisplay\">10</p>\n          </div>\n\n          <div class=\"statButtons statButtonsVertical\">\n            <button id=\"healthUpButton\">+5</button>\n            <button id=\"healthDownButton\">-5</button>\n          </div>\n        </div>\n\n        <div class=\"statBox\">\n          <img src=\"images/coin.png\" alt=\"Coin icon\" class=\"statIcon\">\n\n          <div class=\"statMain\">\n            <h3>Coins</h3>\n            <p id=\"coinsDisplay\">5</p>\n          </div>\n\n          <div class=\"statButtons statButtonsVertical\">\n            <button id=\"coinsUpButton\">+1</button>\n            <button id=\"coinsDownButton\">-1</button>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"sceneCard\">\n      <img src=\"images/game-scene.png\" alt=\"Game world preview\">\n    </section>\n  </main>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n  font-family: Arial, sans-serif;\n}\n\nbody {\n  background: linear-gradient(to bottom, #f6efe3, #e7dcc8);\n  color: #3e2f26;\n  min-height: 100vh;\n}\n\nheader {\n  text-align: center;\n  padding: 24px 20px 12px;\n}\n\nheader h1 {\n  font-size: 2rem;\n  color: #5a3e2b;\n  letter-spacing: 0.5px;\n}\n\nmain {\n  max-width: 820px;\n  margin: 0 auto;\n  padding: 20px;\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n\nsection {\n  background-color: #fffaf2;\n  border: 3px solid #d8c4a8;\n  border-radius: 20px;\n  padding: 20px;\n  box-shadow: 0 6px 0 rgba(120, 91, 62, 0.12);\n}\n\n#dashboardCard {\n  display: flex;\n  gap: 16px;\n  align-items: stretch;\n}\n\n#avatarPanel {\n  flex: 1.05;\n}\n\n#avatarPanel img {\n  width: 100%;\n  height: 100%;\n  min-height: 280px;\n  object-fit: cover;\n  display: block;\n  border-radius: 16px;\n  border: 3px solid #d8c4a8;\n  background-color: #f3eadb;\n}\n\n#infoPanel {\n  flex: 0.95;\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n\n#playerInfo {\n  background-color: #f8f1e7;\n  border: 2px solid #dbc8af;\n  border-radius: 16px;\n  padding: 16px;\n  text-align: center;\n}\n\n#usernameDisplay {\n  font-size: 1.6rem;\n  color: #4e382a;\n  margin-bottom: 4px;\n}\n\n#rankDisplay {\n  font-size: 1rem;\n  color: #8a6a4f;\n}\n\n.statBox {\n  background-color: #f8f1e7;\n  border: 2px solid #dbc8af;\n  border-radius: 16px;\n  padding: 14px 16px;\n  display: grid;\n  grid-template-columns: 52px 1fr auto;\n  align-items: center;\n  column-gap: 14px;\n}\n\n.statIcon {\n  width: 42px;\n  height: 42px;\n  object-fit: contain;\n  justify-self: center;\n}\n\n.statMain {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  gap: 4px;\n  min-width: 0;\n}\n\n.statMain h3 {\n  font-size: 1rem;\n  color: #7a5a3c;\n  font-weight: bold;\n  line-height: 1.1;\n}\n\n.statMain p {\n  font-size: 2.35rem;\n  font-weight: bold;\n  color: #4a3427;\n  line-height: 1;\n}\n\n.statButtons {\n  display: flex;\n  gap: 8px;\n}\n\n.statButtonsVertical {\n  flex-direction: column;\n}\n\nbutton {\n  border: none;\n  border-radius: 10px;\n  padding: 8px 12px;\n  min-width: 54px;\n  font-size: 0.9rem;\n  font-weight: bold;\n  cursor: pointer;\n  color: #fffaf2;\n  transition: transform 0.15s ease, filter 0.15s ease;\n}\n\nbutton:hover {\n  transform: translateY(-1px);\n  filter: brightness(1.05);\n}\n\nbutton:active {\n  transform: translateY(1px);\n}\n\n#healthUpButton {\n  background-color: #8fbc7a;\n}\n\n#healthDownButton {\n  background-color: #5f8a55;\n}\n\n#coinsUpButton {\n  background-color: #e3b25c;\n}\n\n#coinsDownButton {\n  background-color: #b8822f;\n}\n\n#sceneCard {\n  padding: 0;\n  overflow: hidden;\n  background-color: #f3eadb;\n}\n\n#sceneCard img {\n  width: 100%;\n  height: 320px;\n  object-fit: cover;\n  display: block;\n  border-radius: 16px;\n}\n\n@media (max-width: 700px) {\n  #dashboardCard {\n    flex-direction: column;\n  }\n\n  #avatarPanel img {\n    min-height: 220px;\n  }\n\n  .statBox {\n    grid-template-columns: 44px 1fr auto;\n    column-gap: 12px;\n  }\n\n  .statIcon {\n    width: 36px;\n    height: 36px;\n  }\n\n  .statMain p {\n    font-size: 2.1rem;\n  }\n\n  button {\n    min-width: 50px;\n    padding: 8px 10px;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "// Starting state\nlet health = 20;\nlet coins = 15;\nlet username = \"GamerGirl\";\nlet explorerType = \"Rookie\";\nlet avatarImage = \"images/player-avatar.png\";\n\n// Button effects\nlet healthIncreaseAmount = 15;\nlet healthDecreaseAmount = 5;\nlet coinsIncreaseAmount = 1;\nlet coinsDecreaseAmount = 1;\n\n// Get elements from the page\nconst healthDisplay = document.getElementById(\"healthDisplay\");\nconst coinsDisplay = document.getElementById(\"coinsDisplay\");\n\nconst usernameDisplay = document.getElementById(\"usernameDisplay\");\nconst rankDisplay = document.getElementById(\"rankDisplay\");\nconst avatar = document.querySelector(\"#avatarPanel img\");\n\nconst healthUpButton = document.getElementById(\"healthUpButton\");\nconst healthDownButton = document.getElementById(\"healthDownButton\");\nconst coinsUpButton = document.getElementById(\"coinsUpButton\");\nconst coinsDownButton = document.getElementById(\"coinsDownButton\");\n\n// Show the current state on the page\nfunction updateScreen() {\n  healthDisplay.textContent = health;\n  coinsDisplay.textContent = coins;\n  usernameDisplay.textContent = username;\n  rankDisplay.textContent = explorerType;\n  avatar.src = avatarImage;\n}\n\n// Health buttons\nhealthUpButton.addEventListener(\"click\", function() {\n  health = health + healthIncreaseAmount;\n  updateScreen();\n});\n\nhealthDownButton.addEventListener(\"click\", function() {\n  health = health - healthDecreaseAmount;\n  updateScreen();\n});\n\n// Coin buttons\ncoinsUpButton.addEventListener(\"click\", function() {\n  coins = coins + coinsIncreaseAmount;\n  updateScreen();\n});\n\ncoinsDownButton.addEventListener(\"click\", function() {\n  coins = coins - coinsDecreaseAmount;\n  updateScreen();\n});\n\n// Show starting state when the page loads\nupdateScreen();",
          "folderId": "0",
          "active": true
        },
