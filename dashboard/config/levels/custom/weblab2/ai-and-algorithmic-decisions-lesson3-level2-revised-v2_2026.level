      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Adventure Valley</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script defer src=\"script.js\"></script>\n</head>\n<body>\n  <main>\n    <div id=\"avatarPanel\">\n      <img id=\"avatar\" src=\"images/player-avatar.png\" alt=\"Player avatar\">\n    </div>\n    <div id=\"statsPanel\">\n      <h1 id=\"usernameDisplay\">GamerGirl</h1>\n      <p id=\"rankDisplay\">Rookie Explorer</p>\n      <div id=\"healthBox\">\n        <p>Health</p>\n        <p id=\"healthDisplay\">20</p>\n      </div>\n      <button id=\"healthUpButton\">+ Health</button>\n    </div>\n  </main>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n  font-family: Arial, sans-serif;\n}\nbody {\n  background: linear-gradient(to bottom, #f6efe3, #e7dcc8);\n  color: #3e2f26;\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\nmain {\n  background-color: #fffaf2;\n  border: 3px solid #d8c4a8;\n  border-radius: 20px;\n  padding: 24px;\n  box-shadow: 0 6px 0 rgba(120, 91, 62, 0.12);\n  display: flex;\n  gap: 24px;\n  align-items: center;\n  max-width: 500px;\n  width: 100%;\n}\n#avatarPanel img {\n  width: 180px;\n  height: 180px;\n  object-fit: cover;\n  border-radius: 16px;\n  border: 3px solid #d8c4a8;\n  display: block;\n}\n#statsPanel {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  flex: 1;\n}\n#usernameDisplay {\n  font-size: 1.6rem;\n  color: #4e382a;\n}\n#rankDisplay {\n  font-size: 1rem;\n  color: #8a6a4f;\n}\n#healthBox {\n  background-color: #f8f1e7;\n  border: 2px solid #dbc8af;\n  border-radius: 12px;\n  padding: 12px 16px;\n}\n#healthBox p:first-child {\n  font-size: 0.9rem;\n  color: #7a5a3c;\n  font-weight: bold;\n}\n#healthDisplay {\n  font-size: 2.5rem;\n  font-weight: bold;\n  color: #4a3427;\n  line-height: 1.1;\n}\nbutton {\n  border: none;\n  border-radius: 10px;\n  padding: 10px 16px;\n  font-size: 1rem;\n  font-weight: bold;\n  cursor: pointer;\n  color: #fffaf2;\n  background-color: #8fbc7a;\n  transition: transform 0.15s ease, filter 0.15s ease;\n}\nbutton:hover {\n  transform: translateY(-1px);\n  filter: brightness(1.05);\n}\nbutton:active {\n  transform: translateY(1px);\n}\n@media (max-width: 500px) {\n  main {\n    flex-direction: column;\n    align-items: center;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "let health = 20;\nlet username = \"GamerGirl\";\nlet rank = \"Rookie Explorer\";\nlet avatarImage = \"images/player-avatar.png\";\n\ndocument.getElementById(\"healthDisplay\").textContent = health;\ndocument.getElementById(\"usernameDisplay\").textContent = username;\ndocument.getElementById(\"rankDisplay\").textContent = rank;\ndocument.getElementById(\"avatar\").src = avatarImage;\n\ndocument.getElementById(\"healthUpButton\").addEventListener(\"click\", () => {\n  health = health + 5;\n  document.getElementById(\"healthDisplay\").textContent = health;\n});\n",
          "folderId": "0",
          "active": true
        },
