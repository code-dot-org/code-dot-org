  "properties": {
    "encrypted": "false",
    "long_instructions": "# ScriptCheck Software Optimization\r\n\r\nLaye needs help troubleshooting and optimizing the ScriptCheck software she is using.\r\n\r\nRead the directions on the tablet displayed.",
    "offer_browser_tts": "false",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "true",
    "require_edit_to_continue": "false",
    "initial_view_mode": "split",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
