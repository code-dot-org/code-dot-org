    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>ScriptCheck</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n<script src=\"script.js\" defer></script>\n</head>\n<body>\n\n<h1 class=\"sr-only\">ScriptCheck: one morning behind the pharmacy counter</h1>\n\n<svg class=\"sprite\" aria-hidden=\"true\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\">\n\n  <symbol id=\"t-processor\" viewBox=\"0 0 24 24\">\n    <rect x=\"6\" y=\"6\" width=\"12\" height=\"12\" rx=\"2\"/>\n    <rect x=\"9.5\" y=\"9.5\" width=\"5\" height=\"5\" rx=\"1\" fill=\"#FFFFFF\"/>\n    <rect x=\"8.6\" y=\"2.5\" width=\"1.6\" height=\"3\"/><rect x=\"13.8\" y=\"2.5\" width=\"1.6\" height=\"3\"/>\n    <rect x=\"8.6\" y=\"18.5\" width=\"1.6\" height=\"3\"/><rect x=\"13.8\" y=\"18.5\" width=\"1.6\" height=\"3\"/>\n    <rect x=\"2.5\" y=\"8.6\" width=\"3\" height=\"1.6\"/><rect x=\"2.5\" y=\"13.8\" width=\"3\" height=\"1.6\"/>\n    <rect x=\"18.5\" y=\"8.6\" width=\"3\" height=\"1.6\"/><rect x=\"18.5\" y=\"13.8\" width=\"3\" height=\"1.6\"/>\n  </symbol>\n  <symbol id=\"t-storage\" viewBox=\"0 0 24 24\">\n    <ellipse cx=\"12\" cy=\"6\" rx=\"8\" ry=\"3\"/>\n    <path d=\"M4 6v5c0 1.7 3.6 3 8 3s8-1.3 8-3V6c0 1.7-3.6 3-8 3S4 7.7 4 6z\"/>\n    <path d=\"M4 13v5c0 1.7 3.6 3 8 3s8-1.3 8-3v-5c0 1.7-3.6 3-8 3s-8-1.3-8-3z\"/>\n  </symbol>\n  <symbol id=\"t-network\" viewBox=\"0 0 24 24\">\n    <circle cx=\"12\" cy=\"18.5\" r=\"2.4\"/>\n    <path d=\"M6.5 14.2a7.8 7.8 0 0 1 11 0l-1.8 1.8a5.2 5.2 0 0 0-7.4 0z\"/>\n    <path d=\"M3 10.7a12.8 12.8 0 0 1 18 0l-1.8 1.8a10.2 10.2 0 0 0-14.4 0z\"/>\n  </symbol>\n  <symbol id=\"t-memory\" viewBox=\"0 0 24 24\">\n    <path d=\"M3 7h18v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/>\n    <rect x=\"6\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"9.6\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"13.2\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"16.8\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"5\" y=\"19\" width=\"4\" height=\"2.5\" rx=\"1\"/><rect x=\"15\" y=\"19\" width=\"4\" height=\"2.5\" rx=\"1\"/>\n  </symbol>\n\n  <symbol id=\"a-scan\" viewBox=\"0 0 24 24\">\n    <path d=\"M2 2h6.4v2.3H4.3V8.4H2z\"/><path d=\"M22 2h-6.4v2.3h4.1V8.4H22z\"/>\n    <path d=\"M2 22h6.4v-2.3H4.3V15.6H2z\"/><path d=\"M22 22h-6.4v-2.3h4.1V15.6H22z\"/>\n    <rect x=\"6.2\" y=\"7\" width=\"1.9\" height=\"10\"/><rect x=\"9.2\" y=\"7\" width=\"1\" height=\"10\"/>\n    <rect x=\"11.6\" y=\"7\" width=\"2.1\" height=\"10\"/><rect x=\"15.1\" y=\"7\" width=\"1\" height=\"10\"/>\n    <rect x=\"17\" y=\"7\" width=\"1.5\" height=\"10\"/>\n  </symbol>\n  <symbol id=\"a-verify\" viewBox=\"0 0 24 24\">\n    <rect x=\"4\" y=\"3\" width=\"16\" height=\"19\" rx=\"2\"/>\n    <rect x=\"8.5\" y=\"1.4\" width=\"7\" height=\"3.4\" rx=\"1.2\"/>\n    <path d=\"m10.7 17.6-3.5-3.5 1.7-1.7 1.8 1.8 4.7-4.7 1.7 1.7z\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"a-label\" viewBox=\"0 0 24 24\">\n    <path d=\"M2.4 11.4 12.9 .9a1.5 1.5 0 0 1 1-.4H20a3.5 3.5 0 0 1 3.5 3.5v6.1a1.5 1.5 0 0 1-.4 1L12.6 21.6a1.5 1.5 0 0 1-2.1 0l-8.1-8.1a1.5 1.5 0 0 1 0-2.1z\"/>\n    <circle cx=\"18.2\" cy=\"5.8\" r=\"2.3\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"a-file\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 1.8 18 8h-3.9v7.4h-4.2V8H6z\"/>\n    <path d=\"M3.6 14.6H6v4.2h12v-4.2h2.4V22H3.6z\"/>\n  </symbol>\n  <symbol id=\"a-check\" viewBox=\"0 0 24 24\">\n    <path d=\"M9.4 18.6 3 12.2l2.3-2.3 4.1 4.1L18.7 5l2.3 2.3z\"/>\n  </symbol>\n  <symbol id=\"a-chevron\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 15.6 3.9 7.5a1.6 1.6 0 0 1 2.2-2.2l5.9 5.9 5.9-5.9a1.6 1.6 0 0 1 2.2 2.2z\"/>\n  </symbol>\n  <symbol id=\"a-reset\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 4.5a7.5 7.5 0 1 0 7.2 9.6h-2.7A4.9 4.9 0 1 1 12 7.1a4.8 4.8 0 0 1 3.4 1.4L12.6 11.3H21V2.9l-2.7 2.7A7.5 7.5 0 0 0 12 4.5z\"/>\n  </symbol>\n  <symbol id=\"a-alert\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 2.5 23 21H1z\"/>\n    <rect x=\"11\" y=\"9\" width=\"2\" height=\"6\" rx=\"1\" fill=\"#FFFFFF\"/>\n    <circle cx=\"12\" cy=\"18\" r=\"1.3\" fill=\"#FFFFFF\"/>\n  </symbol>\n\n  <symbol id=\"g-scanner\" viewBox=\"0 0 24 24\">\n    <path d=\"M2 2h6.4v2.3H4.3V8.4H2z\"/><path d=\"M22 2h-6.4v2.3h4.1V8.4H22z\"/>\n    <path d=\"M2 22h6.4v-2.3H4.3V15.6H2z\"/><path d=\"M22 22h-6.4v-2.3h4.1V15.6H22z\"/>\n    <rect x=\"6.2\" y=\"7\" width=\"1.9\" height=\"10\"/><rect x=\"9.2\" y=\"7\" width=\"1\" height=\"10\"/>\n    <rect x=\"11.6\" y=\"7\" width=\"2.1\" height=\"10\"/><rect x=\"15.1\" y=\"7\" width=\"1\" height=\"10\"/>\n    <rect x=\"17\" y=\"7\" width=\"1.5\" height=\"10\"/>\n  </symbol>\n  <symbol id=\"g-verify\" viewBox=\"0 0 24 24\">\n    <rect x=\"4\" y=\"3\" width=\"16\" height=\"19\" rx=\"2\"/>\n    <rect x=\"8.5\" y=\"1.4\" width=\"7\" height=\"3.4\" rx=\"1.2\"/>\n    <path d=\"m10.7 17.6-3.5-3.5 1.7-1.7 1.8 1.8 4.7-4.7 1.7 1.7z\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"g-fridge\" viewBox=\"0 0 24 24\">\n    <rect x=\"5\" y=\"1.6\" width=\"14\" height=\"20.8\" rx=\"2.4\"/>\n    <rect x=\"5\" y=\"9\" width=\"14\" height=\"1.8\" fill=\"#FFFFFF\"/>\n    <rect x=\"15.2\" y=\"4.6\" width=\"1.8\" height=\"3.2\" rx=\"0.9\" fill=\"#FFFFFF\"/>\n    <rect x=\"15.2\" y=\"12\" width=\"1.8\" height=\"4.4\" rx=\"0.9\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"g-paper\" viewBox=\"0 0 24 24\">\n    <path d=\"M4 1.6h9.4L20 8.2V22.4H4z\"/>\n    <path d=\"M13.4 1.6v6.6H20z\" fill=\"#FFFFFF\"/>\n    <rect x=\"7\" y=\"11.6\" width=\"10\" height=\"1.7\" fill=\"#FFFFFF\"/>\n    <rect x=\"7\" y=\"15.2\" width=\"10\" height=\"1.7\" fill=\"#FFFFFF\"/>\n    <rect x=\"7\" y=\"18.8\" width=\"6\" height=\"1.7\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"g-storage\" viewBox=\"0 0 24 24\">\n    <ellipse cx=\"12\" cy=\"6\" rx=\"8\" ry=\"3\"/>\n    <path d=\"M4 6v5c0 1.7 3.6 3 8 3s8-1.3 8-3V6c0 1.7-3.6 3-8 3S4 7.7 4 6z\"/>\n    <path d=\"M4 13v5c0 1.7 3.6 3 8 3s8-1.3 8-3v-5c0 1.7-3.6 3-8 3s-8-1.3-8-3z\"/>\n  </symbol>\n  <symbol id=\"g-records\" viewBox=\"0 0 24 24\">\n    <rect x=\"10.6\" y=\"9\" width=\"2.8\" height=\"13\" rx=\"1\"/>\n    <path d=\"M12 2a7 7 0 0 0-7 7h2.6A4.4 4.4 0 0 1 12 4.6z\"/>\n    <path d=\"M12 2a7 7 0 0 1 7 7h-2.6A4.4 4.4 0 0 0 12 4.6z\"/>\n    <circle cx=\"12\" cy=\"8\" r=\"2.2\"/>\n  </symbol>\n  <symbol id=\"g-system\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 8.4A3.6 3.6 0 1 0 12 15.6 3.6 3.6 0 0 0 12 8.4zm9.4 5.2.1-1.6-.1-1.6 2-1.6-2-3.4-2.4.9a7.8 7.8 0 0 0-2.8-1.6L15.8 2h-3.9l-.4 2.7a7.8 7.8 0 0 0-2.8 1.6L6.3 5.4l-2 3.4 2 1.6-.1 1.6.1 1.6-2 1.6 2 3.4 2.4-.9a7.8 7.8 0 0 0 2.8 1.6l.4 2.7h3.9l.4-2.7a7.8 7.8 0 0 0 2.8-1.6l2.4.9 2-3.4z\"/>\n  </symbol>\n  <symbol id=\"g-settings\" viewBox=\"0 0 24 24\">\n    <rect x=\"2\" y=\"4.6\" width=\"20\" height=\"2.2\" rx=\"1.1\"/>\n    <rect x=\"2\" y=\"10.9\" width=\"20\" height=\"2.2\" rx=\"1.1\"/>\n    <rect x=\"2\" y=\"17.2\" width=\"20\" height=\"2.2\" rx=\"1.1\"/>\n    <circle cx=\"8\" cy=\"5.7\" r=\"3\"/><circle cx=\"16\" cy=\"12\" r=\"3\"/><circle cx=\"10\" cy=\"18.3\" r=\"3\"/>\n    <circle cx=\"8\" cy=\"5.7\" r=\"1.3\" fill=\"#FFFFFF\"/><circle cx=\"16\" cy=\"12\" r=\"1.3\" fill=\"#FFFFFF\"/>\n    <circle cx=\"10\" cy=\"18.3\" r=\"1.3\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"g-counter\" viewBox=\"0 0 24 24\">\n    <rect x=\"6\" y=\"7\" width=\"12\" height=\"15.4\" rx=\"2.4\"/>\n    <rect x=\"4.4\" y=\"2.4\" width=\"15.2\" height=\"4.8\" rx=\"1.8\"/>\n    <rect x=\"10.8\" y=\"11\" width=\"2.4\" height=\"7.4\" fill=\"#FFFFFF\"/>\n    <rect x=\"8.3\" y=\"13.5\" width=\"7.4\" height=\"2.4\" fill=\"#FFFFFF\"/>\n  </symbol>\n\n  <symbol id=\"r-tablets\" viewBox=\"0 0 48 48\">\n    <rect x=\"5\" y=\"7\" width=\"38\" height=\"34\" rx=\"5\"/>\n    <circle cx=\"16\" cy=\"17\" r=\"5.4\" fill=\"#FFFFFF\"/><circle cx=\"32\" cy=\"17\" r=\"5.4\" fill=\"#FFFFFF\"/>\n    <circle cx=\"16\" cy=\"31\" r=\"5.4\" fill=\"#FFFFFF\"/><circle cx=\"32\" cy=\"31\" r=\"5.4\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"r-syrup\" viewBox=\"0 0 48 48\">\n    <rect x=\"14.5\" y=\"4\" width=\"13\" height=\"4.4\" rx=\"1.6\"/>\n    <rect x=\"17\" y=\"8\" width=\"8\" height=\"8\"/>\n    <rect x=\"11\" y=\"16\" width=\"20\" height=\"28\" rx=\"3.4\"/>\n    <rect x=\"14.5\" y=\"22\" width=\"13\" height=\"9\" fill=\"#FFFFFF\"/>\n    <ellipse cx=\"39\" cy=\"19\" rx=\"6.5\" ry=\"4.8\" transform=\"rotate(-25 39 19)\"/>\n    <rect x=\"39.6\" y=\"23\" width=\"3.2\" height=\"15\" rx=\"1.6\" transform=\"rotate(-18 41.2 30.5)\"/>\n  </symbol>\n  <symbol id=\"r-supplies\" viewBox=\"0 0 48 48\">\n    <rect x=\"9\" y=\"9\" width=\"23\" height=\"35\" rx=\"4.4\"/>\n    <rect x=\"13.5\" y=\"14\" width=\"14\" height=\"10\" fill=\"#FFFFFF\"/>\n    <circle cx=\"16.5\" cy=\"31\" r=\"3.1\" fill=\"#FFFFFF\"/><circle cx=\"24.5\" cy=\"31\" r=\"3.1\" fill=\"#FFFFFF\"/>\n    <circle cx=\"20.5\" cy=\"38\" r=\"3.1\" fill=\"#FFFFFF\"/>\n    <rect x=\"30\" y=\"3\" width=\"8\" height=\"14\" rx=\"2.4\"/>\n    <rect x=\"32.4\" y=\"6\" width=\"3.2\" height=\"8\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"r-injection\" viewBox=\"0 0 48 48\">\n    <rect x=\"19.5\" y=\"3\" width=\"9\" height=\"8.4\" rx=\"2.4\"/>\n    <rect x=\"17.5\" y=\"11\" width=\"13\" height=\"23\" rx=\"3.4\"/>\n    <rect x=\"20.8\" y=\"15\" width=\"6.4\" height=\"9.4\" fill=\"#FFFFFF\"/>\n    <path d=\"M21 34h6l-1.4 6.4h-3.2z\"/>\n    <rect x=\"23\" y=\"40\" width=\"2\" height=\"6\"/>\n  </symbol>\n</svg>\n\n<div class=\"device\">\n  <div class=\"screen\">\n\n    <div class=\"statusbar\">\n      <div class=\"stat\"><span class=\"stat-label\">Time</span><span class=\"stat-value\" id=\"stat-clock\">9:00 AM</span></div>\n      <div class=\"stat has-gauge\"><span class=\"stat-label\">Fridge</span><span class=\"stat-value\" id=\"stat-fridge\">4&deg;</span><span class=\"gauge\"><span class=\"gauge-fill\" id=\"gauge-fridge\"></span></span></div>\n      <div class=\"stat has-gauge\"><span class=\"stat-label\">Drive</span><span class=\"stat-value\" id=\"stat-drive\">37%</span><span class=\"gauge\"><span class=\"gauge-fill\" id=\"gauge-drive\"></span></span></div>\n      <div class=\"stat\"><span class=\"stat-label\">Speed</span><span class=\"stat-value\" id=\"stat-speed\">Full speed</span></div>\n      <button type=\"button\" class=\"reset\" id=\"reset-btn\" aria-label=\"Start the morning over\">\n        <svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-reset\"></use></svg>\n      </button>\n    </div>\n\n    <div class=\"procbar\"><div class=\"procbar-fill\" id=\"procbar-fill\"></div></div>\n\n    <main class=\"body\">\n\n      <section class=\"view\" id=\"view-brief\">\n        <div class=\"hero\">\n          <h2 class=\"hero-title\">ScriptCheck<br>Pharmacy Counter System</h2>\n        </div>\n\n        <h3 class=\"brief-head\">The situation</h3>\n        <p class=\"lede\">Layla owns a small neighborhood pharmacy in Amman, Jordan. Four prescriptions came in this morning and four people are waiting on them. Her assistant does not get back until 1:00 PM, so she must process them done alone.</p>\n\n        <h3 class=\"brief-head\">Your job</h3>\n        <p class=\"lede\">Layla needs help optimizing her software. Every time a problem comes up, open <strong>Settings</strong>, figure out which setting is causing it, and change it. Some settings will fix the problem. Many of them will not do anything at all, and every change you make uses up the short time that she has.</p>\n\n        <h3 class=\"brief-head\">For each prescription, you will</h3>\n        <ul class=\"steplist\">\n          <li class=\"step-item\"><span class=\"step-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-scan\"></use></svg></span><span class=\"step-name\">Scan the barcode</span></li>\n          <li class=\"step-item\"><span class=\"step-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-verify\"></use></svg></span><span class=\"step-name\">Check the record</span></li>\n          <li class=\"step-item\"><span class=\"step-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-label\"></use></svg></span><span class=\"step-name\">Label and hand it over</span></li>\n          <li class=\"step-item\"><span class=\"step-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-file\"></use></svg></span><span class=\"step-name\">File it to the records</span></li>\n        </ul>\n        <p class=\"lede\">Work them in any order you like. When the filing happens is one of the settings.</p>\n\n        <h3 class=\"brief-head\">A good morning looks like this</h3>\n        <ul class=\"goals\" id=\"brief-goals\"></ul>\n\n        <div class=\"actions\">\n          <button type=\"button\" class=\"btn btn-go btn-lg\" id=\"start-btn\">Start the morning</button>\n        </div>\n      </section>\n\n      <section class=\"view\" id=\"view-counter\" hidden>\n        <div class=\"banner\" id=\"banner\" hidden role=\"alert\"></div>\n        <div class=\"section-head\">\n          <h2 class=\"section-title\">Waiting on you</h2>\n          <span class=\"section-chip\" id=\"counter-chip\"></span>\n        </div>\n        <ul class=\"squad\" id=\"counter\"></ul>\n        <div class=\"detail\" id=\"detail\" hidden></div>\n        <div class=\"finish\" id=\"finish\"></div>\n      </section>\n\n      <section class=\"view\" id=\"view-settings\" hidden>\n        <div class=\"section-head\">\n          <h2 class=\"section-title\">Settings</h2>\n        </div>\n        <div class=\"symptom\" id=\"symptom\" hidden aria-live=\"polite\"></div>\n        <p class=\"settings-note\" id=\"settings-note\"></p>\n        <div class=\"groups\" id=\"groups\"></div>\n      </section>\n\n      <section class=\"view\" id=\"view-report\" hidden>\n        <div class=\"hero\">\n          <p class=\"hero-kicker\">Morning report</p>\n          <h2 class=\"hero-title\" id=\"report-headline\">Morning Report</h2>\n          <p class=\"hero-sub\" id=\"report-sub\"></p>\n          <p class=\"verdict\" id=\"verdict\"></p>\n        </div>\n        <ul class=\"report-list\" id=\"report-list\"></ul>\n        <h3>What went out the door</h3>\n        <ul class=\"calls\" id=\"outcomes\"></ul>\n        <h3>Where the morning went</h3>\n        <div class=\"tally\" id=\"tally\"></div>\n        <div class=\"report-notes\" id=\"report-notes\"></div>\n        <h3>Questions</h3>\n        <ol class=\"questions\" id=\"questions\"></ol>\n        <div class=\"actions\">\n          <button type=\"button\" class=\"btn btn-go\" id=\"again-btn\">Try the morning again</button>\n        </div>\n      </section>\n\n    </main>\n\n    <div class=\"sheet\" id=\"sheet\" hidden>\n      <div class=\"sheet-card\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"sheet-title\">\n        <h2 class=\"sheet-title\" id=\"sheet-title\">Start the morning over?</h2>\n        <p class=\"sheet-body\">The clock goes back to 9:00 AM, the fridge goes back to 4 degrees, every setting resets, and the four prescriptions are waiting again.</p>\n        <div class=\"actions\">\n          <button type=\"button\" class=\"btn btn-go\" id=\"sheet-yes\">Yes, start over</button>\n          <button type=\"button\" class=\"btn btn-alt\" id=\"sheet-no\">Keep going</button>\n        </div>\n      </div>\n    </div>\n\n    <nav class=\"tabbar\" id=\"tabbar\" aria-label=\"ScriptCheck sections\" hidden>\n      <button type=\"button\" class=\"tab\" data-tab=\"counter\">\n        <span class=\"tab-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#g-counter\"></use></svg></span>\n        <span class=\"tab-label\">Counter</span>\n      </button>\n      <button type=\"button\" class=\"tab\" data-tab=\"settings\">\n        <span class=\"tab-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#g-settings\"></use></svg></span>\n        <span class=\"tab-label\">Settings</span>\n        <span class=\"tab-dot\" id=\"tab-dot\" hidden></span>\n      </button>\n    </nav>\n\n  </div>\n</div>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "/* Brand fonts, subset to Latin. Any glyph they lack falls through to the\n   next family in each stack, so other writing systems still render. */\n@font-face {\n  font-family: \"Space Grotesk\";\n  src: url(\"SpaceGrotesk.ttf\") format(\"truetype\");\n  font-weight: 300 700;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: \"Geist\";\n  src: url(\"Geist.ttf\") format(\"truetype\");\n  font-weight: 100 900;\n  font-display: swap;\n}\n\n:root {\n  --purple-light: #E4E2F8;\n  --purple-mid: #ACA8EA;\n  --purple: #4C42CF;\n  --purple-dark: #1F1976;\n  --blue-light: #D5EFFF;\n  --blue-mid: #6FCAFF;\n  --blue: #0099F3;\n  --blue-dark: #06338D;\n  --green-light: #CCF1D0;\n  --green-mid: #7CDB87;\n  --green: #34BD43;\n  --green-dark: #003F25;\n  --orange-light: #FFE3CE;\n  --orange-mid: #FFA868;\n  --orange: #F46800;\n  --orange-dark: #611D00;\n  --pink-light: #FBDAE8;\n  --pink-mid: #F07FB0;\n  --pink: #E11970;\n  --pink-dark: #7D0C3D;\n\n  --ink: #000000;\n  --ink-soft: #4A4857;\n  --line: #D6D4E0;\n  --tint: #F7F6FC;\n\n  --lift: 0 2px 0 rgba(31, 25, 118, 0.14);\n  --lift-lg: 0 4px 16px rgba(31, 25, 118, 0.18);\n\n  --font-display: \"Space Grotesk\", \"Noto Sans\", system-ui, sans-serif;\n  --font-body: \"Geist\", \"Noto Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n}\n\n* { box-sizing: border-box; }\n[hidden] { display: none !important; }\nhtml, body { height: 100%; }\n\nbody {\n  margin: 0;\n  padding: 10px;\n  background-color: var(--purple-light);\n  font-family: var(--font-body);\n  font-size: 15px;\n  color: var(--ink);\n  line-height: 1.45;\n}\n\n.sr-only {\n  position: absolute; width: 1px; height: 1px;\n  padding: 0; margin: -1px; overflow: hidden;\n  clip: rect(0 0 0 0); white-space: nowrap; border: 0;\n}\n\n.sprite { position: absolute; width: 0; height: 0; }\n\n.device {\n  max-width: 44rem;\n  margin-inline: auto;\n  background-color: var(--purple-dark);\n  border-radius: 20px;\n  padding: 10px;\n  box-shadow: var(--lift-lg);\n}\n\n.screen {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  height: min(42rem, calc(100dvh - 40px));\n  min-height: 26rem;\n  background-color: #FFFFFF;\n  border-radius: 12px;\n  overflow: hidden;\n}\n\n/* ---------- status bar ---------- */\n\n.statusbar {\n  display: flex; flex-wrap: wrap;\n  gap: 0.3rem 1.3rem;\n  padding: 0.5rem 0.85rem;\n  background-color: var(--purple-dark);\n  color: #FFFFFF;\n  flex: 0 0 auto;\n}\n\n.stat { display: flex; flex-direction: column; line-height: 1.15; }\n.stat.has-gauge { min-width: 4.4rem; }\n\n.stat-label {\n  font-size: 0.6rem; letter-spacing: 0.08em;\n  text-transform: uppercase; color: var(--purple-mid);\n}\n\n.stat-value { font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; }\n.stat-value.warn { color: var(--orange-mid); }\n.stat-value.bad { color: var(--pink-mid); }\n\n.gauge {\n  display: block; height: 7px; margin-block-start: 0.25rem;\n  border-radius: 4px; overflow: hidden;\n  background-color: var(--purple-dark);\n  border: 1px solid var(--purple-mid);\n}\n\n.gauge-fill {\n  display: block; height: 100%; width: 0;\n  transition: width 260ms ease-out;\n}\n\n.gauge-fill.battery { background-color: var(--green-mid); }\n.gauge-fill.storage { background-color: var(--blue-mid); }\n.gauge-fill.fridge { background-color: var(--blue-mid); }\n.gauge-fill.warn { background-color: var(--orange-mid); }\n.gauge-fill.bad { background-color: var(--pink-mid); }\n\n.reset {\n  margin-inline-start: auto; align-self: center;\n  width: 38px; height: 38px; flex: 0 0 auto;\n  display: flex; align-items: center; justify-content: center;\n  border-radius: 10px; cursor: pointer;\n  background-color: var(--purple); color: #FFFFFF;\n  border: 2px solid var(--purple-mid);\n}\n\n.reset svg { width: 21px; height: 21px; fill: currentColor; }\n\n.procbar { flex: 0 0 auto; height: 5px; background-color: var(--purple-light); }\n.procbar-fill { height: 100%; width: 0; background-color: var(--orange); transition: width linear; }\n\n@media (max-width: 26rem) {\n  .statusbar { gap: 0.3rem 0.9rem; padding: 0.45rem 0.65rem; }\n  .stat-value { font-size: 0.86rem; }\n}\n\n/* ---------- layout ---------- */\n\n.body { flex: 1 1 auto; overflow-y: auto; overscroll-behavior: contain; }\n.view { padding: 0.85rem 0.9rem 1.1rem; }\n\nh2, h3 { font-family: var(--font-display); margin: 0; }\nh3 { font-size: 1rem; color: var(--purple-dark); margin-block-end: 0.35rem; }\n\n.section-head {\n  display: flex; align-items: center; gap: 0.5rem;\n  margin-block-end: 0.55rem;\n}\n\n.section-title {\n  font-size: 1.3rem; line-height: 0.95;\n  letter-spacing: -0.02em; color: var(--purple-dark);\n}\n\n.section-chip {\n  margin-inline-start: auto;\n  font-family: var(--font-display); font-weight: 700; font-size: 0.72rem;\n  letter-spacing: 0.04em; text-transform: uppercase;\n  color: var(--purple-dark); background-color: var(--purple-light);\n  padding: 0.2rem 0.6rem; border-radius: 999px;\n}\n\n/* ---------- hero band ----------\n   Brand gradient: Primary at the top, Mid in the middle, Light at the bottom.\n   White type stays in the Primary region. */\n\n.hero {\n  border-radius: 14px;\n  padding: 1rem 1rem 1.1rem;\n  margin-block-end: 0.9rem;\n  background-image: linear-gradient(180deg, var(--purple) 0%, var(--purple-mid) 62%, var(--purple-light) 100%);\n}\n\n.hero-kicker {\n  margin: 0 0 0.3rem;\n  font-family: var(--font-display); font-weight: 700;\n  font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase;\n  color: #FFFFFF;\n}\n\n.hero-title {\n  font-size: 1.8rem; line-height: 0.94;\n  letter-spacing: -0.02em; color: #FFFFFF;\n  margin-block-end: 0.55rem;\n}\n\n.hero-title:only-child { margin-block-end: 0; }\n\n.hero-sub {\n  margin: 0;\n  font-size: 0.9rem; font-weight: 600;\n  color: var(--purple-dark);\n}\n\n.verdict {\n  display: inline-block; margin: 0.6rem 0 0;\n  font-family: var(--font-display); font-weight: 700; font-size: 0.83rem;\n  padding: 0.3rem 0.75rem; border-radius: 999px;\n  background-color: var(--pink-light); color: var(--pink-dark);\n}\n\n.verdict.good { background-color: var(--green-light); color: var(--green-dark); }\n\n/* ---------- brief ---------- */\n\n.brief-head {\n  font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase;\n  color: var(--purple); margin-block-end: 0.3rem;\n}\n\n.brief-head + .lede { margin-block-start: 0; }\n.lede { margin: 0 0 0.7rem; font-size: 0.93rem; }\n.lede strong { color: var(--purple-dark); }\n\n.goals { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.3rem; }\n\n.goals li {\n  display: flex; align-items: flex-start; gap: 0.5rem;\n  font-size: 0.88rem; color: var(--green-dark);\n  background-color: var(--green-light);\n  border-radius: 9px; padding: 0.35rem 0.55rem;\n}\n\n.goal-icon {\n  flex: 0 0 auto; width: 20px; height: 20px; border-radius: 6px;\n  background-color: var(--green-dark); color: #FFFFFF;\n  display: flex; align-items: center; justify-content: center;\n}\n\n.goal-icon svg { width: 12px; height: 12px; fill: currentColor; }\n\n.steplist {\n  list-style: none; margin: 0 0 0.85rem; padding: 0;\n  display: grid; gap: 0.45rem;\n  grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));\n}\n\n.step-item {\n  display: flex; align-items: center; gap: 0.55rem;\n  border-radius: 12px; padding: 0.5rem 0.6rem;\n  background-color: var(--tint);\n  border: 2px solid var(--purple-light);\n}\n\n.step-icon {\n  flex: 0 0 auto; width: 34px; height: 34px; border-radius: 9px;\n  background-color: var(--purple); color: #FFFFFF;\n  display: flex; align-items: center; justify-content: center;\n}\n\n.step-icon svg { width: 21px; height: 21px; fill: currentColor; }\n.step-name { font-family: var(--font-display); font-weight: 700; font-size: 0.87rem; color: var(--purple-dark); }\n\n/* ---------- banner ---------- */\n\n.banner {\n  border-radius: 14px; overflow: hidden;\n  margin-block-end: 0.85rem;\n  background-color: var(--orange-light);\n  border: 2px solid var(--orange-dark);\n  box-shadow: var(--lift);\n}\n\n.banner.hard { background-color: var(--pink-light); border-color: var(--pink-dark); }\n\n.banner-head {\n  display: flex; align-items: center; gap: 0.55rem;\n  padding: 0.5rem 0.7rem;\n  background-color: var(--orange-dark);\n}\n\n.banner.hard .banner-head { background-color: var(--pink-dark); }\n\n.banner-icon {\n  flex: 0 0 auto; width: 28px; height: 28px; border-radius: 8px;\n  background-color: #FFFFFF; color: var(--orange-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.banner.hard .banner-icon { color: var(--pink-dark); }\n.banner-icon svg { width: 18px; height: 18px; fill: currentColor; }\n.banner-title { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 0.97rem; color: #FFFFFF; }\n\n.banner-voice {\n  margin: 0; padding: 0.6rem 0.75rem 0.5rem;\n  font-size: 0.88rem; font-style: italic; color: var(--orange-dark);\n}\n\n.banner.hard .banner-voice { color: var(--pink-dark); }\n.banner .actions { padding: 0 0.75rem 0.7rem; }\n\n/* ---------- player picker ---------- */\n\n.squad {\n  list-style: none; margin: 0 0 0.85rem; padding: 0;\n  display: grid; gap: 0.5rem;\n  grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));\n}\n\n.player {\n  width: 100%;\n  display: flex; flex-direction: column; align-items: center; gap: 0.3rem;\n  font: inherit; color: inherit; cursor: pointer;\n  border: 2px solid var(--purple-light); border-radius: 14px;\n  background-color: #FFFFFF; padding: 0.6rem 0.45rem 0.5rem;\n  min-height: 44px;\n  box-shadow: var(--lift);\n  transition: transform 120ms ease-out;\n}\n\n.player:active { transform: translateY(1px); }\n.player.picked { border-color: var(--purple-dark); background-color: var(--purple); }\n.player.done { border-color: var(--green); background-color: var(--green-light); }\n\n.player-icon {\n  width: 52px; height: 52px; border-radius: 13px;\n  background-color: var(--purple-light); color: var(--purple-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.player.picked .player-icon { background-color: #FFFFFF; color: var(--purple); }\n.player.done .player-icon { background-color: #FFFFFF; color: var(--green-dark); }\n.player-icon svg { width: 38px; height: 38px; fill: currentColor; }\n\n.player-name { font-family: var(--font-display); font-weight: 700; font-size: 0.92rem; color: var(--purple-dark); }\n.player.picked .player-name { color: #FFFFFF; }\n.player.done .player-name { color: var(--green-dark); }\n\n.pips {\n  display: flex; gap: 0.22rem;\n  padding: 0.2rem; border-radius: 9px;\n  background-color: var(--tint);\n}\n\n.player.picked .pips { background-color: var(--purple-dark); }\n\n.pip {\n  width: 21px; height: 21px; border-radius: 6px;\n  background-color: var(--purple-light); color: var(--purple-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.pip svg { width: 13px; height: 13px; fill: currentColor; }\n\n.here-badge {\n  width: 24px; height: 24px; border-radius: 7px;\n  background-color: var(--orange); color: #FFFFFF;\n  display: flex; align-items: center; justify-content: center;\n}\n\n.here-badge svg { width: 15px; height: 15px; fill: currentColor; }\n.pip-done { background-color: var(--green-dark); color: #FFFFFF; }\n\n/* ---------- player detail ---------- */\n\n.detail {\n  border-radius: 14px; overflow: hidden;\n  margin-block-end: 0.85rem;\n  background-color: #FFFFFF;\n  border: 2px solid var(--purple-light);\n  box-shadow: var(--lift);\n}\n\n.detail.empty {\n  padding: 0.95rem; color: var(--ink-soft);\n  font-size: 0.9rem; font-style: italic;\n  background-color: var(--tint);\n}\n\n.detail.empty p { margin: 0; }\n\n.detail-head {\n  display: flex; align-items: center; gap: 0.6rem;\n  padding: 0.6rem 0.75rem 0.7rem;\n  background-image: linear-gradient(180deg, var(--purple) 0%, var(--purple-mid) 62%, var(--purple-light) 100%);\n}\n\n.detail-icon {\n  flex: 0 0 auto; width: 48px; height: 48px; border-radius: 12px;\n  background-color: #FFFFFF; color: var(--purple);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.detail-icon svg { width: 34px; height: 34px; fill: currentColor; }\n.detail-id { display: flex; flex-direction: column; min-width: 0; }\n.detail-name { font-family: var(--font-display); font-weight: 700; font-size: 1.12rem; line-height: 1.05; color: #FFFFFF; }\n.detail-kind { font-size: 0.78rem; font-weight: 600; color: var(--purple-dark); }\n\n.detail-body { padding: 0.7rem 0.75rem 0.8rem; }\n.complaint { margin: 0 0 0.5rem; font-size: 0.89rem; font-style: italic; color: var(--ink-soft); }\n\n.findings { list-style: none; margin: 0 0 0.6rem; padding: 0; display: grid; gap: 0.25rem; }\n\n.findings li {\n  font-size: 0.86rem;\n  padding: 0.32rem 0.5rem 0.32rem 0.55rem;\n  border-radius: 8px;\n  background-color: var(--purple-light);\n  border-inline-start: 4px solid var(--purple);\n  color: var(--purple-dark);\n}\n\n.detail-flag {\n  margin: 0 0 0.6rem; padding: 0.4rem 0.6rem; border-radius: 9px;\n  font-size: 0.82rem; font-weight: 600;\n  background-color: var(--orange-light); color: var(--orange-dark);\n  border-inline-start: 5px solid var(--orange);\n}\n\n.detail-travel {\n  margin: 0 0 0.55rem; font-size: 0.79rem; color: var(--ink-soft);\n}\n\n.shot { margin: 0 0 0.6rem; }\n\n.shot-img {\n  display: block; width: 100%; max-width: 230px; height: auto;\n  border-radius: 12px; border: 3px solid var(--blue);\n}\n\n.q-standard { filter: blur(0.6px); }\n.q-low { filter: blur(1.6px); image-rendering: pixelated; }\n\n.shot-cap {\n  margin: 0.35rem 0 0; font-size: 0.77rem; font-weight: 600;\n  color: var(--blue-dark);\n}\n\n.detail-note {\n  margin: 0.5rem 0 0; padding: 0.45rem 0.6rem; border-radius: 9px;\n  font-size: 0.8rem; font-weight: 600;\n  background-color: var(--pink-light); color: var(--pink-dark);\n}\n\n/* ---------- finish ---------- */\n\n.finish {\n  border-radius: 14px; padding: 0.7rem 0.75rem;\n  background-color: var(--tint);\n  border: 2px dashed var(--purple);\n}\n\n.finish-note { margin: 0.4rem 0 0; font-size: 0.79rem; color: var(--ink-soft); }\n\n/* ---------- settings page ---------- */\n\n.symptom {\n  border-radius: 12px; padding: 0.6rem 0.75rem; margin-block-end: 0.6rem;\n  background-color: var(--pink-light);\n  border-inline-start: 6px solid var(--pink);\n}\n\n.symptom.good { background-color: var(--green-light); border-inline-start-color: var(--green); }\n.symptom-line { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; color: var(--pink-dark); }\n.symptom.good .symptom-line { color: var(--green-dark); }\n.symptom-hint { margin: 0.25rem 0 0; font-size: 0.83rem; color: var(--pink-dark); }\n\n.settings-note { margin: 0 0 0.7rem; font-size: 0.81rem; color: var(--ink-soft); }\n\n.groups { display: grid; gap: 0.85rem; }\n\n.group-head {\n  display: flex; align-items: center; gap: 0.5rem;\n  margin-block-end: 0.4rem;\n  padding-block-end: 0.35rem;\n  border-block-end: 3px solid var(--fam-dark);\n}\n\n.group-icon {\n  flex: 0 0 auto; width: 30px; height: 30px; border-radius: 9px;\n  background-color: var(--fam-dark); color: #FFFFFF;\n  display: flex; align-items: center; justify-content: center;\n}\n\n.group-icon svg { width: 19px; height: 19px; fill: currentColor; }\n.group-name { margin: 0; font-size: 1.02rem; color: var(--fam-dark); }\n\n.fam-system  { --fam: #4C42CF; --fam-dark: #1F1976; --fam-light: #E4E2F8; }\n.fam-scanner { --fam: #E11970; --fam-dark: #7D0C3D; --fam-light: #FBDAE8; }\n.fam-verify  { --fam: #E11970; --fam-dark: #7D0C3D; --fam-light: #FBDAE8; }\n.fam-fridge  { --fam: #0099F3; --fam-dark: #06338D; --fam-light: #D5EFFF; }\n.fam-paper   { --fam: #0099F3; --fam-dark: #06338D; --fam-light: #D5EFFF; }\n.fam-storage { --fam: #0099F3; --fam-dark: #06338D; --fam-light: #D5EFFF; }\n.fam-records { --fam: #F46800; --fam-dark: #611D00; --fam-light: #FFE3CE; }\n\n.srow {\n  border: 2px solid var(--line); border-radius: 12px;\n  margin-block-end: 0.35rem; background-color: #FFFFFF;\n}\n\n.srow[open] { border-color: var(--fam); box-shadow: var(--lift); }\n\n.srow-summary {\n  display: flex; align-items: center; gap: 0.5rem;\n  padding: 0.5rem 0.65rem; cursor: pointer; min-height: 44px;\n  list-style: none;\n}\n\n.srow-summary::-webkit-details-marker { display: none; }\n.srow-name { font-family: var(--font-display); font-weight: 700; font-size: 0.88rem; color: var(--ink); }\n\n.srow-value {\n  margin-inline-start: auto; font-size: 0.78rem; font-weight: 600; color: var(--ink-soft);\n  padding: 0.14rem 0.5rem; border-radius: 999px; background-color: var(--tint);\n  border: 1px solid var(--line);\n}\n\n.srow-chevron {\n  flex: 0 0 auto; width: 24px; height: 24px; border-radius: 7px;\n  display: flex; align-items: center; justify-content: center;\n  background-color: var(--fam-light); color: var(--fam-dark);\n  transition: transform 140ms ease-out;\n}\n\n.srow-chevron svg { width: 15px; height: 15px; fill: currentColor; }\n.srow[open] .srow-chevron { background-color: var(--fam-dark); color: #FFFFFF; transform: rotate(180deg); }\n.srow-body { padding: 0 0.65rem 0.7rem; }\n.srow-why { margin: 0 0 0.5rem; font-size: 0.82rem; color: var(--ink-soft); }\n\n.options { display: grid; gap: 0.4rem; grid-template-columns: 1fr; }\n\n@media (min-width: 32rem) { .options { grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); } }\n\n.option {\n  display: flex; flex-direction: column; gap: 0.18rem;\n  text-align: start; font: inherit; color: var(--ink);\n  min-height: 44px; padding: 0.5rem 0.65rem;\n  border-radius: 11px; border: 2px solid var(--line);\n  background-color: #FFFFFF; cursor: pointer;\n  transition: transform 120ms ease-out;\n}\n\n.option:active { transform: translateY(1px); }\n.option-label { font-family: var(--font-display); font-weight: 700; font-size: 0.87rem; color: var(--purple-dark); }\n.option-note { font-size: 0.76rem; color: var(--ink-soft); line-height: 1.32; }\n\n.option[aria-pressed=\"true\"] { background-color: var(--purple); border-color: var(--purple-dark); }\n.option[aria-pressed=\"true\"] .option-label { color: #FFFFFF; }\n.option[aria-pressed=\"true\"] .option-note { color: var(--purple-light); }\n\n/* ---------- buttons ---------- */\n\n.actions { display: flex; flex-wrap: wrap; gap: 0.45rem; }\n\n.btn {\n  font-family: var(--font-display); font-weight: 700; font-size: 0.87rem;\n  min-height: 44px; padding: 0.5rem 0.9rem;\n  border-radius: 11px; border: 2px solid transparent; cursor: pointer;\n  text-align: start;\n  transition: transform 120ms ease-out;\n}\n\n.btn:active { transform: translateY(1px); }\n.btn-lg { font-size: 0.93rem; min-height: 48px; padding: 0.6rem 1.05rem; }\n.btn-go { background-color: var(--purple); color: #FFFFFF; border-color: var(--purple-dark); box-shadow: var(--lift); }\n.btn-alt { background-color: #FFFFFF; color: var(--purple-dark); border-color: var(--purple); }\n.btn-warn { background-color: var(--orange-light); color: var(--orange-dark); border-color: var(--orange); }\n.btn:disabled { cursor: not-allowed; background-color: #EDECF3; color: #56545F; border-color: var(--line); box-shadow: none; }\n\n@media (prefers-reduced-motion: reduce) {\n  .procbar-fill, .gauge-fill, .player, .option, .btn, .srow-chevron { transition: none; }\n  .player:active, .option:active, .btn:active { transform: none; }\n}\n\n/* ---------- report ---------- */\n\n.report-list { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.35rem; }\n\n.report-list li {\n  display: flex; flex-wrap: wrap; gap: 0.2rem 0.7rem;\n  justify-content: space-between; align-items: baseline;\n  border-radius: 11px; padding: 0.5rem 0.75rem;\n  border: 2px solid var(--line); font-size: 0.89rem;\n}\n\n.report-list li.met { background-color: var(--green-light); border-color: var(--green); }\n.report-list li.unmet { background-color: var(--pink-light); border-color: var(--pink); }\n\n.rep-name { font-weight: 600; }\n.rep-val { font-family: var(--font-display); font-weight: 700; }\nli.met .rep-val { color: var(--green-dark); }\nli.unmet .rep-val { color: var(--pink-dark); }\n\n.cat-processor { --fam: #4C42CF; --fam-dark: #1F1976; --fam-light: #E4E2F8; }\n.cat-storage   { --fam: #0099F3; --fam-dark: #06338D; --fam-light: #D5EFFF; }\n.cat-network   { --fam: #F46800; --fam-dark: #611D00; --fam-light: #FFE3CE; }\n.cat-memory    { --fam: #E11970; --fam-dark: #7D0C3D; --fam-light: #FBDAE8; }\n.cat-settings  { --fam: #34BD43; --fam-dark: #003F25; --fam-light: #CCF1D0; }\n\n.tally {\n  display: grid; gap: 0.45rem;\n  grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));\n  margin-block-end: 0.9rem;\n}\n\n.tally-card {\n  border-radius: 12px; overflow: hidden;\n  border: 2px solid var(--fam-light);\n  background-color: #FFFFFF;\n}\n\n.tally-card.is-top { border-color: var(--fam-dark); box-shadow: var(--lift); }\n\n.tally-head {\n  display: flex; align-items: center; gap: 0.4rem;\n  padding: 0.35rem 0.5rem;\n  background-color: var(--fam-dark);\n}\n\n.tally-dot {\n  width: 24px; height: 24px; flex: 0 0 auto; border-radius: 7px;\n  background-color: #FFFFFF; color: var(--fam-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.tally-dot svg { width: 16px; height: 16px; fill: currentColor; }\n.tally-name { font-family: var(--font-display); font-weight: 700; font-size: 0.8rem; color: #FFFFFF; }\n.tally-body { padding: 0.45rem 0.6rem 0.55rem; }\n.tally-val { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; color: var(--fam-dark); margin: 0; }\n.tally-sub { font-size: 0.73rem; color: var(--ink-soft); margin: 0; }\n\n.tally-flag {\n  display: inline-block; margin: 0.3rem 0 0;\n  font-size: 0.66rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase;\n  color: var(--fam-dark); background-color: var(--fam-light);\n  padding: 0.16rem 0.5rem; border-radius: 999px;\n}\n\n.calls { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.35rem; }\n\n.calls li {\n  display: grid; gap: 0.15rem;\n  border-radius: 11px; padding: 0.5rem 0.75rem;\n  border: 2px solid var(--line);\n}\n\n.calls li.met { background-color: var(--green-light); border-color: var(--green); }\n.calls li.unmet { background-color: var(--pink-light); border-color: var(--pink); }\n\n.call-name { font-family: var(--font-display); font-weight: 700; font-size: 0.82rem; }\n.calls li.met .call-name { color: var(--green-dark); }\n.calls li.unmet .call-name { color: var(--pink-dark); }\n.call-text { font-size: 0.87rem; }\n\n.report-notes { display: grid; gap: 0.35rem; margin-block-end: 1rem; }\n\n.report-note {\n  background-color: var(--orange-light);\n  border-inline-start: 6px solid var(--orange);\n  border-radius: 11px; padding: 0.55rem 0.75rem;\n  color: var(--orange-dark); font-size: 0.87rem; margin: 0;\n}\n\n.questions { padding-inline-start: 1.2rem; margin: 0 0 1rem; font-size: 0.89rem; }\n.questions li { margin-block-end: 0.4rem; }\n\n/* ---------- confirmation sheet ---------- */\n\n.sheet {\n  position: absolute; inset: 0; z-index: 10;\n  display: flex; align-items: center; justify-content: center;\n  padding: 1rem;\n  background-color: rgba(31, 25, 118, 0.55);\n}\n\n.sheet-card {\n  width: 100%; max-width: 22rem;\n  border-radius: 16px; padding: 1rem;\n  background-color: #FFFFFF;\n  border: 3px solid var(--purple-dark);\n  box-shadow: var(--lift-lg);\n}\n\n.sheet-title {\n  font-size: 1.15rem; line-height: 1.05;\n  color: var(--purple-dark); margin-block-end: 0.45rem;\n}\n\n.sheet-body { margin: 0 0 0.8rem; font-size: 0.88rem; color: var(--ink-soft); }\n\n/* ---------- tab bar ---------- */\n\n.tabbar {\n  display: flex; flex: 0 0 auto;\n  border-block-start: 2px solid var(--purple-light);\n  background-color: var(--tint);\n}\n\n.tab {\n  position: relative;\n  flex: 1 1 0;\n  display: flex; align-items: center; justify-content: center; gap: 0.45rem;\n  font-family: var(--font-display); font-weight: 700; font-size: 0.88rem;\n  min-height: 50px; padding: 0.35rem;\n  border: none; border-block-start: 4px solid transparent;\n  background-color: transparent; color: var(--ink-soft); cursor: pointer;\n}\n\n.tab[aria-current=\"page\"] { color: #FFFFFF; border-block-start-color: var(--purple-dark); background-color: var(--purple); }\n.tab-icon { display: flex; }\n.tab-icon svg { width: 21px; height: 21px; fill: currentColor; }\n\n.tab-dot {\n  width: 11px; height: 11px; border-radius: 50%;\n  background-color: var(--pink);\n  border: 2px solid #FFFFFF;\n}\n\n.tab[aria-current=\"page\"] .tab-dot { border-color: var(--purple); }\n\n/* ---------- focus ---------- */\n\n.btn:focus-visible,\n.option:focus-visible,\n.player:focus-visible,\n.tab:focus-visible,\n.reset:focus-visible,\n.srow-summary:focus-visible {\n  outline: 3px solid var(--orange);\n  outline-offset: 2px;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const DAY_START = 540;\nconst DAY_END = 780;\nconst DRIVE_CAP = 100;\nconst OLD_RECORD_UNITS = 32;\nconst CACHE_UNITS = 5;\n\nconst SCAN_MINUTES = 6;\nconst COMPARE_MINUTES = 3;\nconst CHECK_MINUTES = 7;\nconst FULL_CHECK_MINUTES = 6;\nconst LABEL_MINUTES = 8;\nconst FILE_NOW_MINUTES = 3;\nconst FILE_END_MINUTES_PER_RX = 7;\nconst CLOSE_MINUTES = 2;\nconst RESEAL_MINUTES = 12;\nconst REAL_SETTING_MINUTES = 2;\nconst IDLE_SETTING_MINUTES = 1;\nconst ARCHIVE_MINUTES = 4;\n\nconst FRIDGE_START = 4;\nconst FRIDGE_RISE_MINUTES = 22;\nconst FRIDGE_WARN = 8;\nconst FRIDGE_SPOIL = 10;\nconst RESEAL_SHOWS_AT = 8;\n\nconst BACKUP_PENALTY = 0.35;\nconst MEMORY_PENALTY = 0.25;\nconst USEFUL_SCAN_SCORE = 50;\nconst HINT_AFTER_TRIES = 2;\n\nconst PAPER = {\n  full: { units: 20, detail: 100, minutes: 4, word: 'Full page' },\n  standard: { units: 7, detail: 75, minutes: 2, word: 'Standard' },\n  text: { units: 2, detail: 30, minutes: 1, word: 'Text only' }\n};\n\nconst GROUPS = [\n  { id: 'system', name: 'System', icon: 'g-system' },\n  { id: 'scanner', name: 'Scanner', icon: 'g-scanner' },\n  { id: 'verify', name: 'Checking', icon: 'g-verify' },\n  { id: 'fridge', name: 'Fridge', icon: 'g-fridge' },\n  { id: 'paper', name: 'Paper copies', icon: 'g-paper' },\n  { id: 'storage', name: 'Storage', icon: 'g-storage' },\n  { id: 'records', name: 'Records', icon: 'g-records' }\n];\n\n/* real: changing it moves time, storage, the fridge, or whether a mistake gets\n   caught. Everything else is here because a real settings screen has things in\n   it that look promising and do nothing. */\nconst SETTINGS = [\n  {\n    id: 'backup', group: 'system', real: true, start: 'daytime',\n    name: 'Records backup',\n    why: 'When the nightly backup of the patient records runs. It is still going, and it is using most of what this computer has.',\n    options: [\n      { value: 'daytime', label: 'Whenever it needs to', note: 'It finishes when it finishes. While it runs, every task takes 35% longer.' },\n      { value: 'overnight', label: 'Overnight only', note: 'Stops the backup now and holds it until the pharmacy is closed.' }\n    ]\n  },\n  {\n    id: 'windows', group: 'system', real: true, start: 'keep',\n    name: 'Finished patient records',\n    why: 'A patient record stays open on screen until something closes it.',\n    options: [\n      { value: 'keep', label: 'Leave them open', note: 'Every open record makes each task 25% slower.' },\n      { value: 'close', label: 'Close them automatically', note: 'Costs 2 minutes per record. The machine stays quick.' }\n    ]\n  },\n  {\n    id: 'tips', group: 'system', real: false, start: 'on',\n    name: 'Tip of the day',\n    why: 'Shows a short note from the software maker when the program opens.',\n    options: [\n      { value: 'on', label: 'On', note: 'A tip on every launch.' },\n      { value: 'off', label: 'Off', note: 'No tips.' }\n    ]\n  },\n  {\n    id: 'theme', group: 'system', real: false, start: 'light',\n    name: 'Interface colors',\n    why: 'The color scheme of the counter software.',\n    options: [\n      { value: 'light', label: 'Light', note: 'Dark words on a light background.' },\n      { value: 'dark', label: 'Dark', note: 'Light words on a dark background.' }\n    ]\n  },\n  {\n    id: 'scanner', group: 'scanner', real: true, start: 'first',\n    name: 'Barcode reads',\n    why: 'The scanning module was replaced last week. The hardware is new, but the software that reads it was never tested afterward, and it sometimes returns the wrong item.',\n    options: [\n      { value: 'first', label: 'Take the first read', note: 'Fastest. A wrong read goes into the file looking exactly like a right one.' },\n      { value: 'compare', label: 'Scan twice and compare', note: 'Adds 3 minutes per prescription. A wrong read gets caught right at the scanner.' }\n    ]\n  },\n  {\n    id: 'beep', group: 'scanner', real: false, start: 'on',\n    name: 'Scanner beep',\n    why: 'The sound the scanner makes when it reads a barcode. It beeps the same way for a right read and a wrong one.',\n    options: [\n      { value: 'on', label: 'On', note: 'The scanner beeps.' },\n      { value: 'off', label: 'Off', note: 'The scanner is silent.' }\n    ]\n  },\n  {\n    id: 'autoFocus', group: 'scanner', real: false, start: 'on',\n    name: 'Automatic focus',\n    why: 'Lets the scanner adjust to how far away the barcode is. The replacement module focuses on its own either way.',\n    options: [\n      { value: 'on', label: 'On', note: 'Adjusts by itself.' },\n      { value: 'off', label: 'Off', note: 'Uses a fixed distance.' }\n    ]\n  },\n  {\n    id: 'check', group: 'verify', real: true, start: 'quick',\n    name: 'Record check',\n    why: 'How much of the patient record the software puts in front of Layla before she hands anything over.',\n    options: [\n      { value: 'quick', label: 'Name and date only', note: 'Fastest. Confirms the right patient, not the right medicine.' },\n      { value: 'full', label: 'Full record', note: 'Adds 6 minutes per prescription. Compares what was scanned against what the doctor actually wrote.' }\n    ]\n  },\n  {\n    id: 'highlight', group: 'verify', real: false, start: 'on',\n    name: 'Highlight color',\n    why: 'Which color the software uses to mark lines that need attention. It marks the same lines either way.',\n    options: [\n      { value: 'on', label: 'Red', note: 'Marks them in red.' },\n      { value: 'off', label: 'Yellow', note: 'Marks them in yellow.' }\n    ]\n  },\n  {\n    id: 'sensor', group: 'fridge', real: true, start: 'hourly',\n    name: 'Fridge sensor readings',\n    why: 'How often the counter computer asks the fridge sensor for a temperature. The number on the status bar is the last reading it took, not what the fridge is doing right now.',\n    options: [\n      { value: 'hourly', label: 'Once an hour', note: 'One reading on the hour. Between readings the number on the screen is out of date.' },\n      { value: 'live', label: 'Every few seconds', note: 'The number on the screen is what the fridge is actually doing.' }\n    ]\n  },\n  {\n    id: 'alarmSound', group: 'fridge', real: false, start: 'on',\n    name: 'Fridge alarm sound',\n    why: 'The noise the software makes when a fridge reading is out of range. It only makes noise about readings it has actually taken.',\n    options: [\n      { value: 'on', label: 'On', note: 'Plays a tone.' },\n      { value: 'off', label: 'Off', note: 'Stays quiet.' }\n    ]\n  },\n  {\n    id: 'quality', group: 'paper', real: true, start: 'full',\n    name: 'Paper copy quality',\n    why: 'Every paper prescription gets scanned and kept. The insurance company has to be able to read it to pay the claim.',\n    options: [\n      { value: 'full', label: 'Full page', note: 'Takes 4 minutes and 20% of the drive per prescription. Perfectly legible, rated 100 out of 100.' },\n      { value: 'standard', label: 'Standard', note: 'Takes 2 minutes and 7% of the drive. Rated 75 out of 100.' },\n      { value: 'text', label: 'Text only', note: 'Takes 1 minute and 2% of the drive. Drops the doctor\\u2019s signature and stamp, rated 30 out of 100.' }\n    ]\n  },\n  {\n    id: 'deskew', group: 'paper', real: false, start: 'on',\n    name: 'Straighten crooked pages',\n    why: 'Rotates a page that went through the scanner at an angle. It happens inside the scan time either way.',\n    options: [\n      { value: 'on', label: 'On', note: 'Straightens the page.' },\n      { value: 'off', label: 'Off', note: 'Leaves it as scanned.' }\n    ]\n  },\n  {\n    id: 'borderCrop', group: 'paper', real: false, start: 'off',\n    name: 'Trim the white border',\n    why: 'Cuts the blank edge off a scanned page. The border is blank, so it costs almost nothing to keep.',\n    options: [\n      { value: 'off', label: 'Off', note: 'Keeps the whole page.' },\n      { value: 'on', label: 'On', note: 'Trims the edges.' }\n    ]\n  },\n  {\n    id: 'archive', group: 'storage', real: true, start: 'local',\n    name: 'Last year\\u2019s records',\n    why: 'A full year of paper copies is still sitting on this drive taking up room that today needs.',\n    options: [\n      { value: 'local', label: 'Keep them here', note: 'Holds 32% of the drive. Layla can pull up last year\\u2019s copy at the counter.' },\n      { value: 'archive', label: 'Move them to the archive disk', note: 'Frees 32% of the drive. Getting one back means going to the back room.' }\n    ]\n  },\n  {\n    id: 'cache', group: 'storage', real: true, start: 'kept',\n    name: 'Temporary files',\n    why: 'Scratch files the software leaves behind. Clearing them helps a little.',\n    options: [\n      { value: 'kept', label: 'Keep them', note: 'Holds 5% of the drive.' },\n      { value: 'cleared', label: 'Clear them', note: 'Frees 5% of the drive. That is two text-only copies.' }\n    ]\n  },\n  {\n    id: 'filing', group: 'records', real: true, start: 'end',\n    name: 'Filing to the records system',\n    why: 'Every prescription has to be filed with the national records system and the insurer. That system is shared by every pharmacy in the city.',\n    options: [\n      { value: 'end', label: 'File them all at closing', note: 'One batch at the end. Closing is exactly when every other pharmacy files too, so each one takes about 7 minutes.' },\n      { value: 'now', label: 'File each one as you finish', note: 'Costs 3 minutes each while the shared system is still quiet.' }\n    ]\n  },\n  {\n    id: 'checkUpdates', group: 'records', real: false, start: 'on',\n    name: 'Check for software updates',\n    why: 'Looks for a newer version of the counter software. It does not install anything without asking.',\n    options: [\n      { value: 'on', label: 'On', note: 'Checks at launch.' },\n      { value: 'off', label: 'Off', note: 'Does not check.' }\n    ]\n  }\n];\n\n/* Two prescriptions sit next to look-alike boxes on the shelf, so a wrong\n   scan on those two will produce the wrong medicine. Two others have to stay\n   refrigerated until they are handed over. */\nconst SCRIPTS = [\n  {\n    id: 'umkhalid', name: 'Um Khalid', who: 'Monthly refill, age 68',\n    icon: 'r-tablets', scan: 'scan-umkhalid.jpg', alt: 'Scan of a paper prescription slip with a printed form, illegible handwriting and a signature at the bottom.',\n    lookalike: true, cold: false,\n    note: 'She has picked this up on the first Sunday of every month for six years.',\n    details: [\n      'The repeat matches what her doctor sent last month.',\n      'Two boxes on that shelf have almost identical packaging.',\n      'She takes it with breakfast, so she is waiting to get home.'\n    ],\n    wrongOutcome: 'She went home with the box that sits beside hers on the shelf.'\n  },\n  {\n    id: 'rami', name: 'Rami', who: 'Child, age 6',\n    icon: 'r-syrup', scan: 'scan-rami.jpg', alt: 'Scan of a paper prescription slip for a child, with illegible handwriting and a clinic stamp.',\n    lookalike: false, cold: true,\n    note: 'His mother is waiting with him. This one has to stay cold the whole way home.',\n    details: [\n      'The amount is worked out from his weight, which is on file.',\n      'It has to stay refrigerated from the fridge into her bag.',\n      'She has already asked how to store it once she gets there.'\n    ],\n    wrongOutcome: ''\n  },\n  {\n    id: 'odeh', name: 'Mr. Odeh', who: 'Testing supplies, age 57',\n    icon: 'r-supplies', scan: 'scan-odeh.jpg', alt: 'Scan of a paper prescription slip with a section crossed out and rewritten in illegible handwriting.',\n    lookalike: true, cold: false,\n    note: 'His doctor changed something last week and he is not sure what.',\n    details: [\n      'The instructions on file changed since his last visit.',\n      'The new supplies and the old ones come in nearly the same box.',\n      'He has been picking up the old ones out of habit.'\n    ],\n    wrongOutcome: 'He went home with the supplies his doctor just moved him off.'\n  },\n  {\n    id: 'nadia', name: 'Nadia', who: 'Refrigerated order, age 34',\n    icon: 'r-injection', scan: 'scan-nadia.jpg', alt: 'Scan of a paper prescription slip with illegible handwriting and a pharmacy stamp in the corner.',\n    lookalike: false, cold: true,\n    note: 'She flies out for work tomorrow and cannot come back for it.',\n    details: [\n      'This one lives in the fridge until the moment it is handed over.',\n      'She has asked how to carry it on a flight.',\n      'The pharmacy only keeps a few of these in stock at a time.'\n    ],\n    wrongOutcome: ''\n  }\n];\n\nconst PROBLEMS = [\n  {\n    id: 'backup', setting: 'backup', group: 'system', blocks: 'scan',\n    title: 'Last night\\u2019s backup is still running',\n    voice: 'The whole machine is crawling and there are four people at this counter.',\n    symptom: 'Right now last night\\u2019s backup is still running in the background.',\n    fixed: 'The machine is quick again.',\n    fires: function () { return true; },\n    ready: function () { return state.settings.backup === 'overnight'; }\n  },\n  {\n    id: 'wrongbox', setting: 'scanner', group: 'scanner', blocks: null, hard: true,\n    title: 'She brought it back',\n    voice: 'This is not what my doctor wrote. Can you check it again?',\n    symptom: 'Right now the repaired scanner is misreading boxes and nothing after it is catching the mistake.',\n    fixed: 'A wrong read will get caught before it reaches anybody now.',\n    fires: function () { return state.redone >= 1; },\n    ready: function () { return state.settings.scanner === 'compare' || state.settings.check === 'full'; }\n  },\n  {\n    id: 'warm', setting: 'sensor', group: 'fridge', blocks: null,\n    title: 'The fridge is drifting warm',\n    voice: 'That reading is higher than that fridge should ever be.',\n    symptom: 'Right now the fridge is above the temperature it is supposed to hold.',\n    fixed: 'You can see what the fridge is actually doing now.',\n    fires: function () { return shownFridge() >= FRIDGE_WARN && !state.sealed; },\n    ready: function () { return state.settings.sensor === 'live'; }\n  },\n  {\n    id: 'full', setting: 'archive', group: 'storage', blocks: 'scan',\n    title: 'The paper copy will not save',\n    voice: 'The drive is full and I have prescriptions left to scan.',\n    symptom: 'Right now there is no room on the drive for another paper copy.',\n    fixed: 'There is room again.',\n    fires: function () { return !copyFits() && needsScan() > 0; },\n    ready: function () { return copyFits(); }\n  },\n  {\n    id: 'huge', setting: 'quality', group: 'paper', blocks: null,\n    title: 'One paper copy took a fifth of the drive',\n    voice: 'It is one sheet of paper. Why is it that big?',\n    symptom: 'Right now every paper copy is being saved at full page quality.',\n    fixed: 'The next copies will use less room.',\n    fires: function () { return scansDone() >= 1 && state.settings.quality === 'full'; },\n    ready: function () { return state.settings.quality !== 'full'; }\n  },\n  {\n    id: 'slow', setting: 'windows', group: 'system', blocks: null,\n    title: 'ScriptCheck is lagging',\n    voice: 'Everything is slow. I have patient records stacked up open.',\n    symptom: 'Right now finished patient records are still open and holding the machine back.',\n    fixed: 'The screen is clear again.',\n    fires: function () { return openRecords() >= 2; },\n    ready: function () { return openRecords() === 0; }\n  }\n];\n\nconst GOALS = [\n  'All four prescriptions reach the records system.',\n  'Layla is done before 1:00 PM.',\n  'Nothing goes out to a patient wrong.',\n  'The refrigerated medicine is still good.',\n  'The paper copies are legible enough for the insurance claim.',\n  'Nothing has to be done over.'\n];\n\nconst QUESTIONS = [\n  'The scanner mistake could be caught at the scanner or at the record check. Either one alone was enough. Why is it worth paying for both?',\n  'The machine was not broken when it felt slow at the start of the morning. What was actually using it up, and which setting stopped it?',\n  'The fridge number on the status bar was real, and it was also out of date. Explain how both of those can be true at once.',\n  'The scanner hardware was replaced last week and the readings were still wrong. Why did fixing the hardware not fix the problem?',\n  'In this job, the fastest choice and the safest choice were not the same choice. How should somebody decide where that line goes?',\n  'Troubleshooting means fixing something that is not working. Optimization means making something run better even when it works. Name one of each from this morning.'\n];\n\nconst nf = new Intl.NumberFormat();\nconst pf = new Intl.NumberFormat(undefined, { style: 'percent', maximumFractionDigits: 0 });\nconst df = new Intl.NumberFormat(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 });\nconst tf = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });\n\nlet state;\nlet busy = false;\nlet renderedView = null;\nlet viewJustChanged = false;\nconst els = {};\n\n/* ================= state ================= */\n\nfunction freshState() {\n  const settings = {};\n  SETTINGS.forEach(function (s) { settings[s.id] = s.start; });\n  return {\n    view: 'brief',\n    settings: settings,\n    selected: null,\n    scripts: SCRIPTS.map(function (s) {\n      return {\n        id: s.id, scanned: false, copy: null, checked: false, labeled: false,\n        closed: false, filed: false, wrong: false, caughtAt: null, spoiled: false\n      };\n    }),\n    problem: null,\n    seen: {},\n    wrongTries: 0,\n    justFixed: null,\n    clock: DAY_START,\n    copyUnits: 0,\n    sealed: false,\n    spoiled: false,\n    returned: false,\n    redone: 0,\n    wentOutWrong: 0,\n    log: [],\n    over: false,\n    endReason: null,\n    missedHistory: false\n  };\n}\n\nfunction scriptDef(id) { for (let i = 0; i < SCRIPTS.length; i++) if (SCRIPTS[i].id === id) return SCRIPTS[i]; return null; }\nfunction scriptState(id) { for (let i = 0; i < state.scripts.length; i++) if (state.scripts[i].id === id) return state.scripts[i]; return null; }\nfunction settingById(id) { for (let i = 0; i < SETTINGS.length; i++) if (SETTINGS[i].id === id) return SETTINGS[i]; return null; }\nfunction groupById(id) { for (let i = 0; i < GROUPS.length; i++) if (GROUPS[i].id === id) return GROUPS[i]; return GROUPS[0]; }\nfunction problemById(id) { for (let i = 0; i < PROBLEMS.length; i++) if (PROBLEMS[i].id === id) return PROBLEMS[i]; return null; }\n\nfunction openRecords() {\n  let n = 0;\n  state.scripts.forEach(function (s) { if (s.labeled && !s.closed) n += 1; });\n  return n;\n}\n\nfunction scansDone() { return state.scripts.filter(function (s) { return s.scanned; }).length; }\nfunction needsScan() { return state.scripts.filter(function (s) { return !s.scanned; }).length; }\n\nfunction tasksLeft() {\n  let n = 0;\n  state.scripts.forEach(function (s) {\n    if (!s.scanned) n += 1;\n    if (!s.checked) n += 1;\n    if (!s.labeled) n += 1;\n  });\n  return n;\n}\n\n/* The fridge drifts warm on its own until the door seal is fixed. The number on\n   the status bar is whatever the last reading said, which is not the same\n   thing as what the fridge is doing. */\nfunction trueFridge() {\n  if (state.sealed) return FRIDGE_START;\n  return FRIDGE_START + Math.floor((state.clock - DAY_START) / FRIDGE_RISE_MINUTES);\n}\n\nfunction lastCheckMinutes() {\n  return DAY_START + Math.floor((state.clock - DAY_START) / 60) * 60;\n}\n\nfunction shownFridge() {\n  if (state.sealed) return FRIDGE_START;\n  if (state.settings.sensor === 'live') return trueFridge();\n  return FRIDGE_START + Math.floor((lastCheckMinutes() - DAY_START) / FRIDGE_RISE_MINUTES);\n}\n\nfunction checkSpoilage() {\n  if (state.spoiled || state.sealed) return;\n  if (trueFridge() < FRIDGE_SPOIL) return;\n  state.spoiled = true;\n  const cold = state.scripts.filter(function (s) { return scriptDef(s.id).cold && !s.labeled; });\n  cold.forEach(function (s) { s.spoiled = true; });\n  state.log.push({\n    text: `The fridge passed ${nf.format(FRIDGE_SPOIL)} degrees. The refrigerated stock has to be thrown out and reordered.`,\n    cat: 'device', minutes: 0, menu: false\n  });\n}\n\nfunction oldRecordUnits() { return state.settings.archive === 'archive' ? 0 : OLD_RECORD_UNITS; }\nfunction cacheUnits() { return state.settings.cache === 'cleared' ? 0 : CACHE_UNITS; }\n\nfunction driveUsed() {\n  return Math.min(oldRecordUnits() + cacheUnits() + state.copyUnits, DRIVE_CAP);\n}\n\nfunction driveFree() { return Math.max(0, DRIVE_CAP - driveUsed()); }\nfunction copyFits() { return driveUsed() + PAPER[state.settings.quality].units <= DRIVE_CAP; }\n\nfunction backupMultiplier() { return state.settings.backup === 'daytime' ? 1 + BACKUP_PENALTY : 1; }\nfunction memoryMultiplier() { return 1 + openRecords() * MEMORY_PENALTY; }\nfunction timeMultiplier() { return backupMultiplier() * memoryMultiplier(); }\n\nfunction copyDetailAverage() {\n  const done = state.scripts.filter(function (s) { return s.copy !== null; });\n  if (done.length === 0) return 0;\n  let total = 0;\n  done.forEach(function (s) { total += PAPER[s.copy].detail; });\n  return Math.round(total / done.length);\n}\n\nfunction unfiled() {\n  return state.scripts.filter(function (s) { return s.labeled && !s.filed; });\n}\n\n/* ================= costs ================= */\n\nfunction spend(minutes, cat, text, menu) {\n  const m = Math.round(minutes);\n  state.clock += m;\n  state.log.push({ text: text, cat: cat, minutes: m, menu: !!menu });\n  checkSpoilage();\n  return m;\n}\n\n/* Charges the task to the part doing the work, then bills each slowdown to\n   whatever actually caused it, so the report can name a culprit. */\nfunction runTask(baseMinutes, cat, text) {\n  const bk = backupMultiplier();\n  const mem = memoryMultiplier();\n  const total = Math.round(baseMinutes * bk * mem);\n\n  let bkShare = Math.round(baseMinutes * (bk - 1));\n  let memShare = Math.round(baseMinutes * bk * (mem - 1));\n  if (bkShare < 2) bkShare = 0;\n  if (memShare < 2) memShare = 0;\n\n  const own = Math.max(0, total - bkShare - memShare);\n  spend(own, cat, text);\n\n  if (bkShare > 0) spend(bkShare, 'settings', `The backup added ${nf.format(bkShare)} minutes to that.`);\n  if (memShare > 0) spend(memShare, 'memory', `${nf.format(openRecords())} open records added ${nf.format(memShare)} minutes to that.`);\n}\n\nfunction checkOver() {\n  if (state.over) return true;\n  if (state.clock >= DAY_END) { state.over = true; state.endReason = 'clock'; return true; }\n  return false;\n}\n\n/* ================= problems ================= */\n\nfunction syncProblem() {\n  if (state.problem) {\n    const active = problemById(state.problem);\n    if (active.ready()) {\n      state.justFixed = active.fixed;\n      state.problem = null;\n      state.wrongTries = 0;\n    } else if (!active.fires()) {\n      /* The situation went away without the setting changing, for example the\n         fridge was resealed before the sensor setting was touched. */\n      state.problem = null;\n      state.wrongTries = 0;\n    } else {\n      return;\n    }\n  }\n  for (let i = 0; i < PROBLEMS.length; i++) {\n    const p = PROBLEMS[i];\n    if (state.seen[p.id]) continue;\n    if (p.ready()) continue;\n    if (!p.fires()) continue;\n    state.problem = p.id;\n    state.seen[p.id] = true;\n    state.wrongTries = 0;\n    return;\n  }\n}\n\n/* Pushes a problem to the front even if another banner is already showing. The\n   displaced one is marked unseen so it can come back afterward. */\nfunction raiseProblem(id) {\n  if (state.problem === id) return;\n  if (state.problem) state.seen[state.problem] = false;\n  state.problem = id;\n  state.seen[id] = true;\n  state.wrongTries = 0;\n}\n\nfunction blockedAction(kind) {\n  if (!state.problem) return false;\n  return problemById(state.problem).blocks === kind;\n}\n\nfunction dismissBanner() {\n  if (!state.problem) return;\n  state.seen[state.problem] = true;\n  state.problem = null;\n  render();\n}\n\n/* ================= actions ================= */\n\nfunction doScan(id) {\n  const s = scriptState(id);\n  const def = scriptDef(id);\n  const q = PAPER[state.settings.quality];\n  const compare = state.settings.scanner === 'compare';\n\n  s.scanned = true;\n  s.copy = state.settings.quality;\n  state.copyUnits += q.units;\n\n  runTask(SCAN_MINUTES + q.minutes + (compare ? COMPARE_MINUTES : 0), 'processor',\n    `Scanned the barcode and the paper for ${def.name}, using ${pf.format(q.units / 100)} of the drive.`);\n\n  if (def.lookalike && compare) {\n    s.caughtAt = 'scanner';\n    spend(0, 'processor', `The second read did not match the first. The right box is on the counter for ${def.name} now.`);\n  }\n}\n\nfunction doCheck(id) {\n  const s = scriptState(id);\n  const def = scriptDef(id);\n  const fullCheck = state.settings.check === 'full';\n  s.checked = true;\n\n  runTask(CHECK_MINUTES + (fullCheck ? FULL_CHECK_MINUTES : 0), 'processor',\n    `Checked the record for ${def.name}.`);\n\n  if (def.lookalike && fullCheck && s.caughtAt === null) {\n    s.caughtAt = 'check';\n    spend(0, 'processor', `The full record check caught it: the scan named a different medicine than the doctor wrote for ${def.name}.`);\n  }\n}\n\n/* The first prescription that goes out wrong comes back to the counter,\n   because the patient notices. A second one does not. */\nfunction doLabel(id) {\n  const s = scriptState(id);\n  const def = scriptDef(id);\n  s.labeled = true;\n\n  runTask(LABEL_MINUTES, 'processor', `Labeled and handed over ${def.name}.`);\n\n  const missed = def.lookalike && state.settings.scanner === 'first' && state.settings.check === 'quick';\n  if (missed) {\n    if (!state.returned) {\n      state.returned = true;\n      state.redone += 1;\n      s.labeled = false;\n      s.checked = false;\n      s.wrong = false;\n      spend(0, 'processor',\n        `${def.name} came back to the counter. It was the wrong box, and the whole prescription has to be done again.`);\n      raiseProblem('wrongbox');\n    } else {\n      s.wrong = true;\n      state.wentOutWrong += 1;\n    }\n  }\n\n  if (s.labeled && state.settings.windows === 'close') {\n    s.closed = true;\n    spend(CLOSE_MINUTES, 'memory', `Closed the record for ${def.name}.`);\n  }\n  if (s.labeled && state.settings.filing === 'now') {\n    s.filed = true;\n    spend(FILE_NOW_MINUTES, 'network', `Filed ${def.name} while the shared system was quiet.`);\n  }\n}\n\nfunction doCloseAll() {\n  const open = state.scripts.filter(function (s) { return s.labeled && !s.closed; });\n  if (open.length === 0) return;\n  open.forEach(function (s) { s.closed = true; });\n  spend(CLOSE_MINUTES * open.length, 'memory', `Closed ${nf.format(open.length)} open records by hand.`);\n}\n\nfunction doReseal() {\n  state.sealed = true;\n  spend(RESEAL_MINUTES, 'device', 'Resealed the fridge door and let it pull back down to 4 degrees.');\n}\n\nfunction doFinish() {\n  const pending = unfiled();\n  if (pending.length > 0) {\n    pending.forEach(function (s) { s.filed = true; });\n    spend(FILE_END_MINUTES_PER_RX * pending.length, 'network',\n      `Filed ${nf.format(pending.length)} prescriptions at closing, when every pharmacy in the city files.`);\n  }\n  state.over = true;\n  if (!state.endReason) state.endReason = state.clock >= DAY_END ? 'clock' : 'finished';\n}\n\nfunction changeSetting(id, value) {\n  if (busy || state.over) return;\n  if (state.settings[id] === value) return;\n\n  const setting = settingById(id);\n  const fromLabel = optionLabel(setting, state.settings[id]);\n  const toLabel = optionLabel(setting, value);\n  state.settings[id] = value;\n  state.justFixed = null;\n\n  if (state.problem && problemById(state.problem).setting !== id) state.wrongTries += 1;\n\n  let minutes = setting.real ? REAL_SETTING_MINUTES : IDLE_SETTING_MINUTES;\n  if (id === 'archive') minutes += ARCHIVE_MINUTES;\n\n  const text = setting.real\n    ? `${setting.name} changed from ${fromLabel} to ${toLabel}.`\n    : `${setting.name} changed from ${fromLabel} to ${toLabel}. Nothing about the morning changed.`;\n  spend(minutes, 'settings', text, true);\n\n  if (id === 'archive' && value === 'archive') state.missedHistory = true;\n  if (id === 'windows' && value === 'close') doCloseAll();\n\n  if (checkOver()) state.view = 'report';\n  syncProblem();\n  render();\n}\n\n/* ================= running an action ================= */\n\nfunction reducedMotion() {\n  return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);\n}\n\nfunction act(fn) {\n  if (busy || state.over) return;\n  const duration = reducedMotion() ? 0 : Math.min(650, Math.round(150 + (timeMultiplier() - 1) * 420));\n  if (duration === 0) { finishAction(fn); return; }\n  busy = true;\n  els.procFill.style.transitionDuration = '0ms';\n  els.procFill.style.width = '0%';\n  window.setTimeout(function () {\n    els.procFill.style.transitionDuration = `${duration}ms`;\n    els.procFill.style.width = '100%';\n  }, 20);\n  window.setTimeout(function () {\n    els.procFill.style.transitionDuration = '0ms';\n    els.procFill.style.width = '0%';\n    busy = false;\n    finishAction(fn);\n  }, duration + 40);\n}\n\nfunction finishAction(fn) {\n  state.justFixed = null;\n  fn();\n  checkOver();\n  syncProblem();\n  if (state.over) state.view = 'report';\n  render();\n  focusMain();\n}\n\n/* ================= small helpers ================= */\n\nfunction clockText(minutes) {\n  const m = typeof minutes === 'number' ? minutes : state.clock;\n  return tf.format(new Date(2026, 0, 1, 0, Math.round(Math.min(m, 24 * 60 - 1))));\n}\n\nfunction optionLabel(setting, value) {\n  for (let i = 0; i < setting.options.length; i++) {\n    if (setting.options[i].value === value) return setting.options[i].label;\n  }\n  return String(value);\n}\n\nfunction speedText() {\n  const m = timeMultiplier();\n  return m <= 1.05 ? 'Full speed' : `${df.format(m)} times slower`;\n}\n\nfunction makeText(tag, className, text) {\n  const el = document.createElement(tag);\n  if (className) el.className = className;\n  if (text !== undefined && text !== null) el.textContent = text;\n  return el;\n}\n\nfunction clearChildren(el) { el.textContent = ''; }\n\nfunction icon(symbolId, className) {\n  const box = document.createElement('span');\n  box.className = className;\n  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');\n  svg.setAttribute('aria-hidden', 'true');\n  svg.setAttribute('focusable', 'false');\n  const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');\n  use.setAttribute('href', `#${symbolId}`);\n  svg.appendChild(use);\n  box.appendChild(svg);\n  return box;\n}\n\nfunction button(label, kind, handler, disabled) {\n  const b = document.createElement('button');\n  b.type = 'button';\n  b.className = `btn ${kind}`;\n  b.textContent = label;\n  b.disabled = !!disabled;\n  b.addEventListener('click', handler);\n  return b;\n}\n\n/* ================= status ================= */\n\nfunction renderStatus() {\n  const drive = driveUsed();\n  const shown = shownFridge();\n  els.clock.textContent = clockText();\n  els.fridge.textContent = state.settings.sensor === 'live' || state.sealed\n    ? `${nf.format(shown)}\\u00B0`\n    : `${nf.format(shown)}\\u00B0 at ${clockText(lastCheckMinutes())}`;\n  els.drive.textContent = pf.format(drive / 100);\n  els.speed.textContent = speedText();\n\n  els.fridge.className = 'stat-value' + (shown >= FRIDGE_SPOIL ? ' bad' : shown >= FRIDGE_WARN ? ' warn' : '');\n  els.drive.className = 'stat-value' + (drive >= 90 ? ' bad' : drive >= 75 ? ' warn' : '');\n  els.speed.className = 'stat-value' + (timeMultiplier() > 1.5 ? ' bad' : timeMultiplier() > 1.05 ? ' warn' : '');\n  els.clock.className = 'stat-value' + (state.clock >= DAY_END - 25 ? ' bad' : state.clock >= DAY_END - 55 ? ' warn' : '');\n\n  els.gaugeFridge.style.width = `${Math.max(0, Math.min(100, shown * 10))}%`;\n  els.gaugeFridge.className = 'gauge-fill fridge' + (shown >= FRIDGE_SPOIL ? ' bad' : shown >= FRIDGE_WARN ? ' warn' : '');\n  els.gaugeDrive.style.width = `${Math.max(0, Math.min(100, drive))}%`;\n  els.gaugeDrive.className = 'gauge-fill storage' + (drive >= 90 ? ' bad' : drive >= 75 ? ' warn' : '');\n\n  els.tabDot.hidden = !state.problem;\n}\n\n/* ================= counter view ================= */\n\nfunction renderBanner() {\n  if (!state.problem) {\n    els.banner.hidden = true;\n    clearChildren(els.banner);\n    return;\n  }\n  const p = problemById(state.problem);\n  els.banner.hidden = false;\n  els.banner.className = 'banner' + (p.blocks || p.hard ? ' hard' : '');\n  clearChildren(els.banner);\n\n  const head = document.createElement('div');\n  head.className = 'banner-head';\n  head.appendChild(icon('a-alert', 'banner-icon'));\n  head.appendChild(makeText('p', 'banner-title', p.title));\n  els.banner.appendChild(head);\n\n  els.banner.appendChild(makeText('p', 'banner-voice', p.voice));\n\n  const row = document.createElement('div');\n  row.className = 'actions';\n  row.appendChild(button('Open Settings', 'btn-go', function () { goTab('settings'); }));\n  if (!p.blocks) row.appendChild(button('Not now', 'btn-alt', dismissBanner));\n  els.banner.appendChild(row);\n}\n\nfunction stepPip(symbol, done) {\n  return icon(symbol, 'pip' + (done ? ' pip-done' : ''));\n}\n\nfunction renderCounter() {\n  const done = state.scripts.filter(function (s) { return s.labeled; }).length;\n  els.counterChip.textContent = `${nf.format(done)} of ${nf.format(SCRIPTS.length)} done`;\n  clearChildren(els.counter);\n  SCRIPTS.forEach(function (script) {\n    const s = scriptState(script.id);\n    const li = document.createElement('li');\n    const card = document.createElement('button');\n    card.type = 'button';\n    card.className = 'player' + (state.selected === script.id ? ' picked' : '') + (s.labeled ? ' done' : '');\n    card.setAttribute('aria-pressed', state.selected === script.id ? 'true' : 'false');\n\n    card.appendChild(icon(script.icon, 'player-icon'));\n    card.appendChild(makeText('span', 'player-name', script.name));\n\n    const pips = document.createElement('span');\n    pips.className = 'pips';\n    pips.appendChild(stepPip('a-scan', s.scanned));\n    pips.appendChild(stepPip('a-verify', s.checked));\n    pips.appendChild(stepPip('a-label', s.labeled));\n    card.appendChild(pips);\n\n    const sr = makeText('span', 'sr-only',\n      `${script.who}. ${s.scanned ? 'Scanned' : 'Not scanned'}. ${s.checked ? 'Record checked' : 'Record not checked'}. ${s.labeled ? 'Handed over' : 'Not handed over'}. ${s.spoiled ? 'The refrigerated stock for this one was ruined.' : ''}`);\n    card.appendChild(sr);\n\n    card.addEventListener('click', function () {\n      state.selected = script.id;\n      state.justFixed = null;\n      render();\n    });\n    li.appendChild(card);\n    els.counter.appendChild(li);\n  });\n}\n\nfunction renderDetail() {\n  if (!state.selected) {\n    els.detail.hidden = false;\n    clearChildren(els.detail);\n    els.detail.className = 'detail empty';\n    els.detail.appendChild(makeText('p', null, 'Pick a prescription to get started.'));\n    return;\n  }\n\n  const script = scriptDef(state.selected);\n  const s = scriptState(state.selected);\n  const mult = timeMultiplier();\n\n  els.detail.hidden = false;\n  els.detail.className = 'detail';\n  clearChildren(els.detail);\n\n  const head = document.createElement('div');\n  head.className = 'detail-head';\n  head.appendChild(icon(script.icon, 'detail-icon'));\n  const idBox = document.createElement('span');\n  idBox.className = 'detail-id';\n  idBox.appendChild(makeText('span', 'detail-name', script.name));\n  idBox.appendChild(makeText('span', 'detail-kind', script.who));\n  head.appendChild(idBox);\n  els.detail.appendChild(head);\n\n  const bodyBox = document.createElement('div');\n  bodyBox.className = 'detail-body';\n  els.detail.appendChild(bodyBox);\n\n  bodyBox.appendChild(makeText('p', 'complaint', script.note));\n\n  if (s.checked) {\n    const ul = document.createElement('ul');\n    ul.className = 'findings';\n    script.details.forEach(function (r) { ul.appendChild(makeText('li', null, r)); });\n    bodyBox.appendChild(ul);\n  }\n\n  if (s.caughtAt === 'scanner') {\n    bodyBox.appendChild(makeText('p', 'detail-flag',\n      'The second scan did not match the first. That would have been the wrong box.'));\n  } else if (s.caughtAt === 'check') {\n    bodyBox.appendChild(makeText('p', 'detail-flag',\n      'The record check caught a wrong scan on this one. That would have gone out wrong.'));\n  }\n\n  if (s.spoiled) {\n    bodyBox.appendChild(makeText('p', 'detail-flag',\n      'The refrigerated stock for this one warmed past the safe limit and had to be thrown out. It cannot be filled today.'));\n  }\n\n  if (s.copy) {\n    const q = PAPER[s.copy];\n    const fig = document.createElement('figure');\n    fig.className = 'shot';\n    const img = document.createElement('img');\n    img.src = script.scan;\n    img.alt = script.alt;\n    img.width = 480;\n    img.height = 360;\n    img.className = `shot-img q-${s.copy === 'standard' ? 'standard' : s.copy === 'text' ? 'low' : 'original'}`;\n    fig.appendChild(img);\n    fig.appendChild(makeText('figcaption', 'shot-cap',\n      `${q.word} quality. Used ${pf.format(q.units / 100)} of the drive, rated ${nf.format(q.detail)} out of 100 for legibility.`));\n    bodyBox.appendChild(fig);\n  }\n\n  const actions = document.createElement('div');\n  actions.className = 'actions';\n\n  if (!s.scanned) {\n    const q = PAPER[state.settings.quality];\n    const compare = state.settings.scanner === 'compare';\n    actions.appendChild(button(\n      `Scan the barcode (${nf.format(Math.round((SCAN_MINUTES + q.minutes + (compare ? COMPARE_MINUTES : 0)) * mult))} min, ${pf.format(q.units / 100)} of the drive)`,\n      'btn-go',\n      function () { act(function () { doScan(script.id); }); },\n      blockedAction('scan') || !copyFits()\n    ));\n  }\n\n  if (s.scanned && !s.checked) {\n    const fullCheck = state.settings.check === 'full';\n    actions.appendChild(button(\n      `Check the record (${nf.format(Math.round((CHECK_MINUTES + (fullCheck ? FULL_CHECK_MINUTES : 0)) * mult))} min)`,\n      'btn-go',\n      function () { act(function () { doCheck(script.id); }); },\n      blockedAction('check')\n    ));\n  }\n\n  if (s.checked && !s.labeled) {\n    actions.appendChild(button(\n      `Label and hand it over (${nf.format(Math.round(LABEL_MINUTES * mult))} min)`,\n      'btn-go',\n      function () { act(function () { doLabel(script.id); }); },\n      blockedAction('label') || s.spoiled\n    ));\n  }\n\n  if (s.labeled && !s.closed) {\n    actions.appendChild(button(`Close the record (${nf.format(CLOSE_MINUTES)} min)`, 'btn-alt',\n      function () { act(doCloseAll); }));\n  }\n\n  bodyBox.appendChild(actions);\n\n  if (!copyFits() && !s.scanned) {\n    bodyBox.appendChild(makeText('p', 'detail-note',\n      `The drive has ${pf.format(driveFree() / 100)} free and this copy needs ${pf.format(PAPER[state.settings.quality].units / 100)}.`));\n  }\n}\n\nfunction renderFinish() {\n  clearChildren(els.finish);\n  const pending = unfiled();\n  const left = tasksLeft();\n\n  const row = document.createElement('div');\n  row.className = 'actions';\n\n  if (pending.length > 0) {\n    row.appendChild(button(\n      `File the rest and close up (${nf.format(FILE_END_MINUTES_PER_RX * pending.length)} min)`,\n      'btn-warn btn-lg',\n      function () { act(doFinish); }\n    ));\n  } else {\n    row.appendChild(button('Close up for the morning', 'btn-warn btn-lg', function () { act(doFinish); }));\n  }\n\n  if (!state.sealed && shownFridge() >= RESEAL_SHOWS_AT) {\n    row.appendChild(button(`Reseal the fridge door (${nf.format(RESEAL_MINUTES)} min)`, 'btn-alt',\n      function () { act(doReseal); }));\n  }\n  els.finish.appendChild(row);\n\n  if (pending.length > 0) {\n    els.finish.appendChild(makeText('p', 'finish-note',\n      `${nf.format(pending.length)} prescriptions are still unfiled. Filing at closing costs ${nf.format(FILE_END_MINUTES_PER_RX)} minutes each.`));\n  }\n\n  if (state.spoiled) {\n    els.finish.appendChild(makeText('p', 'finish-note',\n      'The refrigerated stock is gone. Anything that needed it cannot be filled today.'));\n  }\n\n  if (left > 0) {\n    els.finish.appendChild(makeText('p', 'finish-note', `${nf.format(left)} things are still undone at the counter.`));\n  }\n}\n\nfunction renderCounterView() {\n  renderBanner();\n  renderCounter();\n  renderDetail();\n  renderFinish();\n}\n\n/* ================= settings view ================= */\n\nfunction renderSymptom() {\n  if (state.justFixed) {\n    els.symptom.hidden = false;\n    els.symptom.className = 'symptom good';\n    clearChildren(els.symptom);\n    els.symptom.appendChild(makeText('p', 'symptom-line', state.justFixed));\n    return;\n  }\n  if (!state.problem) {\n    els.symptom.hidden = true;\n    clearChildren(els.symptom);\n    return;\n  }\n  const p = problemById(state.problem);\n  els.symptom.hidden = false;\n  els.symptom.className = 'symptom';\n  clearChildren(els.symptom);\n  els.symptom.appendChild(makeText('p', 'symptom-line', p.symptom));\n  if (state.wrongTries >= HINT_AFTER_TRIES) {\n    els.symptom.appendChild(makeText('p', 'symptom-hint', `Try the ${groupById(p.group).name} settings.`));\n  }\n}\n\nfunction renderSettings() {\n  renderSymptom();\n  els.settingsNote.textContent = 'Opening a setting is free. Changing one costs time.';\n\n  clearChildren(els.groups);\n  GROUPS.forEach(function (group) {\n    const section = document.createElement('section');\n    section.className = `group fam-${group.id}`;\n\n    const head = document.createElement('div');\n    head.className = 'group-head';\n    head.appendChild(icon(group.icon, 'group-icon'));\n    head.appendChild(makeText('h3', 'group-name', group.name));\n    section.appendChild(head);\n\n    SETTINGS.filter(function (s) { return s.group === group.id; }).forEach(function (setting) {\n      const row = document.createElement('details');\n      row.className = 'srow';\n\n      const summary = document.createElement('summary');\n      summary.className = 'srow-summary';\n      summary.appendChild(makeText('span', 'srow-name', setting.name));\n      summary.appendChild(makeText('span', 'srow-value', optionLabel(setting, state.settings[setting.id])));\n      summary.appendChild(icon('a-chevron', 'srow-chevron'));\n      row.appendChild(summary);\n\n      const bodyBox = document.createElement('div');\n      bodyBox.className = 'srow-body';\n      bodyBox.appendChild(makeText('p', 'srow-why', setting.why));\n\n      const opts = document.createElement('div');\n      opts.className = 'options';\n      opts.setAttribute('role', 'group');\n      opts.setAttribute('aria-label', setting.name);\n      setting.options.forEach(function (opt) {\n        const b = document.createElement('button');\n        b.type = 'button';\n        b.className = 'option';\n        b.setAttribute('aria-pressed', state.settings[setting.id] === opt.value ? 'true' : 'false');\n        b.appendChild(makeText('span', 'option-label', opt.label));\n        b.appendChild(makeText('span', 'option-note', opt.note));\n        b.addEventListener('click', function () { changeSetting(setting.id, opt.value); });\n        opts.appendChild(b);\n      });\n      bodyBox.appendChild(opts);\n      row.appendChild(bodyBox);\n      section.appendChild(row);\n    });\n\n    els.groups.appendChild(section);\n  });\n}\n\n/* ================= report ================= */\n\nfunction menuMinutesSpent() {\n  let t = 0;\n  state.log.forEach(function (e) { if (e.menu) t += e.minutes; });\n  return t;\n}\n\nfunction wastedMenuMinutes() {\n  let t = 0;\n  state.log.forEach(function (e) {\n    if (e.menu && e.text.indexOf('Nothing about the morning changed.') !== -1) t += e.minutes;\n  });\n  return t;\n}\n\nfunction totalsByCategory() {\n  const totals = {\n    processor: { m: 0 }, storage: { m: 0 }, network: { m: 0 },\n    memory: { m: 0 }, settings: { m: 0 }\n  };\n  state.log.forEach(function (e) {\n    if (!totals[e.cat]) return;\n    totals[e.cat].m += e.minutes;\n  });\n  return totals;\n}\n\nconst TALLY_CARDS = [\n  { id: 'processor', name: 'Processor', symbol: 't-processor' },\n  { id: 'storage', name: 'Storage', symbol: 't-storage' },\n  { id: 'network', name: 'Network', symbol: 't-network' },\n  { id: 'memory', name: 'Memory', symbol: 't-memory' },\n  { id: 'settings', name: 'Settings', symbol: 'g-settings' }\n];\n\nfunction renderTally() {\n  const totals = totalsByCategory();\n  let topId = null;\n  let topScore = 0;\n  TALLY_CARDS.forEach(function (c) {\n    let score = totals[c.id].m;\n    if (c.id === 'storage') score += state.copyUnits;\n    if (score > topScore) { topScore = score; topId = c.id; }\n  });\n\n  clearChildren(els.tally);\n  TALLY_CARDS.forEach(function (c) {\n    const card = document.createElement('div');\n    card.className = `tally-card cat-${c.id}` + (c.id === topId ? ' is-top' : '');\n    const head = document.createElement('div');\n    head.className = 'tally-head';\n    head.appendChild(icon(c.symbol, 'tally-dot'));\n    head.appendChild(makeText('span', 'tally-name', c.name));\n    card.appendChild(head);\n\n    const bodyBox = document.createElement('div');\n    bodyBox.className = 'tally-body';\n    bodyBox.appendChild(makeText('p', 'tally-val', `${nf.format(totals[c.id].m)} min`));\n    if (c.id === 'storage') bodyBox.appendChild(makeText('p', 'tally-sub', `${pf.format(state.copyUnits / 100)} of the drive in paper copies`));\n    if (c.id === 'settings') {\n      bodyBox.appendChild(makeText('p', 'tally-sub', `${nf.format(menuMinutesSpent())} min changing settings`));\n      bodyBox.appendChild(makeText('p', 'tally-sub', `${nf.format(wastedMenuMinutes())} min of that changed nothing`));\n    }\n    if (c.id === topId) bodyBox.appendChild(makeText('p', 'tally-flag', 'Biggest cost'));\n    card.appendChild(bodyBox);\n    els.tally.appendChild(card);\n  });\n}\n\nfunction renderOutcomes() {\n  clearChildren(els.outcomes);\n  SCRIPTS.forEach(function (script) {\n    const s = scriptState(script.id);\n    const li = document.createElement('li');\n    let text;\n    let ok;\n    if (s.wrong) { text = script.wrongOutcome; ok = false; }\n    else if (s.spoiled) { text = 'The refrigerated stock warmed past the safe limit, so this one could not be filled today.'; ok = false; }\n    else if (!s.labeled) { text = 'This one never made it over the counter.'; ok = false; }\n    else if (s.caughtAt === 'scanner') { text = 'Handed over correctly. The second scan caught a wrong read before anyone saw it.'; ok = true; }\n    else if (s.caughtAt === 'check') { text = 'Handed over correctly. The record check caught a wrong read before anyone saw it.'; ok = true; }\n    else { text = 'Handed over correctly.'; ok = true; }\n\n    li.className = ok ? 'met' : 'unmet';\n    li.appendChild(makeText('span', 'call-name', script.name));\n    li.appendChild(makeText('span', 'call-text', text));\n    els.outcomes.appendChild(li);\n  });\n}\n\nfunction renderReport() {\n  const filed = state.scripts.filter(function (s) { return s.filed; }).length;\n  const detail = copyDetailAverage();\n  const wrong = state.scripts.filter(function (s) { return s.wrong; }).length;\n\n  const rows = [\n    { name: 'Prescriptions filed', value: `${nf.format(filed)} of ${nf.format(SCRIPTS.length)}`, met: filed === SCRIPTS.length },\n    { name: 'Finished before 1:00 PM', value: state.endReason === 'finished' ? `Done at ${clockText()}` : `Stopped at ${clockText()}`, met: state.endReason === 'finished' },\n    { name: 'Prescriptions that went out wrong', value: nf.format(wrong), met: wrong === 0 },\n    { name: 'Refrigerated medicine', value: state.spoiled ? 'Thrown out' : 'Still good', met: !state.spoiled },\n    { name: 'How legible the paper copies were', value: `${nf.format(detail)} out of 100`, met: detail >= USEFUL_SCAN_SCORE },\n    { name: 'Prescriptions done over', value: nf.format(state.redone), met: state.redone === 0 }\n  ];\n\n  const passed = rows.every(function (r) { return r.met; });\n  els.reportHeadline.textContent = passed ? 'Layla got through the morning' : 'The counter came up short';\n  els.verdict.textContent = passed\n    ? `All ${nf.format(rows.length)} goals met`\n    : `${nf.format(rows.filter(function (r) { return !r.met; }).length)} of ${nf.format(rows.length)} goals missed`;\n  els.verdict.className = passed ? 'verdict good' : 'verdict';\n\n  if (state.endReason === 'clock') els.reportSub.textContent = `It hit ${clockText()} with people still waiting.`;\n  else if (passed) els.reportSub.textContent = 'Four people went home with the right medicine and the records are filed.';\n  else els.reportSub.textContent = 'She finished, but something did not go the way it should have.';\n\n  clearChildren(els.reportList);\n  rows.forEach(function (row) {\n    const li = document.createElement('li');\n    li.className = row.met ? 'met' : 'unmet';\n    li.appendChild(makeText('span', 'rep-name', row.name));\n    li.appendChild(makeText('span', 'rep-val', row.met ? row.value : `${row.value} (not enough)`));\n    els.reportList.appendChild(li);\n  });\n\n  renderOutcomes();\n  renderTally();\n\n  clearChildren(els.reportNotes);\n  const notes = [];\n  const wasted = wastedMenuMinutes();\n  const caught = state.scripts.filter(function (s) { return s.caughtAt !== null; }).length;\n\n  if (wrong > 0) {\n    notes.push(`${nf.format(wrong)} prescriptions went out wrong and nobody caught them. The scanner was repaired last week, so the hardware was fine. The software that reads it was the part nobody tested.`);\n  }\n  if (state.redone > 0 && wrong === 0) {\n    notes.push('One patient caught the mistake and brought it back. That is not a safety system, that is luck, and the next one might not notice.');\n  }\n  if (caught > 0) {\n    notes.push(`${nf.format(caught)} wrong reads were caught before anyone saw them. Either the double scan or the full record check was enough on its own, which is exactly why a place like this runs both.`);\n  }\n  if (state.settings.scanner === 'compare' && state.settings.check === 'full') {\n    notes.push('Both checks ran on every prescription. That cost about 9 minutes each, and it is the reason nothing left this counter wrong.');\n  }\n  if (state.spoiled) {\n    notes.push(`The fridge crossed ${nf.format(FRIDGE_SPOIL)} degrees. The number on the status bar was never wrong, it was just old, and by the time an hourly reading showed the problem the stock was already gone.`);\n  }\n  if (state.settings.backup === 'daytime') {\n    notes.push('The backup ran through the whole morning. It was not broken, it was just doing its job at the worst possible time.');\n  }\n  if (state.settings.filing === 'end') {\n    notes.push(`Filing waited until closing, which is when every other pharmacy in the city files too. The same records cost ${nf.format(FILE_END_MINUTES_PER_RX)} minutes each instead of ${nf.format(FILE_NOW_MINUTES)}.`);\n  }\n  if (state.settings.quality === 'full' && state.copyUnits > 0) {\n    notes.push('Every paper copy was saved at full page quality, which is why the drive filled up.');\n  }\n  if (detail > 0 && detail < USEFUL_SCAN_SCORE) {\n    notes.push('The copies were small and unreadable. The insurer needs to see the signature and the stamp, and text alone does not pay a claim.');\n  }\n  if (wasted >= 3) {\n    notes.push(`${nf.format(wasted)} minutes went into settings that do not affect speed, storage, the fridge, or whether a mistake gets caught.`);\n  }\n  if (state.missedHistory) {\n    notes.push('Mr. Odeh asked to see what he was given last spring. That copy was on the archive disk in the back room.');\n  }\n  if (openRecords() >= 2) {\n    notes.push(`She finished with ${nf.format(openRecords())} records still open, which is why the machine never sped back up.`);\n  }\n  notes.forEach(function (t) { els.reportNotes.appendChild(makeText('p', 'report-note', t)); });\n\n  clearChildren(els.questions);\n  QUESTIONS.forEach(function (q) { els.questions.appendChild(makeText('li', null, q)); });\n}\n\n/* ================= views ================= */\n\nfunction render() {\n  /* Each view is a separate screen, so switching to one should start it at the\n     top rather than inheriting wherever the last screen was scrolled to. */\n  viewJustChanged = renderedView !== state.view;\n  renderedView = state.view;\n\n  const chrome = state.view !== 'brief';\n  els.statusbar.hidden = !chrome;\n  els.procbar.hidden = !chrome;\n  els.tabbar.hidden = !chrome || state.over;\n  els.resetBtn.hidden = !chrome;\n  if (chrome) renderStatus();\n\n  Object.keys(els.views).forEach(function (key) { els.views[key].hidden = key !== state.view; });\n\n  if (state.view === 'brief') renderGoals();\n  if (state.view === 'counter') renderCounterView();\n  if (state.view === 'settings') renderSettings();\n  if (state.view === 'report') renderReport();\n\n  els.tabs.forEach(function (tab) {\n    if (tab.dataset.tab === state.view) tab.setAttribute('aria-current', 'page');\n    else tab.removeAttribute('aria-current');\n  });\n\n  if (viewJustChanged) els.body.scrollTop = 0;\n}\n\nfunction focusMain() {\n  const view = els.views[state.view];\n  if (!view) return;\n  const first = view.querySelector('.btn') || view.querySelector('button');\n  if (!first) return;\n  /* On a fresh screen, keep the scroll at the top instead of letting focus drag\n     the page down to whatever control happens to be first. Inside a screen, let\n     focus scroll normally so the control the student just used stays visible. */\n  first.focus({ preventScroll: viewJustChanged });\n  if (viewJustChanged) els.body.scrollTop = 0;\n  viewJustChanged = false;\n}\n\nlet sheetReturnFocus = null;\n\nfunction openSheet() {\n  if (busy) return;\n  sheetReturnFocus = document.activeElement;\n  els.sheet.hidden = false;\n  els.sheetYes.focus();\n}\n\nfunction closeSheet() {\n  els.sheet.hidden = true;\n  if (sheetReturnFocus && sheetReturnFocus.focus) sheetReturnFocus.focus();\n  sheetReturnFocus = null;\n}\n\n/* Keeps Tab inside the dialog while it is open, since the rest of the screen\n   stays in the document behind it. */\nfunction trapSheetFocus(event) {\n  if (els.sheet.hidden) return;\n  if (event.key === 'Escape') { closeSheet(); return; }\n  if (event.key !== 'Tab') return;\n  const stops = [els.sheetYes, els.sheetNo];\n  const first = stops[0];\n  const last = stops[stops.length - 1];\n  if (event.shiftKey && document.activeElement === first) {\n    event.preventDefault();\n    last.focus();\n  } else if (!event.shiftKey && document.activeElement === last) {\n    event.preventDefault();\n    first.focus();\n  }\n}\n\nfunction confirmRestart() {\n  closeSheet();\n  restart();\n}\n\nfunction goTab(name) {\n  if (busy || state.over) return;\n  if (name !== 'settings') state.justFixed = null;\n  state.view = name;\n  render();\n  focusMain();\n}\n\nfunction renderGoals() {\n  clearChildren(els.briefGoals);\n  GOALS.forEach(function (text) {\n    const li = document.createElement('li');\n    li.appendChild(icon('a-check', 'goal-icon'));\n    li.appendChild(makeText('span', null, text));\n    els.briefGoals.appendChild(li);\n  });\n}\n\nfunction startMorning() {\n  syncProblem();\n  state.view = 'counter';\n  render();\n  focusMain();\n}\n\n/* A reset drops the student back on the scenario screen, so the setup and the\n   goals are in front of them again before the second attempt. */\nfunction restart() {\n  els.sheet.hidden = true;\n  renderedView = null;\n  state = freshState();\n  render();\n  focusMain();\n}\n\n/* ================= boot ================= */\n\nfunction cacheElements() {\n  els.statusbar = document.querySelector('.statusbar');\n  els.body = document.querySelector('.body');\n  els.procbar = document.querySelector('.procbar');\n  els.clock = document.getElementById('stat-clock');\n  els.fridge = document.getElementById('stat-fridge');\n  els.drive = document.getElementById('stat-drive');\n  els.speed = document.getElementById('stat-speed');\n  els.gaugeFridge = document.getElementById('gauge-fridge');\n  els.gaugeDrive = document.getElementById('gauge-drive');\n  els.procFill = document.getElementById('procbar-fill');\n  els.views = {\n    brief: document.getElementById('view-brief'),\n    counter: document.getElementById('view-counter'),\n    settings: document.getElementById('view-settings'),\n    report: document.getElementById('view-report')\n  };\n  els.banner = document.getElementById('banner');\n  els.counter = document.getElementById('counter');\n  els.counterChip = document.getElementById('counter-chip');\n  els.detail = document.getElementById('detail');\n  els.finish = document.getElementById('finish');\n  els.symptom = document.getElementById('symptom');\n  els.settingsNote = document.getElementById('settings-note');\n  els.groups = document.getElementById('groups');\n  els.reportHeadline = document.getElementById('report-headline');\n  els.reportSub = document.getElementById('report-sub');\n  els.verdict = document.getElementById('verdict');\n  els.reportList = document.getElementById('report-list');\n  els.outcomes = document.getElementById('outcomes');\n  els.tally = document.getElementById('tally');\n  els.reportNotes = document.getElementById('report-notes');\n  els.questions = document.getElementById('questions');\n  els.tabbar = document.getElementById('tabbar');\n  els.tabDot = document.getElementById('tab-dot');\n  els.briefGoals = document.getElementById('brief-goals');\n  els.resetBtn = document.getElementById('reset-btn');\n  els.sheet = document.getElementById('sheet');\n  els.sheetYes = document.getElementById('sheet-yes');\n  els.sheetNo = document.getElementById('sheet-no');\n  els.tabs = Array.prototype.slice.call(document.querySelectorAll('.tab'));\n}\n\nfunction bindEvents() {\n  document.getElementById('start-btn').addEventListener('click', startMorning);\n  document.getElementById('again-btn').addEventListener('click', restart);\n  els.resetBtn.addEventListener('click', openSheet);\n  els.sheetYes.addEventListener('click', confirmRestart);\n  els.sheetNo.addEventListener('click', closeSheet);\n  document.addEventListener('keydown', trapSheetFocus);\n  els.tabs.forEach(function (tab) {\n    tab.addEventListener('click', function () { goTab(tab.dataset.tab); });\n  });\n}\n\nfunction init() {\n  try {\n    cacheElements();\n    bindEvents();\n    state = freshState();\n    render();\n  } catch (error) {\n    /* Students get a plain message; the real error goes to the console so\n       whoever is fixing it can see what actually broke. */\n    console.error('ScriptCheck could not start.', error);\n    const p = document.createElement('p');\n    p.textContent = 'This activity could not load. Refresh the page, and tell your teacher if it happens again.';\n    document.body.insertBefore(p, document.body.firstChild);\n  }\n}\n\ninit();",
          "folderId": "0",
          "active": true
        },
