<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-04-07T23:29:52.000Z",
  "level_num": "custom",
  "user_id": 18762,
  "properties": {
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\">\n    <title>The Forgotten Labyrinth: A CYOA Tale</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <div class=\"container\">\n      <div class=\"image-section\">\n        <img id=\"img-sword-forest\"  class=\"hide\" src=\"forest-sword.jpg\"  alt=\"Deep inside the Forgotten Forest, a sword appears.\">\n        <img id=\"img-sword-road\"    class=\"hide\" src=\"forest-shield.jpg\" alt=\"Deep inside the Forgotten Forest, a shield appears.\">\n        \n        <img id=\"img-shield-forest\" class=\"hide\" src=\"road-sword.jpg\"   alt=\"Along the Wandering Road, a sword appears.\">\n        <img id=\"img-shield-road\"   class=\"hide\" src=\"road-shield.jpg\"  alt=\"Along the Wandering Road, a shield appears.\">\n      </div>\n\n      <div class=\"questions-section\">\n        <header>\n          <h1>The Journey Begins</h1>\n          <p class=\"story-intro\">The mist clears at the edge of the kingdom. You must make your first decision.</p>\n        </header>\n\n        <div class=\"question-group\">\n          <p class=\"question-text\">Which path do you choose?</p>\n          <div class=\"button-group\">\n            <button id=\"choice-forest\" class=\"btn-action\">The Forgotten Forest</button>\n            <button id=\"choice-road\"   class=\"btn-action\">The Wandering Road</button>\n          </div>\n        </div>\n\n        <div class=\"question-group\">\n          <p class=\"question-text\">You come across two items in the path but you can only take one. Which do you choose?</p>\n          <div class=\"button-group\">\n            <button id=\"choice-sword\"  class=\"btn-action\">Sword</button>\n            <button id=\"choice-shield\" class=\"btn-action\">Shield</button>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "/* General Setup */\nbody {\n  margin: 0;\n  padding: 0;\n  min-height: 100vh;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  background: radial-gradient(circle at center, #1a1a2e 0%, #0f0f1a 100%);\n  color: #e0e0ff;\n  font-family: 'Georgia', serif;\n  overflow-x: hidden;\n}\n\n/* Container with a \"floating\" feel */\n.container {\n  max-width: 800px;\n  width: 90%;\n  background: rgba(255, 255, 255, 0.03);\n  backdrop-filter: blur(10px);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  border-radius: 20px;\n  padding: 40px;\n  box-shadow: 0 0 30px rgba(0, 0, 0, 0.5), 0 0 15px rgba(100, 100, 255, 0.1);\n  text-align: center;\n}\n\n/* Image Section - The Crystal Ball effect */\n.image-section {\n  position: relative;\n  height: 300px;\n  margin-bottom: 30px;\n  border-radius: 15px;\n  overflow: hidden;\n  border: 1px solid rgba(180, 160, 255, 0.3);\n  box-shadow: inset 0 0 20px rgba(0, 0, 0, 1);\n}\n\n.image-section img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: opacity 1s ease-in-out, transform 2s ease-out;\n}\n\n/* Hidden state for smooth fading */\n.hide {\n  display: none;\n  opacity: 0;\n}\n\n/* Narrative Typography */\nh1 {\n  font-variant: small-caps;\n  letter-spacing: 4px;\n  color: #b3cde0;\n  text-shadow: 0 0 10px rgba(179, 205, 224, 0.5);\n  margin-bottom: 10px;\n}\n\n.story-intro {\n  font-style: italic;\n  color: #a0a0c0;\n  margin-bottom: 30px;\n}\n\n.question-text {\n  font-size: 1.2rem;\n  margin: 20px 0;\n  color: #d1d1f0;\n}\n\n/* Magical Buttons */\n.button-group {\n  display: flex;\n  justify-content: center;\n  gap: 20px;\n  margin-bottom: 30px;\n}\n\n.btn-action {\n  background: rgba(40, 40, 80, 0.4);\n  color: #cbd5e0;\n  border: 1px solid #4a5568;\n  padding: 12px 25px;\n  border-radius: 30px;\n  cursor: pointer;\n  font-family: inherit;\n  font-size: 1rem;\n  transition: all 0.4s ease;\n  position: relative;\n  overflow: hidden;\n}\n\n.btn-action:hover {\n  background: rgba(100, 100, 255, 0.2);\n  border-color: #a0a0ff;\n  color: #ffffff;\n  box-shadow: 0 0 15px rgba(140, 140, 255, 0.4);\n  transform: translateY(-2px);\n}\n\n.btn-action:active {\n  transform: translateY(1px);\n}\n\n.btn-action.btn-primary {\n  background: rgba(100, 100, 255, 0.6) !important; /* Brighter magical glow */\n  border-color: #a0a0ff !important;\n  color: #ffffff !important;\n  box-shadow: 0 0 20px rgba(140, 140, 255, 0.6);\n  transform: scale(1.05); /* Slightly grows the button to show it's active */\n}\n\n/* Decorative Horizontal Rule */\nhr {\n  border: 0;\n  height: 1px;\n  background: linear-gradient(to right, transparent, rgba(255,255,255,0.2), transparent);\n  margin: 20px 0;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "// The variables start as 'null' so no button is selected by default.\nlet locationChoice = null;\nlet itemChoice = null;\n\n// Reference the HTML elements we want to control.\nconst forestBtn = document.getElementById(\"choice-forest\");\nconst roadBtn   = document.getElementById(\"choice-road\");\nconst swordBtn  = document.getElementById(\"choice-sword\");\nconst shieldBtn = document.getElementById(\"choice-shield\");\n\nconst imgForestSword  = document.getElementById(\"img-sword-forest\");\nconst imgForestShield = document.getElementById(\"img-sword-road\");\nconst imgRoadSword    = document.getElementById(\"img-shield-forest\");\nconst imgRoadShield   = document.getElementById(\"img-shield-road\");\n\n// This function runs every time a button is clicked. \n// It checks the state and updates the screen so it matches.\nconst updateStory = (location, item) => {\n  \n  // Update state variables only if a new value was passed in\n  if (location !== undefined) locationChoice = location;\n  if (item !== undefined) itemChoice = item;\n\n  // RESET: Remove highlight from all buttons\n  forestBtn.classList.remove(\"btn-primary\");\n  roadBtn.classList.remove(\"btn-primary\");\n  swordBtn.classList.remove(\"btn-primary\");\n  shieldBtn.classList.remove(\"btn-primary\");\n  \n  // RESET: Hide all images\n  imgForestSword.classList.replace(\"show\", \"hide\");\n  imgForestShield.classList.replace(\"show\", \"hide\");\n  imgRoadSword.classList.replace(\"show\", \"hide\");\n  imgRoadShield.classList.replace(\"show\", \"hide\");\n\n  // DECISION TREE LOGIC\n\n\n\n\n\n\n\n// Event handlers: Pass the choice string for the specific button clicked\nforestBtn.addEventListener(\"click\", () => updateStory(\"forest\", undefined));\nroadBtn.addEventListener(\"click\", () => updateStory(\"road\", undefined));\nswordBtn.addEventListener(\"click\", () => updateStory(undefined, \"sword\"));\nshieldBtn.addEventListener(\"click\", () => updateStory(undefined, \"shield\"));\n\n// Call once on load to initialize the screen\nupdateStory();",
          "folderId": "0",
          "active": true
        },
