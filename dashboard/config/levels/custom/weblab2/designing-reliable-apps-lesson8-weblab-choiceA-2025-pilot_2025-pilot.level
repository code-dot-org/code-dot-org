  "properties": {
    "display_name": "The Apology",
    "bubble_choice_description": "Implement a polite, non-technical apology message.",
    "thumbnail_url": "https://images.code.org/72df7689161e48459b9a89eb88ee20b5-Pasted Graphic.png",
