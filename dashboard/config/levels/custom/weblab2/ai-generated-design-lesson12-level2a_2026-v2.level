        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Pete's Pizza</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <header class=\"site-header\">\n    <div class=\"logo-group\">\n      <img src=\"images/icons/home-icon.png\" alt=\"\" class=\"logo-icon\" />\n      <h1>Pete's Pizza</h1>\n    </div>\n\n    <nav class=\"main-nav\" aria-label=\"Main navigation\">\n     <ul>\n      <li><a href=\"index.html\"><img src=\"images/icons/home-icon.png\" class=\"nav-icon\" /> Home</a></li>\n      <li><a href=\"menu.html\"><img src=\"images/icons/menu-icon.png\" class=\"nav-icon\" /> Menu</a></li>\n      <li><a href=\"#\"><img src=\"images/icons/menu-icon.png\" class=\"nav-icon\" /> Specials</a></li>\n      <li><a href=\"#\"><img src=\"images/icons/menu-icon.png\" class=\"nav-icon\" /> Catering</a></li>\n      <li><a href=\"#\"><img src=\"images/icons/menu-icon.png\" class=\"nav-icon\" /> Locations</a></li>\n    </ul>\n    </nav>\n  </header>\n\n  <main>\n    <section class=\"hero\">\n      <div class=\"hero-text\">\n        <p class=\"eyebrow\">Fresh. Hot. Local.</p>\n        <h2>Pizza Night Done Right</h2>\n        <p>\n          From classic pepperoni to veggie-loaded favorites, Pete’s Pizza serves\n          hand-tossed pies made with fresh ingredients and big flavor.\n        </p>\n        <a href=\"menu.html\" class=\"button\">View the Menu</a>\n      </div>\n\n      <div class=\"hero-image\">\n        <img src=\"images/pizza-hero.jpg\" alt=\"Fresh pizza on a wooden table\" />\n      </div>\n    </section>\n\n    <section class=\"featured-menu\">\n      <div class=\"section-heading\">\n        <h2>Popular Pizzas</h2>\n        <p>Customer favorites that keep people coming back.</p>\n      </div>\n\n      <div class=\"card-grid\">\n        <article class=\"pizza-card\">\n          <img src=\"images/pepperoni-card.jpg\" alt=\"Pepperoni pizza\" />\n          <div class=\"card-content\">\n            <h3>Pepperoni Classic</h3>\n            <p>\n              Crispy pepperoni, melted mozzarella, and our signature tomato sauce.\n            </p>\n            <p class=\"price\">$14.99</p>\n          </div>\n        </article>\n\n        <article class=\"pizza-card\">\n          <img src=\"images/veggie-card.jpg\" alt=\"Veggie pizza\" />\n          <div class=\"card-content\">\n            <h3>Garden Veggie</h3>\n            <p>\n              Bell peppers, mushrooms, onions, olives, and a blend of cheeses.\n            </p>\n            <p class=\"price\">$15.99</p>\n          </div>\n        </article>\n\n        <article class=\"pizza-card\">\n          <img src=\"images/combination-card.jpg\" alt=\"Combination pizza\" />\n          <div class=\"card-content\">\n            <h3>House Combination</h3>\n            <p>\n              Pepperoni, sausage, mushrooms, onions, and green peppers on a golden crust.\n            </p>\n            <p class=\"price\">$17.99</p>\n          </div>\n        </article>\n      </div>\n    </section>\n\n    <section class=\"about-preview\">\n      <div class=\"about-text\">\n        <h2>Made for Sharing</h2>\n        <p>\n          Pete’s Pizza has been serving neighborhood families since 1998. We keep\n          it simple: fresh dough, quality toppings, and a warm, welcoming table.\n        </p>\n          <a href=\"menu.html\" class=\"button secondary\">See Full Menu</a>\n      </div>\n\n      <div class=\"about-image\">\n        <img src=\"images/square-pizza-card.jpg\" alt=\"Square pizza ready to serve\" />\n      </div>\n    </section>\n  </main>\n\n  <footer class=\"site-footer\">\n    <div class=\"footer-item\">\n      <img src=\"images/icons/location-icon.png\" alt=\"\" class=\"footer-icon\" />\n      <p>123 Main Street, Hometown, USA</p>\n    </div>\n\n    <div class=\"footer-item\">\n      <img src=\"images/icons/phone-icon.png\" alt=\"\" class=\"footer-icon\" />\n      <p>(555) 123-4567</p>\n    </div>\n\n    <div class=\"footer-item\">\n      <img src=\"images/icons/clock-icon.png\" alt=\"\" class=\"footer-icon\" />\n      <p>Open Daily: 11:00 AM - 10:00 PM</p>\n    </div>\n  </footer>\n</body>\n</html>",
