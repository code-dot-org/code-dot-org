        "15": {
          "id": "15",
          "name": "menu.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Pete's Pizza - Menu</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <header class=\"site-header\">\n    <div class=\"logo-group\">\n      <img src=\"images/icons/home-icon.png\" alt=\"\" class=\"logo-icon\" />\n      <h1>Pete's Pizza</h1>\n    </div>\n\n    <nav class=\"main-nav\" aria-label=\"Main navigation\">\n      <ul>\n        <li><a href=\"index.html\"><img src=\"images/icons/home-icon.png\" alt=\"\" class=\"nav-icon\" /> Home</a></li>\n        <li><a href=\"menu.html\"><img src=\"images/icons/menu-icon.png\" alt=\"\" class=\"nav-icon\" /> Menu</a></li>\n      </ul>\n    </nav>\n  </header>\n\n  <main>\n    <section class=\"menu-hero\">\n      <h2>Our Full Menu</h2>\n      <p>Choose from our classic favorites and specialty pizzas.</p>\n    </section>\n\n    <!-- Classics -->\n    <section class=\"menu-section\">\n      <h3>Classics</h3>\n      <div class=\"card-grid\">\n        <article class=\"pizza-card\">\n          <img src=\"images/pepperoni-card.jpg\" alt=\"Pepperoni pizza\" />\n          <div class=\"card-content\">\n            <h4>Pepperoni Classic</h4>\n            <p>Crispy pepperoni with mozzarella and tomato sauce.</p>\n            <p class=\"price\">$14.99</p>\n          </div>\n        </article>\n\n        <article class=\"pizza-card\">\n          <img src=\"images/combination-card.jpg\" alt=\"Combination pizza\" />\n          <div class=\"card-content\">\n            <h4>House Combination</h4>\n            <p>Pepperoni, sausage, mushrooms, onions, and green peppers.</p>\n            <p class=\"price\">$17.99</p>\n          </div>\n        </article>\n\n        <article class=\"pizza-card\">\n          <img src=\"images/square-pizza-card.jpg\" alt=\"Square pizza\" />\n          <div class=\"card-content\">\n            <h4>Deep Dish Special</h4>\n            <p>Thick crust loaded with cheese and savory toppings.</p>\n            <p class=\"price\">$18.99</p>\n          </div>\n        </article>\n      </div>\n    </section>\n\n    <!-- Veggie Options -->\n    <section class=\"menu-section\">\n      <h3>Veggie Favorites</h3>\n      <div class=\"card-grid\">\n        <article class=\"pizza-card\">\n          <img src=\"images/veggie-card.jpg\" alt=\"Veggie pizza\" />\n          <div class=\"card-content\">\n            <h4>Garden Veggie</h4>\n            <p>Bell peppers, mushrooms, onions, olives, and cheese.</p>\n            <p class=\"price\">$15.99</p>\n          </div>\n        </article>\n\n        <article class=\"pizza-card\">\n          <img src=\"images/veggie-card-2.jpg\" alt=\"Veggie pizza variety\" />\n          <div class=\"card-content\">\n            <h4>Roasted Veggie</h4>\n            <p>Roasted zucchini, eggplant, and tomatoes on a crisp crust.</p>\n            <p class=\"price\">$16.99</p>\n          </div>\n        </article>\n      </div>\n    </section>\n\n    <!-- Special -->\n    <section class=\"menu-section special\">\n      <h3>Today's Special</h3>\n      <p class=\"special-text\">\n        Buy one large pizza and get a second half off. Limited time only!\n      </p>\n    </section>\n  </main>\n\n  <footer class=\"site-footer\">\n    <div class=\"footer-item\">\n      <img src=\"images/icons/location-icon.png\" alt=\"\" class=\"footer-icon\" />\n      <p>123 Main Street, Hometown, USA</p>\n    </div>\n\n    <div class=\"footer-item\">\n      <img src=\"images/icons/phone-icon.png\" alt=\"\" class=\"footer-icon\" />\n      <p>(555) 123-4567</p>\n    </div>\n\n    <div class=\"footer-item\">\n      <img src=\"images/icons/clock-icon.png\" alt=\"\" class=\"footer-icon\" />\n      <p>Open Daily: 11:00 AM - 10:00 PM</p>\n    </div>\n  </footer>\n</body>\n</html>",
