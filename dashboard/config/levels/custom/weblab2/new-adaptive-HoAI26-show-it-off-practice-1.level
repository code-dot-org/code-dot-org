          "name": "index.html",
          "contents": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Your Site Replay</title><link rel=\"stylesheet\" href=\"style.css\"></head><body><h1>Your Site: An Hour Replayed</h1><p>Slide through your project's history and see the skills you've gained!</p><div class=\"replay-container\"><div class=\"timeline\"><label for=\"version-slider\">Version History:</label><input type=\"range\" id=\"version-slider\" min=\"1\" max=\"5\" value=\"1\" step=\"1\"><span id=\"current-version-label\">Version 1</span></div><div class=\"site-preview\"><h2>Preview: <span id=\"preview-title\">Initial Draft</span></h2><div class=\"mock-site-content\"></div></div><div class=\"skill-badges\"><h3>Skills Unlocked:</h3><div id=\"badges-display\"></div></div></div><script src=\"script.js\"></script></body></html>",
