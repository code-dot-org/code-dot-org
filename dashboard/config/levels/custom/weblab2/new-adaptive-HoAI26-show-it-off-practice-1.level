        "9ce13459-5fe7-4775-b96e-e327b541971b": {
          "id": "9ce13459-5fe7-4775-b96e-e327b541971b",
          "name": "style.css",
          "contents": "body { font-family: Arial, sans-serif; display: flex; flex-direction: column; align-items: center; min-height: 100vh; background-color: #f0f2f5; color: #333; margin: 0; padding: 20px; box-sizing: border-box; } h1 { color: #0056b3; margin-bottom: 10px; } p { margin-bottom: 25px; text-align: center; max-width: 600px; } .replay-container { background-color: #fff; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); width: 90%; max-width: 700px; text-align: center; } .timeline { margin-bottom: 30px; border-bottom: 1px solid #eee; padding-bottom: 20px; } .timeline label { display: block; margin-bottom: 10px; font-weight: bold; color: #555; } #version-slider { width: 80%; margin: 0 auto; display: block; } #current-version-label { display: block; margin-top: 10px; font-size: 1.1em; font-weight: bold; color: #007bff; } .site-preview { background-color: #f9f9f9; border: 1px solid #ddd; padding: 20px; border-radius: 8px; margin-bottom: 30px; } .site-preview h2 { color: #4CAF50; margin-top: 0; } .mock-site-content { height: 150px; background-color: #e0e0e0; border: 1px dashed #bbb; display: flex; align-items: center; justify-content: center; color: #666; font-style: italic; } .skill-badges h3 { color: #FF9800; margin-top: 0; margin-bottom: 15px; } #badges-display { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; min-height: 40px; } .badge { background-color: #007bff; color: white; padding: 8px 15px; border-radius: 20px; font-size: 0.9em; display: inline-flex; align-items: center; } .badge:hover { background-color: #0056b3; transform: scale(1.05); transition: all 0.2s ease; }",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "613006a6-f9dc-475d-8ff0-9f5e5a3d47ea": {
          "id": "613006a6-f9dc-475d-8ff0-9f5e5a3d47ea",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => { const versionSlider = document.getElementById('version-slider'); const currentVersionLabel = document.getElementById('current-version-label'); const previewTitle = document.getElementById('preview-title'); const mockSiteContent = document.querySelector('.mock-site-content'); const badgesDisplay = document.getElementById('badges-display'); const versionData = { 1: { title: 'Initial Draft', content: 'Version 1: Basic Layout', badges: ['Planning'] }, 2: { title: 'Added Interactivity', content: 'Version 2: Clickable Button', badges: ['Planning', 'Fixing Bugs'] }, 3: { title: 'Styled Content', content: 'Version 3: Colors & Fonts', badges: ['Planning', 'Fixing Bugs', 'Styling'] }, 4: { title: 'Responsive Elements', content: 'Version 4: Dynamic Actions', badges: ['Planning', 'Fixing Bugs', 'Styling', 'Responsiveness'] }, 5: { title: 'Final Polish', content: 'Version 5: Complete Site', badges: ['Planning', 'Fixing Bugs', 'Styling', 'Responsiveness', 'Code Quality'] } }; function updateDisplay(version) { const data = versionData[version]; currentVersionLabel.textContent = `Version ${version}`; previewTitle.textContent = data.title; mockSiteContent.textContent = data.content; badgesDisplay.innerHTML = ''; data.badges.forEach(badgeText => { const badge = document.createElement('span'); badge.classList.add('badge'); badge.textContent = badgeText; badgesDisplay.appendChild(badge); }); } versionSlider.addEventListener('input', (event) => { const currentVersion = parseInt(event.target.value); updateDisplay(currentVersion); }); updateDisplay(1); });",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
