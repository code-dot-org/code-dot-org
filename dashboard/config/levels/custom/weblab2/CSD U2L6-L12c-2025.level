      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html> \n<html> \n<head>\n   <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <!-- content on terrariums -->\n  <h1>Build a Terrarium!</h1> \n  \n  <h3>\n    What's a terrarium?\n  </h3>\n  \n  <p>\n    A terrarium is usually a sealable glass container containing soil and plants, and can be opened for maintenance to access the plants inside. \n  </p> \n  \n  <h6>From Wikipedia</h6>\n\n  <h3>How do they work?</h3>\n  \n  <p> \n    The glass lets the light in, but it also keeps the water inside so there can be a water cycle.  That way your plants get all the sun they need but never lose any water!\n  </p> \n\n  <h3>How can I make one?</h3>\n  \n  <p>\n    Get a big glass jar, and put it on its side, then put your dirt and plants inside.  Then make sure there's enough water and clse up the jar.\n  </p> \n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* 2) Change the code for the h1 tag so that it is aligned to the center of the page */\n/* 3) Change the alignment of the paragraph tag */\nh1 {\n  color: green;\n  font-size: 24px;\n}\nh6 {\n  text-align: right;\n}\np {\n    font-size: 14px;\n}",
          "folderId": "0",
          "active": true
        }
