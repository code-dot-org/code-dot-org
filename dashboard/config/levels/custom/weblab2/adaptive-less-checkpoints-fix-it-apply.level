      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>EXAMPLE SITE Game Night Snack Vote</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <header class=\"page-header\">\n    <h1>✨EXAMPLE SITE✨ Game Night Snack Vote</h1>\n    <p>Pick the snack you want at game night. Press Vote to add your vote.</p>\n  </header>\n\n  <main class=\"snack-list\">\n    <section class=\"snack-card\" aria-labelledby=\"popcorn-title\">\n      <h2 id=\"popcorn-title\">Popcorn</h2>\n      <p class=\"snack-note\">Buttery and easy to share.</p>\n      <p class=\"vote-row\">\n        <span class=\"vote-label\">Votes</span>\n        <span class=\"vote-count\" id=\"popcorn-count\" aria-live=\"polite\">0</span>\n      </p>\n      <button class=\"vote-button\" type=\"button\" data-snack=\"popcorn\">Vote<span class=\"visually-hidden\"> for Popcorn</span></button>\n    </section>\n\n    <section class=\"snack-card\" aria-labelledby=\"nachos-title\">\n      <h2 id=\"nachos-title\">Nachos</h2>\n      <p class=\"snack-note\">Crunchy chips with warm cheese.</p>\n      <p class=\"vote-row\">\n        <span class=\"vote-label\">Votes</span>\n        <span class=\"vote-count\" id=\"nachos-count\" aria-live=\"polite\">0</span>\n      </p>\n      <button class=\"vote-button\" type=\"button\" data-snack=\"popcorn\">Vote<span class=\"visually-hidden\"> for Nachos</span></button>\n    </section>\n\n    <section class=\"snack-card\" aria-labelledby=\"fruit-title\">\n      <h2 id=\"fruit-title\">Fruit cups</h2>\n      <p class=\"snack-note\">Cool, sweet, and no mess.</p>\n      <p class=\"vote-row\">\n        <span class=\"vote-label\">Votes</span>\n        <span class=\"vote-count\" id=\"fruit-count\" aria-live=\"polite\">0</span>\n      </p>\n      <button class=\"vote-button\" type=\"button\" data-snack=\"fruit\">Vote<span class=\"visually-hidden\"> for Fruit cups</span></button>\n    </section>\n  </main>\n\n  <script src=\"script.js\" defer></script>\n</body>\n</html>\n",
          "folderId": "0",
          "active": true
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "var votes = {\n  popcorn: 0,\n  nachos: 0,\n  fruit: 0\n};\n\nfunction addVote(snack) {\n  votes[snack] = votes[snack] + 1;\n  document.getElementById(snack + '-count').textContent = votes[snack];\n}\n\ndocument.querySelectorAll('.vote-button').forEach(function (button) {\n  button.addEventListener('click', function () {\n    addVote(button.dataset.snack);\n  });\n});\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": "/*\n  What is CADS, what was rebuilt, what was approximated\n\n  CADS: the color, type, spacing, shape and shadow values below are copied\n  from the CADS runtime tokens (only the ones this page uses). Every color in\n  the page styles is one of these variables.\n\n  Rebuilt by hand: the card, header band and Vote button. Web Lab cannot run\n  the CADS runtime, so these follow the CADS patterns (white bordered card,\n  light brand band, brand-filled primary button) without using its components.\n\n  Approximated: the button hover color uses --brand-purple-60 directly, since\n  CADS keeps its button hover values inside the component. Geist and Space\n  Grotesk are not loaded in Web Lab, so the font stacks fall back to system\n  fonts.\n*/\n\n:root {\n  /* CADS primitives */\n  --brand-purple-5: #e4e2f8;\n  --brand-purple-50: #4c42cf;\n  --brand-purple-60: #4238c4;\n  --brand-purple-80: #2b1e9f;\n  --neutral-base-black: #121212;\n  --neutral-base-white: #ffffff;\n  --neutral-gray-5: #f1f2f4;\n  --neutral-gray-20: #d3d6da;\n  --neutral-gray-90: #363b40;\n\n  /* CADS semantic colors */\n  --background-neutral-primary: var(--neutral-base-white);\n  --background-neutral-secondary: var(--neutral-gray-5);\n  --background-brand-primary: var(--brand-purple-50);\n  --background-brand-light: var(--brand-purple-5);\n  --border-neutral-primary: var(--neutral-gray-20);\n  --border-focused-primary: var(--brand-purple-50);\n  --text-neutral-primary: var(--neutral-base-black);\n  --text-neutral-secondary: var(--neutral-gray-90);\n  --text-neutral-white-fixed: var(--neutral-base-white);\n  --text-brand-strong: var(--brand-purple-80);\n\n  /* CADS type */\n  --font-family-main: \"Geist\", \"Noto Sans\", sans-serif;\n  --font-family-heading: \"Space Grotesk\", \"Geist\", \"Noto Sans\", sans-serif;\n  --font-weight-semi-bold: 600;\n  --text-body-md: 1rem;\n  --text-body-lg: 1.125rem;\n  --text-heading-lg: 1.75rem;\n  --text-heading-xs: 1.25rem;\n  --leading-body-md: 1.5rem;\n  --leading-heading-lg: 2.25rem;\n  --leading-heading-xs: 1.75rem;\n\n  /* CADS shape, spacing, shadow, control height */\n  --shape-sm: 0.375rem;\n  --shape-md: 0.5rem;\n  --spacing-p-xxs: 0.5rem;\n  --spacing-p-xs: 1rem;\n  --spacing-p-s: 1.5rem;\n  --spacing-p-m: 2rem;\n  --shadow-sm: 0 4px 7px rgb(0 0 0 / 7%), 0 2px 2px rgb(0 0 0 / 7%);\n  --control-height-large: 48px;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-md);\n  line-height: var(--leading-body-md);\n  color: var(--text-neutral-primary);\n  background-color: var(--background-neutral-primary);\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n/* Header band */\n\n.page-header {\n  padding: var(--spacing-p-m) var(--spacing-p-s);\n  background-color: var(--background-brand-light);\n  text-align: center;\n}\n\n.page-header h1 {\n  margin: 0 0 var(--spacing-p-xxs);\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-lg);\n  line-height: var(--leading-heading-lg);\n  color: var(--text-brand-strong);\n}\n\n.page-header p {\n  margin: 0;\n  font-size: var(--text-body-lg);\n  color: var(--text-neutral-secondary);\n}\n\n/* Snack cards */\n\n.snack-list {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));\n  gap: var(--spacing-p-xs);\n  max-width: 56rem;\n  margin: 0 auto;\n  padding: var(--spacing-p-s);\n}\n\n.snack-card {\n  display: flex;\n  flex-direction: column;\n  padding: var(--spacing-p-s);\n  background-color: var(--background-neutral-primary);\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  box-shadow: var(--shadow-sm);\n}\n\n.snack-card h2 {\n  margin: 0 0 var(--spacing-p-xxs);\n  font-size: var(--text-heading-xs);\n  line-height: var(--leading-heading-xs);\n}\n\n.snack-note {\n  margin: 0 0 var(--spacing-p-xs);\n  color: var(--text-neutral-secondary);\n}\n\n.vote-row {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  margin: 0 0 var(--spacing-p-xs);\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  background-color: var(--background-neutral-secondary);\n  border-radius: var(--shape-sm);\n}\n\n.vote-label {\n  font-weight: var(--font-weight-semi-bold);\n  color: var(--text-neutral-secondary);\n}\n\n.vote-count {\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-lg);\n  line-height: var(--leading-heading-lg);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n/* Vote button */\n\n.vote-button {\n  min-height: var(--control-height-large);\n  margin-top: auto;\n  padding: 0 var(--spacing-p-s);\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-md);\n  font-weight: var(--font-weight-semi-bold);\n  color: var(--text-neutral-white-fixed);\n  background-color: var(--background-brand-primary);\n  border: 1px solid var(--background-brand-primary);\n  border-radius: var(--shape-sm);\n  cursor: pointer;\n}\n\n.vote-button:hover {\n  background-color: var(--brand-purple-60);\n  border-color: var(--brand-purple-60);\n}\n\n.vote-button:focus-visible {\n  outline: 2px solid var(--border-focused-primary);\n  outline-offset: 2px;\n}\n\n@media (prefers-reduced-motion: no-preference) {\n  .vote-button {\n    transition: background-color 0.15s ease, border-color 0.15s ease;\n  }\n}\n",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
