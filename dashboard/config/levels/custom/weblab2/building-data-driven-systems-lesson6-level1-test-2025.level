    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>Intro to Map</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n    <script src=\"script.js\" defer></script>\n  </head>\n  <body>\n    <div class=\"container\">\n      <h1>Mapping Numbers</h1>\n      \n      <div class=\"card\">\n        <h2>Original List</h2>\n        <p id=\"original-display\">...</p>\n      </div>\n\n      <div class=\"card\">\n        <h2>Doubled List</h2>\n        <p id=\"doubled-display\">...</p>\n      </div>\n      \n      <p class=\"instructions\">Read the code to see how the second list was created!</p>\n    </div>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// script.js (Starter Code)\n\n// 1) Create an array of numbers\nconst nums = [1, 2, 3, 4, 5];\n\n// 2) Use .map() to create a NEW array with values doubled\nconst doubled = nums.map(x => x * 2);\n\n// 3) Select the HTML elements\nconst originalDisplay = document.querySelector(\"#original-display\");\nconst doubledDisplay = document.querySelector(\"#doubled-display\");\n\n// 4) Update the screen with the arrays\noriginalDisplay.innerHTML = nums;\ndoubledDisplay.innerHTML = doubled;\n",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "@import url('https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap');\n\nbody {\n  font-family: 'Roboto', sans-serif;\n  background-color: #eef2f5;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  height: 100vh;\n  margin: 0;\n  color: #333;\n}\n\n.container {\n  width: 400px;\n  text-align: center;\n}\n\n.card {\n  background: white;\n  border-radius: 10px;\n  padding: 1rem;\n  margin-bottom: 1rem;\n  box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n}\n\nh2 {\n  font-size: 1rem;\n  color: #555;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  margin-top: 0;\n}\n\np {\n  font-size: 1.5rem;\n  font-weight: bold;\n  color: #2980b9;\n  margin: 0.5rem 0;\n}\n\n.instructions {\n  font-size: 0.9rem;\n  color: #7f8c8d;\n  font-weight: normal;\n}",
          "folderId": "0",
