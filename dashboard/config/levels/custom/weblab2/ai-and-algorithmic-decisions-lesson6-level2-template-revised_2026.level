<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-04-11T06:22:57.000Z",
  "level_num": "custom",
  "user_id": 18762,
  "properties": {
    "start_sources": {
      "folders": {
