      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Stream Schedule</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <div class=\"phone-screen\">\n    <header>\n      <h1>LIVE NOW</h1>\n      <p class=\"subtitle\">Weekly Stream Schedule</p>\n    </header>\n\n    <main>\n      <div class=\"stream-card\">\n        <div class=\"stream-info\">\n          <h2 id=\"stream1-title\">Title Here</h2>\n          <p id=\"stream1-content\" class=\"stream-content\">Details...</p>\n          <p class=\"stream-day\">MONDAY</p>\n        </div>\n        <div class=\"stream-image-placeholder\">\n          <span id=\"stream1-img-name\">img.png</span>\n        </div>\n      </div>\n\n      <div class=\"stream-card\">\n        <div class=\"stream-info\">\n          <h2 id=\"stream2-title\">Title Here</h2>\n          <p id=\"stream2-content\" class=\"stream-content\">Details...</p>\n          <p class=\"stream-day\">TUESDAY</p>\n        </div>\n        <div class=\"stream-image-placeholder\">\n          <span id=\"stream2-img-name\">img.png</span>\n        </div>\n      </div>\n\n      <div class=\"stream-card\">\n        <div class=\"stream-info\">\n          <h2 id=\"stream3-title\">Title Here</h2>\n          <p id=\"stream3-content\" class=\"stream-content\">Details...</p>\n          <p class=\"stream-day\">WEDNESDAY</p>\n        </div>\n        <div class=\"stream-image-placeholder\">\n          <span id=\"stream3-img-name\">img.png</span>\n        </div>\n      </div>\n\n      <div class=\"stream-card\">\n        <div class=\"stream-info\">\n          <h2 id=\"stream4-title\">Title Here</h2>\n          <p id=\"stream4-content\" class=\"stream-content\">Details...</p>\n          <p class=\"stream-day\">THURSDAY</p>\n        </div>\n        <div class=\"stream-image-placeholder\">\n          <span id=\"stream4-img-name\">img.png</span>\n        </div>\n      </div>\n\n      <div class=\"stream-card\">\n        <div class=\"stream-info\">\n          <h2 id=\"stream5-title\">Title Here</h2>\n          <p id=\"stream5-content\" class=\"stream-content\">Details...</p>\n          <p class=\"stream-day\">FRIDAY</p>\n        </div>\n        <div class=\"stream-image-placeholder\">\n          <span id=\"stream5-img-name\">img.png</span>\n        </div>\n      </div>\n    </main>\n  </div>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// DOM ELEMENTS\nlet stream1Title = document.querySelector(\"#stream1-title\");\nlet stream1Content = document.querySelector(\"#stream1-content\");\nlet stream1Img = document.querySelector(\"#stream1-img-name\");\n\nlet stream2Title = document.querySelector(\"#stream2-title\");\nlet stream2Content = document.querySelector(\"#stream2-content\");\nlet stream2Img = document.querySelector(\"#stream2-img-name\");\n\nlet stream3Title = document.querySelector(\"#stream3-title\");\nlet stream3Content = document.querySelector(\"#stream3-content\");\nlet stream3Img = document.querySelector(\"#stream3-img-name\");\n\nlet stream4Title = document.querySelector(\"#stream4-title\");\nlet stream4Content = document.querySelector(\"#stream4-content\");\nlet stream4Img = document.querySelector(\"#stream4-img-name\");\n\nlet stream5Title = document.querySelector(\"#stream5-title\");\nlet stream5Content = document.querySelector(\"#stream5-content\");\nlet stream5Img = document.querySelector(\"#stream5-img-name\");\n\n// DATA LISTS (Parallel Arrays)\n// Index 0 belongs to the Monday slot, Index 1 to Tuesday, etc.\nlet titles = [\"Minecraft Monday\", \"Tactics Tuesday\", \"Warzone Wednesday\", \"Throwback Thursday\", \"Fortnite Friday\"];\nlet contents = [\"Survival World.\", \"Ranked play.\", \"Squad wins.\", \"Retro classics.\", \"Community games.\"];\nlet images = [\"/images/one.png\", \"/images/two.png\", \"/images/three.png\", \"/images/four.png\", \"/images/five.png\"];\n\n// DISPLAY LOGIC\nfunction renderFeed() {\n  // Monday Slot (Index 0)\n  stream1Title.textContent = titles[0];\n  stream1Content.textContent = contents[0];\n  stream1Img.textContent = images[0];\n\n  // Tuesday Slot (Index 1)\n  stream2Title.textContent = titles[1];\n  stream2Content.textContent = contents[1];\n  stream2Img.textContent = images[1];\n\n  // Wednesday Slot (Index 2)\n  stream3Title.textContent = titles[2];\n  stream3Content.textContent = contents[2];\n  stream3Img.textContent = images[2];\n\n  // Thursday Slot (Index 3)\n  stream4Title.textContent = titles[3];\n  stream4Content.textContent = contents[3];\n  stream4Img.textContent = images[3];\n\n  // Friday Slot (Index 4)\n  stream5Title.textContent = titles[4];\n  stream5Content.textContent = contents[4];\n  stream5Img.textContent = images[4];\n}\n\n// START APP\nrenderFeed();\n\n// HELPER FUNCTIONS\n\n",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@700&family=Roboto:wght@400;500&display=swap');\n\nbody {\n  background-color: #0F0F12; /* Very dark background */\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  height: 100vh;\n  margin: 0;\n  font-family: 'Roboto', sans-serif;\n  color: white;\n}\n\n.phone-screen {\n  width: 320px;\n  height: 600px;\n  background-color: #1A1A24; /* Dark grey UI */\n  border: 8px solid #000;\n  border-radius: 24px;\n  overflow: hidden;\n  box-shadow: 0 0 30px rgba(138, 43, 226, 0.3); /* Purple glow */\n  display: flex;\n  flex-direction: column;\n}\n\nheader {\n  background: linear-gradient(90deg, #6200EA, #B00020); /* Purple to Red gradient */\n  padding: 25px 20px;\n  text-align: center;\n  border-bottom: 2px solid #000;\n  flex-shrink: 0;\n}\n\nh1 {\n  font-family: 'Orbitron', sans-serif; /* Sci-fi / Tech font */\n  margin: 0;\n  color: #FFF;\n  font-size: 26px;\n  letter-spacing: 2px;\n  text-shadow: 0 0 10px rgba(255,255,255,0.5);\n}\n\n.subtitle {\n  margin: 5px 0 0;\n  color: #E0E0E0;\n  font-size: 11px;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n}\n\nmain {\n  flex: 1;\n  padding: 15px;\n  overflow-y: auto;\n}\n\n.stream-card {\n  background: #2C2C3A;\n  border-left: 4px solid #00E5FF; /* Cyan accent */\n  border-radius: 4px;\n  margin-bottom: 15px;\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  padding: 12px;\n  transition: transform 0.2s;\n}\n\n.stream-card:hover {\n  transform: translateX(5px);\n}\n\n.stream-info {\n  flex: 1;\n  padding-right: 8px;\n}\n\n.stream-card h2 {\n  margin: 0;\n  font-size: 16px;\n  color: #FFF;\n  line-height: 1.2;\n}\n\n.stream-content {\n  margin: 4px 0;\n  font-size: 12px;\n  color: #B0B0B0; /* Light grey for contrast */\n  font-style: italic;\n}\n\n.stream-day {\n  margin: 6px 0 0;\n  font-size: 10px;\n  color: #00E5FF; /* Cyan text */\n  font-weight: bold;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n}\n\n.stream-image-placeholder {\n  width: 55px;\n  height: 55px;\n  background-color: #000;\n  border: 1px solid #444;\n  border-radius: 4px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 10px;\n  color: #777;\n  flex-shrink: 0;\n  text-align: center;\n  word-break: break-all;\n}",
