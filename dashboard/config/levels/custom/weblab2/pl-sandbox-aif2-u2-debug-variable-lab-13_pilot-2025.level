      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Game Stats Tracker</title>\n  <link rel=\"stylesheet\" href=\"styles.css\" />\n</head>\n<body>\n  <main class=\"wrap\">\n    <header class=\"header\">\n      <h1>Game Stats Tracker</h1>\n    </header>\n\n    <section class=\"stats-card\">\n      <!-- Health -->\n      <div class=\"stat health-stat\">\n        <h2>Health</h2>\n        <div id=\"health\" class=\"value\">100</div>\n        <div class=\"buttons\">\n          <button id=\"health-down\" class=\"btn\">−5</button>\n          <button id=\"health-up\" class=\"btn\">+5</button>\n        </div>\n      </div>\n\n      <!-- Strength -->\n      <div class=\"stat\">\n        <h2>Strength</h2>\n        <div id=\"strength\" class=\"value\">0</div>\n        <div class=\"buttons\">\n          <button id=\"strength-down\" class=\"btn\">−2</button>\n          <button id=\"strength-up\" class=\"btn\">+2</button>\n        </div>\n      </div>\n\n      <!-- Level -->\n      <div class=\"stat level-stat\">\n        <h2>Level</h2>\n        <div id=\"level\" class=\"value\">1</div>\n      </div>\n    </section>\n\n    <p class=\"hint\">Tip: Use the + and − buttons to change your stats.</p>\n  </main>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "styles.css",
          "language": "css",
          "contents": ":root {\n  --bg: #0f172a;\n  --card: #f8fafc;\n  --accent: #2563eb;\n  --text: #0b1220;\n  --shadow: 0 10px 30px rgba(2, 6, 23, .3);\n}\n\n* { box-sizing: border-box; }\n\nhtml, body {\n  height: 100%;\n  margin: 0;\n}\n\nbody {\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;\n  background:\n    radial-gradient(1200px 600px at 75% -10%, rgba(37,99,235,.18), transparent 60%),\n    var(--bg);\n  color: var(--text);\n}\n\n.wrap {\n  min-height: 100vh;\n  display: grid;\n  place-items: start center;\n  padding-top: 6vh;\n}\n\n.header h1 {\n  color: #f1f5f9;\n  text-shadow: 0 1px 2px rgba(0,0,0,.3);\n  margin-bottom: 1.5rem;\n  font-size: clamp(1.8rem, 3vw, 2.5rem);\n}\n\n.stats-card {\n  display: grid;\n  gap: 1.5rem;\n  width: min(500px, 90vw);\n  background: var(--card);\n  border-radius: 20px;\n  padding: 1.5rem;\n  box-shadow: var(--shadow);\n  text-align: center;\n}\n\n.stat {\n  display: grid;\n  gap: 0.5rem;\n  justify-items: center;\n}\n\n.stat h2 {\n  margin: 0;\n  font-size: 1.25rem;\n  color: var(--accent);\n}\n\n/* Make \"Health\" label green */\n.health-stat h2 {\n  color: #064e3b;\n}\n\n/* Make \"Level\" label black */\n.level-stat h2 {\n  color: #000;\n}\n\n.value {\n  font-size: 2.5rem;\n  font-weight: 700;\n  border-radius: 10px;\n  width: 120px;\n  padding: 0.5rem 0;\n  background: linear-gradient(180deg, #dbeafe, #bfdbfe); /* default blue */\n  color: var(--text);\n}\n\n/* 🟩 HEALTH — green tones for text and buttons */\n#health.value {\n  background: linear-gradient(180deg, #bbf7d0, #86efac);\n  border: 2px solid #4ade80;\n  color: #064e3b; /* dark green text */\n}\n\n#health ~ .buttons .btn {\n  background: #064e3b; /* dark green buttons */\n  color: #f0fdf4;      /* light text */\n}\n\n#health ~ .buttons .btn:hover {\n  background: #065f46;\n}\n\n#health ~ .buttons .btn:active {\n  transform: scale(0.95);\n}\n\n/* 💪 STRENGTH — stays blue */\n#strength.value {\n  background: linear-gradient(180deg, #dbeafe, #bfdbfe);\n  border: 2px solid #93c5fd;\n  color: #1e3a8a;\n}\n\n/* ⚫ LEVEL — black tones */\n#level.value {\n  background: linear-gradient(180deg, #1e293b, #0f172a);\n  border: 2px solid #000;\n  color: #f8fafc;\n}\n\n.buttons {\n  display: flex;\n  gap: 0.75rem;\n}\n\n.btn {\n  background: var(--accent);\n  color: white;\n  font-size: 1.1rem;\n  font-weight: 700;\n  border: none;\n  border-radius: 10px;\n  width: 60px;\n  height: 45px;\n  cursor: pointer;\n  transition: background 0.2s, transform 0.1s;\n}\n\n.btn:hover {\n  background: #1d4ed8;\n}\n\n.btn:active {\n  transform: scale(0.95);\n}\n\n.hint {\n  margin-top: 1.25rem;\n  color: #cbd5e1;\n  font-size: 0.95rem;\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "// Initialize variables - health, strength, level\nlet health = 100;\nlet strength = 0;\nlet levels = 1;\n\n// Select DOM elements\nconst healthDisplay = document.getElementById('health');\nconst strengthDisplay = document.getElementById('strength');\nconst levelDisplay = document.getElementById('level');\n\n// HEALTH CONTROLS\n// Increase health by 5 when button clicked\ndocument.getElementById('health-up').addEventListener('click', () => {\n  health += 3;\n  healthDisplay.textContent = health;\n});\n\n// Decrease health by 5 when button clicked\ndocument.getElementById('health-down').addEventListener('click', () => {\n  health -= 3;\n  healthDisplay.textContent = health;\n});\n\n// STRENGTH CONTROLS\n// Increase strength by 2 when button clicked\ndocument.getElementById('strength-down').addEventListener('click', () => {\n  strength += 2;\n  strengthDisplay.textContent = strength;\n\n  // Level increases by 1 every time strength hits a multiple of 10\n  if (strength % 10 === 0) {\n    level += 11;\n    levelDisplay.textContent = level;\n  }\n});\n\n// Decrease strength by 2 when button clicked\ndocument.getElementById('strength-up').addEventListener('click', () => {\n  energy -= 2;\n  energyDisplay.textContent = strength;\n});\n",
          "folderId": "0",
          "active": true
        }
      },
