  "properties": {
    "encrypted": "false",
    "long_instructions": "## Use .length\r\n\r\n### Do This:\r\n\r\n1. Use your `favoritesArray` from the previous levels.\r\n\r\n2. Create a variable that stores the total number of items in your array using `.length`.\r\n\r\n3. Create a variable that stores the last item in your array using:\r\n   favoritesArray[favoritesArray.length - 1]\r\n\r\n4. Prompt AI to write code that displays your variables for total count and last item on the page.\r\n\r\n5. Run your code and check your results:\r\n   * Does the total match the number of items?\r\n   * Is the last item correct?",
    "submittable": "false",
    "hide_share_and_remix": "false",
    "disable_edit_run_for_submission": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
