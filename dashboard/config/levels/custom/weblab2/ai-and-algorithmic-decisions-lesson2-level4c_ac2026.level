    "display_name": "Alternate Universe",
    "bubble_choice_description": "Build an Alternate Universe Newsfeed where clicking each universe button updates the headline to show a breaking news story from that world.",
    "thumbnail_url": "https://images.code.org/9626dcb91a13d93da895915eb985ef89-header.png",
