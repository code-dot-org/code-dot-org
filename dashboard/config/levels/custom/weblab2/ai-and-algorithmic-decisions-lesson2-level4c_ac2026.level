        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Alternate Universe Newsfeed</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n    <script defer src=\"script.js\"></script>\n  </head>\n  <body>\n    <h1 class=\"title\">📡 Alternate Universe Newsfeed</h1>\n    <main class=\"container\">\n      <section class=\"left\">\n        <img id=\"image\" class=\"image\" src=\"images/header.png\" alt=\"Alternate universe newsfeed illustration\" />\n      </section>\n      <section class=\"right\">\n        <p class=\"prompt\">Select a universe to see the latest headlines.</p>\n        <h2 id=\"headline\" class=\"headline\">BREAKING: No universe selected.</h2>\n        <div class=\"buttons\">\n          <button id=\"dinosaursButton\" type=\"button\">🦕 Dinosaurs Never Died</button>\n          <button id=\"catsButton\" type=\"button\">🐱 Cats Are in Charge</button>\n          <button id=\"sleepButton\" type=\"button\">😴 No One Needs Sleep</button>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>",
          "folderId": "0",
          "active": true
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\nhtml,\nbody {\n  height: 100%;\n}\nbody {\n  margin: 0;\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n  background: #0f172a;\n  color: #e2e8f0;\n}\n.title {\n  text-align: center;\n  margin: 16px 0 0;\n  font-size: 1.75rem;\n  letter-spacing: 0.5px;\n  color: #38bdf8;\n}\n.container {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 24px;\n  padding: 24px;\n  max-width: 1000px;\n  margin: 0 auto;\n}\n.left {\n  background: #1e293b;\n  border: 1px solid #334155;\n  border-radius: 12px;\n  padding: 16px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n}\n.image {\n  display: block;\n  max-width: 100%;\n  height: auto;\n  border-radius: 8px;\n  object-fit: contain;\n}\n.right {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n.prompt {\n  margin: 0;\n  font-size: 0.95rem;\n  color: #94a3b8;\n}\n.headline {\n  margin: 0;\n  font-size: 1.4rem;\n  line-height: 1.4;\n  color: #f8fafc;\n  border-left: 4px solid #38bdf8;\n  padding-left: 12px;\n}\n.buttons {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  width: 260px;\n  margin-inline: auto;\n}\n.buttons button {\n  padding: 12px 16px;\n  font-size: 1rem;\n  border-radius: 10px;\n  border: 1px solid #38bdf8;\n  background: #1e293b;\n  color: #e2e8f0;\n  cursor: pointer;\n  transition: background-color 120ms ease, color 120ms ease;\n}\n.buttons button:hover {\n  background: #38bdf8;\n  color: #0f172a;\n}\n.buttons button:active {\n  transform: translateY(1px);\n}\n@media (max-width: 800px) {\n  .container {\n    grid-template-columns: 1fr;\n  }\n  .buttons {\n    width: 100%;\n  }\n}",
          "folderId": "0",
          "active": false
        },
