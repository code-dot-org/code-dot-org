    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Study Resource Hub - Text Search</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n\n<body>\n  <header class=\"site-header\">\n    <h1>Study Resource Hub</h1>\n    <p class=\"tagline\">Find the right study resource fast.</p>\n  </header>\n\n  <main>\n    <section class=\"search-section\">\n      <h2>Search Resources</h2>\n\n      <label for=\"queryInput\" class=\"search-label\">Search by title</label>\n\n      <div class=\"search-row\">\n        <input id=\"queryInput\" type=\"text\" placeholder=\"Type a topic, like Quadratics or Plant Cells\">\n        <button id=\"titleSearch\">Search</button>\n        <button id=\"clearSearch\">Clear</button>\n      </div>\n\n      <p class=\"hint\">Try different capitalization, extra spaces, or an empty search to test your code.</p>\n\n      <p class=\"counts\">\n        Matches: <span id=\"matchCount\">0</span> of <span id=\"totalCount\">0</span>\n      </p>\n\n      <p id=\"statusMessage\" class=\"status-message\"></p>\n    </section>\n\n    <section class=\"results-section\">\n      <h2>Results</h2>\n      <div id=\"list\" class=\"card-list\"></div>\n    </section>\n  </main>\n\n\n\n  <script src=\"data.js\"></script>\n  <script src=\"helpers.js\"></script>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* styles.css - Study Resource Hub */\n\nbody {\n  font-family: Arial, sans-serif;\n  margin: 0;\n  padding: 0;\n  background-color: #f5f7fb;\n  color: #222;\n}\n\n.site-header {\n  background-color: #264653;\n  color: white;\n  padding: 16px;\n  text-align: center;\n}\n\n.site-header h1 {\n  margin: 0 0 4px 0;\n}\n\n.tagline {\n  margin: 0;\n  font-size: 0.95rem;\n}\n\nmain {\n  max-width: 900px;\n  margin: 0 auto;\n  padding: 16px;\n}\n\n.search-section {\n  background-color: white;\n  padding: 16px;\n  border-radius: 8px;\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);\n  margin-bottom: 16px;\n}\n\n.search-label {\n  display: block;\n  margin-bottom: 4px;\n  font-weight: bold;\n}\n\n.search-row {\n  display: flex;\n  gap: 8px;\n  margin-bottom: 8px;\n}\n\n#queryInput {\n  flex: 1;\n  padding: 8px;\n  font-size: 1rem;\n  border-radius: 4px;\n  border: 1px solid #ccc;\n}\n\n#titleSearch {\n  padding: 8px 16px;\n  font-size: 1rem;\n  border: none;\n  border-radius: 4px;\n  background-color: #2a9d8f;\n  color: white;\n  cursor: pointer;\n}\n\n#titleSearch:hover {\n  background-color: #21867b;\n}\n\n#clearSearch {\n  padding: 8px 16px;\n  font-size: 1rem;\n  border: none;\n  border-radius: 4px;\n  background-color: #4c5756;\n  color: white;\n  cursor: pointer;\n}\n\n#clearSearch:hover {\n  background-color: #345550;\n}\n\n.hint {\n  font-size: 0.9rem;\n  color: #555;\n}\n\n.counts {\n  font-size: 0.95rem;\n  margin-top: 8px;\n}\n\n.status-message {\n  margin-top: 4px;\n  font-size: 0.9rem;\n  color: #b00020;\n}\n\n.results-section {\n  margin-top: 8px;\n}\n\n.card-list {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));\n  gap: 12px;\n  margin-top: 8px;\n}\n\n.resource-card {\n  background-color: white;\n  padding: 12px;\n  border-radius: 8px;\n  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);\n}\n\n.resource-card h3 {\n  margin-top: 0;\n  margin-bottom: 4px;\n}\n\n.resource-meta {\n  font-size: 0.85rem;\n  color: #555;\n  margin-bottom: 6px;\n}\n\n.tags {\n  margin-top: 4px;\n  font-size: 0.8rem;\n}\n\n.tag {\n  display: inline-block;\n  background-color: #e9f5ff;\n  color: #13567a;\n  padding: 2px 6px;\n  margin: 2px 4px 0 0;\n  border-radius: 4px;\n}\n\n.badge-teacher {\n  display: inline-block;\n  background-color: #ffb703;\n  color: #000;\n  padding: 2px 6px;\n  border-radius: 4px;\n  font-size: 0.75rem;\n  margin-left: 6px;\n}\n\n.site-footer {\n  text-align: center;\n  padding: 12px;\n  font-size: 0.85rem;\n  color: #555;\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const queryInput = document.getElementById(\"queryInput\");\nconst matchCount = document.getElementById(\"matchCount\");\nconst totalCount = document.getElementById(\"totalCount\");\nconst list = document.getElementById(\"list\");\n\nlet displayResources = resources;\n\nconst renderResources = () => {\n  list.innerHTML = \"\";\n\n  displayResources.map((resource) => {\n    createResourceCard(resource);\n  });\n\n  matchCount.textContent = displayResources.length;\n  totalCount.textContent = resources.length;\n\n};\n\nrenderResources();\n\n\n// Search\nconst titleSearch = () => {\n\n\n\n  \n};\n\n\n// Clear\nconst clearSearch = () => {\n\n\n\n  \n};\n\n// Event Handler\ndocument.getElementById(\"titleSearch\").addEventListener(\"click\", titleSearch);\ndocument.getElementById(\"clearSearch\").addEventListener(\"click\", clearSearch);\n",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
          "name": "data.js",
          "contents": "const resources = [\n  {\n    title: \"Quadratics Intro Video\",\n    subject: \"Math\",\n    resourceType: \"video\",\n    gradeLevel: \"Algebra 1\",\n    createdBy: \"Student A\",\n    tags: [\"quadratics\", \"parabolas\"],\n    rating: 4.7,\n    teacherVerified: true,\n    dateUpdated: \"2024-01-10\",\n    lengthMinutes: 12\n  },\n  {\n    title: \"Plant Cells Diagram Notes\",\n    subject: \"Biology\",\n    resourceType: \"notes\",\n    gradeLevel: \"Biology\",\n    createdBy: \"Student B\",\n    tags: [\"plant cells\", \"organelles\"],\n    rating: 4.5,\n    teacherVerified: false,\n    dateUpdated: \"2024-02-03\",\n    lengthMinutes: 20\n  },\n  {\n    title: \"Civil Rights Movement Flashcards\",\n    subject: \"US History\",\n    resourceType: \"flashcards\",\n    gradeLevel: \"10\",\n    createdBy: \"Student C\",\n    tags: [\"civil rights\", \"1960s\"],\n    rating: 4.9,\n    teacherVerified: true,\n    dateUpdated: \"2024-03-18\",\n    lengthMinutes: 15\n  },\n  {\n    title: \"Exponential Functions Practice\",\n    subject: \"Math\",\n    resourceType: \"worksheet\",\n    gradeLevel: \"Algebra 2\",\n    createdBy: \"Student D\",\n    tags: [\"exponentials\"],\n    rating: 4.2,\n    teacherVerified: false,\n    dateUpdated: \"2024-01-25\",\n    lengthMinutes: 25\n  },\n  {\n    title: \"Shakespeare Character Map\",\n    subject: \"English\",\n    resourceType: \"graphic organizer\",\n    gradeLevel: \"10\",\n    createdBy: \"Student E\",\n    tags: [\"macbeth\", \"characters\", \"literature\"],\n    rating: 4.8,\n    teacherVerified: true,\n    dateUpdated: \"2024-02-14\",\n    lengthMinutes: 10\n  },\n  {\n    title: \"Photosynthesis Comic Summary\",\n    subject: \"Biology\",\n    resourceType: \"comic\",\n    gradeLevel: \"9\",\n    createdBy: \"Student F\",\n    tags: [\"photosynthesis\", \"chloroplast\", \"visual\"],\n    rating: 4.6,\n    teacherVerified: false,\n    dateUpdated: \"2024-03-05\",\n    lengthMinutes: 8\n  },\n  {\n    title: \"Intro to Coding Quiz Game\",\n    subject: \"Computer Science\",\n    resourceType: \"interactive quiz\",\n    gradeLevel: \"Intro CS\",\n    createdBy: \"Student G\",\n    tags: [\"coding basics\", \"variables\", \"loops\"],\n    rating: 4.4,\n    teacherVerified: true,\n    dateUpdated: \"2024-04-10\",\n    lengthMinutes: 18\n  },\n  {\n    title: \"World War I Timeline Slides\",\n    subject: \"World History\",\n    resourceType: \"slide deck\",\n    gradeLevel: \"10\",\n    createdBy: \"Student H\",\n    tags: [\"WWI\", \"timeline\", \"alliances\"],\n    rating: 4.3,\n    teacherVerified: false,\n    dateUpdated: \"2024-02-22\",\n    lengthMinutes: 14\n  },\n  {\n    title: \"Geometry Proof Practice Sheet\",\n    subject: \"Math\",\n    resourceType: \"worksheet\",\n    gradeLevel: \"Geometry\",\n    createdBy: \"Student I\",\n    tags: [\"proofs\", \"theorems\", \"logic\"],\n    rating: 4.0,\n    teacherVerified: false,\n    dateUpdated: \"2024-03-12\",\n    lengthMinutes: 30\n  },\n  {\n    title: \"The Great Gatsby Symbolism Notes\",\n    subject: \"English\",\n    resourceType: \"notes\",\n    gradeLevel: \"11\",\n    createdBy: \"Student J\",\n    tags: [\"gatsby\", \"symbolism\", \"themes\"],\n    rating: 4.9,\n    teacherVerified: true,\n    dateUpdated: \"2024-04-01\",\n    lengthMinutes: 22\n  }\n];",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "helpers.js",
          "contents": "const createResourceCard = (item) => {\n  const list = document.getElementById(\"list\");\n\n  const card = document.createElement(\"div\");\n  card.className = \"resource-card\";\n\n  const title = document.createElement(\"h3\");\n  title.textContent = item.title;\n\n  const meta = document.createElement(\"p\");\n  meta.className = \"resource-meta\";\n  meta.textContent = item.subject + \" • \" + item.resourceType + \" • Grade \" + item.gradeLevel;\n\n  const rating = document.createElement(\"p\");\n  rating.className = \"resource-meta\";\n  rating.textContent = \"Rating: \" + item.rating;\n\n  if (item.teacherVerified === true) {\n    const badge = document.createElement(\"span\");\n    badge.className = \"badge-teacher\";\n    badge.textContent = \"Teacher Verified\";\n\n    rating.appendChild(badge);\n  }\n\n  const tags = document.createElement(\"p\");\n  tags.className = \"tags\";\n\n  item.tags.map((tag) => {\n    const tagSpan = document.createElement(\"span\");\n    tagSpan.className = \"tag\";\n    tagSpan.textContent = tag;\n\n    tags.appendChild(tagSpan);\n  });\n\n  card.appendChild(title);\n  card.appendChild(meta);\n  card.appendChild(rating);\n  card.appendChild(tags);\n\n  list.appendChild(card);\n};",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "3",
