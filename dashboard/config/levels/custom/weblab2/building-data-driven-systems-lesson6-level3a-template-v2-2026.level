      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>QuickBite Order Queue</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n\n  <body>\n    <main class=\"phone\">\n      <header class=\"app-header\">\n        <div class=\"brand-icon\">🛍️</div>\n        <div>\n          <h1>QuickBite Order Queue</h1>\n          <p>Manage orders the restaurant is preparing.</p>\n        </div>\n      </header>\n\n      <section class=\"orders-section\">\n        <div class=\"section-header\">\n          <div class=\"section-title\">\n            <span class=\"section-icon\">📋</span>\n            <h2>Current Orders</h2>\n          </div>\n          <span id=\"orderCount\" class=\"order-count\">0 Orders</span>\n        </div>\n\n        <div id=\"orderList\" class=\"order-list\"></div>\n      </section>\n\n      <section class=\"actions-section\">\n        <div class=\"section-title\">\n          <span class=\"section-icon\">⚙️</span>\n          <h2>Queue Actions</h2>\n        </div>\n\n        <div class=\"button-row\">\n          <button id=\"completeOldestButton\" class=\"action-button complete-button\">\n            <span>✓</span>\n            Complete Oldest\n          </button>\n\n          <button id=\"removeNewestButton\" class=\"action-button remove-button\">\n            <span>✕</span>\n            Remove Newest\n          </button>\n        </div>\n      </section>\n    </main>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  font-family: Inter, Arial, sans-serif;\n  background: #111827;\n  color: #111827;\n}\n\nbutton {\n  font: inherit;\n  cursor: pointer;\n}\n\n.phone {\n  width: 100%;\n  min-height: 100vh;\n  background: #ffffff;\n}\n\n/* Header */\n\n.app-header {\n  display: flex;\n  gap: 18px;\n  align-items: center;\n  padding: 44px 28px 34px;\n  background: #d71920;\n  color: #ffffff;\n}\n\n.brand-icon {\n  width: 64px;\n  height: 64px;\n  border: 4px solid #ffffff;\n  border-radius: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 32px;\n  flex-shrink: 0;\n}\n\n.app-header h1 {\n  margin: 0 0 6px;\n  font-size: 1.75rem;\n  line-height: 1.05;\n}\n\n.app-header p {\n  margin: 0;\n  font-size: 1rem;\n  opacity: 0.95;\n}\n\n/* Sections */\n\n.orders-section,\n.actions-section {\n  padding: 30px 28px;\n}\n\n.section-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 22px;\n}\n\n.section-title {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.section-icon {\n  font-size: 1.8rem;\n}\n\n.section-title h2 {\n  margin: 0;\n  font-size: 1.35rem;\n}\n\n.order-count {\n  background: #fde2e2;\n  color: #d71920;\n  padding: 8px 14px;\n  border-radius: 10px;\n  font-weight: 800;\n  white-space: nowrap;\n}\n\n/* Orders */\n\n.order-list {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.order-item {\n  display: grid;\n  grid-template-columns: 52px 72px 1fr auto;\n  align-items: center;\n  min-height: 86px;\n  border: 1px solid #e5e7eb;\n  border-radius: 12px;\n  overflow: hidden;\n  background: #ffffff;\n}\n\n.order-number {\n  height: 100%;\n  border-right: 1px solid #e5e7eb;\n  color: #d71920;\n  font-size: 1.5rem;\n  font-weight: 900;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.order-emoji {\n  font-size: 2.5rem;\n  text-align: center;\n}\n\n.order-name {\n  font-size: 1.2rem;\n  font-weight: 850;\n}\n\n.order-time {\n  padding-right: 18px;\n  color: #4b5563;\n  font-size: 1rem;\n  white-space: nowrap;\n}\n\n/* Actions */\n\n.actions-section {\n  border-top: 1px solid #e5e7eb;\n}\n\n.button-row {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 14px;\n  margin-top: 22px;\n}\n\n.action-button {\n  border: none;\n  border-radius: 12px;\n  padding: 20px 14px;\n  color: #ffffff;\n  font-size: 1rem;\n  font-weight: 850;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n}\n\n.action-button span {\n  width: 34px;\n  height: 34px;\n  border-radius: 50%;\n  background: #ffffff;\n  color: inherit;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.complete-button {\n  background: #189b45;\n}\n\n.complete-button span {\n  color: #189b45;\n}\n\n.remove-button {\n  background: #d71920;\n}\n\n.remove-button span {\n  color: #d71920;\n}\n\n/* Desktop */\n\n@media (min-width: 760px) {\n  body {\n    background: #f3f4f6;\n  }\n\n  .phone {\n    max-width: 900px;\n    min-height: auto;\n    margin: 40px auto;\n    border-radius: 28px;\n    overflow: hidden;\n    box-shadow: 0 20px 60px rgba(17, 24, 39, 0.18);\n  }\n\n  .app-header {\n    padding: 42px 48px;\n  }\n\n  .app-header h1 {\n    font-size: 2.2rem;\n  }\n\n  .app-header p {\n    font-size: 1.15rem;\n  }\n\n  .orders-section,\n  .actions-section {\n    padding: 36px 48px;\n  }\n\n  .order-item {\n    grid-template-columns: 70px 96px 1fr auto;\n    min-height: 104px;\n  }\n\n  .order-name {\n    font-size: 1.35rem;\n  }\n\n  .order-time {\n    font-size: 1.1rem;\n    padding-right: 28px;\n  }\n\n  .button-row {\n    max-width: 640px;\n  }\n}\n\n/* Small Screens */\n\n@media (max-width: 430px) {\n  .app-header {\n    padding: 34px 20px 28px;\n  }\n\n  .brand-icon {\n    width: 54px;\n    height: 54px;\n    font-size: 28px;\n  }\n\n  .app-header h1 {\n    font-size: 1.45rem;\n  }\n\n  .app-header p {\n    font-size: 0.95rem;\n  }\n\n  .orders-section,\n  .actions-section {\n    padding: 24px 20px;\n  }\n\n  .section-title h2 {\n    font-size: 1.2rem;\n  }\n\n  .order-item {\n    grid-template-columns: 44px 56px 1fr;\n    row-gap: 2px;\n    padding-right: 12px;\n  }\n\n  .order-number {\n    grid-row: 1 / span 2;\n  }\n\n  .order-emoji {\n    grid-row: 1 / span 2;\n    font-size: 2rem;\n  }\n\n  .order-name {\n    font-size: 1.05rem;\n  }\n\n  .order-time {\n    grid-column: 3;\n    padding-right: 0;\n    font-size: 0.9rem;\n  }\n\n  .button-row {\n    grid-template-columns: 1fr;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "script.js",
          "contents": "//Use orderList in renderOrders\nconst orderList = document.getElementById(\"orderList\");\nconst orderCount = document.getElementById(\"orderCount\");\n\n//You will connect these buttons to your app in Level 4.\nconst completeOldestButton = document.getElementById(\"completeOldestButton\");\nconst removeNewestButton = document.getElementById(\"removeNewestButton\");\n\nconst orders = [\n  { \n    emoji: \"🍔\", name: \"Burger Combo\", time: \"12:45 PM\" \n  },\n  { \n    emoji: \"🍣\", name: \"Sushi Roll\", time: \"12:46 PM\" \n  },\n  { \n    emoji: \"🌮\", name: \"Tacos (3)\", time: \"12:48 PM\" \n  },\n  { \n    emoji: \"🍝\", name: \"Pasta Alfredo\", time: \"12:50 PM\" \n  }\n];\n\n// This function is already done for you.\n// Call it in renderOrders\nconst createOrderCard = (order, index) => {\n  return `\n    <div class=\"order-item\">\n      <div class=\"order-number\">${index + 1}</div>\n      <div class=\"order-emoji\">${order.emoji}</div>\n      <div class=\"order-name\">${order.name}</div>\n      <div class=\"order-time\">${order.time}</div>\n    </div>\n  `;\n};\n\n\n// TODO:\n// Inside renderOrders(), use .map() to render each order\n// Each order should create one card using createOrderCard(order, index)\n// Display all the cards inside orderList\nconst renderOrders = () => {\n\n  \n\n  orderCount.textContent = `${orders.length} Orders`;\n};\n\nrenderOrders();",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "4"
      ]
    }
  },
