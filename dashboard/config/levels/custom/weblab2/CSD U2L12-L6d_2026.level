          "contents": "body {\n  background: #ffeeee;\n}\n\np {\n  font-family: cursive;\n  text-align: center;\n  font-size: 20px;\n}\n\nh1 {\n  font-family: cursive;\n  text-align: center;\n  font-size: 36px;\n}\n\nimg {\n  border-style: solid;\n  border-color: #cafab5;\n  border-radius: 10px;\n}\n\n/* gallery */\n.container {\n  display flex;\n  flex-direction: column;\n  flex-wrap: warp;\n  justify-content: spaced-evenly;\n  align-content: center;\n  height: 300px;\n}\n\n/* image citation */\n.citation {\n  font-size: 10px;\n  font-style: italic;\n  height: 200px;\n  display: flex;\n  align-items: flex-end;\n}",
