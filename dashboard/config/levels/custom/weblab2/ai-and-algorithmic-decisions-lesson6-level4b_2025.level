        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Status Indicator</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <h1>User Status</h1>\n\n  <button id=\"onlineBtn\">Go Online</button>\n  <button id=\"offlineBtn\">Go Offline</button>\n\n  <p id=\"output\"></p>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>\n\n  ",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// --- SELECT ELEMENTS ---\nconst outputElement = document.getElementById(\"output\");\nconst onlineBtn = document.getElementById(\"onlineBtn\");\nconst offlineBtn = document.getElementById(\"offlineBtn\");\nlet msg;\n\n// --- PARAMETERIZED FUNCTION ---\n\n\n\n\n// --- EVENT LISTENERS ---\nonlineBtn.addEventListener(\"click\", () => setStatus(\"online\"));\nofflineBtn.addEventListener(\"click\", () => setStatus(\"offline\"));\n",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: Arial, sans-serif;\n  text-align: center;\n  margin-top: 50px;\n}\n\n.online {\n  color: green;\n  font-weight: bold;\n}\n\n.offline {\n  color: gray;\n  font-weight: bold;\n}\n\nbutton {\n  margin: 10px;\n  padding: 8px 16px;\n  font-size: 16px;\n  cursor: pointer;\n}\n",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "documentation.md",
          "language": "md",
          "contents": "# Function: <setStatus>\n\n# What it does\nDecide whether the user is online or offline and show that state in the UI.\n\n# Inputs\nstatus — a string set to \"online\" or \"offline\"\n\n# What it changes\nVariables: Create a local message (e.g., \"You are online.\" or \"You are offline.\").\nOn screen: Update the status message element’s text to the message.",
          "folderId": "0",
          "active": false
        }
