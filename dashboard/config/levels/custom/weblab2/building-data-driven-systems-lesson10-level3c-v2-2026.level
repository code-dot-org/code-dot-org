          "active": false
        },
        "5": {
          "id": "5",
          "name": "style.css",
          "contents": ":root {\n  --card-bg: #FFF9EA;\n  --card-bg-strong: #FFFFFF;\n  --text-main: #241B14;\n  --text-meta: #76685B;\n  --blue: #4E67FF;\n  --cyan: #F58D2F;\n  --green: #3FA36D;\n  --line: #241B14;\n  --paper: #F4E7CF;\n  --panel: #FFEFC8;\n  --accent: #FFB000;\n  --accent-soft: #FFD98B;\n  --rose: #F05A4F;\n  --mint: #A6D8B9;\n  --shadow: 10px 10px 0 rgba(36, 27, 20, 0.18);\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml {\n  background: var(--paper);\n}\n\nbody {\n  min-height: 100vh;\n  font-family: \"Trebuchet MS\", Verdana, Geneva, sans-serif;\n  background:\n    radial-gradient(circle at 20% 14%, rgba(255, 176, 0, 0.24) 0 7rem, transparent 7.2rem),\n    radial-gradient(circle at 86% 26%, rgba(166, 216, 185, 0.48) 0 9rem, transparent 9.2rem),\n    linear-gradient(120deg, rgba(36, 27, 20, 0.045) 25%, transparent 25%) 0 0 / 28px 28px,\n    #F4E7CF;\n  color: var(--text-main);\n  margin: 0;\n  padding: 0 0 56px;\n}\n\nbody::before {\n  content: \"\";\n  position: fixed;\n  inset: 0;\n  pointer-events: none;\n  background-image: radial-gradient(rgba(36, 27, 20, 0.18) 1px, transparent 1.4px);\n  background-size: 18px 18px;\n  opacity: 0.22;\n  mix-blend-mode: multiply;\n}\n\nbutton {\n  appearance: none;\n  font: inherit;\n  background: var(--accent);\n  color: var(--text-main);\n  border: 3px solid var(--line);\n  padding: 13px 18px;\n  border-radius: 14px;\n  cursor: pointer;\n  font-weight: 900;\n  box-shadow: 6px 6px 0 var(--line);\n  transition: transform 140ms ease, box-shadow 140ms ease, background 140ms ease;\n}\n\nbutton:hover {\n  background: #FFC74C;\n  transform: translate(3px, 3px);\n  box-shadow: 3px 3px 0 var(--line);\n}\n\nbutton:focus-visible {\n  outline: 4px solid rgba(78, 103, 255, 0.42);\n  outline-offset: 4px;\n}\n\n.topbar {\n  background: var(--panel);\n  border: 3px solid var(--line);\n  border-radius: 28px;\n  box-shadow: 12px 12px 0 rgba(36, 27, 20, 0.16);\n  padding: 20px;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  align-items: stretch;\n  gap: 24px;\n  position: fixed;\n  top: 24px;\n  bottom: 24px;\n  left: 24px;\n  width: 246px;\n  z-index: 100;\n  overflow: auto;\n}\n\n.topbar::after {\n  content: \"\";\n  width: 92px;\n  height: 92px;\n  border: 3px solid var(--line);\n  border-radius: 999px;\n  background:\n    linear-gradient(135deg, transparent 47%, rgba(36, 27, 20, 0.2) 48% 52%, transparent 53%),\n    var(--mint);\n  box-shadow: 6px 6px 0 rgba(36, 27, 20, 0.18);\n  align-self: flex-end;\n  margin-top: auto;\n}\n\n.brand {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 16px;\n  min-width: 0;\n  flex:1;\n}\n\n.brand-mark {\n  width: 74px;\n  height: 74px;\n  display: grid;\n  place-items: center;\n  border: 3px solid var(--line);\n  border-radius: 50%;\n  color: #FFFFFF;\n  font-family: Georgia, \"Times New Roman\", serif;\n  font-size: 1.15rem;\n  font-weight: 900;\n  letter-spacing: -0.08em;\n  background: var(--rose);\n  box-shadow: 7px 7px 0 var(--line);\n  transform: rotate(-8deg);\n}\n\n.brand-copy {\n  min-width: 0;\n}\n\n.logo {\n  color: var(--text-main);\n  font-family: Georgia, \"Times New Roman\", serif;\n  font-size: clamp(1.8rem, 4vw, 2.55rem);\n  font-weight: 900;\n  letter-spacing: -0.07em;\n  line-height: 0.92;\n  max-width: 8ch;\n  white-space:normal;\n  overflow:visible;\n}\n\n.user-meta {\n  color: var(--text-meta);\n  font-size: 0.88rem;\n  font-weight: 800;\n  margin-top: 12px;\n  padding: 7px 9px;\n  width: fit-content;\n  border: 2px dashed rgba(36, 27, 20, 0.36);\n  border-radius: 10px;\n  background: rgba(255, 255, 255, 0.42);\n}\n\n.app-shell {\n  width: auto;\n  max-width: 1280px;\n  margin: 0 auto 0 292px;\n  padding: 30px 28px 72px;\n}\n\n.feed-panel {\n  min-width: 0;\n  position: relative;\n}\n\n#feed-container {\n  width: 100%;\n  margin: 0;\n  display: grid;\n  grid-template-columns: repeat(12, minmax(0, 1fr));\n  gap: 22px;\n  align-items: start;\n}\n\n.ad-card {\n  grid-column: span 4;\n  border: 3px solid var(--line);\n  background: var(--card-bg);\n  box-shadow: var(--shadow);\n  border-radius: 8px 30px 8px 30px;\n  padding: 22px;\n  position: relative;\n  overflow: hidden;\n  transform: rotate(-0.45deg);\n  transition: transform 150ms ease, box-shadow 150ms ease, background 150ms ease;\n}\n\n.ad-card:nth-child(5n + 1) {\n  grid-column: span 6;\n}\n\n.ad-card:nth-child(5n + 2) {\n  grid-column: span 3;\n  background: #FDF3D6;\n}\n\n.ad-card:nth-child(5n + 3) {\n  grid-column: span 3;\n  transform: rotate(0.5deg);\n}\n\n.ad-card:nth-child(5n + 4) {\n  grid-column: span 5;\n  background: #F4FBED;\n}\n\n.ad-card:nth-child(5n) {\n  grid-column: span 7;\n  transform: rotate(0.35deg);\n}\n\n.ad-card::before {\n  content: \"\";\n  position: absolute;\n  inset: 0 0 auto 0;\n  height: 12px;\n  background: repeating-linear-gradient(\n    90deg,\n    var(--rose) 0 18px,\n    var(--accent-soft) 18px 36px,\n    var(--mint) 36px 54px,\n    var(--blue) 54px 72px\n  );\n  border-bottom: 3px solid var(--line);\n}\n\n.ad-card::after {\n  content: \"\";\n  position: absolute;\n  right: 16px;\n  bottom: 14px;\n  width: 44px;\n  height: 44px;\n  border: 2px solid rgba(36, 27, 20, 0.2);\n  border-radius: 50%;\n  background: radial-gradient(circle, rgba(36, 27, 20, 0.08) 0 33%, transparent 34%);\n  opacity: 0.65;\n}\n\n.ad-card:hover {\n  background: var(--card-bg-strong);\n  transform: rotate(0deg) translate(-3px, -3px);\n  box-shadow: 14px 14px 0 rgba(36, 27, 20, 0.22);\n}\n\n.ad-content {\n  min-width: 0;\n  position: relative;\n  z-index: 1;\n  padding-top: 8px;\n}\n\n.ad-badge {\n  display: inline-flex;\n  align-items: center;\n  width: fit-content;\n  border: 2px solid var(--line);\n  border-radius: 7px;\n  color: #FFFFFF;\n  background: var(--blue);\n  box-shadow: 3px 3px 0 rgba(36, 27, 20, 0.24);\n  padding: 5px 8px;\n  font-size: 0.72rem;\n  font-weight: 900;\n  letter-spacing: 0.02em;\n  margin-bottom: 14px;\n}\n\n.ad-brand {\n  margin: 0 0 10px;\n  color: var(--text-main);\n  font-family: Georgia, \"Times New Roman\", serif;\n  font-size: clamp(1.18rem, 2.3vw, 1.62rem);\n  font-weight: 900;\n  line-height: 1.04;\n  letter-spacing: -0.04em;\n}\n\n.ad-text {\n  margin: 0;\n  color: #40352C;\n  font-size: 0.98rem;\n  line-height: 1.65;\n}\n\n.tag-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 18px;\n}\n\n.tag-chip {\n  border: 2px solid rgba(36, 27, 20, 0.78);\n  border-radius: 8px;\n  color: var(--text-main);\n  background: #FFFFFF;\n  padding: 5px 9px;\n  font-size: 0.76rem;\n  font-weight: 900;\n  box-shadow: 2px 2px 0 rgba(36, 27, 20, 0.2);\n}\n\n.tag-chip:nth-child(3n + 1) {\n  background: #FFE1DE;\n}\n\n.tag-chip:nth-child(3n + 2) {\n  background: #DDF2E5;\n}\n\n.tag-chip:nth-child(3n) {\n  background: #E3E7FF;\n}\n\n.ad-metrics {\n  border-top: 3px dotted rgba(36, 27, 20, 0.3);\n  margin-top: 18px;\n  padding-top: 13px;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 9px;\n}\n\n.metric {\n  color: var(--text-meta);\n  font-family: \"Courier New\", Courier, monospace;\n  font-size: 0.78rem;\n  font-weight: 700;\n  background: rgba(255, 255, 255, 0.58);\n  border: 1px solid rgba(36, 27, 20, 0.2);\n  border-radius: 6px;\n  padding: 3px 6px;\n}\n\n@media (max-width: 1120px) {\n  .ad-card,\n  .ad-card:nth-child(n) {\n    grid-column: span 6;\n  }\n}\n\n@media (max-width: 860px) {\n  body {\n    padding-bottom: 34px;\n  }\n\n  .topbar {\n    position: relative;\n    top: auto;\n    bottom: auto;\n    left: auto;\n    width: calc(100% - 28px);\n    margin: 14px auto 0;\n    flex-direction: row;\n    justify-content: space-between;\n    align-items: center;\n    border-radius: 22px;\n    overflow: visible;\n    flex-wrap: wrap;\n  }\n\n  .topbar::after {\n    display: none;\n  }\n\n  .brand {\n    flex-direction: row;\n    align-items: center;\n  }\n\n  .logo {\n    max-width: none;\n    font-size: 1.4rem;\n    line-height: 1;\n  }\n\n  .user-meta {\n    margin-top: 6px;\n  }\n\n  .app-shell {\n    margin: 0;\n    max-width: none;\n    padding: 22px 14px 0;\n  }\n}\n\n@media (max-width: 680px) {\n  .topbar {\n    align-items: stretch;\n    flex-direction: column;\n  }\n\n  button {\n    width: 100%;\n  }\n\n  #feed-container {\n    grid-template-columns: 1fr;\n    gap: 16px;\n  }\n\n  .ad-card,\n  .ad-card:nth-child(n) {\n    grid-column: 1;\n  }\n}\n\n@media (max-width: 520px) {\n  .brand-mark {\n    width: 52px;\n    height: 52px;\n    box-shadow: 5px 5px 0 var(--line);\n  }\n\n  .ad-card {\n    border-radius: 8px 22px 8px 22px;\n    padding: 19px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    transition-duration: 0.001ms !important;\n  }\n}\n",
          "folderId": "0",
          "active": false
        },
