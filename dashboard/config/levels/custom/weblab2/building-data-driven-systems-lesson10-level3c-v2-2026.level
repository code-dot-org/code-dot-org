    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "helpers.js",
          "contents": "// Formats a dollar amount.\nconst formatMoney = (amount) => {\n  return \"$\" + amount.toFixed(2);\n};\n\n// Formats a tag label for an ad.\nconst formatTag = (tag) => {\n  return \"#\" + tag;\n};\n\n// Formats the user's interests for the header.\nconst formatInterests = (interests) => {\n  return interests.join(\", \");\n};\n\n// Displays the current user in the header.\nconst renderUserProfile = () => {\n  const userDisplay = document.getElementById(\"username-display\");\n\n  userDisplay.textContent = currentUser.name + \" | Age: \" + currentUser.age +\n    \" | Interests: \" + formatInterests(currentUser.interests);\n};\n\n// Creates one ad card.\n// Students do not need to edit this function.\nconst createAdCard = (ad) => {\n  const card = document.createElement(\"article\");\n  card.className = \"ad-card\";\n  card.id = \"adCard\" + ad.id;\n\n  const badge = document.createElement(\"div\");\n  badge.className = \"ad-badge\";\n  badge.id = \"adBadge\" + ad.id;\n  badge.textContent = \"Sponsored\";\n\n  const content = document.createElement(\"div\");\n  content.className = \"ad-content\";\n  content.id = \"adContent\" + ad.id;\n\n  const brand = document.createElement(\"h3\");\n  brand.className = \"ad-brand\";\n  brand.id = \"adBrand\" + ad.id;\n  brand.textContent = ad.brand;\n\n  const text = document.createElement(\"p\");\n  text.className = \"ad-text\";\n  text.id = \"adText\" + ad.id;\n  text.textContent = ad.text;\n\n  const tags = document.createElement(\"div\");\n  tags.className = \"tag-row\";\n  tags.id = \"adTags\" + ad.id;\n\n  ad.tags.map((tag, index) => {\n    const chip = document.createElement(\"span\");\n    chip.className = \"tag-chip\";\n    chip.id = \"adTag\" + ad.id + \"_\" + index;\n    chip.textContent = formatTag(tag);\n\n    tags.appendChild(chip);\n  });\n\n  const metrics = document.createElement(\"div\");\n  metrics.className = \"ad-metrics\";\n  metrics.id = \"adMetrics\" + ad.id;\n\n  const bid = document.createElement(\"span\");\n  bid.className = \"metric\";\n  bid.id = \"adBid\" + ad.id;\n  bid.textContent = \"Bid: \" + formatMoney(ad.bid);\n\n  const quality = document.createElement(\"span\");\n  quality.className = \"metric\";\n  quality.id = \"adQuality\" + ad.id;\n  quality.textContent = \"Quality: \" + ad.quality;\n\n  const minAge = document.createElement(\"span\");\n  minAge.className = \"metric\";\n  minAge.id = \"adMinAge\" + ad.id;\n  minAge.textContent = \"Min Age: \" + ad.minAge;\n\n  metrics.appendChild(bid);\n  metrics.appendChild(quality);\n  metrics.appendChild(minAge);\n\n  content.appendChild(badge);\n  content.appendChild(brand);\n  content.appendChild(text);\n  content.appendChild(tags);\n  content.appendChild(metrics);\n\n  card.appendChild(content);\n\n  return card;\n};\n\n// Displays the current ads on the page.\nconst renderFeed = () => {\n  const feedContainer = document.getElementById(\"feed-container\");\n\n  feedContainer.innerHTML = \"\";\n\n  displayAds.map((ad) => {\n    feedContainer.appendChild(createAdCard(ad));\n  });\n};\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "data.js",
          "contents": "// currentUser schema: name, age, interests\nconst currentUser = {\n  name: \"Javier\",\n  age: 18,\n  interests: [\"gaming\", \"tech\", \"travel\"]\n};\n\n// adDatabase schema: id, brand, text, tags, minAge, bid, quality\nconst adDatabase = [\n  {\n    id: 1,\n    brand: \"RetroArcade\",\n    text: \"Classic gaming console!\",\n    tags: [\"gaming\"],\n    minAge: 10,\n    bid: 12.38,\n    quality: 10\n  },\n  {\n    id: 2,\n    brand: \"RetirementPros\",\n    text: \"Secure your future.\",\n    tags: [\"finance\"],\n    minAge: 55,\n    bid: 3.37,\n    quality: 10\n  },\n  {\n    id: 3,\n    brand: \"TechWeekly\",\n    text: \"Latest gadget reviews.\",\n    tags: [\"tech\", \"news\"],\n    minAge: 18,\n    bid: 12.63,\n    quality: 9\n  },\n  {\n    id: 4,\n    brand: \"SodaPop\",\n    text: \"Fizzy happiness.\",\n    tags: [\"food\"],\n    minAge: 5,\n    bid: 13.22,\n    quality: 7\n  },\n  {\n    id: 5,\n    brand: \"TravelBug\",\n    text: \"Flights to Tokyo 50% off.\",\n    tags: [\"travel\"],\n    minAge: 18,\n    bid: 6.59,\n    quality: 3\n  },\n  {\n    id: 6,\n    brand: \"KidToys\",\n    text: \"Building blocks for tots.\",\n    tags: [\"kids\"],\n    minAge: 2,\n    bid: 12.67,\n    quality: 9\n  },\n  {\n    id: 7,\n    brand: \"CryptoKing\",\n    text: \"Invest in unsure things.\",\n    tags: [\"finance\"],\n    minAge: 21,\n    bid: 5.46,\n    quality: 5\n  },\n  {\n    id: 8,\n    brand: \"GamerChair\",\n    text: \"Sit like a pro.\",\n    tags: [\"gaming\"],\n    minAge: 16,\n    bid: 12.79,\n    quality: 1\n  },\n  {\n    id: 9,\n    brand: \"FashionNova\",\n    text: \"Trendy summer looks.\",\n    tags: [\"fashion\"],\n    minAge: 13,\n    bid: 2.14,\n    quality: 10\n  },\n  {\n    id: 10,\n    brand: \"HealthyLife\",\n    text: \"Vitamins for seniors.\",\n    tags: [\"health\"],\n    minAge: 60,\n    bid: 2.31,\n    quality: 8\n  },\n  {\n    id: 11,\n    brand: \"SportySpice\",\n    text: \"Soccer gear sale.\",\n    tags: [\"sports\"],\n    minAge: 10,\n    bid: 10.79,\n    quality: 5\n  },\n  {\n    id: 12,\n    brand: \"MusicBox\",\n    text: \"Stream millions of songs.\",\n    tags: [\"music\"],\n    minAge: 13,\n    bid: 6.62,\n    quality: 9\n  },\n  {\n    id: 13,\n    brand: \"News24\",\n    text: \"Breaking world news.\",\n    tags: [\"news\"],\n    minAge: 18,\n    bid: 8,\n    quality: 3\n  },\n  {\n    id: 14,\n    brand: \"BurgerKing\",\n    text: \"Double cheese delight.\",\n    tags: [\"food\"],\n    minAge: 5,\n    bid: 9.65,\n    quality: 7\n  },\n  {\n    id: 15,\n    brand: \"TravelLite\",\n    text: \"Backpacks for hiking.\",\n    tags: [\"travel\", \"sports\"],\n    minAge: 18,\n    bid: 9.7,\n    quality: 9\n  },\n  {\n    id: 16,\n    brand: \"CodeAcademy\",\n    text: \"Learn JS today.\",\n    tags: [\"tech\"],\n    minAge: 13,\n    bid: 9.98,\n    quality: 9\n  },\n  {\n    id: 17,\n    brand: \"BabySteps\",\n    text: \"Soft shoes for walking.\",\n    tags: [\"kids\"],\n    minAge: 1,\n    bid: 3.68,\n    quality: 1\n  },\n  {\n    id: 18,\n    brand: \"MortgageHelp\",\n    text: \"Low rates for homeowners.\",\n    tags: [\"finance\"],\n    minAge: 30,\n    bid: 4.75,\n    quality: 7\n  },\n  {\n    id: 19,\n    brand: \"VR_World\",\n    text: \"Immersive virtual reality.\",\n    tags: [\"tech\", \"gaming\"],\n    minAge: 16,\n    bid: 10.4,\n    quality: 7\n  },\n  {\n    id: 20,\n    brand: \"CruiseLine\",\n    text: \"7-day Caribbean cruise.\",\n    tags: [\"travel\"],\n    minAge: 25,\n    bid: 9.97,\n    quality: 8\n  },\n  {\n    id: 21,\n    brand: \"DiaperGenie\",\n    text: \"Odor-free disposal.\",\n    tags: [\"kids\"],\n    minAge: 18,\n    bid: 6.27,\n    quality: 8\n  },\n  {\n    id: 22,\n    brand: \"ProGolf\",\n    text: \"Clubs for professionals.\",\n    tags: [\"sports\"],\n    minAge: 25,\n    bid: 5.55,\n    quality: 8\n  },\n  {\n    id: 23,\n    brand: \"VeganTreats\",\n    text: \"Plant-based snacks.\",\n    tags: [\"food\", \"health\"],\n    minAge: 10,\n    bid: 3.54,\n    quality: 6\n  },\n  {\n    id: 24,\n    brand: \"SeniorLiving\",\n    text: \"Comfortable communities.\",\n    tags: [\"health\"],\n    minAge: 65,\n    bid: 14.36,\n    quality: 3\n  },\n  {\n    id: 25,\n    brand: \"IndieGame\",\n    text: \"Support indie devs.\",\n    tags: [\"gaming\"],\n    minAge: 13,\n    bid: 2.2,\n    quality: 9\n  },\n  {\n    id: 26,\n    brand: \"AutoTrader\",\n    text: \"Best used cars.\",\n    tags: [\"tech\"],\n    minAge: 20,\n    bid: 7.67,\n    quality: 8\n  },\n  {\n    id: 27,\n    brand: \"PetLover\",\n    text: \"Organic dog food.\",\n    tags: [\"food\"],\n    minAge: 18,\n    bid: 10.86,\n    quality: 4\n  },\n  {\n    id: 28,\n    brand: \"GuitarHero\",\n    text: \"Learn to shred.\",\n    tags: [\"music\", \"gaming\"],\n    minAge: 12,\n    bid: 14.9,\n    quality: 7\n  },\n  {\n    id: 29,\n    brand: \"WallStreet\",\n    text: \"Stock market tips.\",\n    tags: [\"finance\"],\n    minAge: 21,\n    bid: 14.25,\n    quality: 9\n  }\n];\n",
