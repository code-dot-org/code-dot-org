        "3": {
          "id": "3",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>SocialStream Ad Algorithm</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <header class=\"topbar\">\n    <div class=\"brand\" aria-label=\"SocialStream\">\n      <span class=\"brand-mark\">SS</span>\n      <div class=\"brand-copy\">\n        <div class=\"logo\">SocialStream</div>\n        <div id=\"username-display\" class=\"user-meta\">Loading...</div>\n      </div>\n    </div>\n\n    <button id=\"run-pipeline-btn\" type=\"button\">Run Ad Algorithm</button>\n  </header>\n\n  <main class=\"app-shell\" aria-label=\"SocialStream ad feed\">\n    <section class=\"feed-panel\" aria-label=\"Sponsored posts\">\n      <div id=\"feed-container\" aria-live=\"polite\"></div>\n    </section>\n  </main>\n\n  <script src=\"data.js\"></script>\n  <script src=\"helpers.js\"></script>\n  <script src=\"script.js\"></script>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "script.js",
          "contents": "// View 1\n\n// This array controls which ads are currently shown.\nlet displayAds = adDatabase;\n\n// First page load\nrenderUserProfile();\nrenderFeed();\n\n// Ad Pipeline Algorithm\n\n// Builds the custom ad feed.\nconst runAdPipeline = () => {\n  // filter → sort → render\n\n\n\n\n\n\n\n};\n\n// Event listeners\ndocument.getElementById(\"run-pipeline-btn\").addEventListener(\"click\", runAdPipeline);\n",
