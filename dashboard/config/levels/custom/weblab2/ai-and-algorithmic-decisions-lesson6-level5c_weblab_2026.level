      "files": {
        "1": {
          "id": "1",
          "name": "utils.js",
          "contents": "// Adds a hover zoom effect and a subtle pulse when the hero updates\ndocument.querySelectorAll('.movie-card').forEach(card => {\n    card.addEventListener('mouseenter', () => {\n        card.style.transform = \"scale(1.08)\";\n        card.style.transition = \"transform 0.3s ease\";\n    });\n    card.addEventListener('mouseleave', () => {\n        card.style.transform = \"scale(1)\";\n    });\n});\n\n// A utility function students can use to add a fade-in effect\nfunction applyFade() {\n    const hero = document.getElementById('heroSection');\n    hero.style.opacity = \"0.5\";\n    setTimeout(() => {\n        hero.style.opacity = \"1\";\n    }, 300);\n}",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "\n",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>FlixFlow | Build Mode</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n    <link href=\"https://fonts.googleapis.com/css2?family=Roboto:wght@400;700;900&display=swap\" rel=\"stylesheet\">\n</head>\n<body>\n\n    <div class=\"app-shell\">\n        <header id=\"heroSection\" class=\"hero\">\n            <div class=\"hero-content\">\n                <div class=\"brand-tag\">FLIXFLOW ORIGINAL</div>\n                <h1 id=\"heroTitle\">Ready to Watch?</h1>\n                <p id=\"heroDesc\">Select a title from the library below to update this display.</p>\n                <div class=\"hero-btns\">\n                    <button class=\"play-btn\">▶ Play</button>\n                    <button class=\"info-btn\">ⓘ More Info</button>\n                </div>\n            </div>\n        </header>\n\n        <main class=\"content\">\n            <h2 class=\"row-title\">Library</h2>\n            \n            <div class=\"movie-row\">\n                <div class=\"movie-container\">\n                    <div class=\"meta-hint\">\n                        <strong>Blind Spot</strong><br>\n                        <strong>He can't face the truth</strong>\n                    </div>\n                    <div class=\"movie-card\">\n                        <img src=\"images/movie1.jpg\" alt=\"Blind Spot\">\n                        <button id=\"movie1Btn\" class=\"action-trigger\">+</button>\n                    </div>\n                </div>\n\n                <div class=\"movie-container\">\n                    <div class=\"meta-hint\">\n                        <strong>Ghost Forest</strong><br>\n                        <strong>Don't look back.</strong>\n                    </div>\n                    <div class=\"movie-card\">\n                        <img src=\"images/movie2.jpg\" alt=\"Ghost Forest\">\n                        <button id=\"movie2Btn\" class=\"action-trigger\">+</button>\n                    </div>\n                </div>\n\n                <div class=\"movie-container\">\n                    <div class=\"meta-hint\">\n                        <strong>Cyber City</strong><br>\n                        <strong>The future is here</strong>.\n                    </div>\n                    <div class=\"movie-card\">\n                        <img src=\"images/movie3.jpg\" alt=\"Cyber City\">\n                        <button id=\"movie3Btn\" class=\"action-trigger\">+</button>\n                    </div>\n                </div>\n\n                <div class=\"movie-container\">\n                    <div class=\"meta-hint\">\n                        <strong>City Blur</strong><br>\n                        <strong>Shadows of the city.</strong>\n                    </div>\n                  \n                    <div class=\"movie-card\">\n                        <img src=\"images/movie4.jpg\" alt=\"City Blur\">\n                        <button id=\"movie4Btn\" class=\"action-trigger\">+</button>\n                    </div>\n                </div>\n            </div>\n        </main>\n    </div>\n\n    <script src=\"script.js\"></script>\n    <script src=\"main.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "active": true
        },
