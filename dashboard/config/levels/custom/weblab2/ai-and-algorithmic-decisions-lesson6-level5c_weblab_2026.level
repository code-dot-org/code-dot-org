        "12": {
          "id": "12",
          "name": "style.css",
          "contents": ":root {\n    --flow-orange: #ff8c00;\n    --bg-black: #0a0a0a;\n    --hint-gray: #333;\n}\n\n* {\n    box-sizing: border-box;\n}\n\nbody {\n    background-color: #222;\n    margin: 0;\n    min-height: 100vh;\n    font-family: 'Roboto', sans-serif;\n    color: white;\n}\n\n.app-shell {\n    width: min(100%, 1200px);\n    min-height: 100vh;\n    margin: 0 auto;\n    background: var(--bg-black);\n    display: flex;\n    flex-direction: column;\n    overflow: hidden;\n}\n\n/* Hero Section */\n.hero {\n    min-height: clamp(320px, 48vw, 520px);\n    background-image: linear-gradient(to top, var(--bg-black), transparent 70%), url('images/hero-default.jpg');\n    background-size: cover;\n    background-position: center;\n    display: flex;\n    align-items: flex-end;\n    padding: clamp(20px, 4vw, 40px);\n}\n\n.hero-content {\n    width: min(100%, 620px);\n}\n\n#heroTitle {\n    font-size: clamp(2rem, 4vw, 3.5rem);\n    margin: 0;\n    font-weight: 900;\n}\n\n#heroDesc {\n    font-size: clamp(0.95rem, 1.5vw, 1.1rem);\n    color: #aaa;\n    margin: 10px 0 0;\n    line-height: 1.5;\n    max-width: 55ch;\n}\n\n.content {\n    flex: 1;\n    padding: clamp(20px, 3vw, 32px);\n}\n\n.row-title {\n    margin: 0 0 16px;\n    font-size: clamp(1.2rem, 2vw, 1.6rem);\n}\n\n.movie-row {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n    gap: 20px;\n    align-items: start;\n}\n\n.movie-container {\n    display: flex;\n    flex-direction: column;\n    gap: 10px;\n    min-width: 0;\n}\n\n.meta-hint {\n    background: var(--hint-gray);\n    padding: 10px;\n    border-radius: 4px;\n    font-size: 0.78rem;\n    color: #00ff00;\n    font-family: monospace;\n    line-height: 1.35;\n    border: 1px solid #444;\n}\n\n.movie-card {\n    position: relative;\n    width: 100%;\n}\n\n.movie-card img {\n    width: 100%;\n    aspect-ratio: 2 / 3;\n    object-fit: cover;\n    border-radius: 6px;\n    display: block;\n}\n\n.action-trigger {\n    position: absolute;\n    right: 8px;\n    bottom: 8px;\n    background: var(--flow-orange);\n    color: white;\n    border: none;\n    width: 32px;\n    height: 32px;\n    border-radius: 50%;\n    cursor: pointer;\n}\n\n/* Tablet */\n@media (max-width: 767px) {\n    .app-shell {\n        width: 100%;\n    }\n\n    .hero {\n        min-height: 320px;\n    }\n\n    .movie-row {\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n        gap: 16px;\n    }\n}\n\n/* Mobile */\n@media (max-width: 480px) {\n    .content {\n        padding: 16px 12px 20px;\n    }\n\n    .hero {\n        min-height: 260px;\n        padding: 14px;\n    }\n\n    #heroTitle {\n        font-size: 1.8rem;\n    }\n\n    #heroDesc {\n        font-size: 0.95rem;\n        max-width: 30ch;\n    }\n\n    .row-title {\n        font-size: 1rem;\n        margin-bottom: 12px;\n    }\n\n    .movie-row {\n        grid-template-columns: repeat(2, minmax(0, 1fr));\n        gap: 12px;\n        align-items: start;\n    }\n\n    .movie-container {\n        gap: 6px;\n    }\n\n    .meta-hint {\n        padding: 6px 7px;\n        font-size: 0.62rem;\n        line-height: 1.2;\n        min-height: 54px;\n    }\n\n    .movie-card img {\n        aspect-ratio: 2 / 2.55;\n    }\n\n    .action-trigger {\n        width: 28px;\n        height: 28px;\n        right: 6px;\n        bottom: 6px;\n    }\n}",
          "folderId": "0",
          "active": false
        }
      },
