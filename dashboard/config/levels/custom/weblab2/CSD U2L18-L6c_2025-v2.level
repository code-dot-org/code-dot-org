          "name": "mayanGlyphs.png",
          "language": "png",
          "contents": "",
          "folderId": "0",
          "url": "/level_starter_assets/CSD%20U2L18-L6c-2025/uuid/ba867deb-b56e-425f-9508-ee328641430c.png",
