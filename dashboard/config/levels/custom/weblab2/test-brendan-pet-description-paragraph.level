          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html>\n<head>\n  <title>My Pet Fish Page</title>\n</head>\n<body>\n  <h1>Finley</h1>\n  <!-- Add a paragraph about your pet fish here! -->\n</body>\n</html>",
