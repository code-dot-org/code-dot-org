    "bubble_choice_description": "Analyze the code for a fee waiver checker, figure out how the rule works, and refactor it into a combined Boolean expression.",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>Application Fee Waivers & Support</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <header class=\"site-header\">\n      <div class=\"utility-bar\">\n        <div class=\"utility-left\">\n          <span>Professional</span>\n          <span class=\"active-pill\">Student</span>\n        </div>\n        <div class=\"utility-right\">\n          <span>Resources</span>\n          <span>Events</span>\n          <span>Contact</span>\n        </div>\n      </div>\n\n      <div class=\"main-header\">\n        <div class=\"brand-block\">\n          <h1 class=\"brand\">NCAN</h1>\n          <p class=\"brand-subtitle\">National College Access Network</p>\n        </div>\n        <div class=\"menu-icon\">☰</div>\n      </div>\n    </header>\n\n    <section class=\"hero\">\n      <div class=\"hero-left\">\n        <h2>Application Fee Waivers &amp; Support</h2>\n        <p class=\"hero-copy\">\n          NCAN offers application fee waiver support to help students with limited\n          financial resources apply for college. Use the tool to explore whether\n          a student may qualify based on their current information.\n        </p>\n      </div>\n\n      <div class=\"hero-right\">\n        <section class=\"app-card\">\n          <p class=\"eyebrow\">Student Support Portal</p>\n          <h3>Application Fee Support Check</h3>\n          <p class=\"intro\">\n            Check whether you may qualify for an application fee waiver based on\n            your current information.\n          </p>\n\n          <div class=\"form-group\">\n            <label for=\"income\">Household income</label>\n            <div class=\"input-with-symbol\">\n              <span class=\"input-symbol\">$</span>\n              <input id=\"income\" type=\"number\" value=\"44000\" min=\"0\" />\n            </div>\n          </div>\n\n          <div class=\"form-group\">\n            <label for=\"familySize\">Family size</label>\n            <input id=\"familySize\" type=\"number\" value=\"4\" min=\"1\" />\n          </div>\n\n          <label class=\"checkbox-row\">\n            <input id=\"feesDue\" type=\"checkbox\" />\n            I currently owe past-due school fees\n          </label>\n\n          <button id=\"runBtn\" class=\"primary-btn\">Check eligibility</button>\n\n          <div class=\"result-card\">\n            <p class=\"result-label\">Status</p>\n            <p id=\"message\" class=\"result-message\">—</p>\n          </div>\n        </section>\n      </div>\n    </section>\n\n    <main class=\"page\">\n      <section class=\"content-section\">\n        <h4>For first-time undergraduate applicants</h4>\n        <p class=\"support-copy\">\n          This support check is a simplified tool that reviews income, family size,\n          and past-due fee status.\n        </p>\n      </section>\n    </main>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  font-family: Arial, Helvetica, sans-serif;\n  background: #f8fafc;\n  color: #0f172a;\n}\n\n/* Header */\n.utility-bar {\n  background: #0f9fb0;\n  color: white;\n  padding: 14px 28px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 15px;\n}\n\n.utility-left,\n.utility-right {\n  display: flex;\n  align-items: center;\n  gap: 18px;\n}\n\n.active-pill {\n  padding: 6px 14px;\n  border: 1px solid rgba(255, 255, 255, 0.8);\n  border-radius: 999px;\n  font-weight: 700;\n}\n\n.main-header {\n  background: white;\n  padding: 26px 28px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.brand {\n  margin: 0;\n  font-size: 52px;\n  line-height: 1;\n  color: #114a84;\n}\n\n.brand-subtitle {\n  margin: 6px 0 0 0;\n  color: #114a84;\n  font-size: 16px;\n}\n\n.menu-icon {\n  font-size: 34px;\n  color: #114a84;\n}\n\n/* Hero */\n.hero {\n  display: grid;\n  grid-template-columns: 1.15fr 0.95fr;\n  gap: 40px;\n  align-items: start;\n  padding: 56px 28px;\n  background: linear-gradient(\n      rgba(15, 159, 176, 0.75),\n      rgba(15, 159, 176, 0.75)\n    ),\n    url(\"students.jpg\") center / cover no-repeat;\n}\n\n.hero-left {\n  color: white;\n  padding: 18px 8px 18px 8px;\n}\n\n.hero-left h2 {\n  margin: 0 0 18px 0;\n  font-size: 72px;\n  line-height: 0.95;\n  font-weight: 800;\n  max-width: 760px;\n}\n\n.hero-copy {\n  margin: 0;\n  font-size: 20px;\n  line-height: 1.6;\n  max-width: 620px;\n}\n\n.hero-right {\n  display: flex;\n  justify-content: flex-end;\n}\n\n/* Tool card */\n.app-card {\n  width: 100%;\n  max-width: 500px;\n  background: #ffffff;\n  border-radius: 22px;\n  padding: 28px;\n  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);\n  border: 1px solid #e2e8f0;\n}\n\n.eyebrow {\n  margin: 0 0 10px 0;\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  color: #2563eb;\n}\n\n.app-card h3 {\n  margin: 0 0 10px 0;\n  font-size: 30px;\n  line-height: 1.1;\n}\n\n.intro {\n  margin: 0 0 22px 0;\n  color: #475569;\n  font-size: 15px;\n  line-height: 1.45;\n}\n\n.form-group {\n  margin-bottom: 16px;\n}\n\n.form-group label {\n  display: block;\n  margin-bottom: 8px;\n  font-size: 14px;\n  font-weight: 600;\n  color: #1e293b;\n}\n\ninput[type=\"number\"] {\n  width: 100%;\n  padding: 12px 14px;\n  border: 1px solid #cbd5e1;\n  border-radius: 12px;\n  font-size: 16px;\n  background: #ffffff;\n}\n\n.input-with-symbol {\n  position: relative;\n}\n\n.input-symbol {\n  position: absolute;\n  left: 14px;\n  top: 50%;\n  transform: translateY(-50%);\n  color: #64748b;\n  font-weight: 700;\n}\n\n.input-with-symbol input {\n  padding-left: 32px;\n}\n\n.checkbox-row {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  margin: 6px 0 20px 0;\n  font-size: 15px;\n  font-weight: 500;\n  color: #1e293b;\n}\n\n.checkbox-row input {\n  width: 18px;\n  height: 18px;\n  margin: 0;\n}\n\n.primary-btn {\n  width: 100%;\n  border: none;\n  border-radius: 14px;\n  padding: 14px;\n  background: #2563eb;\n  color: #ffffff;\n  font-size: 16px;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n.primary-btn:hover {\n  background: #1d4ed8;\n}\n\n.result-card {\n  margin-top: 18px;\n  padding: 16px;\n  background: #f8fafc;\n  border: 1px solid #e2e8f0;\n  border-radius: 14px;\n}\n\n.result-label {\n  margin: 0 0 6px 0;\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: #64748b;\n}\n\n.result-message {\n  margin: 0;\n  font-size: 20px;\n  font-weight: 700;\n}\n\n/* Lower content */\n.page {\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 40px 28px 56px;\n}\n\n.content-section h4 {\n  margin: 0 0 12px 0;\n  font-size: 28px;\n  color: #114a84;\n}\n\n.support-copy {\n  margin: 0;\n  font-size: 17px;\n  line-height: 1.55;\n  color: #475569;\n  max-width: 720px;\n}\n\n/* Responsive */\n@media (max-width: 1000px) {\n  .hero {\n    grid-template-columns: 1fr;\n  }\n\n  .hero-right {\n    justify-content: center;\n  }\n\n  .hero-left h2 {\n    font-size: 52px;\n  }\n}\n\n@media (max-width: 700px) {\n  .utility-bar,\n  .main-header,\n  .hero,\n  .page {\n    padding-left: 20px;\n    padding-right: 20px;\n  }\n\n  .utility-bar {\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 10px;\n  }\n\n  .utility-right {\n    gap: 14px;\n  }\n\n  .hero-left h2 {\n    font-size: 40px;\n  }\n\n  .hero-copy {\n    font-size: 18px;\n  }\n\n  .brand {\n    font-size: 42px;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "// Selectors\nconst income = document.getElementById(\"income\");\nconst familySize = document.getElementById(\"familySize\");\nconst feesDue = document.getElementById(\"feesDue\");\nconst message = document.getElementById(\"message\");\nconst runBtn = document.getElementById(\"runBtn\");\n\n// Function to check eligibility\nconst eligible = () => {\n  const incomeValue = Number(income.value);\n  const familySizeValue = Number(familySize.value);\n  const owesFees = feesDue.checked;\n\n  if (incomeValue < 45000) {\n    if (!owesFees) {\n      message.textContent = \"✅ Eligible\";\n    } else {\n      message.textContent = \"❌ Not eligible\";\n    }\n  } else {\n    if (familySizeValue >= 5) {\n      if (!owesFees) {\n        message.textContent = \"✅ Eligible\";\n      } else {\n        message.textContent = \"❌ Not eligible\";\n      }\n    } else {\n      message.textContent = \"❌ Not eligible\";\n    }\n  }\n};\n\n// Event listener\nrunBtn.addEventListener(\"click\", eligible);",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "3"
      ]
    },
