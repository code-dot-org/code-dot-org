  "properties": {
    "encrypted": "false",
    "display_name": "Pet Adoption Browser",
    "bubble_choice_description": "Use a **read → transform → render** pipeline to show pets available for adoption. ",
    "thumbnail_url": "https://images.code.org/8b9a34fc1b704ed1c1cacccfa20dc514-pet-adoption.png",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
