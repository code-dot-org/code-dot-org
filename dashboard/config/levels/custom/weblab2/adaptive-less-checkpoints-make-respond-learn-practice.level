<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-11-03T04:21:49.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": "true",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "style.css",
          "contents": "/*\n * CADS tokens\n * Copied from the CADS runtime (manifest 0.1.0), light theme. Only the tokens\n * that this stylesheet uses, and the tokens they refer to, are included.\n * Do not change values here. Change the component styles below instead.\n */\n\n:root {\n  /* Palette */\n  --brand-purple-5: #e4e2f8;\n  --brand-purple-20: #aca8ea;\n  --brand-purple-30: #928cef;\n  --brand-purple-50: #4c42cf;\n  --brand-purple-80: #2b1e9f;\n  --brand-purple-90: #1d1590;\n  --brand-orange-5: #ffe3ce;\n  --brand-orange-30: #ffa868;\n  --brand-orange-50: #f46800;\n  --brand-pink-5: #fbdae8;\n  --brand-pink-30: #f07fb0;\n  --brand-pink-50: #e11970;\n  --neutral-base-black: #121212;\n  --neutral-base-white: #ffffff;\n  --neutral-gray-5: #f1f2f4;\n  --neutral-gray-20: #d3d6da;\n  --neutral-gray-40: #9ea5ad;\n  --neutral-gray-70: #596069;\n  --neutral-gray-80: #4b5258;\n  --sentiment-error-5: #ffdada;\n  --sentiment-error-50: #eb1414;\n  --sentiment-error-70: #b30f0f;\n  --sentiment-information-30: #6fcaff;\n  --sentiment-success-5: #d8ffdc;\n  --sentiment-success-30: #7cdb87;\n  --sentiment-success-70: #258830;\n  --sentiment-warning-30: #ffd35c;\n\n  /* Color roles (light theme) */\n  --background-neutral-primary: var(--neutral-base-white);\n  --background-neutral-secondary: var(--neutral-gray-5);\n  --background-brand-primary: var(--brand-purple-50);\n  --background-brand-light: var(--brand-purple-5);\n  --background-brand-mid: var(--brand-purple-20);\n  --background-brand-strong: var(--brand-purple-80);\n  --background-error-light: var(--sentiment-error-5);\n  --background-warning-mid: var(--sentiment-warning-30);\n  --background-success-primary: var(--sentiment-success-70);\n  --background-success-mid: var(--sentiment-success-30);\n  --background-info-mid: var(--sentiment-information-30);\n  --background-selected-primary: var(--brand-purple-80);\n  --background-disabled-neutral: var(--neutral-gray-20);\n  --background-accent-orange-primary: var(--brand-orange-50);\n  --background-accent-orange-light: var(--brand-orange-5);\n  --background-accent-orange-mid: var(--brand-orange-30);\n  --background-accent-pink-primary: var(--brand-pink-50);\n  --background-accent-pink-light: var(--brand-pink-5);\n  --background-accent-pink-mid: var(--brand-pink-30);\n  --border-neutral-primary: var(--neutral-gray-20);\n  --border-neutral-secondary: var(--neutral-gray-40);\n  --border-neutral-solid: var(--neutral-base-black);\n  --border-brand-mid: var(--brand-purple-30);\n  --border-error-primary: var(--sentiment-error-50);\n  --border-focused-primary: var(--brand-purple-50);\n  --border-selected-primary: var(--brand-purple-80);\n  --border-accent-orange-mid: var(--brand-orange-30);\n  --border-accent-pink-mid: var(--brand-pink-30);\n  --text-neutral-primary: var(--neutral-base-black);\n  --text-neutral-tertiary: var(--neutral-gray-80);\n  --text-neutral-quaternary: var(--neutral-gray-70);\n  --text-neutral-white-fixed: var(--neutral-base-white);\n  --text-brand-primary: var(--brand-purple-50);\n  --text-brand-secondary: var(--brand-purple-90);\n  --text-error-secondary: var(--sentiment-error-70);\n  --text-selected-primary: var(--sentiment-success-5);\n\n  /* Type, shape, spacing, motion and control size */\n  --font-family-main: \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-family-heading: \"Space Grotesk\", \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-weight-semi-bold: 600;\n  --font-weight-bold: 700;\n  --text-heading-sm: 1.375rem;\n  --text-heading-xs: 1.25rem;\n  --leading-heading-sm: 1.875rem;\n  --leading-heading-xs: 1.75rem;\n  --text-body-lg: 1.125rem;\n  --text-body-md: 1rem;\n  --leading-body-lg: 1.75rem;\n  --leading-body-md: 1.5rem;\n  --shape-sm: .375rem;\n  --shape-md: .5rem;\n  --shape-lg: .625rem;\n  --shape-round: 62.4375rem;\n  --spacing-p-xxs: .5rem;\n  --spacing-p-xs: 1rem;\n  --spacing-p-s: 1.5rem;\n  --duration-short: .15s;\n  --duration-medium: .2s;\n  --easing-standard: cubic-bezier(.4, 0, .2, 1);\n  --easing-out: cubic-bezier(.23, 1, .32, 1);\n  --motion-press-scale: .97;\n  --motion-press-duration: .15s;\n  --motion-press-easing: cubic-bezier(.23, 1, .32, 1);\n  --transition-colors: background-color var(--duration-short) var(--easing-standard), color var(--duration-short) var(--easing-standard), border-color var(--duration-short) var(--easing-standard), box-shadow var(--duration-short) var(--easing-standard), opacity var(--duration-short) var(--easing-standard);\n  --transition-press: transform var(--motion-press-duration) var(--motion-press-easing);\n  --control-height-large: 48px;\n  --control-height-medium: 40px;\n  --control-height-small: 32px;\n  --control-height-extra-small: 24px;\n}\n\n/*\n * Component styles\n *\n * What is CADS here:\n *   - Every color, type size, spacing, radius, control height, motion and\n *     focus value comes from the CADS tokens above. No hard-coded colors.\n *   - Spacing uses the CADS scale: 16px between groups, 8px inside a group.\n *\n * What was rebuilt from the CADS manifest (Web Lab has no CADS components):\n *   - Button: contained primary and outlined, medium, large and small.\n *   - Chip: the example page and display switches (selected tokens when on).\n *   - Tag: Choose, Count and Remember labels.\n *   - TextInput (small, solid border) and an icon-only outlined Button\n *     for the list editor.\n *   - Card surfaces for the three activity panels.\n *\n * What was approximated:\n *   - Geist and Space Grotesk are named by the CADS font tokens, but Web Lab\n *     blocks outside fonts, so the fallback stack in the token applies.\n *   - Tag and input text is 16px, not the 12 to 14px CADS sizes, to meet the\n *     16px minimum.\n *   - The disabled Pick button uses a darker label than the CADS recipe so it\n *     stays readable.\n *   - The icons are inline SVG, not Font Awesome.\n *   - The wheel, the confetti, the bars and the tiles are custom pieces built\n *     only from CADS tokens.\n */\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nhtml {\n  font-size: 100%;\n}\n\nbody {\n  margin: 0;\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-md);\n  line-height: var(--leading-body-md);\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n\n.sprite {\n  position: absolute;\n  width: 0;\n  height: 0;\n  overflow: hidden;\n}\n\n.icon {\n  flex: none;\n  width: 1.25rem;\n  height: 1.25rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\np {\n  margin: 0;\n}\n\n/* ---------- Layout ---------- */\n\n.widget {\n  display: grid;\n  gap: var(--spacing-p-xs);\n  max-width: 55rem;\n  margin: 0 auto;\n  padding: var(--spacing-p-xs);\n}\n\n.error-banner {\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border: 1px solid var(--border-error-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-error-light);\n  color: var(--text-error-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n/* ---------- Buttons (CADS Button recipe) ---------- */\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--spacing-p-xxs);\n  min-height: var(--control-height-medium);\n  padding: 0 var(--spacing-p-xs);\n  border: 1px solid transparent;\n  border-radius: var(--shape-sm);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n  transition: var(--transition-colors), var(--transition-press);\n}\n\n.btn:active {\n  transform: scale(var(--motion-press-scale));\n}\n\n.btn-large {\n  min-height: var(--control-height-large);\n  font-size: var(--text-body-lg);\n}\n\n.btn-small {\n  min-height: var(--control-height-small);\n}\n\n.btn-contained {\n  background: var(--background-brand-primary);\n  color: var(--text-neutral-white-fixed);\n}\n\n.btn-contained:hover {\n  background: var(--background-brand-strong);\n}\n\n.btn-outlined {\n  border-color: var(--border-neutral-solid);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n}\n\n.btn-outlined:hover {\n  background: var(--background-neutral-secondary);\n}\n\n.btn-text {\n  background: transparent;\n  color: var(--text-brand-primary);\n}\n\n.btn-text:hover {\n  background: var(--background-brand-light);\n}\n\n.btn:focus-visible,\n.chip:focus-visible,\n.item-input:focus-visible,\n.remove:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--background-neutral-primary), 0 0 0 4px var(--border-focused-primary);\n}\n\n/* ---------- Header ---------- */\n\n.intro {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  padding: var(--spacing-p-xs);\n  border: 1px solid var(--border-brand-mid);\n  border-radius: var(--shape-lg);\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n}\n\n.intro .tag {\n  background: var(--background-neutral-primary);\n}\n\n.tag {\n  display: inline-flex;\n  align-items: center;\n  min-height: var(--control-height-extra-small);\n  padding: 0 var(--spacing-p-xxs);\n  border: 1px solid var(--border-brand-mid);\n  line-height: calc(var(--control-height-extra-small) - 2px);\n  border-radius: var(--shape-sm);\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.intro-steps .tag {\n  margin-inline-end: var(--spacing-p-xxs);\n}\n\n.intro-steps {\n  margin: 0;\n}\n\n.intro-page,\n.takeaway-page {\n  display: grid;\n  justify-items: start;\n  align-content: start;\n  gap: var(--spacing-p-xs);\n  max-width: 32rem;\n  padding: var(--spacing-p-xs) 0;\n}\n\n.intro-page p,\n.takeaway-page p {\n  margin: 0;\n}\n\n.intro-title {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-sm);\n  font-weight: var(--font-weight-bold);\n  line-height: var(--leading-heading-sm);\n}\n\n.intro-list {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  margin: 0;\n  padding-inline-start: var(--spacing-p-s);\n}\n\n.intro-list li::marker {\n  font-weight: var(--font-weight-bold);\n}\n\n.takeaway-page:focus {\n  outline: none;\n}\n\n.takeaway-parts {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-p-xxs);\n}\n\n.takeaway-parts .part-tag {\n  margin-inline-end: 0;\n}\n\n.takeaway-next {\n  font-size: var(--text-body-lg);\n  line-height: var(--leading-body-lg);\n}\n\n.widget:not([data-stage=\"intro\"]) .intro-page,\n.widget:not([data-stage=\"done\"]) .takeaway-page,\n.widget[data-stage=\"intro\"] .intro,\n.widget[data-stage=\"intro\"] .practice,\n.widget[data-stage=\"done\"] .intro,\n.widget[data-stage=\"done\"] .practice {\n  display: none;\n}\n\n/* ---------- Practice layout ---------- */\n\n.practice {\n  display: grid;\n  gap: var(--spacing-p-xs);\n}\n\n.topbar {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--spacing-p-xxs) var(--spacing-p-xs);\n}\n\n.displays {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-p-xxs);\n}\n\n.page-info {\n  display: grid;\n  gap: 0;\n  min-width: 0;\n}\n\n.page-name {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.page-name .icon {\n  flex: none;\n}\n\n.topbar-actions {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  margin-inline-start: auto;\n}\n\n.see-it {\n  color: var(--text-neutral-tertiary);\n}\n\n.cards {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: var(--spacing-p-xs);\n  align-items: stretch;\n}\n\n.card {\n  min-width: 0;\n  padding: var(--spacing-p-xs);\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-lg);\n  background: var(--background-neutral-primary);\n}\n\n.card h2 {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-xs);\n  line-height: var(--leading-heading-xs);\n}\n\n/* The tallest card (a full list of six) sets the height, so nothing moves when the list changes */\n.cards .card {\n  display: grid;\n  align-content: start;\n  gap: var(--spacing-p-xxs);\n  min-height: calc(var(--spacing-p-xs) * 3 + var(--leading-heading-xs) + var(--control-height-small) * 6 + var(--spacing-p-xxs) * 5 + 2px);\n}\n\n.cards .card h2 {\n  margin-bottom: var(--spacing-p-xxs);\n}\n\n/* ---------- Chips (CADS Chip recipe) ---------- */\n\n.chip {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  min-height: var(--control-height-medium);\n  padding: 0 var(--spacing-p-xs);\n  border: 1px solid var(--border-neutral-solid);\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  white-space: nowrap;\n  cursor: pointer;\n  transition: var(--transition-colors), var(--transition-press);\n}\n\n.chip-small {\n  min-height: var(--control-height-small);\n  padding: 0 var(--spacing-p-xxs);\n}\n\n.chip:hover:not([aria-pressed=\"true\"]) {\n  background: var(--background-neutral-secondary);\n}\n\n.chip:active {\n  transform: scale(var(--motion-press-scale));\n}\n\n.chip[aria-pressed=\"true\"] {\n  border-color: var(--border-selected-primary);\n  background: var(--background-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n/* ---------- Random pick card ---------- */\n\n.pick-card {\n  justify-items: center;\n}\n\n.pick-card h2 {\n  justify-self: start;\n}\n\n.widget {\n  --wheel-1: var(--background-brand-mid);\n  --wheel-2: var(--background-accent-orange-mid);\n  --wheel-3: var(--background-accent-pink-mid);\n  --wheel-4: var(--background-info-mid);\n  --wheel-5: var(--background-success-mid);\n  --wheel-6: var(--background-warning-mid);\n}\n\n.wheel-wrap {\n  position: relative;\n  width: 6.5rem;\n  height: 6.5rem;\n}\n\n.wheel {\n  width: 100%;\n  height: 100%;\n  border: 3px solid var(--border-neutral-solid);\n  border-radius: 50%;\n  background: var(--wheel);\n  transform: rotate(var(--turn, 0deg));\n  transition: transform 1.2s var(--easing-out);\n}\n\n.wheel-hub {\n  position: absolute;\n  inset-block-start: 50%;\n  inset-inline-start: 50%;\n  width: 1.25rem;\n  height: 1.25rem;\n  margin: -0.625rem;\n  border: 3px solid var(--border-neutral-solid);\n  border-radius: 50%;\n  background: var(--background-neutral-primary);\n}\n\n.wheel-pointer {\n  position: absolute;\n  inset-block-start: -0.75rem;\n  inset-inline-start: 50%;\n  width: 0;\n  height: 0;\n  margin-inline-start: -0.5rem;\n  border-inline: 0.5rem solid transparent;\n  border-block-start: 1rem solid var(--border-neutral-solid);\n}\n\n.swatch {\n  display: inline-block;\n  flex: none;\n  width: 1rem;\n  height: 1rem;\n  border: 1px solid var(--border-neutral-solid);\n  background: var(--c);\n}\n\n.result {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--spacing-p-xxs);\n  font-family: var(--font-family-heading);\n  font-size: var(--text-body-lg);\n  font-weight: var(--font-weight-bold);\n  line-height: var(--leading-body-lg);\n}\n\n.result.muted {\n  color: var(--text-neutral-quaternary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.btn[aria-disabled=\"true\"] {\n  background: var(--background-disabled-neutral);\n  color: var(--text-neutral-tertiary);\n  cursor: default;\n}\n\n.tally {\n  position: relative;\n  color: var(--text-neutral-tertiary);\n}\n\n/* Small confetti on each pick */\n.confetti {\n  position: absolute;\n  inset-block-start: 50%;\n  inset-inline-start: 50%;\n  pointer-events: none;\n}\n\n.piece {\n  position: absolute;\n  width: 0.5rem;\n  height: 0.5rem;\n  border-radius: 50%;\n  animation: burst 0.8s var(--easing-out) forwards;\n}\n\n.piece-1 {\n  background: var(--background-brand-primary);\n}\n\n.piece-2 {\n  background: var(--background-accent-orange-primary);\n}\n\n.piece-3 {\n  background: var(--background-accent-pink-primary);\n}\n\n.piece-4 {\n  background: var(--background-success-primary);\n}\n\n@keyframes burst {\n  0% {\n    opacity: 1;\n    transform: translate(0, 0) scale(1);\n  }\n\n  100% {\n    opacity: 0;\n    transform: translate(var(--dx), var(--dy)) scale(0.6);\n  }\n}\n\n/* ---------- List card (CADS TextInput small and icon-only Button) ---------- */\n\n.items {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.item {\n  display: grid;\n  grid-template-columns: 1rem minmax(0, 1fr) var(--control-height-small);\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n}\n\n.item-input {\n  min-width: 0;\n  height: var(--control-height-small);\n  padding: 0 var(--spacing-p-xxs);\n  border: 1px solid var(--border-neutral-solid);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font: inherit;\n}\n\n.remove {\n  display: grid;\n  place-items: center;\n  width: var(--control-height-small);\n  height: var(--control-height-small);\n  padding: 0;\n  border: 1px solid var(--border-neutral-solid);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  cursor: pointer;\n  transition: var(--transition-colors), var(--transition-press);\n}\n\n.remove:hover:not(:disabled) {\n  background: var(--background-neutral-secondary);\n}\n\n.remove:active:not(:disabled) {\n  transform: scale(var(--motion-press-scale));\n}\n\n.remove:disabled {\n  border-color: var(--border-neutral-primary);\n  color: var(--text-neutral-quaternary);\n  cursor: default;\n}\n\n#add {\n  justify-self: start;\n}\n\n/* ---------- Saved picks card ---------- */\n\n.show-label {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.show-as {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n}\n\n.display {\n  min-height: calc(var(--leading-body-md) * 6);\n  margin-top: var(--spacing-p-xxs);\n}\n\n.display-empty {\n  color: var(--text-neutral-quaternary);\n}\n\n.count-list,\n.bar-list,\n.recent-list {\n  display: grid;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.count-row,\n.bar-row {\n  display: grid;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  min-height: var(--leading-body-md);\n}\n\n.count-row {\n  grid-template-columns: 1rem minmax(0, 1fr) auto;\n}\n\n.bar-row {\n  grid-template-columns: minmax(0, 6rem) minmax(0, 1fr) 1.5rem;\n}\n\n.row-name {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.row-count {\n  font-weight: var(--font-weight-semi-bold);\n  text-align: end;\n}\n\n.bar-track {\n  display: block;\n  height: 0.75rem;\n  overflow: hidden;\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-secondary);\n}\n\n.bar-fill {\n  display: block;\n  width: calc(var(--w, 0) * 1%);\n  height: 100%;\n  border: 1px solid var(--border-neutral-solid);\n  border-radius: var(--shape-round);\n  background: var(--c);\n  transition: width var(--duration-medium) var(--easing-out);\n}\n\n.recent-list {\n  counter-reset: pick;\n}\n\n.recent-row {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  min-height: var(--leading-body-md);\n  counter-increment: pick;\n}\n\n.recent-row::before {\n  content: counter(pick) \".\";\n  min-width: 1.25rem;\n  color: var(--text-neutral-quaternary);\n}\n\n.recent-row:first-child {\n  font-weight: var(--font-weight-bold);\n}\n\n/* ---------- Strip: Choose, Count, Remember ---------- */\n\n.strip {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  padding: var(--spacing-p-xs);\n  border-radius: var(--shape-lg);\n  background: var(--background-neutral-secondary);\n}\n\n.strip-title {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-xs);\n  line-height: var(--leading-heading-xs);\n}\n\n.strip-row {\n  display: grid;\n  grid-template-columns: 6.5rem minmax(0, 1fr);\n  align-items: center;\n  gap: var(--spacing-p-xs);\n  min-height: var(--control-height-small);\n}\n\n.strip-body {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  min-width: 0;\n}\n\n.strip-row .part-tag {\n  justify-self: start;\n}\n\n.strip-text {\n  position: relative;\n}\n\n.tiles {\n  display: flex;\n  gap: var(--spacing-p-xxs);\n  min-width: 0;\n  width: 100%;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.tiles:empty {\n  display: none;\n}\n\n.tile {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  min-width: 0;\n  max-width: 33%;\n  overflow: hidden;\n  padding: 0 var(--spacing-p-xxs);\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-secondary);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: calc(var(--control-height-small) - 2px);\n}\n\n.tile-name {\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.tile-new {\n  animation: pop 0.4s var(--easing-out);\n}\n\n@keyframes pop {\n  0% {\n    opacity: 0;\n    transform: translateX(calc(var(--spacing-p-xs) * -1)) scale(0.9);\n  }\n\n  100% {\n    opacity: 1;\n    transform: none;\n  }\n}\n\n/* Something new flashes so it points back to the pick that caused it */\n.fresh::after {\n  content: \"\";\n  position: absolute;\n  inset: -2px;\n  border-radius: var(--shape-sm);\n  background: var(--background-brand-mid);\n  opacity: 0;\n  pointer-events: none;\n  animation: flash 0.7s var(--easing-out);\n}\n\n@keyframes flash {\n  0% {\n    opacity: 0.7;\n  }\n\n  100% {\n    opacity: 0;\n  }\n}\n\n/* ---------- Tags (CADS Tag recipe) ---------- */\n\n.part-tag {\n  display: inline-block;\n  padding: 0 var(--spacing-p-xxs);\n  border: 1px solid;\n  border-radius: var(--shape-sm);\n  color: var(--text-neutral-primary);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: calc(var(--control-height-extra-small) - 2px);\n}\n\n.part-tag[data-part=\"choose\"] {\n  border-color: var(--border-brand-mid);\n  background: var(--background-brand-light);\n}\n\n.part-tag[data-part=\"count\"] {\n  border-color: var(--border-accent-orange-mid);\n  background: var(--background-accent-orange-light);\n}\n\n.part-tag[data-part=\"remember\"] {\n  border-color: var(--border-accent-pink-mid);\n  background: var(--background-accent-pink-light);\n}\n\n/* ---------- Small screens ---------- */\n\n@media (max-width: 47.99rem) {\n  .cards {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .strip-row {\n    grid-template-columns: minmax(0, 1fr);\n    gap: var(--spacing-p-xxs);\n  }\n\n  .cards .card {\n    min-height: 0;\n  }\n\n  .tile {\n    max-width: 40%;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n\n  .confetti {\n    display: none;\n  }\n\n  .btn:active,\n  .chip:active,\n  .remove:active {\n    transform: none;\n  }\n}\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Language of web dev</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <svg class=\"sprite\" aria-hidden=\"true\" focusable=\"false\">\n    <symbol id=\"icon-check\" viewBox=\"0 0 24 24\">\n      <path d=\"M5 12.5l4.5 4.5L19 7.5\"/>\n    </symbol>\n    <symbol id=\"icon-cross\" viewBox=\"0 0 24 24\">\n      <path d=\"M6 6l12 12M18 6L6 18\"/>\n    </symbol>\n    <symbol id=\"icon-arrow\" viewBox=\"0 0 24 24\">\n      <path d=\"M5 12h14M13 6l6 6-6 6\"/>\n    </symbol>\n    <symbol id=\"icon-plus\" viewBox=\"0 0 24 24\">\n      <path d=\"M12 5v14M5 12h14\"/>\n    </symbol>\n  </svg>\n\n  <main class=\"widget\" id=\"widget\" data-stage=\"intro\">\n    <h1 class=\"visually-hidden\">Language of web dev</h1>\n\n    <p class=\"error-banner\" id=\"error-banner\" role=\"alert\" hidden></p>\n    <p class=\"visually-hidden\" id=\"announcer\" aria-live=\"polite\"></p>\n\n    <section class=\"intro-page\" id=\"intro-page\" aria-labelledby=\"intro-title\">\n      <p><span class=\"tag\">Practice</span></p>\n      <h2 class=\"intro-title\" id=\"intro-title\">Make a page choose, count and remember</h2>\n      <p class=\"intro-lead\">A <strong>random pick</strong> chooses one item from a list by chance. A page can also count each pick and remember it.</p>\n      <ol class=\"intro-list\">\n        <li>Edit the list and press Pick 3 times.</li>\n        <li>Switch how the picks are shown.</li>\n        <li>Press Next example. Try all three examples.</li>\n      </ol>\n      <button class=\"btn btn-contained\" id=\"intro-start\" type=\"button\">Start</button>\n    </section>\n\n    <header class=\"intro\">\n      <p class=\"intro-steps\"><span class=\"tag\">Practice</span><strong>Do This:</strong> Edit the list. Press Pick 3 times. Switch how picks are shown. Press Next to try all three.</p>\n    </header>\n\n    <section class=\"practice\" id=\"practice\" aria-label=\"Practice\">\n      <div class=\"topbar\">\n        <div class=\"page-info\">\n          <p class=\"page-name\" id=\"page-name\"></p>\n          <p class=\"see-it\" id=\"see-it\"></p>\n        </div>\n        <div class=\"topbar-actions\">\n          <button class=\"btn btn-outlined\" id=\"next\" type=\"button\">\n            <span>Next example</span>\n            <svg class=\"icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#icon-arrow\"/></svg>\n          </button>\n          <button class=\"btn btn-contained\" id=\"finish\" type=\"button\" hidden>Finish</button>\n        </div>\n      </div>\n      <div class=\"cards\">\n        <section class=\"card list-card\" aria-labelledby=\"list-title\">\n          <h2 id=\"list-title\">Your list</h2>\n          <ul class=\"items\" id=\"items\"></ul>\n          <button class=\"btn btn-outlined btn-small\" id=\"add\" type=\"button\">\n            <svg class=\"icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#icon-plus\"/></svg>\n            <span>Add item</span>\n          </button>\n        </section>\n\n        <section class=\"card pick-card\" aria-labelledby=\"pick-title\">\n          <h2 id=\"pick-title\">Random pick</h2>\n          <div class=\"wheel-wrap\" aria-hidden=\"true\">\n            <div class=\"wheel\" id=\"wheel\"></div>\n            <span class=\"wheel-pointer\"></span>\n            <span class=\"wheel-hub\"></span>\n          </div>\n          <p class=\"result\" id=\"result\"></p>\n          <button class=\"btn btn-contained btn-large\" id=\"pick\" type=\"button\">Pick</button>\n          <p class=\"tally\">\n            <span id=\"tally-text\"></span>\n            <span class=\"confetti\" id=\"confetti\" aria-hidden=\"true\"></span>\n          </p>\n        </section>\n\n        <section class=\"card saved-card\" aria-labelledby=\"saved-title\">\n          <h2 id=\"saved-title\">Saved picks</h2>\n          <div class=\"show-as\" role=\"group\" aria-labelledby=\"show-label\">\n            <p class=\"show-label\" id=\"show-label\">Show picks as</p>\n            <div class=\"displays\" id=\"displays\"></div>\n          </div>\n          <div class=\"display\" id=\"display\"></div>\n        </section>\n      </div>\n\n      <section class=\"strip\" id=\"strip\" aria-labelledby=\"strip-title\">\n        <h2 class=\"strip-title\" id=\"strip-title\">What the page does</h2>\n        <div class=\"strip-row\">\n          <span class=\"part-tag\" data-part=\"choose\">Choose</span>\n          <p class=\"strip-text\" id=\"strip-choose\"></p>\n        </div>\n        <div class=\"strip-row\">\n          <span class=\"part-tag\" data-part=\"count\">Count</span>\n          <p class=\"strip-text\" id=\"strip-count\"></p>\n        </div>\n        <div class=\"strip-row\">\n          <span class=\"part-tag\" data-part=\"remember\">Remember</span>\n          <div class=\"strip-body\">\n            <p class=\"strip-text\" id=\"strip-remember\"></p>\n            <ul class=\"tiles\" id=\"tiles\" aria-label=\"Last three picks\"></ul>\n          </div>\n        </div>\n      </section>\n    </section>\n\n    <section class=\"takeaway-page\" id=\"takeaway\" aria-labelledby=\"takeaway-title\" tabindex=\"-1\">\n      <h2 class=\"intro-title\" id=\"takeaway-title\">Takeaway: A page chooses, counts and remembers</h2>\n      <p class=\"intro-lead\">A list holds the options. A random pick chooses one by chance. The page can count each pick and save it to show again. You can use all three in your project.</p>\n      <p class=\"takeaway-parts\">\n        <span class=\"part-tag\" data-part=\"choose\">Choose</span>\n        <span class=\"part-tag\" data-part=\"count\">Count</span>\n        <span class=\"part-tag\" data-part=\"remember\">Remember</span>\n      </p>\n      <p class=\"takeaway-next\"><strong>Press Continue to go to your project.</strong></p>\n    </section>\n  </main>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "'use strict';\n\n/* ------------------------------------------------------------------ *\n * Settings\n * ------------------------------------------------------------------ */\n\nconst CONFIG = {\n  // Set to false to skip the intro page.\n  startWithIntro: true,\n  // Picks needed on each example page before it counts as done.\n  picksNeeded: 3,\n  minItems: 2,\n  maxItems: 6,\n  maxLength: 16,\n  // Time the wheel spends turning, in milliseconds.\n  spinMs: 1200,\n};\n\n/* ------------------------------------------------------------------ *\n * Copy shared by every example page\n * ------------------------------------------------------------------ */\n\nconst COPY = {\n  errorBanner: 'Something went wrong loading this activity. Try refreshing the page.',\n\n  pageDone: 'done',\n  pageName: (number, total, label) => `Example ${number} of ${total}: ${label}`,\n  resultWaiting: 'Press Pick',\n  tally: (total, needed) => (total < needed\n    ? `Picks so far: ${total} of ${needed}`\n    : `Picks so far: ${total}`),\n\n  displays: { count: 'Count', bar: 'Bar', recent: 'Recent' },\n  noPicks: 'No picks yet. Press Pick.',\n\n  itemLabel: (number) => `Item ${number}`,\n  removeLabel: (name) => `Remove ${name}`,\n  newItem: 'New item',\n\n  // The strip under the cards names the three ideas\n  stripChooseStart: 'The page chooses one item randomly when Pick is pressed.',\n  stripCountStart: 'The page counts how many times each item is chosen.',\n  stripRememberStart: 'The page saves the last three picks to show again.',\n  tilesLabel: (names) => `Last three picks: ${names.join(', ')}`,\n\n  announcePick: (sentence, total) => `${sentence} Picks so far: ${total}.`,\n  announcePageDone: (label, remaining) => (remaining > 0\n    ? `${label} is done. ${remaining} more ${remaining === 1 ? 'example' : 'examples'} to try.`\n    : 'All three examples are done. Press Finish.'),\n  announceAdded: (name) => `${name} added to the list.`,\n  announceRemoved: (name) => `${name} removed from the list.`,\n};\n\n/* ------------------------------------------------------------------ *\n * Copy for each example page\n * ------------------------------------------------------------------ */\n\nfunction plural(count, one, other) {\n  return count === 1 ? one : other;\n}\n\nconst PAGES = [\n  {\n    id: 'hub',\n    label: 'Group project hub',\n    items: ['Ana', 'Ben', 'Chloe', 'Dev', 'Elena'],\n    seeIt: 'A group project hub uses a random pick to share turns fairly.',\n    chooseText: (name) => `A random pick chose ${name} to present next.`,\n    countText: (name, count) => `${name} has had ${count} ${plural(count, 'turn', 'turns')}.`,\n  },\n  {\n    id: 'study',\n    label: 'Study review',\n    items: ['Variables', 'Loops', 'Lists', 'Events', 'Functions'],\n    seeIt: 'A study app uses a random pick to mix up what you review.',\n    chooseText: (name) => `A random pick chose ${name} as the next topic.`,\n    countText: (name, count) => `${name} has come up ${count} ${plural(count, 'time', 'times')}.`,\n  },\n  {\n    id: 'loot',\n    label: 'Game loot drop',\n    items: ['Coin', 'Potion', 'Shield', 'Gem', 'Map'],\n    seeIt: 'Game designers use random picks for things like loot drops and shuffled cards.',\n    chooseText: (name) => `A random pick chose ${name} as the next drop.`,\n    countText: (name, count) => `${name} has dropped ${count} ${plural(count, 'time', 'times')}.`,\n  },\n];\n\n/* ------------------------------------------------------------------ *\n * State and constants\n * ------------------------------------------------------------------ */\n\nconst SVG_NS = 'http://www.w3.org/2000/svg';\nconst DISPLAY_ORDER = ['count', 'bar', 'recent'];\nconst WHEEL_COLORS = 6;\nconst CONFETTI_PIECES = 10;\nconst RECENT_ROWS = 6;\n\nconst state = {\n  page: 0,\n  pages: PAGES.map((page) => ({\n    items: page.items.map((name, index) => ({ id: index + 1, name, color: index + 1 })),\n    nextId: page.items.length + 1,\n    picks: [],\n    display: 'count',\n    turn: 0,\n    lastPick: null,\n  })),\n  busy: false,\n  completed: false,\n};\n\nconst els = {};\nlet pendingFocus = null;\n\n/* ------------------------------------------------------------------ *\n * Helpers\n * ------------------------------------------------------------------ */\n\nfunction el(tag, className, text) {\n  const node = document.createElement(tag);\n  if (className) node.className = className;\n  if (text !== undefined) node.textContent = text;\n  return node;\n}\n\nfunction icon(id) {\n  const svg = document.createElementNS(SVG_NS, 'svg');\n  svg.setAttribute('class', 'icon');\n  svg.setAttribute('aria-hidden', 'true');\n  svg.setAttribute('focusable', 'false');\n  const use = document.createElementNS(SVG_NS, 'use');\n  use.setAttribute('href', `#${id}`);\n  svg.append(use);\n  return svg;\n}\n\n// A small colored square. It matches the item's slice on the wheel.\nfunction swatch(color) {\n  const square = el('span', 'swatch');\n  square.style.setProperty('--c', `var(--wheel-${color})`);\n  square.setAttribute('aria-hidden', 'true');\n  return square;\n}\n\n// Each item keeps its color. A new item takes the first color not in use.\nfunction nextColor(items) {\n  const used = new Set(items.map((item) => item.color));\n  for (let color = 1; color <= WHEEL_COLORS; color += 1) {\n    if (!used.has(color)) return color;\n  }\n  return 1;\n}\n\nfunction pageData() {\n  return PAGES[state.page];\n}\n\nfunction pageState(index) {\n  return state.pages[index === undefined ? state.page : index];\n}\n\nfunction isDone(index) {\n  return pageState(index).picks.length >= CONFIG.picksNeeded;\n}\n\nfunction allDone() {\n  return PAGES.every((page, index) => isDone(index));\n}\n\nfunction prefersReducedMotion() {\n  return window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n}\n\nfunction announce(message) {\n  els.announcer.textContent = '';\n  // A short delay makes repeated messages get read again\n  window.setTimeout(() => { els.announcer.textContent = message; }, 30);\n}\n\nfunction countFor(itemId) {\n  return pageState().picks.filter((pick) => pick.id === itemId).length;\n}\n\n/* ------------------------------------------------------------------ *\n * Example pages (name and Next button)\n * ------------------------------------------------------------------ */\n\nfunction renderPages() {\n  const data = pageData();\n  els.pageName.replaceChildren();\n  if (isDone(state.page)) {\n    els.pageName.append(icon('icon-check'));\n    els.pageName.append(el('span', 'visually-hidden', `${COPY.pageDone}: `));\n  }\n  els.pageName.append(el('span', '', COPY.pageName(state.page + 1, PAGES.length, data.label)));\n}\n\nfunction nextPage() {\n  if (state.busy) return;\n  state.page = (state.page + 1) % PAGES.length;\n  renderAll();\n  announce(COPY.pageName(state.page + 1, PAGES.length, pageData().label));\n}\n\n/* ------------------------------------------------------------------ *\n * The list (students edit it)\n * ------------------------------------------------------------------ */\n\nfunction renderList() {\n  const items = pageState().items;\n  els.items.replaceChildren();\n  items.forEach((item, index) => {\n    const row = el('li', 'item');\n    const input = el('input', 'item-input');\n    input.type = 'text';\n    input.value = item.name;\n    input.maxLength = CONFIG.maxLength;\n    input.dataset.id = String(item.id);\n    input.setAttribute('aria-label', COPY.itemLabel(index + 1));\n\n    const remove = el('button', 'remove');\n    remove.type = 'button';\n    remove.dataset.id = String(item.id);\n    remove.disabled = items.length <= CONFIG.minItems;\n    remove.setAttribute('aria-label', COPY.removeLabel(item.name));\n    remove.append(icon('icon-cross'));\n\n    row.append(swatch(item.color), input, remove);\n    els.items.append(row);\n  });\n  els.add.hidden = items.length >= CONFIG.maxItems;\n}\n\nfunction findItem(id) {\n  return pageState().items.find((item) => item.id === id);\n}\n\nfunction renameItem(input) {\n  const item = findItem(Number(input.dataset.id));\n  if (!item) return;\n  // An empty name is ignored until the student types something\n  if (input.value.trim() === '') return;\n  item.name = input.value;\n  const remove = els.items.querySelector(`.remove[data-id=\"${item.id}\"]`);\n  if (remove) remove.setAttribute('aria-label', COPY.removeLabel(item.name));\n  renderDisplay();\n}\n\nfunction restoreName(input) {\n  const item = findItem(Number(input.dataset.id));\n  if (item && input.value.trim() === '') input.value = item.name;\n}\n\nfunction addItem() {\n  const page = pageState();\n  if (page.items.length >= CONFIG.maxItems) return;\n  const item = { id: page.nextId, name: COPY.newItem, color: nextColor(page.items) };\n  page.nextId += 1;\n  page.items.push(item);\n  pendingFocus = `input:${item.id}`;\n  renderList();\n  renderWheel();\n  renderDisplay();\n  applyFocus();\n  announce(COPY.announceAdded(item.name));\n}\n\nfunction removeItem(id) {\n  const page = pageState();\n  if (page.items.length <= CONFIG.minItems) return;\n  const index = page.items.findIndex((item) => item.id === id);\n  if (index < 0) return;\n  const [removed] = page.items.splice(index, 1);\n  const neighbor = page.items[Math.min(index, page.items.length - 1)];\n  pendingFocus = `input:${neighbor.id}`;\n  renderList();\n  renderWheel();\n  renderDisplay();\n  applyFocus();\n  announce(COPY.announceRemoved(removed.name));\n}\n\nfunction applyFocus() {\n  if (!pendingFocus) return;\n  const [kind, id] = pendingFocus.split(':');\n  pendingFocus = null;\n  let target = null;\n  if (kind === 'input') target = els.items.querySelector(`.item-input[data-id=\"${id}\"]`);\n  if (target) {\n    target.focus();\n    target.select();\n  }\n}\n\n/* ------------------------------------------------------------------ *\n * The wheel and the pick\n * ------------------------------------------------------------------ */\n\nfunction renderWheel() {\n  const items = pageState().items;\n  const slice = 360 / items.length;\n  const stops = items.map((item, index) => (\n    `var(--wheel-${item.color}) ${index * slice}deg ${(index + 1) * slice}deg`\n  ));\n  els.wheel.style.setProperty('--wheel', `conic-gradient(${stops.join(', ')})`);\n  els.wheel.style.setProperty('--turn', `${pageState().turn}deg`);\n}\n\nfunction renderResult() {\n  const last = pageState().lastPick;\n  els.result.replaceChildren();\n  if (last) {\n    els.result.append(swatch(last.color), el('span', '', last.name));\n  } else {\n    els.result.append(el('span', '', COPY.resultWaiting));\n  }\n  els.result.classList.toggle('muted', !last);\n}\n\nfunction renderTally() {\n  els.tallyText.textContent = COPY.tally(pageState().picks.length, CONFIG.picksNeeded);\n}\n\nfunction spawnConfetti() {\n  if (prefersReducedMotion()) return;\n  els.confetti.replaceChildren();\n  for (let i = 0; i < CONFETTI_PIECES; i += 1) {\n    const piece = el('span', `piece piece-${(i % 4) + 1}`);\n    const angle = (360 / CONFETTI_PIECES) * i + Math.random() * 20;\n    const distance = 24 + Math.random() * 24;\n    piece.style.setProperty('--dx', `${Math.round(Math.cos((angle * Math.PI) / 180) * distance)}px`);\n    piece.style.setProperty('--dy', `${Math.round(Math.sin((angle * Math.PI) / 180) * distance)}px`);\n    els.confetti.append(piece);\n  }\n  window.setTimeout(() => els.confetti.replaceChildren(), 900);\n}\n\nfunction pick() {\n  if (state.busy) return;\n  const page = pageState();\n  const items = page.items;\n  const index = Math.floor(Math.random() * items.length);\n  const chosen = items[index];\n\n  // Turn the wheel so the chosen slice ends up under the pointer\n  const slice = 360 / items.length;\n  const target = (360 - (index + 0.5) * slice + 360) % 360;\n  const current = ((page.turn % 360) + 360) % 360;\n  const delta = (target - current + 360) % 360;\n  page.turn += 1080 + delta;\n  els.wheel.style.setProperty('--turn', `${page.turn}deg`);\n\n  state.busy = true;\n  els.pick.setAttribute('aria-disabled', 'true');\n  window.setTimeout(() => finishPick(chosen), prefersReducedMotion() ? 0 : CONFIG.spinMs);\n}\n\nfunction finishPick(chosen) {\n  const page = pageState();\n  const wasDone = isDone(state.page);\n  const record = { id: chosen.id, name: chosen.name, color: chosen.color };\n  page.picks.push(record);\n  page.lastPick = record;\n  state.busy = false;\n  els.pick.removeAttribute('aria-disabled');\n\n  renderResult();\n  renderTally();\n  renderDisplay();\n  renderStrip(true);\n  spawnConfetti();\n  renderPages();\n  renderFinish();\n\n  const data = pageData();\n  let message = COPY.announcePick(\n    `${data.chooseText(record.name)} ${data.countText(record.name, countFor(record.id))}`,\n    page.picks.length\n  );\n  if (!wasDone && isDone(state.page)) {\n    const remaining = PAGES.filter((_, index) => !isDone(index)).length;\n    message += ` ${COPY.announcePageDone(data.label, remaining)}`;\n  }\n  announce(message);\n}\n\n/* ------------------------------------------------------------------ *\n * Saved picks (Count, Bar or Recent)\n * ------------------------------------------------------------------ */\n\nfunction renderDisplayChips() {\n  els.displays.replaceChildren();\n  DISPLAY_ORDER.forEach((mode) => {\n    const chip = el('button', 'chip chip-small', COPY.displays[mode]);\n    chip.type = 'button';\n    chip.dataset.display = mode;\n    chip.setAttribute('aria-pressed', String(pageState().display === mode));\n    els.displays.append(chip);\n  });\n}\n\nfunction renderDisplay() {\n  const page = pageState();\n  const items = page.items;\n  els.display.replaceChildren();\n\n  if (page.picks.length === 0) {\n    els.display.append(el('p', 'display-empty', COPY.noPicks));\n    return;\n  }\n\n  if (page.display === 'recent') {\n    const list = el('ol', 'recent-list');\n    page.picks.slice(-RECENT_ROWS).reverse().forEach((record) => {\n      const row = el('li', 'recent-row');\n      row.append(swatch(record.color), el('span', 'row-name', record.name));\n      list.append(row);\n    });\n    els.display.append(list);\n    return;\n  }\n\n  const max = Math.max(1, ...items.map((item) => countFor(item.id)));\n  const list = el('ul', page.display === 'bar' ? 'bar-list' : 'count-list');\n  items.forEach((item) => {\n    const count = countFor(item.id);\n    const row = el('li', page.display === 'bar' ? 'bar-row' : 'count-row');\n    if (page.display === 'bar') {\n      row.append(el('span', 'row-name', item.name));\n      const track = el('span', 'bar-track');\n      if (count > 0) {\n        const fill = el('span', 'bar-fill');\n        fill.style.setProperty('--w', String(Math.round((count / max) * 100)));\n        fill.style.setProperty('--c', `var(--wheel-${item.color})`);\n        track.append(fill);\n      }\n      row.append(track);\n    } else {\n      row.append(swatch(item.color), el('span', 'row-name', item.name));\n    }\n    row.append(el('span', 'row-count', String(count)));\n    list.append(row);\n  });\n  els.display.append(list);\n}\n\nfunction setDisplay(mode) {\n  pageState().display = mode;\n  renderDisplayChips();\n  renderDisplay();\n}\n\n/* ------------------------------------------------------------------ *\n * The strip: Choose, Count, Remember\n * ------------------------------------------------------------------ */\n\nfunction setStrip(node, text, fresh) {\n  node.textContent = text;\n  node.classList.toggle('fresh', Boolean(fresh));\n}\n\nfunction renderStrip(fresh) {\n  const page = pageState();\n  const data = pageData();\n  const last = page.lastPick;\n\n  els.tiles.replaceChildren();\n\n  if (!last) {\n    setStrip(els.stripChoose, COPY.stripChooseStart, false);\n    setStrip(els.stripCount, COPY.stripCountStart, false);\n    setStrip(els.stripRemember, COPY.stripRememberStart, false);\n    els.stripRemember.hidden = false;\n    els.tiles.removeAttribute('aria-label');\n    return;\n  }\n\n  setStrip(els.stripChoose, data.chooseText(last.name), fresh);\n  setStrip(els.stripCount, data.countText(last.name, countFor(last.id)), fresh);\n\n  // The shelf keeps the last three picks, newest first\n  const recent = page.picks.slice(-3).reverse();\n  recent.forEach((record, index) => {\n    const tile = el('li', index === 0 && fresh ? 'tile tile-new' : 'tile');\n    tile.append(swatch(record.color), el('span', 'tile-name', record.name));\n    els.tiles.append(tile);\n  });\n  els.tiles.setAttribute('aria-label', COPY.tilesLabel(recent.map((record) => record.name)));\n  els.stripRemember.hidden = true;\n}\n\n/* ------------------------------------------------------------------ *\n * Finish and the takeaway page\n * ------------------------------------------------------------------ */\n\nfunction renderFinish() {\n  els.finish.hidden = !allDone();\n}\n\nfunction markComplete() {\n  if (state.completed) return;\n  state.completed = true;\n  // Completion is the only thing recorded. Hook this up to the level's completion call.\n  try {\n    document.dispatchEvent(new CustomEvent('widget:complete'));\n    if (window.parent && window.parent !== window) {\n      window.parent.postMessage({ type: 'widget-complete' }, '*');\n    }\n  } catch (error) {\n    // Completion is best effort and must never break the activity\n  }\n}\n\nfunction finish() {\n  markComplete();\n  els.widget.dataset.stage = 'done';\n  els.takeaway.focus();\n}\n\n/* ------------------------------------------------------------------ *\n * Whole-widget render and start up\n * ------------------------------------------------------------------ */\n\nfunction renderAll() {\n  renderPages();\n  els.seeIt.textContent = pageData().seeIt;\n  renderList();\n  renderWheel();\n  renderResult();\n  renderTally();\n  renderDisplayChips();\n  renderDisplay();\n  renderStrip(false);\n  renderFinish();\n}\n\nfunction cacheElements() {\n  const ids = {\n    widget: 'widget',\n    errorBanner: 'error-banner',\n    announcer: 'announcer',\n    introStart: 'intro-start',\n    pageName: 'page-name',\n    next: 'next',\n    finish: 'finish',\n    seeIt: 'see-it',\n    wheel: 'wheel',\n    result: 'result',\n    pick: 'pick',\n    tallyText: 'tally-text',\n    confetti: 'confetti',\n    items: 'items',\n    add: 'add',\n    displays: 'displays',\n    display: 'display',\n    stripChoose: 'strip-choose',\n    stripCount: 'strip-count',\n    stripRemember: 'strip-remember',\n    tiles: 'tiles',\n    takeaway: 'takeaway',\n  };\n  Object.keys(ids).forEach((name) => {\n    els[name] = document.getElementById(ids[name]);\n    if (!els[name]) throw new Error(`Missing element: ${ids[name]}`);\n  });\n}\n\nfunction startPractice() {\n  els.widget.dataset.stage = 'practice';\n  els.pick.focus();\n}\n\nfunction bindEvents() {\n  els.introStart.addEventListener('click', startPractice);\n  els.pick.addEventListener('click', pick);\n  els.add.addEventListener('click', addItem);\n  els.finish.addEventListener('click', finish);\n\n  els.next.addEventListener('click', nextPage);\n  els.displays.addEventListener('click', (event) => {\n    const chip = event.target.closest('.chip');\n    if (!chip) return;\n    setDisplay(chip.dataset.display);\n    const again = els.displays.querySelector(`[data-display=\"${chip.dataset.display}\"]`);\n    if (again) again.focus();\n  });\n  els.items.addEventListener('input', (event) => {\n    if (event.target.classList.contains('item-input')) renameItem(event.target);\n  });\n  els.items.addEventListener('focusout', (event) => {\n    if (event.target.classList.contains('item-input')) restoreName(event.target);\n  });\n  els.items.addEventListener('click', (event) => {\n    const button = event.target.closest('.remove');\n    if (button && !button.disabled) removeItem(Number(button.dataset.id));\n  });\n}\n\nfunction init() {\n  try {\n    cacheElements();\n    bindEvents();\n    renderAll();\n    els.widget.dataset.stage = CONFIG.startWithIntro ? 'intro' : 'practice';\n  } catch (error) {\n    const banner = document.getElementById('error-banner');\n    if (banner) {\n      banner.textContent = COPY.errorBanner;\n      banner.hidden = false;\n    }\n  }\n}\n\ninit();\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    },
