'b', 'b'],\n        ['b', 'b', 'b', 'b', 'b', 'b', 'b', 'b'],\n        ['.', 'b', 'b', 'b', 'b', 'b', 'b', '.'],\n        ['.', '.', 'b', 'b', 'b', 'b', '.', '.'],\n    ],\n};\n\n// Color palettes for each sprite — maps letter codes to hex colors.\nconst SPRITE_COLORS = {\n    diamond:        { '#': '#1AA7C4', 'c': '#5DD8EE', 'L': '#AFF0FA' },\n    iron_ingot:     { 'b': '#A8A8A8', 'h': '#D0D0D0', 's': '#707070' },\n    gold_ingot:     { 'b': '#F0C020', 'h': '#FFE060', 'd': '#A08010' },\n    emerald:        { 'b': '#17DD62', 'h': '#5AFF90', 's': '#0A8035' },\n    bone:           { 'b': '#E8E0D0', 'h': '#FFFFFF' },\n    rotten_flesh:   { 'b': '#8B3A1A', 'd': '#4A1A08' },\n    string:         { 'w': '#E0E0E0', 's': '#A0A0A0' },\n    gunpowder:      { 'b': '#444444', 'd': '#222222' },\n    leather_helmet: { 'b': '#8B5A2B', 'h': '#A0693A', 's': '#5A3010' },\n    enchanted_book: { 'b': '#6A0DAD', 'h': '#9B30D4', 's': '#440070', 'p': '#F0E0FF' },\n    golden_apple:   { 'b': '#FFD700', 'h': '#FFED80', 'l': '#228B22' },\n};\n\n// Maps rarity names to display colors.\nconst RARITY_COLORS = {\n    common:    '#AAAAAA',\n    uncommon:  '#55FFFF',\n    rare:      '#FFAA00',\n    legendary: '#55FFFF',\n};\n\n// Rarity → particle config.\nconst PARTICLE_CONFIGS = {\n    common:    { count: 4,  color: '#888888' },\n    uncommon:  { count: 6,  color: '#55FFFF' },\n    rare:      { count: 8,  color: '#FFAA00' },\n    legendary: { count: 12, color: '#55FFFF' },\n};",
