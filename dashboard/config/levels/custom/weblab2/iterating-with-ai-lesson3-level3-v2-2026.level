      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Diamond Hunt</title>\n\n  <!-- Press Start 2P: a retro pixel-art font, perfect for a Minecraft vibe -->\n  <link href=\"https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap\" rel=\"stylesheet\">\n\n  <!-- All our styles live in style.css -->\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n  <!-- === Main Game Container === -->\n  <div id=\"game-container\">\n\n    <!-- Title bar at the top of the page -->\n    <div id=\"title-bar\">&#x26CF; DIAMOND HUNT</div>\n\n    <!-- Canvas wrapper holds both the canvas and the overlay div -->\n    <div id=\"canvas-wrapper\">\n\n      <!-- The game canvas — all dungeon art is drawn here by helpers.js -->\n      <!-- 800x440 pixels gives us plenty of room for the chest area and inventory -->\n      <canvas id=\"game-canvas\" width=\"800\" height=\"440\"></canvas>\n\n      <!-- Result overlay — shown on top of the canvas when the game ends -->\n      <!-- helpers.js fills this in and removes the \"hidden\" class when done -->\n      <div id=\"result-overlay\" class=\"hidden\"></div>\n\n    </div>\n  </div>\n\n  <!-- data.js stores the loot and sprite data used by the game engine -->\n  <!-- helpers.js is the complete game engine and will fetch/run script.js -->\n  <script src=\"data.js\"></script>\n  <script src=\"helpers.js\"></script>\n</body>\n</html>\n",
          "active": false,
          "folderId": "0",
          "type": "support"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "/* === Global Reset & Base === */\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nbody {\n  background-color: #0D0D0D;\n  font-family: 'Press Start 2P', monospace;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  min-height: 100vh;\n  padding: 20px;\n  overflow-x: hidden;\n}\n\n/* === Game Container === */\n#game-container {\n  width: 100%;\n  max-width: 800px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 14px;\n}\n\n/* === Title Bar === */\n#title-bar {\n  font-family: 'Press Start 2P', monospace;\n  font-size: clamp(12px, 4vw, 18px);\n  color: #FFFF55;\n  letter-spacing: clamp(1px, 0.8vw, 3px);\n  text-align: center;\n  line-height: 1.5;\n  text-shadow:\n    0 0 10px rgba(255, 255, 85, 0.6),\n    2px 2px 0 #7A6A00;\n}\n\n/* === Canvas Wrapper === */\n#canvas-wrapper {\n  position: relative;\n  width: 100%;\n  max-width: 800px;\n  line-height: 0;\n}\n\n/* === The Game Canvas === */\n#game-canvas {\n  display: block;\n  width: 100%;\n  height: auto;\n  border: 2px solid #333333;\n  box-shadow:\n    0 0 40px rgba(0, 100, 200, 0.3),\n    0 0 80px rgba(0, 60, 140, 0.15);\n  image-rendering: pixelated;\n}\n\n/* === Result Overlay === */\n#result-overlay {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  pointer-events: none;\n}\n\n#result-overlay.hidden {\n  display: none;\n}\n\n/* === Overlay Panel === */\n.overlay-panel {\n  pointer-events: all;\n  font-family: 'Press Start 2P', monospace;\n  text-align: center;\n  padding: clamp(18px, 5vw, 36px) clamp(18px, 6vw, 40px);\n  max-width: 520px;\n  width: 90%;\n  line-height: 2;\n}\n\n.overlay-panel.victory .overlay-title {\n  font-size: clamp(10px, 3vw, 14px);\n  color: #55FFFF;\n  text-shadow: 0 0 12px #55FFFF;\n  margin-bottom: 18px;\n  line-height: 1.8;\n}\n\n.overlay-panel.victory .overlay-stat {\n  font-size: clamp(7px, 2.3vw, 9px);\n  color: #AAFFFF;\n  margin-bottom: 28px;\n  line-height: 2;\n}\n\n.overlay-panel.gameover .overlay-title {\n  font-size: clamp(10px, 3vw, 12px);\n  color: #FF5555;\n  text-shadow: 0 0 10px #FF5555;\n  margin-bottom: 18px;\n  line-height: 1.8;\n}\n\n.overlay-panel.gameover .overlay-stat {\n  font-size: clamp(7px, 2.3vw, 9px);\n  color: #FFAAAA;\n  margin-bottom: 28px;\n  line-height: 2;\n}\n\n.overlay-btn {\n  display: inline-block;\n  font-family: 'Press Start 2P', monospace;\n  font-size: clamp(8px, 2.5vw, 10px);\n  padding: clamp(10px, 3vw, 14px) clamp(16px, 5vw, 28px);\n  cursor: pointer;\n  border: none;\n  transition: transform 0.1s ease, box-shadow 0.1s ease;\n  letter-spacing: 1px;\n}\n\n/* === Small screens === */\n@media (max-width: 480px) {\n  body {\n    padding: 12px;\n    justify-content: flex-start;\n  }\n\n  #game-container {\n    gap: 10px;\n  }\n\n  #game-canvas {\n    border-width: 1px;\n    box-shadow:\n      0 0 24px rgba(0, 100, 200, 0.28),\n      0 0 48px rgba(0, 60, 140, 0.12);\n  }\n\n  .overlay-panel {\n    width: 94%;\n    line-height: 1.8;\n  }\n\n  #diamond-spin-canvas {\n    width: 48px;\n    height: 48px;\n    margin-bottom: 12px;\n  }\n}",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
        "3": {
          "id": "3",
          "name": "helpers.js",
          "contents": "/*\n  helpers.js — Diamond Hunt: Complete Game Engine\n  ================================================\n  This file does EVERYTHING except the student's while loop:\n    - Loot table with weighted random selection\n    - Pre-rolls 200 chest results at page load (so each run is deterministic)\n    - openChest() and isDiamond() — the two functions students use\n    - All pixel-art sprite drawing\n    - Canvas scene: dungeon background, torches, chest, inventory\n    - Event queue and animation system\n    - Bootstrap: fetches script.js, evals it, then animates events\n    - Victory and game-over overlays\n\n  Students write only their while loop in script.js.\n  This file fetches and runs script.js using eval().\n*/\n\n/* ============================================================\n   SECTION 2: WEIGHTED RANDOM SELECTION\n   Builds cumulative weights, then picks based on a random roll.\n   ============================================================ */\n\n// Calculates cumulative weights for the loot table\n// Returns array: [22, 42, 60, 72, 82, 88, 92, 95, 97, 98, 100]\nconst buildCumulativeWeights = () => {\n    const cumulative = [];\n    let total = 0;\n    for (let i = 0; i < LOOT_TABLE.length; i++) {\n        total += LOOT_TABLE[i].weight;\n        cumulative.push(total);\n    }\n    return cumulative;\n};\n\nconst CUMULATIVE_WEIGHTS = buildCumulativeWeights();\nconst TOTAL_WEIGHT = CUMULATIVE_WEIGHTS[CUMULATIVE_WEIGHTS.length - 1]; // Should be 100\n\n// Picks one random item from the loot table using weighted probability\nconst pickRandomItem = () => {\n    const roll = Math.random() * TOTAL_WEIGHT;\n    for (let i = 0; i < CUMULATIVE_WEIGHTS.length; i++) {\n        if (roll < CUMULATIVE_WEIGHTS[i]) {\n            return LOOT_TABLE[i];\n        }\n    }\n    // Fallback (should never reach here, but just in case)\n    return LOOT_TABLE[LOOT_TABLE.length - 1];\n};\n\n/* ============================================================\n   SECTION 3: PRE-ROLLED CHEST RESULTS\n   We pre-roll ALL 200 chest results at page load.\n   Why? So each game session is consistent — if the student\n   runs the code multiple times without refreshing, they get\n   the same sequence. \"Play Again\" re-rolls a new set.\n   ============================================================ */\n\nlet CHEST_RESULTS = []; // Will hold 200 pre-rolled loot items\n\n// Fills CHEST_RESULTS with 200 random items\n// We also guarantee a diamond appears somewhere in the first 200\nconst preRollChests = () => {\n    CHEST_RESULTS = [];\n    for (let i = 0; i < 200; i++) {\n        CHEST_RESULTS.push(pickRandomItem());\n    }\n    // Make sure there's at least one diamond within the first 200 chests\n    // (so the safety cap situation is \"loop never stopped\" not \"no diamond exists\")\n    let hasDiamond = false;\n    for (let i = 0; i < CHEST_RESULTS.length; i++) {\n        if (CHEST_RESULTS[i].item === 'diamond') {\n            hasDiamond = true;\n            break;\n        }\n    }\n    if (!hasDiamond) {\n        // Place a diamond at a random position in the list\n        const pos = Math.floor(Math.random() * 180) + 10; // Between index 10-189\n        CHEST_RESULTS[pos] = LOOT_TABLE.find((e) => e.item === 'diamond');\n    }\n    console.log('Pre-rolled 200 chest results. Diamond is somewhere in there... good luck!');\n};\n\n/* ============================================================\n   SECTION 4: GAME STATE\n   These variables track what's happening during a run.\n   They get reset each time the student's code is re-evaluated.\n   ============================================================ */\n\nlet iterationCount = 0;     // How many chests have been opened so far\nlet safetyCapHit = false;   // True if the loop went over 200 iterations\nlet gameEvents = [];         // Queue of events to animate (open + result)\n\n/* ============================================================\n   SECTION 5: STUDENT-FACING FUNCTIONS\n   These are the only two functions students need to use.\n   ============================================================ */\n\n// Opens the next chest and returns the item inside as a string.\n// Example: openChest() might return 'iron_ingot' or 'diamond'\n// Each call records an event so the game can animate it later.\nconst openChest = () => {\n    iterationCount++;\n\n    // Safety cap: if the student's loop runs more than 200 times,\n    // we stop the game to prevent an infinite loop crashing the browser.\n    if (iterationCount > 200) {\n        safetyCapHit = true;\n        console.log('Safety cap hit! Loop ran more than 200 times. Did you forget to stop the loop?');\n        throw new Error('SAFETY_CAP');\n    }\n\n    // Get the pre-rolled item for this chest number\n    const lootEntry = CHEST_RESULTS[iterationCount - 1];\n\n    // Record this open event so the animation system can play it back\n    gameEvents.push({\n        type: 'open',\n        chestNum: iterationCount,\n        item: lootEntry.item,\n        label: lootEntry.label,\n        rarity: lootEntry.rarity\n    });\n\n    console.log('Chest #' + iterationCount + ' opened: ' + lootEntry.label + ' (' + lootEntry.rarity + ')');\n\n    // Return just the item string so students can check it\n    return lootEntry.item;\n};\n\n// Returns true if the item is a diamond, false otherwise.\n// Example: isDiamond('diamond') → true\n//          isDiamond('iron_ingot') → false\nconst isDiamond = (item) => item === 'diamond';\n\n/* ============================================================\n   SECTION 6: CANVAS SETUP\n   ============================================================ */\n\nconst canvas = document.getElementById('game-canvas');\nconst ctx = canvas.getContext('2d');\nconst CANVAS_W = 800;\nconst CANVAS_H = 440;\nconst SCALE = 3;\n\n/* ============================================================\n   SECTION 7: PIXEL-ART SPRITE DEFINITIONS\n   Each sprite is a 2D array of color strings.\n   '.' means transparent (skip drawing that pixel).\n   Each pixel is drawn at SCALE * multiplier size.\n   ============================================================ */\n\n\n// Draws an 8x8 pixel-art sprite at (x, y) with each pixel drawn at pixelSize\nconst drawSprite = (itemName, x, y, pixelSize) => {\n    const grid = SPRITES[itemName];\n    const colors = SPRITE_COLORS[itemName];\n    if (!grid || !colors) return;\n\n    for (let row = 0; row < grid.length; row++) {\n        for (let col = 0; col < grid[row].length; col++) {\n            const code = grid[row][col];\n            if (code === '.') continue; // Transparent pixel — skip\n            const color = colors[code];\n            if (!color) continue;\n            ctx.fillStyle = color;\n            ctx.fillRect(\n                x + col * pixelSize,\n                y + row * pixelSize,\n                pixelSize,\n                pixelSize\n            );\n        }\n    }\n};\n\n/* ============================================================\n   SECTION 8: CHEST SPRITE DRAWING\n   drawChest(x, y, openFraction) draws a Minecraft-style chest.\n   openFraction: 0.0 = fully closed, 1.0 = fully open\n   The lid lifts up as openFraction increases.\n   Uses scale 6 (SCALE=3 * 2) so the chest is big and readable.\n   ============================================================ */\n\nconst CHEST_PIXEL = 6; // Each chest \"pixel\" is 6 actual canvas pixels\n\n// Draws the chest body (bottom half, always visible)\nconst drawChestBody = (cx, cy) => {\n    const w = 16 * CHEST_PIXEL; // 96px wide\n    const h =  7 * CHEST_PIXEL; // 42px tall\n\n    // Outer dark trim\n    ctx.fillStyle = '#3A2210';\n    ctx.fillRect(cx, cy, w, h);\n\n    // Main wood fill\n    ctx.fillStyle = '#7A4A28';\n    ctx.fillRect(cx + CHEST_PIXEL, cy + CHEST_PIXEL, w - 2 * CHEST_PIXEL, h - CHEST_PIXEL);\n\n    // Vertical plank lines every 4 pixels\n    ctx.fillStyle = '#6B3F22';\n    for (let px = 4; px < 15; px += 4) {\n        ctx.fillRect(cx + px * CHEST_PIXEL, cy + CHEST_PIXEL, CHEST_PIXEL, h - CHEST_PIXEL);\n    }\n\n    // Bottom trim strip\n    ctx.fillStyle = '#3A2210';\n    ctx.fillRect(cx, cy + h - CHEST_PIXEL, w, CHEST_PIXEL);\n\n    // Center latch / keyhole\n    ctx.fillStyle = '#808080';\n    ctx.fillRect(cx + 7 * CHEST_PIXEL, cy + 2 * CHEST_PIXEL, 2 * CHEST_PIXEL, 3 * CHEST_PIXEL);\n    ctx.fillStyle = '#505050';\n    ctx.fillRect(cx + 7 * CHEST_PIXEL + CHEST_PIXEL / 2, cy + 3 * CHEST_PIXEL, CHEST_PIXEL, 2 * CHEST_PIXEL);\n\n    // Floor shadow beneath chest\n    ctx.fillStyle = 'rgba(0,0,0,0.4)';\n    ctx.fillRect(cx + 4, cy + h, w - 8, 6);\n};\n\n// Draws the chest lid — its vertical position depends on openFraction\n// openFraction=0: lid sits on top of body (closed)\n// openFraction=1: lid is raised fully open (floated up above body)\nconst drawChestLid = (cx, cy, openFraction) => {\n    const bodyH  =  7 * CHEST_PIXEL;\n    const lidH   =  7 * CHEST_PIXEL; // Full lid height when closed\n    const w      = 16 * CHEST_PIXEL;\n\n    // As chest opens, lid shrinks vertically (perspective squish) and moves up\n    const lidDrawH   = Math.round(lidH * (1 - openFraction * 0.7)); // shrinks to 30% height\n    const liftAmount = Math.round(openFraction * lidH * 1.2);       // lifts up\n\n    const lidY = cy - lidDrawH - liftAmount;\n\n    // Interior cavity (visible when open)\n    if (openFraction > 0.1) {\n        const alpha = Math.min(1, openFraction * 2);\n        ctx.fillStyle = 'rgba(26, 13, 5, ' + alpha + ')';\n        ctx.fillRect(cx + CHEST_PIXEL, cy, w - 2 * CHEST_PIXEL, Math.round(openFraction * 8));\n    }\n\n    // Lid outer trim\n    ctx.fillStyle = '#3A2210';\n    ctx.fillRect(cx, lidY, w, lidDrawH);\n\n    if (lidDrawH > CHEST_PIXEL * 1.5) {\n        // Lid wood fill\n        ctx.fillStyle = '#7A4A28';\n        ctx.fillRect(cx + CHEST_PIXEL, lidY + CHEST_PIXEL, w - 2 * CHEST_PIXEL, lidDrawH - 2 * CHEST_PIXEL);\n\n        // Lid plank lines\n        ctx.fillStyle = '#6B3F22';\n        for (let px = 4; px < 15; px += 4) {\n            ctx.fillRect(cx + px * CHEST_PIXEL, lidY + CHEST_PIXEL, CHEST_PIXEL, lidDrawH - 2 * CHEST_PIXEL);\n        }\n\n        // Lid top trim\n        ctx.fillStyle = '#5C3A1E';\n        ctx.fillRect(cx, lidY, w, CHEST_PIXEL);\n\n        // Latch on lid\n        ctx.fillStyle = '#A0A0A0';\n        ctx.fillRect(cx + 7 * CHEST_PIXEL, lidY + CHEST_PIXEL, 2 * CHEST_PIXEL, 2 * CHEST_PIXEL);\n    }\n};\n\n// Main chest drawing function\n// cx, cy = top-left corner; openFraction = 0.0 (closed) to 1.0 (open)\nconst drawChest = (cx, cy, openFraction) => {\n    drawChestBody(cx, cy);\n    drawChestLid(cx, cy, openFraction);\n};\n\n/* ============================================================\n   SECTION 9: BACKGROUND DRAWING\n   Stone brick walls, torches, floor, radial glow.\n   We pre-generate brick colors at startup to avoid per-frame flicker.\n   ============================================================ */\n\n// Pre-generated brick color variation data\n// Each brick gets a slightly different shade so the wall looks natural\nlet BRICK_COLORS = null;\nconst BRICK_W = 32;\nconst BRICK_H = 16;\nconst BRICK_COLS = Math.ceil(CANVAS_W / BRICK_W) + 2;\nconst BRICK_ROWS = Math.ceil((CANVAS_H - 60) / BRICK_H) + 2;\n\n// Builds the BRICK_COLORS 2D array once at startup\nconst initBrickColors = () => {\n    BRICK_COLORS = [];\n    for (let row = 0; row < BRICK_ROWS; row++) {\n        BRICK_COLORS[row] = [];\n        for (let col = 0; col < BRICK_COLS; col++) {\n            // Random slight variation in brick shade\n            const variation = Math.floor(Math.random() * 12) - 6;\n            const base = 56 + variation; // Around #383838\n            const hex = base.toString(16).padStart(2, '0');\n            BRICK_COLORS[row][col] = '#' + hex + hex + hex;\n        }\n    }\n};\n\n// Draws the stone brick wall background\nconst drawBrickBackground = () => {\n    // Base fill\n    ctx.fillStyle = '#2D2D2D';\n    ctx.fillRect(0, 0, CANVAS_W, CANVAS_H - 60);\n\n    // Draw individual bricks with pre-computed colors\n    for (let row = 0; row < BRICK_ROWS; row++) {\n        const y = row * BRICK_H;\n        // Odd rows are offset by half a brick width (staggered pattern)\n        const offsetX = (row % 2 === 0) ? 0 : -BRICK_W / 2;\n\n        for (let col = 0; col < BRICK_COLS; col++) {\n            const x = col * BRICK_W + offsetX;\n            ctx.fillStyle = BRICK_COLORS[row][col];\n            ctx.fillRect(x + 1, y + 1, BRICK_W - 2, BRICK_H - 2);\n        }\n\n        // Mortar lines (gaps between bricks)\n        ctx.fillStyle = '#1A1A1A';\n        ctx.fillRect(0, y, CANVAS_W, 1); // Horizontal mortar\n    }\n};\n\n// Draws the stone floor at the bottom of the canvas\nconst drawFloor = () => {\n    const floorY = CANVAS_H - 60;\n    ctx.fillStyle = '#1A1A1A';\n    ctx.fillRect(0, floorY, CANVAS_W, 60);\n\n    // Cobblestone texture — irregular outlines\n    ctx.strokeStyle = '#2A2A2A';\n    ctx.lineWidth = 1;\n    const stones = [\n        [5, 5, 70, 25], [80, 8, 65, 22], [150, 3, 80, 28], [235, 6, 60, 24],\n        [300, 4, 75, 26], [380, 7, 55, 23], [440, 5, 80, 27], [525, 3, 65, 25],\n        [595, 6, 75, 24], [675, 4, 70, 26], [750, 5, 55, 23],\n        [10, 32, 60, 22], [75, 35, 80, 20], [160, 33, 55, 22], [220, 36, 75, 19],\n        [300, 34, 65, 23], [370, 35, 70, 21], [445, 33, 60, 22], [510, 36, 80, 20],\n        [595, 34, 65, 22], [665, 35, 75, 20], [745, 33, 50, 23],\n    ];\n    for (let i = 0; i < stones.length; i++) {\n        const s = stones[i];\n        ctx.strokeRect(s[0], floorY + s[1], s[2], s[3]);\n    }\n};\n\n// Torch state for flickering animation\nlet torchFrame = 0;\n\n// Draws a wall torch at (tx, ty) with a flickering flame\nconst drawTorch = (tx, ty) => {\n    // Torch stick\n    ctx.fillStyle = '#8B5A2B';\n    ctx.fillRect(tx - 2, ty, 4, 12);\n\n    // Flame base — alternates between orange and yellow each frame\n    const flameColor = (torchFrame % 2 === 0) ? '#FF8C00' : '#FFD700';\n    ctx.fillStyle = flameColor;\n    ctx.fillRect(tx - 3, ty - 6, 6, 7);\n\n    // Inner flame highlight\n    const innerColor = (torchFrame % 2 === 0) ? '#FFD700' : '#FF8C00';\n    ctx.fillStyle = innerColor;\n    ctx.fillRect(tx - 1, ty - 5, 2, 4);\n\n    // Torch light glow on the wall\n    const gradient = ctx.createRadialGradient(tx, ty - 2, 0, tx, ty - 2, 35);\n    gradient.addColorStop(0, 'rgba(255, 160, 50, 0.18)');\n    gradient.addColorStop(1, 'rgba(255, 160, 50, 0)');\n    ctx.fillStyle = gradient;\n    ctx.fillRect(tx - 35, ty - 35, 70, 70);\n};\n\n// Draws the central atmospheric dungeon glow\nconst drawAtmosphericGlow = () => {\n    const gx = CANVAS_W / 2;\n    const gy = CANVAS_H / 2 - 20;\n    const gradient = ctx.createRadialGradient(gx, gy, 0, gx, gy, 300);\n    gradient.addColorStop(0, 'rgba(30, 60, 120, 0.15)');\n    gradient.addColorStop(1, 'rgba(30, 60, 120, 0)');\n    ctx.fillStyle = gradient;\n    ctx.fillRect(0, 0, CANVAS_W, CANVAS_H);\n};\n\n// Draws the complete static background (bricks + floor + glow)\nconst drawBackground = () => {\n    drawBrickBackground();\n    drawFloor();\n    drawAtmosphericGlow();\n};\n\n/* ============================================================\n   SECTION 10: INVENTORY PANEL\n   5-column × 8-row grid of item slots on the right side.\n   Items fill in left-to-right, top-to-bottom as chests are opened.\n   ============================================================ */\n\nconst INVENTORY_X = 480;    // Left edge of inventory panel\nconst INVENTORY_Y = 80;     // Top edge\nconst SLOT_SIZE   = 40;     // Each slot is 40x40 pixels\nconst INV_COLS    = 5;\nconst INV_ROWS    = 8;\n\n// Draws the full inventory grid and any items already collected\n// inventoryItems is an array of item name strings\nconst drawInventory = (inventoryItems) => {\n    // \"INVENTORY\" header\n    ctx.fillStyle = '#FFFF55';\n    ctx.font = '7px \"Press Start 2P\"';\n    ctx.textAlign = 'center';\n    ctx.fillText('INVENTORY', INVENTORY_X + (INV_COLS * SLOT_SIZE) / 2, INVENTORY_Y - 14);\n\n    // Draw all slots\n    for (let row = 0; row < INV_ROWS; row++) {\n        for (let col = 0; col < INV_COLS; col++) {\n            const slotIndex = row * INV_COLS + col;\n            const sx = INVENTORY_X + col * SLOT_SIZE;\n            const sy = INVENTORY_Y + row * SLOT_SIZE;\n\n            // Slot background\n            ctx.fillStyle = '#1A1A1A';\n            ctx.fillRect(sx, sy, SLOT_SIZE, SLOT_SIZE);\n\n            // Slot border\n            ctx.strokeStyle = '#555555';\n            ctx.lineWidth = 1;\n            ctx.strokeRect(sx + 0.5, sy + 0.5, SLOT_SIZE - 1, SLOT_SIZE - 1);\n\n            // Draw item if we have one for this slot\n            if (slotIndex < inventoryItems.length) {\n                const itemName = inventoryItems[slotIndex];\n                const itemPixel = 4; // Each item pixel = 4 canvas pixels (8x8 sprite = 32x32)\n                const spriteSize = 8 * itemPixel; // 32px\n                const offsetX = (SLOT_SIZE - spriteSize) / 2;\n                const offsetY = (SLOT_SIZE - spriteSize) / 2;\n                drawSprite(itemName, sx + offsetX, sy + offsetY, itemPixel);\n            }\n        }\n    }\n};\n\n/* ============================================================\n   SECTION 11: CHEST AREA LABELS\n   Shows chest number and last found item name below the chest.\n   ============================================================ */\n\n// Draws the \"CHEST #N\" and item name labels in the chest area\nconst drawChestLabels = (chestNum, itemLabel, rarity) => {\n    ctx.textAlign = 'center';\n    const labelX = 230; // Center of chest area\n\n    // \"CHEST #N\" in Minecraft yellow\n    ctx.fillStyle = '#FFFF55';\n    ctx.font = '8px \"Press Start 2P\"';\n    ctx.fillText('CHEST #' + chestNum, labelX, 120);\n\n    // Item name in rarity color\n    if (itemLabel) {\n        const color = RARITY_COLORS[rarity] || '#AAAAAA';\n        ctx.fillStyle = color;\n        ctx.font = '7px \"Press Start 2P\"';\n\n        // Glow effect for legendary items\n        if (rarity === 'legendary') {\n            ctx.shadowColor = '#55FFFF';\n            ctx.shadowBlur = 10;\n        }\n        ctx.fillText(itemLabel, labelX, 348);\n        ctx.shadowBlur = 0;\n        ctx.shadowColor = 'transparent';\n    }\n};\n\n/* ============================================================\n   SECTION 12: PARTICLE SYSTEM\n   Short burst of colored dots fly out of the chest when an item\n   appears. Quantity and color depend on rarity.\n   ============================================================ */\n\nlet activeParticles = [];\n\n// Spawns a burst of particles at (px, py) for the given rarity\nconst spawnParticles = (px, py, rarity) => {\n    const config = PARTICLE_CONFIGS[rarity] || PARTICLE_CONFIGS.common;\n    for (let i = 0; i < config.count; i++) {\n        const angle = (Math.PI * 2 * i) / config.count + Math.random() * 0.5;\n        const speed = 1.5 + Math.random() * 2;\n        activeParticles.push({\n            x: px,\n            y: py,\n            vx: Math.cos(angle) * speed,\n            vy: Math.sin(angle) * speed - 1.5,\n            life: 1.0,   // 1.0 = fully visible, 0.0 = gone\n            color: config.color,\n            size: 3 + Math.floor(Math.random() * 3),\n        });\n    }\n};\n\n// Updates and draws all active particles — called each animation frame\nconst updateParticles = () => {\n    const stillAlive = [];\n    for (let i = 0; i < activeParticles.length; i++) {\n        const p = activeParticles[i];\n        p.x += p.vx;\n        p.y += p.vy;\n        p.vy += 0.12; // Gravity\n        p.life -= 0.035;\n        if (p.life > 0) {\n            ctx.globalAlpha = p.life;\n            ctx.fillStyle = p.color;\n            ctx.fillRect(p.x, p.y, p.size, p.size);\n            ctx.globalAlpha = 1;\n            stillAlive.push(p);\n        }\n    }\n    activeParticles = stillAlive;\n};\n\n/* ============================================================\n   SECTION 13: FLYING ITEM ANIMATION\n   When a chest opens, the item sprite \"flies\" upward out of the\n   chest and arcs into the next empty inventory slot.\n   ============================================================ */\n\n// Describes an in-flight item animation\nlet flyingItem = null;\n\n// Starts a flying item animation from the chest to the inventory slot\n// slotIndex = which inventory slot to fly into\nconst startFlyingItem = (itemName, rarity, slotIndex) => {\n    // Start position: above the center of the chest\n    const startX = 230 - 16; // Center chest area minus half sprite\n    const startY = 200;      // Just above chest opening\n\n    // End position: center of the target inventory slot\n    const col = slotIndex % INV_COLS;\n    const row = Math.floor(slotIndex / INV_COLS);\n    const endX = INVENTORY_X + col * SLOT_SIZE + (SLOT_SIZE - 32) / 2;\n    const endY = INVENTORY_Y + row * SLOT_SIZE + (SLOT_SIZE - 32) / 2;\n\n    flyingItem = {\n        itemName: itemName,\n        rarity: rarity,\n        x: startX,\n        y: startY,\n        startX: startX,\n        startY: startY,\n        endX: endX,\n        endY: endY,\n        progress: 0,    // 0.0 to 1.0\n        pixelSize: 4,   // Starts bigger, shrinks as it travels\n    };\n};\n\n// Draws the flying item if one is active, and advances its animation\n// Returns true if the animation is still running, false when done\nconst updateFlyingItem = () => {\n    if (!flyingItem) return false;\n\n    flyingItem.progress += 0.06;\n    if (flyingItem.progress >= 1) {\n        flyingItem = null;\n        return false;\n    }\n\n    const t = flyingItem.progress;\n    // Ease-in-out curve for smooth movement\n    const ease = t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;\n\n    // Arc upward in the middle of the flight\n    const arcLift = Math.sin(t * Math.PI) * 40;\n\n    const x = flyingItem.startX + (flyingItem.endX - flyingItem.startX) * ease;\n    const y = flyingItem.startY + (flyingItem.endY - flyingItem.startY) * ease - arcLift;\n\n    // Item shrinks slightly as it lands\n    const scale = Math.round(4 - t * 1.5);\n    const ps = Math.max(2, scale);\n\n    drawSprite(flyingItem.itemName, Math.round(x), Math.round(y), ps);\n    return true;\n};\n\n/* ============================================================\n   SECTION 14: SCREEN FLASH (legendary items)\n   A brief white flash when a legendary item (diamond!) appears.\n   ============================================================ */\n\nlet flashAlpha = 0; // 0 = no flash, > 0 = flash visible\n\nconst triggerFlash = () => {\n    flashAlpha = 0.6;\n};\n\nconst updateFlash = () => {\n    if (flashAlpha > 0) {\n        ctx.fillStyle = 'rgba(255, 255, 255, ' + flashAlpha + ')';\n        ctx.fillRect(0, 0, CANVAS_W, CANVAS_H);\n        flashAlpha -= 0.04;\n        if (flashAlpha < 0) flashAlpha = 0;\n    }\n};\n\n/* ============================================================\n   SECTION 15: RENDER LOOP\n   Continuously redraws the canvas at ~60fps.\n   The background, torches, chest, inventory, and particles\n   are all redrawn every frame.\n   ============================================================ */\n\n// Current state being displayed (updated by animateEvents)\nlet renderState = {\n    chestOpenFraction: 0,  // 0.0 = closed, 1.0 = open\n    chestNum: 0,\n    currentLabel: '',\n    currentRarity: 'common',\n    inventoryItems: [],    // Array of item name strings collected so far\n};\n\n// Draws the entire scene for one frame\nconst drawFrame = () => {\n    ctx.clearRect(0, 0, CANVAS_W, CANVAS_H);\n\n    drawBackground();\n\n    // Torches (left and right, near top)\n    drawTorch(80, 50);\n    drawTorch(720, 50);\n    torchFrame++;\n\n    // Chest (centered in the left area)\n    const chestX = 230 - (16 * CHEST_PIXEL) / 2; // Horizontally centered\n    const chestY = 200;                            // Vertically in chest area\n    drawChest(chestX, chestY, renderState.chestOpenFraction);\n\n    // Chest labels\n    if (renderState.chestNum > 0) {\n        drawChestLabels(renderState.chestNum, renderState.currentLabel, renderState.currentRarity);\n    } else {\n        // Before any chests open, show a prompt\n        ctx.fillStyle = '#888888';\n        ctx.font = '7px \"Press Start 2P\"';\n        ctx.textAlign = 'center';\n        ctx.fillText('CHEST AWAITS...', 230, 120);\n    }\n\n    // Inventory\n    drawInventory(renderState.inventoryItems);\n\n    // Particles flying out of chest\n    updateParticles();\n\n    // Flying item arc to inventory\n    updateFlyingItem();\n\n    // Screen flash (legendary)\n    updateFlash();\n};\n\n// Starts the render loop using requestAnimationFrame\nconst startRenderLoop = () => {\n    const loop = () => {\n        drawFrame();\n        requestAnimationFrame(loop);\n    };\n    requestAnimationFrame(loop);\n};\n\n/* ============================================================\n   SECTION 16: EVENT ANIMATION QUEUE\n   After eval() runs the student's code, gameEvents[] contains\n   all the chest-open events and the final result event.\n   animateEvents() plays them back one at a time, with a delay\n   between each so students can see every chest open.\n   ============================================================ */\n\n// How long to pause between events (milliseconds)\n// Shorter = faster playback. 400ms feels right for most runs.\nconst EVENT_DELAY_MS = 400;\n\n// Tracks the chest opening animation between event steps\nlet chestAnimProgress = 0;\nlet chestAnimating = false;\nlet chestAnimInterval = null;\n\n// Smoothly animates the chest opening over ~8 frames\nconst animateChestOpen = (onComplete) => {\n    chestAnimProgress = 0;\n    chestAnimating = true;\n\n    // Clear any previous animation\n    if (chestAnimInterval) clearInterval(chestAnimInterval);\n\n    chestAnimInterval = setInterval(() => {\n        chestAnimProgress += 0.14;\n        if (chestAnimProgress >= 1) {\n            chestAnimProgress = 1;\n            renderState.chestOpenFraction = 1;\n            clearInterval(chestAnimInterval);\n            chestAnimating = false;\n            onComplete();\n        } else {\n            renderState.chestOpenFraction = chestAnimProgress;\n        }\n    }, 16); // ~60fps lid animation\n};\n\n// Plays back all gameEvents with delays between each\nconst animateEvents = () => {\n    let eventIndex = 0;\n\n    const processNextEvent = () => {\n        if (eventIndex >= gameEvents.length) return; // All done\n\n        const event = gameEvents[eventIndex];\n        eventIndex++;\n\n        if (event.type === 'open') {\n            // Update labels immediately\n            renderState.chestNum = event.chestNum;\n            renderState.currentLabel = event.label;\n            renderState.currentRarity = event.rarity;\n\n            // Animate chest opening\n            renderState.chestOpenFraction = 0;\n            animateChestOpen(() => {\n                // Spawn particles\n                const chestCenterX = 230;\n                const chestCenterY = 200;\n                spawnParticles(chestCenterX, chestCenterY - 20, event.rarity);\n\n                // Flash on legendary\n                if (event.rarity === 'legendary') {\n                    triggerFlash();\n                }\n\n                // Start item flying to inventory\n                const slotIndex = renderState.inventoryItems.length;\n                renderState.inventoryItems.push(event.item);\n                startFlyingItem(event.item, event.rarity, slotIndex);\n\n                // Close chest after a short pause, then move to next event\n                setTimeout(() => {\n                    renderState.chestOpenFraction = 0;\n                    setTimeout(processNextEvent, EVENT_DELAY_MS / 2);\n                }, EVENT_DELAY_MS * 0.8);\n            });\n\n        } else if (event.type === 'result') {\n            // Game is over — show result overlay after a brief pause\n            setTimeout(() => {\n                if (event.found) {\n                    showVictoryOverlay(event.chests);\n                } else if (event.safetyCapHit) {\n                    showGameOverOverlay(event.chests);\n                }\n            }, 600);\n        }\n    };\n\n    // Start processing after a short initial delay\n    setTimeout(processNextEvent, 500);\n};\n\n/* ============================================================\n   SECTION 17: RESULT OVERLAYS (HTML over canvas)\n   These are HTML <div> panels that appear on top of the canvas.\n   Using HTML lets us get proper text rendering and buttons.\n   ============================================================ */\n\nconst resultOverlay = document.getElementById('result-overlay');\n\n// Shows the victory panel: \"DIAMOND FOUND!\"\nconst showVictoryOverlay = (chestCount) => {\n    resultOverlay.innerHTML =\n        '<div class=\"overlay-panel victory\">' +\n            '<canvas id=\"diamond-spin-canvas\" width=\"64\" height=\"64\"></canvas>' +\n            '<div class=\"overlay-title\">DIAMOND<br>FOUND!</div>' +\n            '<div class=\"overlay-stat\">You opened ' + chestCount + ' chest' + (chestCount !== 1 ? 's' : '') + '.</div>' +\n            '<button class=\"overlay-btn\" id=\"play-again-btn\">PLAY AGAIN</button>' +\n        '</div>';\n\n    resultOverlay.classList.remove('hidden');\n\n    // Start the spinning diamond animation in the mini canvas\n    startSpinningDiamond();\n\n    // Wire up the Play Again button\n    document.getElementById('play-again-btn').addEventListener('click', () => {\n        playAgain();\n    });\n};\n\n// Shows the game-over panel: \"DUNGEON COLLAPSED!\"\nconst showGameOverOverlay = (chestCount) => {\n    resultOverlay.innerHTML =\n        '<div class=\"overlay-panel gameover\">' +\n            '<div class=\"overlay-title\">DUNGEON<br>COLLAPSED!</div>' +\n            '<div class=\"overlay-stat\">' +\n                'Your loop never stopped.<br>' +\n                '200 chests opened.' +\n            '</div>' +\n            '<button class=\"overlay-btn\" id=\"try-again-btn\">TRY AGAIN</button>' +\n        '</div>';\n\n    resultOverlay.classList.remove('hidden');\n\n    document.getElementById('try-again-btn').addEventListener('click', () => {\n        playAgain();\n    });\n};\n\n/* ============================================================\n   SECTION 18: SPINNING DIAMOND ANIMATION\n   A little canvas inside the victory overlay that shows the\n   diamond sprite spinning (simulated by cycling through\n   scaled-down versions of the sprite).\n   ============================================================ */\n\nlet spinFrame = 0;\nlet spinInterval = null;\n\nconst startSpinningDiamond = () => {\n    const spinCanvas = document.getElementById('diamond-spin-canvas');\n    if (!spinCanvas) return;\n    const sCtx = spinCanvas.getContext('2d');\n\n    // Clear any existing interval\n    if (spinInterval) clearInterval(spinInterval);\n    spinFrame = 0;\n\n    spinInterval = setInterval(() => {\n        sCtx.clearRect(0, 0, 64, 64);\n        spinFrame++;\n\n        // Simulate spin by scaling x-axis with Math.cos\n        const spinT = (spinFrame % 40) / 40; // 0.0 to 1.0 loop\n        const scaleX = Math.abs(Math.cos(spinT * Math.PI * 2));\n\n        const pixelSize = 6;\n        const spriteW = 8 * pixelSize; // 48px\n        const spriteH = 8 * pixelSize; // 48px\n\n        sCtx.save();\n        sCtx.translate(32, 8);  // Center of the mini canvas\n        sCtx.scale(scaleX, 1);  // Squish horizontally to fake spin\n        sCtx.translate(-spriteW / 2, 0);\n\n        // Draw diamond using the sprite colors\n        const grid = SPRITES.diamond;\n        const colors = SPRITE_COLORS.diamond;\n        for (let row = 0; row < grid.length; row++) {\n            for (let col = 0; col < grid[row].length; col++) {\n                const code = grid[row][col];\n                if (code === '.') continue;\n                const color = colors[code];\n                if (!color) continue;\n                sCtx.fillStyle = color;\n                sCtx.fillRect(col * pixelSize, row * pixelSize, pixelSize, pixelSize);\n            }\n        }\n        sCtx.restore();\n    }, 30); // ~33fps\n};\n\n/* ============================================================\n   SECTION 19: PLAY AGAIN / RESET\n   Re-rolls the chest results, resets all state, re-fetches\n   and re-evals the student's script.js code.\n   ============================================================ */\n\nconst playAgain = () => {\n    // Hide overlay\n    resultOverlay.classList.add('hidden');\n    resultOverlay.innerHTML = '';\n\n    // Stop spinning diamond\n    if (spinInterval) {\n        clearInterval(spinInterval);\n        spinInterval = null;\n    }\n\n    // Reset game state\n    iterationCount = 0;\n    safetyCapHit = false;\n    gameEvents = [];\n    activeParticles = [];\n    flyingItem = null;\n    flashAlpha = 0;\n    renderState = {\n        chestOpenFraction: 0,\n        chestNum: 0,\n        currentLabel: '',\n        currentRarity: 'common',\n        inventoryItems: [],\n    };\n\n    // Re-roll a fresh set of chest results\n    preRollChests();\n\n    // Re-fetch and re-run the student's code\n    runStudentCode();\n};\n\n/* ============================================================\n   SECTION 20: BOOTSTRAP — FETCH, EVAL, ANIMATE\n   This is where everything kicks off.\n   1. Pre-roll chest results\n   2. Start the render loop\n   3. Fetch script.js\n   4. Eval the student's code\n   5. Push result event\n   6. Start animation playback\n   ============================================================ */\n\n// Fetches script.js, evals it inside a try/catch, then starts animation\nconst runStudentCode = () => {\n    // Add a timestamp to the URL to bust the cache — ensures we get the\n    // latest version of script.js even if the browser cached a previous version\n    const url = 'script.js?t=' + Date.now();\n\n    fetch(url)\n        .then((response) => response.text())\n        .then((code) => {\n            console.log('Fetched script.js — running student code...');\n\n            // Strip let/const declarations so the eval doesn't complain about\n            // re-declaring variables if the student used let/const at the top level\n            const cleanCode = code\n                .replace(/\\bconst\\b/g, 'var')\n                .replace(/\\blet\\b/g, 'var');\n\n            let errorOccurred = false;\n            let errorMessage = '';\n\n            try {\n                // Run the student's while loop using indirect eval\n                // The (0, eval) pattern runs it in the global scope so\n                // openChest() and isDiamond() are accessible\n                (0, eval)(cleanCode);\n            } catch (err) {\n                errorOccurred = true;\n                errorMessage = err.message || String(err);\n\n                if (errorMessage === 'SAFETY_CAP') {\n                    // This is expected — safety cap was intentionally thrown\n                    console.log('Safety cap triggered — loop ran over 200 times.');\n                } else {\n                    // Unexpected JS error in student code\n                    console.error('Error in student code:', errorMessage);\n                    showErrorPanel(errorMessage);\n                    return;\n                }\n            }\n\n            // Push the result event to the queue\n            if (safetyCapHit) {\n                gameEvents.push({\n                    type: 'result',\n                    found: false,\n                    safetyCapHit: true,\n                    chests: 200,\n                });\n            } else {\n                // Check if the last item found was a diamond\n                const lastItem = renderState.inventoryItems.length > 0\n                    ? renderState.inventoryItems[renderState.inventoryItems.length - 1]\n                    : null;\n                // Also check the last open event\n                let foundDiamond = false;\n                for (let i = gameEvents.length - 1; i >= 0; i--) {\n                    if (gameEvents[i].type === 'open' && gameEvents[i].item === 'diamond') {\n                        foundDiamond = true;\n                        break;\n                    }\n                }\n                gameEvents.push({\n                    type: 'result',\n                    found: foundDiamond,\n                    chests: iterationCount,\n                });\n            }\n\n            console.log('Student code finished. Total events to animate: ' + gameEvents.length);\n\n            // Start playing back the animation\n            animateEvents();\n        })\n        .catch((err) => {\n            // Network/fetch error — likely a file path issue\n            showErrorPanel('Could not load script.js: ' + err.message);\n        });\n};\n\n// Shows an error message on the canvas when something goes wrong\nconst showErrorPanel = (message) => {\n    ctx.fillStyle = 'rgba(0, 0, 0, 0.85)';\n    ctx.fillRect(20, 60, CANVAS_W - 40, CANVAS_H - 120);\n\n    ctx.strokeStyle = '#FF5555';\n    ctx.lineWidth = 2;\n    ctx.strokeRect(20, 60, CANVAS_W - 40, CANVAS_H - 120);\n\n    ctx.fillStyle = '#FF5555';\n    ctx.font = '9px \"Press Start 2P\"';\n    ctx.textAlign = 'center';\n    ctx.fillText('ERROR IN YOUR CODE:', CANVAS_W / 2, 110);\n\n    ctx.fillStyle = '#FFAAAA';\n    ctx.font = '7px \"Press Start 2P\"';\n\n    // Word-wrap the error message\n    const maxWidth = CANVAS_W - 80;\n    const words = message.split(' ');\n    let line = '';\n    let lineY = 145;\n    for (let i = 0; i < words.length; i++) {\n        const testLine = line + words[i] + ' ';\n        const metrics = ctx.measureText(testLine);\n        if (metrics.width > maxWidth && i > 0) {\n            ctx.fillText(line, CANVAS_W / 2, lineY);\n            line = words[i] + ' ';\n            lineY += 22;\n        } else {\n            line = testLine;\n        }\n    }\n    ctx.fillText(line, CANVAS_W / 2, lineY);\n};\n\n/* ============================================================\n   SECTION 21: ENTRY POINT\n   Everything starts here when the page finishes loading.\n   ============================================================ */\n\nwindow.addEventListener('load', () => {\n    console.log('Diamond Hunt loaded! Setting up...');\n\n    // Step 1: Pre-generate brick variation so the wall doesn't flicker\n    initBrickColors();\n\n    // Step 2: Pre-roll 200 chest results\n    preRollChests();\n\n    // Step 3: Start the render loop (runs at 60fps forever)\n    startRenderLoop();\n\n    // Step 4: Fetch and eval the student's script.js\n    runStudentCode();\n});\n",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
        "4": {
          "id": "4",
          "name": "script.js",
          "contents": "// Write a while loop that keeps opening chests until a diamond is found.\n// Use openChest() to open the next chest and save the item it returns.\n// Use isDiamond(item) to check whether that item is a diamond.",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "prompt.md",
          "contents": "**Goal:** What is the loop supposed to do?\n\n\n\n**Constraints:** What MUST be true? \n(Hint: what does the loop need to stop on?)\n\n\n\n**Edge cases:** What could go wrong?\n(Hint: what if the loop's stopping condition is never met?)",
          "folderId": "0",
          "active": true
        },
        "6": {
          "id": "6",
          "name": "data.js",
          "contents": "/*\n  data.js — Diamond Hunt: Static Game Data\n  ========================================\n  Holds the loot table, item sprites, sprite colors, rarity colors,\n  and particle settings used by helpers.js.\n*/\n\n// Loot table. Higher weight = more likely to appear.\nconst LOOT_TABLE = [\n    { item: 'rotten_flesh',   label: 'Rotten Flesh',  rarity: 'common',    weight: 22 },\n    { item: 'bone',           label: 'Bone',           rarity: 'common',    weight: 20 },\n    { item: 'string',         label: 'String',         rarity: 'common',    weight: 18 },\n    { item: 'gunpowder',      label: 'Gunpowder',      rarity: 'common',    weight: 12 },\n    { item: 'iron_ingot',     label: 'Iron Ingot',     rarity: 'uncommon',  weight: 10 },\n    { item: 'gold_ingot',     label: 'Gold Ingot',     rarity: 'uncommon',  weight:  6 },\n    { item: 'leather_helmet', label: 'Leather Helmet', rarity: 'uncommon',  weight:  4 },\n    { item: 'emerald',        label: 'Emerald',        rarity: 'rare',      weight:  3 },\n    { item: 'enchanted_book', label: 'Enchanted Book', rarity: 'rare',      weight:  2 },\n    { item: 'golden_apple',   label: 'Golden Apple',   rarity: 'rare',      weight:  1 },\n    { item: 'diamond',        label: 'Diamond',        rarity: 'legendary', weight:  2 },\n];\n\n// 8x8 pixel sprites — item icons.\nconst SPRITES = {\n    diamond: [\n        ['.', '.', '#', '#', '#', '#', '.', '.'],\n        ['.', '#', 'c', 'c', 'c', 'c', '#', '.'],\n        ['#', 'c', 'c', 'L', 'c', 'c', 'c', '#'],\n        ['#', 'c', 'L', 'L', 'c', 'c', 'c', '#'],\n        ['#', 'c', 'c', 'L', 'c', 'c', 'c', '#'],\n        ['.', '#', 'c', 'c', 'c', 'c', '#', '.'],\n        ['.', '.', '#', '#', '#', '#', '.', '.'],\n        ['.', '.', '.', '.', '.', '.', '.', '.'],\n    ],\n\n    iron_ingot: [\n        ['s', 's', 's', 's', 's', 's', 's', 's'],\n        ['s', 'b', 'b', 'b', 'b', 'b', 'b', 's'],\n        ['s', 'b', 'h', 'h', 'h', 'h', 'b', 's'],\n        ['s', 'b', 'h', 'b', 'b', 'h', 'b', 's'],\n        ['s', 'b', 'b', 'b', 'b', 'b', 'b', 's'],\n        ['s', 'b', 'b', 'b', 'b', 'b', 'b', 's'],\n        ['s', 'b', 'b', 'b', 'b', 'b', 'b', 's'],\n        ['s', 's', 's', 's', 's', 's', 's', 's'],\n    ],\n\n    gold_ingot: [\n        ['d', 'd', 'd', 'd', 'd', 'd', 'd', 'd'],\n        ['d', 'b', 'b', 'b', 'b', 'b', 'b', 'd'],\n        ['d', 'b', 'h', 'h', 'h', 'h', 'b', 'd'],\n        ['d', 'b', 'h', 'b', 'b', 'h', 'b', 'd'],\n        ['d', 'b', 'b', 'b', 'b', 'b', 'b', 'd'],\n        ['d', 'b', 'b', 'b', 'b', 'b', 'b', 'd'],\n        ['d', 'b', 'b', 'b', 'b', 'b', 'b', 'd'],\n        ['d', 'd', 'd', 'd', 'd', 'd', 'd', 'd'],\n    ],\n\n    emerald: [\n        ['.', '.', 's', 's', 's', 's', '.', '.'],\n        ['.', 's', 'h', 'h', 'b', 'b', 's', '.'],\n        ['s', 'h', 'h', 'b', 'b', 'b', 'b', 's'],\n        ['s', 'h', 'b', 'b', 'b', 'b', 'b', 's'],\n        ['s', 'b', 'b', 'b', 'b', 'b', 'b', 's'],\n        ['.', 's', 'b', 'b', 'b', 'b', 's', '.'],\n        ['.', '.', 's', 'b', 'b', 's', '.', '.'],\n        ['.', '.', '.', 's', 's', '.', '.', '.'],\n    ],\n\n    bone: [\n        ['h', 'h', '.', '.', '.', '.', 'h', 'h'],\n        ['h', 'b', 'h', '.', '.', 'h', 'b', 'h'],\n        ['h', 'h', '.', 'b', 'b', '.', 'h', 'h'],\n        ['.', '.', 'b', 'b', 'b', 'b', '.', '.'],\n        ['.', '.', 'b', 'b', 'b', 'b', '.', '.'],\n        ['h', 'h', '.', 'b', 'b', '.', 'h', 'h'],\n        ['h', 'b', 'h', '.', '.', 'h', 'b', 'h'],\n        ['h', 'h', '.', '.', '.', '.', 'h', 'h'],\n    ],\n\n    rotten_flesh: [\n        ['b', 'b', 'b', 'b', 'b', 'b', 'b', 'b'],\n        ['b', 'b', 'd', 'b', 'b', 'b', 'b', 'b'],\n        ['b', 'b', 'b', 'b', 'd', 'b', 'b', 'b'],\n        ['b', 'd', 'b', 'b', 'b', 'b', 'b', 'b'],\n        ['b', 'b', 'b', 'd', 'b', 'b', 'd', 'b'],\n        ['b', 'b', 'b', 'b', 'b', 'b', 'b', 'b'],\n        ['b', 'b', 'd', 'b', 'b', 'd', 'b', 'b'],\n        ['b', 'b', 'b', 'b', 'b', 'b', 'b', 'b'],\n    ],\n\n    string: [\n