        },
        "6": {
          "id": "6",
          "name": "data.js",
          "contents": "/*\n  data.js — Diamond Hunt: Static Game Data\n  ========================================\n  Holds the loot table, item sprites, sprite colors, rarity colors,\n  and particle settings used by helpers.js.\n*/\n\n// Loot table. Higher weight = more likely to appear.\nconst LOOT_TABLE = [\n    { item: 'rotten_flesh',   label: 'Rotten Flesh',  rarity: 'common',    weight: 22 },\n    { item: 'bone',           label: 'Bone',           rarity: 'common',    weight: 20 },\n    { item: 'string',         label: 'String',         rarity: 'common',    weight: 18 },\n    { item: 'gunpowder',      label: 'Gunpowder',      rarity: 'common',    weight: 12 },\n    { item: 'iron_ingot',     label: 'Iron Ingot',     rarity: 'uncommon',  weight: 10 },\n    { item: 'gold_ingot',     label: 'Gold Ingot',     rarity: 'uncommon',  weight:  6 },\n    { item: 'leather_helmet', label: 'Leather Helmet', rarity: 'uncommon',  weight:  4 },\n    { item: 'emerald',        label: 'Emerald',        rarity: 'rare',      weight:  3 },\n    { item: 'enchanted_book', label: 'Enchanted Book', rarity: 'rare',      weight:  2 },\n    { item: 'golden_apple',   label: 'Golden Apple',   rarity: 'rare',      weight:  1 },\n    { item: 'diamond',        label: 'Diamond',        rarity: 'legendary', weight:  2 },\n];\n\n// 8x8 pixel sprites — item icons.\nconst SPRITES = {\n    diamond: [\n        ['.', '.', '#', '#', '#', '#', '.', '.'],\n        ['.', '#', 'c', 'c', 'c', 'c', '#', '.'],\n        ['#', 'c', 'c', 'L', 'c', 'c', 'c', '#'],\n        ['#', 'c', 'L', 'L', 'c', 'c', 'c', '#'],\n        ['#', 'c', 'c', 'L', 'c', 'c', 'c', '#'],\n        ['.', '#', 'c', 'c', 'c', 'c', '#', '.'],\n        ['.', '.', '#', '#', '#', '#', '.', '.'],\n        ['.', '.', '.', '.', '.', '.', '.', '.'],\n    ],\n\n    iron_ingot: [\n        ['s', 's', 's', 's', 's', 's', 's', 's'],\n        ['s', 'b', 'b', 'b', 'b', 'b', 'b', 's'],\n        ['s', 'b', 'h', 'h', 'h', 'h', 'b', 's'],\n        ['s', 'b', 'h', 'b', 'b', 'h', 'b', 's'],\n        ['s', 'b', 'b', 'b', 'b', 'b', 'b', 's'],\n        ['s', 'b', 'b', 'b', 'b', 'b', 'b', 's'],\n        ['s', 'b', 'b', 'b', 'b', 'b', 'b', 's'],\n        ['s', 's', 's', 's', 's', 's', 's', 's'],\n    ],\n\n    gold_ingot: [\n        ['d', 'd', 'd', 'd', 'd', 'd', 'd', 'd'],\n        ['d', 'b', 'b', 'b', 'b', 'b', 'b', 'd'],\n        ['d', 'b', 'h', 'h', 'h', 'h', 'b', 'd'],\n        ['d', 'b', 'h', 'b', 'b', 'h', 'b', 'd'],\n        ['d', 'b', 'b', 'b', 'b', 'b', 'b', 'd'],\n        ['d', 'b', 'b', 'b', 'b', 'b', 'b', 'd'],\n        ['d', 'b', 'b', 'b', 'b', 'b', 'b', 'd'],\n        ['d', 'd', 'd', 'd', 'd', 'd', 'd', 'd'],\n    ],\n\n    emerald: [\n        ['.', '.', 's', 's', 's', 's', '.', '.'],\n        ['.', 's', 'h', 'h', 'b', 'b', 's', '.'],\n        ['s', 'h', 'h', 'b', 'b', 'b', 'b', 's'],\n        ['s', 'h', 'b', 'b', 'b', 'b', 'b', 's'],\n        ['s', 'b', 'b', 'b', 'b', 'b', 'b', 's'],\n        ['.', 's', 'b', 'b', 'b', 'b', 's', '.'],\n        ['.', '.', 's', 'b', 'b', 's', '.', '.'],\n        ['.', '.', '.', 's', 's', '.', '.', '.'],\n    ],\n\n    bone: [\n        ['h', 'h', '.', '.', '.', '.', 'h', 'h'],\n        ['h', 'b', 'h', '.', '.', 'h', 'b', 'h'],\n        ['h', 'h', '.', 'b', 'b', '.', 'h', 'h'],\n        ['.', '.', 'b', 'b', 'b', 'b', '.', '.'],\n        ['.', '.', 'b', 'b', 'b', 'b', '.', '.'],\n        ['h', 'h', '.', 'b', 'b', '.', 'h', 'h'],\n        ['h', 'b', 'h', '.', '.', 'h', 'b', 'h'],\n        ['h', 'h', '.', '.', '.', '.', 'h', 'h'],\n    ],\n\n    rotten_flesh: [\n        ['b', 'b', 'b', 'b', 'b', 'b', 'b', 'b'],\n        ['b', 'b', 'd', 'b', 'b', 'b', 'b', 'b'],\n        ['b', 'b', 'b', 'b', 'd', 'b', 'b', 'b'],\n        ['b', 'd', 'b', 'b', 'b', 'b', 'b', 'b'],\n        ['b', 'b', 'b', 'd', 'b', 'b', 'd', 'b'],\n        ['b', 'b', 'b', 'b', 'b', 'b', 'b', 'b'],\n        ['b', 'b', 'd', 'b', 'b', 'd', 'b', 'b'],\n        ['b', 'b', 'b', 'b', 'b', 'b', 'b', 'b'],\n    ],\n\n    string: [\n        ['w', '.', '.', '.', '.', '.', 'w', '.'],\n        ['w', '.', '.', '.', '.', '.', 'w', '.'],\n        ['.', 'w', '.', '.', '.', 'w', '.', '.'],\n        ['.', 'w', '.', '.', '.', 'w', '.', '.'],\n        ['.', '.', 'w', '.', 'w', '.', '.', '.'],\n        ['.', '.', 'w', '.', 'w', '.', '.', '.'],\n        ['.', '.', '.', 'w', '.', '.', '.', '.'],\n        ['.', '.', '.', 'w', '.', '.', '.', '.'],\n    ],\n\n    gunpowder: [\n        ['.', '.', '.', '.', '.', '.', '.', '.'],\n        ['.', '.', 'b', 'b', 'b', '.', '.', '.'],\n        ['.', 'b', 'b', 'd', 'b', 'b', '.', '.'],\n        ['b', 'b', 'd', 'b', 'b', 'b', 'b', '.'],\n        ['b', 'b', 'b', 'b', 'd', 'b', 'b', '.'],\n        ['.', 'b', 'b', 'b', 'b', 'b', '.', '.'],\n        ['.', '.', 'b', 'b', 'b', '.', '.', '.'],\n        ['.', '.', '.', '.', '.', '.', '.', '.'],\n    ],\n\n    leather_helmet: [\n        ['.', '.', 's', 's', 's', 's', '.', '.'],\n        ['.', 's', 'h', 'h', 'h', 'h', 's', '.'],\n        ['s', 'h', 'h', 'b', 'b', 'h', 'h', 's'],\n        ['s', 'h', 'b', 'b', 'b', 'b', 'h', 's'],\n        ['s', 'b', 'b', 'b', 'b', 'b', 'b', 's'],\n        ['s', 'b', 'b', '.', '.', 'b', 'b', 's'],\n        ['.', 's', 'b', '.', '.', 'b', 's', '.'],\n        ['.', '.', 's', 's', 's', 's', '.', '.'],\n    ],\n\n    enchanted_book: [\n        ['s', 'b', 'b', 'b', 'b', 'b', 'p', 'p'],\n        ['s', 'b', 'b', 'b', 'b', 'b', 'p', 'p'],\n        ['s', 'b', 'h', 'h', 'h', 'b', 'p', 'p'],\n        ['s', 'b', 'h', 'b', 'b', 'b', 'p', 'p'],\n        ['s', 'b', 'h', 'h', 'h', 'b', 'p', 'p'],\n        ['s', 'b', 'b', 'b', 'b', 'b', 'p', 'p'],\n        ['s', 'b', 'b', 'b', 'b', 'b', 'p', 'p'],\n        ['s', 's', 's', 's', 's', 's', 's', 's'],\n    ],\n\n    golden_apple: [\n        ['.', '.', '.', 'l', 'l', '.', '.', '.'],\n        ['.', '.', 'l', '.', '.', 'l', '.', '.'],\n        ['.', 'b', 'b', 'b', 'b', 'b', 'b', '.'],\n        ['b', 'h', 'h', 'b', 'b', 'b', 'b', 'b'],\n        ['b', 'h', 'b', 'b', 'b', 'b', 'b', 'b'],\n        ['b', 'b', 'b', 'b', 'b', 'b', 'b', 'b'],\n        ['.', 'b', 'b', 'b', 'b', 'b', 'b', '.'],\n        ['.', '.', 'b', 'b', 'b', 'b', '.', '.'],\n    ],\n};\n\n// Color palettes for each sprite — maps letter codes to hex colors.\nconst SPRITE_COLORS = {\n    diamond:        { '#': '#1AA7C4', 'c': '#5DD8EE', 'L': '#AFF0FA' },\n    iron_ingot:     { 'b': '#A8A8A8', 'h': '#D0D0D0', 's': '#707070' },\n    gold_ingot:     { 'b': '#F0C020', 'h': '#FFE060', 'd': '#A08010' },\n    emerald:        { 'b': '#17DD62', 'h': '#5AFF90', 's': '#0A8035' },\n    bone:           { 'b': '#E8E0D0', 'h': '#FFFFFF' },\n    rotten_flesh:   { 'b': '#8B3A1A', 'd': '#4A1A08' },\n    string:         { 'w': '#E0E0E0', 's': '#A0A0A0' },\n    gunpowder:      { 'b': '#444444', 'd': '#222222' },\n    leather_helmet: { 'b': '#8B5A2B', 'h': '#A0693A', 's': '#5A3010' },\n    enchanted_book: { 'b': '#6A0DAD', 'h': '#9B30D4', 's': '#440070', 'p': '#F0E0FF' },\n    golden_apple:   { 'b': '#FFD700', 'h': '#FFED80', 'l': '#228B22' },\n};\n\n// Maps rarity names to display colors.\nconst RARITY_COLORS = {\n    common:    '#AAAAAA',\n    uncommon:  '#55FFFF',\n    rare:      '#FFAA00',\n    legendary: '#55FFFF',\n};\n\n// Rarity → particle config.\nconst PARTICLE_CONFIGS = {\n    common:    { count: 4,  color: '#888888' },\n    uncommon:  { count: 6,  color: '#55FFFF' },\n    rare:      { count: 8,  color: '#FFAA00' },\n    legendary: { count: 12, color: '#55FFFF' },\n};",
