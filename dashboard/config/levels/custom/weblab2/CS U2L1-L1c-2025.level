          "name": "style.css",
          "language": "css",
          "contents": "body {\n  background: gold;\n  font-family: cursive;\n}\np {\n  color: black;\n}\nh1 {\n  font-weight: bold;\n  text-align: center;\n}\n\n.header {\n  width: 50%;\n  margin-left: 25%;\n  border: solid 4px green;\n  border-radius: 10px;\n}\n\n.align-left {\n  width: 25%;\n  margin-right: 20px;\n  float:left;\n  margin-bottom: 10px;\n  border: solid 4px green;\n  border-radius: 10px;\n}\n\n.align-right {\n  width: 25%;\n  margin-left: 20px;\n  float:right;\n  \n}\n\nhr {\n  clear: both;\n}\n\n.itemtitle {\n  font-family: Arial;\n  font-weight: bold;\n  \n}\n\n.disclaimer {\n  font-family: Consolas;\n  font-size: 10px;\n  color: grey;\n  text-align: center;\n}",
