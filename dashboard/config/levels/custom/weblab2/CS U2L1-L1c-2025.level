          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    <h1>\n      Maria Bonita Catering\n    </h1>\n    \n    <img class=\"header\" src=\"food.jpg\" />\n    \n    <p>Maria Bonita Catering can provide excellent service and delicious food for your next event! Contact us at 1 (234) 555-6789.\n    \n    <h2>Available Dishes</h2>\n    \n    <img class=\"align-left\" src=\"tacos.jpg\" />\n    <p class=\"itemtitle\">Tacos - $4.99 per taco</p>\n    <p>We offer several varieties of tacos, including vegetarian and vegan options</p>\n    \n    <hr />\n    \n    <img class=\"align-right\" src=\"chips.jpg\" />\n    <p class=\"itemtitle\">Chips and Salsa - $10.99 per bag of chips</p>\n    <p>We offer yellow and blue corn tortilla chips with three flavors of salsa</p>\n    \n    \n    <hr />\n    \n    <img class=\"align-left\" src=\"burrito.jpg\" />\n    <p class=\"itemtitle\">Burritos - $8.99 per burrito</p>\n    <p>Burritos include your choice of meat or fish with enchilada sauce on the top</p>\n\n    <hr />\n    \n    <p class=\"disclaimer\">All images from Pixabay and are provided with a Pixabay license</p>\n    \n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "10": {
