      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html>\n<head>\n  <title>Progress Tracker</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <h1>Progress Tracker</h1>\n\n  <div id=\"progressContainer\">\n    <div id=\"progressBar\"></div>\n  </div>\n\n  <div id=\"textArea\"></div>\n\n  <button id=\"increaseProgressButton\">Increase Progress</button>\n  <button id=\"decreaseProgressButton\">Decrease Progress</button>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "body {\n  font-family: Arial, Helvetica, sans-serif;\n  color: #1f2937;\n  text-align: center;\n  padding: 32px 20px;\n}\n\nh1 {\n  margin-bottom: 20px;\n}\n\n#progressContainer {\n  width: 300px;\n  height: 24px;\n  border: 2px solid #d1d5db;\n  border-radius: 12px;\n  margin: 0 auto 20px;\n  overflow: hidden;\n}\n\n#progressBar {\n  height: 100%;\n  width: 10%;\n  background-color: #60a5fa;\n  transition: width 0.3s ease;\n}\n\n#textArea {\n  margin: 0 auto 20px;\n  max-width: 420px;\n  min-height: 60px;\n  padding: 12px;\n  border: 1px solid #d1d5db;\n  border-radius: 8px;\n  background-color: white;\n  font-size: 1rem;\n}\n\nbutton {\n  padding: 10px 16px;\n  margin: 5px;\n  border: 1px solid #d1d5db;\n  border-radius: 8px;\n  background-color: #e5e7eb;\n  cursor: pointer;\n  font-weight: 600;\n  font-size: 1rem;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const increaseButton = document.getElementById(\"increaseProgressButton\");\nconst progressBar = document.getElementById(\"progressBar\");\nconst textArea = document.getElementById(\"textArea\");\n\nlet progress = 10;\n\nincreaseButton.addEventListener(\"click\", () => {\n  progress = progress + 10;\n  progressBar.style.width = progress + \"%\";\n  textArea.textContent = \"Progress: \" + progress + \"%\";\n});",
          "folderId": "0",
          "active": false
        },
