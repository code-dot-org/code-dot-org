    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Fair Music Filter</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <div class=\"app-container\">\n    <header>\n      <h1>🎵 Fair Music Filter</h1>\n      <p>Curating playlists without bias.</p>\n    </header>\n\n    <main>\n      <div class=\"controls\">\n        <div class=\"input-group\">\n          <label for=\"popularityInput\">Min Popularity (0-100)</label>\n          <input type=\"number\" id=\"popularityInput\" placeholder=\"e.g. 80\" min=\"0\" max=\"100\">\n        </div>\n\n        <div class=\"input-group\">\n          <label for=\"genreDropdown\">Genre</label>\n          <select id=\"genreDropdown\">\n            <option value=\"Pop\">Pop</option>\n            <option value=\"Rock\">Rock</option>\n            <option value=\"Hip-Hop\">Hip-Hop</option>\n            <option value=\"Jazz\">Jazz</option>\n          </select>\n        </div>\n\n        <button id=\"applyButton\">Apply Filter</button>\n      </div>\n\n      <div class=\"output-section\">\n        <h3 id=\"countLabel\">Results: 0</h3>\n        <pre id=\"resultsArea\">No results yet...</pre>\n      </div>\n    </main>\n  </div>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// Data Setup (Simulating a database)\nconst songs = [\n  { title: \"Levitating\", artist: \"Dua Lipa\", genre: \"Pop\", popularity: 100 },\n  { title: \"Blinding Lights\", artist: \"The Weeknd\", genre: \"Pop\", popularity: 95 },\n  { title: \"Smells Like Teen Spirit\", artist: \"Nirvana\", genre: \"Rock\", popularity: 92 },\n  { title: \"Take Five\", artist: \"Dave Brubeck\", genre: \"Jazz\", popularity: 85 },\n  { title: \"Juicy\", artist: \"Notorious B.I.G.\", genre: \"Hip-Hop\", popularity: 90 },\n  { title: \"Missing You\", artist: \"Mystery Artist\", genre: \"Pop\" }, // Note: Missing popularity!\n  { title: \"Unknown Track\", artist: \"Unknown\", popularity: 88 }     // Note: Missing genre!\n];\n\n// Element Selection\nconst popularityInput = document.querySelector(\"#popularityInput\");\nconst genreDropdown = document.querySelector(\"#genreDropdown\");\nconst applyButton = document.querySelector(\"#applyButton\");\nconst resultsArea = document.querySelector(\"#resultsArea\");\nconst countLabel = document.querySelector(\"#countLabel\");\n\n// Helper Functions\n\nconst filterByPopularity = (song, minPop) => {\n\n};\n\nconst filterByGenre = (song, selectedGenre) => {\n\n};\n\n// Event Listener\n\napplyButton.addEventListener(\"click\", () => {\n  // Get current values from inputs\n  const minPop = Number(popularityInput.value);\n  const selectedGenre = genreDropdown.value;\n  \n  // Create a list of results using .map()\n  const results = songs.map((song) => {\n\n    return \"\"; // temporary placeholder\n  });\n\n  // Display results\n  resultsArea.textContent = results.join(\"\\n\");\n});",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "/* style.css */\n:root {\n  --primary: #6c5ce7;\n  --secondary: #a29bfe;\n  --bg: #2d3436;\n  --card-bg: #dfe6e9;\n  --text: #2d3436;\n}\n\nbody {\n  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n  background-color: var(--bg);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  min-height: 100vh;\n  margin: 0;\n  color: var(--text);\n}\n\n.app-container {\n  background-color: white;\n  width: 400px;\n  padding: 2rem;\n  border-radius: 12px;\n  box-shadow: 0 10px 25px rgba(0,0,0,0.5);\n}\n\nheader {\n  text-align: center;\n  margin-bottom: 2rem;\n}\n\nh1 {\n  margin: 0;\n  color: var(--primary);\n}\n\n.input-group {\n  margin-bottom: 1rem;\n}\n\nlabel {\n  display: block;\n  font-weight: bold;\n  margin-bottom: 0.5rem;\n}\n\ninput, select {\n  width: 100%;\n  padding: 0.8rem;\n  border: 2px solid var(--secondary);\n  border-radius: 8px;\n  font-size: 1rem;\n  box-sizing: border-box; /* Ensures padding doesn't break width */\n}\n\nbutton {\n  width: 100%;\n  padding: 1rem;\n  background-color: var(--primary);\n  color: white;\n  border: none;\n  border-radius: 8px;\n  font-size: 1.1rem;\n  cursor: pointer;\n  transition: background 0.2s;\n}\n\nbutton:hover {\n  background-color: #5649c0;\n}\n\n.output-section {\n  margin-top: 2rem;\n  background-color: var(--card-bg);\n  padding: 1rem;\n  border-radius: 8px;\n  min-height: 150px;\n}\n\n#resultsArea {\n  white-space: pre-wrap; /* Preserves newlines but wraps text */\n  font-family: 'Courier New', Courier, monospace;\n  color: #333;\n}",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
