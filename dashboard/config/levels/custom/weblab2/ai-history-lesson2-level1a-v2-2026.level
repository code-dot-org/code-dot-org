        "13": {
          "id": "13",
          "name": "style.css",
          "contents": "@import url(\"https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap\");\n\n:root {\n  --brand-light: #e4e2f8;\n  --brand-mid: #aca8ea;\n  --brand-primary: #4c42cf;\n  --brand-dark: #1f1976;\n  --brand-black: #000000;\n  --white: #ffffff;\n\n  --background: var(--white);\n  --surface: var(--white);\n  --text: var(--brand-dark);\n  --body-text: #272542;\n  --muted-text: #3d3a68;\n  --border: var(--brand-mid);\n  --panel-heading: var(--brand-light);\n  --link: var(--brand-dark);\n  --focus: var(--brand-primary);\n  --content-width: 880px;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml {\n  color-scheme: light;\n  font-size: 100%;\n}\n\nbody {\n  margin: 0;\n  background: var(--background);\n  color: var(--body-text);\n  font-family: \"Geist\", Arial, sans-serif;\n  font-size: 1rem;\n  line-height: 1.6;\n}\n\n.skip-link {\n  position: absolute;\n  top: -5rem;\n  left: 1rem;\n  z-index: 10;\n  padding: 0.75rem 1rem;\n  background: var(--white);\n  color: var(--brand-dark);\n  font-weight: 700;\n}\n\n.skip-link:focus {\n  top: 1rem;\n}\n\n.contributor-header,\n.page-shell {\n  width: min(calc(100% - 2rem), var(--content-width));\n  margin-inline: auto;\n}\n\n.contributor-header {\n  display: grid;\n  grid-template-columns: 124px minmax(0, 1fr);\n  gap: 1.5rem;\n  align-items: center;\n  margin-top: 1.5rem;\n  padding: 1.25rem;\n  border: 1px solid var(--brand-mid);\n  border-left: 0.4rem solid var(--brand-primary);\n  border-radius: 0.5rem;\n  background: var(--brand-light);\n}\n\n.contributor-image {\n  display: block;\n  width: 124px;\n  height: 148px;\n  border-radius: 0.35rem;\n  object-fit: cover;\n  object-position: center top;\n}\n\n.contributor-introduction {\n  min-width: 0;\n}\n\nh1,\nsummary {\n  font-family: \"Space Grotesk\", Arial, sans-serif;\n}\n\nh1,\np {\n  overflow-wrap: anywhere;\n}\n\nh1 {\n  margin: 0;\n  color: var(--brand-dark);\n  font-size: clamp(1.8rem, 5vw, 2.5rem);\n  font-weight: 700;\n  line-height: 1.15;\n}\n\n.contributor-headline {\n  max-width: 38rem;\n  margin: 0.45rem 0 0;\n  color: var(--muted-text);\n  font-size: 1.1rem;\n  font-weight: 500;\n  line-height: 1.45;\n}\n\n.page-shell {\n  padding-block: 1rem 3rem;\n}\n\n.panels {\n  display: grid;\n  gap: 0.8rem;\n}\n\n.panel {\n  overflow: hidden;\n  border: 1px solid var(--border);\n  border-radius: 0.35rem;\n  background: var(--surface);\n}\n\nsummary {\n  min-height: 3.25rem;\n  padding: 0.8rem 3rem 0.8rem 1rem;\n  background: var(--panel-heading);\n  color: var(--brand-dark);\n  font-size: 1.05rem;\n  font-weight: 600;\n  cursor: pointer;\n  touch-action: manipulation;\n}\n\nsummary:hover {\n  background: var(--brand-mid);\n}\n\n.panel[open] > summary {\n  border-bottom: 1px solid var(--border);\n}\n\n.panel-content {\n  padding: 1.25rem;\n}\n\n.panel-content > :first-child {\n  margin-top: 0;\n}\n\n.panel-content > :last-child {\n  margin-bottom: 0;\n}\n\na {\n  color: var(--link);\n  font-weight: 600;\n  text-decoration-thickness: 0.12em;\n  text-underline-offset: 0.16em;\n  touch-action: manipulation;\n}\n\na:hover {\n  color: var(--brand-primary);\n  text-decoration-thickness: 0.2em;\n}\n\n.source-list {\n  padding-left: 1.4rem;\n}\n\n.source-list li + li {\n  margin-top: 0.65rem;\n}\n\n:focus-visible {\n  outline: 4px solid var(--focus);\n  outline-offset: 3px;\n}\n\n@media (max-width: 560px) {\n  .contributor-header {\n    grid-template-columns: 92px minmax(0, 1fr);\n    gap: 1rem;\n    margin-top: 1rem;\n    padding: 1rem;\n  }\n\n  .contributor-image {\n    width: 92px;\n    height: 112px;\n  }\n\n  .contributor-header h1 {\n    font-size: 1.55rem;\n  }\n\n  .contributor-headline {\n    font-size: 1rem;\n  }\n}\n\n@media (max-width: 380px) {\n  .contributor-header {\n    grid-template-columns: 1fr;\n  }\n\n  .contributor-image {\n    width: 112px;\n    height: 136px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    scroll-behavior: auto !important;\n  }\n}\n\n@media (prefers-contrast: more) {\n  :root {\n    --border: var(--brand-dark);\n    --muted-text: var(--brand-black);\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "14": {
          "id": "14",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n\n  <title>Alan Turing | AI History</title>\n\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n\n<body>\n  <a class=\"skip-link\" href=\"#main-content\">Skip to contributor information</a>\n\n  <header class=\"contributor-header\">\n    <img\n      class=\"contributor-image\"\n      src=\"turing.jpg\"\n      alt=\"Portrait of Alan Turing\"\n    >\n\n    <div class=\"contributor-introduction\">\n      <h1>Alan Turing</h1>\n\n      <p class=\"contributor-headline\">\n        Foundational Questions\n      </p>\n    </div>\n  </header>\n\n  <main id=\"main-content\" class=\"page-shell\">\n    <div class=\"panels\">\n      <details class=\"panel\">\n        <summary>What did they contribute?</summary>\n\n        <div class=\"panel-content\">\n          <p>\n            Turing was a mathematician and computer scientist who helped give\n            machine intelligence one of its earliest and most important\n            questions: <em>Can machines think?</em> In a 1950 paper, he proposed\n            the imitation game — now called the Turing Test — as a way to evaluate\n            whether a machine could produce responses indistinguishable from a\n            human.<sup class=\"fn\">1</sup>\n          </p>\n        </div>\n      </details>\n\n      <details class=\"panel\">\n        <summary>What part of AI history does this connect to?</summary>\n\n        <div class=\"panel-content\">\n          <p>\n            Turing's ideas belong to the earliest stage of AI history, before\n            the field even had a name. He connected mathematics, computing, and\n            philosophy of mind in ways that gave future researchers a framework\n            for thinking about machine intelligence.<sup class=\"fn\">1</sup>\n          </p>\n        </div>\n      </details>\n\n      <details class=\"panel\">\n        <summary>Why does this contribution matter?</summary>\n\n        <div class=\"panel-content\">\n          <p>\n            By asking a practical question instead of a purely philosophical\n            one, Turing made the study of machine intelligence something\n            researchers could actually investigate. The Turing Test is still\n            debated today as AI systems become capable of generating\n            increasingly fluent, human-like responses.<sup class=\"fn\">1,</sup><sup class=\"fn\">2</sup>\n          </p>\n        </div>\n      </details>\n    </div>\n  </main>\n</body>\n</html>",
          "folderId": "0",
          "active": true
        },
