<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-11-03T03:28:28.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": true,
    "start_sources": {
      "folders": {
      },
      "files": {
        "17b581c8-52d8-4910-bef7-a0aed209a478": {
          "id": "17b581c8-52d8-4910-bef7-a0aed209a478",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Name the Page Parts</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <h1>Name the Page Parts</h1>\n    <p>Click on different sections of this club page to learn their names and jobs.</p>\n\n    <div class=\"page-container\">\n        <div class=\"hero-section\" id=\"heroSection\">\n            <h2>Welcome to the Adventure Club!</h2>\n            <p>Explore the outdoors, make new friends, and discover new hobbies with us.</p>\n            <button class=\"hero-button\">Join Our Next Trip</button>\n        </div>\n\n        <div class=\"feature-cards\" id=\"featureCards\">\n            <div class=\"card\" id=\"card1\">\n                <h3>Exciting Events</h3>\n                <p>Hiking, camping, kayaking, and more! We organize a variety of activities.</p>\n            </div>\n            <div class=\"card\" id=\"card2\">\n                <h3>Skill Building</h3>\n                <p>Learn navigation, first aid, and survival skills from experienced members.</p>\n            </div>\n            <div class=\"card\" id=\"card3\">\n                <h3>Community</h3>\n                <p>Connect with fellow adventurers who share your passion for exploration.</p>\n            </div>\n        </div>\n\n        <div class=\"cta-section\" id=\"ctaSection\">\n            <h2>Ready for an Adventure?</h2>\n            <p>Sign up today and start your journey with the Adventure Club!</p>\n            <button class=\"cta-button\">Become a Member</button>\n        </div>\n    </div>\n\n    <div class=\"info-box\">\n        <h2>Selected Part Info:</h2>\n        <p><strong>Name:</strong> <span id=\"partName\">Click a section</span></p>\n        <p><strong>Job:</strong> <span id=\"partJob\">To see its name and what it does.</span></p>\n    </div>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "667982b3-419d-4fc2-a06c-8daae09e1086": {
          "id": "667982b3-419d-4fc2-a06c-8daae09e1086",
          "name": "style.css",
          "contents": "body {\n    font-family: Arial, sans-serif;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    min-height: 100vh;\n    background-color: #f4f4f4;\n    color: #333;\n    margin: 0;\n    padding: 20px;\n    box-sizing: border-box;\n}\n\nh1 {\n    color: #0056b3;\n    margin-bottom: 10px;\n}\n\np {\n    margin-bottom: 25px;\n    text-align: center;\n}\n\n.page-container {\n    background-color: #fff;\n    padding: 30px;\n    border-radius: 10px;\n    box-shadow: 0 4px 10px rgba(0,0,0,0.1);\n    margin-bottom: 30px;\n    width: 90%;\n    max-width: 800px;\n    display: flex;\n    flex-direction: column;\n    gap: 30px;\n}\n\n.hero-section,\n.feature-cards,\n.cta-section {\n    border: 1px solid #ddd;\n    border-radius: 8px;\n    padding: 20px;\n    text-align: center;\n    cursor: pointer;\n    transition: background-color 0.3s ease;\n}\n\n.hero-section:hover,\n.feature-cards:hover,\n.cta-section:hover {\n    background-color: #e9e9e9;\n}\n\n.hero-section h2 {\n    color: #28a745;\n    margin-top: 0;\n    font-size: 2em;\n}\n\n.hero-button,\n.cta-button {\n    background-color: #007bff;\n    color: white;\n    padding: 10px 20px;\n    border: none;\n    border-radius: 5px;\n    font-size: 1em;\n    cursor: pointer;\n    margin-top: 15px;\n    transition: background-color 0.3s ease;\n}\n\n.hero-button:hover,\n.cta-button:hover {\n    background-color: #0056b3;\n}\n\n.feature-cards {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n    gap: 20px;\n}\n\n.card {\n    background-color: #f9f9f9;\n    border: 1px solid #eee;\n    border-radius: 5px;\n    padding: 15px;\n    box-shadow: 0 2px 5px rgba(0,0,0,0.05);\n    cursor: pointer;\n    transition: transform 0.2s ease;\n}\n\n.card:hover {\n    transform: translateY(-5px);\n}\n\n.card h3 {\n    color: #ffc107;\n    margin-top: 0;\n    font-size: 1.2em;\n}\n\n.cta-section h2 {\n    color: #dc3545;\n    font-size: 1.8em;\n}\n\n.info-box {\n    background-color: #e2f0fb;\n    border: 1px solid #a8d5f7;\n    padding: 20px;\n    border-radius: 8px;\n    width: 90%;\n    max-width: 400px;\n    box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n}\n\n.info-box h2 {\n    color: #007bff;\n    margin-top: 0;\n    margin-bottom: 15px;\n    border-bottom: 1px solid #a8d5f7;\n    padding-bottom: 10px;\n}\n\n.info-box p {\n    text-align: left;\n    margin-bottom: 10px;\n    font-size: 1em;\n}\n\n.info-box strong {\n    color: #0056b3;\n}\n",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "a9718119-23cf-4034-bdb6-aa1a49cb5019": {
          "id": "a9718119-23cf-4034-bdb6-aa1a49cb5019",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const heroSection = document.getElementById('heroSection');\n    const featureCards = document.getElementById('featureCards');\n    const card1 = document.getElementById('card1');\n    const card2 = document.getElementById('card2');\n    const card3 = document.getElementById('card3');\n    const ctaSection = document.getElementById('ctaSection');\n\n    const partNameSpan = document.getElementById('partName');\n    const partJobSpan = document.getElementById('partJob');\n\n    function updateInfo(name, job) {\n        partNameSpan.textContent = name;\n        partJobSpan.textContent = job;\n    }\n\n    heroSection.addEventListener('click', (event) => {\n        // Prevent clicks on buttons inside from triggering this parent handler\n        if (event.target.tagName !== 'BUTTON') {\n            updateInfo(\"Hero Section\", \"Introduces the club and its main message, grabbing attention.\");\n        }\n    });\n\n    // Click on the overall feature cards area\n    featureCards.addEventListener('click', (event) => {\n        if (event.target.classList.contains('card') || event.target.closest('.card')) {\n            // If a specific card was clicked, its info will be displayed by its own listener\n            // This prevents the parent from overwriting if a card was the target\n            return;\n        }\n        updateInfo(\"Feature Cards Area\", \"Displays key aspects or benefits of the club in separate, digestible blocks.\");\n    });\n\n    card1.addEventListener('click', () => {\n        updateInfo(\"Feature Card (Events)\", \"Highlights the exciting activities and events the club offers.\");\n    });\n    card2.addEventListener('click', () => {\n        updateInfo(\"Feature Card (Skill Building)\", \"Showcases opportunities to learn new skills.\");\n    });\n    card3.addEventListener('click', () => {\n        updateInfo(\"Feature Card (Community)\", \"Emphasizes the social and connection aspects of the club.\");\n    });\n\n    ctaSection.addEventListener('click', (event) => {\n        // Prevent clicks on buttons inside from triggering this parent handler\n        if (event.target.tagName !== 'BUTTON') {\n            updateInfo(\"Call-to-Action Section\", \"Encourages visitors to take a specific action, like joining or learning more.\");\n        }\n    });\n\n    // Initial message\n    updateInfo(\"Click a section\", \"To see its name and what it does.\");\n});\n",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
        "17b581c8-52d8-4910-bef7-a0aed209a478",
        "667982b3-419d-4fc2-a06c-8daae09e1086",
        "a9718119-23cf-4034-bdb6-aa1a49cb5019"
      ]
    },
