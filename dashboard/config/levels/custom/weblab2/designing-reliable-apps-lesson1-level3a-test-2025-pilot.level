<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-01-27T17:47:01.000Z",
  "level_num": "custom",
  "user_id": 18762,
  "properties": {
    "display_name": "Pokémon API",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>PokéStats Generator</title>\n    <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n\n    <div class=\"app-container\">\n        <div class=\"pokemon-card\">\n            <div class=\"card-body\">\n                \n                <div class=\"identity-section\">\n                    <h1 id=\"pokeName\">Ready?</h1>\n                    <p id=\"pokeType\">---</p>\n                </div>\n\n                <div class=\"main-stat-section\">\n                    <label>Base Experience</label>\n                    <div id=\"baseExp\">--</div>\n                </div>\n\n                <div class=\"bio-section\">\n                    <p>Height: <span id=\"pokeHeight\">--</span></p>\n                    <p>Weight: <span id=\"pokeWeight\">--</span></p>\n                    <p>Ability: <span id=\"pokeAbility\">--</span></p>\n                </div>\n\n            </div>\n        </div>\n\n        <button id=\"generateBtn\">Generate Random Pokémon</button>\n    </div>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "styles.css",
          "language": "css",
          "contents": "body {\n    font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;\n    background-color: #f8f9fa;\n    margin: 0;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    height: 100vh;\n}\n\n.app-container {\n    width: 100%;\n    max-width: 800px;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding: 20px;\n}\n\n.pokemon-card {\n    background: white;\n    width: 100%;\n    border-radius: 12px;\n    box-shadow: 0 8px 30px rgba(0,0,0,0.05);\n    padding: 40px;\n    margin-bottom: 30px;\n    border-left: 8px solid #00cec9; /* Accent border */\n}\n\n.card-body {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 30px;\n}\n\n/* Identity Section */\n.identity-section {\n    flex: 1.2;\n}\n\n.identity-section h1 {\n    margin: 0;\n    text-transform: capitalize;\n    font-size: 2.5rem;\n    color: #2d3436;\n    letter-spacing: -0.5px;\n}\n\n#pokeType {\n    margin: 8px 0 0 0;\n    font-weight: 600;\n    color: #636e72;\n    text-transform: uppercase;\n    font-size: 0.9rem;\n}\n\n/* Main Stat Section */\n.main-stat-section {\n    flex: 1;\n    text-align: center;\n    border-left: 1px solid #eee;\n    border-right: 1px solid #eee;\n}\n\n.main-stat-section label {\n    font-size: 0.75rem;\n    color: #b2bec3;\n    text-transform: uppercase;\n    font-weight: bold;\n}\n\n#baseExp {\n    font-size: 4rem;\n    font-weight: 800;\n    color: #ff7675;\n}\n\n/* Bio Section */\n.bio-section {\n    flex: 1;\n    padding-left: 10px;\n}\n\n.bio-section p {\n    margin: 12px 0;\n    font-size: 1.1rem;\n    color: #2d3436;\n    display: flex;\n    justify-content: space-between;\n}\n\n.bio-section span {\n    font-weight: 700;\n    color: #00cec9;\n}\n\n/* Button */\n#generateBtn {\n    background: #2d3436;\n    color: white;\n    border: none;\n    padding: 16px 45px;\n    font-size: 1rem;\n    font-weight: bold;\n    border-radius: 6px;\n    cursor: pointer;\n    transition: all 0.2s;\n}\n\n#generateBtn:hover {\n    background: #00cec9;\n    transform: scale(1.02);\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const generateBtn = document.getElementById('generateBtn');\n\ngenerateBtn.addEventListener('click', () => {\n    // 1 to 898 covers Generations 1-8\n    const randomId = Math.floor(Math.random() * 898) + 1;\n    const apiUrl = `https://pokeapi.co/api/v2/pokemon/${randomId}`;\n\n    fetch(apiUrl)\n        .then(response => {\n            if (!response.ok) throw new Error(\"Network error\");\n            return response.json();\n        })\n        .then(data => {\n            updateUI(data);\n        })\n        .catch(error => {\n            console.error(error);\n            document.getElementById('pokeName').innerText = \"Error!\";\n        });\n});\n\nfunction updateUI(data) {\n    // Update Identity\n    document.getElementById('pokeName').innerText = data.name;\n    document.getElementById('pokeType').innerText = data.types.map(t => t.type.name).join(' • ');\n\n    // Update Stats\n    document.getElementById('baseExp').innerText = data.base_experience || 'N/A';\n    document.getElementById('pokeHeight').innerText = `${data.height / 10}m`;\n    document.getElementById('pokeWeight').innerText = `${data.weight / 10}kg`;\n    \n    // Ability formatting\n    const abilityName = data.abilities[0].ability.name;\n    document.getElementById('pokeAbility').innerText = abilityName.replace('-', ' ');\n\n    generateBtn.innerText = \"Fetch New Pokémon\";\n}",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
          "name": "pokemon.json",
          "language": "json",
          "contents": "{\"abilities\":[{\"ability\":{\"name\":\"limber\",\"url\":\"https://pokeapi.co/api/v2/ability/7/\"},\"is_hidden\":false,\"slot\":1},{\"ability\":{\"name\":\"imposter\",\"url\":\"https://pokeapi.co/api/v2/ability/150/\"},\"is_hidden\":true,\"slot\":3}],\"base_experience\":101,\"cries\":{\"latest\":\"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/132.ogg\",\"legacy\":\"https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/legacy/132.ogg\"},\"forms\":[{\"name\":\"ditto\",\"url\":\"https://pokeapi.co/api/v2/pokemon-form/132/\"}],\"game_indices\":[{\"game_index\":76,\"version\":{\"name\":\"red\",\"url\":\"https://pokeapi.co/api/v2/version/1/\"}},{\"game_index\":76,\"version\":{\"name\":\"blue\",\"url\":\"https://pokeapi.co/api/v2/version/2/\"}},{\"game_index\":76,\"version\":{\"name\":\"yellow\",\"url\":\"https://pokeapi.co/api/v2/version/3/\"}},{\"game_index\":132,\"version\":{\"name\":\"gold\",\"url\":\"https://pokeapi.co/api/v2/version/4/\"}},{\"game_index\":132,\"version\":{\"name\":\"silver\",\"url\":\"https://pokeapi.co/api/v2/version/5/\"}},{\"game_index\":132,\"version\":{\"name\":\"crystal\",\"url\":\"https://pokeapi.co/api/v2/version/6/\"}},{\"game_index\":132,\"version\":{\"name\":\"ruby\",\"url\":\"https://pokeapi.co/api/v2/version/7/\"}},{\"game_index\":132,\"version\":{\"name\":\"sapphire\",\"url\":\"https://pokeapi.co/api/v2/version/8/\"}},{\"game_index\":132,\"version\":{\"name\":\"emerald\",\"url\":\"https://pokeapi.co/api/v2/version/9/\"}},{\"game_index\":132,\"version\":{\"name\":\"firered\",\"url\":\"https://pokeapi.co/api/v2/version/10/\"}},{\"game_index\":132,\"version\":{\"name\":\"leafgreen\",\"url\":\"https://pokeapi.co/api/v2/version/11/\"}},{\"game_index\":132,\"version\":{\"name\":\"diamond\",\"url\":\"https://pokeapi.co/api/v2/version/12/\"}},{\"game_index\":132,\"version\":{\"name\":\"pearl\",\"url\":\"https://pokeapi.co/api/v2/version/13/\"}},{\"game_index\":132,\"version\":{\"n