        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n  </head>\n  <body>\n    <!-- info on my travels -->\n    <h1>My Travels</h1>\n    \n    <!-- 2) Add a descriptive alt attribute to each image -->\n    <h2>Kyoto, Japan</h2>\n    \n    <img src=\"Lanterns.jpg\">\n    \n    <p>Photo by Nicholas Dench from FreeImages</p>\n    <br>\n    \n    <h2>Paris, France</h2>\n    \n    <img src=\"Eiffel.jpg\">\n    \n    <p>Photo by Benjamin Thorn from FreeImages</p>\n    \n    <br>\n    \n    <h2>Rio de Janeiro, Brazil</h2>\n    \n    <img src=\"Brazil.jpg\">\n    \n    <p>Photo by Joe Carey from FreeImages</p>\n  </body>\n</html>",
