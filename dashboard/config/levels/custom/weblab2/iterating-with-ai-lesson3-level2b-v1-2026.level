      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Speed Boost Runner</title>\n\n  <!-- Pixel art font from Google Fonts -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap\" rel=\"stylesheet\">\n\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n  <div id=\"game-container\">\n\n    <!-- Title bar above the canvas -->\n    <div id=\"title-bar\">&#9889; SPEED BOOST RUNNER</div>\n\n    <!-- Canvas wrapper holds the canvas and the result overlay -->\n    <div id=\"canvas-wrapper\">\n      <canvas id=\"game-canvas\" width=\"800\" height=\"400\"></canvas>\n\n      <!-- Result overlay — hidden until the animation finishes -->\n      <div id=\"result-overlay\" class=\"hidden\"></div>\n    </div>\n\n  </div>\n\n  <!-- helpers.js must load first — it defines applyBoost, showResult, etc.\n       It also fetches and evals script.js on page load. -->\n  <script src=\"helpers.js\"></script>\n\n\n</body>\n</html>\n",
          "active": false,
          "folderId": "0",
          "type": "support"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "*, *::before, *::after {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  background-color: #04060d;\n  color: #e8faff;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 100vh;\n  font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  padding: 16px;\n}\n\n#game-container {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0;\n  width: 100%;\n  max-width: 800px;\n}\n\n#title-bar {\n  background: #0a0f1a;\n  color: #00dcff;\n  font-family: 'Press Start 2P', monospace;\n  font-size: clamp(10px, 2.4vw, 14px);\n  letter-spacing: 2px;\n  line-height: 1.5;\n  padding: 12px 16px;\n  border: 2px solid #00dcff;\n  border-bottom: none;\n  text-shadow: 0 0 10px rgba(0, 220, 255, 0.8);\n  width: 100%;\n  text-align: center;\n}\n\n#canvas-wrapper {\n  position: relative;\n  width: 100%;\n  aspect-ratio: 2 / 1;\n}\n\n#game-canvas {\n  display: block;\n  width: 100%;\n  height: 100%;\n  border: 2px solid #00dcff;\n  box-shadow:\n    0 0 40px rgba(0, 200, 255, 0.5),\n    0 0 80px rgba(0, 200, 255, 0.2),\n    inset 0 0 30px rgba(0, 0, 0, 0.8);\n  background: #0a0f1a;\n  image-rendering: pixelated;\n  image-rendering: crisp-edges;\n}\n\n#result-overlay {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 16px;\n  text-align: center;\n  padding: 24px;\n  border: 2px solid #00dcff;\n}\n\n#result-overlay.hidden {\n  display: none;\n}\n\n#result-overlay.overload {\n  background: rgba(30, 0, 0, 0.92);\n  border-color: #ff2222;\n  box-shadow: 0 0 40px rgba(255, 30, 30, 0.5);\n}\n\n#result-overlay.clean {\n  background: rgba(0, 20, 30, 0.92);\n  border-color: #00dcff;\n  box-shadow: 0 0 40px rgba(0, 220, 255, 0.5);\n}\n\n.overlay-icon {\n  font-size: clamp(32px, 7vw, 52px);\n  line-height: 1;\n}\n\n.overlay-title {\n  font-family: 'Press Start 2P', monospace;\n  font-size: clamp(12px, 3vw, 22px);\n  letter-spacing: 2px;\n  line-height: 1.5;\n}\n\n.overload .overlay-title {\n  color: #ff4444;\n  text-shadow: 0 0 12px rgba(255, 60, 60, 0.9);\n  animation: glitch 0.4s infinite;\n}\n\n.clean .overlay-title {\n  color: #00dcff;\n  text-shadow: 0 0 12px rgba(0, 220, 255, 0.9);\n}\n\n.overlay-subtitle {\n  font-size: clamp(14px, 3vw, 18px);\n  line-height: 1.5;\n  max-width: 520px;\n}\n\n.overload .overlay-subtitle {\n  color: #ffaaaa;\n}\n\n.clean .overlay-subtitle {\n  color: #aaeeff;\n}\n\n.overlay-stat {\n  font-size: clamp(14px, 2.8vw, 17px);\n  font-weight: 700;\n  letter-spacing: 0.5px;\n  margin-top: 4px;\n}\n\n.overload .overlay-stat {\n  color: #ff8888;\n}\n\n.clean .overlay-stat {\n  color: #00ffcc;\n}\n\n.play-again-btn {\n  margin-top: 8px;\n  padding: 12px 24px;\n  min-height: 44px;\n  font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  font-size: clamp(14px, 3vw, 17px);\n  font-weight: 700;\n  cursor: pointer;\n  border: none;\n  border-radius: 6px;\n  letter-spacing: 0.5px;\n  transition: transform 0.1s ease, box-shadow 0.1s ease, filter 0.1s ease;\n}\n\n.overload .play-again-btn {\n  background: #ff2222;\n  color: #ffffff;\n  box-shadow: 0 0 14px rgba(255, 30, 30, 0.6);\n}\n\n.clean .play-again-btn {\n  background: #00dcff;\n  color: #0a0f1a;\n  box-shadow: 0 0 14px rgba(0, 220, 255, 0.6);\n}\n\n.play-again-btn:hover {\n  transform: scale(1.05);\n  filter: brightness(1.1);\n}\n\n.play-again-btn:focus-visible {\n  outline: 3px solid #ffffff;\n  outline-offset: 4px;\n}\n\n@keyframes glitch {\n  0%   { text-shadow: 0 0 12px rgba(255,60,60,0.9), -2px 0 #ff0000; }\n  25%  { text-shadow: 2px 0 12px rgba(255,60,60,0.9),  2px 0 #ff0000; }\n  50%  { text-shadow: 0 0 12px rgba(255,60,60,0.9), -2px 0 #ff6600; }\n  75%  { text-shadow: 2px 0 12px rgba(255,60,60,0.9),  0px 0 #ff0000; }\n  100% { text-shadow: 0 0 12px rgba(255,60,60,0.9), -2px 0 #ff0000; }\n}\n\n@media (max-width: 500px) {\n  body {\n    padding: 8px;\n    align-items: flex-start;\n  }\n\n  #title-bar {\n    font-size: 10px;\n    letter-spacing: 1px;\n    padding: 10px 8px;\n  }\n\n  #result-overlay {\n    gap: 10px;\n    padding: 16px;\n  }\n\n  .overlay-title {\n    font-size: 12px;\n    letter-spacing: 1px;\n  }\n\n  .overlay-subtitle,\n  .overlay-stat,\n  .play-again-btn {\n    font-size: 14px;\n  }\n\n  .play-again-btn {\n    padding: 10px 18px;\n  }\n}",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
        "3": {
          "id": "3",
          "name": "helpers.js",
          "contents": "/*\n  helpers.js — Speed Boost Runner Game Engine\n  ============================================\n  This file does everything except the student's while-loop logic:\n    - Defines the Canvas and all pixel-art sprites\n    - Runs the background scrolling city scene\n    - Provides applyBoost() and showResult() for student code to call\n    - Collects game events and animates them one-by-one\n    - Bootstraps by fetching + eval-ing script.js on page load\n\n  Students do NOT edit this file.\n*/\n\n// ============================================================\n// === SECTION 1: Canvas Setup\n// ============================================================\n\nconst canvas = document.getElementById('game-canvas');\nconst ctx = canvas.getContext('2d');\n\n// Scale factor — each pixel in our sprite arrays becomes SCALE×SCALE canvas pixels\nconst SCALE = 3;\n\n// Ground line Y position (pixels from top of canvas)\nconst GROUND_Y = 320;\n\n// Player's fixed horizontal position on screen\nconst PLAYER_X = 180;\n\n// Player's vertical position — feet land on the ground line\n// Player sprite is 16 pixels tall * SCALE = 48 canvas px\nconst PLAYER_Y = GROUND_Y - 16 * SCALE;\n\n\n// ============================================================\n// === SECTION 2: Pixel-Art Sprite Definitions\n// ============================================================\n// Each sprite is a 2D array of color strings.\n// '.' means transparent (skip drawing that pixel).\n// Colors are plain CSS hex strings.\n\n// --- Player sprite, Frame 0: right leg forward, left leg back ---\nconst PLAYER_FRAME_0 = [\n  ['.','#1a1a2e','#1a1a2e','#1a1a2e','#1a1a2e','#1a1a2e','#1a1a2e','.','.','.'],\n  ['.','#1a1a2e','#2d2d4a','#2d2d4a','#2d2d4a','#2d2d4a','#1a1a2e','.','.','.'],\n  ['.','#1a1a2e','#e8c98a','#e8c98a','#e8c98a','#e8c98a','#1a1a2e','.','.','.'],\n  ['.','.',  '#e8c98a','#e8c98a','#e8c98a','#e8c98a','.','.','.', '.'],\n  ['#00b4cc','#00b4cc','#00b4cc','#00b4cc','#00b4cc','#00b4cc','#00b4cc','.','.', '.'],\n  ['.','#00b4cc','#00b4cc','#00b4cc','#00b4cc','#00b4cc','.','#00b4cc','.','.'],\n  ['.','#009ab0','#009ab0','#009ab0','#009ab0','#009ab0','.','.','.', '.'],\n  ['.','#007a8c','#007a8c','#007a8c','#007a8c','#007a8c','.','.','.', '.'],\n  ['.','.','#00dcff','#00dcff','.','.','.','#005566','.','.'],\n  ['.','.','#00dcff','.','.','.','.','.','.', '.'],\n  ['.','.','.','#00dcff','.','.','.','.','.','.'],\n  ['.','.','.','#00dcff','.','.','.','#003344','.','.'],\n  ['.','.','.','.','#00b4cc','.','.','.','.', '.'],\n  ['.','.','.','.','#00b4cc','.','.','.','.','.'],\n  ['.','.','.','.','.','#ffffff','#ffffff','.','.', '.'],\n  ['.','.','.','.','.','.','#ffffff','#ffffff','.', '.'],\n];\n\n// --- Player sprite, Frame 1: left leg forward, right leg back ---\nconst PLAYER_FRAME_1 = [\n  ['.','#1a1a2e','#1a1a2e','#1a1a2e','#1a1a2e','#1a1a2e','#1a1a2e','.','.','.'],\n  ['.','#1a1a2e','#2d2d4a','#2d2d4a','#2d2d4a','#2d2d4a','#1a1a2e','.','.','.'],\n  ['.','#1a1a2e','#e8c98a','#e8c98a','#e8c98a','#e8c98a','#1a1a2e','.','.','.'],\n  ['.','.',  '#e8c98a','#e8c98a','#e8c98a','#e8c98a','.','.','.', '.'],\n  ['.','.','.','.','.','.','#00b4cc','#00b4cc','#00b4cc','.'],\n  ['.','#00b4cc','#00b4cc','#00b4cc','#00b4cc','#00b4cc','#00b4cc','.','.','.'],\n  ['.','#009ab0','#009ab0','#009ab0','#009ab0','#009ab0','.','.','.', '.'],\n  ['.','#007a8c','#007a8c','#007a8c','#007a8c','#007a8c','.','.','.', '.'],\n  ['.','#005566','.','.','.','.','#00dcff','#00dcff','.','.'],\n  ['.','.','.','.','.','.','.','#00dcff','.','.'],\n  ['.','.','.','.','.','.','#00dcff','.','.','.'],\n  ['.','#003344','.','.','.','.','#00dcff','.','.','.'],\n  ['.','.','.','#00b4cc','.','.','.','.','.','.'],\n  ['.','.','.','.','#00b4cc','.','.','.','.','.'],\n  ['.','.','.','.','.','#ffffff','#ffffff','.','.', '.'],\n  ['.','.','.','.','.','.','#ffffff','#ffffff','.', '.'],\n];\n\n// --- Lightning bolt power-up icon ---\nconst BOLT_SPRITE = [\n  ['.', '.', '.', '#ffe800', '#ffe800', '.', '.', '.'],\n  ['.', '.', '#ffe800', '#ffe800', '#ffcc00', '.', '.', '.'],\n  ['.', '#ffe800', '#ffe800', '#ffcc00', '.', '.', '.', '.'],\n  ['#ffe800', '#ffe800', '#ffaa00', '#ffaa00', '#ffe800', '#ffe800', '.', '.'],\n  ['.', '.', '.', '#ffe800', '#ffe800', '#ffcc00', '#ffe800', '.'],\n  ['.', '.', '.', '.', '#ffcc00', '#ffe800', '.', '.'],\n  ['.', '.', '.', '.', '.', '#ffe800', '.', '.'],\n  ['.', '.', '.', '.', '.', '#ffaa00', '.', '.'],\n];\n\n\n// ============================================================\n// === SECTION 3: Game State Variables\n// ============================================================\n\nlet iterationCount = 0;\nlet safetyCapHit = false;\nlet gameEvents = [];\nlet studentCodeSource = '';\n\nlet bgScrollX = 0;\nlet canvasLoopId = null;\nlet canvasFrame = 0;\nlet walkFrame = 0;\n\nlet isBoosted = false;\nlet auraIntensity = 0;\n\nlet playerJumpOffset = 0;\nlet playerJumping = false;\nlet jumpVelocity = 0;\n\nlet particles = [];\n\nlet eventIndex = 0;\nlet playbackInterval = null;\n\nlet hudTimerValue = 5;\nlet hudTimerStart = 5;\nlet hudTick = 0;\n\n\n// ============================================================\n// === SECTION 4: Sprite Drawing Utility\n// ============================================================\n\nconst drawSprite = (sprite, x, y) => {\n  for (let row = 0; row < sprite.length; row++) {\n    for (let col = 0; col < sprite[row].length; col++) {\n      const color = sprite[row][col];\n\n      if (color !== '.') {\n        ctx.fillStyle = color;\n        ctx.fillRect(\n          x + col * SCALE,\n          y + row * SCALE,\n          SCALE,\n          SCALE\n        );\n      }\n    }\n  }\n};\n\n\n// ============================================================\n// === SECTION 5: Background — Scrolling City Skyline\n// ============================================================\n\nconst buildCityProfile = () => {\n  const buildings = [];\n  const widths = [28, 20, 36, 16, 44, 24, 32, 18, 40, 22, 30, 26, 38, 14, 42];\n  const heights = [90, 140, 60, 180, 80, 120, 50, 160, 70, 100, 130, 55, 110, 150, 75];\n\n  let x = 0;\n\n  for (let i = 0; i < widths.length; i++) {\n    buildings.push({ x: x, w: widths[i], h: heights[i] });\n    x += widths[i] + 4;\n  }\n\n  return buildings;\n};\n\nconst CITY_BUILDINGS = buildCityProfile();\n\nconst totalCityWidth = CITY_BUILDINGS.reduce((sum, b) => sum + b.w + 4, 0);\n\nconst drawBackground = (scrollSpeed) => {\n  ctx.fillStyle = '#0a0f1a';\n  ctx.fillRect(0, 0, canvas.width, canvas.height);\n\n  bgScrollX = (bgScrollX + scrollSpeed) % totalCityWidth;\n\n  for (let copy = 0; copy < 3; copy++) {\n    const offsetX = copy * totalCityWidth - bgScrollX;\n\n    for (const b of CITY_BUILDINGS) {\n      const shade = (CITY_BUILDINGS.indexOf(b) % 2 === 0) ? '#0d1428' : '#111832';\n\n      ctx.fillStyle = shade;\n      ctx.fillRect(\n        offsetX + b.x,\n        GROUND_Y - b.h,\n        b.w,\n        b.h\n      );\n\n      ctx.fillStyle = '#1e2d55';\n      for (let wy = 8; wy < b.h - 8; wy += 18) {\n        for (let wx = 4; wx < b.w - 4; wx += 10) {\n          if ((b.x + wx + wy) % 3 !== 0) {\n            ctx.fillRect(offsetX + b.x + wx, GROUND_Y - b.h + wy, 4, 4);\n          }\n        }\n      }\n    }\n  }\n\n  const groundGlow = ctx.createLinearGradient(0, GROUND_Y - 2, 0, GROUND_Y + 12);\n  groundGlow.addColorStop(0, 'rgba(0, 220, 255, 0.35)');\n  groundGlow.addColorStop(0.4, 'rgba(0, 180, 220, 0.12)');\n  groundGlow.addColorStop(1, 'rgba(0, 0, 0, 0)');\n\n  ctx.fillStyle = groundGlow;\n  ctx.fillRect(0, GROUND_Y - 2, canvas.width, 14);\n\n  ctx.strokeStyle = '#00dcff';\n  ctx.lineWidth = 2;\n  ctx.beginPath();\n  ctx.moveTo(0, GROUND_Y);\n  ctx.lineTo(canvas.width, GROUND_Y);\n  ctx.stroke();\n};\n\n\n// ============================================================\n// === SECTION 6: Speed Lines\n// ============================================================\n\nconst drawSpeedLines = (intensity) => {\n  const numLines = Math.min(3 + Math.floor(intensity * 0.5), 22);\n  const playerCenterY = PLAYER_Y + (16 * SCALE) / 2;\n  const halfH = (16 * SCALE) / 2;\n\n  for (let i = 0; i < numLines; i++) {\n    const lineY = playerCenterY - halfH + Math.random() * (halfH * 2);\n    const lineLen = 20 + Math.random() * (30 + intensity * 3);\n    const alpha = 0.3 + Math.random() * 0.5;\n\n    const grad = ctx.createLinearGradient(\n      PLAYER_X - lineLen, lineY,\n      PLAYER_X, lineY\n    );\n\n    grad.addColorStop(0, `rgba(255, 100, 0, 0)`);\n    grad.addColorStop(0.6, `rgba(255, 180, 0, ${alpha * 0.6})`);\n    grad.addColorStop(1, `rgba(255, 220, 0, ${alpha})`);\n\n    ctx.strokeStyle = grad;\n    ctx.lineWidth = 1 + Math.random() * 2;\n    ctx.beginPath();\n    ctx.moveTo(PLAYER_X - lineLen, lineY);\n    ctx.lineTo(PLAYER_X, lineY);\n    ctx.stroke();\n  }\n};\n\n\n// ============================================================\n// === SECTION 7: Speed Aura\n// ============================================================\n\nconst drawAura = (intensity) => {\n  const cx = PLAYER_X + (9 * SCALE) / 2;\n  const cy = PLAYER_Y + (16 * SCALE) / 2;\n\n  const pulse = Math.sin(canvasFrame * 0.18) * 6;\n  const baseRadius = 48 + pulse;\n  const extraRadius = Math.min(intensity * 4, 160);\n  const radius = baseRadius + extraRadius;\n\n  const alpha = Math.min(0.18 + intensity * 0.012, 0.7);\n\n  const grad = ctx.createRadialGradient(cx, cy, 4, cx, cy, radius);\n  grad.addColorStop(0, `rgba(0, 220, 255, ${alpha})`);\n  grad.addColorStop(0.4, `rgba(0, 180, 220, ${alpha * 0.5})`);\n  grad.addColorStop(1, 'rgba(0, 0, 0, 0)');\n\n  ctx.fillStyle = grad;\n  ctx.beginPath();\n  ctx.arc(cx, cy, radius, 0, Math.PI * 2);\n  ctx.fill();\n\n  if (intensity > 60) {\n    const warnAlpha = Math.min((intensity - 60) * 0.005, 0.4);\n    const warnGrad = ctx.createRadialGradient(cx, cy, radius * 0.7, cx, cy, radius * 1.6);\n\n    warnGrad.addColorStop(0, `rgba(255, 100, 0, ${warnAlpha})`);\n    warnGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');\n\n    ctx.fillStyle = warnGrad;\n    ctx.beginPath();\n    ctx.arc(cx, cy, radius * 1.6, 0, Math.PI * 2);\n    ctx.fill();\n  }\n};\n\n// ============================================================\n// === SECTION 8: HUD — Heads-Up Display\n// ============================================================\n\nconst drawHUD = (timerValue, timerStart, tick) => {\n  const hudY = 14;\n\n  const boltX = 16;\n  const boltY = 8;\n  const BSCALE = 2;\n\n  for (let row = 0; row < BOLT_SPRITE.length; row++) {\n    for (let col = 0; col < BOLT_SPRITE[row].length; col++) {\n      const color = BOLT_SPRITE[row][col];\n\n      if (color !== '.') {\n        ctx.fillStyle = color;\n        ctx.fillRect(boltX + col * BSCALE, boltY + row * BSCALE, BSCALE, BSCALE);\n      }\n    }\n  }\n\n  ctx.font = '16px monospace';\n  ctx.fillStyle = '#00dcff';\n  ctx.textBaseline = 'middle';\n  ctx.fillText('SPEED BOOST', 36, hudY);\n\n  const barX = 170;\n  const barY = hudY - 6;\n  const barW = 120;\n  const barH = 12;\n  const filledRatio = Math.min(timerValue / timerStart, 2.5);\n\n  ctx.fillStyle = '#1a2a3a';\n  ctx.fillRect(barX, barY, barW, barH);\n\n  let barColor;\n  if (timerValue > timerStart) {\n    const overRatio = (timerValue - timerStart) / timerStart;\n\n    if (overRatio < 0.5) {\n      barColor = '#ff8800';\n    } else if (overRatio < 1.5) {\n      barColor = '#ff4400';\n    } else {\n      barColor = '#ff1111';\n    }\n  } else {\n    barColor = '#00dcff';\n  }\n\n  const fillW = Math.min(filledRatio * barW, barW);\n\n  ctx.fillStyle = barColor;\n  ctx.fillRect(barX, barY, fillW, barH);\n\n  ctx.strokeStyle = '#336688';\n  ctx.lineWidth = 1;\n  ctx.strokeRect(barX, barY, barW, barH);\n\n  ctx.font = '16px monospace';\n  ctx.fillStyle = '#ffffff';\n  ctx.fillText(`${timerValue} / ${timerStart}`, barX + barW + 8, hudY);\n\n  ctx.font = '16px monospace';\n  ctx.fillStyle = '#aaffee';\n  ctx.textAlign = 'right';\n  ctx.fillText(`TICK: ${tick}`, canvas.width - 16, hudY);\n  ctx.textAlign = 'left';\n};\n\n\n// ============================================================\n// === SECTION 9: Celebration Particles\n// ============================================================\n\nconst spawnParticles = () => {\n  const cx = PLAYER_X + (9 * SCALE) / 2;\n  const cy = PLAYER_Y;\n  const colors = ['#00dcff', '#ffe800', '#ff6ec7', '#00ffaa', '#ffffff'];\n\n  for (let i = 0; i < 20; i++) {\n    const angle = Math.random() * Math.PI * 2;\n    const speed = 2 + Math.random() * 4;\n\n    particles.push({\n      x: cx,\n      y: cy,\n      vx: Math.cos(angle) * speed,\n      vy: Math.sin(angle) * speed - 3,\n      color: colors[Math.floor(Math.random() * colors.length)],\n      life: 1.0,\n    });\n  }\n};\n\nconst updateAndDrawParticles = () => {\n  particles = particles.filter((p) => p.life > 0);\n\n  for (const p of particles) {\n    p.x += p.vx;\n    p.y += p.vy;\n    p.vy += 0.18;\n    p.life -= 0.025;\n\n    ctx.globalAlpha = Math.max(0, p.life);\n    ctx.fillStyle = p.color;\n    ctx.fillRect(p.x - 2, p.y - 2, 4, 4);\n  }\n\n  ctx.globalAlpha = 1;\n};\n\n\n// ============================================================\n// === SECTION 10: Main Canvas Render Loop\n// ============================================================\n\nconst renderFrame = () => {\n  canvasFrame++;\n\n  const scrollSpeed = isBoosted ? Math.min(2 + auraIntensity * 0.05, 12) : 0.5;\n\n  drawBackground(scrollSpeed);\n\n  if (isBoosted) {\n    drawSpeedLines(auraIntensity);\n    drawAura(auraIntensity);\n  }\n\n  const cycleTicks = isBoosted ? 3 : 6;\n  if (canvasFrame % cycleTicks === 0) {\n    walkFrame = 1 - walkFrame;\n  }\n\n  let jumpY = 0;\n  if (playerJumping) {\n    jumpVelocity += 0.6;\n    playerJumpOffset += jumpVelocity;\n    jumpY = Math.min(playerJumpOffset, 0);\n\n    if (playerJumpOffset >= 0) {\n      playerJumping = false;\n      playerJumpOffset = 0;\n    }\n  }\n\n  const frame = walkFrame === 0 ? PLAYER_FRAME_0 : PLAYER_FRAME_1;\n  drawSprite(frame, PLAYER_X, PLAYER_Y + jumpY);\n\n  if (particles.length > 0) {\n    updateAndDrawParticles();\n  }\n\n  drawHUD(hudTimerValue, hudTimerStart, hudTick);\n\n  canvasLoopId = requestAnimationFrame(renderFrame);\n};\n\nconst startCanvasLoop = () => {\n  if (canvasLoopId) {\n    cancelAnimationFrame(canvasLoopId);\n  }\n\n  canvasLoopId = requestAnimationFrame(renderFrame);\n};\n\nconst stopCanvasLoop = () => {\n  if (canvasLoopId) {\n    cancelAnimationFrame(canvasLoopId);\n    canvasLoopId = null;\n  }\n};\n\n\n// ============================================================\n// === SECTION 11: Event Queue — applyBoost & showResult\n// ============================================================\n\nconst applyBoost = (tick) => {\n  iterationCount++;\n\n  if (iterationCount > 200) {\n    safetyCapHit = true;\n    window.powerUpTimer = -1;\n    return;\n  }\n\n  gameEvents.push({\n    type: 'boost',\n    tick: tick,\n    timerValue: window.powerUpTimer,\n  });\n\n  console.log(`[applyBoost] tick=${tick}, powerUpTimer=${window.powerUpTimer}, iterationCount=${iterationCount}`);\n};\n\nconst showResult = (tick) => {\n  gameEvents.push({\n    type: 'result',\n    tick: tick,\n    safetyCapHit: safetyCapHit,\n  });\n\n  console.log(`[showResult] total ticks=${tick}, safetyCapHit=${safetyCapHit}`);\n\n  animateEvents();\n};\n\n\n// Make these available to the fetched/evaled student code.\nwindow.applyBoost = applyBoost;\nwindow.showResult = showResult;\n\n\n// ============================================================\n// === SECTION 12: Event Playback — animateEvents\n// ============================================================\n\nconst animateEvents = () => {\n  eventIndex = 0;\n  isBoosted = true;\n\n  if (gameEvents.length > 0 && gameEvents[0].type === 'boost') {\n    hudTimerStart = 5;\n    hudTimerValue = gameEvents[0].timerValue;\n  }\n\n  playbackInterval = setInterval(() => {\n    if (eventIndex >= gameEvents.length) {\n      clearInterval(playbackInterval);\n      return;\n    }\n\n    const event = gameEvents[eventIndex];\n    eventIndex++;\n\n    if (event.type === 'boost') {\n      hudTimerValue = event.timerValue;\n      hudTick = event.tick;\n      auraIntensity = event.tick;\n\n      console.log(`[animateEvents] boost event: tick=${event.tick}, timerValue=${event.timerValue}`);\n\n    } else if (event.type === 'result') {\n      isBoosted = false;\n      auraIntensity = 0;\n\n      setTimeout(() => {\n        showResultOverlay(event.tick, event.safetyCapHit);\n      }, 300);\n    }\n  }, 100);\n};\n\n// ============================================================\n// === SECTION 13: Result Overlay\n// ============================================================\n\nconst showResultOverlay = (tick, capHit) => {\n  const overlay = document.getElementById('result-overlay');\n  overlay.innerHTML = '';\n\n  if (capHit) {\n    overlay.className = 'overload';\n\n    overlay.innerHTML = `\n      <div class=\"overlay-icon\">&#9889;</div>\n      <div class=\"overlay-title\">BOOST OVERLOAD</div>\n      <div class=\"overlay-subtitle\">The timer never reached zero.</div>\n      <div class=\"overlay-stat\">200 TICKS ELAPSED</div>\n      <button class=\"play-again-btn\" onclick=\"runGame()\">PLAY AGAIN</button>\n    `;\n\n    console.log('[result] overload — bug was not fixed');\n\n  } else {\n    overlay.className = 'clean';\n\n    overlay.innerHTML = `\n      <div class=\"overlay-icon\">&#9889;</div>\n      <div class=\"overlay-title\">BOOST EXPIRED</div>\n      <div class=\"overlay-subtitle\">You ran for ${tick} ticks!</div>\n      <div class=\"overlay-stat\">BOOST COMPLETE</div>\n      <button class=\"play-again-btn\" onclick=\"runGame()\">PLAY AGAIN</button>\n    `;\n\n    playerJumping = true;\n    playerJumpOffset = 0;\n    jumpVelocity = -10;\n    spawnParticles();\n\n    console.log('[result] clean exit — bug was fixed, ticks=' + tick);\n  }\n\n  overlay.classList.remove('hidden');\n};\n\n\n// ============================================================\n// === SECTION 14: Reset — runGame()\n// ============================================================\n\nconst resetGameState = () => {\n  iterationCount = 0;\n  safetyCapHit = false;\n  gameEvents = [];\n  bgScrollX = 0;\n  canvasFrame = 0;\n  walkFrame = 0;\n  isBoosted = false;\n  auraIntensity = 0;\n  playerJumpOffset = 0;\n  playerJumping = false;\n  jumpVelocity = 0;\n  particles = [];\n  eventIndex = 0;\n  hudTimerValue = 5;\n  hudTimerStart = 5;\n  hudTick = 0;\n\n  if (playbackInterval) {\n    clearInterval(playbackInterval);\n    playbackInterval = null;\n  }\n\n  const overlay = document.getElementById('result-overlay');\n  overlay.className = 'hidden';\n  overlay.innerHTML = '';\n\n  delete window.powerUpTimer;\n  delete window.tick;\n\n  console.log('[runGame] state reset');\n};\n\nconst runGame = () => {\n  resetGameState();\n\n  console.log('[runGame] Re-fetching script.js to pick up any edits...');\n\n  fetch('script.js?t=' + Date.now())\n    .then((response) => {\n      if (!response.ok) {\n        throw new Error('Could not reload script.js: ' + response.status);\n      }\n\n      return response.text();\n    })\n    .then((source) => {\n      studentCodeSource = source;\n\n      const executableCode = source\n        .replace(/\\blet\\s+/g, '')\n        .replace(/\\bconst\\s+/g, '');\n\n      console.log('[runGame] script.js reloaded, running student code');\n\n      try {\n        // Indirect eval: runs in global scope so bare variable\n        // assignments become window globals.\n        // eslint-disable-next-line no-eval\n        (0, eval)(executableCode);\n      } catch (err) {\n        console.error('[runGame] Error in student code:', err);\n      }\n    })\n    .catch((err) => {\n      console.error('[runGame] Failed to reload script.js:', err);\n    });\n};\n\n// Make this available to inline Play Again buttons.\nwindow.runGame = runGame;\n\n\n// ============================================================\n// === SECTION 15: Bootstrap — fetch script.js on page load\n// ============================================================\n\nwindow.addEventListener('load', () => {\n  console.log('[bootstrap] Page loaded — starting canvas loop and fetching script.js');\n\n  startCanvasLoop();\n\n  fetch('script.js?t=' + Date.now())\n    .then((response) => {\n      if (!response.ok) {\n        throw new Error('Could not load script.js: ' + response.status);\n      }\n\n      return response.text();\n    })\n    .then((source) => {\n      studentCodeSource = source;\n\n      console.log('[bootstrap] script.js loaded, eval-ing student code');\n\n      const executableCode = source\n        .replace(/\\blet\\s+/g, '')\n        .replace(/\\bconst\\s+/g, '');\n\n      // Indirect eval: runs in global scope so bare variable\n      // assignments become window globals.\n      // eslint-disable-next-line no-eval\n      (0, eval)(executableCode);\n    })\n    .catch((err) => {\n      console.error('[bootstrap] Failed to load script.js:', err);\n    });\n});",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
        "4": {
          "id": "4",
          "name": "script.js",
          "contents": "// Player grabbed a Speed Boost! The boost lasts while the timer is above 0.\nlet powerUpTimer = 5;\nlet tick = 0;\n\nwhile (powerUpTimer > 0) {\n    tick++;\n    applyBoost(tick);\n    powerUpTimer = powerUpTimer + 1;  // updates the timer each tick\n}\n\nshowResult(tick);\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "4"
      ]
    },
