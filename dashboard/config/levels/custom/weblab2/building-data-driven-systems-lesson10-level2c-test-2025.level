      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>SocialStream: Ad Transparency</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <div class=\"app-container\">\n    <header class=\"feed-header\">\n      <div class=\"header-content\">\n        <h1>SocialStream</h1>\n        <div id=\"user-profile\">\n          <span id=\"username-display\">Loading...</span>\n        </div>\n      </div>\n      <button id=\"run-pipeline-btn\">Run Ad Algorithm</button>\n    </header>\n    \n    <main id=\"feed-container\">\n      </main>\n  </div>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "//  Datasets\n//  currentUser schema: name, age, interests\nconst currentUser = {\n  name: \"Javier\",\n  age: 18,\n  interests: [\"gaming\", \"tech\", \"travel\"]\n};\n\n//  adDatabase schema: id, brand, text, tags, minAge, bid, quality\nconst adDatabase = [\n  { id: 1, brand: \"RetroArcade\", text: \"Classic gaming console!\", tags: ['gaming'], minAge: 10, bid: 12.38, quality: 10 },\n  { id: 2, brand: \"RetirementPros\", text: \"Secure your future.\", tags: ['finance'], minAge: 55, bid: 3.37, quality: 10 },\n  { id: 3, brand: \"TechWeekly\", text: \"Latest gadget reviews.\", tags: ['tech', 'news'], minAge: 18, bid: 12.63, quality: 9 },\n  { id: 4, brand: \"SodaPop\", text: \"Fizzy happiness.\", tags: ['food'], minAge: 5, bid: 13.22, quality: 7 },\n  { id: 5, brand: \"TravelBug\", text: \"Flights to Tokyo 50% off.\", tags: ['travel'], minAge: 18, bid: 6.59, quality: 3 },\n  { id: 6, brand: \"KidToys\", text: \"Building blocks for tots.\", tags: ['kids'], minAge: 2, bid: 12.67, quality: 9 },\n  { id: 7, brand: \"CryptoKing\", text: \"Invest in unsure things.\", tags: ['finance'], minAge: 21, bid: 5.46, quality: 5 },\n  { id: 8, brand: \"GamerChair\", text: \"Sit like a pro.\", tags: ['gaming'], minAge: 16, bid: 12.79, quality: 1 },\n  { id: 9, brand: \"FashionNova\", text: \"Trendy summer looks.\", tags: ['fashion'], minAge: 13, bid: 2.14, quality: 10 },\n  { id: 10, brand: \"HealthyLife\", text: \"Vitamins for seniors.\", tags: ['health'], minAge: 60, bid: 2.31, quality: 8 },\n  { id: 11, brand: \"SportySpice\", text: \"Soccer gear sale.\", tags: ['sports'], minAge: 10, bid: 10.79, quality: 5 },\n  { id: 12, brand: \"MusicBox\", text: \"Stream millions of songs.\", tags: ['music'], minAge: 13, bid: 6.62, quality: 9 },\n  { id: 13, brand: \"News24\", text: \"Breaking world news.\", tags: ['news'], minAge: 18, bid: 8.0, quality: 3 },\n  { id: 14, brand: \"BurgerKing\", text: \"Double cheese delight.\", tags: ['food'], minAge: 5, bid: 9.65, quality: 7 },\n  { id: 15, brand: \"TravelLite\", text: \"Backpacks for hiking.\", tags: ['travel', 'sports'], minAge: 18, bid: 9.7, quality: 9 },\n  { id: 16, brand: \"CodeAcademy\", text: \"Learn JS today.\", tags: ['tech'], minAge: 13, bid: 9.98, quality: 9 },\n  { id: 17, brand: \"BabySteps\", text: \"Soft shoes for walking.\", tags: ['kids'], minAge: 1, bid: 3.68, quality: 1 },\n  { id: 18, brand: \"MortgageHelp\", text: \"Low rates for homeowners.\", tags: ['finance'], minAge: 30, bid: 4.75, quality: 7 },\n  { id: 19, brand: \"VR_World\", text: \"Immersive virtual reality.\", tags: ['tech', 'gaming'], minAge: 16, bid: 10.4, quality: 7 },\n  { id: 20, brand: \"CruiseLine\", text: \"7-day Caribbean cruise.\", tags: ['travel'], minAge: 25, bid: 9.97, quality: 8 },\n  { id: 21, brand: \"DiaperGenie\", text: \"Odor-free disposal.\", tags: ['kids'], minAge: 18, bid: 6.27, quality: 8 },\n  { id: 22, brand: \"ProGolf\", text: \"Clubs for professionals.\", tags: ['sports'], minAge: 25, bid: 5.55, quality: 8 },\n  { id: 23, brand: \"VeganTreats\", text: \"Plant-based snacks.\", tags: ['food', 'health'], minAge: 10, bid: 3.54, quality: 6 },\n  { id: 24, brand: \"SeniorLiving\", text: \"Comfortable communities.\", tags: ['health'], minAge: 65, bid: 14.36, quality: 3 },\n  { id: 25, brand: \"IndieGame\", text: \"Support indie devs.\", tags: ['gaming'], minAge: 13, bid: 2.2, quality: 9 },\n  { id: 26, brand: \"AutoTrader\", text: \"Best used cars.\", tags: ['tech'], minAge: 20, bid: 7.67, quality: 8 },\n  { id: 27, brand: \"PetLover\", text: \"Organic dog food.\", tags: ['food'], minAge: 18, bid: 10.86, quality: 4 },\n  { id: 28, brand: \"GuitarHero\", text: \"Learn to shred.\", tags: ['music', 'gaming'], minAge: 12, bid: 14.9, quality: 7 },\n  { id: 29, brand: \"WallStreet\", text: \"Stock market tips.\", tags: ['finance'], minAge: 21, bid: 14.25, quality: 9 }\n];\n\n// --- DOM ELEMENTS ---\nconst feed = document.getElementById(\"feed-container\");\nconst userDisplay = document.getElementById(\"username-display\");\nconst runBtn = document.getElementById(\"run-pipeline-btn\");\n\nuserDisplay.textContent = `${currentUser.name} (Age: ${currentUser.age})`;\n\n// Render Cards\nconst renderFeed = (ads) => {\n  const cardHTML = ads.map(ad => `\n    <article class=\"ad-card\">\n      <div class=\"ad-badge\">Sponsored</div>\n      <h3>${ad.brand}</h3>\n      <p>${ad.text}</p>\n      <div class=\"debug-info\">\n        <span>Bid: $${ad.bid.toFixed(2)}</span> | \n        <span>Quality: ${ad.quality}</span> | \n        <span>Min Age: ${ad.minAge}</span>\n      </div>\n    </article>\n  `).join(\"\");\n  \n  feed.innerHTML = cardHTML;\n};\n\n// Initial Render\nrenderFeed(adDatabase);\n\n// 1. FILTER\n\n\n// 2. SORT\n\n\n// 3. PIPELINE\nrunBtn.addEventListener(\"click\", runAdPipeline);\nconst runAdPipeline = () => {\n\n  \n};\n\n",
