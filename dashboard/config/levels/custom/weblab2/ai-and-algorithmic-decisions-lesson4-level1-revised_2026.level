  "properties": {
    "encrypted": "false",
    "long_instructions": "### **Predict & Trace**\r\n\r\n#### **Do This:**\r\n\r\n1. Look at the JavaScript code in `script.js`. In the box below, write what you think will happen when you click the **Increase Volume** button.\r\n\r\n2. Click the **Increase Volume** button. Did the result match your prediction?\r\n\r\n3. Use AI Chat to help you review the code.",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
    "predict_settings": {
      "isPredictLevel": true,
      "solution": "When I click the Increase Volume button, I think the page will update the volume number, show a message displaying the current volume level, and make the speaker image appear larger.",
      "questionType": "freeResponse",
      "placeholderText": "When I click the \"Increase Volume\" button, I think the page will change by…",
