    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html>\n<head>\n  <title>Notifications</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <div class=\"app-header\">\n    <div class=\"app-title\">📱 MyApp</div>\n    <button id=\"bellButton\" class=\"bell-button\">\n      <span class=\"bell-icon\">🔔</span>\n      <span id=\"badge\" class=\"badge\">0</span>\n    </button>\n  </div>\n\n  <div class=\"content\">\n    <p class=\"status\">You have <span id=\"notificationCount\">0</span> new notifications</p>\n    <button id=\"simulateButton\" class=\"primary-button\">Simulate Notification</button>\n    <button id=\"markReadButton\" class=\"secondary-button\">Mark all as read</button>\n  </div>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "body {\n  font-family: sans-serif;\n  background: #f5f5f7;\n  margin: 0;\n  min-height: 100vh;\n}\n\n.app-header {\n  background: white;\n  border-bottom: 1px solid #e5e5e7;\n  padding: 16px 24px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.app-title {\n  font-size: 18px;\n  font-weight: 600;\n  color: #1d1d1f;\n}\n\n.bell-button {\n  position: relative;\n  background: none;\n  border: none;\n  cursor: pointer;\n  padding: 8px;\n  font-size: 24px;\n}\n\n.bell-icon {\n  display: inline-block;\n  transition: transform 0.3s ease;\n}\n\n.bell-icon.wiggle {\n  animation: wiggle 0.4s ease;\n}\n\n@keyframes wiggle {\n  0%   { transform: rotate(0deg); }\n  25%  { transform: rotate(-15deg); }\n  50%  { transform: rotate(15deg); }\n  75%  { transform: rotate(-10deg); }\n  100% { transform: rotate(0deg); }\n}\n\n.badge {\n  position: absolute;\n  top: 2px;\n  right: 0;\n  background: #ff3b30;\n  color: white;\n  font-size: 11px;\n  font-weight: 700;\n  min-width: 18px;\n  height: 18px;\n  border-radius: 9px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 0 5px;\n  box-sizing: border-box;\n  opacity: 0;\n  transition: opacity 0.2s ease;\n}\n\n.badge.visible {\n  opacity: 1;\n}\n\n.content {\n  padding: 40px 24px;\n  text-align: center;\n}\n\n.status {\n  font-size: 16px;\n  color: #1d1d1f;\n  margin-bottom: 24px;\n}\n\n.primary-button {\n  background: #007aff;\n  color: white;\n  border: none;\n  border-radius: 10px;\n  padding: 12px 20px;\n  font-size: 15px;\n  font-weight: 600;\n  cursor: pointer;\n  margin-right: 8px;\n}\n\n.primary-button:hover {\n  background: #0a84ff;\n}\n\n.secondary-button {\n  background: #e5e5e7;\n  color: #1d1d1f;\n  border: none;\n  border-radius: 10px;\n  padding: 12px 20px;\n  font-size: 15px;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.secondary-button:hover {\n  background: #d8d8da;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const bellButton = document.getElementById(\"bellButton\");\nconst simulateButton = document.getElementById(\"simulateButton\");\nconst markReadButton = document.getElementById(\"markReadButton\");\nconst bellIcon = document.querySelector(\".bell-icon\");\nconst badge = document.getElementById(\"badge\");\nconst notificationCount = document.getElementById(\"notificationCount\");\nlet notifications = 0;\n\nconst addNotification = () => {\n  notifications = notifications + 1;\n  badge.textContent = notifications;\n  notificationCount.textContent = notifications;\n  badge.classList.add(\"visible\");\n  bellIcon.classList.add(\"wiggle\");\n  setTimeout(() => bellIcon.classList.remove(\"wiggle\"), 400);\n};\n\nbellButton.addEventListener(\"click\", addNotification);\nsimulateButton.addEventListener(\"click\", addNotification);\n\nmarkReadButton.addEventListener(\"click\", () => {\n  notifications = 0;\n  badge.textContent = notifications;\n  notificationCount.textContent = notifications;\n  badge.classList.remove(\"visible\");\n});\n",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
          "name": "speaker.png",
