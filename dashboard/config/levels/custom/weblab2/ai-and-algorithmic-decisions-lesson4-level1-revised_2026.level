<Weblab2>
  <config><![CDATA[{
  "published": true,
  "game_id": 74,
  "created_at": "2026-04-01T00:37:44.000Z",
  "level_num": "custom",
  "user_id": 22366,
  "properties": {
    "encrypted": "false",
    "long_instructions": "## Do This:\r\n\r\n1. Predict what will happen when you:\r\n   - Click the bell icon\r\n   - Click the Simulate Notification button\r\n   - Click Mark all as read\r\n\r\n2. Try each one. Did the results match your predictions?\r\n\r\n3. Look at how the buttons are connected to their behavior in `script.js`:\r\n   - The bell and Simulate Notification buttons both use a function with a name: `addNotification`.\r\n   - The Mark all as read button uses a function with **no name** — look for `() => { ... }` written directly inside `addEventListener`.\r\n   - How many times is `addNotification` defined? How many times is it called?\r\n\r\n4. Change the `addNotification` function so each click adds **5 notifications** instead of 1.\r\n   - Change one line inside the function only.\r\n   - Don't change the function's name or the event listeners.\r\n   - If your change doesn't work, use the AI to help figure out why.\r\n\r\n5. Test your change:\r\n   - Click the bell icon. Does it add 5 now?\r\n   - Click the Simulate Notification button. Does it add 5 now?\r\n   - Click Mark all as read. Did its behavior change?\r\n",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "When I click the Increase Volume button, I think the page will update the volume number, show a message displaying the current volume level, and make the speaker image appear larger.",
      "questionType": "freeResponse",
      "placeholderText": "When I click the \"Increase Volume\" button, I think the page will change by…",
