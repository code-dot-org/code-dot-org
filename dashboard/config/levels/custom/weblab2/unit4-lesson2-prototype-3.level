  "user_id": 22366,
  "properties": {
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Countdown Timer</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <h1>Countdown Timer</h1>\n  <button id=\"runLoop\">Start Countdown</button>\n\n  <div id=\"screen\">\n    <span id=\"count\">10</span>\n  </div>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: system-ui, sans-serif;\n  background: #f6f9fc;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  height: 100vh;\n}\n\nh1 {\n  margin-bottom: 10px;\n}\n\n#screen {\n  width: 150px;\n  height: 150px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 50%;\n  background: #4caf50;\n  color: white;\n  font-size: 3rem;\n  margin-top: 20px;\n  transition: background 0.3s ease;\n}\n\nbutton {\n  background: #333;\n  color: white;\n  border: none;\n  padding: 10px 18px;\n  border-radius: 6px;\n  cursor: pointer;\n  font-size: 1rem;\n}\n\nbutton:hover {\n  background: #111;\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const countEl = document.getElementById(\"count\");\nconst runButton = document.getElementById(\"runLoop\");\n\nconst countdown = () => {\n  const start = 10; // starting number\n\n  for (let num = start; num >= 0; num--) {\n    setTimeout(() => {\n      countEl.textContent = num;\n\n      // Change color based on time left\n      if (num > 5) {\n        countEl.parentElement.style.background = \"#4caf50\"; // green\n      } else if (num > 2) {\n        countEl.parentElement.style.background = \"#ff9800\"; // orange\n      } else {\n        countEl.parentElement.style.background = \"#f44336\"; // red\n      }\n\n    }, (start - num) * 1000); // one step per second\n  }\n};\n\nrunButton.addEventListener(\"click\", countdown);\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    }
  },
