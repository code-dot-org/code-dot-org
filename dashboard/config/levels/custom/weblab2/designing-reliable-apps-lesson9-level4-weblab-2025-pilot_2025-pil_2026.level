      "files": {
        "1": {
          "id": "1",
          "name": "script.js",
          "contents": "const searchButton = document.getElementById(\"searchButton\");\n\nconst findFlights = async () => {\n  showLoadingState();\n\n  try {\n    \n    // Short delay so the loading state is visible\n    await new Promise(resolve => setTimeout(resolve, 1000));\n    \n    const response = await fetch(\"flights.json\");\n    \n    if (!response.ok) throw new Error(\"Could not load flight data.\");\n    \n    const data = await response.json();\n\n    if (data.flights.length === 0) {\n      showEmptyState();\n    } else {\n      renderFlightList(data.flights);\n    }\n\n  } catch (error) {\n    showErrorState();\n  }\n};\n\nsearchButton.addEventListener(\"click\", () => {\n  findFlights();\n});\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "ui.js",
          "contents": "const plannerCard      = document.getElementById(\"plannerCard\");\nconst statusArea       = document.getElementById(\"statusArea\");\nconst resultsContainer = document.getElementById(\"resultsContainer\");\nconst flightList       = document.getElementById(\"flightList\");\n\n// ── Visibility helpers ──────────────────────────────────────\n\nconst showPlanner = () => {\n  plannerCard.classList.remove(\"hidden\");\n  statusArea.classList.add(\"hidden\");\n  resultsContainer.classList.add(\"hidden\");\n};\n\nconst showStatus = () => {\n  plannerCard.classList.add(\"hidden\");\n  statusArea.classList.remove(\"hidden\");\n  resultsContainer.classList.add(\"hidden\");\n};\n\nconst showResults = () => {\n  plannerCard.classList.add(\"hidden\");\n  statusArea.classList.add(\"hidden\");\n  resultsContainer.classList.remove(\"hidden\");\n};\n\n// ── Flight card renderer ────────────────────────────────────\n\nconst renderFlightList = (flights) => {\n  showResults();\n  flightList.innerHTML = \"\";\n\n  flights.forEach((f) => {\n    const card = document.createElement(\"li\");\n    card.className = \"flight-row-card\";\n\n    card.innerHTML = `\n      <div class=\"flight-main-content\">\n        <div class=\"airline-col\">\n          <div class=\"fake-logo\"></div>\n          <span class=\"airline-name-serious\">${f.airline}</span>\n        </div>\n        <div class=\"time-col\">\n          <div class=\"time-range\">${f.time}</div>\n          <div class=\"route-details\">${f.route.replace(\"→\", \"—\")}</div>\n        </div>\n        <div class=\"duration-col\">\n          <span class=\"duration-text\">7h 15m</span>\n          <span class=\"stop-info\">• Nonstop</span>\n        </div>\n        <div class=\"price-col\">\n          <span class=\"flight-price\">${f.price}</span>\n          <span class=\"price-type\">roundtrip</span>\n        </div>\n      </div>\n      <div class=\"flight-footer\">\n        <span class=\"status-badge status-${f.status.toLowerCase().replace(\" \", \"-\")}\">${f.status}</span>\n        <span class=\"flight-footer-link\">Flight details ⌄</span>\n      </div>\n    `;\n\n    flightList.appendChild(card);\n  });\n};\n\n// ── Reset ───────────────────────────────────────────────────\n\nconst resetApp = () => {\n  showPlanner();\n};\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": "* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;\n  background-color: #f4f6f8;\n  color: #202124;\n  min-height: 100vh;\n}\n\n/* ── HEADER ── */\n.site-header {\n  background: #1a1f36;\n  padding: 1rem 2rem;\n}\n\n.logo {\n  font-size: 1.1rem;\n  font-weight: 700;\n  color: #ffffff;\n  letter-spacing: 0.02em;\n}\n\n/* ── MAIN ── */\nmain {\n  max-width: 860px;\n  margin: 0 auto;\n  padding: 2rem;\n}\n\n.hidden {\n  display: none;\n}\n\n/* ── PLANNER CARD ── */\n.planner-card {\n  background: #ffffff;\n  border: 1px solid #dadce0;\n  border-radius: 16px;\n  padding: 2.5rem;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.07);\n}\n\n.planner-card h1 {\n  font-size: 1.6rem;\n  font-weight: 700;\n  margin-bottom: 6px;\n  color: #1a1f36;\n}\n\n.subtitle {\n  font-size: 0.95rem;\n  color: #70757a;\n  margin-bottom: 2rem;\n}\n\n.form-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n  gap: 1.25rem;\n  margin-bottom: 1.75rem;\n}\n\n.form-group {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\nlabel {\n  font-size: 0.85rem;\n  font-weight: 600;\n  color: #3c4043;\n}\n\ninput {\n  padding: 10px 12px;\n  border: 1px solid #dadce0;\n  border-radius: 8px;\n  font-size: 0.95rem;\n  color: #202124;\n  transition: border-color 0.2s;\n}\n\ninput:focus {\n  outline: none;\n  border-color: #1a73e8;\n}\n\n/* ── BUTTONS ── */\n.search-btn {\n  background: #1a73e8;\n  color: white;\n  border: none;\n  padding: 13px 32px;\n  border-radius: 50px;\n  font-size: 1rem;\n  font-weight: 700;\n  cursor: pointer;\n  transition: background 0.2s;\n}\n\n.search-btn:hover {\n  background: #1557b0;\n}\n\n.reset-btn {\n  background: transparent;\n  color: #1a73e8;\n  border: 1.5px solid #1a73e8;\n  padding: 10px 24px;\n  border-radius: 50px;\n  font-size: 0.9rem;\n  font-weight: 600;\n  cursor: pointer;\n  transition: background 0.2s, color 0.2s;\n}\n\n.reset-btn:hover {\n  background: #1a73e8;\n  color: white;\n}\n\n/* ── STATUS AREA ── */\n.status-area {\n  text-align: center;\n  padding: 4rem 2rem;\n}\n\n.state-message {\n  font-size: 1.1rem;\n  color: #70757a;\n  margin-bottom: 1.5rem;\n}\n\n/* ── RESULTS ── */\n.results-header-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  margin-bottom: 1.25rem;\n}\n\n.results-header {\n  font-size: 1.3rem;\n  font-weight: 700;\n  color: #202124;\n  margin-bottom: 2px;\n}\n\n.results-subtext {\n  font-size: 0.88rem;\n  color: #70757a;\n}\n\n.flight-list {\n  list-style: none;\n}\n\n/* ── FLIGHT CARD ── */\n.flight-row-card {\n  background: #fff;\n  border: 1px solid #dadce0;\n  border-radius: 12px;\n  margin-bottom: 16px;\n  transition: box-shadow 0.2s ease-in-out;\n}\n\n.flight-row-card:hover {\n  box-shadow: 0 4px 12px rgba(60, 64, 67, 0.15);\n}\n\n.flight-main-content {\n  display: flex;\n  align-items: center;\n  padding: 24px;\n  justify-content: space-between;\n}\n\n.airline-col {\n  display: flex;\n  align-items: center;\n  flex: 2;\n  gap: 16px;\n}\n\n.fake-logo {\n  width: 36px;\n  height: 36px;\n  background: #1a73e8;\n  border-radius: 6px;\n  flex-shrink: 0;\n}\n\n.time-col {\n  flex: 2.5;\n  padding: 0 20px;\n}\n\n.duration-col {\n  flex: 2;\n  text-align: left;\n}\n\n.price-col {\n  flex: 1.5;\n  text-align: right;\n  border-left: 1px solid #f1f3f4;\n  padding-left: 20px;\n}\n\n.airline-name-serious {\n  font-size: 15px;\n  font-weight: 500;\n  color: #3c4043;\n}\n\n.time-range {\n  font-size: 18px;\n  font-weight: 700;\n  color: #202124;\n  margin-bottom: 4px;\n}\n\n.route-details {\n  font-size: 14px;\n  color: #70757a;\n}\n\n.duration-text {\n  font-size: 15px;\n  display: block;\n  margin-bottom: 2px;\n}\n\n.stop-info {\n  font-size: 14px;\n  color: #188038;\n  font-weight: 600;\n}\n\n.flight-price {\n  display: block;\n  font-size: 22px;\n  font-weight: 700;\n  color: #188038;\n}\n\n.price-type {\n  font-size: 12px;\n  color: #70757a;\n}\n\n.flight-footer-link {\n  border-top: 1px solid #f1f3f4;\n  padding: 12px 24px;\n  font-size: 14px;\n  color: #1a73e8;\n  text-align: right;\n  font-weight: 500;\n  cursor: pointer;\n}\n\n/* ── FLIGHT FOOTER ── */\n.flight-footer {\n  border-top: 1px solid #f1f3f4;\n  padding: 10px 24px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.flight-footer-link {\n  font-size: 14px;\n  color: #1a73e8;\n  font-weight: 500;\n  cursor: pointer;\n}\n\n/* Status badges */\n.status-badge {\n  font-size: 12px;\n  font-weight: 600;\n  padding: 4px 10px;\n  border-radius: 99px;\n}\n\n.status-on-time {\n  background: #e6f4ea;\n  color: #188038;\n}\n\n.status-limited-seats {\n  background: #fce8e6;\n  color: #c5221f;\n}\n\n.status-boarding-soon {\n  background: #fef7e0;\n  color: #b06000;\n}\n",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>FlightFinder</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n\n  <header class=\"site-header\">\n    <span class=\"logo\">✈ FlightFinder</span>\n  </header>\n\n  <main>\n\n    <!-- Search Form -->\n    <section id=\"plannerCard\" class=\"planner-card\">\n      <h1>Where to?</h1>\n      <p class=\"subtitle\">Find available flights in seconds.</p>\n\n      <div class=\"form-grid\">\n        <div class=\"form-group\">\n          <label for=\"departureDate\">Departure</label>\n          <input type=\"date\" id=\"departureDate\" />\n        </div>\n        <div class=\"form-group\">\n          <label for=\"returnDate\">Return</label>\n          <input type=\"date\" id=\"returnDate\" />\n        </div>\n        <div class=\"form-group\">\n          <label for=\"passengerCount\">Passengers</label>\n          <input type=\"number\" id=\"passengerCount\" min=\"1\" value=\"1\" />\n        </div>\n      </div>\n\n      <button id=\"searchButton\">Find flights</button>\n    </section>\n\n    <!-- Loading / Empty / Error States -->\n    <section id=\"statusArea\" class=\"status-area hidden\"></section>\n\n    <!-- Results -->\n    <section id=\"resultsContainer\" class=\"results-container hidden\">\n      <div class=\"results-header-row\">\n        <div>\n          <p class=\"results-title\">Available Flights</p>\n          <p class=\"results-sub\">Per person · roundtrip</p>\n        </div>\n        <button class=\"link-btn\" onclick=\"resetApp()\">← New search</button>\n      </div>\n      <ul id=\"flightList\" class=\"flight-list\"></ul>\n    </section>\n\n  </main>\n\n  <script src=\"ui.js\"></script>\n  <script src=\"helpers.js\"></script>\n  <script src=\"script.js\"></script>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "helpers.js",
          "contents": "// State UI components - update each function below to match your wireframes.\n\nconst showLoadingState = () => {\n  showStatus();\n  statusArea.innerHTML = \"\";\n\n  // TODO: Design your loading state here\n\n};\n\nconst showEmptyState = () => {\n  showStatus();\n  statusArea.innerHTML = \"\";\n\n  // TODO: Design your empty state here\n\n};\n\nconst showErrorState = () => {\n  showStatus();\n  statusArea.innerHTML = \"\";\n\n  // TODO: Design your error state here\n\n};\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "5"
      ]
    },
