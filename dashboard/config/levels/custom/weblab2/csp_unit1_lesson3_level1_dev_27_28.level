<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-09-24T15:01:42.000Z",
  "level_num": "custom",
  "user_id": 22366,
  "properties": {
    "require_edit_to_continue": "true",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Test a Sensor</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"app\">\n    <h1 class=\"visually-hidden\">Test a Sensor</h1>\n    <p id=\"app-error\" class=\"app-error\" role=\"alert\" hidden></p>\n\n    <div class=\"workspace\">\n      <section class=\"panel sensor-panel\" aria-labelledby=\"sensor-panel-heading\">\n        <div class=\"panel-header\">\n          <h2 id=\"sensor-panel-heading\">Sensor Panel</h2>\n          <button id=\"reset-button\" class=\"text-button\" type=\"button\">Reset</button>\n        </div>\n\n        <div class=\"sensor-row\">\n          <div class=\"sensor-name\">\n            <span class=\"sensor-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" focusable=\"false\">\n                <circle cx=\"12\" cy=\"12\" r=\"4\"></circle>\n                <path d=\"M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8\"></path>\n              </svg>\n            </span>\n            <label for=\"light-slider\">Light Sensor</label>\n          </div>\n          <div class=\"sensor-control slider-row\">\n            <span class=\"slider-end\" aria-hidden=\"true\">Dark</span>\n            <input id=\"light-slider\" class=\"light-slider\" type=\"range\" min=\"0\" max=\"100\" step=\"1\" value=\"70\">\n            <span class=\"slider-end\" aria-hidden=\"true\">Bright</span>\n            <output id=\"light-value\" class=\"slider-value\" for=\"light-slider\">70</output>\n          </div>\n        </div>\n\n        <div class=\"sensor-row\">\n          <div class=\"sensor-name\">\n            <span class=\"sensor-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" focusable=\"false\">\n                <path d=\"M12 21s-6.5-5.8-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 15.2 12 21 12 21z\"></path>\n                <circle cx=\"12\" cy=\"9.8\" r=\"2.3\"></circle>\n              </svg>\n            </span>\n            <label for=\"location-select\">GPS (Location)</label>\n          </div>\n          <div class=\"sensor-control\">\n            <select id=\"location-select\" class=\"location-select\"></select>\n          </div>\n        </div>\n\n        <div class=\"sensor-row\">\n          <div class=\"sensor-name\">\n            <span class=\"sensor-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" focusable=\"false\">\n                <path d=\"M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8M16 4h2.5A1.5 1.5 0 0 1 20 5.5V8M20 16v2.5a1.5 1.5 0 0 1-1.5 1.5H16M8 20H5.5A1.5 1.5 0 0 1 4 18.5V16\"></path>\n                <path d=\"M9 9.5v1M15 9.5v1M12 9.5v3.5h-1M9.5 15.5a3.5 3.5 0 0 0 5 0\"></path>\n              </svg>\n            </span>\n            <span>Front Camera (Face ID)</span>\n          </div>\n          <div class=\"sensor-control sensor-stack\">\n            <fieldset class=\"segmented\">\n              <legend class=\"field-hint\">Who's looking at the phone?</legend>\n              <div class=\"face-tiles\">\n                <span class=\"face-tile\">\n                  <input id=\"face-owner\" type=\"radio\" name=\"face\" value=\"owner\" checked>\n                  <label for=\"face-owner\">\n                    <svg class=\"face-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n                      <circle cx=\"12\" cy=\"12\" r=\"8.5\"></circle>\n                      <circle class=\"face-fill\" cx=\"9\" cy=\"10.5\" r=\"1\"></circle>\n                      <circle class=\"face-fill\" cx=\"15\" cy=\"10.5\" r=\"1\"></circle>\n                      <path d=\"M8.8 14.6a4 4 0 0 0 6.4 0\"></path>\n                    </svg>\n                    <span>Owner</span>\n                  </label>\n                </span>\n                <span class=\"face-tile\">\n                  <input id=\"face-sunglasses\" type=\"radio\" name=\"face\" value=\"owner-sunglasses\">\n                  <label for=\"face-sunglasses\">\n                    <svg class=\"face-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n                      <circle cx=\"12\" cy=\"12\" r=\"8.5\"></circle>\n                      <rect class=\"face-fill\" x=\"6.3\" y=\"9\" width=\"4.6\" height=\"3.2\" rx=\"1.2\"></rect>\n                      <rect class=\"face-fill\" x=\"13.1\" y=\"9\" width=\"4.6\" height=\"3.2\" rx=\"1.2\"></rect>\n                      <path d=\"M10.9 10.2h2.2M8.8 15.2a4 4 0 0 0 6.4 0\"></path>\n                    </svg>\n                    <span>Sunglasses</span>\n                  </label>\n                </span>\n                <span class=\"face-tile\">\n                  <input id=\"face-someone-else\" type=\"radio\" name=\"face\" value=\"someone-else\">\n                  <label for=\"face-someone-else\">\n                    <svg class=\"face-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n                      <circle cx=\"12\" cy=\"12\" r=\"8.5\"></circle>\n                      <path d=\"M4.2 9.5C5.5 6 8.5 4.5 12 4.5c2 0 3.6.6 4.6 1.6M7.5 8.5c2.5.2 5-.6 7-2.4 1 1.3 2.4 2.2 4.2 2.6\"></path>\n                      <circle class=\"face-fill\" cx=\"9\" cy=\"12\" r=\"1\"></circle>\n                      <circle class=\"face-fill\" cx=\"15\" cy=\"12\" r=\"1\"></circle>\n                      <path d=\"M9.5 16h5\"></path>\n                    </svg>\n                    <span>Someone else</span>\n                  </label>\n                </span>\n              </div>\n            </fieldset>\n            <button id=\"pickup-button\" class=\"action-button\" type=\"button\">\n              <span id=\"pickup-button-text\">Pick up phone</span>\n            </button>\n          </div>\n        </div>\n\n        <div class=\"sensor-row\">\n          <div class=\"sensor-name\">\n            <span class=\"sensor-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\" focusable=\"false\">\n                <rect x=\"9\" y=\"3\" width=\"6\" height=\"11\" rx=\"3\"></rect>\n                <path d=\"M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21M8.5 21h7\"></path>\n              </svg>\n            </span>\n            <span>Microphone (Voice)</span>\n          </div>\n          <div class=\"sensor-control voice-controls\">\n            <button id=\"speak-button\" class=\"action-button speak-button\" type=\"button\">\n              <span class=\"speak-indicator\" aria-hidden=\"true\"></span>\n              <span id=\"speak-button-text\">Speak</span>\n            </button>\n            <p id=\"read-aloud-row\" class=\"read-aloud-row\">\n              <input id=\"read-aloud\" type=\"checkbox\" checked>\n              <label for=\"read-aloud\">Read replies out loud</label>\n            </p>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"panel preview-panel\" aria-labelledby=\"preview-heading\">\n        <h2 id=\"preview-heading\">Phone Preview</h2>\n        <div class=\"phone\">\n          <div id=\"phone-screen\" class=\"phone-screen\">\n            <div class=\"status-bar\">\n              <svg class=\"status-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n                <path d=\"M4 18v-2M9 18v-5M14 18v-8M19 18V7\"></path>\n              </svg>\n              <span class=\"camera-notch\" aria-hidden=\"true\"></span>\n              <svg class=\"status-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n                <rect x=\"2.5\" y=\"8\" width=\"17\" height=\"9\" rx=\"2\"></rect>\n                <path d=\"M22 11.5v2\"></path>\n                <rect class=\"battery-level\" x=\"4.5\" y=\"10\" width=\"11\" height=\"5\" rx=\"1\"></rect>\n              </svg>\n            </div>\n\n            <div id=\"brightness-hud\" class=\"brightness-hud\" aria-hidden=\"true\">\n              <svg class=\"hud-icon\" viewBox=\"0 0 24 24\" focusable=\"false\">\n                <circle cx=\"12\" cy=\"12\" r=\"4\"></circle>\n                <path d=\"M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8\"></path>\n              </svg>\n              <span class=\"hud-track\"><span id=\"hud-fill\" class=\"hud-fill\"></span></span>\n              <span id=\"hud-value\" class=\"hud-value\"></span>\n            </div>\n\n            <p id=\"lock-status\" class=\"lock-status trackable\">\n              <span id=\"lock-icon\" class=\"lock-icon\"></span>\n              <span id=\"lock-text\"></span>\n            </p>\n\n            <p id=\"screen-time-wrap\" class=\"screen-time trackable\">\n              <span id=\"screen-time\"></span>\n              <span id=\"screen-day\" class=\"screen-day\" hidden>Tomorrow</span>\n            </p>\n            <p id=\"screen-city\" class=\"screen-city trackable\"></p>\n            <p id=\"screen-weather\" class=\"screen-weather trackable\">\n              <span id=\"weather-icon\" class=\"weather-icon\"></span>\n              <span id=\"screen-temp\"></span>\n              <span id=\"screen-condition\"></span>\n            </p>\n\n            <div class=\"screen-cards\">\n              <div id=\"screen-welcome\" class=\"notification trackable\">\n                <span class=\"app-icon app-icon-carrier\" aria-hidden=\"true\">\n                  <svg viewBox=\"0 0 24 24\" focusable=\"false\"><path d=\"M5 18v-2M10 18v-5M15 18v-8M20 18V7\"></path></svg>\n                </span>\n                <div class=\"notification-body\">\n                  <p class=\"notification-app\">Carrier <span class=\"notification-when\">now</span></p>\n                  <p id=\"welcome-text\" class=\"welcome-text\"></p>\n                  <p id=\"welcome-english\" class=\"welcome-english\"></p>\n                </div>\n              </div>\n              <div id=\"screen-nearby\" class=\"notification trackable\">\n                <span class=\"app-icon app-icon-maps\" aria-hidden=\"true\">\n                  <svg viewBox=\"0 0 24 24\" focusable=\"false\">\n                    <path d=\"M12 21s-6.5-5.8-6.5-11.2a6.5 6.5 0 0 1 13 0C18.5 15.2 12 21 12 21z\"></path>\n                    <circle cx=\"12\" cy=\"9.8\" r=\"2.3\"></circle>\n                  </svg>\n                </span>\n                <div class=\"notification-body\">\n                  <p class=\"notification-app\">Maps <span class=\"notification-when\">now</span></p>\n                  <p id=\"nearby-text\"></p>\n                </div>\n              </div>\n            </div>\n\n            <span class=\"home-bar\" aria-hidden=\"true\"></span>\n\n            <div id=\"voice-overlay\" class=\"voice-overlay\" hidden>\n              <p id=\"voice-listening\" class=\"voice-listening\">\n                <span class=\"listening-dot\" aria-hidden=\"true\"></span>\n                <span>Listening...</span>\n              </p>\n              <div id=\"voice-exchange\" class=\"voice-exchange\">\n                <p id=\"bubble-user\" class=\"bubble bubble-user\" hidden>\n                  <span class=\"bubble-label\">You said</span>\n                  <span id=\"voice-transcript\"></span>\n                </p>\n                <p id=\"bubble-assistant\" class=\"bubble bubble-assistant\" hidden>\n                  <span class=\"bubble-label\">Assistant</span>\n                  <span id=\"voice-response\"></span>\n                </p>\n              </div>\n              <button id=\"voice-done\" class=\"voice-done\" type=\"button\">Done</button>\n            </div>\n          </div>\n        </div>\n      </section>\n    </div>\n\n    <p id=\"announcer\" class=\"visually-hidden\" aria-live=\"polite\"></p>\n  </main>\n\n  <template id=\"icon-lock-closed\">\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n      <rect x=\"5\" y=\"10.5\" width=\"14\" height=\"10\" rx=\"2\"></rect>\n      <path d=\"M8 10.5V7.5a4 4 0 0 1 8 0v3\"></path>\n    </svg>\n  </template>\n  <template id=\"icon-lock-open\">\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n      <rect x=\"5\" y=\"10.5\" width=\"14\" height=\"10\" rx=\"2\"></rect>\n      <path d=\"M8 10.5V7.5a4 4 0 0 1 7.7-1.5\"></path>\n    </svg>\n  </template>\n  <template id=\"icon-face-scan\">\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n      <path d=\"M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8M16 4h2.5A1.5 1.5 0 0 1 20 5.5V8M20 16v2.5a1.5 1.5 0 0 1-1.5 1.5H16M8 20H5.5A1.5 1.5 0 0 1 4 18.5V16\"></path>\n      <path d=\"M9 9.5v1M15 9.5v1M12 9.5v3.5h-1M9.5 15.5a3.5 3.5 0 0 0 5 0\"></path>\n    </svg>\n  </template>\n  <template id=\"icon-sun\">\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n      <circle cx=\"12\" cy=\"12\" r=\"4\"></circle>\n      <path d=\"M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8\"></path>\n    </svg>\n  </template>\n  <template id=\"icon-cloud\">\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n      <path d=\"M7 18h10a4 4 0 0 0 .6-7.95A5.5 5.5 0 0 0 7.1 9.1 4.5 4.5 0 0 0 7 18z\"></path>\n    </svg>\n  </template>\n  <template id=\"icon-rain\">\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n      <path d=\"M7 15h10a4 4 0 0 0 .6-7.95A5.5 5.5 0 0 0 7.1 6.1 4.5 4.5 0 0 0 7 15z\"></path>\n      <path d=\"M8 18l-1 3M12 18l-1 3M16 18l-1 3\"></path>\n    </svg>\n  </template>\n  <template id=\"icon-moon\">\n    <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n      <path d=\"M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z\"></path>\n    </svg>\n  </template>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "/* Tokens */\n\n:root {\n  --color-page: #f1f3f8;\n  --color-surface: #ffffff;\n  --color-text: #1b1f2e;\n  --color-muted: #545b70;\n  --color-border: #d5d9e4;\n  --color-border-strong: #8b92ad;\n  --color-accent: #3a47c9;\n  --color-accent-strong: #2c379f;\n  --color-accent-soft: #e8eafb;\n  --color-on-accent: #ffffff;\n  --color-disabled: #545b70;\n  --color-focus: #3a47c9;\n  --color-highlight: #e07a10;\n  --color-error-bg: #fdecea;\n  --color-error-text: #8a1c12;\n\n  --phone-frame: #1b1f2e;\n  --screen-bg: #e6e9ee;\n  --screen-text-light: #16181d;\n  --screen-muted-light: #3d4350;\n  --screen-card-light: rgba(255, 255, 255, 0.65);\n  --screen-text-dark: #f5f6f8;\n  --screen-muted-dark: #c9ced8;\n  --screen-card-dark: rgba(255, 255, 255, 0.1);\n  --bubble-user-bg: #3a47c9;\n  --bubble-user-label: #dfe3fb;\n\n  --control-height: 2.5rem;\n  --radius: 0.75rem;\n  --space-1: 0.25rem;\n  --space-2: 0.5rem;\n  --space-3: 1rem;\n  --space-4: 1.5rem;\n  --font-body: system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif;\n}\n\n/* Base */\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\nhtml {\n  font-size: 87.5%;\n}\n\nbody {\n  margin: 0;\n  background: var(--color-page);\n  color: var(--color-text);\n  font-family: var(--font-body);\n  font-size: 1rem;\n  line-height: 1.4;\n}\n\nh2,\np {\n  margin: 0;\n}\n\nbutton,\ninput,\nselect {\n  font: inherit;\n}\n\n[hidden] {\n  display: none !important;\n}\n\n:focus-visible {\n  outline: 3px solid var(--color-focus);\n  outline-offset: 2px;\n}\n\n.visually-hidden {\n  position: absolute;\n  inline-size: 1px;\n  block-size: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n}\n\n/* Layout */\n\n.app {\n  max-inline-size: 80rem;\n  margin-inline: auto;\n  padding: var(--space-2);\n}\n\n.app-error {\n  margin-block-end: var(--space-2);\n  padding: var(--space-3);\n  border-radius: var(--radius);\n  background: var(--color-error-bg);\n  color: var(--color-error-text);\n  font-weight: 600;\n}\n\n.workspace {\n  display: grid;\n  gap: var(--space-2);\n}\n\n@media (min-width: 48rem) {\n  .workspace {\n    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);\n  }\n}\n\n.panel {\n  padding: var(--space-3) var(--space-4);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius);\n  background: var(--color-surface);\n}\n\n.panel h2 {\n  font-size: 0.8rem;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n  color: var(--color-muted);\n}\n\n.panel-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-3);\n  min-block-size: 2rem;\n  margin-block-end: var(--space-1);\n}\n\n.preview-panel {\n  display: flex;\n  flex-direction: column;\n}\n\n.preview-panel h2 {\n  margin-block-end: var(--space-3);\n}\n\n/* Sensor Panel */\n\n.sensor-row {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--space-2) var(--space-4);\n  padding-block: var(--space-3);\n  border-block-start: 1px solid var(--color-border);\n}\n\n.sensor-name {\n  display: flex;\n  flex: 0 0 12rem;\n  align-items: center;\n  gap: var(--space-2);\n  font-weight: 700;\n}\n\n.sensor-icon {\n  display: flex;\n  flex: none;\n  align-items: center;\n  justify-content: center;\n  inline-size: 2rem;\n  block-size: 2rem;\n  border-radius: 0.5rem;\n  background: var(--color-accent-soft);\n  color: var(--color-accent);\n}\n\n.sensor-icon svg {\n  inline-size: 1.1rem;\n  block-size: 1.1rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.sensor-control {\n  flex: 1 1 18rem;\n  min-inline-size: 0;\n}\n\n.sensor-stack {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: var(--space-2);\n}\n\n.field-hint {\n  margin-block-end: var(--space-1);\n  padding: 0;\n  color: var(--color-muted);\n  font-size: 0.85rem;\n}\n\n/* Slider */\n\n.slider-row {\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n}\n\n.slider-end {\n  color: var(--color-muted);\n  font-size: 0.85rem;\n}\n\n.light-slider {\n  flex: 1 1 auto;\n  min-inline-size: 0;\n  min-block-size: 32px;\n  margin: 0;\n  accent-color: var(--color-accent);\n}\n\n.slider-value {\n  flex: none;\n  min-inline-size: 3rem;\n  padding-block: var(--space-1);\n  border: 1px solid var(--color-border);\n  border-radius: 0.5rem;\n  font-weight: 700;\n  font-variant-numeric: tabular-nums;\n  text-align: center;\n}\n\n/* Select */\n\n.location-select {\n  inline-size: 100%;\n  min-block-size: var(--control-height);\n  padding-inline: var(--space-2);\n  border: 1px solid var(--color-border-strong);\n  border-radius: 0.5rem;\n  background: var(--color-surface);\n  color: var(--color-text);\n}\n\n/* Segmented control (styled radio group) */\n\n.segmented {\n  inline-size: 100%;\n  margin: 0;\n  padding: 0;\n  border: 0;\n  min-inline-size: 0;\n}\n\n.face-tiles {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 5.5rem));\n  gap: var(--space-2);\n}\n\n.face-tile {\n  position: relative;\n}\n\n.face-tile input {\n  position: absolute;\n  inset: 0;\n  margin: 0;\n  opacity: 0;\n  cursor: pointer;\n}\n\n.face-tile label {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: var(--space-1);\n  block-size: 100%;\n  padding: var(--space-2) var(--space-1);\n  border: 1px solid var(--color-border-strong);\n  border-radius: 0.6rem;\n  background: var(--color-surface);\n  color: var(--color-text);\n  font-size: 0.8rem;\n  font-weight: 600;\n  line-height: 1.2;\n  text-align: center;\n  cursor: pointer;\n}\n\n.face-tile label:hover {\n  background: var(--color-accent-soft);\n}\n\n.face-icon {\n  inline-size: 2rem;\n  block-size: 2rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.6;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.face-icon .face-fill {\n  fill: currentColor;\n  stroke: none;\n}\n\n.face-tile input:checked + label {\n  border: 2px solid var(--color-accent);\n  padding: calc(var(--space-2) - 1px) calc(var(--space-1) - 1px);\n  background: var(--color-accent-soft);\n  color: var(--color-accent-strong);\n}\n\n.face-tile input:focus-visible + label {\n  outline: 3px solid var(--color-focus);\n  outline-offset: 2px;\n}\n\n/* Buttons */\n\n.action-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-2);\n  min-block-size: var(--control-height);\n  min-inline-size: 8.5rem;\n  padding-inline: var(--space-3);\n  border: 0;\n  border-radius: 0.5rem;\n  background: var(--color-accent);\n  color: var(--color-on-accent);\n  font-weight: 700;\n  cursor: pointer;\n}\n\n.action-button:hover {\n  background: var(--color-accent-strong);\n}\n\n.action-button[aria-disabled=\"true\"] {\n  background: var(--color-disabled);\n  cursor: default;\n}\n\n.text-button {\n  min-block-size: 2rem;\n  padding-inline: var(--space-2);\n  border: 1px solid var(--color-border);\n  border-radius: 0.5rem;\n  background: none;\n  color: var(--color-accent);\n  font-size: 0.85rem;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.text-button:hover {\n  background: var(--color-accent-soft);\n}\n\n.speak-indicator {\n  display: none;\n  position: relative;\n  inline-size: 0.6rem;\n  block-size: 0.6rem;\n  border-radius: 50%;\n  background: currentColor;\n}\n\n.speak-button.is-listening .speak-indicator {\n  display: inline-block;\n}\n\n.speak-button.is-listening .speak-indicator::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: 50%;\n  background: currentColor;\n  animation: pulse 1s ease-out infinite;\n}\n\n@keyframes pulse {\n  from {\n    transform: scale(1);\n    opacity: 0.7;\n  }\n  to {\n    transform: scale(2.4);\n    opacity: 0;\n  }\n}\n\n.voice-controls {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--space-2) var(--space-4);\n}\n\n.read-aloud-row {\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n  font-size: 0.9rem;\n}\n\n.read-aloud-row input {\n  inline-size: 1.1rem;\n  block-size: 1.1rem;\n  margin: 0;\n  accent-color: var(--color-accent);\n}\n\n/* Phone Preview */\n\n.phone {\n  margin-block: auto;\n  inline-size: 100%;\n  max-inline-size: clamp(11rem, calc((100vh - 7rem) / 2.1), 15rem);\n  margin-inline: auto;\n  padding: 0.5rem;\n  border-radius: 2.2rem;\n  background: var(--phone-frame);\n  box-shadow: 0 8px 24px rgba(27, 31, 46, 0.25);\n}\n\n.phone-screen {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  aspect-ratio: 9 / 18;\n  padding-block: var(--space-2);\n  padding-inline: 0.75rem;\n  border-radius: 1.75rem;\n  background: var(--screen-bg);\n  color: var(--screen-text-light);\n  text-align: center;\n  transition: background-color 0.2s ease;\n}\n\n.phone-screen.is-dark {\n  color: var(--screen-text-dark);\n}\n\n.status-bar {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-block-end: var(--space-3);\n  padding-inline: var(--space-2);\n}\n\n.status-icon {\n  inline-size: 1.1rem;\n  block-size: 1.1rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n}\n\n.battery-level {\n  fill: currentColor;\n  stroke: none;\n}\n\n.camera-notch {\n  inline-size: 4rem;\n  block-size: 1.1rem;\n  border-radius: 999px;\n  background: var(--phone-frame);\n}\n\n.brightness-hud {\n  position: absolute;\n  inset-block-start: 2.2rem;\n  inset-inline: 0;\n  display: flex;\n  align-items: center;\n  gap: var(--space-2);\n  inline-size: 70%;\n  margin-inline: auto;\n  padding: var(--space-2) var(--space-3);\n  border-radius: 999px;\n  background: rgba(8, 10, 22, 0.85);\n  color: #ffffff;\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity 0.4s ease;\n  z-index: 1;\n}\n\n.brightness-hud.is-visible {\n  opacity: 1;\n  transition-duration: 0.1s;\n}\n\n.hud-icon {\n  flex: none;\n  inline-size: 1.1rem;\n  block-size: 1.1rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n}\n\n.hud-track {\n  flex: 1 1 auto;\n  block-size: 0.4rem;\n  border-radius: 999px;\n  background: rgba(255, 255, 255, 0.3);\n  overflow: hidden;\n}\n\n.hud-fill {\n  display: block;\n  block-size: 100%;\n  inline-size: calc(var(--level, 0.5) * 100%);\n  border-radius: 999px;\n  background: #ffffff;\n}\n\n.hud-value {\n  flex: none;\n  font-size: 0.8rem;\n  font-weight: 700;\n  font-variant-numeric: tabular-nums;\n}\n\n.lock-status {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-1);\n  margin-block-end: var(--space-1);\n  font-size: 0.8rem;\n  font-weight: 700;\n}\n\n.lock-icon svg {\n  display: block;\n  inline-size: 1.1rem;\n  block-size: 1.1rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.lock-status.is-failed {\n  flex-direction: column;\n}\n\n.screen-time {\n  font-size: 2rem;\n  font-weight: 700;\n  line-height: 1.1;\n  font-variant-numeric: tabular-nums;\n}\n\n.screen-day,\n.welcome-english {\n  color: var(--screen-muted-light);\n}\n\n.is-dark .screen-day,\n.is-dark .welcome-english {\n  color: var(--screen-muted-dark);\n}\n\n.screen-day {\n  display: block;\n  font-size: 0.85rem;\n  font-weight: 600;\n}\n\n.screen-city {\n  margin-block-start: var(--space-1);\n  font-size: 1rem;\n  font-weight: 700;\n}\n\n.screen-weather {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-1);\n  margin-block-end: var(--space-2);\n  font-size: 0.9rem;\n  font-weight: 600;\n}\n\n.weather-icon svg {\n  display: block;\n  inline-size: 1.2rem;\n  block-size: 1.2rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.screen-cards {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-2);\n  margin-block-start: auto;\n}\n\n.notification {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--space-2);\n  padding: var(--space-2);\n  font-size: 0.8rem;\n  border-radius: 1.1rem;\n  background: var(--screen-card-light);\n  text-align: start;\n}\n\n.is-dark .notification {\n  background: var(--screen-card-dark);\n}\n\n.notification-body {\n  min-inline-size: 0;\n}\n\n.notification-app {\n  font-size: 0.65rem;\n  font-weight: 700;\n  letter-spacing: 0.02em;\n  text-transform: uppercase;\n}\n\n.notification-when {\n  margin-inline-start: var(--space-1);\n  font-weight: 500;\n  text-transform: none;\n}\n\n.app-icon {\n  display: flex;\n  flex: none;\n  align-items: center;\n  justify-content: center;\n  inline-size: 1.6rem;\n  block-size: 1.6rem;\n  border-radius: 0.45rem;\n  color: #ffffff;\n}\n\n.app-icon svg {\n  inline-size: 1rem;\n  block-size: 1rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2.2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.app-icon-maps {\n  background: #1f8a4c;\n}\n\n.app-icon-carrier {\n  background: #3a47c9;\n}\n\n.welcome-text {\n  font-weight: 600;\n}\n\n.welcome-english {\n  font-size: 0.75rem;\n}\n\n.home-bar {\n  align-self: center;\n  inline-size: 35%;\n  block-size: 0.25rem;\n  margin-block-start: var(--space-2);\n  border-radius: 999px;\n  background: currentColor;\n  opacity: 0.6;\n}\n\n/* Voice overlay */\n\n.voice-overlay {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n  gap: var(--space-3);\n  padding: var(--space-3) 0.75rem;\n  border-radius: 1.75rem;\n  background: rgba(8, 10, 22, 0.9);\n  color: #ffffff;\n  text-align: start;\n  animation: fade-in 0.25s ease-out;\n}\n\n.voice-listening {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--space-2);\n  font-weight: 700;\n}\n\n.listening-dot {\n  position: relative;\n  inline-size: 0.75rem;\n  block-size: 0.75rem;\n  border-radius: 50%;\n  background: #8cb8ff;\n}\n\n.listening-dot::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  border-radius: 50%;\n  background: #8cb8ff;\n  animation: pulse 1s ease-out infinite;\n}\n\n.voice-exchange {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-2);\n}\n\n.bubble {\n  max-inline-size: 88%;\n  padding: 0.4rem 0.65rem;\n  border-radius: 0.9rem;\n  font-size: 0.85rem;\n  animation: bubble-in 0.3s ease-out;\n}\n\n.bubble-label {\n  display: block;\n  font-size: 0.65rem;\n  font-weight: 700;\n}\n\n.bubble-user {\n  align-self: flex-end;\n  border-end-end-radius: 0.3rem;\n  background: var(--bubble-user-bg);\n}\n\n.bubble-user .bubble-label {\n  color: var(--bubble-user-label);\n}\n\n.bubble-assistant {\n  align-self: flex-start;\n  border-end-start-radius: 0.3rem;\n  background: #2e3448;\n}\n\n.bubble-assistant .bubble-label {\n  color: #c9ced8;\n}\n\n.voice-done {\n  align-self: center;\n  min-block-size: 44px;\n  min-inline-size: 6rem;\n  padding-inline: var(--space-4);\n  border: 2px solid #ffffff;\n  border-radius: 999px;\n  background: none;\n  color: #ffffff;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n.voice-done:focus-visible {\n  outline-color: #8cb8ff;\n}\n\n@keyframes fade-in {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n\n@keyframes bubble-in {\n  from {\n    opacity: 0;\n    transform: translateY(0.5rem);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n/* Change highlight */\n\n.trackable {\n  position: relative;\n}\n\n.trackable.is-updated::after {\n  content: \"\";\n  position: absolute;\n  inset: -0.25rem;\n  border: 2px solid var(--color-highlight);\n  border-radius: 0.6rem;\n  pointer-events: none;\n  opacity: 0;\n  animation: flash-outline 0.6s ease-out;\n}\n\n@keyframes flash-outline {\n  from {\n    opacity: 1;\n  }\n  to {\n    opacity: 0;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .phone-screen,\n  .brightness-hud,\n  .brightness-hud.is-visible {\n    transition: none;\n  }\n\n  .speak-button.is-listening .speak-indicator::after,\n  .trackable.is-updated::after,\n  .listening-dot::after {\n    display: none;\n  }\n\n  .voice-overlay,\n  .bubble {\n    animation: none;\n  }\n\n  .trackable.is-updated {\n    text-decoration: underline;\n    text-decoration-color: var(--color-highlight);\n    text-decoration-thickness: 2px;\n    text-underline-offset: 3px;\n  }\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const CONFIG = {\n  darkModeThreshold: 30,\n  boostThreshold: 85,\n  defaultLight: 70,\n  defaultCityId: \"chicago\",\n  referenceMinutes: 10 * 60 + 42,\n  listeningMs: 1500,\n  replyDelayMs: 700,\n  scanMs: 1200,\n  hudMs: 1500,\n  logLimit: 50,\n  pageStep: 10\n};\n\n// Offsets are minutes ahead of Chicago in January (standard time), fixed so every student sees the same times.\nconst CITIES = [\n  {\n    id: \"chicago\",\n    name: \"Chicago\",\n    offsetMinutes: 0,\n    temperatureF: 34,\n    condition: \"Cloudy\",\n    conditionInSentence: \"cloudy\",\n    icon: \"cloud\",\n    coffeeShopsOpen: 3,\n    welcome: { text: \"Welcome to Chicago!\", lang: \"en\", english: \"\" }\n  },\n  {\n    id: \"sao-paulo\",\n    name: \"São Paulo\",\n    offsetMinutes: 180,\n    temperatureF: 81,\n    condition: \"Sunny\",\n    conditionInSentence: \"sunny\",\n    icon: \"sun\",\n    coffeeShopsOpen: 4,\n    welcome: { text: \"Bem-vindo a São Paulo!\", lang: \"pt-BR\", english: \"Welcome to São Paulo!\" }\n  },\n  {\n    id: \"paris\",\n    name: \"Paris\",\n    offsetMinutes: 420,\n    temperatureF: 45,\n    condition: \"Rain\",\n    conditionInSentence: \"rainy\",\n    icon: \"rain\",\n    coffeeShopsOpen: 2,\n    welcome: { text: \"Bienvenue à Paris !\", lang: \"fr\", english: \"Welcome to Paris!\" }\n  },\n  {\n    id: \"tokyo\",\n    name: \"Tokyo\",\n    offsetMinutes: 900,\n    temperatureF: 41,\n    condition: \"Clear\",\n    conditionInSentence: \"clear\",\n    icon: \"moon\",\n    coffeeShopsOpen: 0,\n    welcome: { text: \"東京へようこそ！\", lang: \"ja\", english: \"Welcome to Tokyo!\" }\n  }\n];\n\nconst COMMANDS = [\n  {\n    transcript: \"What's the weather?\",\n    respond: (city, local) => `It's ${local.temperature} and ${city.conditionInSentence} in ${city.name}.`\n  },\n  {\n    transcript: \"What time is it?\",\n    respond: (city, local) => `It's ${local.time} in ${city.name}.`\n  },\n  {\n    transcript: \"Find coffee near me.\",\n    respond: (city, local) => `${local.coffee}.`\n  },\n  {\n    transcript: \"Set a timer for 5 minutes.\",\n    respond: () => \"Timer set for 5 minutes.\",\n    savedData: \"timer stored: 5 min\"\n  }\n];\n\n// Face ID results are simulated. \"unsure\" and \"no-match\" show the same message on purpose:\n// the phone can't tell the user why it failed.\nconst FACES = {\n  owner: { result: \"match\", logResult: \"face matched saved face: phone unlocked\" },\n  \"owner-sunglasses\": { result: \"unsure\", logResult: \"match unsure: asked for passcode\" },\n  \"someone-else\": { result: \"no-match\", logResult: \"no match: phone stays locked\" }\n};\n\nconst TEXT = {\n  speak: \"Speak\",\n  listening: \"Listening...\",\n  pickUp: \"Pick up phone\",\n  scanning: \"Scanning face...\",\n  locked: \"Locked\",\n  unlocked: \"Unlocked\",\n  notRecognized: \"Face not recognized. Enter passcode.\",\n  loadError: \"This activity couldn't load. Try refreshing the page.\"\n};\n\nconst ELEMENT_IDS = [\n  \"light-slider\", \"light-value\", \"location-select\", \"speak-button\", \"speak-button-text\",\n  \"read-aloud\", \"read-aloud-row\", \"pickup-button\", \"pickup-button-text\", \"reset-button\",\n  \"phone-screen\", \"brightness-hud\", \"hud-fill\", \"hud-value\", \"lock-status\", \"lock-icon\", \"lock-text\",\n  \"screen-time-wrap\", \"screen-time\", \"screen-day\", \"screen-city\", \"screen-weather\",\n  \"weather-icon\", \"screen-temp\", \"screen-condition\", \"screen-welcome\",\n  \"welcome-text\", \"welcome-english\", \"screen-nearby\", \"nearby-text\", \"voice-overlay\", \"voice-listening\",\n  \"bubble-user\", \"bubble-assistant\", \"voice-transcript\", \"voice-response\", \"voice-done\", \"announcer\"\n];\n\nconst loadTime = Date.now();\nconst speechSupported = \"speechSynthesis\" in window && typeof window.SpeechSynthesisUtterance === \"function\";\nlet formatters;\nlet elements;\nlet state;\nlet lastCommittedLight;\nlet listeningTimer = null;\nlet replyTimer = null;\nlet scanTimer = null;\nlet hudTimer = null;\n\nfunction createInitialState() {\n  return {\n    light: CONFIG.defaultLight,\n    cityId: CONFIG.defaultCityId,\n    voiceIndex: 0,\n    voiceStatus: \"idle\",\n    lastCommand: null,\n    replyShown: false,\n    readAloud: true,\n    face: \"owner\",\n    lockStatus: \"locked\",\n  };\n}\n\nfunction createTemperatureFormatter(locale) {\n  try {\n    return new Intl.NumberFormat(locale, { style: \"unit\", unit: \"fahrenheit\", unitDisplay: \"short\" });\n  } catch (error) {\n    const plain = new Intl.NumberFormat(locale);\n    return { format: (value) => `${plain.format(value)}°F` };\n  }\n}\n\nfunction createFormatters() {\n  const locale = document.documentElement.lang || \"en\";\n  return {\n    locale,\n    time: new Intl.DateTimeFormat(locale, { hour: \"numeric\", minute: \"2-digit\", timeZone: \"UTC\" }),\n    logTime: new Intl.DateTimeFormat(locale, {\n      hour: \"2-digit\",\n      minute: \"2-digit\",\n      second: \"2-digit\",\n      hourCycle: \"h23\",\n      timeZone: \"UTC\"\n    }),\n    number: new Intl.NumberFormat(locale),\n    percent: new Intl.NumberFormat(locale, { style: \"percent\", maximumFractionDigits: 0 }),\n    plural: new Intl.PluralRules(locale),\n    temperature: createTemperatureFormatter(locale)\n  };\n}\n\nfunction getElements() {\n  const found = {};\n  ELEMENT_IDS.forEach((id) => {\n    const element = document.getElementById(id);\n    if (!element) {\n      throw new Error(`Missing element: #${id}`);\n    }\n    const key = id.replace(/-([a-z])/g, (match, letter) => letter.toUpperCase());\n    found[key] = element;\n  });\n  return found;\n}\n\nfunction findCity(id) {\n  return CITIES.find((city) => city.id === id) || CITIES[0];\n}\n\nfunction getMode(light) {\n  if (light < CONFIG.darkModeThreshold) {\n    return \"dark\";\n  }\n  return light >= CONFIG.boostThreshold ? \"boost\" : \"light\";\n}\n\nfunction getBrightness(light) {\n  const mode = getMode(light);\n  if (mode === \"dark\") {\n    return 40 + light;\n  }\n  if (mode === \"light\") {\n    return Math.round(70 + (light - CONFIG.darkModeThreshold) * 0.5);\n  }\n  return 100;\n}\n\n// Brightness tints only the screen background, within ranges that keep text contrast above WCAG AA.\nfunction getScreenLightness(brightness, mode) {\n  if (mode === \"dark\") {\n    return 6 + ((brightness - 40) * 14) / 29;\n  }\n  return 80 + ((brightness - 70) * 20) / 30;\n}\n\nfunction getCoffeeMessage(count) {\n  if (count === 0) {\n    return \"No coffee shops open right now\";\n  }\n  const shown = formatters.number.format(count);\n  return formatters.plural.select(count) === \"one\"\n    ? `${shown} coffee shop open near you`\n    : `${shown} coffee shops open near you`;\n}\n\nfunction getLocalInfo(city) {\n  const totalMinutes = CONFIG.referenceMinutes + city.offsetMinutes;\n  const minutesInDay = 24 * 60;\n  const dayOffset = Math.floor(totalMinutes / minutesInDay);\n  const minuteOfDay = ((totalMinutes % minutesInDay) + minutesInDay) % minutesInDay;\n  const date = new Date(Date.UTC(2026, 0, 15, 0, minuteOfDay));\n  return {\n    time: formatters.time.format(date),\n    isTomorrow: dayOffset > 0,\n    temperature: formatters.temperature.format(city.temperatureF),\n    coffee: getCoffeeMessage(city.coffeeShopsOpen)\n  };\n}\n\nfunction getLogTimestamp() {\n  const start = Date.UTC(2026, 0, 15, 10, 42, 0);\n  return formatters.logTime.format(new Date(start + (Date.now() - loadTime)));\n}\n\nfunction announce(message) {\n  elements.announcer.textContent = \"\";\n  window.setTimeout(() => {\n    elements.announcer.textContent = message;\n  }, 50);\n}\n\nfunction highlight(targets) {\n  targets.forEach((target) => {\n    target.classList.remove(\"is-updated\");\n    void target.offsetWidth;\n    target.classList.add(\"is-updated\");\n  });\n}\n\nfunction speakAloud(text) {\n  if (!speechSupported || !state.readAloud) {\n    return false;\n  }\n  try {\n    window.speechSynthesis.cancel();\n    const utterance = new window.SpeechSynthesisUtterance(text);\n    utterance.lang = formatters.locale;\n    window.speechSynthesis.speak(utterance);\n    return true;\n  } catch (error) {\n    return false;\n  }\n}\n\nfunction stopSpeaking() {\n  if (speechSupported) {\n    window.speechSynthesis.cancel();\n  }\n}\n\n// Hidden outputs are written to the browser console, like a real app's developer log.\nfunction addLog(tag, message) {\n  console.info(`[${getLogTimestamp()}] ${tag.padEnd(7)} ${message}`);\n}\n\nfunction renderLight() {\n  const mode = getMode(state.light);\n  const brightness = getBrightness(state.light);\n  const lightness = getScreenLightness(brightness, mode);\n\n  elements.phoneScreen.classList.toggle(\"is-dark\", mode === \"dark\");\n  elements.phoneScreen.style.setProperty(\"--screen-bg\", `hsl(220, 15%, ${lightness.toFixed(1)}%)`);\n  elements.lightValue.textContent = formatters.number.format(state.light);\n  elements.hudFill.style.setProperty(\"--level\", String(brightness / 100));\n  elements.hudValue.textContent = formatters.percent.format(brightness / 100);\n}\n\nfunction renderIcon(container, iconName) {\n  const template = document.getElementById(`icon-${iconName}`);\n  if (template) {\n    container.replaceChildren(template.content.cloneNode(true));\n  } else {\n    container.replaceChildren();\n  }\n}\n\nfunction showBrightnessHud() {\n  elements.brightnessHud.classList.add(\"is-visible\");\n  if (hudTimer !== null) {\n    window.clearTimeout(hudTimer);\n  }\n  hudTimer = window.setTimeout(hideBrightnessHud, CONFIG.hudMs);\n}\n\nfunction hideBrightnessHud() {\n  hudTimer = null;\n  elements.brightnessHud.classList.remove(\"is-visible\");\n}\n\nfunction renderLock() {\n  const status = state.lockStatus;\n  const isScanning = status === \"scanning\";\n  const icons = { locked: \"lock-closed\", scanning: \"face-scan\", unlocked: \"lock-open\", failed: \"lock-closed\" };\n  const labels = { locked: TEXT.locked, scanning: TEXT.scanning, unlocked: TEXT.unlocked, failed: TEXT.notRecognized };\n\n  renderIcon(elements.lockIcon, icons[status]);\n  elements.lockText.textContent = labels[status];\n  elements.lockStatus.classList.toggle(\"is-failed\", status === \"failed\");\n\n  elements.pickupButton.setAttribute(\"aria-disabled\", String(isScanning));\n  elements.pickupButtonText.textContent = isScanning ? TEXT.scanning : TEXT.pickUp;\n}\n\nfunction renderLocation() {\n  const city = findCity(state.cityId);\n  const local = getLocalInfo(city);\n\n  elements.screenTime.textContent = local.time;\n  elements.screenDay.hidden = !local.isTomorrow;\n  elements.screenCity.textContent = city.name;\n  elements.screenTemp.textContent = local.temperature;\n  elements.screenCondition.textContent = city.condition;\n  renderIcon(elements.weatherIcon, city.icon);\n\n  elements.welcomeText.textContent = city.welcome.text;\n  elements.welcomeText.setAttribute(\"lang\", city.welcome.lang);\n  elements.welcomeEnglish.textContent = city.welcome.english;\n  elements.welcomeEnglish.hidden = city.welcome.english === \"\";\n\n  elements.nearbyText.textContent = local.coffee;\n}\n\nfunction renderVoice() {\n  const isListening = state.voiceStatus === \"listening\";\n  elements.speakButton.classList.toggle(\"is-listening\", isListening);\n  elements.speakButton.setAttribute(\"aria-disabled\", String(isListening));\n  elements.speakButtonText.textContent = isListening ? TEXT.listening : TEXT.speak;\n\n  elements.voiceOverlay.hidden = state.voiceStatus === \"idle\";\n  elements.voiceListening.hidden = !isListening;\n\n  if (state.lastCommand) {\n    elements.voiceTranscript.textContent = state.lastCommand.transcript;\n    elements.voiceResponse.textContent = state.lastCommand.response;\n  }\n  elements.bubbleUser.hidden = !state.lastCommand;\n  elements.bubbleAssistant.hidden = !state.lastCommand || !state.replyShown;\n}\n\nfunction renderAll() {\n  elements.lightSlider.value = String(state.light);\n  elements.locationSelect.value = state.cityId;\n  elements.readAloud.checked = state.readAloud;\n  document.querySelectorAll('input[name=\"face\"]').forEach((input) => {\n    input.checked = input.value === state.face;\n  });\n  renderLight();\n  renderLock();\n  renderLocation();\n  renderVoice();\n}\n\nfunction clearVoiceTimers() {\n  if (listeningTimer !== null) {\n    window.clearTimeout(listeningTimer);\n    listeningTimer = null;\n  }\n  if (replyTimer !== null) {\n    window.clearTimeout(replyTimer);\n    replyTimer = null;\n  }\n}\n\nfunction closeVoice() {\n  clearVoiceTimers();\n  stopSpeaking();\n  state.voiceStatus = \"idle\";\n  state.lastCommand = null;\n  state.replyShown = false;\n  renderVoice();\n}\n\nfunction getLightAnnouncement() {\n  const light = formatters.number.format(state.light);\n  const brightness = formatters.percent.format(getBrightness(state.light) / 100);\n  const mode = getMode(state.light);\n  if (mode === \"dark\") {\n    return `Light level ${light}. Dark mode on. Brightness ${brightness}.`;\n  }\n  if (mode === \"boost\") {\n    return `Light level ${light}. Bright light: screen boosted. Brightness ${brightness}.`;\n  }\n  return `Light level ${light}. Light mode. Brightness ${brightness}.`;\n}\n\nfunction commitLight(value) {\n  const wasDark = getMode(lastCommittedLight) === \"dark\";\n  state.light = value;\n  renderLight();\n\n  const isDark = getMode(value) === \"dark\";\n  const theme = isDark ? \"dark\" : \"light\";\n  addLog(\"SENSOR\", `light=${value}`);\n  addLog(\"DISPLAY\", `theme=${theme} brightness=${getBrightness(value)}%`);\n  if (wasDark !== isDark) {\n    addLog(\"DISPLAY\", isDark ? \"dark mode on\" : \"dark mode off\");\n  }\n  addLog(\"SAVE\", \"brightness preference stored\");\n\n  lastCommittedLight = value;\n  announce(getLightAnnouncement());\n}\n\nfunction handleSliderInput() {\n  state.light = Number(elements.lightSlider.value);\n  renderLight();\n  showBrightnessHud();\n}\n\nfunction handleSliderChange() {\n  commitLight(Number(elements.lightSlider.value));\n  showBrightnessHud();\n}\n\nfunction handleSliderKeydown(event) {\n  if (event.key !== \"PageUp\" && event.key !== \"PageDown\") {\n    return;\n  }\n  event.preventDefault();\n  const step = event.key === \"PageUp\" ? CONFIG.pageStep : -CONFIG.pageStep;\n  const value = Math.min(100, Math.max(0, state.light + step));\n  elements.lightSlider.value = String(value);\n  commitLight(value);\n  showBrightnessHud();\n}\n\nfunction handleLocationChange() {\n  if (state.voiceStatus !== \"idle\") {\n    closeVoice();\n  }\n  state.cityId = elements.locationSelect.value;\n  const city = findCity(state.cityId);\n  renderLocation();\n\n  addLog(\"SENSOR\", `location=${city.name}`);\n  addLog(\"SEND\", \"location shared with weather service\");\n  addLog(\"SEND\", \"location shared with places service\");\n  addLog(\"SAVE\", `added ${city.name} to location history`);\n  addLog(\"DISPLAY\", `welcome message shown in the local language (${city.welcome.lang})`);\n  addLog(\"DISPLAY\", \"time, weather, and coffee shops updated\");\n\n  const local = getLocalInfo(city);\n  const message = local.isTomorrow\n    ? `Location changed to ${city.name}. It's ${local.time} tomorrow, ${local.temperature} and ${city.conditionInSentence}. ${local.coffee}.`\n    : `Location changed to ${city.name}. It's ${local.time}, ${local.temperature} and ${city.conditionInSentence}. ${local.coffee}.`;\n  announce(message);\n  highlight([\n    elements.screenTimeWrap,\n    elements.screenCity,\n    elements.screenWeather,\n    elements.screenWelcome,\n    elements.screenNearby\n  ]);\n}\n\nfunction showReply() {\n  replyTimer = null;\n  state.replyShown = true;\n  renderVoice();\n  addLog(\"DISPLAY\", \"assistant reply shown\");\n\n  const { transcript, response } = state.lastCommand;\n  if (speakAloud(response)) {\n    addLog(\"DISPLAY\", \"assistant reply read out loud\");\n  }\n  announce(`You said: ${transcript} Assistant: ${response}`);\n}\n\nfunction finishListening() {\n  listeningTimer = null;\n  const command = COMMANDS[state.voiceIndex];\n  const city = findCity(state.cityId);\n  const response = command.respond(city, getLocalInfo(city));\n\n  state.voiceIndex = (state.voiceIndex + 1) % COMMANDS.length;\n  state.voiceStatus = \"responded\";\n  state.lastCommand = { transcript: command.transcript, response };\n  state.replyShown = false;\n  renderVoice();\n\n  const seconds = formatters.number.format(CONFIG.listeningMs / 1000);\n  addLog(\"SENSOR\", `microphone off (${seconds}s)`);\n  addLog(\"SEND\", \"audio sent for transcription\");\n  addLog(\"SAVE\", `transcript stored: \"${command.transcript}\"`);\n  if (command.savedData) {\n    addLog(\"SAVE\", command.savedData);\n  }\n\n  replyTimer = window.setTimeout(showReply, CONFIG.replyDelayMs);\n}\n\nfunction handleSpeak() {\n  if (state.voiceStatus === \"listening\") {\n    return;\n  }\n  clearVoiceTimers();\n  stopSpeaking();\n  state.voiceStatus = \"listening\";\n  state.lastCommand = null;\n  state.replyShown = false;\n  renderVoice();\n  addLog(\"SENSOR\", \"microphone on\");\n  announce(TEXT.listening);\n  listeningTimer = window.setTimeout(finishListening, CONFIG.listeningMs);\n}\n\nfunction handleFaceChange(event) {\n  state.face = event.target.value;\n}\n\nfunction finishScan() {\n  scanTimer = null;\n  const face = FACES[state.face];\n  const unlocked = face.result === \"match\";\n  state.lockStatus = unlocked ? \"unlocked\" : \"failed\";\n  renderLock();\n\n  addLog(\"SENSOR\", \"front camera off\");\n  addLog(\"DISPLAY\", face.logResult);\n  addLog(\"SAVE\", `unlock attempt logged (${unlocked ? \"success\" : \"failed\"})`);\n  addLog(\"SAVE\", \"face scan checked on this phone, never sent anywhere\");\n\n  announce(unlocked ? \"Face matched. Phone unlocked.\" : TEXT.notRecognized);\n  highlight([elements.lockStatus]);\n}\n\nfunction handlePickUp() {\n  if (state.lockStatus === \"scanning\") {\n    return;\n  }\n  state.lockStatus = \"scanning\";\n  renderLock();\n  addLog(\"SENSOR\", \"phone picked up (motion sensor)\");\n  addLog(\"SENSOR\", \"front camera and depth sensor on\");\n  announce(TEXT.scanning);\n  scanTimer = window.setTimeout(finishScan, CONFIG.scanMs);\n}\n\nfunction handleDone() {\n  closeVoice();\n  elements.speakButton.focus();\n}\n\nfunction handleReadAloudChange() {\n  state.readAloud = elements.readAloud.checked;\n  if (!state.readAloud) {\n    stopSpeaking();\n  }\n}\n\nfunction handleReset() {\n  clearVoiceTimers();\n  stopSpeaking();\n  if (scanTimer !== null) {\n    window.clearTimeout(scanTimer);\n    scanTimer = null;\n  }\n  if (hudTimer !== null) {\n    window.clearTimeout(hudTimer);\n  }\n  hideBrightnessHud();\n  const { readAloud } = state;\n  state = createInitialState();\n  state.readAloud = readAloud;\n  lastCommittedLight = state.light;\n\n  renderAll();\n  addLog(\"DISPLAY\", \"panel reset\");\n  announce(\"Panel reset.\");\n  highlight(Array.from(document.querySelectorAll(\".trackable\")));\n}\n\nfunction populateLocations() {\n  CITIES.forEach((city) => {\n    const option = document.createElement(\"option\");\n    option.value = city.id;\n    option.textContent = city.name;\n    elements.locationSelect.append(option);\n  });\n}\n\nfunction bindEvents() {\n  elements.lightSlider.addEventListener(\"input\", handleSliderInput);\n  elements.lightSlider.addEventListener(\"change\", handleSliderChange);\n  elements.lightSlider.addEventListener(\"keydown\", handleSliderKeydown);\n  elements.locationSelect.addEventListener(\"change\", handleLocationChange);\n  elements.speakButton.addEventListener(\"click\", handleSpeak);\n  elements.voiceDone.addEventListener(\"click\", handleDone);\n  elements.pickupButton.addEventListener(\"click\", handlePickUp);\n  document.querySelectorAll('input[name=\"face\"]').forEach((input) => {\n    input.addEventListener(\"change\", handleFaceChange);\n  });\n  elements.readAloud.addEventListener(\"change\", handleReadAloudChange);\n  elements.resetButton.addEventListener(\"click\", handleReset);\n}\n\nfunction init() {\n  formatters = createFormatters();\n  elements = getElements();\n  state = createInitialState();\n  lastCommittedLight = state.light;\n\n  elements.readAloudRow.hidden = !speechSupported;\n  populateLocations();\n  renderAll();\n\n  const city = findCity(state.cityId);\n  addLog(\"SENSOR\", `light=${state.light}`);\n  addLog(\"SENSOR\", `location=${city.name}`);\n  addLog(\"DISPLAY\", `theme=${getMode(state.light) === \"dark\" ? \"dark\" : \"light\"} brightness=${getBrightness(state.light)}%`);\n\n  bindEvents();\n}\n\nfunction showLoadError(error) {\n  const box = document.getElementById(\"app-error\");\n  if (box) {\n    box.textContent = TEXT.loadError;\n    box.hidden = false;\n  }\n  console.error(error);\n}\n\ntry {\n  init();\n} catch (error) {\n  showLoadError(error);\n}\n",
