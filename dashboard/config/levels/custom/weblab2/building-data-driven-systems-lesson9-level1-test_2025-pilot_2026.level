      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>ColorWall Paint Studio</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n\n<body>\n  <header class=\"page-header\">\n    <h1>ColorWall Paint Studio</h1>\n    <p class=\"tagline\">Search paint swatches by color name.</p>\n  </header>\n\n  <main>\n    <section class=\"controls\">\n      <label for=\"search\" class=\"search-label\">Search paints:</label>\n      <input id=\"search\" type=\"text\" placeholder=\"Try blue, sage, pink...\">\n      <button id=\"searchBtn\">Search</button>\n      <button id=\"clearBtn\" class=\"secondary\">Clear</button>\n    </section>\n\n    <section class=\"summary\" aria-live=\"polite\">\n      <p>\n        Showing <span id=\"matchCount\">0</span> of <span id=\"totalCount\">0</span> paint colors.\n      </p>\n    </section>\n\n    <section>\n      <h2>Paint Swatches</h2>\n      <div id=\"paintGrid\" class=\"paint-grid\"></div>\n    </section>\n  </main>\n\n  <script src=\"data.js\"></script>\n  <script src=\"helpers.js\"></script>\n  <script src=\"script.js\"></script>\n</body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  padding: 0;\n  font-family: Inter, Arial, Helvetica, sans-serif;\n  background-color: #f6f3ee;\n  color: #191919;\n}\n\n/* Header */\n.page-header {\n  background-color: #ffffff;\n  border-bottom: 1px solid #e5ded5;\n  padding: 20px 18px;\n}\n\n.page-header h1 {\n  margin: 0;\n  font-size: 1.65rem;\n  letter-spacing: -0.03em;\n}\n\n.tagline {\n  margin: 6px 0 0;\n  font-size: 0.95rem;\n  color: #6f675f;\n}\n\n/* Layout */\nmain {\n  max-width: 420px;\n  margin: 0 auto;\n  padding: 18px 14px 36px;\n}\n\n/* Search panel */\n.controls {\n  background-color: #ffffff;\n  border: 1px solid #e5ded5;\n  border-radius: 18px;\n  padding: 14px;\n  margin-bottom: 14px;\n  box-shadow: 0 8px 24px rgba(70, 55, 38, 0.06);\n}\n\n.search-label {\n  display: block;\n  font-size: 0.85rem;\n  font-weight: 800;\n  margin-bottom: 8px;\n  color: #2b2926;\n}\n\n#search {\n  width: 100%;\n  padding: 12px 13px;\n  font-size: 1rem;\n  border: 1px solid #d8cfc4;\n  border-radius: 999px;\n  outline: none;\n  margin-bottom: 10px;\n  background-color: #fbfaf8;\n}\n\n#search:focus {\n  border-color: #2f6f56;\n  box-shadow: 0 0 0 3px rgba(47, 111, 86, 0.12);\n}\n\nbutton {\n  padding: 10px 14px;\n  font-size: 0.95rem;\n  border: none;\n  border-radius: 999px;\n  background-color: #191919;\n  color: #fff;\n  cursor: pointer;\n  font-weight: 700;\n  margin-right: 6px;\n}\n\nbutton.secondary {\n  background-color: #eee8df;\n  color: #2b2926;\n}\n\nbutton:hover {\n  opacity: 0.9;\n}\n\n/* Summary */\n.summary {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  color: #6f675f;\n  font-size: 0.9rem;\n  margin-bottom: 18px;\n}\n\n.summary p {\n  margin: 0;\n}\n\nh2 {\n  font-size: 1.15rem;\n  margin: 0 0 12px;\n}\n\n/* Paint grid */\n.paint-grid {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  gap: 12px;\n}\n\n/* Paint cards */\n.paint-card {\n  background-color: #ffffff;\n  border: 1px solid #e1d9cf;\n  border-radius: 16px;\n  overflow: hidden;\n  box-shadow: 0 8px 20px rgba(70, 55, 38, 0.07);\n}\n\n.paint-swatch {\n  height: 140px;\n  border-bottom: 1px solid #eee7df;\n}\n\n.paint-info {\n  padding: 12px;\n}\n\n.paint-name {\n  margin: 0 0 4px;\n  font-size: 0.98rem;\n  font-weight: 900;\n  letter-spacing: -0.02em;\n}\n\n.paint-family {\n  margin: 0 0 8px;\n  font-size: 0.78rem;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  color: #8a8076;\n}\n\n.paint-hex {\n  display: inline-block;\n  margin: 0;\n  font-family: \"Courier New\", monospace;\n  font-size: 0.78rem;\n  color: #444;\n  background-color: #f4efe8;\n  padding: 4px 7px;\n  border-radius: 999px;\n}\n\n/* Wider screens */\n@media (min-width: 700px) {\n  main {\n    max-width: 980px;\n    padding: 26px 22px 48px;\n  }\n\n  .controls {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n\n  .search-label {\n    margin-bottom: 0;\n    white-space: nowrap;\n  }\n\n  #search {\n    margin-bottom: 0;\n  }\n\n  .paint-grid {\n    grid-template-columns: repeat(4, 1fr);\n    gap: 18px;\n  }\n\n  .paint-swatch {\n    height: 190px;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const searchInput = document.getElementById(\"search\");\n\nconst matchCount = document.getElementById(\"matchCount\");\nconst totalCount = document.getElementById(\"totalCount\");\n\nconst paintGrid = document.getElementById(\"paintGrid\");\n\nlet displayPaints = paints;\n\nconst renderPaints = () => {\n  paintGrid.innerHTML = \"\";\n\n  displayPaints.map((paint) => {\n    createPaintCard(paint);\n  });\n\n  matchCount.textContent = displayPaints.length;\n  totalCount.textContent = paints.length;\n};\n\n// Search\nconst searchColors = () => {\n    \n  const query = searchInput.value.toLowerCase();\n  displayPaints = [];\n  \n  paints.map((paint) => {\n    const paintName = paint.name.toLowerCase();\n    const paintFamily = paint.family.toLowerCase();\n    \n    if (paintName.includes(query) || paintFamily.includes(query)) {\n      displayPaints.push(paint);\n    }\n  });\n\n  renderPaints();\n};\n\n\n// Clear\nconst clearSearch = () => {\n  searchInput.value = \"\";\n  displayPaints = paints;\n  renderPaints();\n};\n\n// Event Handlers\ndocument.getElementById(\"searchBtn\").addEventListener(\"click\", searchColors);\ndocument.getElementById(\"clearBtn\").addEventListener(\"click\", clearSearch);\n\n// First page load\nrenderPaints();\n\n",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
          "name": "data.js",
          "contents": "const paints = [\n  {\n    name: \"Papyrus Veil\",\n    code: \"CW-010\",\n    family: \"White\",\n    finish: \"Matte\",\n    hex: \"#F3EBD8\"\n  },\n  {\n    name: \"Vanilla Linen\",\n    code: \"CW-024\",\n    family: \"White\",\n    finish: \"Eggshell\",\n    hex: \"#EFE6D2\"\n  },\n  {\n    name: \"Oat Milk\",\n    code: \"NT-101\",\n    family: \"Neutral\",\n    finish: \"Matte\",\n    hex: \"#E8DDC8\"\n  },\n  {\n    name: \"Warm Stone\",\n    code: \"NT-118\",\n    family: \"Neutral\",\n    finish: \"Satin\",\n    hex: \"#C9B8A3\"\n  },\n\n  {\n    name: \"Clay Blush\",\n    code: \"PK-204\",\n    family: \"Pink\",\n    finish: \"Eggshell\",\n    hex: \"#D7A7A0\"\n  },\n  {\n    name: \"Rose Plaster\",\n    code: \"PK-219\",\n    family: \"Pink\",\n    finish: \"Matte\",\n    hex: \"#C98F8A\"\n  },\n  {\n    name: \"Terracotta Tile\",\n    code: \"RD-301\",\n    family: \"Red\",\n    finish: \"Satin\",\n    hex: \"#B45A45\"\n  },\n  {\n    name: \"Brick Dust\",\n    code: \"RD-316\",\n    family: \"Red\",\n    finish: \"Matte\",\n    hex: \"#8F4638\"\n  },\n\n  {\n    name: \"Sage Wash\",\n    code: \"GN-402\",\n    family: \"Green\",\n    finish: \"Matte\",\n    hex: \"#A9B89B\"\n  },\n  {\n    name: \"Olive Grove\",\n    code: \"GN-428\",\n    family: \"Green\",\n    finish: \"Eggshell\",\n    hex: \"#77825C\"\n  },\n  {\n    name: \"Forest Library\",\n    code: \"GN-455\",\n    family: \"Green\",\n    finish: \"Satin\",\n    hex: \"#3F5A46\"\n  },\n  {\n    name: \"Mint Glass\",\n    code: \"GN-471\",\n    family: \"Green\",\n    finish: \"Matte\",\n    hex: \"#C7DCCB\"\n  },\n\n  {\n    name: \"Sky Room\",\n    code: \"BL-502\",\n    family: \"Blue\",\n    finish: \"Eggshell\",\n    hex: \"#9DC6E0\"\n  },\n  {\n    name: \"Harbor Mist\",\n    code: \"BL-527\",\n    family: \"Blue\",\n    finish: \"Matte\",\n    hex: \"#6F93A8\"\n  },\n  {\n    name: \"Deep Pool\",\n    code: \"BL-548\",\n    family: \"Blue\",\n    finish: \"Satin\",\n    hex: \"#28506D\"\n  },\n  {\n    name: \"Ink Night\",\n    code: \"BL-566\",\n    family: \"Blue\",\n    finish: \"Matte\",\n    hex: \"#172B45\"\n  },\n\n  {\n    name: \"Lilac Fog\",\n    code: \"PR-601\",\n    family: \"Purple\",\n    finish: \"Matte\",\n    hex: \"#B8AFCB\"\n  },\n  {\n    name: \"Plum Velvet\",\n    code: \"PR-637\",\n    family: \"Purple\",\n    finish: \"Satin\",\n    hex: \"#5D456B\"\n  },\n\n  {\n    name: \"Soft Charcoal\",\n    code: \"GY-702\",\n    family: \"Gray\",\n    finish: \"Eggshell\",\n    hex: \"#5D6364\"\n  },\n  {\n    name: \"Graphite\",\n    code: \"GY-718\",\n    family: \"Gray\",\n    finish: \"Satin\",\n    hex: \"#303437\"\n  }\n];",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "helpers.js",
          "contents": "const createPaintCard = (paint) => {\n  const paintGrid = document.getElementById(\"paintGrid\");\n\n  const card = document.createElement(\"article\");\n  card.className = \"paint-card\";\n\n  const swatch = document.createElement(\"div\");\n  swatch.className = \"paint-swatch\";\n  swatch.style.backgroundColor = paint.hex;\n\n  const info = document.createElement(\"div\");\n  info.className = \"paint-info\";\n\n  const name = document.createElement(\"p\");\n  name.className = \"paint-name\";\n  name.textContent = paint.name;\n\n  const family = document.createElement(\"p\");\n  family.className = \"paint-family\";\n  family.textContent = paint.family;\n\n  const hex = document.createElement(\"p\");\n  hex.className = \"paint-hex\";\n  hex.textContent = paint.hex;\n\n  info.appendChild(name);\n  info.appendChild(family);\n  info.appendChild(hex);\n\n  card.appendChild(swatch);\n  card.appendChild(info);\n\n  paintGrid.appendChild(card);\n};",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "3",
        "4"
      ]
    },
