    "display_name": "Headings",
    "bubble_choice_description": "Learn about Heading elements, like &lt;h1&gt;, &lt;h3&gt;, etc",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html>\n  <body>\n    <h1>Some of my favorite things</h1>\n    \n    <h2>Places</h2>\n    <p>I really like Tucson because it has the Biosphere</p>\n\n    <h3>Foods</h3>\n    <p>hot cheetos are delicious, but they make my fingers red</p>\n\n    <h4>Drinks</h4>\n    <p>jasmine boba tea is delicious</p>\n\n\n    \n  </body>\n</html>\n  ",
          "active": true,
          "folderId": "0"
