  "properties": {
    "encrypted": "false",
    "display_name": "Analyze Priority Rule",
    "long_instructions": "## Do This:\r\n\r\n1. Run the app and test different inputs. What do you notice?\r\n\r\n2. Read the code and figure out how the rule works.\r\n\r\n3. Use AI (if needed) to explain the logic. Make sure to check if the explanation makes sense.\r\n\r\n4. Refactor the code to use a combined Boolean expression with `!`, `&&`, and `||`.\r\n",
    "thumbnail_url": "https://images.code.org/294ca4e23a4516bd9ac03f5ad6433857-triage.png",
    "submittable": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
    "disable_edit_run_for_submission": "false",
