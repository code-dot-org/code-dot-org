          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>Panda Fan Club</title>\n    <style>\n      body {\n        background-color: #d8f0d0;\n        font-family: Arial, sans-serif;\n        text-align: center;\n        padding: 20px;\n      }\n      h1 {\n        color: #1f5f2e;\n      }\n      .food {\n        color: #1f5f2e;\n      }\n      .facts {\n        color: #ff0000;\n      }\n      button {\n        background-color: #1f5f2e;\n        color: white;\n        border: none;\n        border-radius: 20px;\n        padding: 12px 24px;\n        font-size: 18px;\n      }\n    </style>\n  </head>\n  <body>\n    <h1>Panda Fan Culb</h1>\n    <p>\n      Is it snack time yet? I just finished my bamboo, and I'm already\n      thinking about more bamboo. Welcome to the club!\n    </p>\n\n    <h2 class=\"food\">Our Favorite Food</h2>\n    <p>Bamboo for breakfast, bamboo for lunch, and bamboo for dinner.</p>\n\n    <h2 class=\"facts\">Panda Fun Facts</h2>\n    <p>Pandas can spend up to 14 hours a day eating.</p>\n\n    <button>Meet the koalas</button>\n  </body>\n</html>\n",
