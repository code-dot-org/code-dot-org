  "properties": {
    "require_edit_to_continue": "false",
    "encrypted": "false",
    "long_instructions": "In this simulation, you can run a neural network on a processing unit of your choice.\r\n\r\n**☑️ Do This:**\r\n- Choose a processor. Then, choose the number of cores it has.\r\n- Run the network. Pay attention to how long it took.\r\n- Repeat, trying different processors and core counts. You’ll answer a question about this activity in the following level.\r\n",
    "offer_browser_tts": "false",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "true",
    "widget_view": "true",
    "initial_view_mode": "preview",
    "hide_ai_tutor": "true",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "placeholderText": "",
      "multipleChoiceOptions": [
