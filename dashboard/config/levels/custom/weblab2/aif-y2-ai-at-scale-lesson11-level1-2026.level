    "start_sources": {
      "folders": {
        "1": {
          "id": "1",
          "name": "components",
          "parentId": "0",
          "open": true
        }
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Processing Units</title>\n    <link rel=\"stylesheet\" href=\"styles.css\" />\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Geist+Mono:ital,wght@0,100..900;1,100..900&family=Geist:ital,wght@0,100..900;1,100..900&family=Space+Grotesk:wght@300..700&display=swap\"\n      rel=\"stylesheet\"\n    />\n  </head>\n  <body>\n    <header>\n      <h1>Processing Units</h1>\n    </header>\n    <main>\n      <section class=\"hardware-section\" aria-labelledby=\"hardware-heading\">\n        <div class=\"card-panel\">\n          <h2 class=\"heading\" id=\"hardware-heading\">Hardware</h2>\n        </div>\n\n        <div class=\"hardware-picker\">\n          <fieldset class=\"choice-group\">\n            <legend class=\"choice-group__legend\">Processor</legend>\n            <div class=\"processor-options\">\n              <label class=\"processor-option\">\n                <input\n                  class=\"processor-option__input\"\n                  type=\"radio\"\n                  name=\"processor\"\n                  value=\"cpu\"\n                  checked\n                />\n                <span class=\"processor-option__name\">CPU</span>\n                <span class=\"processor-option__full\">Central processing unit</span>\n              </label>\n              <label class=\"processor-option\">\n                <input\n                  class=\"processor-option__input\"\n                  type=\"radio\"\n                  name=\"processor\"\n                  value=\"gpu\"\n                />\n                <span class=\"processor-option__name\">GPU</span>\n                <span class=\"processor-option__full\">Graphics processing unit</span>\n              </label>\n            </div>\n          </fieldset>\n\n          <fieldset class=\"choice-group\">\n            <legend class=\"choice-group__legend\">Cores</legend>\n            <!-- One row per core count, cloned from #core-option-template. -->\n            <div class=\"core-options\"></div>\n          </fieldset>\n        </div>\n\n        <button type=\"button\" class=\"run-button\">Run</button>\n\n        <div class=\"run-history\">\n          <h3 class=\"run-history__heading\" id=\"run-history-heading\">Previous runs</h3>\n          <div class=\"run-history__runs\">\n            <p class=\"run-history__empty\">No runs yet.</p>\n            <ol class=\"run-history__list\" aria-labelledby=\"run-history-heading\"></ol>\n          </div>\n        </div>\n      </section>\n\n      <section\n        class=\"network-section\"\n        aria-labelledby=\"network-heading\"\n        aria-describedby=\"network-description\"\n      >\n        <div class=\"card-panel\">\n          <h2 class=\"heading\" id=\"network-heading\">Neural Network</h2>\n        </div>\n\n        <div class=\"network\">\n          <!-- Drawn by network-diagram.js. The list of layers beneath it, the\n               description after that, and the progress bar say in words what\n               it shows. -->\n          <canvas class=\"network__canvas\" aria-hidden=\"true\"></canvas>\n          <ol class=\"network__layers\" aria-label=\"Layers\"></ol>\n          <!-- Set by app.js, to match the hardware chosen. -->\n          <p class=\"visually-hidden\" id=\"network-description\"></p>\n        </div>\n\n        <div class=\"progress\">\n          <div class=\"progress__text\">\n            <span class=\"progress__label\" id=\"progress-label\">Progress</span>\n            <span class=\"progress__stage\" id=\"progress-stage\">Ready to run</span>\n          </div>\n          <div\n            class=\"progress__bar\"\n            role=\"progressbar\"\n            aria-labelledby=\"progress-label\"\n            aria-valuemin=\"0\"\n            aria-valuemax=\"100\"\n            aria-valuenow=\"0\"\n          >\n            <div class=\"progress__fill\"></div>\n          </div>\n        </div>\n\n        <dl class=\"results\">\n          <div class=\"results__item\">\n            <dt class=\"results__label\">Time</dt>\n            <dd class=\"results__value\" id=\"time-value\"></dd>\n            <dd class=\"results__note\">\n              <span class=\"results__note-line\" id=\"unit-note\"></span>\n              <span class=\"results__note-line\" id=\"slowdown-note\"></span>\n            </dd>\n          </div>\n        </dl>\n\n        <!-- What screen readers hear when a run starts and finishes. -->\n        <p class=\"visually-hidden\" id=\"status\" role=\"status\"></p>\n      </section>\n    </main>\n\n    <template id=\"core-option-template\">\n      <label class=\"core-option\">\n        <input class=\"core-option__input\" type=\"radio\" name=\"cores\" />\n        <span class=\"core-option__count\"></span>\n      </label>\n    </template>\n\n    <template id=\"layer-template\">\n      <li class=\"network__layer\">\n        <span class=\"network__layer-name\"></span>\n        <span class=\"network__layer-size\"></span>\n      </li>\n    </template>\n\n    <template id=\"run-template\">\n      <li class=\"run\">\n        <span class=\"run__hardware\"></span>\n        <span class=\"run__time\"></span>\n        <span class=\"run__bar\" aria-hidden=\"true\"><span class=\"run__fill\"></span></span>\n      </li>\n    </template>\n\n    <script type=\"module\" src=\"app.js\"></script>\n  </body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "app.js",
          "contents": "/**\n * app.js — the Processing Units controller.\n *\n * Wires together:\n *   - the hardware picker (CPU or GPU, and how many cores)\n *   - the network diagram, which animates a run as it goes\n *   - the progress bar and the inference time (plain DOM in index.html)\n *   - the run history, for comparing one run with the next\n *\n * Pressing \"Run\" starts a pretend inference (model.js) on the chosen hardware.\n * Every animation frame, the diagram, the progress bar, and the running clock\n * catch up with it; once it finishes, the time it took is shown, and the run\n * is added to the history.\n *\n * The times are real hardware's, all in nanoseconds so any two can be\n * compared, but the animation is slowed down so a run can be watched: a\n * million times for a CPU, more for a GPU. Beneath the time, the card says\n * what a nanosecond is and how much the animation was slowed.\n *\n * A student who prefers reduced motion (WCAG 2.3.3) waits just as long, but\n * sees nothing sweep or fill: each layer of the diagram, and the progress bar\n * with it, jumps forward only when that layer is finished, and the clock\n * stays blank until the time is known. The preference is checked on every\n * frame, so changing it partway through a run takes effect at once.\n *\n * While a run is going, the hardware can't be changed and \"Run\" does nothing.\n * The button is marked aria-disabled rather than disabled, so that a student\n * who pressed it keeps keyboard focus on it.\n */\n\nimport {\n  LAYERS,\n  PROCESSORS,\n  finishedFraction,\n  layerProgress,\n  runInference,\n} from \"./model.js\";\nimport { UNIT_MEANING, formatDuration } from \"./components/duration.js\";\nimport { createHardwarePicker } from \"./components/hardware-picker.js\";\nimport { createNetworkDiagram } from \"./components/network-diagram.js\";\nimport { createRunHistory } from \"./components/run-history.js\";\n\nconst numbers = new Intl.NumberFormat(\"en-US\");\nconst reducedMotion = window.matchMedia(\"(prefers-reduced-motion: reduce)\");\n\nconst runButton = document.querySelector(\".run-button\");\nconst layerList = document.querySelector(\".network__layers\");\nconst progressBar = document.querySelector(\".progress__bar\");\nconst progressFill = document.querySelector(\".progress__fill\");\nconst progressStage = document.getElementById(\"progress-stage\");\nconst timeValue = document.getElementById(\"time-value\");\nconst unitNote = document.getElementById(\"unit-note\");\nconst slowdownNote = document.getElementById(\"slowdown-note\");\nconst networkDescription = document.getElementById(\"network-description\");\nconst status = document.getElementById(\"status\");\n\nrenderLayerList();\n\nconst picker = createHardwarePicker(document.querySelector(\".hardware-picker\"), {\n  processors: PROCESSORS,\n  onChange: describeNetwork,\n});\n\nconst diagram = createNetworkDiagram(document.querySelector(\".network__canvas\"), {\n  sizes: LAYERS.map(({ size }) => size),\n  labels: layerList,\n});\n\nconst history = createRunHistory(document.querySelector(\".run-history\"), {\n  processors: PROCESSORS,\n});\n\nlet running = false;\n\nasync function run() {\n  if (running) return;\n  running = true;\n  const hardware = picker.getSelection();\n\n  picker.setDisabled(true);\n  runButton.setAttribute(\"aria-disabled\", \"true\");\n  runButton.textContent = \"Running…\";\n\n  // Set before the run starts, so the notes are up for the whole of it.\n  const { slowdown } = PROCESSORS[hardware.processor];\n  // \"Shown\", not \"animated\": with reduced motion, there is no animation.\n  unitNote.textContent = UNIT_MEANING;\n  slowdownNote.textContent = `This run is shown ${numbers.format(slowdown)}× slower than real time.`;\n  status.textContent =\n    `Running inference on a ${hardwareName(hardware)}, ` +\n    `shown ${numbers.format(slowdown)} times slower than real time.`;\n  showPlaceholder(timeValue);\ndescribeNetwork(picker.getSelection());\n\n  const { seconds } = await runInference(hardware, {\n    onProgress: (fraction, elapsed) => showProgress(hardware, fraction, elapsed),\n  });\n\n  timeValue.textContent = formatDuration(seconds);\n  progressStage.textContent = \"Done\";\n  history.add({ ...hardware, seconds });\n  status.textContent = `Finished in ${formatDuration(seconds)} on a ${hardwareName(hardware)}.`;\n\n  picker.setDisabled(false);\n  runButton.removeAttribute(\"aria-disabled\");\n  runButton.textContent = \"Run\";\n  running = false;\n}\n\nfunction showProgress(hardware, fraction, elapsed) {\n  const reduce = reducedMotion.matches;\n  let progress = layerProgress(fraction);\n  if (reduce) {\n    progress = progress.map((p) => (p >= 1 ? 1 : 0));\n    fraction = finishedFraction(progress);\n  }\n  diagram.show({ ...hardware, progress });\n\n  const percent = Math.floor(fraction * 100);\n  progressFill.style.width = `${fraction * 100}%`;\n  progressBar.setAttribute(\"aria-valuenow\", String(percent));\n\n  // The first layer not yet finished is the one being computed.\n  const layer = LAYERS[progress.findIndex((p) => p < 1)];\n  if (layer) {\n    progressStage.textContent = `Computing ${layer.name.toLowerCase()}`;\n    progressBar.setAttribute(\"aria-valuetext\", `${percent}%, computing ${layer.name.toLowerCase()}`);\n  } else {\n    progressBar.removeAttribute(\"aria-valuetext\");\n  }\n\n  // A running clock, counting up through the real run as it plays.\n  if (!reduce) timeValue.textContent = formatDuration(elapsed);\n}\n\n// The diagram's text alternative (WCAG 1.1.1): what the canvas shows that the\n// layer list and the progress bar don't — how the layers connect, and how the\n// chosen processor works through them. Not shown on screen; read as part of\n// the network's section.\nfunction describeNetwork({ processor, cores }) {\n  const count = numbers.format(cores);\n  const work =\n    processor === \"cpu\"\n      ? `On this CPU, ${count} cores compute ${count} neurons at a time, so each layer is worked through in batches of ${count}.`\n      : `On this GPU, ${count} cores share out the calculations for every neuron in a layer, so the whole layer is computed at once.`;\n  networkDescription.textContent = `Every neuron in each layer is connected to every neuron in the next layer. ${work}`;\n}\n\nfunction hardwareName({ processor, cores }) {\n  return `${PROCESSORS[processor].name} with ${numbers.format(cores)} cores`;\n}\n\nfunction renderLayerList() {\n  const template = document.getElementById(\"layer-template\");\n  layerList.replaceChildren(\n    ...LAYERS.map(({ name, size }) => {\n      const item = template.content.firstElementChild.cloneNode(true);\n      // A no-break space before the number, so a name that wraps on a narrow\n      // screen splits as \"Hidden / Layer 2\" rather than leave the \"2\" alone.\n      item.querySelector(\".network__layer-name\").textContent = name.replace(/ (\\d+)$/, \" $1\");\n      item.querySelector(\".network__layer-size\").textContent =\n        `${numbers.format(size)} ${size === 1 ? \"neuron\" : \"neurons\"}`;\n      return item;\n    }),\n  );\n}\n\n// A dash where there is no number yet, read as \"none yet\".\nfunction showPlaceholder(element) {\n  const dash = document.createElement(\"span\");\n  dash.setAttribute(\"aria-hidden\", \"true\");\n  dash.textContent = \"—\";\n  element.replaceChildren(dash, visuallyHidden(\"none yet\"));\n}\n\nfunction visuallyHidden(text) {\n  const element = document.createElement(\"span\");\n  element.className = \"visually-hidden\";\n  element.textContent = text;\n  return element;\n}\n\nrunButton.addEventListener(\"click\", run);\n\nshowPlaceholder(timeValue);\ndescribeNetwork(picker.getSelection());\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "model.js",
          "contents": "/**\n * model.js — a pretend neural network, and how long pretend hardware takes to\n * run it. Pure logic, no DOM.\n *\n * Nothing here runs a real network. `runInference` only works out how long the\n * chosen hardware would take, then plays that out slowed down, reporting its\n * progress along the way.\n *\n * The network is fully connected: every neuron takes in every value from the\n * layer before it, multiplies each by a weight, and adds the products up. So\n * each connection is one calculation, and a layer's share of the work is the\n * number of connections into it.\n */\n\nexport const LAYERS = [\n  { name: \"Input Layer\", size: 1024 },\n  { name: \"Hidden Layer 1\", size: 2048 },\n  { name: \"Hidden Layer 2\", size: 2048 },\n  { name: \"Output Layer\", size: 1 },\n];\n\n// The calculations into each layer after the input layer, in order.\nconst CALCULATIONS = LAYERS.slice(1).map((layer, i) => LAYERS[i].size * layer.size);\nconst TOTAL_CALCULATIONS = CALCULATIONS.reduce((total, count) => total + count, 0);\n\n/**\n * Core counts like those of real chips: the CPUs' from Apple's M-series, the\n * GPUs' rounded from the CUDA cores of NVIDIA's H-series (an H100 has 16,896).\n *\n * Speeds are each core's best case for neural-network math in 16-bit numbers,\n * where a calculation is one multiply-add:\n *   - A CPU core: about 100 billion a second (4 vector units, each doing 8\n *     multiply-adds a cycle, at about 3 GHz).\n *   - A GPU core: about 29 billion a second. An H100's tensor cores, built for\n *     exactly this math, manage 989 trillion operations a second, or about 495\n *     trillion multiply-adds, shared across its 16,896 CUDA cores.\n * These are peaks. A network this small, run on a single input, would in\n * practice spend most of its time reading weights from memory, and the gap\n * between the two would shrink.\n *\n * Real runs take millionths of a second or less, too quick to watch, so each\n * is animated slowed down, by a different factor for each processor. One\n * factor for both would leave either the CPUs waiting for minutes or the GPUs\n * over in a few thousandths of a second. The factor is shown beside the time.\n */\nexport const PROCESSORS = {\n  cpu: {\n    name: \"CPU\",\n    calculationsPerCorePerSecond: 100e9,\n    slowdown: 1_000_000,\n    cores: [8, 12, 16, 32],\n  },\n  gpu: {\n    name: \"GPU\",\n    calculationsPerCorePerSecond: 989.4e12 / 2 / 16_896,\n    slowdown: 25_000_000,\n    cores: [16_000, 24_000, 32_000],\n  },\n};\n\n/** How long `hardware`, a `{ processor, cores }`, takes to run the network. */\nexport function inferenceSeconds({ processor, cores }) {\n  return TOTAL_CALCULATIONS / (cores * PROCESSORS[processor].calculationsPerCorePerSecond);\n}\n\n/**\n * How far along each layer is, from 0 to 1, when `fraction` of the whole\n * network's work is done. The input layer is given, not computed, so it is\n * always done; each layer after it starts once the one before has finished.\n */\nexport function layerProgress(fraction) {\n  let remaining = fraction * TOTAL_CALCULATIONS;\n  return [\n    1,\n    ...CALCULATIONS.map((count) => {\n      const progress = Math.min(1, Math.max(0, remaining / count));\n      remaining -= count;\n      return progress;\n    }),\n  ];\n}\n\n/**\n * The share of the network's work in the layers that `progress` (as from\n * `layerProgress`) has finished, counting none of a layer still underway.\n */\nexport function finishedFraction(progress) {\n  const finished = CALCULATIONS.reduce(\n    (total, count, i) => (progress[i + 1] >= 1 ? total + count : total),\n    0,\n  );\n  return finished / TOTAL_CALCULATIONS;\n}\n\n/**\n * \"Run\" the network on `hardware`, slowed down by its processor's factor.\n * Calls `onProgress(fraction, seconds)` on every animation frame, where\n * `seconds` is how far into the real run the animation has reached, and\n * resolves with `{ seconds, slowdown }`: how long the real run took, and how\n * many times slower it was shown.\n */\nexport function runInference(hardware, { onProgress } = {}) {\n  const seconds = inferenceSeconds(hardware);\n  const { slowdown } = PROCESSORS[hardware.processor];\n  const duration = seconds * slowdown * 1000;\n  const start = performance.now();\n\n  return new Promise((resolve) => {\n    let frame = requestAnimationFrame(function tick() {\n      const fraction = Math.min(1, (performance.now() - start) / duration);\n      onProgress?.(fraction, fraction * seconds);\n      frame = requestAnimationFrame(tick);\n    });\n\n    // A timer rather than the frames, which stop while the tab is hidden.\n    setTimeout(() => {\n      cancelAnimationFrame(frame);\n      onProgress?.(1, seconds);\n      resolve({ seconds, slowdown });\n    }, duration);\n  });\n}\n",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "styles.css",
          "contents": "@import url(\"components/hardware-picker.css\");\n@import url(\"components/network-diagram.css\");\n@import url(\"components/run-history.css\");\n\n:root {\n  --gray-0: #fdfdfd;\n  --gray-50: #f9f9f9;\n  --gray-100: #f4f4f4;\n  --gray-150: #eeeeee;\n  --gray-200: #e5e5e5;\n  --gray-300: #d4d4d4;\n  --gray-400: #a3a3a3;\n  --gray-500: #737373;\n  --gray-600: #525252;\n  --gray-700: #404040;\n  --gray-800: #262626;\n  --gray-900: #171717;\n  --gray-950: #0a0a0a;\n  --purple-0: rgb(245, 244, 253);\n  --purple-100: rgb(234, 232, 251);\n  --purple-200: rgb(214, 210, 246);\n  --purple-300: rgb(192, 188, 240);\n  --purple-400: rgb(169, 163, 232);\n  --purple-500: rgb(105, 98, 210);\n  --purple-600: rgb(82, 75, 184);\n  --purple-700: rgb(59, 53, 153);\n  --purple-800: rgb(41, 35, 126);\n  --purple-900: rgb(30, 25, 113);\n  --mint-0: rgb(244, 252, 247);\n  --mint-100: rgb(230, 247, 237);\n  --mint-200: rgb(211, 240, 211);\n  --mint-300: rgb(184, 228, 196);\n  --mint-400: rgb(141, 207, 170);\n  --mint-500: rgb(91, 175, 138);\n  --mint-600: rgb(56, 140, 110);\n  --mint-700: rgb(34, 107, 86);\n  --mint-800: rgb(21, 74, 60);\n  --mint-900: rgb(12, 46, 38);\n}\n\nh1,\nh2,\nh3,\nh4,\nh5,\nh6,\np {\n  margin: 0;\n}\n\nbody {\n  align-items: center;\n  background-color: var(--gray-50);\n  box-sizing: border-box;\n  color: var(--purple-900);\n  display: flex;\n  flex-direction: column;\n  font-family: \"Geist\", sans-serif;\n  gap: 2em;\n  justify-content: center;\n  margin: 0;\n  min-height: 100vh;\n  padding: 1.5em 1em;\n}\n\nheader {\n  max-width: 34em;\n  text-align: center;\n}\n\nheader h1 {\n  font-family: \"Space Grotesk\", monospace;\n  font-weight: 700;\n}\n\n/* The hardware beside the network, or above it once there isn't room for\n   both: the network needs about 28em to stay legible. */\nmain {\n  align-items: stretch;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 1em;\n  justify-content: center;\n  max-width: 64em;\n  width: 100%;\n}\n\nsection {\n  background-color: var(--gray-0);\n  border-radius: 0.5em;\n  box-shadow: 0px 2px 2px rgba(0, 0, 0, 0.3);\n  box-sizing: border-box;\n  display: flex;\n  flex-direction: column;\n  gap: 1.25em;\n  padding: 1em;\n}\n\n.hardware-section {\n  flex: 1 1 15em;\n}\n\n.network-section {\n  flex: 3 1 28em;\n  /* Lets the network shrink below its flex basis on a narrow screen rather\n     than push the page sideways. */\n  min-width: 0;\n}\n\n.heading {\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 1rem;\n  font-weight: bold;\n}\n\n/* A panel across the top of a card, running to the card's edges and into its\n   rounded top corners, with a hairline where it meets the rest. */\n.card-panel {\n  background-color: var(--gray-100);\n  border-bottom: 1px solid var(--gray-200);\n  border-radius: 0.5em 0.5em 0 0;\n  margin: -1em -1em 0;\n  padding: 0.75em 1em;\n}\n\n/* ---------- Run button ---------- */\n\n.run-button {\n  background-color: var(--purple-900);\n  border: none;\n  border-radius: 0.5em;\n  color: var(--gray-0);\n  cursor: pointer;\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 1.1rem;\n  font-weight: 700;\n  padding: 0.75em;\n  width: 100%;\n}\n\n.run-button:hover {\n  background-color: var(--purple-700);\n}\n\n.run-button:focus-visible {\n  outline: 3px solid var(--purple-900);\n  outline-offset: 2px;\n}\n\n/* A lighter purple while running, still dark enough to keep \"Running…\" above\n   4.5:1 against it. */\n.run-button[aria-disabled=\"true\"] {\n  background-color: var(--purple-600);\n  cursor: progress;\n}\n\n/* ---------- Progress ---------- */\n\n.progress {\n  display: flex;\n  flex-direction: column;\n  gap: 0.4em;\n}\n\n.progress__text {\n  display: flex;\n  flex-wrap: wrap;\n  font-size: 0.875rem;\n  gap: 0.25em 1em;\n  justify-content: space-between;\n}\n\n.progress__label {\n  font-family: \"Space Grotesk\", monospace;\n  font-weight: 700;\n}\n\n.progress__stage {\n  color: var(--purple-700);\n}\n\n/* The track's border is what marks out the bar against the card (WCAG 1.4.11),\n   whether or not any of it is filled yet. */\n.progress__bar {\n  background-color: var(--gray-100);\n  border: 1px solid var(--gray-500);\n  border-radius: 999px;\n  height: 0.75em;\n  overflow: hidden;\n}\n\n.progress__fill {\n  background-color: var(--purple-600);\n  height: 100%;\n  width: 0;\n}\n\n/* ---------- Results ---------- */\n\n.results {\n  margin: 0;\n}\n\n.results__item {\n  background-color: var(--purple-0);\n  border-radius: 0.5em;\n  /* The time's size answers to this card's width (see .results__value). */\n  container: result / inline-size;\n  display: flex;\n  flex-direction: column;\n  gap: 0.2em;\n  padding: 0.6em 0.9em;\n}\n\n.results__label {\n  color: var(--purple-700);\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 0.8rem;\n  font-weight: 700;\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n}\n\n.results__value {\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 1.6rem;\n  font-variant-numeric: tabular-nums;\n  font-weight: 700;\n  margin: 0;\n}\n\n/* What the unit means, and how much the run was slowed down. Three lines held\n   open before the first run, since the second wraps on a phone, so the card\n   doesn't grow when they fill. */\n.results__note {\n  color: var(--purple-700);\n  font-size: 0.875rem;\n  line-height: 1.35;\n  margin: 0;\n  min-height: calc(3 * 1.35em);\n}\n\n.results__note-line {\n  display: block;\n}\n\n/* \"7,867 nanoseconds\", the longest time, wraps at full size in a card this\n   narrow (a 320px screen), and would make the card a line taller after a CPU\n   run than after a GPU one. A container query in ems, so enlarged text\n   (WCAG 1.4.4) shrinks it too. */\n@container result (max-width: 16em) {\n  .results__value {\n    font-size: 1.3rem;\n  }\n\n  /* Both notes wrap at this width, so four lines are held open, not three. */\n  .results__note {\n    min-height: calc(4 * 1.35em);\n  }\n}\n\n/* Read by screen readers, not shown. */\n.visually-hidden {\n  clip-path: inset(50%);\n  height: 1px;\n  overflow: hidden;\n  position: absolute;\n  white-space: nowrap;\n  width: 1px;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    transition: none !important;\n  }\n}\n",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "duration.js",
          "contents": "/**\n * duration.js — the very short times a run takes, written out for people.\n *\n * Every time is given in whole nanoseconds, whatever the hardware, so a CPU's\n * and a GPU's can be compared number to number: \"7,867 nanoseconds\" against\n * \"13 nanoseconds\". The unit is spelled out rather than abbreviated, since\n * \"ns\" means nothing to most students (or to a screen reader, which would\n * spell it out letter by letter).\n */\n\nconst NANOSECOND = 1e-9;\nconst numbers = new Intl.NumberFormat(\"en-US\", { maximumFractionDigits: 0 });\n\nexport const UNIT_MEANING = \"A nanosecond is a billionth of a second.\";\n\n/** `seconds` in words: \"7,867 nanoseconds\". */\nexport function formatDuration(seconds) {\n  return `${numbers.format(seconds / NANOSECOND)} nanoseconds`;\n}\n",
          "folderId": "1",
          "active": false
        },
        "6": {
          "id": "6",
          "name": "hardware-picker.css",
          "contents": ".hardware-picker {\n  display: flex;\n  flex-direction: column;\n  gap: 1.25em;\n}\n\n.choice-group {\n  border: none;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5em;\n  margin: 0;\n  min-width: 0;\n  padding: 0;\n}\n\n.choice-group__legend {\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 0.875rem;\n  font-weight: 700;\n  margin-bottom: 0.5em;\n  padding: 0;\n}\n\n/* ---------- Processor ---------- */\n\n/* Two cards, side by side, each a whole label: the radio itself is hidden, and\n   the card shows which is chosen by its border and fill. */\n.processor-options {\n  display: grid;\n  gap: 0.5em;\n  grid-template-columns: 1fr 1fr;\n}\n\n.processor-option {\n  border: 2px solid var(--gray-400);\n  border-radius: 0.5em;\n  cursor: pointer;\n  display: flex;\n  flex-direction: column;\n  gap: 0.15em;\n  padding: 0.6em 0.75em;\n  position: relative;\n}\n\n/* Hidden from sight but not from the keyboard or screen readers. */\n.processor-option__input {\n  clip-path: inset(50%);\n  height: 1px;\n  margin: 0;\n  overflow: hidden;\n  position: absolute;\n  white-space: nowrap;\n  width: 1px;\n}\n\n.processor-option:has(:checked) {\n  background-color: var(--purple-0);\n  border-color: var(--purple-900);\n}\n\n.processor-option:has(:focus-visible) {\n  outline: 3px solid var(--purple-900);\n  outline-offset: 2px;\n}\n\n.processor-option:has(:disabled) {\n  cursor: not-allowed;\n}\n\n.processor-option__name {\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 1.25rem;\n  font-weight: 700;\n}\n\n.processor-option__full {\n  color: var(--gray-600);\n  font-size: 0.8rem;\n  line-height: 1.25;\n}\n\n/* ---------- Cores ---------- */\n\n/* Held at the height of the longest list, four rows, so switching between CPU\n   and GPU never moves the Run button. */\n.core-options {\n  display: flex;\n  flex-direction: column;\n  gap: 0.35em;\n  min-height: calc(4 * 2.75rem + 3 * 0.35em);\n}\n\n/* At least 44px tall, the whole row a target for the radio in it. */\n.core-option {\n  align-items: center;\n  border: 1px solid var(--gray-300);\n  border-radius: 0.5em;\n  box-sizing: border-box;\n  cursor: pointer;\n  display: flex;\n  gap: 0.6em;\n  min-height: 2.75rem;\n  padding: 0.4em 0.75em;\n}\n\n.core-option:has(:checked) {\n  background-color: var(--purple-0);\n  border-color: var(--purple-900);\n}\n\n.core-option:has(:disabled) {\n  cursor: not-allowed;\n}\n\n.core-option__input {\n  accent-color: var(--purple-900);\n  cursor: inherit;\n  height: 1.1em;\n  margin: 0;\n  width: 1.1em;\n}\n\n.core-option__input:focus-visible {\n  outline: 3px solid var(--purple-900);\n  outline-offset: 2px;\n}\n\n.core-option__count {\n  font-family: \"Space Grotesk\", monospace;\n  font-variant-numeric: tabular-nums;\n  font-weight: 700;\n}\n",
          "folderId": "1",
          "active": false
        },
        "7": {
          "id": "7",
          "name": "network-diagram.css",
          "contents": ".network {\n  /* The layer names answer to the diagram's width (see the end of this file). */\n  container: network / inline-size;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5em;\n}\n\n/* The colors network-diagram.js paints with, every one at least 3:1 against\n   the card (WCAG 1.4.11): the outline of a neuron not yet computed, mint for\n   what is being computed and the lines into it, and purple for what is done. */\n.network__canvas {\n  --neuron-idle: var(--gray-500);\n  --neuron-active: var(--mint-600);\n  --neuron-done: var(--purple-600);\n  --wire-active: var(--mint-600);\n  --output-fill: var(--gray-0);\n  --output-stroke: var(--gray-500);\n\n  display: block;\n  width: 100%;\n}\n\n/* Its columns are set by network-diagram.js, one under each layer. */\n.network__layers {\n  display: grid;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n/* Each line is centered on its layer. On a narrow screen a line wraps between\n   words, and a single word wider than its column, like \"neurons\" under the\n   Input Layer at 320px, spills evenly into the gaps on either side rather\n   than breaking partway through. */\n.network__layer {\n  align-items: center;\n  display: flex;\n  flex-direction: column;\n  font-size: 0.8rem;\n  line-height: 1.25;\n  min-width: 0;\n  /* Keeps neighboring names apart on a narrow screen, wrapping them instead\n     of letting \"Hidden Layer 1\" run into \"Hidden Layer 2\". */\n  padding: 0 0.2em;\n  text-align: center;\n}\n\n.network__layer-name {\n  font-family: \"Space Grotesk\", monospace;\n  font-weight: 700;\n}\n\n/* The page's own font, not Geist Mono, which is wide enough that \"neurons\"\n   would spill well past the Input Layer's column on a phone. */\n.network__layer-size {\n  color: var(--gray-600);\n  font-variant-numeric: tabular-nums;\n}\n\n/* On a phone, the columns under the layers are only a few ems wide, and the\n   names at full size would wrap unevenly. A container query in ems, not a\n   media query in pixels, so enlarged text (WCAG 1.4.4) shrinks them too. */\n@container network (max-width: 26em) {\n  .network__layer {\n    font-size: 0.7rem;\n  }\n}\n",
          "folderId": "1",
          "active": false
        },
        "8": {
          "id": "8",
          "name": "network-diagram.js",
          "contents": "/**\n * network-diagram.js — every neuron of the network, drawn as a dot on a canvas.\n *\n * Thousands of neurons are too many for one element each, so they are painted\n * instead. Each layer but the last is a block of dots, 64 rows tall, filled a\n * column at a time from the top; the output layer, a single neuron, is a\n * larger circle. The real network joins every neuron to every neuron in the\n * next layer, millions of lines that would only fill the gaps in solid, so\n * none are drawn at rest (the description in index.html says so in words).\n * Lines appear only into what is being computed.\n *\n * The drawing shows how the chosen processor shares out the work:\n *   - A CPU's handful of cores each take one neuron, so a layer is computed a\n *     batch of neurons at a time — as many as there are cores — lit as they\n *     finish, with lines into the batch being computed.\n *   - A GPU's thousands of cores split up every neuron's calculations between\n *     them, so a whole layer is computed at once and fills in together.\n * A neuron not yet computed is an empty circle, and it fills in as it is\n * computed: mint while being computed, purple once done. Empty against filled\n * tells the two apart without relying on color (WCAG 1.4.1), and the outline\n * keeps the network visible at 3:1 or better before a run (WCAG 1.4.11).\n *\n * The canvas is aria-hidden. In its place, the layer list beneath it names\n * each layer and its size, a description in index.html says how the layers\n * connect and how the chosen processor works through them, and the progress\n * bar says how far along the run is.\n */\n\nconst ROWS = 64;\n// Layout, in multiples of the distance from one neuron to the next.\nconst GAP = 10;\nconst MARGIN = 1;\nconst DOT_RADIUS = 0.36;\nconst ACTIVE_DOT_RADIUS = 0.5;\n// An empty neuron's outline: never thinner than 0.75px, which still draws.\nconst OUTLINE_WIDTH = 0.15;\nconst MIN_OUTLINE_WIDTH = 0.75;\n// In pixels: room for the output circle, and for its label beneath.\nconst OUTPUT_SLOT = 56;\n// Lines drawn into a layer a GPU is computing: a sample of its connections.\nconst SAMPLED_CONNECTIONS = 90;\n// Lines drawn into each neuron a CPU core is computing.\nconst FAN_IN = 5;\n\nexport function createNetworkDiagram(canvas, { sizes, labels }) {\n  const context = canvas.getContext(\"2d\");\n  const connections = sampleConnections(sizes.length - 1);\n  let geometry = null;\n  let state = { progress: sizes.map(() => 0), processor: \"cpu\", cores: 1 };\n\n  function measure() {\n    const width = canvas.clientWidth;\n    const blockSizes = sizes.slice(0, -1);\n    const columns = blockSizes.reduce((total, size) => total + size / ROWS, 0);\n    const pitch = (width - OUTPUT_SLOT) / (MARGIN + columns + GAP * blockSizes.length);\n    const height = (ROWS + 2 * MARGIN) * pitch;\n\n    let x = MARGIN * pitch;\n    const blocks = blockSizes.map((size) => {\n      const block = { left: x, right: x + (size / ROWS) * pitch };\n      x = block.right + GAP * pitch;\n      return block;\n    });\n    const output = {\n      x: width - OUTPUT_SLOT / 2,\n      y: height / 2,\n      radius: Math.min(OUTPUT_SLOT / 2 - 4, Math.max(3 * pitch, 8)),\n    };\n    return { width, height, pitch, top: MARGIN * pitch, blocks, output };\n  }\n\n  function resize() {\n    const width = canvas.clientWidth;\n    if (!width || width === geometry?.width) return;\n    geometry = measure();\n\n    const scale = window.devicePixelRatio || 1;\n    canvas.style.height = `${geometry.height}px`;\n    canvas.width = Math.round(geometry.width * scale);\n    canvas.height = Math.round(geometry.height * scale);\n    context.setTransform(scale, 0, 0, scale, 0, 0);\n\n    // Each label sits under its layer, its cell running to the middle of the\n    // gaps either side.\n    const { blocks, pitch } = geometry;\n    const edges = [0, ...blocks.map(({ right }) => right + (GAP * pitch) / 2), geometry.width];\n    labels.style.gridTemplateColumns = edges\n      .slice(1)\n      .map((edge, i) => `${edge - edges[i]}px`)\n      .join(\" \");\n\n    draw();\n  }\n\n  /**\n   * Show the network as of `progress`, one number from 0 to 1 per layer,\n   * computed by `processor` with `cores` cores.\n   */\n  function show(next) {\n    state = next;\n    draw();\n  }\n\n  function draw() {\n    if (!geometry) return;\n    const colors = readColors(canvas);\n    const { progress, processor } = state;\n    context.clearRect(0, 0, geometry.width, geometry.height);\n\n    // On a GPU, the whole layer being computed has lines into it.\n    if (processor === \"gpu\") {\n      connections.forEach((sample, gap) => {\n        if (isComputing(progress[gap + 1])) strokeConnections(sample, gap, colors.activeWire);\n      });\n    }\n\n    for (let layer = 0; layer < sizes.length - 1; layer++) drawBlock(layer, colors);\n    drawOutput(colors);\n  }\n\n  function drawBlock(layer, colors) {\n    const size = sizes[layer];\n    const progress = state.progress[layer];\n\n    // The input layer isn't computed: it is given, all at once.\n    if (layer === 0) {\n      if (progress > 0) dots(layer, 0, size, colors.done);\n      else outlines(layer, 0, size, colors.idle);\n      return;\n    }\n\n    if (state.processor === \"gpu\") {\n      if (progress >= 1) return dots(layer, 0, size, colors.done);\n      outlines(layer, 0, size, colors.idle);\n      context.globalAlpha = progress;\n      dots(layer, 0, size, colors.active);\n      context.globalAlpha = 1;\n      return;\n    }\n\n    const { done, active } = cpuBatch(size, progress);\n    fanIn(layer, done, active, colors);\n    dots(layer, 0, done, colors.done);\n    dots(layer, done, active, colors.active, ACTIVE_DOT_RADIUS);\n    outlines(layer, active, size, colors.idle);\n  }\n\n  function drawOutput(colors) {\n    const layer = sizes.length - 1;\n    const progress = state.progress[layer];\n    const { x, y, radius } = geometry.output;\n\n    if (state.processor === \"cpu\") {\n      const { done, active } = cpuBatch(1, progress);\n      fanIn(layer, done, active, colors);\n    }\n\n    context.beginPath();\n    context.arc(x, y, radius, 0, 2 * Math.PI);\n    context.fillStyle = progress >= 1 ? colors.done : isComputing(progress) ? colors.active : colors.outputFill;\n    context.fill();\n    context.lineWidth = 2;\n    context.strokeStyle = progress >= 1 ? colors.done : colors.outputStroke;\n    context.stroke();\n  }\n\n  // Lines into each neuron being computed, from neurons in the layer before.\n  // Which neurons is decided by a hash, so the lines into a neuron stay put\n  // from frame to frame rather than flickering.\n  function fanIn(layer, from, to, colors) {\n    if (from >= to) return;\n    const source = geometry.blocks[layer - 1];\n    context.beginPath();\n    for (let neuron = from; neuron < to; neuron++) {\n      const target = position(layer, neuron);\n      for (let k = 0; k < FAN_IN; k++) {\n        context.moveTo(source.right, rowY(hash(layer, neuron, k) % ROWS));\n        context.lineTo(target.x, target.y);\n      }\n    }\n    context.lineWidth = 1;\n    context.strokeStyle = colors.activeWire;\n    context.stroke();\n  }\n\n  function strokeConnections(sample, gap, color) {\n    const source = geometry.blocks[gap];\n    const lastGap = gap === sizes.length - 2;\n    context.beginPath();\n    sample.forEach(({ from, to }) => {\n      context.moveTo(source.right, rowY(from));\n      if (lastGap) context.lineTo(geometry.output.x, geometry.output.y);\n      else context.lineTo(geometry.blocks[gap + 1].left, rowY(to));\n    });\n    context.lineWidth = 1;\n    context.strokeStyle = color;\n    context.stroke();\n  }\n\n  // Neurons `from` up to but not including `to`, filled, in one path.\n  function dots(layer, from, to, color, radius = DOT_RADIUS) {\n    if (from >= to) return;\n    circles(layer, from, to, Math.max(0.6, radius * geometry.pitch));\n    context.fillStyle = color;\n    context.fill();\n  }\n\n  // The same, as empty circles. The outline runs just inside where a filled\n  // dot's edge would be, so a neuron takes the same room either way. On a\n  // narrow screen, where the dots are barely a pixel, the outline closes up\n  // and the circle reads as a gray dot; the layer it belongs to stays as\n  // visible.\n  function outlines(layer, from, to, color) {\n    if (from >= to) return;\n    const width = Math.max(MIN_OUTLINE_WIDTH, OUTLINE_WIDTH * geometry.pitch);\n    const r = Math.max(0.6, DOT_RADIUS * geometry.pitch);\n    circles(layer, from, to, Math.max(0.3, r - width / 2));\n    context.lineWidth = width;\n    context.strokeStyle = color;\n    context.stroke();\n  }\n\n  function circles(layer, from, to, r) {\n    context.beginPath();\n    for (let neuron = from; neuron < to; neuron++) {\n      const { x, y } = position(layer, neuron);\n      context.moveTo(x + r, y);\n      context.arc(x, y, r, 0, 2 * Math.PI);\n    }\n  }\n\n  function position(layer, neuron) {\n    if (layer === sizes.length - 1) return geometry.output;\n    const column = Math.floor(neuron / ROWS);\n    return {\n      x: geometry.blocks[layer].left + (column + 0.5) * geometry.pitch,\n      y: rowY(neuron % ROWS),\n    };\n  }\n\n  function rowY(row) {\n    return geometry.top + (row + 0.5) * geometry.pitch;\n  }\n\n  // Which neurons a CPU has finished, and which it is working on, `progress`\n  // of the way through a layer: one batch per core count, one after another.\n  function cpuBatch(size, progress) {\n    const { cores } = state;\n    const batches = Math.ceil(size / cores);\n    const done = Math.min(size, Math.floor(progress * batches) * cores);\n    const active = isComputing(progress) ? Math.min(size, done + cores) : done;\n    return { done, active };\n  }\n\n  // The width of the canvas follows its card's; the drawing is redone to fit.\n  new ResizeObserver(resize).observe(canvas);\n  resize();\n\n  return { show };\n}\n\nfunction isComputing(progress) {\n  return progress > 0 && progress < 1;\n}\n\n// Colors live in the stylesheet (network-diagram.css), with the rest.\nfunction readColors(canvas) {\n  const style = getComputedStyle(canvas);\n  const read = (name) => style.getPropertyValue(name).trim();\n  return {\n    idle: read(\"--neuron-idle\"),\n    active: read(\"--neuron-active\"),\n    done: read(\"--neuron-done\"),\n    activeWire: read(\"--wire-active\"),\n    outputFill: read(\"--output-fill\"),\n    outputStroke: read(\"--output-stroke\"),\n  };\n}\n\n// A fixed sample of connections for each gap between layers, as rows on\n// either side. Seeded, so it is the same picture every time.\nfunction sampleConnections(gaps) {\n  const random = mulberry32(50);\n  const pick = () => Math.floor(random() * ROWS);\n  return Array.from({ length: gaps }, () =>\n    Array.from({ length: SAMPLED_CONNECTIONS }, () => ({ from: pick(), to: pick() })),\n  );\n}\n\nfunction mulberry32(seed) {\n  return () => {\n    seed = (seed + 0x6d2b79f5) | 0;\n    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);\n    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n}\n\nfunction hash(...numbers) {\n  let h = 2166136261;\n  for (const n of numbers) {\n    h = Math.imul(h ^ n, 16777619);\n    h ^= h >>> 13;\n  }\n  return h >>> 0;\n}\n",
          "folderId": "1",
          "active": false
        },
        "9": {
          "id": "9",
          "name": "run-history.css",
          "contents": ".run-history {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5em;\n}\n\n.run-history__heading {\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 0.875rem;\n}\n\n/* Room for the most runs listed, five, held open from the start: two lines of\n   text and the gap between them, in the run's own font size, plus the gaps\n   between runs. The \"No runs yet.\" message sits in the same room. */\n.run-history__runs {\n  --run-font-size: 0.875rem;\n  min-height: calc(5 * var(--run-font-size) * (1.25 + 0.25 + 1.25) + 4 * 0.6rem);\n}\n\n.run-history__empty {\n  color: var(--gray-600);\n  font-size: 0.875rem;\n}\n\n/* Two columns shared by every run, through subgrid: the bars, and the times\n   beside them. The time column is as wide as the widest time listed, so every\n   bar's track is the same length and the bars compare fairly. */\n.run-history__list {\n  display: grid;\n  gap: 0.6rem 0.75rem;\n  grid-template-columns: 1fr auto;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n/* The hardware on a line of its own, then the bar with the time beside it. A\n   time in nanoseconds (\"7,867 nanoseconds\") is too long to share a line with\n   the hardware in a narrow card without one of them wrapping. */\n.run {\n  display: grid;\n  font-size: var(--run-font-size);\n  grid-column: 1 / -1;\n  grid-template-columns: subgrid;\n  line-height: 1.25;\n  row-gap: 0.25em;\n}\n\n.run__hardware {\n  grid-column: 1 / -1;\n}\n\n.run__time {\n  font-variant-numeric: tabular-nums;\n  grid-column: 2;\n  grid-row: 2;\n  text-align: end;\n}\n\n.run__bar {\n  align-self: center;\n  background-color: var(--gray-150);\n  border-radius: 999px;\n  display: block;\n  grid-column: 1;\n  grid-row: 2;\n  height: 0.4em;\n  overflow: hidden;\n}\n\n.run__fill {\n  border-radius: inherit;\n  display: block;\n  height: 100%;\n  /* A GPU run beside a slow CPU run would otherwise be too thin to see. */\n  min-width: 0.4em;\n}\n\n.run--cpu .run__fill {\n  background-color: var(--purple-600);\n}\n\n.run--gpu .run__fill {\n  background-color: var(--mint-600);\n}\n",
          "folderId": "1",
          "active": false
        },
        "10": {
          "id": "10",
          "name": "run-history.js",
          "contents": "/**\n * run-history.js — the last few runs, newest first, to compare side by side.\n *\n * Each run has a bar as long as its time, measured against the slowest run\n * still listed, so a GPU run beside a CPU run shows the gap at a glance. It is\n * the real time that counts, not how long the slowed-down animation took. The\n * bar is decoration (aria-hidden): the time beside it is the same fact in\n * words. Bars are colored by processor, which the text also names.\n *\n * Only the last five are kept, and room for all five is held open from the\n * start (run-history.css), so the card never grows as runs are added.\n */\n\nimport { formatDuration } from \"./duration.js\";\n\nconst LIMIT = 5;\nconst numbers = new Intl.NumberFormat(\"en-US\");\n\nexport function createRunHistory(container, { processors }) {\n  const list = container.querySelector(\".run-history__list\");\n  const empty = container.querySelector(\".run-history__empty\");\n  const template = document.getElementById(\"run-template\");\n  const runs = [];\n\n  function add(run) {\n    runs.unshift(run);\n    runs.splice(LIMIT);\n    render();\n  }\n\n  function render() {\n    const slowest = Math.max(...runs.map(({ seconds }) => seconds));\n    list.replaceChildren(\n      ...runs.map(({ processor, cores, seconds }) => {\n        const item = template.content.firstElementChild.cloneNode(true);\n        item.classList.add(`run--${processor}`);\n        item.querySelector(\".run__hardware\").textContent =\n          `${numbers.format(cores)}-core ${processors[processor].name}`;\n        item.querySelector(\".run__time\").textContent = formatDuration(seconds);\n        item.querySelector(\".run__fill\").style.width = `${(seconds / slowest) * 100}%`;\n        return item;\n      }),\n    );\n    empty.hidden = runs.length > 0;\n  }\n\n  return { add };\n}\n",
          "folderId": "1",
          "active": true
        },
        "11": {
          "id": "11",
          "name": "hardware-picker.js",
          "contents": "/**\n * hardware-picker.js — the choice of processor, and of how many cores it has.\n *\n * Both are plain radio groups in fieldsets, so arrow keys move between options\n * and a screen reader names the group (\"Cores\") along with each option. The\n * core counts are cloned from `#core-option-template` whenever the processor\n * changes, since a CPU and a GPU offer different ones.\n *\n * The cores last chosen for each processor are remembered, so switching from\n * CPU to GPU and back returns to the same CPU.\n */\n\nconst numbers = new Intl.NumberFormat(\"en-US\");\n\nexport function createHardwarePicker(container, { processors, onChange } = {}) {\n  const coreList = container.querySelector(\".core-options\");\n  const template = document.getElementById(\"core-option-template\");\n\n  let processor = container.querySelector('input[name=\"processor\"]:checked').value;\n  const chosenCores = Object.fromEntries(\n    Object.entries(processors).map(([key, { cores }]) => [key, cores[0]]),\n  );\n\n  function renderCores() {\n    const rows = processors[processor].cores.map((cores) => {\n      const row = template.content.firstElementChild.cloneNode(true);\n      const input = row.querySelector(\".core-option__input\");\n      input.value = String(cores);\n      input.checked = cores === chosenCores[processor];\n      row.querySelector(\".core-option__count\").textContent = `${numbers.format(cores)} cores`;\n      return row;\n    });\n    coreList.replaceChildren(...rows);\n  }\n\n  function getSelection() {\n    return { processor, cores: chosenCores[processor] };\n  }\n\n  // While the network runs, the hardware it is running on can't change.\n  function setDisabled(disabled) {\n    container.querySelectorAll(\"input\").forEach((input) => {\n      input.disabled = disabled;\n    });\n  }\n\n  container.addEventListener(\"change\", ({ target }) => {\n    if (target.name === \"processor\") {\n      processor = target.value;\n      renderCores();\n    } else if (target.name === \"cores\") {\n      chosenCores[processor] = Number(target.value);\n    }\n    onChange?.(getSelection());\n  });\n\n  renderCores();\n\n  return { getSelection, setDisabled };\n}\n",
          "folderId": "1",
          "active": false
        }
      },
      "openFiles": [
        "1",
        "2",
        "3",
        "4",
        "5",
