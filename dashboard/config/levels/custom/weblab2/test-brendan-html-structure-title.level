          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html>\n<head>\n  <!-- Add your page title here, inside <title> tags! -->\n</head>\n<body>\n  <!-- This is where your fish's story will go! -->\n</body>\n</html>",
