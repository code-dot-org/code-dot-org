<Weblab2>
  <config><![CDATA[{
  "published": true,
  "game_id": 74,
  "created_at": "2026-11-03T04:27:31.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": "true",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Prompt dial: weather checker</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"widget\" id=\"widget\">\n    <div class=\"error-banner\" id=\"error\" role=\"alert\" hidden></div>\n    <h1 class=\"visually-hidden\" data-text=\"intro.title\"></h1>\n\n    <header class=\"intro\" id=\"header\">\n      <div class=\"intro-line\" id=\"practiceLine\">\n        <span class=\"tag\" data-text=\"intro.tag\"></span>\n      </div>\n      <p class=\"do-this\" id=\"doThis\"><strong data-text=\"intro.doThis\"></strong> <span data-text=\"intro.doThisText\"></span></p>\n    </header>\n\n    <section class=\"intro-screen\" id=\"introScreen\" hidden>\n      <span class=\"tag\" data-text=\"intro.tag\"></span>\n      <h2 class=\"intro-title\" data-text=\"intro.heading\"></h2>\n      <p class=\"intro-lead\" data-text=\"intro.lead\"></p>\n      <ol class=\"intro-steps\">\n        <li data-text=\"intro.steps.0\"></li>\n        <li data-text=\"intro.steps.1\"></li>\n        <li data-text=\"intro.steps.2\"></li>\n      </ol>\n      <button type=\"button\" class=\"btn btn-primary\" id=\"startButton\" data-text=\"intro.start\"></button>\n    </section>\n\n    <div class=\"workspace\" id=\"workspace\" data-mode=\"demo\">\n      <section class=\"col\">\n        <div class=\"card prompt-card\">\n          <span class=\"overline\" data-text=\"prompt.label\"></span>\n          <div class=\"prompt-box\">\n            <p class=\"prompt-text\" id=\"promptText\"></p>\n            <p class=\"prompt-ghost\" id=\"promptGhost\" aria-hidden=\"true\"></p>\n          </div>\n        </div>\n\n        <div class=\"switches\" id=\"switches\" hidden></div>\n\n        <div class=\"demo-panel\" id=\"demoPanel\">\n          <p class=\"demo-step\" id=\"demoStep\"></p>\n          <h2 class=\"demo-title\" id=\"demoTitle\" hidden></h2>\n          <p class=\"demo-text\" id=\"demoText\"></p>\n          <div class=\"demo-actions\">\n            <button type=\"button\" class=\"btn btn-outline\" id=\"demoNext\" data-text=\"demo.next\"></button>\n          </div>\n        </div>\n      </section>\n\n      <div class=\"gutter\" id=\"sparkHolder\"></div>\n\n      <section class=\"col\">\n        <div class=\"page-area\" id=\"pageArea\"></div>\n        <div class=\"note\" id=\"note\"></div>\n        <div class=\"finish-row\"><button type=\"button\" class=\"btn btn-primary\" id=\"finishButton\" data-text=\"finish.label\" hidden></button></div>\n      </section>\n    </div>\n\n\n    <div class=\"visually-hidden\" id=\"announcer\" aria-live=\"polite\" aria-atomic=\"true\"></div>\n\n    <section class=\"takeaway-page\" id=\"takeaway\" aria-labelledby=\"takeaway-title\" tabindex=\"-1\" hidden>\n      <h2 class=\"intro-title\" id=\"takeaway-title\" data-text=\"takeaway.title\"></h2>\n      <p class=\"intro-lead\" data-text=\"takeaway.text\"></p>\n      <ul class=\"takeaway-labels\" id=\"takeawayLabels\"></ul>\n      <p class=\"takeaway-last\"><strong data-text=\"takeaway.last\"></strong></p>\n    </section>\n  </main>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
