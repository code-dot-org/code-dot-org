<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-11-03T04:27:31.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": true,
    "start_sources": {
      "folders": {
      },
      "files": {
        "c184a62d-3e69-4d6e-9827-15652aa1b7e4": {
          "id": "c184a62d-3e69-4d6e-9827-15652aa1b7e4",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Direct the Code Widget</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <h1>Request Small Pieces of Code</h1>\n    <p>See how adding details to your prompt makes the AI generate clearer code.</p>\n\n    <div id=\"promptDisplay\">Current Prompt: <span id=\"currentPrompt\">A piece of code for a function.</span></div>\n    <div class=\"controls\">\n        <button id=\"toggleDetail1\">Add Detail: Function Name</button>\n        <button id=\"toggleDetail2\">Add Detail: Parameters</button>\n        <button id=\"toggleDetail3\">Add Detail: Logic</button>\n    </div>\n    \n    <div class=\"code-display\">\n        <h2>Generated Code:</h2>\n        <pre><code id=\"generatedCode\"></code></pre>\n    </div>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "8bf3f06d-cc28-4525-a4b7-cc8823b9de14": {
          "id": "8bf3f06d-cc28-4525-a4b7-cc8823b9de14",
          "name": "style.css",
          "contents": "body {\n    font-family: Arial, sans-serif;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding: 20px;\n    background-color: #f0f0f0;\n    color: #333;\n}\n\nh1 {\n    color: #333;\n    margin-bottom: 10px;\n}\n\np {\n    margin-bottom: 20px;\n    text-align: center;\n}\n\n#promptDisplay {\n    margin: 20px 0;\n    font-size: 1.1em;\n    color: #555;\n}\n\n#currentPrompt {\n    font-weight: bold;\n    color: #007bff;\n}\n\n.controls {\n    margin-bottom: 30px;\n}\n\nbutton {\n    padding: 10px 15px;\n    margin: 0 5px;\n    border: none;\n    background-color: #007bff;\n    color: white;\n    border-radius: 5px;\n    cursor: pointer;\n    transition: background-color 0.3s ease;\n}\n\nbutton:hover {\n    background-color: #0056b3;\n}\n\n.code-display {\n    width: 90%;\n    max-width: 700px;\n    background-color: #2d2d2d;\n    color: #f8f8f2;\n    border-radius: 8px;\n    padding: 20px;\n    box-shadow: 0 4px 8px rgba(0,0,0,0.2);\n}\n\n.code-display h2 {\n    color: #61dafb;\n    margin-top: 0;\n    margin-bottom: 15px;\n}\n\npre {\n    margin: 0;\n    white-space: pre-wrap;\n    word-wrap: break-word;\n}\n\ncode {\n    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, Courier, monospace;\n    font-size: 0.95em;\n    line-height: 1.5;\n}",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "033aeaa1-e913-4933-bf89-98836bba52f0": {
          "id": "033aeaa1-e913-4933-bf89-98836bba52f0",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const currentPromptSpan = document.getElementById('currentPrompt');\n    const generatedCodeBlock = document.getElementById('generatedCode');\n    const toggleDetail1Btn = document.getElementById('toggleDetail1');\n    const toggleDetail2Btn = document.getElementById('toggleDetail2');\n    const toggleDetail3Btn = document.getElementById('toggleDetail3');\n\n    let activeDetails = new Set();\n\n    const updateCodePreview = () => {\n        let promptText = 'A piece of code for a function.';\n        let codeContent = 'function x(){ /* does nothing */ }'; // Vague code\n\n        if (activeDetails.has('functionName')) {\n            promptText += ' named \\'calculateArea\\'.';\n            codeContent = 'function calculateArea(){ /* ... */ }';\n        }\n        if (activeDetails.has('parameters')) {\n            promptText += ' It takes \\'width\\' and \\'height\\' as parameters.';\n            codeContent = 'function calculateArea(width, height){ /* ... */ }';\n        }\n        if (activeDetails.has('logic')) {\n            promptText += ' It should return the product of its parameters.';\n            codeContent = 'function calculateArea(width, height){ return width * height; }';\n        }\n\n        // Special handling for clarity if some details are missing\n        if (!activeDetails.has('functionName') && (activeDetails.has('parameters') || activeDetails.has('logic'))) {\n             promptText = 'A piece of code for a function. ';\n             if (activeDetails.has('parameters')) promptText += ' It takes \\'w\\' and \\'h\\' as parameters.';\n             if (activeDetails.has('logic')) promptText += ' It should return their product.';\n             codeContent = 'function z(w, h){ return w * h; }';\n        } else if (activeDetails.has('functionName') && !activeDetails.has('parameters') && activeDetails.has('logic')) {\n            promptText = 'A piece of code for a function named \\'calculateArea\\'. It returns a value.';\n            codeContent = 'function calculateArea(){ return 100; /* Placeholder */ }';\n        }\n\n        currentPromptSpan.textContent = promptText;\n        generatedCodeBlock.textContent = codeContent;\n    };\n\n    const toggleDetail = (detailName, button) => {\n        if (activeDetails.has(detailName)) {\n            activeDetails.delete(detailName);\n            button.classList.remove('active');\n        } else {\n            activeDetails.add(detailName);\n            button.classList.add('active');\n        }\n        updateCodePreview();\n    };\n\n    toggleDetail1Btn.addEventListener('click', () => toggleDetail('functionName', toggleDetail1Btn));\n    toggleDetail2Btn.addEventListener('click', () => toggleDetail('parameters', toggleDetail2Btn));\n    toggleDetail3Btn.addEventListener('click', () => toggleDetail('logic', toggleDetail3Btn));\n\n    // Initial state\n    updateCodePreview();\n\n    console.log(\"Direct the Code Widget loaded. Student will observe changes simulated by the widget.\");\n});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
        "c184a62d-3e69-4d6e-9827-15652aa1b7e4",
        "8bf3f06d-cc28-4525-a4b7-cc8823b9de14",
        "033aeaa1-e913-4933-bf89-98836bba52f0"
      ]
