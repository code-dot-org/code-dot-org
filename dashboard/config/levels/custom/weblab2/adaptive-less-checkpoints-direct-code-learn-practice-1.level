.5rem; --leading-body-sm: 1.375rem; --leading-body-xs: 1.125rem; --leading-body-xxs: 1rem; --tracking-heading-display: -.01em; --tracking-overline: .08em; --tracking-none: 0}\n\n:root{--shape-sm: .375rem; --shape-md: .5rem; --shape-lg: .625rem; --shape-xl: .75rem; --shape-round: 62.4375rem; --spacing-p-xxs: .5rem; --spacing-p-xs: 1rem; --spacing-p-s: 1.5rem; --spacing-p-m: 2rem; --spacing-p-l: 2.5rem; --spacing-p-xl: 3rem; --spacing-p-xxl: 3.5rem; --spacing-p-xxxl: 4rem; --shadow-sm: 0 4px 7px rgb(0 0 0 / 7%), 0 2px 2px rgb(0 0 0 / 7%); --shadow-md: 0 10px 15px -3px rgb(0 0 0 / 10%), 0 4px 6px -4px rgb(0 0 0 / 10%); --shadow-lg: 0 20px 25px -5px rgb(0 0 0 / 10%), 0 8px 10px -6px rgb(0 0 0 / 10%)}\n\n:root{--duration-instant: 0ms; --duration-fast: .1s; --duration-short: .15s; --duration-medium: .2s; --easing-standard: cubic-bezier(.4, 0, .2, 1); --easing-emphasized: cubic-bezier(.2, 0, 0, 1); --easing-out: cubic-bezier(.23, 1, .32, 1); --motion-press-scale: .97; --motion-press-duration: .15s; --motion-press-easing: cubic-bezier(.23, 1, .32, 1); --motion-surface-from-scale: .96; --motion-surface-duration: .2s; --motion-surface-easing: cubic-bezier(.23, 1, .32, 1); --motion-indicator-duration: .2s; --motion-indicator-easing: cubic-bezier(.2, 0, 0, 1); --motion-fade-duration: .1s; --motion-fade-easing: cubic-bezier(.23, 1, .32, 1); --motion-highlight-chase-duration: .1s; --motion-highlight-chase-easing: cubic-bezier(.23, 1, .32, 1); --transition-colors: background-color var(--duration-short) var(--easing-standard), color var(--duration-short) var(--easing-standard), border-color var(--duration-short) var(--easing-standard), box-shadow var(--duration-short) var(--easing-standard), opacity var(--duration-short) var(--easing-standard); --transition-fade: background-color var(--motion-fade-duration) var(--motion-fade-easing), color var(--motion-fade-duration) var(--motion-fade-easing), border-color var(--motion-fade-duration) var(--motion-fade-easing), opacity var(--motion-fade-duration) var(--motion-fade-easing); --transition-press: transform var(--motion-press-duration) var(--motion-press-easing); --transition-surface: opacity var(--motion-surface-duration) var(--motion-surface-easing), transform var(--motion-surface-duration) var(--motion-surface-easing); --transition-indicator: left var(--motion-indicator-duration) var(--motion-indicator-easing), width var(--motion-indicator-duration) var(--motion-indicator-easing), transform var(--motion-indicator-duration) var(--motion-indicator-easing), background-color var(--duration-short) var(--easing-standard); --transition-highlight-chase: top var(--motion-highlight-chase-duration) var(--motion-highlight-chase-easing), height var(--motion-highlight-chase-duration) var(--motion-highlight-chase-easing), opacity var(--motion-highlight-chase-duration) var(--motion-highlight-chase-easing)}\n\n:root{--ring: var(--border-focused-primary); --control-height-large: 48px; --control-height-medium: 40px; --control-height-small: 32px; --control-height-extra-small: 24px; --control-height-l: 48px; --control-height-m: 40px; --control-height-s: 32px; --control-height-xs: 24px; --z-drawer: 1200; --z-modal: 1300; --z-dropdown: 1300; --z-popover: 1300; --z-toast: 1400; --z-tooltip: 1500; --font-fa-free: \"Font Awesome 7 Free\"; --font-fa-pro: \"Font Awesome 7 Pro\"; --font-fa-brands: \"Font Awesome 7 Brands\"; --syntax-attribute: #B34800; --syntax-comment: #69788A; --syntax-keyword: #4C42CF; --syntax-number: #0B43A3; --syntax-property: #B5004F; --syntax-punctuation: #596069; --syntax-selector: #1A7F85; --syntax-string: #1F7028; --syntax-tag: #3228B7; --syntax-value: #1570D1}\n\n/* Code colors (the light values CADS ships for syntax) */\n:root {\n  --syntax-attribute: #B34800;\n  --syntax-comment: #69788A;\n  --syntax-keyword: #4C42CF;\n  --syntax-number: #0B43A3;\n  --syntax-property: #B5004F;\n  --syntax-punctuation: #596069;\n  --syntax-selector: #1A7F85;\n  --syntax-string: #1F7028;\n  --syntax-tag: #3228B7;\n  --syntax-value: #1570D1;\n}\n\n/* ===== end CADS tokens ===== */\n/* ==================================================================\n   Prompt dial component styles\n\n   What is CADS\n   - Every color, type size, radius, spacing step, shadow and motion value\n     below comes from the CADS tokens above. No hard-coded colors.\n   - Selected look for the pressed choice buttons (selected-primary fill,\n     border and text, always as a set).\n   - Focus ring: 2px --ring, never removed.\n   - Overline labels, the Tag look for \"Practice\", the Alert look for the\n     error message and the status line, and the white card with a 1px\n     hairline and --shape-md radius.\n   - Control heights from --control-height-* (40px choice buttons).\n\n   What was rebuilt from the manifest\n   - Choice buttons are rebuilt as plain buttons that follow the Chip rules\n     (pill shape, thick label, selected tokens). The real CADS runtime is\n     not loaded, because Web Lab allows no scripts or fonts from outside.\n   - The primary and outlined Button looks for Try it and Next.\n   - The two options in each row act like a small SegmentedButton, but a\n     tap on the selected option clears it, so it is built as two buttons\n     with aria-pressed.\n\n   What was approximated\n   - Geist and Space Grotesk are named by the tokens but are not loaded.\n     The tokens' own fallback fonts show instead.\n   - Icons are small inline SVGs drawn to match the Font Awesome weight.\n     Font Awesome is not loaded.\n   - The sample page (weather) is\n     an illustration built only from CADS palette tokens. It is not a CADS\n     component.\n   ================================================================== */\n\n*,\n*::before,\n*::after { box-sizing: border-box; }\n\n[hidden] { display: none !important; }\n\nhtml { font-size: 100%; }\n\nbody {\n  margin: 0;\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-md);\n  line-height: var(--leading-body-md);\n  color: var(--text-neutral-primary);\n  background: var(--background-neutral-primary);\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.nowrap { white-space: nowrap; }\n\n.icon {\n  flex: none;\n  width: 1.125rem;\n  height: 1.125rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* Detail colors. Each detail keeps one color from prompt to page to note. */\n\n.is-d1,\n[data-flash=\"1\"] { --detail-line: var(--border-brand-primary); --detail-bg: var(--background-brand-light); }\n\n.is-d2,\n[data-flash=\"2\"] { --detail-line: var(--border-accent-orange-strong); --detail-bg: var(--background-accent-orange-light); }\n\n.is-d3,\n[data-flash=\"3\"] { --detail-line: var(--border-accent-pink-primary); --detail-bg: var(--background-accent-pink-light); }\n\n.is-d4,\n[data-flash=\"4\"] { --detail-line: var(--border-info-strong); --detail-bg: var(--background-info-light); }\n\n/* ---------- Intro page ---------- */\n\n.intro-screen,\n.takeaway-page {\n  display: grid;\n  justify-items: start;\n  align-content: start;\n  gap: var(--spacing-p-xs);\n  max-width: 32rem;\n  padding: var(--spacing-p-xs) var(--spacing-p-xxs);\n}\n\n.intro-title {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-md);\n  font-weight: var(--font-weight-bold);\n  line-height: var(--leading-heading-md);\n}\n\n.intro-lead { margin: 0; }\n\n.intro-steps {\n  margin: 0;\n  padding-inline-start: 1.5rem;\n  display: grid;\n  gap: .375rem;\n}\n\n.intro-steps li::marker { font-weight: var(--font-weight-bold); }\n\n.takeaway-labels {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-p-xxs) var(--spacing-p-xs);\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.takeaway-label {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.takeaway-label .icon { color: var(--detail-line); }\n\n.takeaway-last { margin: 0; }\n\n.takeaway-page:focus-visible {\n  outline: 2px solid var(--ring);\n  outline-offset: 2px;\n}\n\n.finish-row { display: flex; }\n\n/* ---------- Layout ---------- */\n\n.widget {\n  max-width: 60rem;\n  margin: 0 auto;\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs) var(--spacing-p-xs);\n}\n\n.error-banner {\n  margin-block-end: var(--spacing-p-xxs);\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border: 1px solid var(--border-error-mid);\n  border-radius: var(--shape-md);\n  background: var(--background-error-light);\n  color: var(--text-error-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.intro {\n  display: grid;\n  gap: .25rem;\n  margin-block-end: var(--spacing-p-xxs);\n}\n\n.author-row {\n  display: flex;\n  align-items: center;\n  gap: .5rem;\n}\n\n.author-row label {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.author-row select {\n  min-height: var(--control-height-small);\n  max-width: 100%;\n  padding: 0 .5rem;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font: inherit;\n}\n\n.intro-line {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: .5rem;\n}\n\n.tag {\n  display: inline-block;\n  padding: 0 .5rem;\n  border-radius: var(--shape-sm);\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: var(--leading-body-md);\n}\n\n.do-this { margin: 0; color: var(--text-neutral-secondary); }\n\n.do-this strong { color: var(--text-neutral-primary); }\n\n.text-button {\n  min-height: var(--control-height-small);\n  padding: 0 .5rem;\n  border: 0;\n  border-radius: var(--shape-sm);\n  background: transparent;\n  color: var(--text-brand-primary);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  text-decoration: underline;\n  cursor: pointer;\n}\n\n.workspace {\n  display: grid;\n  grid-template-columns: minmax(0, 5fr) 2rem minmax(0, 6fr);\n  align-items: start;\n}\n\n.col {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  min-width: 0;\n}\n\n.gutter {\n  display: flex;\n  justify-content: center;\n  padding-block-start: 3rem;\n}\n\n/* ---------- Prompt card ---------- */\n\n.card {\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n}\n\n.prompt-card { padding: .5rem .75rem .625rem; }\n\n.overline {\n  font-size: var(--text-body-md);\n  font-weight: var(--font-weight-semi-bold);\n  letter-spacing: var(--tracking-overline);\n  text-transform: uppercase;\n  color: var(--text-neutral-quaternary);\n}\n\n.prompt-box {\n  display: grid;\n  margin-block-start: .125rem;\n}\n\n.prompt-text,\n.prompt-ghost {\n  grid-area: 1 / 1;\n  margin: 0;\n}\n\n.prompt-ghost { visibility: hidden; }\n\n.phrase {\n  padding: 0 .25rem;\n  border-bottom: 2px solid var(--detail-line);\n  border-radius: var(--shape-sm);\n  background: var(--detail-bg);\n  font-weight: var(--font-weight-semi-bold);\n  -webkit-box-decoration-break: clone;\n  box-decoration-break: clone;\n}\n\n.phrase .icon { color: var(--detail-line); margin-inline-end: .25rem; vertical-align: -.2em; }\n\n.sent.is-new { animation: fade-in var(--motion-surface-duration) var(--motion-surface-easing) both; }\n\n.sent.keep {\n  display: inline-block;\n  padding: 0 .25rem;\n  border-inline-start: 3px solid var(--detail-line);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n/* ---------- Choice rows ---------- */\n\n.switches {\n  display: grid;\n  gap: .375rem;\n}\n\n.row {\n  min-width: 0;\n  margin: 0;\n  padding: 0;\n  border: 0;\n}\n\n.row legend {\n  display: flex;\n  align-items: center;\n  gap: .375rem;\n  padding: 0;\n  margin-block-end: .125rem;\n  font-weight: var(--font-weight-semi-bold);\n  line-height: 1.25rem;\n}\n\n.row legend .icon { color: var(--detail-line); }\n\n.opts {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: .5rem;\n}\n\n.opt {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: .25rem;\n  min-height: var(--control-height-medium);\n  padding: .125rem .75rem;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  line-height: 1.25rem;\n  text-align: center;\n  cursor: pointer;\n  transition: var(--transition-colors), var(--transition-press);\n}\n\n.opt:hover { background: var(--background-neutral-secondary); }\n\n.opt:active { transform: scale(var(--motion-press-scale)); }\n\n.opt .check { display: none; }\n\n.opt[aria-pressed=\"true\"] {\n  background: var(--background-selected-primary);\n  border-color: var(--border-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n.opt[aria-pressed=\"true\"] .check { display: inline-block; }\n\n.opt:focus-visible,\n.text-button:focus-visible,\n.btn:focus-visible,\n.author-row select:focus-visible {\n  outline: 2px solid var(--ring);\n  outline-offset: 2px;\n}\n\n/* ---------- Buttons (demo) ---------- */\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: var(--control-height-medium);\n  padding: 0 var(--spacing-p-xs);\n  border: 1px solid transparent;\n  border-radius: var(--shape-md);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n  transition: var(--transition-colors), var(--transition-press);\n}\n\n.btn:active { transform: scale(var(--motion-press-scale)); }\n\n.btn-primary {\n  background: var(--background-brand-primary);\n  color: var(--text-neutral-white-fixed);\n}\n\n.btn-primary:hover { background: var(--background-brand-strong); }\n\n.btn-outline {\n  background: var(--background-neutral-primary);\n  border-color: var(--border-neutral-solid);\n  color: var(--text-neutral-primary);\n}\n\n.btn-outline:hover { background: var(--background-neutral-secondary); }\n\n/* ---------- Demo panel ---------- */\n\n.demo-panel {\n  display: grid;\n  gap: .375rem;\n  padding: .75rem;\n  border-radius: var(--shape-md);\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n}\n\n.demo-step {\n  margin: 0;\n  font-weight: var(--font-weight-semi-bold);\n  letter-spacing: var(--tracking-overline);\n  text-transform: uppercase;\n}\n\n.demo-title {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-xs);\n  line-height: var(--leading-heading-xs);\n  color: var(--text-neutral-primary);\n}\n\n.demo-text {\n  margin: 0;\n  min-height: 2.75rem;\n  color: var(--text-neutral-primary);\n  font-size: var(--text-body-lg);\n  line-height: var(--leading-body-md);\n}\n\n.demo-actions {\n  display: flex;\n  align-items: center;\n  gap: .5rem;\n}\n\n.spark {\n  width: 1.5rem;\n  height: 1.5rem;\n  fill: var(--background-brand-primary);\n  transform-origin: center;\n}\n\n.spark.is-pulsing { animation: spark-pulse .8s var(--easing-out); }\n\n/* ---------- Sample page ---------- */\n\n.page-area {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  min-width: 0;\n}\n\n.site {\n  --site-bg: var(--background-neutral-primary);\n  --site-ink: var(--text-neutral-tertiary);\n  --site-line: var(--border-neutral-primary);\n  --site-a: var(--neutral-gray-10);\n  --site-b: var(--neutral-gray-20);\n  --site-c: var(--neutral-gray-10);\n  --site-label: var(--text-neutral-tertiary);\n  --site-btn-bg: var(--neutral-gray-20);\n  --site-btn-ink: var(--text-neutral-primary);\n  --site-btn-line: transparent;\n  --title-family: var(--font-family-heading);\n  --title-size: 1.25rem;\n  --title-weight: var(--font-weight-semi-bold);\n  overflow: hidden;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-md);\n  background: var(--site-bg);\n  color: var(--site-ink);\n  transition: background-color var(--duration-medium) var(--easing-standard);\n}\n\n/* Looks chosen by \"the feel\", \"colors\" or \"tone\" */\n\n.site-bar {\n  display: flex;\n  align-items: center;\n  gap: .25rem;\n  height: 1.75rem;\n  padding: 0 .5rem;\n  border-bottom: 1px solid var(--border-neutral-primary);\n  background: var(--background-neutral-secondary);\n}\n\n.site-dot {\n  width: .5rem;\n  height: .5rem;\n  border-radius: var(--shape-round);\n  background: var(--neutral-gray-30);\n}\n\n.site-url {\n  margin-inline-start: .5rem;\n  padding: 0 .75rem;\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-quaternary);\n  font-size: var(--text-body-sm);\n  line-height: 1.25rem;\n}\n\n.site-main {\n  display: grid;\n  gap: .625rem;\n  align-content: start;\n  min-height: 15rem;\n  padding: var(--spacing-p-xs);\n}\n\n.site-main.hood-main { min-height: 0; }\n\n.slot,\n.bar {\n  margin: 0;\n  width: fit-content;\n  max-width: 100%;\n  transition: color var(--duration-medium) var(--easing-standard), background-color var(--duration-medium) var(--easing-standard);\n  transition-delay: calc(var(--i, 0) * 60ms);\n}\n\n.slot.is-bar,\n.bar {\n  border-radius: var(--shape-sm);\n  background: var(--neutral-gray-10);\n  color: transparent;\n  user-select: none;\n}\n\n.site-title {\n  font-family: var(--title-family);\n  font-size: var(--title-size);\n  font-weight: var(--title-weight);\n  line-height: 1.2;\n}\n\n.site-title:not(.is-bar) { color: var(--site-ink); }\n\n.site-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: fit-content;\n  min-height: 2.25rem;\n  padding: .125rem var(--spacing-p-xs);\n  border: 2px solid var(--site-btn-line);\n  border-radius: var(--shape-md);\n  background: var(--site-btn-bg);\n  color: var(--site-btn-ink);\n  font-weight: var(--font-weight-bold);\n  transition: background-color var(--duration-medium) var(--easing-standard), color var(--duration-medium) var(--easing-standard);\n}\n\n.site-btn.is-bar { background: var(--neutral-gray-10); color: transparent; }\n\n.site-result { font-weight: var(--font-weight-bold); font-size: var(--text-body-lg); line-height: var(--leading-body-md); }\n\n/* Weather checker */\n\n.w-row { display: flex; gap: .5rem; align-items: stretch; border-radius: var(--shape-md); }\n\n.w-box {\n  display: flex;\n  align-items: center;\n  flex: 1 1 auto;\n  min-width: 0;\n  min-height: 2.5rem;\n  padding: 0 .75rem;\n  border: 1px solid var(--site-line);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n}\n\n.w-placeholder { color: var(--text-neutral-quaternary); }\n\n.site[data-part=\"1\"] .w-btn,\n.site[data-part=\"2\"] .w-btn {\n  background: var(--background-brand-primary);\n  color: var(--text-neutral-white-fixed);\n}\n\n.site[data-part=\"1\"] .w-btn { outline: 3px solid var(--border-brand-strong); outline-offset: 2px; }\n\n.site[data-part=\"2\"] .w-box { outline: 3px solid var(--border-brand-strong); outline-offset: 2px; }\n\n.w-days { display: flex; gap: .5rem; border-radius: var(--shape-md); }\n\n.w-day {\n  padding: .125rem .5rem;\n  border-radius: var(--shape-sm);\n  background: var(--background-info-light);\n  color: var(--text-info-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n/* ---------- Code card ---------- */\n\n.code-card {\n  overflow: hidden;\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n}\n\n.code-head {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  padding: .125rem .75rem;\n  border-bottom: 1px solid var(--border-neutral-primary);\n  background: var(--background-neutral-secondary);\n}\n\n.code-file { font-family: var(--font-family-mono); color: var(--text-neutral-quaternary); }\n\n.code-body {\n  min-height: 10.5rem;\n  padding: .5rem .5rem;\n  font-family: var(--font-family-mono);\n  font-size: var(--text-body-md);\n  line-height: var(--leading-body-md);\n}\n\n.code-empty { margin: 0; padding: .25rem; color: var(--text-neutral-quaternary); }\n\n.code-line {\n  display: grid;\n  grid-template-columns: 1.25rem minmax(0, 1fr);\n  gap: .25rem;\n  align-items: start;\n  padding-inline: .25rem;\n  border-radius: var(--shape-sm);\n  border-inline-start: 3px solid var(--detail-line);\n}\n\n.code-icon { width: 1rem; height: 1rem; margin-block-start: .25rem; color: var(--detail-line); }\n\n.code-text { white-space: pre-wrap; overflow-wrap: anywhere; }\n\n.code-line.is-comment .code-text { color: var(--text-neutral-quaternary); }\n\n.tok-kw { color: var(--syntax-keyword); font-weight: var(--font-weight-semi-bold); }\n\n.tok-str { color: var(--syntax-string); }\n\n.code-line.is-new { animation: line-in 1.2s var(--easing-out) both; }\n\n/* ---------- Note under the page ---------- */\n\n.note {\n  display: grid;\n  gap: .125rem;\n  min-height: 3.5rem;\n}\n\n.note-main {\n  display: flex;\n  align-items: flex-start;\n  gap: .5rem;\n  margin: 0;\n}\n\n.note-main .icon { margin-block-start: .1875rem; color: var(--detail-line); }\n\n.note-status {\n  margin: 0;\n  padding: .125rem .5rem;\n  border-radius: var(--shape-sm);\n  background: var(--background-success-light);\n  color: var(--text-success-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n/* ---------- Flash on the part of the page a detail reached ---------- */\n\n.flash {\n  outline: 3px solid var(--detail-line);\n  outline-offset: -3px;\n  animation: flash-fade 1s ease-out forwards;\n}\n\n/* ---------- Motion ---------- */\n\n@keyframes fade-in {\n  from { opacity: 0; transform: translateY(.25rem); }\n  to { opacity: 1; transform: none; }\n}\n\n@keyframes flash-fade {\n  from { outline-color: var(--detail-line); }\n  to { outline-color: transparent; }\n}\n\n@keyframes line-in {\n  from { background: var(--detail-bg); }\n  to { background: transparent; }\n}\n\n@keyframes spark-pulse {\n  0% { transform: scale(1); opacity: .6; }\n  40% { transform: scale(1.6); opacity: 1; }\n  100% { transform: scale(1); opacity: .9; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n}\n\n/* ---------- Narrow screens ---------- */\n\n@media (max-width: 47.99rem) {\n  .workspace { grid-template-columns: minmax(0, 1fr); }\n\n  .gutter { padding-block: 0; height: 2rem; align-items: center; }\n\n  .site-main { min-height: 0; }\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "'use strict';\n\n/* ------------------------------------------------------------------\n   Prompt dial\n   One engine, four swappable directions. Each direction supplies its\n   details, its sample page and its words (see DIRECTIONS below).\n   ------------------------------------------------------------------ */\n\nconst CONFIG = {\n  // The sample page this widget shows.\n  direction: 'hood',\n  // One-line intro page with a Start button. Address override: ?intro=0\n  showIntro: true,\n  // Short opening demo. Address override: ?demo=0\n  showDemo: true,\n  flashMilliseconds: 1000,\n  completeEventName: 'widget:complete',\n  completeMessageType: 'widget-complete'\n};\n\n/* ---------- Words that are not part of a direction ---------- */\n\nconst T = {\n  intro: {\n    tag: 'Practice',\n    doThis: 'Do This:',\n    doThisText: 'Build a sample prompt step by step. Notice how each additional detail in the prompt improves the output.',\n    title: 'Prompt dial',\n    heading: 'Add details to a prompt',\n    lead: 'You will do this whenever you ask AI to build part of your project.',\n    steps: ['Watch a short demo, step by step.', 'Pick a choice in each row.', 'Change one thing and keep the rest.'],\n    start: 'Start',\n  },\n  prompt: {\n    label: 'Prompt',\n    base: 'Make a site.'\n  },\n  demo: {\n    vague: 'A prompt is your order to the AI. A vague order gets a plain page.',\n    first: (label) => `A specific order gets the page you pictured. Start with ${label}.`,\n    later: (label) => `Next, add ${label}.`,\n    endTitle: 'Every detail helped.',\n    endText: 'Each detail gave the AI more to work with, so the page came out closer to what you pictured.',\n    next: 'Next',\n    start: 'Try it',\n    stepOf: (n, total) => `Step ${n} of ${total}`,\n    ready: 'Your turn. Pick a choice in each row.'\n  },\n  status: {\n    keptRest: 'Changed one thing. The rest stayed the same.',\n    allIn: 'All four details are in. Try changing just one.'\n  },\n  announce: {\n    add: (label, option, note) => `${label}: ${option}. ${note}`,\n    swap: (label, option, note) => `${label} changed to ${option}. ${note} The rest stayed the same.`,\n    remove: (label, note) => `${label} removed. ${note}`\n  },\n  aria: {\n    site: 'Sample page',\n    spark: 'The AI is working',\n    codeCard: 'Code for the sample page'\n  },\n  code: {\n    label: 'Code',\n    file: 'script.js',\n    empty: 'No code yet.'\n  },\n  finish: { label: 'Finish' },\n  takeaway: {\n    title: 'Takeaway: Details in your prompt shape what the AI builds.',\n    text: 'The AI can only build what your prompt says. Each detail you add gives it more to work with, so the page matches your idea.',\n    last: 'Press Continue to go to your project.'\n  },\n  error: 'Something went wrong while loading this activity. Try reloading the page.'\n};\n\n/* ---------- Icons (inline SVG, drawn with strokes) ---------- */\n\nconst ICONS = {\n  code: [['path', { d: 'M8 7l-5 5 5 5M16 7l5 5-5 5' }]],\n  target: [\n    ['circle', { cx: 12, cy: 12, r: 7 }],\n    ['circle', { cx: 12, cy: 12, r: 2 }]\n  ],\n  list: [['path', { d: 'M5 6h14M5 12h14M5 18h9' }]],\n  note: [\n    ['path', { d: 'M6 3h9l4 4v14H6z' }],\n    ['path', { d: 'M9 12h7M9 16h5' }]\n  ],\n  check: [['path', { d: 'M5 12.5l4.5 4.5L19 7.5' }]]\n};\n\n/* ---------- Direction content ---------- */\n\n/*\n  Every direction has four details. Each detail has two options.\n  Option 1 is the phrase from the content table. Option 2 gives students\n  a second choice, so they can swap one detail and keep the rest.\n\n  sentence  Whole sentence that joins the prompt. {phrase} marks the\n            highlighted words.\n  swap      Sentence added to the prompt when a student swaps one option.\n  notes     One short takeaway for each state: [nothing, option 1, option 2].\n  slots     Text on the sample page that depends on a detail. State 0 is\n            the gray placeholder (or flat words when flat is true).\n*/\n\nconst DIRECTIONS = {\n  hood: {\n    name: 'Under the hood: weather checker',\n    globalDetail: null,\n    details: [\n      {\n        id: 'what', icon: 'code', label: 'What it does',\n        sentence: 'It {phrase}.',\n        swap: 'Change only what it does. Keep the rest the same.',\n        options: [\n          { label: 'One city', phrase: 'shows the weather for a city' },\n          { label: 'City, 3 days', phrase: 'shows the weather for a city and the next three days' }\n        ],\n        notes: ['No goal, so no code yet.', 'Code gets the weather for one city.', 'Code gets a city and three days.']\n      },\n      {\n        id: 'part', icon: 'target', label: 'Which part',\n        sentence: 'The code is for {phrase}.',\n        swap: 'Change only which part. Keep the rest the same.',\n        options: [\n          { label: 'Check button', phrase: 'the Check button' },\n          { label: 'Search box', phrase: 'the search box' }\n        ],\n        notes: ['No part named, so no starting point.', 'The code starts when Check is clicked.', 'The code starts when the search box changes.']\n      },\n      {\n        id: 'how', icon: 'list', label: 'How it works',\n        sentence: 'The code {phrase}.',\n        swap: 'Change only how it works. Keep the rest the same.',\n        options: [\n          { label: 'Temperature', phrase: 'looks up the city and shows the temperature' },\n          { label: 'Temp and rain', phrase: 'looks up the city and shows the temperature and rain chance' }\n        ],\n        notes: ['No steps said, so nothing shows.', 'The code shows the temperature.', 'The code shows temperature and rain chance.']\n      },\n      {\n        id: 'explain', icon: 'note', label: 'Explain it',\n        sentence: 'Explain it {phrase}.',\n        swap: 'Change only the explanation. Keep the rest the same.',\n        options: [\n          { label: 'Line by line', phrase: 'in plain words, one line at a time' },\n          { label: 'One summary', phrase: 'in one short summary' }\n        ],\n        notes: ['No explanation, so no comments.', 'Comments (notes for people) explain each line.', 'One comment sums up the code.']\n      }\n    ],\n    slots: {\n      title: { detail: 'what', text: ['Page title', 'Weather checker', 'Weather checker'] },\n      placeholder: { detail: 'what', text: ['Type here', 'Type a city', 'Type a city'] },\n      button: { detail: 'part', text: ['Button', 'Check', 'Check'] },\n      result: { detail: 'how', text: ['Result goes here.', 'Denver: 62 degrees', 'Denver: 62 degrees, 20% rain'] }\n    },\n    days: ['Wed 62', 'Thu 58', 'Fri 60'],\n    url: 'weather.web',\n    code: {\n      summary: 'Checks the weather for a city and shows it on the page.',\n      wrapper: [\n        null,\n        { open: 'checkButton.addEventListener(\"click\", () => {', note: 'Run this when Check is clicked.' },\n        { open: 'searchBox.addEventListener(\"change\", () => {', note: 'Run this when the search box changes.' }\n      ],\n      look: [\n        null,\n        { line: 'const weather = getWeather(cityBox.value);', note: 'Look up the weather for the city.' },\n        { line: 'const weather = getWeather(cityBox.value, 3);', note: 'Look up the city and the next 3 days.' }\n      ],\n      show: [\n        null,\n        { line: 'showText(weather.temp);', note: 'Show the temperature on the page.' },\n        { line: 'showText(weather.temp, weather.rain);', note: 'Show the temperature and rain chance.' }\n      ],\n      close: '});'\n    }\n  }\n};\n\n/* ---------- Small helpers ---------- */\n\nconst SVG_NS = 'http://www.w3.org/2000/svg';\n\nfunction h(tag, props, ...kids) {\n  const el = document.createElement(tag);\n  if (props) {\n    for (const [key, value] of Object.entries(props)) {\n      if (value === false || value === null || value === undefined) continue;\n      if (key === 'class') el.className = value;\n      else if (key === 'text') el.textContent = value;\n      else el.setAttribute(key, value === true ? '' : value);\n    }\n  }\n  for (const kid of kids) if (kid) el.append(kid);\n  return el;\n}\n\nfunction s(tag, attrs, ...kids) {\n  const el = document.createElementNS(SVG_NS, tag);\n  if (attrs) for (const [key, value] of Object.entries(attrs)) el.setAttribute(key, String(value));\n  for (const kid of kids) if (kid) el.append(kid);\n  return el;\n}\n\nfunction icon(name, extraClass) {\n  const svg = s('svg', {\n    viewBox: '0 0 24 24',\n    class: extraClass ? `icon ${extraClass}` : 'icon',\n    'aria-hidden': 'true',\n    focusable: 'false'\n  });\n  for (const [tag, attrs] of ICONS[name]) svg.append(s(tag, attrs));\n  return svg;\n}\n\nfunction prefersReducedMotion() {\n  return Boolean(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);\n}\n\nfunction readParams() {\n  try {\n    const params = new URLSearchParams(window.location.search);\n    return { demo: params.get('demo'), intro: params.get('intro') };\n  } catch (err) {\n    return { demo: null, intro: null };\n  }\n}\n\n/* ---------- State ---------- */\n\nconst els = {};\nconst state = {\n  dirId: null,\n  dir: null,\n  values: {},\n  mode: 'play',\n  swapId: null\n};\nlet demoStep = 0;\nlet timers = [];\nlet site = null;\n\nfunction later(fn, ms) {\n  timers.push(window.setTimeout(fn, ms));\n}\n\nfunction clearTimers() {\n  timers.forEach((id) => window.clearTimeout(id));\n  timers = [];\n}\n\nfunction detailIndex(id) {\n  return state.dir.details.findIndex((d) => d.id === id);\n}\n\nfunction resetValues() {\n  state.values = {};\n  state.dir.details.forEach((d) => { state.values[d.id] = 0; });\n  state.swapId = null;\n}\n\nfunction allChosen() {\n  return state.dir.details.every((d) => state.values[d.id] > 0);\n}\n\n/* ---------- Sample page builders ---------- */\n\nfunction slotEl(name, tag, extraClass) {\n  const def = state.dir.slots[name];\n  const classes = ['slot'];\n  if (extraClass) classes.push(extraClass);\n  if (def.flat) classes.push('is-flat');\n  return h(tag, { class: classes.join(' '), 'data-slot': name });\n}\n\nfunction bar(text) {\n  return h('p', { class: 'bar', 'aria-hidden': 'true', text });\n}\n\nfunction siteFrame(dir) {\n  const root = h('div', { class: 'site', role: 'group', 'aria-label': T.aria.site, 'data-dir': state.dirId });\n  if (dir.globalDetail) root.classList.add(`r-${dir.globalDetail}`);\n  const topBar = h('div', { class: 'site-bar', 'aria-hidden': 'true' },\n    h('span', { class: 'site-dot' }), h('span', { class: 'site-dot' }), h('span', { class: 'site-dot' }),\n    h('span', { class: 'site-url', text: dir.url }));\n  root.append(topBar);\n  return root;\n}\n\nconst BUILDERS = {\n  hood(dir, root) {\n    root.append(h('div', { class: 'site-main hood-main' },\n      slotEl('title', 'p', 'site-title r-what'),\n      h('div', { class: 'w-row r-part' },\n        h('div', { class: 'w-box' }, slotEl('placeholder', 'span', 'w-placeholder')),\n        slotEl('button', 'div', 'site-btn w-btn')),\n      slotEl('result', 'p', 'site-result r-how'),\n      h('div', { class: 'w-days r-what', hidden: true })));\n  }\n};\n\n/* ---------- Sample page rendering ---------- */\n\nfunction applySlots() {\n  const slots = state.dir.slots;\n  site.querySelectorAll('.slot').forEach((el, index) => {\n    const def = slots[el.getAttribute('data-slot')];\n    const value = state.values[def.detail];\n    const text = def.text[value];\n    if (el.textContent !== text) el.textContent = text;\n    const isBar = value === 0 && !def.flat;\n    el.classList.toggle('is-bar', isBar);\n    el.toggleAttribute('aria-hidden', isBar);\n    el.style.setProperty('--i', String(index));\n  });\n}\n\nfunction renderDays(value) {\n  const days = site.querySelector('.w-days');\n  days.textContent = '';\n  days.hidden = value !== 2;\n  if (value !== 2) return;\n  state.dir.days.forEach((day) => days.append(h('span', { class: 'w-day', text: day })));\n}\n\n/* Code card for the \"hood\" direction */\n\nfunction highlight(text) {\n  const frag = document.createDocumentFragment();\n  const parts = text.split(/(\\bconst\\b|\"[^\"]*\")/g);\n  parts.forEach((part) => {\n    if (!part) return;\n    if (part === 'const') frag.append(h('span', { class: 'tok-kw', text: part }));\n    else if (part.charAt(0) === '\"') frag.append(h('span', { class: 'tok-str', text: part }));\n    else frag.append(part);\n  });\n  return frag;\n}\n\nfunction buildCodeLines() {\n  const code = state.dir.code;\n  const v = state.values;\n  const lines = [];\n  const push = (text, src, kind, key) => lines.push({ text, src, kind, key });\n  const anyCode = v.part || v.what || v.how;\n  const pad = v.part ? '  ' : '';\n  if (v.explain === 2 && anyCode) push(`// ${code.summary}`, 'explain', 'comment', 'summary');\n  const wrap = code.wrapper[v.part];\n  if (wrap) {\n    if (v.explain === 1) push(`// ${wrap.note}`, 'explain', 'comment', `wrap-note-${v.part}`);\n    push(wrap.open, 'part', 'code', `wrap-${v.part}`);\n  }\n  const look = code.look[v.what];\n  if (look) {\n    if (v.explain === 1) push(`${pad}// ${look.note}`, 'explain', 'comment', `look-note-${v.what}`);\n    push(`${pad}${look.line}`, 'what', 'code', `look-${v.what}`);\n  }\n  const show = code.show[v.how];\n  if (show) {\n    if (v.explain === 1) push(`${pad}// ${show.note}`, 'explain', 'comment', `show-note-${v.how}`);\n    push(`${pad}${show.line}`, 'how', 'code', `show-${v.how}`);\n  }\n  if (wrap) push(code.close, 'part', 'code', `close-${v.part}`);\n  return lines;\n}\n\nlet previousCodeKeys = new Set();\n\nfunction renderCode(animate) {\n  const body = els.codeBody;\n  const lines = buildCodeLines();\n  body.textContent = '';\n  if (!lines.length) {\n    body.append(h('p', { class: 'code-empty', text: T.code.empty }));\n    previousCodeKeys = new Set();\n    return;\n  }\n  lines.forEach((line) => {\n    const index = detailIndex(line.src) + 1;\n    const row = h('div', { class: `code-line is-d${index}${line.kind === 'comment' ? ' is-comment' : ''}` });\n    row.append(icon(state.dir.details[index - 1].icon, 'code-icon'));\n    const text = h('span', { class: 'code-text' });\n    text.append(line.kind === 'comment' ? line.text : highlight(line.text));\n    row.append(text);\n    if (animate && !previousCodeKeys.has(line.key)) row.classList.add('is-new');\n    body.append(row);\n  });\n  previousCodeKeys = new Set(lines.map((line) => line.key));\n}\n\nfunction buildCodeCard() {\n  els.codeBody = h('div', { class: 'code-body' });\n  return h('section', { class: 'code-card', 'aria-label': T.aria.codeCard },\n    h('div', { class: 'code-head' },\n      h('span', { class: 'overline', text: T.code.label }),\n      h('span', { class: 'code-file', text: T.code.file })),\n    els.codeBody);\n}\n\nconst RENDERERS = {\n  hood(prev, animate) {\n    const v = state.values;\n    if (!prev || prev.what !== v.what) renderDays(v.what);\n    renderCode(animate);\n  }\n};\n\nfunction renderPage(prev, animate) {\n  const dir = state.dir;\n  dir.details.forEach((d) => site.setAttribute(`data-${d.id}`, String(state.values[d.id])));\n  applySlots();\n  RENDERERS[state.dirId](prev, animate);\n}\n\n/* ---------- Prompt, switches and notes ---------- */\n\nfunction sentenceEl(template, phrase, index) {\n  const [before, after] = template.split('{phrase}');\n  const words = phrase.split(' ');\n  const first = words.shift();\n  const phraseEl = h('span', { class: `phrase is-d${index + 1}` },\n    h('span', { class: 'nowrap' }, icon(state.dir.details[index].icon), first));\n  if (words.length) phraseEl.append(` ${words.join(' ')}`);\n  const sentence = h('span', { class: 'sent' });\n  sentence.append(before, phraseEl, after);\n  return sentence;\n}\n\nfunction renderPrompt(info) {\n  const box = els.promptText;\n  box.textContent = '';\n  box.append(h('span', { class: 'sent', text: T.prompt.base }));\n  state.dir.details.forEach((d, i) => {\n    const value = state.values[d.id];\n    if (!value) return;\n    const sentence = sentenceEl(d.sentence, d.options[value - 1].phrase, i);\n    if (info && info.id === d.id && info.move !== 'remove') sentence.classList.add('is-new');\n    box.append(' ', sentence);\n  });\n  if (state.swapId) {\n    box.append(' ', h('span', { class: `sent keep is-new is-d${detailIndex(state.swapId) + 1}`, text: state.dir.details[detailIndex(state.swapId)].swap }));\n  }\n}\n\nfunction buildGhost() {\n  const ghost = els.promptGhost;\n  ghost.textContent = '';\n  ghost.append(h('span', { class: 'sent', text: T.prompt.base }));\n  let longestSwap = 0;\n  state.dir.details.forEach((d, i) => {\n    let longest = 0;\n    d.options.forEach((o, k) => { if (o.phrase.length > d.options[longest].phrase.length) longest = k; });\n    ghost.append(' ', sentenceEl(d.sentence, d.options[longest].phrase, i));\n    if (d.swap.length > state.dir.details[longestSwap].swap.length) longestSwap = i;\n  });\n  const swapDetail = state.dir.details[longestSwap];\n  ghost.append(' ', h('span', { class: `sent keep is-d${longestSwap + 1}`, text: swapDetail.swap }));\n}\n\nfunction buildSwitches() {\n  els.switches.textContent = '';\n  state.dir.details.forEach((d, i) => {\n    const row = h('fieldset', { class: `row is-d${i + 1}`, 'data-detail': d.id });\n    row.append(h('legend', null, icon(d.icon), h('span', { text: d.label })));\n    const opts = h('div', { class: 'opts' });\n    d.options.forEach((o, k) => {\n      opts.append(h('button', { type: 'button', class: 'opt', 'aria-pressed': 'false', 'data-option': String(k + 1) },\n        icon('check', 'check'), h('span', { text: o.label })));\n    });\n    row.append(opts);\n    els.switches.append(row);\n  });\n}\n\nfunction renderSwitches() {\n  els.switches.querySelectorAll('.row').forEach((row) => {\n    const value = state.values[row.getAttribute('data-detail')];\n    row.querySelectorAll('.opt').forEach((btn) => {\n      btn.setAttribute('aria-pressed', String(Number(btn.getAttribute('data-option')) === value));\n    });\n  });\n}\n\nfunction renderNote(info) {\n  const note = els.note;\n  note.textContent = '';\n  if (!info) return;\n  const index = detailIndex(info.id);\n  const d = state.dir.details[index];\n  const line = h('p', { class: `note-main is-d${index + 1}` }, icon(d.icon),\n    h('span', null, h('strong', { text: `${d.label}: ` }), d.notes[state.values[d.id]]));\n  note.append(line);\n  if (info.move === 'swap') note.append(h('p', { class: 'note-status', text: T.status.keptRest }));\n  else if (state.mode === 'play' && allChosen()) note.append(h('p', { class: 'note-status', text: T.status.allIn }));\n}\n\n/* ---------- Feedback: flash, pulse, announcer ---------- */\n\nfunction flashRegion(id) {\n  const index = detailIndex(id) + 1;\n  const nodes = els.pageArea.querySelectorAll(`.r-${id}`);\n  nodes.forEach((node) => {\n    node.setAttribute('data-flash', String(index));\n    node.classList.remove('flash');\n    void node.offsetWidth;\n    node.classList.add('flash');\n  });\n  window.setTimeout(() => nodes.forEach((node) => node.classList.remove('flash')), CONFIG.flashMilliseconds);\n}\n\nfunction pulse() {\n  [els.spark].forEach((el) => {\n    if (!el) return;\n    el.classList.remove('is-pulsing');\n    void el.getBoundingClientRect();\n    el.classList.add('is-pulsing');\n  });\n}\n\nfunction announce(text) {\n  els.announcer.textContent = '';\n  window.setTimeout(() => { els.announcer.textContent = text; }, 30);\n}\n\n/* ---------- One move ---------- */\n\nfunction renderAll(prev, info) {\n  renderPrompt(info);\n  renderSwitches();\n  renderPage(prev, Boolean(info));\n  renderNote(info);\n  renderFinish();\n}\n\nfunction applyMove(id, next, options) {\n  const quiet = Boolean(options && options.quiet);\n  const prev = Object.assign({}, state.values);\n  const before = prev[id];\n  state.values[id] = next;\n  const move = next === 0 ? 'remove' : (before === 0 ? 'add' : 'swap');\n  state.swapId = move === 'swap' ? id : null;\n  const info = { id, move };\n  renderAll(prev, info);\n  flashRegion(id);\n  pulse();\n  const d = state.dir.details[detailIndex(id)];\n  if (!quiet) {\n    const note = d.notes[next];\n    if (move === 'add') announce(T.announce.add(d.label, d.options[next - 1].label, note));\n    else if (move === 'swap') announce(T.announce.swap(d.label, d.options[next - 1].label, note));\n    else announce(T.announce.remove(d.label, note));\n  }\n}\n\nfunction choose(id, option) {\n  applyMove(id, state.values[id] === option ? 0 : option);\n}\n\nlet completionReported = false;\n\nfunction reportComplete() {\n  if (completionReported) return;\n  completionReported = true;\n  try {\n    window.dispatchEvent(new CustomEvent(CONFIG.completeEventName));\n  } catch (err) { /* no listener needed */ }\n  try {\n    if (window.parent && window.parent !== window) {\n      window.parent.postMessage({ type: CONFIG.completeMessageType }, '*');\n    }\n  } catch (err) { /* sandbox may block it */ }\n}\n\nfunction renderFinish() {\n  els.finishButton.hidden = state.mode !== 'play' || !allChosen();\n}\n\nfunction finish() {\n  reportComplete();\n  buildTakeawayLabels();\n  setStage('done');\n  els.takeaway.focus();\n}\n\nfunction buildTakeawayLabels() {\n  els.takeawayLabels.textContent = '';\n  state.dir.details.forEach((d, i) => {\n    els.takeawayLabels.append(h('li', { class: `takeaway-label is-d${i + 1}` }, icon(d.icon), h('span', { text: d.label })));\n  });\n}\n\n/* ---------- Direction setup ---------- */\n\nfunction buildDirection(id) {\n  clearTimers();\n  state.dirId = id;\n  state.dir = DIRECTIONS[id];\n  resetValues();\n  previousCodeKeys = new Set();\n  els.pageArea.textContent = '';\n  site = siteFrame(state.dir);\n  BUILDERS[id](state.dir, site);\n  els.pageArea.append(site);\n  els.pageArea.append(buildCodeCard());\n  buildSwitches();\n  buildGhost();\n  renderAll(null, null);\n}\n\n/* ---------- Demo ---------- */\n\nfunction setMode(mode) {\n  state.mode = mode;\n  els.workspace.setAttribute('data-mode', mode);\n  els.switches.hidden = mode !== 'play';\n  els.demoPanel.hidden = mode !== 'demo';\n  renderFinish();\n}\n\nfunction setCaption(title, text, stepText) {\n  els.demoStep.textContent = stepText;\n  els.demoTitle.textContent = title;\n  els.demoTitle.hidden = !title;\n  els.demoText.textContent = text;\n}\n\nfunction setAllChosen() {\n  state.dir.details.forEach((d) => { state.values[d.id] = 1; });\n  state.swapId = null;\n  renderAll(null, null);\n}\n\nfunction showStep(n) {\n  clearTimers();\n  demoStep = n;\n  const details = state.dir.details;\n  const total = details.length + 2;\n  const last = n === total;\n  const stepText = T.demo.stepOf(n, total);\n  els.demoNext.textContent = last ? T.demo.start : T.demo.next;\n  els.demoNext.classList.toggle('btn-primary', last);\n  els.demoNext.classList.toggle('btn-outline', !last);\n  if (n === 1) {\n    resetValues();\n    renderAll(null, null);\n    setCaption('', T.demo.vague, stepText);\n    announce(T.demo.vague);\n    pulse();\n  } else if (!last) {\n    const index = n - 2;\n    details.forEach((d, i) => { if (i < index) state.values[d.id] = 1; });\n    const label = details[index].label.toLowerCase();\n    const caption = index === 0 ? T.demo.first(label) : T.demo.later(label);\n    setCaption('', caption, stepText);\n    announce(caption);\n    applyMove(details[index].id, 1, { quiet: true });\n  } else {\n    setAllChosen();\n    setCaption(T.demo.endTitle, T.demo.endText, stepText);\n    announce(`${T.demo.endTitle} ${T.demo.endText}`);\n    pulse();\n  }\n}\n\nfunction startDemo() {\n  setMode('demo');\n  showStep(1);\n}\n\nfunction startPlay(shouldFocus) {\n  clearTimers();\n  demoStep = 0;\n  resetValues();\n  renderAll(null, null);\n  setMode('play');\n  if (shouldFocus) {\n    announce(T.demo.ready);\n    const first = els.switches.querySelector('.opt');\n    if (first) first.focus();\n  }\n}\n\n/* ---------- Intro page ---------- */\n\nfunction setStage(stage) {\n  const intro = stage === 'intro';\n  const done = stage === 'done';\n  els.header.hidden = done;\n  els.introScreen.hidden = !intro;\n  els.practiceLine.hidden = intro;\n  els.doThis.hidden = intro;\n  els.workspace.hidden = intro || done;\n  els.takeaway.hidden = !done;\n}\n\nfunction leaveIntro() {\n  setStage('active');\n}\n\n/* ---------- Page setup ---------- */\n\nfunction buildSpark() {\n  const svg = s('svg', { viewBox: '0 0 24 24', class: 'spark', role: 'img', 'aria-label': T.aria.spark });\n  svg.append(s('path', { d: 'M12 2l2.6 7.4L22 12l-7.4 2.6L12 22l-2.6-7.4L2 12l7.4-2.6z' }));\n  return svg;\n}\n\nfunction fillText() {\n  document.querySelectorAll('[data-text]').forEach((el) => {\n    const value = el.getAttribute('data-text').split('.').reduce((obj, key) => obj[key], T);\n    el.textContent = value;\n  });\n}\n\nfunction showError() {\n  const box = els.error || document.getElementById('error');\n  if (!box) return;\n  box.textContent = T.error;\n  box.hidden = false;\n}\n\nfunction init() {\n  ['widget', 'workspace', 'pageArea', 'promptText', 'promptGhost', 'switches', 'note', 'announcer',\n    'demoPanel', 'demoStep', 'demoTitle', 'demoText', 'demoNext',  'header', 'introScreen', 'startButton', 'finishButton', 'takeaway', 'takeawayLabels', 'practiceLine', 'doThis', 'sparkHolder', 'error'].forEach((id) => {\n    els[id] = document.getElementById(id);\n  });\n  fillText();\n\n  els.spark = buildSpark();\n  els.sparkHolder.append(els.spark);\n\n\n  const params = readParams();\n  buildDirection(CONFIG.direction);\n\n  els.switches.addEventListener('click', (event) => {\n    const button = event.target.closest('.opt');\n    if (!button) return;\n    choose(button.closest('.row').getAttribute('data-detail'), Number(button.getAttribute('data-option')));\n  });\n  els.demoNext.addEventListener('click', () => {\n    if (demoStep === state.dir.details.length + 2) startPlay(true);\n    else showStep(demoStep + 1);\n  });\n\n  els.finishButton.addEventListener('click', finish);\n  els.startButton.addEventListener('click', () => {\n    leaveIntro();\n    if (CONFIG.showDemo && params.demo !== '0') startDemo();\n    else startPlay(true);\n  });\n\n  if (CONFIG.showIntro && params.intro !== '0') {\n    setStage('intro');\n    startPlay(false);\n  } else if (CONFIG.showDemo && params.demo !== '0') {\n    startDemo();\n  } else {\n    startPlay(false);\n  }\n}\n\nwindow.addEventListener('error', showError);\n\ntry {\n  init();\n} catch (err) {\n  showError();\n}\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    },
