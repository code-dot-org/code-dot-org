<Weblab2>
  <config><![CDATA[{
  "published": true,
  "game_id": 74,
  "created_at": "2026-11-03T04:24:32.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": "true",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Readable and clear</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"widget\" id=\"widget\">\n    <div class=\"error-banner\" id=\"error\" role=\"alert\" hidden></div>\n    <h1 class=\"visually-hidden\" data-text=\"intro.title\"></h1>\n\n    <section class=\"intro-screen\" id=\"introScreen\" hidden>\n      <span class=\"tag\" data-text=\"intro.tag\"></span>\n      <h2 class=\"intro-title\" data-text=\"intro.heading\"></h2>\n      <p class=\"intro-lead\" id=\"introLead\"></p>\n      <ol class=\"intro-steps\">\n        <li data-text=\"intro.steps.0\"></li>\n        <li data-text=\"intro.steps.1\"></li>\n        <li data-text=\"intro.steps.2\"></li>\n      </ol>\n      <button type=\"button\" class=\"btn btn-primary\" id=\"startButton\" data-text=\"intro.start\"></button>\n    </section>\n\n    <section class=\"demo-screen\" id=\"demoScreen\" hidden>\n      <p class=\"demo-step\" id=\"demoStep\"></p>\n      <div class=\"demo-pair\" id=\"demoPair\"></div>\n      <p class=\"demo-text\" id=\"demoText\"></p>\n      <div>\n        <button type=\"button\" class=\"btn btn-outline\" id=\"demoNext\"></button>\n      </div>\n    </section>\n\n    <section class=\"activity\" id=\"activity\" hidden>\n      <header class=\"intro\">\n        <div class=\"intro-line\">\n          <span class=\"tag\" data-text=\"intro.tag\"></span>\n          <p class=\"do-this\"><strong data-text=\"doThis.label\"></strong> <span id=\"doThis\"></span></p>\n        </div>\n      </header>\n\n      <div class=\"workspace\">\n        <section class=\"col\">\n          <div class=\"stage\">\n            <div class=\"sample\" id=\"card\" role=\"group\" aria-label=\"Sample card\"></div>\n          </div>\n          <div class=\"gauge card\" role=\"group\" aria-label=\"Readability gauge\">\n            <span class=\"overline\" data-text=\"gauge.label\"></span>\n            <div class=\"gauge-bar\" id=\"gaugeBar\" data-level=\"0\" aria-hidden=\"true\">\n              <span class=\"gauge-seg\"></span><span class=\"gauge-seg\"></span><span class=\"gauge-seg\"></span>\n            </div>\n            <p class=\"gauge-level\" id=\"gaugeLevel\"></p>\n            <p class=\"gauge-reason\" id=\"gaugeReason\"></p>\n          </div>\n        </section>\n\n        <section class=\"col\">\n          <div class=\"col\" id=\"slidePanel\" hidden>\n            <div class=\"sliders\" id=\"sliders\"></div>\n            <p class=\"fact\" data-text=\"fact\"></p>\n            <div class=\"button-row\">\n              <button type=\"button\" class=\"btn btn-primary\" id=\"nextButton\" data-text=\"controls.next\" hidden></button>\n            </div>\n          </div>\n\n          <div class=\"col\" id=\"askPanel\" hidden>\n            <div class=\"card prompt-card\">\n              <span class=\"overline\" data-text=\"ask.label\"></span>\n              <div class=\"prompt-box\">\n                <p class=\"prompt-text\" id=\"promptText\"></p>\n                <p class=\"prompt-ghost\" id=\"promptGhost\" aria-hidden=\"true\"></p>\n              </div>\n            </div>\n            <div class=\"phrases\" id=\"phrases\" role=\"group\" aria-label=\"Phrases to ask the AI\"></div>\n            <div class=\"note\" id=\"note\"></div>\n            <div class=\"button-row\">\n              <button type=\"button\" class=\"btn btn-primary\" id=\"finishButton\" data-text=\"finish\" hidden></button>\n            </div>\n          </div>\n        </section>\n      </div>\n    </section>\n\n    <span class=\"probe\" id=\"probe\" aria-hidden=\"true\"></span>\n    <div class=\"visually-hidden\" id=\"announcer\" aria-live=\"polite\" aria-atomic=\"true\"></div>\n\n    <section class=\"takeaway-page\" id=\"takeaway\" aria-labelledby=\"takeaway-title\" tabindex=\"-1\" hidden>\n      <h2 class=\"intro-title\" id=\"takeaway-title\" data-text=\"takeaway.title\"></h2>\n      <p class=\"intro-lead\" data-text=\"takeaway.text\"></p>\n      <ul class=\"takeaway-labels\" id=\"takeawayLabels\"></ul>\n      <p class=\"takeaway-last\"><strong data-text=\"takeaway.last\"></strong></p>\n    </section>\n  </main>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "'use strict';\n\n/* ------------------------------------------------------------------\n   Readable and clear\n   Skill: Build with AI.\n   Students slide text color, background color and text size on a sample\n   card and watch a readability gauge. Then they tap phrases to ask the AI\n   for the same changes.\n   ------------------------------------------------------------------ */\n\nconst CONFIG = {\n  // Intro page with a Start button. Address override: ?intro=0\n  showIntro: true,\n  // Step-by-step demo after Start. Address override: ?demo=0\n  showDemo: true,\n  // Gauge thresholds (WCAG contrast ratios and text sizes in pixels)\n  contrastGood: 4.5,\n  contrastOkay: 3,\n  sizeGood: 16,\n  sizeOkay: 14,\n  flashMilliseconds: 1000,\n  completeEventName: 'widget:complete',\n  completeMessageType: 'widget-complete'\n};\n\n/* ---------- Words ---------- */\n\nconst T = {\n  intro: {\n    title: 'Readable and clear',\n    tag: 'Practice',\n    heading: 'Make text easy to read',\n    term: 'Readable',\n    definition: ' text is easy to see and understand. It is big enough, stands out from the background, and uses clear words.',\n    steps: [\n      'Slide the text color, background color and text size.',\n      'Watch the gauge show how easy the text is to read.',\n      'Ask the AI for the same changes with phrases.'\n    ],\n    start: 'Start'\n  },\n  demo: {\n    stepOf: (n, total) => `Step ${n} of ${total}`,\n    next: 'Next',\n    start: 'Try it'\n  },\n  doThis: {\n    label: 'Do This:',\n    slide: 'Slide each control until the gauge says the text is easy to read.',\n    ask: 'Tap phrases to ask the AI for the same changes.'\n  },\n  controls: {\n    next: 'Next'\n  },\n  gauge: {\n    label: 'Readability',\n    levels: ['Hard to read', 'Okay to read', 'Easy to read'],\n    reasons: {\n      size: 'The text is small.',\n      contrast: 'The text and background are too close in color. That is low contrast.',\n      good: 'The text is big and stands out from the background.'\n    },\n    announce: (level, reason) => `${level}. ${reason}`\n  },\n  fact: 'Accessibility specialists check contrast so everyone can read a page.',\n  ask: {\n    label: 'Prompt',\n    base: 'Make the card easier to read.',\n    removed: 'That change is undone.',\n    announce: (label, note, level) => `${label}: ${note} ${level}.`\n  },\n  finish: 'Finish',\n  takeaway: {\n    title: 'Takeaway: Tell the AI exactly how to make text readable.',\n    text: 'The AI aims at what your prompt names. Ask for the size, the contrast or the wording you want, and the text gets easier to read.',\n    last: 'Press Continue to go to your project.'\n  },\n  aria: {\n    card: 'Sample card',\n    gauge: 'Readability gauge',\n    phrases: 'Phrases to ask the AI'\n  },\n  error: 'Something went wrong while loading this activity. Try reloading the page.'\n};\n\n/* ---------- Content ---------- */\n\n/*\n  Colors come only from the CADS gray ramp, so every step is a token.\n  The sliders step through the same ramp, light to dark.\n*/\nconst RAMP = [\n  { name: 'White', token: '--neutral-base-white' },\n  { name: 'Very light gray', token: '--neutral-gray-10' },\n  { name: 'Light gray', token: '--neutral-gray-30' },\n  { name: 'Medium gray', token: '--neutral-gray-50' },\n  { name: 'Dark gray', token: '--neutral-gray-70' },\n  { name: 'Very dark gray', token: '--neutral-gray-90' },\n  { name: 'Black', token: '--neutral-base-black' }\n];\n\nconst SIZES = [12, 14, 16, 18, 20, 24];\n\n/* The card starts pale, small and confusing on purpose. */\nconst START = { text: 2, bg: 1, size: 0 };\n\nconst CARD_WORDS = {\n  clear: { title: 'Movie night', body: 'Movie night is Friday at 6 in the gym. Bring a blanket and a snack.', button: 'Save my seat' },\n  confusing: { title: 'Fri thing', body: 'Do the stuff there. Bring things.', button: 'Do it' }\n};\n\n/* Category colors and icons: size, contrast, wording, and the vague ask. */\nconst CATEGORIES = {\n  size: { icon: 'size', label: 'Size', tone: 1 },\n  contrast: { icon: 'contrast', label: 'Contrast', tone: 2 },\n  wording: { icon: 'bubble', label: 'Wording', tone: 3 },\n  vague: { icon: 'spark', label: 'Vague ask', tone: 4 }\n};\n\nconst SLIDERS = [\n  {\n    id: 'text', category: 'contrast', label: 'Text color', max: RAMP.length - 1,\n    ends: ['Light', 'Dark'], valueText: (v) => RAMP[v].name\n  },\n  {\n    id: 'bg', category: 'contrast', label: 'Background color', max: RAMP.length - 1,\n    ends: ['Light', 'Dark'], valueText: (v) => RAMP[v].name\n  },\n  {\n    id: 'size', category: 'size', label: 'Text size', max: SIZES.length - 1,\n    ends: ['Small', 'Big'], valueText: (v) => `${formatNumber(SIZES[v])} px`\n  }\n];\n\n/*\n  Phrases. Each one adds a whole sentence to the prompt and changes the card.\n  effect: what the phrase asks the AI to change.\n*/\nconst PHRASES = [\n  { id: 'darker', icons: ['contrast'], category: 'contrast', label: 'Make the text darker', sentence: 'Make the text darker.',\n    effect: { text: 5 }, note: 'Darker text stands out from the background.' },\n  { id: 'bigger', icons: ['size'], category: 'size', label: 'Make the text bigger', sentence: 'Make the text bigger.',\n    effect: { size: 4 }, note: 'Bigger text is easier to see.' },\n  { id: 'lighter', icons: ['contrast'], category: 'contrast', label: 'Use a lighter background', sentence: 'Use a lighter background.',\n    effect: { bg: 0 }, note: 'A lighter background changes the contrast.' },\n  { id: 'both', icons: ['contrast', 'size'], category: 'contrast', label: 'Make the text darker and bigger', sentence: 'Make the text darker and bigger.',\n    effect: { text: 5, size: 4 }, note: 'One phrase asked for two details.', title: 'Contrast and size' },\n  { id: 'words', icons: ['bubble'], category: 'wording', label: 'Use clearer words', sentence: 'Use clearer words.',\n    effect: { clear: true }, note: 'Clear words say what the card is for.' },\n  { id: 'vague', icons: ['spark'], category: 'vague', label: 'Make it look better', sentence: 'Make it look better.',\n    effect: { vague: true }, note: 'The look changed, but the text is no easier to read.' }\n];\n\n/* Demo: three side-by-side comparisons, one idea each. */\nconst DEMO = [\n  {\n    category: 'size',\n    caption: 'Size: tiny text is hard to read. Bigger text is easier to see.',\n    left: { label: 'Tiny text', icon: 'alert', card: { text: 5, bg: 0, size: 0, words: 'clear' } },\n    right: { label: 'Bigger text', icon: 'check', card: { text: 5, bg: 0, size: 4, words: 'clear' } }\n  },\n  {\n    category: 'contrast',\n    caption: 'Contrast: pale text on a pale background fades. Dark text on a light background stands out.',\n    left: { label: 'Pale on pale', icon: 'alert', card: { text: 2, bg: 1, size: 3, words: 'clear' } },\n    right: { label: 'Dark on light', icon: 'check', card: { text: 5, bg: 0, size: 3, words: 'clear' } }\n  },\n  {\n    category: 'wording',\n    caption: 'Wording: a confusing label hides what the button does. A clear label says it.',\n    left: { label: 'Confusing label', icon: 'alert', card: { text: 5, bg: 0, size: 3, words: 'confusing' } },\n    right: { label: 'Clear label', icon: 'check', card: { text: 5, bg: 0, size: 3, words: 'clear' } }\n  }\n];\n\n/* ---------- Icons (inline SVG, drawn with strokes) ---------- */\n\nconst ICONS = {\n  size: [['path', { d: 'M4 19L9 5l5 14M6 14h6M16 19l3.5-9 3.5 9M17.3 16h4.4' }]],\n  contrast: [\n    ['circle', { cx: 12, cy: 12, r: 8 }],\n    ['path', { d: 'M12 4v16a8 8 0 0 1 0-16z', fill: 'currentColor' }]\n  ],\n  bubble: [['path', { d: 'M4 5h16v11H9l-5 4z' }]],\n  spark: [['path', { d: 'M12 3l2.2 6.3L21 12l-6.8 2.7L12 21l-2.2-6.3L3 12l6.8-2.7z' }]],\n  check: [['path', { d: 'M5 12.5l4.5 4.5L19 7.5' }]],\n  alert: [\n    ['path', { d: 'M12 4l9 16H3z' }],\n    ['path', { d: 'M12 10v4M12 17v.5' }]\n  ],\n  minus: [\n    ['circle', { cx: 12, cy: 12, r: 8 }],\n    ['path', { d: 'M8 12h8' }]\n  ],\n  info: [\n    ['circle', { cx: 12, cy: 12, r: 8 }],\n    ['path', { d: 'M12 11v5M12 8v.5' }]\n  ]\n};\n\n/* ---------- Helpers ---------- */\n\nconst SVG_NS = 'http://www.w3.org/2000/svg';\n\nfunction h(tag, props, ...kids) {\n  const el = document.createElement(tag);\n  if (props) {\n    for (const [key, value] of Object.entries(props)) {\n      if (value === false || value === null || value === undefined) continue;\n      if (key === 'class') el.className = value;\n      else if (key === 'text') el.textContent = value;\n      else el.setAttribute(key, value === true ? '' : value);\n    }\n  }\n  for (const kid of kids) if (kid) el.append(kid);\n  return el;\n}\n\nfunction s(tag, attrs) {\n  const el = document.createElementNS(SVG_NS, tag);\n  if (attrs) for (const [key, value] of Object.entries(attrs)) el.setAttribute(key, String(value));\n  return el;\n}\n\nfunction icon(name, extraClass) {\n  const svg = s('svg', {\n    viewBox: '0 0 24 24',\n    class: extraClass ? `icon ${extraClass}` : 'icon',\n    'aria-hidden': 'true',\n    focusable: 'false'\n  });\n  for (const [tag, attrs] of ICONS[name]) svg.append(s(tag, attrs));\n  return svg;\n}\n\nfunction formatNumber(value) {\n  try {\n    return new Intl.NumberFormat(document.documentElement.lang || 'en').format(value);\n  } catch (err) {\n    return String(value);\n  }\n}\n\nfunction prefersReducedMotion() {\n  return Boolean(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);\n}\n\nfunction readParams() {\n  try {\n    const params = new URLSearchParams(window.location.search);\n    return { demo: params.get('demo'), intro: params.get('intro') };\n  } catch (err) {\n    return { demo: null, intro: null };\n  }\n}\n\n/* ---------- State ---------- */\n\nconst els = {};\nconst state = {\n  stage: 'intro',\n  slide: Object.assign({}, START),\n  touched: new Set(),\n  ask: new Set(),\n  askEasy: false,\n  lastLevel: -1,\n  lastPhrase: null\n};\nlet demoStep = 0;\nlet completionReported = false;\n\n/* ---------- Sample card ---------- */\n\nfunction colorVar(index) {\n  return `var(${RAMP[index].token})`;\n}\n\nfunction buildCard(extraClass) {\n  const card = h('div', { class: `sample${extraClass ? ` ${extraClass}` : ''}` },\n    h('p', { class: 'sample-title' }),\n    h('p', { class: 'sample-body' }),\n    h('span', { class: 'sample-button' }));\n  return card;\n}\n\nfunction paintCard(card, look) {\n  card.style.setProperty('--card-text', colorVar(look.text));\n  card.style.setProperty('--card-bg', colorVar(look.bg));\n  card.style.setProperty('--card-size', `${SIZES[look.size]}px`);\n  const words = CARD_WORDS[look.words];\n  card.querySelector('.sample-title').textContent = words.title;\n  card.querySelector('.sample-body').textContent = words.body;\n  card.querySelector('.sample-button').textContent = words.button;\n  card.toggleAttribute('data-vague', Boolean(look.vague));\n}\n\n/* ---------- Readability gauge ---------- */\n\nfunction resolveColor(token) {\n  els.probe.style.color = `var(${token})`;\n  const match = getComputedStyle(els.probe).color.match(/[\\d.]+/g);\n  return match.slice(0, 3).map(Number);\n}\n\nfunction luminance(rgb) {\n  const [r, g, b] = rgb.map((v) => {\n    const c = v / 255;\n    return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);\n  });\n  return 0.2126 * r + 0.7152 * g + 0.0722 * b;\n}\n\nfunction contrastRatio(textIndex, bgIndex) {\n  const a = luminance(resolveColor(RAMP[textIndex].token));\n  const b = luminance(resolveColor(RAMP[bgIndex].token));\n  return (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);\n}\n\nfunction readability(look) {\n  const ratio = contrastRatio(look.text, look.bg);\n  const px = SIZES[look.size];\n  const contrastPoints = ratio >= CONFIG.contrastGood ? 2 : (ratio >= CONFIG.contrastOkay ? 1 : 0);\n  const sizePoints = px >= CONFIG.sizeGood ? 2 : (px >= CONFIG.sizeOkay ? 1 : 0);\n  const total = contrastPoints + sizePoints;\n  const level = total === 4 ? 2 : (total >= 2 ? 1 : 0);\n  const reasons = [];\n  if (sizePoints < 2) reasons.push(T.gauge.reasons.size);\n  if (contrastPoints < 2) reasons.push(T.gauge.reasons.contrast);\n  if (!reasons.length) reasons.push(T.gauge.reasons.good);\n  return { level, reason: reasons.join(' ') };\n}\n\nconst LEVEL_ICONS = ['alert', 'minus', 'check'];\n\nfunction renderGauge(look, announceChange) {\n  const result = readability(look);\n  els.gaugeBar.setAttribute('data-level', String(result.level));\n  els.gaugeLevel.textContent = '';\n  els.gaugeLevel.append(icon(LEVEL_ICONS[result.level]), h('span', { text: T.gauge.levels[result.level] }));\n  els.gaugeReason.textContent = result.reason;\n  if (announceChange && result.level !== state.lastLevel) announce(T.gauge.announce(T.gauge.levels[result.level], result.reason));\n  state.lastLevel = result.level;\n  return result;\n}\n\n/* ---------- Slide step ---------- */\n\nfunction buildSliders() {\n  els.sliders.textContent = '';\n  SLIDERS.forEach((def) => {\n    const cat = CATEGORIES[def.category];\n    const id = `slider-${def.id}`;\n    const input = h('input', {\n      type: 'range', id, min: '0', max: String(def.max), step: '1', value: String(START[def.id]),\n      class: 'slider', 'data-slider': def.id\n    });\n    const valueEl = h('span', { class: 'slider-value', id: `${id}-value` });\n    const row = h('div', { class: `slider-row is-t${cat.tone}` },\n      h('div', { class: 'slider-head' },\n        h('label', { for: id, class: 'slider-label' }, icon(cat.icon), h('span', { text: def.label })),\n        valueEl),\n      input,\n      h('div', { class: 'slider-ends', 'aria-hidden': 'true' }, h('span', { text: def.ends[0] }), h('span', { text: def.ends[1] })));\n    els.sliders.append(row);\n  });\n}\n\nfunction renderSliders() {\n  SLIDERS.forEach((def) => {\n    const input = document.getElementById(`slider-${def.id}`);\n    const value = state.slide[def.id];\n    input.value = String(value);\n    input.style.setProperty('--fill', `${(value / def.max) * 100}%`);\n    input.setAttribute('aria-valuetext', def.valueText(value));\n    document.getElementById(`slider-${def.id}-value`).textContent = def.valueText(value);\n  });\n}\n\nfunction onSlide(event) {\n  const input = event.target.closest('.slider');\n  if (!input) return;\n  const id = input.getAttribute('data-slider');\n  state.slide[id] = Number(input.value);\n  state.touched.add(id);\n  paintCard(els.card, Object.assign({ words: 'clear' }, state.slide));\n  renderSliders();\n  renderGauge(state.slide, true);\n  els.nextButton.hidden = state.touched.size < SLIDERS.length;\n}\n\n/* ---------- Ask step ---------- */\n\nfunction askLook() {\n  const look = { text: START.text, bg: START.bg, size: START.size, words: 'confusing', vague: false };\n  PHRASES.forEach((p) => {\n    if (!state.ask.has(p.id)) return;\n    const e = p.effect;\n    if (e.text !== undefined) look.text = e.text;\n    if (e.bg !== undefined) look.bg = e.bg;\n    if (e.size !== undefined) look.size = e.size;\n    if (e.clear) look.words = 'clear';\n    if (e.vague) look.vague = true;\n  });\n  return look;\n}\n\nfunction phraseIcons(p) {\n  const cat = CATEGORIES[p.category];\n  const wrap = h('span', { class: 'phrase-icons' });\n  p.icons.forEach((name) => wrap.append(icon(name)));\n  wrap.className = `phrase-icons is-t${cat.tone}`;\n  return wrap;\n}\n\nfunction buildPhrases() {\n  els.phrases.textContent = '';\n  PHRASES.forEach((p) => {\n    els.phrases.append(h('button', { type: 'button', class: 'opt', 'aria-pressed': 'false', 'data-phrase': p.id },\n      icon('check', 'check'), phraseIcons(p), h('span', { text: p.label })));\n  });\n}\n\nfunction buildGhost() {\n  const ghost = els.promptGhost;\n  ghost.textContent = '';\n  ghost.append(h('span', { class: 'sent', text: T.ask.base }));\n  PHRASES.forEach((p) => {\n    ghost.append(' ', h('span', { class: 'phrase is-t1' }, h('span', { class: 'nowrap' }, icon(p.icons[0]), p.sentence)));\n  });\n}\n\nfunction renderPrompt(newId) {\n  const box = els.promptText;\n  box.textContent = '';\n  box.append(h('span', { class: 'sent', text: T.ask.base }));\n  PHRASES.forEach((p) => {\n    if (!state.ask.has(p.id)) return;\n    const cat = CATEGORIES[p.category];\n    const words = p.sentence.split(' ');\n    const first = words.shift();\n    const phrase = h('span', { class: `phrase is-t${cat.tone}${newId === p.id ? ' is-new' : ''}` },\n      h('span', { class: 'nowrap' }, icon(p.icons[0]), first));\n    if (words.length) phrase.append(` ${words.join(' ')}`);\n    box.append(' ', phrase);\n  });\n}\n\nfunction renderPhraseButtons() {\n  els.phrases.querySelectorAll('.opt').forEach((btn) => {\n    btn.setAttribute('aria-pressed', String(state.ask.has(btn.getAttribute('data-phrase'))));\n  });\n}\n\nfunction renderNote(phrase, added) {\n  els.note.textContent = '';\n  if (!phrase) return;\n  const cat = CATEGORIES[phrase.category];\n  els.note.append(h('p', { class: `note-main is-t${cat.tone}` }, icon(cat.icon),\n    h('span', null, h('strong', { text: `${phrase.title || cat.label}: ` }), added ? phrase.note : T.ask.removed)));\n}\n\nfunction flash(el) {\n  el.classList.remove('flash');\n  void el.offsetWidth;\n  el.classList.add('flash');\n  window.setTimeout(() => el.classList.remove('flash'), CONFIG.flashMilliseconds);\n}\n\nfunction onPhrase(event) {\n  const btn = event.target.closest('.opt');\n  if (!btn) return;\n  const id = btn.getAttribute('data-phrase');\n  const phrase = PHRASES.find((p) => p.id === id);\n  const added = !state.ask.has(id);\n  if (added) state.ask.add(id);\n  else state.ask.delete(id);\n  const look = askLook();\n  paintCard(els.card, look);\n  renderPrompt(added ? id : null);\n  renderPhraseButtons();\n  renderNote(phrase, added);\n  const result = renderGauge(look, false);\n  flash(els.card);\n  announce(T.ask.announce(phrase.title || CATEGORIES[phrase.category].label, added ? phrase.note : T.ask.removed, T.gauge.levels[result.level]));\n  if (result.level === 2) state.askEasy = true;\n  els.finishButton.hidden = !state.askEasy;\n}\n\n/* ---------- Announcer ---------- */\n\nfunction announce(text) {\n  els.announcer.textContent = '';\n  window.setTimeout(() => { els.announcer.textContent = text; }, 30);\n}\n\n/* ---------- Completion ---------- */\n\nfunction reportComplete() {\n  if (completionReported) return;\n  completionReported = true;\n  try {\n    window.dispatchEvent(new CustomEvent(CONFIG.completeEventName));\n  } catch (err) { /* no listener needed */ }\n  try {\n    if (window.parent && window.parent !== window) {\n      window.parent.postMessage({ type: CONFIG.completeMessageType }, '*');\n    }\n  } catch (err) { /* sandbox may block it */ }\n}\n\nfunction buildTakeawayLabels() {\n  els.takeawayLabels.textContent = '';\n  ['size', 'contrast', 'wording'].forEach((key) => {\n    const cat = CATEGORIES[key];\n    els.takeawayLabels.append(h('li', { class: `takeaway-label is-t${cat.tone}` }, icon(cat.icon), h('span', { text: cat.label })));\n  });\n}\n\n/* ---------- Stages ---------- */\n\nfunction setStage(stage) {\n  state.stage = stage;\n  const inActivity = stage === 'slide' || stage === 'ask';\n  els.introScreen.hidden = stage !== 'intro';\n  els.demoScreen.hidden = stage !== 'demo';\n  els.activity.hidden = !inActivity;\n  els.slidePanel.hidden = stage !== 'slide';\n  els.askPanel.hidden = stage !== 'ask';\n  els.takeaway.hidden = stage !== 'done';\n  if (stage === 'slide') els.doThis.textContent = T.doThis.slide;\n  if (stage === 'ask') els.doThis.textContent = T.doThis.ask;\n}\n\nfunction startSlide() {\n  state.slide = Object.assign({}, START);\n  state.touched = new Set();\n  state.lastLevel = -1;\n  els.nextButton.hidden = true;\n  setStage('slide');\n  renderSliders();\n  paintCard(els.card, Object.assign({ words: 'clear' }, state.slide));\n  renderGauge(state.slide, false);\n  els.sliders.querySelector('.slider').focus();\n}\n\nfunction startAsk() {\n  state.ask = new Set();\n  state.askEasy = false;\n  state.lastLevel = -1;\n  els.finishButton.hidden = true;\n  setStage('ask');\n  const look = askLook();\n  paintCard(els.card, look);\n  renderPrompt(null);\n  renderPhraseButtons();\n  renderNote(null, false);\n  renderGauge(look, false);\n  announce(T.doThis.ask);\n  els.phrases.querySelector('.opt').focus();\n}\n\nfunction finish() {\n  reportComplete();\n  buildTakeawayLabels();\n  setStage('done');\n  els.takeaway.focus();\n}\n\n/* ---------- Demo ---------- */\n\nfunction showDemoStep(n) {\n  demoStep = n;\n  const scene = DEMO[n - 1];\n  const last = n === DEMO.length;\n  els.demoStep.textContent = T.demo.stepOf(n, DEMO.length);\n  els.demoPair.textContent = '';\n  ['left', 'right'].forEach((side) => {\n    const spec = scene[side];\n    const card = buildCard('sample-demo');\n    paintCard(card, spec.card);\n    const tone = CATEGORIES[scene.category].tone;\n    els.demoPair.append(h('figure', { class: `demo-figure is-t${tone}` },\n      h('figcaption', { class: 'demo-label' }, icon(spec.icon), h('span', { text: spec.label })),\n      card));\n  });\n  els.demoText.textContent = scene.caption;\n  els.demoNext.textContent = last ? T.demo.start : T.demo.next;\n  els.demoNext.classList.toggle('btn-primary', last);\n  els.demoNext.classList.toggle('btn-outline', !last);\n  announce(scene.caption);\n}\n\nfunction startDemo() {\n  setStage('demo');\n  showDemoStep(1);\n  els.demoNext.focus();\n}\n\nfunction afterIntro(params) {\n  if (CONFIG.showDemo && params.demo !== '0') startDemo();\n  else startSlide();\n}\n\n/* ---------- Setup ---------- */\n\nfunction fillText() {\n  document.querySelectorAll('[data-text]').forEach((el) => {\n    el.textContent = el.getAttribute('data-text').split('.').reduce((obj, key) => obj[key], T);\n  });\n}\n\nfunction showError() {\n  const box = els.error || document.getElementById('error');\n  if (!box) return;\n  box.textContent = T.error;\n  box.hidden = false;\n}\n\nfunction init() {\n  ['widget', 'introScreen', 'introLead', 'startButton', 'demoScreen', 'demoStep', 'demoPair', 'demoText', 'demoNext',\n    'activity', 'doThis', 'card', 'gaugeBar', 'gaugeLevel', 'gaugeReason', 'slidePanel', 'sliders', 'nextButton',\n    'askPanel', 'promptText', 'promptGhost', 'phrases', 'note', 'finishButton', 'announcer', 'takeaway',\n    'takeawayLabels', 'probe', 'error'].forEach((id) => { els[id] = document.getElementById(id); });\n  fillText();\n  els.introLead.append(h('strong', { text: T.intro.term }), T.intro.definition);\n\n  els.card.append(...buildCard().children);\n  buildSliders();\n  buildPhrases();\n  buildGhost();\n\n  els.sliders.addEventListener('input', onSlide);\n  els.phrases.addEventListener('click', onPhrase);\n  els.nextButton.addEventListener('click', startAsk);\n  els.finishButton.addEventListener('click', finish);\n  els.demoNext.addEventListener('click', () => {\n    if (demoStep === DEMO.length) startSlide();\n    else showDemoStep(demoStep + 1);\n  });\n\n  const params = readParams();\n  els.startButton.addEventListener('click', () => afterIntro(params));\n  if (CONFIG.showIntro && params.intro !== '0') setStage('intro');\n  else afterIntro(params);\n}\n\nwindow.addEventListener('error', showError);\n\ntry {\n  init();\n} catch (err) {\n  showError();\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": "/* ==================================================================\n   CADS tokens\n   Copied from the CADS runtime (@moshebari/cads-react, manifest 0.1.0).\n   Light theme only. Only the tokens this widget uses are copied. Do not\n   edit this block. Build only with these variables below it.\n   ================================================================== */\n\n:root {\n  --brand-purple-5: #e4e2f8;\n  --brand-purple-50: #4c42cf;\n  --brand-purple-80: #2b1e9f;\n  --brand-purple-90: #1d1590;\n  --brand-orange-5: #ffe3ce;\n  --brand-orange-70: #b34800;\n  --brand-pink-5: #fbdae8;\n  --brand-pink-50: #e11970;\n  --neutral-base-black: #121212;\n  --neutral-base-white: #ffffff;\n  --neutral-gray-5: #f1f2f4;\n  --neutral-gray-10: #e1e3e6;\n  --neutral-gray-20: #d3d6da;\n  --neutral-gray-30: #b7bcc2;\n  --neutral-gray-40: #9ea5ad;\n  --neutral-gray-50: #87909a;\n  --neutral-gray-70: #596069;\n  --neutral-gray-90: #363b40;\n  --sentiment-error-5: #ffdada;\n  --sentiment-error-20: #f69898;\n  --sentiment-error-70: #b30f0f;\n  --sentiment-information-5: #d5efff;\n  --sentiment-information-30: #6fcaff;\n  --sentiment-information-70: #1570d1;\n  --sentiment-information-90: #0b43a3;\n  --sentiment-success-5: #d8ffdc;\n  --background-neutral-primary: var(--neutral-base-white);\n  --background-neutral-secondary: var(--neutral-gray-5);\n  --background-brand-primary: var(--brand-purple-50);\n  --background-brand-light: var(--brand-purple-5);\n  --background-brand-strong: var(--brand-purple-80);\n  --background-error-light: var(--sentiment-error-5);\n  --background-info-light: var(--sentiment-information-5);\n  --background-selected-primary: var(--brand-purple-80);\n  --background-accent-orange-light: var(--brand-orange-5);\n  --background-accent-pink-light: var(--brand-pink-5);\n  --border-neutral-primary: var(--neutral-gray-20);\n  --border-neutral-secondary: var(--neutral-gray-40);\n  --border-neutral-solid: var(--neutral-base-black);\n  --border-brand-primary: var(--brand-purple-50);\n  --border-error-mid: var(--sentiment-error-20);\n  --border-info-mid: var(--sentiment-information-30);\n  --border-info-strong: var(--sentiment-information-70);\n  --border-focused-primary: var(--brand-purple-50);\n  --border-selected-primary: var(--brand-purple-80);\n  --border-accent-orange-strong: var(--brand-orange-70);\n  --border-accent-pink-primary: var(--brand-pink-50);\n  --text-neutral-primary: var(--neutral-base-black);\n  --text-neutral-secondary: var(--neutral-gray-90);\n  --text-neutral-quaternary: var(--neutral-gray-70);\n  --text-neutral-white-fixed: var(--neutral-base-white);\n  --text-brand-secondary: var(--brand-purple-90);\n  --text-error-secondary: var(--sentiment-error-70);\n  --text-info-secondary: var(--sentiment-information-90);\n  --text-selected-primary: var(--sentiment-success-5);\n  --font-family-main: \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-family-heading: \"Space Grotesk\", \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-weight-semi-bold: 600;\n  --font-weight-bold: 700;\n  --text-heading-md: 1.5rem;\n  --leading-heading-md: 2rem;\n  --text-body-lg: 1.125rem;\n  --text-body-md: 1rem;\n  --leading-body-md: 1.5rem;\n  --tracking-overline: .08em;\n  --shape-sm: .375rem;\n  --shape-md: .5rem;\n  --shape-xl: .75rem;\n  --shape-round: 62.4375rem;\n  --spacing-p-xxs: .5rem;\n  --spacing-p-xs: 1rem;\n  --spacing-p-s: 1.5rem;\n  --shadow-md: 0 10px 15px -3px rgb(0 0 0 / 10%), 0 4px 6px -4px rgb(0 0 0 / 10%);\n  --duration-short: .15s;\n  --duration-medium: .2s;\n  --easing-standard: cubic-bezier(.4, 0, .2, 1);\n  --motion-press-scale: .97;\n  --motion-press-duration: .15s;\n  --motion-press-easing: cubic-bezier(.23, 1, .32, 1);\n  --motion-surface-duration: .2s;\n  --motion-surface-easing: cubic-bezier(.23, 1, .32, 1);\n  --transition-colors: background-color var(--duration-short) var(--easing-standard), color var(--duration-short) var(--easing-standard), border-color var(--duration-short) var(--easing-standard), box-shadow var(--duration-short) var(--easing-standard), opacity var(--duration-short) var(--easing-standard);\n  --transition-press: transform var(--motion-press-duration) var(--motion-press-easing);\n  --ring: var(--border-focused-primary);\n  --control-height-medium: 40px;\n}\n\n/* ===== end CADS tokens ===== */\n\n/* ==================================================================\n   Readable and clear component styles\n\n   What is CADS\n   - Every color, type size, radius, spacing step and motion value below\n     comes from the CADS tokens above. No hard-coded colors.\n   - Spacing is 8 and 16 pixels (--spacing-p-xxs and --spacing-p-xs).\n   - Selected look for pressed phrase buttons (selected-primary fill,\n     border and text, always as a set), and the filled part of each slider.\n   - Focus ring: 2px --ring, never removed.\n   - Overline labels, the Tag look for \"Practice\", and the white card with\n     a 1px hairline and --shape-md radius.\n   - Control heights from --control-height-* (40px buttons).\n\n   What was rebuilt from the manifest\n   - Phrase buttons follow the Chip rules (thick label, selected tokens)\n     but have a rounded-rectangle shape so a two-line label fits.\n   - The primary and outlined Button looks for Start, Next, Try it and\n     Finish.\n   - Sliders are native range inputs, so the keyboard works for free. Track\n     fill uses the selected tokens, as the CADS Slider rules say.\n\n   What was approximated\n   - The CADS runtime is not loaded, so the Slider knob and track sizes are\n     approximated from the manifest rules, not copied from a rendered\n     component.\n   - Geist and Space Grotesk are named by the tokens but are not loaded.\n     The tokens' own fallback fonts show instead.\n   - Icons are small inline SVGs drawn to match the Font Awesome weight.\n   - Text in the interface is at least 16px. The sample card is the thing\n     students judge, so its text starts at 12px on purpose and is the one\n     exception.\n   ================================================================== */\n\n*,\n*::before,\n*::after { box-sizing: border-box; }\n\n[hidden] { display: none !important; }\n\nhtml { font-size: 100%; }\n\nbody {\n  margin: 0;\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-md);\n  line-height: var(--leading-body-md);\n  color: var(--text-neutral-primary);\n  background: var(--background-neutral-primary);\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.probe { position: absolute; width: 0; height: 0; overflow: hidden; transition: none; }\n\n.nowrap { white-space: nowrap; }\n\n.icon {\n  flex: none;\n  width: 1.5rem;\n  height: 1.5rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* Category colors. Size is orange, contrast is purple, wording is pink and\n   the vague ask is blue. Green and red are not used. */\n.is-t1 { --tone-line: var(--border-accent-orange-strong); --tone-bg: var(--background-accent-orange-light); }\n.is-t2 { --tone-line: var(--border-brand-primary); --tone-bg: var(--background-brand-light); }\n.is-t3 { --tone-line: var(--border-accent-pink-primary); --tone-bg: var(--background-accent-pink-light); }\n.is-t4 { --tone-line: var(--border-info-strong); --tone-bg: var(--background-info-light); }\n\n/* ---------- Page ---------- */\n\n.widget {\n  max-width: 60rem;\n  margin: 0 auto;\n  padding: var(--spacing-p-xs);\n}\n\n.error-banner {\n  margin-block-end: var(--spacing-p-xs);\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border: 1px solid var(--border-error-mid);\n  border-radius: var(--shape-md);\n  background: var(--background-error-light);\n  color: var(--text-error-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.tag {\n  display: inline-block;\n  padding: 0 var(--spacing-p-xxs);\n  border-radius: var(--shape-sm);\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: var(--leading-body-md);\n}\n\n.intro-screen,\n.takeaway-page {\n  display: grid;\n  justify-items: start;\n  align-content: start;\n  gap: var(--spacing-p-xs);\n  max-width: 32rem;\n}\n\n.intro-title {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-md);\n  font-weight: var(--font-weight-bold);\n  line-height: var(--leading-heading-md);\n}\n\n.intro-lead { margin: 0; }\n\n.intro-steps {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  margin: 0;\n  padding-inline-start: var(--spacing-p-s);\n}\n\n.intro-steps li::marker { font-weight: var(--font-weight-bold); }\n\n.takeaway-labels {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-p-xxs) var(--spacing-p-xs);\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.takeaway-label {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.takeaway-label .icon { color: var(--tone-line); }\n\n.takeaway-last { margin: 0; }\n\n.takeaway-page:focus-visible {\n  outline: 2px solid var(--ring);\n  outline-offset: 2px;\n}\n\n/* ---------- Buttons ---------- */\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: var(--control-height-medium);\n  padding: 0 var(--spacing-p-xs);\n  border: 1px solid transparent;\n  border-radius: var(--shape-md);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n  transition: var(--transition-colors), var(--transition-press);\n}\n\n.btn:active { transform: scale(var(--motion-press-scale)); }\n\n.btn-primary {\n  background: var(--background-brand-primary);\n  color: var(--text-neutral-white-fixed);\n}\n\n.btn-primary:hover { background: var(--background-brand-strong); }\n\n.btn-outline {\n  background: var(--background-neutral-primary);\n  border-color: var(--border-neutral-solid);\n  color: var(--text-neutral-primary);\n}\n\n.btn-outline:hover { background: var(--background-neutral-secondary); }\n\n.btn:focus-visible,\n.opt:focus-visible,\n.slider:focus-visible {\n  outline: 2px solid var(--ring);\n  outline-offset: 2px;\n}\n\n.button-row { display: flex; }\n\n/* ---------- Demo ---------- */\n\n.demo-screen {\n  display: grid;\n  gap: var(--spacing-p-xs);\n  justify-items: start;\n}\n\n.demo-step {\n  margin: 0;\n  font-weight: var(--font-weight-semi-bold);\n  letter-spacing: var(--tracking-overline);\n  text-transform: uppercase;\n  color: var(--text-neutral-quaternary);\n}\n\n.demo-pair {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: var(--spacing-p-xs);\n  width: 100%;\n}\n\n.demo-figure {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  margin: 0;\n  align-content: start;\n}\n\n.demo-label {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.demo-label .icon { color: var(--tone-line); }\n\n.demo-text {\n  margin: 0;\n  min-height: 3rem;\n  font-size: var(--text-body-lg);\n  line-height: var(--leading-body-md);\n}\n\n/* ---------- Activity ---------- */\n\n.intro { margin-block-end: var(--spacing-p-xs); }\n\n.intro-line {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: var(--spacing-p-xxs);\n}\n\n.do-this { margin: 0; color: var(--text-neutral-secondary); }\n.do-this strong { color: var(--text-neutral-primary); }\n\n.workspace {\n  display: grid;\n  grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);\n  gap: var(--spacing-p-xs);\n  align-items: start;\n}\n\n.col {\n  display: grid;\n  gap: var(--spacing-p-xs);\n  min-width: 0;\n  align-content: start;\n}\n\n.card {\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n}\n\n.overline {\n  font-weight: var(--font-weight-semi-bold);\n  letter-spacing: var(--tracking-overline);\n  text-transform: uppercase;\n  color: var(--text-neutral-quaternary);\n}\n\n/* The sample card */\n.stage {\n  display: grid;\n  place-items: center;\n  min-height: 15rem;\n  padding: var(--spacing-p-xs);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-secondary);\n}\n\n.sample {\n  --card-text: var(--neutral-gray-90);\n  --card-bg: var(--neutral-base-white);\n  --card-size: 16px;\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  justify-items: start;\n  width: 100%;\n  padding: var(--spacing-p-xs);\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-md);\n  background: var(--card-bg);\n  color: var(--card-text);\n  font-size: var(--card-size);\n  line-height: 1.4;\n  transition: background-color var(--duration-medium) var(--easing-standard), color var(--duration-medium) var(--easing-standard), font-size var(--duration-medium) var(--easing-standard);\n}\n\n.sample-title {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: 1.25em;\n  font-weight: var(--font-weight-bold);\n}\n\n.sample-body { margin: 0; }\n\n.sample-button {\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border-radius: var(--shape-md);\n  background: var(--card-text);\n  color: var(--card-bg);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.sample[data-vague] {\n  border: 3px dotted var(--border-accent-pink-primary);\n  border-radius: var(--shape-xl);\n  box-shadow: var(--shadow-md);\n}\n\n.sample-demo { min-height: 10rem; align-content: start; }\n\n/* Readability gauge */\n.gauge {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  padding: var(--spacing-p-xs);\n}\n\n.gauge-bar {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: var(--spacing-p-xxs);\n}\n\n.gauge-seg {\n  height: var(--spacing-p-xxs);\n  border-radius: var(--shape-round);\n  background: var(--neutral-gray-10);\n  transition: background-color var(--duration-medium) var(--easing-standard);\n}\n\n.gauge-bar[data-level=\"0\"] .gauge-seg:nth-child(-n + 1),\n.gauge-bar[data-level=\"1\"] .gauge-seg:nth-child(-n + 2),\n.gauge-bar[data-level=\"2\"] .gauge-seg { background: var(--background-brand-primary); }\n\n.gauge-level {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  margin: 0;\n  font-size: var(--text-body-lg);\n  font-weight: var(--font-weight-bold);\n}\n\n.gauge-reason {\n  margin: 0;\n  min-height: 4.5rem;\n  color: var(--text-neutral-secondary);\n}\n\n/* Sliders */\n.sliders { display: grid; gap: var(--spacing-p-xs); }\n\n.slider-row { display: grid; gap: 0; }\n\n.slider-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--spacing-p-xxs);\n}\n\n.slider-label {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.slider-label .icon { color: var(--tone-line); }\n\n.slider-value { color: var(--text-neutral-secondary); }\n\n.slider-ends {\n  display: flex;\n  justify-content: space-between;\n  color: var(--text-neutral-quaternary);\n}\n\n.slider {\n  --fill: 0%;\n  -webkit-appearance: none;\n  appearance: none;\n  width: 100%;\n  height: var(--spacing-p-s);\n  margin: 0;\n  background: transparent;\n  cursor: pointer;\n}\n\n.slider::-webkit-slider-runnable-track {\n  height: var(--spacing-p-xxs);\n  border-radius: var(--shape-round);\n  background: linear-gradient(to right, var(--background-selected-primary) var(--fill), var(--neutral-gray-10) var(--fill));\n}\n\n.slider::-moz-range-track {\n  height: var(--spacing-p-xxs);\n  border-radius: var(--shape-round);\n  background: linear-gradient(to right, var(--background-selected-primary) var(--fill), var(--neutral-gray-10) var(--fill));\n}\n\n.slider::-webkit-slider-thumb {\n  -webkit-appearance: none;\n  appearance: none;\n  box-sizing: border-box;\n  width: var(--spacing-p-s);\n  height: var(--spacing-p-s);\n  margin-top: calc(var(--spacing-p-xxs) * -1);\n  border: 2px solid var(--border-selected-primary);\n  border-radius: var(--shape-round);\n  background: var(--neutral-base-white);\n}\n\n.slider::-moz-range-thumb {\n  box-sizing: border-box;\n  width: var(--spacing-p-s);\n  height: var(--spacing-p-s);\n  border: 2px solid var(--border-selected-primary);\n  border-radius: var(--shape-round);\n  background: var(--neutral-base-white);\n}\n\n.fact {\n  display: block;\n  margin: 0;\n  padding: var(--spacing-p-xs);\n  border: 1px solid var(--border-info-mid);\n  border-radius: var(--shape-md);\n  background: var(--background-info-light);\n  color: var(--text-info-secondary);\n}\n\n/* Prompt and phrases */\n.prompt-card { padding: var(--spacing-p-xxs) var(--spacing-p-xs) var(--spacing-p-xs); }\n\n.prompt-box { display: grid; }\n\n.prompt-text,\n.prompt-ghost { grid-area: 1 / 1; margin: 0; }\n\n.prompt-ghost { visibility: hidden; }\n\n.phrase {\n  padding: 0 var(--spacing-p-xxs);\n  border-bottom: 2px solid var(--tone-line);\n  border-radius: var(--shape-sm);\n  background: var(--tone-bg);\n  font-weight: var(--font-weight-semi-bold);\n  -webkit-box-decoration-break: clone;\n  box-decoration-break: clone;\n}\n\n.phrase .icon { width: 1rem; height: 1rem; margin-inline-end: var(--spacing-p-xxs); color: var(--tone-line); vertical-align: -.15em; }\n\n.phrase.is-new { animation: fade-in var(--motion-surface-duration) var(--motion-surface-easing) both; }\n\n.phrases {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: var(--spacing-p-xxs);\n}\n\n.opt {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  min-height: var(--control-height-medium);\n  padding: var(--spacing-p-xxs);\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  line-height: 1.25rem;\n  text-align: left;\n  cursor: pointer;\n  transition: var(--transition-colors), var(--transition-press);\n}\n\n.opt:hover { background: var(--background-neutral-secondary); }\n.opt:active { transform: scale(var(--motion-press-scale)); }\n\n.opt .check { display: none; }\n\n.phrase-icons { display: inline-flex; gap: 0; color: var(--tone-line); }\n.opt .icon { width: 1.25rem; height: 1.25rem; }\n\n.opt[aria-pressed=\"true\"] {\n  background: var(--background-selected-primary);\n  border-color: var(--border-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n.opt[aria-pressed=\"true\"] .check { display: inline-block; }\n.opt[aria-pressed=\"true\"] .phrase-icons { color: var(--text-selected-primary); }\n\n.note { display: grid; min-height: 3rem; }\n\n.note-main {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--spacing-p-xxs);\n  margin: 0;\n}\n\n.note-main .icon { margin-block-start: 0; color: var(--tone-line); }\n\n/* Flash on the card when a phrase changes it */\n.flash {\n  outline: 3px solid var(--border-brand-primary);\n  outline-offset: 2px;\n  animation: flash-fade 1s ease-out forwards;\n}\n\n@keyframes flash-fade {\n  from { outline-color: var(--border-brand-primary); }\n  to { outline-color: transparent; }\n}\n\n@keyframes fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n}\n\n/* ---------- Narrow screens ---------- */\n\n@media (max-width: 47.99rem) {\n  .workspace { grid-template-columns: minmax(0, 1fr); }\n  .demo-pair { grid-template-columns: minmax(0, 1fr); }\n  .stage { min-height: 0; }\n}\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    },
