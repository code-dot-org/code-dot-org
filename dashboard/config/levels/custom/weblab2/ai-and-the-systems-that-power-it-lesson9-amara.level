    "encrypted": "false",
    "long_instructions": "##Explore an AI Model - Amara\r\n**Goal:** Race to see which kinds of work each processing units handles best.\r\n\r\n1. Pick a task.\r\n2. Press **Start the race**. All processing units run the job at the same time.\r\n3. Compare each processing units' place and task score. Record them in your activity guide.\r\n4. Race all tasks.\r\n\r\nNeed a definition? Press **Remind Me**. All results are simulated.\r\n",
    "offer_browser_tts": "false",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "true",
    "require_edit_to_continue": "false",
