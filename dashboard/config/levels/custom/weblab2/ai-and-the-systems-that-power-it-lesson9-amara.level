    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "style.css",
          "contents": ":root {\n  --purple: #4C42CF;\n  --purple-dark: #1F1976;\n  --purple-mid: #ACA8EA;\n  --purple-light: #E4E2F8;\n  --blue: #0099F3;\n  --blue-dark: #06338D;\n  --blue-mid: #6FCAFF;\n  --blue-light: #D5EFFF;\n  --pink: #E11970;\n  --pink-dark: #7D0C3D;\n  --pink-mid: #F07FB0;\n  --pink-light: #FBDAE8;\n  --green: #34BD43;\n  --green-dark: #003F25;\n  --green-light: #CCF1D0;\n  --orange: #F46800;\n  --orange-dark: #611D00;\n  --orange-light: #FFE3CE;\n  --text: #16133A;\n  --text-muted: #45426B;\n  --border: #8A87B8;\n  --surface: #FFFFFF;\n  --page: #F1F0FB;\n  --radius: 14px;\n  --shadow: 0 1px 0 rgba(31, 25, 118, 0.14), 0 6px 18px rgba(31, 25, 118, 0.08);\n  font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans\", Arial, sans-serif;\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  background: var(--page);\n  color: var(--text);\n  line-height: 1.45;\n}\n\nh1,\nh2,\nh3 {\n  line-height: 1.2;\n  margin: 0;\n}\n\np {\n  margin: 0;\n}\n\n:focus-visible {\n  outline: 3px solid var(--purple-dark);\n  outline-offset: 2px;\n}\n\n[tabindex=\"-1\"]:focus {\n  outline: none;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n/* Header */\n\n.app-header {\n  background: linear-gradient(180deg, #4C42CF 0%, #ACA8EA 80%, #E4E2F8 100%);\n  padding: 0.75rem clamp(0.75rem, 3vw, 1.5rem) 0.9rem;\n}\n\n.header-inner {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.5rem 1rem;\n  max-width: 76rem;\n  margin: 0 auto;\n}\n\n.app-header h1 {\n  color: #FFFFFF;\n  font-size: clamp(1.35rem, 3.5vw, 1.8rem);\n}\n\n.intro {\n  max-width: 76rem;\n  margin: 0.25rem auto 0;\n  color: var(--purple-dark);\n  font-weight: 700;\n}\n\nmain {\n  max-width: 76rem;\n  margin: 0 auto;\n  padding: 0.9rem clamp(0.75rem, 3vw, 1.5rem) 2rem;\n}\n\n.stack {\n  display: flex;\n  flex-direction: column;\n  gap: 0.9rem;\n}\n\n/* Groups: titled panels */\n\n.group {\n  background: var(--surface);\n  border-radius: var(--radius);\n  box-shadow: var(--shadow);\n  overflow: hidden;\n}\n\n.group-title,\n.group-title-row {\n  background: var(--purple-dark);\n  color: #FFFFFF;\n}\n\n.group-title {\n  font-size: 1rem;\n  font-weight: 800;\n  letter-spacing: 0.02em;\n  padding: 0.5rem 1rem;\n}\n\n.group-title-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.5rem;\n  padding-inline-end: 0.75rem;\n}\n\n.group-body {\n  padding: 0.85rem 1rem 1rem;\n}\n\n.group--build .group-title {\n  background: var(--purple);\n}\n\n.group--mission .group-title {\n  background: var(--blue-dark);\n}\n\n.group--twist {\n  outline: 3px solid var(--pink);\n}\n\n.group--twist .group-title {\n  background: var(--pink-dark);\n}\n\n.group--twist .group-body {\n  background: var(--pink-light);\n}\n\n.group--results .group-title-row {\n  background: var(--green-dark);\n}\n\n.tag {\n  display: inline-block;\n  font-size: 0.75rem;\n  font-weight: 800;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  color: var(--purple-dark);\n  background: var(--purple-light);\n  border-radius: 999px;\n  padding: 0.1rem 0.6rem;\n}\n\n.mini-title {\n  font-size: 0.85rem;\n  font-weight: 800;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  color: var(--text-muted);\n  margin: 0.75rem 0 0.35rem;\n}\n\n/* Buttons */\n\n.button {\n  font: inherit;\n  font-weight: 800;\n  min-height: 44px;\n  padding: 0.5rem 1.25rem;\n  border-radius: 999px;\n  border: 2px solid var(--purple);\n  cursor: pointer;\n}\n\n.button:active {\n  transform: translateY(1px);\n}\n\n.button--primary {\n  background: var(--purple);\n  color: #FFFFFF;\n}\n\n.button--primary:hover {\n  background: var(--purple-dark);\n  border-color: var(--purple-dark);\n}\n\n.button--secondary {\n  background: var(--surface);\n  color: var(--purple-dark);\n}\n\n.button--secondary:hover {\n  background: var(--purple-light);\n}\n\n.button--ghost {\n  background: transparent;\n  border-color: transparent;\n  color: var(--purple-dark);\n  text-decoration: underline;\n  padding-inline: 0.5rem;\n}\n\n.button:disabled {\n  cursor: not-allowed;\n  background: var(--purple-light);\n  border-color: var(--border);\n  color: var(--text-muted);\n}\n\n#remind-button {\n  border-color: #FFFFFF;\n  background: #FFFFFF;\n  color: var(--purple-dark);\n}\n\n/* Shapes for kinds of work */\n\n.shape {\n  flex-shrink: 0;\n}\n\n.shape--steps {\n  fill: var(--purple);\n}\n\n.shape--repeat {\n  fill: var(--blue);\n}\n\n.shape--ai {\n  fill: var(--pink);\n}\n\n.work-visual {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  gap: 0.35rem;\n}\n\n.work-row {\n  display: flex;\n  align-items: center;\n  gap: 0.6rem;\n}\n\n.work-name {\n  min-width: 6.5rem;\n  font-size: 0.9rem;\n  font-weight: 700;\n  color: var(--text-muted);\n}\n\n.work-blocks {\n  display: flex;\n  gap: 0.25rem;\n}\n\n/* Machine picture */\n\n.machine-picture {\n  display: block;\n  width: 100%;\n  height: auto;\n}\n\n.board {\n  fill: #1F1976;\n}\n\n.trace {\n  stroke: #4C42CF;\n  stroke-width: 1.5;\n  opacity: 0.6;\n}\n\n.chip-body {\n  fill: #2E2790;\n  stroke-width: 2;\n}\n\n.chip--cpu .chip-body {\n  stroke: #ACA8EA;\n}\n\n.chip--gpu .chip-body {\n  stroke: #6FCAFF;\n}\n\n.chip--ai .chip-body {\n  stroke: #F07FB0;\n}\n\n.chip--empty .chip-body {\n  stroke-dasharray: 6 5;\n  opacity: 0.55;\n}\n\n.chip-label {\n  fill: #FFFFFF;\n  font-size: 15px;\n  font-weight: 800;\n}\n\n.cell {\n  fill: #FFFFFF;\n  opacity: 0.12;\n}\n\n.chip--cpu .cell--on {\n  fill: #ACA8EA;\n  opacity: 1;\n}\n\n.chip--gpu .cell--on {\n  fill: #6FCAFF;\n  opacity: 1;\n}\n\n.chip--ai .cell--on {\n  fill: #F07FB0;\n  opacity: 1;\n}\n\n.chip.is-working .cell--on,\n.chip--reserved .cell--on {\n  animation: pulse 0.5s ease-in-out infinite alternate;\n}\n\n@keyframes pulse {\n  from {\n    opacity: 1;\n  }\n  to {\n    opacity: 0.4;\n  }\n}\n\n/* Mission workspace */\n\n.mission-screen {\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n}\n\n.mission-top {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.5rem 1rem;\n}\n\n.mission-title {\n  font-size: 1.35rem;\n  color: var(--purple-dark);\n}\n\n.stepper {\n  list-style: none;\n  margin: 0;\n  margin-inline-start: auto;\n  padding: 0;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.35rem;\n}\n\n.step {\n  display: flex;\n  align-items: center;\n  gap: 0.35rem;\n  padding: 0.2rem 0.7rem 0.2rem 0.25rem;\n  border-radius: 999px;\n  background: var(--surface);\n  color: var(--text-muted);\n  font-weight: 700;\n  font-size: 0.9rem;\n}\n\n.step-number {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 1.5rem;\n  height: 1.5rem;\n  border-radius: 50%;\n  background: var(--purple-light);\n  color: var(--purple-dark);\n  font-weight: 800;\n}\n\n.step.is-current {\n  background: var(--purple);\n  color: #FFFFFF;\n}\n\n.step.is-current .step-number {\n  background: #FFFFFF;\n}\n\n.step.is-done .step-number {\n  background: var(--green);\n  color: #FFFFFF;\n}\n\n.workspace {\n  display: grid;\n  gap: 0.9rem;\n  align-items: start;\n}\n\n@media (min-width: 60rem) {\n  .workspace {\n    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);\n  }\n}\n\n.side {\n  display: grid;\n  gap: 0.9rem;\n}\n\n/* Build panel */\n\n.build-panel {\n  display: grid;\n  gap: 0.75rem;\n}\n\n.picture-slot {\n  max-width: 26rem;\n  margin: 0 auto;\n  width: 100%;\n}\n\n.slider-list {\n  display: grid;\n  gap: 0.5rem;\n}\n\n.slider-row {\n  display: grid;\n  grid-template-columns: 4.5rem auto minmax(0, 1fr) 2rem;\n  align-items: center;\n  gap: 0.25rem 0.6rem;\n  padding: 0.4rem 0.75rem;\n  border-radius: 12px;\n  border-inline-start: 6px solid var(--purple);\n  background: var(--purple-light);\n}\n\n.slider-row--gpu {\n  border-inline-start-color: var(--blue);\n  background: var(--blue-light);\n}\n\n.slider-row--ai {\n  border-inline-start-color: var(--pink);\n  background: var(--pink-light);\n}\n\n.slider-label {\n  font-weight: 900;\n  font-size: 1.05rem;\n  color: var(--purple-dark);\n}\n\n.slider-row--gpu .slider-label {\n  color: var(--blue-dark);\n}\n\n.slider-row--ai .slider-label {\n  color: var(--pink-dark);\n}\n\n.slider-shapes {\n  display: flex;\n  gap: 0.2rem;\n}\n\n.slider-output {\n  font-size: 1.5rem;\n  font-weight: 900;\n  text-align: center;\n  font-variant-numeric: tabular-nums;\n  color: var(--purple-dark);\n}\n\n.slider-lock {\n  grid-column: 1 / -1;\n  font-size: 0.85rem;\n  font-weight: 700;\n  color: var(--blue-dark);\n}\n\n.slider {\n  width: 100%;\n  height: 2.25rem;\n  margin: 0;\n  background: transparent;\n  -webkit-appearance: none;\n  appearance: none;\n  cursor: pointer;\n}\n\n.slider:disabled {\n  cursor: not-allowed;\n  opacity: 0.6;\n}\n\n.slider::-webkit-slider-runnable-track {\n  height: 0.7rem;\n  border-radius: 999px;\n  background: #FFFFFF;\n  border: 1px solid var(--border);\n}\n\n.slider::-moz-range-track {\n  height: 0.7rem;\n  border-radius: 999px;\n  background: #FFFFFF;\n  border: 1px solid var(--border);\n}\n\n.slider::-webkit-slider-thumb {\n  -webkit-appearance: none;\n  appearance: none;\n  width: 2rem;\n  height: 2rem;\n  margin-top: -0.7rem;\n  border-radius: 50%;\n  background: var(--purple);\n  border: 3px solid #FFFFFF;\n  box-shadow: 0 0 0 2px var(--purple-dark);\n}\n\n.slider::-moz-range-thumb {\n  width: 1.6rem;\n  height: 1.6rem;\n  border-radius: 50%;\n  background: var(--purple);\n  border: 3px solid #FFFFFF;\n  box-shadow: 0 0 0 2px var(--purple-dark);\n}\n\n.slider--gpu::-webkit-slider-thumb {\n  background: var(--blue-dark);\n}\n\n.slider--gpu::-moz-range-thumb {\n  background: var(--blue-dark);\n}\n\n.slider--ai::-webkit-slider-thumb {\n  background: var(--pink-dark);\n}\n\n.slider--ai::-moz-range-thumb {\n  background: var(--pink-dark);\n}\n\n.gauges {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));\n  gap: 0.6rem 1rem;\n}\n\n.gauge-head {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-between;\n  gap: 0.25rem 0.5rem;\n  font-weight: 800;\n  font-size: 0.95rem;\n}\n\n.gauge-label {\n  color: var(--purple-dark);\n}\n\n.gauge-value {\n  font-variant-numeric: tabular-nums;\n}\n\n.gauge-track {\n  height: 0.75rem;\n  border-radius: 999px;\n  background: var(--purple-light);\n  overflow: hidden;\n  margin-block-start: 0.2rem;\n}\n\n.gauge-fill {\n  display: block;\n  height: 100%;\n  background: var(--purple);\n  transform-origin: left center;\n  transform: scaleX(0);\n  transition: transform 0.2s ease;\n}\n\n.gauge-fill.is-high {\n  background: var(--orange);\n}\n\n[dir=\"rtl\"] .gauge-fill {\n  transform-origin: right center;\n}\n\n.limit-note {\n  min-height: 1.3rem;\n  font-weight: 700;\n  font-size: 0.9rem;\n  color: var(--orange-dark);\n}\n\n.run-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.6rem;\n  margin-block-start: 0.75rem;\n}\n\n#run-button {\n  flex: 1 1 10rem;\n  font-size: 1.15rem;\n  min-height: 52px;\n}\n\n.error {\n  margin-block-start: 0.5rem;\n  font-weight: 700;\n  color: var(--orange-dark);\n}\n\n.notice {\n  margin-block-start: 0.5rem;\n  font-weight: 700;\n  color: var(--blue-dark);\n}\n\n/* Mission panel */\n\n.task {\n  font-size: 1.1rem;\n  font-weight: 800;\n  margin-block-end: 0.6rem;\n}\n\n.info-chips {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.4rem;\n}\n\n.info-chip,\n.goal-chip {\n  display: inline-flex;\n  align-items: baseline;\n  gap: 0.35rem;\n  background: var(--page);\n  border: 1px solid var(--purple-light);\n  border-radius: 999px;\n  padding: 0.2rem 0.75rem;\n}\n\n.chip-key {\n  font-size: 0.8rem;\n  font-weight: 700;\n  color: var(--text-muted);\n}\n\n.chip-value,\n.goal-chip span:last-child {\n  font-weight: 900;\n  color: var(--purple-dark);\n}\n\n.group--twist .info-chip {\n  background: #FFFFFF;\n}\n\n.work-box {\n  margin-block-start: 0.25rem;\n}\n\n/* Results */\n\n.result-slot {\n  min-height: 13.5rem;\n  position: relative;\n}\n\n.result-body {\n  animation: pop-in 0.3s ease-out;\n  transform-origin: bottom left;\n  transition: transform 0.3s ease-in, opacity 0.3s ease-in;\n}\n\n.result-body.is-leaving {\n  transform: translateY(45%) scale(0.3);\n  opacity: 0;\n}\n\n@keyframes pop-in {\n  from {\n    transform: scale(0.96);\n    opacity: 0;\n  }\n}\n\n.result-body.is-empty {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 13.5rem;\n  border: 2px dashed var(--purple-light);\n  border-radius: 12px;\n  color: var(--text-muted);\n  font-weight: 700;\n  text-align: center;\n  padding: 1rem;\n}\n\n.running-text {\n  font-weight: 800;\n  font-size: 1.1rem;\n  color: var(--purple-dark);\n  margin-block-end: 0.5rem;\n}\n\n.score-pair {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 0.6rem;\n}\n\n.score-tile {\n  display: flex;\n  flex-direction: column;\n  gap: 0.15rem;\n  background: var(--page);\n  border-radius: 12px;\n  padding: 0.6rem 0.8rem;\n}\n\n.score-tile.is-full {\n  background: var(--green-light);\n}\n\n.score-key {\n  font-size: 0.8rem;\n  font-weight: 800;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  color: var(--text-muted);\n}\n\n.score-number {\n  font-size: clamp(2rem, 6vw, 2.6rem);\n  font-weight: 900;\n  line-height: 1.05;\n  color: var(--purple);\n  font-variant-numeric: tabular-nums;\n}\n\n.score-tile.is-full .score-number {\n  color: var(--green-dark);\n}\n\n.score-word {\n  font-size: clamp(1.5rem, 4.5vw, 1.9rem);\n  font-weight: 900;\n  line-height: 1.1;\n}\n\n.score-tile--high .score-word {\n  color: var(--green-dark);\n}\n\n.score-tile--medium .score-word {\n  color: var(--purple-dark);\n}\n\n.score-tile--low .score-word {\n  color: var(--orange-dark);\n}\n\n.pips {\n  display: inline-flex;\n  gap: 0.25rem;\n}\n\n.pips span {\n  width: 1.6rem;\n  height: 0.6rem;\n  border-radius: 999px;\n  background: var(--purple-light);\n}\n\n.pips--low span:nth-child(1),\n.pips--medium span:nth-child(-n + 2),\n.pips--high span {\n  background: var(--green);\n}\n\n.time-bar {\n  position: relative;\n  margin-block-start: 1.6rem;\n}\n\n.time-track {\n  position: relative;\n  height: 1.3rem;\n  border-radius: 999px;\n  background: var(--page);\n  border: 1px solid var(--purple-light);\n  overflow: hidden;\n}\n\n.time-fill {\n  display: flex;\n  height: 100%;\n}\n\n.time-segment {\n  flex-basis: 0;\n  min-width: 4px;\n}\n\n.time-segment--steps {\n  background: repeating-linear-gradient(135deg, var(--purple) 0 10px, #6A61DB 10px 20px);\n}\n\n.time-segment--repeat {\n  background: repeating-linear-gradient(135deg, var(--blue) 0 10px, #4DB8F7 10px 20px);\n}\n\n.time-segment--ai {\n  background: repeating-linear-gradient(135deg, var(--pink) 0 10px, #EC5A99 10px 20px);\n}\n\n.time-cover {\n  position: absolute;\n  inset: 0;\n  background: var(--page);\n  transform-origin: right center;\n  transform: scaleX(1);\n  transition-property: transform;\n  transition-timing-function: linear;\n}\n\n.time-cover.is-open {\n  transform: scaleX(0);\n}\n\n[dir=\"rtl\"] .time-cover {\n  transform-origin: left center;\n}\n\n.goal-marker {\n  position: absolute;\n  top: -0.35rem;\n  bottom: -0.35rem;\n  border-inline-start: 3px dashed var(--purple-dark);\n  margin-inline-start: -1.5px;\n}\n\n.goal-flag {\n  position: absolute;\n  bottom: 100%;\n  inset-inline-start: -1.25rem;\n  font-size: 0.75rem;\n  font-weight: 800;\n  color: var(--purple-dark);\n  white-space: nowrap;\n}\n\n.time-text {\n  margin-block-start: 0.4rem;\n  font-weight: 700;\n}\n\n.energy-text {\n  color: var(--text-muted);\n  font-weight: 600;\n  font-size: 0.95rem;\n}\n\n.tip,\n.idle-chip {\n  margin-block-start: 0.4rem;\n  font-size: 0.92rem;\n  font-weight: 600;\n  padding: 0.25rem 0.6rem;\n  border-radius: 8px;\n  background: var(--purple-light);\n}\n\n.idle-chip {\n  background: var(--orange-light);\n  color: var(--orange-dark);\n}\n\n.badge {\n  display: inline-block;\n  margin-block-start: 0.4rem;\n  font-weight: 900;\n  color: var(--green-dark);\n  background: var(--green-light);\n  border: 2px solid var(--green);\n  border-radius: 999px;\n  padding: 0.15rem 0.75rem;\n}\n\n.history {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.4rem;\n}\n\n.history-empty {\n  color: var(--text-muted);\n  font-size: 0.9rem;\n}\n\n.history-chip {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: 0.4rem;\n  padding: 0.3rem 0.55rem;\n  border: 2px solid var(--purple-light);\n  border-radius: 10px;\n  background: var(--surface);\n}\n\n.history-chip.is-latest {\n  animation: pop-in 0.3s ease-out;\n}\n\n.history-chip.is-best {\n  border-color: var(--green);\n  background: var(--green-light);\n}\n\n.history-chip .pips span {\n  width: 0.55rem;\n  height: 0.45rem;\n}\n\n.mini-levels {\n  display: flex;\n  align-items: flex-end;\n  gap: 2px;\n  height: 1.4rem;\n}\n\n.mini-level {\n  width: 5px;\n  height: 100%;\n  border-radius: 2px;\n  transform-origin: bottom center;\n  background: var(--purple);\n}\n\n.mini-level--gpu {\n  background: var(--blue);\n}\n\n.mini-level--ai {\n  background: var(--pink);\n}\n\n.history-score {\n  font-weight: 900;\n  font-variant-numeric: tabular-nums;\n}\n\n.best-tag {\n  position: absolute;\n  top: -0.6rem;\n  inset-inline-end: -0.3rem;\n  font-size: 0.65rem;\n  font-weight: 900;\n  text-transform: uppercase;\n  background: var(--green-dark);\n  color: #FFFFFF;\n  border-radius: 999px;\n  padding: 0 0.4rem;\n}\n\n/* Mission menu */\n\n.mission-grid {\n  list-style: none;\n  margin: 0;\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));\n  gap: 0.75rem;\n}\n\n.mission-grid--single {\n  grid-template-columns: minmax(0, 30rem);\n}\n\n.mission-card article {\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  background: var(--page);\n  border-radius: 12px;\n  border-block-start: 6px solid var(--purple);\n  padding: 0.85rem;\n}\n\n.mission-card h3 {\n  color: var(--purple-dark);\n  font-size: 1.15rem;\n}\n\n.mission-card--video article {\n  border-block-start-color: var(--blue);\n}\n\n.mission-card--music article {\n  border-block-start-color: var(--pink);\n}\n\n.mission-card--fitness article {\n  border-block-start-color: var(--green);\n}\n\n.mission-card--yearbook article {\n  border-block-start-color: var(--orange);\n}\n\n.mission-card.is-locked article {\n  opacity: 0.75;\n  border-block-start-color: var(--border);\n}\n\n.mission-card .tag {\n  align-self: flex-start;\n}\n\n.card-task {\n  font-weight: 600;\n}\n\n.card-foot {\n  margin-block-start: auto;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.5rem;\n  padding-block-start: 0.4rem;\n}\n\n.locked-text {\n  color: var(--text-muted);\n  font-weight: 700;\n  font-size: 0.9rem;\n}\n\n.done-tag {\n  font-weight: 800;\n  color: var(--green-dark);\n  background: var(--green-light);\n  border-radius: 999px;\n  padding: 0.1rem 0.7rem;\n}\n\n/* Summary */\n\n.summary-grid {\n  list-style: none;\n  margin: 0 0 0.9rem;\n  padding: 0;\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));\n  gap: 0.75rem;\n}\n\n.summary-row {\n  display: flex;\n  flex-direction: column;\n  gap: 0.4rem;\n  background: var(--page);\n  border-radius: 12px;\n  padding: 0.75rem;\n}\n\n.summary-row h3 {\n  color: var(--purple-dark);\n  font-size: 1rem;\n}\n\n.summary-specs {\n  font-weight: 700;\n}\n\n.summary-score {\n  font-weight: 800;\n  color: var(--purple);\n}\n\n.callout {\n  background: var(--purple-light);\n  border-radius: 10px;\n  padding: 0.6rem 0.9rem;\n  font-weight: 800;\n}\n\n/* Level 1 race */\n\n.race-controls {\n  display: grid;\n  gap: 0.75rem;\n  align-items: end;\n}\n\n@media (min-width: 60rem) {\n  .race-controls {\n    grid-template-columns: minmax(0, 1fr) auto;\n  }\n}\n\n.job-group {\n  border: 0;\n  margin: 0;\n  padding: 0;\n  min-width: 0;\n}\n\n.job-group legend {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n}\n\n.job-picker {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));\n  gap: 0.6rem;\n}\n\n.job-card {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  gap: 0.4rem;\n  padding: 0.6rem 0.75rem 0.7rem 2.4rem;\n  border: 2px solid var(--purple-light);\n  border-radius: 12px;\n  background: var(--surface);\n  cursor: pointer;\n}\n\n.job-card:hover {\n  border-color: var(--purple-mid);\n}\n\n.job-card.is-selected {\n  border-color: var(--purple);\n  background: var(--purple-light);\n}\n\n.job-card input {\n  position: absolute;\n  inset-inline-start: 0.7rem;\n  inset-block-start: 0.75rem;\n  width: 1.2rem;\n  height: 1.2rem;\n  margin: 0;\n  accent-color: var(--purple);\n}\n\n.job-title {\n  font-weight: 900;\n  color: var(--purple-dark);\n}\n\n.job-card .work-name {\n  min-width: 5.5rem;\n}\n\n.raced-tag {\n  position: absolute;\n  top: 0.5rem;\n  inset-inline-end: 0.5rem;\n  font-size: 0.7rem;\n  font-weight: 900;\n  text-transform: uppercase;\n  color: var(--green-dark);\n  background: var(--green-light);\n  border-radius: 999px;\n  padding: 0 0.45rem;\n}\n\n.race-go {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  align-items: stretch;\n}\n\n.race-grid {\n  list-style: none;\n  margin: 0;\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));\n  gap: 0.75rem;\n}\n\n.race-card article {\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  gap: 0.45rem;\n  background: var(--page);\n  border: 3px solid transparent;\n  border-radius: 12px;\n  padding: 0.7rem;\n}\n\n.race-card.is-winner article {\n  border-color: var(--green);\n  background: var(--surface);\n}\n\n.race-top {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.race-top h3 {\n  color: var(--purple-dark);\n  font-size: 1.05rem;\n}\n\n.place {\n  font-weight: 900;\n  color: #FFFFFF;\n  background: var(--purple-dark);\n  border-radius: 999px;\n  padding: 0.05rem 0.6rem;\n  opacity: 0;\n  transform: scale(0.5);\n  transition: opacity 0.2s ease, transform 0.25s ease;\n}\n\n.race-card.is-winner .place {\n  background: var(--green-dark);\n}\n\n.race-picture {\n  display: block;\n}\n\n.race-track {\n  height: 1.2rem;\n}\n\n.race-fill {\n  width: 100%;\n}\n\n.race-grid.is-done .time-cover {\n  transform: scaleX(0);\n}\n\n.race-result {\n  display: flex;\n  flex-direction: column;\n  gap: 0.3rem;\n  opacity: 0;\n  transform: translateY(6px);\n  transition: opacity 0.3s ease, transform 0.3s ease;\n}\n\n.race-card.is-finished .race-result,\n.race-card.is-finished .place {\n  opacity: 1;\n  transform: none;\n}\n\n.race-time {\n  font-weight: 800;\n}\n\n.race-stats {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.5rem 0.75rem;\n}\n\n.race-score {\n  font-size: 1.6rem;\n  font-weight: 900;\n  color: var(--purple);\n  line-height: 1.1;\n}\n\n.race-eff {\n  display: inline-flex;\n  flex-direction: column;\n  gap: 0.15rem;\n  font-weight: 800;\n  font-size: 0.9rem;\n}\n\n/* Tables */\n\n.table-scroll {\n  overflow-x: auto;\n}\n\ntable {\n  border-collapse: collapse;\n  width: 100%;\n  min-width: 32rem;\n}\n\nth,\ntd {\n  text-align: start;\n  vertical-align: top;\n  padding: 0.45rem 0.6rem;\n  border-block-end: 1px solid var(--purple-light);\n}\n\nthead th {\n  color: var(--purple-dark);\n  font-size: 0.9rem;\n}\n\n.not-tested {\n  color: var(--text-muted);\n}\n\n.cell-score {\n  display: block;\n  font-weight: 900;\n}\n\n.cell-line {\n  display: flex;\n  align-items: center;\n  gap: 0.35rem;\n  font-size: 0.85rem;\n  color: var(--text-muted);\n}\n\n.cell-line .pips span {\n  width: 0.7rem;\n  height: 0.45rem;\n}\n\n/* Glossary dialog */\n\n.glossary {\n  max-width: min(36rem, calc(100vw - 2rem));\n  max-height: calc(100vh - 2rem);\n  border: 0;\n  border-radius: var(--radius);\n  box-shadow: var(--shadow);\n  padding: 1.1rem 1.4rem;\n  color: var(--text);\n}\n\n.glossary h2 {\n  color: var(--purple-dark);\n  margin-block-end: 0.6rem;\n}\n\n.glossary::backdrop {\n  background: rgba(31, 25, 118, 0.5);\n}\n\n.glossary-list {\n  margin: 0 0 1rem;\n}\n\n.glossary-item {\n  margin-block-end: 0.6rem;\n}\n\n.glossary-item dt {\n  font-weight: 800;\n  color: var(--purple-dark);\n}\n\n.glossary-item dd {\n  margin: 0;\n}\n\n.error-message {\n  background: var(--orange-light);\n  color: var(--orange-dark);\n  border-radius: var(--radius);\n  padding: 1rem;\n  font-weight: 700;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .chip.is-working .cell--on,\n  .chip--reserved .cell--on,\n  .result-body,\n  .history-chip.is-latest {\n    animation: none;\n  }\n\n  .gauge-fill,\n  .time-cover,\n  .result-body,\n  .race-result,\n  .place {\n    transition: none;\n  }\n}\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "'use strict';\n\n/* ==========================================================\n   Content: every student-facing string and number lives here.\n   ========================================================== */\n\nconst CHIPS = {\n  cpu: {\n    name: 'CPU',\n    shortName: 'CPU',\n    sentenceName: 'CPU',\n    does: 'Does step-by-step work, plus a little repeated and AI work.',\n    min: 1,\n    cost: 60,\n    power: 25,\n    speed: { steps: 10, repeat: 4, ai: 2 }\n  },\n  gpu: {\n    name: 'GPU',\n    shortName: 'GPU',\n    sentenceName: 'GPU',\n    does: 'Does repeated work and AI work. Can\\'t do step-by-step work.',\n    min: 0,\n    cost: 150,\n    power: 70,\n    speed: { steps: 0, repeat: 60, ai: 40 }\n  },\n  ai: {\n    name: 'Specialized AI chip',\n    shortName: 'AI chip',\n    sentenceName: 'specialized AI chip',\n    does: 'Does only AI work, using very little power.',\n    min: 0,\n    cost: 90,\n    power: 10,\n    speed: { steps: 0, repeat: 0, ai: 60 }\n  }\n};\n\nconst CHIP_ORDER = ['cpu', 'gpu', 'ai'];\nconst MAX_LEVEL = 5;\nconst BASE = { cost: 100, power: 20 };\nconst IDLE_POWER = 0.2;\nconst PHONE_BATTERY_WH = 15;\n\nconst DEVICES = {\n  phone: { name: 'Phone', speed: 0.1, power: 0.04, cost: 0.5 },\n  laptop: { name: 'Laptop', speed: 0.4, power: 0.3, cost: 1 },\n  desktop: { name: 'Desktop', speed: 1, power: 1, cost: 1 },\n  datacenter: { name: 'Data center', speed: 5, power: 5, cost: 0.25 }\n};\n\nconst KINDS = {\n  steps: { name: 'Step-by-step', sentenceName: 'step-by-step work' },\n  repeat: { name: 'Repeated', sentenceName: 'repeated work' },\n  ai: { name: 'AI', sentenceName: 'AI work' }\n};\n\nconst KIND_ORDER = ['steps', 'repeat', 'ai'];\nconst AMOUNT_BLOCKS = { little: 1, some: 3, lot: 5 };\n\nconst GLOSSARY = [\n  { term: 'Processor (processing unit)', definition: 'A component in a computer that executes instructions and performs calculations.' },\n  { term: 'CPU (Central Processing Unit)', definition: 'A general-purpose processor found in most computers.' },\n  { term: 'GPU (Graphics Processing Unit)', definition: 'A processor that processes many calculations in parallel.' },\n  { term: 'Specialized AI chip', definition: 'A processor built for one kind of job, running AI models. It\\'s fast and efficient at that job but can\\'t be used for others.' },\n  { term: 'Step-by-step work (square)', definition: 'Each step needs the one before it, like rules, sorting and logic.' },\n  { term: 'Repeated work (circle)', definition: 'The same step on lots of data, like photo and video effects.' },\n  { term: 'AI work (diamond)', definition: 'Running or training an AI model.' },\n  { term: 'Power (watts, W)', definition: 'How much electricity a machine uses at one moment. More chips draw more power.' },\n  { term: 'Energy (watt-hours, Wh)', definition: 'How much electricity a whole job uses: power multiplied by time.' },\n  { term: 'Efficiency', definition: 'How little energy a machine uses to finish the job, compared with the best machine that also finishes on time.' }\n];\n\nconst TEXT = {\n  loadError: 'This activity could not start. Try reloading the page. If that doesn\\'t work, tell your teacher.',\n  run: 'Run',\n  running: 'Running',\n  simulated: 'Simulated',\n  levelValue: value => `${value}`,\n  levelText: value => `Level ${value}`,\n  lockedChip: 'Locked: busy drawing the game',\n  cost: 'Cost',\n  power: 'Power',\n  gaugeValue: (used, limit) => `${used} / ${limit}`,\n  overBudget: name => `The ${name} can't go higher: over budget.`,\n  overPower: name => `The ${name} can't go higher: over the power limit.`,\n  buildHeading: 'Your machine',\n  missionHeading: 'Mission',\n  resultsHeading: 'Results',\n  goal: 'Goal',\n  device: 'Device',\n  budget: 'Budget',\n  powerLimit: 'Power limit',\n  work: 'The work',\n  workAria: (kind, amount) => `${kind} work: ${amount}`,\n  amounts: { little: 'a little', some: 'some', lot: 'a lot' },\n  taskScore: 'Task score',\n  efficiency: 'Efficiency',\n  efficiencyLevels: { high: 'High', medium: 'Medium', low: 'Low' },\n  timeValue: (time, target) => `${time} (goal: ${target})`,\n  energyValue: energy => `${energy} used`,\n  batteryValue: percent => `${percent} battery per hour`,\n  goalMarker: 'Goal',\n  emptyResult: 'Set your sliders, then press Run.',\n  tips: {\n    steps: 'Most time: step-by-step work. Only the CPU can speed it up.',\n    repeat: 'Most time: repeated work. The GPU speeds it up most.',\n    ai: 'Most time: AI work. The GPU or the AI chip speeds it up.'\n  },\n  idle: name => `The ${name} had nothing to do.`,\n  badge: 'Efficiency expert',\n  history: 'Your runs',\n  historyEmpty: 'Your runs will appear here.',\n  best: 'Best',\n  runChip: (specs, score, efficiency) => `${specs}: ${score}, ${efficiency} efficiency`,\n  runAnnouncement: specs => `Running ${specs}.`,\n  resultAnnouncement: (score, efficiency, tip) => `Task score ${score}. Efficiency ${efficiency}. ${tip}`,\n  specs: (cpu, gpu, ai) => `CPU ${cpu}, GPU ${gpu}, AI chip ${ai}`,\n  // Level 1\n  chooseJob: 'Pick a job',\n  startRace: 'Start the race',\n  racing: 'Racing',\n  raceHeading: 'The race',\n  places: ['1st', '2nd', '3rd', '4th'],\n  placeText: ['1st place', '2nd place', '3rd place', '4th place'],\n  raceStart: job => `The race has started: ${job}.`,\n  raceEntry: (place, machine, score, efficiency) => `${place}: ${machine}, task score ${score}, efficiency ${efficiency}.`,\n  raceAnnouncement: list => `Race results. ${list}`,\n  raced: 'Raced',\n  testResultsHeading: 'Race results',\n  machineColumn: 'Machine',\n  notTested: 'Not raced yet',\n  // Level 2\n  stages: ['Build', 'Twist', 'Rebuild', 'Done'],\n  stageText: (number, total, name) => `Step ${number} of ${total}: ${name}`,\n  starterTag: 'Starter mission',\n  startMission: 'Start',\n  playAgain: 'Play again',\n  completed: 'Completed',\n  lockedMission: 'Finish the starter mission first',\n  starterHeading: 'Starter mission',\n  choiceHeading: 'Choice missions: pick one',\n  backToMissions: 'Missions',\n  seeTwist: 'See the twist',\n  needRun: 'Run your build first.',\n  twistHeading: 'Plot twist',\n  twistAutoRun: 'Your build is running with the twist.',\n  finish: 'Finish mission',\n  beforeTwist: 'Before the twist',\n  sameBuild: 'Same build, after the twist',\n  afterRebuild: 'After your rebuild',\n  summaryScore: (score, efficiency) => `Task score ${score}, ${efficiency} efficiency`,\n  fitted: 'Your build went over the new limits, so it was cut back to fit.',\n  recordInGuide: 'Record these builds and scores in your activity guide.',\n  missionComplete: title => `Mission complete: ${title}`\n};\n\nconst MACHINES = [\n  { id: 'budget-laptop', name: 'Budget Laptop', build: { cpu: 2, gpu: 0, ai: 0 } },\n  { id: 'gaming-pc', name: 'Gaming PC', build: { cpu: 3, gpu: 4, ai: 0 } },\n  { id: 'ai-laptop', name: 'AI Laptop', build: { cpu: 2, gpu: 1, ai: 3 } },\n  { id: 'ai-server', name: 'AI Server', build: { cpu: 3, gpu: 5, ai: 5 } }\n];\n\nconst JOBS = [\n  {\n    id: 'photos',\n    title: 'Brighten 1,000 photos',\n    phase: { device: 'desktop', benchmark: 'machines', work: { steps: 20, repeat: 6000 }, mix: { steps: 'little', repeat: 'lot' }, target: 40 }\n  },\n  {\n    id: 'spreadsheet',\n    title: 'Recalculate a huge spreadsheet',\n    phase: { device: 'desktop', benchmark: 'machines', work: { steps: 600, repeat: 50 }, mix: { steps: 'lot', repeat: 'little' }, target: 40 }\n  },\n  {\n    id: 'faces',\n    title: 'Find faces in 1,000 photos with AI',\n    phase: { device: 'desktop', benchmark: 'machines', work: { steps: 20, repeat: 200, ai: 6000 }, mix: { steps: 'little', repeat: 'little', ai: 'lot' }, target: 31 }\n  }\n];\n\nconst MISSIONS = [\n  {\n    id: 'game',\n    starter: true,\n    title: 'Indie Phone Game',\n    interest: 'Gaming',\n    setup: {\n      task: 'Run the enemies\\' decisions in a phone game.',\n      device: 'phone',\n      work: { steps: 0.04 },\n      mix: { steps: 'lot' },\n      target: 0.016,\n      budget: 400,\n      powerLimit: 10,\n      locked: { gpu: 2 },\n      reserved: ['gpu'],\n      energyAs: 'battery'\n    },\n    twist: {\n      card: 'The enemies now use an AI model that learns how each player moves.',\n      work: { steps: 0.005, ai: 0.2 },\n      mix: { steps: 'little', ai: 'lot' }\n    }\n  },\n  {\n    id: 'video',\n    title: 'Content Creator',\n    interest: 'Video',\n    setup: {\n      task: 'Export a 3-minute 4K video with effects, overnight.',\n      device: 'laptop',\n      work: { steps: 200, repeat: 600000 },\n      mix: { steps: 'little', repeat: 'lot' },\n      target: 28800,\n      budget: 1200,\n      powerLimit: 120,\n      energyAs: 'energy'\n    },\n    twist: {\n      card: 'The project is now a 30-second clip with only trims, and you have just $300 to spend.',\n      work: { steps: 200, repeat: 3000 },\n      mix: { steps: 'some', repeat: 'some' },\n      target: 660,\n      budget: 300\n    }\n  },\n  {\n    id: 'music',\n    title: 'Music App',\n    interest: 'Music',\n    setup: {\n      task: 'Sort 200 songs by tempo and mood on a phone.',\n      device: 'phone',\n      work: { steps: 0.5 },\n      mix: { steps: 'lot' },\n      target: 0.2,\n      budget: 400,\n      powerLimit: 4,\n      energyAs: 'battery'\n    },\n    twist: {\n      card: 'You add live karaoke: an AI model splits the singer\\'s voice from the music as it plays.',\n      work: { steps: 0.05, ai: 12 },\n      mix: { steps: 'little', ai: 'lot' },\n      target: 1\n    }\n  },\n  {\n    id: 'fitness',\n    title: 'Sports and Fitness',\n    interest: 'Sports',\n    setup: {\n      task: 'Count your steps all day on a phone.',\n      device: 'phone',\n      work: { steps: 0.02 },\n      mix: { steps: 'some' },\n      target: 0.1,\n      budget: 400,\n      powerLimit: 2.5,\n      energyAs: 'battery'\n    },\n    twist: {\n      card: 'Your coach wants AI to check running form in 100 practice videos, overnight, on a laptop.',\n      device: 'laptop',\n      work: { steps: 200, ai: 1500000 },\n      mix: { steps: 'little', ai: 'lot' },\n      target: 36000,\n      budget: 1500,\n      powerLimit: 150,\n      energyAs: 'energy'\n    }\n  },\n  {\n    id: 'yearbook',\n    title: 'Yearbook Photos',\n    interest: 'School clubs',\n    setup: {\n      task: 'Train an AI to sort 20,000 yearbook photos in a rented data center.',\n      device: 'datacenter',\n      work: { steps: 2000, ai: 200000000 },\n      mix: { steps: 'little', ai: 'lot' },\n      target: 432000,\n      budget: 175,\n      powerLimit: 3000,\n      energyAs: 'energy'\n    },\n    twist: {\n      card: 'Neighbors protest the data center\\'s use of groundwater for cooling. Your power limit drops to 600 W.',\n      powerLimit: 600\n    }\n  }\n];\n\nconst SCENES = {\n  'test-drive': { mode: 'test-drive' },\n  missions: { mode: 'missions' }\n};\n\n/* ==========================================================\n   Simulation\n   ========================================================== */\n\nfunction machineCost(build, phase) {\n  return (BASE.cost + CHIP_ORDER.reduce((sum, id) => sum + build[id] * CHIPS[id].cost, 0)) * DEVICES[phase.device].cost;\n}\n\nfunction machinePower(build, phase) {\n  return (BASE.power + CHIP_ORDER.reduce((sum, id) => sum + build[id] * CHIPS[id].power, 0)) * DEVICES[phase.device].power;\n}\n\nfunction helpersFor(kind, build, phase) {\n  const reserved = phase.reserved || [];\n  return CHIP_ORDER.filter(id => build[id] > 0 && CHIPS[id].speed[kind] > 0 && !reserved.includes(id));\n}\n\nfunction simulate(build, phase) {\n  const device = DEVICES[phase.device];\n  const reserved = phase.reserved || [];\n  const lanes = [];\n  let time = 0;\n  let energy = 0;\n  KIND_ORDER.forEach(kind => {\n    const work = phase.work[kind] || 0;\n    if (!work) return;\n    const helpers = helpersFor(kind, build, phase);\n    const throughput = helpers.reduce((sum, id) => sum + build[id] * CHIPS[id].speed[kind], 0) * device.speed;\n    const laneTime = work / throughput;\n    const watts = BASE.power + CHIP_ORDER.reduce((sum, id) => {\n      const busy = helpers.includes(id) || reserved.includes(id);\n      return sum + build[id] * CHIPS[id].power * (busy ? 1 : IDLE_POWER);\n    }, 0);\n    energy += watts * device.power * laneTime / 3600;\n    time += laneTime;\n    lanes.push({ kind, time: laneTime, helpers });\n  });\n  const score = Math.min(100, Math.round((phase.target / time) * 100));\n  const idle = CHIP_ORDER.filter(id => build[id] > 0 && !reserved.includes(id) && !lanes.some(lane => lane.helpers.includes(id)));\n  const bottleneck = lanes.reduce((a, b) => (b.time > a.time ? b : a)).kind;\n  return { time, energy, score, lanes, idle, bottleneck, cost: machineCost(build, phase), power: machinePower(build, phase), avgPower: energy * 3600 / time };\n}\n\nfunction withinLimits(build, phase) {\n  const budgetOk = phase.budget === undefined || machineCost(build, phase) <= phase.budget + 1e-9;\n  const powerOk = phase.powerLimit === undefined || machinePower(build, phase) <= phase.powerLimit + 1e-9;\n  return budgetOk && powerOk;\n}\n\nconst benchmarkCache = new Map();\n\nfunction candidateBuilds(phase) {\n  if (phase.benchmark === 'machines') return MACHINES.map(machine => machine.build);\n  const builds = [];\n  for (let cpu = CHIPS.cpu.min; cpu <= MAX_LEVEL; cpu += 1) {\n    for (let gpu = 0; gpu <= MAX_LEVEL; gpu += 1) {\n      for (let ai = 0; ai <= MAX_LEVEL; ai += 1) {\n        const build = Object.assign({ cpu, gpu, ai }, phase.locked || {});\n        if (withinLimits(build, phase)) builds.push(build);\n      }\n    }\n  }\n  return builds;\n}\n\nfunction benchmarkEnergy(phase) {\n  if (benchmarkCache.has(phase)) return benchmarkCache.get(phase);\n  let best = Infinity;\n  let bestAny = Infinity;\n  candidateBuilds(phase).forEach(build => {\n    const result = simulate(build, phase);\n    bestAny = Math.min(bestAny, result.energy);\n    if (result.score >= 100) best = Math.min(best, result.energy);\n  });\n  const value = Number.isFinite(best) ? best : bestAny;\n  benchmarkCache.set(phase, value);\n  return value;\n}\n\nfunction efficiencyLevel(result, phase) {\n  const ratio = benchmarkEnergy(phase) / result.energy;\n  if (ratio >= 0.8) return 'high';\n  if (ratio >= 0.5) return 'medium';\n  return 'low';\n}\n\nfunction rankRun(run) {\n  return run.result.score * 10 + { low: 0, medium: 1, high: 2 }[run.level];\n}\n\n/* ==========================================================\n   Helpers\n   ========================================================== */\n\nconst REDUCED_MOTION = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\nconst LOCALE = document.documentElement.lang || 'en-US';\nconst SVG_NS = 'http://www.w3.org/2000/svg';\nconst PROPERTY_KEYS = ['checked', 'disabled', 'value', 'hidden', 'tabIndex', 'htmlFor', 'min', 'max', 'step'];\n\nfunction el(tag, props, ...children) {\n  const node = document.createElement(tag);\n  Object.entries(props || {}).forEach(([key, value]) => {\n    if (value === undefined || value === null || value === false) return;\n    if (key === 'className') node.className = value;\n    else if (key === 'text') node.textContent = value;\n    else if (key === 'onClick') node.addEventListener('click', value);\n    else if (key === 'onChange') node.addEventListener('change', value);\n    else if (key === 'onInput') node.addEventListener('input', value);\n    else if (PROPERTY_KEYS.includes(key)) node[key] = value;\n    else node.setAttribute(key, value === true ? '' : value);\n  });\n  children.flat().forEach(child => {\n    if (child === null || child === undefined || child === false) return;\n    node.append(typeof child === 'string' ? document.createTextNode(child) : child);\n  });\n  return node;\n}\n\nfunction svg(tag, attrs, ...children) {\n  const node = document.createElementNS(SVG_NS, tag);\n  Object.entries(attrs || {}).forEach(([key, value]) => {\n    if (key === 'text') node.textContent = value;\n    else node.setAttribute(key, value);\n  });\n  children.flat().forEach(child => { if (child) node.append(child); });\n  return node;\n}\n\nfunction button(text, onClick, variant, extra) {\n  return el('button', Object.assign({ type: 'button', className: `button button--${variant || 'primary'}`, text, onClick }, extra || {}));\n}\n\nfunction wait(ms) {\n  return new Promise(resolve => setTimeout(resolve, ms));\n}\n\nfunction announce(message) {\n  const status = document.getElementById('status');\n  if (!status) return;\n  status.textContent = '';\n  setTimeout(() => { status.textContent = message; }, 50);\n}\n\nfunction focusById(id) {\n  const target = id && document.getElementById(id);\n  if (target) target.focus();\n}\n\nfunction formatNumber(value, options) {\n  return new Intl.NumberFormat(LOCALE, options).format(value);\n}\n\nfunction formatDuration(seconds) {\n  const unit = [\n    [1, 'millisecond', seconds * 1000],\n    [60, 'second', seconds],\n    [3600, 'minute', seconds / 60],\n    [172800, 'hour', seconds / 3600],\n    [Infinity, 'day', seconds / 86400]\n  ].find(([limit]) => seconds < limit);\n  return formatNumber(unit[2], { style: 'unit', unit: unit[1], unitDisplay: 'short', maximumFractionDigits: 1 });\n}\n\nfunction formatCost(dollars) {\n  return formatNumber(dollars, { style: 'currency', currency: 'USD', minimumFractionDigits: 0, maximumFractionDigits: 0 });\n}\n\nfunction formatWatts(watts) {\n  return `${formatNumber(watts, { maximumFractionDigits: watts < 10 ? 1 : 0 })} W`;\n}\n\nfunction formatEnergy(wattHours) {\n  if (wattHours >= 1000) return `${formatNumber(wattHours / 1000, { maximumSignificantDigits: 3 })} kWh`;\n  return `${formatNumber(wattHours, { maximumSignificantDigits: 3 })} Wh`;\n}\n\nfunction formatPercent(fraction) {\n  return formatNumber(fraction, { style: 'percent', maximumFractionDigits: 0 });\n}\n\nfunction specsText(build) {\n  return TEXT.specs(build.cpu, build.gpu, build.ai);\n}\n\n/* ==========================================================\n   Visual pieces: work shapes, machine picture, time bar\n   ========================================================== */\n\nfunction kindShape(kind, size) {\n  const s = size || 14;\n  const node = svg('svg', { viewBox: '0 0 14 14', width: s, height: s, class: `shape shape--${kind}`, 'aria-hidden': 'true', focusable: 'false' });\n  if (kind === 'steps') node.append(svg('rect', { x: 1, y: 1, width: 12, height: 12, rx: 2 }));\n  if (kind === 'repeat') node.append(svg('circle', { cx: 7, cy: 7, r: 6 }));\n  if (kind === 'ai') node.append(svg('path', { d: 'M7 0.5L13.5 7L7 13.5L0.5 7Z' }));\n  return node;\n}\n\nfunction workVisual(phase) {\n  return el('ul', { className: 'work-visual' }, KIND_ORDER.filter(kind => phase.mix[kind]).map(kind => {\n    const blocks = [];\n    for (let i = 0; i < AMOUNT_BLOCKS[phase.mix[kind]]; i += 1) blocks.push(kindShape(kind, 18));\n    return el('li', { className: 'work-row', 'aria-label': TEXT.workAria(KINDS[kind].name, TEXT.amounts[phase.mix[kind]]) },\n      el('span', { className: 'work-name', 'aria-hidden': 'true', text: KINDS[kind].name }),\n      el('span', { className: 'work-blocks' }, blocks)\n    );\n  }));\n}\n\nconst CHIP_LAYOUT = {\n  cpu: { x: 16, y: 34, w: 92, h: 92 },\n  gpu: { x: 120, y: 22, w: 128, h: 116 },\n  ai: { x: 260, y: 42, w: 76, h: 76 }\n};\n\nfunction machinePicture(build, reserved) {\n  const picture = svg('svg', { viewBox: '0 0 352 160', class: 'machine-picture', 'aria-hidden': 'true', focusable: 'false' });\n  picture.append(svg('rect', { x: 2, y: 2, width: 348, height: 156, rx: 16, class: 'board' }));\n  for (let i = 0; i < 5; i += 1) {\n    picture.append(svg('line', { x1: 12, x2: 340, y1: 20 + i * 30, y2: 20 + i * 30, class: 'trace' }));\n  }\n  CHIP_ORDER.forEach(id => {\n    const box = CHIP_LAYOUT[id];\n    const isReserved = (reserved || []).includes(id);\n    const group = svg('g', { class: `chip chip--${id}${build[id] === 0 ? ' chip--empty' : ''}${isReserved ? ' chip--reserved' : ''}`, 'data-chip': id });\n    group.append(svg('rect', { x: box.x, y: box.y, width: box.w, height: box.h, rx: 10, class: 'chip-body' }));\n    const cell = (box.w - 16) / MAX_LEVEL;\n    for (let level = 1; level <= MAX_LEVEL; level += 1) {\n      group.append(svg('rect', {\n        x: box.x + 8 + (level - 1) * cell + 1, y: box.y + box.h - 30, width: cell - 3, height: 18, rx: 3,\n        class: level <= build[id] ? 'cell cell--on' : 'cell'\n      }));\n    }\n    group.append(svg('text', { x: box.x + box.w / 2, y: box.y + 28, class: 'chip-label', 'text-anchor': 'middle', text: CHIPS[id].shortName }));\n    picture.append(group);\n  });\n  return picture;\n}\n\nfunction setWorking(scope, ids) {\n  scope.querySelectorAll('.chip').forEach(group => {\n    group.classList.toggle('is-working', ids.includes(group.getAttribute('data-chip')));\n  });\n}\n\nfunction timeBar(result, phase, open) {\n  const scaleMax = Math.max(result.time, phase.target);\n  const fill = el('span', { className: 'time-fill' }, result.lanes.map(lane => {\n    const segment = el('span', { className: `time-segment time-segment--${lane.kind}` });\n    segment.style.flexGrow = String(lane.time / result.time);\n    return segment;\n  }));\n  fill.style.width = `${(result.time / scaleMax) * 100}%`;\n  const marker = el('span', { className: 'goal-marker' }, el('span', { className: 'goal-flag', text: TEXT.goalMarker }));\n  marker.style.insetInlineStart = `${(phase.target / scaleMax) * 100}%`;\n  return el('div', { className: 'time-bar', 'aria-hidden': 'true' },\n    el('div', { className: 'time-track' }, fill, el('span', { className: `time-cover${open ? ' is-open' : ''}` })),\n    marker\n  );\n}\n\nasync function playTimeBar(scope, result, totalMs) {\n  const cover = scope.querySelector('.time-cover');\n  if (!cover || REDUCED_MOTION) {\n    if (cover) cover.classList.add('is-open');\n    return;\n  }\n  cover.style.transitionDuration = `${totalMs}ms`;\n  await wait(30);\n  cover.classList.add('is-open');\n  let elapsed = 0;\n  for (const lane of result.lanes) {\n    const ms = (lane.time / result.time) * totalMs;\n    setWorking(document, lane.helpers);\n    await wait(ms);\n    elapsed += ms;\n  }\n  setWorking(document, []);\n  if (elapsed < totalMs) await wait(totalMs - elapsed);\n}\n\nfunction runDuration(result, phase) {\n  return Math.min(3500, Math.max(1000, 1800 * Math.sqrt(result.time / phase.target)));\n}\n\nfunction efficiencyPips(level) {\n  return el('span', { className: `pips pips--${level}`, 'aria-hidden': 'true' }, el('span'), el('span'), el('span'));\n}\n\n/* ==========================================================\n   Build panel (sliders, picture, gauges)\n   ========================================================== */\n\nfunction gauge(label) {\n  const fill = el('span', { className: 'gauge-fill' });\n  const value = el('span', { className: 'gauge-value' });\n  const node = el('div', { className: 'gauge' },\n    el('div', { className: 'gauge-head' }, el('span', { className: 'gauge-label', text: label }), value),\n    el('div', { className: 'gauge-track', 'aria-hidden': 'true' }, fill)\n  );\n  return { node, fill, value };\n}\n\nfunction setGauge(g, used, limit) {\n  const ratio = Math.min(1, used / limit);\n  g.fill.style.transform = `scaleX(${ratio})`;\n  g.fill.classList.toggle('is-high', ratio > 0.85);\n}\n\nfunction buildPanel({ build, phase, disabled, onChange }) {\n  const locked = phase.locked || {};\n  const reserved = phase.reserved || [];\n  const pictureSlot = el('div', { className: 'picture-slot' });\n  const note = el('p', { className: 'limit-note', 'aria-live': 'polite' });\n  const costGauge = gauge(TEXT.cost);\n  const powerGauge = gauge(TEXT.power);\n  const sliders = {};\n\n  function refresh() {\n    pictureSlot.replaceChildren(machinePicture(build, reserved));\n    const cost = machineCost(build, phase);\n    const power = machinePower(build, phase);\n    setGauge(costGauge, cost, phase.budget);\n    costGauge.value.textContent = TEXT.gaugeValue(formatCost(cost), formatCost(phase.budget));\n    setGauge(powerGauge, power, phase.powerLimit);\n    powerGauge.value.textContent = TEXT.gaugeValue(formatWatts(power), formatWatts(phase.powerLimit));\n    CHIP_ORDER.forEach(id => {\n      sliders[id].output.textContent = TEXT.levelValue(build[id]);\n      sliders[id].input.value = String(build[id]);\n      sliders[id].input.setAttribute('aria-valuetext', TEXT.levelText(build[id]));\n    });\n  }\n\n  function handleInput(id, input) {\n    let value = Number(input.value);\n    let message = '';\n    while (value > build[id]) {\n      const trial = Object.assign({}, build, { [id]: value });\n      if (withinLimits(trial, phase)) break;\n      message = machineCost(trial, phase) > phase.budget + 1e-9 ? TEXT.overBudget(CHIPS[id].sentenceName) : TEXT.overPower(CHIPS[id].sentenceName);\n      value -= 1;\n    }\n    build[id] = value;\n    note.textContent = message;\n    refresh();\n    onChange(build);\n  }\n\n  const sliderList = el('div', { className: 'slider-list' }, CHIP_ORDER.map(id => {\n    const inputId = `slider-${id}`;\n    const isLocked = id in locked;\n    const input = el('input', {\n      type: 'range', id: inputId, className: `slider slider--${id}`,\n      min: String(CHIPS[id].min), max: String(MAX_LEVEL), step: '1', value: String(build[id]),\n      disabled: disabled || isLocked, 'aria-describedby': `${inputId}-does`\n    });\n    input.addEventListener('input', () => handleInput(id, input));\n    const output = el('span', { className: 'slider-output', 'aria-hidden': 'true' });\n    sliders[id] = { input, output };\n    const shapes = KIND_ORDER.filter(kind => CHIPS[id].speed[kind] > 0).map(kind => kindShape(kind, 14));\n    return el('div', { className: `slider-row slider-row--${id}${isLocked ? ' is-locked' : ''}` },\n      el('label', { htmlFor: inputId, className: 'slider-label', text: CHIPS[id].shortName }),\n      el('span', { className: 'slider-shapes' }, shapes),\n      input,\n      output,\n      el('span', { className: isLocked ? 'slider-lock' : 'visually-hidden', id: `${inputId}-does`, text: isLocked ? TEXT.lockedChip : CHIPS[id].does })\n    );\n  }));\n\n  const node = el('div', { className: 'build-panel' },\n    pictureSlot,\n    sliderList,\n    el('div', { className: 'gauges' }, costGauge.node, powerGauge.node),\n    note\n  );\n  refresh();\n  return { node };\n}\n\n/* ==========================================================\n   Level 1: Test Drive (all machines race side by side)\n   ========================================================== */\n\nconst RACE_BASE_MS = 900;\nconst RACE_MAX_MS = 6000;\nconst testDrive = { jobId: JOBS[0].id, racing: false, shownJobId: null, raced: {} };\n\nfunction raceResults(job) {\n  const results = MACHINES.map(machine => ({ machine, result: simulate(machine.build, job.phase) }));\n  results.forEach(entry => {\n    entry.place = 1 + results.filter(other => other.result.time < entry.result.time - 1e-9).length;\n    entry.level = efficiencyLevel(entry.result, job.phase);\n  });\n  return results;\n}\n\nfunction raceDurations(results) {\n  const fastest = Math.min(...results.map(entry => entry.result.time));\n  return results.map(entry => Math.min(RACE_MAX_MS, RACE_BASE_MS * Math.sqrt(entry.result.time / fastest)));\n}\n\nfunction jobPicker() {\n  const list = el('div', { className: 'job-picker' });\n  JOBS.forEach(job => {\n    const inputId = `job-${job.id}`;\n    const card = el('label', { className: `job-card${testDrive.jobId === job.id ? ' is-selected' : ''}`, htmlFor: inputId },\n      el('input', {\n        type: 'radio', name: 'job', id: inputId, value: job.id, checked: testDrive.jobId === job.id,\n        onChange: () => { testDrive.jobId = job.id; renderTestDrive(inputId); }\n      }),\n      el('span', { className: 'job-title', text: job.title }),\n      workVisual(job.phase),\n      testDrive.raced[job.id] ? el('span', { className: 'raced-tag', text: TEXT.raced }) : null\n    );\n    list.append(card);\n  });\n  return el('fieldset', { className: 'job-group', disabled: testDrive.racing }, el('legend', { text: TEXT.chooseJob }), list);\n}\n\nfunction raceCard(entry, finished) {\n  const { machine, result } = entry;\n  const headingId = `race-${machine.id}`;\n  const segments = result.lanes.map(lane => {\n    const segment = el('span', { className: `time-segment time-segment--${lane.kind}` });\n    segment.style.flexGrow = String(lane.time / result.time);\n    return segment;\n  });\n  return el('li', { className: `race-card${finished ? ' is-finished' : ''}${finished && entry.place === 1 ? ' is-winner' : ''}`, id: `card-${machine.id}` },\n    el('article', { 'aria-labelledby': headingId },\n      el('div', { className: 'race-top' },\n        el('h3', { id: headingId, text: machine.name }),\n        el('span', { className: 'place', 'aria-label': TEXT.placeText[entry.place - 1], text: TEXT.places[entry.place - 1] })\n      ),\n      el('span', { className: 'race-picture' }, machinePicture(machine.build)),\n      el('p', { className: 'visually-hidden', text: specsText(machine.build) }),\n      el('div', { className: 'time-track race-track', 'aria-hidden': 'true' },\n        el('span', { className: 'time-fill race-fill' }, segments),\n        el('span', { className: 'time-cover' })\n      ),\n      el('div', { className: 'race-result' },\n        el('p', { className: 'race-time', text: formatDuration(result.time) }),\n        el('div', { className: 'race-stats' },\n          el('span', { className: 'race-score', text: formatPercent(result.score / 100) }),\n          el('span', { className: 'race-eff' }, efficiencyPips(entry.level), el('span', { text: TEXT.efficiencyLevels[entry.level] }))\n        ),\n        result.idle.map(id => el('p', { className: 'idle-chip', text: TEXT.idle(CHIPS[id].shortName) }))\n      )\n    )\n  );\n}\n\nfunction renderTestDrive(focusId) {\n  const app = document.getElementById('app');\n  const job = JOBS.find(j => j.id === testDrive.jobId);\n  const finished = testDrive.shownJobId === job.id && !testDrive.racing;\n  const entries = raceResults(job);\n  app.replaceChildren(el('div', { className: 'stack' },\n    el('section', { className: 'group group--job', 'aria-labelledby': 'job-heading' },\n      el('h2', { className: 'group-title', id: 'job-heading', text: TEXT.chooseJob }),\n      el('div', { className: 'group-body race-controls' },\n        jobPicker(),\n        el('div', { className: 'race-go' },\n          el('p', { className: 'goal-chip' }, el('span', { className: 'chip-key', text: TEXT.goal }), el('span', { text: formatDuration(job.phase.target) })),\n          button(testDrive.racing ? TEXT.racing : TEXT.startRace, runRace, 'primary', { disabled: testDrive.racing, id: 'run-button' })\n        )\n      )\n    ),\n    el('section', { className: 'group group--race', 'aria-labelledby': 'race-heading' },\n      el('div', { className: 'group-title-row' },\n        el('h2', { className: 'group-title', id: 'race-heading', tabIndex: -1, text: `${TEXT.raceHeading}: ${job.title}` }),\n        el('span', { className: 'tag', text: TEXT.simulated })\n      ),\n      el('ul', { className: `race-grid group-body${finished ? ' is-done' : ''}` }, entries.map(entry => raceCard(entry, finished)))\n    ),\n    raceTable()\n  ));\n  focusById(focusId);\n}\n\nasync function runRace() {\n  const job = JOBS.find(j => j.id === testDrive.jobId);\n  testDrive.racing = true;\n  testDrive.shownJobId = job.id;\n  renderTestDrive('race-heading');\n  announce(TEXT.raceStart(job.title));\n  const entries = raceResults(job);\n  const durations = REDUCED_MOTION ? entries.map(() => 0) : raceDurations(entries);\n  entries.forEach((entry, i) => {\n    const card = document.getElementById(`card-${entry.machine.id}`);\n    card.querySelector('.time-cover').style.transitionDuration = `${durations[i]}ms`;\n    card.querySelectorAll('.chip').forEach(chip => {\n      if (entry.result.lanes.some(lane => lane.helpers.includes(chip.getAttribute('data-chip')))) chip.classList.add('is-working');\n    });\n    setTimeout(() => {\n      card.classList.add('is-finished');\n      if (entry.place === 1) card.classList.add('is-winner');\n      card.querySelectorAll('.chip').forEach(chip => chip.classList.remove('is-working'));\n    }, durations[i]);\n  });\n  await wait(30);\n  document.querySelectorAll('.race-grid .time-cover').forEach(cover => cover.classList.add('is-open'));\n  await wait(Math.max(...durations) + 500);\n  testDrive.racing = false;\n  testDrive.raced[job.id] = true;\n  renderTestDrive('race-heading');\n  const order = [...entries].sort((a, b) => a.place - b.place)\n    .map(entry => TEXT.raceEntry(TEXT.placeText[entry.place - 1], entry.machine.name, formatPercent(entry.result.score / 100), TEXT.efficiencyLevels[entry.level]));\n  announce(TEXT.raceAnnouncement(order.join(' ')));\n}\n\nfunction raceTable() {\n  return el('section', { className: 'group', 'aria-labelledby': 'tests-heading' },\n    el('h2', { className: 'group-title', id: 'tests-heading', text: TEXT.testResultsHeading }),\n    el('div', { className: 'group-body table-scroll' },\n      el('table', {},\n        el('thead', {}, el('tr', {},\n          el('th', { scope: 'col', text: TEXT.machineColumn }),\n          JOBS.map(job => el('th', { scope: 'col', text: job.title }))\n        )),\n        el('tbody', {}, MACHINES.map(machine => el('tr', {},\n          el('th', { scope: 'row', text: machine.name }),\n          JOBS.map(job => {\n            if (!testDrive.raced[job.id]) return el('td', { className: 'not-tested', text: TEXT.notTested });\n            const entry = raceResults(job).find(item => item.machine.id === machine.id);\n            return el('td', {},\n              el('span', { className: 'cell-score', text: formatPercent(entry.result.score / 100) }),\n              el('span', { className: 'cell-line' }, efficiencyPips(entry.level), el('span', { text: TEXT.efficiencyLevels[entry.level] }))\n            );\n          })\n        )))\n      )\n    )\n  );\n}\n\n/* ==========================================================\n   Level 2: Missions\n   ========================================================== */\n\nconst missions = { completed: {}, current: null };\nconst phaseCache = new Map();\n\nfunction phaseFor(mission, key) {\n  if (key === 'setup') return mission.setup;\n  if (!phaseCache.has(mission.id)) phaseCache.set(mission.id, Object.assign({}, mission.setup, mission.twist));\n  return phaseCache.get(mission.id);\n}\n\nfunction currentMission() {\n  return MISSIONS.find(m => m.id === missions.current.id);\n}\n\nfunction currentPhase() {\n  return phaseFor(currentMission(), missions.current.phaseKey);\n}\n\nfunction makeRun(build, phase) {\n  const result = simulate(build, phase);\n  return { build: Object.assign({}, build), result, level: efficiencyLevel(result, phase) };\n}\n\nfunction startMission(id) {\n  const mission = MISSIONS.find(m => m.id === id);\n  missions.current = {\n    id,\n    stage: 0,\n    phaseKey: 'setup',\n    build: Object.assign({ cpu: 1, gpu: 0, ai: 0 }, mission.setup.locked || {}),\n    runs: [],\n    running: false,\n    error: null,\n    notice: null,\n    before: null,\n    sameBuild: null\n  };\n  renderMission('mission-heading');\n}\n\nfunction missionCard(mission) {\n  const done = Boolean(missions.completed[mission.id]);\n  const locked = !mission.starter && !missions.completed.game;\n  const headingId = `card-${mission.id}`;\n  return el('li', { className: `mission-card mission-card--${mission.id}${locked ? ' is-locked' : ''}` },\n    el('article', { 'aria-labelledby': headingId },\n      el('p', { className: 'tag', text: mission.starter ? TEXT.starterTag : mission.interest }),\n      el('h3', { id: headingId, text: mission.title }),\n      el('p', { className: 'card-task', text: mission.setup.task }),\n      workVisual(mission.setup),\n      el('div', { className: 'card-foot' },\n        done ? el('span', { className: 'done-tag', text: TEXT.completed }) : null,\n        locked\n          ? el('span', { className: 'locked-text', text: TEXT.lockedMission })\n          : button(done ? TEXT.playAgain : TEXT.startMission, () => startMission(mission.id), done ? 'secondary' : 'primary', { 'aria-describedby': headingId })\n      )\n    )\n  );\n}\n\nfunction renderMenu(focusId) {\n  document.getElementById('app').replaceChildren(el('div', { className: 'stack' },\n    el('section', { className: 'group', 'aria-labelledby': 'starter-heading' },\n      el('h2', { className: 'group-title', id: 'starter-heading', tabIndex: -1, text: TEXT.starterHeading }),\n      el('ul', { className: 'group-body mission-grid mission-grid--single' }, MISSIONS.filter(m => m.starter).map(missionCard))\n    ),\n    el('section', { className: 'group', 'aria-labelledby': 'choice-heading' },\n      el('h2', { className: 'group-title', id: 'choice-heading', tabIndex: -1, text: TEXT.choiceHeading }),\n      el('ul', { className: 'group-body mission-grid' }, MISSIONS.filter(m => !m.starter).map(missionCard))\n    )\n  ));\n  focusById(focusId);\n}\n\nfunction stepper(stage) {\n  return el('ol', { className: 'stepper', 'aria-label': TEXT.stageText(stage + 1, TEXT.stages.length, TEXT.stages[stage]) },\n    TEXT.stages.map((name, i) => el('li', { className: `step${i === stage ? ' is-current' : ''}${i < stage ? ' is-done' : ''}`, 'aria-current': i === stage ? 'step' : null },\n      el('span', { className: 'step-number', text: formatNumber(i + 1) }),\n      el('span', { className: 'step-name', text: name })\n    ))\n  );\n}\n\nfunction infoChip(key, value) {\n  return el('li', { className: 'info-chip' }, el('span', { className: 'chip-key', text: key }), el('span', { className: 'chip-value', text: value }));\n}\n\nfunction missionPanel(mission, phase) {\n  const state = missions.current;\n  const isTwist = state.phaseKey === 'twist';\n  return el('section', { className: `group group--mission${isTwist ? ' group--twist' : ''}`, 'aria-labelledby': 'mission-heading' },\n    el('h2', { className: 'group-title', id: 'mission-heading', tabIndex: -1, text: isTwist ? TEXT.twistHeading : TEXT.missionHeading }),\n    el('div', { className: 'group-body' },\n      el('p', { className: 'task', text: isTwist ? mission.twist.card : phase.task }),\n      el('ul', { className: 'info-chips' },\n        infoChip(TEXT.goal, formatDuration(phase.target)),\n        infoChip(TEXT.device, DEVICES[phase.device].name),\n        infoChip(TEXT.budget, formatCost(phase.budget)),\n        infoChip(TEXT.powerLimit, formatWatts(phase.powerLimit))\n      ),\n      el('div', { className: 'work-box' }, el('h3', { className: 'mini-title', text: TEXT.work }), workVisual(phase))\n    )\n  );\n}\n\nfunction resultBody(run, phase) {\n  const r = run.result;\n  const tipLines = [el('p', { className: 'tip', text: TEXT.tips[r.bottleneck] })];\n  r.idle.forEach(id => tipLines.push(el('p', { className: 'idle-chip', text: TEXT.idle(CHIPS[id].shortName) })));\n  const energyText = phase.energyAs === 'battery'\n    ? TEXT.batteryValue(formatPercent(r.avgPower / PHONE_BATTERY_WH))\n    : TEXT.energyValue(formatEnergy(r.energy));\n  return el('div', { className: 'result-body' },\n    el('div', { className: 'score-pair' },\n      el('div', { className: `score-tile${r.score >= 100 ? ' is-full' : ''}` },\n        el('span', { className: 'score-key', text: TEXT.taskScore }),\n        el('span', { className: 'score-number', text: formatPercent(r.score / 100) })\n      ),\n      el('div', { className: `score-tile score-tile--${run.level}` },\n        el('span', { className: 'score-key', text: TEXT.efficiency }),\n        el('span', { className: 'score-word', text: TEXT.efficiencyLevels[run.level] }),\n        efficiencyPips(run.level)\n      )\n    ),\n    timeBar(r, phase, true),\n    el('p', { className: 'time-text', text: TEXT.timeValue(formatDuration(r.time), formatDuration(phase.target)) }),\n    el('p', { className: 'energy-text', text: energyText }),\n    r.score >= 100 && run.level === 'high' ? el('p', { className: 'badge', text: TEXT.badge }) : null,\n    tipLines\n  );\n}\n\nfunction historyStrip(runs) {\n  if (!runs.length) return el('p', { className: 'history-empty', text: TEXT.historyEmpty });\n  const best = runs.reduce((a, b) => (rankRun(b) > rankRun(a) ? b : a));\n  return el('ol', { className: 'history' }, runs.map((run, i) => el('li', {\n    className: `history-chip${run === best ? ' is-best' : ''}${i === runs.length - 1 ? ' is-latest' : ''}`,\n    'aria-label': TEXT.runChip(specsText(run.build), formatPercent(run.result.score / 100), TEXT.efficiencyLevels[run.level])\n  },\n    el('span', { className: 'mini-levels', 'aria-hidden': 'true' }, CHIP_ORDER.map(id => {\n      const bar = el('span', { className: `mini-level mini-level--${id}` });\n      bar.style.transform = `scaleY(${Math.max(0.08, run.build[id] / MAX_LEVEL)})`;\n      return bar;\n    })),\n    el('span', { className: 'history-score', 'aria-hidden': 'true', text: formatPercent(run.result.score / 100) }),\n    efficiencyPips(run.level),\n    run === best ? el('span', { className: 'best-tag', 'aria-hidden': 'true', text: TEXT.best }) : null\n  )));\n}\n\nfunction resultsPanel(phase) {\n  const state = missions.current;\n  const latest = state.runs[state.runs.length - 1];\n  let body;\n  if (state.running && latest) {\n    body = el('div', { className: 'result-body is-running' },\n      el('p', { className: 'running-text', text: state.phaseKey === 'twist' && state.runs.length === 1 ? TEXT.twistAutoRun : TEXT.running }),\n      timeBar(latest.result, phase, false)\n    );\n  } else if (latest) {\n    body = resultBody(latest, phase);\n  } else {\n    body = el('div', { className: 'result-body is-empty' }, el('p', { text: TEXT.emptyResult }));\n  }\n  return el('section', { className: 'group group--results', 'aria-labelledby': 'results-heading' },\n    el('div', { className: 'group-title-row' },\n      el('h2', { className: 'group-title', id: 'results-heading', tabIndex: -1, text: TEXT.resultsHeading }),\n      el('span', { className: 'tag', text: TEXT.simulated })\n    ),\n    el('div', { className: 'group-body' },\n      el('div', { className: 'result-slot', id: 'result-slot' }, body),\n      el('h3', { className: 'mini-title', text: TEXT.history }),\n      historyStrip(state.running ? state.runs.slice(0, -1) : state.runs)\n    )\n  );\n}\n\nfunction renderMission(focusId) {\n  const state = missions.current;\n  const mission = currentMission();\n  const phase = currentPhase();\n  const panel = buildPanel({ build: state.build, phase, disabled: state.running, onChange: () => {} });\n  const nextButton = state.phaseKey === 'setup'\n    ? button(TEXT.seeTwist, showTwist, 'secondary', { disabled: state.running })\n    : button(TEXT.finish, finishMission, 'secondary', { disabled: state.running });\n  const view = el('div', { className: 'mission-screen' },\n    el('div', { className: 'mission-top' },\n      button(TEXT.backToMissions, () => { missions.current = null; renderMenu('starter-heading'); }, 'ghost'),\n      el('h2', { className: 'mission-title', text: mission.title }),\n      stepper(state.stage)\n    ),\n    el('div', { className: 'workspace' },\n      el('section', { className: 'group group--build', 'aria-labelledby': 'build-heading' },\n        el('h2', { className: 'group-title', id: 'build-heading', text: TEXT.buildHeading }),\n        el('div', { className: 'group-body' },\n          panel.node,\n          el('div', { className: 'run-row' },\n            button(state.running ? TEXT.running : TEXT.run, runMission, 'primary', { disabled: state.running, id: 'run-button' }),\n            nextButton\n          ),\n          state.error ? el('p', { className: 'error', role: 'alert', text: state.error }) : null,\n          state.notice ? el('p', { className: 'notice', text: state.notice }) : null\n        )\n      ),\n      el('div', { className: 'side' },\n        missionPanel(mission, phase),\n        resultsPanel(phase)\n      )\n    )\n  );\n  document.getElementById('app').replaceChildren(view);\n  focusById(focusId);\n}\n\nasync function shrinkCurrentResult() {\n  const slot = document.querySelector('#result-slot .result-body');\n  if (!slot || REDUCED_MOTION || slot.classList.contains('is-empty')) return;\n  slot.classList.add('is-leaving');\n  await wait(320);\n}\n\nasync function playRun(run, phase, focusAfter) {\n  const state = missions.current;\n  await shrinkCurrentResult();\n  state.runs.push(run);\n  state.running = true;\n  state.error = null;\n  state.notice = null;\n  renderMission('results-heading');\n  announce(TEXT.runAnnouncement(specsText(run.build)));\n  await playTimeBar(document.getElementById('result-slot'), run.result, runDuration(run.result, phase));\n  state.running = false;\n  renderMission(focusAfter || 'results-heading');\n  announce(TEXT.resultAnnouncement(formatPercent(run.result.score / 100), TEXT.efficiencyLevels[run.level], TEXT.tips[run.result.bottleneck]));\n}\n\nfunction runMission() {\n  const phase = currentPhase();\n  playRun(makeRun(missions.current.build, phase), phase);\n}\n\nfunction showTwist() {\n  const state = missions.current;\n  const mission = currentMission();\n  const last = state.runs[state.runs.length - 1];\n  if (!last) {\n    state.error = TEXT.needRun;\n    renderMission('run-button');\n    return;\n  }\n  state.before = last;\n  state.phaseKey = 'twist';\n  state.stage = 1;\n  state.runs = [];\n  state.build = Object.assign({}, last.build, mission.twist.locked || mission.setup.locked || {});\n  const twistPhase = currentPhase();\n  const sameBuild = makeRun(state.build, twistPhase);\n  state.sameBuild = sameBuild;\n  playRun(sameBuild, twistPhase, 'mission-heading').then(() => {\n    state.stage = 2;\n    if (!withinLimits(state.build, twistPhase)) {\n      fitToLimits(state.build, twistPhase);\n      state.notice = TEXT.fitted;\n    }\n    renderMission('mission-heading');\n  });\n}\n\nfunction fitToLimits(build, phase) {\n  const locked = phase.locked || {};\n  ['gpu', 'ai', 'cpu'].forEach(id => {\n    while (!withinLimits(build, phase) && build[id] > CHIPS[id].min && !(id in locked)) build[id] -= 1;\n  });\n}\n\nfunction finishMission() {\n  const state = missions.current;\n  const mission = currentMission();\n  missions.completed[mission.id] = true;\n  state.stage = 3;\n  const after = state.runs[state.runs.length - 1];\n  const row = (title, run) => el('li', { className: 'summary-row' },\n    el('h3', { text: title }),\n    el('span', { className: 'race-picture' }, machinePicture(run.build)),\n    el('p', { className: 'summary-specs', text: specsText(run.build) }),\n    el('p', { className: 'summary-score', text: TEXT.summaryScore(formatPercent(run.result.score / 100), TEXT.efficiencyLevels[run.level]) })\n  );\n  document.getElementById('app').replaceChildren(el('div', { className: 'mission-screen' },\n    el('div', { className: 'mission-top' },\n      button(TEXT.backToMissions, () => { missions.current = null; renderMenu('choice-heading'); }, 'ghost'),\n      el('h2', { className: 'mission-title', text: mission.title }),\n      stepper(3)\n    ),\n    el('section', { className: 'group', 'aria-labelledby': 'summary-heading' },\n      el('h2', { className: 'group-title', id: 'summary-heading', tabIndex: -1, text: TEXT.missionComplete(mission.title) }),\n      el('div', { className: 'group-body' },\n        el('ol', { className: 'summary-grid' },\n          row(TEXT.beforeTwist, state.before),\n          row(TEXT.sameBuild, state.sameBuild),\n          row(TEXT.afterRebuild, after)\n        ),\n        el('p', { className: 'callout', text: TEXT.recordInGuide }),\n        el('div', { className: 'run-row' },\n          button(TEXT.backToMissions, () => { missions.current = null; renderMenu('choice-heading'); }, 'primary'),\n          button(TEXT.playAgain, () => startMission(mission.id), 'secondary')\n        )\n      )\n    )\n  ));\n  focusById('summary-heading');\n}\n\n/* ==========================================================\n   Glossary dialog and start-up\n   ========================================================== */\n\nfunction setUpGlossary() {\n  const dialog = document.getElementById('glossary');\n  const openButton = document.getElementById('remind-button');\n  const list = document.getElementById('glossary-list');\n  const closeButton = document.getElementById('glossary-close');\n  if (!dialog || !openButton || !list || !closeButton) return;\n  list.replaceChildren(...GLOSSARY.map(item => el('div', { className: 'glossary-item' },\n    el('dt', { text: item.term }),\n    el('dd', { text: item.definition })\n  )));\n  const supportsModal = typeof dialog.showModal === 'function';\n  openButton.addEventListener('click', () => {\n    if (supportsModal) dialog.showModal();\n    else dialog.setAttribute('open', '');\n    closeButton.focus();\n  });\n  closeButton.addEventListener('click', () => {\n    if (supportsModal) dialog.close();\n    else dialog.removeAttribute('open');\n    openButton.focus();\n  });\n}\n\nfunction showError() {\n  const app = document.getElementById('app');\n  if (app) app.replaceChildren(el('p', { className: 'error-message', role: 'alert', text: TEXT.loadError }));\n}\n\nfunction start() {\n  try {\n    const scene = SCENES[document.body.dataset.scene];\n    if (!scene || !window.Intl || !Intl.NumberFormat) throw new Error('Unsupported scene or browser');\n    setUpGlossary();\n    if (scene.mode === 'test-drive') renderTestDrive();\n    else renderMenu();\n  } catch (error) {\n    showError();\n  }\n}\n\nstart();\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Processor Missions</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body data-scene=\"missions\">\n  <header class=\"app-header\">\n    <div class=\"header-inner\">\n      <h1>Processor Missions</h1>\n      <button type=\"button\" class=\"button button--secondary\" id=\"remind-button\" aria-haspopup=\"dialog\">Remind me</button>\n    </div>\n    <p class=\"intro\">Build a machine for each mission. Stay under the budget and power limit.</p>\n  </header>\n  <main id=\"app\">\n    <p>Loading the activity.</p>\n    <noscript><p class=\"error-message\">This activity needs JavaScript. Ask your teacher for help.</p></noscript>\n  </main>\n  <p id=\"status\" class=\"visually-hidden\" role=\"status\" aria-live=\"polite\"></p>\n  <dialog id=\"glossary\" class=\"glossary\" aria-labelledby=\"glossary-title\">\n    <h2 id=\"glossary-title\">Remind me</h2>\n    <dl id=\"glossary-list\" class=\"glossary-list\"></dl>\n    <button type=\"button\" class=\"button button--primary\" id=\"glossary-close\">Close</button>\n  </dialog>\n</body>\n</html>\n",
          "folderId": "0",
          "active": true
