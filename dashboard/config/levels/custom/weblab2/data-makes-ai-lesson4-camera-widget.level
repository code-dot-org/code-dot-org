        "17": {
          "id": "17",
          "name": "style.css",
          "contents": ":root {\n  --navy: #1b1464;\n  --purple: #4f46e5;\n  --lavender: #e4e1f7;\n  --page: #f6f6f9;\n  --panel: #ffffff;\n  --card-line: #dcdce6;\n  --line: #8a87b8;\n  --muted: #55526f;\n  --feature: #0b5cad;\n  --feature-tint: #e3effb;\n  --label: #a3185f;\n  --label-tint: #fbe6f1;\n  --ok: #17612b;\n  --ok-tint: #e3f4e8;\n  --warn: #7a3b00;\n  --warn-tint: #fff1dd;\n  --ring: linear-gradient(135deg, #ff8a3d, #ec4899, #7c3aed);\n  --focus: #1b1464;\n}\n\n* { box-sizing: border-box; }\n\nhtml, body {\n  height: 100%;\n  overflow: hidden;\n}\n\nbody {\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  margin: 0;\n  font-family: Arial, Helvetica, sans-serif;\n  font-size: clamp(0.8rem, 0.45rem + 1.1vh, 1rem);\n  line-height: 1.3;\n  color: var(--navy);\n  background: var(--page);\n}\n\n[hidden] { display: none !important; }\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n}\n\n:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 2px;\n  box-shadow: 0 0 0 5px #ffffff;\n}\n\n/* Header */\n.app-bar {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 6px 16px;\n  background: var(--panel);\n  border-bottom: 1px solid var(--card-line);\n}\n\n.app-icon { width: 1.8em; height: 1.8em; flex: 0 0 auto; }\n\nh1 { margin: 0; font-size: 1.4em; }\n\n.app {\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  gap: 8px;\n  min-height: 0;\n  padding: 8px 12px 10px;\n}\n\n/* Cards */\n.card {\n  min-width: 0;\n  padding: 8px 12px;\n  background: var(--panel);\n  border: 1px solid var(--card-line);\n  border-radius: 12px;\n  box-shadow: 0 1px 3px rgba(27, 20, 100, 0.12);\n}\n\n.card-title {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin: 0 0 6px;\n  font-size: 1.05em;\n}\n\n.title-dot {\n  width: 0.8em;\n  height: 0.8em;\n  border-radius: 50%;\n  background: var(--navy);\n}\n\n/* Progress row */\n.progress-card {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 6px 16px;\n}\n\n.progress-card .card-title { margin: 0; }\n\n.progress-row {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px 12px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.progress-item {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 2px;\n  min-width: 3.6rem;\n  font-size: 0.8em;\n  color: var(--muted);\n  text-align: center;\n}\n\n.progress-circle {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 2.8em;\n  height: 2.8em;\n  overflow: hidden;\n  border: 2px solid var(--card-line);\n  border-radius: 50%;\n  background: #f1f1f6;\n  color: var(--navy);\n  font-size: 1.2em;\n  font-weight: bold;\n}\n\n.progress-item.is-current .progress-circle {\n  border: 3px solid transparent;\n  background: linear-gradient(#ffffff, #ffffff) padding-box, var(--ring) border-box;\n}\n\n.progress-thumb {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n}\n\n.progress-item.is-current .progress-label { color: var(--navy); font-weight: bold; }\n.progress-item.is-saved .progress-label { color: var(--ok); font-weight: bold; }\n\n.records-toggle,\n.records-close {\n  min-height: 2.75rem;\n  padding: 0.25rem 0.9rem;\n  font: inherit;\n  font-weight: bold;\n  color: var(--navy);\n  background: #ffffff;\n  border: 2px solid var(--navy);\n  border-radius: 10px;\n  box-shadow: 2px 2px 0 var(--navy);\n  cursor: pointer;\n}\n\n.records-toggle { margin-inline-start: auto; }\n.records-toggle[aria-expanded=\"true\"] { color: #ffffff; background: var(--purple); }\n.records-toggle:hover,\n.records-close:hover { background: var(--lavender); }\n.records-toggle[aria-expanded=\"true\"]:hover { background: var(--purple); }\n\n/* Workspace */\n.workspace {\n  position: relative;\n  display: grid;\n  grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);\n  gap: 10px;\n  min-height: 0;\n}\n\n.left,\n.right {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  min-width: 0;\n  min-height: 0;\n}\n\n/* Map */\n.map-card {\n  display: flex;\n  flex: 1 1 0;\n  flex-direction: column;\n  min-height: 0;\n}\n\n.map-area {\n  flex: 1 1 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 0;\n  container-type: size;\n}\n\n.map {\n  position: relative;\n  flex: 0 0 auto;\n  width: min(100cqw, calc(100cqh * 1200 / 670));\n  aspect-ratio: 1200 / 670;\n  border: 1px solid var(--card-line);\n  border-radius: 10px;\n  overflow: hidden;\n}\n\n.map-art {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  display: block;\n}\n\n.map-button {\n  position: absolute;\n  transform: translate(-50%, -50%);\n  min-width: 3.5rem;\n  min-height: 2.75rem;\n  padding: 0.15rem 0.4rem;\n  font: inherit;\n  font-size: 0.85em;\n  font-weight: bold;\n  line-height: 1.15;\n  color: var(--navy);\n  background: #ffffff;\n  border: 2px solid var(--navy);\n  border-radius: 10px;\n  box-shadow: 2px 2px 0 var(--navy);\n  cursor: pointer;\n}\n\n.map-button:hover { background: var(--lavender); }\n\n.map-button[aria-current=\"true\"] {\n  color: #ffffff;\n  background: var(--purple);\n}\n\n.map-button.is-saved {\n  color: #ffffff;\n  background: var(--ok);\n}\n\n.map-button.is-saved::after {\n  content: \"(Saved)\";\n  display: block;\n  font-size: 0.85em;\n  font-weight: normal;\n}\n\n/* Photo and record card */\n.placeholder {\n  flex: 1 1 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin: 0;\n  color: var(--muted);\n  text-align: center;\n}\n\n.photo-panel {\n  display: flex;\n  flex: 1 1 0;\n  flex-direction: column;\n  gap: 8px;\n  min-height: 0;\n}\n\n.photo-card {\n  display: flex;\n  flex: 1 1 0;\n  flex-direction: column;\n  min-height: 0;\n  padding: 0;\n  overflow: hidden;\n}\n\n.card-head {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 4px 12px;\n  border-bottom: 1px solid var(--card-line);\n}\n\n.head-ring {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 1.9em;\n  height: 1.9em;\n  border: 2px solid transparent;\n  border-radius: 50%;\n  background: linear-gradient(#ffffff, #ffffff) padding-box, var(--ring) border-box;\n  color: var(--navy);\n}\n.head-ring svg { width: 1.1em; height: 1.1em; }\n\n.head-title { margin: 0; font-size: 1em; }\n\n.photo-frame {\n  position: relative;\n  flex: 1 1 0;\n  min-height: 0;\n  background: #dfe5ea;\n}\n\n.photo-frame img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n}\n\n.saved-badge {\n  position: absolute;\n  inset-inline-start: 8px;\n  top: 8px;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  padding: 3px 12px 3px 8px;\n  border-radius: 999px;\n  background: var(--ok);\n  color: #ffffff;\n  font-weight: bold;\n  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);\n}\n.saved-badge svg { width: 1em; height: 1em; }\n\n.fallback {\n  height: 100%;\n  padding: 0.75rem;\n  overflow: auto;\n  background: var(--warn-tint);\n  border: 2px dashed var(--warn);\n  color: var(--warn);\n}\n.fallback p { margin: 0 0 0.5rem; }\n.fallback-title { font-weight: bold; }\n\n.record-card {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  flex: 0 0 auto;\n  gap: 4px 10px;\n  align-items: end;\n}\n\n.record-card .card-title { grid-column: 1 / -1; margin-bottom: 0; }\n\n.field label {\n  display: block;\n  margin-bottom: 2px;\n  font-size: 0.9em;\n  font-weight: bold;\n  color: var(--feature);\n}\n\n.field-label label { color: var(--label); }\n\nselect {\n  width: 100%;\n  min-height: 2rem;\n  padding: 0.1rem 0.4rem;\n  font: inherit;\n  color: var(--navy);\n  background: #ffffff;\n  border: 2px solid var(--line);\n  border-radius: 8px;\n}\n\n.field.is-off select {\n  border: 3px dashed var(--warn);\n  background: var(--warn-tint);\n}\n\n.save-button {\n  width: 100%;\n  min-height: 2.75rem;\n  padding: 0.25rem 0.75rem;\n  font: inherit;\n  font-weight: bold;\n  color: var(--navy);\n  background: #ffffff;\n  border: 2px solid var(--navy);\n  border-radius: 10px;\n  box-shadow: 3px 3px 0 var(--navy);\n  cursor: pointer;\n}\n.save-button:hover { background: var(--lavender); }\n.save-button:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 var(--navy); }\n\n/* Feedback prompt card */\n.message {\n  flex: 0 1 auto;\n  min-height: 0;\n  max-height: 40%;\n  overflow: auto;\n}\n\n.prompt-card {\n  display: flex;\n  gap: 8px;\n  align-items: flex-start;\n  padding: 6px 10px;\n  background: var(--panel);\n  border: 2px solid;\n  border-radius: 10px;\n  box-shadow: 3px 3px 0;\n}\n.prompt-card p { margin: 0; font-size: 0.9em; }\n.prompt-icon { flex: 0 0 auto; width: 1.3em; height: 1.3em; margin-top: 1px; }\n.prompt-icon svg { display: block; width: 100%; height: 100%; }\n.prompt-card.is-warn { color: var(--warn); background: var(--warn-tint); border-color: var(--warn); }\n.prompt-card.is-ok { color: var(--ok); background: var(--ok-tint); border-color: var(--ok); }\n\n/* Records panel (opens over the workspace) */\n.records-panel {\n  position: absolute;\n  inset: 0;\n  z-index: 5;\n  overflow: auto;\n  padding: 10px 12px;\n  box-shadow: 0 4px 16px rgba(27, 20, 100, 0.3);\n}\n\n.records-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 6px;\n}\n.records-head .card-title { margin: 0; }\n\n.records-panel p { margin: 0; }\n\n.table-wrap { overflow-x: auto; }\n\ntable {\n  width: 100%;\n  border-collapse: separate;\n  border-spacing: 0;\n  overflow: hidden;\n  border: 1px solid var(--card-line);\n  border-radius: 10px;\n  font-size: 0.9em;\n}\n\nth, td {\n  padding: 0.25rem 0.5rem;\n  text-align: start;\n  border-bottom: 1px solid var(--card-line);\n}\n\nth { color: #ffffff; background: var(--feature); }\nth.is-label { background: var(--label); }\nth small { display: block; font-weight: normal; }\ntbody th { color: var(--navy); background: #f1f1f6; }\ntbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }\ntd.is-feature { background: var(--feature-tint); }\ntd.is-label { background: var(--label-tint); font-weight: bold; }\n\n.load-error {\n  padding: 0.75rem 1rem;\n  color: var(--warn);\n  background: var(--warn-tint);\n  border: 2px solid var(--warn);\n}\n\n/* Phones: stack and allow scrolling */\n@media (max-width: 639px) {\n  html, body { height: auto; overflow: auto; }\n  body { display: block; font-size: 1rem; }\n  .app { display: grid; grid-template-rows: none; }\n  .workspace { grid-template-columns: minmax(0, 1fr); }\n  .map-area { container-type: normal; display: block; }\n  .map { width: 100%; }\n  .map-button { min-width: 4.5rem; }\n  .map-card, .photo-panel, .photo-card, .placeholder, .photo-frame { flex: none; }\n  .photo-frame img { height: auto; aspect-ratio: 1312 / 816; }\n  .records-panel { position: fixed; inset: 8px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  * { transition: none !important; animation: none !important; }\n}\n",
          "folderId": "0",
          "active": false
        },
        "18": {
          "id": "18",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Camera Map</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <header class=\"app-bar\">\n    <svg class=\"app-icon\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" focusable=\"false\">\n      <defs>\n        <linearGradient id=\"icon-gradient\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n          <stop offset=\"0\" stop-color=\"#ff8a3d\"/>\n          <stop offset=\"0.5\" stop-color=\"#ec4899\"/>\n          <stop offset=\"1\" stop-color=\"#7c3aed\"/>\n        </linearGradient>\n      </defs>\n      <path d=\"M4 11a3 3 0 0 1 3-3h3l1.5-2.5h9L22 8h3a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3z\" fill=\"none\" stroke=\"url(#icon-gradient)\" stroke-width=\"2.4\" stroke-linejoin=\"round\"/>\n      <circle cx=\"16\" cy=\"17\" r=\"4.5\" fill=\"none\" stroke=\"url(#icon-gradient)\" stroke-width=\"2.4\"/>\n    </svg>\n    <h1>Camera Map</h1>\n  </header>\n\n  <main class=\"app\">\n\n    <section class=\"card progress-card\" aria-labelledby=\"progress-heading\">\n      <h2 id=\"progress-heading\" class=\"card-title\">Your cameras</h2>\n      <ol class=\"progress-row\" id=\"progress-row\"></ol>\n      <button type=\"button\" class=\"records-toggle\" id=\"records-toggle\" aria-expanded=\"false\" aria-controls=\"records-panel\"></button>\n    </section>\n\n    <div class=\"workspace\">\n\n      <section class=\"card records-panel\" id=\"records-panel\" aria-labelledby=\"table-heading\" hidden>\n        <div class=\"records-head\">\n          <h2 id=\"table-heading\" class=\"card-title\" tabindex=\"-1\">Your Records</h2>\n          <button type=\"button\" class=\"records-close\" id=\"records-close\">Close</button>\n        </div>\n        <p id=\"table-empty\">No records yet. Click a camera to start.</p>\n        <div class=\"table-wrap\" id=\"table-wrap\" hidden>\n          <table>\n            <caption class=\"visually-hidden\">Saved camera records</caption>\n            <thead>\n              <tr id=\"table-head\"></tr>\n            </thead>\n            <tbody id=\"table-body\"></tbody>\n          </table>\n        </div>\n      </section>\n\n      <div class=\"left\">\n        <section class=\"card map-card\" aria-labelledby=\"map-heading\">\n          <h2 id=\"map-heading\" class=\"card-title\">Park Map</h2>\n          <div class=\"map-area\">\n            <div class=\"map\" id=\"map\">\n              <img class=\"map-art\" src=\"map-bg.jpg\" alt=\"\" width=\"1200\" height=\"670\">\n              <div class=\"map-buttons\" id=\"map-buttons\"></div>\n            </div>\n          </div>\n        </section>\n        <div class=\"message\" id=\"message\" role=\"status\" aria-live=\"polite\"></div>\n      </div>\n\n      <div class=\"right\">\n        <p class=\"card placeholder\" id=\"placeholder\">Choose a camera on the map.</p>\n\n        <div class=\"photo-panel\" id=\"photo-panel\" hidden>\n          <section class=\"card photo-card\" aria-labelledby=\"photo-heading\">\n            <div class=\"card-head\">\n              <span class=\"head-ring\" aria-hidden=\"true\">\n                <svg viewBox=\"0 0 32 32\" focusable=\"false\"><path d=\"M6 12a3 3 0 0 1 3-3h2.5L13 6.5h6L20.5 9H23a3 3 0 0 1 3 3v10a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linejoin=\"round\"/><circle cx=\"16\" cy=\"17\" r=\"3.8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\"/></svg>\n              </span>\n              <h2 id=\"photo-heading\" class=\"head-title\" tabindex=\"-1\">Camera</h2>\n            </div>\n            <div class=\"photo-frame\" id=\"photo-frame\">\n              <img id=\"photo\" alt=\"\">\n              <div class=\"fallback\" id=\"fallback\" hidden>\n                <p class=\"fallback-title\">The photo could not load.</p>\n                <p id=\"fallback-text\"></p>\n              </div>\n              <span class=\"saved-badge\" id=\"saved-badge\" hidden>\n                <svg viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M3 8.5l3.2 3.2L13 4.8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n                Saved\n              </span>\n            </div>\n          </section>\n\n          <form class=\"card record-card\" id=\"card\" novalidate aria-labelledby=\"record-heading\">\n            <h3 id=\"record-heading\" class=\"card-title\"><span class=\"title-dot\" aria-hidden=\"true\"></span>Record Card</h3>\n            <div class=\"field\">\n              <label for=\"season\">Season</label>\n              <select id=\"season\" name=\"season\"></select>\n            </div>\n            <div class=\"field\">\n              <label for=\"timeOfDay\">Time of Day</label>\n              <select id=\"timeOfDay\" name=\"timeOfDay\"></select>\n            </div>\n            <div class=\"field\">\n              <label for=\"waterLevel\">Water Level</label>\n              <select id=\"waterLevel\" name=\"waterLevel\"></select>\n            </div>\n            <div class=\"field\">\n              <label for=\"temperature\">Temperature</label>\n              <select id=\"temperature\" name=\"temperature\"></select>\n            </div>\n            <div class=\"field field-label\">\n              <label for=\"elephantsVisit\">Elephants Visit</label>\n              <select id=\"elephantsVisit\" name=\"elephantsVisit\"></select>\n            </div>\n            <button type=\"submit\" class=\"save-button\">Save Record</button>\n          </form>\n        </div>\n      </div>\n\n    </div>\n\n    <p class=\"load-error\" id=\"load-error\" hidden>Camera Map could not start. Reload the page to try again.</p>\n  </main>\n  <script src=\"script.js\" defer></script>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "19": {
          "id": "19",
          "name": "script.js",
          "contents": "'use strict';\n\n/*\n * Edit this section to change photos, answers, alt text or map positions.\n * Each camera's answer is the record its photo should become.\n * x and y place the camera button on the map, in percent.\n */\nconst FEATURES = [\n  { key: 'season', label: 'Season', categories: ['Wet', 'Dry'], hint: 'Look at the grass.' },\n  { key: 'timeOfDay', label: 'Time of Day', categories: ['Morning', 'Afternoon', 'Night'], hint: 'Look at the light.' },\n  { key: 'waterLevel', label: 'Water Level', categories: ['High', 'Low'], hint: 'Look at where the water meets the bank.' },\n  { key: 'temperature', label: 'Temperature', categories: ['Hot', 'Cool'], hint: 'Read the stamp at the bottom of the photo.' },\n  { key: 'elephantsVisit', label: 'Elephants Visit', categories: ['Yes', 'No'], hint: 'Look at the water for elephants.', isLabel: true }\n];\n\nconst CAMERAS = [\n  {\n    id: 1,\n    name: 'Camera 1',\n    src: 'camera-1.jpg',\n    x: 42, y: 20,\n    alt: 'Night photo from a trail camera at a waterhole. The grass is dry and brown. The light is dim and gray from the night flash. The water is low, far below the bank. One elephant stands at the water. The stamp at the bottom says Cool.',\n    answer: { season: 'Dry', timeOfDay: 'Night', waterLevel: 'Low', temperature: 'Cool', elephantsVisit: 'Yes' }\n  },\n  {\n    id: 2,\n    name: 'Camera 2',\n    src: 'camera-2.jpg',\n    x: 65, y: 20,\n    alt: 'Morning photo from a trail camera at a waterhole. The grass is green. Soft, low sunlight shines from one side. The water is low, below the bank. No elephants are at the water. The stamp at the bottom says Cool.',\n    answer: { season: 'Wet', timeOfDay: 'Morning', waterLevel: 'Low', temperature: 'Cool', elephantsVisit: 'No' }\n  },\n  {\n    id: 3,\n    name: 'Camera 3',\n    src: 'camera-3.jpg',\n    x: 83, y: 48,\n    alt: 'Afternoon photo from a trail camera at a waterhole. The grass is green. Bright sunlight comes from high in the sky. The water is high and reaches the bank. Two elephants stand at the water. The stamp at the bottom says Hot.',\n    answer: { season: 'Wet', timeOfDay: 'Afternoon', waterLevel: 'High', temperature: 'Hot', elephantsVisit: 'Yes' }\n  },\n  {\n    id: 4,\n    name: 'Camera 4',\n    src: 'camera-4.jpg',\n    x: 66, y: 78,\n    alt: 'Afternoon photo from a trail camera at a waterhole. The grass is dry and brown. Bright sunlight comes from high in the sky. The water is low, far below the bank. One elephant stands at the water. The stamp at the bottom says Hot.',\n    answer: { season: 'Dry', timeOfDay: 'Afternoon', waterLevel: 'Low', temperature: 'Hot', elephantsVisit: 'Yes' }\n  },\n  {\n    id: 5,\n    name: 'Camera 5',\n    src: 'camera-5.jpg',\n    x: 42, y: 78,\n    alt: 'Afternoon photo from a trail camera at a waterhole. The grass is green. Bright sunlight comes from high in the sky. The water is low, below the bank. No elephants are at the water. The stamp at the bottom says Hot.',\n    answer: { season: 'Wet', timeOfDay: 'Afternoon', waterLevel: 'Low', temperature: 'Hot', elephantsVisit: 'No' }\n  },\n  {\n    id: 6,\n    name: 'Camera 6',\n    src: 'camera-6.jpg',\n    x: 22, y: 48,\n    alt: 'Morning photo from a trail camera at a waterhole. The grass is dry and brown. Soft, low sunlight shines from one side. The water is high and reaches the bank. No elephants are at the water. The stamp at the bottom says Hot.',\n    answer: { season: 'Dry', timeOfDay: 'Morning', waterLevel: 'High', temperature: 'Hot', elephantsVisit: 'No' }\n  }\n];\n\nconst TEXT = {\n  choose: 'Choose',\n  fillAll: 'Choose a category for all five features before you save.',\n  allDone: 'Great work! Your table has six records.',\n  cameraTable: 'Camera',\n  cameraOf: function (number, total) {\n    return `Camera ${number} of ${total}`;\n  },\n  labelTag: 'Label',\n  recordsTable: 'Saved camera records',\n  saved: 'Saved',\n  recordsToggle: function (count, total) {\n    return `Records (${count} of ${total})`;\n  }\n};\n\nconst savedRecords = {};\nlet currentCamera = null;\n\nconst ICONS = {\n  warn: '<svg viewBox=\"0 0 20 20\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"10\" cy=\"10\" r=\"8.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M10 5.5v5.5M10 13.5v1.5\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/></svg>',\n  ok: '<svg viewBox=\"0 0 20 20\" aria-hidden=\"true\" focusable=\"false\"><circle cx=\"10\" cy=\"10\" r=\"8.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/><path d=\"M6 10.4l2.7 2.7L14 7.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>'\n};\n\nconst els = {\n  progressRow: document.getElementById('progress-row'),\n  savedBadge: document.getElementById('saved-badge'),\n  mapButtons: document.getElementById('map-buttons'),\n  panel: document.getElementById('photo-panel'),\n  placeholder: document.getElementById('placeholder'),\n  recordsToggle: document.getElementById('records-toggle'),\n  recordsClose: document.getElementById('records-close'),\n  recordsPanel: document.getElementById('records-panel'),\n  recordsHeading: document.getElementById('table-heading'),\n  heading: document.getElementById('photo-heading'),\n  photo: document.getElementById('photo'),\n  fallback: document.getElementById('fallback'),\n  fallbackText: document.getElementById('fallback-text'),\n  card: document.getElementById('card'),\n  message: document.getElementById('message'),\n  tableEmpty: document.getElementById('table-empty'),\n  tableWrap: document.getElementById('table-wrap'),\n  tableHead: document.getElementById('table-head'),\n  tableBody: document.getElementById('table-body'),\n  loadError: document.getElementById('load-error')\n};\n\nfunction init() {\n  buildProgressRow();\n  buildMapButtons();\n  buildDropdowns();\n  buildTableHead();\n  renderRecordsToggle();\n  els.recordsToggle.addEventListener('click', function () {\n    if (els.recordsPanel.hidden) {\n      openRecords();\n    } else {\n      closeRecords(true);\n    }\n  });\n  els.recordsClose.addEventListener('click', function () {\n    closeRecords(true);\n  });\n  document.addEventListener('keydown', function (event) {\n    if (event.key === 'Escape' && !els.recordsPanel.hidden) {\n      closeRecords(true);\n    }\n  });\n  els.card.addEventListener('submit', handleSave);\n  els.photo.addEventListener('error', showFallback);\n  els.photo.addEventListener('load', hideFallback);\n}\n\nfunction renderRecordsToggle() {\n  els.recordsToggle.textContent = TEXT.recordsToggle(Object.keys(savedRecords).length, CAMERAS.length);\n}\n\nfunction openRecords() {\n  els.recordsPanel.hidden = false;\n  els.recordsToggle.setAttribute('aria-expanded', 'true');\n  els.recordsHeading.focus();\n}\n\nfunction closeRecords(returnFocus) {\n  els.recordsPanel.hidden = true;\n  els.recordsToggle.setAttribute('aria-expanded', 'false');\n  if (returnFocus) {\n    els.recordsToggle.focus();\n  }\n}\n\nfunction buildProgressRow() {\n  CAMERAS.forEach(function (camera) {\n    const item = document.createElement('li');\n    item.className = 'progress-item';\n    item.id = `progress-item-${camera.id}`;\n\n    const circle = document.createElement('span');\n    circle.className = 'progress-circle';\n    const number = document.createElement('span');\n    number.className = 'progress-number';\n    number.textContent = String(camera.id);\n    const thumb = document.createElement('img');\n    thumb.className = 'progress-thumb';\n    thumb.alt = '';\n    thumb.hidden = true;\n    thumb.addEventListener('error', function () {\n      thumb.hidden = true;\n    });\n    circle.appendChild(number);\n    circle.appendChild(thumb);\n\n    const label = document.createElement('span');\n    label.className = 'progress-label';\n    label.textContent = camera.name;\n\n    const button = document.createElement('button');\n    button.type = 'button';\n    button.className = 'progress-button';\n    button.id = `progress-button-${camera.id}`;\n    button.addEventListener('click', function () {\n      openCamera(camera);\n    });\n    button.appendChild(circle);\n    button.appendChild(label);\n    item.appendChild(button);\n    els.progressRow.appendChild(item);\n  });\n}\n\nfunction renderProgress() {\n  CAMERAS.forEach(function (camera) {\n    const item = document.getElementById(`progress-item-${camera.id}`);\n    const thumb = item.querySelector('.progress-thumb');\n    const label = item.querySelector('.progress-label');\n    const isSaved = Boolean(savedRecords[camera.id]);\n    const button = item.querySelector('.progress-button');\n    button.setAttribute('aria-label', isSaved ? `${camera.name}: ${TEXT.saved}` : camera.name);\n    item.classList.toggle('is-saved', isSaved);\n    item.classList.toggle('is-current', Boolean(currentCamera) && currentCamera.id === camera.id);\n    if (currentCamera && currentCamera.id === camera.id) {\n      item.setAttribute('aria-current', 'step');\n    } else {\n      item.removeAttribute('aria-current');\n    }\n    if (isSaved) {\n      thumb.src = camera.src;\n      thumb.hidden = false;\n      label.textContent = '';\n      const hiddenName = document.createElement('span');\n      hiddenName.className = 'visually-hidden';\n      hiddenName.textContent = `: `;\n      label.appendChild(hiddenName);\n      label.appendChild(document.createTextNode(TEXT.saved));\n    } else {\n      thumb.hidden = true;\n      label.textContent = camera.name;\n    }\n  });\n}\n\nfunction buildMapButtons() {\n  CAMERAS.forEach(function (camera) {\n    const button = document.createElement('button');\n    button.type = 'button';\n    button.className = 'map-button';\n    button.id = `map-button-${camera.id}`;\n    button.textContent = camera.name;\n    button.style.insetInlineStart = `${camera.x}%`;\n    button.style.top = `${camera.y}%`;\n    button.addEventListener('click', function () {\n      openCamera(camera);\n    });\n    els.mapButtons.appendChild(button);\n  });\n}\n\nfunction buildDropdowns() {\n  FEATURES.forEach(function (feature) {\n    const select = document.getElementById(feature.key);\n    select.appendChild(new Option(TEXT.choose, ''));\n    feature.categories.forEach(function (category) {\n      select.appendChild(new Option(category, category));\n    });\n    select.addEventListener('change', function () {\n      select.parentNode.classList.remove('is-off');\n    });\n  });\n}\n\nfunction buildTableHead() {\n  const first = document.createElement('th');\n  first.scope = 'col';\n  first.textContent = TEXT.cameraTable;\n  els.tableHead.appendChild(first);\n  FEATURES.forEach(function (feature) {\n    const th = document.createElement('th');\n    th.scope = 'col';\n    th.textContent = feature.label;\n    if (feature.isLabel) {\n      th.className = 'is-label';\n      const tag = document.createElement('small');\n      tag.textContent = TEXT.labelTag;\n      th.appendChild(tag);\n    }\n    els.tableHead.appendChild(th);\n  });\n}\n\nfunction openCamera(camera) {\n  currentCamera = camera;\n  clearMessage();\n  closeRecords(false);\n  els.placeholder.hidden = true;\n  els.panel.hidden = false;\n  els.heading.textContent = TEXT.cameraOf(camera.id, CAMERAS.length);\n  els.savedBadge.hidden = !savedRecords[camera.id];\n  hideFallback();\n  els.photo.alt = camera.alt;\n  els.fallbackText.textContent = camera.alt;\n  els.photo.src = camera.src;\n\n  const saved = savedRecords[camera.id] || {};\n  FEATURES.forEach(function (feature) {\n    const select = document.getElementById(feature.key);\n    select.value = saved[feature.key] || '';\n    select.parentNode.classList.remove('is-off');\n  });\n\n  CAMERAS.forEach(function (other) {\n    const button = document.getElementById(`map-button-${other.id}`);\n    if (other.id === camera.id) {\n      button.setAttribute('aria-current', 'true');\n    } else {\n      button.removeAttribute('aria-current');\n    }\n  });\n  renderProgress();\n  els.heading.focus();\n}\n\nfunction showFallback() {\n  els.photo.hidden = true;\n  els.fallback.hidden = false;\n}\n\nfunction hideFallback() {\n  els.photo.hidden = false;\n  els.fallback.hidden = true;\n}\n\nfunction readCard() {\n  const record = {};\n  FEATURES.forEach(function (feature) {\n    record[feature.key] = document.getElementById(feature.key).value;\n  });\n  return record;\n}\n\nfunction handleSave(event) {\n  event.preventDefault();\n  if (!currentCamera) {\n    return;\n  }\n  const record = readCard();\n  const empty = FEATURES.filter(function (feature) {\n    return record[feature.key] === '';\n  });\n  if (empty.length > 0) {\n    markOff(empty);\n    showMessage(TEXT.fillAll, 'is-warn');\n    return;\n  }\n\n  const off = FEATURES.filter(function (feature) {\n    return record[feature.key] !== currentCamera.answer[feature.key];\n  });\n  if (off.length > 0) {\n    markOff(off);\n    showMessage(buildHintMessage(off), 'is-warn');\n    return;\n  }\n\n  savedRecords[currentCamera.id] = record;\n  document.getElementById(`map-button-${currentCamera.id}`).classList.add('is-saved');\n  els.savedBadge.hidden = false;\n  renderTable();\n  renderProgress();\n  renderRecordsToggle();\n  const savedCount = Object.keys(savedRecords).length;\n  if (savedCount === CAMERAS.length) {\n    showMessage(TEXT.allDone, 'is-ok');\n  } else {\n    showMessage(`Record saved for ${currentCamera.name}. ${CAMERAS.length - savedCount} to go.`, 'is-ok');\n  }\n}\n\nfunction buildHintMessage(offFeatures) {\n  const names = offFeatures.map(function (feature) {\n    return feature.label;\n  });\n  const list = typeof Intl !== 'undefined' && Intl.ListFormat\n    ? new Intl.ListFormat('en', { style: 'long', type: 'conjunction' }).format(names)\n    : names.join(', ');\n  const hints = offFeatures.map(function (feature) {\n    return `${feature.label}: ${feature.hint}`;\n  }).join(' ');\n  return `Look at the photo again. Check these features: ${list}. ${hints}`;\n}\n\nfunction markOff(features) {\n  FEATURES.forEach(function (feature) {\n    document.getElementById(feature.key).parentNode.classList.remove('is-off');\n  });\n  features.forEach(function (feature) {\n    document.getElementById(feature.key).parentNode.classList.add('is-off');\n  });\n}\n\nfunction renderTable() {\n  els.tableBody.textContent = '';\n  CAMERAS.forEach(function (camera) {\n    const record = savedRecords[camera.id];\n    if (!record) {\n      return;\n    }\n    const row = document.createElement('tr');\n    const head = document.createElement('th');\n    head.scope = 'row';\n    head.textContent = camera.name;\n    row.appendChild(head);\n    FEATURES.forEach(function (feature) {\n      const td = document.createElement('td');\n      td.className = feature.isLabel ? 'is-label' : 'is-feature';\n      td.textContent = record[feature.key];\n      row.appendChild(td);\n    });\n    els.tableBody.appendChild(row);\n  });\n  els.tableEmpty.hidden = true;\n  els.tableWrap.hidden = false;\n}\n\nfunction showMessage(text, kind) {\n  els.message.textContent = '';\n  const card = document.createElement('div');\n  card.className = `prompt-card ${kind}`;\n  const icon = document.createElement('span');\n  icon.className = 'prompt-icon';\n  icon.innerHTML = kind === 'is-ok' ? ICONS.ok : ICONS.warn;\n  const p = document.createElement('p');\n  p.textContent = text;\n  card.appendChild(icon);\n  card.appendChild(p);\n  els.message.appendChild(card);\n}\n\nfunction clearMessage() {\n  els.message.textContent = '';\n}\n\ntry {\n  init();\n} catch (error) {\n  els.loadError.hidden = false;\n}\n\n\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "5",
