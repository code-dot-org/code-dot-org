    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Array Debugging Challenge</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n  <header>\n    <h1>Snack App</h1>\n  </header>\n  \n  <main>\n    <h2>Snack List Items</h2>\n    <p id=\"item0\">Item 1 will appear here.</p>\n    <p id=\"item1\">Item 2 will appear here.</p>\n    <p id=\"item2\">Item 3 will appear here.</p>\n\n    <h2>Last Item & Count</h2>\n    <p id=\"lastItem\">Last snack: [ERROR]</p>\n    <p id=\"count\">Total snacks: [ERROR]</p>\n  </main>\n\n  <script src=\"script.js\" defer></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "let snacks = [\"chips\", \"cookies\", \"fruit\"];\n\n// Display the first three items.\ndocument.getElementById(\"item0\").innerHTML = snacks[0];\ndocument.getElementById(\"item1\").innerHTML = snacks[1];\ndocument.getElementById(\"item2\").innerHTML = snacks[3]; \n\n//Display the total number of snacks\ndocument.getElementById(\"count\").innerHTML = \"Total snacks: \" + (snacks.length + 1);\n\n//Display the last snack\ndocument.getElementById(\"lastItem\").innerHTML = \"Last snack: \" + snacks[snacks.length];",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "/* Minimal styling for a focused debugging environment */\nbody {\n  font-family: Arial, sans-serif;\n  padding: 20px;\n  background-color: #f9f9f9;\n  color: #333;\n}\n\nh1 {\n  color: #c0392b; /* Reddish tone to highlight the \"Challenge\" */\n}\n\nh2 {\n  border-bottom: 1px solid #ccc;\n  padding-bottom: 5px;\n  margin-top: 25px;\n}\n\np {\n  padding: 5px 0;\n  margin: 5px 0;\n  background-color: #fff;\n  border-left: 4px solid #f39c12; /* Yellow/Orange focus */\n  padding-left: 10px;\n}",
          "folderId": "0",
          "active": false
        }
