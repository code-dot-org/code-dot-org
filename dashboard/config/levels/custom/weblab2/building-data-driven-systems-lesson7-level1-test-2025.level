        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Course Directory</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <header>\n    <h1>Community Learning Hub</h1>\n    <p>Find a class that sparks your interest.</p>\n  </header>\n\n  <main id=\"course-feed\">\n    \n    <div class=\"course-card\">\n      <img class=\"card-img\">\n      <div class=\"card-title\"></div>\n      <p class=\"card-level\"></p>\n      <button class=\"join-btn\">Click Here</button>\n    </div>\n\n    <div class=\"course-card\">\n      <img class=\"card-img\">\n      <div class=\"card-title\"></div>\n      <p class=\"card-level\"></p>\n      <button class=\"join-btn\">Click Here</button>\n    </div>\n\n    <div class=\"course-card\">\n      <img class=\"card-img\">\n      <div class=\"card-title\"></div>\n      <p class=\"card-level\"></p>\n      <button class=\"join-btn\">Click Here</button>\n    </div>\n\n  </main>\n\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// script.js (Starter Code)\n\n// Data: List of available courses\nconst courses = [\n  {\n    title: \"Intro to Web Design\",\n    level: \"Beginner\",\n    image: \"/images/WebDesign.png\"\n  },\n  {\n    title: \"Data Science Basics\",\n    level: \"Intermediate\",\n    image: \"/images/DataScience.png\"\n  },\n  {\n    title: \"Digital Art 101\",\n    level: \"Beginner\",\n    image: \"/images/DigitalArt.png\"\n  }\n];\n\n// Select all card elements\nconst cardElements = document.querySelectorAll(\".course-card\");\n\n// Helper to update a single card\nconst updateCard = (index) => {\n  // Get the specific card element and the data\n  const card = cardElements[index];\n  const data = courses[index];\n\n  // Select parts inside this card\n  const img = card.querySelector(\".card-img\");\n  const title = card.querySelector(\".card-title\");\n  const level = card.querySelector(\".card-level\");\n  const btn = card.querySelector(\".join-btn\");\n\n  // Update Content\n  img.src = data.image;\n  \n  // Update text\n  title.innerText = data.title;\n  level.innerText = data.level;\n  \n  btn.innerText = \"Click Here\";\n};\n\n// Update all 3 cards\nupdateCard(0);\nupdateCard(1);\nupdateCard(2);",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": ":root {\n  --primary: #2c3e50;\n  --bg: #f4f4f9;\n  --card-bg: #ffffff;\n}\n\nbody {\n  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n  background-color: var(--bg);\n  color: var(--primary);\n  margin: 0;\n  padding: 20px;\n  line-height: 1.5;\n}\n\nheader {\n  text-align: center;\n  margin-bottom: 30px;\n}\n\n#course-feed {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));\n  gap: 20px;\n  max-width: 1000px;\n  margin: 0 auto;\n}\n\n.course-card {\n  background: var(--card-bg);\n  border-radius: 8px;\n  padding: 15px;\n  box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n  text-align: center;\n}\n\n.course-card img {\n  width: 100%;\n  height: 150px;\n  object-fit: cover;\n  border-radius: 4px;\n  margin-bottom: 10px;\n}\n\n.course-level {\n  font-size: 0.9rem;\n  color: #e0e0e0; \n  margin-bottom: 10px;\n  font-weight: bold;\n}\n\n.join-btn {\n  background-color: var(--primary);\n  color: white;\n  border: none;\n  padding: 8px 16px;\n  border-radius: 4px;\n  cursor: pointer;\n  font-size: 1rem;\n}",
          "folderId": "0",
          "active": false
