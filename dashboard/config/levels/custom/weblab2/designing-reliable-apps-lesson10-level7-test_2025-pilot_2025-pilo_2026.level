H\ntVhMUBT4f9aVHJWaJIuL3v8QBV8quRQzp7MyCE1f5R8K95kaiGPA2W8vIsXY\nDDPJOvb8Po9rSWDjjy84iA6ARCg1KsHvkTrA/8MQau191OZAN7Co/PzTwbLB\n9OfLjdC/I0n+Zza4P37FoA/cr7sKQMNy2rbDnlg4kk0emYavIKaL1ZvLeDle\nCF5nyf97pnYXaj7FReZqwQMSmlB8AM91uhZCGbCgQTR0eJEcK5qcHYB4kq21\ncW/ag1WrX03tr7SeyzFfYQ4HsbNonWqwlwri+0Kc3haqU7Uxg6zFKlc+eO/L\nEIuurXqSgBI4jZvW79n8EfVLHKt/QckQ7wwtXVVWNOQ8/862cN2gJg3eCjcx\ngC9N1fRUG77jOJQ9wL6aMM9ASKX0hf5svcf72Sk8GikDJp4bBfEVQlUBfdRf\nSw9E64y8+kyH+JDXJNRu7cHw/m/xd/yx0C0J4sqiVCT9QlRfJnyXOBgPn8PB\ncE7czG6YF+/nSA2t3sCJZ18nRtQ0eK6suWIxTFoeweRSU6aycLRjMID6ajFu\nCQumgKlTyLey5EbWCSdGvZTzca1cNTPiiBUIc11s8BLFhhYHqTrNswFqK3NB\neAtm1wC79pGM9MvussAa1cDlfjGsAjFyc+kcok3RL+wsqioEgxrUQGgE6roU\nm1Wo3g1oIaBT0rtg6Hf0n6aWM9qVa26yTBHWk9fvWkvvEHB3yjOCeqIh0evG\n+alCFbfnXbnzTxp7fFuv1eLMB22rgbC8sjsTXVynd20BS2QevapYtQ9SWQUP\nhTOs5wQ/o1f3+vG6+qxtj4yt4+Kh+4r26+Ix10KSukZ4LatKzasFjWRyb23x\nwzDUe1JbmTIWiA==\n",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <meta charset=\"utf-8\">\n    <title>Population Tracker</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    <div class=\"container\">\n      \n      <div id=\"header-section\">\n        <h1 id=\"title-section\">Title</h1>\n        <p id=\"date-section\">Date</p>\n      </div>\n      \n      <div class=\"controls\">\n        <div id=\"status\">Status: </div>\n        <button id=\"fetch-btn\">Get Live Census</button>\n      </div>\n\n      <div id=\"results\"></div>\n      \n    </div>\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: sans-serif;\n  background: #f0f2f5;\n  display: flex;\n  justify-content: center;\n  padding-top: 40px;\n}\n\n.container {\n  background: white;\n  width: 400px;\n  padding: 30px;\n  border-radius: 12px;\n  box-shadow: 0 4px 15px rgba(0,0,0,0.1);\n}\n\n#header-section h1 { color: #1a73e8; margin-bottom: 5px; }\n#header-section p { color: #666; margin-top: 0; }\n\n#status {\n  background: #eee;\n  padding: 10px;\n  border-radius: 6px;\n  margin-bottom: 10px;\n  font-weight: bold;\n  font-size: 0.9rem;\n}\n\nbutton {\n  background: #1a73e8;\n  color: white;\n  border: none;\n  padding: 12px;\n  width: 100%;\n  border-radius: 6px;\n  font-size: 1rem;\n  cursor: pointer;\n}\nbutton:hover { background: #1557b0; }\n\n/* Visual Cues for Data Source */\n.result-card {\n  padding: 10px;\n  margin-top: 10px;\n  border-left: 5px solid #ccc;\n  background: #f9f9f9;\n}\n.live-data { border-left-color: #34a853; } /* Green */\n.backup-data { border-left-color: #fbbc05; } /* Orange */",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const apiEndpoint = \"https://restcountries.com/v3.1/all?fields=name,population\";\nconst outputElement = document.getElementById(\"results\");\nconst statusElement = document.getElementById(\"status\");\nconst headerElement = document.getElementById(\"header-section\");\nconst title = document.getElementById(\"title-section\");\nconst date = document.getElementById(\"date-section\");\n\n\nconst appConfig = {\n  title: \"Global Population Tracker\",\n  date: \"2026 Census\"\n};\n\nconst renderAppShell = () => {\n  title.innerHTML = appConfig.title;\n  date.innerHTML = appConfig.date;\n};\n\nrenderAppShell();\n\n\nconst localCountries = [\n  { name: \"Dominican Republic\", population: 10771504 },\n  { name: \"Puerto Rico\", population: 3203295 },\n  { name: \"India\", population: 1417492000 }\n];\n\nconst renderBackup = () => {\n\n  localCountries.forEach(country => {\n       outputElement.innerHTML += `\n         <div class=\"result-card live-data\">\n           <strong>${country.name}</strong><br>\n           Pop: ${country.population.toLocaleString()}\n         </div>`;\n  });\n}\n\nrenderBackup();",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    },
    "name_suffix": "_2026"
  },
