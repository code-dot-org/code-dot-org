<Weblab2>
  <config><![CDATA[{
  "published": true,
  "game_id": 74,
  "created_at": "2026-11-03T04:19:10.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": "true",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "style.css",
          "contents": "/*\n * CADS tokens\n * Copied from the CADS runtime (manifest 0.1.0), light theme. Only the tokens\n * that this stylesheet uses, and the tokens they refer to, are included.\n * Do not change values here. Change the component styles below instead.\n */\n\n:root {\n  /* Palette */\n  --brand-purple-5: #e4e2f8;\n  --brand-purple-20: #aca8ea;\n  --brand-purple-30: #928cef;\n  --brand-purple-50: #4c42cf;\n  --brand-purple-80: #2b1e9f;\n  --brand-purple-90: #1d1590;\n  --brand-orange-5: #ffe3ce;\n  --brand-orange-30: #ffa868;\n  --brand-pink-5: #fbdae8;\n  --brand-pink-30: #f07fb0;\n  --neutral-base-black: #121212;\n  --neutral-base-white: #ffffff;\n  --neutral-gray-5: #f1f2f4;\n  --neutral-gray-20: #d3d6da;\n  --neutral-gray-40: #9ea5ad;\n  --neutral-gray-70: #596069;\n  --neutral-gray-80: #4b5258;\n  --sentiment-error-5: #ffdada;\n  --sentiment-error-20: #f69898;\n  --sentiment-error-50: #eb1414;\n  --sentiment-error-70: #b30f0f;\n  --sentiment-information-30: #6fcaff;\n  --sentiment-success-5: #d8ffdc;\n  --sentiment-success-30: #7cdb87;\n  --sentiment-success-70: #258830;\n  --sentiment-success-90: #17541e;\n  --sentiment-warning-5: #fff5da;\n  --sentiment-warning-30: #ffd35c;\n  --sentiment-warning-90: #885d02;\n\n  /* Color roles (light theme) */\n  --background-neutral-primary: var(--neutral-base-white);\n  --background-neutral-secondary: var(--neutral-gray-5);\n  --background-brand-primary: var(--brand-purple-50);\n  --background-brand-light: var(--brand-purple-5);\n  --background-brand-mid: var(--brand-purple-20);\n  --background-brand-strong: var(--brand-purple-80);\n  --background-error-primary: var(--sentiment-error-50);\n  --background-error-light: var(--sentiment-error-5);\n  --background-warning-light: var(--sentiment-warning-5);\n  --background-success-primary: var(--sentiment-success-70);\n  --background-success-light: var(--sentiment-success-5);\n  --background-info-mid: var(--sentiment-information-30);\n  --background-selected-primary: var(--brand-purple-80);\n  --background-disabled-neutral: var(--neutral-gray-20);\n  --background-accent-orange-light: var(--brand-orange-5);\n  --background-accent-pink-light: var(--brand-pink-5);\n  --border-neutral-primary: var(--neutral-gray-20);\n  --border-neutral-secondary: var(--neutral-gray-40);\n  --border-neutral-solid: var(--neutral-base-black);\n  --border-brand-mid: var(--brand-purple-30);\n  --border-error-primary: var(--sentiment-error-50);\n  --border-error-mid: var(--sentiment-error-20);\n  --border-warning-mid: var(--sentiment-warning-30);\n  --border-success-mid: var(--sentiment-success-30);\n  --border-success-strong: var(--sentiment-success-70);\n  --border-focused-primary: var(--brand-purple-50);\n  --border-selected-primary: var(--brand-purple-80);\n  --border-accent-orange-mid: var(--brand-orange-30);\n  --border-accent-pink-mid: var(--brand-pink-30);\n  --text-neutral-primary: var(--neutral-base-black);\n  --text-neutral-tertiary: var(--neutral-gray-80);\n  --text-neutral-quaternary: var(--neutral-gray-70);\n  --text-neutral-white-fixed: var(--neutral-base-white);\n  --text-brand-primary: var(--brand-purple-50);\n  --text-brand-secondary: var(--brand-purple-90);\n  --text-error-secondary: var(--sentiment-error-70);\n  --text-warning-secondary: var(--sentiment-warning-90);\n  --text-success-secondary: var(--sentiment-success-90);\n  --text-selected-primary: var(--sentiment-success-5);\n\n  /* Type, shape, spacing, motion and control size */\n  --font-family-main: \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-family-heading: \"Space Grotesk\", \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-weight-semi-bold: 600;\n  --font-weight-bold: 700;\n  --text-heading-sm: 1.375rem;\n  --text-heading-xs: 1.25rem;\n  --leading-heading-sm: 1.875rem;\n  --leading-heading-xs: 1.75rem;\n  --text-body-lg: 1.125rem;\n  --text-body-md: 1rem;\n  --leading-body-lg: 1.75rem;\n  --leading-body-md: 1.5rem;\n  --shape-sm: .375rem;\n  --shape-md: .5rem;\n  --shape-lg: .625rem;\n  --shape-round: 62.4375rem;\n  --spacing-p-xxs: .5rem;\n  --spacing-p-xs: 1rem;\n  --spacing-p-s: 1.5rem;\n  --duration-short: .15s;\n  --easing-standard: cubic-bezier(.4, 0, .2, 1);\n  --easing-out: cubic-bezier(.23, 1, .32, 1);\n  --motion-press-scale: .97;\n  --motion-press-duration: .15s;\n  --motion-press-easing: cubic-bezier(.23, 1, .32, 1);\n  --transition-colors: background-color var(--duration-short) var(--easing-standard), color var(--duration-short) var(--easing-standard), border-color var(--duration-short) var(--easing-standard), box-shadow var(--duration-short) var(--easing-standard), opacity var(--duration-short) var(--easing-standard);\n  --transition-press: transform var(--motion-press-duration) var(--motion-press-easing);\n  --control-height-large: 48px;\n  --control-height-medium: 40px;\n  --control-height-extra-small: 24px;\n}\n\n/*\n * Component styles\n *\n * What is CADS here:\n *   - Every color, type size, spacing, radius, shadow, control height, motion\n *     and focus value comes from the CADS tokens above. No hard-coded colors.\n *\n * What was rebuilt from the CADS manifest (Web Lab has no CADS components):\n *   - Button: contained primary, outlined and text variants, medium and large.\n *   - SegmentedButton: the author-only page picker (selected tokens on the\n *     active segment, connected segments, shape-sm outer corners).\n *   - The report buttons use the toggle recipe from Chip and SegmentedButton:\n *     neutral when off, selected tokens when on, aria-pressed for state.\n *\n * What was approximated:\n *   - Geist and Space Grotesk are named by the CADS font tokens, but Web Lab\n *     blocks outside fonts, so the fallback stack in the token applies.\n *   - Spacing smaller than the smallest CADS step uses half of that step.\n *   - Alert (the verdict), Tag (Right, Wrong, Missed and the part labels), Chip\n *     (the part buttons), chat bubbles (the message and the AI reply) and\n *     Progress Bubble (the message dots) follow the CADS recipes. Text in them\n *     is 16px, not the 12 to 14px CADS sizes, to meet the 16px minimum.\n *   - The disabled Check button uses a darker label than the CADS recipe so it\n *     stays readable.\n *   - The icons are inline SVG, not Font Awesome.\n *   - The node cluster, the sample pages, the page notes and the reply cards\n *     are custom pieces built only from CADS tokens.\n */\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nhtml {\n  font-size: 100%;\n}\n\nbody {\n  margin: 0;\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-md);\n  line-height: var(--leading-body-md);\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n  border: 0;\n}\n\n.sprite {\n  position: absolute;\n  width: 0;\n  height: 0;\n  overflow: hidden;\n}\n\n.icon {\n  flex: none;\n  width: 1.25rem;\n  height: 1.25rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\np {\n  margin: 0;\n}\n\n/* ---------- Layout ---------- */\n\n.widget {\n  display: grid;\n  gap: var(--spacing-p-xs);\n  max-width: 55rem;\n  margin: 0 auto;\n  padding: var(--spacing-p-xs);\n}\n\n.error-banner {\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border: 1px solid var(--border-error-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-error-light);\n  color: var(--text-error-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n/* ---------- Buttons (CADS Button recipe) ---------- */\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: var(--spacing-p-xxs);\n  min-height: var(--control-height-medium);\n  padding: 0 var(--spacing-p-xs);\n  border: 1px solid transparent;\n  border-radius: var(--shape-md);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n  transition: var(--transition-colors), var(--transition-press);\n}\n\n.btn:active {\n  transform: scale(var(--motion-press-scale));\n}\n\n.btn-large {\n  min-height: var(--control-height-large);\n}\n\n.btn-contained {\n  background: var(--background-brand-primary);\n  color: var(--text-neutral-white-fixed);\n}\n\n.btn-contained:hover {\n  background: var(--background-brand-strong);\n}\n\n.btn-outlined {\n  border-color: var(--border-neutral-solid);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n}\n\n.btn-outlined:hover {\n  background: var(--background-neutral-secondary);\n}\n\n.btn-text {\n  background: transparent;\n  color: var(--text-brand-primary);\n}\n\n.btn-text:hover {\n  background: var(--background-brand-light);\n}\n\n.btn:focus-visible,\n.mark:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--background-neutral-primary), 0 0 0 4px var(--border-focused-primary);\n}\n\n/* ---------- Header ---------- */\n\n.intro {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n}\n\n.tag {\n  display: inline-flex;\n  align-items: center;\n  min-height: var(--control-height-extra-small);\n  padding: 0 var(--spacing-p-xxs);\n  border: 1px solid var(--border-brand-mid);\n  line-height: calc(var(--control-height-extra-small) - 2px);\n  border-radius: var(--shape-sm);\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.intro-steps .tag {\n  margin-inline-end: var(--spacing-p-xxs);\n}\n\n.intro-steps {\n  margin: 0;\n}\n\n.intro-page,\n.takeaway-page {\n  display: grid;\n  justify-items: start;\n  align-content: start;\n  gap: var(--spacing-p-xs);\n  max-width: 32rem;\n  padding: var(--spacing-p-xs) 0;\n}\n\n.intro-page p,\n.takeaway-page p {\n  margin: 0;\n}\n\n.intro-title {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-sm);\n  font-weight: var(--font-weight-bold);\n  line-height: var(--leading-heading-sm);\n}\n\n.intro-list {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  margin: 0;\n  padding-inline-start: var(--spacing-p-s);\n}\n\n.intro-list li::marker {\n  font-weight: var(--font-weight-bold);\n}\n\n.takeaway-page:focus {\n  outline: none;\n}\n\n.takeaway-parts {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-p-xxs);\n}\n\n.takeaway-parts .part-tag {\n  margin-inline-end: 0;\n}\n\n.takeaway-next {\n  font-size: var(--text-body-lg);\n  line-height: var(--leading-body-lg);\n}\n\n.widget:not([data-stage=\"intro\"]) .intro-page,\n.widget:not([data-stage=\"done\"]) .takeaway-page,\n.widget[data-stage=\"intro\"] .intro,\n.widget[data-stage=\"intro\"] .practice,\n.widget[data-stage=\"done\"] .intro,\n.widget[data-stage=\"done\"] .practice {\n  display: none;\n}\n\n/* ---------- Practice layout ---------- */\n\n.stage {\n  display: grid;\n  grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);\n  gap: var(--spacing-p-xs);\n  align-items: start;\n}\n\n.stage-right {\n  display: grid;\n  gap: var(--spacing-p-xs);\n  align-content: start;\n  min-width: 0;\n}\n\n.card {\n  padding: var(--spacing-p-xs);\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-lg);\n  background: var(--background-neutral-primary);\n}\n\n.card h2 {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-xs);\n  line-height: var(--leading-heading-xs);\n}\n\n/* ---------- Message ---------- */\n\n.msg-card {\n  display: grid;\n  gap: var(--spacing-p-xs);\n  align-content: start;\n}\n\n.msg-head {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--spacing-p-xxs);\n}\n\n/* CADS Progress Bubble: small dots, with the current message as a large numbered bubble */\n.msg-dots {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n}\n\n.round-dot {\n  display: grid;\n  place-items: center;\n  width: 0.75rem;\n  height: 0.75rem;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: 50%;\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font-size: var(--text-body-md);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: 1;\n}\n\n.round-dot.current {\n  width: 1.5rem;\n  height: 1.5rem;\n  border-color: var(--border-success-strong);\n}\n\n.round-dot[data-result=\"right\"] {\n  border-color: var(--background-success-primary);\n  background: var(--background-success-primary);\n  color: var(--text-neutral-white-fixed);\n}\n\n.round-dot[data-result=\"wrong\"] {\n  border-color: var(--background-error-primary);\n  background: var(--background-error-primary);\n  color: var(--text-neutral-white-fixed);\n}\n\n/* CADS chat message: the student's message is the human bubble */\n.thread {\n  display: grid;\n  justify-items: end;\n  align-content: start;\n  min-height: calc(var(--leading-body-md) * 4 + var(--spacing-p-xxs) * 2);\n}\n\n.bubble {\n  max-width: 100%;\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border-radius: var(--shape-md);\n  background: var(--background-info-mid);\n  color: var(--text-neutral-primary);\n}\n\n/* Parts get Tag colors that never match the green Right and red Wrong */\n.hl {\n  padding: 0;\n  line-height: var(--leading-body-md);\n  border-bottom: 2px solid;\n  border-radius: var(--shape-sm) var(--shape-sm) 0 0;\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n}\n\n.hl-label,\n.part-tag {\n  display: inline-block;\n  margin-inline-end: var(--spacing-p-xxs);\n  padding: 0 var(--spacing-p-xxs);\n  border: 1px solid;\n  border-radius: var(--shape-sm);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: calc(var(--control-height-extra-small) - 2px);\n}\n\n.part-tag {\n  margin-inline-end: 0;\n}\n\n.hl[data-part=\"expected\"] {\n  border-color: var(--border-brand-mid);\n}\n\n.hl[data-part=\"happened\"] {\n  border-color: var(--border-accent-orange-mid);\n}\n\n.hl[data-part=\"where\"] {\n  border-color: var(--border-accent-pink-mid);\n}\n\n.hl[data-part=\"expected\"] .hl-label,\n.part-tag[data-part=\"expected\"] {\n  border-color: var(--border-brand-mid);\n  background: var(--background-brand-light);\n  color: var(--text-neutral-primary);\n}\n\n.hl[data-part=\"happened\"] .hl-label,\n.part-tag[data-part=\"happened\"] {\n  border-color: var(--border-accent-orange-mid);\n  background: var(--background-accent-orange-light);\n  color: var(--text-neutral-primary);\n}\n\n.hl[data-part=\"where\"] .hl-label,\n.part-tag[data-part=\"where\"] {\n  border-color: var(--border-accent-pink-mid);\n  background: var(--background-accent-pink-light);\n  color: var(--text-neutral-primary);\n}\n\n.marks-label {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n/* CADS Chip: a pill. Selected uses the selected tokens. */\n.marks {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-between;\n  gap: var(--spacing-p-xxs) var(--spacing-p-xs);\n  margin-top: var(--spacing-p-xxs);\n}\n\n.mark-col {\n  display: grid;\n  justify-items: center;\n  gap: var(--spacing-p-xxs);\n}\n\n.mark {\n  min-height: var(--control-height-medium);\n  padding: 0 var(--spacing-p-xs);\n  border: 1px solid var(--border-neutral-solid);\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  white-space: nowrap;\n  cursor: pointer;\n  transition: var(--transition-colors), var(--transition-press);\n}\n\n.mark:hover:not(:disabled):not([aria-pressed=\"true\"]) {\n  background: var(--background-neutral-secondary);\n}\n\n.mark:active:not(:disabled) {\n  transform: scale(var(--motion-press-scale));\n}\n\n.mark[aria-pressed=\"true\"] {\n  border-color: var(--border-selected-primary);\n  background: var(--background-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n.mark:disabled {\n  cursor: default;\n}\n\n.mark:disabled:not([aria-pressed=\"true\"]) {\n  border-color: var(--border-neutral-primary);\n  color: var(--text-neutral-quaternary);\n}\n\n/* CADS Tag: Right, Wrong or Missed under each chip */\n.tag-slot {\n  display: grid;\n  justify-items: center;\n  min-height: var(--control-height-extra-small);\n}\n\n.tag-result {\n  display: inline-flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  min-height: var(--control-height-extra-small);\n  padding: 0 var(--spacing-p-xxs);\n  border: 1px solid;\n  border-radius: var(--shape-sm);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: calc(var(--control-height-extra-small) - 2px);\n}\n\n.tag-result .icon {\n  width: 1rem;\n  height: 1rem;\n  stroke-width: 3;\n}\n\n.tag-result[data-status=\"right\"] {\n  border-color: var(--border-success-mid);\n  background: var(--background-success-light);\n  color: var(--text-success-secondary);\n}\n\n.tag-result[data-status=\"wrong\"] {\n  border-color: var(--border-error-mid);\n  background: var(--background-error-light);\n  color: var(--text-error-secondary);\n}\n\n.tag-result[data-status=\"missed\"] {\n  border-color: var(--border-warning-mid);\n  background: var(--background-warning-light);\n  color: var(--text-warning-secondary);\n}\n\n/* CADS Alert: the verdict after Check */\n.verdict {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xs);\n  min-height: calc(var(--leading-body-md) * 2 + var(--spacing-p-xxs) * 2 + 2px);\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border: 1px solid transparent;\n  border-radius: var(--shape-md);\n  color: var(--text-neutral-primary);\n}\n\n.verdict[data-state=\"right\"] {\n  border-color: var(--border-success-mid);\n  background: var(--background-success-light);\n}\n\n.verdict[data-state=\"wrong\"] {\n  border-color: var(--border-error-mid);\n  background: var(--background-error-light);\n}\n\n.verdict-icon {\n  display: grid;\n  flex: none;\n  place-items: center;\n  width: 1.5rem;\n  height: 1.5rem;\n  border-radius: 50%;\n  color: var(--text-neutral-white-fixed);\n}\n\n.verdict[data-state=\"right\"] .verdict-icon {\n  background: var(--background-success-primary);\n}\n\n.verdict[data-state=\"wrong\"] .verdict-icon {\n  background: var(--background-error-primary);\n}\n\n.verdict-icon .icon {\n  width: 0.875rem;\n  height: 0.875rem;\n  stroke-width: 3;\n}\n\n.msg-actions {\n  display: flex;\n  gap: var(--spacing-p-xxs);\n}\n\n.btn:disabled {\n  background: var(--background-disabled-neutral);\n  color: var(--text-neutral-tertiary);\n  cursor: default;\n}\n\n/* ---------- Key to the three parts ---------- */\n\n.key-list {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  margin: var(--spacing-p-xs) 0 0;\n}\n\n.key-row {\n  display: grid;\n  grid-template-columns: 6.75rem minmax(0, 1fr);\n  gap: var(--spacing-p-xxs);\n  align-items: center;\n}\n\n.key-row dt {\n  display: flex;\n}\n\n.key-row dd {\n  margin: 0;\n}\n\n/* ---------- AI reply ---------- */\n\n.reply-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--spacing-p-xxs);\n}\n\n.reply-body {\n  display: grid;\n  margin-top: var(--spacing-p-xs);\n}\n\n.reply-live,\n.reply-ghost {\n  grid-area: 1 / 1;\n}\n\n.reply-text,\n.reply-fix {\n  position: relative;\n  justify-self: start;\n  max-width: 100%;\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-secondary);\n}\n\n.reply-text.muted {\n  padding-inline: 0;\n  background: transparent;\n  color: var(--text-neutral-quaternary);\n}\n\n.reply-live,\n.ghost-layer {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  align-content: start;\n}\n\n.reply-ghost {\n  display: grid;\n  visibility: hidden;\n}\n\n.ghost-layer {\n  grid-area: 1 / 1;\n}\n\n.reply-fix-intro {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.reply-steps {\n  margin: 0;\n  padding-inline-start: var(--spacing-p-s);\n}\n\n/* Something new flashes so it points back to the tap that caused it */\n.fresh::after {\n  content: \"\";\n  position: absolute;\n  inset: -2px;\n  border-radius: inherit;\n  background: var(--background-brand-mid);\n  opacity: 0;\n  pointer-events: none;\n  animation: flash 0.7s var(--easing-out);\n}\n\n@keyframes flash {\n  0% {\n    opacity: 0.7;\n  }\n\n  100% {\n    opacity: 0;\n  }\n}\n\n/* ---------- Small screens ---------- */\n\n@media (max-width: 47.99rem) {\n  .stage {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .key-row {\n    grid-template-columns: 7rem minmax(0, 1fr);\n  }\n\n  .verdict {\n    min-height: calc(var(--leading-body-md) * 3 + var(--spacing-p-xxs) * 2 + 2px);\n  }\n\n  .thread {\n    min-height: calc(var(--leading-body-md) * 5 + var(--spacing-p-xxs) * 2);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n\n  .btn:active,\n  .mark:active {\n    transform: none;\n  }\n}\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "'use strict';\n\n/* ------------------------------------------------------------------ *\n * Settings\n * ------------------------------------------------------------------ */\n\nconst CONFIG = {\n  // Which set of messages students get. Only 'interactive' (decision wheel) is written so far.\n  direction: 'interactive',\n  // Set to false to skip the intro page.\n  startWithIntro: true,\n};\n\n/* ------------------------------------------------------------------ *\n * Copy shared by every set of messages\n * ------------------------------------------------------------------ */\n\nconst COPY = {\n  errorBanner: 'Something went wrong loading this activity. Try refreshing the page.',\n\n  // The three parts of a clear bug report\n  partLabels: {\n    expected: 'Expected',\n    happened: 'Happened',\n    where: 'Where',\n  },\n  flagLabel: 'None',\n\n  messageCount: (number, total) => `Bug Report Prompt ${number} of ${total}`,\n  check: 'Check',\n  next: 'Next prompt',\n  finish: 'Finish',\n\n  // Right and wrong are always clear. Every button and the banner say which it was.\n  markStatus: {\n    right: 'Right',\n    wrong: 'Wrong',\n    missed: 'Missed',\n  },\n  correct: 'Correct!',\n  notQuite: 'Not quite.',\n  foundFull: 'You found all three details.',\n  foundAll: 'You found every detail it has.',\n  flaggedRight: 'It has none of the three details, so it is vague.',\n  looksLike: (list) => `This prompt has: ${list}.`,\n  looksLikeNone: 'This prompt has none of the three details, so it is vague.',\n\n  // The AI reply gets more helpful as a message has more parts\n  replyWaiting: 'The AI replies after you check.',\n  reply0: 'I’m not sure what you mean. What is broken?',\n  ask: {\n    expected: 'What did you expect to happen?',\n    happened: 'What happened instead?',\n    where: 'Where does it happen?',\n  },\n  thanksAsk: (questions) => `Thanks, that helps. ${questions}`,\n  reply3: 'Now I can help. Here is a fix:',\n\n  announceChecked: (verdict, reply) => `${verdict} The AI replies: ${reply}`,\n};\n\n/* ------------------------------------------------------------------ *\n * Copy for the messages (decision wheel)\n * A segment with a part is a phrase that tells the AI that part.\n * ------------------------------------------------------------------ */\n\nconst DIRECTIONS = {\n  interactive: {\n    messages: [\n      {\n        segments: [{ text: 'It’s broken!' }],\n      },\n      {\n        segments: [\n          { text: 'My page picks a place to eat with a wheel. ' },\n          { text: 'I expected it to spin.', part: 'expected' },\n          { text: ' Instead, nothing moved.', part: 'happened' },\n        ],\n      },\n      {\n        segments: [\n          { text: 'On my wheel that picks a place to eat,', part: 'where' },\n          { text: ' it lands on Pizza every time.', part: 'happened' },\n          { text: ' I expected a different place each time.', part: 'expected' },\n        ],\n        fix: [\n          'Check the code that picks the place.',\n          'Make it pick a place by chance each time.',\n        ],\n      },\n      {\n        segments: [{ text: 'It’s the Spin button on my page that picks a place to eat.', part: 'where' }],\n      },\n      {\n        segments: [{ text: 'Something is wrong with my page and I don’t know why.' }],\n      },\n      {\n        segments: [\n          { text: 'My page picks a place to eat with a wheel. ' },\n          { text: 'The result under the wheel', part: 'where' },\n          { text: ' says “undefined.”', part: 'happened' },\n        ],\n      },\n    ],\n  },\n};\n\n/* ------------------------------------------------------------------ *\n * State and constants\n * ------------------------------------------------------------------ */\n\nconst SVG_NS = 'http://www.w3.org/2000/svg';\nconst PART_ORDER = ['expected', 'happened', 'where'];\nconst MARK_ORDER = ['expected', 'happened', 'where', 'vague'];\nconst STATUS_ICONS = { right: 'icon-check', wrong: 'icon-cross', missed: 'icon-missed' };\n\nconst state = {\n  direction: CONFIG.direction,\n  index: 0,\n  marks: { expected: false, happened: false, where: false, vague: false },\n  checked: false,\n  results: [],\n  completed: false,\n};\n\nconst els = {};\nlet pendingFocus = null;\n\n/* ------------------------------------------------------------------ *\n * Helpers\n * ------------------------------------------------------------------ */\n\nfunction el(tag, className, text) {\n  const node = document.createElement(tag);\n  if (className) node.className = className;\n  if (text !== undefined) node.textContent = text;\n  return node;\n}\n\nfunction svgEl(tag, attrs) {\n  const node = document.createElementNS(SVG_NS, tag);\n  Object.keys(attrs || {}).forEach((name) => node.setAttribute(name, attrs[name]));\n  return node;\n}\n\nfunction icon(id) {\n  const svg = svgEl('svg', { class: 'icon', 'aria-hidden': 'true', focusable: 'false' });\n  svg.append(svgEl('use', { href: `#${id}` }));\n  return svg;\n}\n\nfunction direction() {\n  return DIRECTIONS[state.direction];\n}\n\nfunction messages() {\n  return direction().messages;\n}\n\nfunction currentMessage() {\n  return messages()[state.index];\n}\n\n// The parts a message really has, in report order\nfunction actualParts(message) {\n  return PART_ORDER.filter((key) => message.segments.some((segment) => segment.part === key));\n}\n\n// Compare the student's marks with what the message really has\nfunction evaluateMarks(message) {\n  const actual = actualParts(message);\n  const status = {};\n  PART_ORDER.forEach((key) => {\n    const has = actual.includes(key);\n    if (state.marks[key]) status[key] = has ? 'right' : 'wrong';\n    else status[key] = has ? 'missed' : 'none';\n  });\n  const isVague = actual.length === 0;\n  if (state.marks.vague) status.vague = isVague ? 'right' : 'wrong';\n  else status.vague = isVague ? 'missed' : 'none';\n  const match = MARK_ORDER.every((key) => status[key] === 'right' || status[key] === 'none');\n  return { actual, status, match };\n}\n\nfunction markedParts() {\n  return PART_ORDER.filter((key) => state.marks[key]);\n}\n\nfunction formatList(items) {\n  const lang = document.documentElement.lang || 'en';\n  try {\n    return new Intl.ListFormat(lang, { style: 'long', type: 'conjunction' }).format(items);\n  } catch (error) {\n    return items.join(', ');\n  }\n}\n\nfunction announce(message) {\n  els.announcer.textContent = '';\n  // A short delay makes repeated messages get read again\n  window.setTimeout(() => { els.announcer.textContent = message; }, 30);\n}\n\n/* ------------------------------------------------------------------ *\n * The message and the marks\n * ------------------------------------------------------------------ */\n\nfunction renderBubble() {\n  const message = currentMessage();\n  els.bubble.replaceChildren();\n  message.segments.forEach((segment) => {\n    if (state.checked && segment.part) {\n      const highlight = el('mark', 'hl');\n      highlight.dataset.part = segment.part;\n      highlight.append(el('span', 'hl-label', COPY.partLabels[segment.part]), document.createTextNode(` ${segment.text.trim()}`));\n      els.bubble.append(document.createTextNode(' '), highlight);\n    } else {\n      els.bubble.append(document.createTextNode(segment.text));\n    }\n  });\n}\n\nfunction renderMarks() {\n  const result = state.checked ? evaluateMarks(currentMessage()) : null;\n  els.marks.replaceChildren();\n  MARK_ORDER.forEach((key) => {\n    const label = key === 'vague' ? COPY.flagLabel : COPY.partLabels[key];\n    const status = result ? result.status[key] : 'none';\n\n    const column = el('div', 'mark-col');\n    const chip = el('button', 'mark', label);\n    chip.type = 'button';\n    chip.dataset.mark = key;\n    chip.disabled = state.checked;\n    chip.setAttribute('aria-pressed', String(state.marks[key]));\n\n    // A Tag under the chip says Right, Wrong or Missed once the message is checked\n    const tag = el('span', 'tag-slot');\n    if (status !== 'none') {\n      const resultTag = el('span', 'tag-result');\n      resultTag.dataset.status = status;\n      resultTag.append(icon(STATUS_ICONS[status]), el('span', '', COPY.markStatus[status]));\n      tag.append(resultTag);\n    }\n    column.append(chip, tag);\n    els.marks.append(column);\n  });\n}\n\nfunction toggleMark(key) {\n  if (state.checked) return;\n  const turnedOn = !state.marks[key];\n  if (key === 'vague') {\n    // Flagging as vague means no parts are marked\n    PART_ORDER.forEach((part) => { state.marks[part] = false; });\n    state.marks.vague = turnedOn;\n  } else {\n    state.marks[key] = turnedOn;\n    if (turnedOn) state.marks.vague = false;\n  }\n  pendingFocus = `mark:${key}`;\n  render();\n}\n\nfunction hasAnyMark() {\n  return state.marks.vague || markedParts().length > 0;\n}\n\nfunction checkMessage() {\n  if (state.checked || !hasAnyMark()) return;\n  const message = currentMessage();\n  const { actual, match } = evaluateMarks(message);\n\n  state.checked = true;\n  state.results.push({ message, count: actual.length, right: match });\n  pendingFocus = 'next';\n  render();\n  announce(COPY.announceChecked(verdictText(), replyText(composeReply(message))));\n}\n\n// The one-sentence verdict shown and announced after Check\nfunction verdictText() {\n  const { actual, match } = evaluateMarks(currentMessage());\n  if (match) {\n    let detail = COPY.foundAll;\n    if (actual.length === 0) detail = COPY.flaggedRight;\n    if (actual.length === PART_ORDER.length) detail = COPY.foundFull;\n    return `${COPY.correct} ${detail}`;\n  }\n  const detail = actual.length === 0\n    ? COPY.looksLikeNone\n    : COPY.looksLike(formatList(actual.map((key) => COPY.partLabels[key])));\n  return `${COPY.notQuite} ${detail}`;\n}\n\nfunction renderVerdict() {\n  els.verdict.replaceChildren();\n  if (!state.checked) {\n    els.verdict.dataset.state = 'none';\n    return;\n  }\n  const { match } = evaluateMarks(currentMessage());\n  const lead = match ? COPY.correct : COPY.notQuite;\n  els.verdict.dataset.state = match ? 'right' : 'wrong';\n  const badge = el('span', 'verdict-icon');\n  badge.append(icon(match ? 'icon-check' : 'icon-cross'));\n  const text = el('span', 'verdict-text');\n  text.append(el('strong', '', lead), document.createTextNode(` ${verdictText().slice(lead.length).trim()}`));\n  els.verdict.append(badge, text);\n}\n\nfunction nextMessage() {\n  if (state.index === messages().length - 1) {\n    // Finish leads to the takeaway screen\n    markComplete();\n    els.widget.dataset.stage = 'done';\n    els.takeaway.focus();\n    return;\n  }\n  state.index += 1;\n  state.marks = { expected: false, happened: false, where: false, vague: false };\n  state.checked = false;\n  pendingFocus = 'mark:expected';\n  render();\n  announce(`${COPY.messageCount(state.index + 1, messages().length)}. ${els.bubble.textContent}`);\n}\n\n/* ------------------------------------------------------------------ *\n * The AI reply\n * ------------------------------------------------------------------ */\n\nfunction composeReply(message) {\n  const actual = actualParts(message);\n  if (actual.length === 0) return [{ type: 'text', text: COPY.reply0 }];\n  if (actual.length === PART_ORDER.length) {\n    return [{ type: 'fix', intro: COPY.reply3, steps: message.fix }];\n  }\n  const missing = PART_ORDER.filter((key) => !actual.includes(key));\n  const questions = missing.map((key) => COPY.ask[key]).join(' ');\n  return [{ type: 'text', text: COPY.thanksAsk(questions) }];\n}\n\nfunction replyText(blocks) {\n  return blocks.map((block) => {\n    if (block.type === 'fix') return `${block.intro} ${block.steps.join(' ')}`;\n    return block.text;\n  }).join(' ');\n}\n\nfunction renderBlocks(target, blocks, fresh, muted) {\n  target.replaceChildren();\n  blocks.forEach((block) => {\n    if (block.type === 'fix') {\n      const box = el('div', fresh ? 'reply-fix fresh' : 'reply-fix');\n      const list = el('ol', 'reply-steps');\n      block.steps.forEach((step) => list.append(el('li', '', step)));\n      box.append(el('p', 'reply-fix-intro', block.intro), list);\n      target.append(box);\n    } else {\n      let className = 'reply-text';\n      if (muted) className += ' muted';\n      if (fresh) className += ' fresh';\n      target.append(el('p', className, block.text));\n    }\n  });\n}\n\nfunction renderReply() {\n  if (state.checked) {\n    renderBlocks(els.replyLive, composeReply(currentMessage()), true, false);\n  } else {\n    renderBlocks(els.replyLive, [{ type: 'text', text: COPY.replyWaiting }], false, true);\n  }\n\n  // Hidden copies of every possible reply, stacked in one cell, keep the card height steady\n  const layers = [[{ type: 'text', text: COPY.replyWaiting }]];\n  messages().forEach((message) => layers.push(composeReply(message)));\n  els.replyGhost.replaceChildren();\n  layers.forEach((blocks) => {\n    const layer = el('div', 'ghost-layer');\n    renderBlocks(layer, blocks, false, false);\n    els.replyGhost.append(layer);\n  });\n}\n\n/* ------------------------------------------------------------------ *\n * Whole-widget render\n * ------------------------------------------------------------------ */\n\nfunction renderProgress() {\n  const total = messages().length;\n  els.msgTitle.textContent = COPY.messageCount(state.index + 1, total);\n  els.msgDots.replaceChildren();\n  for (let i = 0; i < total; i += 1) {\n    const result = state.results[i];\n    const dot = el('span', 'round-dot');\n    if (result) dot.dataset.result = result.right ? 'right' : 'wrong';\n    if (i === state.index) {\n      // The current message is the large bubble with its number\n      dot.classList.add('current');\n      dot.textContent = String(i + 1);\n    }\n    els.msgDots.append(dot);\n  }\n}\n\nfunction render() {\n  const lastMessage = state.index === messages().length - 1;\n\n  els.widget.dataset.checked = String(state.checked);\n\n  renderProgress();\n  renderBubble();\n  renderMarks();\n  renderVerdict();\n\n  els.check.hidden = state.checked;\n  els.check.disabled = !hasAnyMark();\n  els.next.hidden = !state.checked;\n  els.next.textContent = lastMessage ? COPY.finish : COPY.next;\n\n  renderReply();\n\n  if (pendingFocus) {\n    const spec = pendingFocus.split(':');\n    pendingFocus = null;\n    let target = null;\n    if (spec[0] === 'next') target = els.next;\n    if (spec[0] === 'mark') target = els.marks.querySelector(`[data-mark=\"${spec[1]}\"]`);\n    if (target && !target.hidden && !target.disabled) target.focus();\n  }\n}\n\nfunction markComplete() {\n  if (state.completed) return;\n  state.completed = true;\n  // Completion is the only thing recorded. Hook this up to the level's completion call.\n  try {\n    document.dispatchEvent(new CustomEvent('widget:complete'));\n    if (window.parent && window.parent !== window) {\n      window.parent.postMessage({ type: 'widget-complete' }, '*');\n    }\n  } catch (error) {\n    // Completion is best effort and must never break the activity\n  }\n}\n\n/* ------------------------------------------------------------------ *\n * Start up\n * ------------------------------------------------------------------ */\n\nfunction cacheElements() {\n  const ids = {\n    widget: 'widget',\n    errorBanner: 'error-banner',\n    announcer: 'announcer',\n    introStart: 'intro-start',\n    msgTitle: 'msg-title',\n    msgDots: 'msg-dots',\n    bubble: 'bubble',\n    marks: 'marks',\n    verdict: 'verdict',\n    check: 'check',\n    next: 'next',\n    replyLive: 'reply-live',\n    replyGhost: 'reply-ghost',\n    takeaway: 'takeaway',\n  };\n  Object.keys(ids).forEach((name) => {\n    els[name] = document.getElementById(ids[name]);\n    if (!els[name]) throw new Error(`Missing element: ${ids[name]}`);\n  });\n}\n\nfunction startPractice() {\n  els.widget.dataset.stage = 'practice';\n  const first = els.marks.querySelector('.mark');\n  if (first) first.focus();\n}\n\nfunction bindEvents() {\n  els.marks.addEventListener('click', (event) => {\n    const button = event.target.closest('.mark');\n    if (button) toggleMark(button.dataset.mark);\n  });\n  els.check.addEventListener('click', checkMessage);\n  els.next.addEventListener('click', nextMessage);\n  els.introStart.addEventListener('click', startPractice);\n}\n\nfunction init() {\n  try {\n    cacheElements();\n    bindEvents();\n    render();\n    els.widget.dataset.stage = CONFIG.startWithIntro ? 'intro' : 'practice';\n  } catch (error) {\n    const banner = document.getElementById('error-banner');\n    if (banner) {\n      banner.textContent = COPY.errorBanner;\n      banner.hidden = false;\n    }\n  }\n}\n\ninit();\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Bug report builder</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <svg class=\"sprite\" aria-hidden=\"true\" focusable=\"false\">\n    <symbol id=\"icon-check\" viewBox=\"0 0 24 24\">\n      <path d=\"M5 12.5l4.5 4.5L19 7.5\"/>\n    </symbol>\n    <symbol id=\"icon-cross\" viewBox=\"0 0 24 24\">\n      <path d=\"M6 6l12 12M18 6L6 18\"/>\n    </symbol>\n    <symbol id=\"icon-missed\" viewBox=\"0 0 24 24\">\n      <circle cx=\"12\" cy=\"12\" r=\"9\"/>\n      <path d=\"M8 12h8\"/>\n    </symbol>\n  </svg>\n\n  <main class=\"widget\" id=\"widget\" data-stage=\"intro\">\n    <h1 class=\"visually-hidden\">Bug report builder</h1>\n\n    <p class=\"error-banner\" id=\"error-banner\" role=\"alert\" hidden></p>\n    <p class=\"visually-hidden\" id=\"announcer\" aria-live=\"polite\"></p>\n\n    <section class=\"intro-page\" id=\"intro-page\" aria-labelledby=\"intro-title\">\n      <p><span class=\"tag\">Practice</span></p>\n      <h2 class=\"intro-title\" id=\"intro-title\">Build a clear bug report prompt</h2>\n      <p class=\"intro-lead\">A <strong>bug report prompt</strong> is a note that tells AI what’s broken so it can give you a better fix.</p>\n      <ol class=\"intro-list\">\n        <li>Read each prompt.</li>\n        <li>Tap the details it has. If it has none, tap None.</li>\n        <li>Check to see if you were right.</li>\n      </ol>\n      <button class=\"btn btn-contained\" id=\"intro-start\" type=\"button\">Start</button>\n    </section>\n\n    <header class=\"intro\">\n      <p class=\"intro-steps\"><span class=\"tag\">Practice</span><strong>Do This:</strong> Read each prompt. Tap the details it has. If it has none, tap None. Then tap Check.</p>\n    </header>\n\n    <section class=\"practice\" id=\"practice\" aria-label=\"Practice\">\n      <div class=\"stage\" id=\"stage\">\n\n        <section class=\"card msg-card\" id=\"msg-card\" aria-labelledby=\"msg-title\">\n          <div class=\"msg-head\">\n            <h2 id=\"msg-title\"></h2>\n            <span class=\"msg-dots\" id=\"msg-dots\" aria-hidden=\"true\"></span>\n          </div>\n\n          <div class=\"thread\"><p class=\"bubble\" id=\"bubble\"></p></div>\n\n          <div class=\"marks-wrap\" role=\"group\" aria-labelledby=\"marks-label\">\n            <p class=\"marks-label\" id=\"marks-label\">Which bug report details are included in this prompt?</p>\n            <div class=\"marks\" id=\"marks\"></div>\n          </div>\n\n          <p class=\"verdict\" id=\"verdict\" data-state=\"none\"></p>\n\n          <div class=\"msg-actions\">\n            <button class=\"btn btn-contained\" id=\"check\" type=\"button\" disabled>Check</button>\n            <button class=\"btn btn-contained\" id=\"next\" type=\"button\" hidden></button>\n          </div>\n        </section>\n\n        <div class=\"stage-right\" id=\"stage-right\">\n          <section class=\"card\" id=\"reply-card\" aria-labelledby=\"reply-title\">\n            <div class=\"reply-head\">\n              <h2 id=\"reply-title\">AI reply</h2>\n            </div>\n            <div class=\"reply-body\">\n              <div class=\"reply-live\" id=\"reply-live\"></div>\n              <div class=\"reply-ghost\" id=\"reply-ghost\" aria-hidden=\"true\"></div>\n            </div>\n          </section>\n          <section class=\"card\" aria-labelledby=\"key-title\">\n            <h2 id=\"key-title\">Bug Report Details</h2>\n            <dl class=\"key-list\">\n              <div class=\"key-row\">\n                <dt><span class=\"part-tag\" data-part=\"expected\">Expected</span></dt>\n                <dd>What should happen</dd>\n              </div>\n              <div class=\"key-row\">\n                <dt><span class=\"part-tag\" data-part=\"happened\">Happened</span></dt>\n                <dd>What you saw instead</dd>\n              </div>\n              <div class=\"key-row\">\n                <dt><span class=\"part-tag\" data-part=\"where\">Where</span></dt>\n                <dd>The part of the page</dd>\n              </div>\n            </dl>\n          </section>\n        </div>\n\n      </div>\n    </section>\n\n    <section class=\"takeaway-page\" id=\"takeaway\" aria-labelledby=\"takeaway-title\" tabindex=\"-1\">\n      <h2 class=\"intro-title\" id=\"takeaway-title\">Takeaway: AI needs a detailed bug report prompt</h2>\n      <p class=\"intro-lead\">A clear bug report prompt tells the AI what you expected, what happened, and where. The more details you give it, the closer it gets to a fix.</p>\n      <p class=\"takeaway-parts\">\n        <span class=\"part-tag\" data-part=\"expected\">Expected</span>\n        <span class=\"part-tag\" data-part=\"happened\">Happened</span>\n        <span class=\"part-tag\" data-part=\"where\">Where</span>\n      </p>\n      <p class=\"takeaway-next\"><strong>Press Continue to go to your project.</strong></p>\n    </section>\n  </main>\n</body>\n</html>\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
