      "files": {
        "219ee1a0-303d-4d4a-acde-a272cfb4151a": {
          "id": "219ee1a0-303d-4d4a-acde-a272cfb4151a",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Sample Broken Page</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <h1>Discover the Mysteries!</h1>\n    <p id=\"mysteryText\">This text holds a secret. Click the button to reveal it!</p>\n    <button id=\"revealButton\">Reveal Secret</button>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "0597f7ca-9bf0-4529-8374-6ffdc9245a69": {
          "id": "0597f7ca-9bf0-4529-8374-6ffdc9245a69",
          "name": "style.css",
          "contents": "body {\n    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n    text-align: center;\n    margin-top: 50px;\n    background-color: #f4f4f4;\n    color: #333;\n}\nh1 {\n    color: #0056b3;\n}\np {\n    margin-top: 20px;\n    font-size: 1.2em;\n    color: #cc0000; /* Intentionally red to hint at a problem */\n}\nbutton {\n    background-color: #007bff;\n    color: white;\n    padding: 10px 20px;\n    border: none;\n    border-radius: 5px;\n    font-size: 1em;\n    cursor: pointer;\n    margin-top: 30px;\n}\nbutton:hover {\n    background-color: #0056b3;\n}",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "1e7ef55b-8d9d-4712-8e61-72d3de1d53d8": {
          "id": "1e7ef55b-8d9d-4712-8e61-72d3de1d53d8",
          "name": "script.js",
          "contents": "document.getElementById('revealButton').addEventListener('click', function() {\n    // This script tries to find an element with ID 'secretMessage',\n    // but in index.html, the ID is 'mysteryText'. This is the bug!\n    const messageElement = document.getElementById('secretMessage');\n    if (messageElement) {\n        messageElement.textContent = 'The secret is... AI helps you build amazing things!';\n        messageElement.style.color = '#008000'; // Green for revealed secret\n    } else {\n        console.error('Bug detected: Target element for message not found. Expected: secretMessage, Found: mysteryText');\n    }\n});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
