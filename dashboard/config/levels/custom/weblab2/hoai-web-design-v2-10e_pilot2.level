    "display_name": "Exploring Spacing",
    "bubble_choice_description": "Learn the rules for how to add space around and within elements",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <style>\n      header {\n        margin: 20px;\n        padding: 10px;\n        background-color: #e8f4f8;\n        border-radius: 10px;\n      }\n    </style>\n  </head>\n  <body>\n    <header>\n      <h1>My Contacts</h1>\n      <p>Here are some important people to know. Each card below has their name, role, and how to reach them.</p>\n    </header>\n\n    <section>\n      <h2>Ms. Rivera</h2>\n      <p>Role: School Counselor</p>\n      <p>Email: rivera@westview.edu</p>\n      <p>Office: Room 104</p>\n    </section>\n\n    <section>\n      <h2>Mr. Okafor</h2>\n      <p>Role: Web Design Teacher</p>\n      <p>Email: okafor@westview.edu</p>\n      <p>Office: Room 212</p>\n    </section>\n\n    <section>\n      <h2>Dr. Patel</h2>\n      <p>Role: Principal</p>\n      <p>Email: patel@westview.edu</p>\n      <p>Office: Main Building</p>\n    </section>\n\n  </body>\n</html>",
          "active": true,
