          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html>\n  <body>\n    <p>This page is waiting for your vision!</p>\n    <p>Describe the website you want in the AI Tutor chat, and watch it appear here.</p>\n  </body>\n</html>\n",
          "active": true,
