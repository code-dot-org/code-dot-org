      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Web Lab: The Safe Fetch</title>\n    <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n\n    <div class=\"app-container\">\n        <div class=\"status-box\">Status: <span id=\"status\">IDLE</span></div>\n        \n        <div class=\"card\">\n            <h1>Boredom Buster</h1>\n            <p id=\"activity-text\">Ready to find an activity?</p>\n            <button id=\"fetch-btn\">Run Code</button>\n        </div>\n\n        <div id=\"dom-console\">\n            <div class=\"console-header\">System Console</div>\n            <div id=\"console-output\"></div>\n        </div>\n    </div>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "styles.css",
          "language": "css",
          "contents": "body {\n    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n    background: #f0f2f5;\n    display: flex;\n    justify-content: center;\n    padding: 40px;\n}\n\n.app-container {\n    width: 400px;\n    background: white;\n    padding: 25px;\n    border-radius: 12px;\n    box-shadow: 0 4px 15px rgba(0,0,0,0.1);\n    text-align: center;\n}\n\n.status-box {\n    font-size: 0.8rem;\n    color: #666;\n    margin-bottom: 10px;\n    border-bottom: 1px solid #eee;\n    padding-bottom: 5px;\n    text-transform: uppercase;\n    letter-spacing: 1px;\n}\n\n#status {\n    font-weight: bold;\n    color: #007bff;\n}\n\n.card h1 {\n    font-size: 1.5rem;\n    color: #333;\n}\n\n#activity-text {\n    margin: 20px 0;\n    color: #555;\n    min-height: 40px;\n}\n\nbutton {\n    background: #007bff;\n    color: white;\n    border: none;\n    padding: 12px 24px;\n    border-radius: 6px;\n    cursor: pointer;\n    font-weight: bold;\n    font-size: 1rem;\n}\n\nbutton:hover {\n    background: #0056b3;\n}\n\n/* Simulated Console */\n#dom-console {\n    background: #1e1e1e;\n    color: #d4d4d4;\n    border-radius: 6px;\n    text-align: left;\n    font-family: 'Courier New', monospace;\n    overflow: hidden;\n    margin-top: 25px;\n}\n\n.console-header {\n    background: #333;\n    color: #888;\n    padding: 6px 12px;\n    font-size: 11px;\n}\n\n#console-output {\n    padding: 12px;\n    min-height: 80px;\n    font-size: 13px;\n    line-height: 1.5;\n}\n\n.error-text {\n    color: #ff5f56;\n    font-weight: bold;\n}\n\n.caught-text {\n    color: #ffbd2e;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const btn = document.getElementById(\"fetch-btn\");\nconst display = document.getElementById(\"activity-text\");\nconst status = document.getElementById(\"status\");\nconst consoleOutput = document.getElementById(\"console-output\");\n\n// This listener simulates the \"Big Red Error\" in the browser\nwindow.addEventListener('unhandledrejection', function (event) {\n    const p = document.createElement(\"p\");\n    p.className = \"error-text\";\n    p.innerText = \"❌ Uncaught (in promise) TypeError: Failed to fetch\";\n    consoleOutput.appendChild(p);\n});\n\nbtn.addEventListener(\"click\", async () => {\n    // Reset UI\n    consoleOutput.innerHTML = \"\";\n    status.innerText = \"FETCHING...\";\n    \n    // The Broken URL\n    const response = await fetch(\"https://www.boredapi.com/api/activity\");\n    \n    // If the previous line fails, the function stops immediately\n    const data = await response.json();\n\n    // These lines are never reached \n    display.innerText = data.activity;\n    status.innerText = \"COMPLETE!\";\n});",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "3"
      ]
    },
