      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Cargo Loader Challenge</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <div class=\"dashboard\">\n    <h2>🚀 Cargo Bay Controls</h2>\n    \n    <div id=\"status-screen\">\n      <p>Status: <span id=\"status-text\">Ready to Load</span></p>\n      <p>Current Weight: <span id=\"weight-display\">0</span> / 500 kg</p>\n      <hr>\n      <ul id=\"log-list\">\n        </ul>\n    </div>\n\n    <button id=\"start-loading-btn\">Start Loading Sequence</button>\n  </div>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// Incoming cargo crates (weights in kg)\nconst cargoQueue = [50, 120, 80, 200, 40, 90, 150, 60];\nconst maxCapacity = 500;\n\n// DOM Elements\nconst startBtn = document.querySelector(\"#start-loading-btn\");\nconst weightDisplay = document.querySelector(\"#weight-display\");\nconst logList = document.querySelector(\"#log-list\");\nconst statusText = document.querySelector(\"#status-text\");\n\nstartBtn.addEventListener(\"click\", () => {\n  // Reset state\n  logList.innerHTML = \"\";\n  let currentWeight = 0;\n  let i = 0; // index for the cargoQueue array\n\n  // Write a while loop below.\n\n\n  \n  // Update Screen after loop\n  weightDisplay.textContent = currentWeight;\n  statusText.textContent = \"Loading Complete\";\n});",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "/* Space Dashboard Theme */\n:root {\n  --bg-color: #121212;\n  --panel-color: #1e1e24;\n  --accent-color: #00d4ff; /* Cyan */\n  --alert-color: #ff4757;\n  --text-color: #ffffff;\n  --screen-bg: #000000;\n  --screen-text: #33ff00; /* Retro terminal green */\n}\n\nbody {\n  font-family: 'Courier New', Courier, monospace;\n  background-color: var(--bg-color);\n  color: var(--text-color);\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  height: 100vh;\n  margin: 0;\n}\n\n.dashboard {\n  background-color: var(--panel-color);\n  padding: 20px;\n  border: 2px solid var(--accent-color);\n  border-radius: 10px;\n  width: 400px;\n  box-shadow: 0 0 15px rgba(0, 212, 255, 0.3);\n}\n\nh2 {\n  text-align: center;\n  color: var(--accent-color);\n  margin-top: 0;\n}\n\n#status-screen {\n  background-color: var(--screen-bg);\n  color: var(--screen-text);\n  padding: 15px;\n  border-radius: 5px;\n  border: 1px solid #333;\n  font-family: 'Consolas', monospace;\n  margin-bottom: 20px;\n  min-height: 150px;\n}\n\n#log-list {\n  list-style-type: none;\n  padding: 0;\n  margin: 0;\n  font-size: 0.9rem;\n  max-height: 100px;\n  overflow-y: auto;\n}\n\n#log-list li {\n  margin-bottom: 5px;\n  border-bottom: 1px dashed #333;\n}\n\nbutton {\n  width: 100%;\n  padding: 12px;\n  background-color: var(--accent-color);\n  color: #000;\n  border: none;\n  border-radius: 5px;\n  font-weight: bold;\n  cursor: pointer;\n  font-size: 1rem;\n  transition: background 0.2s;\n}\n\nbutton:hover {\n  background-color: #fff;\n}",
          "folderId": "0",
          "active": false
        }
