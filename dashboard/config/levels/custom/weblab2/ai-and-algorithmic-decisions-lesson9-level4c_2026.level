      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Team Portal | Windy City Cyclones</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n    <nav class=\"top-nav\">\n        <div class=\"nav-brand\">Sports Club</div>\n        <div class=\"nav-links\">\n            <span class=\"active\">Home</span>\n            <span>Roster</span>\n            <span>Schedule</span>\n        </div>\n        <div class=\"user-profile\">S</div>\n    </nav>\n\n    <main class=\"app-container\">\n        <header class=\"hero-section\">\n            <div class=\"hero-overlay\">\n                <div class=\"logo-circle\">\n                    <img src=\"cyclone.png\" alt=\"Cyclones Logo\">\n                </div>\n                <h1 class=\"team-title\">Windy City Cyclones</h1>\n            </div>\n        </header>\n\n        <section class=\"content-body\">\n            <h2 class=\"section-label\">MEMBERSHIP STATUS</h2>\n            \n            <div class=\"status-card\" id=\"statusCard\">\n                <div class=\"status-icon\" id=\"statusIcon\">📋</div>\n                <div class=\"status-info\">\n                    <h3 id=\"statusTitle\">Checking Eligibility...</h3>\n                    <p id=\"statusMessage\">Updating records from the Logic Lab.</p>\n                </div>\n            </div>\n\n            <h2 class=\"section-label\">ANNOUNCEMENTS</h2>\n            <div class=\"announcement-card\">\n                <span class=\"date-tag\">JANUARY 13, 2026</span>\n                <h4>Season Tryouts</h4>\n                <p>Ensure all eligibility requirements are met before Friday's deadline.</p>\n            </div>\n        </section>\n    </main>\n\n    <div class=\"logic-lab\" id=\"logicLabPanel\">\n        <div class=\"lab-header\">\n            <h3>🛠 Logic Lab</h3>\n            <button id=\"toggleLabMinimize\" class=\"minimize-btn\">−</button>\n        </div>\n        \n        <div class=\"lab-content\">\n            <div class=\"control-row\">\n                <label>meetsGradeRequirement</label>\n                <button id=\"btnGrade\" class=\"toggle-btn\">FALSE</button>\n            </div>\n\n            <div class=\"control-row\">\n                <label>meetsAttendanceRequirement</label>\n                <button id=\"btnAttendance\" class=\"toggle-btn\">FALSE</button>\n            </div>\n\n            <div class=\"outcome-box\">\n                <strong>Logical Output:</strong>\n                <div id=\"logicStatus\">Awaiting Data...</div>\n            </div>\n        </div>\n    </div>\n\n    <script src=\"script.js\"></script>\n    <script src=\"lab-overlay.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": ":root {\n    --primary: #5856d6;\n    --bg-light: #f2f2f7;\n    --card-bg: #ffffff;\n    --text-main: #1c1c1e;\n    --text-muted: #8e8e93;\n    --success: #34c759;\n    --danger: #ff3b30;\n    --nav-bg: #24292e;\n}\n\n* { box-sizing: border-box; margin: 0; padding: 0; }\n\nbody {\n    font-family: -apple-system, system-ui, sans-serif;\n    background-color: var(--bg-light);\n    color: var(--text-main);\n}\n\n.top-nav {\n    height: 50px; background: var(--nav-bg); color: white;\n    display: flex; align-items: center; justify-content: space-between;\n    padding: 0 20px; position: sticky; top: 0; z-index: 100;\n}\n\n.user-profile { width: 28px; height: 28px; background: #4cd964; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold; }\n\n/* HERO SECTION - REPAIRED */\n.hero-section {\n    height: 320px;\n    background-image: url('baseball-field.jpg');\n    background-size: cover;\n    background-position: center;\n    position: relative;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n}\n\n.hero-overlay {\n    width: 100%; height: 100%;\n    background: rgba(0,0,0,0.25);\n    display: flex; flex-direction: column; align-items: center; justify-content: center;\n}\n\n.logo-circle {\n    width: 110px; height: 110px; background: white; border-radius: 50%;\n    display: flex; align-items: center; justify-content: center;\n    box-shadow: 0 8px 24px rgba(0,0,0,0.3); margin-bottom: 15px;\n}\n\n.logo-circle img { width: 85px; height: auto; }\n\n.team-title { color: white; text-shadow: 0 2px 10px rgba(0,0,0,0.8); font-size: 32px; font-weight: 800; }\n\n/* APP CONTENT */\n.app-container { max-width: 600px; margin: 0 auto; padding-bottom: 100px; }\n.content-body { padding: 25px 20px; }\n.section-label { font-size: 12px; color: var(--text-muted); font-weight: 700; margin-bottom: 15px; letter-spacing: 0.5px; }\n\n.status-card, .announcement-card {\n    background: white; border-radius: 16px; padding: 20px;\n    box-shadow: 0 4px 15px rgba(0,0,0,0.06); margin-bottom: 25px;\n}\n\n.status-card { display: flex; align-items: center; gap: 20px; }\n.status-icon { font-size: 32px; width: 60px; height: 60px; background: #f0f0f5; border-radius: 12px; display: flex; align-items: center; justify-content: center; }\n\n/* FLOATING OVERLAY LOGIC LAB */\n.logic-lab {\n    position: fixed; bottom: 20px; right: 20px; width: 340px;\n    background: #1c1c1e; color: white; border-radius: 16px;\n    box-shadow: 0 12px 40px rgba(0,0,0,0.6); z-index: 2000;\n    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);\n    border: 1px solid #333;\n}\n\n.logic-lab.minimized { transform: translateY(calc(100% - 60px)); }\n\n.lab-header { padding: 15px 20px; border-bottom: 1px solid #333; display: flex; justify-content: space-between; align-items: center; }\n.lab-content { padding: 20px; }\n.minimize-btn { background: none; border: none; color: white; font-size: 24px; cursor: pointer; }\n\n.control-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }\n.toggle-btn { width: 80px; padding: 6px; border-radius: 20px; border: none; background: var(--danger); color: white; font-weight: bold; cursor: pointer; }\n.toggle-btn.active { background: var(--success); }\n\n.outcome-box { border-top: 1px solid #333; margin-top: 15px; padding-top: 15px; }\n#logicStatus { color: #0a84ff; font-family: monospace; font-weight: bold; margin-top: 5px; }",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "// State Variables\nlet meetsGradeRequirement = false;\nlet meetsAttendanceRequirement = false;\n\n// DOM References\nconst statusTitle = document.getElementById(\"statusTitle\");\nconst statusMessage = document.getElementById(\"statusMessage\");\nconst statusIcon = document.getElementById(\"statusIcon\");\n\n// Function to update the eligibility logic\n\n\n\n\n\n\n\n\n\n\n\nupdateAppUI();",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
          "name": "lab-overlay.js",
          "contents": "const labPanel = document.getElementById('logicLabPanel');\nconst minBtn = document.getElementById('toggleLabMinimize');\nconst gradeBtn = document.getElementById('btnGrade');\nconst attendBtn = document.getElementById('btnAttendance');\nconst labText = document.getElementById('logicStatus');\n\nminBtn.addEventListener('click', () => {\n    labPanel.classList.toggle('minimized');\n    minBtn.innerText = labPanel.classList.contains('minimized') ? '+' : '−';\n});\n\ngradeBtn.addEventListener('click', () => {\n    meetsGradeRequirement = !meetsGradeRequirement;\n    gradeBtn.innerText = meetsGradeRequirement ? \"TRUE\" : \"FALSE\";\n    gradeBtn.classList.toggle('active', meetsGradeRequirement);\n    sync();\n});\n\nattendBtn.addEventListener('click', () => {\n    meetsAttendanceRequirement = !meetsAttendanceRequirement;\n    attendBtn.innerText = meetsAttendanceRequirement ? \"TRUE\" : \"FALSE\";\n    attendBtn.classList.toggle('active', meetsAttendanceRequirement);\n    sync();\n});\n\nfunction sync() {\n    updateAppUI();\n    labText.innerText = `grade(${meetsGradeRequirement}) && attend(${meetsAttendanceRequirement})`;\n}\n\nsync();",
          "folderId": "0",
          "active": false
        },
