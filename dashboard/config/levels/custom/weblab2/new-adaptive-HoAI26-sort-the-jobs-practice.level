<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-11-03T03:29:55.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": true,
    "start_sources": {
      "folders": {
      },
      "files": {
        "37521b59-d238-44f2-a594-313faabfe871": {
          "id": "37521b59-d238-44f2-a594-313faabfe871",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Sort the Jobs: Practice</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <h1>Sort the Jobs: Structure, Style, Behavior</h1>\n    <p>Click on different parts of the profile card below to see their main job: structure, style, or behavior.</p>\n\n    <div class=\"profile-card\" id=\"profileCard\">\n        <img src=\"https://via.placeholder.com/100\" alt=\"Profile Picture\" class=\"profile-pic\" id=\"profilePic\">\n        <h2 id=\"profileName\">Codey McCoderface</h2>\n        <p class=\"profile-bio\" id=\"profileBio\">Web developer passionate about creating interactive and beautiful experiences. Loves debugging and learning new frameworks.</p>\n        <div class=\"social-info\">\n            <span id=\"followerCount\">500</span> followers\n        </div>\n        <button class=\"action-button\" id=\"followButton\">Follow</button>\n        <button class=\"action-button\" id=\"messageButton\">Message</button>\n    </div>\n\n    <div class=\"info-box\">\n        <h2>Selected Element Job:</h2>\n        <p><strong>Part:</strong> <span id=\"elementName\">Click an element</span></p>\n        <p><strong>Job:</strong> <span id=\"elementJob\">To see its job (structure, style, behavior).</span></p>\n        <p><strong>Explanation:</strong> <span id=\"elementExplanation\"></span></p>\n    </div>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>\n",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "f1aa3848-691f-4d2e-8acb-37f78b6f64d5": {
          "id": "f1aa3848-691f-4d2e-8acb-37f78b6f64d5",
          "name": "style.css",
          "contents": "body {\n    font-family: Arial, sans-serif;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    min-height: 100vh;\n    background-color: #f0f2f5;\n    color: #333;\n    margin: 0;\n    padding: 20px;\n    box-sizing: border-box;\n}\n\nh1 {\n    color: #0056b3;\n    margin-bottom: 10px;\n}\n\np {\n    margin-bottom: 25px;\n    text-align: center;\n    max-width: 600px;\n}\n\n.profile-card {\n    background-color: #fff;\n    padding: 30px;\n    border-radius: 12px;\n    box-shadow: 0 4px 15px rgba(0,0,0,0.1);\n    margin-bottom: 30px;\n    width: 90%;\n    max-width: 350px;\n    text-align: center;\n    cursor: pointer; /* Make the whole card clickable for structural info */\n    transition: transform 0.2s ease;\n    border: 1px solid #ddd;\n}\n\n.profile-card:hover {\n    transform: translateY(-5px);\n}\n\n.profile-pic {\n    width: 100px;\n    height: 100px;\n    border-radius: 50%;\n    object-fit: cover;\n    margin-bottom: 15px;\n    border: 3px solid #007bff;\n    box-shadow: 0 2px 8px rgba(0,0,0,0.1);\n    cursor: pointer;\n}\n\nh2 {\n    color: #333;\n    font-size: 1.8em;\n    margin-bottom: 10px;\n    cursor: pointer;\n}\n\n.profile-bio {\n    font-size: 0.95em;\n    color: #666;\n    line-height: 1.5;\n    margin-bottom: 20px;\n    cursor: pointer;\n}\n\n.social-info {\n    font-size: 1.1em;\n    color: #555;\n    margin-bottom: 20px;\n    cursor: pointer;\n}\n\n#followerCount {\n    font-weight: bold;\n    color: #007bff;\n}\n\n.action-button {\n    background-color: #007bff;\n    color: white;\n    padding: 10px 20px;\n    border: none;\n    border-radius: 25px;\n    font-size: 1em;\n    cursor: pointer;\n    margin: 5px;\n    transition: background-color 0.3s ease, transform 0.2s ease;\n}\n\n.action-button:hover {\n    background-color: #0056b3;\n    transform: translateY(-2px);\n}\n\n#messageButton {\n    background-color: #28a745;\n}\n\n#messageButton:hover {\n    background-color: #218838;\n}\n\n.info-box {\n    background-color: #e2f0fb;\n    border: 1px solid #a8d5f7;\n    padding: 20px;\n    border-radius: 8px;\n    width: 90%;\n    max-width: 400px;\n    box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n    margin-top: 20px;\n}\n\n.info-box h2 {\n    color: #007bff;\n    margin-top: 0;\n    margin-bottom: 15px;\n    border-bottom: 1px solid #a8d5f7;\n    padding-bottom: 10px;\n    text-align: center;\n}\n\n.info-box p {\n    text-align: left;\n    margin-bottom: 10px;\n    font-size: 1em;\n}\n\n.info-box strong {\n    color: #0056b3;\n}\n",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "0f106700-1359-4a79-881d-6bfdb8c7ccb0": {
          "id": "0f106700-1359-4a79-881d-6bfdb8c7ccb0",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const profileCard = document.getElementById('profileCard');\n    const profilePic = document.getElementById('profilePic');\n    const profileName = document.getElementById('profileName');\n    const profileBio = document.getElementById('profileBio');\n    const followerCountSpan = document.getElementById('followerCount');\n    const followButton = document.getElementById('followButton');\n    const messageButton = document.getElementById('messageButton');\n    const socialInfo = document.querySelector('.social-info');\n\n    const elementNameSpan = document.getElementById('elementName');\n    const elementJobSpan = document.getElementById('elementJob');\n    const elementExplanationSpan = document.getElementById('elementExplanation');\n\n    let followerCount = 500;\n\n    function updateInfo(name, job, explanation) {\n        elementNameSpan.textContent = name;\n        elementJobSpan.textContent = job;\n        elementExplanationSpan.textContent = explanation;\n    }\n\n    profileCard.addEventListener('click', (event) => {\n        // Only update if the click is directly on the card or not a child with its own listener\n        if (event.target === profileCard) {\n            updateInfo(\n                \"Profile Card Container\", \n                \"Structure\", \n                \"Organizes and groups related content together on the page.\"\n            );\n        }\n    });\n\n    profilePic.addEventListener('click', () => {\n        updateInfo(\n            \"Profile Picture\", \n            \"Structure & Style\", \n            \"Holds an image (structure) and its shape/border (style) influences how it looks.\"\n        );\n    });\n\n    profileName.addEventListener('click', () => {\n        updateInfo(\n            \"Profile Name (H2)\", \n            \"Structure & Style\", \n            \"Defines a main heading for the card (structure). Its font size and color (style) make it stand out.\"\n        );\n    });\n\n    profileBio.addEventListener('click', () => {\n        updateInfo(\n            \"Profile Biography (Paragraph)\", \n            \"Structure\", \n            \"Contains the descriptive text content of the profile.\"\n        );\n    });\n\n    socialInfo.addEventListener('click', () => {\n        updateInfo(\n            \"Follower Count Area\", \n            \"Structure & Style\", \n            \"Groups the follower count text (structure). Its font weight and color (style) draw attention.\"\n        );\n    });\n\n    followButton.addEventListener('click', () => {\n        followerCount++;\n        followerCountSpan.textContent = followerCount;\n        updateInfo(\n            \"Follow Button\", \n            \"Behavior\", \n            \"Changes the follower count when clicked, showing user interaction.\"\n        );\n    });\n\n    messageButton.addEventListener('click', () => {\n        alert('Sending message to Codey!');\n        updateInfo(\n            \"Message Button\", \n            \"Behavior\", \n            \"Triggers an action (like showing an alert) when clicked.\"\n        );\n    });\n\n    // Initialize with a default message\n    updateInfo(\n        \"Click an element\", \n        \"To see its job (structure, style, behavior).\", \n        \"Each part of a web page has a main job: defining content arrangement (structure), how it looks (style), or what it does (behavior).\"\n    );\n});\n",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
        "37521b59-d238-44f2-a594-313faabfe871",
        "f1aa3848-691f-4d2e-8acb-37f78b6f64d5",
        "0f106700-1359-4a79-881d-6bfdb8c7ccb0"
      ]
    },
    "long_instructions": "TODOs:\r\n- Open index.html to view the sample profile card page.\r\n- Click on different elements within the profile card, like the image, name, biography, and buttons.\r\n- Observe the 'Job' description in the info box to see if it's classified as structure, style, or behavior.\r\n- Read the 'Explanation' to understand why each part has that job.\r\n- Practice distinguishing between elements that define content (structure), how it looks (style), and what it does (behavior).",
