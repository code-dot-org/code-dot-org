      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Snack Picks</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <main class=\"app\">\n      <header class=\"app-header\">\n        <p class=\"eyebrow\">Movie Night</p>\n        <h1>Snack Picks</h1>\n        <p class=\"subtitle\">Choose your favorites for the night.</p>\n      </header>\n\n      <section class=\"deals-section\">\n        <h2>Available Snacks</h2>\n        <div id=\"snackContainer\" class=\"deal-container\"></div>\n      </section>\n    </main>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  font-family: Inter, Arial, sans-serif;\n  background: #f3f4f6;\n  color: #1f2937;\n}\n\n.app {\n  max-width: 480px;\n  margin: 0 auto;\n  min-height: 100vh;\n  background: #ffffff;\n}\n\n.app-header {\n  padding: 24px 20px 16px;\n  border-bottom: 1px solid #e5e7eb;\n}\n\n.eyebrow {\n  margin: 0 0 4px;\n  font-size: 0.8rem;\n  text-transform: uppercase;\n  color: #6b7280;\n}\n\n.app-header h1 {\n  margin: 0;\n  font-size: 1.8rem;\n  font-weight: 700;\n}\n\n.subtitle {\n  margin: 6px 0 0;\n  font-size: 0.95rem;\n  color: #6b7280;\n}\n\n.deals-section {\n  padding: 20px;\n}\n\n.deals-section h2 {\n  margin: 0 0 12px;\n  font-size: 1.1rem;\n  font-weight: 700;\n}\n\n.deal-container {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n.deal-card {\n  border-radius: 16px;\n  overflow: hidden;\n  background: #ffffff;\n  border: 1px solid #e5e7eb;\n}\n\n.deal-image {\n  width: 100%;\n  height: 150px;\n  object-fit: cover;\n  display: block;\n}\n\n.deal-content {\n  padding: 14px 16px;\n}\n\n.deal-title {\n  margin: 0 0 6px;\n  font-size: 1.1rem;\n  font-weight: 700;\n}\n\n.deal-meta {\n  margin: 0;\n  font-size: 0.9rem;\n  color: #6b7280;\n}\n\n.deal-price {\n  margin-top: 8px;\n  font-size: 1rem;\n  font-weight: 600;\n  color: #111827;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const snackContainer = document.getElementById(\"snackContainer\");\n\nconst snacks = [\n  {\n    name: \"Popcorn\",\n    image: \"images/popcorn.png\",\n    flavor: \"Butter\",\n    price: \"$5\"\n  },\n  {\n    name: \"Ice Cream\",\n    image: \"images/ice-cream.png\",\n    flavor: \"Vanilla\",\n    price: \"$4\"\n  },\n  {\n    name: \"Cupcakes\",\n    image: \"images/cupcake.png\",\n    flavor: \"Vanilla\",\n    price: \"$3\"\n  }\n];",
          "folderId": "0",
          "active": true
        },
