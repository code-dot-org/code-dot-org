          "name": "style.css",
          "language": "css",
          "contents": "body {\n  background: lightblue;\n}\n\nh1 {\n  font-weight: bold;\n  font-family: fantasy;\n  text-shadow: #ffffff 1px 1px 0px;\n  font-size: 56px;\n  text-align: center;\n}\n\np {\n  font-family: Verdana;\n  font-size: 24px;\n  text-align: center;\n}\n\nimg {\n  width: 300px;\n  border-style: solid;\n  border-color: #00bcff;\n  border-radius: 20px;\n  margin: 5px;\n}\n\n\n.container {\n  display: flex;\n  flex-direction: row-reverse;\n  flex-wrap: wrap;\n  justify-content: center;\n}\n\nh4 {\n  font-family: monospace;\n  font-style: italic;\n  text-align: center;\n}",
