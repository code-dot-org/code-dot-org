          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    \n    <!-- Page title -->\n    <h1>Cute Animals</h1>\n    \n    <!-- intro -->\n    <p>Baby animals are the cutest type of animal! It doesn't matter what type of animal it is ... if it is a baby, then it is adorable! I dare you to find a baby animal that is not the most adorable and huggable little cutie pie!</p>\n    \n    <!-- container div -->\n    <div class =\"container\">\n      \n      <!-- gallery images -->\n        <img src=\"turtle.jpg\" alt=\"turtle pic\">    \n     \n        <img src=\"kitty.jpg\" alt=\"kitty pic\">    \n   \n        <img src=\"hedgehog.jpg\" alt=\"hedgehog pic\">      \n    \n        <img src=\"penguin.jpg\" alt=\"penguin pic\">      \n    \n        <img src=\"horse.jpg\" alt=\"horse pic\">\n     \n        <img src=\"redPanda.jpg\" alt=\"panda pic\">\n    \n    </div>\n  \n     \n    <!-- footer image citation -->\n    <h4>All images from Pixabay stock images</h4>\n \n    \n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
