      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false,
      "allowMultipleAttempts": false
    },
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Route Planner</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <main class=\"phone\">\n      <header class=\"app-header\">\n        <h1>Route Planner</h1>\n        <p>Debug the route data.</p>\n      </header>\n\n      <section class=\"composer\">\n        <h2>Add a Stop</h2>\n\n        <input id=\"inputName\" type=\"text\" placeholder=\"Stop name...\" />\n        <input id=\"inputHours\" type=\"text\" placeholder=\"Hours...\" />\n        <textarea id=\"inputNotes\" placeholder=\"Notes...\"></textarea>\n\n        <div class=\"action-row\">\n          <button id=\"addStopButton\" class=\"primary-button\">Add New Stop</button>\n          <button id=\"removeStopButton\" class=\"secondary-button\">Remove Last Stop</button>\n        </div>\n      </section>\n\n      <section class=\"route-section\">\n        <h2>Your Route</h2>\n        <div id=\"routeList\" class=\"route-list\"></div>\n      </section>\n    </main>\n\n    <script src=\"helpers.js\"></script>\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// Inputs\nconst inputName = document.getElementById(\"inputName\");\nconst inputHours = document.getElementById(\"inputHours\");\nconst inputNotes = document.getElementById(\"inputNotes\");\n\n// Route list container\nconst routeList = document.getElementById(\"routeList\");\n\n// Arrays that store route data\nconst stopNameArray = [\"Mural A\", \"Mural B\", \"Mural C\"];\nconst stopHoursArray = [\"10-5\", \"All day\", \"12-8\"];\nconst stopNotesArray = [\"Bring camera\", \"Check weather\", \"Best at sunset\"];\n\n// Displays all stops from the arrays\nconst renderRoute = () => {\n  routeList.innerHTML = \"\";\n  inputName.value = \"\";\n  inputHours.value = \"\";\n  inputNotes.value = \"\";\n\n  stopNameArray.map((stopName, index) => {\n    createStopCard(stopName, stopHoursArray[index], stopNotesArray[index]);\n  });\n};\n\nrenderRoute();\n\n// Adds a new stop\nconst addStop = () => {\n  const name = inputName.value;\n  const hours = inputHours.value;\n  const notes = inputNotes.value;\n\n  stopNameArray.push(name);\n  stopHoursArray.push(hours);\n\n  renderRoute();\n};\n\n// Removes the last stop\nconst removeStop = () => {\n  if (stopNameArray.length > 0) {\n    stopNameArray.pop();\n    stopNotesArray.pop();\n\n    renderRoute();\n  }\n};\n\n// Event listeners\ndocument.getElementById(\"addStopButton\").addEventListener(\"click\", addStop);\ndocument.getElementById(\"removeStopButton\").addEventListener(\"click\", removeStop);",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  font-family: Inter, Arial, sans-serif;\n  background: #f2f2f7;\n  color: #1f2937;\n}\n\n.phone {\n  width: 100%;\n  max-width: 430px;\n  min-height: 100vh;\n  margin: 0 auto;\n  background: #ffffff;\n  padding-bottom: 28px;\n}\n\n.app-header {\n  padding: 28px 20px 18px;\n  border-bottom: 1px solid #e5e7eb;\n  text-align: center;\n}\n\n.app-header h1 {\n  margin: 0;\n  font-size: 2rem;\n  font-weight: 700;\n  letter-spacing: -0.04em;\n  color: #1f2a44;\n}\n\n.app-header p {\n  margin: 8px 0 0;\n  font-size: 0.95rem;\n  color: #6b7280;\n}\n\n.composer,\n.route-section {\n  padding: 20px;\n}\n\n.composer h2,\n.route-section h2 {\n  margin: 0 0 14px;\n  font-size: 1.1rem;\n  font-weight: 700;\n  letter-spacing: -0.02em;\n  color: #1f2a44;\n}\n\n#inputName,\n#inputHours,\n#inputNotes {\n  width: 100%;\n  border: 1px solid #d1d5db;\n  border-radius: 14px;\n  padding: 14px 16px;\n  font-size: 1rem;\n  font-family: inherit;\n  background: #ffffff;\n  color: #1f2937;\n  outline: none;\n}\n\n#inputName,\n#inputHours {\n  margin-bottom: 12px;\n}\n\n#inputNotes {\n  min-height: 96px;\n  resize: none;\n  margin-bottom: 14px;\n}\n\n.action-row {\n  display: flex;\n  gap: 10px;\n}\n\n.primary-button,\n.secondary-button {\n  flex: 1;\n  min-height: 52px;\n  border: none;\n  border-radius: 14px;\n  font: inherit;\n  font-size: 0.95rem;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.primary-button {\n  background: #3478f6;\n  color: #ffffff;\n}\n\n.secondary-button {\n  background: #e5e7eb;\n  color: #1f2937;\n}\n\n.route-list {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.stop-card {\n  border: 1px solid #e5e7eb;\n  border-radius: 16px;\n  padding: 16px;\n  background: #ffffff;\n}\n\n.stop-name {\n  margin: 0 0 8px;\n  font-size: 1rem;\n  font-weight: 700;\n  color: #1f2a44;\n}\n\n.stop-detail {\n  margin: 4px 0;\n  font-size: 0.93rem;\n  color: #667085;\n  line-height: 1.35;\n}\n\n.label {\n  font-weight: 600;\n  color: #374151;\n}\n\n@media (max-width: 430px) {\n  .composer,\n  .route-section {\n    padding: 16px;\n  }\n\n  .action-row {\n    gap: 8px;\n  }\n\n  .primary-button,\n  .secondary-button {\n    font-size: 0.9rem;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "helpers.js",
          "contents": "const createStopCard = (name, hours, notes) => {\n  const routeList = document.getElementById(\"routeList\");\n\n  const card = document.createElement(\"div\");\n  card.classList.add(\"stop-card\");\n\n  const stopName = document.createElement(\"h3\");\n  stopName.classList.add(\"stop-name\");\n  stopName.textContent = name;\n\n  const stopHours = document.createElement(\"p\");\n  stopHours.classList.add(\"stop-detail\");\n  stopHours.innerHTML = `<span class=\"label\">Hours:</span> ${hours}`;\n\n  const stopNotes = document.createElement(\"p\");\n  stopNotes.classList.add(\"stop-detail\");\n  stopNotes.innerHTML = `<span class=\"label\">Notes:</span> ${notes}`;\n\n  card.appendChild(stopName);\n  card.appendChild(stopHours);\n  card.appendChild(stopNotes);\n\n  routeList.appendChild(card);\n};",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "2"
      ]
    },
