          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    <!-- corgis! -->\n    <h1>Corgi Lovers United</h1>\n    \n    <p>Welcome to Corgi Lovers United! We enjoy sharing our love of corgis with the world, and this social media page is dedicated to pictures of them. Enjoy!</p>\n    \n    <img src=\"CorgiTongue.jpg\" alt=\"corgi\">\n    \n    <img src=\"CorgiInTent.jpg\" alt=\"corg in a tent\">\n    \n    <img src=\"FluffyCorgi.jpg\" alt=\"super fluffy corgi\">\n    \n    <p>Photos by Florenica Potter, ipet photo, and Cole Keister from Unplash</p>\n    \n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  background: #fff3e7;\n}\np {\n  font-family: cursive;\n}\nh1 {\n  font-family: cursive;\n}\n\n/* 2) Add the width property with a value of your choice */\nimg {\n  \n}",
