      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>SmartHome | Maya</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n    <div class=\"dashboard-bg\"></div>\n\n    <main class=\"app-container\">\n        <header class=\"greeting\">\n            <h1>Hey, Maya!</h1>\n            <p>Your home is responding to your needs.</p>\n        </header>\n\n        <section class=\"widget-grid\">\n            <div class=\"widget glass\" id=\"lightWidget\">\n                <div class=\"widget-header\">\n                    <div class=\"icon-circle\">\n                        <svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\"><path fill=\"currentColor\" d=\"M12,2A7,7 0 0,0 5,9C5,11.38 6.19,13.47 8,14.74V17A1,1 0 0,0 9,18H15A1,1 0 0,0 16,17V14.74C17.81,13.47 19,11.38 19,9A7,7 0 0,0 12,2M9,21A1,1 0 0,0 10,22H14A1,1 0 0,0 15,21V20H9V21Z\" /></svg>\n                    </div>\n                    <span class=\"status-label\" id=\"lightStatusLabel\">Lights Off</span>\n                </div>\n                <h2>Smart Lighting</h2>\n                <div class=\"light-visualizer\">\n                    <div class=\"glow-effect\" id=\"bulbGlow\"></div>\n                </div>\n            </div>\n\n            <div class=\"widget glass\">\n                <h3>Energy Usage</h3>\n                <div class=\"energy-chart-container\">\n                    <img src=\"energy-usage.png\" alt=\"Energy usage graph\" class=\"usage-graph\">\n                </div>\n            </div>\n        </section>\n    </main>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "/* =========================================\n   GLOBAL STYLES & VARIABLES\n   ========================================= */\n:root {\n    --bg-dark: #09090b;\n    --glass: rgba(255, 255, 255, 0.1); /* Adjusted for visibility against kitchen image */\n    --glass-border: rgba(255, 255, 255, 0.15);\n    --accent-gold: #fbbf24;\n    --text-main: #ffffff;\n    --text-dim: #e2e8f0;\n}\n\n* {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n}\n\nbody {\n    margin: 0;\n    background-color: var(--bg-dark);\n    color: var(--text-main);\n    font-family: 'Inter', system-ui, -apple-system, sans-serif;\n    overflow: hidden;\n}\n\n/* KITCHEN BACKGROUND IMAGE */\n.dashboard-bg {\n    position: fixed;\n    top: 0; left: 0; \n    width: 100%; height: 100%;\n    background-image: url('kitchen.png'); \n    background-size: cover;\n    background-position: center;\n    /* Dark overlay to ensure the white glass widgets are readable */\n    background-color: rgba(0, 0, 0, 0.4); \n    background-blend-mode: darken;\n    z-index: -1;\n}\n\n/* =========================================\n   MAIN LAYOUT\n   ========================================= */\n.app-container {\n    max-width: 1000px;\n    margin: 0 auto;\n    padding: 60px 20px;\n}\n\n.greeting h1 { \n    font-size: 3rem; \n    margin-bottom: 8px; \n    text-shadow: 0 2px 10px rgba(0,0,0,0.3);\n}\n\n.greeting p { \n    color: var(--text-dim); \n    font-size: 1.1rem;\n    text-shadow: 0 1px 5px rgba(0,0,0,0.3);\n}\n\n.widget-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n    gap: 24px;\n    margin-top: 40px;\n}\n\n.glass {\n    background: var(--glass);\n    backdrop-filter: blur(15px);\n    -webkit-backdrop-filter: blur(15px);\n    border: 1px solid var(--glass-border);\n    border-radius: 24px;\n    padding: 24px;\n}\n\n/* =========================================\n   SMART LIGHT WIDGET\n   ========================================= */\n.widget-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 20px;\n}\n\n.icon-circle {\n    width: 48px;\n    height: 48px;\n    background: var(--glass-border);\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}\n\n.status-label { \n    font-weight: 600; \n    font-size: 0.9rem; \n    text-transform: uppercase; \n}\n\n/* Light On State */\n.light-on {\n    box-shadow: 0 0 30px rgba(251, 191, 36, 0.3);\n    border-color: var(--accent-gold);\n}\n\n.glow-effect {\n    width: 100%;\n    height: 4px;\n    background: var(--accent-gold);\n    filter: blur(10px);\n    opacity: 0;\n    transition: opacity 0.3s;\n}\n\n.light-on .glow-effect { \n    opacity: 1; \n}\n\n/* =========================================\n   ENERGY USAGE WIDGET\n   ========================================= */\n.energy-chart-container {\n    margin-top: 15px;\n    border-radius: 12px;\n    overflow: hidden;\n}\n\n.usage-graph { \n    width: 100%; \n    display: block; \n}\n\n/* =========================================\n   LOGIC LAB OVERLAY\n   ========================================= */\n.logic-lab {\n    position: fixed;\n    bottom: 24px; \n    right: 24px;\n    width: 300px;\n    background: #18181b;\n    border: 1px solid #27272a;\n    border-radius: 16px;\n    padding: 20px;\n    z-index: 100;\n}\n\n.lab-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n}\n\n/* Minimize Logic: Hide content but keep panel title visible */\n.logic-lab.minimized #labContent {\n    display: none;\n}\n\n.lab-toggle-btn {\n    background: none;\n    border: none;\n    color: white;\n    font-size: 1.5rem;\n    cursor: pointer;\n    line-height: 1;\n}\n\n.control-row {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin: 16px 0;\n}\n\n.lab-btn {\n    background: #ef4444; /* Default False = Red */\n    border: none;\n    color: white;\n    padding: 6px 12px;\n    border-radius: 8px;\n    cursor: pointer;\n    width: 80px;\n    font-weight: bold;\n}\n\n.lab-btn.active { \n    background: #10b981; /* True = Green */\n}\n\n.outcome-box {\n    margin-top: 15px;\n    padding-top: 15px;\n    border-top: 1px solid #27272a;\n}\n\n#logicStatus {\n    font-weight: bold;\n    margin-top: 4px;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "// State Variables\nlet motionDetected = false;\nlet isNighttime = false;\n\n// UI Elements\nconst lightWidget = document.getElementById('lightWidget');\nconst lightStatusLabel = document.getElementById('lightStatusLabel');\n\n// Function to update the smart home lights logic\n\n\n\n\n\n\nupdateAppUI();",
          "folderId": "0",
          "active": true
        },
