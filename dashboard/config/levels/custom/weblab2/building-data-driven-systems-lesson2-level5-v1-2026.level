  "properties": {
    "encrypted": "false",
    "long_instructions": "## Predict What .map() Does\r\n\r\n### Do This:\r\n\r\n1. Look at the code and think about what is happening:\r\n   * What is being repeated?\r\n   * How is `index` being used?\r\n\r\n2. Predict what this code will do and submit your predictions below:\r\n   * How many cards will be created?\r\n   * What will each card show?\r\n\r\n3. Prompt AI to explain the syntax of `.map()` in this code.",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
