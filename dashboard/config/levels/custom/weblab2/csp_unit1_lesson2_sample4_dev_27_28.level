        "2": {
          "id": "2",
          "name": "style.css",
          "contents": ":root {\n  --indigo: #3743c4;\n  --indigo-dark: #2a3399;\n  --indigo-tint: #e8eafc;\n  --ink: #1c2233;\n  --surface: #ffffff;\n  --page: #eef1f6;\n  --success-bg: #e3f4ea;\n  --success-ink: #14532d;\n  --success-border: #2f7d4f;\n  --warn-bg: #fdecec;\n  --warn-ink: #7f1d1d;\n  --warn-border: #b42318;\n  --radius: 0.75rem;\n}\n\n[hidden] {\n  display: none !important;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  display: flex;\n  justify-content: center;\n  align-items: flex-start;\n  padding: 1rem;\n  background: var(--page);\n  color: var(--ink);\n  font-family: system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif;\n  font-size: 1rem;\n  line-height: 1.45;\n}\n\n.app {\n  width: 100%;\n  max-width: 28rem;\n  min-height: 36rem;\n  display: flex;\n  flex-direction: column;\n  background: var(--surface);\n  border-radius: 1.5rem;\n  box-shadow: 0 8px 24px rgba(28, 34, 51, 0.18);\n  overflow: hidden;\n}\n\n.app-header {\n  padding: 1rem 1.25rem;\n  background: var(--indigo);\n  color: #ffffff;\n}\n\n.app-title {\n  margin: 0;\n  font-size: 1.25rem;\n  line-height: 1.2;\n}\n\n.notice {\n  margin: 1rem 1.25rem 0;\n  padding: 0.75rem 1rem;\n  border-radius: var(--radius);\n  background: var(--warn-bg);\n  color: var(--warn-ink);\n  font-weight: 600;\n}\n\n.screen {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  gap: 0.875rem;\n  padding: 1.25rem;\n}\n\n.screen h2 {\n  margin: 0;\n  font-size: 1.375rem;\n  line-height: 1.25;\n}\n\n.screen h2:focus {\n  outline: none;\n}\n\n.screen p {\n  margin: 0;\n}\n\n.feature-image {\n  display: block;\n  width: 100%;\n  max-width: 22rem;\n  height: auto;\n  margin-inline: auto;\n}\n\n.count-row {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 0.5rem;\n}\n\n.count-button {\n  min-height: 3rem;\n  border: 2px solid transparent;\n  border-radius: var(--radius);\n  color: #ffffff;\n  font: inherit;\n  font-size: 1.25rem;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n.count-one {\n  background: #3e1abc;\n}\n\n.count-two {\n  background: #a1157f;\n}\n\n.count-three {\n  background: #0f766e;\n}\n\n.count-four {\n  background: #b45309;\n}\n\n.people-image {\n  display: block;\n  width: 100%;\n  height: auto;\n}\n\n.answer {\n  min-height: 4rem;\n  padding: 0.75rem 1rem;\n  border-inline-start: 4px solid var(--indigo);\n  border-radius: 0.375rem;\n  background: var(--indigo-tint);\n  font-size: 1.5rem;\n  font-weight: 700;\n  text-align: center;\n}\n\n.answer.is-right {\n  border-color: var(--success-border);\n  background: var(--success-bg);\n  color: var(--success-ink);\n}\n\n.answer.is-wrong {\n  border-color: var(--warn-border);\n  background: var(--warn-bg);\n  color: var(--warn-ink);\n}\n\n.screen-actions {\n  display: flex;\n  justify-content: center;\n  margin-top: auto;\n  padding-top: 0.5rem;\n}\n\n.primary-button {\n  min-width: 8rem;\n  min-height: 2.75rem;\n  padding: 0.5rem 1.5rem;\n  border: 2px solid var(--indigo);\n  border-radius: var(--radius);\n  background: var(--indigo);\n  color: #ffffff;\n  font: inherit;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n.primary-button:hover {\n  background: var(--indigo-dark);\n  border-color: var(--indigo-dark);\n}\n\n.primary-button:focus-visible,\n.count-button:focus-visible {\n  outline: 3px solid var(--indigo);\n  outline-offset: 2px;\n}\n\n@media (max-width: 22rem) {\n  body {\n    padding: 0;\n  }\n\n  .app {\n    border-radius: 0;\n  }\n}\n",
          "folderId": "0",
          "active": false
        },
        "4": {
