          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n<head>\n  <title>My Web Page</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <section class=\"hero\">\n    <h1>Welcome to My Site</h1>\n    <p>This is my awesome webpage.</p>\n    <button>Learn More</button>\n  </section>\n</body>\n</html>",
