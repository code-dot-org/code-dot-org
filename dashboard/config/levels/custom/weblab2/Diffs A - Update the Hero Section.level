          "language": "css",
          "contents": "body {\n  margin: 0;\n  font-family: Arial, sans-serif;\n}\n\n.hero {\n  background-color: #f4f4f4;\n  padding: 20px;\n  text-align: center;\n}\n\nbutton {\n  padding: 8px 16px;\n  font-size: 16px;\n}",
          "folderId": "0",
