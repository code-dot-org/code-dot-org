        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>Level 2 – Password Visibility</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body class=\"light\">\n    <h1>Password Visibility</h1>\n\n    <section id=\"pwBlock\">\n      <label for=\"pwInput\">Password:</label>\n      <input id=\"pwInput\" type=\"password\" value=\"p@ssword123!\">\n      <br/><br/>\n      <label>\n        <input id=\"chkToggle\" type=\"checkbox\">\n        Show password\n      </label>\n    </section>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* Layout */\nbody {\n  font-family: sans-serif;\n  text-align: center;\n  padding: 2rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n  align-items: center;\n  min-height: 100vh;\n  transition: background-color 0.3s, color 0.3s;\n}\n\ninput[type=\"password\"],\ninput[type=\"text\"] {\n  padding: 0.4rem;\n  border: 1px solid #ccc;\n  border-radius: 4px;\n}\n\nlabel {\n  margin: 0.5rem;\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "// Selectors\nconst pwInput = document.getElementById(\"pwInput\");\nconst chkToggle = document.getElementById(\"chkToggle\");\n",
          "folderId": "0",
          "active": true
        }
