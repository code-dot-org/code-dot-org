<Weblab2>
  <config><![CDATA[{
  "published": true,
  "game_id": 74,
  "created_at": "2025-10-17T19:24:04.000Z",
  "level_num": "custom",
  "user_id": 18603,
  "properties": {
    "encrypted": "false",
    "long_instructions": "##Accessibility Feature: Contrast\r\n\r\n_Higher contrast makes shapes and letters pop from their surroundings, so people can read and recognize things quickly_\r\n\r\nChat with the AI in order to learn how contrast was implemented in this web app.\r\n\r\nPossible Stems:\r\n* How did we turn on high contrast for this card?\r\n* What are the final text and background colors for the card in normal mode and in high-contrast?\r\n* How can we link a button to update contrast?",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
    "ai_tutor_mode": "outline",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "allowMultipleAttempts": false,
      "placeholderText": "",
      "multipleChoiceOptions": [
        ""
      ],
      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false
    },
    "display_name": "High Contrast",
    "bubble_choice_description": "Contrast is the visible difference between what you need to see (text, icons, controls) and what’s behind it (background)",
    "thumbnail_url": "https://images.code.org/4ba153e113178824f94f48e17c46adbe-aiChat.png",
    "level_system_prompt": "You are an accessibility coach for novice web students analyzing a Storm Tracker card’s CONTRAST.\r\n\r\nStudents know minimal JS and almost no CSS. Keep answers short, concrete, and copy-pasteable.\r\n\r\nDo:\r\n- Point to ONE class/attribute that enables high contrast and where it’s added (e.g., on <body>).\r\n- List the final text and background colors in normal and high-contrast modes. If variables are used, resolve them.\r\n- Explain contrast values (what is needed for good contrast?)\r\n- Provide at most two one-line fixes (e.g., toggle JS line, underline for links) with no layout changes.\r\n- Offer a 4-step visual check students can perform.\r\n\r\nDon’t:\r\n- Don’t refactor to CSS variables, don’t change HTML, don’t propose redesigns.\r\n- Don’t use jargon; no diffs; no more than 5 lines of code total.\r\n\r\nReturn sections in this order:\r\n1) Toggle (where/how)\r\n2) Colors (normal vs. high-contrast, with ratios)\r\n3) Pass/Fail (bullet list)\r\n4) One-liners (max 2)\r\n5) Quick Check (4 steps)",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "image.png",
          "language": "png",
          "contents": "",
          "folderId": "0",
          "url": "/level_starter_assets/ai-and-algorithmic-decisions-lesson7-level3a-test-2025/uuid/09d6685a-1055-4a63-85df-3e32eed44ca3.png",
          "type": "starter",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n<head>\n  <title>Storm Alert Dashboard</title>\n  <link rel=\"stylesheet\" href=\"styles.css\" />\n  <script src=\"script.js\"></script>\n</head>\n<body>\n  <div class=\"container\">\n    <header>\n      <h1>Campus Storm Alert Dashboard</h1>\n      <button id=\"contrast-toggle\">Contrast Boost</button>\n    </header>\n\n    <main>\n      <div class=\"alert-card\">\n        <img src=\"image.png\" alt=\"Storm warning icon\" class=\"alert-icon\" />\n        <h2>Severe Weather Warning</h2>\n        <p class=\"alert-level\">Alert Level: High</p>\n        <p class=\"alert-time\">Issued: 2:30 PM</p>\n        <p class=\"alert-description\">\n          Strong thunderstorms expected in the area. Heavy rain and wind gusts\n          up to 45 mph possible. Seek shelter indoors.\n        </p>\n      </div>\n\n      <div class=\"alert-card\">\n        <img src=\"image.png\" alt=\"Storm warning icon\" class=\"alert-icon\" />\n        <h2>Flash Flood Watch</h2>\n        <p class=\"alert-level\">Alert Level: Medium</p>\n        <p class=\"alert-time\">Issued: 1:15 PM</p>\n        <p class=\"alert-description\">\n          Low-lying areas may experience flooding. Avoid walking or driving\n          through standing water.\n        </p>\n      </div>\n\n      <div class=\"alert-card\">\n        <img src=\"image.png\" alt=\"Storm warning icon\" class=\"alert-icon\" />\n        <h2>Wind Advisory</h2>\n        <p class=\"alert-level\">Alert Level: Low</p>\n        <p class=\"alert-time\">Issued: 12:00 PM</p>\n        <p class=\"alert-description\">\n          Gusty winds expected throughout the afternoon. Secure loose objects\n          and be cautious when walking outdoors.\n        </p>\n      </div>\n    </main>\n\n    <footer>\n      <p>Last Updated: 2:45 PM | Campus Safety Office</p>\n    </footer>\n  </div>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "document.addEventListener(\"DOMContentLoaded\", () => {\n  const contrastButton = document.querySelector(\"#contrast-toggle\");\n  const container = document.querySelector(\".container\");\n\n  contrastButton.addEventListener(\"click\", () => {\n    container.classList.toggle(\"high-contrast\");\n  });\n});\n",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
          "name": "styles.css",
          "language": "css",
          "contents": "body {\n  margin: 0;\n  padding: 0;\n  font-family: Arial, sans-serif;\n  background-color: lightgray;\n}\n\n.container {\n  max-width: 800px;\n  margin: 0 auto;\n  padding: 20px;\n}\n\nheader {\n  text-align: center;\n  margin-bottom: 30px;\n}\n\nh1 {\n  color: silver;\n  font-size: 32px;\n  margin-bottom: 15px;\n}\n\nbutton {\n  background-color: lightgray;\n  color: darkgray;\n  border: 1px solid silver;\n  padding: 10px 20px;\n  font-size: 16px;\n  cursor: pointer;\n}\n\nbutton:hover {\n  background-color: silver;\n}\n\nmain {\n  margin-bottom: 30px;\n}\n\n.alert-card {\n  background-color: whitesmoke;\n  border: 1px solid lightgray;\n  padding: 20px;\n  margin-bottom: 20px;\n}\n\n.alert-icon {\n  width: 50px;\n  height: 50px;\n  margin-bottom: 10px;\n}\n\nh2 {\n  color: lightgray;\n  font-size: 24px;\n  margin: 10px 0;\n}\n\n.alert-level {\n  color: silver;\n  font-size: 14px;\n  margin: 5px 0;\n}\n\n.alert-time {\n  color: darkgray;\n  font-size: 14px;\n  margin: 5px 0;\n}\n\n.alert-description {\n  color: gray;\n  font-size: 16px;\n  line-height: 1.5;\n  margin: 10px 0;\n}\n\nfooter {\n  text-align: center;\n  padding: 20px 0;\n  border-top: 1px solid lightgray;\n}\n\nfooter p {\n  color: silver;\n  font-size: 14px;\n  margin: 0;\n}\n\n.high-contrast {\n  background-color: white;\n}\n\n.high-contrast h1 {\n  color: black;\n  text-decoration: underline;\n  border-bottom: 3px solid black;\n  padding-bottom: 10px;\n}\n\n.high-contrast button {\n  background-color: black;\n  color: white;\n  border: 3px solid black;\n}\n\n.high-contrast button:hover {\n  background-color: #333;\n}\n\n.high-contrast .alert-card {\n  background-color: white;\n  border: 3px solid black;\n}\n\n.high-contrast h2 {\n  color: black;\n  text-decoration: underline;\n}\n\n.high-contrast .alert-level {\n  color: black;\n  font-weight: bold;\n}\n\n.high-contrast .alert-time {\n  color: black;\n  font-weight: bold;\n}\n\n.high-contrast .alert-description {\n  color: black;\n}\n\n.high-contrast footer {\n  border-top: 3px solid black;\n}\n\n.high-contrast footer p {\n  color: black;\n  font-weight: bold;\n}\n",
          "folderId": "0",
          "active": false
        }
      },
