<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-11-03T03:33:42.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": true,
    "start_sources": {
      "folders": {
      },
      "files": {
        "9973ade3-7dc3-4022-8ed4-d3fab3451d48": {
          "id": "9973ade3-7dc3-4022-8ed4-d3fab3451d48",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Find Code Lines</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <h1>Search the Code</h1>\n    <p>Enter a section ID (name) below to find its corresponding line in the HTML code.</p>\n\n    <div class=\"code-viewer\">\n        <div class=\"line-numbers\" id=\"lineNumbers\"></div>\n        <pre><code id=\"sampleCodeBlock\"></code></pre>\n    </div>\n\n    <div class=\"search-controls\">\n        <label for=\"searchId\">Search for ID:</label>\n        <input type=\"text\" id=\"searchId\" placeholder=\"e.g., mainHeader\">\n        <button id=\"searchButton\">Find Line</button>\n    </div>\n\n    <div class=\"result-display\">\n        <p><strong>Found on Line:</strong> <span id=\"resultLineNumber\">--</span></p>\n        <pre><code id=\"resultCodeLine\"></code></pre>\n    </div>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "02007dc9-2fdb-4c21-84fc-c298eda14b14": {
          "id": "02007dc9-2fdb-4c21-84fc-c298eda14b14",
          "name": "style.css",
          "contents": "body {\n    font-family: Arial, sans-serif;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    min-height: 100vh;\n    background-color: #f0f2f5;\n    color: #333;\n    margin: 0;\n    padding: 20px;\n    box-sizing: border-box;\n}\n\nh1 {\n    color: #0056b3;\n    margin-bottom: 10px;\n}\n\np {\n    margin-bottom: 25px;\n    text-align: center;\n    max-width: 600px;\n}\n\n.code-viewer {\n    display: flex;\n    width: 90%;\n    max-width: 700px;\n    background-color: #fff;\n    border: 1px solid #ddd;\n    border-radius: 8px;\n    margin-bottom: 30px;\n    box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n    overflow-x: auto;\n}\n\n.line-numbers {\n    padding: 15px 10px;\n    background-color: #f8f8f8;\n    border-right: 1px solid #eee;\n    color: #888;\n    text-align: right;\n    font-family: 'Courier New', monospace;\n    font-size: 0.9em;\n    line-height: 1.4;\n    flex-shrink: 0;\n}\n\npre {\n    margin: 0;\n    padding: 15px;\n    overflow-x: auto;\n    flex-grow: 1;\n}\n\ncode {\n    font-family: 'Courier New', monospace;\n    font-size: 0.9em;\n    line-height: 1.4;\n    white-space: pre;\n}\n\n.search-controls {\n    background-color: #fff;\n    padding: 20px;\n    border-radius: 8px;\n    box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n    width: 90%;\n    max-width: 700px;\n    display: flex;\n    gap: 10px;\n    align-items: center;\n    margin-bottom: 30px;\n}\n\n.search-controls label {\n    font-weight: bold;\n    color: #555;\n}\n\n.search-controls input[type=\"text\"] {\n    flex-grow: 1;\n    padding: 10px;\n    border: 1px solid #ccc;\n    border-radius: 5px;\n    font-size: 1em;\n}\n\n.search-controls button {\n    background-color: #007bff;\n    color: white;\n    padding: 10px 20px;\n    border: none;\n    border-radius: 5px;\n    font-size: 1em;\n    cursor: pointer;\n    transition: background-color 0.3s ease;\n}\n\n.search-controls button:hover {\n    background-color: #0056b3;\n}\n\n.result-display {\n    background-color: #e9f5ff;\n    border: 1px solid #a8d5f7;\n    padding: 15px;\n    border-radius: 8px;\n    width: 90%;\n    max-width: 700px;\n    box-shadow: 0 2px 5px rgba(0,0,0,0.05);\n}\n\n.result-display p {\n    text-align: left;\n    margin-bottom: 10px;\n    color: #007bff;\n}\n\n.result-display pre {\n    background-color: #d1ecf1;\n    border: 1px solid #bee5eb;\n    padding: 10px;\n    border-radius: 5px;\n    margin-top: 10px;\n}\n\n.result-display code {\n    color: #0c5460;\n}\n",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "872efa6c-db7c-4c09-942e-d86b0b9d7e1f": {
          "id": "872efa6c-db7c-4c09-942e-d86b0b9d7e1f",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const sampleHtmlCode = `<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>My Sample Page</title>\n</head>\n<body>\n    <header id=\"mainHeader\">\n        <h1>Welcome to My Site</h1>\n        <nav>\n            <ul>\n                <li><a href=\"#\">Home</a></li>\n                <li><a href=\"#\">About</a></li>\n            </ul>\n        </nav>\n    </header>\n\n    <main>\n        <section id=\"featuredContent\">\n            <h2>Featured Articles</h2>\n            <article>\n                <h3>Article 1 Title</h3>\n                <p>This is the content of article 1.</p>\n            </article>\n        </section>\n\n        <section id=\"contactInfo\">\n            <h2>Contact Us</h2>\n            <p>Email: info@example.com</p>\n            <button>Send Message</button>\n        </section>\n    </main>\n\n    <footer id=\"pageFooter\">\n        <p>&copy; 2023 My Sample Page</p>\n    </footer>\n</body>\n</html>`;\n\n    const lineNumbersDiv = document.getElementById('lineNumbers');\n    const sampleCodeBlock = document.getElementById('sampleCodeBlock');\n    const searchIdInput = document.getElementById('searchId');\n    const searchButton = document.getElementById('searchButton');\n    const resultLineNumberSpan = document.getElementById('resultLineNumber');\n    const resultCodeLineCode = document.getElementById('resultCodeLine');\n\n    function escapeHtml(unsafe) {\n        return unsafe\n            .replace(/&/g, \"&amp;\")\n            .replace(/</g, \"&lt;\")\n            .replace(/>/g, \"&gt;\")\n            .replace(/\"/g, \"&quot;\")\n            .replace(/'/g, \"&#039;\");\n    }\n\n    function displayCodeWithLines() {\n        const lines = sampleHtmlCode.split('\\n');\n        let lineNumbersHtml = '';\n        let codeHtml = '';\n        lines.forEach((line, index) => {\n            lineNumbersHtml += `<span>${index + 1}</span><br>`;\n            codeHtml += escapeHtml(line) + '\\n';\n        });\n        lineNumbersDiv.innerHTML = lineNumbersHtml;\n        sampleCodeBlock.textContent = sampleHtmlCode; // Use textContent for the raw code\n    }\n\n    function searchCode() {\n        const searchTerm = searchIdInput.value.trim();\n        if (!searchTerm) {\n            resultLineNumberSpan.textContent = '--';\n            resultCodeLineCode.textContent = 'Please enter an ID to search.';\n            return;\n        }\n\n        const lines = sampleHtmlCode.split('\\n');\n        let foundLineNumber = -1;\n        let foundLineContent = '';\n\n        const regex = new RegExp(`id=\"${searchTerm}\"`, 'i'); // Case-insensitive search for id=\"searchTerm\"\n\n        for (let i = 0; i < lines.length; i++) {\n            if (regex.test(lines[i])) {\n                foundLineNumber = i + 1;\n                foundLineContent = lines[i].trim();\n                break;\n            }\n        }\n\n        if (foundLineNumber !== -1) {\n            resultLineNumberSpan.textContent = foundLineNumber;\n            resultCodeLineCode.textContent = foundLineContent;\n            // Optional: Highlight in the main code block (more complex to implement with textContent)\n        } else {\n            resultLineNumberSpan.textContent = '--';\n            resultCodeLineCode.textContent = `ID \"${searchTerm}\" not found.`;\n        }\n    }\n\n    displayCodeWithLines();\n    searchButton.addEventListener('click', searchCode);\n    searchIdInput.addEventListener('keypress', (event) => {\n        if (event.key === 'Enter') {\n            searchCode();\n        }\n    });\n});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
