      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Curbside Pickup Queue</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n\n  <body>\n    <main class=\"phone\">\n      <header class=\"app-header\">\n        <div class=\"brand-icon\">🚗</div>\n        <div>\n          <h1>Curbside Pickup Queue</h1>\n          <p>Manage pickups in the order customers arrived.</p>\n        </div>\n      </header>\n\n      <section class=\"pickups-section\">\n        <div class=\"section-header\">\n          <div class=\"section-title\">\n            <span class=\"section-icon\">📋</span>\n            <h2>Current Pickups</h2>\n          </div>\n          <span id=\"pickupCount\" class=\"pickup-count\">0 Pickups</span>\n        </div>\n\n        <div id=\"pickupList\" class=\"pickup-list\"></div>\n      </section>\n\n      <section class=\"actions-section\">\n        <div class=\"section-title\">\n          <span class=\"section-icon\">⚙️</span>\n          <h2>Queue Actions</h2>\n        </div>\n\n        <div class=\"button-row\">\n          <button id=\"completeOldestButton\" class=\"action-button complete-button\">\n            <span>✓</span>\n            Complete Oldest Pickup\n          </button>\n\n          <button id=\"removeNewestButton\" class=\"action-button remove-button\">\n            <span>✕</span>\n            Remove Newest Pickup\n          </button>\n        </div>\n\n        <div class=\"info-box\">\n          <span>ⓘ</span>\n          <p>Pickups are processed from oldest at the top to newest at the bottom.</p>\n        </div>\n      </section>\n    </main>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  font-family: Inter, Arial, sans-serif;\n  background: #0f172a;\n  color: #111827;\n}\n\nbutton {\n  font: inherit;\n  cursor: pointer;\n}\n\n.phone {\n  width: 100%;\n  min-height: 100vh;\n  background: #ffffff;\n}\n\n/* HEADER */\n.app-header {\n  display: flex;\n  gap: 18px;\n  align-items: center;\n  padding: 44px 28px 34px;\n  background: #1d4ed8;\n  color: #ffffff;\n}\n\n.brand-icon {\n  width: 64px;\n  height: 64px;\n  border: 4px solid #ffffff;\n  border-radius: 16px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 32px;\n}\n\n.app-header h1 {\n  margin: 0 0 6px;\n  font-size: 1.75rem;\n}\n\n.app-header p {\n  margin: 0;\n  opacity: 0.9;\n}\n\n/* SECTIONS */\n.pickups-section,\n.actions-section {\n  padding: 30px 28px;\n}\n\n.section-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 22px;\n}\n\n.section-title {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n\n.section-icon {\n  font-size: 1.6rem;\n}\n\n.section-title h2 {\n  margin: 0;\n}\n\n.pickup-count {\n  background: #dbeafe;\n  color: #1d4ed8;\n  padding: 8px 14px;\n  border-radius: 10px;\n  font-weight: 800;\n}\n\n/* LIST */\n.pickup-list {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.pickup-item {\n  display: grid;\n  grid-template-columns: 34px 44px 1fr auto;\n  gap: 12px;\n  align-items: center;\n  padding: 14px;\n  background: #f8fafc;\n  border: 1px solid #e5e7eb;\n  border-radius: 16px;\n}\n\n.pickup-number {\n  width: 28px;\n  height: 28px;\n  border-radius: 999px;\n  background: #1d4ed8;\n  color: white;\n  display: grid;\n  place-items: center;\n  font-weight: 800;\n}\n\n.pickup-avatar {\n  font-size: 1.8rem;\n}\n\n.pickup-name {\n  font-weight: 800;\n}\n\n.pickup-details,\n.pickup-time {\n  color: #64748b;\n  font-size: 0.9rem;\n}\n\n/* ACTIONS */\n.actions-section {\n  background: #f8fafc;\n  border-top: 1px solid #e5e7eb;\n}\n\n.button-row {\n  display: flex;\n  gap: 12px;\n  margin: 18px 0;\n  flex-wrap: wrap;\n}\n\n.action-button {\n  border: 0;\n  border-radius: 12px;\n  padding: 12px 16px;\n  font-weight: 800;\n  color: white;\n  box-shadow: 0 6px 14px rgba(15, 23, 42, 0.12);\n}\n\n.complete-button {\n  background: #1d4ed8;\n}\n\n.remove-button {\n  background: #dc2626;\n}\n\n/* INFO BOX */\n.info-box {\n  display: flex;\n  gap: 10px;\n  align-items: flex-start;\n  padding: 14px;\n  background: #eff6ff;\n  color: #1e40af;\n  border-radius: 14px;\n  border: 1px solid #bfdbfe;\n}\n\n.info-box p {\n  margin: 0;\n}",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "script.js",
          "contents": "// Use pickupList in renderPickups\nconst pickupList = document.getElementById(\"pickupList\");\nconst pickupCount = document.getElementById(\"pickupCount\");\n\n// You will connect these buttons to your app in Level 4.\nconst completeOldestButton = document.getElementById(\"completeOldestButton\");\nconst removeNewestButton = document.getElementById(\"removeNewestButton\");\n\nconst pickups = [\n  {\n    icon: \"👤\",\n    customer: \"Sarah J.\",\n    order: \"Grocery Order #1842\",\n    location: \"Spot A3\",\n    time: \"10:15 AM\"\n  },\n  {\n    icon: \"👤\",\n    customer: \"Mike R.\",\n    order: \"Home Goods #2091\",\n    location: \"Spot B1\",\n    time: \"10:23 AM\"\n  },\n  {\n    icon: \"👤\",\n    customer: \"Priya K.\",\n    order: \"Pharmacy Pickup #772\",\n    location: \"Spot A5\",\n    time: \"10:31 AM\"\n  },\n  {\n    icon: \"👤\",\n    customer: \"James L.\",\n    order: \"Electronics #4310\",\n    location: \"Spot C2\",\n    time: \"10:42 AM\"\n  }\n];\n\n// This function is already done for you.\n// Call it in renderPickups.\nconst createPickupCard = (pickup, index) => {\n  return `\n    <div class=\"pickup-item\">\n      <div class=\"pickup-number\">${index + 1}</div>\n      <div class=\"pickup-avatar\">${pickup.icon}</div>\n      <div>\n        <div class=\"pickup-name\">${pickup.customer}</div>\n        <div class=\"pickup-details\">${pickup.order}</div>\n        <div class=\"pickup-details\">${pickup.location}</div>\n      </div>\n      <div class=\"pickup-time\">${pickup.time}</div>\n    </div>\n  `;\n};\n\n// TODO:\n// Inside renderPickups(), use .map() to render each pickup.\n// Each pickup should create one card using createPickupCard(pickup, index).\n// Display all the cards inside pickupList.\nconst renderPickups = () => {\n\n\n\n  pickupCount.textContent = `${pickups.length} Pickups`;\n};\n\nrenderPickups();",
