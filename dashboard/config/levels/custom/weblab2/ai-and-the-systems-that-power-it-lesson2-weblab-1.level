      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Build the Machine</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n<script src=\"script.js\" defer></script>\n</head>\n<body>\n\n<svg class=\"sprite\" aria-hidden=\"true\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\">\n\n  <symbol id=\"art-board\" viewBox=\"0 0 1000 780\">\n    <rect class=\"a-board\" x=\"16\" y=\"16\" width=\"968\" height=\"748\" rx=\"22\" stroke-width=\"6\"/>\n    <g class=\"a-hole\" fill=\"none\" stroke-width=\"4\">\n      <circle cx=\"58\" cy=\"58\" r=\"10\"/>\n      <circle cx=\"942\" cy=\"58\" r=\"10\"/>\n      <circle cx=\"58\" cy=\"722\" r=\"10\"/>\n      <circle cx=\"942\" cy=\"722\" r=\"10\"/>\n    </g>\n    <g class=\"a-trace\" fill=\"none\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <path d=\"M130 105 H166 V200 H200\"/>\n      <path d=\"M130 300 H168 V262 H200\"/>\n      <path d=\"M470 140 H620 V100 H700\"/>\n      <path d=\"M470 220 H650 V230 H700\"/>\n      <path d=\"M340 340 V420 H520 V470 H560\"/>\n      <path d=\"M620 550 V600\"/>\n      <path d=\"M680 470 H817 V400\"/>\n      <path d=\"M586 460 H654 M586 486 H654 M586 512 H654\"/>\n    </g>\n    <g class=\"a-chip\" stroke-width=\"4\">\n      <rect x=\"20\" y=\"76\" width=\"110\" height=\"58\" rx=\"5\"/>\n      <rect x=\"20\" y=\"148\" width=\"110\" height=\"42\" rx=\"5\"/>\n      <rect x=\"20\" y=\"204\" width=\"84\" height=\"62\" rx=\"5\"/>\n      <rect x=\"20\" y=\"280\" width=\"110\" height=\"48\" rx=\"5\"/>\n      <rect x=\"20\" y=\"342\" width=\"84\" height=\"42\" rx=\"5\"/>\n      <rect x=\"560\" y=\"430\" width=\"120\" height=\"120\" rx=\"12\"/>\n    </g>\n    <g class=\"a-socket\" stroke-width=\"6\">\n      <rect x=\"200\" y=\"70\" width=\"270\" height=\"270\" rx=\"10\"/>\n      <rect x=\"700\" y=\"70\" width=\"54\" height=\"330\" rx=\"7\"/>\n      <rect x=\"790\" y=\"70\" width=\"54\" height=\"330\" rx=\"7\"/>\n      <rect x=\"200\" y=\"420\" width=\"200\" height=\"44\" rx=\"7\"/>\n      <rect x=\"150\" y=\"600\" width=\"560\" height=\"54\" rx=\"7\"/>\n    </g>\n    <g class=\"a-recess\" stroke-width=\"4\">\n      <rect x=\"238\" y=\"108\" width=\"194\" height=\"194\" rx=\"6\"/>\n      <rect x=\"714\" y=\"102\" width=\"26\" height=\"266\" rx=\"4\"/>\n      <rect x=\"804\" y=\"102\" width=\"26\" height=\"266\" rx=\"4\"/>\n      <rect x=\"216\" y=\"434\" width=\"146\" height=\"16\" rx=\"4\"/>\n      <rect x=\"168\" y=\"618\" width=\"90\" height=\"20\" rx=\"4\"/>\n      <rect x=\"276\" y=\"618\" width=\"416\" height=\"20\" rx=\"4\"/>\n    </g>\n    <g class=\"a-chip\" stroke-width=\"4\">\n      <rect x=\"286\" y=\"56\" width=\"46\" height=\"18\" rx=\"4\"/>\n      <rect x=\"342\" y=\"56\" width=\"46\" height=\"18\" rx=\"4\"/>\n      <rect x=\"706\" y=\"76\" width=\"42\" height=\"20\" rx=\"4\"/>\n      <rect x=\"706\" y=\"374\" width=\"42\" height=\"20\" rx=\"4\"/>\n      <rect x=\"796\" y=\"76\" width=\"42\" height=\"20\" rx=\"4\"/>\n      <rect x=\"796\" y=\"374\" width=\"42\" height=\"20\" rx=\"4\"/>\n      <rect x=\"712\" y=\"606\" width=\"34\" height=\"42\" rx=\"6\"/>\n    </g>\n    <g class=\"a-accent\">\n      <rect x=\"252\" y=\"122\" width=\"26\" height=\"26\" rx=\"4\"/>\n      <rect x=\"720\" y=\"222\" width=\"14\" height=\"30\" rx=\"3\"/>\n      <rect x=\"810\" y=\"222\" width=\"14\" height=\"30\" rx=\"3\"/>\n      <circle cx=\"380\" cy=\"442\" r=\"10\"/>\n      <rect x=\"264\" y=\"614\" width=\"8\" height=\"28\" rx=\"3\"/>\n    </g>\n  </symbol>\n\n  <symbol id=\"art-chipset\" viewBox=\"0 0 240 240\">\n    <g class=\"a-pin\" stroke-width=\"7\" stroke-linecap=\"round\">\n      <path d=\"M70 44V22M110 44V22M150 44V22M190 44V22\"/>\n      <path d=\"M70 196v22M110 196v22M150 196v22M190 196v22\"/>\n      <path d=\"M44 70H22M44 110H22M44 150H22M44 190H22\"/>\n    </g>\n    <rect class=\"a-chip\" x=\"44\" y=\"44\" width=\"152\" height=\"152\" rx=\"12\" stroke-width=\"6\"/>\n    <rect class=\"a-recess\" x=\"74\" y=\"74\" width=\"92\" height=\"92\" rx=\"8\" stroke-width=\"4\"/>\n    <rect class=\"a-accent\" x=\"56\" y=\"56\" width=\"16\" height=\"16\" rx=\"3\"/>\n  </symbol>\n\n  <symbol id=\"art-warn\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 3.2 22.4 20.8H1.6Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linejoin=\"round\"/>\n    <path d=\"M12 9.4v4.6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\"/>\n    <circle cx=\"12\" cy=\"17.6\" r=\"1.35\" fill=\"currentColor\"/>\n  </symbol>\n\n  <symbol id=\"art-power\" viewBox=\"0 0 48 48\">\n    <path d=\"M32.6 11.7A15 15 0 1 1 15.4 11.7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n    <path d=\"M24 5.5V22\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"5\" stroke-linecap=\"round\"/>\n  </symbol>\n\n  <symbol id=\"art-cpu\" viewBox=\"0 0 240 240\">\n    <g class=\"a-pin\" stroke-width=\"7\" stroke-linecap=\"round\">\n      <path d=\"M70 40V18M105 40V18M140 40V18M175 40V18\"/>\n      <path d=\"M70 200v22M105 200v22M140 200v22M175 200v22\"/>\n      <path d=\"M40 70H18M40 105H18M40 140H18M40 175H18\"/>\n      <path d=\"M200 70h22M200 105h22M200 140h22M200 175h22\"/>\n    </g>\n    <rect class=\"a-part\" x=\"40\" y=\"40\" width=\"160\" height=\"160\" rx=\"10\" stroke-width=\"6\"/>\n    <rect class=\"a-face\" x=\"82\" y=\"82\" width=\"76\" height=\"76\" rx=\"6\" stroke-width=\"5\"/>\n    <rect class=\"a-accent\" x=\"54\" y=\"54\" width=\"18\" height=\"18\" rx=\"4\"/>\n  </symbol>\n\n  <symbol id=\"art-gpu\" viewBox=\"0 0 340 200\">\n    <rect class=\"a-part\" x=\"58\" y=\"34\" width=\"252\" height=\"130\" rx=\"10\" stroke-width=\"6\"/>\n    <circle class=\"a-face\" cx=\"140\" cy=\"99\" r=\"40\" stroke-width=\"5\"/>\n    <circle class=\"a-face\" cx=\"246\" cy=\"99\" r=\"40\" stroke-width=\"5\"/>\n    <g class=\"a-blade\" fill=\"none\" stroke-width=\"5\" stroke-linecap=\"round\">\n      <path d=\"M140 69v18M158 110l-18-11M122 110l18-11\"/>\n      <path d=\"M246 69v18M264 110l-18-11M228 110l18-11\"/>\n    </g>\n    <circle class=\"a-dark\" cx=\"140\" cy=\"99\" r=\"9\"/>\n    <circle class=\"a-dark\" cx=\"246\" cy=\"99\" r=\"9\"/>\n    <rect class=\"a-part\" x=\"16\" y=\"22\" width=\"42\" height=\"154\" rx=\"8\" stroke-width=\"6\"/>\n    <g class=\"a-recess\" stroke-width=\"4\">\n      <rect x=\"28\" y=\"46\" width=\"18\" height=\"42\" rx=\"4\"/>\n      <rect x=\"28\" y=\"106\" width=\"18\" height=\"42\" rx=\"4\"/>\n    </g>\n    <rect class=\"a-accent\" x=\"92\" y=\"164\" width=\"130\" height=\"16\" rx=\"4\"/>\n  </symbol>\n\n  <symbol id=\"art-ram\" viewBox=\"0 0 340 130\">\n    <rect class=\"a-part\" x=\"18\" y=\"20\" width=\"304\" height=\"72\" rx=\"8\" stroke-width=\"6\"/>\n    <g class=\"a-dark\">\n      <rect x=\"42\" y=\"38\" width=\"34\" height=\"36\" rx=\"4\"/>\n      <rect x=\"88\" y=\"38\" width=\"34\" height=\"36\" rx=\"4\"/>\n      <rect x=\"134\" y=\"38\" width=\"34\" height=\"36\" rx=\"4\"/>\n      <rect x=\"180\" y=\"38\" width=\"34\" height=\"36\" rx=\"4\"/>\n      <rect x=\"226\" y=\"38\" width=\"34\" height=\"36\" rx=\"4\"/>\n      <rect x=\"272\" y=\"38\" width=\"34\" height=\"36\" rx=\"4\"/>\n    </g>\n    <rect class=\"a-face\" x=\"40\" y=\"92\" width=\"82\" height=\"18\" rx=\"3\" stroke-width=\"4\"/>\n    <rect class=\"a-face\" x=\"146\" y=\"92\" width=\"172\" height=\"18\" rx=\"3\" stroke-width=\"4\"/>\n    <rect class=\"a-accent\" x=\"128\" y=\"90\" width=\"12\" height=\"22\" rx=\"3\"/>\n  </symbol>\n\n  <symbol id=\"art-ssd\" viewBox=\"0 0 340 130\">\n    <rect class=\"a-part\" x=\"52\" y=\"38\" width=\"256\" height=\"54\" rx=\"8\" stroke-width=\"6\"/>\n    <g class=\"a-dark\">\n      <rect x=\"90\" y=\"52\" width=\"52\" height=\"26\" rx=\"4\"/>\n      <rect x=\"154\" y=\"52\" width=\"52\" height=\"26\" rx=\"4\"/>\n      <rect x=\"218\" y=\"52\" width=\"34\" height=\"26\" rx=\"4\"/>\n    </g>\n    <rect class=\"a-face\" x=\"16\" y=\"46\" width=\"42\" height=\"38\" rx=\"4\" stroke-width=\"5\"/>\n    <rect class=\"a-accent\" x=\"24\" y=\"54\" width=\"10\" height=\"22\" rx=\"2\"/>\n    <circle class=\"a-accent\" cx=\"288\" cy=\"65\" r=\"11\"/>\n  </symbol>\n\n  <symbol id=\"art-camera\" viewBox=\"0 0 240 200\">\n    <rect class=\"a-part\" x=\"34\" y=\"46\" width=\"172\" height=\"110\" rx=\"26\" stroke-width=\"6\"/>\n    <circle class=\"a-face\" cx=\"120\" cy=\"101\" r=\"42\" stroke-width=\"5\"/>\n    <circle class=\"a-dark\" cx=\"120\" cy=\"101\" r=\"20\"/>\n    <circle class=\"a-accent\" cx=\"176\" cy=\"70\" r=\"9\"/>\n    <path class=\"a-pin\" d=\"M120 156v20M84 176h72\" fill=\"none\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n  </symbol>\n\n  <symbol id=\"art-keyboard\" viewBox=\"0 0 340 160\">\n    <rect class=\"a-part\" x=\"14\" y=\"26\" width=\"312\" height=\"108\" rx=\"12\" stroke-width=\"6\"/>\n    <g class=\"a-key\" stroke-width=\"4\">\n      <rect x=\"34\" y=\"44\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"68\" y=\"44\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"102\" y=\"44\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"136\" y=\"44\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"170\" y=\"44\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"204\" y=\"44\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"238\" y=\"44\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"272\" y=\"44\" width=\"34\" height=\"22\" rx=\"4\"/>\n      <rect x=\"34\" y=\"74\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"68\" y=\"74\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"102\" y=\"74\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"136\" y=\"74\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"170\" y=\"74\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"204\" y=\"74\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"238\" y=\"74\" width=\"68\" height=\"22\" rx=\"4\"/>\n      <rect x=\"34\" y=\"104\" width=\"46\" height=\"20\" rx=\"4\"/>\n      <rect x=\"88\" y=\"104\" width=\"164\" height=\"20\" rx=\"4\"/>\n      <rect x=\"260\" y=\"104\" width=\"46\" height=\"20\" rx=\"4\"/>\n    </g>\n  </symbol>\n\n  <symbol id=\"art-monitor\" viewBox=\"0 0 260 220\">\n    <rect class=\"a-part\" x=\"16\" y=\"18\" width=\"228\" height=\"146\" rx=\"12\" stroke-width=\"6\"/>\n    <rect class=\"a-dark\" x=\"38\" y=\"40\" width=\"184\" height=\"102\" rx=\"6\"/>\n    <rect class=\"a-part\" x=\"112\" y=\"164\" width=\"36\" height=\"28\" stroke-width=\"6\"/>\n    <rect class=\"a-part\" x=\"72\" y=\"188\" width=\"116\" height=\"18\" rx=\"8\" stroke-width=\"6\"/>\n    <circle class=\"a-accent\" cx=\"130\" cy=\"153\" r=\"6\"/>\n  </symbol>\n\n  <symbol id=\"art-speakers\" viewBox=\"0 0 240 200\">\n    <rect class=\"a-part\" x=\"26\" y=\"20\" width=\"76\" height=\"164\" rx=\"10\" stroke-width=\"6\"/>\n    <rect class=\"a-part\" x=\"138\" y=\"20\" width=\"76\" height=\"164\" rx=\"10\" stroke-width=\"6\"/>\n    <circle class=\"a-face\" cx=\"64\" cy=\"132\" r=\"26\" stroke-width=\"5\"/>\n    <circle class=\"a-face\" cx=\"176\" cy=\"132\" r=\"26\" stroke-width=\"5\"/>\n    <circle class=\"a-dark\" cx=\"64\" cy=\"132\" r=\"10\"/>\n    <circle class=\"a-dark\" cx=\"176\" cy=\"132\" r=\"10\"/>\n    <circle class=\"a-face\" cx=\"64\" cy=\"66\" r=\"14\" stroke-width=\"5\"/>\n    <circle class=\"a-face\" cx=\"176\" cy=\"66\" r=\"14\" stroke-width=\"5\"/>\n    <circle class=\"a-accent\" cx=\"64\" cy=\"168\" r=\"6\"/>\n  </symbol>\n\n  <symbol id=\"seat-cpu\" viewBox=\"0 0 1000 780\">\n    <rect class=\"a-part\" x=\"242\" y=\"112\" width=\"186\" height=\"186\" rx=\"8\" stroke-width=\"6\"/>\n    <rect class=\"a-face\" x=\"282\" y=\"152\" width=\"106\" height=\"106\" rx=\"6\" stroke-width=\"5\"/>\n    <rect class=\"a-accent\" x=\"254\" y=\"124\" width=\"22\" height=\"22\" rx=\"4\"/>\n    <g class=\"a-chip\" stroke-width=\"4\">\n      <rect x=\"286\" y=\"56\" width=\"46\" height=\"18\" rx=\"4\"/>\n      <rect x=\"342\" y=\"56\" width=\"46\" height=\"18\" rx=\"4\"/>\n    </g>\n  </symbol>\n\n  <symbol id=\"seat-ram\" viewBox=\"0 0 1000 780\">\n    <rect class=\"a-part\" x=\"706\" y=\"82\" width=\"42\" height=\"306\" rx=\"6\" stroke-width=\"6\"/>\n    <g class=\"a-dark\">\n      <rect x=\"714\" y=\"100\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"124\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"148\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"172\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"196\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"220\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"244\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"268\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"292\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"316\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"340\" width=\"26\" height=\"10\" rx=\"3\"/>\n    </g>\n    <g class=\"a-chip\" stroke-width=\"4\">\n      <rect x=\"706\" y=\"76\" width=\"42\" height=\"20\" rx=\"4\"/>\n      <rect x=\"706\" y=\"374\" width=\"42\" height=\"20\" rx=\"4\"/>\n    </g>\n  </symbol>\n\n  <symbol id=\"seat-gpu\" viewBox=\"0 0 1000 780\">\n    <g class=\"a-chip\" stroke-width=\"5\">\n      <rect x=\"400\" y=\"556\" width=\"54\" height=\"26\" rx=\"5\"/>\n      <rect x=\"466\" y=\"556\" width=\"54\" height=\"26\" rx=\"5\"/>\n    </g>\n    <rect class=\"a-part\" x=\"162\" y=\"578\" width=\"618\" height=\"98\" rx=\"8\" stroke-width=\"6\"/>\n    <rect class=\"a-face\" x=\"192\" y=\"598\" width=\"558\" height=\"58\" rx=\"5\" stroke-width=\"4\"/>\n    <path class=\"a-blade\" fill=\"none\" stroke-width=\"4\" stroke-linecap=\"round\" d=\"M212 606V648M246 606V648M280 606V648M314 606V648M348 606V648M382 606V648M416 606V648M450 606V648M484 606V648M518 606V648M552 606V648M586 606V648M620 606V648M654 606V648M688 606V648M722 606V648\"/>\n    <rect class=\"a-part\" x=\"136\" y=\"548\" width=\"26\" height=\"160\" rx=\"5\" stroke-width=\"6\"/>\n    <g class=\"a-recess\" stroke-width=\"4\">\n      <rect x=\"141\" y=\"574\" width=\"16\" height=\"44\" rx=\"3\"/>\n      <rect x=\"141\" y=\"638\" width=\"16\" height=\"44\" rx=\"3\"/>\n    </g>\n    <rect class=\"a-accent\" x=\"758\" y=\"612\" width=\"14\" height=\"30\" rx=\"3\"/>\n  </symbol>\n\n  <symbol id=\"seat-ssd\" viewBox=\"0 0 1000 780\">\n    <rect class=\"a-part\" x=\"222\" y=\"424\" width=\"168\" height=\"36\" rx=\"6\" stroke-width=\"6\"/>\n    <g class=\"a-dark\">\n      <rect x=\"242\" y=\"434\" width=\"34\" height=\"18\" rx=\"3\"/>\n      <rect x=\"286\" y=\"434\" width=\"34\" height=\"18\" rx=\"3\"/>\n      <rect x=\"330\" y=\"434\" width=\"24\" height=\"18\" rx=\"3\"/>\n    </g>\n    <rect class=\"a-socket\" x=\"200\" y=\"420\" width=\"34\" height=\"44\" rx=\"7\" stroke-width=\"6\"/>\n    <circle class=\"a-accent\" cx=\"380\" cy=\"442\" r=\"10\"/>\n  </symbol>\n\n</svg>\n\n<header class=\"topbar\">\n  <h1>Build the Machine</h1>\n  <div class=\"actions\">\n    <button type=\"button\" class=\"btn-run\" id=\"power\">\n      <svg class=\"btn-icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#art-power\"/></svg>\n      <span id=\"power-label\">Power on</span>\n    </button>\n    <button type=\"button\" class=\"btn-reset\" id=\"reset\">Reset</button>\n  </div>\n</header>\n\n<main class=\"layout\">\n\n  <section class=\"ports-wrap\" aria-labelledby=\"ports-label\">\n    <h2 class=\"rail-title\" id=\"ports-label\">Rear ports</h2>\n    <ul class=\"ports\" id=\"ports\"></ul>\n  </section>\n\n  <section class=\"stage-wrap\" aria-labelledby=\"stage-label\">\n    <h2 class=\"visually-hidden\" id=\"stage-label\">Motherboard</h2>\n    <div class=\"stage\" id=\"stage\">\n      <svg class=\"board\" viewBox=\"0 0 1000 780\" aria-hidden=\"true\" focusable=\"false\">\n        <use href=\"#art-board\"/>\n        <use class=\"seat\" id=\"seat-use-cpu\" href=\"#seat-cpu\"/>\n        <use class=\"seat\" id=\"seat-use-ram-1\" href=\"#seat-ram\"/>\n        <g class=\"seat\" id=\"seat-use-ram-2\" transform=\"translate(90 0)\"><use href=\"#seat-ram\"/></g>\n        <use class=\"seat\" id=\"seat-use-gpu\" href=\"#seat-gpu\"/>\n        <use class=\"seat\" id=\"seat-use-ssd\" href=\"#seat-ssd\"/>\n      </svg>\n      <div class=\"sockets\" id=\"sockets\"></div>\n      <div class=\"hotspots\" id=\"hotspots\"></div>\n      <button type=\"button\" class=\"board-tag\" id=\"board-tag\">Motherboard</button>\n    </div>\n  </section>\n\n  <section class=\"notes-wrap\" aria-labelledby=\"notes-label\">\n    <h2 class=\"rail-title\" id=\"notes-label\">Notes</h2>\n    <div class=\"notes\" id=\"notes\" aria-live=\"polite\">\n      <p class=\"status\" id=\"status\">Choose a part.</p>\n      <div class=\"note-body\" id=\"note-body\"></div>\n    </div>\n  </section>\n\n</main>\n\n<section class=\"bin-wrap\" aria-labelledby=\"bin-label\">\n  <h2 class=\"rail-title\" id=\"bin-label\">Parts</h2>\n  <ul class=\"bin\" id=\"bin\"></ul>\n</section>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": ":root {\n  --bg: #0B0A18;\n  --panel: #16142B;\n  --edge: #3D3877;\n  --line: #ACA8EA;\n  --text: #EDECF9;\n  --text-dim: #A9A5C9;\n  --accent: #FFA868;\n  --slot-open: #D8F25C;\n  --slot-lit: #6FCAFF;\n  --ok: #6FCAFF;\n  --warn: #FFC24A;\n  --on: #FF5449;\n  --radius: 12px;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  padding: clamp(10px, 2.5vw, 22px);\n  background-color: var(--bg);\n  color: var(--text);\n  font-family: \"Space Grotesk\", \"Geist\", \"Noto Sans\", system-ui, -apple-system, \"Segoe UI\", Arial, sans-serif;\n  font-size: 16px;\n  line-height: 1.4;\n}\n\n.sprite {\n  position: absolute;\n  width: 0;\n  height: 0;\n  overflow: hidden;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n/* Asset theming */\n\n.a-board { fill: #16142B; stroke: #6F67C9; }\n.a-hole { stroke: #6F67C9; }\n.a-trace { stroke: #4F49A0; }\n.a-chip { fill: #2E2A5C; stroke: #6F67C9; }\n.a-socket { fill: #241F46; stroke: #8B84D8; }\n.a-recess { fill: #0D0B1C; stroke: #6F67C9; }\n.a-accent { fill: var(--accent); }\n\n.a-part { fill: #ACA8EA; stroke: #14113A; }\n.a-face { fill: #E4E2F8; stroke: #14113A; }\n.a-dark { fill: #2A2652; }\n.a-pin { stroke: #8B84D8; }\n.a-blade { stroke: #14113A; }\n.a-key { fill: #E4E2F8; stroke: #14113A; }\n\n/* Header */\n\n.topbar {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px 16px;\n  margin-block-end: 14px;\n}\n\nh1 {\n  font-size: clamp(1.15rem, 3.5vw, 1.5rem);\n  margin: 0;\n  letter-spacing: -0.01em;\n}\n\n.status {\n  margin: 0 0 10px;\n  padding-block-end: 10px;\n  border-block-end: 1px solid var(--edge);\n  color: var(--text-dim);\n  font-size: 0.95rem;\n  min-height: 1.4em;\n}\n\n.status.is-good {\n  color: var(--ok);\n  font-weight: 700;\n}\n\n.status.is-bad {\n  color: var(--warn);\n  font-weight: 700;\n}\n\n/* Layout */\n\n.layout {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 14px;\n  align-items: start;\n}\n\n@media (min-width: 760px) {\n  .layout { grid-template-columns: 150px minmax(0, 1fr); }\n  .notes-wrap { grid-column: 1 / -1; }\n}\n\n@media (min-width: 1080px) {\n  .layout { grid-template-columns: 150px minmax(0, 1fr) minmax(220px, 280px); }\n  .notes-wrap { grid-column: auto; }\n}\n\n.stage {\n  position: relative;\n  background-color: var(--panel);\n  border: 1px solid var(--edge);\n  border-radius: var(--radius);\n  overflow: hidden;\n}\n\n.board {\n  display: block;\n  width: 100%;\n  height: auto;\n}\n\n.seat {\n  display: none;\n}\n\n.seat.is-in {\n  display: inline;\n}\n\n/* Part notes */\n\n.notes {\n  padding: 12px 14px;\n  border: 1px solid var(--edge);\n  border-radius: var(--radius);\n  background-color: var(--panel);\n  min-height: 9em;\n}\n\n.notes-art {\n  display: block;\n  width: 76px;\n  height: 46px;\n  margin-block-end: 8px;\n}\n\n.notes-category {\n  margin: 0;\n  font-size: 0.72rem;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  color: var(--accent);\n}\n\n.notes-name {\n  margin: 2px 0 6px;\n  font-size: 1.05rem;\n}\n\n.notes-text {\n  margin: 0;\n  color: var(--text);\n  font-size: 0.9rem;\n}\n\n.notes-intro {\n  margin: 0;\n  color: var(--text-dim);\n  font-size: 0.9rem;\n}\n\n.hotspots {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n}\n\n.hotspot {\n  position: absolute;\n  min-width: 34px;\n  min-height: 34px;\n  padding: 0;\n  border: 2px solid transparent;\n  border-radius: 14px;\n  background-color: transparent;\n  cursor: pointer;\n  pointer-events: auto;\n}\n\n.board-tag:hover {\n  background-color: #2E2A5C;\n}\n\n.board-tag {\n  position: absolute;\n  right: 3%;\n  bottom: 3.5%;\n  min-height: 30px;\n  padding: 5px 12px;\n  border: 1px solid var(--line);\n  border-radius: 999px;\n  background-color: #221F42;\n  color: var(--text);\n  font: inherit;\n  font-size: 0.75rem;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  cursor: pointer;\n}\n\n/* Socket targets */\n\n.sockets {\n  position: absolute;\n  inset: 0;\n}\n\n.socket {\n  position: absolute;\n  min-width: 34px;\n  min-height: 34px;\n  padding: 0;\n  border: 3px solid transparent;\n  border-radius: 8px;\n  background-color: transparent;\n  cursor: pointer;\n}\n\n.socket:hover,\n.hotspot:hover {\n  border-color: rgba(172, 168, 234, 0.7);\n  background-color: rgba(172, 168, 234, 0.14);\n}\n\n.socket.is-open {\n  border-color: var(--slot-open);\n  border-style: dashed;\n  border-width: 3px;\n  background-color: rgba(216, 242, 92, 0.22);\n  box-shadow: 0 0 0 4px rgba(216, 242, 92, 0.18);\n  animation: breathe 1.6s ease-in-out infinite;\n}\n\n.socket.is-open:hover {\n  border-color: var(--slot-open);\n  background-color: rgba(216, 242, 92, 0.3);\n}\n\n.socket.is-lit {\n  border-color: var(--slot-lit);\n  border-style: solid;\n  background-color: rgba(111, 202, 255, 0.22);\n  box-shadow: 0 0 0 4px rgba(111, 202, 255, 0.16);\n}\n\n@keyframes breathe {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.55; }\n}\n\n/* Rails */\n\n.rail-title {\n  font-size: 0.8rem;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  color: var(--text-dim);\n  margin: 0 0 8px;\n}\n\n.ports, .bin {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  gap: 8px;\n}\n\n.ports {\n  flex-wrap: wrap;\n}\n\n@media (min-width: 760px) {\n  .ports { flex-direction: column; }\n}\n\n.bin-wrap {\n  margin-block-start: 14px;\n}\n\n.bin {\n  flex-wrap: wrap;\n}\n\n.bin li, .ports li {\n  flex: 0 0 auto;\n}\n\n.chip {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 4px;\n  width: 104px;\n  min-height: 108px;\n  padding: 8px 6px;\n  border: 2px solid var(--edge);\n  border-radius: var(--radius);\n  background-color: var(--panel);\n  color: var(--text);\n  font: inherit;\n  font-size: 0.78rem;\n  cursor: pointer;\n}\n\n.chip[aria-pressed=\"true\"] {\n  border-color: var(--slot-open);\n  background-color: #262E15;\n}\n\n.chip.is-used {\n  border-style: dashed;\n  color: var(--text-dim);\n}\n\n.chip.is-used > svg {\n  opacity: 0.55;\n}\n\n.chip.is-broken {\n  border-color: var(--warn);\n  border-style: dashed;\n}\n\n.chip.is-broken > svg {\n  opacity: 0.5;\n}\n\n.is-broken-tag {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  color: var(--warn);\n  font-weight: 700;\n}\n\n.tag-icon {\n  width: 12px;\n  height: 12px;\n  flex: 0 0 auto;\n}\n\n.socket.is-broken {\n  border-color: var(--warn);\n  border-style: solid;\n  background-color: rgba(255, 194, 74, 0.14);\n}\n\n.socket-badge {\n  position: absolute;\n  inset-block-start: 2px;\n  inset-inline-end: 2px;\n  width: 17px;\n  height: 17px;\n  color: var(--warn);\n}\n\n.chip-tag {\n  font-size: 0.68rem;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  color: var(--text-dim);\n}\n\n.chip > svg {\n  width: 100%;\n  height: 44px;\n}\n\n.chip-name {\n  text-align: center;\n  line-height: 1.15;\n}\n\n.port {\n  width: 100%;\n  min-height: 56px;\n}\n\n.port.is-filled {\n  border-color: var(--line);\n}\n\n.port.is-open {\n  border-color: var(--slot-open);\n  border-style: dashed;\n  border-width: 3px;\n  background-color: rgba(216, 242, 92, 0.22);\n  animation: breathe 1.6s ease-in-out infinite;\n}\n\n.port .port-empty {\n  color: var(--text-dim);\n}\n\n/* Actions */\n\n.actions {\n  display: flex;\n  gap: 10px;\n  flex-wrap: wrap;\n}\n\n.btn-run, .btn-reset {\n  min-height: 48px;\n  padding: 10px 22px;\n  border-radius: 999px;\n  font: inherit;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n.btn-run {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  padding-inline-start: 16px;\n  border: 2px solid var(--ok);\n  background-color: var(--ok);\n  color: #04141E;\n}\n\n.btn-run.is-on {\n  border-color: var(--on);\n  background-color: var(--on);\n  color: #2B0704;\n}\n\n.btn-icon {\n  display: block;\n  width: 21px;\n  height: 21px;\n  flex: 0 0 auto;\n}\n\n.btn-reset {\n  border: 2px solid var(--edge);\n  background-color: transparent;\n  color: var(--text);\n}\n\n.btn-next {\n  min-height: 44px;\n  margin-block-start: 12px;\n  padding: 8px 18px;\n  border: 2px solid var(--ok);\n  border-radius: 999px;\n  background-color: transparent;\n  color: var(--ok);\n  font: inherit;\n  font-weight: 700;\n  cursor: pointer;\n}\n\nbutton:focus-visible {\n  outline: 3px solid var(--line);\n  outline-offset: 2px;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .socket.is-open,\n  .port.is-open {\n    animation: none;\n  }\n}",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const VIEW = { width: 1000, height: 780 };\n\nconst PARTS = [\n  { id: 'cpu', name: 'CPU', art: 'art-cpu', fits: ['cpu'], info: 'cpu' },\n  { id: 'ram-a', name: 'RAM', art: 'art-ram', fits: ['ram-1', 'ram-2'], info: 'ram' },\n  { id: 'ram-b', name: 'RAM', art: 'art-ram', fits: ['ram-1', 'ram-2'], info: 'ram' },\n  { id: 'gpu', name: 'GPU', art: 'art-gpu', fits: ['pcie'], info: 'gpu' },\n  { id: 'ssd', name: 'SSD', art: 'art-ssd', fits: ['m2'], info: 'ssd' },\n  { id: 'camera', name: 'Camera', art: 'art-camera', fits: ['port-in'], info: 'camera' },\n  { id: 'keyboard', name: 'Keyboard', art: 'art-keyboard', fits: ['port-in'], info: 'keyboard' },\n  { id: 'monitor', name: 'Monitor', art: 'art-monitor', fits: ['port-out'], info: 'monitor', display: true },\n  { id: 'speakers', name: 'Speakers', art: 'art-speakers', fits: ['port-out'], info: 'speakers' }\n];\n\nconst INFO = {\n  board: {\n    category: 'Connections',\n    text: 'The motherboard is the board that every other part plugs into. It does not think or store anything by itself. Its job is to carry power and information between the parts, along the thin copper lines printed across it.'\n  },\n  'rear-ports': {\n    category: 'Ports',\n    text: 'These are the plugs that stick out of the back of the machine. Every device outside the case connects through one of them, including keyboards, monitors, speakers, and network cables. Each plug is a different shape on purpose, so a cable only fits the one it belongs in.'\n  },\n  'slot-cpu': {\n    category: 'Slot',\n    text: 'This is where the CPU goes. Hundreds of tiny contacts inside the socket line up with matching points on the bottom of the chip. Each kind of CPU needs a socket built for it, so a CPU from one computer will not always fit another.'\n  },\n  'slot-ram': {\n    category: 'Slot',\n    text: 'RAM sticks go in these two long slots. The notch partway along the slot means a stick can only go in one way around, so it is hard to install backwards. Having two slots is what lets the CPU reach two sticks at once.'\n  },\n  'slot-drive': {\n    category: 'Slot',\n    text: 'An SSD goes in this short slot. The drive lies flat against the board instead of connecting with cables, which is one reason laptops can be built so thin.'\n  },\n  'slot-expansion': {\n    category: 'Slot',\n    text: 'This long slot holds an add-on card, most often a GPU. It is called an expansion slot because it lets you add an ability the board did not come with. Leave it empty and the computer still works.'\n  },\n  'ports-in': {\n    category: 'Ports',\n    text: 'These are plugs on the back of the computer for devices that send information in. A keyboard or a camera goes here. Anything plugged in on this side is giving the computer something to work with.'\n  },\n  'ports-out': {\n    category: 'Ports',\n    text: 'These are plugs on the back of the computer for devices that carry information out. A monitor or a set of speakers goes here. Anything plugged in on this side is showing you what the computer produced.'\n  },\n  chipset: {\n    category: 'Connections',\n    text: 'That chip is the chipset, and it is soldered to the board for good. It works like a traffic controller for information: whatever comes from the drive, the expansion slot, and the ports all passes through it on the way to the CPU. It decides what gets through and when, so the CPU is not interrupted by everything at once.'\n  },\n  cpu: {\n    category: 'Processing',\n    text: 'The CPU is the main chip that runs the computer. It reads instructions and carries them out one at a time, very fast. Every program you open depends on the CPU to do the work.'\n  },\n  ram: {\n    category: 'Memory',\n    text: 'RAM is the computer\\u2019s work space. Whatever you have open right now is held in RAM so the computer can reach it quickly. RAM is only temporary, so anything left in it disappears when the power goes off.'\n  },\n  'ram-second': {\n    category: 'Memory',\n    title: 'Second RAM stick',\n    text: 'You do not have to add a second stick, but it helps. Two sticks give the computer a bigger work space, so you can keep more programs and larger files open before things start to slow down. Two sticks also give the computer two paths to its memory instead of one, so information can move in and out faster.'\n  },\n  gpu: {\n    category: 'Processing',\n    text: 'The GPU is a second chip built for one job: doing a huge number of small calculations at the same time. The CPU is fast, but it works through tasks in order. Filling a screen with pixels takes millions of tiny calculations at once, so a GPU handles graphics and video much better than a CPU can.'\n  },\n  ssd: {\n    category: 'Storage',\n    text: 'The SSD is where files stay when the power is off. Your programs, photos, and documents all live here. When you open a file, the computer copies it from the SSD into RAM to work on it.'\n  },\n  camera: {\n    category: 'Input device',\n    text: 'A camera is an input device. Input devices bring information into the computer. A camera turns what it sees into a picture the computer can store.'\n  },\n  keyboard: {\n    category: 'Input device',\n    text: 'A keyboard is an input device. Input devices bring information into the computer. Each key you press is sent in as a letter, a number, or a command.'\n  },\n  monitor: {\n    category: 'Output device',\n    text: 'A monitor is an output device. Output devices send information from the computer back out to you. A monitor shows you the pictures and text the computer produces.'\n  },\n  speakers: {\n    category: 'Output device',\n    text: 'Speakers are an output device. Output devices send information from the computer back out to you. Speakers turn the computer\\u2019s signals into sound you can hear.'\n  }\n};\n\nconst FIXED = [\n  {\n    id: 'board',\n    name: 'Motherboard',\n    art: 'art-board',\n    info: 'board',\n    status: 'The motherboard is the base of the machine. It cannot be taken out.'\n  },\n  {\n    id: 'chipset',\n    name: 'Chipset',\n    art: 'art-chipset',\n    info: 'chipset',\n    status: 'The chipset is soldered to the board. It cannot be taken out.',\n    x: 550,\n    y: 420,\n    width: 140,\n    height: 140\n  },\n  {\n    id: 'rear-ports',\n    name: 'Rear ports',\n    info: 'rear-ports',\n    status: 'The rear ports are built into the board. They cannot be taken out.',\n    x: 18,\n    y: 70,\n    width: 120,\n    height: 320\n  }\n];\n\nconst SLOTS = [\n  { id: 'about-cpu', name: 'Processor socket', info: 'slot-cpu' },\n  { id: 'about-ram-1', name: 'Memory channel', info: 'slot-ram' },\n  { id: 'about-ram-2', name: 'Memory channel', info: 'slot-ram' },\n  { id: 'about-m2', name: 'Drive slot', info: 'slot-drive' },\n  { id: 'about-pcie', name: 'Expansion slot', info: 'slot-expansion' },\n  { id: 'about-port-in', name: 'Input ports', info: 'ports-in' },\n  { id: 'about-port-out', name: 'Output ports', info: 'ports-out' }\n];\n\nconst SOCKETS = [\n  { id: 'cpu', label: 'Processor socket', x: 200, y: 70, width: 270, height: 270, seat: 'seat-use-cpu' },\n  { id: 'ram-1', label: 'Memory channel 1', x: 700, y: 70, width: 54, height: 330, seat: 'seat-use-ram-1' },\n  { id: 'ram-2', label: 'Memory channel 2', x: 790, y: 70, width: 54, height: 330, seat: 'seat-use-ram-2' },\n  { id: 'm2', label: 'Drive slot', x: 200, y: 420, width: 200, height: 44, seat: 'seat-use-ssd' },\n  { id: 'pcie', label: 'Expansion slot', x: 150, y: 600, width: 560, height: 54, seat: 'seat-use-gpu' }\n];\n\nconst PORTS = [\n  { id: 'port-in', label: 'Input ports' },\n  { id: 'port-out', label: 'Output ports' }\n];\n\nconst STAGES = {\n  cpu: {\n    kind: 'step',\n    sockets: ['cpu'],\n    title: 'Power reaches the CPU',\n    text: 'Electricity reaches the board and the CPU starts up. It runs a small program stored on the board itself, and the first thing that program does is check which parts are installed.'\n  },\n  memory: {\n    kind: 'step',\n    sockets: ['ram-1', 'ram-2'],\n    title: 'The CPU checks the memory',\n    text: 'The CPU counts the RAM and tests it. Memory has to work before anything else can happen, because the operating system needs somewhere to run.'\n  },\n  drive: {\n    kind: 'step',\n    sockets: ['m2'],\n    title: 'The CPU finds the drive',\n    text: 'The CPU looks for a drive that holds an operating system, like Windows or ChromeOS. It finds the SSD and copies the operating system into RAM.'\n  }\n};\n\nconst DRAWN_BY = {\n  gpu: 'The operating system is now running in RAM. The GPU takes over drawing the picture, so games, video, and animation stay smooth.',\n  brokenGpu: 'The operating system is now running in RAM. The GPU in the expansion slot is damaged, so the CPU has to draw the picture by itself, which means graphics and video look choppy.',\n  cpu: 'The operating system is now running in RAM. You left the expansion slot empty, so the CPU has to draw the picture by itself, which means graphics and video look choppy.'\n};\n\nconst SHOWN_ON = {\n  display: {\n    title: 'The screen turns on',\n    text: 'The monitor lights up and the desktop appears.'\n  },\n  soundOnly: {\n    title: 'There is no screen',\n    text: 'The only thing in the output ports is a set of speakers. You can hear this computer, but you will never see what it is showing.'\n  },\n  nowhere: {\n    title: 'The picture has nowhere to go',\n    text: 'The output ports are empty, so that picture goes nowhere and nobody ever sees it.'\n  }\n};\n\nconst DRIVE_ERROR = {\n  display: 'The screen shows an error message instead of a desktop, so at least you can read what went wrong.',\n  noDisplay: 'The computer would put an error message on a screen, but there is nothing in the output ports to show it on. It just sits there stuck, with no way to tell you what is wrong.'\n};\n\nconst HALTS = {\n  brokenCpu: {\n    kind: 'fail',\n    sockets: [],\n    kicker: 'Startup stopped',\n    title: 'The CPU is not working',\n    text: 'Power reaches the board, but the CPU sitting in the socket is damaged and cannot run the startup program. Nothing else can happen without it. Press Reset to start over with undamaged parts.'\n  },\n  brokenMemory: {\n    kind: 'fail',\n    sockets: ['cpu'],\n    kicker: 'Startup stopped',\n    title: 'The memory is not working',\n    text: 'The CPU is running, but every stick of RAM on the board is damaged. There is nowhere to load the operating system, so startup stops here. Press Reset to start over with undamaged parts.'\n  },\n  brokenDrive: {\n    kind: 'fail',\n    sockets: ['cpu', 'ram-1', 'ram-2'],\n    kicker: 'Startup stopped',\n    title: 'The drive is not working',\n    text: 'The CPU and the memory are both fine, but the SSD in the drive slot is damaged, so there is no operating system to load. Press Reset to start over with undamaged parts.'\n  },\n  noCpu: {\n    kind: 'fail',\n    sockets: [],\n    kicker: 'Nothing happens',\n    title: 'The computer cannot start',\n    text: 'There is no CPU, so nothing is there to run the startup program. The fans might spin, but the computer never begins to start. Every other part is waiting for instructions that will never come.'\n  },\n  noMemory: {\n    kind: 'fail',\n    sockets: ['cpu'],\n    kicker: 'Startup stopped',\n    title: 'No memory found',\n    text: 'The CPU is running, but it cannot find any RAM. There is nowhere to load the operating system, so startup stops right here. A real computer beeps or blinks a light to tell you the memory is missing, because it has no screen to write an error on yet.'\n  },\n  noDrive: {\n    kind: 'fail',\n    sockets: ['cpu', 'ram-1', 'ram-2'],\n    kicker: 'Startup stopped',\n    title: 'No operating system found',\n    text: 'The CPU and the memory both work, but there is no drive holding an operating system. The computer is on, and it has nothing to run.'\n  }\n};\n\nconst ENDINGS = {\n  full: {\n    kind: 'done',\n    sockets: [],\n    kicker: 'Startup complete',\n    title: 'The computer is ready',\n    text: 'The computer finished starting up. You have a way to send information in and a way to get information back out, so a person can actually sit down and use this machine.'\n  },\n  noOutput: {\n    kind: 'done',\n    sockets: [],\n    kicker: 'Startup complete',\n    title: 'Running with nothing to show',\n    text: 'The computer finished starting up, but the output ports are empty. It is working away with no monitor and no speakers, so you have no way to see or hear what it is doing. Most computers in data centers run exactly like this, with no screen attached at all.'\n  },\n  noInput: {\n    kind: 'done',\n    sockets: [],\n    kicker: 'Startup complete',\n    title: 'Running with no way to control it',\n    text: 'The computer finished starting up and it can send information back out, but the input ports are empty. With no keyboard and no camera, there is no way to send anything into it. It will sit there running and doing nothing, because nothing can tell it what to do.'\n  },\n  noPorts: {\n    kind: 'done',\n    sockets: [],\n    kicker: 'Startup complete',\n    title: 'Running with no way to use it',\n    text: 'The computer finished starting up, but both port groups are empty. Nothing goes in and nothing comes out. The machine is working perfectly and it is completely cut off from you.'\n  }\n};\n\nfunction poweredOffNote() {\n  return {\n    kind: 'event',\n    sockets: [],\n    kicker: 'Power off',\n    title: 'You turned the computer off',\n    text: 'The moment the power stopped, everything being held in RAM disappeared. Anything that was saved to the SSD is still sitting there, waiting for the next time you start the computer up.'\n  };\n}\n\nfunction pulledCoreNote(name) {\n  return {\n    kind: 'event',\n    sockets: [],\n    kicker: 'Power lost',\n    title: 'The computer shuts off',\n    text: `You pulled the ${name} out while the power was on. Anything the computer was holding in RAM is gone, and nothing was saved. Parts inside a computer are only removed with the power off.`\n  };\n}\n\nfunction pulledGpuNote(name) {\n  return {\n    kind: 'event',\n    sockets: [],\n    kicker: 'Still running',\n    title: 'The screen goes dark',\n    text: `You pulled the ${name} out while the computer was running. The picture is gone, but the computer itself is still on and still working. You just took away the part that was drawing the screen.`\n  };\n}\n\nfunction coreAddedNote(name) {\n  return {\n    kind: 'event',\n    sockets: [],\n    kicker: 'Power lost',\n    title: 'That ruins the part',\n    text: `You pushed the ${name} into a live board. Electricity was already running through those contacts, and the ${name} did not survive it. In real life you might get lucky, or you might destroy the part and the board with it, which is why every repair guide tells you to unplug a computer before you open it.`\n  };\n}\n\nfunction portChangedNote(name) {\n  return {\n    kind: 'event',\n    sockets: [],\n    kicker: 'Still running',\n    title: 'The computer keeps running',\n    text: `You changed the ${name} while the computer was running, and it did not care at all. Devices that plug into the outside of a computer can come and go while it works. The parts inside cannot.`\n  };\n}\n\nconst INTRO = 'Choose a part below, then choose a glowing slot on the board. When you think the computer has what it needs, press Power on and read what happens. You can choose any slot, the chip in the middle, the ports along the back, or the Motherboard label to read about them.';\n\nconst state = {\n  held: null,\n  filled: {},\n  ports: {},\n  placedOrder: [],\n  note: null,\n  boot: null,\n  power: false,\n  damaged: []\n};\n\nconst els = {};\nconst numbers = new Intl.NumberFormat();\n\nfunction getPart(id) {\n  return PARTS.concat(FIXED).concat(SLOTS).filter(function (p) { return p.id === id; })[0];\n}\n\nfunction aboutId(id) {\n  return `about-${id}`;\n}\n\nfunction getSocket(id) {\n  return SOCKETS.filter(function (s) { return s.id === id; })[0];\n}\n\nfunction isDamaged(partId) {\n  return state.damaged.indexOf(partId) !== -1;\n}\n\nfunction markDamaged(partId) {\n  if (!isDamaged(partId)) {\n    state.damaged.push(partId);\n  }\n}\n\nfunction workingIn(socketId) {\n  const partId = state.filled[socketId];\n  return partId && !isDamaged(partId) ? partId : null;\n}\n\nfunction memorySockets() {\n  return ['ram-1', 'ram-2'];\n}\n\nfunction hasMemory() {\n  return memorySockets().some(function (id) { return Boolean(state.filled[id]); });\n}\n\nfunction outputParts() {\n  return state.ports['port-out'] || [];\n}\n\nfunction hasOutput() {\n  return outputParts().length > 0;\n}\n\nfunction hasDisplay() {\n  return outputParts().some(function (id) { return Boolean(getPart(id).display); });\n}\n\nfunction screenStep() {\n  const draw = workingIn('pcie')\n    ? DRAWN_BY.gpu\n    : (state.filled.pcie ? DRAWN_BY.brokenGpu : DRAWN_BY.cpu);\n  const shown = hasDisplay()\n    ? SHOWN_ON.display\n    : (hasOutput() ? SHOWN_ON.soundOnly : SHOWN_ON.nowhere);\n  return {\n    kind: 'step',\n    sockets: workingIn('pcie') ? ['pcie'] : [],\n    title: shown.title,\n    text: `${draw} ${shown.text}`\n  };\n}\n\nfunction driveHalt(base) {\n  const detail = hasDisplay() ? DRIVE_ERROR.display : DRIVE_ERROR.noDisplay;\n  return {\n    kind: base.kind,\n    sockets: base.sockets,\n    kicker: base.kicker,\n    title: base.title,\n    text: `${base.text} ${detail}`\n  };\n}\n\nfunction hasWorkingMemory() {\n  return memorySockets().some(function (id) { return Boolean(workingIn(id)); });\n}\n\nfunction recordPlacement(partId) {\n  if (state.placedOrder.indexOf(partId) === -1) {\n    state.placedOrder.push(partId);\n  }\n}\n\nfunction forgetPlacement(partId) {\n  const at = state.placedOrder.indexOf(partId);\n  if (at !== -1) {\n    state.placedOrder.splice(at, 1);\n  }\n}\n\nfunction getInfo(partId) {\n  const part = getPart(partId);\n  const sameKind = state.placedOrder.filter(function (id) {\n    return getPart(id).info === part.info;\n  });\n  const nth = sameKind.indexOf(partId);\n  const sequenced = INFO[`${part.info}-second`];\n  if (nth === 1 && sequenced) {\n    return sequenced;\n  }\n  return INFO[part.info];\n}\n\nfunction buildScript() {\n  if (!state.filled.cpu) {\n    return [HALTS.noCpu];\n  }\n  if (!workingIn('cpu')) {\n    return [HALTS.brokenCpu];\n  }\n  if (!hasMemory()) {\n    return [STAGES.cpu, HALTS.noMemory];\n  }\n  if (!hasWorkingMemory()) {\n    return [STAGES.cpu, HALTS.brokenMemory];\n  }\n  if (!state.filled.m2) {\n    return [STAGES.cpu, STAGES.memory, driveHalt(HALTS.noDrive)];\n  }\n  if (!workingIn('m2')) {\n    return [STAGES.cpu, STAGES.memory, driveHalt(HALTS.brokenDrive)];\n  }\n\n  const script = [STAGES.cpu, STAGES.memory, STAGES.drive, screenStep()];\n\n  const hasIn = Boolean((state.ports['port-in'] || []).length);\n  const hasOut = hasOutput();\n  if (hasIn && hasOut) {\n    script.push(ENDINGS.full);\n  } else if (hasIn) {\n    script.push(ENDINGS.noOutput);\n  } else if (hasOut) {\n    script.push(ENDINGS.noInput);\n  } else {\n    script.push(ENDINGS.noPorts);\n  }\n  return script;\n}\n\nfunction makeArt(artId) {\n  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');\n  svg.setAttribute('aria-hidden', 'true');\n  svg.setAttribute('focusable', 'false');\n  const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');\n  use.setAttribute('href', '#' + artId);\n  svg.appendChild(use);\n  return svg;\n}\n\nfunction say(message, tone) {\n  els.status.className = 'status';\n  if (tone) {\n    els.status.classList.add(tone);\n  }\n  els.status.textContent = message;\n}\n\nfunction isPlaced(partId) {\n  const inSockets = Object.keys(state.filled).some(function (k) {\n    return state.filled[k] === partId;\n  });\n  const inPorts = Object.keys(state.ports).some(function (k) {\n    return state.ports[k].indexOf(partId) !== -1;\n  });\n  return inSockets || inPorts;\n}\n\nfunction isLit(socketId) {\n  if (!state.boot || !state.power || !workingIn(socketId)) {\n    return false;\n  }\n  const through = Math.min(state.boot.step, state.boot.steps.length - 1);\n  for (let i = 0; i <= through; i += 1) {\n    if (state.boot.steps[i].sockets.indexOf(socketId) !== -1) {\n      return true;\n    }\n  }\n  return false;\n}\n\nfunction renderBin() {\n  els.bin.textContent = '';\n  PARTS.forEach(function (part) {\n    const li = document.createElement('li');\n    const btn = document.createElement('button');\n    btn.type = 'button';\n    btn.className = 'chip';\n    btn.dataset.partId = part.id;\n\n    const used = isPlaced(part.id);\n    const broken = isDamaged(part.id);\n    if (broken) {\n      btn.classList.add('is-broken');\n    }\n    if (used) {\n      btn.classList.add('is-used');\n    }\n    if (used || broken) {\n      btn.setAttribute('aria-label', broken\n        ? `${part.name} is damaged. Read what happened.`\n        : `${part.name} is placed. Read what it does again.`);\n    } else {\n      btn.setAttribute('aria-pressed', String(state.held === part.id));\n    }\n\n    btn.appendChild(makeArt(part.art));\n    const name = document.createElement('span');\n    name.className = 'chip-name';\n    name.textContent = part.name;\n    btn.appendChild(name);\n\n    if (broken) {\n      const tag = document.createElement('span');\n      tag.className = 'chip-tag is-broken-tag';\n      const icon = makeArt('art-warn');\n      icon.setAttribute('class', 'tag-icon');\n      tag.appendChild(icon);\n      const word = document.createElement('span');\n      word.textContent = 'Damaged';\n      tag.appendChild(word);\n      btn.appendChild(tag);\n    } else if (used) {\n      const tag = document.createElement('span');\n      tag.className = 'chip-tag';\n      tag.textContent = 'Placed';\n      btn.appendChild(tag);\n    }\n\n    li.appendChild(btn);\n    els.bin.appendChild(li);\n  });\n}\n\nfunction renderSockets() {\n  els.sockets.textContent = '';\n  SOCKETS.forEach(function (socket) {\n    const btn = document.createElement('button');\n    btn.type = 'button';\n    btn.className = 'socket';\n    btn.dataset.socketId = socket.id;\n    btn.style.left = (socket.x / VIEW.width * 100) + '%';\n    btn.style.top = (socket.y / VIEW.height * 100) + '%';\n    btn.style.width = (socket.width / VIEW.width * 100) + '%';\n    btn.style.height = (socket.height / VIEW.height * 100) + '%';\n\n    const filledBy = state.filled[socket.id];\n    if (filledBy && isDamaged(filledBy)) {\n      const brokenName = getPart(filledBy).name;\n      btn.classList.add('is-broken');\n      const badge = makeArt('art-warn');\n      badge.setAttribute('class', 'socket-badge');\n      btn.appendChild(badge);\n      btn.setAttribute('aria-label', `${socket.label} holds the ${brokenName}, which is damaged. Choose it to take the ${brokenName} back out.`);\n    } else if (filledBy) {\n      const heldName = getPart(filledBy).name;\n      btn.setAttribute('aria-label', `${socket.label} holds the ${heldName}. Choose it to take the ${heldName} back out.`);\n    } else if (state.held) {\n      btn.setAttribute('aria-label', `${socket.label} is empty.`);\n    } else {\n      btn.setAttribute('aria-label', `${socket.label} is empty. Choose it to read what it is.`);\n    }\n\n    if (state.held && !filledBy && getPart(state.held).fits.indexOf(socket.id) !== -1) {\n      btn.classList.add('is-open');\n    }\n    if (isLit(socket.id)) {\n      btn.classList.add('is-lit');\n    }\n\n    els.sockets.appendChild(btn);\n  });\n}\n\nfunction buildHotspots() {\n  FIXED.forEach(function (item) {\n    if (typeof item.x !== 'number') {\n      return;\n    }\n    const btn = document.createElement('button');\n    btn.type = 'button';\n    btn.className = 'hotspot';\n    btn.dataset.fixedId = item.id;\n    btn.style.left = (item.x / VIEW.width * 100) + '%';\n    btn.style.top = (item.y / VIEW.height * 100) + '%';\n    btn.style.width = (item.width / VIEW.width * 100) + '%';\n    btn.style.height = (item.height / VIEW.height * 100) + '%';\n    btn.setAttribute('aria-label', `${item.name}. Read what it does.`);\n    els.hotspots.appendChild(btn);\n  });\n}\n\nfunction renderSeats() {\n  SOCKETS.forEach(function (socket) {\n    const node = document.getElementById(socket.seat);\n    if (node) {\n      node.classList.toggle('is-in', Boolean(state.filled[socket.id]));\n    }\n  });\n}\n\nfunction renderPorts() {\n  els.ports.textContent = '';\n  PORTS.forEach(function (port) {\n    const li = document.createElement('li');\n    const btn = document.createElement('button');\n    btn.type = 'button';\n    btn.className = 'chip port';\n    btn.dataset.portId = port.id;\n\n    const held = state.ports[port.id] || [];\n    if (held.length) {\n      btn.classList.add('is-filled');\n      held.forEach(function (partId) {\n        btn.appendChild(makeArt(getPart(partId).art));\n      });\n      const names = held.map(function (partId) { return getPart(partId).name; });\n      btn.setAttribute('aria-label', `${port.label} is connected to: ${names.join(', ')}.`);\n    } else {\n      const label = document.createElement('span');\n      label.className = 'chip-name port-empty';\n      label.textContent = port.label;\n      btn.appendChild(label);\n      btn.setAttribute('aria-label', state.held\n        ? `${port.label} have nothing connected.`\n        : `${port.label} have nothing connected. Choose it to read what it is.`);\n    }\n\n    if (state.held && getPart(state.held).fits.indexOf(port.id) !== -1) {\n      btn.classList.add('is-open');\n    }\n\n    li.appendChild(btn);\n    els.ports.appendChild(li);\n  });\n}\n\nfunction addNote(category, title, text) {\n  const kicker = document.createElement('p');\n  kicker.className = 'notes-category';\n  kicker.textContent = category;\n  els.noteBody.appendChild(kicker);\n\n  const heading = document.createElement('h3');\n  heading.className = 'notes-name';\n  heading.textContent = title;\n  els.noteBody.appendChild(heading);\n\n  const body = document.createElement('p');\n  body.className = 'notes-text';\n  body.textContent = text;\n  els.noteBody.appendChild(body);\n}\n\nfunction renderBootNote() {\n  const steps = state.boot.steps;\n  const entry = steps[state.boot.step];\n  const numbered = steps.filter(function (s) {\n    return s.kind === 'step' || s.kind === 'fail';\n  });\n\n  if (entry.kind === 'step') {\n    const place = numbered.indexOf(entry) + 1;\n    addNote(`Step ${numbers.format(place)} of ${numbers.format(numbered.length)}`, entry.title, entry.text);\n  } else {\n    addNote(entry.kicker, entry.title, entry.text);\n  }\n\n  const upNext = steps[state.boot.step + 1];\n  if (!upNext) {\n    return;\n  }\n\n  const next = document.createElement('button');\n  next.type = 'button';\n  next.className = 'btn-next';\n  next.id = 'next';\n  next.textContent = upNext.kind === 'step' ? 'Next step' : 'See what happens';\n  els.noteBody.appendChild(next);\n}\n\nfunction renderNotes() {\n  els.noteBody.textContent = '';\n\n  if (!state.note && state.boot) {\n    renderBootNote();\n    return;\n  }\n\n  if (!state.note) {\n    const intro = document.createElement('p');\n    intro.className = 'notes-intro';\n    intro.textContent = INTRO;\n    els.noteBody.appendChild(intro);\n    return;\n  }\n\n  const part = getPart(state.note);\n  const info = getInfo(state.note);\n\n  if (part.art) {\n    const art = makeArt(part.art);\n    art.setAttribute('class', 'notes-art');\n    els.noteBody.appendChild(art);\n  }\n\n  addNote(info.category, info.title || part.name, info.text);\n\n  if (state.boot) {\n    const entry = state.boot.steps[state.boot.step];\n    const stepsRemain = state.boot.step + 1 < state.boot.steps.length;\n    if (entry.kind === 'step' && stepsRemain) {\n      const back = document.createElement('button');\n      back.type = 'button';\n      back.className = 'btn-next';\n      back.id = 'resume';\n      back.textContent = 'Continue startup';\n      els.noteBody.appendChild(back);\n    }\n  }\n}\n\nfunction renderPowerButton() {\n  els.powerLabel.textContent = state.power ? 'Power off' : 'Power on';\n  els.power.classList.toggle('is-on', state.power);\n}\n\nfunction render() {\n  renderPowerButton();\n  renderBin();\n  renderSockets();\n  renderSeats();\n  renderPorts();\n  renderNotes();\n}\n\nfunction interrupt(note, keepPower) {\n  const kept = state.boot.steps.slice(0, state.boot.step + 1);\n  state.boot = { steps: kept.concat([note]), step: kept.length };\n  state.note = null;\n  state.power = keepPower;\n}\n\nfunction isPoweredOn() {\n  return state.power;\n}\n\nfunction partsIn(portId) {\n  return (state.ports[portId] || []).map(function (id) { return getPart(id).name; });\n}\n\nfunction slotStatus(targetId) {\n  const socket = getSocket(targetId);\n  if (socket) {\n    const filledBy = state.filled[targetId];\n    if (!filledBy) {\n      return `${socket.label} is empty.`;\n    }\n    return isDamaged(filledBy)\n      ? `${socket.label} holds the ${getPart(filledBy).name}, and it is damaged.`\n      : `${socket.label} holds the ${getPart(filledBy).name}.`;\n  }\n  const port = PORTS.filter(function (p) { return p.id === targetId; })[0];\n  const names = partsIn(targetId);\n  return names.length\n    ? `${port.label} are connected to: ${names.join(', ')}.`\n    : `${port.label} have nothing connected.`;\n}\n\nfunction statusFor(id) {\n  const fixed = FIXED.filter(function (f) { return f.id === id; })[0];\n  if (fixed) {\n    return fixed.status;\n  }\n  if (id.indexOf('about-') === 0) {\n    return slotStatus(id.slice('about-'.length));\n  }\n\n  const name = getPart(id).name;\n  const socket = SOCKETS.filter(function (s) { return state.filled[s.id] === id; })[0];\n  if (socket) {\n    return isDamaged(id)\n      ? `${socket.label} holds the ${name}, and it is damaged.`\n      : `${socket.label} holds the ${name}.`;\n  }\n  const port = PORTS.filter(function (p) {\n    return (state.ports[p.id] || []).indexOf(id) !== -1;\n  })[0];\n  if (port) {\n    return `${port.label} are connected to: ${partsIn(port.id).join(', ')}.`;\n  }\n  return isDamaged(id)\n    ? `The ${name} is damaged and is not in the machine.`\n    : `The ${name} is not in the machine yet.`;\n}\n\nfunction showNote(partId) {\n  if (!state.power) {\n    state.boot = null;\n  }\n  state.note = partId;\n  render();\n  say(statusFor(partId));\n}\n\nfunction pickUp(partId) {\n  state.held = state.held === partId ? null : partId;\n  state.note = partId;\n  render();\n  if (state.held) {\n    say(`You are holding the ${getPart(partId).name}. Choose a glowing slot.`);\n  } else {\n    say('You put the part down.');\n  }\n}\n\nfunction placeInSocket(socketId) {\n  const socket = getSocket(socketId);\n  const occupant = state.filled[socketId];\n  const running = isPoweredOn();\n\n  if (occupant) {\n    delete state.filled[socketId];\n    forgetPlacement(occupant);\n    const name = getPart(occupant).name;\n    if (running && socketId === 'pcie') {\n      interrupt(pulledGpuNote(name), true);\n      render();\n      say(`You pulled the ${name} out of a running computer.`, 'is-bad');\n      focusNext();\n      return;\n    }\n    if (running) {\n      interrupt(pulledCoreNote(name), false);\n      render();\n      say(`You pulled the ${name} out of a running computer.`, 'is-bad');\n      focusNext();\n      return;\n    }\n    state.boot = null;\n    if (state.note === occupant) {\n      state.note = null;\n    }\n    render();\n    say(`You pulled the ${name} back out.`);\n    return;\n  }\n\n  if (!state.held) {\n    showNote(aboutId(socketId));\n    return;\n  }\n\n  const part = getPart(state.held);\n  if (part.fits.indexOf(socketId) === -1) {\n    say(`The ${part.name} does not fit the ${socket.label.toLowerCase()}.`, 'is-bad');\n    return;\n  }\n\n  state.filled[socketId] = part.id;\n  state.held = null;\n  recordPlacement(part.id);\n\n  if (running) {\n    markDamaged(part.id);\n    interrupt(coreAddedNote(part.name), false);\n    render();\n    say(`The ${part.name} was damaged.`, 'is-bad');\n    focusNext();\n    return;\n  }\n\n  state.boot = null;\n  render();\n  say(`The ${part.name} is in.`, 'is-good');\n}\n\nfunction placeInPort(portId) {\n  const port = PORTS.filter(function (p) { return p.id === portId; })[0];\n  const held = state.ports[portId] || [];\n  const running = isPoweredOn();\n\n  if (!state.held) {\n    if (held.length) {\n      delete state.ports[portId];\n      held.forEach(forgetPlacement);\n      if (running) {\n        interrupt(portChangedNote(port.label.toLowerCase()), true);\n        render();\n        say('You unplugged that port while the computer was running.');\n        focusNext();\n        return;\n      }\n      state.boot = null;\n      if (held.indexOf(state.note) !== -1) {\n        state.note = null;\n      }\n      render();\n      say('You unplugged that port.');\n      return;\n    }\n    showNote(aboutId(portId));\n    return;\n  }\n\n  const part = getPart(state.held);\n  if (part.fits.indexOf(portId) === -1) {\n    say(`The ${part.name} does not belong in that port.`, 'is-bad');\n    return;\n  }\n\n  state.ports[portId] = held.concat([part.id]);\n  state.held = null;\n  recordPlacement(part.id);\n\n  if (running) {\n    interrupt(portChangedNote(port.label.toLowerCase()), true);\n    render();\n    say(`You plugged the ${part.name} into a running computer.`);\n    focusNext();\n    return;\n  }\n\n  state.boot = null;\n  render();\n  say(`The ${part.name} is plugged in.`, 'is-good');\n}\n\nfunction focusNext() {\n  const next = document.getElementById('next');\n  if (next) {\n    next.focus();\n  } else {\n    els.power.focus();\n  }\n}\n\nfunction powerOn() {\n  state.held = null;\n  state.note = null;\n  state.power = true;\n  state.boot = { steps: buildScript(), step: 0 };\n  render();\n  say('The power is on.');\n  focusNext();\n}\n\nfunction powerOff() {\n  state.held = null;\n  interrupt(poweredOffNote(), false);\n  render();\n  say('The power is off.');\n  els.power.focus();\n}\n\nfunction togglePower() {\n  if (state.power) {\n    powerOff();\n  } else {\n    powerOn();\n  }\n}\n\nfunction nextStep() {\n  if (!state.boot || state.boot.step + 1 >= state.boot.steps.length) {\n    return;\n  }\n  state.boot.step += 1;\n  state.note = null;\n  const entry = state.boot.steps[state.boot.step];\n  render();\n  if (entry.kind === 'fail') {\n    say('The computer did not finish starting up.', 'is-bad');\n  } else if (entry.kind === 'done') {\n    say('Startup is finished.', 'is-good');\n  }\n  focusNext();\n}\n\nfunction resetAll() {\n  state.held = null;\n  state.filled = {};\n  state.ports = {};\n  state.placedOrder = [];\n  state.note = null;\n  state.boot = null;\n  state.power = false;\n  state.damaged = [];\n  render();\n  say('Reset. Choose a part.');\n}\n\nfunction fail() {\n  const p = document.createElement('p');\n  p.className = 'status is-bad';\n  p.textContent = 'This activity could not start. Reload the page.';\n  document.body.insertBefore(p, document.body.firstChild);\n}\n\nfunction init() {\n  els.status = document.getElementById('status');\n  els.stage = document.getElementById('stage');\n  els.sockets = document.getElementById('sockets');\n  els.ports = document.getElementById('ports');\n  els.bin = document.getElementById('bin');\n  els.noteBody = document.getElementById('note-body');\n  els.boardTag = document.getElementById('board-tag');\n  els.powerLabel = document.getElementById('power-label');\n  els.hotspots = document.getElementById('hotspots');\n  els.power = document.getElementById('power');\n  els.reset = document.getElementById('reset');\n\n  const ok = Object.keys(els).every(function (k) { return Boolean(els[k]); });\n  if (!ok) {\n    fail();\n    return;\n  }\n\n  try {\n    els.bin.addEventListener('click', function (e) {\n      const btn = e.target.closest('.chip');\n      if (!btn) {\n        return;\n      }\n      const partId = btn.dataset.partId;\n      if (isPlaced(partId) || isDamaged(partId)) {\n        showNote(partId);\n        return;\n      }\n      pickUp(partId);\n    });\n    els.sockets.addEventListener('click', function (e) {\n      const btn = e.target.closest('.socket');\n      if (btn) {\n        placeInSocket(btn.dataset.socketId);\n      }\n    });\n    els.ports.addEventListener('click', function (e) {\n      const btn = e.target.closest('.port');\n      if (btn) {\n        placeInPort(btn.dataset.portId);\n      }\n    });\n    els.noteBody.addEventListener('click', function (e) {\n      if (e.target.closest('#resume')) {\n        state.note = null;\n        render();\n        focusNext();\n        return;\n      }\n      if (e.target.closest('.btn-next')) {\n        nextStep();\n      }\n    });\n    els.hotspots.addEventListener('click', function (e) {\n      const btn = e.target.closest('.hotspot');\n      if (btn) {\n        showNote(btn.dataset.fixedId);\n      }\n    });\n    els.boardTag.addEventListener('click', function () {\n      showNote('board');\n    });\n    els.power.addEventListener('click', togglePower);\n    els.reset.addEventListener('click', resetAll);\n\n    buildHotspots();\n    render();\n  } catch (error) {\n    fail();\n  }\n}\n\ninit();",
