"/>\n    <rect class=\"a-dark\" x=\"38\" y=\"40\" width=\"184\" height=\"102\" rx=\"6\"/>\n    <rect class=\"a-part\" x=\"112\" y=\"164\" width=\"36\" height=\"28\" stroke-width=\"6\"/>\n    <rect class=\"a-part\" x=\"72\" y=\"188\" width=\"116\" height=\"18\" rx=\"8\" stroke-width=\"6\"/>\n    <circle class=\"a-accent\" cx=\"130\" cy=\"153\" r=\"6\"/>\n  </symbol>\n\n  <symbol id=\"art-speakers\" viewBox=\"0 0 240 200\">\n    <rect class=\"a-part\" x=\"26\" y=\"20\" width=\"76\" height=\"164\" rx=\"10\" stroke-width=\"6\"/>\n    <rect class=\"a-part\" x=\"138\" y=\"20\" width=\"76\" height=\"164\" rx=\"10\" stroke-width=\"6\"/>\n    <circle class=\"a-face\" cx=\"64\" cy=\"132\" r=\"26\" stroke-width=\"5\"/>\n    <circle class=\"a-face\" cx=\"176\" cy=\"132\" r=\"26\" stroke-width=\"5\"/>\n    <circle class=\"a-dark\" cx=\"64\" cy=\"132\" r=\"10\"/>\n    <circle class=\"a-dark\" cx=\"176\" cy=\"132\" r=\"10\"/>\n    <circle class=\"a-face\" cx=\"64\" cy=\"66\" r=\"14\" stroke-width=\"5\"/>\n    <circle class=\"a-face\" cx=\"176\" cy=\"66\" r=\"14\" stroke-width=\"5\"/>\n    <circle class=\"a-accent\" cx=\"64\" cy=\"168\" r=\"6\"/>\n  </symbol>\n\n  <symbol id=\"seat-cpu\" viewBox=\"0 0 1000 780\">\n    <rect class=\"a-part\" x=\"242\" y=\"112\" width=\"186\" height=\"186\" rx=\"8\" stroke-width=\"6\"/>\n    <rect class=\"a-face\" x=\"282\" y=\"152\" width=\"106\" height=\"106\" rx=\"6\" stroke-width=\"5\"/>\n    <rect class=\"a-accent\" x=\"254\" y=\"124\" width=\"22\" height=\"22\" rx=\"4\"/>\n    <g class=\"a-chip\" stroke-width=\"4\">\n      <rect x=\"286\" y=\"56\" width=\"46\" height=\"18\" rx=\"4\"/>\n      <rect x=\"342\" y=\"56\" width=\"46\" height=\"18\" rx=\"4\"/>\n    </g>\n  </symbol>\n\n  <symbol id=\"seat-ram\" viewBox=\"0 0 1000 780\">\n    <rect class=\"a-part\" x=\"706\" y=\"82\" width=\"42\" height=\"306\" rx=\"6\" stroke-width=\"6\"/>\n    <g class=\"a-dark\">\n      <rect x=\"714\" y=\"100\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"124\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"148\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"172\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"196\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"220\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"244\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"268\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"292\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"316\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"340\" width=\"26\" height=\"10\" rx=\"3\"/>\n    </g>\n    <g class=\"a-chip\" stroke-width=\"4\">\n      <rect x=\"706\" y=\"76\" width=\"42\" height=\"20\" rx=\"4\"/>\n      <rect x=\"706\" y=\"374\" width=\"42\" height=\"20\" rx=\"4\"/>\n    </g>\n  </symbol>\n\n  <symbol id=\"seat-gpu\" viewBox=\"0 0 1000 780\">\n    <g class=\"a-chip\" stroke-width=\"5\">\n      <rect x=\"400\" y=\"556\" width=\"54\" height=\"26\" rx=\"5\"/>\n      <rect x=\"466\" y=\"556\" width=\"54\" height=\"26\" rx=\"5\"/>\n    </g>\n    <rect class=\"a-part\" x=\"162\" y=\"578\" width=\"618\" height=\"98\" rx=\"8\" stroke-width=\"6\"/>\n    <rect class=\"a-face\" x=\"192\" y=\"598\" width=\"558\" height=\"58\" rx=\"5\" stroke-width=\"4\"/>\n    <path class=\"a-blade\" fill=\"none\" stroke-width=\"4\" stroke-linecap=\"round\" d=\"M212 606V648M246 606V648M280 606V648M314 606V648M348 606V648M382 606V648M416 606V648M450 606V648M484 606V648M518 606V648M552 606V648M586 606V648M620 606V648M654 606V648M688 606V648M722 606V648\"/>\n    <rect class=\"a-part\" x=\"136\" y=\"548\" width=\"26\" height=\"160\" rx=\"5\" stroke-width=\"6\"/>\n    <g class=\"a-recess\" stroke-width=\"4\">\n      <rect x=\"141\" y=\"574\" width=\"16\" height=\"44\" rx=\"3\"/>\n      <rect x=\"141\" y=\"638\" width=\"16\" height=\"44\" rx=\"3\"/>\n    </g>\n    <rect class=\"a-accent\" x=\"758\" y=\"612\" width=\"14\" height=\"30\" rx=\"3\"/>\n  </symbol>\n\n  <symbol id=\"seat-hdd\" viewBox=\"0 0 1000 780\">\n    <path class=\"a-pin\" fill=\"none\" stroke-width=\"8\" stroke-linecap=\"round\" d=\"M900 498V484\"/>\n    <rect class=\"a-part\" x=\"750\" y=\"498\" width=\"200\" height=\"64\" rx=\"7\" stroke-width=\"6\"/>\n    <circle class=\"a-face\" cx=\"792\" cy=\"530\" r=\"22\" stroke-width=\"4\"/>\n    <circle class=\"a-dark\" cx=\"792\" cy=\"530\" r=\"7\"/>\n    <circle class=\"a-dark\" cx=\"922\" cy=\"512\" r=\"6\"/>\n    <path class=\"a-blade\" fill=\"none\" stroke-width=\"5\" stroke-linecap=\"round\" d=\"M920 514 822 526\"/>\n    <rect class=\"a-accent\" x=\"906\" y=\"544\" width=\"34\" height=\"9\" rx=\"3\"/>\n  </symbol>\n\n  <symbol id=\"seat-ssd\" viewBox=\"0 0 1000 780\">\n    <rect class=\"a-part\" x=\"222\" y=\"424\" width=\"168\" height=\"36\" rx=\"6\" stroke-width=\"6\"/>\n    <g class=\"a-dark\">\n      <rect x=\"242\" y=\"434\" width=\"34\" height=\"18\" rx=\"3\"/>\n      <rect x=\"286\" y=\"434\" width=\"34\" height=\"18\" rx=\"3\"/>\n      <rect x=\"330\" y=\"434\" width=\"24\" height=\"18\" rx=\"3\"/>\n    </g>\n    <rect class=\"a-socket\" x=\"200\" y=\"420\" width=\"34\" height=\"44\" rx=\"7\" stroke-width=\"6\"/>\n    <circle class=\"a-accent\" cx=\"380\" cy=\"442\" r=\"10\"/>\n  </symbol>\n\n</svg>\n\n<header class=\"topbar\">\n  <h1>Build the Machine</h1>\n  <div class=\"actions\">\n    <button type=\"button\" class=\"btn-run\" id=\"power\">\n      <svg class=\"btn-icon\" aria-hidden=\"true\" focusable=\"false\"><use href=\"#art-power\"/></svg>\n      <span id=\"power-label\">Power on</span>\n    </button>\n    <button type=\"button\" class=\"btn-reset\" id=\"reset\">Reset</button>\n  </div>\n</header>\n\n<p class=\"status\" id=\"status\" role=\"status\">Pick a part.</p>\n\n<main class=\"layout\">\n\n  <section class=\"bin-wrap\" aria-labelledby=\"bin-label\">\n    <h2 class=\"rail-title\" id=\"bin-label\">Parts</h2>\n    <ul class=\"bin\" id=\"bin\"></ul>\n  </section>\n\n  <section class=\"stage-wrap\" aria-labelledby=\"stage-label\">\n    <h2 class=\"rail-title visually-hidden\" id=\"stage-label\">Motherboard</h2>\n    <div class=\"stage\" id=\"stage\">\n      <svg class=\"board\" viewBox=\"0 0 1000 780\" aria-hidden=\"true\" focusable=\"false\">\n        <use href=\"#art-board\"/>\n        <use class=\"seat\" id=\"seat-use-cpu\" href=\"#seat-cpu\"/>\n        <use class=\"seat\" id=\"seat-use-ram-1\" href=\"#seat-ram\"/>\n        <g class=\"seat\" id=\"seat-use-ram-2\" transform=\"translate(90 0)\"><use href=\"#seat-ram\"/></g>\n        <use class=\"seat\" id=\"seat-use-gpu\" href=\"#seat-gpu\"/>\n        <use class=\"seat\" id=\"seat-use-ssd\" href=\"#seat-ssd\"/>\n        <use class=\"seat\" id=\"seat-use-hdd\" href=\"#seat-hdd\"/>\n      </svg>\n      <div class=\"sockets\" id=\"sockets\"></div>\n      <div class=\"hotspots\" id=\"hotspots\"></div>\n      <button type=\"button\" class=\"board-tag\" id=\"board-tag\">Motherboard</button>\n    </div>\n    <div class=\"sortboard\" id=\"sortboard\" hidden></div>\n  </section>\n\n  <section class=\"notes-wrap\" aria-labelledby=\"notes-label\">\n    <h2 class=\"rail-title\" id=\"notes-label\">Notes</h2>\n    <div class=\"notes\" id=\"notes\">\n      <div class=\"note-body\" id=\"note-body\" aria-live=\"polite\"></div>\n    </div>\n  </section>\n\n</main>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
