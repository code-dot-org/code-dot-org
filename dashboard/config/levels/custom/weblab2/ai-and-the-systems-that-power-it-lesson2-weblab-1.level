          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Build the Machine</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n<script src=\"script.js\" defer></script>\n</head>\n<body>\n\n<svg class=\"sprite\" aria-hidden=\"true\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\">\n\n  <symbol id=\"art-board\" viewBox=\"0 0 1000 780\">\n    <rect class=\"a-board\" x=\"16\" y=\"16\" width=\"968\" height=\"748\" rx=\"22\" stroke-width=\"6\"/>\n    <g class=\"a-hole\" fill=\"none\" stroke-width=\"4\">\n      <circle cx=\"58\" cy=\"58\" r=\"10\"/>\n      <circle cx=\"942\" cy=\"58\" r=\"10\"/>\n      <circle cx=\"58\" cy=\"722\" r=\"10\"/>\n      <circle cx=\"942\" cy=\"722\" r=\"10\"/>\n    </g>\n    <g class=\"a-trace\" fill=\"none\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <path d=\"M176 124 H200\"/>\n      <path d=\"M176 228 H200\"/>\n      <path d=\"M176 354 H188 V566 H430 V520 H560\"/>\n      <path d=\"M176 458 H196 V582 H452 V534 H560\"/>\n      <path d=\"M470 140 H620 V100 H700\"/>\n      <path d=\"M470 220 H650 V230 H700\"/>\n      <path d=\"M340 340 V420 H520 V470 H560\"/>\n      <path d=\"M620 550 V600\"/>\n      <path d=\"M680 470 H817 V400\"/>\n      <path d=\"M586 460 H654 M586 486 H654 M586 512 H654\"/>\n      <path d=\"M680 520 H920 V484\"/>\n    </g>\n    <g class=\"a-chip\" stroke-width=\"4\">\n      <rect x=\"560\" y=\"430\" width=\"120\" height=\"120\" rx=\"12\"/>\n    </g>\n    <g class=\"a-socket\" stroke-width=\"6\">\n      <rect x=\"20\" y=\"76\" width=\"156\" height=\"96\" rx=\"9\"/>\n      <rect x=\"20\" y=\"180\" width=\"156\" height=\"96\" rx=\"9\"/>\n      <rect x=\"20\" y=\"306\" width=\"156\" height=\"96\" rx=\"9\"/>\n      <rect x=\"20\" y=\"410\" width=\"156\" height=\"96\" rx=\"9\"/>\n      <rect x=\"200\" y=\"70\" width=\"270\" height=\"270\" rx=\"10\"/>\n      <rect x=\"7