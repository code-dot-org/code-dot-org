        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Build the Machine</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n<script src=\"script.js\" defer></script>\n</head>\n<body>\n\n<svg class=\"sprite\" aria-hidden=\"true\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\">\n\n  <symbol id=\"art-board\" viewBox=\"0 0 1000 780\">\n    <rect class=\"a-board\" x=\"16\" y=\"16\" width=\"968\" height=\"748\" rx=\"22\" stroke-width=\"6\"/>\n    <g class=\"a-hole\" fill=\"none\" stroke-width=\"4\">\n      <circle cx=\"58\" cy=\"58\" r=\"10\"/>\n      <circle cx=\"942\" cy=\"58\" r=\"10\"/>\n      <circle cx=\"58\" cy=\"722\" r=\"10\"/>\n      <circle cx=\"942\" cy=\"722\" r=\"10\"/>\n    </g>\n    <g class=\"a-trace\" fill=\"none\" stroke-width=\"4\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n      <path d=\"M130 105 H166 V200 H200\"/>\n      <path d=\"M130 300 H168 V262 H200\"/>\n      <path d=\"M470 140 H620 V100 H700\"/>\n      <path d=\"M470 220 H650 V230 H700\"/>\n      <path d=\"M340 340 V420 H520 V470 H560\"/>\n      <path d=\"M620 550 V600\"/>\n      <path d=\"M680 470 H862 V400\"/>\n      <path d=\"M586 460 H654 M586 486 H654 M586 512 H654\"/>\n    </g>\n    <g class=\"a-chip\" stroke-width=\"4\">\n      <rect x=\"40\" y=\"76\" width=\"90\" height=\"58\" rx=\"5\"/>\n      <rect x=\"40\" y=\"148\" width=\"90\" height=\"42\" rx=\"5\"/>\n      <rect x=\"40\" y=\"204\" width=\"64\" height=\"62\" rx=\"5\"/>\n      <rect x=\"40\" y=\"280\" width=\"90\" height=\"48\" rx=\"5\"/>\n      <rect x=\"40\" y=\"342\" width=\"64\" height=\"42\" rx=\"5\"/>\n      <rect x=\"560\" y=\"430\" width=\"120\" height=\"120\" rx=\"12\"/>\n    </g>\n    <g class=\"a-socket\" stroke-width=\"6\">\n      <rect x=\"200\" y=\"70\" width=\"270\" height=\"270\" rx=\"10\"/>\n      <rect x=\"700\" y=\"70\" width=\"54\" height=\"330\" rx=\"7\"/>\n      <rect x=\"790\" y=\"70\" width=\"54\" height=\"330\" rx=\"7\"/>\n      <rect x=\"200\" y=\"420\" width=\"200\" height=\"44\" rx=\"7\"/>\n      <rect x=\"150\" y=\"600\" width=\"560\" height=\"54\" rx=\"7\"/>\n    </g>\n    <g class=\"a-recess\" stroke-width=\"4\">\n      <rect x=\"238\" y=\"108\" width=\"194\" height=\"194\" rx=\"6\"/>\n      <rect x=\"714\" y=\"102\" width=\"26\" height=\"266\" rx=\"4\"/>\n      <rect x=\"804\" y=\"102\" width=\"26\" height=\"266\" rx=\"4\"/>\n      <rect x=\"216\" y=\"434\" width=\"146\" height=\"16\" rx=\"4\"/>\n      <rect x=\"168\" y=\"618\" width=\"90\" height=\"20\" rx=\"4\"/>\n      <rect x=\"276\" y=\"618\" width=\"416\" height=\"20\" rx=\"4\"/>\n    </g>\n    <g class=\"a-chip\" stroke-width=\"4\">\n      <rect x=\"286\" y=\"56\" width=\"46\" height=\"18\" rx=\"4\"/>\n      <rect x=\"342\" y=\"56\" width=\"46\" height=\"18\" rx=\"4\"/>\n      <rect x=\"706\" y=\"76\" width=\"42\" height=\"20\" rx=\"4\"/>\n      <rect x=\"706\" y=\"374\" width=\"42\" height=\"20\" rx=\"4\"/>\n      <rect x=\"796\" y=\"76\" width=\"42\" height=\"20\" rx=\"4\"/>\n      <rect x=\"796\" y=\"374\" width=\"42\" height=\"20\" rx=\"4\"/>\n      <rect x=\"712\" y=\"606\" width=\"34\" height=\"42\" rx=\"6\"/>\n    </g>\n    <g class=\"a-accent\">\n      <rect x=\"252\" y=\"122\" width=\"26\" height=\"26\" rx=\"4\"/>\n      <rect x=\"720\" y=\"222\" width=\"14\" height=\"30\" rx=\"3\"/>\n      <rect x=\"810\" y=\"222\" width=\"14\" height=\"30\" rx=\"3\"/>\n      <circle cx=\"380\" cy=\"442\" r=\"10\"/>\n      <rect x=\"264\" y=\"614\" width=\"8\" height=\"28\" rx=\"3\"/>\n    </g>\n  </symbol>\n\n  <symbol id=\"art-cpu\" viewBox=\"0 0 240 240\">\n    <g class=\"a-pin\" stroke-width=\"7\" stroke-linecap=\"round\">\n      <path d=\"M70 40V18M105 40V18M140 40V18M175 40V18\"/>\n      <path d=\"M70 200v22M105 200v22M140 200v22M175 200v22\"/>\n      <path d=\"M40 70H18M40 105H18M40 140H18M40 175H18\"/>\n      <path d=\"M200 70h22M200 105h22M200 140h22M200 175h22\"/>\n    </g>\n    <rect class=\"a-part\" x=\"40\" y=\"40\" width=\"160\" height=\"160\" rx=\"10\" stroke-width=\"6\"/>\n    <rect class=\"a-face\" x=\"82\" y=\"82\" width=\"76\" height=\"76\" rx=\"6\" stroke-width=\"5\"/>\n    <rect class=\"a-accent\" x=\"54\" y=\"54\" width=\"18\" height=\"18\" rx=\"4\"/>\n  </symbol>\n\n  <symbol id=\"art-gpu\" viewBox=\"0 0 340 200\">\n    <rect class=\"a-part\" x=\"58\" y=\"34\" width=\"252\" height=\"130\" rx=\"10\" stroke-width=\"6\"/>\n    <circle class=\"a-face\" cx=\"140\" cy=\"99\" r=\"40\" stroke-width=\"5\"/>\n    <circle class=\"a-face\" cx=\"246\" cy=\"99\" r=\"40\" stroke-width=\"5\"/>\n    <g class=\"a-blade\" fill=\"none\" stroke-width=\"5\" stroke-linecap=\"round\">\n      <path d=\"M140 69v18M158 110l-18-11M122 110l18-11\"/>\n      <path d=\"M246 69v18M264 110l-18-11M228 110l18-11\"/>\n    </g>\n    <circle class=\"a-dark\" cx=\"140\" cy=\"99\" r=\"9\"/>\n    <circle class=\"a-dark\" cx=\"246\" cy=\"99\" r=\"9\"/>\n    <rect class=\"a-part\" x=\"16\" y=\"22\" width=\"42\" height=\"154\" rx=\"8\" stroke-width=\"6\"/>\n    <g class=\"a-recess\" stroke-width=\"4\">\n      <rect x=\"28\" y=\"46\" width=\"18\" height=\"42\" rx=\"4\"/>\n      <rect x=\"28\" y=\"106\" width=\"18\" height=\"42\" rx=\"4\"/>\n    </g>\n    <rect class=\"a-accent\" x=\"92\" y=\"164\" width=\"130\" height=\"16\" rx=\"4\"/>\n  </symbol>\n\n  <symbol id=\"art-ram\" viewBox=\"0 0 340 130\">\n    <rect class=\"a-part\" x=\"18\" y=\"20\" width=\"304\" height=\"72\" rx=\"8\" stroke-width=\"6\"/>\n    <g class=\"a-dark\">\n      <rect x=\"42\" y=\"38\" width=\"34\" height=\"36\" rx=\"4\"/>\n      <rect x=\"88\" y=\"38\" width=\"34\" height=\"36\" rx=\"4\"/>\n      <rect x=\"134\" y=\"38\" width=\"34\" height=\"36\" rx=\"4\"/>\n      <rect x=\"180\" y=\"38\" width=\"34\" height=\"36\" rx=\"4\"/>\n      <rect x=\"226\" y=\"38\" width=\"34\" height=\"36\" rx=\"4\"/>\n      <rect x=\"272\" y=\"38\" width=\"34\" height=\"36\" rx=\"4\"/>\n    </g>\n    <rect class=\"a-face\" x=\"40\" y=\"92\" width=\"82\" height=\"18\" rx=\"3\" stroke-width=\"4\"/>\n    <rect class=\"a-face\" x=\"146\" y=\"92\" width=\"172\" height=\"18\" rx=\"3\" stroke-width=\"4\"/>\n    <rect class=\"a-accent\" x=\"128\" y=\"90\" width=\"12\" height=\"22\" rx=\"3\"/>\n  </symbol>\n\n  <symbol id=\"art-ssd\" viewBox=\"0 0 340 130\">\n    <rect class=\"a-part\" x=\"52\" y=\"38\" width=\"256\" height=\"54\" rx=\"8\" stroke-width=\"6\"/>\n    <g class=\"a-dark\">\n      <rect x=\"90\" y=\"52\" width=\"52\" height=\"26\" rx=\"4\"/>\n      <rect x=\"154\" y=\"52\" width=\"52\" height=\"26\" rx=\"4\"/>\n      <rect x=\"218\" y=\"52\" width=\"34\" height=\"26\" rx=\"4\"/>\n    </g>\n    <rect class=\"a-face\" x=\"16\" y=\"46\" width=\"42\" height=\"38\" rx=\"4\" stroke-width=\"5\"/>\n    <rect class=\"a-accent\" x=\"24\" y=\"54\" width=\"10\" height=\"22\" rx=\"2\"/>\n    <circle class=\"a-accent\" cx=\"288\" cy=\"65\" r=\"11\"/>\n  </symbol>\n\n  <symbol id=\"art-camera\" viewBox=\"0 0 240 200\">\n    <rect class=\"a-part\" x=\"34\" y=\"46\" width=\"172\" height=\"110\" rx=\"26\" stroke-width=\"6\"/>\n    <circle class=\"a-face\" cx=\"120\" cy=\"101\" r=\"42\" stroke-width=\"5\"/>\n    <circle class=\"a-dark\" cx=\"120\" cy=\"101\" r=\"20\"/>\n    <circle class=\"a-accent\" cx=\"176\" cy=\"70\" r=\"9\"/>\n    <path class=\"a-pin\" d=\"M120 156v20M84 176h72\" fill=\"none\" stroke-width=\"7\" stroke-linecap=\"round\"/>\n  </symbol>\n\n  <symbol id=\"art-keyboard\" viewBox=\"0 0 340 160\">\n    <rect class=\"a-part\" x=\"14\" y=\"26\" width=\"312\" height=\"108\" rx=\"12\" stroke-width=\"6\"/>\n    <g class=\"a-key\" stroke-width=\"4\">\n      <rect x=\"34\" y=\"44\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"68\" y=\"44\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"102\" y=\"44\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"136\" y=\"44\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"170\" y=\"44\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"204\" y=\"44\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"238\" y=\"44\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"272\" y=\"44\" width=\"34\" height=\"22\" rx=\"4\"/>\n      <rect x=\"34\" y=\"74\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"68\" y=\"74\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"102\" y=\"74\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"136\" y=\"74\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"170\" y=\"74\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"204\" y=\"74\" width=\"26\" height=\"22\" rx=\"4\"/>\n      <rect x=\"238\" y=\"74\" width=\"68\" height=\"22\" rx=\"4\"/>\n      <rect x=\"34\" y=\"104\" width=\"46\" height=\"20\" rx=\"4\"/>\n      <rect x=\"88\" y=\"104\" width=\"164\" height=\"20\" rx=\"4\"/>\n      <rect x=\"260\" y=\"104\" width=\"46\" height=\"20\" rx=\"4\"/>\n    </g>\n  </symbol>\n\n  <symbol id=\"art-monitor\" viewBox=\"0 0 260 220\">\n    <rect class=\"a-part\" x=\"16\" y=\"18\" width=\"228\" height=\"146\" rx=\"12\" stroke-width=\"6\"/>\n    <rect class=\"a-dark\" x=\"38\" y=\"40\" width=\"184\" height=\"102\" rx=\"6\"/>\n    <rect class=\"a-part\" x=\"112\" y=\"164\" width=\"36\" height=\"28\" stroke-width=\"6\"/>\n    <rect class=\"a-part\" x=\"72\" y=\"188\" width=\"116\" height=\"18\" rx=\"8\" stroke-width=\"6\"/>\n    <circle class=\"a-accent\" cx=\"130\" cy=\"153\" r=\"6\"/>\n  </symbol>\n\n  <symbol id=\"art-speakers\" viewBox=\"0 0 240 200\">\n    <rect class=\"a-part\" x=\"26\" y=\"20\" width=\"76\" height=\"164\" rx=\"10\" stroke-width=\"6\"/>\n    <rect class=\"a-part\" x=\"138\" y=\"20\" width=\"76\" height=\"164\" rx=\"10\" stroke-width=\"6\"/>\n    <circle class=\"a-face\" cx=\"64\" cy=\"132\" r=\"26\" stroke-width=\"5\"/>\n    <circle class=\"a-face\" cx=\"176\" cy=\"132\" r=\"26\" stroke-width=\"5\"/>\n    <circle class=\"a-dark\" cx=\"64\" cy=\"132\" r=\"10\"/>\n    <circle class=\"a-dark\" cx=\"176\" cy=\"132\" r=\"10\"/>\n    <circle class=\"a-face\" cx=\"64\" cy=\"66\" r=\"14\" stroke-width=\"5\"/>\n    <circle class=\"a-face\" cx=\"176\" cy=\"66\" r=\"14\" stroke-width=\"5\"/>\n    <circle class=\"a-accent\" cx=\"64\" cy=\"168\" r=\"6\"/>\n  </symbol>\n\n  <symbol id=\"seat-cpu\" viewBox=\"0 0 1000 780\">\n    <rect class=\"a-part\" x=\"242\" y=\"112\" width=\"186\" height=\"186\" rx=\"8\" stroke-width=\"6\"/>\n    <rect class=\"a-face\" x=\"282\" y=\"152\" width=\"106\" height=\"106\" rx=\"6\" stroke-width=\"5\"/>\n    <rect class=\"a-accent\" x=\"254\" y=\"124\" width=\"22\" height=\"22\" rx=\"4\"/>\n    <g class=\"a-chip\" stroke-width=\"4\">\n      <rect x=\"286\" y=\"56\" width=\"46\" height=\"18\" rx=\"4\"/>\n      <rect x=\"342\" y=\"56\" width=\"46\" height=\"18\" rx=\"4\"/>\n    </g>\n  </symbol>\n\n  <symbol id=\"seat-ram\" viewBox=\"0 0 1000 780\">\n    <rect class=\"a-part\" x=\"706\" y=\"82\" width=\"42\" height=\"306\" rx=\"6\" stroke-width=\"6\"/>\n    <g class=\"a-dark\">\n      <rect x=\"714\" y=\"100\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"124\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"148\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"172\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"196\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"220\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"244\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"268\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"292\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"316\" width=\"26\" height=\"10\" rx=\"3\"/>\n      <rect x=\"714\" y=\"340\" width=\"26\" height=\"10\" rx=\"3\"/>\n    </g>\n    <g class=\"a-chip\" stroke-width=\"4\">\n      <rect x=\"706\" y=\"76\" width=\"42\" height=\"20\" rx=\"4\"/>\n      <rect x=\"706\" y=\"374\" width=\"42\" height=\"20\" rx=\"4\"/>\n    </g>\n  </symbol>\n\n  <symbol id=\"seat-gpu\" viewBox=\"0 0 1000 780\">\n    <g class=\"a-chip\" stroke-width=\"5\">\n      <rect x=\"400\" y=\"556\" width=\"54\" height=\"26\" rx=\"5\"/>\n      <rect x=\"466\" y=\"556\" width=\"54\" height=\"26\" rx=\"5\"/>\n    </g>\n    <rect class=\"a-part\" x=\"162\" y=\"578\" width=\"618\" height=\"98\" rx=\"8\" stroke-width=\"6\"/>\n    <rect class=\"a-face\" x=\"192\" y=\"598\" width=\"558\" height=\"58\" rx=\"5\" stroke-width=\"4\"/>\n    <path class=\"a-blade\" fill=\"none\" stroke-width=\"4\" stroke-linecap=\"round\" d=\"M212 606V648M246 606V648M280 606V648M314 606V648M348 606V648M382 606V648M416 606V648M450 606V648M484 606V648M518 606V648M552 606V648M586 606V648M620 606V648M654 606V648M688 606V648M722 606V648\"/>\n    <rect class=\"a-part\" x=\"136\" y=\"548\" width=\"26\" height=\"160\" rx=\"5\" stroke-width=\"6\"/>\n    <g class=\"a-recess\" stroke-width=\"4\">\n      <rect x=\"141\" y=\"574\" width=\"16\" height=\"44\" rx=\"3\"/>\n      <rect x=\"141\" y=\"638\" width=\"16\" height=\"44\" rx=\"3\"/>\n    </g>\n    <rect class=\"a-accent\" x=\"758\" y=\"612\" width=\"14\" height=\"30\" rx=\"3\"/>\n  </symbol>\n\n  <symbol id=\"seat-ssd\" viewBox=\"0 0 1000 780\">\n    <rect class=\"a-part\" x=\"222\" y=\"424\" width=\"168\" height=\"36\" rx=\"6\" stroke-width=\"6\"/>\n    <g class=\"a-dark\">\n      <rect x=\"242\" y=\"434\" width=\"34\" height=\"18\" rx=\"3\"/>\n      <rect x=\"286\" y=\"434\" width=\"34\" height=\"18\" rx=\"3\"/>\n      <rect x=\"330\" y=\"434\" width=\"24\" height=\"18\" rx=\"3\"/>\n    </g>\n    <rect class=\"a-socket\" x=\"200\" y=\"420\" width=\"34\" height=\"44\" rx=\"7\" stroke-width=\"6\"/>\n    <circle class=\"a-accent\" cx=\"380\" cy=\"442\" r=\"10\"/>\n  </symbol>\n\n</svg>\n\n<header class=\"topbar\">\n  <h1>Build the Machine</h1>\n  <p class=\"status\" id=\"status\" role=\"status\" aria-live=\"polite\">Pick a part.</p>\n</header>\n\n<main class=\"layout\">\n\n  <section class=\"ports-wrap\" aria-labelledby=\"ports-label\">\n    <h2 class=\"rail-title\" id=\"ports-label\">Rear ports</h2>\n    <ul class=\"ports\" id=\"ports\"></ul>\n  </section>\n\n  <section class=\"stage-wrap\" aria-labelledby=\"stage-label\">\n    <h2 class=\"visually-hidden\" id=\"stage-label\">Motherboard</h2>\n    <div class=\"stage\" id=\"stage\">\n      <svg class=\"board\" viewBox=\"0 0 1000 780\" aria-hidden=\"true\" focusable=\"false\">\n        <use href=\"#art-board\"/>\n        <use class=\"seat\" id=\"seat-use-cpu\" href=\"#seat-cpu\"/>\n        <use class=\"seat\" id=\"seat-use-ram-1\" href=\"#seat-ram\"/>\n        <g class=\"seat\" id=\"seat-use-ram-2\" transform=\"translate(90 0)\"><use href=\"#seat-ram\"/></g>\n        <use class=\"seat\" id=\"seat-use-gpu\" href=\"#seat-gpu\"/>\n        <use class=\"seat\" id=\"seat-use-ssd\" href=\"#seat-ssd\"/>\n      </svg>\n      <div class=\"sockets\" id=\"sockets\"></div>\n    </div>\n  </section>\n\n</main>\n\n<section class=\"bin-wrap\" aria-labelledby=\"bin-label\">\n  <h2 class=\"rail-title\" id=\"bin-label\">Parts</h2>\n  <ul class=\"bin\" id=\"bin\"></ul>\n</section>\n\n<footer class=\"actions\">\n  <button type=\"button\" class=\"btn-run\" id=\"power\">Power on</button>\n  <button type=\"button\" class=\"btn-clear\" id=\"clear\">Clear</button>\n</footer>\n\n</body>\n</html>",
          "active": true,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": ":root {\n  --bg: #0B0A18;\n  --panel: #16142B;\n  --edge: #3D3877;\n  --line: #ACA8EA;\n  --text: #EDECF9;\n  --text-dim: #A9A5C9;\n  --accent: #FFA868;\n  --signal-open: #6FCAFF;\n  --signal-lit: #FFC24A;\n  --radius: 12px;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  padding: clamp(10px, 2.5vw, 22px);\n  background-color: var(--bg);\n  color: var(--text);\n  font-family: \"Space Grotesk\", \"Geist\", \"Noto Sans\", system-ui, -apple-system, \"Segoe UI\", Arial, sans-serif;\n  font-size: 16px;\n  line-height: 1.4;\n}\n\n.sprite {\n  position: absolute;\n  width: 0;\n  height: 0;\n  overflow: hidden;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n/* Asset theming */\n\n.a-board { fill: #16142B; stroke: #6F67C9; }\n.a-hole { stroke: #6F67C9; }\n.a-trace { stroke: #4F49A0; }\n.a-chip { fill: #2E2A5C; stroke: #6F67C9; }\n.a-socket { fill: #241F46; stroke: #8B84D8; }\n.a-recess { fill: #0D0B1C; stroke: #6F67C9; }\n.a-accent { fill: var(--accent); }\n\n.a-part { fill: #ACA8EA; stroke: #14113A; }\n.a-face { fill: #E4E2F8; stroke: #14113A; }\n.a-dark { fill: #2A2652; }\n.a-pin { stroke: #8B84D8; }\n.a-blade { stroke: #14113A; }\n.a-key { fill: #E4E2F8; stroke: #14113A; }\n\n/* Header */\n\n.topbar {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  gap: 6px 16px;\n  margin-block-end: 12px;\n}\n\nh1 {\n  font-size: clamp(1.15rem, 3.5vw, 1.5rem);\n  margin: 0;\n  letter-spacing: -0.01em;\n}\n\n.status {\n  margin: 0;\n  color: var(--text-dim);\n  font-size: 0.95rem;\n  min-height: 1.4em;\n}\n\n.status.is-good { color: var(--signal-open); }\n.status.is-bad { color: var(--signal-lit); }\n\n/* Layout */\n\n.layout {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 14px;\n  align-items: start;\n}\n\n@media (min-width: 760px) {\n  .layout { grid-template-columns: 150px minmax(0, 1fr); }\n}\n\n.stage {\n  position: relative;\n  background-color: var(--panel);\n  border: 1px solid var(--edge);\n  border-radius: var(--radius);\n  overflow: hidden;\n}\n\n.board {\n  display: block;\n  width: 100%;\n  height: auto;\n}\n\n.seat {\n  display: none;\n}\n\n.seat.is-in {\n  display: inline;\n}\n\n/* Socket targets */\n\n.sockets {\n  position: absolute;\n  inset: 0;\n}\n\n.socket {\n  position: absolute;\n  min-width: 34px;\n  min-height: 34px;\n  padding: 0;\n  border: 3px solid transparent;\n  border-radius: 8px;\n  background-color: transparent;\n  cursor: pointer;\n}\n\n.socket.is-open {\n  border-color: var(--signal-open);\n  border-style: dashed;\n  border-width: 3px;\n  background-color: rgba(111, 202, 255, 0.16);\n  animation: breathe 1.6s ease-in-out infinite;\n}\n\n.socket.is-lit {\n  border-color: var(--signal-lit);\n  border-style: solid;\n  background-color: rgba(255, 194, 74, 0.16);\n}\n\n@keyframes breathe {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0.55; }\n}\n\n/* Rails */\n\n.rail-title {\n  font-size: 0.8rem;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  color: var(--text-dim);\n  margin: 0 0 8px;\n}\n\n.ports, .bin {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  gap: 8px;\n}\n\n.ports {\n  flex-wrap: wrap;\n}\n\n@media (min-width: 760px) {\n  .ports { flex-direction: column; }\n}\n\n.bin-wrap {\n  margin-block-start: 14px;\n}\n\n.bin {\n  flex-wrap: wrap;\n}\n\n.bin li, .ports li {\n  flex: 0 0 auto;\n}\n\n.chip {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 4px;\n  width: 104px;\n  min-height: 92px;\n  padding: 8px 6px;\n  border: 2px solid var(--edge);\n  border-radius: var(--radius);\n  background-color: var(--panel);\n  color: var(--text);\n  font: inherit;\n  font-size: 0.78rem;\n  cursor: pointer;\n}\n\n.chip[aria-pressed=\"true\"] {\n  border-color: var(--signal-open);\n  background-color: #172A3A;\n}\n\n.chip.is-used {\n  opacity: 0.35;\n  cursor: default;\n}\n\n.chip svg {\n  width: 100%;\n  height: 44px;\n}\n\n.chip-name {\n  text-align: center;\n  line-height: 1.15;\n}\n\n.port {\n  width: 100%;\n  min-height: 56px;\n}\n\n.port.is-filled {\n  border-color: var(--line);\n}\n\n.port.is-open {\n  border-color: var(--signal-open);\n  border-style: dashed;\n  border-width: 3px;\n  background-color: rgba(111, 202, 255, 0.16);\n  animation: breathe 1.6s ease-in-out infinite;\n}\n\n.port .port-empty {\n  color: var(--text-dim);\n}\n\n/* Actions */\n\n.actions {\n  display: flex;\n  gap: 10px;\n  flex-wrap: wrap;\n  margin-block-start: 16px;\n}\n\n.btn-run, .btn-clear {\n  min-height: 48px;\n  padding: 10px 22px;\n  border-radius: var(--radius);\n  font: inherit;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n.btn-run {\n  flex: 1 1 200px;\n  border: 2px solid var(--signal-open);\n  background-color: var(--signal-open);\n  color: #04141E;\n}\n\n.btn-run[disabled] {\n  border-color: var(--edge);\n  background-color: transparent;\n  color: var(--text-dim);\n  cursor: default;\n}\n\n.btn-clear {\n  border: 2px solid var(--edge);\n  background-color: transparent;\n  color: var(--text);\n}\n\nbutton:focus-visible {\n  outline: 3px solid var(--line);\n  outline-offset: 2px;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .socket.is-open,\n  .port.is-open {\n    animation: none;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const VIEW = { width: 1000, height: 780 };\n\nconst PARTS = [\n  { id: 'cpu', name: 'CPU', art: 'art-cpu', fits: ['cpu'] },\n  { id: 'ram-a', name: 'RAM', art: 'art-ram', fits: ['ram-1', 'ram-2'] },\n  { id: 'ram-b', name: 'RAM', art: 'art-ram', fits: ['ram-1', 'ram-2'] },\n  { id: 'gpu', name: 'GPU', art: 'art-gpu', fits: ['pcie'] },\n  { id: 'ssd', name: 'SSD', art: 'art-ssd', fits: ['m2'] },\n  { id: 'camera', name: 'Camera', art: 'art-camera', fits: ['port-in'] },\n  { id: 'keyboard', name: 'Keyboard', art: 'art-keyboard', fits: ['port-in'] },\n  { id: 'monitor', name: 'Monitor', art: 'art-monitor', fits: ['port-out'] },\n  { id: 'speakers', name: 'Speakers', art: 'art-speakers', fits: ['port-out'] }\n];\n\nconst SOCKETS = [\n  { id: 'cpu', label: 'Processor socket', x: 200, y: 70, width: 270, height: 270, seat: 'seat-use-cpu' },\n  { id: 'ram-1', label: 'Memory channel 1', x: 700, y: 70, width: 54, height: 330, seat: 'seat-use-ram-1' },\n  { id: 'ram-2', label: 'Memory channel 2', x: 790, y: 70, width: 54, height: 330, seat: 'seat-use-ram-2' },\n  { id: 'm2', label: 'Drive slot', x: 200, y: 420, width: 200, height: 44, seat: 'seat-use-ssd' },\n  { id: 'pcie', label: 'Expansion slot', x: 150, y: 600, width: 560, height: 54, seat: 'seat-use-gpu' }\n];\n\nconst PORTS = [\n  { id: 'port-in', label: 'Input ports' },\n  { id: 'port-out', label: 'Output ports' }\n];\n\nconst REQUIRED = ['cpu', 'ram-1', 'm2'];\nconst TRACE_ORDER = ['m2', 'ram-1', 'cpu', 'pcie'];\n\nconst state = {\n  held: null,\n  filled: {},\n  ports: {},\n  running: false\n};\n\nconst els = {};\nconst reduced = window.matchMedia('(prefers-reduced-motion: reduce)');\n\nfunction getPart(id) {\n  return PARTS.filter(function (p) { return p.id === id; })[0];\n}\n\nfunction getSocket(id) {\n  return SOCKETS.filter(function (s) { return s.id === id; })[0];\n}\n\nfunction makeArt(artId) {\n  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');\n  svg.setAttribute('aria-hidden', 'true');\n  svg.setAttribute('focusable', 'false');\n  const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');\n  use.setAttribute('href', '#' + artId);\n  svg.appendChild(use);\n  return svg;\n}\n\nfunction say(message, tone) {\n  els.status.className = 'status';\n  if (tone) {\n    els.status.classList.add(tone);\n  }\n  els.status.textContent = message;\n}\n\nfunction isPlaced(partId) {\n  const inSockets = Object.keys(state.filled).some(function (k) {\n    return state.filled[k] === partId;\n  });\n  const inPorts = Object.keys(state.ports).some(function (k) {\n    return state.ports[k].indexOf(partId) !== -1;\n  });\n  return inSockets || inPorts;\n}\n\nfunction renderBin() {\n  els.bin.textContent = '';\n  PARTS.forEach(function (part) {\n    const li = document.createElement('li');\n    const btn = document.createElement('button');\n    btn.type = 'button';\n    btn.className = 'chip';\n    btn.dataset.partId = part.id;\n\n    const used = isPlaced(part.id);\n    btn.disabled = used;\n    if (used) {\n      btn.classList.add('is-used');\n    }\n    btn.setAttribute('aria-pressed', String(state.held === part.id));\n\n    btn.appendChild(makeArt(part.art));\n    const name = document.createElement('span');\n    name.className = 'chip-name';\n    name.textContent = part.name;\n    btn.appendChild(name);\n\n    li.appendChild(btn);\n    els.bin.appendChild(li);\n  });\n}\n\nfunction renderSockets() {\n  els.sockets.textContent = '';\n  SOCKETS.forEach(function (socket) {\n    const btn = document.createElement('button');\n    btn.type = 'button';\n    btn.className = 'socket';\n    btn.dataset.socketId = socket.id;\n    btn.style.left = (socket.x / VIEW.width * 100) + '%';\n    btn.style.top = (socket.y / VIEW.height * 100) + '%';\n    btn.style.width = (socket.width / VIEW.width * 100) + '%';\n    btn.style.height = (socket.height / VIEW.height * 100) + '%';\n\n    const filledBy = state.filled[socket.id];\n    if (filledBy) {\n      btn.setAttribute('aria-label', `${socket.label} holds the ${getPart(filledBy).name}.`);\n    } else {\n      btn.setAttribute('aria-label', `${socket.label} is empty.`);\n    }\n\n    if (state.held && !filledBy && getPart(state.held).fits.indexOf(socket.id) !== -1) {\n      btn.classList.add('is-open');\n    }\n\n    els.sockets.appendChild(btn);\n  });\n}\n\nfunction renderSeats() {\n  SOCKETS.forEach(function (socket) {\n    const node = document.getElementById(socket.seat);\n    if (node) {\n      node.classList.toggle('is-in', Boolean(state.filled[socket.id]));\n    }\n  });\n}\n\nfunction renderPorts() {\n  els.ports.textContent = '';\n  PORTS.forEach(function (port) {\n    const li = document.createElement('li');\n    const btn = document.createElement('button');\n    btn.type = 'button';\n    btn.className = 'chip port';\n    btn.dataset.portId = port.id;\n\n    const held = state.ports[port.id] || [];\n    if (held.length) {\n      btn.classList.add('is-filled');\n      held.forEach(function (partId) {\n        btn.appendChild(makeArt(getPart(partId).art));\n      });\n      const names = held.map(function (partId) { return getPart(partId).name; });\n      btn.setAttribute('aria-label', `${port.label} is connected to: ${names.join(', ')}.`);\n    } else {\n      const label = document.createElement('span');\n      label.className = 'chip-name port-empty';\n      label.textContent = port.label;\n      btn.appendChild(label);\n      btn.setAttribute('aria-label', `${port.label} has nothing connected.`);\n    }\n\n    if (state.held && getPart(state.held).fits.indexOf(port.id) !== -1) {\n      btn.classList.add('is-open');\n    }\n\n    li.appendChild(btn);\n    els.ports.appendChild(li);\n  });\n}\n\nfunction renderPower() {\n  const ready = REQUIRED.every(function (id) { return Boolean(state.filled[id]); });\n  els.power.disabled = !ready || state.running;\n}\n\nfunction render() {\n  renderBin();\n  renderSockets();\n  renderSeats();\n  renderPorts();\n  renderPower();\n}\n\nfunction pickUp(partId) {\n  state.held = state.held === partId ? null : partId;\n  render();\n  if (state.held) {\n    say(`You are holding the ${getPart(partId).name}. Pick a glowing slot.`);\n  } else {\n    say('You put the part down.');\n  }\n}\n\nfunction placeInSocket(socketId) {\n  const socket = getSocket(socketId);\n  const occupant = state.filled[socketId];\n\n  if (occupant) {\n    delete state.filled[socketId];\n    render();\n    say(`You pulled the ${getPart(occupant).name} back out.`);\n    return;\n  }\n  if (!state.held) {\n    say('Pick a part first.');\n    return;\n  }\n\n  const part = getPart(state.held);\n  if (part.fits.indexOf(socketId) === -1) {\n    say(`The ${part.name} does not fit the ${socket.label.toLowerCase()}.`, 'is-bad');\n    return;\n  }\n\n  state.filled[socketId] = part.id;\n  state.held = null;\n  render();\n  say(`The ${part.name} is in.`, 'is-good');\n}\n\nfunction placeInPort(portId) {\n  const held = state.ports[portId] || [];\n\n  if (!state.held) {\n    if (held.length) {\n      delete state.ports[portId];\n      render();\n      say('You unplugged that port.');\n      return;\n    }\n    say('Pick a part first.');\n    return;\n  }\n\n  const part = getPart(state.held);\n  if (part.fits.indexOf(portId) === -1) {\n    say(`The ${part.name} does not belong in that port.`, 'is-bad');\n    return;\n  }\n\n  state.ports[portId] = held.concat([part.id]);\n  state.held = null;\n  render();\n  say(`The ${part.name} is plugged in.`, 'is-good');\n}\n\nfunction litSockets() {\n  return TRACE_ORDER.filter(function (id) { return Boolean(state.filled[id]); });\n}\n\nfunction finishRun() {\n  const hasGpu = Boolean(state.filled.pcie);\n  state.running = false;\n  render();\n  if (hasGpu) {\n    say('The model ran in 12 seconds. The GPU did thousands of calculations at once.', 'is-good');\n  } else {\n    say('The model ran in 31 minutes. Without a GPU the CPU works through the math one step at a time.', 'is-bad');\n  }\n}\n\nfunction powerOn() {\n  if (state.running) {\n    return;\n  }\n  state.running = true;\n  render();\n  say('Running.');\n\n  const order = litSockets();\n  const buttons = order.map(function (id) {\n    return els.sockets.querySelector('[data-socket-id=\"' + id + '\"]');\n  });\n\n  if (reduced.matches) {\n    buttons.forEach(function (b) { if (b) { b.classList.add('is-lit'); } });\n    finishRun();\n    return;\n  }\n\n  let i = 0;\n  const timer = window.setInterval(function () {\n    if (i >= buttons.length) {\n      window.clearInterval(timer);\n      finishRun();\n      return;\n    }\n    if (buttons[i]) {\n      buttons[i].classList.add('is-lit');\n    }\n    i += 1;\n  }, 420);\n}\n\nfunction clearAll() {\n  state.held = null;\n  state.filled = {};\n  state.ports = {};\n  state.running = false;\n  render();\n  say('Cleared. Pick a part.');\n}\n\nfunction fail() {\n  const p = document.createElement('p');\n  p.className = 'status is-bad';\n  p.textContent = 'This activity could not start. Reload the page.';\n  document.body.insertBefore(p, document.body.firstChild);\n}\n\nfunction init() {\n  els.status = document.getElementById('status');\n  els.stage = document.getElementById('stage');\n  els.sockets = document.getElementById('sockets');\n  els.ports = document.getElementById('ports');\n  els.bin = document.getElementById('bin');\n  els.power = document.getElementById('power');\n  els.clear = document.getElementById('clear');\n\n  const ok = Object.keys(els).every(function (k) { return Boolean(els[k]); });\n  if (!ok) {\n    fail();\n    return;\n  }\n\n  try {\n    els.bin.addEventListener('click', function (e) {\n      const btn = e.target.closest('.chip');\n      if (btn && !btn.disabled) {\n        pickUp(btn.dataset.partId);\n      }\n    });\n    els.sockets.addEventListener('click', function (e) {\n      const btn = e.target.closest('.socket');\n      if (btn) {\n        placeInSocket(btn.dataset.socketId);\n      }\n    });\n    els.ports.addEventListener('click', function (e) {\n      const btn = e.target.closest('.port');\n      if (btn) {\n        placeInPort(btn.dataset.portId);\n      }\n    });\n    els.power.addEventListener('click', powerOn);\n    els.clear.addEventListener('click', clearAll);\n\n    render();\n  } catch (error) {\n    fail();\n  }\n}\n\ninit();",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    }
  },
