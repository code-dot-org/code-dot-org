    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html>\n<head>\n  <title>Plant Care Helper</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <h1>Plant Care Helper</h1>\n\n  <img id=\"plantImage\" src=\"plant.png\" alt=\"A small plant in a terracotta pot.\">\n    \n  <div id=\"textArea\"></div>\n\n  <button id=\"addSunlightButton\">Add Sunlight</button>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "body {\n  font-family: Arial, Helvetica, sans-serif;\n\n  color: #1f2937;\n  text-align: center;\n  padding: 32px 20px;\n}\n\nh1 {\n  color: #14532d;\n  margin-bottom: 20px;\n}\n\n#plantImage {\n  width: 180px;\n  height: auto;\n  display: block;\n  margin: 0 auto 20px;\n  transition: transform 0.3s ease;\n  padding-top: 30px;\n  padding-bottom: 30px;\n}\n\n#textArea {\n  margin: 0 auto 20px;\n  max-width: 420px;\n  min-height: 70px;\n  padding: 14px;\n  border: 2px solid #bbf7d0;\n  border-radius: 10px;\n  background-color: white;\n  color: #14532d;\n  font-size: 1rem;\n  line-height: 1.4;\n}\n\nbutton {\n  padding: 10px 16px;\n  border: 1px solid #a7f3d0;\n  border-radius: 8px;\n  background-color: #d1fae5;\n  color: #064e3b;\n  cursor: pointer;\n  font-weight: 600;\n  font-size: 1rem;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const sunlightButton = document.getElementById(\"addSunlightButton\");\nconst textArea = document.getElementById(\"textArea\");\nconst plantImage = document.getElementById(\"plantImage\");\n\nsunlightButton.addEventListener(\"click\", () => {\n  textArea.textContent = \"Your plant got more sunlight and looks happier!\";\n  plantImage.style.transform = \"scale(1.5)\";\n});",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
          "name": "plant.png",
          "contents": "",
          "folderId": "0",
