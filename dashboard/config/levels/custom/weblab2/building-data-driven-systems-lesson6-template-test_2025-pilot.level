          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Warming Center Finder</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n    <script src=\"script.js\" defer></script>\n  </head>\n  <body>\n    <header>\n      <h1>City Warming Centers</h1>\n      <p>Find a safe place to stay warm.</p>\n    </header>\n    \n    <main>\n      <section id=\"list\" class=\"center-list\">\n        </section>\n    </main>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// Data\nconst centers = [\n  { id: 1, name: \"Community Hall\", capacity: 50, isOpen: true },\n  { id: 2, name: \"Library Basement\", capacity: 20, isOpen: false },\n  { id: 3, name: \"High School Gym\", capacity: 200, isOpen: true },\n  { id: 4, name: \"Downtown Shelter\", capacity: 120, isOpen: true },\n  { id: 5, name: \"Eastside Rec Center\", capacity: 45, isOpen: false },\n  { id: 6, name: \"St. Mary's Church\", capacity: 30, isOpen: true },\n  { id: 7, name: \"Veterans Hall\", capacity: 80, isOpen: true },\n  { id: 8, name: \"Municipal Building\", capacity: 150, isOpen: false },\n  { id: 9, name: \"Fire Station No. 4\", capacity: 15, isOpen: true },\n  { id: 10, name: \"Westside YMCA\", capacity: 60, isOpen: true },\n  { id: 11, name: \"Salvation Army\", capacity: 100, isOpen: true },\n  { id: 12, name: \"Civic Center Lobby\", capacity: 250, isOpen: false }\n];\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": ":root {\n  --primary: #2c3e50;\n  --accent: #e67e22;\n  --bg: #f4f6f7;\n  --card-bg: #ffffff;\n  --text: #34495e;\n}\n\nbody {\n  font-family: 'Verdana', sans-serif;\n  margin: 0;\n  padding: 2rem;\n  background-color: var(--bg);\n  color: var(--text);\n}\n\nheader {\n  text-align: center;\n  margin-bottom: 2rem;\n}\n\nh1 {\n  color: var(--primary);\n  margin-bottom: 0.5rem;\n}\n\n.center-list {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));\n  gap: 1.5rem;\n  max-width: 1000px;\n  margin: 0 auto;\n}\n\n.card {\n  background: var(--card-bg);\n  border-radius: 8px;\n  padding: 1.5rem;\n  box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n  border-left: 5px solid var(--accent);\n}\n\n.card h3 {\n  margin-top: 0;\n  color: var(--primary);\n}\n\n.status {\n  font-weight: bold;\n  color: #27ae60;\n}\n\n.status.closed {\n  color: #c0392b;\n}",
          "folderId": "0",
          "active": false
        },
