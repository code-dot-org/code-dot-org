        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html> \n<html> \n \t<head>\n    <link rel=\"stylesheet\" href=\"nature.css\">\n\t</head>\n\t<body>\n    <!-- colors in nature content -->\n\t\t<h1>Colors in Nature</h1>\n\t\t\n    <h2>Red</h2>\n\t\t\n    <!-- 1) Using the file menu for reference, fix each of the image tags -->\n    \n    <img src=\"red.jpg\" alt=\"red sky\"> \n    \n    <p>Grant W. Goodge/ NOAA - Library of Congress - Public Domain</p>\n\t\t\n    <h2>Green</h2>\n\t\t\n    <img src=\"grass.jpg\" alt=\"green grass\"> \n    \n    <p>Jin Zan - Wikimedia Commons - CC-BY-SA</p>\n\t\t\n    <h2>Blue</h2>\n\t\t\n    <img src=\"blu.jpg\" alt=\"blue islands\">\n    \n    <p>MALIZ ONG - PublicDomainPicture.net - CC0 Public Domain</p>\n\t</body>\n</html>",
