  "properties": {
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Fetch Example: Countries</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n    <div class=\"container\">\n        <h1>Global Population Data</h1>\n\n        <div id=\"app-status\" class=\"status-text\">Status: Ready</div>\n\n        <button id=\"fetch-button\">\n            ▶ Load Country Data\n        </button>\n\n        <div id=\"data-output\" class=\"output-box\">\n            <p class=\"placeholder\">No data loaded yet.</p>\n        </div>\n    </div>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* General Page Layout */\nbody {\n    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\n    background-color: #f4f4f9;\n    color: #333;\n    display: flex;\n    justify-content: center;\n    padding-top: 50px;\n    margin: 0;\n}\n\n.container {\n    background: white;\n    width: 400px;\n    padding: 30px;\n    border-radius: 8px;\n    box-shadow: 0 4px 15px rgba(0,0,0,0.1);\n}\n\nh1 {\n    font-size: 1.5rem;\n    margin-top: 0;\n    text-align: center;\n}\n\n/* Status Text */\n.status-text {\n    font-weight: bold;\n    margin-bottom: 15px;\n    color: #555;\n    font-size: 0.9rem;\n    text-align: center;\n}\n\n/* Button Styling */\n#fetch-button {\n    width: 100%;\n    padding: 12px;\n    background-color: #007bff; /* Blue */\n    color: white;\n    border: none;\n    border-radius: 5px;\n    font-size: 1rem;\n    cursor: pointer;\n    transition: background 0.3s;\n}\n\n#fetch-button:hover {\n    background-color: #0056b3; /* Darker Blue */\n}\n\n/* Output Box Styling */\n.output-box {\n    margin-top: 20px;\n    border: 1px solid #e1e1e1;\n    border-radius: 5px;\n    padding: 15px;\n    background-color: #fafafa;\n    min-height: 100px;\n    max-height: 300px; /* Limits height */\n    overflow-y: auto;  /* Adds scrollbar if list is long */\n}\n\n.placeholder {\n    color: #999;\n    text-align: center;\n    font-style: italic;\n}\n\n/* Dynamic List Items (Created by JS) */\nul {\n    list-style-type: none;\n    padding: 0;\n    margin: 0;\n}\n\nli {\n    padding: 8px 0;\n    border-bottom: 1px solid #eee;\n    font-size: 0.95rem;\n    display: flex;\n    justify-content: space-between;\n}\n\nli:last-child {\n    border-bottom: none;\n}\n\n/* Error Message Class */\n.error-msg {\n    color: #dc3545; /* Red */\n    background-color: #ffe6e6;\n    padding: 10px;\n    border-radius: 4px;\n    border: 1px solid #ffcccc;\n    text-align: center;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const statusElement = document.getElementById('app-status');\nconst outputElement = document.getElementById('data-output');\nconst fetchBtn = document.getElementById('fetch-button');\n\nfetchBtn.addEventListener('click', () => {\n\n    statusElement.textContent = 'Status: Fetching data...';\n    outputElement.innerHTML = '<p class=\"placeholder\">Loading...</p>';\n\n    // 1. \n    fetch('https://restcountries.com/v3.1/all?fields=name,population')\n\n        // 2. \n        .then(response => {\n            return response.json();\n        })\n\n       // 3. \n        .then(data => {\n\n            statusElement.textContent = 'Status: Success! Loaded ' + data.length + ' countries.';\n\n            let htmlList = '<ul>';\n\n            data.forEach(country => {\n                const name = country.name.common;\n                const population = country.population.toLocaleString();\n\n                htmlList += '<li> <span>' + name + '</span> <strong>' + population + '</strong> </li>';\n            });\n\n            htmlList += '</ul>';\n\n            outputElement.innerHTML = htmlList;\n        })\n\n        // 4. \n        .catch(error => {\n            statusElement.textContent = 'Status: FAILED';\n            \n            outputElement.innerHTML = '<div class=\"error-msg\">' +  'Error: ' + error.message + '</div>';\n        });\n});",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "3"
      ]
    },
