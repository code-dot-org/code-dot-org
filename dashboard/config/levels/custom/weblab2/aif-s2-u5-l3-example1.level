    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "script.js",
          "language": "js",
          "contents": "const apiEndpoint = 'https://restcountries.com/v3.1/all?fields=name,population';\nconst statusElement = document.getElementById('app-status');\nconst outputElement = document.getElementById('data-output');\n\ndocument.getElementById('fetch-button').addEventListener('click', () => {\n\n    fetch(apiEndpoint)\n      // 1. Convert response to JSON\n      .then(response => {\n        statusElement.textContent = `Status: Response received (${response.status}).`;\n        // Removed: if (!response.ok) check\n        return response.json(); \n      })\n      \n     \n      // 2. Process and display the data (which is an array)\n      .then(data => {\n        const countries = data; \n        \n        statusElement.textContent = `Status: Success! Displaying ${countries.length} countries.`;\n        \n        // Start building the HTML output\n        let htmlList = `<h3>🌍 Populations for ${countries.length} Countries</h3> <ul>`;\n        \n        // Use .forEach() to loop through every country in the array\n        countries.forEach(country => {\n            const name = country.name.common;\n            const population = country.population;\n            htmlList += `<li>${name}: ${population}</li>`;\n        });\n        \n        htmlList += '</ul>';\n\n        // Update the output element\n        outputElement.innerHTML = htmlList;\n      })\n     \n      \n      // 3. Catch any error (NETWORK/HTTP/PARSING ERROR HANDLER)\n      .catch(error => {\n        // This block runs if any promise in the chain above is rejected\n        statusElement.textContent = `Status: FAILED!`;\n        outputElement.innerHTML = `<p style=\"color: red; padding: 10px;\">\n                                      <strong>Error Fetching Data:</strong> ${error.message}\n                                  </p>`;\n      });\n;\n});",
          "folderId": "0",
          "active": true
        },
        "2": {
          "id": "2",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n  </head>\n  <body>\n    \n    <div id=\"app-status\" style=\"font-weight: bold; margin-top: 10px;\">Status: Ready</div>\n    \n    <div id=\"data-output\" style=\"border: 1px dashed #444; padding: 10px; margin-top: 10px;\">\n    </div>\n\n    <button id=\"fetch-button\">▶ Get Population Data</button> \n\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "2",
        "1"
      ]
    }
  },
