  "properties": {
    "encrypted": "false",
    "long_instructions": "**Snippet 1: The Core `fetch` Promise Chain**\r\n\r\nThis example demonstrates how to use the browser's `fetch` API for network requests, utilizing the `.then()` for successful steps and the `.catch()` for handling failures in the asynchronous **Promise chain**.\r\n",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
    "ai_tutor_mode": "engineer",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "placeholderText": "",
