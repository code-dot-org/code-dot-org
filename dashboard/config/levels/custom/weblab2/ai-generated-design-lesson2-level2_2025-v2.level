<Weblab2>
  <config><![CDATA[{
  "published": true,
  "game_id": 74,
  "created_at": "2026-02-28T22:28:35.000Z",
  "level_num": "custom",
  "user_id": 19378,
  "properties": {
    "encrypted": "false",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "true",
    "widget_view": "true",
    "initial_view_mode": "preview",
    "ai_tutor_prompt_answer_types": [
      "ask"
    ],
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "placeholderText": "",
      "multipleChoiceOptions": [
        ""
      ],
      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false
    },
    "start_sources": {
      "folders": {
        "1": {
          "id": "1",
          "name": "assets",
          "parentId": "0",
          "open": true
        }
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Adopt-a-Pet</title>\n  <link rel=\"stylesheet\" href=\"styles.css\" />\n  <script defer src=\"controls.js\"></script>\n</head>\n\n<body>\n  <div class=\"layout\">\n    <!-- CONTROL PANEL -->\n    <aside class=\"controls\" aria-label=\"Design controls\">\n      <h2>Redesign Controls</h2>\n\n      <div class=\"control-group\">\n        <h3>Navigation</h3>\n\n        <label for=\"navPosition\">Nav position</label>\n        <select id=\"navPosition\">\n          <option value=\"bottom\">Bottom</option>\n          <option value=\"top\">Top</option>\n        </select>\n\n        <label for=\"navSize\">Nav size</label>\n        <input id=\"navSize\" type=\"range\" min=\"10\" max=\"20\" value=\"10\" />\n\n        <label>\n          <input id=\"showBack\" type=\"checkbox\" checked />\n          Show “Back”\n        </label>\n      </div>\n\n      <div class=\"control-group\">\n        <h3>Readability</h3>\n\n        <label for=\"textSize\">Text size</label>\n        <input id=\"textSize\" type=\"range\" min=\"8\" max=\"20\" value=\"10\" />\n\n        <label for=\"lineHeight\">Line spacing</label>\n        <input id=\"lineHeight\" type=\"range\" min=\"10\" max=\"18\" value=\"10\" />\n\n        <label for=\"spacing\">Spacing</label>\n        <input id=\"spacing\" type=\"range\" min=\"0\" max=\"28\" value=\"2\" />\n\n        <!-- NEW: Tap target size -->\n        <label for=\"tapSize\">Tap target size</label>\n        <input id=\"tapSize\" type=\"range\" min=\"0\" max=\"100\" value=\"50\" />\n      </div>\n\n      <div class=\"control-group\">\n        <h3>Color Contrast</h3>\n\n        <label for=\"contrast\">Contrast</label>\n        <input id=\"contrast\" type=\"range\" min=\"0\" max=\"100\" value=\"0\" />\n      </div>\n\n      <div class=\"control-group\">\n        <button id=\"reset\" type=\"button\">Reset to Bad</button>\n      </div>\n    </aside>\n\n    <!-- APP -->\n    <div class=\"app\" aria-label=\"Adopt a Pet App (Level 2)\">\n\n      <!-- Header -->\n      <header>\n        <div class=\"brand\">\n          <img src=\"assets/logo.png\" alt=\"PawPrint Shelter Logo\" />\n          <span>PawPrint Shelter</span>\n        </div>\n        <div class=\"header-links\">\n          <a href=\"#contact\">Contact</a>\n        </div>\n      </header>\n\n      <!-- Hero Section -->\n      <section class=\"hero\" aria-label=\"Hero\">\n        <img src=\"assets/hero-dog.jpg\" alt=\"Happy dog ready for adoption\" />\n        <div class=\"hero-copy\">\n          <h1>Adopt a Pet Today</h1>\n          <p>Find your new best friend. Browse our available pets below.</p>\n        </div>\n      </section>\n\n      <!-- Pet Grid (NO FILTERS) -->\n      <main aria-label=\"Pet listings\">\n        <!-- 1 -->\n        <article class=\"pet-card\" aria-label=\"Pet card: Rocky\">\n          <img src=\"assets/adopt-dog-1.jpg\" alt=\"Rocky the dog\" />\n          <h3>Rocky</h3>\n\n          <p class=\"meta\">Age: <span class=\"value\">2 years</span></p>\n          <p class=\"meta\"><span class=\"label\">Size</span>: <span class=\"value\">Large</span></p>\n          <p class=\"meta\">Good with kids: <span class=\"value\">Sometimes</span></p>\n\n          <p class=\"desc\">\n            Rocky is energetic and loves long walks, squeaky toys, meeting new people, playing fetch endlessly, and sitting right in the middle of wherever you are trying to walk because he thinks he is much smaller than he actually is and because he is convinced that being directly underfoot is the best possible way to stay close to you at all times even when you are clearly trying to do something else.\n          </p>\n\n          <div class=\"actions\" aria-label=\"Actions for Rocky\">\n            <details class=\"details\">\n              <summary>Details</summary>\n              <div class=\"details-body\">\n                <p><strong>Confirm:</strong> Rocky — Age: 2 years — Size: Large — Good with kids: Sometimes</p>\n                <p>\n                  Rocky is enthusiastic and friendly but can be bouncy and forgets his size, so he may do best with older kids who can handle a playful, energetic dog and who like being followed everywhere including the kitchen, hallway, and anywhere else you try to walk.\n                </p>\n              </div>\n            </details>\n            <button class=\"adopt\" type=\"button\" aria-label=\"Adopt Rocky\">Adopt</button>\n          </div>\n        </article>\n\n        <!-- 2 -->\n        <article class=\"pet-card\" aria-label=\"Pet card: Milo\">\n          <img src=\"assets/adopt-cat-2.jpg\" alt=\"Milo the cat\" />\n          <h3>Milo</h3>\n\n          <p class=\"meta\">Age: <span class=\"value\">6 months</span></p>\n          <p class=\"meta\"><span class=\"label\">Size</span>: <span class=\"value\">Small</span></p>\n          <p class=\"meta\">Good with kids: <span class=\"value\">Yes</span></p>\n\n          <p class=\"desc\">\n            Milo is playful, curious, and always exploring, he loves chasing toy mice, climbing onto shelves he probably should not be on, investigating every bag that enters the house, sprinting down hallways for no obvious reason, and then suddenly flopping down like nothing happened, and because he is still young he learns quickly and enjoys interactive play that keeps his brain busy even when you are just trying to sit down for a minute.\n          </p>\n\n          <div class=\"actions\" aria-label=\"Actions for Milo\">\n            <details class=\"details\">\n              <summary>Details</summary>\n              <div class=\"details-body\">\n                <p><strong>Confirm:</strong> Milo — Age: 6 months — Size: Small — Good with kids: Yes</p>\n                <p>\n                  Milo enjoys gentle attention and does well with respectful kids who like to play using wand toys and who understand that kittens need breaks, naps, and a calm approach even when they are being silly and zooming around the room.\n                </p>\n              </div>\n            </details>\n            <button class=\"adopt\" type=\"button\" aria-label=\"Adopt Milo\">Adopt</button>\n          </div>\n        </article>\n\n        <!-- 3 -->\n        <article class=\"pet-card\" aria-label=\"Pet card: Bella\">\n          <img src=\"assets/adopt-dog-2.jpg\" alt=\"Bella the dog\" />\n          <h3>Bella</h3>\n\n          <p class=\"meta\">Age: <span class=\"value\">4 years</span></p>\n          <p class=\"meta\"><span class=\"label\">Size</span>: <span class=\"value\">Small</span></p>\n          <p class=\"meta\">Good with kids: <span class=\"value\">Yes</span></p>\n\n          <p class=\"desc\">\n            Bella is calm, affectionate, and enjoys being around families, she loves belly rubs, gentle walks, and will happily follow you from room to room just to make sure she is included in absolutely everything, and if you sit down she will quietly appear next to you like she has always been there and like it is her job to supervise the entire household in the sweetest possible way.\n          </p>\n\n          <div class=\"actions\" aria-label=\"Actions for Bella\">\n            <details class=\"details\">\n              <summary>Details</summary>\n              <div class=\"details-body\">\n                <p><strong>Confirm:</strong> Bella — Age: 4 years — Size: Small — Good with kids: Yes</p>\n                <p>\n                  Bella is gentle and patient and tends to settle quickly after a walk, making her a good fit for families who want a steady companion that enjoys routine, calm attention, and being near people without needing constant excitement.\n                </p>\n              </div>\n            </details>\n            <button class=\"adopt\" type=\"button\" aria-label=\"Adopt Bella\">Adopt</button>\n          </div>\n        </article>\n\n        <!-- 4 -->\n        <article class=\"pet-card\" aria-label=\"Pet card: Luna\">\n          <img src=\"assets/adopt-cat-1.jpg\" alt=\"Luna the cat\" />\n          <h3>Luna</h3>\n\n          <p class=\"meta\">Age: <span class=\"value\">3 years</span></p>\n          <p class=\"meta\"><span class=\"label\">Size</span>: <span class=\"value\">Small</span></p>\n          <p class=\"meta\">Good with kids: <span class=\"value\">No</span></p>\n\n          <p class=\"desc\">\n            Luna is quiet and observant and prefers a predictable environment, she enjoys sunny windowsills, gentle pets, and curling up next to you in the evenings, and she would do best in a calm home where she can relax at her own pace without a lot of sudden noise or fast movement, because she likes to choose when she interacts and when she simply watches everything from a comfortable spot.\n          </p>\n\n          <div class=\"actions\" aria-label=\"Actions for Luna\">\n            <details class=\"details\">\n              <summary>Details</summary>\n              <div class=\"details-body\">\n                <p><strong>Confirm:</strong> Luna — Age: 3 years — Size: Small — Good with kids: No</p>\n                <p>\n                  Luna bonds slowly but deeply and would love an adult or teen household that understands cat body language, appreciates a calm companion, and can offer a quiet routine with cozy places to perch and nap.\n                </p>\n              </div>\n            </details>\n            <button class=\"adopt\" type=\"button\" aria-label=\"Adopt Luna\">Adopt</button>\n          </div>\n        </article>\n\n        <!-- 5 -->\n        <article class=\"pet-card\" aria-label=\"Pet card: Max\">\n          <img src=\"assets/adopt-dog-3.jpg\" alt=\"Max the dog\" />\n          <h3>Max</h3>\n\n          <p class=\"meta\">Age: <span class=\"value\">1 year</span></p>\n          <p class=\"meta\"><span class=\"label\">Size</span>: <span class=\"value\">Large</span></p>\n          <p class=\"meta\">Good with kids: <span class=\"value\">Yes</span></p>\n\n          <p class=\"desc\">\n            Max is smart and highly trainable and needs an active home where he can learn new skills, play outside, and burn off energy throughout the day, he thrives with structure and clear expectations and likes having a job to do, and when he is bored he invents his own activities which may include reorganizing your shoes, investigating every corner of the yard, and following you closely to see what happens next.\n          </p>\n\n          <div class=\"actions\" aria-label=\"Actions for Max\">\n            <details class=\"details\">\n              <summary>Details</summary>\n              <div class=\"details-body\">\n                <p><strong>Confirm:</strong> Max — Age: 1 year — Size: Large — Good with kids: Yes</p>\n                <p>\n                  Max does best with families who like training games and daily exercise, and he can be a great match for kids who enjoy helping with routines like practicing basic cues, going on walks, and playing structured fetch.\n                </p>\n              </div>\n            </details>\n            <button class=\"adopt\" type=\"button\" aria-label=\"Adopt Max\">Adopt</button>\n          </div>\n        </article>\n\n        <!-- 6 -->\n        <article class=\"pet-card\" aria-label=\"Pet card: Chloe\">\n          <img src=\"assets/adopt-cat-3.jpg\" alt=\"Chloe the cat\" />\n          <h3>Chloe</h3>\n\n          <p class=\"meta\">Age: <span class=\"value\">5 years</span></p>\n          <p class=\"meta\"><span class=\"label\">Size</span>: <span class=\"value\">Small</span></p>\n          <p class=\"meta\">Good with kids: <span class=\"value\">Yes</span></p>\n\n          <p class=\"desc\">\n            Chloe is affectionate and talkative and enjoys interactive play and will happily keep you company throughout the day, she bonds closely with her person and loves attention and will remind you that it is time to focus on her by politely speaking up, and because she likes engagement she enjoys routines that include play, brushing, and a place to sit where she can watch what you are doing and comment on it.\n          </p>\n\n          <div class=\"actions\" aria-label=\"Actions for Chloe\">\n            <details class=\"details\">\n              <summary>Details</summary>\n              <div class=\"details-body\">\n                <p><strong>Confirm:</strong> Chloe — Age: 5 years — Size: Small — Good with kids: Yes</p>\n                <p>\n                  Chloe is social and does well with kids who enjoy gentle interaction and can respect when she steps away, and she tends to thrive when there are predictable daily moments for play and attention.\n                </p>\n              </div>\n            </details>\n            <button class=\"adopt\" type=\"button\" aria-label=\"Adopt Chloe\">Adopt</button>\n          </div>\n        </article>\n\n        <!-- 7 -->\n        <article class=\"pet-card\" aria-label=\"Pet card: Poppy\">\n          <img src=\"assets/dog4-adoption.jpg\" alt=\"Poppy the dog\" />\n          <h3>Poppy</h3>\n\n          <p class=\"meta\">Age: <span class=\"value\">10 months</span></p>\n          <p class=\"meta\"><span class=\"label\">Size</span>: <span class=\"value\">Small</span></p>\n          <p class=\"meta\">Good with kids: <span class=\"value\">Yes</span></p>\n\n          <p class=\"desc\">\n            Poppy is bright and bouncy and loves sniffing every single thing on a walk, she enjoys learning tricks, chasing soft toys, and then curling up the moment she decides the fun is over, and because she is small she fits nicely into apartments as long as she gets daily play and a chance to explore, and she tends to greet new people with a wag and a quick little hop that makes everyone laugh.\n          </p>\n\n          <div class=\"actions\" aria-label=\"Actions for Poppy\">\n            <details class=\"details\">\n              <summary>Details</summary>\n              <div class=\"details-body\">\n                <p><strong>Confirm:</strong> Poppy — Age: 10 months — Size: Small — Good with kids: Yes</p>\n                <p>\n                  Poppy is a great match for families who want a small, young pet and who can offer gentle play and short training sessions, and she does best with kids who understand that even small dogs need calm handling and breaks.\n                </p>\n              </div>\n            </details>\n            <button class=\"adopt\" type=\"button\" aria-label=\"Adopt Poppy\">Adopt</button>\n          </div>\n        </article>\n\n        <!-- 8 -->\n        <article class=\"pet-card\" aria-label=\"Pet card: Duke\">\n          <img src=\"assets/dog5-adoption.jpg\" alt=\"Duke the dog\" />\n          <h3>Duke</h3>\n\n          <p class=\"meta\">Age: <span class=\"value\">7 years</span></p>\n          <p class=\"meta\"><span class=\"label\">Size</span>: <span class=\"value\">Medium</span></p>\n          <p class=\"meta\">Good with kids: <span class=\"value\">Yes</span></p>\n\n          <p class=\"desc\">\n            Duke is steady and sweet and enjoys routine more than surprises, he likes slow walks, comfortable naps, and being near people without needing to be the center of attention every second, and he is the kind of dog who will quietly sit next to you while you do homework or watch a movie and then follow you to the kitchen just in case something interesting happens, and he responds well to calm voices and predictable schedules.\n          </p>\n\n          <div class=\"actions\" aria-label=\"Actions for Duke\">\n            <details class=\"details\">\n              <summary>Details</summary>\n              <div class=\"details-body\">\n                <p><strong>Confirm:</strong> Duke — Age: 7 years — Size: Medium — Good with kids: Yes</p>\n                <p>\n                  Duke is a good fit for families who want a calmer companion and can offer a stable home, and he tends to do well with kids who like a gentle dog that enjoys relaxed play and quiet time.\n                </p>\n              </div>\n            </details>\n            <button class=\"adopt\" type=\"button\" aria-label=\"Adopt Duke\">Adopt</button>\n          </div>\n        </article>\n\n        <!-- 9 -->\n        <article class=\"pet-card\" aria-label=\"Pet card: Nori\">\n          <img src=\"assets/dog6-adoption.jpg\" alt=\"Nori the dog\" />\n          <h3>Nori</h3>\n\n          <p class=\"meta\">Age: <span class=\"value\">18 months</span></p>\n          <p class=\"meta\"><span class=\"label\">Size</span>: <span class=\"value\">Medium</span></p>\n          <p class=\"meta\">Good with kids: <span class=\"value\">No</span></p>\n\n          <p class=\"desc\">\n            Nori is sensitive and prefers a quieter environment and can be cautious in busy spaces, she enjoys gentle routines, sniffy walks, and having a safe spot where she can relax, and she does best when people move slowly and give her time to warm up, and while she bonds strongly once she trusts you she can get overwhelmed by sudden noises and quick movement which is why she would prefer an adult household or a home with older teens.\n          </p>\n\n          <div class=\"actions\" aria-label=\"Actions for Nori\">\n            <details class=\"details\">\n              <summary>Details</summary>\n              <div class=\"details-body\">\n                <p><strong>Confirm:</strong> Nori — Age: 18 months — Size: Medium — Good with kids: No</p>\n                <p>\n                  Nori thrives with patient handling and calm spaces, and she would love a home that values a gentle approach, slow introductions, and predictable daily rhythms that help her feel secure.\n                </p>\n              </div>\n            </details>\n            <button class=\"adopt\" type=\"button\" aria-label=\"Adopt Nori\">Adopt</button>\n          </div>\n        </article>\n      </main>\n\n      <!-- Navigation -->\n      <nav aria-label=\"Bottom navigation\" class=\"nav-bottom\">\n        <a href=\"#\">\n          <img src=\"assets/home.png\" alt=\"Home icon\" />\n          <div>Home</div>\n        </a>\n        <a href=\"#\">\n          <img src=\"assets/dogs.png\" alt=\"Dogs icon\" />\n          <div>Dogs</div>\n        </a>\n        <a href=\"#\">\n          <img src=\"assets/cats.png\" alt=\"Cats icon\" />\n          <div>Cats</div>\n        </a>\n        <a class=\"nav-back\" href=\"#\">\n          <img src=\"assets/back.png\" alt=\"Back icon\" />\n          <div>Back</div>\n        </a>\n      </nav>\n\n      <!-- Footer -->\n      <footer id=\"contact\" aria-label=\"Contact\">\n        <p>PawPrint Shelter</p>\n        <p>123 Rescue Lane</p>\n        <p>Open 7 Days a Week</p>\n        <p>Email: adopt@pawprint.org</p>\n      </footer>\n\n    </div>\n  </div>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "19": {
          "id": "19",
          "name": "styles.css",
          "contents": "/* styles.css — LEVEL 2\n   - Controls panel: readable\n   - App: starts \"bad\" but is adjustable via JS (CSS variables)\n*/\n\n/* ================= */\n/* Defaults */\n/* ================= */\n:root{\n  /* App palette / baseline (bad) */\n  --bg:#f6f6f6;\n  --text:#cfcfcf;\n  --muted:#d7d7d7;\n  --border:#efefef;\n  --card:#f7f7f7;\n\n  --btn-bg:#e9e9e9;\n  --btn-text:#d8d8d8;\n  --btn-border:#ededed;\n\n  --base:12px;\n  --lh:1.05;\n\n  --gap:2px;\n  --card-pad:6px;\n  --card-text:10px;\n  --card-lh:1.05;\n\n  --nav-font:9px;\n  --nav-icon:16px;\n  --nav-height:34px;\n\n  --tap-pad: 1px;\n  --tap-font: 10px; \n  \n}\n\n*{ box-sizing:border-box; }\n\nbody{\n  margin:0;\n  background:#fff;\n}\n\n/* ======================= */\n/* Split Layout (Controls | App) */\n/* ======================= */\n.layout{\n  display:grid;\n  grid-template-columns: 340px 1fr;\n  min-height:100vh;\n}\n\n/* ======================= */\n/* CONTROL PANEL (GOOD UI) */\n/* ======================= */\n.controls{\n  background:#0f172a;\n  color:#e5e7eb;\n  padding:16px;\n  border-right:1px solid #0b1220;\n  position:sticky;\n  top:0;\n  height:100vh;\n  overflow:auto;\n\n  font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Arial, \"Noto Sans\", \"Liberation Sans\", sans-serif;\n  line-height:1.4;\n}\n\n.controls h2{\n  margin:0 0 12px 0;\n  font-size:16px;\n  font-weight:650;\n  letter-spacing:0.2px;\n}\n\n.control-group{\n  background:#111c34;\n  border:1px solid rgba(255,255,255,0.08);\n  border-radius:10px;\n  padding:12px;\n  margin-bottom:12px;\n}\n\n.control-group h3{\n  margin:0 0 10px 0;\n  font-size:13px;\n  font-weight:650;\n  color:#f3f4f6;\n}\n\n.controls label{\n  display:block;\n  margin:10px 0 6px 0;\n  font-size:12px;\n  color:#d1d5db;\n}\n\n.controls select{\n  width:100%;\n  padding:8px 10px;\n  border-radius:8px;\n  border:1px solid rgba(255,255,255,0.12);\n  background:#0b1220;\n  color:#f3f4f6;\n  outline:none;\n}\n\n.controls input[type=\"range\"]{\n  width:100%;\n}\n\n.controls input[type=\"checkbox\"]{\n  transform: translateY(1px);\n  margin-right:8px;\n}\n\n.controls button{\n  width:100%;\n  padding:9px 10px;\n  border-radius:10px;\n  border:1px solid rgba(255,255,255,0.14);\n  background:#111827;\n  color:#f3f4f6;\n  font-size:13px;\n  font-weight:600;\n  cursor:pointer;\n  margin-top:8px;\n}\n\n.controls button:hover{ background:#0b1220; }\n.controls button:active{ transform: translateY(1px); }\n\n/* ======================= */\n/* APP (Bad UX styles scoped here) */\n/* ======================= */\n.app{\n  background:var(--bg);\n  color:var(--text);\n  font-family:\"Times New Roman\", Times, serif;\n  font-size:var(--base);\n  line-height:var(--lh);\n  min-height:100vh;\n}\n\n/* Header */\n.app header{\n  display:flex;\n  justify-content:space-between;\n  align-items:center;\n  padding:6px 6px 2px 6px;\n  border-bottom:1px solid var(--border);\n  background:transparent;\n}\n\n.app .brand{\n  display:flex;\n  align-items:center;\n}\n\n.app header img{\n  width:28px;\n  height:28px;\n}\n\n.app header span{\n  font-size:12px;\n  font-weight:400;\n  margin-left:4px;\n}\n\n.app header a{\n  color:var(--muted);\n  text-decoration:none;\n  font-size:10px;\n}\n\n/* Hero */\n.app section{ padding:8px; }\n\n.app section img{\n  width:100%;\n  height:auto;\n  display:block;\n  border:1px solid var(--border);\n}\n\n.app .hero{\n  position:relative;\n  padding:0;\n}\n\n.app .hero img{\n  height:280px;\n  object-fit:cover;\n  filter:contrast(0.9) brightness(1.05);\n}\n\n.app .hero .hero-copy{\n  position:absolute;\n  top:18px;\n  left:10px;\n  max-width:280px;\n  padding:6px 8px;\n  background:rgba(255,255,255,0.25);\n  border:1px solid rgba(255,255,255,0.25);\n}\n\n.app .hero h1{\n  margin:6px 0 4px 0;\n  font-size:16px;\n  font-weight:400;\n}\n\n.app .hero p{\n  margin:0;\n  font-size:12px;\n  color:var(--muted);\n}\n\n/* Grid */\n.app main{\n  padding:8px;\n\n  /* still overlaps slightly by default */\n  padding-bottom:22px;\n\n  display:grid;\n  grid-template-columns:repeat(3, 1fr);\n  gap:var(--gap);\n}\n\n.app article{\n  background:var(--card);\n  border:1px solid var(--border);\n  padding:var(--card-pad);\n}\n\n.app article img{\n  width:100%;\n  height:160px;\n  object-fit:cover;\n  border:1px solid var(--border);\n}\n\n.app article h3{\n  margin:6px 0 2px 0;\n  font-size: calc(var(--card-text) + 2px);\n  font-weight:400;\n}\n\n/* Random bolding (intentional) */\n.app article:nth-child(2) h3,\n.app article:nth-child(6) .meta .value,\n.app article:nth-child(7) .meta .label{\n  font-weight:700;\n}\n\n.app .meta,\n.app .desc{\n  margin:0 0 4px 0;\n  font-size:var(--card-text);\n  line-height:var(--card-lh);\n  color:var(--muted);\n}\n\n.app .meta .label,\n.app .meta .value{\n  color:var(--muted);\n  font-weight:400;\n}\n\n.app .desc{ margin-top:2px; }\n\n/* Actions */\n.app .actions{\n  display:flex;\n  align-items:flex-start;\n  gap:2px;\n  margin-top:2px;\n}\n\n/* Treat BOTH controls like matching buttons */\n.app summary,\n.app button.adopt{\n  border:1px solid var(--btn-border);\n  background:var(--btn-bg);\n  color:var(--btn-text);\n\n  font-size:var(--tap-font);\n  line-height:1;\n\n  padding: var(--tap-pad) calc(var(--tap-pad) + 1px);\n}\n\n/* details wrapper should not add its own visual box */\n.app details{\n  border:0;\n  background:transparent;\n  padding:0;\n}\n\n/* keep summary clickable + remove marker */\n.app summary{\n  cursor:pointer;\n  list-style:none;\n}\n.app summary::-webkit-details-marker{ display:none; }\n\n/* dropdown content stays as-is */\n.app .details-body{\n  padding:2px 3px;\n  border-top:1px solid var(--btn-border);\n}\n\n.app .details-body p{\n  margin:0 0 4px 0;\n  font-size:10px;\n  line-height:1.05;\n  color:var(--muted);\n}\n\n.app button.adopt{\n  cursor:pointer;\n}\n.app button.adopt:active{ transform:translateY(1px); }\n\n/* Footer */\n.app footer{\n  padding:10px 8px;\n  border-top:1px solid var(--border);\n  color:var(--muted);\n  font-size:11px;\n}\n\n/* Nav (base styles — NOT positioned here) */\n.app nav{\n  height:var(--nav-height);\n  background:rgba(242,242,242,0.65);\n  border-top:1px solid var(--border);\n\n  display:flex;\n  justify-content:space-around;\n  align-items:center;\n\n  padding:0 2px;\n  z-index:10;\n}\n.app nav a{\n  width:46px;\n  text-align:center;\n  text-decoration:none;\n  color:var(--text);\n  font-size:var(--nav-font);\n  line-height:1.0;\n}\n\n.app nav img{\n  width:var(--nav-icon);\n  height:var(--nav-icon);\n  display:block;\n  margin:0 auto 1px auto;\n  opacity:0.55;\n}\n/* Bottom */\n.app nav.nav-bottom{\n  position:fixed;\n  left:0;\n  right:0;\n  bottom:0;\n}\n\n/* Top */\n.app nav.nav-top{\n  position:sticky;\n  top:0;\n}\n\n/* When nav is top, you don't need extra bottom padding */\n.app.nav-is-top main{\n  padding-bottom:8px;\n}\n\n/* Responsive */\n@media (max-width: 900px){\n  .layout{ grid-template-columns: 1fr; }\n  .controls{ position:static; height:auto; }\n\n  .app main{ grid-template-columns:repeat(2, 1fr); }\n}\n\n@media (max-width: 520px){\n  .app main{ grid-template-columns:1fr; }\n}",
          "folderId": "0",
          "active": false
        },
        "29": {
          "id": "29",
          "name": "controls.js",
          "contents": "// controls.js\n// Midpoint mapping:\n// - Slider midpoint = BAD baseline (Level 1)\n// - Left of midpoint = WORSE\n// - Right of midpoint = BETTER (improved, not \"perfect\")\n//\n// Visual-only controls: no filters, no hidden logic.\n// Refactor: updates are scheduled with requestAnimationFrame for snappier sliders.\n\nconst $ = (id) => document.getElementById(id);\n\nconst app = document.querySelector(\".app\");\nconst nav = document.querySelector(\".app nav\");\nconst backItem = document.querySelector(\".app .nav-back\");\n\nif (!app || !nav) console.error(\"Missing .app or .app nav in HTML.\");\n\n/* -----------------------\n   RAF scheduler (snappy)\n----------------------- */\nlet rafId = 0;\nconst pending = new Map();\n\nfunction schedule(key, fn) {\n  pending.set(key, fn);\n  if (rafId) return;\n\n  rafId = requestAnimationFrame(() => {\n    rafId = 0;\n    for (const [, job] of pending) job();\n    pending.clear();\n  });\n}\n\n/* -----------------------\n   Helpers\n----------------------- */\nfunction setVar(name, value) {\n  if (!app) return;\n  app.style.setProperty(name, value);\n}\n\nfunction lerp(a, b, t) {\n  return a + (b - a) * t;\n}\n\n// returns t in [-1, +1] where 0 = midpoint\nfunction signedT(value, min, max) {\n  const minN = Number(min);\n  const maxN = Number(max);\n  const mid = (minN + maxN) / 2;\n  const v = Number(value);\n\n  if (v === mid) return 0;\n  if (v < mid) return -((mid - v) / (mid - minN));\n  return (v - mid) / (maxN - mid);\n}\n\nfunction rgb(arr) {\n  return `rgb(${arr[0]}, ${arr[1]}, ${arr[2]})`;\n}\n\nfunction mixRGB(from, to, t) {\n  return [\n    Math.round(lerp(from[0], to[0], t)),\n    Math.round(lerp(from[1], to[1], t)),\n    Math.round(lerp(from[2], to[2], t)),\n  ];\n}\n\n/* -----------------------\n   Nav positioning (visual only)\n----------------------- */\nconst navPlaceholder = document.createComment(\"nav-placeholder\");\nif (nav && nav.parentNode) nav.parentNode.insertBefore(navPlaceholder, nav);\n\nfunction moveNavToTop() {\n  if (!app || !nav) return;\n  const header = app.querySelector(\"header\");\n  if (header) header.after(nav);\n}\n\nfunction moveNavToBottom() {\n  if (!navPlaceholder || !nav) return;\n  navPlaceholder.parentNode.insertBefore(nav, navPlaceholder);\n}\n\nfunction setNavPosition(position) {\n  if (!nav) return;\n\n  nav.classList.remove(\"nav-top\", \"nav-bottom\");\n\n  if (position === \"top\") {\n    moveNavToTop();\n    nav.classList.add(\"nav-top\");\n    app?.classList.add(\"nav-is-top\");\n  } else {\n    moveNavToBottom();\n    nav.classList.add(\"nav-bottom\");\n    app?.classList.remove(\"nav-is-top\");\n  }\n}\n\nfunction setBackVisibility(isVisible) {\n  if (!backItem) return;\n  backItem.style.display = isVisible ? \"\" : \"none\";\n}\n\n/* -----------------------\n   BAD baseline values (midpoint maps here)\n----------------------- */\nconst BASE_BAD = {\n  cardTextPx: 10,\n  cardLineHeight: 1.05,\n  gapPx: 2,\n\n  navFontPx: 9,\n  navIconPx: 16,\n\n  // NEW: tap targets baseline (BAD)\n  tapPadPx: 1,\n  tapFontPx: 10,\n\n  palette: {\n    bg: [246, 246, 246],\n    text: [207, 207, 207],\n    muted: [215, 215, 215],\n    btnBg: [233, 233, 233],\n    btnText: [216, 216, 216],\n  },\n};\n\n// WORSE and BETTER targets (BETTER is intentionally not \"perfect\")\nconst TARGETS = {\n  cardTextPx: { worse: 8, better: 16 },\n  cardLineHeight: { worse: 1.0, better: 1.45 },\n  gapPx: { worse: 0, better: 14 },\n\n  navFontPx: { worse: 7, better: 13 },\n  navIconPx: { worse: 12, better: 24 },\n\n  // Tap targets (worse -> better)\n  tapPadPx: { worse: 0, better: 10 },\n  tapFontPx: { worse: 9, better: 12 },\n\n  paletteWorse: {\n    bg: [242, 242, 242],\n    text: [225, 225, 225],\n    muted: [232, 232, 232],\n    btnBg: [238, 238, 238],\n    btnText: [228, 228, 228],\n  },\n\n  paletteBetter: {\n    bg: [255, 255, 255],\n    text: [55, 55, 55],\n    muted: [95, 95, 95],\n    btnBg: [45, 45, 45],\n    btnText: [245, 245, 245],\n  },\n};\n\n/* -----------------------\n   Apply functions (midpoint = bad baseline)\n----------------------- */\nfunction applyTapSize() {\n  const el = $(\"tapSize\");\n  if (!el) return;\n\n  const t = signedT(el.value, el.min, el.max);\n\n  let pad, font;\n  if (t < 0) {\n    pad = lerp(BASE_BAD.tapPadPx, TARGETS.tapPadPx.worse, -t);\n    font = lerp(BASE_BAD.tapFontPx, TARGETS.tapFontPx.worse, -t);\n  } else {\n    pad = lerp(BASE_BAD.tapPadPx, TARGETS.tapPadPx.better, t);\n    font = lerp(BASE_BAD.tapFontPx, TARGETS.tapFontPx.better, t);\n  }\n\n  setVar(\"--tap-pad\", `${pad.toFixed(0)}px`);\n  setVar(\"--tap-font\", `${font.toFixed(0)}px`);\n}\n\nfunction applyTextSize() {\n  const el = $(\"textSize\");\n  if (!el) return;\n\n  const t = signedT(el.value, el.min, el.max);\n\n  const px =\n    t < 0\n      ? lerp(BASE_BAD.cardTextPx, TARGETS.cardTextPx.worse, -t)\n      : lerp(BASE_BAD.cardTextPx, TARGETS.cardTextPx.better, t);\n\n  setVar(\"--card-text\", `${px.toFixed(0)}px`);\n}\n\nfunction applyLineHeight() {\n  const el = $(\"lineHeight\");\n  if (!el) return;\n\n  const t = signedT(el.value, el.min, el.max);\n\n  const lh =\n    t < 0\n      ? lerp(BASE_BAD.cardLineHeight, TARGETS.cardLineHeight.worse, -t)\n      : lerp(BASE_BAD.cardLineHeight, TARGETS.cardLineHeight.better, t);\n\n  setVar(\"--card-lh\", lh.toFixed(2));\n}\n\nfunction applySpacing() {\n  const el = $(\"spacing\");\n  if (!el) return;\n\n  const t = signedT(el.value, el.min, el.max);\n\n  const gap =\n    t < 0\n      ? lerp(BASE_BAD.gapPx, TARGETS.gapPx.worse, -t)\n      : lerp(BASE_BAD.gapPx, TARGETS.gapPx.better, t);\n\n  setVar(\"--gap\", `${gap.toFixed(0)}px`);\n}\n\nfunction applyNavSize() {\n  const el = $(\"navSize\");\n  if (!el) return;\n\n  const t = signedT(el.value, el.min, el.max);\n\n  let fontPx, iconPx;\n  if (t < 0) {\n    fontPx = lerp(BASE_BAD.navFontPx, TARGETS.navFontPx.worse, -t);\n    iconPx = lerp(BASE_BAD.navIconPx, TARGETS.navIconPx.worse, -t);\n  } else {\n    fontPx = lerp(BASE_BAD.navFontPx, TARGETS.navFontPx.better, t);\n    iconPx = lerp(BASE_BAD.navIconPx, TARGETS.navIconPx.better, t);\n  }\n\n  setVar(\"--nav-font\", `${fontPx.toFixed(0)}px`);\n  setVar(\"--nav-icon\", `${iconPx.toFixed(0)}px`);\n}\n\nfunction applyContrast() {\n  const el = $(\"contrast\");\n  if (!el) return;\n\n  const t = signedT(el.value, el.min, el.max);\n\n  const base = BASE_BAD.palette;\n  const worse = TARGETS.paletteWorse;\n  const better = TARGETS.paletteBetter;\n\n  const blendToward = (baseArr, targetArr, amt) => mixRGB(baseArr, targetArr, amt);\n\n  const bg = t < 0 ? blendToward(base.bg, worse.bg, -t) : blendToward(base.bg, better.bg, t);\n  const text = t < 0 ? blendToward(base.text, worse.text, -t) : blendToward(base.text, better.text, t);\n  const muted = t < 0 ? blendToward(base.muted, worse.muted, -t) : blendToward(base.muted, better.muted, t);\n  const btnBg = t < 0 ? blendToward(base.btnBg, worse.btnBg, -t) : blendToward(base.btnBg, better.btnBg, t);\n  const btnText = t < 0 ? blendToward(base.btnText, worse.btnText, -t) : blendToward(base.btnText, better.btnText, t);\n\n  setVar(\"--bg\", rgb(bg));\n  setVar(\"--text\", rgb(text));\n  setVar(\"--muted\", rgb(muted));\n  setVar(\"--btn-bg\", rgb(btnBg));\n  setVar(\"--btn-text\", rgb(btnText));\n}\n\nfunction applyAll() {\n  applyTextSize();\n  applyLineHeight();\n  applySpacing();\n  applyContrast();\n  applyNavSize();\n  applyTapSize();\n\n  if ($(\"navPosition\")) setNavPosition($(\"navPosition\").value);\n  if ($(\"showBack\")) setBackVisibility($(\"showBack\").checked);\n}\n\n/* -----------------------\n   Reset + initialization\n----------------------- */\nfunction setSlidersToMidpoints() {\n  const ids = [\"textSize\", \"lineHeight\", \"spacing\", \"contrast\", \"navSize\", \"tapSize\"];\n  for (const id of ids) {\n    const el = $(id);\n    if (!el) continue;\n    const min = Number(el.min);\n    const max = Number(el.max);\n    el.value = String((min + max) / 2);\n  }\n}\n\nfunction applyBadBaseline() {\n  setVar(\"--card-text\", `${BASE_BAD.cardTextPx}px`);\n  setVar(\"--card-lh\", BASE_BAD.cardLineHeight.toFixed(2));\n  setVar(\"--gap\", `${BASE_BAD.gapPx}px`);\n\n  setVar(\"--nav-font\", `${BASE_BAD.navFontPx}px`);\n  setVar(\"--nav-icon\", `${BASE_BAD.navIconPx}px`);\n\n  // NEW: tap baseline vars\n  setVar(\"--tap-pad\", `${BASE_BAD.tapPadPx}px`);\n  setVar(\"--tap-font\", `${BASE_BAD.tapFontPx}px`);\n\n  setVar(\"--bg\", rgb(BASE_BAD.palette.bg));\n  setVar(\"--text\", rgb(BASE_BAD.palette.text));\n  setVar(\"--muted\", rgb(BASE_BAD.palette.muted));\n  setVar(\"--btn-bg\", rgb(BASE_BAD.palette.btnBg));\n  setVar(\"--btn-text\", rgb(BASE_BAD.palette.btnText));\n\n  if ($(\"navPosition\")) $(\"navPosition\").value = \"bottom\";\n  setNavPosition(\"bottom\");\n\n  if ($(\"showBack\")) $(\"showBack\").checked = true;\n  setBackVisibility(true);\n}\n\nfunction wireControls() {\n  const onInput = (id, fn) => {\n    const el = $(id);\n    if (!el) return;\n    el.addEventListener(\"input\", () => schedule(id, fn));\n  };\n\n  onInput(\"textSize\", applyTextSize);\n  onInput(\"lineHeight\", applyLineHeight);\n  onInput(\"spacing\", applySpacing);\n  onInput(\"contrast\", applyContrast);\n  onInput(\"navSize\", applyNavSize);\n  onInput(\"tapSize\", applyTapSize); // NEW\n\n  const navPos = $(\"navPosition\");\n  if (navPos) navPos.addEventListener(\"change\", (e) => setNavPosition(e.target.value));\n\n  const showBack = $(\"showBack\");\n  if (showBack) showBack.addEventListener(\"change\", (e) => setBackVisibility(e.target.checked));\n\n  const resetBtn = $(\"reset\");\n  if (resetBtn) {\n    resetBtn.addEventListener(\"click\", () => {\n      setSlidersToMidpoints();\n      applyBadBaseline();\n      schedule(\"reset\", applyAll);\n    });\n  }\n}\n\nwireControls();\nsetSlidersToMidpoints();\napplyBadBaseline();\napplyAll();",
          "folderId": "0",
          "active": true
        },
