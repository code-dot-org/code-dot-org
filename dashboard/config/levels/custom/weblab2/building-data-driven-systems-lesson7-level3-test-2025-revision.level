    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Student Activity Board</title>\n  <link href=\"https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Mono:wght@400;700&display=swap\" rel=\"stylesheet\">\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n  <main class=\"board\">\n    <header>\n      <h1>CAMPUS CLUBS</h1>\n      <p class=\"subtitle\">FEATURED OPPORTUNITIES (TOP 3)</p>\n    </header>\n\n    <div class=\"controls\">\n      <button id=\"shuffle-btn\">RANDOMIZE SELECTION</button>\n    </div>\n\n    <div id=\"card-container\" class=\"grid-container\">\n      </div>\n  </main>\n\n  <script src=\"script.js\" defer></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// script.js (Exemplar Solution)\n\nlet clubs = [\n  { name: \"Varsity Golf\", category: \"Sports\", cost: \"$500/yr\", requirements: \"Own clubs required\", image: \"https://images.unsplash.com/photo-1535131749006-b7f58c99034b?auto=format&fit=crop&q=80&w=400\" },\n  { name: \"Travel Debate\", category: \"Academic\", cost: \"$250/trip\", requirements: \"GPA > 3.8\", image: \"https://images.unsplash.com/photo-1524178232363-1fb2b075b955?auto=format&fit=crop&q=80&w=400\" },\n  { name: \"Robotics Elite\", category: \"STEM\", cost: \"$150\", requirements: \"Prior coding experience\", image: \"\" },\n  { name: \"Community Garden\", category: \"Service\", cost: \"Free\", requirements: \"Open to all\", image: \"\" },\n  { name: \"Street Art Crew\", category: \"Arts\", cost: \"Free\", requirements: \"None\", image: \"\" },\n  { name: \"JV Soccer\", category: \"Sports\", cost: \"$200\", requirements: \"Cleats required\", image: \"\" }, // Added\n  { name: \"Varsity Tennis\", category: \"Sports\", cost: \"$300\", requirements: \"Own racket\", image: \"\" }, // Added\n  { name: \"Code for Good\", category: \"STEM\", cost: \"Free\", requirements: \"Beginners welcome\", image: \"\" },\n  { name: \"Swim Team\", category: \"Sports\", cost: \"$150\", requirements: \"Can swim 100m\", image: \"\" }, // Added\n  { name: \"Varsity Cheer\", category: \"Sports\", cost: \"$600\", requirements: \"Tryouts required\", image: \"https://images.unsplash.com/photo-1541534741688-6078c6bfb5c5?auto=format&fit=crop&q=80&w=400\" },\n  { name: \"Esports Team\", category: \"Gaming\", cost: \"$50\", requirements: \"Own mouse/keyboard\", image: \"\" },\n  { name: \"Cross Country\", category: \"Sports\", cost: \"$100\", requirements: \"Running shoes\", image: \"\" } // Added\n];\n\nconst cardContainer = document.querySelector(\"#card-container\");\nconst shuffleBtn = document.querySelector(\"#shuffle-btn\");\n\nconst renderClubs = () => {\n  // Use slice to limit to 3 items\n  const featured = clubs.slice(0, 3); \n\n  const htmlString = featured.map(club => {\n    \n    let imageStyle = \"\";\n    let missingLabel = \"\";\n    if (club.image) {\n      imageStyle = `background-image: url('${club.image}')`;\n    } else {\n      missingLabel = `<span class='missing-img-label'>NO IMAGE</span>`;\n    }\n\n    return `\n      <article class=\"card\">\n        <div class=\"card-image\" style=\"${imageStyle}\">\n          ${missingLabel}\n        </div>\n        <div class=\"card-content\">\n          <div class=\"meta-tags\">\n            <span class=\"tag\">${club.category}</span>\n            <span class=\"tag tag-cost\">${club.cost}</span>\n          </div>\n          <h2>${club.name}</h2>\n          <div class=\"requirements\">\n            <span class=\"req-label\">REQUIRES:</span>\n            ${club.requirements}\n          </div>\n        </div>\n      </article>\n    `;\n  });\n\n  cardContainer.innerHTML = htmlString.join(\"\");\n};\n\nshuffleBtn.addEventListener(\"click\", () => {\n  // Random sort\n  clubs.sort(() => Math.random() - 0.5);\n  renderClubs();\n});\n\nrenderClubs();",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": ":root {\n  --bg-color: #f4f4f4;\n  --card-bg: #ffffff;\n  --border-black: 3px solid #000;\n  --shadow-hard: 6px 6px 0px #000;\n}\n\nbody {\n  font-family: 'Space Mono', monospace;\n  background-color: var(--bg-color);\n  margin: 0;\n  padding: 20px;\n  color: #000;\n}\n\nheader {\n  text-align: center;\n  margin-bottom: 40px;\n  border-bottom: var(--border-black);\n  padding-bottom: 20px;\n  background-color: #fff;\n  border: var(--border-black);\n  box-shadow: var(--shadow-hard);\n  padding: 20px;\n}\n\nh1 {\n  font-family: 'Archivo Black', sans-serif;\n  font-size: 3rem;\n  text-transform: uppercase;\n  margin: 0;\n  line-height: 1;\n}\n\n.subtitle {\n  font-weight: bold;\n  margin-top: 10px;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n}\n\n.controls {\n  text-align: center;\n  margin-bottom: 40px;\n}\n\nbutton {\n  background-color: #000;\n  color: #fff;\n  border: none;\n  padding: 15px 30px;\n  font-family: 'Space Mono', monospace;\n  font-size: 1.1rem;\n  font-weight: bold;\n  cursor: pointer;\n  text-transform: uppercase;\n  box-shadow: var(--shadow-hard);\n  transition: all 0.1s;\n}\n\nbutton:hover {\n  transform: translate(2px, 2px);\n  box-shadow: 4px 4px 0px #000;\n}\n\nbutton:active {\n  transform: translate(6px, 6px);\n  box-shadow: none;\n}\n\n.grid-container {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));\n  gap: 30px;\n  max-width: 1200px;\n  margin: 0 auto;\n}\n\n.card {\n  background: var(--card-bg);\n  border: var(--border-black);\n  display: flex;\n  flex-direction: column;\n  box-shadow: var(--shadow-hard);\n}\n\n.card-image {\n  height: 180px;\n  background-color: #000;\n  background-size: cover;\n  background-position: center;\n  position: relative;\n  border-bottom: var(--border-black);\n}\n\n.missing-img-label {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  color: #fff;\n  font-weight: bold;\n  text-transform: uppercase;\n  text-align: center;\n  width: 100%;\n}\n\n.card-content {\n  padding: 20px;\n  display: flex;\n  flex-direction: column;\n  flex-grow: 1;\n}\n\n.meta-tags {\n  margin-bottom: 10px;\n}\n\n.tag {\n  display: inline-block;\n  background: #000;\n  color: #fff;\n  padding: 4px 8px;\n  font-size: 0.8rem;\n  font-weight: bold;\n  text-transform: uppercase;\n  margin-right: 5px;\n}\n\n.tag-cost {\n  background: #fff;\n  color: #000;\n  border: 2px solid #000;\n}\n\nh2 {\n  font-family: 'Archivo Black', sans-serif;\n  font-size: 1.6rem;\n  margin: 5px 0 15px 0;\n  text-transform: uppercase;\n  line-height: 1;\n}\n\n.requirements {\n  margin-top: auto;\n  padding-top: 15px;\n  border-top: 2px dashed #000;\n  font-size: 0.85rem;\n  font-style: italic;\n}\n\n.req-label {\n  font-weight: bold;\n  font-style: normal;\n  display: block;\n  margin-bottom: 3px;\n}",
          "folderId": "0",
          "active": false
        }
      },
