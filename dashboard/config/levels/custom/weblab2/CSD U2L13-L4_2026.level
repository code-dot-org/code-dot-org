      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    \n    <!-- parent container with 4 child div tags -->\n    <!-- 1) Give each child item inside the \"flex-order\" parent a specific class attribute (see instructions) -->\n    <div class=\"flex-order\">\n      <div>a</div>\n      <div>b</div>\n      <div>c</div>\n      <div>d</div>\n    </div>\n    \n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* 1) Add a rule in the CSS file for each of the child items using their class attribute as the selector. */\n\n/* 2) Set each item's order using the order property (see instructions for the order) */\n\n.flex-order {\n  /* We gave the parent div container a background color so you can see how the items are positioned within it */\n  background: #b691d6;\n  display: flex;\n  padding: 5px;\n}\n\n/* styled child divs in parent continer */\n.flex-order > div {\n  background-color: aliceblue;\n  margin: 5px;\n  width: 45%;\n  text-align: center;\n  line-height: 55px;\n  font-size: 20px;\n  border-style: solid;\n  font-family: sans-serif;\n}\n\n/* ADD CODE BELOW to set the order for \"item-a\" to be 3rd */\n\n\n/* ADD CODE BELOW to set the order for \"item-b\" to be 2nd */\n\n\n/* ADD CODE BELOW to set the order for \"item-c\" to be 4th */\n\n\n/* ADD CODE BELOW to set the order for \"item-d\" to be 1st */",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2"
      ]
    },
