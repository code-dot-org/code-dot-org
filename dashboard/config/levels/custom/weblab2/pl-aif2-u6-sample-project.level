  "audit_log": "[{\"changed_at\":\"2026-07-09T21:20:14.733+00:00\",\"changed\":[\"cloned from \\\"capstone-project-lesson1-level8-2026\\\"\"],\"cloned_from\":\"capstone-project-lesson1-level8-2026\"},{\"changed_at\":\"2026-07-09 21:23:07 +0000\",\"changed\":[],\"changed_by_id\":19028,\"changed_by_email\":\"amanda.dennard@code.org\"},{\"changed_at\":\"2026-07-09 21:30:20 +0000\",\"changed\":[],\"changed_by_id\":19028,\"changed_by_email\":\"amanda.dennard@code.org\"},{\"changed_at\":\"2026-07-09 21:35:03 +0000\",\"changed\":[],\"changed_by_id\":19028,\"changed_by_email\":\"amanda.dennard@code.org\"},{\"changed_at\":\"2026-07-09 21:36:08 +0000\",\"changed\":[\"long_instructions\"],\"changed_by_id\":19028,\"changed_by_email\":\"amanda.dennard@code.org\"}]"
