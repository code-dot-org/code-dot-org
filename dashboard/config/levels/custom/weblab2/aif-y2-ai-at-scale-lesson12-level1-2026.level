      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Costs of AI</title>\n    <link rel=\"stylesheet\" href=\"styles.css\" />\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Geist+Mono:ital,wght@0,100..900;1,100..900&family=Geist:ital,wght@0,100..900;1,100..900&family=Space+Grotesk:wght@300..700&display=swap\"\n      rel=\"stylesheet\"\n    />\n  </head>\n  <body>\n    <header>\n      <h1>Costs of AI</h1>\n    </header>\n    <main>\n      <section class=\"settings-section\" aria-labelledby=\"settings-heading\">\n        <div class=\"card-panel\">\n          <h2 class=\"heading\" id=\"settings-heading\">Scenario</h2>\n        </div>\n\n        <div class=\"slider requests-slider\">\n          <div class=\"slider__header\">\n            <label class=\"slider__label\" for=\"requests-input\">Requests per second</label>\n            <span class=\"slider__value\" aria-hidden=\"true\"></span>\n          </div>\n          <p class=\"slider__hint\" id=\"requests-hint\">\n            Number of requests for a new video every second\n          </p>\n          <!-- Positions along the track, mapped to a number of requests by app.js. -->\n          <input\n            class=\"slider__input\"\n            id=\"requests-input\"\n            type=\"range\"\n            autocomplete=\"off\"\n            min=\"0\"\n            max=\"9\"\n            step=\"1\"\n            aria-describedby=\"requests-hint\"\n          />\n          <div class=\"slider__ends\" aria-hidden=\"true\">\n            <span>1,000</span>\n            <span>1 million</span>\n          </div>\n        </div>\n\n        <div class=\"slider candidates-slider\">\n          <div class=\"slider__header\">\n            <label class=\"slider__label\" for=\"candidates-input\">Candidates per request</label>\n            <span class=\"slider__value\" aria-hidden=\"true\"></span>\n          </div>\n          <p class=\"slider__hint\" id=\"candidates-hint\">\n            Number of videos to select from\n          </p>\n          <input\n            class=\"slider__input\"\n            id=\"candidates-input\"\n            type=\"range\"\n            autocomplete=\"off\"\n            min=\"10\"\n            max=\"1000\"\n            step=\"10\"\n            aria-describedby=\"candidates-hint\"\n          />\n          <div class=\"slider__ends\" aria-hidden=\"true\">\n            <span>10</span>\n            <span>1,000</span>\n          </div>\n        </div>\n\n        <fieldset class=\"choice-picker gpu-picker\" aria-describedby=\"gpu-hint\">\n          <legend class=\"choice-picker__legend\">GPU</legend>\n          <p class=\"choice-picker__hint\" id=\"gpu-hint\">Generation of data center GPUs</p>\n          <!-- One card per GPU, cloned from #choice-option-template. -->\n          <div class=\"choice-picker__options\"></div>\n        </fieldset>\n\n        <fieldset class=\"choice-picker mix-picker\" aria-describedby=\"mix-hint\">\n          <legend class=\"choice-picker__legend\">Energy Mix</legend>\n          <p class=\"choice-picker__hint\" id=\"mix-hint\">Source of energy</p>\n          <!-- One card per mix, cloned from #choice-option-template. -->\n          <div class=\"choice-picker__options\"></div>\n        </fieldset>\n      </section>\n\n      <section class=\"results-section\" aria-labelledby=\"results-heading\">\n        <div class=\"card-panel\">\n          <h2 class=\"heading\" id=\"results-heading\">Costs</h2>\n        </div>\n\n        <dl class=\"results results--row\">\n          <div class=\"results__item\">\n            <dt class=\"results__label\">Work</dt>\n            <dd class=\"results__value\" id=\"work-value\"></dd>\n          </div>\n          <div class=\"results__item\">\n            <dt class=\"results__label\">Power</dt>\n            <dd class=\"results__value\" id=\"power-value\"></dd>\n          </div>\n          <div class=\"results__item\">\n            <dt class=\"results__label\">GPUs</dt>\n            <dd class=\"results__value\" id=\"gpus-value\"></dd>\n          </div>\n        </dl>\n\n        <!-- Drawn by square-grid.js. The cards above say the same in words. -->\n        <figure class=\"square-grid work-grid\">\n          <p class=\"square-grid__title\">TFLOP/s</p>\n          <canvas class=\"square-grid__canvas\" aria-hidden=\"true\"></canvas>\n          <figcaption class=\"square-grid__caption\"></figcaption>\n        </figure>\n\n        <figure class=\"square-grid watts-grid\">\n          <p class=\"square-grid__title\">Watts</p>\n          <canvas class=\"square-grid__canvas\" aria-hidden=\"true\"></canvas>\n          <figcaption class=\"square-grid__caption\"></figcaption>\n        </figure>\n\n        <figure class=\"square-grid gpus-grid\">\n          <p class=\"square-grid__title\">GPUs</p>\n          <canvas class=\"square-grid__canvas\" aria-hidden=\"true\"></canvas>\n          <figcaption class=\"square-grid__caption\"></figcaption>\n        </figure>\n\n        <!-- Filled by cost-split.js: the total, a bar of its parts, and a line\n             for each part with the sum that gives it. -->\n        <div class=\"cost-split\">\n          <p class=\"cost-split__title\">Approximate Monetary Cost Per Year</p>\n          <p class=\"cost-split__total\"></p>\n          <div class=\"cost-split__bar\" aria-hidden=\"true\"></div>\n          <ul class=\"cost-split__parts\"></ul>\n        </div>\n\n        <!-- Filled by emissions.js: the CO2, the trees to take it in, and the\n             sum that gives it. -->\n        <div class=\"emissions\">\n          <h3 class=\"emissions__title\">Approximate Carbon Emissions Per Year</h3>\n          <p class=\"emissions__intro\">\n            Burning coal or gas releases carbon dioxide (CO2), a gas that warms the planet.\n          </p>\n          <!-- The tons and the trees side by side, the trees beneath once\n               there isn't room for both. -->\n          <div class=\"emissions__figures\">\n            <p class=\"emissions__total\"></p>\n            <p class=\"emissions__trees\">\n              <span class=\"emissions__tree-count\"></span>\n              <span class=\"emissions__tree-note\"></span>\n            </p>\n          </div>\n          <p class=\"emissions__sum\"></p>\n        </div>\n      </section>\n    </main>\n\n    <template id=\"cost-part-template\">\n      <li class=\"cost-split__part\">\n        <span class=\"cost-split__swatch\" aria-hidden=\"true\"></span>\n        <span class=\"cost-split__name\"></span>: <span class=\"cost-split__sum\"></span>\n      </li>\n    </template>\n\n    <template id=\"choice-option-template\">\n      <label class=\"choice-option\">\n        <input class=\"choice-option__input\" type=\"radio\" autocomplete=\"off\" />\n        <span class=\"choice-option__name\"></span>\n        <span class=\"choice-option__detail\"></span>\n      </label>\n    </template>\n\n    <script type=\"module\" src=\"app.js\"></script>\n  </body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "model.js",
          "contents": "/**\n * model.js — what it costs a short-video app to pick each video with a neural\n * network. Pure logic, no DOM.\n *\n * The network is the top of a recommendation model: a fully connected network\n * that takes in 479 numbers about a user and a video and puts out one, the\n * chance the user watches the video. For each request (one user needing a\n * video), it scores some number of candidate videos, and the highest score is\n * shown.\n *\n * Running the network takes 2 FLOP per parameter (a multiply and an add for\n * each weight). Biases need slightly less, and activation functions add a few\n * thousand FLOP; both are too small to matter and are left out.\n */\n\nconst LAYER_SIZES = [479, 1024, 1024, 512, 256, 1];\n\n/** Each layer after the first, with its weights and biases. */\nexport const LAYERS = LAYER_SIZES.slice(1).map((size, i) => ({\n  inputs: LAYER_SIZES[i],\n  outputs: size,\n  parameters: LAYER_SIZES[i] * size + size,\n}));\n\nexport const PARAMETERS = LAYERS.reduce((total, { parameters }) => total + parameters, 0);\n\n// 4,395,010: about 4.4 million.\nexport const FLOP_PER_CANDIDATE = 2 * PARAMETERS;\n\n/**\n * GPUs from three eras, about five years apart, each with its sustained\n * FLOP/s — the speed achieved in practice rather than the maximum on the spec\n * sheet — and its power draw. Students see only the era and the efficiency,\n * FLOP/s per watt, which is all the power drawn depends on.\n *\n * Illustrative, about a third of each GPU's peak: NVIDIA's Tesla K20X (2012,\n * 3.95 trillion FLOP/s at 32 bits, at 235 W), V100 SXM2 (2017, 125 trillion at\n * 16 bits, at 300 W), and H100 SXM (2022, 989 trillion at 16 bits, at 700 W).\n * Each has a rough price to buy one, near its launch. Check all of these\n * against spec sheets and price lists before release.\n */\nexport const UNITS = {\n  c2012: { name: \"2012 generation\", flopPerSecond: 1.3e12, watts: 235, dollars: 3000 },\n  c2017: { name: \"2017 generation\", flopPerSecond: 4e13, watts: 300, dollars: 9000 },\n  c2022: { name: \"2022 generation\", flopPerSecond: 3e14, watts: 700, dollars: 30000 },\n};\n\n// What a year of running the GPUs costs. A GPU is used for about 4 years, a\n// common period for writing off servers, so a quarter of its price counts\n// toward each year. Electricity is illustrative, at $0.10 a kilowatt-hour.\nexport const YEARS_OF_USE = 4;\nexport const HOURS_PER_YEAR = 365 * 24;\nexport const DOLLARS_PER_KILOWATT_HOUR = 0.1;\n// The same rate for each watt-hour, so a power in watts can be priced as is.\nexport const DOLLARS_PER_WATT_HOUR = DOLLARS_PER_KILOWATT_HOUR / 1000;\n\n// Roughly what an average U.S. home uses, averaged over a day (nearer 1,200\n// watts; rounded down to keep the arithmetic simple). Check before release.\nexport const WATTS_PER_HOME = 1000;\n\n/**\n * Everything the load costs when `requests` a second each score `candidates`\n * videos on `unit` (one of `UNITS`): the work, the power it draws, how many\n * GPUs it takes, a whole number, enough to sustain the work, and what a year\n * of those GPUs costs.\n *\n * The power counts only the work done, as if a GPU that is partly busy drew\n * only that part of its power. So 1 GPU at a tenth of its speed draws a tenth\n * of its watts. The electricity is for that power, all year; the GPUs are\n * bought whole.\n */\nexport function costs({ requests, candidates, unit }) {\n  const joulesPerFlop = unit.watts / unit.flopPerSecond;\n  const flopPerRequest = candidates * FLOP_PER_CANDIDATE;\n  const flopPerSecond = requests * flopPerRequest;\n  const watts = flopPerSecond * joulesPerFlop;\n  const gpus = Math.ceil(flopPerSecond / unit.flopPerSecond);\n  const buyingPerYear = (gpus * unit.dollars) / YEARS_OF_USE;\n  return { flopPerSecond, watts, gpus, buyingPerYear };\n}\n\n/** What `watts`, drawn all year, cost in electricity. */\nexport function electricityPerYear(watts) {\n  return watts * HOURS_PER_YEAR * DOLLARS_PER_WATT_HOUR;\n}\n\n/*\n * Carbon. Making electricity from fossil fuels releases carbon dioxide (CO2);\n * wind, solar, and nuclear release next to none as they run, and so are\n * \"emission-free\". Each mix gives the kilograms of CO2 for each\n * kilowatt-hour: illustrative, about 0.8 kg for fossil fuels (coal releases\n * about 1 kg, natural gas about 0.4 kg), and half that for a mix that is half\n * emission-free. A grown tree takes in roughly 22 kg of CO2 a\n * year. Check all of these before release.\n */\nexport const MIXES = {\n  free: { name: \"100% emission-free\", sources: \"Wind, solar, nuclear\", kgPerKilowattHour: 0 },\n  half: { name: \"50% emission-free\", sources: \"Mix of sources\", kgPerKilowattHour: 0.4 },\n  none: { name: \"0% emission-free\", sources: \"Natural gas, coal\", kgPerKilowattHour: 0.8 },\n};\nexport const KG_PER_TREE_PER_YEAR = 22;\n\n/** The kilograms of CO2 that `watts`, drawn all year from `mix`, release. */\nexport function emissionsPerYear(watts, mix) {\n  return (watts * HOURS_PER_YEAR * mix.kgPerKilowattHour) / 1000;\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "styles.css",
          "contents": "@import url(\"components/slider.css\");\n@import url(\"components/choice-picker.css\");\n@import url(\"components/square-grid.css\");\n@import url(\"components/cost-split.css\");\n@import url(\"components/emissions.css\");\n\n:root {\n  --gray-0: #fdfdfd;\n  --gray-50: #f9f9f9;\n  --gray-100: #f4f4f4;\n  --gray-150: #eeeeee;\n  --gray-200: #e5e5e5;\n  --gray-300: #d4d4d4;\n  --gray-400: #a3a3a3;\n  --gray-500: #737373;\n  --gray-600: #525252;\n  --gray-700: #404040;\n  --gray-800: #262626;\n  --gray-900: #171717;\n  --gray-950: #0a0a0a;\n  --purple-0: rgb(245, 244, 253);\n  --purple-100: rgb(234, 232, 251);\n  --purple-200: rgb(214, 210, 246);\n  --purple-300: rgb(192, 188, 240);\n  --purple-400: rgb(169, 163, 232);\n  --purple-500: rgb(105, 98, 210);\n  --purple-600: rgb(82, 75, 184);\n  --purple-700: rgb(59, 53, 153);\n  --purple-800: rgb(41, 35, 126);\n  --purple-900: rgb(30, 25, 113);\n  --mint-0: rgb(244, 252, 247);\n  --mint-100: rgb(230, 247, 237);\n  --mint-200: rgb(211, 240, 211);\n  --mint-300: rgb(184, 228, 196);\n  --mint-400: rgb(141, 207, 170);\n  --mint-500: rgb(91, 175, 138);\n  --mint-600: rgb(56, 140, 110);\n  --mint-700: rgb(34, 107, 86);\n  --mint-800: rgb(21, 74, 60);\n  --mint-900: rgb(12, 46, 38);\n}\n\nh1,\nh2,\nh3,\nh4,\nh5,\nh6,\np {\n  margin: 0;\n}\n\nbody {\n  align-items: center;\n  background-color: var(--gray-50);\n  box-sizing: border-box;\n  color: var(--purple-900);\n  display: flex;\n  flex-direction: column;\n  font-family: \"Geist\", sans-serif;\n  gap: 2em;\n  justify-content: center;\n  margin: 0;\n  min-height: 100vh;\n  padding: 1.5em 1em;\n}\n\nheader {\n  max-width: 34em;\n  text-align: center;\n}\n\nheader h1 {\n  font-family: \"Space Grotesk\", monospace;\n  font-weight: 700;\n}\n\n/* The settings beside the results, or above them once there isn't room for\n   both. */\nmain {\n  align-items: start;\n  display: grid;\n  gap: 1em;\n  grid-template-columns: minmax(16em, 22em) minmax(0, 1fr);\n  max-width: 64em;\n  width: 100%;\n}\n\n@media (max-width: 52em) {\n  main {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n\n/* On a screen tall enough to hold all the settings, they stay in view while\n   the results scroll past, so a slider can be moved while watching what it\n   changes. */\n@media (min-width: 52.01em) and (min-height: 50em) {\n  .settings-section {\n    position: sticky;\n    top: 1em;\n  }\n}\n\nsection {\n  background-color: var(--gray-0);\n  border-radius: 0.5em;\n  box-shadow: 0px 2px 2px rgba(0, 0, 0, 0.3);\n  box-sizing: border-box;\n  display: flex;\n  flex-direction: column;\n  gap: 1.25em;\n  min-width: 0;\n  padding: 1em;\n}\n\n.heading {\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 1rem;\n  font-weight: bold;\n}\n\n/* A panel across the top of a card, running to the card's edges and into its\n   rounded top corners, with a hairline where it meets the rest. */\n.card-panel {\n  background-color: var(--gray-100);\n  border-bottom: 1px solid var(--gray-200);\n  border-radius: 0.5em 0.5em 0 0;\n  margin: -1em -1em 0;\n  padding: 0.75em 1em;\n}\n\n/* ---------- Results ---------- */\n\n/* Two to a row where there's room. */\n.results {\n  display: grid;\n  gap: 0.75em;\n  grid-template-columns: repeat(auto-fit, minmax(14em, 1fr));\n  margin: 0;\n}\n\n/* Work, power, and GPUs: side by side, in a column only once the card is\n   too narrow for them (a container query in ems, so enlarged text, WCAG\n   1.4.4, stacks them as well). */\n.results-section {\n  container: results / inline-size;\n}\n\n.results--row {\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n}\n\n/* Full size where there's room, smaller where the longest value, \"0.0044\n   TFLOP/s\" at about 7.4 ems, would otherwise wrap in its column: a third of\n   the card, less the gaps and padding (2.3rem). */\n.results--row .results__value {\n  font-size: clamp(1rem, (33.3cqi - 2.3rem) / 7.6, 1.5rem);\n}\n\n@container results (max-width: 28.7em) {\n  .results--row {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .results--row .results__value {\n    font-size: 1.5rem;\n  }\n}\n\n.results__item {\n  background-color: var(--purple-0);\n  border-radius: 0.5em;\n  display: flex;\n  flex-direction: column;\n  gap: 0.2em;\n  min-width: 0;\n  padding: 0.6em 0.9em;\n}\n\n.results__label {\n  color: var(--purple-700);\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 0.9rem;\n  font-weight: 700;\n}\n\n.results__value {\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 1.5rem;\n  font-variant-numeric: tabular-nums;\n  font-weight: 700;\n  margin: 0;\n  overflow-wrap: anywhere;\n}\n\n/* Read by screen readers, not shown. */\n.visually-hidden {\n  clip-path: inset(50%);\n  height: 1px;\n  overflow: hidden;\n  position: absolute;\n  white-space: nowrap;\n  width: 1px;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n}\n",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "app.js",
          "contents": "/**\n * app.js — the Costs of AI controller.\n *\n * Wires together:\n *   - the settings: two sliders (requests per second, candidates per request),\n *     the GPU, and the energy mix\n *   - the results: the work, power, and GPUs the load takes (plain DOM in\n *     index.html), each again as a grid of squares, what a year of those\n *     GPUs costs, part by part, and the CO2 their electricity releases\n *\n * Every change to a setting works everything out again (model.js) and shows\n * it at once.\n */\n\nimport {\n  DOLLARS_PER_WATT_HOUR,\n  HOURS_PER_YEAR,\n  KG_PER_TREE_PER_YEAR,\n  MIXES,\n  UNITS,\n  WATTS_PER_HOME,\n  YEARS_OF_USE,\n  costs,\n  electricityPerYear,\n  emissionsPerYear,\n} from \"./model.js\";\nimport * as format from \"./components/format.js\";\nimport { createCostSplit } from \"./components/cost-split.js\";\nimport { createEmissions } from \"./components/emissions.js\";\nimport { createSquareGrid } from \"./components/square-grid.js\";\nimport { createSlider } from \"./components/slider.js\";\nimport { createChoicePicker } from \"./components/choice-picker.js\";\n\nconst REQUEST_STOPS = [1e3, 2e3, 5e3, 1e4, 2e4, 5e4, 1e5, 2e5, 5e5, 1e6];\n\nconst numbers = new Intl.NumberFormat(\"en-US\");\n\nconst requestsSlider = createSlider(document.querySelector(\".requests-slider\"), {\n  stops: REQUEST_STOPS,\n  format: (r) => numbers.format(r),\n  describe: (r) => `${numbers.format(r)} requests per second`,\n  onInput: () => update(),\n});\n\nconst candidatesSlider = createSlider(document.querySelector(\".candidates-slider\"), {\n  format: (c) => numbers.format(c),\n  describe: (c) => `${numbers.format(c)} ${format.plural(c, \"candidate\", \"candidates\")} per request`,\n  onInput: () => update(),\n});\n\nconst unitPicker = createChoicePicker(document.querySelector(\".gpu-picker\"), {\n  name: \"gpu\",\n  options: UNITS,\n  selected: \"c2012\",\n  describe: (unit) => `${efficiency(unit)} TFLOP/s per watt`,\n  onChange: () => update(),\n});\n\nconst mixPicker = createChoicePicker(document.querySelector(\".mix-picker\"), {\n  name: \"mix\",\n  options: MIXES,\n  selected: \"half\",\n  describe: (mix) => mix.sources,\n  onChange: () => update(),\n});\n\n// The most there can be, for the grids to make room for: the most requests,\n// each scoring the most candidates, on whichever GPU needs the most.\nconst heaviest = Object.values(UNITS).map((unit) =>\n  costs({\n    requests: REQUEST_STOPS.at(-1),\n    candidates: Number(document.getElementById(\"candidates-input\").max),\n    unit,\n  }),\n);\nconst most = {\n  flopPerSecond: Math.max(...heaviest.map(({ flopPerSecond }) => flopPerSecond)),\n  watts: Math.max(...heaviest.map(({ watts }) => watts)),\n  gpus: Math.max(...heaviest.map(({ gpus }) => gpus)),\n};\n\n// All three grids have 50 squares to a row, so their squares are the same\n// size, whatever each one stands for.\nconst workGrid = createSquareGrid(document.querySelector(\".work-grid\"), {\n  perSquare: 10,\n  max: most.flopPerSecond / 1e12,\n  columns: 50,\n  caption: \"Each square is 10 TFLOP/s.\",\n});\n\nconst wattsGrid = createSquareGrid(document.querySelector(\".watts-grid\"), {\n  perSquare: WATTS_PER_HOME,\n  max: most.watts,\n  columns: 50,\n  caption: \"Each square is 1,000 watts, about what an average U.S. home uses.\",\n});\n\nconst gpusGrid = createSquareGrid(document.querySelector(\".gpus-grid\"), {\n  perSquare: 10,\n  max: most.gpus,\n  columns: 50,\n  caption: \"Each square is 10 GPUs.\",\n});\n\nconst costSplit = createCostSplit(document.querySelector(\".cost-split\"), {\n  parts: [\"Buying GPUs\", \"Electricity\"],\n});\n\nconst emissions = createEmissions(document.querySelector(\".emissions\"));\n\nfunction update() {\n  const requests = requestsSlider.getValue();\n  const candidates = candidatesSlider.getValue();\n  const unit = UNITS[unitPicker.getSelection()];\n\n  showCosts(costs({ requests, candidates, unit }), unit);\n}\n\nfunction showCosts(result, unit) {\n  set(\"work-value\", format.teraflops(result.flopPerSecond));\n  set(\"power-value\", format.watts(result.watts));\n  set(\"gpus-value\", `${numbers.format(result.gpus)} ${format.plural(result.gpus, \"GPU\", \"GPUs\")}`);\n  workGrid.show(result.flopPerSecond / 1e12);\n  wattsGrid.show(result.watts);\n  gpusGrid.show(result.gpus);\n\n  // Each part's sum, written out so it can be checked by hand, from the\n  // numbers as shown above: the electricity from the power as rounded on its\n  // card, not as worked out.\n  const gpus = `${numbers.format(result.gpus)} ${format.plural(result.gpus, \"GPU\", \"GPUs\")}`;\n  const watts = format.round(result.watts);\n  costSplit.show([\n    {\n      amount: result.buyingPerYear,\n      working: `${gpus} × ${format.dollars(unit.dollars)} ÷ ${YEARS_OF_USE} years`,\n    },\n    {\n      amount: electricityPerYear(watts),\n      working:\n        `${format.watts(watts)} × ${numbers.format(HOURS_PER_YEAR)} hours × ` +\n        `$${format.significant(DOLLARS_PER_WATT_HOUR)} per watt-hour`,\n    },\n  ]);\n\n  // From the same rounded power, so this sum can be checked by hand too.\n  const mix = MIXES[mixPicker.getSelection()];\n  emissions.show({\n    kg: emissionsPerYear(watts, mix),\n    working:\n      `${format.watts(watts)} × ${numbers.format(HOURS_PER_YEAR)} hours × ` +\n      `${format.significant(mix.kgPerKilowattHour / 1000)} kg of CO2 per watt-hour`,\n    kgPerTree: KG_PER_TREE_PER_YEAR,\n  });\n}\n\n// TFLOP/s per watt, to two significant figures but no more than three decimal\n// places, so the oldest GPU reads \"0.006\" rather than \"0.0055\".\nfunction efficiency({ flopPerSecond, watts }) {\n  return format.significant(Math.round((flopPerSecond / watts / 1e12) * 1000) / 1000);\n}\n\nfunction set(id, text) {\n  document.getElementById(id).textContent = text;\n}\n\nrequestsSlider.setValue(1e3);\ncandidatesSlider.setValue(50);\nupdate();\n",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "choice-picker.css",
          "contents": ".choice-picker {\n  border: none;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5em;\n  margin: 0;\n  min-width: 0;\n  padding: 0;\n}\n\n.choice-picker__legend {\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 0.875rem;\n  font-weight: 700;\n  margin-bottom: 0.3em;\n  padding: 0;\n}\n\n.choice-picker__hint {\n  color: var(--gray-600);\n  font-size: 0.8rem;\n  line-height: 1.35;\n}\n\n/* One card above another, each a whole label: the radio itself is hidden,\n   and the card shows which is chosen by its border and fill. */\n.choice-picker__options {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5em;\n}\n\n/* The name on the left, the detail on the right, or beneath once there isn't\n   room, still to the right. At least 44px tall. */\n.choice-option {\n  align-items: baseline;\n  border: 2px solid var(--gray-400);\n  border-radius: 0.5em;\n  box-sizing: border-box;\n  cursor: pointer;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.2em 0.75em;\n  justify-content: space-between;\n  min-height: 2.75rem;\n  padding: 0.5em 0.75em;\n  position: relative;\n}\n\n/* Hidden from sight but not from the keyboard or screen readers. */\n.choice-option__input {\n  clip-path: inset(50%);\n  height: 1px;\n  margin: 0;\n  overflow: hidden;\n  position: absolute;\n  white-space: nowrap;\n  width: 1px;\n}\n\n.choice-option:has(:checked) {\n  background-color: var(--purple-0);\n  border-color: var(--purple-900);\n}\n\n.choice-option:has(:focus-visible) {\n  outline: 3px solid var(--purple-900);\n  outline-offset: 2px;\n}\n\n.choice-option__name {\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 1rem;\n  font-weight: 700;\n}\n\n.choice-option__detail {\n  color: var(--gray-600);\n  font-size: 0.8rem;\n  font-variant-numeric: tabular-nums;\n  margin-left: auto;\n  text-align: right;\n}\n",
          "folderId": "1",
          "active": false
        },
        "6": {
          "id": "6",
          "name": "choice-picker.js",
          "contents": "/**\n * choice-picker.js — a choice between a few options, one card per option.\n *\n * A plain radio group in a fieldset, so arrow keys move between options and a\n * screen reader names the group along with each one. The cards are cloned\n * from `#choice-option-template`, one for each of `options`: its name on the\n * left, and on the right whatever `describe` says about it, such as a GPU's\n * efficiency or an energy mix's sources.\n */\n\nexport function createChoicePicker(container, { name, options, selected, describe, onChange } = {}) {\n  const list = container.querySelector(\".choice-picker__options\");\n  const template = document.getElementById(\"choice-option-template\");\n\n  list.replaceChildren(\n    ...Object.entries(options).map(([key, option]) => {\n      const card = template.content.firstElementChild.cloneNode(true);\n      const input = card.querySelector(\".choice-option__input\");\n      input.name = name;\n      input.value = key;\n      input.checked = key === selected;\n      card.querySelector(\".choice-option__name\").textContent = option.name;\n      card.querySelector(\".choice-option__detail\").textContent = describe(option);\n      return card;\n    }),\n  );\n\n  container.addEventListener(\"change\", ({ target }) => onChange?.(target.value));\n\n  return {\n    getSelection: () => container.querySelector(\".choice-option__input:checked\").value,\n  };\n}\n",
          "folderId": "1",
          "active": false
        },
        "7": {
          "id": "7",
          "name": "cost-split.css",
          "contents": ".cost-split {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5em;\n}\n\n/* Styled like the grids' titles above. */\n.cost-split__title {\n  color: var(--purple-700);\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 0.9rem;\n  font-weight: 700;\n}\n\n.cost-split__total {\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 1.5rem;\n  font-variant-numeric: tabular-nums;\n  font-weight: 700;\n}\n\n/* The parts side by side, a 2px gap of the card's color between them. The\n   colors are at least 3:1 against the card (WCAG 1.4.11): purple for buying\n   the GPUs, mint, like the grids' squares, for the electricity. */\n.cost-split__bar {\n  display: flex;\n  gap: 2px;\n  height: 1.25em;\n}\n\n.cost-split__segment {\n  border-radius: 3px;\n  display: block;\n  min-width: 2px;\n  transition: width 0.4s ease-out;\n}\n\n.cost-split__segment--1,\n.cost-split__swatch--1 {\n  background-color: var(--purple-600);\n}\n\n.cost-split__segment--2,\n.cost-split__swatch--2 {\n  background-color: var(--mint-600);\n}\n\n.cost-split__parts {\n  display: flex;\n  flex-direction: column;\n  gap: 0.3em;\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n\n.cost-split__part {\n  color: var(--purple-700);\n  font-size: 0.875rem;\n  font-variant-numeric: tabular-nums;\n  line-height: 1.4;\n  padding-left: 1.4em;\n  position: relative;\n}\n\n/* Level with the first line, if the sum wraps. */\n.cost-split__swatch {\n  border-radius: 2px;\n  height: 0.8em;\n  left: 0;\n  position: absolute;\n  top: 0.3em;\n  width: 0.8em;\n}\n\n.cost-split__name {\n  font-weight: 700;\n}\n",
          "folderId": "1",
          "active": false
        },
        "8": {
          "id": "8",
          "name": "cost-split.js",
          "contents": "/**\n * cost-split.js — a yearly cost, the parts it is made of, and how each part\n * is worked out.\n *\n * The total sits above a bar split into one segment per part, each as wide as\n * that part's share of the total. Beneath, each part has a line of its own:\n * a swatch matching its segment, its name, and the sum that gives it\n * (\"3 GPUs × $30,000 ÷ 4 years = $22,500\"). Every amount is to the dollar,\n * and the total is the sum of the parts as shown, so a student can check it.\n *\n * The bar is aria-hidden: the lines beneath give every part in words. A part\n * is told apart by its line, its name, and its place in the bar (in the same\n * order as the lines), not by color alone (WCAG 1.4.1). The segments slide to\n * new widths, or jump there with reduced motion (styles.css).\n */\n\nimport { dollars } from \"./format.js\";\n\nexport function createCostSplit(container, { parts }) {\n  const total = container.querySelector(\".cost-split__total\");\n  const bar = container.querySelector(\".cost-split__bar\");\n  const list = container.querySelector(\".cost-split__parts\");\n  const template = document.getElementById(\"cost-part-template\");\n\n  // One segment and one line for each part, in order.\n  const segments = parts.map((name, i) => {\n    const segment = document.createElement(\"span\");\n    segment.className = `cost-split__segment cost-split__segment--${i + 1}`;\n    return segment;\n  });\n  bar.replaceChildren(...segments);\n\n  const lines = parts.map((name, i) => {\n    const line = template.content.firstElementChild.cloneNode(true);\n    line.querySelector(\".cost-split__swatch\").classList.add(`cost-split__swatch--${i + 1}`);\n    line.querySelector(\".cost-split__name\").textContent = name;\n    return line;\n  });\n  list.replaceChildren(...lines);\n\n  /**\n   * Show each part's `amount`, in dollars, and the `working` that gives it,\n   * in the order the parts were named.\n   */\n  function show(values) {\n    const amounts = values.map(({ amount }) => Math.round(amount));\n    const sum = amounts.reduce((a, b) => a + b, 0);\n    total.textContent = dollars(sum);\n\n    values.forEach(({ working }, i) => {\n      segments[i].style.width = `${sum ? (amounts[i] / sum) * 100 : 0}%`;\n      lines[i].querySelector(\".cost-split__sum\").textContent =\n        `${working} = ${dollars(amounts[i])}`;\n    });\n  }\n\n  return { show };\n}\n",
          "folderId": "1",
          "active": false
        },
        "9": {
          "id": "9",
          "name": "emissions.css",
          "contents": ".emissions {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5em;\n}\n\n/* Styled like the cost's title above. */\n.emissions__title {\n  color: var(--purple-700);\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 0.9rem;\n  font-weight: 700;\n}\n\n.emissions__intro,\n.emissions__tree-note,\n.emissions__sum {\n  color: var(--purple-700);\n  font-size: 0.875rem;\n  line-height: 1.4;\n}\n\n/* Two headlines, the tons and the trees, side by side while both fit, the\n   trees beneath once they don't. */\n.emissions__figures {\n  align-items: baseline;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.25em 2em;\n}\n\n.emissions__total,\n.emissions__tree-count {\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 1.5rem;\n  font-variant-numeric: tabular-nums;\n  font-weight: 700;\n}\n\n.emissions__trees {\n  display: flex;\n  flex-direction: column;\n}\n\n.emissions__sum {\n  font-variant-numeric: tabular-nums;\n}\n",
          "folderId": "1",
          "active": false
        },
        "10": {
          "id": "10",
          "name": "emissions.js",
          "contents": "/**\n * emissions.js — the CO2 a year of electricity releases.\n *\n * The total is given in kilograms, beside the trees it would take a year to\n * take in the same CO2, and beneath both, the sum that gives it (\"40 watts ×\n * 8,760 hours × 0.0004 kg of CO2 per watt-hour = 140 kg\"), so it can be\n * checked by hand. Where the electricity comes from is chosen in the Scenario\n * panel, with the GPU.\n */\n\nimport { significant } from \"./format.js\";\n\nexport function createEmissions(container) {\n  const total = container.querySelector(\".emissions__total\");\n  const treeCount = container.querySelector(\".emissions__tree-count\");\n  const treeNote = container.querySelector(\".emissions__tree-note\");\n  const sum = container.querySelector(\".emissions__sum\");\n\n  /**\n   * Show `kg` of CO2, the `working` that gives it, and as many trees as it\n   * would take `kgPerTree` a year each to take it in.\n   */\n  function show({ kg, working, kgPerTree }) {\n    const amount = `${significant(kg)} kg`;\n    total.textContent = `${amount} of CO2`;\n\n    // The count as a headline, and a note beneath on what it means.\n    const count = Math.round(kg / kgPerTree);\n    if (kg === 0) {\n      treeCount.textContent = \"0 trees\";\n      treeNote.textContent = \"needed to offset these emissions\";\n    } else {\n      treeCount.textContent =\n        count < 1\n          ? \"Under 1 tree\"\n          : `${significant(count)} ${count === 1 ? \"tree\" : \"trees\"}`;\n      treeNote.textContent = \"could offset these emissions\";\n    }\n\n    sum.textContent = `${working} = ${amount}`;\n  }\n\n  return { show };\n}\n",
          "folderId": "1",
          "active": false
        },
        "11": {
          "id": "11",
          "name": "format.js",
          "contents": "/**\n * format.js — the widget's numbers, written out for people.\n *\n * Amounts run from hundredths of a watt to quadrillions of FLOP/s, so they\n * are rounded to two significant figures, enough to compare one setting with\n * the next. Each kind of amount keeps to one unit, whatever its size: work in\n * TFLOP/s (trillions of FLOP a second), power in watts. Watts are spelled\n * out, not \"W\", since a screen reader reads \"W\" as a letter. Dollars are the\n * exception: they are given to the dollar, so that the parts of a cost can be\n * added up to its total.\n */\n\nconst whole = new Intl.NumberFormat(\"en-US\", { maximumFractionDigits: 0 });\n\n/** `n` rounded to `digits` significant figures, as a number. */\nexport function round(n, digits = 2) {\n  return n === 0 ? 0 : Number(n.toPrecision(digits));\n}\n\n/** `n` to `digits` significant figures, with commas: \"0.0013\", \"1,300\". */\nexport function significant(n, digits = 2) {\n  if (n === 0) return \"0\";\n  // Rounded first, so that a whole number keeps its commas.\n  const rounded = round(n, digits);\n  return rounded >= 10 ** digits\n    ? whole.format(rounded)\n    : rounded.toLocaleString(\"en-US\", { maximumSignificantDigits: digits });\n}\n\n/** A rate of work, `n` FLOP/s, in trillions: \"44 TFLOP/s\", \"0.0044 TFLOP/s\". */\nexport function teraflops(n) {\n  return `${significant(n / 1e12)} TFLOP/s`;\n}\n\nexport function plural(n, one, many) {\n  return n === 1 ? one : many;\n}\n\n/** Power, always in watts: \"0.01 watts\", \"1 watt\", \"260,000 watts\". */\nexport function watts(w) {\n  const amount = significant(w);\n  return `${amount} ${amount === \"1\" ? \"watt\" : \"watts\"}`;\n}\n\n/** Dollars, to the dollar: \"$22,500\". */\nexport function dollars(amount) {\n  return `$${whole.format(Math.round(amount))}`;\n}\n",
          "folderId": "1",
          "active": false
        },
        "12": {
          "id": "12",
          "name": "slider.css",
          "contents": ".slider {\n  display: flex;\n  flex-direction: column;\n  gap: 0.3em;\n}\n\n.slider__header {\n  align-items: baseline;\n  display: flex;\n  gap: 0.5em;\n  justify-content: space-between;\n}\n\n.slider__label {\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 0.875rem;\n  font-weight: 700;\n}\n\n.slider__value {\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 1.25rem;\n  font-variant-numeric: tabular-nums;\n  font-weight: 700;\n}\n\n.slider__hint {\n  color: var(--gray-600);\n  font-size: 0.8rem;\n  line-height: 1.35;\n}\n\n/* At least 24px tall, a comfortable target (WCAG 2.5.8). */\n.slider__input {\n  accent-color: var(--purple-900);\n  cursor: pointer;\n  margin: 0.25em 0 0;\n  min-height: 1.75rem;\n  width: 100%;\n}\n\n.slider__input:focus-visible {\n  border-radius: 0.25em;\n  outline: 3px solid var(--purple-900);\n  outline-offset: 2px;\n}\n\n.slider__ends {\n  color: var(--gray-600);\n  display: flex;\n  font-size: 0.75rem;\n  justify-content: space-between;\n}\n",
          "folderId": "1",
          "active": false
        },
        "13": {
          "id": "13",
          "name": "square-grid.css",
          "contents": ".square-grid {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5em;\n  margin: 0;\n}\n\n/* What the squares count, styled like the cards' labels above. */\n.square-grid__title {\n  color: var(--purple-700);\n  font-family: \"Space Grotesk\", monospace;\n  font-size: 0.9rem;\n  font-weight: 700;\n}\n\n/* The colors square-grid.js paints with: mint for a square lit, at least 3:1\n   against the card (WCAG 1.4.11), and a pale gray for one not lit, there only\n   to show how much room is left. */\n.square-grid__canvas {\n  --square-on: var(--mint-600);\n  --square-off: var(--gray-200);\n\n  display: block;\n  width: 100%;\n}\n\n.square-grid__caption {\n  color: var(--purple-700);\n  font-size: 0.875rem;\n  line-height: 1.4;\n}\n",
          "folderId": "1",
          "active": false
        },
        "14": {
          "id": "14",
          "name": "square-grid.js",
          "contents": "/**\n * square-grid.js — an amount, as squares that light up.\n *\n * A grid of squares, each standing for the same amount (`perSquare`), fills\n * from the bottom row up, left to right, as the amount grows. The last square\n * lit can be partly lit, so small changes still show. The scale never\n * changes, so one setting can be compared with another by eye. There are just\n * enough rows for the most there can be (`max`), so every amount fits.\n *\n * When the amount changes, the squares light (or go dark) one after another\n * over half a second, rather than all at once. A student who prefers reduced\n * motion (WCAG 2.3.3) sees the new amount at once. The preference is checked\n * on every frame, so changing it partway through takes effect at once.\n *\n * The canvas is aria-hidden: the same amount is given in words in the cards\n * above it, and the caption beneath gives the scale.\n */\n\nconst DURATION_MS = 500;\n// The space between squares, as a share of each square's cell.\nconst GAP = 0.18;\n\nconst reducedMotion = window.matchMedia(\"(prefers-reduced-motion: reduce)\");\n\nexport function createSquareGrid(figure, { perSquare, max, columns, caption }) {\n  const canvas = figure.querySelector(\".square-grid__canvas\");\n  const context = canvas.getContext(\"2d\");\n  figure.querySelector(\".square-grid__caption\").textContent = caption;\n\n  // Whole rows, enough for the most there can be.\n  const rows = Math.ceil(max / perSquare / columns);\n  const squares = rows * columns;\n\n  let cell = 0;\n  // How many squares are lit, as drawn, and how many there should be.\n  let lit = 0;\n  let target = 0;\n  let from = 0;\n  let start = 0;\n  let frame = null;\n\n  /** Light up `amount` worth of squares. */\n  function show(amount) {\n    target = Math.min(squares, amount / perSquare);\n    if (reducedMotion.matches || !cell) {\n      lit = target;\n      draw();\n      return;\n    }\n    from = lit;\n    start = performance.now();\n    if (frame === null) frame = requestAnimationFrame(tick);\n  }\n\n  function tick(now) {\n    const t = reducedMotion.matches ? 1 : Math.min(1, (now - start) / DURATION_MS);\n    lit = from + (target - from) * easeOut(t);\n    draw();\n    frame = t < 1 ? requestAnimationFrame(tick) : null;\n  }\n\n  function draw() {\n    if (!cell) return;\n    const colors = readColors(canvas);\n    const size = cell * (1 - GAP);\n    context.clearRect(0, 0, canvas.width, canvas.height);\n\n    for (let i = 0; i < squares; i++) {\n      // From the bottom row up, left to right.\n      const x = (i % columns) * cell + (cell - size) / 2;\n      const y = (rows - 1 - Math.floor(i / columns)) * cell + (cell - size) / 2;\n      const share = Math.min(1, Math.max(0, lit - i));\n\n      if (share < 1) {\n        context.fillStyle = colors.off;\n        context.fillRect(x, y, size, size);\n      }\n      if (share > 0) {\n        context.fillStyle = colors.on;\n        context.fillRect(x, y, size * share, size);\n      }\n    }\n  }\n\n  // The grid is as wide as the card, and its squares as wide as fit.\n  function resize() {\n    const width = canvas.clientWidth;\n    if (!width || width / columns === cell) return;\n    cell = width / columns;\n    const height = cell * rows;\n    const ratio = window.devicePixelRatio || 1;\n    canvas.style.height = `${height}px`;\n    canvas.width = Math.round(width * ratio);\n    canvas.height = Math.round(height * ratio);\n    context.setTransform(ratio, 0, 0, ratio, 0, 0);\n    draw();\n  }\n\n  new ResizeObserver(resize).observe(canvas);\n  resize();\n\n  return { show };\n}\n\nfunction easeOut(t) {\n  return 1 - (1 - t) ** 3;\n}\n\n// Colors live in the stylesheet (square-grid.css), with the rest.\nfunction readColors(canvas) {\n  const style = getComputedStyle(canvas);\n  return {\n    on: style.getPropertyValue(\"--square-on\").trim(),\n    off: style.getPropertyValue(\"--square-off\").trim(),\n  };\n}\n",
          "folderId": "1",
          "active": false
        },
        "15": {
          "id": "15",
          "name": "slider.js",
          "contents": "/**\n * slider.js — a native range input, with its value shown beside its label.\n *\n * A slider can move through a list of `stops` rather than every whole number\n * between its ends: requests per second climb 1,000, 2,000, 5,000, 10,000, …,\n * so a few presses of an arrow key cover the thousandfold range, and each\n * press roughly doubles the load. Without stops, the input's own value is the\n * value.\n *\n * The input's `aria-valuetext` is the value in words (\"100,000 requests per\n * second\"), so a screen reader says that rather than the position along the\n * track (\"6\"). The value beside the label is aria-hidden, since the input\n * already says it.\n */\n\nexport function createSlider(container, { stops, format, describe = format, onInput } = {}) {\n  const input = container.querySelector(\".slider__input\");\n  const valueText = container.querySelector(\".slider__value\");\n\n  const toValue = (position) => (stops ? stops[position] : position);\n  const toPosition = (value) => (stops ? stops.indexOf(value) : value);\n\n  function getValue() {\n    return toValue(Number(input.value));\n  }\n\n  function render() {\n    const value = getValue();\n    valueText.textContent = format(value);\n    input.setAttribute(\"aria-valuetext\", describe(value));\n  }\n\n  /** Move the slider to `value` without calling `onInput`. */\n  function setValue(value) {\n    input.value = String(toPosition(value));\n    render();\n  }\n\n  input.addEventListener(\"input\", () => {\n    render();\n    onInput?.(getValue());\n  });\n\n  render();\n\n  return { getValue, setValue };\n}\n",
          "folderId": "1",
          "active": true
        }
      },
      "openFiles": [
