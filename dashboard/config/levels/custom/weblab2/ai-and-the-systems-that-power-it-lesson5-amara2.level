    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>FieldVet</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n<script src=\"script.js\" defer></script>\n</head>\n<body>\n\n<h1 class=\"sr-only\">FieldVet: one morning at Halvorsen Farm</h1>\n\n<svg class=\"sprite\" aria-hidden=\"true\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\">\n\n  <symbol id=\"t-processor\" viewBox=\"0 0 24 24\">\n    <rect x=\"6\" y=\"6\" width=\"12\" height=\"12\" rx=\"2\"/>\n    <rect x=\"9.5\" y=\"9.5\" width=\"5\" height=\"5\" rx=\"1\" fill=\"#FFFFFF\"/>\n    <rect x=\"8.6\" y=\"2.5\" width=\"1.6\" height=\"3\"/><rect x=\"13.8\" y=\"2.5\" width=\"1.6\" height=\"3\"/>\n    <rect x=\"8.6\" y=\"18.5\" width=\"1.6\" height=\"3\"/><rect x=\"13.8\" y=\"18.5\" width=\"1.6\" height=\"3\"/>\n    <rect x=\"2.5\" y=\"8.6\" width=\"3\" height=\"1.6\"/><rect x=\"2.5\" y=\"13.8\" width=\"3\" height=\"1.6\"/>\n    <rect x=\"18.5\" y=\"8.6\" width=\"3\" height=\"1.6\"/><rect x=\"18.5\" y=\"13.8\" width=\"3\" height=\"1.6\"/>\n  </symbol>\n  <symbol id=\"t-storage\" viewBox=\"0 0 24 24\">\n    <ellipse cx=\"12\" cy=\"6\" rx=\"8\" ry=\"3\"/>\n    <path d=\"M4 6v5c0 1.7 3.6 3 8 3s8-1.3 8-3V6c0 1.7-3.6 3-8 3S4 7.7 4 6z\"/>\n    <path d=\"M4 13v5c0 1.7 3.6 3 8 3s8-1.3 8-3v-5c0 1.7-3.6 3-8 3s-8-1.3-8-3z\"/>\n  </symbol>\n  <symbol id=\"t-network\" viewBox=\"0 0 24 24\">\n    <circle cx=\"12\" cy=\"18.5\" r=\"2.4\"/>\n    <path d=\"M6.5 14.2a7.8 7.8 0 0 1 11 0l-1.8 1.8a5.2 5.2 0 0 0-7.4 0z\"/>\n    <path d=\"M3 10.7a12.8 12.8 0 0 1 18 0l-1.8 1.8a10.2 10.2 0 0 0-14.4 0z\"/>\n  </symbol>\n  <symbol id=\"t-memory\" viewBox=\"0 0 24 24\">\n    <path d=\"M3 7h18v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/>\n    <rect x=\"6\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"9.6\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"13.2\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"16.8\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"5\" y=\"19\" width=\"4\" height=\"2.5\" rx=\"1\"/><rect x=\"15\" y=\"19\" width=\"4\" height=\"2.5\" rx=\"1\"/>\n  </symbol>\n\n  <symbol id=\"a-exam\" viewBox=\"0 0 24 24\">\n    <path d=\"M5 3v5a4 4 0 0 0 8 0V3h-2v5a2 2 0 0 1-4 0V3z\"/>\n    <path d=\"M8 13v2a5 5 0 0 0 10 0v-2h-2v2a3 3 0 0 1-6 0v-2z\"/>\n    <circle cx=\"18\" cy=\"8\" r=\"3\"/><circle cx=\"18\" cy=\"8\" r=\"1.2\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"a-photo\" viewBox=\"0 0 24 24\">\n    <path d=\"M9 4h6l1.4 2.2H20a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8.2a2 2 0 0 1 2-2h3.6z\"/>\n    <circle cx=\"12\" cy=\"13\" r=\"4.4\" fill=\"#FFFFFF\"/><circle cx=\"12\" cy=\"13\" r=\"2.6\"/>\n  </symbol>\n  <symbol id=\"a-record\" viewBox=\"0 0 24 24\">\n    <rect x=\"4\" y=\"3\" width=\"16\" height=\"19\" rx=\"2\"/>\n    <rect x=\"8.5\" y=\"1.4\" width=\"7\" height=\"3.4\" rx=\"1.2\"/>\n    <rect x=\"7.5\" y=\"9\" width=\"9\" height=\"1.7\" fill=\"#FFFFFF\"/>\n    <rect x=\"7.5\" y=\"13\" width=\"9\" height=\"1.7\" fill=\"#FFFFFF\"/>\n    <rect x=\"7.5\" y=\"17\" width=\"5.5\" height=\"1.7\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"a-send\" viewBox=\"0 0 24 24\">\n    <path d=\"M2 11.5 22 3l-8.5 19-2.6-7.4z\"/>\n    <path d=\"m11 14.6 9.4-10.2L9.3 12z\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"a-check\" viewBox=\"0 0 24 24\">\n    <path d=\"M9.4 18.6 3 12.2l2.3-2.3 4.1 4.1L18.7 5l2.3 2.3z\"/>\n  </symbol>\n  <symbol id=\"a-chevron\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 15.6 3.9 7.5a1.6 1.6 0 0 1 2.2-2.2l5.9 5.9 5.9-5.9a1.6 1.6 0 0 1 2.2 2.2z\"/>\n  </symbol>\n  <symbol id=\"a-reset\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 4.5a7.5 7.5 0 1 0 7.2 9.6h-2.7A4.9 4.9 0 1 1 12 7.1a4.8 4.8 0 0 1 3.4 1.4L12.6 11.3H21V2.9l-2.7 2.7A7.5 7.5 0 0 0 12 4.5z\"/>\n  </symbol>\n  <symbol id=\"a-alert\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 2.5 23 21H1z\"/>\n    <rect x=\"11\" y=\"9\" width=\"2\" height=\"6\" rx=\"1\" fill=\"#FFFFFF\"/>\n    <circle cx=\"12\" cy=\"18\" r=\"1.3\" fill=\"#FFFFFF\"/>\n  </symbol>\n\n  <symbol id=\"g-display\" viewBox=\"0 0 24 24\">\n    <rect x=\"2\" y=\"3.5\" width=\"20\" height=\"14\" rx=\"2\"/>\n    <rect x=\"4.5\" y=\"6\" width=\"15\" height=\"9\" fill=\"#FFFFFF\"/>\n    <rect x=\"8\" y=\"19.5\" width=\"8\" height=\"2\" rx=\"1\"/>\n  </symbol>\n  <symbol id=\"g-camera\" viewBox=\"0 0 24 24\">\n    <path d=\"M9 4h6l1.4 2.2H20a2 2 0 0 1 2 2V18a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8.2a2 2 0 0 1 2-2h3.6z\"/>\n    <circle cx=\"12\" cy=\"13\" r=\"4.4\" fill=\"#FFFFFF\"/><circle cx=\"12\" cy=\"13\" r=\"2.6\"/>\n  </symbol>\n  <symbol id=\"g-storage\" viewBox=\"0 0 24 24\">\n    <ellipse cx=\"12\" cy=\"6\" rx=\"8\" ry=\"3\"/>\n    <path d=\"M4 6v5c0 1.7 3.6 3 8 3s8-1.3 8-3V6c0 1.7-3.6 3-8 3S4 7.7 4 6z\"/>\n    <path d=\"M4 13v5c0 1.7 3.6 3 8 3s8-1.3 8-3v-5c0 1.7-3.6 3-8 3s-8-1.3-8-3z\"/>\n  </symbol>\n  <symbol id=\"g-network\" viewBox=\"0 0 24 24\">\n    <rect x=\"10.6\" y=\"9\" width=\"2.8\" height=\"13\" rx=\"1\"/>\n    <path d=\"M12 2a7 7 0 0 0-7 7h2.6A4.4 4.4 0 0 1 12 4.6z\"/>\n    <path d=\"M12 2a7 7 0 0 1 7 7h-2.6A4.4 4.4 0 0 0 12 4.6z\"/>\n    <circle cx=\"12\" cy=\"8\" r=\"2.2\"/>\n  </symbol>\n  <symbol id=\"g-battery\" viewBox=\"0 0 24 24\">\n    <rect x=\"2\" y=\"6\" width=\"17\" height=\"12\" rx=\"2.4\"/>\n    <rect x=\"20\" y=\"10\" width=\"2.6\" height=\"4\" rx=\"1\"/>\n    <rect x=\"4.4\" y=\"8.4\" width=\"6\" height=\"7.2\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"g-app\" viewBox=\"0 0 24 24\">\n    <rect x=\"2.5\" y=\"2.5\" width=\"8\" height=\"8\" rx=\"2\"/>\n    <rect x=\"13.5\" y=\"2.5\" width=\"8\" height=\"8\" rx=\"2\"/>\n    <rect x=\"2.5\" y=\"13.5\" width=\"8\" height=\"8\" rx=\"2\"/>\n    <rect x=\"13.5\" y=\"13.5\" width=\"8\" height=\"8\" rx=\"2\"/>\n  </symbol>\n  <symbol id=\"g-settings\" viewBox=\"0 0 24 24\">\n    <rect x=\"2\" y=\"4.6\" width=\"20\" height=\"2.2\" rx=\"1.1\"/>\n    <rect x=\"2\" y=\"10.9\" width=\"20\" height=\"2.2\" rx=\"1.1\"/>\n    <rect x=\"2\" y=\"17.2\" width=\"20\" height=\"2.2\" rx=\"1.1\"/>\n    <circle cx=\"8\" cy=\"5.7\" r=\"3\"/><circle cx=\"16\" cy=\"12\" r=\"3\"/><circle cx=\"10\" cy=\"18.3\" r=\"3\"/>\n    <circle cx=\"8\" cy=\"5.7\" r=\"1.3\" fill=\"#FFFFFF\"/><circle cx=\"16\" cy=\"12\" r=\"1.3\" fill=\"#FFFFFF\"/>\n    <circle cx=\"10\" cy=\"18.3\" r=\"1.3\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"g-animals\" viewBox=\"0 0 24 24\">\n    <ellipse cx=\"5\" cy=\"9\" rx=\"3\" ry=\"2\"/><ellipse cx=\"19\" cy=\"9\" rx=\"3\" ry=\"2\"/>\n    <path d=\"M7 6h10v8a5 5 0 0 1-10 0z\"/>\n    <ellipse cx=\"12\" cy=\"16\" rx=\"4.4\" ry=\"3.4\" fill=\"#FFFFFF\"/>\n    <circle cx=\"10.4\" cy=\"16\" r=\"0.9\"/><circle cx=\"13.6\" cy=\"16\" r=\"0.9\"/>\n    <circle cx=\"9.4\" cy=\"10\" r=\"1.1\" fill=\"#FFFFFF\"/><circle cx=\"14.6\" cy=\"10\" r=\"1.1\" fill=\"#FFFFFF\"/>\n  </symbol>\n\n  <symbol id=\"i-cow\" viewBox=\"0 0 48 48\">\n    <ellipse cx=\"9\" cy=\"17\" rx=\"6\" ry=\"4\"/><ellipse cx=\"39\" cy=\"17\" rx=\"6\" ry=\"4\"/>\n    <path d=\"M13 12h22v15a11 11 0 0 1-22 0z\"/>\n    <ellipse cx=\"24\" cy=\"31\" rx=\"9\" ry=\"7\" fill=\"#FFFFFF\"/>\n    <circle cx=\"20.5\" cy=\"31\" r=\"1.6\"/><circle cx=\"27.5\" cy=\"31\" r=\"1.6\"/>\n    <circle cx=\"18\" cy=\"19\" r=\"2.1\" fill=\"#FFFFFF\"/><circle cx=\"30\" cy=\"19\" r=\"2.1\" fill=\"#FFFFFF\"/>\n    <path d=\"M17 6c-3 0-4 3-2 5l3-2z\"/><path d=\"M31 6c3 0 4 3 2 5l-3-2z\"/>\n  </symbol>\n  <symbol id=\"i-goat\" viewBox=\"0 0 48 48\">\n    <path d=\"M15 12C11 6 6 6 5 9c3 0 6 2 7 6z\"/><path d=\"M33 12c4-6 9-6 10-3-3 0-6 2-7 6z\"/>\n    <ellipse cx=\"11\" cy=\"21\" rx=\"5\" ry=\"3\"/><ellipse cx=\"37\" cy=\"21\" rx=\"5\" ry=\"3\"/>\n    <path d=\"M16 14h16v13c0 6-3 9-8 9s-8-3-8-9z\"/>\n    <circle cx=\"20\" cy=\"21\" r=\"2\" fill=\"#FFFFFF\"/><circle cx=\"28\" cy=\"21\" r=\"2\" fill=\"#FFFFFF\"/>\n    <ellipse cx=\"24\" cy=\"31\" rx=\"4\" ry=\"3\" fill=\"#FFFFFF\"/>\n    <path d=\"M21 37h6l-3 7z\"/>\n  </symbol>\n  <symbol id=\"i-sheep\" viewBox=\"0 0 48 48\">\n    <circle cx=\"14\" cy=\"18\" r=\"7\"/><circle cx=\"34\" cy=\"18\" r=\"7\"/><circle cx=\"24\" cy=\"13\" r=\"7\"/>\n    <circle cx=\"16\" cy=\"28\" r=\"7\"/><circle cx=\"32\" cy=\"28\" r=\"7\"/>\n    <ellipse cx=\"24\" cy=\"30\" rx=\"9\" ry=\"10\" fill=\"#FFFFFF\"/>\n    <ellipse cx=\"24\" cy=\"30\" rx=\"7.5\" ry=\"8.5\"/>\n    <circle cx=\"21\" cy=\"28\" r=\"1.7\" fill=\"#FFFFFF\"/><circle cx=\"27\" cy=\"28\" r=\"1.7\" fill=\"#FFFFFF\"/>\n    <ellipse cx=\"24\" cy=\"35\" rx=\"3\" ry=\"2\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"i-hog\" viewBox=\"0 0 48 48\">\n    <path d=\"M11 13l2 8-6-2z\"/><path d=\"M37 13l-2 8 6-2z\"/>\n    <path d=\"M11 20a13 13 0 0 1 26 0v6a13 13 0 0 1-26 0z\"/>\n    <circle cx=\"18\" cy=\"21\" r=\"2.1\" fill=\"#FFFFFF\"/><circle cx=\"30\" cy=\"21\" r=\"2.1\" fill=\"#FFFFFF\"/>\n    <ellipse cx=\"24\" cy=\"31\" rx=\"8\" ry=\"6\" fill=\"#FFFFFF\"/>\n    <ellipse cx=\"21\" cy=\"31\" rx=\"1.6\" ry=\"2.2\"/><ellipse cx=\"27\" cy=\"31\" rx=\"1.6\" ry=\"2.2\"/>\n  </symbol>\n</svg>\n\n<div class=\"device\">\n  <div class=\"screen\">\n\n    <div class=\"statusbar\">\n      <div class=\"stat\"><span class=\"stat-label\">Time</span><span class=\"stat-value\" id=\"stat-clock\">8:00 AM</span></div>\n      <div class=\"stat has-gauge\"><span class=\"stat-label\">Battery</span><span class=\"stat-value\" id=\"stat-battery\">100%</span><span class=\"gauge\"><span class=\"gauge-fill\" id=\"gauge-battery\"></span></span></div>\n      <div class=\"stat has-gauge\"><span class=\"stat-label\">Drive</span><span class=\"stat-value\" id=\"stat-drive\">40%</span><span class=\"gauge\"><span class=\"gauge-fill\" id=\"gauge-drive\"></span></span></div>\n      <div class=\"stat\"><span class=\"stat-label\">Speed</span><span class=\"stat-value\" id=\"stat-speed\">Full speed</span></div>\n      <div class=\"stat\"><span class=\"stat-label\">Signal</span><span class=\"stat-value\" id=\"stat-signal\">No service</span><span class=\"bars\" id=\"signal-bars\" aria-hidden=\"true\"><span class=\"bar-seg\"></span><span class=\"bar-seg\"></span><span class=\"bar-seg\"></span></span></div>\n      <button type=\"button\" class=\"reset\" id=\"reset-btn\" aria-label=\"Start the morning over\">\n        <svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-reset\"></use></svg>\n      </button>\n    </div>\n\n    <div class=\"procbar\"><div class=\"procbar-fill\" id=\"procbar-fill\"></div></div>\n\n    <main class=\"body\">\n\n      <section class=\"view\" id=\"view-brief\">\n        <div class=\"hero\">\n          <h2 class=\"hero-title\">FieldVet<br>Animal Tracking System</h2>\n        </div>\n\n        <h3 class=\"brief-head\">The situation</h3>\n        <p class=\"lede\">Amara is a large animal vet. This morning she has four sick animals to see at Nibori Farm. She writes her notes, takes her photos, and saves every record on one tablet.</p>\n\n        <h3 class=\"brief-head\">Your job</h3>\n        <p class=\"lede\">Amara handles the animals. You handle the tablet. Every time a problem comes up, open <strong>Settings</strong>, figure out which setting is causing it, and change it. Some settings will fix the problem. Many of them will not do anything at all, and every change you make uses up minutes that Amara needs.</p>\n\n        <h3 class=\"brief-head\">For each animal, she will</h3>\n        <ul class=\"steplist\">\n          <li class=\"step-item\"><span class=\"step-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-exam\"></use></svg></span><span class=\"step-name\">Examine</span></li>\n          <li class=\"step-item\"><span class=\"step-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-photo\"></use></svg></span><span class=\"step-name\">Photograph</span></li>\n          <li class=\"step-item\"><span class=\"step-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-record\"></use></svg></span><span class=\"step-name\">Write the record</span></li>\n          <li class=\"step-item\"><span class=\"step-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#a-send\"></use></svg></span><span class=\"step-name\">Send the data</span></li>\n        </ul>\n        <p class=\"lede\">Work them in any order you like.</p>\n\n        <h3 class=\"brief-head\">A good morning looks like this</h3>\n        <ul class=\"goals\" id=\"brief-goals\"></ul>\n\n        <div class=\"actions\">\n          <button type=\"button\" class=\"btn btn-go btn-lg\" id=\"start-btn\">Start the morning</button>\n        </div>\n      </section>\n\n      <section class=\"view\" id=\"view-farm\" hidden>\n        <div class=\"banner\" id=\"banner\" hidden role=\"alert\"></div>\n        <div class=\"section-head\">\n          <h2 class=\"section-title\">Today's animals</h2>\n          <span class=\"section-chip\" id=\"pen-chip\"></span>\n        </div>\n        <ul class=\"pen\" id=\"pen\"></ul>\n        <div class=\"detail\" id=\"detail\" hidden></div>\n        <div class=\"finish\" id=\"finish\"></div>\n      </section>\n\n      <section class=\"view\" id=\"view-settings\" hidden>\n        <div class=\"section-head\">\n          <h2 class=\"section-title\">Settings</h2>\n        </div>\n        <div class=\"symptom\" id=\"symptom\" hidden aria-live=\"polite\"></div>\n        <p class=\"settings-note\" id=\"settings-note\"></p>\n        <div class=\"groups\" id=\"groups\"></div>\n      </section>\n\n      <section class=\"view\" id=\"view-report\" hidden>\n        <div class=\"hero hero-purple\">\n          <p class=\"hero-kicker\">Morning report</p>\n          <h2 class=\"hero-title\" id=\"report-headline\">Morning Report</h2>\n          <p class=\"hero-sub\" id=\"report-sub\"></p>\n          <p class=\"verdict\" id=\"verdict\"></p>\n        </div>\n        <ul class=\"report-list\" id=\"report-list\"></ul>\n        <h3>Where the morning went</h3>\n        <div class=\"tally\" id=\"tally\"></div>\n        <div class=\"report-notes\" id=\"report-notes\"></div>\n        <h3>Questions</h3>\n        <ol class=\"questions\" id=\"questions\"></ol>\n        <div class=\"actions\">\n          <button type=\"button\" class=\"btn btn-go\" id=\"again-btn\">Try the morning again</button>\n        </div>\n      </section>\n\n    </main>\n\n    <div class=\"sheet\" id=\"sheet\" hidden>\n      <div class=\"sheet-card\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"sheet-title\">\n        <h2 class=\"sheet-title\" id=\"sheet-title\">Start the morning over?</h2>\n        <p class=\"sheet-body\">The clock goes back to 8:00 AM, every setting goes back to how it started, and the four animals are waiting again.</p>\n        <div class=\"actions\">\n          <button type=\"button\" class=\"btn btn-go\" id=\"sheet-yes\">Yes, start over</button>\n          <button type=\"button\" class=\"btn btn-alt\" id=\"sheet-no\">Keep going</button>\n        </div>\n      </div>\n    </div>\n\n    <nav class=\"tabbar\" id=\"tabbar\" aria-label=\"FieldVet sections\" hidden>\n      <button type=\"button\" class=\"tab\" data-tab=\"farm\">\n        <span class=\"tab-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#g-animals\"></use></svg></span>\n        <span class=\"tab-label\">Animals</span>\n      </button>\n      <button type=\"button\" class=\"tab\" data-tab=\"settings\">\n        <span class=\"tab-icon\"><svg aria-hidden=\"true\" focusable=\"false\"><use href=\"#g-settings\"></use></svg></span>\n        <span class=\"tab-label\">Settings</span>\n        <span class=\"tab-dot\" id=\"tab-dot\" hidden></span>\n      </button>\n    </nav>\n\n  </div>\n</div>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "/* Brand fonts, subset to Latin. Any glyph they lack falls through to the\n   next family in each stack, so other writing systems still render. */\n@font-face {\n  font-family: \"Space Grotesk\";\n  src: url(\"SpaceGrotesk.ttf\") format(\"truetype\");\n  font-weight: 300 700;\n  font-display: swap;\n}\n\n@font-face {\n  font-family: \"Geist\";\n  src: url(\"Geist.ttf\") format(\"truetype\");\n  font-weight: 100 900;\n  font-display: swap;\n}\n\n:root {\n  --purple-light: #E4E2F8;\n  --purple-mid: #ACA8EA;\n  --purple: #4C42CF;\n  --purple-dark: #1F1976;\n  --blue-light: #D5EFFF;\n  --blue-mid: #6FCAFF;\n  --blue: #0099F3;\n  --blue-dark: #06338D;\n  --green-light: #CCF1D0;\n  --green-mid: #7CDB87;\n  --green: #34BD43;\n  --green-dark: #003F25;\n  --orange-light: #FFE3CE;\n  --orange-mid: #FFA868;\n  --orange: #F46800;\n  --orange-dark: #611D00;\n  --pink-light: #FBDAE8;\n  --pink-mid: #F07FB0;\n  --pink: #E11970;\n  --pink-dark: #7D0C3D;\n\n  --ink: #000000;\n  --ink-soft: #4A4857;\n  --line: #D6D4E0;\n  --tint: #F7F6FC;\n\n  --lift: 0 2px 0 rgba(31, 25, 118, 0.14);\n  --lift-lg: 0 4px 16px rgba(31, 25, 118, 0.18);\n\n  --font-display: \"Space Grotesk\", \"Noto Sans\", system-ui, sans-serif;\n  --font-body: \"Geist\", \"Noto Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n}\n\n* { box-sizing: border-box; }\n[hidden] { display: none !important; }\nhtml, body { height: 100%; }\n\nbody {\n  margin: 0;\n  padding: 10px;\n  background-color: var(--purple-light);\n  font-family: var(--font-body);\n  font-size: 15px;\n  color: var(--ink);\n  line-height: 1.45;\n}\n\n.sr-only {\n  position: absolute; width: 1px; height: 1px;\n  padding: 0; margin: -1px; overflow: hidden;\n  clip: rect(0 0 0 0); white-space: nowrap; border: 0;\n}\n\n.sprite { position: absolute; width: 0; height: 0; }\n\n.device {\n  max-width: 44rem;\n  margin-inline: auto;\n  background-color: var(--purple-dark);\n  border-radius: 20px;\n  padding: 10px;\n  box-shadow: var(--lift-lg);\n}\n\n.screen {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  height: min(42rem, calc(100dvh - 40px));\n  min-height: 26rem;\n  background-color: #FFFFFF;\n  border-radius: 12px;\n  overflow: hidden;\n}\n\n/* ---------- status bar ---------- */\n\n.statusbar {\n  display: flex; flex-wrap: wrap;\n  gap: 0.3rem 1.3rem;\n  padding: 0.5rem 0.85rem;\n  background-color: var(--purple-dark);\n  color: #FFFFFF;\n  flex: 0 0 auto;\n}\n\n.stat { display: flex; flex-direction: column; line-height: 1.15; }\n.stat.has-gauge { min-width: 4.4rem; }\n\n.stat-label {\n  font-size: 0.6rem; letter-spacing: 0.08em;\n  text-transform: uppercase; color: var(--purple-mid);\n}\n\n.stat-value { font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; }\n.stat-value.warn { color: var(--orange-mid); }\n.stat-value.bad { color: var(--pink-mid); }\n\n.gauge {\n  display: block; height: 7px; margin-block-start: 0.25rem;\n  border-radius: 4px; overflow: hidden;\n  background-color: var(--purple-dark);\n  border: 1px solid var(--purple-mid);\n}\n\n.gauge-fill {\n  display: block; height: 100%; width: 0;\n  transition: width 260ms ease-out;\n}\n\n.gauge-fill.battery { background-color: var(--green-mid); }\n.gauge-fill.storage { background-color: var(--blue-mid); }\n.gauge-fill.warn { background-color: var(--orange-mid); }\n.gauge-fill.bad { background-color: var(--pink-mid); }\n\n.reset {\n  margin-inline-start: auto; align-self: center;\n  width: 38px; height: 38px; flex: 0 0 auto;\n  display: flex; align-items: center; justify-content: center;\n  border-radius: 10px; cursor: pointer;\n  background-color: var(--purple); color: #FFFFFF;\n  border: 2px solid var(--purple-mid);\n}\n\n.reset svg { width: 21px; height: 21px; fill: currentColor; }\n\n.procbar { flex: 0 0 auto; height: 5px; background-color: var(--purple-light); }\n.procbar-fill { height: 100%; width: 0; background-color: var(--orange); transition: width linear; }\n\n@media (max-width: 26rem) {\n  .statusbar { gap: 0.3rem 0.9rem; padding: 0.45rem 0.65rem; }\n  .stat-value { font-size: 0.86rem; }\n}\n\n.bars {\n  display: flex; align-items: flex-end; gap: 2px;\n  height: 12px; margin-block-start: 0.25rem;\n}\n\n.bar-seg {\n  display: block; width: 5px;\n  border-radius: 1px;\n  background-color: var(--purple-dark);\n  border: 1px solid var(--purple-mid);\n}\n\n.bar-seg:nth-child(1) { height: 5px; }\n.bar-seg:nth-child(2) { height: 8px; }\n.bar-seg:nth-child(3) { height: 12px; }\n\n.bar-seg.on { border-color: transparent; }\n.bar-seg.on.low { background-color: var(--orange-mid); }\n.bar-seg.on.medium { background-color: var(--green-mid); }\n.bar-seg.on.high { background-color: var(--green-mid); }\n\n/* ---------- layout ---------- */\n\n.body { flex: 1 1 auto; overflow-y: auto; overscroll-behavior: contain; }\n.view { padding: 0.85rem 0.9rem 1.1rem; }\n\nh2, h3 { font-family: var(--font-display); margin: 0; }\nh3 { font-size: 1rem; color: var(--purple-dark); margin-block-end: 0.35rem; }\n\n.section-head {\n  display: flex; align-items: center; gap: 0.5rem;\n  margin-block-end: 0.55rem;\n}\n\n.section-title {\n  font-size: 1.3rem; line-height: 0.95;\n  letter-spacing: -0.02em; color: var(--purple-dark);\n}\n\n.section-chip {\n  margin-inline-start: auto;\n  font-family: var(--font-display); font-weight: 700; font-size: 0.72rem;\n  letter-spacing: 0.04em; text-transform: uppercase;\n  color: var(--purple-dark); background-color: var(--purple-light);\n  padding: 0.2rem 0.6rem; border-radius: 999px;\n}\n\n/* ---------- hero band ----------\n   Brand gradient: Primary at the top, Mid in the middle, Light at the bottom.\n   White type stays in the Primary region. */\n\n.hero {\n  border-radius: 14px;\n  padding: 1rem 1rem 1.1rem;\n  margin-block-end: 0.9rem;\n  background-image: linear-gradient(180deg, var(--purple) 0%, var(--purple-mid) 62%, var(--purple-light) 100%);\n}\n\n.hero-kicker {\n  margin: 0 0 0.3rem;\n  font-family: var(--font-display); font-weight: 700;\n  font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase;\n  color: #FFFFFF;\n}\n\n.hero-title {\n  font-size: 1.8rem; line-height: 0.94;\n  letter-spacing: -0.02em; color: #FFFFFF;\n  margin-block-end: 0.55rem;\n}\n\n.hero-title:only-child { margin-block-end: 0; }\n\n.hero-sub {\n  margin: 0;\n  font-size: 0.9rem; font-weight: 600;\n  color: var(--purple-dark);\n}\n\n.verdict {\n  display: inline-block; margin: 0.6rem 0 0;\n  font-family: var(--font-display); font-weight: 700; font-size: 0.83rem;\n  padding: 0.3rem 0.75rem; border-radius: 999px;\n  background-color: var(--pink-light); color: var(--pink-dark);\n}\n\n.verdict.good { background-color: var(--green-light); color: var(--green-dark); }\n\n/* ---------- brief ---------- */\n\n.brief-head {\n  font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase;\n  color: var(--purple); margin-block-end: 0.3rem;\n}\n\n.brief-head + .lede { margin-block-start: 0; }\n.lede { margin: 0 0 0.7rem; font-size: 0.93rem; }\n.lede strong { color: var(--purple-dark); }\n\n.goals { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.3rem; }\n\n.goals li {\n  display: flex; align-items: flex-start; gap: 0.5rem;\n  font-size: 0.88rem; color: var(--green-dark);\n  background-color: var(--green-light);\n  border-radius: 9px; padding: 0.35rem 0.55rem;\n}\n\n.goal-icon {\n  flex: 0 0 auto; width: 20px; height: 20px; border-radius: 6px;\n  background-color: var(--green-dark); color: #FFFFFF;\n  display: flex; align-items: center; justify-content: center;\n}\n\n.goal-icon svg { width: 12px; height: 12px; fill: currentColor; }\n\n.steplist {\n  list-style: none; margin: 0 0 0.85rem; padding: 0;\n  display: grid; gap: 0.45rem;\n  grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));\n}\n\n.step-item {\n  display: flex; align-items: center; gap: 0.55rem;\n  border-radius: 12px; padding: 0.5rem 0.6rem;\n  background-color: var(--tint);\n  border: 2px solid var(--purple-light);\n}\n\n.step-icon {\n  flex: 0 0 auto; width: 34px; height: 34px; border-radius: 9px;\n  background-color: var(--purple); color: #FFFFFF;\n  display: flex; align-items: center; justify-content: center;\n}\n\n.step-icon svg { width: 21px; height: 21px; fill: currentColor; }\n.step-name { font-family: var(--font-display); font-weight: 700; font-size: 0.87rem; color: var(--purple-dark); }\n\n.thesis {\n  margin: 0 0 1rem; padding: 0.7rem 0.85rem; border-radius: 12px;\n  background-color: var(--purple-light);\n  border-inline-start: 6px solid var(--purple);\n  color: var(--purple-dark); font-weight: 600; font-size: 0.92rem;\n}\n\n/* ---------- banner ---------- */\n\n.banner {\n  border-radius: 14px; overflow: hidden;\n  margin-block-end: 0.85rem;\n  background-color: var(--orange-light);\n  border: 2px solid var(--orange-dark);\n  box-shadow: var(--lift);\n}\n\n.banner.hard { background-color: var(--pink-light); border-color: var(--pink-dark); }\n\n.banner-head {\n  display: flex; align-items: center; gap: 0.55rem;\n  padding: 0.5rem 0.7rem;\n  background-color: var(--orange-dark);\n}\n\n.banner.hard .banner-head { background-color: var(--pink-dark); }\n\n.banner-icon {\n  flex: 0 0 auto; width: 28px; height: 28px; border-radius: 8px;\n  background-color: #FFFFFF; color: var(--orange-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.banner.hard .banner-icon { color: var(--pink-dark); }\n.banner-icon svg { width: 18px; height: 18px; fill: currentColor; }\n.banner-title { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 0.97rem; color: #FFFFFF; }\n\n.banner-voice {\n  margin: 0; padding: 0.6rem 0.75rem 0.5rem;\n  font-size: 0.88rem; font-style: italic; color: var(--orange-dark);\n}\n\n.banner.hard .banner-voice { color: var(--pink-dark); }\n.banner .actions { padding: 0 0.75rem 0.7rem; }\n\n/* ---------- animal picker ---------- */\n\n.pen {\n  list-style: none; margin: 0 0 0.85rem; padding: 0;\n  display: grid; gap: 0.5rem;\n  grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));\n}\n\n.beast {\n  width: 100%;\n  display: flex; flex-direction: column; align-items: center; gap: 0.3rem;\n  font: inherit; color: inherit; cursor: pointer;\n  border: 2px solid var(--purple-light); border-radius: 14px;\n  background-color: #FFFFFF; padding: 0.6rem 0.45rem 0.5rem;\n  min-height: 44px;\n  box-shadow: var(--lift);\n  transition: transform 120ms ease-out;\n}\n\n.beast:active { transform: translateY(1px); }\n.beast.picked { border-color: var(--purple-dark); background-color: var(--purple); }\n.beast.done { border-color: var(--green); background-color: var(--green-light); }\n\n.beast-icon {\n  width: 52px; height: 52px; border-radius: 13px;\n  background-color: var(--purple-light); color: var(--purple-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.beast.picked .beast-icon { background-color: #FFFFFF; color: var(--purple); }\n.beast.done .beast-icon { background-color: #FFFFFF; color: var(--green-dark); }\n.beast-icon svg { width: 40px; height: 40px; fill: currentColor; }\n\n.beast-name { font-family: var(--font-display); font-weight: 700; font-size: 0.92rem; color: var(--purple-dark); }\n.beast.picked .beast-name { color: #FFFFFF; }\n.beast.done .beast-name { color: var(--green-dark); }\n\n.pips {\n  display: flex; gap: 0.22rem;\n  padding: 0.2rem; border-radius: 9px;\n  background-color: var(--tint);\n}\n\n.beast.picked .pips { background-color: var(--purple-dark); }\n\n.pip {\n  width: 21px; height: 21px; border-radius: 6px;\n  background-color: var(--purple-light); color: var(--purple-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.pip svg { width: 13px; height: 13px; fill: currentColor; }\n.pip-done { background-color: var(--green-dark); color: #FFFFFF; }\n\n/* ---------- animal detail ---------- */\n\n.detail {\n  border-radius: 14px; overflow: hidden;\n  margin-block-end: 0.85rem;\n  background-color: #FFFFFF;\n  border: 2px solid var(--purple-light);\n  box-shadow: var(--lift);\n}\n\n.detail.empty {\n  padding: 0.95rem; color: var(--ink-soft);\n  font-size: 0.9rem; font-style: italic;\n  background-color: var(--tint);\n}\n\n.detail.empty p { margin: 0; }\n\n.detail-head {\n  display: flex; align-items: center; gap: 0.6rem;\n  padding: 0.6rem 0.75rem 0.7rem;\n  background-image: linear-gradient(180deg, var(--purple) 0%, var(--purple-mid) 62%, var(--purple-light) 100%);\n}\n\n.detail-icon {\n  flex: 0 0 auto; width: 48px; height: 48px; border-radius: 12px;\n  background-color: #FFFFFF; color: var(--purple);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.detail-icon svg { width: 36px; height: 36px; fill: currentColor; }\n.detail-id { display: flex; flex-direction: column; min-width: 0; }\n.detail-name { font-family: var(--font-display); font-weight: 700; font-size: 1.12rem; line-height: 1.05; color: #FFFFFF; }\n.detail-kind { font-size: 0.78rem; font-weight: 600; color: var(--purple-dark); }\n\n.detail-body { padding: 0.7rem 0.75rem 0.8rem; }\n.complaint { margin: 0 0 0.5rem; font-size: 0.89rem; font-style: italic; color: var(--ink-soft); }\n\n.findings { list-style: none; margin: 0 0 0.6rem; padding: 0; display: grid; gap: 0.25rem; }\n\n.findings li {\n  font-size: 0.86rem;\n  padding: 0.32rem 0.5rem 0.32rem 0.55rem;\n  border-radius: 8px;\n  background-color: var(--purple-light);\n  border-inline-start: 4px solid var(--purple);\n  color: var(--purple-dark);\n}\n\n.shot { margin: 0 0 0.6rem; }\n\n.shot-img {\n  display: block; width: 100%; max-width: 230px; height: auto;\n  border-radius: 12px; border: 3px solid var(--blue);\n}\n\n.q-standard { filter: blur(0.6px); }\n.q-low { filter: blur(1.6px); image-rendering: pixelated; }\n\n.shot-cap {\n  margin: 0.35rem 0 0; font-size: 0.77rem; font-weight: 600;\n  color: var(--blue-dark);\n}\n\n.detail-note {\n  margin: 0.5rem 0 0; padding: 0.45rem 0.6rem; border-radius: 9px;\n  font-size: 0.8rem; font-weight: 600;\n  background-color: var(--pink-light); color: var(--pink-dark);\n}\n\n/* ---------- finish ---------- */\n\n.finish {\n  border-radius: 14px; padding: 0.7rem 0.75rem;\n  background-color: var(--tint);\n  border: 2px dashed var(--purple);\n}\n\n.finish-note { margin: 0.4rem 0 0; font-size: 0.79rem; color: var(--ink-soft); }\n\n/* ---------- settings page ---------- */\n\n.symptom {\n  border-radius: 12px; padding: 0.6rem 0.75rem; margin-block-end: 0.6rem;\n  background-color: var(--pink-light);\n  border-inline-start: 6px solid var(--pink);\n}\n\n.symptom.good { background-color: var(--green-light); border-inline-start-color: var(--green); }\n.symptom-line { margin: 0; font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; color: var(--pink-dark); }\n.symptom.good .symptom-line { color: var(--green-dark); }\n.symptom-hint { margin: 0.25rem 0 0; font-size: 0.83rem; color: var(--pink-dark); }\n\n.settings-note { margin: 0 0 0.7rem; font-size: 0.81rem; color: var(--ink-soft); }\n\n.groups { display: grid; gap: 0.85rem; }\n\n.group-head {\n  display: flex; align-items: center; gap: 0.5rem;\n  margin-block-end: 0.4rem;\n  padding-block-end: 0.35rem;\n  border-block-end: 3px solid var(--fam-dark);\n}\n\n.group-icon {\n  flex: 0 0 auto; width: 30px; height: 30px; border-radius: 9px;\n  background-color: var(--fam-dark); color: #FFFFFF;\n  display: flex; align-items: center; justify-content: center;\n}\n\n.group-icon svg { width: 19px; height: 19px; fill: currentColor; }\n.group-name { margin: 0; font-size: 1.02rem; color: var(--fam-dark); }\n\n.fam-display { --fam: #4C42CF; --fam-dark: #1F1976; --fam-light: #E4E2F8; }\n.fam-camera  { --fam: #0099F3; --fam-dark: #06338D; --fam-light: #D5EFFF; }\n.fam-storage { --fam: #0099F3; --fam-dark: #06338D; --fam-light: #D5EFFF; }\n.fam-network { --fam: #F46800; --fam-dark: #611D00; --fam-light: #FFE3CE; }\n.fam-battery { --fam: #34BD43; --fam-dark: #003F25; --fam-light: #CCF1D0; }\n.fam-app     { --fam: #E11970; --fam-dark: #7D0C3D; --fam-light: #FBDAE8; }\n\n.srow {\n  border: 2px solid var(--line); border-radius: 12px;\n  margin-block-end: 0.35rem; background-color: #FFFFFF;\n}\n\n.srow[open] { border-color: var(--fam); box-shadow: var(--lift); }\n\n.srow-summary {\n  display: flex; align-items: center; gap: 0.5rem;\n  padding: 0.5rem 0.65rem; cursor: pointer; min-height: 44px;\n  list-style: none;\n}\n\n.srow-summary::-webkit-details-marker { display: none; }\n.srow-name { font-family: var(--font-display); font-weight: 700; font-size: 0.88rem; color: var(--ink); }\n\n.srow-value {\n  margin-inline-start: auto; font-size: 0.78rem; font-weight: 600; color: var(--ink-soft);\n  padding: 0.14rem 0.5rem; border-radius: 999px; background-color: var(--tint);\n  border: 1px solid var(--line);\n}\n\n.srow-chevron {\n  flex: 0 0 auto; width: 24px; height: 24px; border-radius: 7px;\n  display: flex; align-items: center; justify-content: center;\n  background-color: var(--fam-light); color: var(--fam-dark);\n  transition: transform 140ms ease-out;\n}\n\n.srow-chevron svg { width: 15px; height: 15px; fill: currentColor; }\n.srow[open] .srow-chevron { background-color: var(--fam-dark); color: #FFFFFF; transform: rotate(180deg); }\n.srow-body { padding: 0 0.65rem 0.7rem; }\n.srow-why { margin: 0 0 0.5rem; font-size: 0.82rem; color: var(--ink-soft); }\n\n.options { display: grid; gap: 0.4rem; grid-template-columns: 1fr; }\n\n@media (min-width: 32rem) { .options { grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); } }\n\n.option {\n  display: flex; flex-direction: column; gap: 0.18rem;\n  text-align: start; font: inherit; color: var(--ink);\n  min-height: 44px; padding: 0.5rem 0.65rem;\n  border-radius: 11px; border: 2px solid var(--line);\n  background-color: #FFFFFF; cursor: pointer;\n  transition: transform 120ms ease-out;\n}\n\n.option:active { transform: translateY(1px); }\n.option-label { font-family: var(--font-display); font-weight: 700; font-size: 0.87rem; color: var(--purple-dark); }\n.option-note { font-size: 0.76rem; color: var(--ink-soft); line-height: 1.32; }\n\n.option[aria-pressed=\"true\"] { background-color: var(--purple); border-color: var(--purple-dark); }\n.option[aria-pressed=\"true\"] .option-label { color: #FFFFFF; }\n.option[aria-pressed=\"true\"] .option-note { color: var(--purple-light); }\n\n/* ---------- buttons ---------- */\n\n.actions { display: flex; flex-wrap: wrap; gap: 0.45rem; }\n\n.btn {\n  font-family: var(--font-display); font-weight: 700; font-size: 0.87rem;\n  min-height: 44px; padding: 0.5rem 0.9rem;\n  border-radius: 11px; border: 2px solid transparent; cursor: pointer;\n  text-align: start;\n  transition: transform 120ms ease-out;\n}\n\n.btn:active { transform: translateY(1px); }\n.btn-lg { font-size: 0.93rem; min-height: 48px; padding: 0.6rem 1.05rem; }\n.btn-go { background-color: var(--purple); color: #FFFFFF; border-color: var(--purple-dark); box-shadow: var(--lift); }\n.btn-alt { background-color: #FFFFFF; color: var(--purple-dark); border-color: var(--purple); }\n.btn-warn { background-color: var(--orange-light); color: var(--orange-dark); border-color: var(--orange); }\n.btn:disabled { cursor: not-allowed; background-color: #EDECF3; color: #56545F; border-color: var(--line); box-shadow: none; }\n\n@media (prefers-reduced-motion: reduce) {\n  .procbar-fill, .gauge-fill, .beast, .option, .btn, .srow-chevron { transition: none; }\n  .beast:active, .option:active, .btn:active { transform: none; }\n}\n\n/* ---------- report ---------- */\n\n.report-list { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.35rem; }\n\n.report-list li {\n  display: flex; flex-wrap: wrap; gap: 0.2rem 0.7rem;\n  justify-content: space-between; align-items: baseline;\n  border-radius: 11px; padding: 0.5rem 0.75rem;\n  border: 2px solid var(--line); font-size: 0.89rem;\n}\n\n.report-list li.met { background-color: var(--green-light); border-color: var(--green); }\n.report-list li.unmet { background-color: var(--pink-light); border-color: var(--pink); }\n\n.rep-name { font-weight: 600; }\n.rep-val { font-family: var(--font-display); font-weight: 700; }\nli.met .rep-val { color: var(--green-dark); }\nli.unmet .rep-val { color: var(--pink-dark); }\n\n.cat-processor { --fam: #4C42CF; --fam-dark: #1F1976; --fam-light: #E4E2F8; }\n.cat-storage   { --fam: #0099F3; --fam-dark: #06338D; --fam-light: #D5EFFF; }\n.cat-network   { --fam: #F46800; --fam-dark: #611D00; --fam-light: #FFE3CE; }\n.cat-memory    { --fam: #E11970; --fam-dark: #7D0C3D; --fam-light: #FBDAE8; }\n.cat-settings  { --fam: #34BD43; --fam-dark: #003F25; --fam-light: #CCF1D0; }\n\n.tally {\n  display: grid; gap: 0.45rem;\n  grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));\n  margin-block-end: 0.9rem;\n}\n\n.tally-card {\n  border-radius: 12px; overflow: hidden;\n  border: 2px solid var(--fam-light);\n  background-color: #FFFFFF;\n}\n\n.tally-card.is-top { border-color: var(--fam-dark); box-shadow: var(--lift); }\n\n.tally-head {\n  display: flex; align-items: center; gap: 0.4rem;\n  padding: 0.35rem 0.5rem;\n  background-color: var(--fam-dark);\n}\n\n.tally-dot {\n  width: 24px; height: 24px; flex: 0 0 auto; border-radius: 7px;\n  background-color: #FFFFFF; color: var(--fam-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.tally-dot svg { width: 16px; height: 16px; fill: currentColor; }\n.tally-name { font-family: var(--font-display); font-weight: 700; font-size: 0.8rem; color: #FFFFFF; }\n.tally-body { padding: 0.45rem 0.6rem 0.55rem; }\n.tally-val { font-family: var(--font-display); font-weight: 700; font-size: 1.15rem; color: var(--fam-dark); margin: 0; }\n.tally-sub { font-size: 0.73rem; color: var(--ink-soft); margin: 0; }\n\n.tally-flag {\n  display: inline-block; margin: 0.3rem 0 0;\n  font-size: 0.66rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase;\n  color: var(--fam-dark); background-color: var(--fam-light);\n  padding: 0.16rem 0.5rem; border-radius: 999px;\n}\n\n.report-notes { display: grid; gap: 0.35rem; margin-block-end: 1rem; }\n\n.report-note {\n  background-color: var(--orange-light);\n  border-inline-start: 6px solid var(--orange);\n  border-radius: 11px; padding: 0.55rem 0.75rem;\n  color: var(--orange-dark); font-size: 0.87rem; margin: 0;\n}\n\n.questions { padding-inline-start: 1.2rem; margin: 0 0 1rem; font-size: 0.89rem; }\n.questions li { margin-block-end: 0.4rem; }\n\n/* ---------- confirmation sheet ---------- */\n\n.sheet {\n  position: absolute; inset: 0; z-index: 10;\n  display: flex; align-items: center; justify-content: center;\n  padding: 1rem;\n  background-color: rgba(31, 25, 118, 0.55);\n}\n\n.sheet-card {\n  width: 100%; max-width: 22rem;\n  border-radius: 16px; padding: 1rem;\n  background-color: #FFFFFF;\n  border: 3px solid var(--purple-dark);\n  box-shadow: var(--lift-lg);\n}\n\n.sheet-title {\n  font-size: 1.15rem; line-height: 1.05;\n  color: var(--purple-dark); margin-block-end: 0.45rem;\n}\n\n.sheet-body { margin: 0 0 0.8rem; font-size: 0.88rem; color: var(--ink-soft); }\n\n/* ---------- tab bar ---------- */\n\n.tabbar {\n  display: flex; flex: 0 0 auto;\n  border-block-start: 2px solid var(--purple-light);\n  background-color: var(--tint);\n}\n\n.tab {\n  position: relative;\n  flex: 1 1 0;\n  display: flex; align-items: center; justify-content: center; gap: 0.45rem;\n  font-family: var(--font-display); font-weight: 700; font-size: 0.88rem;\n  min-height: 50px; padding: 0.35rem;\n  border: none; border-block-start: 4px solid transparent;\n  background-color: transparent; color: var(--ink-soft); cursor: pointer;\n}\n\n.tab[aria-current=\"page\"] { color: #FFFFFF; border-block-start-color: var(--purple-dark); background-color: var(--purple); }\n.tab-icon { display: flex; }\n.tab-icon svg { width: 21px; height: 21px; fill: currentColor; }\n\n.tab-dot {\n  width: 11px; height: 11px; border-radius: 50%;\n  background-color: var(--pink);\n  border: 2px solid #FFFFFF;\n}\n\n.tab[aria-current=\"page\"] .tab-dot { border-color: var(--purple); }\n\n/* ---------- focus ---------- */\n\n.btn:focus-visible,\n.option:focus-visible,\n.beast:focus-visible,\n.tab:focus-visible,\n.reset:focus-visible,\n.srow-summary:focus-visible {\n  outline: 3px solid var(--orange);\n  outline-offset: 2px;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const DAY_START = 480;\nconst DAY_END = 720;\nconst DRIVE_CAP = 100;\nconst OLD_RECORD_UNITS = 35;\nconst CACHE_UNITS = 5;\n\nconst EXAM_MINUTES = 12;\nconst EXAM_BATTERY = 3;\nconst RECORD_MINUTES = 15;\nconst RECORD_BATTERY = 4;\nconst PHOTO_BATTERY = 2;\nconst CLOSE_MINUTES = 2;\nconst REAL_SETTING_MINUTES = 2;\nconst IDLE_SETTING_MINUTES = 1;\nconst ARCHIVE_MINUTES = 4;\nconst WAIT_MINUTES = 8;\nconst RETRY_MINUTES = 2;\nconst RETRY_BATTERY = 3;\nconst SEND_MINUTES_PER_UNIT = 0.25;\nconst SEND_MINUTES_PER_RECORD = 1.5;\nconst SEND_BATTERY_PER_UNIT = 0.35;\nconst SEND_BATTERY_PER_RECORD = 2;\nconst NO_SERVICE_LIMIT = 3;\n\n/* Service out here is weather and terrain, not a setting. It wanders on its own\n   and the student can only choose when to use it. */\nconst SIGNAL = {\n  none:   { word: 'No service', bars: 0, cost: null },\n  low:    { word: 'Low', bars: 1, cost: 2.2 },\n  medium: { word: 'Medium', bars: 2, cost: 1.4 },\n  high:   { word: 'Strong', bars: 3, cost: 1 }\n};\n\n/* Each row is the chance of landing on none, low, medium, high next. Weighted\n   to drift upward so a run cannot stall out. */\nconst SIGNAL_DRIFT = {\n  none:   [0.40, 0.60, 0.00, 0.00],\n  low:    [0.20, 0.35, 0.45, 0.00],\n  medium: [0.00, 0.25, 0.35, 0.40],\n  high:   [0.00, 0.00, 0.30, 0.70]\n};\n\nconst SIGNAL_ORDER = ['none', 'low', 'medium', 'high'];\nconst MEMORY_PENALTY = 0.25;\nconst SAVER_TIME = 1.4;\nconst SAVER_BATTERY = 0.6;\nconst USEFUL_PHOTO_SCORE = 50;\nconst HINT_AFTER_TRIES = 2;\n\nconst BRIGHTNESS_DRAIN = { low: 1, medium: 1.3, high: 1.7 };\n\nconst QUALITY = {\n  original: { units: 24, detail: 100, minutes: 6, word: 'Original' },\n  standard: { units: 8, detail: 75, minutes: 3, word: 'Standard' },\n  low: { units: 3, detail: 35, minutes: 2, word: 'Low' }\n};\n\nconst GROUPS = [\n  { id: 'display', name: 'Display', icon: 'g-display' },\n  { id: 'camera', name: 'Camera', icon: 'g-camera' },\n  { id: 'storage', name: 'Storage', icon: 'g-storage' },\n  { id: 'network', name: 'Network', icon: 'g-network' },\n  { id: 'battery', name: 'Battery', icon: 'g-battery' },\n  { id: 'app', name: 'FieldVet app', icon: 'g-app' }\n];\n\n/* real: changing it moves time, battery or drive space.\n   Everything else is here because a real settings screen has things in it\n   that look promising and do nothing. */\nconst SETTINGS = [\n  {\n    id: 'brightness', group: 'display', real: true, start: 'low',\n    name: 'Screen brightness',\n    why: 'How bright the backlight runs. The backlight is one of the hungriest things on the tablet.',\n    options: [\n      { value: 'low', label: 'Low', note: 'Hard to read in a dark barn. Normal battery use.' },\n      { value: 'medium', label: 'Medium', note: 'Readable almost anywhere. Uses 30% more battery per task.' },\n      { value: 'high', label: 'High', note: 'Readable in direct sun. Uses 70% more battery per task.' }\n    ]\n  },\n  {\n    id: 'textSize', group: 'display', real: false, start: 'medium',\n    name: 'Text size',\n    why: 'How big the words are. Does not change how bright the screen is.',\n    options: [\n      { value: 'small', label: 'Small', note: 'More fits on the screen.' },\n      { value: 'medium', label: 'Medium', note: 'The usual size.' },\n      { value: 'large', label: 'Large', note: 'Fewer words on the screen at once.' }\n    ]\n  },\n  {\n    id: 'darkMode', group: 'display', real: false, start: 'off',\n    name: 'Dark colors',\n    why: 'Swaps the app to a dark color scheme. This screen lights every pixel from behind either way.',\n    options: [\n      { value: 'off', label: 'Off', note: 'Dark words on a light background.' },\n      { value: 'on', label: 'On', note: 'Light words on a dark background.' }\n    ]\n  },\n  {\n    id: 'quality', group: 'camera', real: true, start: 'original',\n    name: 'Photo quality',\n    why: 'How much detail each photo keeps. Detail is what fills the drive and what slows the send.',\n    options: [\n      { value: 'original', label: 'Original', note: 'Takes 24% of the drive per photo. The clinic rates it 100 out of 100.' },\n      { value: 'standard', label: 'Standard', note: 'Takes 8% of the drive per photo. The clinic rates it 75 out of 100.' },\n      { value: 'low', label: 'Low', note: 'Takes 3% of the drive per photo. The clinic rates it 35 out of 100.' }\n    ]\n  },\n  {\n    id: 'grid', group: 'camera', real: false, start: 'off',\n    name: 'Grid lines',\n    why: 'Draws lines over the viewfinder to help line up a shot. The lines are not saved into the photo.',\n    options: [\n      { value: 'off', label: 'Off', note: 'A plain viewfinder.' },\n      { value: 'on', label: 'On', note: 'Guide lines while aiming.' }\n    ]\n  },\n  {\n    id: 'shutter', group: 'camera', real: false, start: 'on',\n    name: 'Shutter sound',\n    why: 'The click the camera makes. Some animals do not love it.',\n    options: [\n      { value: 'on', label: 'On', note: 'The camera clicks.' },\n      { value: 'off', label: 'Off', note: 'The camera is silent.' }\n    ]\n  },\n  {\n    id: 'archive', group: 'storage', real: true, start: 'tablet',\n    name: 'Records older than a month',\n    why: 'Old visits sit on the drive taking up room that today needs.',\n    options: [\n      { value: 'tablet', label: 'Keep on the tablet', note: 'Holds 35% of the drive. Amara can look up an old visit right here.' },\n      { value: 'clinic', label: 'Move to the clinic', note: 'Frees 35% of the drive. She cannot look up old visits at the farm.' }\n    ]\n  },\n  {\n    id: 'cache', group: 'storage', real: true, start: 'kept',\n    name: 'Temporary files',\n    why: 'Scratch files the app leaves behind. Clearing them helps a little.',\n    options: [\n      { value: 'kept', label: 'Keep them', note: 'Holds 5% of the drive.' },\n      { value: 'cleared', label: 'Clear them', note: 'Frees 5% of the drive. That is one fifth of a photo at original quality.' }\n    ]\n  },\n  {\n    id: 'sending', group: 'network', real: true, start: 'auto',\n    name: 'Sending records',\n    why: 'When the tablet tries to push records out. Service out here comes and goes on its own.',\n    options: [\n      { value: 'auto', label: 'Keep trying automatically', note: 'Sends after every task, at whatever signal happens to be up. A failed try with no service costs 2 minutes and 3% battery.' },\n      { value: 'manual', label: 'Wait until I say', note: 'Nothing leaves the tablet until you send it, so you can hold out for a stronger signal.' }\n    ]\n  },\n  {\n    id: 'wifi', group: 'network', real: false, start: 'on',\n    name: 'Look for Wi-Fi',\n    why: 'Scans for Wi-Fi networks. The nearest one is ten miles away, and this is a cell signal problem anyway.',\n    options: [\n      { value: 'on', label: 'On', note: 'Keeps scanning for a network to join.' },\n      { value: 'off', label: 'Off', note: 'Stops scanning.' }\n    ]\n  },\n  {\n    id: 'power', group: 'battery', real: true, start: 'normal',\n    name: 'Power mode',\n    why: 'Trades speed for battery life. Which one helps depends on what Amara is short of.',\n    options: [\n      { value: 'normal', label: 'Normal', note: 'Full speed. Normal battery use.' },\n      { value: 'saver', label: 'Power saver', note: 'Every task takes 40% longer. Uses 40% less battery.' }\n    ]\n  },\n  {\n    id: 'batteryPercent', group: 'battery', real: false, start: 'on',\n    name: 'Show battery percent',\n    why: 'Whether the number appears next to the battery icon.',\n    options: [\n      { value: 'on', label: 'On', note: 'Shows the number.' },\n      { value: 'off', label: 'Off', note: 'Shows only the icon.' }\n    ]\n  },\n  {\n    id: 'autoClose', group: 'app', real: true, start: 'keep',\n    name: 'Finished records',\n    why: 'A saved record stays loaded in memory until something closes it.',\n    options: [\n      { value: 'keep', label: 'Leave them open', note: 'Every open record makes each task 25% slower.' },\n      { value: 'close', label: 'Close them automatically', note: 'Costs 2 minutes per record. Memory stays clear and the app stays fast.' }\n    ]\n  },\n  {\n    id: 'tips', group: 'app', real: false, start: 'on',\n    name: 'Tip of the day',\n    why: 'Shows a short tip when the app opens.',\n    options: [\n      { value: 'on', label: 'On', note: 'A tip on every launch.' },\n      { value: 'off', label: 'Off', note: 'No tips.' }\n    ]\n  }\n];\n\nconst ANIMALS = [\n  {\n    id: 'dot', name: 'Dot', kind: 'Dairy cow', icon: 'i-cow', photo: 'photo-dot.png',\n    alt: 'Close photo of a dairy cow\\u2019s swollen back leg joint.',\n    complaint: 'Swollen hock, favoring the leg for two days.',\n    findings: ['The joint is warm and puffy.', 'She limps when she turns.', 'No cut and no puncture.']\n  },\n  {\n    id: 'biscuit', name: 'Biscuit', kind: 'Goat', icon: 'i-goat', photo: 'photo-biscuit.png',\n    alt: 'Close photo of a patchy rash along a goat\\u2019s back.',\n    complaint: 'A rash spreading along her back.',\n    findings: ['Hair is thin in three patches.', 'The skin is flaky, not raw.', 'She is not scratching at it.']\n  },\n  {\n    id: 'pepper', name: 'Pepper', kind: 'Ewe', icon: 'i-sheep', photo: 'photo-pepper.png',\n    alt: 'Close photo of a sheep\\u2019s clouded left eye.',\n    complaint: 'Her left eye has gone cloudy.',\n    findings: ['The surface looks milky, not red.', 'She flinches at bright light.', 'The other eye is clear.']\n  },\n  {\n    id: 'mo', name: 'Mo', kind: 'Hog', icon: 'i-hog', photo: 'photo-mo.png',\n    alt: 'Close photo of a hog\\u2019s cracked front hoof.',\n    complaint: 'Off his feed, will not stand on a front foot.',\n    findings: ['There is a split in the hoof wall.', 'The area above it is hot.', 'He keeps the foot lifted.']\n  }\n];\n\nconst PROBLEMS = [\n  {\n    id: 'dim', setting: 'brightness', group: 'display', blocks: 'exam',\n    title: 'The screen is too dark to read',\n    voice: 'It is dim in this barn and I cannot read my own notes.',\n    fixed: 'She can read it now.',\n    fires: function () { return true; },\n    ready: function () { return state.settings.brightness !== 'low'; }\n  },\n  {\n    id: 'huge', setting: 'quality', group: 'camera', blocks: null,\n    title: 'One photo took a quarter of the drive',\n    voice: 'That picture came out beautiful and enormous.',\n    fixed: 'The next photos will use less room.',\n    fires: function () { return photosTaken() >= 1 && state.settings.quality === 'original'; },\n    ready: function () { return state.settings.quality !== 'original'; }\n  },\n  {\n    id: 'slow', setting: 'autoClose', group: 'app', blocks: null,\n    title: 'FieldVet is lagging',\n    voice: 'Everything is slow. I have records stacked up open.',\n    fixed: 'Memory is clear again.',\n    fires: function () { return openRecords() >= 2; },\n    ready: function () { return openRecords() === 0; }\n  },\n  {\n    id: 'full', setting: 'archive', group: 'storage', blocks: 'photo',\n    title: 'The photo will not save',\n    voice: 'No room on the drive, and I still have animals to shoot.',\n    fixed: 'There is room again.',\n    fires: function () { return !photoFits() && needsPhoto() > 0; },\n    ready: function () { return photoFits(); }\n  },\n  {\n    id: 'retry', setting: 'sending', group: 'network', blocks: null,\n    title: 'The tablet keeps trying to send',\n    voice: 'Service keeps dropping out here, and it keeps trying anyway.',\n    fixed: 'The retries have stopped.',\n    fires: function () { return state.retries >= 5; },\n    ready: function () { return state.settings.sending === 'manual'; }\n  },\n  {\n    id: 'lowbatt', setting: 'power', group: 'battery', blocks: null,\n    title: 'The battery is getting low',\n    voice: 'Under half, and I still have work plus a send at the end.',\n    fixed: 'Noted.',\n    fires: function () { return state.battery <= 45 && tasksLeft() > 0; },\n    ready: function () { return state.settings.power === 'saver'; }\n  }\n];\n\nconst GOALS = [\n  'All four records reach the clinic.',\n  'Amara is done before noon.',\n  'The tablet still has battery at the end.',\n  'Every animal has a photo.',\n  'The photos are good enough for the clinic to use.'\n];\n\nconst QUESTIONS = [\n  'Amara turned the brightness up to fix something she could see. What did that cost her later?',\n  'The tablet was not broken when it started lagging. What was really happening, and which setting stopped it?',\n  'The signal came and went on its own all morning. What could you control about sending, and what could you not?',\n  'Several settings in that list changed nothing at all. How could you tell which ones were worth trying?',\n  'Troubleshooting means fixing something that is not working. Optimization means making something run better even when it works. Name one of each from this morning.'\n];\n\nconst nf = new Intl.NumberFormat();\nconst pf = new Intl.NumberFormat(undefined, { style: 'percent', maximumFractionDigits: 0 });\nconst df = new Intl.NumberFormat(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 });\nconst tf = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });\n\nlet state;\nlet busy = false;\nlet renderedView = null;\nlet viewJustChanged = false;\nconst els = {};\n\n/* ================= state ================= */\n\nfunction freshState() {\n  const settings = {};\n  SETTINGS.forEach(function (s) { settings[s.id] = s.start; });\n  return {\n    view: 'brief',\n    settings: settings,\n    selected: null,\n    animals: ANIMALS.map(function (a) {\n      return { id: a.id, examined: false, photo: null, skipped: false, written: false, closed: false, sent: false };\n    }),\n    problem: null,\n    seen: {},\n    wrongTries: 0,\n    justFixed: null,\n    clock: DAY_START,\n    battery: 100,\n    photoUnits: 0,\n    retries: 0,\n    signal: 'none',\n    noServiceStreak: 0,\n    log: [],\n    over: false,\n    endReason: null,\n    missedHistory: false\n  };\n}\n\nfunction animalDef(id) { for (let i = 0; i < ANIMALS.length; i++) if (ANIMALS[i].id === id) return ANIMALS[i]; return null; }\nfunction animalState(id) { for (let i = 0; i < state.animals.length; i++) if (state.animals[i].id === id) return state.animals[i]; return null; }\nfunction settingById(id) { for (let i = 0; i < SETTINGS.length; i++) if (SETTINGS[i].id === id) return SETTINGS[i]; return null; }\nfunction groupById(id) { for (let i = 0; i < GROUPS.length; i++) if (GROUPS[i].id === id) return GROUPS[i]; return GROUPS[0]; }\nfunction problemById(id) { for (let i = 0; i < PROBLEMS.length; i++) if (PROBLEMS[i].id === id) return PROBLEMS[i]; return null; }\n\nfunction openRecords() {\n  let n = 0;\n  state.animals.forEach(function (a) { if (a.written && !a.closed) n += 1; });\n  return n;\n}\n\nfunction photosTaken() { return state.animals.filter(function (a) { return a.photo !== null; }).length; }\nfunction needsPhoto() { return state.animals.filter(function (a) { return a.examined && a.photo === null && !a.skipped; }).length; }\n\nfunction tasksLeft() {\n  let n = 0;\n  state.animals.forEach(function (a) {\n    if (!a.examined) n += 1;\n    if (a.photo === null && !a.skipped) n += 1;\n    if (!a.written) n += 1;\n  });\n  return n;\n}\n\nfunction oldRecordUnits() { return state.settings.archive === 'clinic' ? 0 : OLD_RECORD_UNITS; }\nfunction cacheUnits() { return state.settings.cache === 'cleared' ? 0 : CACHE_UNITS; }\nfunction driveUsed() { return oldRecordUnits() + cacheUnits() + state.photoUnits; }\nfunction photoFits() { return driveUsed() + QUALITY[state.settings.quality].units <= DRIVE_CAP; }\n\nfunction signalInfo() { return SIGNAL[state.signal]; }\nfunction hasService() { return state.signal !== 'none'; }\n\nfunction tickSignal() {\n  const weights = SIGNAL_DRIFT[state.signal];\n  let roll = Math.random();\n  let next = state.signal;\n  for (let i = 0; i < SIGNAL_ORDER.length; i++) {\n    roll -= weights[i];\n    if (roll <= 0) { next = SIGNAL_ORDER[i]; break; }\n  }\n  /* Guard against a run of bad luck locking a student out of sending. */\n  if (next === 'none') {\n    state.noServiceStreak += 1;\n    if (state.noServiceStreak >= NO_SERVICE_LIMIT) { next = 'low'; state.noServiceStreak = 0; }\n  } else {\n    state.noServiceStreak = 0;\n  }\n  state.signal = next;\n}\n\nfunction sendableRecords() {\n  return state.animals.filter(function (a) { return a.written && !a.sent; });\n}\n\nfunction sendCost(records) {\n  const info = signalInfo();\n  if (!info.cost) return null;\n  let units = 0;\n  records.forEach(function (a) { if (a.photo) units += QUALITY[a.photo].units; });\n  const minutes = (SEND_MINUTES_PER_UNIT * units + SEND_MINUTES_PER_RECORD * records.length) * info.cost * saverTime();\n  const battery = (SEND_BATTERY_PER_UNIT * units + SEND_BATTERY_PER_RECORD * records.length) * info.cost * batteryMultiplier();\n  return { minutes: Math.round(minutes), battery: Math.round(battery) };\n}\n\nfunction memoryMultiplier() { return 1 + openRecords() * MEMORY_PENALTY; }\nfunction saverTime() { return state.settings.power === 'saver' ? SAVER_TIME : 1; }\nfunction timeMultiplier() { return memoryMultiplier() * saverTime(); }\nfunction batteryMultiplier() {\n  return BRIGHTNESS_DRAIN[state.settings.brightness] * (state.settings.power === 'saver' ? SAVER_BATTERY : 1);\n}\n\nfunction photoDetailAverage() {\n  const shots = state.animals.filter(function (a) { return a.photo !== null; });\n  if (shots.length === 0) return 0;\n  let total = 0;\n  shots.forEach(function (a) { total += QUALITY[a.photo].detail; });\n  return Math.round(total / shots.length);\n}\n\n/* ================= costs ================= */\n\nfunction spend(minutes, battery, cat, text, menu) {\n  const m = Math.round(minutes);\n  const b = Math.round(battery);\n  state.clock += m;\n  state.battery -= b;\n  if (state.battery < 0) state.battery = 0;\n  state.log.push({ text: text, cat: cat, minutes: m, battery: b, menu: !!menu });\n  return { minutes: m, battery: b };\n}\n\n/* Charges the task to the part doing the work, then bills each slowdown to\n   whatever actually caused it, so the report can name a culprit. */\nfunction runTask(baseMinutes, baseBattery, cat, text) {\n  const mem = memoryMultiplier();\n  const sav = saverTime();\n  const total = Math.round(baseMinutes * mem * sav);\n\n  let memShare = Math.round(baseMinutes * (mem - 1));\n  let savShare = Math.round(baseMinutes * mem * (sav - 1));\n  if (memShare < 2) memShare = 0;\n  if (savShare < 2) savShare = 0;\n\n  const own = Math.max(0, total - memShare - savShare);\n  spend(own, baseBattery * batteryMultiplier(), cat, text);\n\n  if (memShare > 0) {\n    spend(memShare, 0, 'memory', `${nf.format(openRecords())} open records added ${nf.format(memShare)} minutes to that.`);\n  }\n  if (savShare > 0) {\n    spend(savShare, 0, 'settings', `Power saver added ${nf.format(savShare)} minutes to that.`);\n  }\n}\n\nfunction sendQueue(auto) {\n  const records = sendableRecords();\n  if (records.length === 0) return;\n  const cost = sendCost(records);\n  if (!cost) return;\n  records.forEach(function (a) { a.sent = true; });\n  const info = signalInfo();\n  const how = auto ? 'The tablet sent' : 'Sent';\n  spend(cost.minutes, cost.battery, 'network',\n    `${how} ${nf.format(records.length)} records on a ${info.word.toLowerCase()} signal.`);\n}\n\nfunction autoSendTick() {\n  if (state.settings.sending !== 'auto') return;\n  if (sendableRecords().length === 0) return;\n  if (!hasService()) {\n    state.retries += 1;\n    spend(RETRY_MINUTES, RETRY_BATTERY * batteryMultiplier(), 'network', 'Tried to send. No service.');\n    return;\n  }\n  sendQueue(true);\n}\n\nfunction checkOver() {\n  if (state.over) return true;\n  if (state.battery <= 0) { state.over = true; state.endReason = 'battery'; return true; }\n  if (state.clock >= DAY_END) { state.over = true; state.endReason = 'clock'; return true; }\n  return false;\n}\n\n/* ================= problems ================= */\n\nfunction syncProblem() {\n  if (state.problem) {\n    const active = problemById(state.problem);\n    if (active.ready()) {\n      state.justFixed = active.fixed;\n      state.problem = null;\n      state.wrongTries = 0;\n    } else if (!active.fires()) {\n      /* The situation went away without the setting changing, for example the\n         student skipped the photo instead of making room. Drop the banner. */\n      state.problem = null;\n      state.wrongTries = 0;\n      return;\n    } else {\n      return;\n    }\n  }\n  for (let i = 0; i < PROBLEMS.length; i++) {\n    const p = PROBLEMS[i];\n    if (state.seen[p.id]) continue;\n    if (p.ready()) continue;\n    if (!p.fires()) continue;\n    state.problem = p.id;\n    state.seen[p.id] = true;\n    state.wrongTries = 0;\n    return;\n  }\n}\n\nfunction blockedAction(kind) {\n  if (!state.problem) return false;\n  return problemById(state.problem).blocks === kind;\n}\n\nfunction dismissBanner() {\n  if (!state.problem) return;\n  state.seen[state.problem] = true;\n  state.problem = null;\n  render();\n}\n\n/* ================= actions ================= */\n\nfunction doExam(id) {\n  const a = animalState(id);\n  a.examined = true;\n  runTask(EXAM_MINUTES, EXAM_BATTERY, 'processor', `Examined ${animalDef(id).name}.`);\n  autoSendTick();\n}\n\nfunction doPhoto(id) {\n  const a = animalState(id);\n  const q = QUALITY[state.settings.quality];\n  a.photo = state.settings.quality;\n  state.photoUnits += q.units;\n  runTask(q.minutes, PHOTO_BATTERY, 'storage',\n    `Photographed ${animalDef(id).name} at ${q.word.toLowerCase()} quality, using ${pf.format(q.units / 100)} of the drive.`);\n  autoSendTick();\n}\n\nfunction doSkipPhoto(id) {\n  animalState(id).skipped = true;\n  spend(0, 0, 'storage', `No photo of ${animalDef(id).name}. The clinic will not see this one.`);\n}\n\nfunction doRecord(id) {\n  const a = animalState(id);\n  a.written = true;\n  runTask(RECORD_MINUTES, RECORD_BATTERY, 'processor', `Wrote the record for ${animalDef(id).name}.`);\n  if (state.settings.autoClose === 'close') {\n    a.closed = true;\n    spend(CLOSE_MINUTES, 0, 'memory', `Closed ${animalDef(id).name}\\u2019s record automatically.`);\n  }\n  autoSendTick();\n}\n\nfunction doCloseAll() {\n  const open = state.animals.filter(function (a) { return a.written && !a.closed; });\n  if (open.length === 0) return;\n  open.forEach(function (a) { a.closed = true; });\n  spend(CLOSE_MINUTES * open.length, 0, 'memory', `Closed ${nf.format(open.length)} open records by hand.`);\n}\n\nfunction doWaitForSignal() {\n  spend(WAIT_MINUTES, 0, 'network', 'Waited for the signal to come back.');\n}\n\nfunction doFinish() {\n  sendQueue(false);\n  state.over = true;\n  if (!state.endReason) state.endReason = state.clock >= DAY_END ? 'clock' : 'finished';\n}\n\nfunction changeSetting(id, value) {\n  if (busy || state.over) return;\n  if (state.settings[id] === value) return;\n\n  const setting = settingById(id);\n  const fromLabel = optionLabel(setting, state.settings[id]);\n  const toLabel = optionLabel(setting, value);\n  state.settings[id] = value;\n  state.justFixed = null;\n\n  if (state.problem && problemById(state.problem).setting !== id) state.wrongTries += 1;\n\n  let minutes = setting.real ? REAL_SETTING_MINUTES : IDLE_SETTING_MINUTES;\n  if (id === 'archive') minutes += ARCHIVE_MINUTES;\n\n  const text = setting.real\n    ? `${setting.name} changed from ${fromLabel} to ${toLabel}.`\n    : `${setting.name} changed from ${fromLabel} to ${toLabel}. Nothing about the morning changed.`;\n  spend(minutes, 0, 'settings', text, true);\n\n  if (id === 'archive' && value === 'clinic') state.missedHistory = true;\n  if (id === 'autoClose' && value === 'close') doCloseAll();\n\n  tickSignal();\n  if (checkOver()) state.view = 'report';\n  syncProblem();\n  render();\n}\n\n/* ================= running an action ================= */\n\nfunction reducedMotion() {\n  return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);\n}\n\nfunction act(fn) {\n  if (busy || state.over) return;\n  const duration = reducedMotion() ? 0 : Math.min(650, Math.round(150 + (timeMultiplier() - 1) * 420));\n  if (duration === 0) { finishAction(fn); return; }\n  busy = true;\n  els.procFill.style.transitionDuration = '0ms';\n  els.procFill.style.width = '0%';\n  window.setTimeout(function () {\n    els.procFill.style.transitionDuration = `${duration}ms`;\n    els.procFill.style.width = '100%';\n  }, 20);\n  window.setTimeout(function () {\n    els.procFill.style.transitionDuration = '0ms';\n    els.procFill.style.width = '0%';\n    busy = false;\n    finishAction(fn);\n  }, duration + 40);\n}\n\nfunction finishAction(fn) {\n  state.justFixed = null;\n  fn();\n  if (!state.over) tickSignal();\n  checkOver();\n  syncProblem();\n  if (state.over) state.view = 'report';\n  render();\n  focusMain();\n}\n\n/* ================= small helpers ================= */\n\nfunction clockText(minutes) {\n  const m = typeof minutes === 'number' ? minutes : state.clock;\n  return tf.format(new Date(2026, 0, 1, 0, Math.round(Math.min(m, 24 * 60 - 1))));\n}\n\nfunction optionLabel(setting, value) {\n  for (let i = 0; i < setting.options.length; i++) {\n    if (setting.options[i].value === value) return setting.options[i].label;\n  }\n  return String(value);\n}\n\nfunction speedText() {\n  const m = timeMultiplier();\n  return m <= 1.05 ? 'Full speed' : `${df.format(m)} times slower`;\n}\n\nfunction makeText(tag, className, text) {\n  const el = document.createElement(tag);\n  if (className) el.className = className;\n  if (text !== undefined && text !== null) el.textContent = text;\n  return el;\n}\n\nfunction clearChildren(el) { el.textContent = ''; }\n\nfunction icon(symbolId, className) {\n  const box = document.createElement('span');\n  box.className = className;\n  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');\n  svg.setAttribute('aria-hidden', 'true');\n  svg.setAttribute('focusable', 'false');\n  const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');\n  use.setAttribute('href', `#${symbolId}`);\n  svg.appendChild(use);\n  box.appendChild(svg);\n  return box;\n}\n\nfunction button(label, kind, handler, disabled) {\n  const b = document.createElement('button');\n  b.type = 'button';\n  b.className = `btn ${kind}`;\n  b.textContent = label;\n  b.disabled = !!disabled;\n  b.addEventListener('click', handler);\n  return b;\n}\n\n/* ================= status ================= */\n\nfunction renderSignalBars() {\n  const info = signalInfo();\n  for (let i = 0; i < els.signalBars.length; i++) {\n    const on = i < info.bars;\n    els.signalBars[i].className = 'bar-seg' + (on ? ` on ${state.signal}` : '');\n  }\n}\n\nfunction renderStatus() {\n  const drive = driveUsed();\n  els.clock.textContent = clockText();\n  els.battery.textContent = state.settings.batteryPercent === 'on' ? pf.format(state.battery / 100) : '';\n  els.drive.textContent = pf.format(drive / 100);\n  els.speed.textContent = speedText();\n  els.signal.textContent = signalInfo().word;\n  els.signal.className = 'stat-value' + (state.signal === 'none' ? ' bad' : state.signal === 'low' ? ' warn' : '');\n  renderSignalBars();\n\n  els.battery.className = 'stat-value' + (state.battery <= 20 ? ' bad' : state.battery <= 45 ? ' warn' : '');\n  els.drive.className = 'stat-value' + (drive >= 90 ? ' bad' : drive >= 75 ? ' warn' : '');\n  els.speed.className = 'stat-value' + (timeMultiplier() > 1.5 ? ' bad' : timeMultiplier() > 1.05 ? ' warn' : '');\n  els.clock.className = 'stat-value' + (state.clock >= DAY_END - 30 ? ' bad' : state.clock >= DAY_END - 75 ? ' warn' : '');\n\n  const batteryLevel = state.battery <= 20 ? ' bad' : state.battery <= 45 ? ' warn' : '';\n  const driveLevel = drive >= 90 ? ' bad' : drive >= 75 ? ' warn' : '';\n  els.gaugeBattery.style.width = `${Math.max(0, Math.min(100, state.battery))}%`;\n  els.gaugeBattery.className = 'gauge-fill battery' + batteryLevel;\n  els.gaugeDrive.style.width = `${Math.max(0, Math.min(100, drive))}%`;\n  els.gaugeDrive.className = 'gauge-fill storage' + driveLevel;\n\n  els.tabDot.hidden = !state.problem;\n}\n\n/* ================= farm view ================= */\n\nfunction renderBanner() {\n  if (!state.problem) {\n    els.banner.hidden = true;\n    clearChildren(els.banner);\n    return;\n  }\n  const p = problemById(state.problem);\n  els.banner.hidden = false;\n  els.banner.className = 'banner' + (p.blocks ? ' hard' : '');\n  clearChildren(els.banner);\n\n  const head = document.createElement('div');\n  head.className = 'banner-head';\n  head.appendChild(icon('a-alert', 'banner-icon'));\n  head.appendChild(makeText('p', 'banner-title', p.title));\n  els.banner.appendChild(head);\n\n  els.banner.appendChild(makeText('p', 'banner-voice', p.voice));\n\n  const row = document.createElement('div');\n  row.className = 'actions';\n  row.appendChild(button('Open Settings', 'btn-go', function () { goTab('settings'); }));\n  if (!p.blocks) row.appendChild(button('Not now', 'btn-alt', dismissBanner));\n  els.banner.appendChild(row);\n}\n\nfunction stepPip(symbol, done) {\n  const span = icon(symbol, 'pip' + (done ? ' pip-done' : ''));\n  return span;\n}\n\nfunction renderPen() {\n  const done = state.animals.filter(function (a) { return a.written; }).length;\n  els.penChip.textContent = `${nf.format(done)} of ${nf.format(ANIMALS.length)} done`;\n  clearChildren(els.pen);\n  ANIMALS.forEach(function (animal) {\n    const a = animalState(animal.id);\n    const li = document.createElement('li');\n    const card = document.createElement('button');\n    card.type = 'button';\n    card.className = 'beast' + (state.selected === animal.id ? ' picked' : '') + (a.written ? ' done' : '');\n    card.setAttribute('aria-pressed', state.selected === animal.id ? 'true' : 'false');\n\n    card.appendChild(icon(animal.icon, 'beast-icon'));\n    const name = makeText('span', 'beast-name', animal.name);\n    card.appendChild(name);\n\n    const pips = document.createElement('span');\n    pips.className = 'pips';\n    pips.appendChild(stepPip('a-exam', a.examined));\n    pips.appendChild(stepPip('a-photo', a.photo !== null || a.skipped));\n    pips.appendChild(stepPip('a-record', a.written));\n    card.appendChild(pips);\n\n    const sr = makeText('span', 'sr-only',\n      `${a.examined ? 'Examined' : 'Not examined'}. ${a.photo !== null ? 'Photographed' : a.skipped ? 'No photo' : 'No photo yet'}. ${a.written ? 'Record written' : 'Record not written'}.`);\n    card.appendChild(sr);\n\n    card.addEventListener('click', function () {\n      state.selected = animal.id;\n      state.justFixed = null;\n      render();\n    });\n    li.appendChild(card);\n    els.pen.appendChild(li);\n  });\n}\n\nfunction renderDetail() {\n  if (!state.selected) {\n    els.detail.hidden = false;\n    clearChildren(els.detail);\n    els.detail.className = 'detail empty';\n    els.detail.appendChild(makeText('p', null, 'Pick an animal to get started.'));\n    return;\n  }\n\n  const animal = animalDef(state.selected);\n  const a = animalState(state.selected);\n  const mult = timeMultiplier();\n\n  els.detail.hidden = false;\n  els.detail.className = 'detail';\n  clearChildren(els.detail);\n\n  const head = document.createElement('div');\n  head.className = 'detail-head';\n  head.appendChild(icon(animal.icon, 'detail-icon'));\n  const idBox = document.createElement('span');\n  idBox.className = 'detail-id';\n  idBox.appendChild(makeText('span', 'detail-name', animal.name));\n  idBox.appendChild(makeText('span', 'detail-kind', animal.kind));\n  head.appendChild(idBox);\n  els.detail.appendChild(head);\n\n  const bodyBox = document.createElement('div');\n  bodyBox.className = 'detail-body';\n  els.detail.appendChild(bodyBox);\n\n  bodyBox.appendChild(makeText('p', 'complaint', animal.complaint));\n\n  if (a.examined) {\n    const ul = document.createElement('ul');\n    ul.className = 'findings';\n    animal.findings.forEach(function (f) { ul.appendChild(makeText('li', null, f)); });\n    bodyBox.appendChild(ul);\n  }\n\n  if (a.photo) {\n    const q = QUALITY[a.photo];\n    const fig = document.createElement('figure');\n    fig.className = 'shot';\n    const img = document.createElement('img');\n    img.src = animal.photo;\n    img.alt = animal.alt;\n    img.width = 480;\n    img.height = 360;\n    img.className = `shot-img q-${a.photo}`;\n    fig.appendChild(img);\n    fig.appendChild(makeText('figcaption', 'shot-cap',\n      `${q.word} quality. Used ${pf.format(q.units / 100)} of the drive, rated ${nf.format(q.detail)} out of 100.`));\n    bodyBox.appendChild(fig);\n  }\n\n  const actions = document.createElement('div');\n  actions.className = 'actions';\n\n  if (!a.examined) {\n    actions.appendChild(button(\n      `Examine (${nf.format(Math.round(EXAM_MINUTES * mult))} min)`,\n      'btn-go',\n      function () { act(function () { doExam(animal.id); }); },\n      blockedAction('exam')\n    ));\n  }\n\n  if (a.examined && a.photo === null && !a.skipped) {\n    const q = QUALITY[state.settings.quality];\n    actions.appendChild(button(\n      `Photograph (${nf.format(Math.round(q.minutes * mult))} min, ${pf.format(q.units / 100)} of the drive)`,\n      'btn-go',\n      function () { act(function () { doPhoto(animal.id); }); },\n      blockedAction('photo') || !photoFits()\n    ));\n    actions.appendChild(button('Skip the photo', 'btn-alt', function () { act(function () { doSkipPhoto(animal.id); }); }));\n  }\n\n  if (a.examined && !a.written) {\n    actions.appendChild(button(\n      `Write the record (${nf.format(Math.round(RECORD_MINUTES * mult))} min)`,\n      'btn-go',\n      function () { act(function () { doRecord(animal.id); }); },\n      blockedAction('record')\n    ));\n  }\n\n  if (a.written && !a.closed) {\n    actions.appendChild(button(`Close the record (${nf.format(CLOSE_MINUTES)} min)`, 'btn-alt',\n      function () { act(doCloseAll); }));\n  }\n\n  bodyBox.appendChild(actions);\n\n  if (!photoFits() && a.examined && a.photo === null && !a.skipped) {\n    bodyBox.appendChild(makeText('p', 'detail-note',\n      `The drive has ${pf.format((DRIVE_CAP - driveUsed()) / 100)} free and this photo needs ${pf.format(QUALITY[state.settings.quality].units / 100)}.`));\n  }\n}\n\nfunction renderFinish() {\n  clearChildren(els.finish);\n  const ready = sendableRecords();\n  const left = tasksLeft();\n  const info = signalInfo();\n\n  const row = document.createElement('div');\n  row.className = 'actions';\n\n  if (ready.length === 0) {\n    row.appendChild(button('Finish the morning', 'btn-warn btn-lg', function () { act(doFinish); }));\n  } else if (hasService()) {\n    const cost = sendCost(ready);\n    row.appendChild(button(\n      `Send the data (${nf.format(cost.minutes)} min, ${pf.format(cost.battery / 100)} of the battery)`,\n      'btn-warn btn-lg',\n      function () { act(doFinish); }\n    ));\n  } else {\n    row.appendChild(button('Send the data', 'btn-warn btn-lg', function () { act(doFinish); }, true));\n  }\n\n  if (ready.length > 0 && state.signal !== 'high') {\n    row.appendChild(button(`Wait for a better signal (${nf.format(WAIT_MINUTES)} min)`, 'btn-alt',\n      function () { act(doWaitForSignal); }));\n  }\n  els.finish.appendChild(row);\n\n  if (ready.length > 0 && !hasService()) {\n    els.finish.appendChild(makeText('p', 'finish-note',\n      `No service right now, so nothing can leave the tablet. ${nf.format(ready.length)} records are waiting.`));\n  } else if (ready.length > 0) {\n    els.finish.appendChild(makeText('p', 'finish-note',\n      `${nf.format(ready.length)} records are waiting. A ${info.word.toLowerCase()} signal costs ${df.format(info.cost)} times what a strong one would.`));\n  }\n\n  if (left > 0) {\n    els.finish.appendChild(makeText('p', 'finish-note', `${nf.format(left)} things are still undone back in the pen.`));\n  }\n}\n\nfunction renderFarm() {\n  renderBanner();\n  renderPen();\n  renderDetail();\n  renderFinish();\n}\n\n/* ================= settings view ================= */\n\nfunction renderSymptom() {\n  if (state.justFixed) {\n    els.symptom.hidden = false;\n    els.symptom.className = 'symptom good';\n    clearChildren(els.symptom);\n    els.symptom.appendChild(makeText('p', 'symptom-line', state.justFixed));\n    return;\n  }\n  if (!state.problem) {\n    els.symptom.hidden = true;\n    clearChildren(els.symptom);\n    return;\n  }\n  const p = problemById(state.problem);\n  els.symptom.hidden = false;\n  els.symptom.className = 'symptom';\n  clearChildren(els.symptom);\n  els.symptom.appendChild(makeText('p', 'symptom-line', `Right now: ${p.title.toLowerCase()}.`));\n  if (state.wrongTries >= HINT_AFTER_TRIES) {\n    els.symptom.appendChild(makeText('p', 'symptom-hint', `Try the ${groupById(p.group).name} settings.`));\n  }\n}\n\nfunction renderSettings() {\n  renderSymptom();\n  els.settingsNote.textContent = 'Opening a setting is free. Changing one costs time.';\n\n  clearChildren(els.groups);\n  GROUPS.forEach(function (group) {\n    const section = document.createElement('section');\n    section.className = `group fam-${group.id}`;\n\n    const head = document.createElement('div');\n    head.className = 'group-head';\n    head.appendChild(icon(group.icon, 'group-icon'));\n    head.appendChild(makeText('h3', 'group-name', group.name));\n    section.appendChild(head);\n\n    SETTINGS.filter(function (s) { return s.group === group.id; }).forEach(function (setting) {\n      const row = document.createElement('details');\n      row.className = 'srow';\n\n      const summary = document.createElement('summary');\n      summary.className = 'srow-summary';\n      summary.appendChild(makeText('span', 'srow-name', setting.name));\n      summary.appendChild(makeText('span', 'srow-value', optionLabel(setting, state.settings[setting.id])));\n      summary.appendChild(icon('a-chevron', 'srow-chevron'));\n      row.appendChild(summary);\n\n      const bodyBox = document.createElement('div');\n      bodyBox.className = 'srow-body';\n      bodyBox.appendChild(makeText('p', 'srow-why', setting.why));\n\n      const opts = document.createElement('div');\n      opts.className = 'options';\n      opts.setAttribute('role', 'group');\n      opts.setAttribute('aria-label', setting.name);\n      setting.options.forEach(function (opt) {\n        const b = document.createElement('button');\n        b.type = 'button';\n        b.className = 'option';\n        b.setAttribute('aria-pressed', state.settings[setting.id] === opt.value ? 'true' : 'false');\n        b.appendChild(makeText('span', 'option-label', opt.label));\n        b.appendChild(makeText('span', 'option-note', opt.note));\n        b.addEventListener('click', function () { changeSetting(setting.id, opt.value); });\n        opts.appendChild(b);\n      });\n      bodyBox.appendChild(opts);\n      row.appendChild(bodyBox);\n      section.appendChild(row);\n    });\n\n    els.groups.appendChild(section);\n  });\n}\n\n/* ================= report ================= */\n\nfunction menuMinutesSpent() {\n  let t = 0;\n  state.log.forEach(function (e) { if (e.menu) t += e.minutes; });\n  return t;\n}\n\nfunction wastedMenuMinutes() {\n  let t = 0;\n  state.log.forEach(function (e) {\n    if (e.menu && e.text.indexOf('Nothing about the morning changed.') !== -1) t += e.minutes;\n  });\n  return t;\n}\n\nfunction totalsByCategory() {\n  const totals = { processor: { m: 0, b: 0 }, storage: { m: 0, b: 0 }, network: { m: 0, b: 0 }, memory: { m: 0, b: 0 }, settings: { m: 0, b: 0 } };\n  state.log.forEach(function (e) {\n    if (!totals[e.cat]) return;\n    totals[e.cat].m += e.minutes;\n    totals[e.cat].b += e.battery;\n  });\n  return totals;\n}\n\nconst TALLY_CARDS = [\n  { id: 'processor', name: 'Processor', symbol: 't-processor' },\n  { id: 'storage', name: 'Storage', symbol: 't-storage' },\n  { id: 'network', name: 'Network', symbol: 't-network' },\n  { id: 'memory', name: 'Memory', symbol: 't-memory' },\n  { id: 'settings', name: 'Settings', symbol: 'g-settings' }\n];\n\nfunction renderTally() {\n  const totals = totalsByCategory();\n  let topId = null;\n  let topScore = 0;\n  TALLY_CARDS.forEach(function (c) {\n    let score = totals[c.id].m / (DAY_END - DAY_START) + totals[c.id].b / 100;\n    if (c.id === 'storage') score += state.photoUnits / 100;\n    if (score > topScore) { topScore = score; topId = c.id; }\n  });\n\n  clearChildren(els.tally);\n  TALLY_CARDS.forEach(function (c) {\n    const card = document.createElement('div');\n    card.className = `tally-card cat-${c.id}` + (c.id === topId ? ' is-top' : '');\n    const head = document.createElement('div');\n    head.className = 'tally-head';\n    head.appendChild(icon(c.symbol, 'tally-dot'));\n    head.appendChild(makeText('span', 'tally-name', c.name));\n    card.appendChild(head);\n\n    const bodyBox = document.createElement('div');\n    bodyBox.className = 'tally-body';\n    bodyBox.appendChild(makeText('p', 'tally-val', `${nf.format(totals[c.id].m)} min`));\n    bodyBox.appendChild(makeText('p', 'tally-sub', `${pf.format(totals[c.id].b / 100)} of the battery`));\n    if (c.id === 'storage') bodyBox.appendChild(makeText('p', 'tally-sub', `${pf.format(state.photoUnits / 100)} of the drive`));\n    if (c.id === 'network') bodyBox.appendChild(makeText('p', 'tally-sub', `${nf.format(state.retries)} failed retries`));\n    if (c.id === 'settings') {\n      bodyBox.appendChild(makeText('p', 'tally-sub', `${nf.format(menuMinutesSpent())} min changing settings`));\n      bodyBox.appendChild(makeText('p', 'tally-sub', `${nf.format(wastedMenuMinutes())} min of that changed nothing`));\n    }\n    if (c.id === topId) bodyBox.appendChild(makeText('p', 'tally-flag', 'Biggest cost'));\n    card.appendChild(bodyBox);\n    els.tally.appendChild(card);\n  });\n}\n\nfunction renderReport() {\n  const sent = state.animals.filter(function (a) { return a.sent; }).length;\n  const shots = photosTaken();\n  const detail = photoDetailAverage();\n\n  const rows = [\n    { name: 'Records at the clinic', value: `${nf.format(sent)} of ${nf.format(ANIMALS.length)}`, met: sent === ANIMALS.length },\n    { name: 'Finished before noon', value: state.endReason === 'finished' ? `Done at ${clockText()}` : `Out of morning at ${clockText()}`, met: state.endReason === 'finished' },\n    { name: 'Battery left', value: pf.format(state.battery / 100), met: state.battery > 0 },\n    { name: 'Animals photographed', value: `${nf.format(shots)} of ${nf.format(ANIMALS.length)}`, met: shots === ANIMALS.length },\n    { name: 'How useful the photos were', value: `${nf.format(detail)} out of 100`, met: detail >= USEFUL_PHOTO_SCORE }\n  ];\n\n  const passed = rows.every(function (r) { return r.met; });\n  els.reportHeadline.textContent = passed ? 'Amara got through the morning' : 'The clinic came up short';\n  els.verdict.textContent = passed\n    ? `All ${nf.format(rows.length)} goals met`\n    : `${nf.format(rows.filter(function (r) { return !r.met; }).length)} of ${nf.format(rows.length)} goals missed`;\n  els.verdict.className = passed ? 'verdict good' : 'verdict';\n\n  if (state.endReason === 'battery') els.reportSub.textContent = `The tablet died at ${clockText()}.`;\n  else if (state.endReason === 'clock') els.reportSub.textContent = `It hit ${clockText()} with work still left.`;\n  else if (passed) els.reportSub.textContent = 'Everything reached the clinic and the photos were worth taking.';\n  else els.reportSub.textContent = 'She finished, but something did not make it.';\n\n  clearChildren(els.reportList);\n  rows.forEach(function (row) {\n    const li = document.createElement('li');\n    li.className = row.met ? 'met' : 'unmet';\n    li.appendChild(makeText('span', 'rep-name', row.name));\n    li.appendChild(makeText('span', 'rep-val', row.met ? row.value : `${row.value} (not enough)`));\n    els.reportList.appendChild(li);\n  });\n\n  renderTally();\n\n  clearChildren(els.reportNotes);\n  const notes = [];\n  const wasted = wastedMenuMinutes();\n  if (wasted >= 3) {\n    notes.push(`${nf.format(wasted)} minutes went into settings that do not affect speed, battery, or storage.`);\n  }\n  if (state.retries >= 6) {\n    notes.push(`The tablet failed to send ${nf.format(state.retries)} times while there were no bars. No setting can create a signal, so none of those tries could have worked.`);\n  }\n  if (state.settings.quality === 'original' && state.photoUnits > 0) {\n    notes.push('Every photo stayed at original quality, which is why the drive filled and the send took so long.');\n  }\n  if (detail > 0 && detail < USEFUL_PHOTO_SCORE) {\n    notes.push('The photos were cheap to store and too small to be useful. The clinic could not see what Amara saw.');\n  }\n  if (state.missedHistory) {\n    notes.push('The farmer asked about a calf from last spring. Those records were back at the clinic.');\n  }\n  if (openRecords() >= 2) {\n    notes.push(`She finished with ${nf.format(openRecords())} records open, which is why the app never sped back up.`);\n  }\n  if (state.settings.brightness === 'high') {\n    notes.push('The screen ran at high brightness all morning, which is the most expensive way to read it.');\n  }\n  notes.forEach(function (t) { els.reportNotes.appendChild(makeText('p', 'report-note', t)); });\n\n  clearChildren(els.questions);\n  QUESTIONS.forEach(function (q) { els.questions.appendChild(makeText('li', null, q)); });\n}\n\n/* ================= views ================= */\n\nfunction render() {\n  /* Each view is a separate screen, so switching to one should start it at the\n     top rather than inheriting wherever the last screen was scrolled to. */\n  viewJustChanged = renderedView !== state.view;\n  renderedView = state.view;\n\n  const chrome = state.view !== 'brief';\n  els.statusbar.hidden = !chrome;\n  els.procbar.hidden = !chrome;\n  els.tabbar.hidden = !chrome || state.over;\n  els.resetBtn.hidden = !chrome;\n  if (chrome) renderStatus();\n\n  Object.keys(els.views).forEach(function (key) { els.views[key].hidden = key !== state.view; });\n\n  if (state.view === 'brief') renderGoals();\n  if (state.view === 'farm') renderFarm();\n  if (state.view === 'settings') renderSettings();\n  if (state.view === 'report') renderReport();\n\n  els.tabs.forEach(function (tab) {\n    if (tab.dataset.tab === state.view) tab.setAttribute('aria-current', 'page');\n    else tab.removeAttribute('aria-current');\n  });\n\n  if (viewJustChanged) els.body.scrollTop = 0;\n}\n\nfunction focusMain() {\n  const view = els.views[state.view];\n  if (!view) return;\n  const first = view.querySelector('.btn') || view.querySelector('button');\n  if (!first) return;\n  /* On a fresh screen, keep the scroll at the top instead of letting focus drag\n     the page down to whatever control happens to be first. Inside a screen, let\n     focus scroll normally so the control the student just used stays visible. */\n  first.focus({ preventScroll: viewJustChanged });\n  if (viewJustChanged) els.body.scrollTop = 0;\n  viewJustChanged = false;\n}\n\nlet sheetReturnFocus = null;\n\nfunction openSheet() {\n  if (busy) return;\n  sheetReturnFocus = document.activeElement;\n  els.sheet.hidden = false;\n  els.sheetYes.focus();\n}\n\nfunction closeSheet() {\n  els.sheet.hidden = true;\n  if (sheetReturnFocus && sheetReturnFocus.focus) sheetReturnFocus.focus();\n  sheetReturnFocus = null;\n}\n\n/* Keeps Tab inside the dialog while it is open, since the rest of the screen\n   stays in the document behind it. */\nfunction trapSheetFocus(event) {\n  if (els.sheet.hidden) return;\n  if (event.key === 'Escape') { closeSheet(); return; }\n  if (event.key !== 'Tab') return;\n  const stops = [els.sheetYes, els.sheetNo];\n  const first = stops[0];\n  const last = stops[stops.length - 1];\n  if (event.shiftKey && document.activeElement === first) {\n    event.preventDefault();\n    last.focus();\n  } else if (!event.shiftKey && document.activeElement === last) {\n    event.preventDefault();\n    first.focus();\n  }\n}\n\nfunction confirmRestart() {\n  closeSheet();\n  restart();\n}\n\nfunction goTab(name) {\n  if (busy || state.over) return;\n  if (name !== 'settings') state.justFixed = null;\n  state.view = name;\n  render();\n  focusMain();\n}\n\nfunction renderGoals() {\n  clearChildren(els.briefGoals);\n  GOALS.forEach(function (text) {\n    const li = document.createElement('li');\n    li.appendChild(icon('a-check', 'goal-icon'));\n    li.appendChild(makeText('span', null, text));\n    els.briefGoals.appendChild(li);\n  });\n}\n\nfunction startMorning() {\n  syncProblem();\n  state.view = 'farm';\n  render();\n  focusMain();\n}\n\n/* A reset drops the student back on the scenario screen, so the setup and the\n   goals are in front of them again before the second attempt. */\nfunction restart() {\n  els.sheet.hidden = true;\n  renderedView = null;\n  state = freshState();\n  render();\n  focusMain();\n}\n\n/* ================= boot ================= */\n\nfunction cacheElements() {\n  els.statusbar = document.querySelector('.statusbar');\n  els.body = document.querySelector('.body');\n  els.procbar = document.querySelector('.procbar');\n  els.clock = document.getElementById('stat-clock');\n  els.battery = document.getElementById('stat-battery');\n  els.gaugeBattery = document.getElementById('gauge-battery');\n  els.gaugeDrive = document.getElementById('gauge-drive');\n  els.drive = document.getElementById('stat-drive');\n  els.speed = document.getElementById('stat-speed');\n  els.signal = document.getElementById('stat-signal');\n  els.signalBars = Array.prototype.slice.call(document.querySelectorAll('#signal-bars .bar-seg'));\n  els.procFill = document.getElementById('procbar-fill');\n  els.views = {\n    brief: document.getElementById('view-brief'),\n    farm: document.getElementById('view-farm'),\n    settings: document.getElementById('view-settings'),\n    report: document.getElementById('view-report')\n  };\n  els.banner = document.getElementById('banner');\n  els.pen = document.getElementById('pen');\n  els.penChip = document.getElementById('pen-chip');\n  els.detail = document.getElementById('detail');\n  els.finish = document.getElementById('finish');\n  els.symptom = document.getElementById('symptom');\n  els.settingsNote = document.getElementById('settings-note');\n  els.groups = document.getElementById('groups');\n  els.reportHeadline = document.getElementById('report-headline');\n  els.reportSub = document.getElementById('report-sub');\n  els.verdict = document.getElementById('verdict');\n  els.reportList = document.getElementById('report-list');\n  els.tally = document.getElementById('tally');\n  els.reportNotes = document.getElementById('report-notes');\n  els.questions = document.getElementById('questions');\n  els.tabbar = document.getElementById('tabbar');\n  els.tabDot = document.getElementById('tab-dot');\n  els.briefGoals = document.getElementById('brief-goals');\n  els.resetBtn = document.getElementById('reset-btn');\n  els.sheet = document.getElementById('sheet');\n  els.sheetYes = document.getElementById('sheet-yes');\n  els.sheetNo = document.getElementById('sheet-no');\n  els.tabs = Array.prototype.slice.call(document.querySelectorAll('.tab'));\n}\n\nfunction bindEvents() {\n  document.getElementById('start-btn').addEventListener('click', startMorning);\n  document.getElementById('again-btn').addEventListener('click', restart);\n  els.resetBtn.addEventListener('click', openSheet);\n  els.sheetYes.addEventListener('click', confirmRestart);\n  els.sheetNo.addEventListener('click', closeSheet);\n  document.addEventListener('keydown', trapSheetFocus);\n  els.tabs.forEach(function (tab) {\n    tab.addEventListener('click', function () { goTab(tab.dataset.tab); });\n  });\n}\n\nfunction init() {\n  try {\n    cacheElements();\n    bindEvents();\n    state = freshState();\n    render();\n  } catch (error) {\n    /* Students get a plain message; the real error goes to the console so\n       whoever is fixing it can see what actually broke. */\n    console.error('FieldVet could not start.', error);\n    const p = document.createElement('p');\n    p.textContent = 'This activity could not load. Refresh the page, and tell your teacher if it happens again.';\n    document.body.insertBefore(p, document.body.firstChild);\n  }\n}\n\ninit();",
