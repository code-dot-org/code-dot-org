    "display_name": "Veterinary Software",
    "bubble_choice_description": "Help Amara to optimize her Fieldvet tablet software that tracks her animal visits.",
    "thumbnail_url": "https://images.code.org/e2318b149e2eea274673399982ea37f1-amara.png"
