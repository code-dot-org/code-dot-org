        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Career Snapshots</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n    <script defer src=\"script.js\"></script>\n  </head>\n  <body>\n    <h1 class=\"title\">Career Snapshots</h1>\n    <main class=\"container\">\n      <section class=\"left\">\n        <img id=\"image\" class=\"image\" src=\"image.png\" alt=\"Career snapshots illustration\" />\n      </section>\n      <section class=\"right\">\n        <div id=\"textArea\" class=\"textArea\" aria-live=\"polite\">Choose a role to see a day-in-the-life snapshot.</div>\n        <div class=\"buttons\">\n          <button id=\"frontEndDevButton\" type=\"button\">Front-End Dev</button>\n          <button id=\"qaButton\" type=\"button\">QA</button>\n          <button id=\"uxButton\" type=\"button\">UX</button>\n          <button id=\"dataButton\" type=\"button\">Data</button>\n          <button id=\"pmButton\" type=\"button\">PM</button>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nhtml,\nbody {\n  height: 100%;\n}\n\nbody {\n  margin: 0;\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n  background: #f6c453;\n  color: #1f2937;\n}\n\n.title {\n  text-align: center;\n  margin: 16px 0 0;\n  font-size: 1.75rem;\n  letter-spacing: 0.5px;\n  color: #0f172a;\n}\n\n.container {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 24px;\n  padding: 24px;\n  max-width: 1000px;\n  margin: 0 auto;\n}\n\n.left {\n  background: #fff;\n  border: 1px solid #e5e7eb;\n  border-radius: 12px;\n  padding: 16px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n}\n\n.image {\n  display: block;\n  max-width: 100%;\n  height: auto;\n  border-radius: 8px;\n  object-fit: contain;\n}\n\n.right {\n  display: flex;\n  flex-direction: column;\n  gap: 24px;\n}\n\n.textArea {\n  min-height: 120px;\n  border: 1px dashed #cbd5e1;\n  border-radius: 12px;\n  padding: 16px;\n  background: #fff;\n  font-size: 1.1rem;\n  line-height: 1.6;\n  color: #111827;\n}\n\n.buttons {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  width: 240px;\n  margin-inline: auto;\n}\n\n.buttons button {\n  padding: 12px 16px;\n  font-size: 1rem;\n  border-radius: 10px;\n  border: 1px solid #1f2937;\n  background: #ffffff;\n  color: #111827;\n  cursor: pointer;\n  transition: background-color 120ms ease, color 120ms ease, border-color 120ms ease;\n}\n\n\n.buttons button:active {\n  transform: translateY(1px);\n}\n\n@media (max-width: 800px) {\n  .container {\n    grid-template-columns: 1fr;\n  }\n\n  .buttons {\n    width: 100%;\n  }\n}",
          "folderId": "0",
          "active": false
