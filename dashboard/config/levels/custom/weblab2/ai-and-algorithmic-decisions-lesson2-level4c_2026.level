    "display_name": "Career Snapshot App",
    "bubble_choice_description": "Create a web app that shows people tasks that are involved in various careers.",
    "thumbnail_url": "https://images.code.org/6f99f05a90e21fe82614b10bc1ff09e9-main-image.png",
