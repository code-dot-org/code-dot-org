          "language": "html",
          "contents": "<!DOCTYPE html> \n<html> \n<head>\n  <link rel=\"stylesheet\" href=\"animals.css\">\n</head>\n <body>\n   <h1> Dogs vs Cats </h1> \n \n    <h3>Dogs</h3> \n  <img src=\"dog.jpg\" \n      alt=\"dog jumping\"> \n \n  <p>Cpl Ian Houlding - Wikimedia Commons - OGL</p>\n \n  <h3>Cats</h3> \n </body> \n</html>",
