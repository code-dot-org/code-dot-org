      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>ExploreWorld Travel</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n\n  <!-- Header / Navigation -->\n  <header class=\"site-header\">\n    <div class=\"container nav-container\">\n      <div class=\"logo\">\n        <a href=\"index.html\" class=\"logo\">\n          <img src=\"images/icons/logo.png\" alt=\"ExploreWorld logo\">\n          <span>ExploreWorld</span>\n        </a>\n      </div>\n      <nav class=\"main-nav\">\n        <ul>\n          <li><a href=\"index.html\"><img src=\"images/icons/home-icon.png\" alt=\"\"> Home</a></li>\n          <li><a href=\"destinations.html\"><img src=\"images/icons/location-icon.png\" alt=\"\"> Destinations</a></li>\n        </ul>\n      </nav>\n    </div>\n  </header>\n\n  <!-- Hero -->\n  <section class=\"hero\">\n    <img src=\"images/home-hero.jpg\" alt=\"Travel landscape\">\n    <div class=\"hero-text\">\n      <h1>Explore the World</h1>\n      <p>Your next adventure starts here</p>\n    </div>\n  </section>\n\n  <!-- Destinations -->\n  <section class=\"destinations container\">\n    <h2>Popular Destinations</h2>\n\n    <div class=\"card-grid\">\n      <div class=\"card\">\n        <img src=\"images/paris.jpg\" alt=\"Paris\">\n        <h3>Paris</h3>\n        <p>Experience the charm of the City of Light.</p>\n      </div>\n\n      <div class=\"card\">\n        <img src=\"images/tokyo.jpg\" alt=\"Tokyo\">\n        <h3>Tokyo</h3>\n        <p>A perfect blend of tradition and innovation.</p>\n      </div>\n\n      <div class=\"card\">\n        <img src=\"images/newyork.jpg\" alt=\"New York\">\n        <h3>New York</h3>\n        <p>The city that never sleeps.</p>\n      </div>\n\n      <div class=\"card\">\n        <img src=\"images/rome.jpg\" alt=\"Rome\">\n        <h3>Rome</h3>\n        <p>Walk through history and timeless culture.</p>\n      </div>\n\n      <div class=\"card\">\n        <img src=\"images/bali.jpg\" alt=\"Bali\">\n        <h3>Bali</h3>\n        <p>Relax in tropical paradise.</p>\n      </div>\n\n      <div class=\"card\">\n        <img src=\"images/iceland.jpg\" alt=\"Iceland\">\n        <h3>Iceland</h3>\n        <p>Discover dramatic natural landscapes.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- Feature Section -->\n  <section class=\"feature container\">\n    <div class=\"feature-content\">\n      <img src=\"images/travel-feature.jpg\" alt=\"Travel experience\">\n      <div>\n        <h2>Why Travel With Us?</h2>\n        <p>We offer curated travel experiences, expert guides, and seamless planning to make your trip unforgettable.</p>\n      </div>\n    </div>\n  </section>\n\n  <!-- Footer -->\n  <footer class=\"site-footer\">\n    <div class=\"container footer-content\">\n      <p>© 2026 ExploreWorld Travel</p>\n      <div class=\"footer-contact\">\n        <p><img src=\"images/icons/phone-icon.png\" alt=\"\"> +1 (555) 123-4567</p>\n      </div>\n    </div>\n  </footer>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "15": {
          "id": "15",
          "name": "destinations.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Destinations | ExploreWorld Travel</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n\n  <!-- Header -->\n  <header class=\"site-header\">\n    <div class=\"container nav-container\">\n  \n      <a href=\"index.html\" class=\"logo\">\n        <img src=\"images/icons/logo.png\" alt=\"ExploreWorld logo\">\n        <span>ExploreWorld</span>\n      </a>\n  \n      <nav class=\"main-nav\">\n        <ul>\n          <li><a href=\"index.html\"><img src=\"images/icons/home-icon.png\" alt=\"\"> Home</a></li>\n          <li><a href=\"destinations.html\"><img src=\"images/icons/location-icon.png\" alt=\"\"> Destinations</a></li>\n        </ul>\n      </nav>\n  \n    </div>\n  </header>\n\n  <!-- Hero -->\n  <section class=\"hero\">\n    <img src=\"images/destinations-hero.jpg\" alt=\"City skyline\">\n    <div class=\"hero-text\">\n      <h1>Our Destinations</h1>\n      <p>Find your perfect getaway</p>\n    </div>\n  </section>\n\n  <!-- Destination List -->\n  <section class=\"destination-list container\">\n\n    <div class=\"destination-item\">\n      <img src=\"images/paris.jpg\" alt=\"Paris\">\n      <div class=\"destination-text\">\n        <h2>Paris</h2>\n        <p>Explore iconic landmarks, world-class cuisine, and timeless romance in France’s capital.</p>\n      </div>\n    </div>\n\n    <div class=\"destination-item\">\n      <img src=\"images/tokyo.jpg\" alt=\"Tokyo\">\n      <div class=\"destination-text\">\n        <h2>Tokyo</h2>\n        <p>Experience vibrant city life, cutting-edge technology, and rich cultural traditions.</p>\n      </div>\n    </div>\n\n    <div class=\"destination-item\">\n      <img src=\"images/newyork.jpg\" alt=\"New York\">\n      <div class=\"destination-text\">\n        <h2>New York</h2>\n        <p>Discover world-famous attractions, diverse neighborhoods, and nonstop energy.</p>\n      </div>\n    </div>\n\n    <div class=\"destination-item\">\n      <img src=\"images/rome.jpg\" alt=\"Rome\">\n      <div class=\"destination-text\">\n        <h2>Rome</h2>\n        <p>Step into history with ancient ruins, stunning architecture, and authentic Italian culture.</p>\n      </div>\n    </div>\n\n  </section>\n\n  <!-- Footer -->\n  <footer class=\"site-footer\">\n    <div class=\"container footer-content\">\n      <p>© 2026 ExploreWorld Travel</p>\n      <div class=\"footer-contact\">\n        <p><img src=\"images/icons/phone-icon.png\" alt=\"\"> +1 (555) 123-4567</p>\n      </div>\n    </div>\n  </footer>\n\n</body>\n</html>",
          "folderId": "0",
          "active": false
        },
        "16": {
          "id": "16",
          "name": "styles.css",
          "contents": "/* Reset */\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nbody {\n  font-family: Arial, sans-serif;\n  line-height: 1.6;\n  color: #222;\n}\n\n/* Layout */\n.container {\n  width: 1100px;\n  max-width: 1100px;\n  margin: 0 auto;\n  padding: 20px;\n}\n\n/* Header */\n.site-header {\n  background: #fff;\n  border-bottom: 1px solid #ddd;\n}\n\n.nav-container {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.logo {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-weight: bold;\n  font-size: 18px;\n}\n\n.logo img {\n  width: 36px;\n  height: 36px;\n}\n\n.main-nav ul {\n  display: flex;\n  list-style: none;\n  gap: 30px;\n}\n\n.main-nav a {\n  text-decoration: none;\n  color: #222;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 15px;\n}\n\n.main-nav img {\n  width: 18px;\n  height: 18px;\n}\n\n/* Hero */\n.hero {\n  position: relative;\n  height: 400px;\n  overflow: hidden;\n}\n\n.hero img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.hero-text {\n  position: absolute;\n  bottom: 40px;\n  left: 40px;\n  color: white;\n}\n\n.hero-text h1 {\n  font-size: 40px;\n  margin-bottom: 10px;\n}\n\n/* Cards */\n.card-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n  gap: 20px;\n  margin-top: 20px;\n}\n\n.card {\n  border: 1px solid #ddd;\n  padding: 10px;\n  background: #fff;\n}\n\n.card img {\n  width: 100%;\n  height: 180px;\n  object-fit: cover;\n}\n\n.card h3 {\n  margin: 10px 0 5px;\n}\n\n/* Feature */\n.feature-content {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n  margin-top: 20px;\n}\n\n.feature-content img {\n  width: 50%;\n  height: 300px;\n  object-fit: cover;\n}\n\n/* Destination Page */\n.destination-item {\n  display: flex;\n  gap: 20px;\n  margin-bottom: 30px;\n  align-items: center;\n}\n\n.destination-item img {\n  width: 300px;\n  height: 200px;\n  object-fit: cover;\n}\n\n.destination-text h2 {\n  margin-bottom: 10px;\n}\n\n/* Footer */\n.site-footer {\n  background: #f5f5f5;\n  margin-top: 40px;\n}\n\n.footer-content {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.footer-contact img {\n  width: 16px;\n  margin-right: 5px;\n}\n\n/* Normal responsive behavior */\n@media (max-width: 768px) {\n  .container {\n    width: 92%;\n    max-width: 92%;\n  }\n\n  .nav-container {\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 12px;\n  }\n\n  .main-nav ul {\n    flex-wrap: wrap;\n    gap: 16px;\n  }\n\n  .hero {\n    height: 280px;\n  }\n\n  .hero-text {\n    left: 20px;\n    bottom: 20px;\n  }\n\n  .hero-text h1 {\n    font-size: 28px;\n  }\n\n  .feature-content {\n    flex-direction: column;\n  }\n\n  .feature-content img {\n    width: 100%;\n  }\n\n  .destination-item {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n\n  .destination-item img {\n    width: 100%;\n    height: 220px;\n  }\n}\n\n/* INTENTIONALLY BROKEN mobile styles */\n@media (max-width: 768px) {\n  /* Layout & Structure */\n  .container {\n    min-width: 1100px;\n  }\n\n  /* Navigation */\n  .main-nav ul {\n    flex-direction: row;\n    justify-content: space-between;\n  }\n\n  .main-nav li {\n    width: 200px;\n  }\n\n  /* Images & Media */\n  .card img,\n  .feature-content img,\n  .destination-item img {\n    height: 120px;\n    object-fit: cover;\n  }\n\n  /* Text & Readability */\n  .hero-text p,\n  .card p,\n  .destination-text p,\n  .footer-content p {\n    font-size: 10px;\n    line-height: 1.1;\n  }\n}",
          "folderId": "0",
