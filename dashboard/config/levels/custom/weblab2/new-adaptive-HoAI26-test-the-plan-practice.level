      "files": {
        "2e97900c-76ca-4d74-a0bc-03343b7b3a12": {
          "id": "2e97900c-76ca-4d74-a0bc-03343b7b3a12",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Decision Wheel Plan vs. Result</title>\n    <style>\n        body {\n            font-family: sans-serif;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: flex-start;\n            min-height: 100vh;\n            background-color: #f0f0f0;\n            color: #333;\n            margin: 0;\n            padding: 20px;\n        }\n        h1 {\n            color: #0056b3;\n            margin-bottom: 20px;\n        }\n        .section-container {\n            background-color: #fff;\n            padding: 25px;\n            border-radius: 10px;\n            box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n            margin-bottom: 30px;\n            width: 90%;\n            max-width: 600px;\n        }\n        .section-container h2 {\n            color: #007bff;\n            margin-top: 0;\n            border-bottom: 1px solid #eee;\n            padding-bottom: 10px;\n            margin-bottom: 20px;\n        }\n        .plan-details ul {\n            list-style: disc inside;\n            padding-left: 0;\n        }\n        .plan-details li {\n            margin-bottom: 8px;\n            font-size: 1.1em;\n        }\n\n        /* Wheel styling (adapted from Level 13) */\n        .wheel-container {\n            position: relative;\n            width: 250px;\n            height: 250px;\n            border-radius: 50%;\n            background-color: #eee;\n            border: 5px solid #bbb;\n            overflow: hidden;\n            margin: 30px auto;\n            box-shadow: 0 4px 8px rgba(0,0,0,0.2);\n        }\n        .segment {\n            position: absolute;\n            width: 50%;\n            height: 50%;\n            top: 0;\n            left: 50%;\n            transform-origin: 0% 100%;\n            background-color: #ddd; /* Default bland color */\n            border: 1px solid #aaa;\n            box-sizing: border-box;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-weight: bold;\n            color: #555;\n            font-size: 0.9em;\n            text-align: center;\n            padding: 5px;\n            opacity: 0.8;\n            transition: background-color 0.3s ease, color 0.3s ease;\n        }\n        .segment:nth-child(1) { transform: rotate(0deg) skewY(-30deg); }\n        .segment:nth-child(2) { transform: rotate(60deg) skewY(-30deg); }\n        .segment:nth-child(3) { transform: rotate(120deg) skewY(-30deg); }\n        .segment:nth-child(4) { transform: rotate(180deg) skewY(-30deg); }\n        .segment:nth-child(5) { transform: rotate(240deg) skewY(-30deg); }\n        .segment:nth-child(6) { transform: rotate(300deg) skewY(-30deg); }\n\n        .segment span {\n            transform: skewY(30deg) rotate(-30deg); /* Counter-skew and rotate for text */\n            display: none; /* Hidden by default */\n        }\n\n        /* Dynamic Styling from controls */\n        .colorful .segment:nth-child(1) { background-color: #FFDDC1; }\n        .colorful .segment:nth-child(2) { background-color: #FFABAB; }\n        .colorful .segment:nth-child(3) { background-color: #FFC3A0; }\n        .colorful .segment:nth-child(4) { background-color: #FF677D; }\n        .colorful .segment:nth-child(5) { background-color: #D4A5A5; }\n        .colorful .segment:nth-child(6) { background-color: #B5EAD7; }\n        .colorful .segment { color: #333; opacity: 1; }\n\n        .show-labels .segment span { display: block; }\n\n        .spin-button-container { text-align: center; margin-top: 20px; }\n        .spin-button { display: none; background-color: #28a745; color: white; padding: 10px 20px; border: none; border-radius: 5px; cursor: pointer; font-size: 1.1em; }\n        .spin-button:hover { background-color: #218838; }\n\n        /* Prompt Dial Controls Styling */\n        .prompt-controls {\n            display: flex;\n            flex-direction: column;\n            gap: 15px;\n            width: 100%;\n        }\n        .control-item {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n        }\n        .control-item label {\n            font-size: 1.1em;\n            color: #555;\n        }\n        .switch {\n            position: relative;\n            display: inline-block;\n            width: 40px;\n            height: 24px;\n        }\n        .switch input {\n            opacity: 0;\n            width: 0;\n            height: 0;\n        }\n        .slider {\n            position: absolute;\n            cursor: pointer;\n            top: 0;\n            left: 0;\n            right: 0;\n            bottom: 0;\n            background-color: #ccc;\n            -webkit-transition: .4s;\n            transition: .4s;\n            border-radius: 24px;\n        }\n        .slider:before {\n            position: absolute;\n            content: \"\";\n            height: 16px;\n            width: 16px;\n            left: 4px;\n            bottom: 4px;\n            background-color: white;\n            -webkit-transition: .4s;\n            transition: .4s;\n            border-radius: 50%;\n        }\n        input:checked + .slider {\n            background-color: #2196F3;\n        }\n        input:focus + .slider {\n            box-shadow: 0 0 1px #2196F3;\n        }\n        input:checked + .slider:before {\n            -webkit-transform: translateX(16px);\n            -ms-transform: translateX(16px);\n            transform: translateX(16px);\n        }\n\n        .decision-buttons {\n            margin-top: 30px;\n            text-align: center;\n            display: flex;\n            justify-content: space-around;\n            gap: 10px;\n        }\n        .decision-buttons button {\n            padding: 12px 25px;\n            font-size: 1em;\n            border: none;\n            border-radius: 5px;\n            cursor: pointer;\n            transition: background-color 0.3s ease;\n            width: 120px;\n        }\n        .decision-buttons .keep { background-color: #4CAF50; color: white; }\n        .decision-buttons .keep:hover { background-color: #45a049; }\n        .decision-buttons .redirect { background-color: #ffc107; color: #333; }\n        .decision-buttons .redirect:hover { background-color: #e0a800; }\n        .decision-buttons .edit { background-color: #007bff; color: white; }\n        .decision-buttons .edit:hover { background-color: #0056b3; }\n    </style>\n</head>\n<body>\n    <h1>Plan vs. Result: Decision Wheel</h1>\n\n    <div class=\"section-container\">\n        <h2>Desired Plan for the Wheel</h2>\n        <div class=\"plan-details\">\n            <p>Our client wants a decision wheel with the following features:</p>\n            <ul>\n                <li>The wheel should have <strong>6 clearly visible segments</strong>.</li>\n                <li>Each segment must display a <strong>distinct label</strong> (e.g., \"Option 1\", \"Option 2\").</li>\n                <li>The segments should use <strong>vibrant and easy-to-distinguish colors</strong>.</li>\n                <li>There should be an active <strong>'Spin the Wheel' button</strong> below the wheel.</li>\n            </ul>\n        </div>\n    </div>\n\n    <div class=\"section-container\">\n        <h2>AI-Generated Wheel</h2>\n        <div class=\"wheel-container\" id=\"decisionWheel\">\n            <div class=\"segment\"><span>Option 1</span></div>\n            <div class=\"segment\"><span>Option 2</span></div>\n            <div class=\"segment\"><span>Option 3</span></div>\n            <div class=\"segment\"><span>Option 4</span></div>\n            <div class=\"segment\"><span>Option 5</span></div>\n            <div class=\"segment\"><span>Option 6</span></div>\n        </div>\n        <div class=\"spin-button-container\">\n            <button class=\"spin-button\" id=\"spinButton\">Spin the Wheel</button>\n        </div>\n\n        <div class=\"prompt-controls\">\n            <h3>Prompt Dial: Simulate AI Output</h3>\n            <p>Toggle these to see how different prompt details change the wheel:</p>\n            <div class=\"control-item\">\n                <label for=\"colorfulSegments\">Use Vibrant Colors (Prompt detail: \"...use bright, primary colors\")</label>\n                <label class=\"switch\">\n                    <input type=\"checkbox\" id=\"colorfulSegments\">\n                    <span class=\"slider\"></span>\n                </label>\n            </div>\n            <div class=\"control-item\">\n                <label for=\"showLabels\">Show Segment Labels (Prompt detail: \"...display 'Option X' on each segment\")</label>\n                <label class=\"switch\">\n                    <input type=\"checkbox\" id=\"showLabels\">\n                    <span class=\"slider\"></span>\n                </label>\n            </div>\n            <div class=\"control-item\">\n                <label for=\"enableSpinButton\">Enable 'Spin' Button (Prompt detail: \"...add a 'Spin' button\")</label>\n                <label class=\"switch\">\n                    <input type=\"checkbox\" id=\"enableSpinButton\">\n                    <span class=\"slider\"></span>\n                </label>\n            </div>\n        </div>\n\n        <div class=\"decision-buttons\">\n            <button class=\"keep\">Keep It</button>\n            <button class=\"redirect\">Redirect (New Prompt)</button>\n            <button class=\"edit\">Edit (Small Change)</button>\n        </div>\n    </div>\n\n    <script>\n        const decisionWheel = document.getElementById('decisionWheel');\n        const colorfulSegmentsToggle = document.getElementById('colorfulSegments');\n        const showLabelsToggle = document.getElementById('showLabels');\n        const enableSpinButtonToggle = document.getElementById('enableSpinButton');\n        const spinButton = document.getElementById('spinButton');\n\n        colorfulSegmentsToggle.addEventListener('change', function() {\n            if (this.checked) {\n                decisionWheel.classList.add('colorful');\n            } else {\n                decisionWheel.classList.remove('colorful');\n            }\n        });\n\n        showLabelsToggle.addEventListener('change', function() {\n            if (this.checked) {\n                decisionWheel.classList.add('show-labels');\n            } else {\n                decisionWheel.classList.remove('show-labels');\n            }\n        });\n\n        enableSpinButtonToggle.addEventListener('change', function() {\n            if (this.checked) {\n                spinButton.style.display = 'block';\n            } else {\n                spinButton.style.display = 'none';\n            }\n        });\n\n        // Initial state update\n        colorfulSegmentsToggle.dispatchEvent(new Event('change'));\n        showLabelsToggle.dispatchEvent(new Event('change'));\n        enableSpinButtonToggle.dispatchEvent(new Event('change'));\n    </script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        }
      },
