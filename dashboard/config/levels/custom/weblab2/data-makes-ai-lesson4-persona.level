        "9": {
          "id": "9",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Meet Dr. Osei</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <main class=\"app\">\n    <h1 class=\"page-title\">Meet Dr. Osei</h1>\n\n    <div class=\"layout\">\n      <div id=\"scene\" class=\"scene\">\n        <div class=\"stage\">\n          <img id=\"portrait\" class=\"portrait\" src=\"portrait-img.jpg\" width=\"960\" height=\"960\"\n               alt=\"Dr. Osei, a smiling park data scientist in a tan field shirt, standing in the savanna and holding a tablet.\">\n          <p class=\"nameplate\"><span class=\"nameplate-name\">Dr. Osei</span><span class=\"nameplate-role\">Park data scientist</span></p>\n        </div>\n\n        <div id=\"bubble\" class=\"bubble is-empty\">\n          <svg class=\"bubble-shape\" aria-hidden=\"true\" focusable=\"false\">\n            <path id=\"bubble-path\" class=\"bubble-path\" d=\"\"></path>\n          </svg>\n          <span class=\"bubble-name\" aria-hidden=\"true\">Dr. Osei</span>\n          <p id=\"answer\" class=\"bubble-text\" role=\"status\" aria-live=\"polite\" aria-label=\"Dr. Osei says\"></p>\n        </div>\n      </div>\n\n      <section class=\"panel\" aria-labelledby=\"ask-title\">\n        <h2 id=\"ask-title\" class=\"panel-title\">Ask Dr. Osei</h2>\n        <ul id=\"questions\" class=\"questions\"></ul>\n        <p id=\"progress\" class=\"progress\"></p>\n        <div id=\"done\" class=\"done\" role=\"status\"></div>\n      </section>\n    </div>\n    <p id=\"error\" class=\"error\" hidden></p>\n  </main>\n  <script src=\"script.js\" defer></script>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "10": {
          "id": "10",
          "name": "script.js",
          "contents": "(function () {\n  'use strict';\n\n  var TEXT = {\n    asked: 'Asked',\n    progress: function (count, total) {\n      var format = new Intl.NumberFormat();\n      return `${format.format(count)} of ${format.format(total)} questions asked`;\n    },\n    done: 'You asked all four questions.',\n    error: 'Something went wrong loading this activity. Please reload the page.'\n  };\n\n  var QUESTIONS = [\n    {\n      question: 'What do you do?',\n      answer: 'I help the park protect its elephants. I use data to predict when they will come to the waterhole.'\n    },\n    {\n      question: 'What data do you use?',\n      answer: 'Photos from camera traps and notes from park rangers. A camera trap is a camera that takes a photo when an animal walks past.'\n    },\n    {\n      question: 'Why does it matter?',\n      answer: 'If we know when elephants will come, rangers can be there to keep them safe.'\n    },\n    {\n      question: 'What do you need from me?',\n      answer: 'Today you\\'re on my team. Help me choose the data our model is trained on.'\n    }\n  ];\n\n  var CONFIG = {\n    // Positions below are percentages of the photo's width and height.\n    mouth: { x: 50.5, y: 31 },\n    // The speech bubble must never cover this box (head, ears and neck).\n    face: { left: 39, right: 63, top: 7, bottom: 40 },\n    // Where the photo is anchored when object-fit: cover crops it (0 to 1).\n    cropAnchor: { x: 0.5, y: 0 },\n    stackedQuery: '(max-width: 639px)',\n    borderWidth: 2,\n    cornerRadius: 22,\n    tailBaseWidth: 26,\n    tailTipWidth: 4\n  };\n\n  var SVG_NS = 'http://www.w3.org/2000/svg';\n  var scene = document.getElementById('scene');\n  var portrait = document.getElementById('portrait');\n  var bubble = document.getElementById('bubble');\n  var bubbleShape = bubble.querySelector('.bubble-shape');\n  var bubblePath = document.getElementById('bubble-path');\n  var answer = document.getElementById('answer');\n  var list = document.getElementById('questions');\n  var progress = document.getElementById('progress');\n  var done = document.getElementById('done');\n  var errorBox = document.getElementById('error');\n\n  var buttons = [];\n  var askedCount = 0;\n  var showTimer = null;\n\n  function clamp(value, min, max) {\n    return Math.max(min, Math.min(max, value));\n  }\n\n  function createCheckIcon() {\n    var svg = document.createElementNS(SVG_NS, 'svg');\n    svg.setAttribute('class', 'asked-check');\n    svg.setAttribute('viewBox', '0 0 16 16');\n    svg.setAttribute('aria-hidden', 'true');\n    svg.setAttribute('focusable', 'false');\n    var path = document.createElementNS(SVG_NS, 'path');\n    path.setAttribute('d', 'M3 8.5l3.2 3.2L13 4.8');\n    svg.appendChild(path);\n    return svg;\n  }\n\n  function createQuestionButton(item) {\n    var li = document.createElement('li');\n    var button = document.createElement('button');\n    button.type = 'button';\n    button.className = 'question';\n    button.setAttribute('aria-pressed', 'false');\n\n    var text = document.createElement('span');\n    text.className = 'question-text';\n    text.textContent = item.question;\n\n    var tag = document.createElement('span');\n    tag.className = 'asked-tag';\n    tag.hidden = true;\n    tag.appendChild(createCheckIcon());\n    tag.appendChild(document.createTextNode(TEXT.asked));\n\n    button.appendChild(text);\n    button.appendChild(tag);\n    button.addEventListener('click', function () {\n      askQuestion(button, item);\n    });\n    li.appendChild(button);\n    list.appendChild(li);\n    return button;\n  }\n\n  // Maps a point given in photo percentages to scene pixels, allowing for\n  // the crop that object-fit: cover applies when the photo's box is wider\n  // than the image's natural shape.\n  function photoPointToScene(xPercent, yPercent) {\n    var sceneRect = scene.getBoundingClientRect();\n    var box = portrait.getBoundingClientRect();\n    var naturalWidth = portrait.naturalWidth || portrait.width;\n    var naturalHeight = portrait.naturalHeight || portrait.height;\n    var scale = Math.max(box.width / naturalWidth, box.height / naturalHeight);\n    var drawnWidth = naturalWidth * scale;\n    var drawnHeight = naturalHeight * scale;\n    var offsetX = (box.width - drawnWidth) * CONFIG.cropAnchor.x;\n    var offsetY = (box.height - drawnHeight) * CONFIG.cropAnchor.y;\n    return {\n      x: box.left - sceneRect.left + offsetX + (xPercent / 100) * drawnWidth,\n      y: box.top - sceneRect.top + offsetY + (yPercent / 100) * drawnHeight\n    };\n  }\n\n  function getMouthPoint() {\n    return photoPointToScene(CONFIG.mouth.x, CONFIG.mouth.y);\n  }\n\n  // One closed outline: the rounded bubble with the tail built into one edge.\n  // The edge between the tail's two base points is left out, so the border\n  // runs down both sides of the tail with no seam.\n  function buildOutline(width, height, mouth, stacked) {\n    var inset = CONFIG.borderWidth / 2;\n    var x0 = inset;\n    var y0 = inset;\n    var x1 = width - inset;\n    var y1 = height - inset;\n    var r = Math.min(CONFIG.cornerRadius, (x1 - x0) / 2, (y1 - y0) / 2);\n    var half = CONFIG.tailBaseWidth / 2;\n    var tipHalf = CONFIG.tailTipWidth / 2;\n    var corner = r + half;\n    var baseX = stacked ? clamp(mouth.x, x0 + corner, x1 - corner) : x0;\n    var baseY = stacked ? y0 : clamp(mouth.y, y0 + corner, y1 - corner);\n    var dx = mouth.x - baseX;\n    var dy = mouth.y - baseY;\n    var length = Math.sqrt(dx * dx + dy * dy) || 1;\n    var nx = -dy / length * tipHalf;\n    var ny = dx / length * tipHalf;\n    var tipA = { x: mouth.x + nx, y: mouth.y + ny };\n    var tipB = { x: mouth.x - nx, y: mouth.y - ny };\n    var arc = `A ${r} ${r} 0 0 1`;\n    var tailPart;\n    var tipFirst;\n    var tipSecond;\n\n    if (stacked) {\n      // Top edge runs left to right.\n      tipFirst = tipA.x <= tipB.x ? tipA : tipB;\n      tipSecond = tipFirst === tipA ? tipB : tipA;\n      return `M ${x0 + r} ${y0} H ${baseX - half} L ${tipFirst.x} ${tipFirst.y} ` +\n        `L ${tipSecond.x} ${tipSecond.y} L ${baseX + half} ${y0} H ${x1 - r} ` +\n        `${arc} ${x1} ${y0 + r} V ${y1 - r} ${arc} ${x1 - r} ${y1} H ${x0 + r} ` +\n        `${arc} ${x0} ${y1 - r} V ${y0 + r} ${arc} ${x0 + r} ${y0} Z`;\n    }\n\n    // Left edge runs bottom to top.\n    tipFirst = tipA.y >= tipB.y ? tipA : tipB;\n    tipSecond = tipFirst === tipA ? tipB : tipA;\n    tailPart = `V ${baseY + half} L ${tipFirst.x} ${tipFirst.y} ` +\n      `L ${tipSecond.x} ${tipSecond.y} L ${x0} ${baseY - half}`;\n    return `M ${x0 + r} ${y0} H ${x1 - r} ${arc} ${x1} ${y0 + r} V ${y1 - r} ` +\n      `${arc} ${x1 - r} ${y1} H ${x0 + r} ${arc} ${x0} ${y1 - r} ${tailPart} ` +\n      `V ${y0 + r} ${arc} ${x0 + r} ${y0} Z`;\n  }\n\n  function drawBubble() {\n    // Layout sizes ignore the pop animation's scale.\n    var width = bubble.offsetWidth;\n    var height = bubble.offsetHeight;\n    if (!width || !height) { return; }\n    var mouth = getMouthPoint();\n    var local = { x: mouth.x - bubble.offsetLeft, y: mouth.y - bubble.offsetTop };\n    var stacked = window.matchMedia(CONFIG.stackedQuery).matches;\n\n    bubbleShape.setAttribute('width', width);\n    bubbleShape.setAttribute('height', height);\n    bubbleShape.setAttribute('viewBox', `0 0 ${width} ${height}`);\n    bubblePath.setAttribute('d', buildOutline(width, height, local, stacked));\n  }\n\n  function restartPop() {\n    bubble.classList.remove('is-popping');\n    void bubble.offsetWidth;\n    bubble.classList.add('is-popping');\n  }\n\n  function showAnswer(text) {\n    window.clearTimeout(showTimer);\n    answer.textContent = '';\n    showTimer = window.setTimeout(function () {\n      answer.textContent = text;\n      bubble.classList.remove('is-empty');\n      drawBubble();\n      restartPop();\n    }, 30);\n  }\n\n  function updateProgress() {\n    progress.textContent = TEXT.progress(askedCount, QUESTIONS.length);\n    done.textContent = askedCount === QUESTIONS.length ? TEXT.done : '';\n  }\n\n  function askQuestion(button, item) {\n    buttons.forEach(function (other) {\n      other.setAttribute('aria-pressed', other === button ? 'true' : 'false');\n    });\n    if (!button.hasAttribute('data-asked')) {\n      button.setAttribute('data-asked', 'true');\n      button.querySelector('.asked-tag').hidden = false;\n      askedCount += 1;\n      updateProgress();\n    }\n    showAnswer(item.answer);\n  }\n\n  function init() {\n    buttons = QUESTIONS.map(createQuestionButton);\n    updateProgress();\n    window.addEventListener('resize', drawBubble);\n    portrait.addEventListener('load', drawBubble);\n    if (window.ResizeObserver) {\n      var observer = new ResizeObserver(drawBubble);\n      observer.observe(scene);\n      observer.observe(bubble);\n    }\n  }\n\n  try {\n    init();\n  } catch (error) {\n    errorBox.textContent = TEXT.error;\n    errorBox.hidden = false;\n  }\n})();\n",
          "folderId": "0",
          "active": false
        },
        "11": {
          "id": "11",
          "name": "style.css",
          "contents": ":root {\n  --sand: #f6efe2;\n  --ink: #2b2118;\n  --card: #ffffff;\n  --accent: #9a3b12;\n  --accent-ink: #ffffff;\n  --asked: #2f5d2a;\n  --focus: #1b4db3;\n  --plate: rgba(43, 33, 24, 0.9);\n  --scene-size: min(calc(100vh - 64px), 58vw, 720px);\n}\n\n* { box-sizing: border-box; }\n\nhtml, body {\n  height: 100%;\n  margin: 0;\n  overflow: hidden;\n}\n\nbody {\n  background: var(--sand);\n  color: var(--ink);\n  font-family: \"Trebuchet MS\", \"Segoe UI\", Arial, sans-serif;\n  font-size: 16px;\n  line-height: 1.35;\n}\n\n.app {\n  display: grid;\n  grid-template-rows: auto auto;\n  align-content: center;\n  justify-content: center;\n  height: 100%;\n  padding: 8px 16px 12px;\n}\n\n.page-title {\n  margin: 0 0 6px;\n  font-size: clamp(1.15rem, 3.2vh, 1.5rem);\n  line-height: 1.2;\n}\n\n.layout {\n  display: grid;\n  grid-template-columns: var(--scene-size) minmax(0, 560px);\n  grid-template-rows: var(--scene-size);\n  column-gap: clamp(14px, 2.4vw, 28px);\n  justify-content: center;\n  align-content: center;\n  min-height: 0;\n}\n\n.scene {\n  position: relative;\n  width: var(--scene-size);\n  height: var(--scene-size);\n}\n\n.stage {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  overflow: hidden;\n  border: 2px solid var(--ink);\n  border-radius: 16px;\n  background: #c9c29a;\n}\n\n.portrait {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: 50% 0;\n}\n\n.nameplate {\n  position: absolute;\n  inset-inline-start: 12px;\n  bottom: 12px;\n  max-width: 55%;\n  margin: 0;\n  padding: 6px 12px;\n  border-inline-start: 5px solid #e9a15f;\n  border-radius: 4px;\n  background: var(--plate);\n  color: #ffffff;\n}\n\n.nameplate-name {\n  display: block;\n  font-weight: 700;\n  font-size: clamp(0.95rem, 2.4vh, 1.1rem);\n}\n\n.nameplate-role {\n  display: block;\n  font-size: clamp(0.75rem, 1.9vh, 0.9rem);\n}\n\n.bubble {\n  position: absolute;\n  z-index: 2;\n  top: 5%;\n  left: 68%;\n  width: min(340px, calc(100vw - 36px - 0.68 * var(--scene-size)));\n  padding: 10px 14px 12px;\n  transform-origin: 0 50%;\n}\n\n.bubble.is-empty {\n  opacity: 0;\n  pointer-events: none;\n}\n\n.bubble-shape {\n  position: absolute;\n  top: 0;\n  left: 0;\n  z-index: -1;\n  overflow: visible;\n  pointer-events: none;\n  filter: drop-shadow(0 6px 6px rgba(43, 33, 24, 0.25));\n}\n\n.bubble-path {\n  fill: var(--card);\n  stroke: var(--ink);\n  stroke-width: 2;\n  stroke-linejoin: round;\n}\n\n.bubble-name {\n  display: block;\n  margin-bottom: 2px;\n  color: var(--accent);\n  font-size: 0.75rem;\n  font-weight: 700;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n\n.bubble-text {\n  margin: 0;\n  font-size: clamp(0.82rem, 1.5vw, 1rem);\n  line-height: 1.3;\n}\n\n@keyframes bubble-pop {\n  from { opacity: 0; transform: scale(0.85); }\n  to { opacity: 1; transform: scale(1); }\n}\n\n@media (prefers-reduced-motion: no-preference) {\n  .bubble.is-popping { animation: bubble-pop 0.2s ease-out; }\n}\n\n.panel {\n  align-self: end;\n  min-width: 0;\n  margin: 0;\n}\n\n.panel-title {\n  margin: 0 0 8px;\n  font-size: clamp(1.05rem, 2.6vh, 1.4rem);\n  line-height: 1.2;\n}\n\n.questions {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  gap: 10px 22px;\n  margin: 0 0 0 9px;\n  padding: 0;\n  list-style: none;\n}\n\n.question {\n  position: relative;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 2px 10px;\n  width: 100%;\n  min-height: 44px;\n  padding: 6px 14px;\n  border: 2px solid var(--ink);\n  border-radius: 24px;\n  background: var(--card);\n  color: var(--ink);\n  font: inherit;\n  font-size: clamp(0.82rem, 1.5vw, 1rem);\n  font-weight: 700;\n  text-align: start;\n  cursor: pointer;\n}\n\n.question::before {\n  content: \"\";\n  position: absolute;\n  top: 50%;\n  inset-inline-start: -9px;\n  width: 14px;\n  height: 14px;\n  margin-top: -7px;\n  border-bottom: 2px solid var(--ink);\n  border-left: 2px solid var(--ink);\n  background: inherit;\n  transform: rotate(45deg);\n}\n\n.question:hover { background: #fbeadb; }\n\n.question[aria-pressed=\"true\"] {\n  background: var(--accent);\n  color: var(--accent-ink);\n}\n\n.question:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 3px;\n}\n\n.asked-tag[hidden] { display: none; }\n\n.asked-tag {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 0.85em;\n  font-weight: 700;\n  color: var(--asked);\n}\n\n.question[aria-pressed=\"true\"] .asked-tag { color: var(--accent-ink); }\n\n.asked-check {\n  width: 16px;\n  height: 16px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2.4;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.progress {\n  margin: 10px 0 0;\n  font-size: clamp(0.85rem, 1.5vw, 1rem);\n  font-weight: 700;\n}\n\n.done {\n  margin: 6px 0 0;\n  padding: 6px 12px;\n  border-inline-start: 5px solid var(--asked);\n  background: #e7efdc;\n  font-size: clamp(0.85rem, 1.5vw, 1rem);\n}\n\n.done:empty { display: none; }\n\n.error {\n  margin: 8px 0 0;\n  padding: 10px 14px;\n  border: 2px solid var(--accent);\n  background: var(--card);\n}\n\n@media (min-width: 1100px) {\n  .questions { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n}\n\n@media (max-width: 639px) {\n  html, body {\n    height: auto;\n    overflow: auto;\n  }\n\n  .app {\n    display: block;\n    height: auto;\n    padding: 16px;\n  }\n\n  .layout { display: block; }\n\n  .scene {\n    width: 100%;\n    height: auto;\n  }\n\n  .stage { height: auto; }\n\n  .portrait {\n    height: auto;\n    aspect-ratio: 10 / 7;\n  }\n\n  .nameplate { max-width: 80%; }\n\n  .bubble {\n    position: relative;\n    top: auto;\n    left: auto;\n    width: auto;\n    min-height: 9rem;\n    margin-top: 28px;\n    transform-origin: 50% 0;\n  }\n\n  .panel { margin-top: 24px; }\n\n  .questions { margin-inline-start: 0; }\n}\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "8",
