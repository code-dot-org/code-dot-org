        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <style>\n      ul {\n        font-size: 14px;\n        font-weight: bold;\n      }\n      ol {\n        font-size: 14px;\n        text-decoration: underline;\n      }\n    </style>\n  </head>\n  <body>\n    <h1>The Golden Spoon Menu</h1>\n\n    <h2>Starters</h2>\n    <p>Perfect bites to begin your meal.</p>\n    <ul>\n      <li>Spring Rolls — crispy rolls with vegetables and dipping sauce</li>\n      <li>Soup of the Day — ask your server for today's selection</li>\n      <li>Bruschetta — toasted bread with tomato and basil</li>\n    </ul>\n\n    <h2>Mains</h2>\n    <p>Hearty dishes made with seasonal ingredients.</p>\n    <ul>\n      <li>Grilled Salmon — served with roasted vegetables and lemon butter</li>\n      <li>Mushroom Risotto — creamy arborio rice with wild mushrooms</li>\n      <li>Jerk Chicken — marinated chicken with rice and peas</li>\n    </ul>\n\n    <h2>Desserts</h2>\n    <p>Sweet endings to a great meal.</p>\n    <ol>\n      <li>Chocolate Lava Cake</li>\n      <li>Mango Sorbet</li>\n      <li>Churros with Caramel Sauce</li>\n    </ol>\n\n  </body>\n</html>",
