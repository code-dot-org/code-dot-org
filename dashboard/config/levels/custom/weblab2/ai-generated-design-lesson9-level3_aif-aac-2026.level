      "files": {
        "2": {
          "id": "2",
          "name": "styles.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  font-family: Arial, Helvetica, sans-serif;\n  font-size: 13px;\n  color: #222;\n  background: #ffffff;\n}\n\n.site {\n  display: flex;\n  flex-direction: column;\n  min-height: 100vh;\n}\n\n/* Header */\n.header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 10px 14px;\n  background: #f2f2f2;\n}\n\n.title {\n  font-weight: 700;\n  font-size: 12px;\n}\n\n/* Low contrast + tiny target */\n.nav-link {\n  color: #9a9acb;\n  text-decoration: underline;\n  padding: 1px 3px;\n  font-size: 11px;\n}\n\n/* Intentionally bad: remove visible focus */\n.nav-link:focus,\n.tiny-btn:focus,\n.input:focus,\n.primary:focus {\n  outline: none;\n  box-shadow: none;\n}\n\n/* Hero */\n.hero {\n  padding: 14px;\n  background: #f5f5f5;\n}\n\n.hero-img {\n  width: 100%;\n  height: 180px;\n  object-fit: cover;\n  display: block;\n}\n\n/* Very low contrast text */\n.muted {\n  color: #c9c9c9;\n  font-size: 11px;\n  margin-top: 10px;\n  margin-bottom: 10px;\n}\n\n/* Small button (hard to tap) */\n.tiny-btn {\n  font-size: 9px;\n  padding: 1px 4px;\n  border: 1px solid #bcbcbc;\n  background: #f7f7f7;\n  color: #222;\n  cursor: pointer;\n}\n\n/* Content */\n.content {\n  padding: 14px;\n}\n\n.section {\n  margin-bottom: 14px;\n}\n\n/* Looks like heading but not semantic */\n.section-title {\n  font-weight: 700;\n  font-size: 16px;\n  margin-bottom: 8px;\n}\n\n.section p {\n  margin-top: 0;\n  margin-bottom: 12px;\n  line-height: 1.35;\n}\n\n/* Form */\n.input {\n  padding: 5px 6px;\n  font-size: 11px;\n  width: 180px;\n  margin-right: 8px;\n  border: 1px solid #bdbdbd;\n}\n\n/* Slightly low contrast primary button */\n.primary {\n  background: #4d8ed6;\n  color: #ffffff;\n  border: none;\n  padding: 5px 8px;\n  font-size: 11px;\n  cursor: pointer;\n}\n\n/* Footer */\n.footer {\n  margin-top: auto;\n  padding: 10px 14px;\n  background: #f2f2f2;\n  font-size: 12px;\n  color: #555;\n}\n\n/* Cards */\n.cards {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));\n  gap: 12px;\n  margin-top: 8px;\n}\n\n.card {\n  background: #ffffff;\n  border: 1px solid #e2e2e2;\n  padding: 8px;\n}\n\n.card-img {\n  width: 100%;\n  height: 140px;\n  object-fit: cover;\n  display: block;\n}\n\n/* Styled like heading but still div */\n.card-title {\n  font-weight: 700;\n  font-size: 14px;\n  margin: 6px 0;\n}\n\n.card p {\n  line-height: 1.3;\n  margin-bottom: 8px;\n}\n\n/* Mobile issues (intentionally poor) */\n@media (max-width: 700px) {\n  .header {\n    padding: 6px 8px;\n  }\n\n  .title {\n    font-size: 10px;\n  }\n\n  .nav-link {\n    font-size: 10px;\n    padding: 0;\n  }\n\n  .hero {\n    padding: 8px;\n  }\n\n  .hero-img {\n    height: 120px;\n  }\n\n  .muted {\n    font-size: 10px;\n  }\n\n  .content {\n    padding: 8px;\n  }\n\n  /* Keep cards too wide so page overflows horizontally */\n  .cards {\n    grid-template-columns: repeat(3, 220px);\n    gap: 8px;\n    overflow-x: auto;\n  }\n\n  .card {\n    padding: 6px;\n  }\n\n  .card-title {\n    font-size: 12px;\n  }\n\n  .card p {\n    font-size: 11px;\n  }\n\n  .tiny-btn {\n    font-size: 8px;\n    padding: 1px 3px;\n  }\n\n  /* Make form awkward on mobile */\n  .input {\n    width: 180px;\n    display: inline-block;\n    margin-right: 6px;\n    margin-bottom: 0;\n    font-size: 10px;\n    padding: 4px 5px;\n  }\n\n  .primary {\n    display: inline-block;\n    font-size: 10px;\n    padding: 4px 6px;\n  }\n\n  .footer {\n    font-size: 10px;\n    padding: 8px;\n  }\n}",
          "folderId": "0",
          "active": false
        },
