        "7": {
          "id": "7",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Umbrella Shop</title>\n  <link rel=\"stylesheet\" href=\"styles.css\">\n</head>\n<body>\n  <div class=\"site\">\n\n    <!-- Header -->\n    <div class=\"header\">\n      <div class=\"title\">RainReady Umbrellas</div>\n      <a href=\"#\" class=\"nav-link\">Click here</a>\n    </div>\n\n    <!-- Hero -->\n    <div class=\"hero\">\n      <!-- Missing alt text -->\n      <img src=\"images/hero.png\" class=\"hero-img\">\n\n      <p class=\"muted\">\n        Stay dry in style with our lightweight, wind-tested umbrellas.\n      </p>\n\n      <button class=\"tiny-btn\">Shop</button>\n    </div>\n\n    <!-- Content -->\n    <div class=\"content\">\n\n      <!-- Products -->\n      <div class=\"section\">\n        <div class=\"section-title\">Products</div>\n\n        <p>\n          Discover durable classics and ultra-compact travel umbrellas.\n          Limited colors available today.\n        </p>\n\n        <div class=\"cards\">\n\n          <div class=\"card\">\n            <!-- Missing alt text -->\n            <img src=\"images/product1.png\" class=\"card-img\">\n\n            <div class=\"card-title\">Classic Umbrella</div>\n            <p>Sturdy steel frame with ergonomic handle.</p>\n\n            <button class=\"tiny-btn\">Add</button>\n          </div>\n\n          <div class=\"card\">\n            <!-- Missing alt text -->\n            <img src=\"images/product2.png\" class=\"card-img\">\n\n            <div class=\"card-title\">Travel Mini</div>\n            <p>Pocket-size design for on-the-go coverage.</p>\n\n            <button class=\"tiny-btn\">Add</button>\n          </div>\n\n          <div class=\"card\">\n            <!-- Missing alt text -->\n            <img src=\"images/product3.png\" class=\"card-img\">\n\n            <!-- Slightly vague product name -->\n            <div class=\"card-title\">Model X</div>\n            <p>Reinforced canopy built for gusty days.</p>\n\n            <button class=\"tiny-btn\">Add</button>\n          </div>\n\n        </div>\n      </div>\n\n      <!-- Order -->\n      <div class=\"section\">\n        <div class=\"section-title\">Order</div>\n\n        <!-- No label, only placeholder -->\n        <input type=\"text\" class=\"input\" placeholder=\"Your name\">\n\n        <!-- Vague action -->\n        <button class=\"primary\">Continue</button>\n      </div>\n\n    </div>\n\n    <!-- Footer -->\n    <div class=\"footer\">\n      <div>© 2025 RainReady Co</div>\n    </div>\n\n  </div>\n</body>\n</html>\n",
          "folderId": "0",
          "active": true
        },
