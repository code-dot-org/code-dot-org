          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    \n    <!-- instruction paragraph -->\n    <p>Add the \"hover\" and \"active\" pseudo-classes to this link in the CSS file:</p> \n    \n    <!-- hyperlink to another page -->\n    <a href=\"another-page.html\">Another Page</a>\n\n\n\n  </body>\n</html>",
          "active": true,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* 1) Add a rule to style the \"hover\" state of the <a> element */\n\n\n\n\n/* 2) Add a rule to style the \"active\" state of the <a> element. */\n\n\n\n/* paragraph style */\np {\n  font-family: sans-serif;\n  font-size: 24px;\n  background-color: #4cff00;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "another-page.html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    \n    <!-- instruction paragraph -->\n    <p>Add the \"hover\" and \"active\" pseudo-classes to this link in the CSS file:</p> \n    \n    <!-- hyperlink to home page -->\n    <a href=\"index.html\">Go back</a>\n\n\n\n  </body>\n</html>",
          "folderId": "0",
