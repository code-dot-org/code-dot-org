      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Interactive Panel</title>\n    <script src=\"marked-min.js\"></script>\n    <style>\n        :root {\n            --primary-bg: #f5f5f5;\n            --text-color: #333;\n            --accent-color: #ffffff;\n            --container-max-width: 1200px;\n            --min-height: 420px;\n            --min-width: 700px;\n        }\n\n        body {\n            margin: 0;\n            padding: 0;\n            font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n            background-color: var(--primary-bg);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            min-height: 100vh;\n            overflow: hidden;\n            /* Prevent body scroll, rely on container scaling */\n        }\n\n        #error {\n            color: #e74c3c;\n            background: #fef5f5;\n            padding: 12px;\n            border-radius: 4px;\n            display: none;\n            position: absolute;\n            top: 20px;\n            z-index: 1000;\n        }\n\n        .main-wrapper {\n            width: 100%;\n            max-width: var(--container-max-width);\n            padding: 20px;\n            box-sizing: border-box;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n        }\n\n        .slide-container {\n            width: 100%;\n            aspect-ratio: 16 / 9;\n            background-color: #fff;\n            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);\n            border-radius: 8px;\n            /* Changed to visible to prevent hotspot tooltip clipping */\n            overflow: visible;\n            position: relative;\n            display: flex;\n            min-width: var(--min-width);\n            min-height: var(--min-height);\n        }\n\n        /* Fallback for browsers not supporting aspect-ratio */\n        @supports not (aspect-ratio: 16/9) {\n            .slide-container {\n                height: 0;\n                padding-bottom: 56.25%;\n                /* 9/16 */\n            }\n        }\n\n        .left-column {\n            flex: 1;\n            height: 100%;\n            /* Changed to visible to prevent hotspot tooltip clipping */\n            overflow: visible;\n            background: transparent;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            position: relative;\n            /* Fix for absolute hotspots */\n        }\n\n        .left-column img {\n            max-width: 100%;\n            max-height: 100%;\n            object-fit: contain;\n            display: block;\n        }\n\n        .left-column,\n        .right-column {\n            transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n            opacity: 1;\n            transform: scale(1);\n        }\n\n        .slide-container.switching .left-column,\n        .slide-container.switching .right-column {\n            opacity: 0;\n            transform: scale(0.98);\n        }\n\n        .right-column {\n            flex: 1;\n            height: 100%;\n            padding: 40px;\n            box-sizing: border-box;\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            color: var(--accent-color);\n            background: transparent;\n        }\n\n        .right-column .slide-header {\n            font-size: clamp(1.5rem, 4vw, 2.5rem);\n            margin: 0 0 20px 0;\n            line-height: 1.2;\n            font-weight: bold;\n        }\n\n        .right-column .slide-header h1,\n        .right-column .slide-header h2,\n        .right-column .slide-header p {\n            font-size: inherit;\n            margin: 0;\n            line-height: inherit;\n            color: inherit;\n        }\n\n        .right-column .slide-text {\n            font-size: clamp(1rem, 2vw, 1.2rem);\n            line-height: 1.6;\n            margin: 0;\n            background-color: rgb(243, 243, 243);\n            padding: 20px;\n            border-radius: 12px;\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            color: black;\n            overflow-y: auto;\n        }\n\n        .right-column .slide-text p:first-child {\n            margin-top: 0;\n        }\n\n        .right-column .slide-text p:last-child {\n            margin-bottom: 0;\n        }\n\n        .right-column .slide-text h1,\n        .right-column .slide-text h2,\n        .right-column .slide-text h3 {\n            margin-top: 0;\n            margin-bottom: 10px;\n            line-height: 1.2;\n        }\n\n        .return-btn {\n            position: absolute;\n            bottom: 20px;\n            right: 20px;\n            width: 44px;\n            height: 44px;\n            background: rgba(255, 255, 255, 0.2);\n            border: none;\n            border-radius: 50%;\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            transition: background 0.2s;\n            z-index: 10;\n        }\n\n        .return-btn:hover {\n            background: rgba(255, 255, 255, 0.4);\n        }\n\n        .return-btn svg {\n            width: 24px;\n            height: 24px;\n            fill: white;\n        }\n\n        /* Hotspot Styles */\n        .hotspot {\n            position: absolute;\n            width: 24px;\n            height: 24px;\n            background: rgba(255, 255, 255, 0.85);\n            border-radius: 50%;\n            border: 2px solid #3498db;\n            cursor: pointer;\n            transform: translate(-50%, -50%);\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);\n            transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n            z-index: 100;\n        }\n\n        .hotspot .hotspot-dot {\n            width: 8px;\n            height: 8px;\n            background: #3498db;\n            border-radius: 50%;\n        }\n\n        .hotspot:hover {\n            transform: translate(-50%, -50%) scale(1.2);\n            background: #fff;\n            box-shadow: 0 0 20px rgba(52, 152, 219, 0.6);\n        }\n\n        .hotspot-label {\n            position: absolute;\n            background: #fff;\n            color: #333;\n            padding: 5px 12px;\n            border-radius: 4px;\n            font-size: 13px;\n            font-weight: 600;\n            white-space: nowrap;\n            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);\n            /* Ensure tooltips are above everything, including other hotspots */\n            z-index: 1000;\n            pointer-events: none;\n            /* Initial default position, will be overridden by JS if config keys exist */\n            left: 20px;\n            top: -10px;\n            transition: transform 0.2s ease;\n        }\n\n        /* Adjust labels if they are on the far right */\n        .hotspot.left-side .hotspot-label {\n            left: auto;\n            right: 20px;\n        }\n\n        /* Ensure label stays visible even when parent scales */\n        .hotspot:hover .hotspot-label {\n            z-index: 2000;\n        }\n\n        /* Title Layout Styles */\n        .layout-title .left-column {\n            flex: none;\n            width: 100%;\n        }\n\n        .layout-title .right-column {\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 80%;\n            max-width: 600px;\n            height: auto;\n            text-align: center;\n            background-color: rgba(0, 0, 0, 0.6);\n            /* Default fallback */\n            padding: 40px;\n            border-radius: 20px;\n            backdrop-filter: blur(8px);\n            -webkit-backdrop-filter: blur(8px);\n            border: 1px solid rgba(255, 255, 255, 0.2);\n            z-index: 50;\n        }\n\n        .layout-title .right-column h1 {\n            font-size: clamp(2rem, 6vw, 3.5rem);\n            margin-bottom: 20px;\n            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);\n        }\n\n        .layout-title .right-column .slide-text {\n            background-color: transparent;\n            border: none;\n            color: white;\n            font-size: clamp(1.2rem, 3vw, 1.5rem);\n            padding: 0;\n            text-shadow: 0 2px 5px rgba(0, 0, 0, 0.5);\n        }\n\n        .layout-title .return-btn {\n            display: none;\n            /* Usually title slides don't need a return btn back to themselves */\n        }\n\n        /* Quarter Layout Styles */\n        .layout-quarter {\n            flex-direction: row;\n            /* Default */\n        }\n\n        .layout-quarter.display-top {\n            flex-direction: column;\n        }\n\n        .layout-quarter.display-bottom {\n            flex-direction: column-reverse;\n        }\n\n        .layout-quarter.display-left {\n            flex-direction: row;\n        }\n\n        .layout-quarter.display-right {\n            flex-direction: row-reverse;\n        }\n\n        .layout-quarter .left-column {\n            flex: 3;\n            /* 75% */\n            height: 100%;\n            width: 100%;\n        }\n\n        .layout-quarter .right-column {\n            flex: 1;\n            /* 25% */\n            background-color: #f0f0f0;\n            color: #333;\n            padding: 24px;\n            position: relative;\n            display: flex;\n            flex-direction: column;\n            justify-content: flex-start;\n            height: 100%;\n            box-sizing: border-box;\n        }\n\n        .layout-quarter.display-top .left-column,\n        .layout-quarter.display-bottom .left-column {\n            height: 70%;\n        }\n\n        .layout-quarter.display-top .right-column,\n        .layout-quarter.display-bottom .right-column {\n            height: 30%;\n            width: 100%;\n        }\n\n        .layout-quarter .right-column .slide-header {\n            font-size: clamp(1.2rem, 3vw, 1.8rem);\n            margin-bottom: 12px;\n            color: inherit;\n        }\n\n        .layout-quarter .right-column .slide-text {\n            font-size: clamp(0.9rem, 1.5vw, 1.1rem);\n            background: transparent;\n            padding: 0;\n            border: none;\n            color: inherit;\n        }\n\n        .layout-quarter .return-btn {\n            background: rgba(0, 0, 0, 0.1);\n            bottom: 15px;\n            right: 15px;\n        }\n\n        .layout-quarter .return-btn svg {\n            fill: #333;\n        }\n\n        /* Responsive scaling down */\n        @media (max-width: 740px) {\n            .main-wrapper {\n                padding: 10px;\n            }\n\n            .slide-container {\n                min-width: auto;\n                min-height: auto;\n                width: 700px;\n                transform: scale(calc(100vw / 740));\n                transform-origin: center top;\n            }\n        }\n    </style>\n</head>\n\n<body>\n\n    <div id=\"error\"></div>\n\n    <div class=\"main-wrapper\">\n        <div id=\"slide-container\" class=\"slide-container\">\n            <div class=\"left-column\" id=\"img-container\">\n                <img id=\"slide-img\" src=\"\" alt=\"Slide Image\"\n                    onerror=\"this.style.display='none'; document.getElementById('img-fallback').style.display='flex'\">\n                <div id=\"img-fallback\"\n                    style=\"display:none; width:100%; height:100%; align-items:center; justify-content:center; padding:40px; text-align:center; box-sizing:border-box; color:#666; font-style:italic;\">\n                    <p id=\"fallback-text\"></p>\n                </div>\n            </div>\n            <div id=\"content-col\" class=\"right-column\">\n                <div id=\"slide-header\" class=\"slide-header\"></div>\n                <div id=\"slide-text\" class=\"slide-text\"></div>\n                <button id=\"return-btn\" class=\"return-btn\" title=\"Return\">\n                    <svg viewBox=\"0 0 24 24\">\n                        <path d=\"M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z\" />\n                    </svg>\n                </button>\n            </div>\n        </div>\n    </div>\n\n    <!-- Load Config -->\n    <script src=\"initialConfig.js\"></script>\n\n    <script>\n        (function () {\n            const elements = {\n                container: document.getElementById('slide-container'),\n                img: document.getElementById('slide-img'),\n                header: document.getElementById('slide-header'),\n                text: document.getElementById('slide-text'),\n                contentCol: document.getElementById('content-col'),\n                returnBtn: document.getElementById('return-btn'),\n                error: document.getElementById('error')\n            };\n\n            let currentSlideId = null;\n\n            function showError(msg) {\n                elements.error.textContent = msg;\n                elements.error.style.display = 'block';\n                setTimeout(() => { elements.error.style.display = 'none'; }, 5000);\n            }\n\n            function preloadImage(url) {\n                return new Promise((resolve) => {\n                    if (!url) return resolve();\n                    const img = new Image();\n                    img.onload = () => resolve();\n                    img.onerror = () => resolve();\n                    img.src = url;\n                });\n            }\n\n            async function renderSlide(slideId) {\n                if (typeof initialConfig === 'undefined' || !initialConfig.slides) {\n                    showError(\"Configuration not found.\");\n                    return;\n                }\n\n                const slide = initialConfig.slides.find(s => s.id === slideId)\n                    || (initialConfig.initialSlideId && initialConfig.slides.find(s => s.id === initialConfig.initialSlideId))\n                    || initialConfig.slides[0];\n\n                if (!slide) {\n                    showError(\"Slide not found.\");\n                    return;\n                }\n\n                // Start transition\n                elements.container.classList.add('switching');\n\n                // Preload image before showing next slide\n                await preloadImage(slide.img_url);\n\n                // Wait for fade out animation to finish (at least partially)\n                await new Promise(r => setTimeout(r, 300));\n\n                // Apply layout class\n                elements.container.className = 'slide-container'; // Reset\n                if (slide.layout) {\n                    elements.container.classList.add(`layout-${slide.layout}`);\n                } else {\n                    elements.container.classList.add('layout-two-column');\n                }\n\n                if (slide.layout === 'quarter' && slide.display) {\n                    elements.container.classList.add(`display-${slide.display}`);\n                }\n\n                // Update DOM\n                elements.img.style.display = 'block';\n                document.getElementById('img-fallback').style.display = 'none';\n\n                elements.img.src = slide.img_url;\n                elements.img.alt = slide.alt_text || 'Slide Image';\n                document.getElementById('fallback-text').textContent = slide.alt_text || 'Image could not be loaded';\n\n                if (typeof marked !== 'undefined') {\n                    marked.setOptions({ breaks: true, gfm: true });\n                    elements.header.innerHTML = slide.header ? marked.parse(slide.header) : '';\n                    elements.text.innerHTML = slide.text ? marked.parse(slide.text) : '';\n                } else {\n                    elements.header.textContent = slide.header || '';\n                    elements.text.textContent = slide.text || '';\n                    if (slide.text) elements.text.innerHTML = slide.text.replace(/\\n/g, '<br>');\n                }\n\n                if (slide.layout === 'title') {\n                    elements.container.style.backgroundColor = slide.background_color || 'rgba(0,0,0,0.6)';\n                } else if (slide.layout === 'quarter') {\n                    elements.container.style.backgroundColor = slide.background_color || '#f0f0f0';\n                } else {\n                    elements.container.style.backgroundColor = slide.background_color || '#333';\n                }\n\n                if (slide.layout === 'quarter') {\n                    elements.returnBtn.style.display = slide.return_id_link ? 'flex' : 'none';\n                } else if (slide.layout === 'title') {\n                    elements.returnBtn.style.display = 'none';\n                } else {\n                    elements.returnBtn.style.display = 'flex';\n                }\n\n                const existingHotspots = elements.container.querySelectorAll('.hotspot');\n                existingHotspots.forEach(h => h.remove());\n\n                if (slide.hotspots && Array.isArray(slide.hotspots)) {\n                    slide.hotspots.forEach(h => {\n                        const hotspotEl = document.createElement('div');\n                        hotspotEl.className = 'hotspot';\n                        hotspotEl.style.left = `${h.x}%`;\n                        hotspotEl.style.top = `${h.y}%`;\n\n                        if (h.x > 70) hotspotEl.classList.add('left-side');\n\n                        const palette = (initialConfig.hotspotPalettes && h.palette)\n                            ? initialConfig.hotspotPalettes[h.palette]\n                            : (initialConfig.hotspotPalettes ? initialConfig.hotspotPalettes.blue : null);\n\n                        if (palette) {\n                            hotspotEl.style.borderColor = palette.primary;\n                            hotspotEl.style.backgroundColor = palette.secondary;\n                        }\n\n                        const dotEl = document.createElement('div');\n                        dotEl.className = 'hotspot-dot';\n                        if (palette) dotEl.style.backgroundColor = palette.primary;\n                        hotspotEl.appendChild(dotEl);\n\n                        const labelEl = document.createElement('div');\n                        labelEl.className = 'hotspot-label';\n                        labelEl.textContent = h.label;\n\n                        if (h.label_x !== undefined) {\n                            labelEl.style.left = `${h.label_x}px`;\n                            // If user manually set a negative offset that moves it too far left, \n                            // we don't force 'left-side' class which would flip it back right.\n                            if (h.label_x < 0) hotspotEl.classList.remove('left-side');\n                        }\n                        if (h.label_y !== undefined) labelEl.style.top = `${h.label_y}px`;\n\n                        hotspotEl.appendChild(labelEl);\n\n                        hotspotEl.onclick = (e) => {\n                            e.stopPropagation();\n                            if (h.target_id) renderSlide(h.target_id);\n                        };\n\n                        document.getElementById('img-container').appendChild(hotspotEl);\n                    });\n                }\n\n                elements.returnBtn.onclick = (e) => {\n                    e.preventDefault();\n                    if (slide.return_id_link) renderSlide(slide.return_id_link);\n                };\n\n                currentSlideId = slide.id;\n\n                // End transition - wait a frame to ensure DOM updates applied before fading in\n                requestAnimationFrame(() => {\n                    elements.container.classList.remove('switching');\n                });\n            }\n\n            // Initialize after the config script has likely executed\n            // We use document.readyState to check if we can start immediately\n            if (document.readyState === 'loading') {\n                document.addEventListener('DOMContentLoaded', () => renderSlide());\n            } else {\n                renderSlide();\n            }\n        })();\n    </script>\n</body>\n\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "initialConfig.js",
          "contents": "let initialConfig = {\n  hotspotPalettes: {\n    blue: { primary: \"#217dbb\", secondary: \"#D6EAF8\" },\n    red: { primary: \"#c0392b\", secondary: \"#FADBD8\" },\n    green: { primary: \"#1e8449\", secondary: \"#D5F5E3\" },\n    orange: { primary: \"#a04000\", secondary: \"#FDEBD0\" },\n    purple: { primary: \"#76448a\", secondary: \"#EBDEF0\" },\n    yellow: { primary: \"#9a7d0a\", secondary: \"#FCF3CF\" },\n    teal: { primary: \"#117864\", secondary: \"#D1F2EB\" },\n    pink: { primary: \"#880e4f\", secondary: \"#F8BBD0\" },\n    indigo: { primary: \"#1a237e\", secondary: \"#C5CAE9\" },\n    brown: { primary: \"#4e342e\", secondary: \"#D7CCC8\" },\n    grey: { primary: \"#515a5a\", secondary: \"#E5E8E8\" },\n    black: { primary: \"#17202a\", secondary: \"#D1D5D8\" },\n    white: { primary: \"#7f8c8d\", secondary: \"#FDFEFE\" },\n    cyan: { primary: \"#00838f\", secondary: \"#B2EBF2\" },\n    lime: { primary: \"#558b2f\", secondary: \"#DCEDC8\" },\n    amber: { primary: \"#ff8f00\", secondary: \"#FFECB3\" }\n  },\n\n  // Start here\n  initialSlideId: \"title-slide\",\n\n  slides: [\n    // Title\n    {\n      id: \"title-slide\",\n      layout: \"quarter\",\n      display: \"top\",\n      img_url: \"images/title.jpg\",\n      header: \"Can your photos tell a story you didn't mean to share?\",\n      text: \"Every time you take a photo or post a message, you leave behind *digital breadcrumbs* called **metadata**. While a photo looks like just a picture to us, AI systems see it as a collection of data points: GPS coordinates, timestamps, and even the type of phone you used. By using pattern recognition, AI can connect these small, public details to build a private map of your life, habits, and location.\",\n      alt_text: \"An introduction to how metadata can reveal personal details.\",\n      background_color: \"#c9dfed\",\n      hotspots: [\n        {\n          \"x\": 29.63,\n          \"y\": 63.04,\n          \"label\": \"GPS\",\n          \"target_id\": \"one\",\n          \"label_x\": -5,\n          \"label_y\": 38,\n          \"palette\": \"black\"\n        },\n        {\n          \"x\": 48.03,\n          \"y\": 13.97,\n          \"label\": \"Background Detective\",\n          \"target_id\": \"two\",\n          \"label_x\": -55,\n          \"label_y\": 39,\n          \"palette\": \"black\"\n        },\n        {\n          \"x\": 69.93,\n          \"y\": 47.87,\n          \"label\": \"Shadow Profile\",\n          \"target_id\": \"three\",\n          \"label_x\": -40,\n          \"label_y\": 41,\n          \"palette\": \"black\"\n        }\n      ]\n    },\n\n    // Branch 1: GPS\n    {\n      id: \"one\",\n      layout: \"two-column\",\n      img_url: \"images/one.jpg\",\n      header: \"Does every selfie come with a map?\",\n      text: \"Most smartphones automatically attach data to photos, which can include the exact latitude and longitude of where the picture was taken. AI tools can instantly read this hidden data to pinpoint a person's home or school, even if the background of the photo is just a plain wall.\\n\\n**Further Research Prompt:** What are examples of data that can be hidden in images?\",\n      alt_text: \"A slide about GPS metadata embedded in photos.\",\n      background_color: \"#4da2c6\",\n      return_id_link: \"title-slide\",\n      hotspots: [\n        {\n          \"x\": 67.89,\n          \"y\": 17.78,\n          \"label\": \"The Hidden Map\",\n          \"target_id\": \"one-one\",\n          \"label_x\": -39,\n          \"label_y\": 39,\n          \"palette\": \"amber\"\n        },\n        {\n          \"x\": 51.68,\n          \"y\": 46.2,\n          \"label\": \"Auto-Tagging\",\n          \"target_id\": \"one-two\",\n          \"label_x\": 34,\n          \"label_y\": 1,\n          \"palette\": \"amber\"\n        },\n        {\n          \"x\": 29.45,\n          \"y\": 85.44,\n          \"label\": \"Check the Source\",\n          \"target_id\": \"one-three\",\n          \"label_x\": 34,\n          \"label_y\": 1,\n          \"palette\": \"amber\"\n        }\n      ]\n    },\n    {\n      id: \"one-one\",\n      layout: \"two-column\",\n      img_url: \"images/one-one.jpg\",\n      header: \"\",\n      text: \"AI doesn't just see a cool sunset, it reads the digital tag that says exactly which billboard you were standing on.\",\n      alt_text: \"GPS metadata can reveal precise location.\",\n      background_color: \"#4da2c6\",\n      return_id_link: \"one\"\n    },\n    {\n      id: \"one-two\",\n      layout: \"two-column\",\n      img_url: \"images/one-two.jpg\",\n      header: \"\",\n      text: \"Leaving **Location Services** on for your camera app means you are sharing your physical address with every upload.\",\n      alt_text: \"Location services can attach location data to photos.\",\n      background_color: \"#4da2c6\",\n      return_id_link: \"one\"\n    },\n    {\n      id: \"one-three\",\n      layout: \"two-column\",\n      img_url: \"images/one-three.jpg\",\n      header: \"\",\n      text: \"Before posting, ask: Does this digital file contain more information than just the pixels I see?\",\n      alt_text: \"Think about what hidden data might be included before posting.\",\n      background_color: \"#4da2c6\",\n      return_id_link: \"one\"\n    },\n\n    // Branch 2: Background Detective\n    {\n      id: \"two\",\n      layout: \"two-column\",\n      img_url: \"images/two.jpg\",\n      header: \"Can AI 'see' what you ignore?\",\n      text: \"Computer vision, a type of AI, is incredibly good at identifying logos or unique landmarks in the blurry background of your videos. While you focus on a face, AI might be cataloging visible data.\\n\\n**Further Research Prompt:** How does an AI image recognition system identify a specific location using only a logo and a street sign in the background?\",\n      alt_text: \"A slide about how computer vision can extract clues from backgrounds.\",\n      background_color: \"#78909c\",\n      return_id_link: \"title-slide\",\n      hotspots: [\n        {\n          \"x\": 75.45,\n          \"y\": 45.62,\n          \"label\": \"Pattern Matching\",\n          \"target_id\": \"two-one\",\n          \"label_x\": -42,\n          \"label_y\": -30,\n          \"palette\": \"amber\"\n        },\n        {\n          \"x\": 19.37,\n          \"y\": 85.05,\n          \"label\": \"The Blur Method\",\n          \"target_id\": \"two-two\",\n          \"label_x\": -36,\n          \"label_y\": -31,\n          \"palette\": \"amber\"\n        },\n        {\n          \"x\": 28.57,\n          \"y\": 22.45,\n          \"label\": \"Scan the Perimeter\",\n          \"target_id\": \"two-three\",\n          \"label_x\": -40,\n          \"label_y\": -33,\n          \"palette\": \"amber\"\n        }\n      ]\n    },\n    {\n      id: \"two-one\",\n      layout: \"two-column\",\n      img_url: \"images/two-one.jpg\",\n      header: \"\",\n      text: \"AI can compare a tiny logo on a hat in your room to a database of local stores to guess exactly what neighborhood you live in.\",\n      alt_text: \"Pattern matching can identify location clues.\",\n      background_color: \"#78909c\",\n      return_id_link: \"two\"\n    },\n    {\n      id: \"two-two\",\n      layout: \"two-column\",\n      img_url: \"images/two-two.jpg\",\n      header: \"\",\n      text: \"Best practice: Use a *background blur* or a virtual background during calls to keep your private living space private.\",\n      alt_text: \"Using blur or virtual backgrounds reduces background information.\",\n      background_color: \"#78909c\",\n      return_id_link: \"two\"\n    },\n    {\n      id: \"two-three\",\n      layout: \"two-column\",\n      img_url: \"images/two-three.jpg\",\n      header: \"\",\n      text: \"Treat your camera frame like a work of art in a public space. Look for *clues* in the background that reveal your private life.\",\n      alt_text: \"Scanning the frame helps you notice revealing background details.\",\n      background_color: \"#78909c\",\n      return_id_link: \"two\"\n    },\n\n    // Branch 3: Shadow Profile\n    {\n      id: \"three\",\n      layout: \"two-column\",\n      img_url: \"images/three.jpg\",\n      header: \"Can AI guess your secrets from your 'likes'?\",\n      text: \"Even if you never post your address, an AI can look at the patterns of when you are online, what local sports teams you follow, and the weather in your photos to create a **Shadow Profile.** This is a high-level guess about who you are based on the digital trail you leave behind.\\n\\n**Further Research Prompt:** How does AI use public data to predict private user details?\",\n      alt_text: \"A slide about inferred profiles created from public activity.\",\n      background_color: \"#117864\",\n      return_id_link: \"title-slide\",\n      hotspots: [\n        {\n          \"x\": 27.8,\n          \"y\": 16.32,\n          \"label\": \"Connecting the Dots\",\n          \"target_id\": \"three-one\",\n          \"label_x\": 39,\n          \"label_y\": 3,\n          \"palette\": \"amber\"\n        },\n        {\n          \"x\": 22.55,\n          \"y\": 53.6,\n          \"label\": \"Moment of Friction\",\n          \"target_id\": \"three-two\",\n          \"label_x\": 37,\n          \"label_y\": 1,\n          \"palette\": \"amber\"\n        },\n        {\n          \"x\": 73.37,\n          \"y\": 57.59,\n          \"label\": \"Unintentional Sharing\",\n          \"target_id\": \"three-three\",\n          \"label_x\": -56,\n          \"label_y\": 37,\n          \"palette\": \"amber\"\n        }\n      ]\n    },\n    {\n      id: \"three-one\",\n      layout: \"two-column\",\n      img_url: \"images/three-one.jpg\",\n      header: \"\",\n      text: \"By analyzing *Public* data like your comments, AI can infer *Sensitive* data like your political views or religious beliefs.\",\n      alt_text: \"Public signals can be used to infer sensitive traits.\",\n      background_color: \"#117864\",\n      return_id_link: \"three\"\n    },\n    {\n      id: \"three-two\",\n      layout: \"two-column\",\n      img_url: \"images/three-two.jpg\",\n      header: \"\",\n      text: \"The tradeoff: Sorting data makes your feeds more *relevant,* but it also means an algorithm knows you better than some of your friends.\",\n      alt_text: \"Personalization increases relevance but also increases inference.\",\n      background_color: \"#117864\",\n      return_id_link: \"three\"\n    },\n    {\n      id: \"three-three\",\n      layout: \"two-column\",\n      img_url: \"images/three-three.jpg\",\n      header: \"\",\n      text: \"Remember: AI systems are shaped by the data you provide. Choose what parts of your identity you want to be *discoverable*.\",\n      alt_text: \"Be intentional about what you share.\",\n      background_color: \"#117864\",\n      return_id_link: \"three\"\n    }\n  ]\n};\n\nconsole.log(initialConfig);\n",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "marked-min.js",
