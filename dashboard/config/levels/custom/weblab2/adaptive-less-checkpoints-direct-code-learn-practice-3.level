<Weblab2>
  <config><![CDATA[{
  "published": true,
  "game_id": 74,
  "created_at": "2026-11-03T04:28:34.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": "true",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Label the sections of a page</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <svg class=\"sprite\" aria-hidden=\"true\" focusable=\"false\">\n    <defs>\n      <!-- Shared panda parts -->\n      <symbol id=\"panda-face\" viewBox=\"0 0 100 90\">\n        <circle class=\"art-black\" cx=\"21\" cy=\"17\" r=\"14\"/>\n        <circle class=\"art-black\" cx=\"79\" cy=\"17\" r=\"14\"/>\n        <ellipse class=\"art-white art-outline\" cx=\"50\" cy=\"50\" rx=\"41\" ry=\"36\"/>\n        <ellipse class=\"art-black\" cx=\"31\" cy=\"46\" rx=\"9.5\" ry=\"12.5\" transform=\"rotate(22 31 46)\"/>\n        <ellipse class=\"art-black\" cx=\"69\" cy=\"46\" rx=\"9.5\" ry=\"12.5\" transform=\"rotate(-22 69 46)\"/>\n        <circle class=\"art-white\" cx=\"32\" cy=\"45\" r=\"3.4\"/>\n        <circle class=\"art-white\" cx=\"68\" cy=\"45\" r=\"3.4\"/>\n        <ellipse class=\"art-black\" cx=\"50\" cy=\"58\" rx=\"6.5\" ry=\"4.5\"/>\n        <path class=\"art-line\" d=\"M43 66 Q50 73 57 66\"/>\n      </symbol>\n      <symbol id=\"panda-face-asleep\" viewBox=\"0 0 100 90\">\n        <circle class=\"art-black\" cx=\"21\" cy=\"17\" r=\"14\"/>\n        <circle class=\"art-black\" cx=\"79\" cy=\"17\" r=\"14\"/>\n        <ellipse class=\"art-white art-outline\" cx=\"50\" cy=\"50\" rx=\"41\" ry=\"36\"/>\n        <ellipse class=\"art-black\" cx=\"31\" cy=\"46\" rx=\"9.5\" ry=\"12.5\" transform=\"rotate(22 31 46)\"/>\n        <ellipse class=\"art-black\" cx=\"69\" cy=\"46\" rx=\"9.5\" ry=\"12.5\" transform=\"rotate(-22 69 46)\"/>\n        <path class=\"art-line-white\" d=\"M26 46 Q32 51 38 46\"/>\n        <path class=\"art-line-white\" d=\"M62 46 Q68 51 74 46\"/>\n        <ellipse class=\"art-black\" cx=\"50\" cy=\"58\" rx=\"6.5\" ry=\"4.5\"/>\n        <path class=\"art-line\" d=\"M45 66 Q50 70 55 66\"/>\n      </symbol>\n      <symbol id=\"panda-sit\" viewBox=\"0 0 140 130\">\n        <ellipse class=\"art-white art-outline\" cx=\"70\" cy=\"96\" rx=\"40\" ry=\"32\"/>\n        <ellipse class=\"art-black\" cx=\"38\" cy=\"96\" rx=\"11\" ry=\"22\" transform=\"rotate(18 38 96)\"/>\n        <ellipse class=\"art-black\" cx=\"102\" cy=\"96\" rx=\"11\" ry=\"22\" transform=\"rotate(-18 102 96)\"/>\n        <ellipse class=\"art-black\" cx=\"48\" cy=\"122\" rx=\"16\" ry=\"8\"/>\n        <ellipse class=\"art-black\" cx=\"92\" cy=\"122\" rx=\"16\" ry=\"8\"/>\n        <use href=\"#panda-face\" x=\"28\" y=\"2\" width=\"84\" height=\"75.6\"/>\n      </symbol>\n      <symbol id=\"panda-asleep\" viewBox=\"0 0 120 100\">\n        <use href=\"#panda-face-asleep\" x=\"6\" y=\"14\" width=\"88\" height=\"79.2\"/>\n        <path class=\"art-z\" d=\"M80 28 h9 l-9 10 h9\"/>\n        <path class=\"art-z\" d=\"M96 4 h14 l-14 15 h14\"/>\n      </symbol>\n      <symbol id=\"bamboo\" viewBox=\"0 0 40 120\">\n        <rect class=\"art-stalk\" x=\"14\" y=\"0\" width=\"12\" height=\"120\" rx=\"4\"/>\n        <rect class=\"art-joint\" x=\"12\" y=\"30\" width=\"16\" height=\"5\" rx=\"2\"/>\n        <rect class=\"art-joint\" x=\"12\" y=\"68\" width=\"16\" height=\"5\" rx=\"2\"/>\n        <rect class=\"art-joint\" x=\"12\" y=\"104\" width=\"16\" height=\"5\" rx=\"2\"/>\n        <path class=\"art-leaf\" d=\"M26 30 Q40 20 40 8 Q28 12 26 30Z\"/>\n        <path class=\"art-leaf\" d=\"M14 68 Q0 58 0 46 Q12 50 14 68Z\"/>\n      </symbol>\n      <symbol id=\"paw\" viewBox=\"0 0 60 60\">\n        <ellipse class=\"art-black\" cx=\"30\" cy=\"41\" rx=\"17\" ry=\"14\"/>\n        <circle class=\"art-black\" cx=\"11\" cy=\"25\" r=\"6\"/>\n        <circle class=\"art-black\" cx=\"24\" cy=\"13\" r=\"6.5\"/>\n        <circle class=\"art-black\" cx=\"38\" cy=\"13\" r=\"6.5\"/>\n        <circle class=\"art-black\" cx=\"51\" cy=\"25\" r=\"6\"/>\n      </symbol>\n      <symbol id=\"arrow\" viewBox=\"0 0 50 50\">\n        <path class=\"art-arrow\" d=\"M8 4 L8 38 L17 30 L24 46 L31 43 L24 27 L37 27 Z\"/>\n      </symbol>\n\n      <!-- Panda site -->\n      <symbol id=\"hero-panda\" viewBox=\"0 0 140 130\">\n        <image href=\"panda.png\" x=\"42\" y=\"0\" width=\"98\" height=\"130\"/>\n        <use href=\"#bamboo\" x=\"12\" y=\"8\" width=\"36\" height=\"108\" transform=\"rotate(12 30 62)\"/>\n      </symbol>\n      <symbol id=\"card-panda-1\" viewBox=\"0 0 60 60\">\n        <use href=\"#bamboo\" x=\"18\" y=\"0\" width=\"20\" height=\"60\"/>\n      </symbol>\n      <symbol id=\"card-panda-2\" viewBox=\"0 0 60 60\">\n        <use href=\"#panda-asleep\" x=\"0\" y=\"6\" width=\"60\" height=\"50\"/>\n      </symbol>\n      <symbol id=\"card-panda-3\" viewBox=\"0 0 60 60\">\n        <use href=\"#paw\" x=\"4\" y=\"4\" width=\"52\" height=\"52\"/>\n      </symbol>\n      <symbol id=\"canvas-panda\" viewBox=\"0 0 300 100\">\n        <use href=\"#bamboo\" x=\"46\" y=\"5\" width=\"30\" height=\"90\" transform=\"rotate(-8 61 50)\"/>\n        <use href=\"#arrow\" x=\"104\" y=\"28\" width=\"44\" height=\"44\"/>\n        <use href=\"#panda-sit\" x=\"172\" y=\"2\" width=\"107\" height=\"99\"/>\n      </symbol>\n\n      <!-- Pizza site -->\n      <symbol id=\"pizza\" viewBox=\"0 0 116 116\">\n        <circle class=\"art-crust\" cx=\"58\" cy=\"58\" r=\"56\"/>\n        <circle class=\"art-cheese\" cx=\"58\" cy=\"58\" r=\"45\"/>\n        <circle class=\"art-pepperoni\" cx=\"42\" cy=\"42\" r=\"9\"/>\n        <circle class=\"art-pepperoni\" cx=\"76\" cy=\"44\" r=\"9\"/>\n        <circle class=\"art-pepperoni\" cx=\"58\" cy=\"68\" r=\"9\"/>\n        <circle class=\"art-pepperoni\" cx=\"36\" cy=\"72\" r=\"8\"/>\n        <circle class=\"art-pepperoni\" cx=\"82\" cy=\"76\" r=\"8\"/>\n        <circle class=\"art-pepperoni-dot\" cx=\"39\" cy=\"39\" r=\"2.6\"/>\n        <circle class=\"art-pepperoni-dot\" cx=\"73\" cy=\"41\" r=\"2.6\"/>\n        <circle class=\"art-pepperoni-dot\" cx=\"55\" cy=\"65\" r=\"2.6\"/>\n        <ellipse class=\"art-basil\" cx=\"58\" cy=\"28\" rx=\"7\" ry=\"4\" transform=\"rotate(-30 58 28)\"/>\n        <ellipse class=\"art-basil\" cx=\"26\" cy=\"56\" rx=\"7\" ry=\"4\" transform=\"rotate(40 26 56)\"/>\n        <ellipse class=\"art-basil\" cx=\"92\" cy=\"58\" rx=\"7\" ry=\"4\" transform=\"rotate(-50 92 58)\"/>\n      </symbol>\n      <symbol id=\"pepperoni\" viewBox=\"0 0 50 50\">\n        <circle class=\"art-pepperoni\" cx=\"25\" cy=\"25\" r=\"22\"/>\n        <circle class=\"art-pepperoni-dot\" cx=\"17\" cy=\"17\" r=\"3.4\"/>\n        <circle class=\"art-pepperoni-dot\" cx=\"32\" cy=\"22\" r=\"3\"/>\n        <circle class=\"art-pepperoni-dot\" cx=\"22\" cy=\"33\" r=\"3.2\"/>\n      </symbol>\n      <symbol id=\"hero-pizza\" viewBox=\"0 0 140 130\">\n        <use href=\"#pizza\" x=\"18\" y=\"8\" width=\"116\" height=\"116\"/>\n      </symbol>\n      <symbol id=\"card-pizza-1\" viewBox=\"0 0 60 60\">\n        <path class=\"art-cheese\" d=\"M30 57 L8 14 Q30 4 52 14 Z\"/>\n        <path class=\"art-crust\" d=\"M5 11 Q30 -1 55 11 L52 18 Q30 9 8 18Z\"/>\n        <circle class=\"art-pepperoni\" cx=\"22\" cy=\"27\" r=\"4.5\"/>\n        <circle class=\"art-pepperoni\" cx=\"37\" cy=\"26\" r=\"4.5\"/>\n        <circle class=\"art-pepperoni\" cx=\"30\" cy=\"41\" r=\"4.5\"/>\n      </symbol>\n      <symbol id=\"card-pizza-2\" viewBox=\"0 0 60 60\">\n        <circle class=\"art-pepperoni\" cx=\"30\" cy=\"35\" r=\"22\"/>\n        <circle class=\"art-pepperoni-dot\" cx=\"21\" cy=\"28\" r=\"3.5\"/>\n        <ellipse class=\"art-basil\" cx=\"22\" cy=\"14\" rx=\"9\" ry=\"4\" transform=\"rotate(-25 22 14)\"/>\n        <ellipse class=\"art-basil\" cx=\"38\" cy=\"14\" rx=\"9\" ry=\"4\" transform=\"rotate(25 38 14)\"/>\n        <ellipse class=\"art-basil\" cx=\"30\" cy=\"11\" rx=\"4\" ry=\"8\"/>\n      </symbol>\n      <symbol id=\"card-pizza-3\" viewBox=\"0 0 60 60\">\n        <path class=\"art-basil\" d=\"M30 56 Q4 42 10 14 Q38 6 50 30 Q52 50 30 56Z\"/>\n        <path class=\"art-line-white\" d=\"M30 54 Q28 36 34 20\"/>\n      </symbol>\n      <symbol id=\"canvas-pizza\" viewBox=\"0 0 300 100\">\n        <use href=\"#pepperoni\" x=\"34\" y=\"26\" width=\"52\" height=\"52\"/>\n        <use href=\"#arrow\" x=\"108\" y=\"28\" width=\"44\" height=\"44\"/>\n        <use href=\"#pizza\" x=\"178\" y=\"4\" width=\"92\" height=\"92\"/>\n      </symbol>\n\n      <!-- Space site -->\n      <symbol id=\"rocket\" viewBox=\"0 0 100 112\">\n        <path class=\"art-flame\" d=\"M36 92 Q50 126 64 92Z\"/>\n        <path class=\"art-flame-core\" d=\"M43 92 Q50 112 57 92Z\"/>\n        <path class=\"art-fin\" d=\"M28 66 L8 98 L28 90Z\"/>\n        <path class=\"art-fin\" d=\"M72 66 L92 98 L72 90Z\"/>\n        <path class=\"art-rocket\" d=\"M50 6 Q74 28 74 64 L74 92 L26 92 L26 64 Q26 28 50 6Z\"/>\n        <circle class=\"art-window\" cx=\"50\" cy=\"48\" r=\"10\"/>\n      </symbol>\n      <symbol id=\"moon\" viewBox=\"0 0 100 100\">\n        <circle class=\"art-moon\" cx=\"50\" cy=\"50\" r=\"48\"/>\n        <circle class=\"art-crater\" cx=\"34\" cy=\"32\" r=\"10\"/>\n        <circle class=\"art-crater\" cx=\"68\" cy=\"50\" r=\"13\"/>\n        <circle class=\"art-crater\" cx=\"40\" cy=\"70\" r=\"7\"/>\n        <circle class=\"art-crater\" cx=\"74\" cy=\"22\" r=\"5\"/>\n      </symbol>\n      <symbol id=\"hero-space\" viewBox=\"0 0 140 130\">\n        <use href=\"#moon\" x=\"52\" y=\"46\" width=\"84\" height=\"84\"/>\n        <use href=\"#rocket\" x=\"12\" y=\"6\" width=\"60\" height=\"67\" transform=\"rotate(38 42 40)\"/>\n        <circle class=\"art-star\" cx=\"16\" cy=\"100\" r=\"3\"/>\n        <circle class=\"art-star\" cx=\"122\" cy=\"20\" r=\"3.5\"/>\n        <circle class=\"art-star\" cx=\"104\" cy=\"8\" r=\"2\"/>\n        <circle class=\"art-star\" cx=\"28\" cy=\"70\" r=\"2\"/>\n      </symbol>\n      <symbol id=\"card-space-1\" viewBox=\"0 0 60 60\">\n        <path class=\"art-star art-star-edge\" d=\"M30 4 L37 22 L56 23 L41 35 L46 54 L30 43 L14 54 L19 35 L4 23 L23 22Z\"/>\n      </symbol>\n      <symbol id=\"card-space-2\" viewBox=\"0 0 60 60\">\n        <circle class=\"art-planet\" cx=\"30\" cy=\"30\" r=\"17\"/>\n        <ellipse class=\"art-ring\" cx=\"30\" cy=\"30\" rx=\"27\" ry=\"8\" transform=\"rotate(-20 30 30)\"/>\n      </symbol>\n      <symbol id=\"card-space-3\" viewBox=\"0 0 60 60\">\n        <path class=\"art-star art-star-edge\" d=\"M38 6 A25 25 0 1 0 54 40 A21 21 0 0 1 38 6Z\"/>\n      </symbol>\n      <symbol id=\"canvas-space\" viewBox=\"0 0 300 100\">\n        <circle class=\"art-star\" cx=\"22\" cy=\"18\" r=\"2.5\"/>\n        <circle class=\"art-star\" cx=\"96\" cy=\"86\" r=\"2\"/>\n        <circle class=\"art-star\" cx=\"150\" cy=\"14\" r=\"2.5\"/>\n        <circle class=\"art-star\" cx=\"196\" cy=\"84\" r=\"2\"/>\n        <circle class=\"art-star\" cx=\"284\" cy=\"20\" r=\"3\"/>\n        <circle class=\"art-star\" cx=\"276\" cy=\"86\" r=\"2\"/>\n        <use href=\"#rocket\" x=\"28\" y=\"19\" width=\"58\" height=\"65\" transform=\"rotate(90 57 51.5)\"/>\n        <use href=\"#arrow\" x=\"110\" y=\"26\" width=\"44\" height=\"44\"/>\n        <use href=\"#moon\" x=\"190\" y=\"8\" width=\"84\" height=\"84\"/>\n      </symbol>\n\n      <!-- Music site -->\n      <symbol id=\"note\" viewBox=\"0 0 30 40\">\n        <ellipse class=\"art-note\" cx=\"9\" cy=\"32\" rx=\"8\" ry=\"6\" transform=\"rotate(-20 9 32)\"/>\n        <rect class=\"art-note\" x=\"14\" y=\"4\" width=\"4\" height=\"28\"/>\n        <path class=\"art-note\" d=\"M18 4 Q30 10 28 22 Q24 14 18 14Z\"/>\n      </symbol>\n      <symbol id=\"hero-music\" viewBox=\"0 0 140 130\">\n        <path class=\"art-headband\" d=\"M28 88 C18 6 112 6 112 88\"/>\n        <rect class=\"art-cup\" x=\"12\" y=\"72\" width=\"32\" height=\"50\" rx=\"14\"/>\n        <rect class=\"art-cup\" x=\"96\" y=\"72\" width=\"32\" height=\"50\" rx=\"14\"/>\n        <rect class=\"art-cup-pad\" x=\"12\" y=\"84\" width=\"12\" height=\"26\" rx=\"6\"/>\n        <rect class=\"art-cup-pad\" x=\"116\" y=\"84\" width=\"12\" height=\"26\" rx=\"6\"/>\n        <use href=\"#note\" x=\"4\" y=\"6\" width=\"26\" height=\"35\"/>\n        <use href=\"#note\" x=\"110\" y=\"4\" width=\"26\" height=\"35\"/>\n      </symbol>\n      <symbol id=\"card-music-1\" viewBox=\"0 0 60 60\">\n        <use href=\"#note\" x=\"10\" y=\"4\" width=\"39\" height=\"52\"/>\n      </symbol>\n      <symbol id=\"card-music-2\" viewBox=\"0 0 60 60\">\n        <path class=\"art-drum\" d=\"M8 22 V46 Q30 58 52 46 V22 Q30 32 8 22Z\"/>\n        <ellipse class=\"art-drum-head\" cx=\"30\" cy=\"22\" rx=\"22\" ry=\"8\"/>\n        <path class=\"art-drum-stick\" d=\"M14 4 L32 20 M46 4 L28 20\"/>\n      </symbol>\n      <symbol id=\"card-music-3\" viewBox=\"0 0 60 60\">\n        <circle class=\"art-vinyl\" cx=\"30\" cy=\"30\" r=\"27\"/>\n        <circle class=\"art-groove\" cx=\"30\" cy=\"30\" r=\"20\"/>\n        <circle class=\"art-groove\" cx=\"30\" cy=\"30\" r=\"14\"/>\n        <circle class=\"art-record-label\" cx=\"30\" cy=\"30\" r=\"8\"/>\n        <circle class=\"art-vinyl\" cx=\"30\" cy=\"30\" r=\"2\"/>\n      </symbol>\n      <symbol id=\"canvas-music\" viewBox=\"0 0 300 100\">\n        <rect class=\"art-pad-a\" x=\"24\" y=\"14\" width=\"34\" height=\"34\" rx=\"7\"/>\n        <rect class=\"art-pad-b\" x=\"62\" y=\"14\" width=\"34\" height=\"34\" rx=\"7\"/>\n        <rect class=\"art-pad-c\" x=\"100\" y=\"14\" width=\"34\" height=\"34\" rx=\"7\"/>\n        <rect class=\"art-pad-d\" x=\"24\" y=\"52\" width=\"34\" height=\"34\" rx=\"7\"/>\n        <rect class=\"art-pad-e\" x=\"62\" y=\"52\" width=\"34\" height=\"34\" rx=\"7\"/>\n        <rect class=\"art-pad-f\" x=\"100\" y=\"52\" width=\"34\" height=\"34\" rx=\"7\"/>\n        <use href=\"#arrow\" x=\"110\" y=\"27\" width=\"44\" height=\"44\"/>\n        <rect class=\"art-speaker\" x=\"184\" y=\"12\" width=\"60\" height=\"76\" rx=\"12\"/>\n        <circle class=\"art-woofer\" cx=\"214\" cy=\"60\" r=\"20\"/>\n        <circle class=\"art-woofer\" cx=\"214\" cy=\"31\" r=\"8\"/>\n        <path class=\"art-wave\" d=\"M254 36 Q266 50 254 64\"/>\n        <path class=\"art-wave\" d=\"M262 26 Q286 50 262 74\"/>\n      </symbol>\n    </defs>\n  </svg>\n\n  <main class=\"widget\">\n\n    <div id=\"error-banner\" class=\"error-banner\" role=\"alert\" hidden>\n      Something went wrong. Reload this page to try again.\n    </div>\n    <noscript>\n      <div class=\"error-banner\">This activity needs JavaScript turned on.</div>\n    </noscript>\n\n    <section class=\"screen\" id=\"intro-screen\" aria-labelledby=\"intro-title\">\n      <span class=\"practice-tag\">Practice</span>\n      <h1 class=\"screen-title\" id=\"intro-title\" tabindex=\"-1\">Label the sections of a page.</h1>\n      <p class=\"screen-text\">A <strong>section</strong> is a part of a page with its own name and job, like a hero or a call-to-action.</p>\n      <ol class=\"steps\">\n        <li>Pick a label.</li>\n        <li>Drag it, or tap it, onto the section it names.</li>\n        <li>Label all four sections fast. Then play again to beat your best.</li>\n      </ol>\n      <button type=\"button\" class=\"button button-primary\" id=\"start-button\">Start</button>\n    </section>\n\n    <div class=\"widget-layout\" id=\"activity-screen\" hidden>\n\n      <h1 class=\"visually-hidden\">Label the sections of a page</h1>\n\n      <div class=\"activity-header\">\n        <span class=\"practice-tag\">Practice</span>\n        <p class=\"do-this\"><strong>Do This:</strong> Match each label to its section as fast as you can.</p>\n      </div>\n\n      <aside class=\"rail\" id=\"rail\" data-ready=\"false\">\n        <dl class=\"scoreboard\">\n          <div class=\"stat\">\n            <dt>Time</dt>\n            <dd id=\"time-value\" role=\"timer\">0:00</dd>\n          </div>\n          <div class=\"stat\">\n            <dt>Score</dt>\n            <dd id=\"score-value\">0</dd>\n          </div>\n          <div class=\"stat\">\n            <dt>Best</dt>\n            <dd id=\"best-value\">None</dd>\n          </div>\n        </dl>\n\n        <div class=\"progress\">\n          <ol class=\"progress-dots\" id=\"progress-dots\" aria-hidden=\"true\"></ol>\n          <p class=\"progress-count\" id=\"progress-count\"></p>\n        </div>\n\n        <div class=\"tray\" id=\"tray\" role=\"group\" aria-label=\"Labels\"></div>\n\n        <section class=\"results\" id=\"results\" aria-labelledby=\"results-title\" hidden>\n          <h2 class=\"results-title\" id=\"results-title\"></h2>\n          <dl class=\"results-list\">\n            <div class=\"results-row\">\n              <dt>Time</dt>\n              <dd id=\"result-time\"></dd>\n            </div>\n            <div class=\"results-row\">\n              <dt>Wrong tries</dt>\n              <dd id=\"result-wrong\"></dd>\n            </div>\n            <div class=\"results-row\">\n              <dt>Speed bonus</dt>\n              <dd id=\"result-bonus\"></dd>\n            </div>\n            <div class=\"results-row results-total\">\n              <dt>Score</dt>\n              <dd id=\"result-score\"></dd>\n            </div>\n          </dl>\n          <p class=\"results-note\" id=\"results-note\"></p>\n          <div class=\"results-actions\">\n            <button type=\"button\" class=\"button button-primary\" id=\"finish-button\">Finish</button>\n            <button type=\"button\" class=\"button button-outline\" id=\"play-button\">Play again</button>\n          </div>\n        </section>\n\n        <p class=\"status\" id=\"status\" aria-live=\"polite\"></p>\n\n        <button type=\"button\" class=\"reset-button\" id=\"reset-button\" disabled>Start over</button>\n      </aside>\n\n      <div class=\"sample-page\" id=\"sample-page\" data-site=\"panda\" data-carrying=\"false\" role=\"group\" aria-label=\"Sample panda fan page\">\n        <div class=\"page-bar\">\n          <span class=\"page-dots\" aria-hidden=\"true\">\n            <span class=\"page-dot\"></span>\n            <span class=\"page-dot\"></span>\n            <span class=\"page-dot\"></span>\n          </span>\n          <span class=\"page-name\" id=\"page-name\"></span>\n        </div>\n\n        <div class=\"page-body\" id=\"page-body\">\n\n          <button class=\"page-block\" type=\"button\" data-block=\"hero\" data-state=\"idle\">\n            <span class=\"visually-hidden\" data-slot=\"desc-hero\"></span>\n            <span class=\"hero-title\" data-slot=\"hero-title\"></span>\n            <svg class=\"hero-art\" viewBox=\"0 0 140 130\" aria-hidden=\"true\" focusable=\"false\"><use data-slot=\"hero-art\" href=\"#hero-panda\"/></svg>\n            <span class=\"tag\"><span class=\"tag-name\"></span><span class=\"tag-job\"></span></span>\n          </button>\n\n          <button class=\"page-block\" type=\"button\" data-block=\"cards\" data-state=\"idle\">\n            <span class=\"visually-hidden\" data-slot=\"desc-cards\"></span>\n            <span class=\"card-row\" aria-hidden=\"true\">\n              <span class=\"fact-card\">\n                <svg class=\"card-icon\" viewBox=\"0 0 60 60\" focusable=\"false\"><use data-slot=\"card-1\" href=\"#card-panda-1\"/></svg>\n                <span class=\"bar\"></span>\n                <span class=\"bar bar-short\"></span>\n              </span>\n              <span class=\"fact-card\">\n                <svg class=\"card-icon\" viewBox=\"0 0 60 60\" focusable=\"false\"><use data-slot=\"card-2\" href=\"#card-panda-2\"/></svg>\n                <span class=\"bar\"></span>\n                <span class=\"bar bar-short\"></span>\n              </span>\n              <span class=\"fact-card\">\n                <svg class=\"card-icon\" viewBox=\"0 0 60 60\" focusable=\"false\"><use data-slot=\"card-3\" href=\"#card-panda-3\"/></svg>\n                <span class=\"bar\"></span>\n                <span class=\"bar bar-short\"></span>\n              </span>\n            </span>\n            <span class=\"tag\"><span class=\"tag-name\"></span><span class=\"tag-job\"></span></span>\n          </button>\n\n          <button class=\"page-block\" type=\"button\" data-block=\"canvas\" data-state=\"idle\">\n            <span class=\"visually-hidden\" data-slot=\"desc-canvas\"></span>\n            <svg class=\"canvas-art\" viewBox=\"0 0 300 100\" aria-hidden=\"true\" focusable=\"false\"><use data-slot=\"canvas-art\" href=\"#canvas-panda\"/></svg>\n            <span class=\"tag\"><span class=\"tag-name\"></span><span class=\"tag-job\"></span></span>\n          </button>\n\n          <button class=\"page-block\" type=\"button\" data-block=\"cta\" data-state=\"idle\">\n            <span class=\"visually-hidden\" data-slot=\"desc-cta\"></span>\n            <span class=\"cta-text\" data-slot=\"cta-text\"></span>\n            <span class=\"cta-button\" data-slot=\"cta-button\"></span>\n            <span class=\"tag\"><span class=\"tag-name\"></span><span class=\"tag-job\"></span></span>\n          </button>\n\n        </div>\n      </div>\n\n    </div>\n\n    <section class=\"screen\" id=\"takeaway-screen\" aria-labelledby=\"takeaway-title\" hidden>\n      <h1 class=\"screen-title\" id=\"takeaway-title\" tabindex=\"-1\">Takeaway: Tell AI which section to change.</h1>\n      <p class=\"screen-text\">Every page is built from sections, like a hero, feature cards, an interactive canvas and a call-to-action. When you use a section’s name in your prompt, AI knows exactly which part of your page to change.</p>\n      <ul class=\"recap-labels\" id=\"recap-labels\"></ul>\n      <p class=\"screen-text\"><strong>Press Continue to go to your project.</strong></p>\n    </section>\n\n  </main>\n\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "/* CADS tokens, copied from the CADS runtime (manifest 0.1.0, light theme).\n   Only the tokens this widget uses are included. Component styles below\n   use these variables only. Font stacks are shortened to Geist / Space Grotesk\n   plus system sans-serif; the fonts themselves are not loaded. */\n:root {\n  /* Brand ramps */\n  --brand-orange-30: #ffa868;\n  --brand-orange-5: #ffe3ce;\n  --brand-orange-50: #f46800;\n  --brand-orange-70: #b34800;\n  --brand-pink-30: #f07fb0;\n  --brand-pink-5: #fbdae8;\n  --brand-pink-50: #e11970;\n  --brand-pink-70: #b5004f;\n  --brand-purple-10: #cac6f5;\n  --brand-purple-20: #aca8ea;\n  --brand-purple-30: #928cef;\n  --brand-purple-5: #e4e2f8;\n  --brand-purple-50: #4c42cf;\n  --brand-purple-70: #3228b7;\n  --brand-purple-80: #2b1e9f;\n  --brand-purple-90: #1d1590;\n  /* Neutral ramps */\n  --neutral-base-black: #121212;\n  --neutral-base-white: #ffffff;\n  --neutral-black-alpha-10: #1212121a;\n  --neutral-gray-10: #e1e3e6;\n  --neutral-gray-20: #d3d6da;\n  --neutral-gray-30: #b7bcc2;\n  --neutral-gray-40: #9ea5ad;\n  --neutral-gray-5: #f1f2f4;\n  --neutral-gray-70: #596069;\n  --neutral-gray-90: #363b40;\n  /* Sentiment ramps */\n  --sentiment-error-20: #f69898;\n  --sentiment-error-30: #f37272;\n  --sentiment-error-5: #ffdada;\n  --sentiment-error-50: #eb1414;\n  --sentiment-error-70: #b30f0f;\n  --sentiment-information-10: #b8e5ff;\n  --sentiment-information-30: #6fcaff;\n  --sentiment-information-5: #d5efff;\n  --sentiment-information-70: #1570d1;\n  --sentiment-information-90: #0b43a3;\n  --sentiment-success-10: #c4f1ca;\n  --sentiment-success-30: #7cdb87;\n  --sentiment-success-5: #d8ffdc;\n  --sentiment-success-50: #34bd43;\n  --sentiment-success-70: #258830;\n  --sentiment-success-90: #17541e;\n  --sentiment-warning-10: #ffecb8;\n  --sentiment-warning-30: #ffd35c;\n  --sentiment-warning-5: #fff5da;\n  --sentiment-warning-70: #cf8e02;\n  /* Background roles */\n  --background-accent-orange-light: var(--brand-orange-5);\n  --background-accent-orange-mid: var(--brand-orange-30);\n  --background-accent-orange-primary: var(--brand-orange-50);\n  --background-accent-orange-strong: var(--brand-orange-70);\n  --background-accent-pink-light: var(--brand-pink-5);\n  --background-accent-pink-mid: var(--brand-pink-30);\n  --background-accent-pink-primary: var(--brand-pink-50);\n  --background-accent-pink-strong: var(--brand-pink-70);\n  --background-brand-light: var(--brand-purple-5);\n  --background-brand-mid: var(--brand-purple-20);\n  --background-brand-primary: var(--brand-purple-50);\n  --background-brand-strong: var(--brand-purple-80);\n  --background-error-light: var(--sentiment-error-5);\n  --background-error-mid: var(--sentiment-error-30);\n  --background-error-primary: var(--sentiment-error-50);\n  --background-error-strong: var(--sentiment-error-70);\n  --background-info-light: var(--sentiment-information-5);\n  --background-info-mid: var(--sentiment-information-30);\n  --background-info-primary: var(--sentiment-information-70);\n  --background-info-strong: var(--sentiment-information-90);\n  --background-neutral-alpha-10: var(--neutral-black-alpha-10);\n  --background-neutral-primary: var(--neutral-base-white);\n  --background-neutral-primary-inverse: var(--neutral-base-black);\n  --background-neutral-quinary: var(--neutral-gray-30);\n  --background-neutral-secondary: var(--neutral-gray-5);\n  --background-neutral-tertiary: var(--neutral-gray-10);\n  --background-success-light: var(--sentiment-success-5);\n  --background-success-mid: var(--sentiment-success-30);\n  --background-success-primary: var(--sentiment-success-70);\n  --background-success-strong: var(--sentiment-success-90);\n  --background-warning-light: var(--sentiment-warning-5);\n  --background-warning-mid: var(--sentiment-warning-30);\n  --background-warning-strong: var(--sentiment-warning-70);\n  /* Border roles */\n  --border-accent-orange-mid: var(--brand-orange-30);\n  --border-accent-orange-primary: var(--brand-orange-50);\n  --border-accent-orange-strong: var(--brand-orange-70);\n  --border-accent-pink-mid: var(--brand-pink-30);\n  --border-accent-pink-strong: var(--brand-pink-70);\n  --border-brand-light: var(--brand-purple-10);\n  --border-brand-mid: var(--brand-purple-30);\n  --border-brand-primary: var(--brand-purple-50);\n  --border-brand-strong: var(--brand-purple-70);\n  --border-error-mid: var(--sentiment-error-20);\n  --border-error-primary: var(--sentiment-error-50);\n  --border-error-strong: var(--sentiment-error-70);\n  --border-focused-primary: var(--brand-purple-50);\n  --border-info-light: var(--sentiment-information-10);\n  --border-info-mid: var(--sentiment-information-30);\n  --border-info-strong: var(--sentiment-information-70);\n  --border-neutral-primary: var(--neutral-gray-20);\n  --border-neutral-secondary: var(--neutral-gray-40);\n  --border-neutral-solid: var(--neutral-base-black);\n  --border-neutral-white-fixed: var(--neutral-base-white);\n  --border-selected-primary: var(--brand-purple-80);\n  --border-success-light: var(--sentiment-success-10);\n  --border-success-mid: var(--sentiment-success-30);\n  --border-success-primary: var(--sentiment-success-50);\n  --border-success-strong: var(--sentiment-success-70);\n  --border-warning-light: var(--sentiment-warning-10);\n  --border-warning-mid: var(--sentiment-warning-30);\n  --border-warning-strong: var(--sentiment-warning-70);\n  /* Text roles */\n  --text-accent-pink-secondary: var(--brand-pink-70);\n  --text-brand-primary: var(--brand-purple-50);\n  --text-brand-secondary: var(--brand-purple-90);\n  --text-disabled-neutral: var(--neutral-gray-20);\n  --text-error-secondary: var(--sentiment-error-70);\n  --text-info-secondary: var(--sentiment-information-90);\n  --text-neutral-black-fixed: var(--neutral-base-black);\n  --text-neutral-primary: var(--neutral-base-black);\n  --text-neutral-quaternary: var(--neutral-gray-70);\n  --text-neutral-secondary: var(--neutral-gray-90);\n  --text-neutral-white-fixed: var(--neutral-base-white);\n  --text-success-primary: var(--sentiment-success-70);\n  --text-success-secondary: var(--sentiment-success-90);\n  /* Type */\n  --font-family-heading: \"Space Grotesk\", \"Geist\", \"Noto Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n  --font-family-main: \"Geist\", \"Noto Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n  --font-size-body-lg: 1.125rem;\n  --font-size-body-md: 1rem;\n  --font-size-body-sm: 0.875rem;\n  --font-size-body-xs: 0.75rem;\n  --font-weight-bold: 700;\n  --font-weight-medium: 500;\n  --font-weight-semi-bold: 600;\n  /* Shape */\n  --shape-lg: .625rem;\n  --shape-md: .5rem;\n  --shape-round: 62.4375rem;\n  --shape-sm: .375rem;\n  --shape-xl: .75rem;\n  /* Spacing */\n  --spacing-p-xs: 1rem;\n  --spacing-p-xxs: .5rem;\n  /* Shadow */\n  --shadow-lg: 0 20px 25px -5px rgb(0 0 0 / 10%), 0 8px 10px -6px rgb(0 0 0 / 10%);\n  --shadow-md: 0 10px 15px -3px rgb(0 0 0 / 10%), 0 4px 6px -4px rgb(0 0 0 / 10%);\n  --shadow-sm: 0 4px 7px rgb(0 0 0 / 7%), 0 2px 2px rgb(0 0 0 / 7%);\n  /* Motion */\n  --duration-medium: .2s;\n  --duration-short: .15s;\n  --easing-out: cubic-bezier(.23, 1, .32, 1);\n  --easing-standard: cubic-bezier(.4, 0, .2, 1);\n  --motion-press-duration: .15s;\n  --motion-press-easing: cubic-bezier(.23, 1, .32, 1);\n  --motion-press-scale: .97;\n  --motion-surface-duration: .2s;\n  --motion-surface-easing: cubic-bezier(.23, 1, .32, 1);\n  --transition-colors: background-color var(--duration-short) var(--easing-standard), color var(--duration-short) var(--easing-standard), border-color var(--duration-short) var(--easing-standard), box-shadow var(--duration-short) var(--easing-standard), opacity var(--duration-short) var(--easing-standard);\n  --transition-press: transform var(--motion-press-duration) var(--motion-press-easing);\n}\n\n/* ==========================================================================\n   Component styles\n   --------------------------------------------------------------------------\n   CADS (copied as-is above): color, shape, spacing, shadow, motion and\n   font-size/weight tokens. Focus ring (2px surface gap + 2px focus color),\n   disabled tokens and press scale follow the CADS recipes.\n\n   Rebuilt from the CADS manifest (not the runtime components): the text\n   Button used for \"Start over\", the contained primary Button used for\n   \"Start\" and \"Finish\", the outlined primary Button used for \"Play again\"\n   (40px height, 16px text) and the brand Tag used for \"Practice\" (24px\n   height). Their values were read from the rendered CADS components.\n\n   Approximated: the Tag and button text is 16px. CADS Tags use 14px text.\n   Geist and Space Grotesk are named by the CADS font tokens\n   but are not loaded (no external fonts in Web Lab), so the fallback\n   sans-serif shows. The sample page, the draggable stickers, the empty label\n   slots, the progress dots and the panda art are custom to this widget and\n   are not CADS components. The scoreboard, results panel, site themes and all\n   site art are also custom, built from CADS tokens.\n   ========================================================================== */\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\nhtml {\n  -webkit-text-size-adjust: 100%;\n}\n\nbody {\n  margin: 0;\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font-family: var(--font-family-main);\n  font-size: var(--font-size-body-md);\n  line-height: 1.4;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nbutton {\n  margin: 0;\n  font: inherit;\n  color: inherit;\n  -webkit-tap-highlight-color: transparent;\n  touch-action: manipulation;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  border: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n.sprite {\n  position: absolute;\n  width: 0;\n  height: 0;\n  overflow: hidden;\n}\n\n.error-banner {\n  margin: var(--spacing-p-xxs);\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border: 2px solid var(--border-error-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-error-light);\n  color: var(--text-error-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n/* ---------- Layout ---------- */\n\n.widget-layout {\n  display: grid;\n  grid-template-columns: 14rem minmax(0, 1fr);\n  grid-template-areas:\n    \"header header\"\n    \"rail page\";\n  gap: var(--spacing-p-xxs) var(--spacing-p-xs);\n  align-items: start;\n  max-width: 62rem;\n  margin-inline: auto;\n  padding: var(--spacing-p-xxs);\n}\n\n.activity-header {\n  grid-area: header;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n}\n\n.do-this {\n  margin: 0;\n  font-size: var(--font-size-body-md);\n  line-height: 1.5rem;\n}\n\n.sample-page {\n  grid-area: page;\n}\n\n.rail {\n  grid-area: rail;\n}\n\n@media (max-width: 47.99rem) {\n  .widget-layout {\n    grid-template-columns: minmax(0, 1fr);\n    grid-template-areas:\n      \"header\"\n      \"rail\"\n      \"page\";\n    row-gap: var(--spacing-p-xs);\n  }\n}\n\n/* ---------- Intro and takeaway screens ---------- */\n\n.screen {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: var(--spacing-p-xs);\n  max-width: 62rem;\n  margin-inline: auto;\n  padding: var(--spacing-p-xs);\n}\n\n.screen > * {\n  max-width: 40rem;\n}\n\n.screen-title {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: 1.75rem;\n  font-weight: var(--font-weight-bold);\n  line-height: 1.2;\n}\n\n.screen-title:focus {\n  outline: none;\n}\n\n.screen-text {\n  margin: 0;\n  font-size: var(--font-size-body-lg);\n  line-height: 1.4;\n}\n\n.steps {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-p-xxs);\n  margin: 0;\n  padding-inline-start: calc(var(--spacing-p-xs) * 1.5);\n  font-size: var(--font-size-body-lg);\n  line-height: 1.4;\n}\n\n.steps li::marker {\n  font-weight: var(--font-weight-bold);\n}\n\n.steps + .button {\n  margin-block-start: var(--spacing-p-xxs);\n}\n\n.practice-tag {\n  display: inline-block;\n  padding: 3px 10px;\n  border: 1px solid var(--border-brand-mid);\n  border-radius: var(--shape-sm);\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n  font-size: var(--font-size-body-md);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: 1rem;\n  white-space: nowrap;\n}\n\n.recap-labels {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: var(--spacing-p-xs);\n  width: 100%;\n  margin: var(--spacing-p-xxs) 0;\n  padding: 0 var(--spacing-p-xxs);\n  list-style: none;\n}\n\n@media (max-width: 35.99rem) {\n  .recap-labels {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n\n/* ---------- Sample page ---------- */\n\n/* Site themes. Panda is the default; each data-site value overrides it. */\n\n.sample-page {\n  --frame-bg: var(--background-success-strong);\n  --frame-edge: var(--border-success-strong);\n  --body-bg: var(--background-success-light);\n  --hero-bg: var(--background-success-mid);\n  --hero-edge: var(--border-success-primary);\n  --hero-text: var(--text-success-secondary);\n  --band-edge: var(--border-success-mid);\n  --band-edge-strong: var(--border-success-strong);\n  --card-bg: var(--background-success-light);\n  --card-edge: var(--border-success-light);\n  --canvas-bg: var(--background-neutral-primary);\n  --cta-bg: var(--background-accent-pink-light);\n  --cta-edge: var(--border-accent-pink-mid);\n  --cta-edge-strong: var(--border-accent-pink-strong);\n  --cta-text: var(--text-accent-pink-secondary);\n  --button-bg: var(--background-success-strong);\n\n  border: 3px solid var(--frame-edge);\n  border-radius: var(--shape-xl);\n  background: var(--body-bg);\n  box-shadow: var(--shadow-md);\n}\n\n.sample-page[data-site=\"pizza\"] {\n  --frame-bg: var(--background-accent-orange-strong);\n  --frame-edge: var(--border-accent-orange-strong);\n  --body-bg: var(--background-warning-light);\n  --hero-bg: var(--background-accent-orange-mid);\n  --hero-edge: var(--border-accent-orange-primary);\n  --hero-text: var(--text-neutral-primary);\n  --band-edge: var(--border-warning-mid);\n  --band-edge-strong: var(--border-accent-orange-strong);\n  --card-bg: var(--background-warning-light);\n  --card-edge: var(--border-warning-light);\n  --cta-bg: var(--background-error-light);\n  --cta-edge: var(--border-error-mid);\n  --cta-edge-strong: var(--border-error-strong);\n  --cta-text: var(--text-error-secondary);\n  --button-bg: var(--background-error-strong);\n}\n\n.sample-page[data-site=\"space\"] {\n  --frame-bg: var(--background-brand-strong);\n  --frame-edge: var(--border-brand-strong);\n  --body-bg: var(--background-brand-light);\n  --hero-bg: var(--background-brand-primary);\n  --hero-edge: var(--border-brand-strong);\n  --hero-text: var(--text-neutral-white-fixed);\n  --band-edge: var(--border-brand-mid);\n  --band-edge-strong: var(--border-brand-strong);\n  --card-bg: var(--background-brand-light);\n  --card-edge: var(--border-brand-light);\n  --canvas-bg: var(--background-brand-strong);\n  --cta-bg: var(--background-info-light);\n  --cta-edge: var(--border-info-mid);\n  --cta-edge-strong: var(--border-info-strong);\n  --cta-text: var(--text-info-secondary);\n  --button-bg: var(--background-brand-strong);\n}\n\n.sample-page[data-site=\"music\"] {\n  --frame-bg: var(--background-info-strong);\n  --frame-edge: var(--border-info-strong);\n  --body-bg: var(--background-info-light);\n  --hero-bg: var(--background-info-mid);\n  --hero-edge: var(--border-info-strong);\n  --hero-text: var(--text-info-secondary);\n  --band-edge: var(--border-info-mid);\n  --band-edge-strong: var(--border-info-strong);\n  --card-bg: var(--background-info-light);\n  --card-edge: var(--border-info-light);\n  --canvas-bg: var(--background-neutral-primary-inverse);\n  --cta-bg: var(--background-accent-orange-light);\n  --cta-edge: var(--border-accent-orange-mid);\n  --cta-edge-strong: var(--border-accent-orange-strong);\n  --cta-text: var(--text-neutral-primary);\n  --button-bg: var(--background-info-strong);\n}\n\n.page-bar {\n  display: flex;\n  align-items: center;\n  gap: calc(var(--spacing-p-xxs) * 1.5);\n  padding: calc(var(--spacing-p-xxs) * 0.8) calc(var(--spacing-p-xxs) * 1.5);\n  border-start-start-radius: calc(var(--shape-xl) - 3px);\n  border-start-end-radius: calc(var(--shape-xl) - 3px);\n  background: var(--frame-bg);\n}\n\n.page-dots {\n  display: flex;\n  gap: calc(var(--spacing-p-xxs) * 0.6);\n}\n\n.page-dot {\n  width: 0.6rem;\n  height: 0.6rem;\n  border-radius: var(--shape-round);\n  background: var(--body-bg);\n}\n\n.page-name {\n  color: var(--text-neutral-white-fixed);\n  font-family: var(--font-family-heading);\n  font-size: var(--font-size-body-xs);\n  font-weight: var(--font-weight-bold);\n  line-height: 1;\n}\n\n.page-body {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-p-xs);\n  padding: calc(var(--spacing-p-xxs) * 1.5);\n}\n\n.page-row {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  gap: var(--spacing-p-xs);\n}\n\n.page-row[data-columns=\"2\"] {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.page-row > .page-block {\n  align-self: stretch;\n}\n\n@media (max-width: 47.99rem) {\n  .page-row[data-columns=\"2\"] {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n\n.page-body.is-swapping {\n  animation: layout-in 0.3s var(--easing-out);\n}\n\n/* ---------- Blocks ---------- */\n\n.page-block {\n  --pop: translateY(-3px) scale(1.02);\n  --edge: var(--band-edge);\n  --edge-strong: var(--band-edge-strong);\n  --tag-bg: var(--background-warning-mid);\n  --tag-tilt: -3deg;\n\n  position: relative;\n  display: flex;\n  align-items: center;\n  width: 100%;\n  min-height: 6.4rem;\n  padding: 1.6rem calc(var(--spacing-p-xxs) * 1.5) calc(var(--spacing-p-xxs) * 1.2);\n  border: 2px solid var(--edge);\n  border-radius: var(--shape-lg);\n  background: var(--background-neutral-primary);\n  text-align: start;\n  cursor: default;\n  transition:\n    transform var(--motion-surface-duration) var(--motion-surface-easing),\n    box-shadow var(--duration-short) var(--easing-standard),\n    border-color var(--duration-short) var(--easing-standard);\n}\n\n.page-block[data-state=\"done\"] {\n  border-color: var(--edge-strong);\n  box-shadow: var(--shadow-sm);\n}\n\n.sample-page[data-carrying=\"true\"] .page-block[data-state=\"idle\"] {\n  border-style: dashed;\n  border-color: var(--border-brand-mid);\n  cursor: pointer;\n}\n\n.page-block[data-over=\"true\"] {\n  z-index: 2;\n  transform: var(--pop);\n  border-style: dashed;\n  border-color: var(--border-brand-primary);\n  box-shadow: var(--shadow-md);\n}\n\n.page-block[data-current=\"true\"] {\n  z-index: 2;\n  transform: var(--pop);\n  box-shadow: var(--shadow-md);\n}\n\n.page-block:focus-visible {\n  box-shadow: 0 0 0 2px var(--background-neutral-primary), 0 0 0 4px var(--border-focused-primary), var(--shadow-md);\n}\n\n.page-block:focus-visible {\n  outline: none;\n}\n\n.page-block.is-wiggling {\n  animation: wiggle 0.45s var(--easing-out);\n}\n\n.page-block.is-wrong {\n  animation: shake 0.35s var(--easing-out);\n}\n\n.page-block[data-block=\"hero\"] {\n  --edge: var(--hero-edge);\n  --tag-bg: var(--background-warning-mid);\n  --tag-tilt: -3deg;\n  --art-leaf: var(--background-success-light);\n  min-height: 5.5rem;\n  background: var(--hero-bg);\n}\n\n.page-block[data-block=\"cards\"] {\n  --tag-bg: var(--background-accent-pink-mid);\n  --tag-tilt: 2deg;\n}\n\n.page-block[data-block=\"canvas\"] {\n  --tag-bg: var(--background-info-mid);\n  --tag-tilt: -2deg;\n  min-height: 5.6rem;\n  background: var(--canvas-bg);\n}\n\n.page-block[data-block=\"cta\"] {\n  --edge: var(--cta-edge);\n  --edge-strong: var(--cta-edge-strong);\n  --tag-bg: var(--background-accent-orange-mid);\n  --tag-tilt: 3deg;\n  justify-content: space-between;\n  gap: calc(var(--spacing-p-xxs) * 1.5);\n  min-height: 4.8rem;\n  background: var(--cta-bg);\n}\n\n/* Hero */\n\n.hero-title {\n  display: block;\n  max-width: 55%;\n  color: var(--hero-text);\n  font-family: var(--font-family-heading);\n  font-size: 1.5rem;\n  font-weight: var(--font-weight-bold);\n  line-height: 1.1;\n}\n\n.hero-art {\n  position: absolute;\n  inset-block-end: 0;\n  inset-inline-end: var(--spacing-p-xxs);\n  height: 120%;\n  aspect-ratio: 140 / 130;\n  pointer-events: none;\n}\n\n/* Feature cards */\n\n.card-row {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: var(--spacing-p-xxs);\n  width: 100%;\n}\n\n.fact-card {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: calc(var(--spacing-p-xxs) * 0.5);\n  padding: calc(var(--spacing-p-xxs) * 0.8) var(--spacing-p-xxs);\n  border: 2px solid var(--card-edge);\n  border-radius: var(--shape-md);\n  background: var(--card-bg);\n}\n\n.card-icon {\n  display: block;\n  height: 2rem;\n  aspect-ratio: 1;\n}\n\n.bar {\n  display: block;\n  width: 70%;\n  height: 0.3rem;\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-quinary);\n}\n\n.bar-short {\n  width: 45%;\n}\n\n/* Interactive canvas */\n\n.canvas-art {\n  display: block;\n  width: 100%;\n  height: 3.4rem;\n}\n\n/* Call-to-action */\n\n.cta-text {\n  color: var(--cta-text);\n  font-family: var(--font-family-heading);\n  font-size: var(--font-size-body-lg);\n  font-weight: var(--font-weight-bold);\n}\n\n.cta-button {\n  display: inline-block;\n  white-space: nowrap;\n  padding: calc(var(--spacing-p-xxs) * 0.9) var(--spacing-p-xs);\n  border-radius: var(--shape-round);\n  background: var(--button-bg);\n  color: var(--text-neutral-white-fixed);\n  font-size: var(--font-size-body-sm);\n  font-weight: var(--font-weight-bold);\n}\n\n/* ---------- Stickers ---------- */\n\n.tag {\n  position: absolute;\n  inset-block-start: -1rem;\n  inset-inline-start: calc(var(--spacing-p-xxs) * 1.5);\n  z-index: 3;\n  display: block;\n  max-width: min(16rem, 80%);\n  padding: calc(var(--spacing-p-xxs) * 0.4) calc(var(--spacing-p-xxs) * 1.1) calc(var(--spacing-p-xxs) * 0.5);\n  border: 2px solid var(--border-neutral-solid);\n  border-radius: var(--shape-sm);\n  background: var(--tag-bg);\n  color: var(--text-neutral-black-fixed);\n  box-shadow: 2px 2px 0 var(--border-neutral-solid);\n  transform: rotate(var(--tag-tilt));\n  transform-origin: left bottom;\n  pointer-events: none;\n}\n\n.page-block[data-state=\"done\"] .tag {\n  animation: tag-pop 0.35s var(--easing-out) backwards;\n}\n\n.page-block[data-state=\"idle\"] .tag {\n  min-width: 7rem;\n  min-height: 2.4rem;\n  border-style: dashed;\n  border-color: var(--border-neutral-secondary);\n  background: var(--background-neutral-alpha-10);\n  box-shadow: none;\n}\n\n.sample-page[data-carrying=\"true\"] .page-block[data-state=\"idle\"] .tag {\n  border-color: var(--border-brand-primary);\n  background: var(--background-brand-light);\n}\n\n.page-block[data-over=\"true\"] .tag {\n  background: var(--background-brand-mid);\n}\n\n.tag-name {\n  display: block;\n  font-family: var(--font-family-heading);\n  font-size: var(--font-size-body-sm);\n  font-weight: var(--font-weight-bold);\n  line-height: 1.15;\n}\n\n.tag-job {\n  display: block;\n  font-size: var(--font-size-body-xs);\n  font-weight: var(--font-weight-medium);\n  line-height: 1.25;\n}\n\n/* ---------- Art colors ---------- */\n\n.art-black {\n  fill: var(--background-neutral-primary-inverse);\n}\n\n.art-white {\n  fill: var(--background-neutral-primary);\n}\n\n.art-outline {\n  stroke: var(--border-neutral-secondary);\n  stroke-width: 1.5;\n}\n\n.art-line,\n.art-line-white,\n.art-z {\n  fill: none;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.art-line {\n  stroke: var(--border-neutral-solid);\n  stroke-width: 2.5;\n}\n\n.art-line-white {\n  stroke: var(--border-neutral-white-fixed);\n  stroke-width: 2.5;\n}\n\n.art-z {\n  stroke: var(--border-brand-primary);\n  stroke-width: 3;\n}\n\n.art-stalk {\n  fill: var(--background-success-primary);\n}\n\n.art-joint {\n  fill: var(--background-success-strong);\n}\n\n.art-leaf {\n  fill: var(--art-leaf, var(--background-success-mid));\n}\n\n.art-arrow {\n  fill: var(--background-accent-pink-primary);\n  stroke: var(--border-neutral-white-fixed);\n  stroke-width: 2;\n  stroke-linejoin: round;\n}\n\n/* Pizza */\n\n.art-crust {\n  fill: var(--background-warning-strong);\n}\n\n.art-cheese {\n  fill: var(--background-warning-mid);\n}\n\n.art-pepperoni {\n  fill: var(--background-error-primary);\n}\n\n.art-pepperoni-dot {\n  fill: var(--background-error-mid);\n}\n\n.art-basil {\n  fill: var(--background-success-primary);\n}\n\n/* Space */\n\n.art-rocket {\n  fill: var(--background-neutral-primary);\n  stroke: var(--border-neutral-secondary);\n  stroke-width: 2;\n}\n\n.art-fin {\n  fill: var(--background-error-primary);\n}\n\n.art-window {\n  fill: var(--background-info-mid);\n  stroke: var(--border-neutral-secondary);\n  stroke-width: 2;\n}\n\n.art-flame {\n  fill: var(--background-warning-mid);\n}\n\n.art-flame-core {\n  fill: var(--background-accent-orange-primary);\n}\n\n.art-moon {\n  fill: var(--background-neutral-tertiary);\n}\n\n.art-crater {\n  fill: var(--border-neutral-secondary);\n}\n\n.art-star {\n  fill: var(--background-warning-mid);\n}\n\n.art-star-edge {\n  stroke: var(--border-warning-strong);\n  stroke-width: 2;\n  stroke-linejoin: round;\n}\n\n.art-planet {\n  fill: var(--background-brand-mid);\n  stroke: var(--border-brand-primary);\n  stroke-width: 2;\n}\n\n.art-ring {\n  fill: none;\n  stroke: var(--border-accent-orange-primary);\n  stroke-width: 4;\n}\n\n/* Music */\n\n.art-note {\n  fill: var(--background-brand-primary);\n}\n\n.art-headband {\n  fill: none;\n  stroke: var(--border-neutral-solid);\n  stroke-width: 9;\n  stroke-linecap: round;\n}\n\n.art-cup {\n  fill: var(--background-accent-pink-primary);\n  stroke: var(--border-neutral-solid);\n  stroke-width: 3;\n}\n\n.art-cup-pad {\n  fill: var(--background-accent-pink-strong);\n}\n\n.art-drum {\n  fill: var(--background-info-primary);\n}\n\n.art-drum-head {\n  fill: var(--background-neutral-primary);\n  stroke: var(--border-neutral-secondary);\n  stroke-width: 2;\n}\n\n.art-drum-stick {\n  fill: none;\n  stroke: var(--border-warning-strong);\n  stroke-width: 4;\n  stroke-linecap: round;\n}\n\n.art-vinyl {\n  fill: var(--background-neutral-primary-inverse);\n}\n\n.art-groove {\n  fill: none;\n  stroke: var(--border-neutral-secondary);\n  stroke-width: 1.5;\n}\n\n.art-record-label {\n  fill: var(--background-accent-pink-primary);\n}\n\n.art-pad-a {\n  fill: var(--background-accent-pink-primary);\n}\n\n.art-pad-b {\n  fill: var(--background-info-mid);\n}\n\n.art-pad-c {\n  fill: var(--background-success-mid);\n}\n\n.art-pad-d {\n  fill: var(--background-warning-mid);\n}\n\n.art-pad-e {\n  fill: var(--background-brand-mid);\n}\n\n.art-pad-f {\n  fill: var(--background-accent-orange-mid);\n}\n\n.art-speaker {\n  fill: var(--background-neutral-tertiary);\n}\n\n.art-woofer {\n  fill: var(--background-neutral-primary-inverse);\n  stroke: var(--border-neutral-secondary);\n  stroke-width: 2;\n}\n\n.art-wave {\n  fill: none;\n  stroke: var(--border-warning-mid);\n  stroke-width: 3;\n  stroke-linecap: round;\n}\n\n/* ---------- Side rail ---------- */\n\n.rail {\n  display: flex;\n  flex-direction: column;\n  gap: calc(var(--spacing-p-xxs) * 1.5);\n  padding: var(--spacing-p-xs);\n  border: 2px solid var(--border-neutral-primary);\n  border-radius: var(--shape-xl);\n  background: var(--background-neutral-secondary);\n  transition: background-color var(--duration-medium) var(--easing-standard), border-color var(--duration-medium) var(--easing-standard);\n}\n\n.rail[data-ready=\"true\"] {\n  border-color: var(--border-brand-primary);\n  background: var(--background-brand-light);\n  animation: rail-pop 0.3s var(--easing-out);\n}\n\n.progress {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n}\n\n.progress-dots {\n  display: flex;\n  gap: calc(var(--spacing-p-xxs) * 0.7);\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.dot {\n  width: 1rem;\n  height: 1rem;\n  border: 2px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-primary);\n  transition: background-color var(--duration-short) var(--easing-standard), border-color var(--duration-short) var(--easing-standard);\n}\n\n.dot[data-filled=\"true\"] {\n  border-color: var(--border-success-primary);\n  background: var(--background-success-primary);\n}\n\n.progress-count {\n  margin: 0;\n  white-space: nowrap;\n  color: var(--text-neutral-secondary);\n  font-size: var(--font-size-body-sm);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.reset-button {\n  align-self: flex-start;\n  min-height: 2rem;\n  padding: calc(var(--spacing-p-xxs) * 0.5) calc(var(--spacing-p-xxs) * 1.2);\n  border: 0;\n  border-radius: var(--shape-md);\n  background: transparent;\n  color: var(--text-brand-primary);\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n}\n\n.reset-button:hover {\n  background: var(--background-brand-light);\n}\n\n.reset-button:disabled {\n  color: var(--text-disabled-neutral);\n  cursor: default;\n}\n\n.reset-button:hover:disabled {\n  background: transparent;\n}\n\n/* ---------- Scoreboard and results ---------- */\n\n.scoreboard {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: calc(var(--spacing-p-xxs) * 0.6);\n  margin: 0;\n}\n\n.stat {\n  padding: calc(var(--spacing-p-xxs) * 0.5) calc(var(--spacing-p-xxs) * 0.3);\n  border: 2px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n  text-align: center;\n}\n\n.stat dt {\n  color: var(--text-neutral-quaternary);\n  font-size: var(--font-size-body-xs);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: 1.2;\n}\n\n.stat dd {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--font-size-body-lg);\n  font-weight: var(--font-weight-bold);\n  font-variant-numeric: tabular-nums;\n  line-height: 1.3;\n}\n\n#score-value.is-up {\n  animation: score-up 0.4s var(--easing-out);\n}\n\n#score-value.is-down {\n  animation: score-down 0.4s var(--easing-out);\n}\n\n.results {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-p-xxs);\n  padding: var(--spacing-p-xxs) calc(var(--spacing-p-xxs) * 1.5) calc(var(--spacing-p-xxs) * 1.5);\n  border: 2px solid var(--border-brand-mid);\n  border-radius: var(--shape-lg);\n  background: var(--background-neutral-primary);\n}\n\n.results-title {\n  margin: 0;\n  color: var(--text-brand-secondary);\n  font-family: var(--font-family-heading);\n  font-size: var(--font-size-body-lg);\n  font-weight: var(--font-weight-bold);\n  line-height: 1.2;\n}\n\n.results-list {\n  margin: 0;\n}\n\n.results-row {\n  display: flex;\n  justify-content: space-between;\n  gap: var(--spacing-p-xxs);\n  padding-block: calc(var(--spacing-p-xxs) * 0.4);\n  border-block-end: 1px solid var(--border-neutral-primary);\n  font-size: var(--font-size-body-sm);\n}\n\n.results-row dt {\n  color: var(--text-neutral-secondary);\n}\n\n.results-row dd {\n  margin: 0;\n  font-weight: var(--font-weight-semi-bold);\n  font-variant-numeric: tabular-nums;\n}\n\n.results-total {\n  border-block-end: 0;\n  font-size: var(--font-size-body-lg);\n  font-weight: var(--font-weight-bold);\n}\n\n.results-total dt {\n  color: var(--text-neutral-primary);\n}\n\n.results-total dd {\n  font-weight: var(--font-weight-bold);\n}\n\n.results-note {\n  margin: 0;\n  color: var(--text-neutral-secondary);\n  font-size: var(--font-size-body-sm);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: 1.3;\n}\n\n.results-actions {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-p-xxs);\n}\n\n.button {\n  min-height: 2.5rem;\n  padding: var(--spacing-p-xxs) calc(var(--spacing-p-xxs) * 1.75);\n  border: 1px solid transparent;\n  border-radius: var(--shape-sm);\n  font-size: var(--font-size-body-md);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: 1.5rem;\n  cursor: pointer;\n  transition: var(--transition-colors), var(--transition-press);\n}\n\n.screen > .button {\n  min-width: 7.5rem;\n}\n\n.button:active {\n  transform: scale(var(--motion-press-scale));\n}\n\n.button:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--background-neutral-primary), 0 0 0 4px var(--border-focused-primary);\n}\n\n.button-primary {\n  background: var(--background-brand-primary);\n  color: var(--text-neutral-white-fixed);\n}\n\n.button-primary:hover {\n  background: var(--background-brand-strong);\n}\n\n.button-outline {\n  border-color: var(--border-neutral-solid);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n}\n\n.button-outline:hover {\n  background: var(--background-neutral-tertiary);\n}\n\n/* ---------- Tray and stickers ---------- */\n\n.tray {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-p-xxs);\n}\n\n.sticker,\n.recap-label {\n  --tag-bg: var(--background-warning-mid);\n  --tag-tilt: -3deg;\n  display: block;\n  width: 100%;\n  padding: calc(var(--spacing-p-xxs) * 0.5) calc(var(--spacing-p-xxs) * 1.1) calc(var(--spacing-p-xxs) * 0.6);\n  border: 2px solid var(--border-neutral-solid);\n  border-radius: var(--shape-sm);\n  background: var(--tag-bg);\n  color: var(--text-neutral-black-fixed);\n  box-shadow: 2px 2px 0 var(--border-neutral-solid);\n  text-align: start;\n  transform: rotate(var(--tag-tilt));\n}\n\n.sticker {\n  cursor: grab;\n  touch-action: none;\n  user-select: none;\n  -webkit-user-select: none;\n  transform: translate(var(--drag-x, 0px), var(--drag-y, 0px)) rotate(var(--tag-tilt));\n  transition: transform var(--motion-surface-duration) var(--motion-surface-easing), box-shadow var(--duration-short) var(--easing-standard);\n}\n\n.recap-label .tag-name {\n  font-size: var(--font-size-body-lg);\n}\n\n.recap-label .tag-job {\n  font-size: var(--font-size-body-md);\n}\n\n.sticker[data-sticker=\"hero\"],\n.recap-label[data-label=\"hero\"] {\n  --tag-bg: var(--background-warning-mid);\n  --tag-tilt: -2deg;\n}\n\n.sticker[data-sticker=\"cards\"],\n.recap-label[data-label=\"cards\"] {\n  --tag-bg: var(--background-accent-pink-mid);\n  --tag-tilt: 2deg;\n}\n\n.sticker[data-sticker=\"canvas\"],\n.recap-label[data-label=\"canvas\"] {\n  --tag-bg: var(--background-info-mid);\n  --tag-tilt: -1.5deg;\n}\n\n.sticker[data-sticker=\"cta\"],\n.recap-label[data-label=\"cta\"] {\n  --tag-bg: var(--background-accent-orange-mid);\n  --tag-tilt: 2.5deg;\n}\n\n.sticker:hover {\n  box-shadow: 3px 4px 0 var(--border-neutral-solid);\n}\n\n.sticker[aria-pressed=\"true\"] {\n  outline: 3px solid var(--border-selected-primary);\n  outline-offset: 2px;\n}\n\n.sticker.is-dragging {\n  position: relative;\n  z-index: 20;\n  cursor: grabbing;\n  box-shadow: var(--shadow-lg), 2px 2px 0 var(--border-neutral-solid);\n  transition: none;\n}\n\n.sticker.is-wrong {\n  animation: sticker-shake 0.35s var(--easing-out);\n}\n\n.sticker[data-placed=\"true\"] {\n  visibility: hidden;\n}\n\n.sticker:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--background-neutral-primary), 0 0 0 4px var(--border-focused-primary), 2px 2px 0 var(--border-neutral-solid);\n}\n\n.status {\n  min-height: 2.6em;\n  margin: 0;\n  color: var(--text-neutral-secondary);\n  font-size: var(--font-size-body-sm);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: 1.3;\n}\n\n.rail[data-ready=\"true\"] .status {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n@media (max-width: 47.99rem) {\n  .tray {\n    flex-direction: row;\n    flex-wrap: wrap;\n  }\n\n  .sticker {\n    flex: 1 1 9.5rem;\n    width: auto;\n  }\n}\n\n.reset-button:focus-visible {\n  outline: none;\n  box-shadow: 0 0 0 2px var(--background-neutral-primary), 0 0 0 4px var(--border-focused-primary);\n}\n\n/* ---------- Motion ---------- */\n\n@keyframes wiggle {\n  0% { transform: rotate(0) scale(1); }\n  20% { transform: rotate(-2.5deg) scale(1.05); }\n  40% { transform: rotate(2.5deg) scale(1.05); }\n  60% { transform: rotate(-1.5deg) scale(1.04); }\n  80% { transform: rotate(1deg) scale(1.03); }\n  100% { transform: var(--pop); }\n}\n\n@keyframes layout-in {\n  0% { opacity: 0; transform: translateY(6px); }\n  100% { opacity: 1; transform: translateY(0); }\n}\n\n@keyframes score-up {\n  0% { color: var(--text-success-primary); transform: scale(1.35); }\n  100% { color: var(--text-neutral-primary); transform: scale(1); }\n}\n\n@keyframes score-down {\n  0% { color: var(--text-error-secondary); transform: scale(0.8); }\n  100% { color: var(--text-neutral-primary); transform: scale(1); }\n}\n\n@keyframes shake {\n  0%, 100% { transform: translateX(0); }\n  25% { transform: translateX(-5px); }\n  75% { transform: translateX(5px); }\n}\n\n@keyframes sticker-shake {\n  0%, 100% { transform: translateX(0) rotate(var(--tag-tilt)); }\n  25% { transform: translateX(-6px) rotate(var(--tag-tilt)); }\n  75% { transform: translateX(6px) rotate(var(--tag-tilt)); }\n}\n\n@keyframes tag-pop {\n  0% { opacity: 0; transform: scale(0.4) rotate(calc(var(--tag-tilt) - 12deg)); }\n  65% { opacity: 1; transform: scale(1.12) rotate(var(--tag-tilt)); }\n  100% { opacity: 1; transform: scale(1) rotate(var(--tag-tilt)); }\n}\n\n@keyframes rail-pop {\n  0% { transform: translateY(4px); }\n  100% { transform: translateY(0); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "'use strict';\n\nconst CONFIG = {\n  // Order matches the blocks on the page, top to bottom.\n  blocks: [\n    { id: 'hero', name: 'Hero', job: 'The first thing you see.' },\n    { id: 'cards', name: 'Feature cards', job: 'Share quick facts at a glance.' },\n    { id: 'canvas', name: 'Interactive canvas', job: 'Lets visitors play with the page.' },\n    { id: 'cta', name: 'Call-to-action', job: 'Asks visitors to take the next step.' }\n  ],\n  // Sites, one is chosen at random each round (never the same one twice in a\n  // row). The art for each site lives in the sprite in index.html, named\n  // hero-<id>, card-<id>-1 to 3 and canvas-<id>. The look comes from\n  // data-site in style.css. The descriptions are for screen readers and say\n  // nothing about position, because the layouts move the blocks around.\n  sites: [\n    {\n      id: 'panda',\n      name: 'Panda Fan Club',\n      label: 'Sample panda fan page',\n      heroTitle: 'Meet the pandas',\n      ctaText: 'Love pandas?',\n      ctaButton: 'Join the panda club',\n      desc: {\n        hero: 'A banner with a panda holding bamboo.',\n        cards: 'Three cards with a bamboo stalk, a sleeping panda and a paw print.',\n        canvas: 'A play area with a piece of bamboo, an arrow and a panda.',\n        cta: 'A sign-up area.'\n      }\n    },\n    {\n      id: 'pizza',\n      name: 'Slice Street',\n      label: 'Sample pizza shop page',\n      heroTitle: 'Hot, fresh pizza',\n      ctaText: 'Hungry?',\n      ctaButton: 'Order a pizza',\n      desc: {\n        hero: 'A banner with a big pizza.',\n        cards: 'Three cards with a pizza slice, a tomato and a basil leaf.',\n        canvas: 'A play area with a pepperoni, an arrow and a pizza.',\n        cta: 'An ordering area.'\n      }\n    },\n    {\n      id: 'space',\n      name: 'Moon Explorers',\n      label: 'Sample space club page',\n      heroTitle: 'Blast off to the Moon',\n      ctaText: 'Ready to launch?',\n      ctaButton: 'Join the crew',\n      desc: {\n        hero: 'A banner with a rocket and the Moon.',\n        cards: 'Three cards with a star, a ringed planet and a crescent moon.',\n        canvas: 'A play area with a rocket, an arrow and the Moon.',\n        cta: 'A sign-up area.'\n      }\n    },\n    {\n      id: 'music',\n      name: 'Beat Lab',\n      label: 'Sample music maker page',\n      heroTitle: 'Make your own beats',\n      ctaText: 'Got rhythm?',\n      ctaButton: 'Join the band',\n      desc: {\n        hero: 'A banner with headphones and music notes.',\n        cards: 'Three cards with a music note, a drum and a record.',\n        canvas: 'A play area with colorful pads, an arrow and a speaker.',\n        cta: 'A sign-up area.'\n      }\n    }\n  ],\n  // Page layouts, one is chosen at random each round (never the same one twice\n  // in a row). Each inner array is a row; two blocks in a row sit side by side.\n  // The hero always stays on top because its job is the first thing you see.\n  layouts: [\n    [['hero'], ['cards'], ['canvas'], ['cta']],\n    [['hero'], ['cta'], ['cards'], ['canvas']],\n    [['hero'], ['canvas'], ['cta'], ['cards']],\n    [['hero'], ['cards'], ['cta'], ['canvas']],\n    [['hero'], ['cards', 'canvas'], ['cta']],\n    [['hero'], ['cta'], ['canvas', 'cards']]\n  ],\n  // Order the labels start in. Differs from the page order on purpose.\n  trayOrder: ['canvas', 'hero', 'cta', 'cards'],\n  dragThresholdPx: 6,\n  animationFallbackMs: 700,\n  tickMs: 250,\n  // Scoring: points per correct label, minus a penalty per wrong block,\n  // plus a speed bonus for every second left under bonusSeconds.\n  pointsPerLabel: 100,\n  wrongPenalty: 25,\n  bonusSeconds: 60,\n  bonusPerSecond: 2\n};\n\nconst COPY = {\n  progress: (placed, total) => `${placed} of ${total} labeled`,\n  selected: (name) => `${name} is ready. Now tap the section where it goes.`,\n  correct: (name) => `Yes! ${name} fits that section.`,\n  correctLast: (name) => `Yes! ${name} fits that section. All four sections are labeled.`,\n  wrong: 'Not quite. Try another section.',\n  alreadyLabeled: 'That section already has a label. Try another one.',\n  needLabel: 'Pick a label first, then tap a section.',\n  reset: 'Back to the start. All four labels are in the tray.',\n  newRound: (siteName) => `New round. This page is ${siteName}, with a new layout. The labels are shuffled.`,\n  clock: (minutes, seconds) => `${minutes}:${seconds}`,\n  noBest: 'None',\n  bonus: (points) => `+${points}`,\n  resultsTitle: (round) => `Round ${round} complete`,\n  finished: (name, score) => `Yes! ${name} fits that section. All four sections are labeled. Your score is ${score}.`,\n  noteFirst: 'Nice first round! Play again to beat it.',\n  noteBest: 'New best! Play again to go even higher.',\n  noteTry: (best) => `Your best is ${best}. Can you beat it?`\n};\n\nconst state = {\n  placed: new Set(),\n  selected: null,\n  dragging: false,\n  current: null,\n  wrong: 0,\n  startedAt: null,\n  elapsedMs: 0,\n  timerId: null,\n  round: 1,\n  best: null,\n  result: null,\n  layout: null,\n  site: null,\n  screen: 'intro',\n  completed: false\n};\n\nconst refs = {\n  blocks: {},\n  stickers: {},\n  dots: {}\n};\n\nconst drag = {\n  id: null,\n  pointerId: null,\n  startX: 0,\n  startY: 0,\n  active: false,\n  over: null,\n  suppressClick: false\n};\n\nconst numberFormat = new Intl.NumberFormat();\nconst twoDigits = new Intl.NumberFormat(undefined, { minimumIntegerDigits: 2 });\n\nfunction query(selector) {\n  const element = document.querySelector(selector);\n  if (!element) {\n    throw new Error(`Missing element: ${selector}`);\n  }\n  return element;\n}\n\nfunction findBlock(id) {\n  return CONFIG.blocks.find((block) => block.id === id);\n}\n\nfunction prefersReducedMotion() {\n  return Boolean(window.matchMedia) &&\n    window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n}\n\nfunction setStatus(message) {\n  refs.status.textContent = '';\n  if (message) {\n    window.setTimeout(() => {\n      refs.status.textContent = message;\n    }, 50);\n  }\n}\n\nfunction showError() {\n  const banner = document.getElementById('error-banner');\n  if (banner) {\n    banner.hidden = false;\n  }\n}\n\nfunction playClass(element, className) {\n  if (prefersReducedMotion()) {\n    return;\n  }\n  element.classList.remove(className);\n  // Reading offsetWidth restarts the animation when the class is re-added.\n  void element.offsetWidth;\n  element.classList.add(className);\n  window.setTimeout(() => element.classList.remove(className), CONFIG.animationFallbackMs);\n}\n\nfunction allPlaced() {\n  return state.placed.size === CONFIG.blocks.length;\n}\n\n/* Timer and score */\n\nfunction clockText(ms) {\n  const totalSeconds = Math.floor(ms / 1000);\n  return COPY.clock(\n    numberFormat.format(Math.floor(totalSeconds / 60)),\n    twoDigits.format(totalSeconds % 60)\n  );\n}\n\nfunction renderClock() {\n  refs.time.textContent = clockText(state.elapsedMs);\n}\n\nfunction tick() {\n  state.elapsedMs = Date.now() - state.startedAt;\n  renderClock();\n}\n\nfunction startTimer() {\n  if (state.startedAt !== null || state.result) {\n    return;\n  }\n  state.startedAt = Date.now();\n  state.timerId = window.setInterval(tick, CONFIG.tickMs);\n}\n\nfunction stopTimer() {\n  if (state.timerId !== null) {\n    window.clearInterval(state.timerId);\n    state.timerId = null;\n  }\n}\n\nfunction liveScore() {\n  return Math.max(\n    0,\n    CONFIG.pointsPerLabel * state.placed.size - CONFIG.wrongPenalty * state.wrong\n  );\n}\n\nfunction finishRound() {\n  tick();\n  stopTimer();\n  const seconds = Math.floor(state.elapsedMs / 1000);\n  const bonus = Math.max(0, CONFIG.bonusSeconds - seconds) * CONFIG.bonusPerSecond;\n  const total = liveScore() + bonus;\n  let note = COPY.noteTry(numberFormat.format(state.best));\n  if (state.best === null) {\n    note = COPY.noteFirst;\n    state.best = total;\n  } else if (total > state.best) {\n    note = COPY.noteBest;\n    state.best = total;\n  }\n  state.result = { seconds, bonus, total, note };\n}\n\nfunction bumpScore(direction) {\n  refs.score.classList.remove('is-up', 'is-down');\n  playClass(refs.score, direction);\n}\n\nfunction render() {\n  CONFIG.blocks.forEach((block) => {\n    const element = refs.blocks[block.id];\n    const placed = state.placed.has(block.id);\n    element.dataset.state = placed ? 'done' : 'idle';\n    element.dataset.current = String(state.current === block.id);\n    element.querySelector('.tag-name').textContent = placed ? block.name : '';\n    element.querySelector('.tag-job').textContent = placed ? block.job : '';\n\n    refs.dots[block.id].dataset.filled = String(placed);\n\n    const sticker = refs.stickers[block.id];\n    sticker.dataset.placed = String(placed);\n    sticker.disabled = placed;\n    sticker.setAttribute('aria-pressed', String(state.selected === block.id));\n  });\n\n  const finished = state.result !== null;\n  refs.score.textContent = numberFormat.format(finished ? state.result.total : liveScore());\n  refs.best.textContent = state.best === null ? COPY.noBest : numberFormat.format(state.best);\n  refs.tray.hidden = finished;\n  refs.results.hidden = !finished;\n  refs.reset.hidden = finished;\n  if (finished) {\n    refs.resultsTitle.textContent = COPY.resultsTitle(numberFormat.format(state.round));\n    refs.resultTime.textContent = clockText(state.elapsedMs);\n    refs.resultWrong.textContent = numberFormat.format(state.wrong);\n    refs.resultBonus.textContent = COPY.bonus(numberFormat.format(state.result.bonus));\n    refs.resultScore.textContent = numberFormat.format(state.result.total);\n    refs.resultsNote.textContent = state.result.note;\n  }\n\n  refs.sample.dataset.carrying = String(state.selected !== null || state.dragging);\n  refs.count.textContent = COPY.progress(\n    numberFormat.format(state.placed.size),\n    numberFormat.format(CONFIG.blocks.length)\n  );\n  refs.rail.dataset.ready = String(allPlaced());\n  refs.reset.disabled = state.placed.size === 0 && state.selected === null && state.startedAt === null;\n}\n\nfunction placeLabel(id) {\n  const block = findBlock(id);\n  state.placed.add(id);\n  state.selected = null;\n  state.current = id;\n  if (allPlaced()) {\n    finishRound();\n  }\n  render();\n  playClass(refs.blocks[id], 'is-wiggling');\n  bumpScore('is-up');\n  if (allPlaced()) {\n    setStatus(COPY.finished(block.name, numberFormat.format(state.result.total)));\n    refs.finish.focus({ preventScroll: true });\n  } else {\n    setStatus(COPY.correct(block.name));\n  }\n}\n\nfunction rejectLabel(id, blockId, message, penalize) {\n  if (penalize) {\n    state.wrong += 1;\n    render();\n    bumpScore('is-down');\n  }\n  playClass(refs.blocks[blockId], 'is-wrong');\n  playClass(refs.stickers[id], 'is-wrong');\n  setStatus(message);\n}\n\nfunction tryPlace(id, blockId) {\n  if (state.placed.has(blockId)) {\n    rejectLabel(id, blockId, COPY.alreadyLabeled, false);\n    return false;\n  }\n  if (id !== blockId) {\n    rejectLabel(id, blockId, COPY.wrong, true);\n    return false;\n  }\n  placeLabel(id);\n  return true;\n}\n\n/* Tap and keyboard path */\n\nfunction handleStickerClick(id) {\n  if (drag.suppressClick) {\n    drag.suppressClick = false;\n    return;\n  }\n  if (state.placed.has(id)) {\n    return;\n  }\n  startTimer();\n  if (state.selected === id) {\n    state.selected = null;\n    render();\n    setStatus('');\n    return;\n  }\n  state.selected = id;\n  render();\n  setStatus(COPY.selected(findBlock(id).name));\n}\n\nfunction handleBlockClick(blockId) {\n  if (state.selected === null) {\n    if (!state.placed.has(blockId)) {\n      setStatus(COPY.needLabel);\n    }\n    return;\n  }\n  tryPlace(state.selected, blockId);\n}\n\nfunction handleKeydown(event) {\n  if (event.key === 'Escape' && state.selected !== null) {\n    state.selected = null;\n    render();\n    setStatus('');\n  }\n}\n\n/* Drag path */\n\nfunction blockIdAtPoint(x, y) {\n  const elements = document.elementsFromPoint(x, y);\n  for (let i = 0; i < elements.length; i += 1) {\n    const block = elements[i].closest('.page-block');\n    if (block) {\n      return block.dataset.block;\n    }\n  }\n  return null;\n}\n\nfunction setOver(blockId) {\n  if (drag.over === blockId) {\n    return;\n  }\n  if (drag.over) {\n    refs.blocks[drag.over].dataset.over = 'false';\n  }\n  drag.over = blockId;\n  if (blockId) {\n    refs.blocks[blockId].dataset.over = 'true';\n  }\n}\n\nfunction moveSticker(sticker, dx, dy) {\n  sticker.style.setProperty('--drag-x', `${dx}px`);\n  sticker.style.setProperty('--drag-y', `${dy}px`);\n}\n\nfunction endDrag(sticker) {\n  setOver(null);\n  sticker.classList.remove('is-dragging');\n  moveSticker(sticker, 0, 0);\n  drag.id = null;\n  drag.pointerId = null;\n  drag.active = false;\n  state.dragging = false;\n  render();\n}\n\nfunction handlePointerDown(event, id) {\n  if (state.placed.has(id) || (event.pointerType === 'mouse' && event.button !== 0)) {\n    return;\n  }\n  startTimer();\n  drag.id = id;\n  drag.pointerId = event.pointerId;\n  drag.startX = event.clientX;\n  drag.startY = event.clientY;\n  drag.active = false;\n  refs.stickers[id].setPointerCapture(event.pointerId);\n}\n\nfunction handlePointerMove(event, id) {\n  if (drag.id !== id || drag.pointerId !== event.pointerId) {\n    return;\n  }\n  const dx = event.clientX - drag.startX;\n  const dy = event.clientY - drag.startY;\n  const sticker = refs.stickers[id];\n\n  if (!drag.active) {\n    if (Math.hypot(dx, dy) < CONFIG.dragThresholdPx) {\n      return;\n    }\n    drag.active = true;\n    state.dragging = true;\n    state.selected = null;\n    sticker.classList.add('is-dragging');\n    render();\n    setStatus('');\n  }\n\n  moveSticker(sticker, dx, dy);\n  setOver(blockIdAtPoint(event.clientX, event.clientY));\n}\n\nfunction handlePointerUp(event, id) {\n  if (drag.id !== id || drag.pointerId !== event.pointerId) {\n    return;\n  }\n  const sticker = refs.stickers[id];\n  if (!drag.active) {\n    drag.id = null;\n    drag.pointerId = null;\n    return;\n  }\n  const target = blockIdAtPoint(event.clientX, event.clientY);\n  drag.suppressClick = true;\n  window.setTimeout(() => {\n    drag.suppressClick = false;\n  }, 0);\n  endDrag(sticker);\n  if (target) {\n    tryPlace(id, target);\n  }\n}\n\nfunction handlePointerCancel(event, id) {\n  if (drag.id !== id) {\n    return;\n  }\n  endDrag(refs.stickers[id]);\n}\n\nfunction chooseDifferent(list, current) {\n  const options = list\n    .map((item, index) => index)\n    .filter((index) => index !== current);\n  return options[Math.floor(Math.random() * options.length)];\n}\n\nfunction chooseLayout() {\n  return chooseDifferent(CONFIG.layouts, state.layout);\n}\n\nfunction chooseSite() {\n  return chooseDifferent(CONFIG.sites, state.site);\n}\n\nfunction slot(name) {\n  return refs.sample.querySelector(`[data-slot=\"${name}\"]`);\n}\n\nfunction applySite(index) {\n  state.site = index;\n  const site = CONFIG.sites[index];\n  refs.sample.dataset.site = site.id;\n  refs.sample.setAttribute('aria-label', site.label);\n  refs.pageName.textContent = site.name;\n  slot('hero-title').textContent = site.heroTitle;\n  slot('cta-text').textContent = site.ctaText;\n  slot('cta-button').textContent = site.ctaButton;\n  slot('hero-art').setAttribute('href', `#hero-${site.id}`);\n  slot('canvas-art').setAttribute('href', `#canvas-${site.id}`);\n  [1, 2, 3].forEach((number) => {\n    slot(`card-${number}`).setAttribute('href', `#card-${site.id}-${number}`);\n  });\n  Object.keys(site.desc).forEach((part) => {\n    slot(`desc-${part}`).textContent = site.desc[part];\n  });\n}\n\nfunction applyLayout(index) {\n  state.layout = index;\n  refs.pageBody.textContent = '';\n  CONFIG.layouts[index].forEach((ids) => {\n    const row = document.createElement('div');\n    row.className = 'page-row';\n    row.dataset.columns = String(ids.length);\n    ids.forEach((id) => row.appendChild(refs.blocks[id]));\n    refs.pageBody.appendChild(row);\n  });\n}\n\nfunction shuffleTray() {\n  const ids = CONFIG.blocks.map((block) => block.id);\n  for (let i = ids.length - 1; i > 0; i -= 1) {\n    const j = Math.floor(Math.random() * (i + 1));\n    [ids[i], ids[j]] = [ids[j], ids[i]];\n  }\n  ids.forEach((id) => refs.tray.appendChild(refs.stickers[id]));\n}\n\nfunction handleReset() {\n  const wasFinished = state.result !== null;\n  stopTimer();\n  state.placed.clear();\n  state.selected = null;\n  state.current = null;\n  state.wrong = 0;\n  state.startedAt = null;\n  state.elapsedMs = 0;\n  state.result = null;\n  CONFIG.blocks.forEach((block) => {\n    refs.blocks[block.id].classList.remove('is-wiggling', 'is-wrong');\n  });\n  if (wasFinished) {\n    state.round += 1;\n    applySite(chooseSite());\n    applyLayout(chooseLayout());\n    playClass(refs.pageBody, 'is-swapping');\n  }\n  shuffleTray();\n  render();\n  renderClock();\n  setStatus(wasFinished ? COPY.newRound(CONFIG.sites[state.site].name) : COPY.reset);\n  if (wasFinished) {\n    refs.tray.firstElementChild.focus({ preventScroll: true });\n  }\n}\n\n/* Screens */\n\nfunction showScreen(name) {\n  state.screen = name;\n  Object.keys(refs.screens).forEach((key) => {\n    refs.screens[key].hidden = key !== name;\n  });\n}\n\nfunction handleStart() {\n  showScreen('activity');\n  refs.tray.firstElementChild.focus({ preventScroll: true });\n}\n\nfunction handleFinish() {\n  if (state.completed || state.result === null) {\n    return;\n  }\n  state.completed = true;\n  setStatus('');\n  showScreen('takeaway');\n  refs.takeawayTitle.focus({ preventScroll: true });\n  document.dispatchEvent(new CustomEvent('widget:complete'));\n  if (window.parent !== window) {\n    window.parent.postMessage({ type: 'widget-complete' }, '*');\n  }\n}\n\n/* Setup */\n\nfunction buildRecap() {\n  const list = query('#recap-labels');\n  CONFIG.blocks.forEach((block) => {\n    const item = document.createElement('li');\n    item.className = 'recap-label';\n    item.dataset.label = block.id;\n\n    const name = document.createElement('span');\n    name.className = 'tag-name';\n    name.textContent = block.name;\n    const job = document.createElement('span');\n    job.className = 'tag-job';\n    job.textContent = block.job;\n    item.appendChild(name);\n    item.appendChild(job);\n    list.appendChild(item);\n  });\n}\n\nfunction buildDots() {\n  const list = query('#progress-dots');\n  CONFIG.blocks.forEach((block) => {\n    const dot = document.createElement('li');\n    dot.className = 'dot';\n    list.appendChild(dot);\n    refs.dots[block.id] = dot;\n  });\n}\n\nfunction buildTray() {\n  const tray = refs.tray;\n  CONFIG.trayOrder.forEach((id) => {\n    const block = findBlock(id);\n    const sticker = document.createElement('button');\n    sticker.type = 'button';\n    sticker.className = 'sticker';\n    sticker.dataset.sticker = id;\n    sticker.setAttribute('aria-pressed', 'false');\n\n    const name = document.createElement('span');\n    name.className = 'tag-name';\n    name.textContent = block.name;\n    const job = document.createElement('span');\n    job.className = 'tag-job';\n    job.textContent = block.job;\n    sticker.appendChild(name);\n    sticker.appendChild(job);\n\n    sticker.addEventListener('click', () => handleStickerClick(id));\n    sticker.addEventListener('pointerdown', (event) => handlePointerDown(event, id));\n    sticker.addEventListener('pointermove', (event) => handlePointerMove(event, id));\n    sticker.addEventListener('pointerup', (event) => handlePointerUp(event, id));\n    sticker.addEventListener('pointercancel', (event) => handlePointerCancel(event, id));\n    sticker.addEventListener('animationend', (event) => {\n      if (event.target === sticker) {\n        sticker.classList.remove('is-wrong');\n      }\n    });\n\n    tray.appendChild(sticker);\n    refs.stickers[id] = sticker;\n  });\n}\n\nfunction bindBlocks() {\n  CONFIG.blocks.forEach((block) => {\n    const element = query(`[data-block=\"${block.id}\"]`);\n    element.addEventListener('click', () => handleBlockClick(block.id));\n    element.addEventListener('animationend', (event) => {\n      if (event.target === element) {\n        element.classList.remove('is-wiggling', 'is-wrong');\n      }\n    });\n    refs.blocks[block.id] = element;\n  });\n}\n\nfunction init() {\n  refs.sample = query('#sample-page');\n  refs.pageBody = query('#page-body');\n  refs.pageName = query('#page-name');\n  refs.rail = query('#rail');\n  refs.status = query('#status');\n  refs.count = query('#progress-count');\n  refs.reset = query('#reset-button');\n  refs.play = query('#play-button');\n  refs.finish = query('#finish-button');\n  refs.start = query('#start-button');\n  refs.takeawayTitle = query('#takeaway-title');\n  refs.screens = {\n    intro: query('#intro-screen'),\n    activity: query('#activity-screen'),\n    takeaway: query('#takeaway-screen')\n  };\n  refs.tray = query('#tray');\n  refs.time = query('#time-value');\n  refs.score = query('#score-value');\n  refs.best = query('#best-value');\n  refs.results = query('#results');\n  refs.resultsTitle = query('#results-title');\n  refs.resultTime = query('#result-time');\n  refs.resultWrong = query('#result-wrong');\n  refs.resultBonus = query('#result-bonus');\n  refs.resultScore = query('#result-score');\n  refs.resultsNote = query('#results-note');\n\n  bindBlocks();\n  applySite(chooseSite());\n  applyLayout(chooseLayout());\n  buildDots();\n  buildTray();\n  buildRecap();\n  refs.start.addEventListener('click', handleStart);\n  refs.reset.addEventListener('click', handleReset);\n  refs.play.addEventListener('click', handleReset);\n  refs.finish.addEventListener('click', handleFinish);\n  document.addEventListener('keydown', handleKeydown);\n  showScreen('intro');\n  render();\n  renderClock();\n}\n\ntry {\n  init();\n} catch (error) {\n  showError();\n}\n",
