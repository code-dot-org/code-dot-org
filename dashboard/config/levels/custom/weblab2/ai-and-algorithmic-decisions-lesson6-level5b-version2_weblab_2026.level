      "files": {
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "* {\n    box-sizing: border-box;\n    margin: 0;\n    padding: 0;\n}\n\nbody {\n    font-family: 'Segoe UI', Roboto, Arial, sans-serif;\n    background: #0a0a0a;\n    color: white;\n    line-height: 1.4;\n}\n\nimg {\n    display: block;\n    max-width: 100%;\n}\n\n.app-shell {\n    width: min(100%, 1100px);\n    margin: 0 auto;\n    background: #121212;\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n    box-shadow: 0 0 50px rgba(0,0,0,0.5);\n}\n\n.navbar {\n    background: #1a1a1a;\n    padding: 12px 20px;\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    border-bottom: 1px solid #333;\n}\n\n.nav-logo {\n    width: 32px;\n    height: 32px;\n}\n\n.navbar h1 {\n    font-size: 1.2rem;\n}\n\n.status-panel {\n    background: #181818;\n    padding: 20px;\n    border-bottom: 2px solid #333;\n    display: flex;\n    gap: 40px;\n}\n\n.status-label {\n    font-size: 0.7rem;\n    text-transform: uppercase;\n    letter-spacing: 1.5px;\n    color: #888;\n    margin-bottom: 4px;\n}\n\n.status-panel h2 {\n    font-size: 1.8rem;\n    font-weight: 800;\n    color: #fff;\n}\n\n#damageDisplay {\n    color: #ff4444;\n}\n\n.hero-banner {\n    height: 300px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background-color: #000;\n    border-bottom: 1px solid #333;\n    overflow: hidden;\n}\n\n.target-img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    filter: drop-shadow(0 0 15px rgba(255, 68, 68, 0.4));\n    transition: transform 0.1s ease;\n}\n\n.target-img:active {\n    transform: scale(1.05);\n}\n\n.menu-section {\n    padding: 24px;\n}\n\n.menu-section h3 {\n    margin-bottom: 20px;\n    font-size: 0.9rem;\n    color: #666;\n    text-transform: uppercase;\n    letter-spacing: 2px;\n    text-align: center;\n}\n\n.menu-item {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 24px;\n    max-width: 800px;\n    margin: 0 auto;\n}\n\nbutton.attack-btn {\n    background: none;\n    border: none;\n    padding: 0;\n    color: white;\n    cursor: pointer;\n    text-align: center;\n    transition: transform 0.2s ease;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n}\n\nbutton.attack-btn img {\n    width: 100%;\n    max-width: 160px;\n    aspect-ratio: 1 / 1;\n    object-fit: cover;\n    border-radius: 12px;\n    margin-bottom: 12px;\n    filter: grayscale(20%) brightness(0.8);\n    transition: all 0.3s ease;\n    border: 1px solid #333;\n}\n\n.move-name {\n    display: block;\n    font-size: 1rem;\n    font-weight: bold;\n    margin-bottom: 4px;\n    letter-spacing: 0.5px;\n}\n\n.move-damage {\n    display: block;\n    font-size: 0.85rem;\n    color: #ff4444;\n    font-weight: bold;\n    text-transform: uppercase;\n    opacity: 0.9;\n}\n\nbutton.attack-btn:hover img {\n    filter: grayscale(0%) brightness(1.1);\n    transform: translateY(-8px);\n    border-color: #555;\n    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.6);\n}\n\nbutton.attack-btn:active {\n    transform: scale(0.95);\n}\n\n.selected img {\n    filter: grayscale(0%) brightness(1.2) !important;\n    outline: 3px solid #ff3c3c;\n    outline-offset: 4px;\n    box-shadow: 0 0 25px rgba(255, 60, 60, 0.3);\n    border-color: #ff3c3c !important;\n}\n\n.selected .move-name {\n    color: #ff3c3c;\n}\n\n@media (min-width: 800px) {\n    .menu-item {\n        grid-template-columns: repeat(4, 1fr);\n    }\n    \n    .hero-banner {\n        height: 400px;\n    }\n}\n\n@media (max-width: 500px) {\n    .menu-item {\n        grid-template-columns: 1fr 1fr;\n        gap: 16px;\n    }\n\n    button.attack-btn img {\n        max-width: 140px;\n    }\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const slashBtn = document.getElementById('slashBtn');\nconst fireballBtn = document.getElementById('fireballBtn');\nconst thunderBtn = document.getElementById('thunderBtn');\nconst abyssalBtn = document.getElementById('abyssalBtn');\n\nslashBtn.addEventListener(\"click\", () => {\n    // call your function here\n});\nfireballBtn.addEventListener(\"click\", () => {\n    // call your function here\n});\nthunderBtn.addEventListener(\"click\", () => {\n    // call your function here\n});\nabyssalBtn.addEventListener(\"click\", () => {\n    // call your function here\n});\n",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Battle Simulator</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n<div class=\"app-shell\">\n    <header class=\"fixed-top\">\n        <nav class=\"navbar\">\n            <img src=\"images/logo.png\" alt=\"Logo\" class=\"nav-logo\">\n            <h1>Battle Simulator</h1>\n        </nav>\n        <div class=\"status-panel\">\n            <div class=\"status-block\">\n                <p class=\"status-label\">Last Move</p>\n                <h2 id=\"attackDisplay\">Waiting...</h2>\n            </div>\n            <div class=\"status-block\">\n                <p class=\"status-label\">Damage Dealt</p>\n                <h2 id=\"damageDisplay\">0</h2>\n            </div>\n        </div>\n    </header>\n    <main class=\"scroll-content\">\n        <div class=\"hero-banner\">\n            <img src=\"images/enemy-boss.png\" alt=\"Enemy Boss\" class=\"target-img\">\n        </div>\n        <section class=\"menu-section\">\n            <h3>Select Attack</h3>\n            <div class=\"menu-item\">\n                <button id=\"slashBtn\" class=\"attack-btn\">\n                    <img src=\"images/move-slash.jpg\" alt=\"Slash\">\n                    <span class=\"move-name\">Heavy Slash</span>\n                    <span class=\"move-damage\">25 DMG</span>\n                </button>\n                <button id=\"fireballBtn\" class=\"attack-btn\">\n                    <img src=\"images/move-fireball.jpg\" alt=\"Fireball\">\n                    <span class=\"move-name\">Fireball</span>\n                    <span class=\"move-damage\">45 DMG</span>\n                </button>\n                <button id=\"thunderBtn\" class=\"attack-btn\">\n                    <img src=\"images/move-thunder.jpg\" alt=\"Thunder\">\n                    <span class=\"move-name\">Thunderbolt</span>\n                    <span class=\"move-damage\">60 DMG</span>\n                </button>\n                <button id=\"abyssalBtn\" class=\"attack-btn\">\n                    <img src=\"images/move-execute.jpg\" alt=\"Execute\">\n                    <span class=\"move-name\">Abyssal Strike</span>\n                    <span class=\"move-damage\">99 DMG</span>\n                </button>\n            </div>\n        </section>\n    </main>\n</div>\n<script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "active": false
        },
