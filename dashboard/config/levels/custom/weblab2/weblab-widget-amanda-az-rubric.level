    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Review the Project: Mood Playlist Picker</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n<div class=\"top-bar\">\n  <div class=\"top-bar-left\">Lesson 12: Reactive Logic Project — Sample: Mood Playlist Picker</div>\n  <div class=\"top-bar-right\">\n    <div class=\"fake-btn\">Share</div>\n    <div class=\"fake-btn\">Remix</div>\n  </div>\n</div>\n\n<div class=\"main-layout\">\n\n  <div class=\"rubric-panel\">\n    <h2>Project Rubric</h2>\n    <div class=\"rubric-sub\">Click a category to review all four tiers.</div>\n    <div id=\"rubricList\"></div>\n    <div class=\"score-tally\">\n      <div class=\"score-label\">YOUR ASSESSMENT SCORE</div>\n      <div class=\"score-value\" id=\"scoreValue\">0 <span>/ 20</span></div>\n    </div>\n  </div>\n\n  <div class=\"workspace\">\n    <div class=\"view-toggle-row\">\n      <button type=\"button\" class=\"view-toggle-btn active\" id=\"codeViewBtn\">Code</button>\n      <button type=\"button\" class=\"view-toggle-btn\" id=\"previewViewBtn\">Preview</button>\n    </div>\n\n    <div id=\"codeView\">\n      <div class=\"file-tabs\" id=\"fileTabs\"></div>\n      <div class=\"code-area\" id=\"codeArea\"></div>\n    </div>\n\n    <div id=\"previewView\" style=\"display:none;\">\n      <div class=\"preview-area\">\n        <div class=\"preview-frame\">\n          <div class=\"preview-browser-bar\"><span></span><span></span><span></span></div>\n          <div class=\"app-page\" id=\"appPage\">\n            <h2>Mood Playlist Picker</h2>\n            <div class=\"mood-buttons\">\n              <button type=\"button\" class=\"mood-btn\" id=\"happyButton\">Happy</button>\n              <button type=\"button\" class=\"mood-btn\" id=\"chillButton\">Chill</button>\n              <button type=\"button\" class=\"mood-btn\" id=\"sadButton\">Sad</button>\n            </div>\n            <div class=\"playlist-display\" id=\"playlistText\">Pick a mood to see your playlist</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n</div>\n\n<script src=\"script.js\"></script>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "@import url('https://fonts.googleapis.com/css2?family=Geist:wght@400;500;700&display=swap');\n\n* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  padding: 0;\n  font-family: 'Geist', system-ui, sans-serif;\n  background-color: #FFFFFF;\n  color: #222222;\n}\n\n/* Top bar */\n.top-bar {\n  background-color: #4C42CF;\n  padding: 10px 20px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 10px;\n}\n.top-bar-left {\n  color: #FFFFFF;\n  font-weight: 700;\n  font-size: 14px;\n}\n.top-bar-right {\n  display: flex;\n  gap: 8px;\n}\n.fake-btn {\n  background-color: rgba(255,255,255,0.15);\n  color: #FFFFFF;\n  font-size: 12px;\n  font-weight: 600;\n  padding: 5px 12px;\n  border-radius: 6px;\n}\n\n/* Main layout */\n.main-layout {\n  display: flex;\n  flex-wrap: wrap;\n  min-height: 600px;\n}\n\n/* Rubric panel (left, dark, mimics instructions panel) */\n.rubric-panel {\n  background-color: #1E1E2E;\n  color: #E4E2F8;\n  width: 340px;\n  flex-shrink: 0;\n  padding: 18px;\n}\n.rubric-panel h2 {\n  color: #FFFFFF;\n  font-size: 16px;\n  margin: 0 0 6px 0;\n}\n.rubric-panel .rubric-sub {\n  font-size: 12px;\n  color: #ACA8EA;\n  margin-bottom: 16px;\n}\n.rubric-item {\n  background-color: #2B2745;\n  border-radius: 8px;\n  margin-bottom: 8px;\n  overflow: hidden;\n}\n.rubric-item-header {\n  width: 100%;\n  text-align: left;\n  background: none;\n  border: none;\n  color: #FFFFFF;\n  font-family: 'Geist', system-ui, sans-serif;\n  font-size: 13px;\n  font-weight: 600;\n  padding: 10px 12px;\n  cursor: pointer;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.rubric-item-header:hover { background-color: #34304F; }\n.rubric-item.open .rubric-item-header { background-color: #4C42CF; }\n.rubric-item-header .arrow { transition: transform 0.15s ease; font-size: 11px; }\n.rubric-item.open .rubric-item-header .arrow { transform: rotate(90deg); }\n.rubric-item-body {\n  display: none;\n  padding: 10px 12px 14px 12px;\n  font-size: 12px;\n  line-height: 1.5;\n}\n.rubric-item.open .rubric-item-body { display: block; }\n.tier-option {\n  display: block;\n  width: 100%;\n  text-align: left;\n  background: none;\n  border: 1px solid #3A3660;\n  border-radius: 6px;\n  color: #E4E2F8;\n  font-family: 'Geist', system-ui, sans-serif;\n  font-size: 12px;\n  line-height: 1.5;\n  padding: 8px 10px;\n  margin-bottom: 6px;\n  cursor: pointer;\n}\n.tier-option:last-child { margin-bottom: 0; }\n.tier-option:hover { background-color: #34304F; }\n.tier-option b { color: #ACA8EA; }\n.tier-option.selected {\n  background-color: #4C42CF;\n  border-color: #4C42CF;\n}\n.tier-option.selected b { color: #FFFFFF; }\n\n.category-selected-tag {\n  font-size: 10px;\n  font-weight: 700;\n  padding: 2px 8px;\n  border-radius: 10px;\n  background-color: #34BD43;\n  color: #FFFFFF;\n  margin-left: 8px;\n  display: none;\n}\n.rubric-item.has-selection .category-selected-tag { display: inline-block; }\n\n.score-tally {\n  background-color: #2B2745;\n  border-radius: 8px;\n  padding: 12px 14px;\n  margin-top: 14px;\n  font-size: 13px;\n  color: #FFFFFF;\n}\n.score-tally .score-label {\n  font-size: 11px;\n  color: #ACA8EA;\n  margin-bottom: 4px;\n}\n.score-tally .score-value {\n  font-size: 22px;\n  font-weight: 700;\n}\n.score-tally .score-value span {\n  font-size: 14px;\n  font-weight: 400;\n  color: #ACA8EA;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  * { transition: none !important; }\n}\n\n/* Workspace (right side) */\n.workspace {\n  flex: 1;\n  min-width: 320px;\n  display: flex;\n  flex-direction: column;\n}\n\n.icon-rail {\n  display: none;\n}\n\n.view-toggle-row {\n  background-color: #F7F7FB;\n  border-bottom: 1px solid #E4E2F8;\n  padding: 8px 16px;\n  display: flex;\n  gap: 8px;\n}\n.view-toggle-btn {\n  font-family: 'Geist', system-ui, sans-serif;\n  font-size: 13px;\n  font-weight: 600;\n  padding: 6px 14px;\n  border-radius: 6px;\n  border: 1px solid #E4E2F8;\n  background-color: #FFFFFF;\n  color: #555555;\n  cursor: pointer;\n}\n.view-toggle-btn.active {\n  background-color: #4C42CF;\n  color: #FFFFFF;\n  border-color: #4C42CF;\n}\n\n.file-tabs {\n  display: flex;\n  background-color: #171721;\n  overflow-x: auto;\n}\n.file-tab {\n  font-family: 'Geist', system-ui, sans-serif;\n  font-size: 13px;\n  padding: 10px 16px;\n  background-color: #171721;\n  color: #888888;\n  border: none;\n  cursor: pointer;\n  white-space: nowrap;\n  border-top: 2px solid transparent;\n}\n.file-tab:hover { background-color: #232338; }\n.file-tab.active {\n  background-color: #1E1E2E;\n  color: #FFFFFF;\n  border-top: 2px solid #4C42CF;\n}\n.file-tab .dot {\n  display: inline-block;\n  width: 7px;\n  height: 7px;\n  border-radius: 2px;\n  margin-right: 6px;\n}\n\n.code-area {\n  background-color: #1E1E2E;\n  color: #E4E2F8;\n  font-family: 'Courier New', monospace;\n  font-size: 14px;\n  line-height: 1.7;\n  padding: 18px 20px;\n  flex: 1;\n  white-space: pre-wrap;\n  overflow-x: auto;\n}\n.code-area .tag { color: #E11970; }\n.code-area .attr { color: #0099F3; }\n.code-area .selector { color: #34BD43; font-weight: bold; }\n.code-area .kw { color: #E11970; }\n.code-area .str { color: #34BD43; }\n.code-area .comment { color: #7C7C90; font-style: italic; }\n.code-area .md-header { color: #0099F3; font-weight: bold; }\n\n.preview-area {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background-color: #F0F0F5;\n  padding: 20px;\n}\n.preview-frame {\n  background-color: #FFFFFF;\n  border-radius: 10px;\n  overflow: hidden;\n  width: 100%;\n  max-width: 480px;\n  box-shadow: none;\n  border: 1px solid #E4E2F8;\n}\n.preview-browser-bar {\n  background-color: #F7F7FB;\n  padding: 8px 12px;\n  border-bottom: 1px solid #E4E2F8;\n  display: flex;\n  gap: 6px;\n}\n.preview-browser-bar span {\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n  background-color: #E4E2F8;\n  display: inline-block;\n}\n.app-page {\n  padding: 30px 24px;\n  text-align: center;\n  transition: background-color 0.3s ease;\n}\n.app-page h2 {\n  font-size: 18px;\n  color: #222222;\n  margin: 0 0 16px 0;\n}\n.mood-buttons {\n  display: flex;\n  gap: 10px;\n  justify-content: center;\n  margin-bottom: 20px;\n}\n.mood-btn {\n  font-family: 'Geist', system-ui, sans-serif;\n  font-size: 14px;\n  font-weight: 500;\n  background-color: #FFFFFF;\n  color: #222222;\n  border: 1.5px solid #CCCCCC;\n  border-radius: 8px;\n  padding: 10px 18px;\n  cursor: pointer;\n}\n.mood-btn:hover { background-color: #F0F0F0; }\n.playlist-display {\n  font-size: 18px;\n  font-weight: 700;\n  color: #222222;\n  min-height: 26px;\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "/* ---------- Rubric data ---------- */\nconst rubric = [\n  {\n    name: \"Algorithmic Planning\",\n    tiers: [\n      [\"Extensive\", \"Flowchart or pseudocode includes multiple layers of logic or alternate user paths; criteria are detailed and anticipate complex user behaviors.\"],\n      [\"Convincing\", \"Flowchart or pseudocode clearly models the app's logic, with branches and decision points that match app behavior; all outcome criteria are defined.\"],\n      [\"Limited\", \"Flowchart shows basic structure but some branches or decision points don't align with intended app behavior; outcome criteria are partially defined.\"],\n      [\"No evidence\", \"Flowchart or pseudocode is incomplete or missing, with unclear or missing decision points; outcome criteria are not defined.\"]\n    ]\n  },\n  {\n    name: \"Conditional Logic Implementation\",\n    tiers: [\n      [\"Extensive\", \"Code demonstrates efficient use of if/else structures to handle complex app conditions; features update accurately and consistently.\"],\n      [\"Convincing\", \"JavaScript correctly implements the planned conditional logic using if/else; features update reliably based on user input.\"],\n      [\"Limited\", \"Code includes basic if/else statements, but some feature updates occur inconsistently or do not fully match the planned logic.\"],\n      [\"No evidence\", \"Code lacks functional if/else statements or does not reflect the flowchart's logic; features do not update correctly.\"]\n    ]\n  },\n  {\n    name: \"State Management and DOM Manipulation\",\n    tiers: [\n      [\"Extensive\", \"Code demonstrates robust state management, efficiently updating multiple DOM elements in real time to create a smooth, responsive experience.\"],\n      [\"Convincing\", \"Variables accurately track user selections or totals; DOM updates dynamically to reflect user interactions.\"],\n      [\"Limited\", \"Variables track some user input but DOM updates are incomplete, inconsistent, or hardcoded.\"],\n      [\"No evidence\", \"Code does not track user state; DOM elements remain static even when users interact with the app.\"]\n    ]\n  },\n  {\n    name: \"Code Organization and Structure\",\n    tiers: [\n      [\"Extensive\", \"Code is modular and efficient, with well-structured functions, organized event listeners, and clear, consistent commenting that explains design choices.\"],\n      [\"Convincing\", \"Functions (e.g., checkCriteria()) encapsulate main logic; event listeners work correctly; code is readable and includes basic comments.\"],\n      [\"Limited\", \"Some functions or event listeners are used, but logic may be misplaced or inconsistently triggered; code readability is limited.\"],\n      [\"No evidence\", \"Code is unstructured or repetitive; lacks dedicated functions or event listeners; minimal formatting or comments.\"]\n    ]\n  },\n  {\n    name: \"Process and Reflection\",\n    tiers: [\n      [\"Extensive\", \"Reflection is detailed and insightful, linking process artifacts, AI collaboration, and design decisions to the final outcome; evaluates effectiveness and ethics of AI use.\"],\n      [\"Convincing\", \"Reflection references planning artifacts, includes at least two examples of how AI supported brainstorming/debugging, and evaluates the final app's success.\"],\n      [\"Limited\", \"Some planning artifacts included; reflection briefly mentions AI but lacks specific examples or insights.\"],\n      [\"No evidence\", \"Few or no planning artifacts; reflection is missing or lacks detail about the process or AI use.\"]\n    ]\n  }\n];\n\nconst rubricList = document.getElementById('rubricList');\nrubric.forEach((cat, i) => {\n  const item = document.createElement('div');\n  item.className = 'rubric-item';\n  const tiersHtml = cat.tiers.map((t, tIdx) => `<button type=\"button\" class=\"tier-option\" data-cat=\"${i}\" data-tier=\"${tIdx}\"><b>${t[0]}:</b> ${t[1]}</button>`).join('');\n  item.innerHTML = `\n    <button type=\"button\" class=\"rubric-item-header\" data-idx=\"${i}\">\n      <span>${cat.name}<span class=\"category-selected-tag\" id=\"tag-${i}\"></span></span>\n      <span class=\"arrow\">&#9656;</span>\n    </button>\n    <div class=\"rubric-item-body\">${tiersHtml}</div>\n  `;\n  rubricList.appendChild(item);\n});\n\nrubricList.querySelectorAll('.rubric-item-header').forEach(btn => {\n  btn.addEventListener('click', () => {\n    const item = btn.closest('.rubric-item');\n    const wasOpen = item.classList.contains('open');\n    document.querySelectorAll('.rubric-item').forEach(i => i.classList.remove('open'));\n    if (!wasOpen) item.classList.add('open');\n  });\n});\n\nconst tierPoints = { 0: 4, 1: 3, 2: 2, 3: 1 }; // Extensive, Convincing, Limited, No evidence\nconst selections = {};\n\nfunction updateScore() {\n  let total = 0;\n  Object.values(selections).forEach(tierIdx => { total += tierPoints[tierIdx]; });\n  document.getElementById('scoreValue').innerHTML = total + ' <span>/ 20</span>';\n}\n\nrubricList.querySelectorAll('.tier-option').forEach(opt => {\n  opt.addEventListener('click', (e) => {\n    e.stopPropagation();\n    const catIdx = opt.dataset.cat;\n    const tierIdx = opt.dataset.tier;\n    const item = opt.closest('.rubric-item');\n\n    item.querySelectorAll('.tier-option').forEach(o => o.classList.remove('selected'));\n    opt.classList.add('selected');\n    item.classList.add('has-selection');\n\n    const tag = document.getElementById('tag-' + catIdx);\n    tag.textContent = rubric[catIdx].tiers[tierIdx][0];\n\n    selections[catIdx] = parseInt(tierIdx, 10);\n    updateScore();\n  });\n});\n\n/* ---------- File tabs / code ---------- */\nconst files = {\n  \"planning.md\": {\n    dot: \"#0099F3\",\n    render: () => `<span class=\"md-header\"># App Idea</span>\nMood Playlist Picker: a user picks a mood, and the app shows a matching playlist and background color.\n\n<span class=\"md-header\">---</span>\n\n<span class=\"md-header\">## Planning</span>\nSTART\nAsk user to pick a mood (happy, chill)\nIF mood is happy\n  show upbeat playlist\nIF mood is chill\n  show lofi playlist\nEND`\n  },\n  \"index.html\": {\n    dot: \"#E44D26\",\n    render: () => `&lt;<span class=\"tag\">!DOCTYPE html</span>&gt;\n&lt;<span class=\"tag\">html</span> <span class=\"attr\">lang</span>=\"en\"&gt;\n&lt;<span class=\"tag\">head</span>&gt;\n  &lt;<span class=\"tag\">title</span>&gt;Mood Playlist Picker&lt;/<span class=\"tag\">title</span>&gt;\n  &lt;<span class=\"tag\">link</span> <span class=\"attr\">rel</span>=\"stylesheet\" <span class=\"attr\">href</span>=\"style.css\"&gt;\n&lt;/<span class=\"tag\">head</span>&gt;\n&lt;<span class=\"tag\">body</span>&gt;\n  &lt;<span class=\"tag\">h2</span>&gt;Mood Playlist Picker&lt;/<span class=\"tag\">h2</span>&gt;\n  &lt;<span class=\"tag\">div</span> <span class=\"attr\">class</span>=\"mood-buttons\"&gt;\n    &lt;<span class=\"tag\">button</span> <span class=\"attr\">id</span>=\"happyButton\"&gt;Happy&lt;/<span class=\"tag\">button</span>&gt;\n    &lt;<span class=\"tag\">button</span> <span class=\"attr\">id</span>=\"chillButton\"&gt;Chill&lt;/<span class=\"tag\">button</span>&gt;\n    &lt;<span class=\"tag\">button</span> <span class=\"attr\">id</span>=\"sadButton\"&gt;Sad&lt;/<span class=\"tag\">button</span>&gt;\n  &lt;/<span class=\"tag\">div</span>&gt;\n  &lt;<span class=\"tag\">div</span> <span class=\"attr\">id</span>=\"playlistText\"&gt;Pick a mood to see your playlist&lt;/<span class=\"tag\">div</span>&gt;\n  &lt;<span class=\"tag\">script</span> <span class=\"attr\">src</span>=\"script.js\"&gt;&lt;/<span class=\"tag\">script</span>&gt;\n&lt;/<span class=\"tag\">body</span>&gt;\n&lt;/<span class=\"tag\">html</span>&gt;`\n  },\n  \"style.css\": {\n    dot: \"#264DE4\",\n    render: () => `<span class=\"selector\">body</span> {\n  font-family: sans-serif;\n  text-align: center;\n  padding: 30px;\n}\n\n<span class=\"selector\">.mood-buttons</span> {\n  margin-bottom: 20px;\n}\n\n<span class=\"selector\">button</span> {\n  padding: 10px 18px;\n  margin: 0 5px;\n  border-radius: 8px;\n  border: 1px solid #ccc;\n  cursor: pointer;\n}`\n  },\n  \"script.js\": {\n    dot: \"#F0DB4F\",\n    render: () => `<span class=\"kw\">let</span> mood = <span class=\"str\">\"\"</span>;\n\n<span class=\"kw\">function</span> showPlaylist() {\n  <span class=\"kw\">const</span> playlistText = document.getElementById(<span class=\"str\">'playlistText'</span>);\n\n  <span class=\"kw\">if</span> (mood === <span class=\"str\">\"happy\"</span>) {\n    playlistText.textContent = <span class=\"str\">\"Upbeat Anthems\"</span>;\n    document.body.style.backgroundColor = <span class=\"str\">\"#FFE3CE\"</span>;\n  } <span class=\"kw\">else if</span> (mood === <span class=\"str\">\"chill\"</span>) {\n    playlistText.textContent = <span class=\"str\">\"Lo-Fi Focus\"</span>;\n    document.body.style.backgroundColor = <span class=\"str\">\"#D5EFFF\"</span>;\n  } <span class=\"kw\">else</span> {\n    playlistText.textContent = <span class=\"str\">\"Rainy Day Ballads\"</span>;\n    document.body.style.backgroundColor = <span class=\"str\">\"#CBD6E3\"</span>;\n  }\n}\n\nhappyButton.addEventListener(<span class=\"str\">\"click\"</span>, () =&gt; { mood = <span class=\"str\">\"happy\"</span>; showPlaylist(); });\nchillButton.addEventListener(<span class=\"str\">\"click\"</span>, () =&gt; { mood = <span class=\"str\">\"chill\"</span>; showPlaylist(); });\nsadButton.addEventListener(<span class=\"str\">\"click\"</span>, () =&gt; { mood = <span class=\"str\">\"sad\"</span>; showPlaylist(); });`\n  },\n  \"reflection.md\": {\n    dot: \"#0099F3\",\n    render: () => `<span class=\"md-header\"># Reflection</span>\n\n<span class=\"comment\">\"For this project I used AI to help me write the if/else code because I wasn't sure how to make the background color change. It worked pretty well after I told it what colors I wanted. I think my app turned out okay.\"</span>`\n  }\n};\n\nconst fileTabs = document.getElementById('fileTabs');\nconst codeArea = document.getElementById('codeArea');\n\nObject.keys(files).forEach((name, i) => {\n  const tab = document.createElement('button');\n  tab.type = 'button';\n  tab.className = 'file-tab' + (i === 1 ? ' active' : '');\n  tab.innerHTML = `<span class=\"dot\" style=\"background-color:${files[name].dot};\"></span>${name}`;\n  tab.addEventListener('click', () => showFile(name));\n  tab.dataset.file = name;\n  fileTabs.appendChild(tab);\n});\n\nfunction showFile(name) {\n  codeArea.innerHTML = files[name].render();\n  document.querySelectorAll('.file-tab').forEach(t => {\n    t.classList.toggle('active', t.dataset.file === name);\n  });\n}\nshowFile('index.html');\n\n/* ---------- Code/Preview toggle ---------- */\nconst codeViewBtn = document.getElementById('codeViewBtn');\nconst previewViewBtn = document.getElementById('previewViewBtn');\nconst codeView = document.getElementById('codeView');\nconst previewView = document.getElementById('previewView');\n\ncodeViewBtn.addEventListener('click', () => {\n  codeViewBtn.classList.add('active');\n  previewViewBtn.classList.remove('active');\n  codeView.style.display = 'block';\n  previewView.style.display = 'none';\n});\npreviewViewBtn.addEventListener('click', () => {\n  previewViewBtn.classList.add('active');\n  codeViewBtn.classList.remove('active');\n  previewView.style.display = 'block';\n  codeView.style.display = 'none';\n});\n\n/* ---------- Live preview app logic ---------- */\nlet mood = \"\";\nconst appPage = document.getElementById('appPage');\nconst playlistText = document.getElementById('playlistText');\n\nfunction showPlaylist() {\n  if (mood === \"happy\") {\n    playlistText.textContent = \"Upbeat Anthems\";\n    appPage.style.backgroundColor = \"#FFE3CE\";\n  } else if (mood === \"chill\") {\n    playlistText.textContent = \"Lo-Fi Focus\";\n    appPage.style.backgroundColor = \"#D5EFFF\";\n  } else {\n    playlistText.textContent = \"Rainy Day Ballads\";\n    appPage.style.backgroundColor = \"#CBD6E3\";\n  }\n}\n\ndocument.getElementById('happyButton').addEventListener('click', () => { mood = \"happy\"; showPlaylist(); });\ndocument.getElementById('chillButton').addEventListener('click', () => { mood = \"chill\"; showPlaylist(); });\ndocument.getElementById('sadButton').addEventListener('click', () => { mood = \"sad\"; showPlaylist(); });\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
