        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>WebLab Explorer</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <header>\n        <nav>\n            <div class=\"logo\">\n                <img src=\"/images/computer.png\" alt=\"Computer and monitor\">\n            </div>\n            <ul class=\"nav-links\">\n                <li><a href=\"#\">Home</a></li>\n                <li><a href=\"#\">About</a></li>\n            </ul>\n        </nav>\n    </header>\n\n    <main>\n        <h1>Hello World</h1>\n        <p>Click around and see what you can figure out about WebLab.</p>\n    </main>\n\n    <footer>\n        <p>&copy; 2026 Student Sandbox</p>\n    </footer>\n</body>\n</html>  ",
          "active": true,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "body {\n  margin: 0;\n  font-family: sans-serif;\n  background-color: #f9f9f9;\n  color: #333;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  height: 100vh;\n  text-align: center;\n}\n\nheader {\n  position: absolute;\n  top: 0;\n  width: 100%;\n  background: white;\n  border-bottom: 1px solid #ddd;\n  padding: 10px 0;\n}\n\nnav {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  max-width: 800px;\n  margin: 0 auto;\n  padding: 0 20px;\n}\n\n.logo img {\n  height: 30px;\n}\n\n.nav-links {\n  list-style: none;\n  display: flex;\n  gap: 20px;\n  margin: 0;\n  padding: 0;\n}\n\n.nav-links a {\n  text-decoration: none;\n  color: #666;\n  font-weight: bold;\n}\n\nh1 {\n  font-size: 3rem;\n  margin-bottom: 10px;\n  color: #222;\n}\n\np {\n  font-size: 1.2rem;\n  color: #555;\n}\n\nfooter {\n  position: absolute;\n  bottom: 20px;\n  font-size: 0.8rem;\n  color: #999;\n}",
