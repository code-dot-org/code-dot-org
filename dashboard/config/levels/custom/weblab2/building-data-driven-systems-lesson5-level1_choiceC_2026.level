    "encrypted": "false",
    "display_name": "Transit Stops",
    "long_instructions": "## Generate Data\r\n\r\n### Do This:\r\n\r\n1. Look at the transit stop object in the code.\r\n2. Highlight the object and prompt AI to generate an array of objects called `stops`.\r\n3. Run the code and inspect the generated dataset.\r\n4. Look for patterns in the kinds of stops and information that appear.",
    "bubble_choice_description": "Start with one transit stop object, then use AI to generate a larger dataset that follows the same structure.",
    "thumbnail_url": "https://images.code.org/8177861adf9963f09de10f582b3f8dcb-transit_stop.png",
    "offer_browser_tts": "false",
