      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Smart Room Inspector</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <div class=\"app\">\n    <header class=\"top-bar\">\n      <svg class=\"brand-logo\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" focusable=\"false\">\n        <defs>\n          <linearGradient id=\"logo-gradient\" x1=\"0\" y1=\"1\" x2=\"1\" y2=\"0\">\n            <stop offset=\"0\" stop-color=\"#f9ce34\"></stop>\n            <stop offset=\"0.5\" stop-color=\"#ee2a7b\"></stop>\n            <stop offset=\"1\" stop-color=\"#6228d7\"></stop>\n          </linearGradient>\n        </defs>\n        <g fill=\"none\" stroke=\"url(#logo-gradient)\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M3 10V5a2 2 0 0 1 2-2h5\"></path>\n          <path d=\"M22 3h5a2 2 0 0 1 2 2v5\"></path>\n          <path d=\"M29 22v5a2 2 0 0 1-2 2h-5\"></path>\n          <path d=\"M10 29H5a2 2 0 0 1-2-2v-5\"></path>\n          <path d=\"M9 15.5L16 9.5l7 6\"></path>\n          <path d=\"M11 14v8h10v-8\"></path>\n          <path d=\"M14.5 22v-4h3v4\"></path>\n        </g>\n      </svg>\n      <h1 class=\"brand-name\">Smart Room Inspector</h1>\n    </header>\n\n    <main class=\"layout\">\n      <article class=\"post\" aria-labelledby=\"post-user\">\n        <header class=\"post-header\">\n          <span class=\"avatar\" aria-hidden=\"true\">\n            <span class=\"avatar-inner\"><svg viewBox=\"0 0 24 24\" focusable=\"false\">\n                <g fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                  <path d=\"M3 8V4.5A1.5 1.5 0 0 1 4.5 3H8\"></path>\n                  <path d=\"M16 3h3.5A1.5 1.5 0 0 1 21 4.5V8\"></path>\n                  <path d=\"M21 16v3.5a1.5 1.5 0 0 1-1.5 1.5H16\"></path>\n                  <path d=\"M8 21H4.5A1.5 1.5 0 0 1 3 19.5V16\"></path>\n                  <path d=\"M7 11.5L12 7.5l5 4\"></path>\n                  <path d=\"M8.5 10.5V16h7v-5.5\"></path>\n                </g>\n              </svg></span>\n          </span>\n          <div class=\"post-meta\">\n            <h2 id=\"post-user\" class=\"post-user\">smart_room_inspector</h2>\n            <p class=\"post-sub\" id=\"room-counter\"></p>\n          </div>\n        </header>\n\n        <div class=\"media\">\n          <div class=\"viewfinder\" id=\"viewfinder\">\n            <span class=\"corner corner-top-start\" aria-hidden=\"true\"></span>\n            <span class=\"corner corner-top-end\" aria-hidden=\"true\"></span>\n            <span class=\"corner corner-bottom-start\" aria-hidden=\"true\"></span>\n            <span class=\"corner corner-bottom-end\" aria-hidden=\"true\"></span>\n            <p class=\"viewfinder-text\">Point your camera at a room, then take a photo.</p>\n          </div>\n          <img class=\"room-photo\" id=\"room-photo\" src=\"\" alt=\"\" hidden>\n          <div class=\"flash\" id=\"flash\" aria-hidden=\"true\"></div>\n          <div class=\"scan\" id=\"scan\" hidden>\n            <div class=\"scan-line\" aria-hidden=\"true\"></div>\n            <p class=\"scan-text\">Checking the room...</p>\n          </div>\n          <p class=\"verdict-badge\" id=\"verdict-badge\" hidden></p>\n        </div>\n      </article>\n\n      <div class=\"side-panel\">\n        <section class=\"stories\" aria-labelledby=\"stories-heading\">\n          <h2 id=\"stories-heading\" class=\"panel-heading\">Your inspections</h2>\n          <ol class=\"story-list\" id=\"story-list\"></ol>\n        </section>\n\n        <div class=\"controls\">\n          <button class=\"shutter\" id=\"shutter-button\" type=\"button\">\n            <span class=\"shutter-ring\" aria-hidden=\"true\"><span class=\"shutter-core\"></span></span>\n            <span class=\"shutter-label\" id=\"shutter-label\">Take photo</span>\n          </button>\n        </div>\n\n        <section class=\"result\" id=\"result\" aria-labelledby=\"result-heading\" hidden>\n          <h3 class=\"result-heading\" id=\"result-heading\"></h3>\n          <p class=\"result-caption\" id=\"result-caption\"></p>\n          <ul class=\"meters\" id=\"meters\"></ul>\n        </section>\n\n        <p class=\"visually-hidden\" id=\"status\" aria-live=\"polite\"></p>\n        <p class=\"error-message\" id=\"error-message\" role=\"alert\" hidden></p>\n      </div>\n    </main>\n  </div>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "// The order of this list is the order students see the rooms.\nconst ROOMS = [\n  {\n    image: \"room-one.jpg\",\n    alt: \"Photo of the first bedroom.\",\n    verdict: \"clean\",\n    scores: { clean: 0.94, unclean: 0.06 }\n  },\n  {\n    image: \"room-two.jpg\",\n    alt: \"Photo of the second bedroom.\",\n    verdict: \"unclean\",\n    scores: { clean: 0.09, unclean: 0.91 }\n  },\n  {\n    image: \"room-three.jpg\",\n    alt: \"Photo of the third bedroom.\",\n    verdict: \"unsure\",\n    scores: { clean: 0.52, unclean: 0.48 }\n  },\n  {\n    image: \"room-four.jpg\",\n    alt: \"Photo of the fourth bedroom.\",\n    verdict: \"clean\",\n    scores: { clean: 0.88, unclean: 0.12 }\n  },\n  {\n    image: \"room-five.jpg\",\n    alt: \"Photo of the fifth bedroom.\",\n    verdict: \"unclean\",\n    scores: { clean: 0.04, unclean: 0.96 }\n  }\n];\n\nconst VERDICTS = {\n  clean: {\n    label: \"Clean\",\n    caption: \"This room looks clean to me.\"\n  },\n  unclean: {\n    label: \"Unclean\",\n    caption: \"This room does not look clean to me.\"\n  },\n  unsure: {\n    label: \"Hard to tell\",\n    caption: \"I'm not sure about this one. The room could be clean or unclean, so I can't pick a label.\"\n  }\n};\n\nconst SCORE_LABELS = {\n  clean: \"Clean\",\n  unclean: \"Unclean\"\n};\n\nconst PLACEHOLDER_IMAGE = \"placeholder.svg\";\nconst FLASH_MS = 350;\nconst ANALYZE_MS = 1800;\n\nconst percentFormat = new Intl.NumberFormat(document.documentElement.lang || undefined, {\n  style: \"percent\"\n});\n\nconst state = {\n  nextIndex: 0,\n  busy: false\n};\n\nconst els = {};\n\nfunction getElements() {\n  const ids = [\n    \"story-list\", \"room-counter\", \"viewfinder\", \"room-photo\", \"flash\", \"scan\",\n    \"verdict-badge\", \"shutter-button\", \"shutter-label\", \"result\", \"result-heading\",\n    \"result-caption\", \"meters\", \"status\", \"error-message\"\n  ];\n  ids.forEach(function (id) {\n    const element = document.getElementById(id);\n    if (!element) {\n      throw new Error(`Missing element: ${id}`);\n    }\n    els[id] = element;\n  });\n}\n\nfunction prefersReducedMotion() {\n  return window.matchMedia && window.matchMedia(\"(prefers-reduced-motion: reduce)\").matches;\n}\n\nfunction wait(ms) {\n  return new Promise(function (resolve) {\n    window.setTimeout(resolve, ms);\n  });\n}\n\nfunction setImage(img, src, alt) {\n  img.onerror = function () {\n    img.onerror = null;\n    img.src = PLACEHOLDER_IMAGE;\n  };\n  img.src = src;\n  img.alt = alt;\n}\n\nfunction announce(message) {\n  els.status.textContent = \"\";\n  window.setTimeout(function () {\n    els.status.textContent = message;\n  }, 50);\n}\n\nfunction updateCounter(roomIndex) {\n  els[\"room-counter\"].textContent = `Room ${roomIndex + 1} of ${ROOMS.length}`;\n}\n\nfunction renderStories(currentIndex, doneCount) {\n  const list = els[\"story-list\"];\n  list.textContent = \"\";\n  ROOMS.forEach(function (room, index) {\n    const done = index < doneCount;\n    const item = document.createElement(\"li\");\n    item.className = \"story\";\n    if (done) {\n      item.classList.add(\"story-done\");\n    } else if (index === currentIndex) {\n      item.classList.add(\"story-current\");\n    }\n\n    const ring = document.createElement(\"span\");\n    ring.className = \"story-ring\";\n    const inner = document.createElement(\"span\");\n    inner.className = \"story-inner\";\n    if (done) {\n      const img = document.createElement(\"img\");\n      setImage(img, room.image, \"\");\n      inner.appendChild(img);\n    } else {\n      inner.setAttribute(\"aria-hidden\", \"true\");\n      inner.textContent = String(index + 1);\n    }\n    ring.appendChild(inner);\n\n    const label = document.createElement(\"span\");\n    label.className = \"story-label\";\n    label.setAttribute(\"aria-hidden\", \"true\");\n    const description = document.createElement(\"span\");\n    description.className = \"visually-hidden\";\n    if (done) {\n      const verdict = VERDICTS[room.verdict];\n      label.classList.add(`verdict-${room.verdict}`);\n      label.textContent = verdict.label;\n      description.textContent = `Room ${index + 1}: ${verdict.label}`;\n    } else {\n      label.textContent = `Room ${index + 1}`;\n      description.textContent = `Room ${index + 1}: not inspected yet`;\n    }\n\n    item.append(ring, label, description);\n    list.appendChild(item);\n  });\n}\n\nfunction setShutter(label, disabled) {\n  els[\"shutter-label\"].textContent = label;\n  els[\"shutter-button\"].setAttribute(\"aria-disabled\", disabled ? \"true\" : \"false\");\n}\n\nfunction clearResult() {\n  els.result.hidden = true;\n  els[\"verdict-badge\"].hidden = true;\n  els.meters.textContent = \"\";\n}\n\nfunction flash() {\n  if (prefersReducedMotion()) {\n    return Promise.resolve();\n  }\n  const flashEl = els.flash;\n  flashEl.classList.remove(\"flash-active\");\n  // Force a reflow so the animation restarts on every photo.\n  void flashEl.offsetWidth;\n  flashEl.classList.add(\"flash-active\");\n  return wait(FLASH_MS);\n}\n\nfunction renderMeter(key, value, verdict) {\n  const item = document.createElement(\"li\");\n\n  const text = document.createElement(\"div\");\n  text.className = \"meter-text\";\n  const name = document.createElement(\"span\");\n  name.className = \"meter-name\";\n  name.textContent = SCORE_LABELS[key];\n  const amount = document.createElement(\"span\");\n  amount.textContent = percentFormat.format(value);\n  text.append(name, amount);\n\n  const track = document.createElement(\"div\");\n  track.className = \"meter-track\";\n  track.setAttribute(\"aria-hidden\", \"true\");\n  const fill = document.createElement(\"div\");\n  const colorKey = verdict === \"unsure\" ? \"unsure\" : key;\n  fill.className = `meter-fill verdict-${colorKey}`;\n  fill.style.width = `${Math.round(value * 100)}%`;\n  track.appendChild(fill);\n\n  item.append(text, track);\n  return item;\n}\n\nfunction showResult(room) {\n  const verdict = VERDICTS[room.verdict];\n  const verdictClass = `verdict-${room.verdict}`;\n\n  els[\"verdict-badge\"].className = `verdict-badge ${verdictClass}`;\n  els[\"verdict-badge\"].textContent = verdict.label;\n  els[\"verdict-badge\"].hidden = false;\n\n  els[\"result-heading\"].className = `result-heading ${verdictClass}`;\n  els[\"result-heading\"].textContent = verdict.label;\n  els[\"result-caption\"].textContent = verdict.caption;\n\n  els.meters.textContent = \"\";\n  Object.keys(SCORE_LABELS).forEach(function (key) {\n    els.meters.appendChild(renderMeter(key, room.scores[key], room.verdict));\n  });\n  els.result.hidden = false;\n}\n\nasync function inspectNextRoom() {\n  const index = state.nextIndex;\n  const room = ROOMS[index];\n\n  state.busy = true;\n  setShutter(\"Checking...\", true);\n  clearResult();\n  updateCounter(index);\n  renderStories(index, index);\n\n  await flash();\n  els.viewfinder.hidden = true;\n  setImage(els[\"room-photo\"], room.image, room.alt);\n  els[\"room-photo\"].hidden = false;\n  els.scan.hidden = false;\n  announce(`Photo taken. Checking room ${index + 1}.`);\n\n  await wait(ANALYZE_MS);\n  els.scan.hidden = true;\n  showResult(room);\n\n  state.nextIndex = index + 1;\n  renderStories(state.nextIndex, state.nextIndex);\n  const verdict = VERDICTS[room.verdict];\n  announce(`Room ${index + 1} result: ${verdict.label}. ${verdict.caption}`);\n\n  const finished = state.nextIndex >= ROOMS.length;\n  setShutter(finished ? \"Start over\" : \"Take another photo\", false);\n  state.busy = false;\n}\n\nfunction startOver() {\n  state.nextIndex = 0;\n  clearResult();\n  els[\"room-photo\"].hidden = true;\n  els[\"room-photo\"].removeAttribute(\"src\");\n  els.viewfinder.hidden = false;\n  updateCounter(0);\n  renderStories(0, 0);\n  setShutter(\"Take photo\", false);\n  announce(\"Starting over. Point your camera at room 1.\");\n}\n\nfunction handleShutter() {\n  if (state.busy) {\n    return;\n  }\n  if (state.nextIndex >= ROOMS.length) {\n    startOver();\n    return;\n  }\n  inspectNextRoom().catch(showError);\n}\n\nfunction showError() {\n  const message = document.getElementById(\"error-message\");\n  if (message) {\n    message.textContent = \"Something went wrong with the camera app. Please reload the page and try again.\";\n    message.hidden = false;\n  }\n}\n\nfunction init() {\n  try {\n    getElements();\n    updateCounter(0);\n    renderStories(0, 0);\n    els[\"shutter-button\"].addEventListener(\"click\", handleShutter);\n  } catch (error) {\n    showError();\n  }\n}\n\ninit();",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": ":root {\n  --color-page: #fafafa;\n  --color-surface: #ffffff;\n  --color-border: #dbdbdb;\n  --color-text: #262626;\n  --color-text-muted: #737373;\n  --color-focus: #0064e0;\n  --color-camera: #1c1c1c;\n  --color-camera-text: #ffffff;\n  --color-clean: #1a7f37;\n  --color-unclean: #c4122f;\n  --color-unsure: #8a5a00;\n  --color-track: #efefef;\n  --color-done-ring: #c7c7c7;\n  --gradient-brand: linear-gradient(45deg, #f9ce34 0%, #ee2a7b 50%, #6228d7 100%);\n  --font-body: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  --radius-card: 8px;\n  --top-bar-height: 52px;\n  --layout-gap: 12px;\n  --side-panel-min: 270px;\n  /* Square photo: as big as fits the screen height and still leaves room for the side panel. */\n  --media-size: max(240px, min(calc(100vh - 140px), calc(100vw - var(--side-panel-min) - 3 * var(--layout-gap))));\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml,\nbody {\n  height: 100%;\n}\n\nbody {\n  margin: 0;\n  background: var(--color-page);\n  color: var(--color-text);\n  font-family: var(--font-body);\n  font-size: 1rem;\n  line-height: 1.4;\n}\n\n[hidden] {\n  display: none !important;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n:focus-visible {\n  outline: 3px solid var(--color-focus);\n  outline-offset: 3px;\n}\n\n.app {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  max-width: 1040px;\n  margin: 0 auto;\n}\n\n/* Top bar */\n.top-bar {\n  display: flex;\n  flex-shrink: 0;\n  align-items: center;\n  gap: 0.6rem;\n  min-height: var(--top-bar-height);\n  padding: 0.5rem var(--layout-gap);\n  background: var(--color-surface);\n  border-block-end: 1px solid var(--color-border);\n}\n\n.brand-logo {\n  flex-shrink: 0;\n  width: 28px;\n  height: 28px;\n}\n\n.brand-name {\n  margin: 0;\n  font-size: 1.25rem;\n  font-weight: 700;\n  letter-spacing: -0.01em;\n}\n\n/* Two-column layout: photo on one side, controls and results on the other */\n.layout {\n  display: grid;\n  grid-template-columns: var(--media-size) minmax(var(--side-panel-min), 1fr);\n  align-items: start;\n  gap: var(--layout-gap);\n  flex: 1;\n  min-height: 0;\n  padding: var(--layout-gap);\n}\n\n/* Post card */\n.post {\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-card);\n  overflow: hidden;\n}\n\n.post-header {\n  display: flex;\n  align-items: center;\n  gap: 0.6rem;\n  padding: 0.45rem 0.75rem;\n}\n\n.avatar {\n  flex-shrink: 0;\n  width: 36px;\n  height: 36px;\n  padding: 2px;\n  border-radius: 50%;\n  background: var(--gradient-brand);\n}\n\n.avatar-inner {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  height: 100%;\n  border: 2px solid var(--color-surface);\n  border-radius: 50%;\n  background: var(--color-surface);\n  color: var(--color-text);\n}\n\n.avatar-inner svg {\n  width: 18px;\n  height: 18px;\n}\n\n.post-meta {\n  min-width: 0;\n}\n\n.post-user {\n  margin: 0;\n  font-size: 0.875rem;\n  font-weight: 600;\n  overflow-wrap: anywhere;\n}\n\n.post-sub {\n  margin: 0;\n  font-size: 0.8rem;\n  color: var(--color-text-muted);\n}\n\n/* Square photo area */\n.media {\n  position: relative;\n  width: 100%;\n  aspect-ratio: 1 / 1;\n  background: var(--color-camera);\n  overflow: hidden;\n}\n\n.viewfinder {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 2.5rem;\n  color: var(--color-camera-text);\n}\n\n.viewfinder-text {\n  margin: 0;\n  max-width: 18rem;\n  text-align: center;\n}\n\n.corner {\n  position: absolute;\n  width: 34px;\n  height: 34px;\n  border-color: var(--color-camera-text);\n  border-style: solid;\n  border-width: 0;\n}\n\n.corner-top-start {\n  inset-block-start: 1.25rem;\n  inset-inline-start: 1.25rem;\n  border-block-start-width: 3px;\n  border-inline-start-width: 3px;\n}\n\n.corner-top-end {\n  inset-block-start: 1.25rem;\n  inset-inline-end: 1.25rem;\n  border-block-start-width: 3px;\n  border-inline-end-width: 3px;\n}\n\n.corner-bottom-start {\n  inset-block-end: 1.25rem;\n  inset-inline-start: 1.25rem;\n  border-block-end-width: 3px;\n  border-inline-start-width: 3px;\n}\n\n.corner-bottom-end {\n  inset-block-end: 1.25rem;\n  inset-inline-end: 1.25rem;\n  border-block-end-width: 3px;\n  border-inline-end-width: 3px;\n}\n\n.room-photo {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.flash {\n  position: absolute;\n  inset: 0;\n  background: #ffffff;\n  opacity: 0;\n  pointer-events: none;\n}\n\n.flash-active {\n  animation: camera-flash 350ms ease-out;\n}\n\n@keyframes camera-flash {\n  0% { opacity: 0; }\n  25% { opacity: 0.95; }\n  100% { opacity: 0; }\n}\n\n.scan {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  align-items: flex-end;\n  justify-content: center;\n  padding: 1rem;\n  background: rgba(0, 0, 0, 0.35);\n  overflow: hidden;\n}\n\n/* A full-height layer with the line on its bottom edge, so translate percentages track the photo size. */\n.scan-line {\n  position: absolute;\n  inset: 0;\n  animation: scan-sweep 1.2s ease-in-out infinite alternate;\n}\n\n.scan-line::after {\n  content: \"\";\n  position: absolute;\n  inset-inline: 0;\n  bottom: 0;\n  height: 4px;\n  background: var(--gradient-brand);\n}\n\n@keyframes scan-sweep {\n  from { transform: translateY(-100%); }\n  to { transform: translateY(0); }\n}\n\n.scan-text {\n  position: relative;\n  margin: 0;\n  padding: 0.4rem 0.9rem;\n  border-radius: 999px;\n  background: rgba(0, 0, 0, 0.75);\n  color: #ffffff;\n  font-weight: 600;\n  font-size: 0.95rem;\n}\n\n.verdict-badge {\n  position: absolute;\n  inset-block-end: 0.85rem;\n  inset-inline-start: 0.85rem;\n  margin: 0;\n  padding: 0.4rem 0.95rem;\n  border-radius: 999px;\n  font-weight: 700;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);\n}\n\n/* Side panel */\n.side-panel {\n  display: flex;\n  flex-direction: column;\n  gap: var(--layout-gap);\n  max-height: 100%;\n  min-width: 0;\n  overflow-y: auto;\n}\n\n.stories,\n.controls,\n.result {\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius-card);\n}\n\n.stories {\n  padding: 0.6rem 0.6rem 0.7rem;\n}\n\n.panel-heading {\n  margin: 0 0 0.5rem;\n  font-size: 0.875rem;\n  font-weight: 600;\n}\n\n.story-list {\n  display: grid;\n  grid-template-columns: repeat(5, minmax(0, 1fr));\n  gap: 0.35rem;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.story {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.25rem;\n  min-width: 0;\n}\n\n.story-ring {\n  display: block;\n  width: 100%;\n  max-width: 56px;\n  aspect-ratio: 1 / 1;\n  padding: 2px;\n  border-radius: 50%;\n  background: var(--color-border);\n}\n\n.story-current .story-ring {\n  background: var(--gradient-brand);\n}\n\n.story-done .story-ring {\n  background: var(--color-done-ring);\n}\n\n.story-inner {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  height: 100%;\n  border: 2px solid var(--color-surface);\n  border-radius: 50%;\n  background: var(--color-page);\n  font-weight: 700;\n  overflow: hidden;\n}\n\n.story-inner img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.story-label {\n  font-size: 0.7rem;\n  line-height: 1.2;\n  text-align: center;\n  overflow-wrap: anywhere;\n}\n\n.story-label.verdict-clean,\n.story-label.verdict-unclean,\n.story-label.verdict-unsure {\n  font-weight: 700;\n}\n\n.controls {\n  display: flex;\n  justify-content: center;\n  padding: 0.6rem;\n}\n\n.shutter {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.3rem;\n  min-width: 44px;\n  padding: 0.25rem 0.75rem;\n  border: 0;\n  border-radius: var(--radius-card);\n  background: transparent;\n  color: var(--color-text);\n  font: inherit;\n  cursor: pointer;\n}\n\n.shutter-ring {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 60px;\n  height: 60px;\n  padding: 4px;\n  border-radius: 50%;\n  background: var(--gradient-brand);\n}\n\n.shutter-core {\n  display: block;\n  width: 100%;\n  height: 100%;\n  border: 4px solid var(--color-surface);\n  border-radius: 50%;\n  background: var(--color-text);\n  transition: transform 120ms ease-out;\n}\n\n.shutter:hover .shutter-core,\n.shutter:active .shutter-core {\n  transform: scale(0.9);\n}\n\n.shutter-label {\n  font-weight: 600;\n  font-size: 0.95rem;\n}\n\n.shutter[aria-disabled=\"true\"] {\n  cursor: default;\n}\n\n.shutter[aria-disabled=\"true\"] .shutter-ring {\n  background: var(--color-done-ring);\n}\n\n.shutter[aria-disabled=\"true\"] .shutter-core {\n  transform: none;\n  background: var(--color-text-muted);\n}\n\n.result {\n  padding: 0.7rem 0.85rem;\n}\n\n.result-heading {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  margin: 0 0 0.2rem;\n  font-size: 1.05rem;\n}\n\n.result-heading::before {\n  content: \"\";\n  flex-shrink: 0;\n  width: 0.75rem;\n  height: 0.75rem;\n  border-radius: 50%;\n  background: currentColor;\n}\n\n.result-caption {\n  margin: 0 0 0.6rem;\n  font-size: 0.95rem;\n}\n\n.meters {\n  display: grid;\n  gap: 0.5rem;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.meter-text {\n  display: flex;\n  justify-content: space-between;\n  gap: 1rem;\n  font-size: 0.875rem;\n}\n\n.meter-name {\n  font-weight: 600;\n}\n\n.meter-track {\n  height: 8px;\n  margin-block-start: 0.2rem;\n  border-radius: 999px;\n  background: var(--color-track);\n  overflow: hidden;\n}\n\n.meter-fill {\n  height: 100%;\n  border-radius: 999px;\n}\n\n/* Verdict colors (always paired with a text label) */\n.verdict-clean { color: var(--color-clean); }\n.verdict-unclean { color: var(--color-unclean); }\n.verdict-unsure { color: var(--color-unsure); }\n\n.verdict-badge.verdict-clean,\n.meter-fill.verdict-clean { background: var(--color-clean); color: #ffffff; }\n\n.verdict-badge.verdict-unclean,\n.meter-fill.verdict-unclean { background: var(--color-unclean); color: #ffffff; }\n\n.verdict-badge.verdict-unsure,\n.meter-fill.verdict-unsure { background: var(--color-unsure); color: #ffffff; }\n\n.error-message {\n  margin: 0;\n  padding: 0.75rem 1rem;\n  border: 2px solid var(--color-unclean);\n  border-radius: var(--radius-card);\n  background: var(--color-surface);\n  color: var(--color-unclean);\n  font-weight: 600;\n}\n\n/* Narrow screens: stack the columns and let the page scroll */\n@media (max-width: 599px) {\n  html,\n  body,\n  .app {\n    height: auto;\n  }\n\n  .layout {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .side-panel {\n    max-height: none;\n    overflow: visible;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .flash-active {\n    animation: none;\n  }\n\n  .scan-line {\n    display: none;\n  }\n\n  .shutter-core {\n    transition: none;\n  }\n}",
