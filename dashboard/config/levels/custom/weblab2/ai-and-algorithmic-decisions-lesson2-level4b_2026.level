        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  padding: 24px;\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;\n  background-color: #f3e8ff;\n  color: #222;\n  text-align: center;\n}\n\n.title {\n  margin-bottom: 16px;\n  font-size: 1.75rem;\n}\n\n.container {\n  max-width: 600px;\n  margin: 0 auto;\n}\n\n.image {\n  width: 100%;\n  max-width: 300px;\n  border-radius: 8px;\n  margin-bottom: 16px;\n}\n\n.textArea {\n  min-height: 100px;\n  padding: 16px;\n  border: 2px dashed #9aa4b2;\n  border-radius: 12px;\n  background-color: #fff;\n  margin-bottom: 16px;\n}\n\n.buttons {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\nbutton {\n  padding: 12px;\n  font-size: 1rem;\n  border-radius: 10px;\n  border: 2px solid #333;\n  background-color: #fff;\n  cursor: pointer;\n}",
