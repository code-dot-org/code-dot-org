        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>StarSage: Zodiac Fortune Teller</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n    <script defer src=\"script.js\"></script>\n  </head>\n  <body>\n    <h1 class=\"title\">StarSage: Zodiac Fortune Teller</h1>\n    <main class=\"container\">\n      <section class=\"left\">\n        <img class=\"image\" src=\"image.png\" alt=\"Crystal ball illustration\" />\n      </section>\n      <section class=\"right\">\n        <div id=\"textArea\" class=\"textArea\" aria-live=\"polite\">Choose your sign to reveal today's fortune.</div>\n        <div class=\"buttons\">\n          <button id=\"ariesButton\" type=\"button\">Aries</button>\n          <button id=\"taurusButton\" type=\"button\">Taurus</button>\n          <button id=\"geminiButton\" type=\"button\">Gemini</button>\n          <button id=\"cancerButton\" type=\"button\">Cancer</button>\n          <button id=\"leoButton\" type=\"button\">Leo</button>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n\n",
          "folderId": "0",
          "active": false
        },
