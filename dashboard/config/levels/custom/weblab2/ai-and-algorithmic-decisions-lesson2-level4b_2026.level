        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>NPC Dialogue Generator</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n    <script defer src=\"script.js\"></script>\n  </head>\n  <body>\n    <h1 class=\"title\">NPC Dialogue Generator</h1>\n    <main class=\"container\">\n      <section class=\"left\">\n        <img class=\"image\" src=\"images/header.png\" alt=\"NPC illustration\" />\n      </section>\n      <section class=\"right\">\n        <div class=\"buttons\">\n          <button id=\"wiseElderButton\" type=\"button\">The Wise Elder</button>\n          <button id=\"suspiciousMerchantButton\" type=\"button\">The Suspicious Merchant</button>\n          <button id=\"randomVillagerButton\" type=\"button\">The Random Villager</button>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>",
          "folderId": "0",
          "active": true
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\nhtml,\nbody {\n  height: 100%;\n}\nbody {\n  margin: 0;\n  font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;\n  background: #1a1a2e;\n  color: #e0e0e0;\n  transition: background-color 400ms ease;\n}\n.title {\n  text-align: center;\n  margin: 16px 0 0;\n  font-size: 1.75rem;\n  color: #c8a4f8;\n}\n.container {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 24px;\n  padding: 24px;\n  max-width: 1000px;\n  margin: 0 auto;\n}\n.left {\n  background: #16213e;\n  border: 2px solid #333;\n  border-radius: 16px;\n  padding: 16px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n}\n.image {\n  display: block;\n  max-width: 100%;\n  height: auto;\n  border-radius: 12px;\n  object-fit: contain;\n}\n.right {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  gap: 12px;\n}\n.buttons {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  width: 260px;\n  margin-inline: auto;\n}\n.buttons button {\n  padding: 12px 16px;\n  font-size: 1rem;\n  border-radius: 10px;\n  border: 2px solid #c8a4f8;\n  background: #16213e;\n  color: #e0e0e0;\n  cursor: pointer;\n  transition: background-color 120ms ease, color 120ms ease;\n}\n.buttons button:hover {\n  background: #c8a4f8;\n  color: #1a1a2e;\n}\n.buttons button:active {\n  transform: translateY(1px);\n}\n@media (max-width: 800px) {\n  .container {\n    grid-template-columns: 1fr;\n  }\n  .buttons {\n    width: 100%;\n  }\n}",
          "folderId": "0",
          "active": false
        },
