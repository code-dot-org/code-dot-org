    "encrypted": "false",
    "display_name": "NPC Dialogue Generator",
    "bubble_choice_description": "Build an NPC Dialogue Generator where clicking each character button changes the page's background color to match that NPC's vibe.",
    "thumbnail_url": "https://images.code.org/55d303f91cc5ba88a1536e0b5cf7ccab-image.png",
    "submittable": "false",
    "hide_share_and_remix": "false",
