      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html> \n<html> \n<head>\n   <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <!-- info on Animal Farm play -->\n  <h1>Animal Farm</h1> \n  \n  <h3>\n    Friday, 4pm in the Auditorium\n  </h3>\n  \n  <p>\n    Come see our production of <em>Animal Farm</em> in the auditorium at 4pm this Friday.  It's going to be a great show, and you will not regret it! \n  </p> \n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* 2) Change the font family for the paragraph tag */\n\n/* 3) Add a font family rule for the h1 or h3 tags */\nh1 {\n  color: red;\n  font-size: 24px;\n}\n\np {\n  font-size: 14px;\n  font-family: cursive;\n}",
          "folderId": "0",
          "active": true
        }
