  "properties": {
    "require_edit_to_continue": "false",
    "encrypted": "false",
    "long_instructions": "Anita tracks how many customers visit her Parlor. She also tracks the temperature outside. With this data, she's created a regression model. It uses temperature to predict how many customers will visit.\r\n\r\n**☑️ Do This:**\r\n- Adjust the temperature to see how the prediction changes.\r\n- Be prepared to answer questions about how well the model works.",
    "offer_browser_tts": "false",
    "submittable": "false",
    "disable_edit_run_for_submission": "true",
    "hide_share_and_remix": "false",
    "widget_view": "true",
    "initial_view_mode": "split",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "placeholderText": "",
      "multipleChoiceOptions": [
        ""
      ],
      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false
    },
    "ai_tutor_prompt_settings": {
