<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-11-03T03:21:19.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": true,
    "start_sources": {
      "folders": {
      },
      "files": {
        "ea4d65d6-25f0-4192-ae95-7dc5340facde": {
          "id": "ea4d65d6-25f0-4192-ae95-7dc5340facde",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Save the Park</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <div class=\"container\" id=\"parkSite\">\n        <h1 id=\"headline\">Protecting Our Green Spaces</h1>\n        <p id=\"main-text\">Our local park is an important part of our neighborhood. It offers a place for everyone to relax and enjoy nature.</p>\n        <button class=\"cta-button\" id=\"cta-button\">Find Out How</button>\n    </div>\n\n    <div class=\"prompt-controls\">\n        <h2>Prompt Dial: Describe the Tone</h2>\n        <div class=\"control-item\">\n            <label for=\"urgentTone\">Urgent Tone</label>\n            <label class=\"switch\">\n                <input type=\"checkbox\" id=\"urgentTone\">\n                <span class=\"slider\"></span>\n            </label>\n        </div>\n        <div class=\"control-item\">\n            <label for=\"formalTone\">Formal Tone</label>\n            <label class=\"switch\">\n                <input type=\"checkbox\" id=\"formalTone\">\n                <span class=\"slider\"></span>\n            </label>\n        </div>\n        <div class=\"control-item\">\n            <label for=\"friendlyTone\">Friendly Tone</label>\n            <label class=\"switch\">\n                <input type=\"checkbox\" id=\"friendlyTone\">\n                <span class=\"slider\"></span>\n            </label>\n        </div>\n    </div>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "70be09df-1739-4b11-acfe-2fdcce226edb": {
          "id": "70be09df-1739-4b11-acfe-2fdcce226edb",
          "name": "style.css",
          "contents": "body {\n    font-family: Arial, sans-serif;\n    margin: 20px;\n    background-color: #f8f8f8;\n    color: #333;\n    line-height: 1.6;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    min-height: calc(100vh - 40px);\n}\n\n.container {\n    background-color: #fff;\n    padding: 30px;\n    border-radius: 10px;\n    box-shadow: 0 4px 10px rgba(0,0,0,0.1);\n    max-width: 800px;\n    width: 100%;\n    margin-bottom: 30px;\n    text-align: center;\n}\n\nh1 {\n    color: #4CAF50;\n    margin-top: 0;\n    font-size: 2em;\n}\n\np {\n    margin-bottom: 25px;\n    font-size: 1.1em;\n}\n\n.cta-button {\n    background-color: #FF9800;\n    color: white;\n    padding: 12px 25px;\n    border: none;\n    border-radius: 5px;\n    font-size: 1.1em;\n    cursor: pointer;\n    transition: background-color 0.3s ease;\n    display: inline-block;\n    margin-top: 10px;\n}\n\n.cta-button:hover {\n    background-color: #FB8C00;\n}\n\n/* Prompt Dial Controls Styling (reused from Level 13/16) */\n.prompt-controls {\n    background-color: #fff;\n    padding: 25px;\n    border-radius: 10px;\n    box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n    display: flex;\n    flex-direction: column;\n    gap: 15px;\n    width: 300px;\n}\n.control-item {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n}\n.control-item label {\n    font-size: 1.1em;\n    color: #555;\n}\n.switch {\n    position: relative;\n    display: inline-block;\n    width: 40px;\n    height: 24px;\n}\n.switch input {\n    opacity: 0;\n    width: 0;\n    height: 0;\n}\n.slider {\n    position: absolute;\n    cursor: pointer;\n    top: 0;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    background-color: #ccc;\n    -webkit-transition: .4s;\n    transition: .4s;\n    border-radius: 24px;\n}\n.slider:before {\n    position: absolute;\n    content: \"\";\n    height: 16px;\n    width: 16px;\n    left: 4px;\n    bottom: 4px;\n    background-color: white;\n    -webkit-transition: .4s;\n    transition: .4s;\n    border-radius: 50%;\n}\ninput:checked + .slider {\n    background-color: #2196F3;\n}\ninput:focus + .slider {\n    box-shadow: 0 0 1px #2196F3;\n}\ninput:checked + .slider:before {\n    -webkit-transform: translateX(16px);\n    -ms-transform: translateX(16px);\n    transform: translateX(16px);\n}\n\n/* Tone-specific styles */\n.urgent-active h1 {\n    color: #D32F2F; /* Red */\n    font-size: 2.5em;\n}\n.urgent-active p {\n    color: #C62828;\n    font-weight: bold;\n}\n.urgent-active .cta-button {\n    background-color: #D32F2F;\n    text-transform: uppercase;\n    font-weight: bold;\n}\n\n.formal-active h1 {\n    color: #455A64; /* Dark blue-grey */\n    font-family: 'Times New Roman', serif;\n    font-size: 2.1em;\n}\n.formal-active p {\n    color: #546E7A;\n    font-family: 'Times New Roman', serif;\n    line-height: 1.8;\n}\n.formal-active .cta-button {\n    background-color: #455A64;\n    border-radius: 3px;\n    font-style: italic;\n}\n\n.friendly-active h1 {\n    color: #66BB6A; /* Light green */\n    font-family: 'Comic Sans MS', cursive;\n    font-size: 2.3em;\n}\n.friendly-active p {\n    color: #81C784;\n    font-family: 'Comic Sans MS', cursive;\n}\n.friendly-active .cta-button {\n    background-color: #66BB6A;\n    border-radius: 20px;\n    font-weight: normal;\n}",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "7f3a04a9-08f0-49bb-86ff-83b6c5b02034": {
          "id": "7f3a04a9-08f0-49bb-86ff-83b6c5b02034",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const body = document.body;\n    const headlineElement = document.getElementById('headline');\n    const mainTextElement = document.getElementById('main-text');\n    const ctaButtonElement = document.getElementById('cta-button');\n\n    const urgentToggle = document.getElementById('urgentTone');\n    const formalToggle = document.getElementById('formalTone');\n    const friendlyToggle = document.getElementById('friendlyTone');\n    const allToggles = [urgentToggle, formalToggle, friendlyToggle];\n\n    const content = {\n        default: {\n            headline: \"Protecting Our Green Spaces\",\n            mainText: \"Our local park is an important part of our neighborhood. It offers a place for everyone to relax and enjoy nature.\",\n            ctaButton: \"Find Out How\",\n            className: ''\n        },\n        urgent: {\n            headline: \"Our Park Is In Danger! Act Now!\",\n            mainText: \"Immediate action is needed! Our vital green space is facing serious threats that could lead to permanent loss. Your help is critical to protect it before it's too late!\",\n            ctaButton: \"Sign The Petition Today!\",\n            className: 'urgent-active'\n        },\n        formal: {\n            headline: \"A Proposal for Park Conservation\",\n            mainText: \"This document outlines strategic initiatives for the preservation and sustainable management of our local green space, emphasizing its ecological and community value.\",\n            ctaButton: \"Review Official Policy\",\n            className: 'formal-active'\n        },\n        friendly: {\n            headline: \"Come Enjoy Our Wonderful Park!\",\n            mainText: \"Discover the peace and beauty of our community park! It's a fantastic spot for everyone to relax, play, and connect with nature. Bring your family and friends!\",\n            ctaButton: \"Plan Your Visit\",\n            className: 'friendly-active'\n        }\n    };\n\n    function updateTone() {\n        let activeTone = 'default';\n\n        if (urgentToggle.checked) {\n            activeTone = 'urgent';\n        } else if (formalToggle.checked) {\n            activeTone = 'formal';\n        } else if (friendlyToggle.checked) {\n            activeTone = 'friendly';\n        }\n\n        const currentContent = content[activeTone];\n\n        headlineElement.textContent = currentContent.headline;\n        mainTextElement.textContent = currentContent.mainText;\n        ctaButtonElement.textContent = currentContent.ctaButton;\n\n        // Remove all tone classes first\n        body.classList.remove('urgent-active', 'formal-active', 'friendly-active');\n        if (currentContent.className) {\n            body.classList.add(currentContent.className);\n        }\n    }\n\n    allToggles.forEach(toggle => {\n        toggle.addEventListener('change', (event) => {\n            // If this toggle was just checked, uncheck others to ensure mutual exclusivity\n            if (event.target.checked) {\n                allToggles.forEach(otherToggle => {\n                    if (otherToggle !== event.target) {\n                        otherToggle.checked = false;\n                    }\n                });\n            }\n            updateTone();\n        });\n    });\n\n    // Initialize the page content\n    updateTone();\n});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
        "ea4d65d6-25f0-4192-ae95-7dc5340facde",
        "70be09df-1739-4b11-acfe-2fdcce226edb",
        "7f3a04a9-08f0-49bb-86ff-83b6c5b02034"
      ]
    },
    "long_instructions": "TODOs:\r\n- Open index.html to see the save-the-park page and prompt dial controls.\r\n- Toggle the \"Urgent Tone\" switch and observe how the headline, text, and button change.\r\n- Toggle the \"Formal Tone\" switch, noting how it overrides the previous tone.\r\n- Toggle the \"Friendly Tone\" switch and see its effect on the page's words.\r\n- Understand that each toggle represents a specific tone detail you might include in a prompt.",
