    "display_name": "Grow Based On Content",
    "bubble_choice_description": "Practice setting the `flex-grow` property based on if you want items to grow equally or not!",
    "thumbnail_url": "https://images.code.org/d50a822195c22cb6b0d5261b83357436-grow.png",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    \n    <!-- parent container with 3 child paragraph tags -->\n    <!-- 1) Add some more text to one of the paragraph in the \"grow0\" container to see the item sizes adjusting based on the content! -->\n    <div class=\"grow0\">\n      <p>child</p>\n      <p>child</p>\n      <p>child</p>\n    </div>\n    \n    <!-- parent container with 3 child paragraph tags -->\n    <div class=\"grow1\">\n      <p>child</p>\n      <p>child</p>\n      <p>child</p>\n    </div>\n\n\n    \n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* 1) Add the flex-grow property to the first container and set the child elements grow based on the content inside the container */ \n.grow0 > p {\n\n}\n\n\n/* 2) Add the flex-grow property to the second container and set the child elements take an equal portion of the parent container. */\n.grow1 > p {\n\n}\n\n\n/* styled parent containers */\n.grow0, .grow1 {\n  background: #b691d6;\n  display: flex;\n  padding: 5px;\n  margin: 10px;\n}\n\n/* styled paragraphs */\np {\n  background-color: aliceblue;\n  margin: 5px;\n  padding: 5px;\n  text-align: center;\n  font-size: 20px;\n  border-style: solid;\n  font-family: sans-serif; \n\n}",
          "folderId": "0",
          "active": true
        }
      },
