        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    <h1>Favorite Places To Travel</h1>\n    \n    <p>These are pictures of some of my favorite places to travel.</p>\n    \n    <h2>Egypt</h2>\n    \n    <img class=\"Egypt\" src=\"Egypt.jpg\" alt=\"Egypt\">\n    <img class=\"Egypt\" src=\"sphinx.jpg\" alt=\"the sphinx\">\n    <img class=\"Egypt\" src=\"pyramids.jpg\" alt=\"the pyramids\">\n    \n    \n    <h2>Greece</h2>\n    \n    <img class=\"grece\" src=\"greece.jpg\" alt=\"Greece\">\n    <img class=\"grece\" src=\"Hephaistos.jpg\" alt=\"Hephaistos Temple\">\n    <img class=\"grece\" src=\"parthenon.jpg\" alt=\"Parthenon\">\n   \n    \n    <h2>Japan</h2>\n    \n    <img class=\"Japan\" src=\"Fuji.jpg\" alt=\"Mt. Fuji\">\n    <img class=\"Japan\" src=\"garden.jpg\" alt=\"Japanese garden\">\n    <img class=\"Japan\" src=\"cherry-blossom.jpg\" alt=\"cherry blossoms\">\n   \n  \n    \n  </body>\n</html>",
          "active": true,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  background: rgba(179, 248, 168, 0.18);\n  text-align: center;\n  font-family: monospace;\n}\n\n\nh2 {\n  font-size: 30px;\n}\n\nimg {\n  margin: 20px;\n  width: 300px;\n  border-radius:10px;\n}\n\n.egypt {\n  border-style: solid;\n  border-width: 8px;\n  border-color:darkgoldenrod;\n}\n\n.Greece {\n  border-style:dashed;\n  border-width: 3px;\n  border-color:darkseagreen;\n}\n\njapan {\n  border-style:dotted;\n  border-width: 5px;\n  border-color: crimson;\n}",
