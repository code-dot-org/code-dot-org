      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    \n    <!-- div container with a class attribute around the 3 images -->\n    <div class=\"container-1\">\n      <img src=\"dog1.jpg\" alt=\"happy dog\">\n      <img src=\"dog2.jpg\" alt=\"dog with clothes\">\n      <img src=\"dog3.jpg\" alt=\"different eye color dog\">\n \n    </div>\n    \n    <!-- div container with a class attribute around the 3 images -->\n    <div class=\"container-2\">\n      <img src=\"dog1.jpg\" alt=\"happy dog\">\n      <img src=\"dog2.jpg\" alt=\"dog with clothes\">\n      <img src=\"dog3.jpg\" alt=\"different eye color dog\">\n    </div>\n    \n    <!-- div container with a class attribute around the 3 images -->\n    <div class=\"container-3\">\n      <img src=\"dog1.jpg\" alt=\"happy dog\">\n      <img src=\"dog2.jpg\" alt=\"dog with clothes\">\n      <img src=\"dog3.jpg\" alt=\"different eye color dog\">\n    </div>\n    \n    <!-- div container with a class attribute around the 3 images -->\n    <div class=\"container-4\">\n      <img src=\"dog1.jpg\" alt=\"happy dog\">\n      <img src=\"dog2.jpg\" alt=\"dog with clothes\">\n      <img src=\"dog3.jpg\" alt=\"different eye color dog\">\n    </div>\n    \n    <!-- div container with a class attribute around the 3 images -->\n    <div class=\"container-5\">\n      <img src=\"dog1.jpg\" alt=\"happy dog\">\n      <img src=\"dog2.jpg\" alt=\"dog with clothes\">\n      <img src=\"dog3.jpg\" alt=\"different eye color dog\">\n    </div>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* 1) Add the align-items property for each of the 5 div container rules in the stylesheet */\n/* 2) Match the image on the right by applying the correct value with each of the align-item properties */\n\n.container-1 {\n  /* The div container has a background color so you can see how the items are positioned within it */\n  background: #b691d6;\n  \n  /* Create a flex layout context */\n  display: flex;\n\n  /* Define the flow direction \n  and if the items should wrap */\n  flex-direction: row;\n  flex-wrap: wrap;\n  \n  /* Define how items should be distributed horizontally across the container */\n  justify-content: center;\n  \n  /* ADD CODE BELOW to define how items should be distributed vertically within the container */\n\n\n\n}\n\n.container-2 {\n  /* The div container has a background color so you can see how the items are positioned within it */\n  background: #91d6ce;\n\n  /* Create a flex layout context */\n  display: flex;\n\n  /* Define the flow direction \n  and if the items should wrap */\n  flex-direction: row;\n  flex-wrap: wrap;\n\n  /* Define how items should be distributed horizontally across the container */\n  justify-content: center;\n\n  /* ADD CODE BELOW to define how items should be distributed vertically within the container */\n\n\n}\n\n.container-3 {\n  /* The div container has a background color so you can see how the items are positioned within it */\n  background: #d691c4;\n\n  /* Create a flex layout context */\n  display: flex;\n\n  /* Define the flow direction \n  and if the items should wrap */\n  flex-direction: row;\n  flex-wrap: wrap;\n\n  /* Define how items should be distributed horizontally across the container */\n  justify-content: center;\n\n  /* ADD CODE BELOW to define how items should be distributed vertically within the container */\n\n\n}\n\n.container-4 {\n  /* The div container has a background color so you can see how the items are positioned within it */\n  background: #9cd691;\n\n  /* Create a flex layout context */\n  display: flex;\n\n  /* Define the flow direction \n  and if the items should wrap */\n  flex-direction: row;\n  flex-wrap: wrap;\n  \n  /* Define how items should be distributed horizontally across the container */\n  justify-content: center;\n\n  /* ADD CODE BELOW to define how items should be distributed vertically within the container */\n\n\n}\n\n.container-5 {\n  /* The div container has a background color so you can see how the items are positioned within it */\n  background: #f6f48c;\n\n  /* Create a flex layout context */\n  display: flex;\n\n  /* Define the flow direction \n  and if the items should wrap */\n  flex-direction: row;\n  flex-wrap: wrap;\n  \n  /* Define how items should be distributed horizontally across the container */\n  justify-content: center;\n\n  /* ADD CODE BELOW to define how items should be distributed vertically within the container */\n\n\n}\n\n\n/* div containers are given extra height to make sure you can see how the items align vertically */\n\ndiv {\n  height: 195px;\n}\n\nimg {\n  width: 100px;\n  border-style:solid;\n  border-color:black;\n}",
          "folderId": "0",
          "active": true
        },
