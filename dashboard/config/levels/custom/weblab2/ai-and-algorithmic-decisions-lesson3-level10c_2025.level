      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Mood Tracker</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <main class=\"wrap\">\n    <h1>My Mood Tracker 💖</h1>\n\n    <section class=\"card\">\n      <h2>Today's Mood Score</h2>\n      <div class=\"display\">\n        <span id=\"mood\">0</span>\n      </div>\n\n      <div class=\"buttons\">\n        <button id=\"happierBtn\" class=\"btn happy\">+1 Happier</button>\n        <button id=\"sadderBtn\" class=\"btn sad\">−1 Sadder</button>\n        <button id=\"resetBtn\" class=\"btn reset\">Reset</button>\n      </div>\n    </section>\n  </main>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// variable for likes\n\n\n\n// references to display element and buttons\nconst moodElement = document.getElementById('mood');\nconst happierBtn = document.getElementById('happierBtn');\nconst neutralBtn = document.getElementById('neutralBtn');\nconst sadderBtn  = document.getElementById('sadderBtn');\nconst resetBtn   = document.getElementById('resetBtn');\n\n// increases mood by 1 and updates the display\nhappierBtn.addEventListener('click', () => {\n\n\n  \n});\n\n// decreases mood by 1 and updates the display\nsadderBtn.addEventListener('click', () => {\n\n\n  \n});\n\n// resets mood to 0 and updates the display\nresetBtn.addEventListener('click', () => {\n\n\n  \n});",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": ":root {\n  --bg: #fff0f6;\n  --card: #ffffff;\n  --text: #4a044e;\n  --happy: #f9a8d4;   /* pastel pink */\n  --neutral: #c4b5fd; /* lavender */\n  --sad: #93c5fd;     /* soft blue */\n  --reset: #fbcfe8;   /* blush pink */\n}\n\n* { box-sizing: border-box; }\n\nbody {\n  margin: 0;\n  font-family: 'Poppins', system-ui, sans-serif;\n  background: radial-gradient(circle at top left, #ffe4e6, #e0e7ff, #fce7f3);\n  display: grid;\n  place-items: center;\n  height: 100vh;\n  color: var(--text);\n}\n\n.wrap {\n  text-align: center;\n  padding: 1rem;\n}\n\nh1 {\n  font-family: 'Fredoka One', cursive;\n  color: #a21caf;\n  font-size: 2.25rem;\n  letter-spacing: 0.5px;\n  text-shadow: 1px 1px 2px rgba(0,0,0,0.1);\n}\n\n.card {\n  background: var(--card);\n  border-radius: 25px;\n  padding: 2rem;\n  box-shadow: 0 10px 25px rgba(0,0,0,0.1);\n  max-width: 350px;\n  border: 3px solid #f9a8d4;\n}\n\nh2 {\n  color: #9333ea;\n  font-size: 1.25rem;\n  margin-bottom: 0.75rem;\n}\n\n.display {\n  font-size: 3.5rem;\n  font-weight: 700;\n  margin: 1rem 0 1.5rem;\n  color: #86198f;\n  background: linear-gradient(180deg, #fce7f3, #e0e7ff);\n  border-radius: 20px;\n  padding: 0.75rem 0;\n  border: 2px solid #f9a8d4;\n  box-shadow: inset 0 3px 6px rgba(0,0,0,0.1);\n}\n\n.buttons {\n  display: flex;\n  flex-direction: column;\n  gap: 0.7rem;\n}\n\n.btn {\n  border: none;\n  border-radius: 12px;\n  padding: 0.8rem 1rem;\n  font-size: 1rem;\n  font-weight: 600;\n  color: #fff;\n  cursor: pointer;\n  transition: transform 0.1s ease, box-shadow 0.2s ease;\n  letter-spacing: 0.5px;\n}\n\n.btn:hover {\n  transform: scale(1.05);\n  box-shadow: 0 6px 10px rgba(0,0,0,0.1);\n}\n\n.happy { background: var(--happy); }\n.happy:hover { background: #f472b6; }\n\n.sad { background: var(--sad); }\n.sad:hover { background: #60a5fa; }\n\n.reset { background: var(--reset); color: #831843; }\n.reset:hover { background: #f9a8d4; }\n\n@media (max-width: 400px) {\n  .card {\n    padding: 1.5rem;\n  }\n}\n",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
