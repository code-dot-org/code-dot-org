<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-04-01T21:40:22.000Z",
  "level_num": "custom",
  "user_id": 18762,
  "properties": {
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "script.js",
          "contents": "const filterBtn = document.getElementById(\"filterBtn\");\nconst resetBtn = document.getElementById(\"resetBtn\");\nlet bakedGoods = data;\n\n// Display a list of baked goods on the page\nconst renderMenu = (list) => {\n  menuList.innerHTML = \"\";\n\n  for (let i = 0; i < list.length; i++) {\n    addMenuItem(list[i]);\n  }\n};\n\n// Renders all bake goods\nrenderMenu(bakedGoods);\n\n// BUGGY CODE — This shouldn't permanently change the original dataset, but it does!\nconst filterNutFree = () => {\n  let safeItems = [];\n\n  for (let i = 0; i < bakedGoods.length; i++) {\n    if (bakedGoods[i].allergens !== \"Nuts\") {\n      safeItems.push(bakedGoods[i]);\n    }\n  }\n\n  bakedGoods = safeItems;\n\n  renderMenu(bakedGoods);\n};\n\n// Event listeners\nfilterBtn.addEventListener(\"click\", () => { filterNutFree() });\nresetBtn.addEventListener(\"click\", () => { renderMenu(bakedGoods) });\n\n\n\n",
          "folderId": "0",
          "active": true
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "@import url('https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@400;600;700&display=swap');\n\n:root {\n  --ink: #161616;\n  --cream: #fff8ee;\n  --pink: #ff5fa2;\n  --lime: #c6ff3d;\n  --butter: #ffe15c;\n  --shadow: 4px 4px 0 var(--ink);\n  --shadow-lg: 6px 6px 0 var(--ink);\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  font-family: 'Archivo', system-ui, sans-serif;\n  background-color: var(--cream);\n  background-image: radial-gradient(var(--ink) 1.2px, transparent 1.2px);\n  background-size: 22px 22px;\n  color: var(--ink);\n  margin: 0;\n  padding: 24px;\n  min-height: 100vh;\n  display: flex;\n  justify-content: center;\n  align-items: flex-start;\n}\n\nmain {\n  background: #fff;\n  padding: 1.75rem;\n  border: 3px solid var(--ink);\n  border-radius: 18px;\n  box-shadow: var(--shadow-lg);\n  width: 100%;\n  max-width: 460px;\n  margin-top: 32px;\n}\n\nh1 {\n  font-family: 'Archivo Black', sans-serif;\n  font-size: 2.4rem;\n  line-height: 1;\n  letter-spacing: -1px;\n  margin: 0 0 4px;\n  text-transform: uppercase;\n}\n\nh1::after {\n  content: \"🧁\";\n  font-size: 1.6rem;\n  margin-left: 6px;\n}\n\n.tagline {\n  font-weight: 600;\n  font-size: 0.9rem;\n  color: var(--pink);\n  margin: 0 0 22px;\n  text-transform: lowercase;\n}\n\n.controls {\n  display: flex;\n  gap: 12px;\n  margin-bottom: 24px;\n}\n\nbutton {\n  flex: 1;\n  background-color: var(--lime);\n  color: var(--ink);\n  border: 3px solid var(--ink);\n  padding: 12px 16px;\n  border-radius: 12px;\n  cursor: pointer;\n  font-family: 'Archivo', sans-serif;\n  font-weight: 700;\n  font-size: 0.95rem;\n  box-shadow: var(--shadow);\n  transition: transform 0.08s ease, box-shadow 0.08s ease;\n}\n\nbutton:hover {\n  transform: translate(-2px, -2px);\n  box-shadow: var(--shadow-lg);\n}\n\nbutton:active {\n  transform: translate(4px, 4px);\n  box-shadow: 0 0 0 var(--ink);\n}\n\nbutton.secondary {\n  background-color: var(--butter);\n}\n\nul {\n  list-style: none;\n  padding: 0;\n  margin: 0;\n}\n\nli {\n  padding: 14px 16px;\n  margin-bottom: 12px;\n  background: #fff;\n  border: 3px solid var(--ink);\n  border-radius: 12px;\n  box-shadow: var(--shadow);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n  font-weight: 600;\n}\n\nli:nth-child(3n+1) { background: #fff; }\nli:nth-child(3n+2) { background: #fffaf0; }\nli:nth-child(3n+3) { background: #fff5fa; }\n\n.allergen-tag {\n  background-color: var(--pink);\n  color: #fff;\n  padding: 5px 12px;\n  border: 2px solid var(--ink);\n  border-radius: 999px;\n  font-size: 0.78rem;\n  font-weight: 700;\n  white-space: nowrap;\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "data.js",
          "contents": "// ===================================================\n// data.js — the bake sale menu\n// Do not edit this file.\n// ===================================================\n\nlet data = [\n  { name: \"Peanut Butter Cookies\", allergens: \"Nuts\" },\n  { name: \"Lemon Bars\", allergens: \"Dairy\" },\n  { name: \"Almond Croissant\", allergens: \"Nuts\" },\n  { name: \"Sugar Cookies\", allergens: \"Gluten\" },\n  { name: \"Pecan Pie\", allergens: \"Nuts\" }\n];\n",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "helpers.js",
          "contents": "// ===================================================\n// helpers.js — page setup and display code\n// You do not need to change anything in this file.\n// ===================================================\n\n// DOM element used for displaying the menu\nconst menuList = document.getElementById(\"menuList\");\n\n// Build one <li> for a single baked good and add it to the menu\nconst addMenuItem = (item) => {\n  const li = document.createElement(\"li\");\n\n  const nameSpan = document.createElement(\"span\");\n  nameSpan.textContent = item.name;\n\n  const tagSpan = document.createElement(\"span\");\n  tagSpan.className = \"allergen-tag\";\n  tagSpan.textContent = \"Contains: \" + item.allergens;\n\n  li.appendChild(nameSpan);\n  li.appendChild(tagSpan);\n\n  menuList.appendChild(li);\n};\n",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Bake Sale Filter</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n\n</head>\n<body>\n\n  <main>\n    <h1>Bake Sale Menu</h1>\n    <p class=\"tagline\">fresh from the oven</p>\n\n    <div class=\"controls\">\n      <button id=\"filterBtn\">Filter: Nut-Free</button>\n      <button id=\"resetBtn\" class=\"secondary\">Reset Data</button>\n    </div>\n\n    <div class=\"menu-container\">\n      <ul id=\"menuList\"></ul>\n    </div>\n  </main>\n  <script src=\"data.js\" ></script>\n  <script src=\"helpers.js\" ></script>\n  <script src=\"script.js\" ></script>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "1"
      ]
    },
