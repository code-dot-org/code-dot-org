      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Lucky 6 Dice Roller</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <main>\n    <h1>Lucky 6 Roller</h1>\n    <p>Roll the die until you get a 6!</p>\n    \n    <button id=\"rollBtn\">Roll Dice</button>\n    \n    <div class=\"results-container\">\n      <h3>Roll History:</h3>\n      <ul id=\"results\">\n        </ul>\n    </div>\n  </main>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// DOM elements\nconst rollBtn = document.querySelector(\"#rollBtn\");\nconst resultsList = document.querySelector(\"#results\");\n\n// Helper function\nconst rollDie = () => Math.floor(Math.random() * 6) + 1;\n\n// Event Listener\nrollBtn.addEventListener(\"click\", () => {\n  resultsList.innerHTML = \"\";  // Reset the list\n  \n  // Initialize variables\n  let roll = 0; // Start with an impossible value so the loop runs at least once\n  const target = 6;\n\n  // Write your while loop here\n\n  \n});",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "/* Base Styles */\nbody {\n  font-family: 'Verdana', sans-serif;\n  background-color: #f0f4f8;\n  color: #333;\n  text-align: center;\n  padding: 2rem;\n}\n\nh1 {\n  color: #2c3e50;\n}\n\n/* Button Styling */\nbutton {\n  background-color: #3498db;\n  color: white;\n  border: none;\n  padding: 1rem 2rem;\n  font-size: 1.2rem;\n  border-radius: 8px;\n  cursor: pointer;\n  margin-bottom: 2rem;\n  transition: background-color 0.2s;\n}\n\nbutton:hover {\n  background-color: #2980b9;\n}\n\n/* Results List */\n.results-container {\n  background: white;\n  max-width: 400px;\n  margin: 0 auto;\n  padding: 1rem;\n  border-radius: 8px;\n  box-shadow: 0 4px 6px rgba(0,0,0,0.1);\n}\n\nul {\n  list-style-type: none;\n  padding: 0;\n}\n\nli {\n  background-color: #ecf0f1;\n  margin: 5px 0;\n  padding: 10px;\n  border-radius: 4px;\n  font-family: 'Courier New', monospace;\n  font-weight: bold;\n}\n\n/* Highlight the winning roll */\nli:last-child {\n  background-color: #2ecc71;\n  color: white;\n}",
          "folderId": "0",
          "active": false
        }
