      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Sports Magazine Cover</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n\n  <div class=\"magazine-wrapper\">\n    <header class=\"masthead\">\n      <h1 id=\"magTitle\">Game Time Weekly</h1>\n      <div class=\"price-tag\">$4.99 • Vol. 102</div>\n    </header>\n\n    <main class=\"cover-body\">\n      <div class=\"image-container\">\n        <img id=\"coverImage\" src=\"/images/cover1b.png\" alt=\"Sports Action Shot\">\n      </div>\n      \n      <div class=\"text-content\">\n        <h2 id=\"headline\"></h2>\n        <p id=\"tagline\"></p>\n      </div>\n    </main>\n\n    <footer>\n      <p id=\"count\"></p>\n    </footer>\n  </div>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// SPORTS MAGAZINE: Parallel Arrays\n\n// Data Arrays\nconst coverImages = [\n  \"/images/cover1b.png\",\n  \"/images/cover2b.png\",\n  \"/images/cover3b.png\"\n];\nconst headlines = [];\nconst taglines = [];\n\n",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  background-color: #e0e0e0;\n  font-family: 'Verdana', sans-serif;\n  display: flex;\n  justify-content: center;\n  padding: 20px;\n}\n\n.magazine-wrapper {\n  background: white;\n  width: 380px;\n  padding: 0;\n  box-shadow: 5px 5px 15px rgba(0,0,0,0.3);\n  text-align: center;\n}\n\n.masthead {\n  background-color: #002147; /* Navy Blue */\n  color: white;\n  padding: 20px 10px;\n}\n\nh1 {\n  font-family: 'Impact', sans-serif;\n  font-style: italic;\n  font-size: 2.8rem;\n  margin: 0;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n}\n\n.price-tag {\n  font-size: 0.9rem;\n  color: #ff9800; /* Orange Accent */\n  margin-top: 5px;\n  font-weight: bold;\n}\n\n.cover-body {\n  position: relative;\n}\n\n#coverImage {\n  width: 100%;\n  height: auto;\n  display: block;\n}\n\n.text-content {\n  background: #ff9800;\n  color: #002147;\n  padding: 15px;\n  clip-path: polygon(0 10%, 100% 0, 100% 100%, 0 100%); /* Dynamic slant */\n  margin-top: -40px; /* Overlap effect */\n  position: relative;\n}\n\n#headline {\n  font-size: 1.8rem;\n  margin: 10px 0 5px 0;\n  text-transform: uppercase;\n  line-height: 1;\n}\n\n#tagline {\n  font-size: 1.1rem;\n  font-weight: bold;\n  margin: 0;\n}\n\nfooter {\n  padding: 10px;\n  background: #ddd;\n  font-size: 0.85rem;\n  color: #555;\n}",
          "folderId": "0",
          "active": false
        },
