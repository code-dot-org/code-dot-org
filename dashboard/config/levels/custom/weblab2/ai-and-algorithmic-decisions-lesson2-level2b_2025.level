      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <title>Player Details</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    <div id=\"topbar\">\n      <div id=\"avatar\"></div>\n      <h3 id=\"brand\">TeamView</h3>\n    </div>\n\n    <div id=\"card\">\n      <h2 id=\"title\">Jordan Lee</h2>\n\n      <div id=\"details\">\n        <img id=\"playerPhoto\" src=\"player.png\" alt=\"Player portrait\">\n        <p id=\"stat1\">Position: Short Stop</p>\n        <p id=\"stat2\">Batting Average: .350</p>\n        <p id=\"stat3\">Homeruns: 5 </p>\n      </div>\n\n      <div id=\"actions\">\n        <button id=\"show\">Show Details</button>\n      </div>\n    </div>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: sans-serif;\n  background-color: #fafafa;\n  text-align: center;\n  margin: 0;\n}\n\n#topbar {\n  background-color: white;\n  padding: 10px;\n}\n\n#avatar {\n  display: inline-block;\n  width: 28px;\n  height: 28px;\n  border-radius: 50%;\n  background: linear-gradient(135deg, #007aff, #ffd15c);\n  vertical-align: middle;\n}\n\n#brand {\n  display: inline-block;\n  margin: 0 0 0 8px;\n  vertical-align: middle;\n}\n\n#card {\n  background-color: white;\n  border-radius: 10px;\n  width: 320px;\n  margin: 20px auto;\n  padding: 12px 0 14px 0;\n}\n\n#details {\n  display: none; /* Start hidden */\n  margin: 10px 0;\n}\n\n#playerPhoto {\n  display: block;\n  margin: 0 auto 8px auto;\n  border-radius: 8px;\n  width: 200px;\n}\n\n#actions {\n  margin-top: 8px;\n}\n\n#show {\n  background-color: white;\n  padding: 6px 12px;\n  border-radius: 6px;\n  cursor: pointer;\n  font-weight: 600;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "document.querySelector(\"#profile-details\").style.display = \"block\";\n\ndocument.querySelector(\"#show\").addEventListener(\"onclick\", () => {\n  \n});\n",
          "folderId": "0",
          "active": true
        },
