    "start_sources": {
      "folders": {
        "1": {
          "id": "1",
          "name": "images",
          "parentId": "0",
          "open": false
        }
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <meta charset=\"utf-8\" />\n    <title id=\"pageTitle\">Profiles</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <main id=\"mainContainer\">\n      <header id=\"header\">\n        <h1 id=\"heading\">Profile</h1>\n        <p id=\"subtitle\">See details about different person or items.</p>\n      </header>\n\n      <section id=\"profileContainer\" class=\"profile-container\"></section>\n    </main>\n\n    <script src=\"helpers.js\" ></script>\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  margin: 0;\n  font-family: Arial, sans-serif;\n  background: #eef1f6;\n  color: #14213d;\n}\n\n#mainContainer {\n  max-width: 900px;\n  margin: 0 auto;\n  padding: 24px 16px 40px;\n}\n\n#header {\n  margin-bottom: 24px;\n}\n\n#heading {\n  margin: 0 0 8px;\n  font-size: 1.8rem;\n}\n\n#subtitle {\n  margin: 0;\n  font-size: 0.95rem;\n  color: #5f687a;\n}\n\n#profileContainer {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(260px, 360px));\n  gap: 20px;\n  justify-content: center;\n}\n\n.profile-card {\n  width: 100%;\n  max-width: 360px;\n  background: #ffffff;\n  border-radius: 16px;\n  padding: 16px;\n  box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);\n  box-sizing: border-box;\n}\n\n.profile-top {\n  display: flex;\n  align-items: flex-start;\n  gap: 12px;\n}\n\n.profile-image {\n  width: 72px;\n  height: 72px;\n  border-radius: 50%;\n  object-fit: cover;\n  flex-shrink: 0;\n}\n\n.profile-main {\n  flex: 1;\n  min-width: 0;\n}\n\n.profile-name {\n  margin: 0 0 6px;\n  font-size: 1.3rem;\n  line-height: 1.1;\n  word-break: break-word;\n}\n\n.profile-description {\n  margin: 0;\n  font-size: 0.9rem;\n  color: #5f687a;\n  line-height: 1.4;\n}\n\n.profile-divider {\n  border: none;\n  border-top: 1px solid #e3e7ef;\n  margin: 16px 0 0;\n}\n\n.profile-detail {\n  margin: 0;\n  padding: 12px 0;\n  font-size: 0.9rem;\n  color: #24324a;\n  border-top: 1px solid #e3e7ef;\n}\n\n.profile-detail:first-of-type {\n  border-top: none;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const image = \"images/olivia.png\";\nconst name = \"Olivia Smith\";\nconst description = \"Enthusiastic learner who enjoys problem solving and coding.\";\nconst detail1 = \"olivia.smith@example.com\";\nconst detail2 = \"10th Grade\";\nconst detail3 = \"Los Angeles, CA\";\n\ncreateProfile(image, name, description, detail1, detail2, detail3);",
          "folderId": "0",
          "active": true
        },
        "4": {
          "id": "4",
          "name": "helpers.js",
          "contents": "let profileCount = 0;\n\nconst createProfile = (imageSrc, name, description, detail1, detail2, detail3) => {\n  const container = document.getElementById(\"profileContainer\");\n\n  const card = document.createElement(\"article\");\n  card.className = \"profile-card\";\n  card.id = \"profile\" + profileCount;\n\n  const top = document.createElement(\"div\");\n  top.className = \"profile-top\";\n  top.id = \"profileTop\" + profileCount;\n\n  const image = document.createElement(\"img\");\n  image.className = \"profile-image\";\n  image.id = \"profileImage\" + profileCount;\n  image.src = imageSrc;\n  image.alt = name;\n\n  const main = document.createElement(\"div\");\n  main.className = \"profile-main\";\n  main.id = \"profileMain\" + profileCount;\n\n  const heading = document.createElement(\"h2\");\n  heading.className = \"profile-name\";\n  heading.id = \"profileName\" + profileCount;\n  heading.textContent = name;\n\n  const descriptionEl = document.createElement(\"p\");\n  descriptionEl.className = \"profile-description\";\n  descriptionEl.id = \"profileDescription\" + profileCount;\n  descriptionEl.textContent = description;\n\n  const divider = document.createElement(\"hr\");\n  divider.className = \"profile-divider\";\n  divider.id = \"profileDivider\" + profileCount;\n\n  const detailOne = document.createElement(\"p\");\n  detailOne.className = \"profile-detail\";\n  detailOne.id = \"profileDetail1_\" + profileCount;\n  detailOne.textContent = detail1;\n\n  const detailTwo = document.createElement(\"p\");\n  detailTwo.className = \"profile-detail\";\n  detailTwo.id = \"profileDetail2_\" + profileCount;\n  detailTwo.textContent = detail2;\n\n  const detailThree = document.createElement(\"p\");\n  detailThree.className = \"profile-detail\";\n  detailThree.id = \"profileDetail3_\" + profileCount;\n  detailThree.textContent = detail3;\n\n  main.appendChild(heading);\n  main.appendChild(descriptionEl);\n\n  top.appendChild(image);\n  top.appendChild(main);\n\n  card.appendChild(top);\n  card.appendChild(divider);\n  card.appendChild(detailOne);\n  card.appendChild(detailTwo);\n  card.appendChild(detailThree);\n\n  container.appendChild(card);\n\n  profileCount++;\n};",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
