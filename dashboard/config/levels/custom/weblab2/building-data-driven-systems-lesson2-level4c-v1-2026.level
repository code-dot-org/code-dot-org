  "properties": {
    "encrypted": "false",
    "long_instructions": "## Display One Profile\r\n\r\n### Do This:\r\n\r\n1. Use the arrays you generated in the previous level.\r\n\r\n2. Create variables that store the values at index 0 from each array.\r\n\r\n3. Use those variables to call `createProfile()`.\r\n\r\n4. Run your code and check:\r\n   * Does one profile display correctly?\r\n   * Do all parts of the profile match?\r\n\r\n### Reminder:\r\n- Index 0 represents one complete profile\r\n- All values at the same index should match",
    "submittable": "false",
    "hide_share_and_remix": "false",
    "disable_edit_run_for_submission": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
    "ai_tutor_mode": "engineer",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
