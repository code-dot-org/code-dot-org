        "12": {
          "id": "12",
          "name": "helpers.js",
          "contents": "// Formats large numbers for the post stats.\nconst formatStat = (number) => {\n  if (number >= 1000000) {\n    return (number / 1000000).toFixed(1) + \"M\";\n  }\n\n  if (number >= 1000) {\n    return (number / 1000).toFixed(1) + \"K\";\n  }\n\n  return number;\n};\n\n// Formats how recently a post was made.\nconst formatTime = (hoursAgo) => {\n  if (hoursAgo === 1) {\n    return \"1 hour ago\";\n  }\n\n  return hoursAgo + \" hours ago\";\n};\n\n// Creates one stat block.\nconst createStat = (number, label) => {\n  const stat = document.createElement(\"div\");\n  stat.className = \"stat\";\n\n  const statNumber = document.createElement(\"span\");\n  statNumber.className = \"stat-number\";\n  statNumber.textContent = formatStat(number);\n\n  const statLabel = document.createElement(\"span\");\n  statLabel.className = \"stat-label\";\n  statLabel.textContent = label;\n\n  stat.appendChild(statNumber);\n  stat.appendChild(statLabel);\n\n  return stat;\n};\n\n// Creates one post card.\n// Students do not need to edit this function.\nconst createPostCard = (post) => {\n  const feedGrid = document.getElementById(\"feedGrid\");\n\n  const card = document.createElement(\"article\");\n  card.className = \"post-card\";\n  card.id = \"postCard\" + post.id;\n\n  const media = document.createElement(\"div\");\n  media.className = \"post-media\";\n  media.id = \"postMedia\" + post.id;\n\n  const image = document.createElement(\"img\");\n  image.className = \"post-image\";\n  image.id = \"postImage\" + post.id;\n  image.src = post.image;\n  image.alt = post.alt;\n\n  media.appendChild(image);\n\n  const content = document.createElement(\"div\");\n  content.className = \"post-content\";\n  content.id = \"postContent\" + post.id;\n\n  const topLine = document.createElement(\"div\");\n  topLine.className = \"post-top-line\";\n  topLine.id = \"postTopLine\" + post.id;\n\n  const author = document.createElement(\"h2\");\n  author.className = \"post-author\";\n  author.id = \"postAuthor\" + post.id;\n  author.textContent = post.author;\n\n  const category = document.createElement(\"span\");\n  category.className = \"post-category\";\n  category.id = \"postCategory\" + post.id;\n  category.textContent = post.category;\n\n  topLine.appendChild(author);\n  topLine.appendChild(category);\n\n  const time = document.createElement(\"p\");\n  time.className = \"post-time\";\n  time.id = \"postTime\" + post.id;\n  time.textContent = formatTime(post.hoursAgo);\n\n  const stats = document.createElement(\"div\");\n  stats.className = \"post-stats\";\n  stats.id = \"postStats\" + post.id;\n\n  stats.appendChild(createStat(post.likes, \"likes\"));\n  stats.appendChild(createStat(post.shares, \"shares\"));\n  stats.appendChild(createStat(post.views, \"views\"));\n\n  content.appendChild(topLine);\n  content.appendChild(time);\n  content.appendChild(stats);\n\n  card.appendChild(media);\n  card.appendChild(content);\n\n  feedGrid.appendChild(card);\n};\n\n// Displays the current posts on the page.\nconst renderPosts = () => {\n  const feedGrid = document.getElementById(\"feedGrid\");\n  const postCount = document.getElementById(\"postCount\");\n\n  feedGrid.innerHTML = \"\";\n  postCount.textContent = displayPosts.length + \" posts\";\n\n  displayPosts.map((post) => {\n    createPostCard(post);\n  });\n};",
          "folderId": "0",
          "active": false
        },
        "13": {
          "id": "13",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>VibeCheck</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n\n<body id=\"mainBody\">\n  <div id=\"appShell\" class=\"app-shell\">\n\n    <aside id=\"sideRail\" class=\"side-rail\" aria-label=\"Primary navigation\">\n      <div id=\"brandLockup\" class=\"brand-lockup\">\n        <h1 id=\"siteLogo\" class=\"logo\">VibeCheck</h1>\n        <p id=\"brandTagline\" class=\"brand-tagline\">Catch the wave</p>\n      </div>\n\n      <nav id=\"railNav\" class=\"rail-nav\" aria-label=\"Main navigation\">\n        <button id=\"railForYou\" class=\"rail-link active-rail-link\" type=\"button\">For You</button>\n        <button id=\"railFollowing\" class=\"rail-link\" type=\"button\">Following</button>\n        <button id=\"railDiscover\" class=\"rail-link\" type=\"button\">Discover</button>\n        <button id=\"railInbox\" class=\"rail-link\" type=\"button\">Inbox</button>\n      </nav>\n\n      <button id=\"createPostBtn\" class=\"create-post-button\" type=\"button\">\n        + Create\n      </button>\n    </aside>\n\n    <div id=\"contentShell\" class=\"content-shell\">\n\n      <header id=\"topBar\" class=\"top-bar\">\n        <div id=\"mobileBrand\" class=\"mobile-brand\">\n          <h1 id=\"mobileLogo\" class=\"mobile-logo\">VibeCheck</h1>\n          <p id=\"mobileSectionName\" class=\"mobile-section-name\">For You</p>\n        </div>\n\n        <label id=\"searchBox\" class=\"search-box\" for=\"searchInput\">\n          <span id=\"searchIcon\" class=\"search-icon\">⌕</span>\n          <input\n            id=\"searchInput\"\n            class=\"search-input\"\n            type=\"search\"\n            placeholder=\"Search videos, creators, sounds\"\n          />\n        </label>\n\n        <div id=\"profilePill\" class=\"profile-pill\">\n          <span id=\"profileName\" class=\"profile-name\">@you</span>\n          <span id=\"profileAvatar\" class=\"profile-avatar\" aria-hidden=\"true\"></span>\n        </div>\n      </header>\n\n      <main id=\"mainContent\" class=\"main-content\">\n\n        <section id=\"feedColumn\" class=\"feed-column\" aria-labelledby=\"feedTitle\">\n          <div id=\"feedTopper\" class=\"feed-topper\">\n            <div id=\"feedTitleGroup\" class=\"feed-title-group\">\n              <p id=\"feedLabel\" class=\"feed-label\">Now playing</p>\n              <h2 id=\"feedTitle\" class=\"feed-title\">For You</h2>\n            </div>\n\n            <button id=\"buildFeedBtn\" class=\"refresh-button\" type=\"button\">\n              Refresh Feed\n            </button>\n          </div>\n\n          <div id=\"trendStrip\" class=\"trend-strip\" aria-label=\"Trending topics\">\n            <button id=\"trendDance\" class=\"trend-chip\" type=\"button\">Dance</button>\n            <button id=\"trendComedy\" class=\"trend-chip\" type=\"button\">Comedy</button>\n            <button id=\"trendGaming\" class=\"trend-chip\" type=\"button\">Gaming</button>\n            <button id=\"trendFood\" class=\"trend-chip\" type=\"button\">Food</button>\n            <button id=\"trendTravel\" class=\"trend-chip\" type=\"button\">Travel</button>\n          </div>\n\n          <div id=\"feedGrid\" class=\"post-stream\" aria-live=\"polite\"></div>\n        </section>\n\n        <aside id=\"discoverPanel\" class=\"discover-panel\" aria-label=\"Discover panel\">\n          <section id=\"pulseCard\" class=\"panel-card pulse-card\">\n            <p id=\"pulseLabel\" class=\"panel-label\">Live pulse</p>\n            <h2 id=\"pulseTitle\" class=\"panel-title\">Trending fast</h2>\n            <p id=\"postCount\" class=\"post-count\">0 posts</p>\n          </section>\n\n          <section id=\"topicCard\" class=\"panel-card topic-card\">\n            <p id=\"topicLabel\" class=\"panel-label\">Top categories</p>\n\n            <div id=\"topicList\" class=\"topic-list\">\n              <span id=\"topicTech\" class=\"topic-pill\">Tech</span>\n              <span id=\"topicSports\" class=\"topic-pill\">Sports</span>\n              <span id=\"topicCats\" class=\"topic-pill\">Cats</span>\n              <span id=\"topicNews\" class=\"topic-pill\">News</span>\n            </div>\n          </section>\n\n          <section id=\"creatorCard\" class=\"panel-card creator-card\">\n            <p id=\"creatorLabel\" class=\"panel-label\">Creator boost</p>\n            <h2 id=\"creatorTitle\" class=\"panel-title\">Fresh picks all day</h2>\n            <p id=\"creatorText\" class=\"panel-text\">\n              New clips are ranked by what people watch, like, and share.\n            </p>\n          </section>\n        </aside>\n\n      </main>\n    </div>\n\n  </div>\n\n  <script src=\"data.js\"></script>\n  <script src=\"helpers.js\"></script>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "active": false
        },
