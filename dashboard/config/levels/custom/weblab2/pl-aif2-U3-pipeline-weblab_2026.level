        "16": {
          "id": "16",
          "name": "style.css",
          "contents": "* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\n:root {\n  --page-bg: #090713;\n  --panel-bg: #151122;\n  --panel-bg-soft: #1d1830;\n  --card-bg: #ffffff;\n  --card-text: #161320;\n  --muted-text: #8f8a9f;\n  --light-text: #f7f2ff;\n  --accent-pink: #ff3d8b;\n  --accent-purple: #8f5cff;\n  --accent-blue: #22d3ee;\n  --accent-lime: #c6ff4a;\n  --border-dark: rgba(255, 255, 255, 0.12);\n  --shadow-soft: 0 24px 70px rgba(0, 0, 0, 0.35);\n}\n\nbody {\n  min-height: 100vh;\n  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  color: var(--light-text);\n  background:\n    radial-gradient(circle at top left, rgba(255, 61, 139, 0.28), transparent 34rem),\n    radial-gradient(circle at bottom right, rgba(34, 211, 238, 0.22), transparent 32rem),\n    var(--page-bg);\n}\n\nbutton,\ninput {\n  font: inherit;\n}\n\nbutton {\n  cursor: pointer;\n}\n\n.app-shell {\n  width: 100%;\n  min-height: 100vh;\n}\n\n/* Side rail */\n\n.side-rail {\n  display: none;\n}\n\n.brand-lockup {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.logo,\n.mobile-logo {\n  font-size: 24px;\n  font-weight: 950;\n  letter-spacing: -0.04em;\n}\n\n.brand-tagline,\n.mobile-section-name {\n  color: var(--muted-text);\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.rail-nav {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.rail-link,\n.create-post-button {\n  border: 0;\n  border-radius: 18px;\n  color: var(--light-text);\n  font-weight: 800;\n}\n\n.rail-link {\n  width: 100%;\n  padding: 13px 14px;\n  text-align: left;\n  background-color: transparent;\n}\n\n.rail-link:hover,\n.active-rail-link {\n  background-color: rgba(255, 255, 255, 0.11);\n}\n\n.create-post-button {\n  margin-top: auto;\n  padding: 14px 16px;\n  background: linear-gradient(135deg, var(--accent-pink), var(--accent-purple));\n  box-shadow: 0 14px 34px rgba(255, 61, 139, 0.28);\n}\n\n/* Main layout */\n\n.content-shell {\n  width: 100%;\n}\n\n.top-bar {\n  position: sticky;\n  top: 0;\n  z-index: 10;\n  display: grid;\n  gap: 14px;\n  padding: 16px;\n  background: rgba(9, 7, 19, 0.82);\n  border-bottom: 1px solid var(--border-dark);\n  backdrop-filter: blur(18px);\n}\n\n.mobile-brand {\n  display: flex;\n  align-items: end;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.search-box {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  min-height: 46px;\n  padding: 0 14px;\n  border: 1px solid var(--border-dark);\n  border-radius: 999px;\n  background-color: rgba(255, 255, 255, 0.08);\n}\n\n.search-icon {\n  color: var(--accent-blue);\n  font-size: 22px;\n  line-height: 1;\n}\n\n.search-input {\n  width: 100%;\n  border: 0;\n  outline: 0;\n  color: var(--light-text);\n  background: transparent;\n}\n\n.search-input::placeholder {\n  color: rgba(247, 242, 255, 0.55);\n}\n\n.profile-pill {\n  display: none;\n}\n\n.main-content {\n  display: grid;\n  gap: 18px;\n  width: 100%;\n  max-width: 1180px;\n  margin: 0 auto;\n  padding: 18px 16px 42px;\n}\n\n/* Feed top */\n\n.feed-column {\n  display: grid;\n  gap: 16px;\n}\n\n.feed-topper {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 18px;\n  border: 1px solid var(--border-dark);\n  border-radius: 30px;\n  background:\n    linear-gradient(135deg, rgba(255, 61, 139, 0.2), rgba(143, 92, 255, 0.14)),\n    rgba(255, 255, 255, 0.07);\n  box-shadow: var(--shadow-soft);\n}\n\n.feed-label,\n.panel-label {\n  margin-bottom: 4px;\n  color: var(--accent-lime);\n  font-size: 12px;\n  font-weight: 950;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n}\n\n.feed-title {\n  font-size: clamp(32px, 8vw, 64px);\n  line-height: 0.95;\n  letter-spacing: -0.07em;\n}\n\n.refresh-button {\n  flex-shrink: 0;\n  border: 0;\n  border-radius: 999px;\n  padding: 12px 16px;\n  color: #17101f;\n  background-color: var(--accent-lime);\n  font-size: 14px;\n  font-weight: 950;\n  box-shadow: 0 12px 30px rgba(198, 255, 74, 0.18);\n}\n\n.refresh-button:hover {\n  transform: translateY(-1px);\n}\n\n.trend-strip {\n  display: flex;\n  gap: 10px;\n  overflow-x: auto;\n  padding-bottom: 4px;\n  scrollbar-width: none;\n}\n\n.trend-strip::-webkit-scrollbar {\n  display: none;\n}\n\n.trend-chip {\n  flex-shrink: 0;\n  border: 1px solid var(--border-dark);\n  border-radius: 999px;\n  padding: 10px 14px;\n  color: var(--light-text);\n  background-color: rgba(255, 255, 255, 0.08);\n  font-size: 13px;\n  font-weight: 850;\n}\n\n.trend-chip:hover {\n  border-color: rgba(255, 255, 255, 0.28);\n  background-color: rgba(255, 255, 255, 0.14);\n}\n\n/* Rendered feed */\n\n.post-stream {\n  display: grid;\n  gap: 16px;\n}\n\n.post-card {\n  overflow: hidden;\n  border-radius: 30px;\n  color: var(--card-text);\n  background-color: var(--card-bg);\n  box-shadow: 0 18px 45px rgba(0, 0, 0, 0.22);\n}\n\n.post-card:hover {\n  transform: translateY(-2px);\n}\n\n.post-media,\n.post-image-wrap {\n  position: relative;\n  width: 100%;\n  aspect-ratio: 16 / 10;\n  overflow: hidden;\n  background:\n    linear-gradient(135deg, rgba(255, 61, 139, 0.2), rgba(34, 211, 238, 0.2)),\n    #242033;\n}\n\n.post-image {\n  width: 100%;\n  height: 100%;\n  display: block;\n  object-fit: cover;\n}\n\n.post-content,\n.post-info {\n  display: grid;\n  gap: 10px;\n  padding: 16px;\n}\n\n.post-top-line,\n.post-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.post-author {\n  font-size: 16px;\n  font-weight: 950;\n}\n\n.post-category {\n  border-radius: 999px;\n  padding: 5px 9px;\n  color: #17101f;\n  background-color: var(--accent-lime);\n  font-size: 11px;\n  font-weight: 950;\n  text-transform: uppercase;\n}\n\n.post-time,\n.post-hours {\n  color: #6c657a;\n  font-size: 13px;\n  font-weight: 750;\n}\n\n.post-stats {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 8px;\n}\n\n.stat,\n.post-stat {\n  padding: 10px;\n  border-radius: 16px;\n  background-color: #f2eff8;\n}\n\n.stat-number,\n.post-stat-number {\n  display: block;\n  color: #17101f;\n  font-size: 16px;\n  font-weight: 950;\n}\n\n.stat-label,\n.post-stat-label {\n  color: #786f88;\n  font-size: 11px;\n  font-weight: 850;\n  text-transform: uppercase;\n}\n\n/* Discovery panel */\n\n.discover-panel {\n  display: grid;\n  gap: 14px;\n}\n\n.panel-card {\n  border: 1px solid var(--border-dark);\n  border-radius: 28px;\n  padding: 18px;\n  background-color: rgba(255, 255, 255, 0.08);\n  box-shadow: var(--shadow-soft);\n}\n\n.pulse-card {\n  background:\n    linear-gradient(135deg, rgba(255, 61, 139, 0.28), rgba(34, 211, 238, 0.16)),\n    rgba(255, 255, 255, 0.08);\n}\n\n.panel-title {\n  margin-bottom: 8px;\n  font-size: 24px;\n  line-height: 1;\n  letter-spacing: -0.04em;\n}\n\n.post-count {\n  color: rgba(247, 242, 255, 0.7);\n  font-size: 14px;\n  font-weight: 800;\n}\n\n.topic-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 9px;\n  margin-top: 12px;\n}\n\n.topic-pill {\n  border-radius: 999px;\n  padding: 9px 11px;\n  color: var(--light-text);\n  background-color: rgba(255, 255, 255, 0.1);\n  font-size: 13px;\n  font-weight: 850;\n}\n\n.panel-text {\n  color: rgba(247, 242, 255, 0.72);\n  font-size: 14px;\n  line-height: 1.5;\n}\n\n/* Focus states */\n\nbutton:focus-visible,\ninput:focus-visible {\n  outline: 3px solid rgba(34, 211, 238, 0.75);\n  outline-offset: 3px;\n}\n\n/* Small screens */\n\n@media (max-width: 420px) {\n  .feed-topper {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n\n  .refresh-button {\n    width: 100%;\n  }\n\n  .post-stats {\n    grid-template-columns: 1fr;\n  }\n}\n\n/* Tablet */\n\n@media (min-width: 680px) {\n  .top-bar {\n    grid-template-columns: auto minmax(260px, 1fr) auto;\n    align-items: center;\n  }\n\n  .profile-pill {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    justify-self: end;\n    padding: 8px 10px 8px 14px;\n    border: 1px solid var(--border-dark);\n    border-radius: 999px;\n    background-color: rgba(255, 255, 255, 0.08);\n  }\n\n  .profile-name {\n    color: rgba(247, 242, 255, 0.76);\n    font-size: 13px;\n    font-weight: 850;\n  }\n\n  .profile-avatar {\n    width: 30px;\n    height: 30px;\n    border-radius: 50%;\n    background:\n      radial-gradient(circle at 30% 25%, white, transparent 18%),\n      linear-gradient(135deg, var(--accent-pink), var(--accent-blue));\n  }\n\n  .post-stream {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .discover-panel {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n}\n\n/* Desktop */\n\n@media (min-width: 980px) {\n  .app-shell {\n    display: grid;\n    grid-template-columns: 230px minmax(0, 1fr);\n  }\n\n  .side-rail {\n    position: sticky;\n    top: 0;\n    display: flex;\n    flex-direction: column;\n    gap: 30px;\n    min-height: 100vh;\n    padding: 24px;\n    border-right: 1px solid var(--border-dark);\n    background-color: rgba(9, 7, 19, 0.58);\n    backdrop-filter: blur(18px);\n  }\n\n  .mobile-brand {\n    display: none;\n  }\n\n  .top-bar {\n    grid-template-columns: minmax(280px, 560px) auto;\n    justify-content: space-between;\n    padding: 18px 28px;\n  }\n\n  .main-content {\n    grid-template-columns: minmax(0, 1fr) 290px;\n    align-items: start;\n    padding: 28px;\n  }\n\n  .post-stream {\n    grid-template-columns: 1fr;\n  }\n\n  .discover-panel {\n    position: sticky;\n    top: 96px;\n    grid-template-columns: 1fr;\n  }\n}\n\n/* Wide desktop */\n\n@media (min-width: 1220px) {\n  .app-shell {\n    grid-template-columns: 250px minmax(0, 1fr);\n  }\n\n  .main-content {\n    grid-template-columns: minmax(0, 760px) 320px;\n  }\n\n  .post-card {\n    display: grid;\n    grid-template-columns: 45% 55%;\n  }\n\n  .post-media,\n  .post-image-wrap {\n    height: 100%;\n    aspect-ratio: auto;\n  }\n\n  .post-content,\n  .post-info {\n    align-content: center;\n    padding: 22px;\n  }\n}",
          "folderId": "0",
          "active": true
        }
      },
