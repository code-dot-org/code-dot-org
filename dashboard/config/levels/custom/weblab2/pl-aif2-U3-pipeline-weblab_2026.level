        "11": {
          "id": "11",
          "name": "data.js",
          "contents": "const allPosts = [\n  {\n    id: 1,\n    author: \"@roomroutine\",\n    likes: 16800,\n    shares: 3900,\n    views: 184000,\n    hoursAgo: 2,\n    category: \"Dance\",\n    image: \"images/dance.png\",\n    alt: \"Friends doing a dance challenge in a bedroom with blue LED lights\"\n  },\n  {\n    id: 2,\n    author: \"@quicktake\",\n    likes: 9200,\n    shares: 4100,\n    views: 118000,\n    hoursAgo: 5,\n    category: \"News\",\n    image: \"images/news.png\",\n    alt: \"Teen creator holding a microphone at a desk with notes and a laptop\"\n  },\n  {\n    id: 3,\n    author: \"@brushmic\",\n    likes: 20400,\n    shares: 5200,\n    views: 232000,\n    hoursAgo: 13,\n    category: \"Comedy\",\n    image: \"images/comedy.png\",\n    alt: \"Friends laughing in a bedroom while one person uses a hairbrush like a microphone\"\n  },\n  {\n    id: 4,\n    author: \"@freeprizebot\",\n    likes: 180,\n    shares: 22,\n    views: 310000,\n    hoursAgo: 1,\n    category: \"Spam\",\n    image: \"images/spam.png\",\n    alt: \"Messy desk with a laptop showing blurred warning popups\"\n  },\n  {\n    id: 5,\n    author: \"@earbudcheck\",\n    likes: 11200,\n    shares: 2600,\n    views: 146000,\n    hoursAgo: 9,\n    category: \"Tech\",\n    image: \"images/tech.png\",\n    alt: \"Teen creator holding wireless earbuds at a desk setup\"\n  },\n  {\n    id: 6,\n    author: \"@setupmode\",\n    likes: 13600,\n    shares: 2800,\n    views: 171000,\n    hoursAgo: 6,\n    category: \"Gaming\",\n    image: \"images/gaming.png\",\n    alt: \"Gaming desk with monitors, keyboard, controller, headphones, and snacks\"\n  },\n  {\n    id: 7,\n    author: \"@snacktable\",\n    likes: 15700,\n    shares: 3400,\n    views: 163000,\n    hoursAgo: 18,\n    category: \"Food\",\n    image: \"images/food.png\",\n    alt: \"Table full of fries, noodles, tacos, snacks, and colorful drinks\"\n  },\n  {\n    id: 8,\n    author: \"@courtcrew\",\n    likes: 12800,\n    shares: 4700,\n    views: 139000,\n    hoursAgo: 3,\n    category: \"Sports\",\n    image: \"images/sports.png\",\n    alt: \"Players competing for the ball on an outdoor basketball court\"\n  },\n  {\n    id: 9,\n    author: \"@pawstealer\",\n    likes: 23800,\n    shares: 6100,\n    views: 205000,\n    hoursAgo: 11,\n    category: \"Animal\",\n    image: \"images/cat.png\",\n    alt: \"Cat reaching toward a plate of spaghetti while looking into the camera\"\n  },\n  {\n    id: 10,\n    author: \"@peakfriends\",\n    likes: 9700,\n    shares: 1800,\n    views: 99000,\n    hoursAgo: 24,\n    category: \"Travel\",\n    image: \"images/travel.png\",\n    alt: \"Friends sitting at a mountain overlook with lakes below at sunset\"\n  }\n];",
          "folderId": "0",
