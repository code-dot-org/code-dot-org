        "15": {
          "id": "15",
          "name": "script.js",
          "contents": "// View 1\n\n// This array controls which posts are currently shown.\nlet displayPosts = allPosts;\n\n// First page load\nrenderPosts();\n\n// Feed Algorithm\n\n// Builds the For You feed.\nconst buildForYouFeed = () => {\n  // filter → sort → render\n\n\n\n\n\n\n\n};\n\n// Event listeners\ndocument.getElementById(\"buildFeedBtn\").addEventListener(\"click\", buildForYouFeed);",
