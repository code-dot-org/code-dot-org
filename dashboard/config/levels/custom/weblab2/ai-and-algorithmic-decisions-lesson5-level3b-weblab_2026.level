  "properties": {
    "require_edit_to_continue": "true",
    "display_name": "Mute Toggle",
    "bubble_choice_description": "Use AI to turn your mute toggle flowchart into working code.",
    "thumbnail_url": "https://images.code.org/110ccf4bbf8697cf8a64de7194156c25-Screenshot 2026-04-14 at 5.18.28 PM.png",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Lo-Fi Chill</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <div class=\"card\">\n    <div class=\"cover\"></div>\n\n    <div class=\"content\">\n      <h1>Lo-Fi Chill</h1>\n      <h2>Orange Music Chill</h2>\n\n      <p class=\"description\">\n        Press play and let the world slow down a little.\n      </p>\n\n      <button class=\"preview\" type=\"button\">▶ Preview</button>\n    </div>\n\n    <div class=\"list-header\">\n      <span>Song</span>\n      <span>Artist</span>\n      <span>Time</span>\n    </div>\n\n    <div class=\"track\">\n      <span>Midnight Static</span>\n      <span>Echo Bloom</span>\n      <span>2:07</span>\n    </div>\n\n    <div class=\"track\">\n      <span>Rain on Glass</span>\n      <span>Soft Circuit</span>\n      <span>3:12</span>\n    </div>\n\n    <div class=\"track\">\n      <span>Cloud Drift</span>\n      <span>Nova Luma</span>\n      <span>2:41</span>\n    </div>\n\n    <div class=\"track\">\n      <span>Late Night Lines</span>\n      <span>Velvet Loop</span>\n      <span>2:18</span>\n    </div>\n\n    <div class=\"bottom-bar\">\n      <div class=\"controls\">\n        <button class=\"icon-btn\" type=\"button\" aria-label=\"Shuffle\">⤮</button>\n        <button class=\"icon-btn\" type=\"button\" aria-label=\"Previous track\">⏮</button>\n        <button class=\"icon-btn play-btn\" type=\"button\" aria-label=\"Play\">▶</button>\n        <button class=\"icon-btn\" type=\"button\" aria-label=\"Next track\">⏭</button>\n        <button class=\"icon-btn\" type=\"button\" aria-label=\"Repeat\">↻</button>\n      </div>\n\n      <div class=\"volume-wrap\">\n        <button\n          class=\"icon-btn volume-icon-btn\"\n          id=\"muteBtn\"\n          type=\"button\"\n          aria-label=\"Mute or unmute\"\n        >\n          <span class=\"volume-icon\" id=\"volumeIcon\">🔊</span>\n        </button>\n\n        <input\n          type=\"range\"\n          min=\"0\"\n          max=\"100\"\n          value=\"62\"\n          class=\"volume-slider\"\n          id=\"volume\"\n          aria-label=\"Volume\"\n        />\n      </div>\n    </div>\n  </div>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n}\n\nhtml,\nbody {\n  height: 100%;\n}\n\nbody {\n  margin: 0;\n  background: #121214;\n  color: #f4f4f6;\n}\n\n/* App container */\n.card {\n  width: 100%;\n  min-height: 100%;\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 16px;\n  background: linear-gradient(180deg, #19191d 0%, #141417 100%);\n}\n\n/* Cover */\n.cover {\n  width: 100%;\n  height: 160px;\n  margin-bottom: 8px;\n  border-radius: 16px;\n  background:\n    linear-gradient(135deg, rgba(255,255,255,0.2), rgba(255,255,255,0.02)),\n    linear-gradient(135deg, #f6d5a8, #c3e4ff 55%, #f7c3cf);\n}\n\n/* Content */\n.content h1 {\n  font-size: 20px;\n}\n\n.content h2 {\n  margin-bottom: 6px;\n  font-size: 16px;\n  color: #ff375f;\n}\n\n.description {\n  margin-bottom: 8px;\n  font-size: 12px;\n  line-height: 1.4;\n  color: #9a9aa1;\n}\n\n.preview {\n  border: none;\n  border-radius: 999px;\n  padding: 6px 12px;\n  font-size: 12px;\n  cursor: pointer;\n  color: white;\n  background: #ff375f;\n}\n\n/* Track list */\n.list-header {\n  display: grid;\n  grid-template-columns: 1fr 1fr 40px;\n  margin-top: 10px;\n  padding-top: 6px;\n  font-size: 11px;\n  color: #9a9aa1;\n  border-top: 1px solid rgba(255,255,255,0.08);\n}\n\n.track {\n  display: grid;\n  grid-template-columns: 1fr 1fr 40px;\n  gap: 8px;\n  padding: 7px 0;\n  font-size: 12px;\n  border-bottom: 1px solid rgba(255,255,255,0.08);\n}\n\n.track:last-child {\n  border-bottom: none;\n}\n\n.track span {\n  overflow: hidden;\n  white-space: nowrap;\n  text-overflow: ellipsis;\n}\n\n/* Bottom controls */\n.bottom-bar {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  margin-top: auto;\n  padding-top: 10px;\n  border-top: 1px solid rgba(255,255,255,0.08);\n}\n\n.controls {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n}\n\n.icon-btn {\n  border: none;\n  background: transparent;\n  color: #9a9aa1;\n  font-size: 16px;\n  cursor: pointer;\n  transition: color 0.2s ease, transform 0.15s ease, background 0.2s ease;\n}\n\n.icon-btn:hover {\n  color: #ffffff;\n}\n\n.icon-btn:active {\n  transform: scale(0.94);\n}\n\n.icon-btn:focus-visible {\n  outline: 2px solid #ff375f;\n  outline-offset: 2px;\n}\n\n/* Play button */\n.play-btn {\n  width: 34px;\n  height: 34px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 999px;\n  background: #1d1d22;\n  color: #f4f4f6;\n}\n\n/* Volume */\n.volume-wrap {\n  display: grid;\n  grid-template-columns: 32px 1fr;\n  align-items: center;\n  gap: 8px;\n}\n\n/* Mute button (now clearly clickable) */\n.volume-icon-btn {\n  width: 28px;\n  height: 28px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 999px;\n  background: #1d1d22;\n  transition: transform 0.15s ease, background 0.2s ease;\n}\n\n.volume-icon-btn:hover {\n  background: #971730;\n  transform: scale(1.05);\n}\n\n.volume-icon-btn:active {\n  transform: scale(0.9);\n}\n\n.volume-icon-btn:focus-visible {\n  outline: 2px solid #ff375f;\n  outline-offset: 2px;\n}\n\n.volume-icon {\n  font-size: 13px;\n  color: #f4f4f6;\n  transition: transform 0.15s ease;\n}\n\n.volume-icon-btn:hover .volume-icon {\n  transform: scale(1.1);\n}\n\n/* Native slider */\n.volume-slider {\n  width: 100%;\n  cursor: pointer;\n  accent-color: #d8d8dd;\n}",
          "folderId": "0",
          "active": false
        },
