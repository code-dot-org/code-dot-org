    "ai_tutor_prompt_settings": {
      "answerTypes": [
        "buildJavaScript",
        "documentation"
      ],
      "answerTypeCustomizations": {
        "buildJavaScript": "Follow these strict rules when generating code: use `getElementById` to select elements and do not use `querySelector`, `querySelectorAll`, arrays, loops, or advanced abstractions. Write a named arrow function for the mute toggle event handler and attach it with `addEventListener`. Use a single boolean variable called `isMuted` to track whether the sound is muted. All logic must be written with simple `if/else` statements only. When the mute button is clicked, if `isMuted` is `true`, set the slider value to `50`, change the volume icon text to the active speaker icon (`🔊`), and set `isMuted` to `false`. Otherwise, set the slider value to `0`, change the volume icon text to the slashed speaker icon (`🔇`), and set `isMuted` to `true`. Do not use helper files, extra functions, class toggling, or unnecessary features. Keep the code short, direct, and beginner-friendly. Return complete JavaScript for the mute button behavior, not a partial example."
      }
    }
  },
