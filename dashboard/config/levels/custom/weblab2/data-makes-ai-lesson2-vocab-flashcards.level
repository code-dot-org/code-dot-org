      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en-US\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Vocabulary cards</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"app\" id=\"app\">\n    <h1 class=\"deck-title\" id=\"deck-title\">Vocabulary cards</h1>\n\n    <div class=\"stage\">\n      <div class=\"card\" id=\"card\" tabindex=\"0\" role=\"group\" aria-labelledby=\"deck-title\" hidden>\n        <div class=\"card-inner\">\n          <section class=\"card-face card-front\" id=\"card-front\">\n            <span class=\"card-label\"></span>\n            <div class=\"card-content\"></div>\n            <p class=\"card-hint\"></p>\n          </section>\n          <section class=\"card-face card-back\" id=\"card-back\" aria-hidden=\"true\">\n            <span class=\"card-label\"></span>\n            <div class=\"card-content\"></div>\n          </section>\n        </div>\n      </div>\n\n      <div class=\"message\" id=\"message\" tabindex=\"-1\">\n        <p class=\"message-text\" id=\"message-text\">Loading cards...</p>\n        <p class=\"message-detail\" id=\"message-detail\" hidden></p>\n        <div class=\"message-actions\" id=\"message-actions\" hidden>\n          <button type=\"button\" class=\"btn\" id=\"finish-restart\">\n            <span class=\"btn-label\">Start over</span>\n            <span class=\"btn-key\">R</span>\n          </button>\n          <button type=\"button\" class=\"btn btn-secondary\" id=\"finish-review\" hidden>\n            <span class=\"btn-label\"></span>\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"controls controls-primary\">\n      <button type=\"button\" class=\"btn\" id=\"btn-back\" disabled>\n        <span class=\"btn-label\">Back</span>\n        <span class=\"btn-key\">Left</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-flip\" id=\"btn-flip\" disabled>\n        <span class=\"btn-label\">Flip</span>\n        <span class=\"btn-key\">Space</span>\n      </button>\n      <button type=\"button\" class=\"btn\" id=\"btn-next\" disabled>\n        <span class=\"btn-label\">Next</span>\n        <span class=\"btn-key\">Right</span>\n      </button>\n    </div>\n\n    <fieldset class=\"controls controls-secondary\" id=\"options\">\n      <legend class=\"visually-hidden\" id=\"options-legend\">Card options</legend>\n      <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-shuffle\" disabled>\n        <span class=\"btn-label\">Shuffle</span>\n        <span class=\"btn-key\">S</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-direction\" disabled>\n        <span class=\"btn-label\">Start from definition</span>\n        <span class=\"btn-key\">F</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-secondary btn-toggle\" id=\"btn-known\" aria-pressed=\"false\" disabled>\n        <span class=\"btn-label\">\n          <svg class=\"check-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2.5 8.5l3.5 3.5 7.5-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          <span class=\"btn-text\">Got it</span>\n        </span>\n        <span class=\"btn-key\">K</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-restart\" disabled>\n        <span class=\"btn-label\">Start over</span>\n        <span class=\"btn-key\">R</span>\n      </button>\n    </fieldset>\n\n    <fieldset class=\"style-picker\" id=\"style-picker\" hidden>\n      <legend class=\"visually-hidden\" id=\"style-legend\">Practice with</legend>\n      <button type=\"button\" class=\"chip\" data-kind=\"definition\" aria-pressed=\"true\">\n        <span class=\"btn-label\">\n          <svg class=\"check-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2.5 8.5l3.5 3.5 7.5-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          <span class=\"btn-text\">Definitions</span>\n        </span>\n        <span class=\"btn-key\">1</span>\n      </button>\n      <button type=\"button\" class=\"chip\" data-kind=\"example\" aria-pressed=\"true\">\n        <span class=\"btn-label\">\n          <svg class=\"check-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2.5 8.5l3.5 3.5 7.5-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          <span class=\"btn-text\">Examples</span>\n        </span>\n        <span class=\"btn-key\">2</span>\n      </button>\n      <button type=\"button\" class=\"chip\" data-kind=\"image\" aria-pressed=\"true\">\n        <span class=\"btn-label\">\n          <svg class=\"check-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2.5 8.5l3.5 3.5 7.5-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          <span class=\"btn-text\">Pictures</span>\n        </span>\n        <span class=\"btn-key\">3</span>\n      </button>\n    </fieldset>\n\n    <div class=\"status\" aria-live=\"polite\">\n      <p class=\"counter\" id=\"counter\"></p>\n      <p class=\"visually-hidden\" id=\"sr-status\"></p>\n    </div>\n  </main>\n</body>\n</html>\n",
          "active": true,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "\"use strict\";\n\nconst STRINGS = {\n  pageTitle: \"Vocabulary cards\",\n  loading: \"Loading cards...\",\n  loadErrorDeck: \"The cards didn’t load. Ask your teacher to check deck.json.\",\n  loadErrorConfig: \"The cards didn’t load. Ask your teacher to check config.json.\",\n  kindLabels: {\n    word: \"WORD\",\n    definition: \"DEFINITION\",\n    example: \"EXAMPLE\",\n    image: \"IMAGE\"\n  },\n  kindNames: {\n    word: \"Word\",\n    definition: \"Definition\",\n    example: \"Example\",\n    image: \"Picture\"\n  },\n  hints: {\n    word: \"Guess the word\",\n    definition: \"Guess the definition\",\n    example: \"Guess the example\"\n  },\n  back: \"Back\",\n  flip: \"Flip\",\n  next: \"Next\",\n  keys: {\n    back: \"Left\",\n    flip: \"Space\",\n    next: \"Right\",\n    shuffle: \"S\",\n    direction: \"F\",\n    known: \"K\",\n    restart: \"R\"\n  },\n  optionsLegend: \"Card options\",\n  shuffle: \"Shuffle\",\n  startFrom: {\n    word: \"Start from word\",\n    definition: \"Start from definition\",\n    example: \"Start from example\"\n  },\n  gotIt: \"Got it\",\n  startOver: \"Start over\",\n  counter: (position, total) => `Card ${position} of ${total}`,\n  leftToLearn: {\n    one: (count) => `${count} left to learn`,\n    other: (count) => `${count} left to learn`\n  },\n  finished: {\n    one: () => \"You went through the only card\",\n    other: (count) => `You went through all ${count} cards`\n  },\n  allKnown: \"You marked every card. Nice work.\",\n  reviewUnknown: {\n    one: () => \"Review the 1 you haven’t marked\",\n    other: (count) => `Review the ${count} you haven’t marked`\n  },\n  faceAnnouncement: (kindName, content) => `${kindName}: ${content}`,\n  cardAnnouncement: (position, face, hint) => `${position}. ${face} ${hint}.`,\n  flipAnnouncement: (face) => `Other side. ${face}`,\n  shuffledAnnouncement: (position) => `Cards shuffled. ${position}.`,\n  knownAnnouncement: \"Marked as known.\",\n  unknownAnnouncement: \"Not marked as known.\",\n  firstCardAnnouncement: \"This is the first card.\",\n  pictureMissing: \"Picture not available.\",\n  styleLegend: \"Practice with\",\n  kindChips: {\n    definition: \"Definitions\",\n    example: \"Examples\",\n    image: \"Pictures\"\n  },\n  kindChipKeys: {\n    definition: \"1\",\n    example: \"2\",\n    image: \"3\"\n  },\n  kindOnAnnouncement: {\n    one: (label, count) => `${label} on. ${count} card in play.`,\n    other: (label, count) => `${label} on. ${count} cards in play.`\n  },\n  kindOffAnnouncement: {\n    one: (label, count) => `${label} off. ${count} card in play.`,\n    other: (label, count) => `${label} off. ${count} cards in play.`\n  },\n  keepOneKind: \"Keep at least one kind turned on.\"\n};\n\nconst CARD_TYPES = {\n  \"word-definition\": { front: \"word\", back: \"definition\", mirror: \"definition-word\" },\n  \"definition-word\": { front: \"definition\", back: \"word\", mirror: \"word-definition\" },\n  \"image-word\": { front: \"image\", back: \"word-definition\", mirror: null },\n  \"example-word\": { front: \"example\", back: \"word\", mirror: \"word-example\" },\n  \"word-example\": { front: \"word\", back: \"example\", mirror: \"example-word\" }\n};\n\nconst DEFAULT_CONFIG = {\n  theme: {\n    background: \"#E4E2F8\",\n    cardFace: \"#FFFFFF\",\n    textColor: \"#000000\",\n    accent: \"#4C42CF\",\n    frameColors: {\n      word: \"#0099F3\",\n      definition: \"#003F25\",\n      example: \"#F46800\",\n      image: \"#4C42CF\"\n    },\n    fontFamily: \"system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif\",\n    wordSize: \"large\",\n    textAlign: \"center\",\n    textPosition: \"center\",\n    cornerRadius: \"medium\"\n  },\n  controls: {\n    shuffle: true,\n    flipDirection: true,\n    progressCounter: true,\n    markKnown: true\n  },\n  startFlipped: false,\n  startShuffled: false,\n  randomizeTypes: false,\n  randomizeAlternates: true,\n  studentStylePicker: false\n};\n\nconst ENUMS = {\n  wordSize: [\"medium\", \"large\", \"xlarge\"],\n  textAlign: [\"start\", \"center\"],\n  textPosition: [\"top\", \"center\"],\n  cornerRadius: [\"none\", \"medium\", \"round\"]\n};\n\nconst TYPE_NAMES = Object.keys(CARD_TYPES);\nconst KIND_TYPES = {\n  definition: [\"word-definition\", \"definition-word\"],\n  example: [\"example-word\", \"word-example\"],\n  image: [\"image-word\"]\n};\nconst PICKER_KINDS = [\"definition\", \"example\", \"image\"];\nconst RTL_LANGUAGES = [\"ar\", \"dv\", \"fa\", \"he\", \"ps\", \"ur\", \"yi\"];\nconst SVG_NS = \"http://www.w3.org/2000/svg\";\n\nconst state = {\n  ready: false,\n  config: DEFAULT_CONFIG,\n  title: STRINGS.pageTitle,\n  cards: [],\n  typesInPlay: TYPE_NAMES.slice(),\n  pass: [],\n  showing: null,\n  lastPicks: new Map(),\n  pickerKinds: [],\n  selectedKinds: new Set(),\n  index: 0,\n  flipped: false,\n  reversed: false,\n  finished: false,\n  known: new Set()\n};\n\nconst els = {};\n\ndocument.addEventListener(\"DOMContentLoaded\", init);\n\nfunction init() {\n  cacheElements();\n  applyStrings();\n  bindEvents();\n  showMessage(STRINGS.loading);\n  loadData();\n}\n\nfunction cacheElements() {\n  const ids = [\n    \"app\", \"deck-title\", \"card\", \"card-front\", \"card-back\", \"message\", \"message-text\",\n    \"message-detail\", \"message-actions\", \"finish-restart\", \"finish-review\", \"btn-back\",\n    \"btn-flip\", \"btn-next\", \"options\", \"options-legend\", \"btn-shuffle\", \"btn-direction\",\n    \"btn-known\", \"btn-restart\", \"counter\", \"sr-status\", \"style-picker\", \"style-legend\"\n  ];\n  ids.forEach((id) => {\n    els[toCamel(id)] = document.getElementById(id);\n  });\n}\n\nfunction toCamel(id) {\n  return id.replace(/-([a-z])/g, (match, letter) => letter.toUpperCase());\n}\n\nfunction applyStrings() {\n  document.title = STRINGS.pageTitle;\n  els.deckTitle.textContent = STRINGS.pageTitle;\n  setButtonText(els.btnBack, STRINGS.back, STRINGS.keys.back);\n  setButtonText(els.btnFlip, STRINGS.flip, STRINGS.keys.flip);\n  setButtonText(els.btnNext, STRINGS.next, STRINGS.keys.next);\n  setButtonText(els.btnShuffle, STRINGS.shuffle, STRINGS.keys.shuffle);\n  setButtonText(els.btnDirection, STRINGS.startFrom.definition, STRINGS.keys.direction);\n  setButtonText(els.btnKnown, STRINGS.gotIt, STRINGS.keys.known);\n  setButtonText(els.btnRestart, STRINGS.startOver, STRINGS.keys.restart);\n  setButtonText(els.finishRestart, STRINGS.startOver, STRINGS.keys.restart);\n  els.optionsLegend.textContent = STRINGS.optionsLegend;\n  els.styleLegend.textContent = STRINGS.styleLegend;\n  kindChips().forEach((chip) => {\n    const kind = chip.getAttribute(\"data-kind\");\n    setButtonText(chip, STRINGS.kindChips[kind], STRINGS.kindChipKeys[kind]);\n  });\n}\n\nfunction kindChips() {\n  return Array.prototype.slice.call(els.stylePicker.querySelectorAll(\".chip\"));\n}\n\nfunction setButtonText(button, label, key) {\n  const text = button.querySelector(\".btn-text\") || button.querySelector(\".btn-label\");\n  text.textContent = label;\n  const keyEl = button.querySelector(\".btn-key\");\n  if (keyEl) {\n    keyEl.textContent = key;\n  }\n}\n\nfunction bindEvents() {\n  els.btnBack.addEventListener(\"click\", goBack);\n  els.btnFlip.addEventListener(\"click\", flip);\n  els.btnNext.addEventListener(\"click\", goNext);\n  els.btnShuffle.addEventListener(\"click\", shuffleCards);\n  els.btnDirection.addEventListener(\"click\", switchDirection);\n  els.btnKnown.addEventListener(\"click\", toggleKnown);\n  els.btnRestart.addEventListener(\"click\", startOver);\n  kindChips().forEach((chip) => {\n    chip.addEventListener(\"click\", () => toggleKind(chip.getAttribute(\"data-kind\")));\n  });\n  els.finishRestart.addEventListener(\"click\", startOver);\n  els.finishReview.addEventListener(\"click\", reviewUnknown);\n  document.addEventListener(\"keydown\", handleKeydown);\n}\n\n/* Loading */\n\nasync function loadData() {\n  let config;\n  try {\n    config = normalizeConfig(await fetchJson(\"config.json\"));\n  } catch (error) {\n    console.error(\"config.json could not be loaded:\", error);\n    showMessage(STRINGS.loadErrorConfig);\n    return;\n  }\n\n  let deck;\n  try {\n    deck = normalizeDeck(await fetchJson(\"deck.json\"));\n  } catch (error) {\n    console.error(\"deck.json could not be loaded:\", error);\n    showMessage(STRINGS.loadErrorDeck);\n    return;\n  }\n\n  start(config, deck);\n}\n\nasync function fetchJson(path) {\n  const response = await fetch(path, { cache: \"no-store\" });\n  if (!response.ok) {\n    throw new Error(`${path} returned status ${response.status}`);\n  }\n  return response.json();\n}\n\nfunction normalizeConfig(raw) {\n  if (!isObject(raw)) {\n    throw new Error(\"config.json must be a JSON object.\");\n  }\n  const theme = isObject(raw.theme) ? raw.theme : {};\n  const frames = isObject(theme.frameColors) ? theme.frameColors : {};\n  const controls = isObject(raw.controls) ? raw.controls : {};\n  const defaults = DEFAULT_CONFIG;\n\n  return {\n    theme: {\n      background: pickColor(theme.background, defaults.theme.background),\n      cardFace: pickColor(theme.cardFace, defaults.theme.cardFace),\n      textColor: pickColor(theme.textColor, defaults.theme.textColor),\n      accent: pickColor(theme.accent, defaults.theme.accent),\n      frameColors: {\n        word: pickColor(frames.word, defaults.theme.frameColors.word),\n        definition: pickColor(frames.definition, defaults.theme.frameColors.definition),\n        example: pickColor(frames.example, defaults.theme.frameColors.example),\n        image: pickColor(frames.image, defaults.theme.frameColors.image)\n      },\n      fontFamily: pickFont(theme.fontFamily, defaults.theme.fontFamily),\n      wordSize: pickEnum(theme.wordSize, \"wordSize\", defaults.theme.wordSize),\n      textAlign: pickEnum(theme.textAlign, \"textAlign\", defaults.theme.textAlign),\n      textPosition: pickEnum(theme.textPosition, \"textPosition\", defaults.theme.textPosition),\n      cornerRadius: pickEnum(theme.cornerRadius, \"cornerRadius\", defaults.theme.cornerRadius)\n    },\n    controls: {\n      shuffle: pickBoolean(controls.shuffle, defaults.controls.shuffle),\n      flipDirection: pickBoolean(controls.flipDirection, defaults.controls.flipDirection),\n      progressCounter: pickBoolean(controls.progressCounter, defaults.controls.progressCounter),\n      markKnown: pickBoolean(controls.markKnown, defaults.controls.markKnown)\n    },\n    startFlipped: pickBoolean(raw.startFlipped, defaults.startFlipped),\n    startShuffled: pickBoolean(raw.startShuffled, defaults.startShuffled),\n    randomizeTypes: pickBoolean(raw.randomizeTypes, defaults.randomizeTypes),\n    randomizeAlternates: pickBoolean(raw.randomizeAlternates, defaults.randomizeAlternates),\n    studentStylePicker: pickBoolean(raw.studentStylePicker, defaults.studentStylePicker)\n  };\n}\n\nfunction normalizeDeck(raw) {\n  if (!isObject(raw) || !Array.isArray(raw.cards)) {\n    throw new Error(\"deck.json needs a \\\"cards\\\" list.\");\n  }\n  const cards = [];\n  raw.cards.forEach((rawCard, position) => {\n    const card = normalizeCard(rawCard);\n    const problem = card ? findCardProblem(card) : \"it is not an object\";\n    if (problem) {\n      console.warn(`Skipping card ${position + 1} in deck.json: ${problem}`);\n      return;\n    }\n    cards.push(card);\n  });\n  if (cards.length === 0) {\n    throw new Error(\"deck.json has no usable cards.\");\n  }\n  const typesInPlay = Array.isArray(raw.typesInPlay)\n    ? raw.typesInPlay.filter((type) => Boolean(CARD_TYPES[type]))\n    : [];\n  return {\n    title: isFilledString(raw.title) ? raw.title.trim() : STRINGS.pageTitle,\n    lang: isFilledString(raw.lang) ? raw.lang.trim() : \"\",\n    typesInPlay: typesInPlay.length > 0 ? typesInPlay : TYPE_NAMES.slice(),\n    cards\n  };\n}\n\nfunction normalizeCard(raw) {\n  if (!isObject(raw)) {\n    return null;\n  }\n  return {\n    id: raw.id,\n    type: raw.type,\n    word: raw.word,\n    definitions: toList(raw.definitions, raw.definition).filter(isFilledString),\n    examples: toList(raw.examples, raw.example).filter(isFilledString),\n    images: toList(raw.images, raw.image).filter((image) => isObject(image) && isFilledString(image.svg) && isFilledString(image.alt))\n  };\n}\n\nfunction toList(list, single) {\n  if (Array.isArray(list)) {\n    return list;\n  }\n  return single === undefined ? [] : [single];\n}\n\nfunction findCardProblem(card) {\n  if (!isFilledString(card.id)) {\n    return \"it has no id\";\n  }\n  if (!isFilledString(card.word)) {\n    return \"it has no word\";\n  }\n  if (!CARD_TYPES[card.type]) {\n    return `\"${card.type}\" is not a card type`;\n  }\n  if (!cardFits(card, card.type)) {\n    return `it is missing content its ${card.type} type needs (images also need alt text)`;\n  }\n  return \"\";\n}\n\nfunction cardFits(card, typeName) {\n  const type = CARD_TYPES[typeName];\n  const kinds = [type.front, type.back];\n  if (kinds.indexOf(\"definition\") !== -1 && card.definitions.length === 0) {\n    return false;\n  }\n  if (kinds.indexOf(\"example\") !== -1 && card.examples.length === 0) {\n    return false;\n  }\n  if (kinds.indexOf(\"image\") !== -1 && card.images.length === 0) {\n    return false;\n  }\n  return true;\n}\n\nfunction isObject(value) {\n  return value !== null && typeof value === \"object\" && !Array.isArray(value);\n}\n\nfunction isFilledString(value) {\n  return typeof value === \"string\" && value.trim() !== \"\";\n}\n\nfunction pickColor(value, fallback) {\n  return typeof value === \"string\" && /^#[0-9a-f]{6}$/i.test(value.trim()) ? value.trim() : fallback;\n}\n\nfunction pickFont(value, fallback) {\n  return typeof value === \"string\" && /^[\\w\\s,'\"-]+$/.test(value) ? value : fallback;\n}\n\nfunction pickEnum(value, name, fallback) {\n  return ENUMS[name].indexOf(value) !== -1 ? value : fallback;\n}\n\nfunction pickBoolean(value, fallback) {\n  return typeof value === \"boolean\" ? value : fallback;\n}\n\n/* Setup */\n\nfunction start(config, deck) {\n  state.config = config;\n  state.title = deck.title;\n  state.cards = deck.cards;\n  state.typesInPlay = deck.typesInPlay;\n  state.pickerKinds = config.studentStylePicker ? availableKinds() : [];\n  state.selectedKinds = new Set(state.pickerKinds);\n  state.reversed = config.startFlipped;\n\n  applyLanguage(deck.lang);\n  applyTheme(config.theme);\n  applyControls(config.controls);\n\n  document.title = deck.title;\n  els.deckTitle.textContent = deck.title;\n\n  state.ready = true;\n  setButtonsDisabled(false);\n  beginPass(config.startShuffled ? shuffled(state.cards) : state.cards.slice());\n  els.card.focus();\n}\n\nfunction applyLanguage(lang) {\n  if (!lang) {\n    return;\n  }\n  document.documentElement.lang = lang;\n  const base = lang.split(\"-\")[0].toLowerCase();\n  document.documentElement.dir = RTL_LANGUAGES.indexOf(base) !== -1 ? \"rtl\" : \"ltr\";\n}\n\nfunction applyTheme(theme) {\n  const root = document.documentElement.style;\n  root.setProperty(\"--bg\", theme.background);\n  root.setProperty(\"--card-face\", theme.cardFace);\n  root.setProperty(\"--text\", theme.textColor);\n  root.setProperty(\"--accent\", theme.accent);\n  root.setProperty(\"--accent-text\", readableTextOn(theme.accent));\n  root.setProperty(\"--font\", theme.fontFamily);\n  Object.keys(theme.frameColors).forEach((kind) => {\n    root.setProperty(`--frame-${kind}`, theme.frameColors[kind]);\n    root.setProperty(`--label-text-${kind}`, readableTextOn(theme.frameColors[kind]));\n  });\n  els.app.setAttribute(\"data-word-size\", theme.wordSize);\n  els.app.setAttribute(\"data-text-align\", theme.textAlign);\n  els.app.setAttribute(\"data-text-position\", theme.textPosition);\n  els.app.setAttribute(\"data-corner-radius\", theme.cornerRadius);\n}\n\nfunction readableTextOn(hex) {\n  const luminance = relativeLuminance(hex);\n  const withBlack = (luminance + 0.05) / 0.05;\n  const withWhite = 1.05 / (luminance + 0.05);\n  return withBlack >= withWhite ? \"#000000\" : \"#FFFFFF\";\n}\n\nfunction relativeLuminance(hex) {\n  const channels = [1, 3, 5].map((start) => {\n    const value = parseInt(hex.slice(start, start + 2), 16) / 255;\n    return value <= 0.03928 ? value / 12.92 : Math.pow((value + 0.055) / 1.055, 2.4);\n  });\n  return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2];\n}\n\nfunction applyControls(controls) {\n  els.btnShuffle.hidden = !controls.shuffle;\n  els.btnDirection.hidden = !controls.flipDirection || !state.cards.some(canMirror);\n  els.btnKnown.hidden = !controls.markKnown;\n  els.counter.hidden = false;\n  els.stylePicker.hidden = !pickerActive();\n  kindChips().forEach((chip) => {\n    const kind = chip.getAttribute(\"data-kind\");\n    chip.hidden = state.pickerKinds.indexOf(kind) === -1;\n    chip.setAttribute(\"aria-pressed\", state.selectedKinds.has(kind) ? \"true\" : \"false\");\n  });\n}\n\nfunction availableKinds() {\n  return PICKER_KINDS.filter((kind) => state.typesInPlay.some((type) => {\n    return KIND_TYPES[kind].indexOf(type) !== -1 && state.cards.some((card) => cardFits(card, type));\n  }));\n}\n\nfunction pickerActive() {\n  return state.config.studentStylePicker && state.pickerKinds.length > 1;\n}\n\nfunction allowedTypes() {\n  const allowed = [];\n  state.selectedKinds.forEach((kind) => {\n    KIND_TYPES[kind].forEach((type) => allowed.push(type));\n  });\n  return state.typesInPlay.filter((type) => allowed.indexOf(type) !== -1);\n}\n\nfunction hasMirror(typeName) {\n  return Boolean(CARD_TYPES[typeName].mirror);\n}\n\nfunction possibleTypes(card) {\n  if (pickerActive()) {\n    const fitting = allowedTypes().filter((type) => cardFits(card, type));\n    if (state.config.randomizeTypes) {\n      return fitting;\n    }\n    return fitting.indexOf(card.type) !== -1 ? [card.type] : fitting.slice(0, 1);\n  }\n  if (!state.config.randomizeTypes) {\n    return [card.type];\n  }\n  const options = state.typesInPlay.filter((type) => cardFits(card, type));\n  return options.length > 0 ? options : [card.type];\n}\n\nfunction isPlayable(card) {\n  return possibleTypes(card).length > 0;\n}\n\nfunction playableCards(cards) {\n  return cards.filter(isPlayable);\n}\n\nfunction nextPlayableIndex(from, step) {\n  for (let i = from; i >= 0 && i < state.pass.length; i += step) {\n    if (isPlayable(state.pass[i])) {\n      return i;\n    }\n  }\n  return -1;\n}\n\nfunction canMirror(card) {\n  return possibleTypes(card).some(hasMirror);\n}\n\nfunction setButtonsDisabled(disabled) {\n  [els.btnBack, els.btnFlip, els.btnNext, els.btnShuffle, els.btnDirection, els.btnKnown, els.btnRestart]\n    .forEach((button) => {\n      button.disabled = disabled;\n    });\n}\n\n/* Passes through the deck */\n\nfunction beginPass(cards) {\n  state.pass = cards;\n  state.index = Math.max(0, nextPlayableIndex(0, 1));\n  state.finished = false;\n  showCard({ redraw: true, announce: true });\n}\n\nfunction currentCard() {\n  return state.finished ? null : state.pass[state.index] || null;\n}\n\nfunction effectiveType(showing) {\n  const type = CARD_TYPES[showing.type];\n  return state.reversed && type.mirror ? type.mirror : showing.type;\n}\n\nfunction drawShowing(card) {\n  const fitting = possibleTypes(card);\n  const options = fitting.length > 0 ? fitting : [card.type];\n  const type = options[Math.floor(Math.random() * options.length)];\n  const typeInfo = CARD_TYPES[type];\n  const kinds = [typeInfo.front, typeInfo.back];\n  const usesDefinition = kinds.indexOf(\"definition\") !== -1 || kinds.indexOf(\"word-definition\") !== -1;\n  return {\n    card,\n    type,\n    definition: usesDefinition ? pickEntry(card, \"definitions\") : card.definitions[0],\n    example: kinds.indexOf(\"example\") !== -1 ? pickEntry(card, \"examples\") : card.examples[0],\n    image: kinds.indexOf(\"image\") !== -1 ? pickEntry(card, \"images\") : card.images[0]\n  };\n}\n\nfunction pickEntry(card, field) {\n  const list = card[field];\n  if (list.length === 0) {\n    return undefined;\n  }\n  if (list.length === 1 || !state.config.randomizeAlternates) {\n    return list[0];\n  }\n  const key = `${card.id}:${field}`;\n  const last = state.lastPicks.get(key);\n  let index = Math.floor(Math.random() * (list.length - 1));\n  if (last !== undefined && index >= last) {\n    index += 1;\n  } else if (last === undefined) {\n    index = Math.floor(Math.random() * list.length);\n  }\n  state.lastPicks.set(key, index);\n  return list[index];\n}\n\nfunction showCard(options) {\n  const card = currentCard();\n  if (!card) {\n    return;\n  }\n  if (options.redraw || !state.showing || state.showing.card !== card) {\n    state.showing = drawShowing(card);\n  }\n  const showing = state.showing;\n  const type = CARD_TYPES[effectiveType(showing)];\n\n  els.message.hidden = true;\n  els.card.hidden = false;\n\n  els.card.classList.add(\"no-animation\");\n  state.flipped = false;\n  els.card.classList.remove(\"is-flipped\");\n  fillFace(els.cardFront, type.front, showing);\n  fillFace(els.cardBack, type.back, showing);\n  els.cardFront.querySelector(\".card-hint\").textContent = STRINGS.hints[primaryKind(type.back)];\n  setFaceVisibility();\n  void els.card.offsetWidth;\n  els.card.classList.remove(\"no-animation\");\n\n  updateControls();\n  updateCounter();\n\n  if (options.announce) {\n    announce(STRINGS.cardAnnouncement(positionText(), describeFace(type.front, showing), STRINGS.hints[primaryKind(type.back)]));\n  }\n}\n\nfunction primaryKind(kind) {\n  return kind === \"word-definition\" ? \"word\" : kind;\n}\n\nfunction fillFace(face, kind, showing) {\n  const labelKind = primaryKind(kind);\n  face.setAttribute(\"data-kind\", labelKind);\n  face.querySelector(\".card-label\").textContent = STRINGS.kindLabels[labelKind];\n  face.querySelector(\".card-content\").replaceChildren(...buildContent(kind, showing));\n}\n\nfunction buildContent(kind, showing) {\n  if (kind === \"word\") {\n    return [textElement(\"p\", \"content-word\", showing.card.word)];\n  }\n  if (kind === \"definition\") {\n    return [textElement(\"p\", \"content-text\", showing.definition)];\n  }\n  if (kind === \"example\") {\n    return [textElement(\"p\", \"content-text\", showing.example)];\n  }\n  if (kind === \"image\") {\n    const svg = buildSvg(showing.image);\n    return [svg || textElement(\"p\", \"content-text\", showing.image.alt || STRINGS.pictureMissing)];\n  }\n  const nodes = [textElement(\"p\", \"content-word\", showing.card.word)];\n  if (isFilledString(showing.definition)) {\n    nodes.push(textElement(\"p\", \"content-sub\", showing.definition));\n  }\n  return nodes;\n}\n\nfunction textElement(tag, className, text) {\n  const element = document.createElement(tag);\n  element.className = className;\n  element.textContent = text;\n  return element;\n}\n\nfunction buildSvg(image) {\n  if (!image || typeof image.svg !== \"string\" || /<\\s*script/i.test(image.svg)) {\n    return null;\n  }\n  let source = image.svg.trim();\n  if (!/xmlns\\s*=/.test(source)) {\n    source = source.replace(/^<svg/i, `<svg xmlns=\"${SVG_NS}\"`);\n  }\n  const parsed = new DOMParser().parseFromString(source, \"image/svg+xml\");\n  const root = parsed.documentElement;\n  if (!root || root.namespaceURI !== SVG_NS || root.localName !== \"svg\") {\n    return null;\n  }\n  if (parsed.getElementsByTagName(\"parsererror\").length > 0 || root.getElementsByTagName(\"script\").length > 0) {\n    return null;\n  }\n  stripUnsafeSvg(root);\n  const svg = document.importNode(root, true);\n  svg.removeAttribute(\"width\");\n  svg.removeAttribute(\"height\");\n  svg.setAttribute(\"role\", \"img\");\n  svg.setAttribute(\"aria-label\", image.alt);\n  svg.setAttribute(\"focusable\", \"false\");\n  svg.setAttribute(\"class\", \"content-image\");\n  return svg;\n}\n\nfunction stripUnsafeSvg(root) {\n  const blocked = [\"script\", \"foreignObject\", \"iframe\", \"object\", \"embed\", \"image\", \"text\", \"style\"];\n  blocked.forEach((tag) => {\n    Array.prototype.slice.call(root.getElementsByTagName(tag)).forEach((node) => node.remove());\n  });\n  [root].concat(Array.prototype.slice.call(root.getElementsByTagName(\"*\"))).forEach((node) => {\n    Array.prototype.slice.call(node.attributes).forEach((attribute) => {\n      const name = attribute.name.toLowerCase();\n      const value = attribute.value.trim();\n      const isHandler = name.indexOf(\"on\") === 0;\n      const isExternalLink = (name === \"href\" || name === \"xlink:href\") && value.charAt(0) !== \"#\";\n      const isExternalUrl = /url\\(\\s*['\"]?(?!#)/i.test(value);\n      if (isHandler || isExternalLink || isExternalUrl) {\n        node.removeAttribute(attribute.name);\n      }\n    });\n  });\n}\n\nfunction setFaceVisibility() {\n  els.cardFront.setAttribute(\"aria-hidden\", state.flipped ? \"true\" : \"false\");\n  els.cardBack.setAttribute(\"aria-hidden\", state.flipped ? \"false\" : \"true\");\n}\n\nfunction describeFace(kind, showing) {\n  const labelKind = primaryKind(kind);\n  const word = showing.card.word;\n  let content;\n  if (kind === \"word\") {\n    content = word;\n  } else if (kind === \"definition\") {\n    content = showing.definition;\n  } else if (kind === \"example\") {\n    content = showing.example;\n  } else if (kind === \"image\") {\n    content = showing.image.alt;\n  } else {\n    content = isFilledString(showing.definition) ? `${endSentence(word)} ${showing.definition}` : word;\n  }\n  return endSentence(STRINGS.faceAnnouncement(STRINGS.kindNames[labelKind], content));\n}\n\nfunction endSentence(text) {\n  const trimmed = text.trim();\n  return /[.!?”\"]$/.test(trimmed) ? trimmed : `${trimmed}.`;\n}\n\n/* Actions */\n\nfunction flip() {\n  const card = currentCard();\n  if (!state.ready || !card) {\n    return;\n  }\n  state.flipped = !state.flipped;\n  els.card.classList.toggle(\"is-flipped\", state.flipped);\n  setFaceVisibility();\n  const type = CARD_TYPES[effectiveType(state.showing)];\n  const kind = state.flipped ? type.back : type.front;\n  announce(STRINGS.flipAnnouncement(describeFace(kind, state.showing)));\n}\n\nfunction goNext() {\n  if (!state.ready || state.finished) {\n    return;\n  }\n  const next = nextPlayableIndex(state.index + 1, 1);\n  if (next === -1) {\n    showFinish();\n    return;\n  }\n  state.index = next;\n  showCard({ redraw: true, announce: true });\n}\n\nfunction goBack() {\n  if (!state.ready) {\n    return;\n  }\n  if (state.finished) {\n    const last = nextPlayableIndex(state.pass.length - 1, -1);\n    if (last === -1) {\n      return;\n    }\n    state.finished = false;\n    state.index = last;\n    showCard({ redraw: true, announce: true });\n    els.card.focus();\n    return;\n  }\n  const previous = nextPlayableIndex(state.index - 1, -1);\n  if (previous === -1) {\n    announce(STRINGS.firstCardAnnouncement);\n    return;\n  }\n  state.index = previous;\n  showCard({ redraw: true, announce: true });\n}\n\nfunction shuffleCards() {\n  if (!state.ready || !state.config.controls.shuffle) {\n    return;\n  }\n  const wasFinished = state.finished;\n  state.pass = shuffled(state.pass);\n  state.index = Math.max(0, nextPlayableIndex(0, 1));\n  state.finished = false;\n  showCard({ redraw: true });\n  if (wasFinished) {\n    els.card.focus();\n  }\n  announce(STRINGS.shuffledAnnouncement(positionText()));\n}\n\nfunction switchDirection() {\n  if (!state.ready || !state.config.controls.flipDirection || els.btnDirection.hidden) {\n    return;\n  }\n  state.reversed = !state.reversed;\n  if (state.finished) {\n    updateControls();\n    return;\n  }\n  showCard({ redraw: false });\n  const type = CARD_TYPES[effectiveType(state.showing)];\n  announce(STRINGS.cardAnnouncement(positionText(), describeFace(type.front, state.showing), STRINGS.hints[primaryKind(type.back)]));\n}\n\nfunction toggleKnown() {\n  const card = currentCard();\n  if (!state.ready || !card || !state.config.controls.markKnown) {\n    return;\n  }\n  const nowKnown = !state.known.has(card.id);\n  if (nowKnown) {\n    state.known.add(card.id);\n  } else {\n    state.known.delete(card.id);\n  }\n  updateControls();\n  updateCounter();\n  announce(nowKnown ? STRINGS.knownAnnouncement : STRINGS.unknownAnnouncement);\n}\n\nfunction startOver() {\n  if (!state.ready) {\n    return;\n  }\n  beginPass(state.config.startShuffled ? shuffled(state.cards) : state.cards.slice());\n  els.card.focus();\n}\n\nfunction reviewUnknown() {\n  const remaining = playableCards(state.cards).filter((card) => !state.known.has(card.id));\n  if (remaining.length === 0) {\n    return;\n  }\n  beginPass(remaining);\n  els.card.focus();\n}\n\nfunction toggleKind(kind) {\n  if (!state.ready || !pickerActive() || state.pickerKinds.indexOf(kind) === -1) {\n    return;\n  }\n  const label = STRINGS.kindChips[kind];\n  if (state.selectedKinds.has(kind)) {\n    if (state.selectedKinds.size === 1) {\n      announce(STRINGS.keepOneKind);\n      return;\n    }\n    state.selectedKinds.delete(kind);\n  } else {\n    state.selectedKinds.add(kind);\n  }\n  const on = state.selectedKinds.has(kind);\n  applyControls(state.config.controls);\n  updateControls();\n  updateCounter();\n  const count = playableCards(state.cards).length;\n  announce(plural(on ? STRINGS.kindOnAnnouncement : STRINGS.kindOffAnnouncement, count, label));\n}\n\nfunction shuffled(cards) {\n  const result = cards.slice();\n  for (let i = result.length - 1; i > 0; i -= 1) {\n    const j = Math.floor(Math.random() * (i + 1));\n    const temp = result[i];\n    result[i] = result[j];\n    result[j] = temp;\n  }\n  return result;\n}\n\n/* Finish and messages */\n\nfunction showFinish() {\n  state.finished = true;\n  state.flipped = false;\n  const total = playableCards(state.pass).length;\n  const unknownCount = playableCards(state.cards).filter((card) => !state.known.has(card.id)).length;\n  const markKnown = state.config.controls.markKnown;\n\n  els.card.hidden = true;\n  els.message.hidden = false;\n  els.messageText.textContent = plural(STRINGS.finished, total);\n  els.messageDetail.hidden = !(markKnown && unknownCount === 0);\n  els.messageDetail.textContent = STRINGS.allKnown;\n  els.messageActions.hidden = false;\n  els.finishReview.hidden = !(markKnown && unknownCount > 0);\n  setButtonText(els.finishReview, plural(STRINGS.reviewUnknown, unknownCount));\n\n  updateControls();\n  updateCounter();\n  els.message.focus();\n  announce(els.messageText.textContent);\n}\n\nfunction showMessage(text) {\n  els.card.hidden = true;\n  els.message.hidden = false;\n  els.messageText.textContent = text;\n  els.messageDetail.hidden = true;\n  els.messageActions.hidden = true;\n  els.counter.hidden = true;\n}\n\nfunction plural(forms, count, ...extra) {\n  const lang = document.documentElement.lang || undefined;\n  const category = new Intl.PluralRules(lang).select(count);\n  const form = forms[category] || forms.other;\n  const formatted = new Intl.NumberFormat(lang).format(count);\n  return extra.length ? form(extra[0], formatted) : form(formatted);\n}\n\n/* Display state */\n\nfunction updateControls() {\n  const card = currentCard();\n  setAriaDisabled(els.btnBack, !state.finished && nextPlayableIndex(state.index - 1, -1) === -1);\n  setAriaDisabled(els.btnFlip, !card);\n  setAriaDisabled(els.btnNext, !card);\n  setAriaDisabled(els.btnKnown, !card);\n  els.btnKnown.setAttribute(\"aria-pressed\", card && state.known.has(card.id) ? \"true\" : \"false\");\n  setButtonText(els.btnDirection, directionLabel(), STRINGS.keys.direction);\n}\n\nfunction setAriaDisabled(button, disabled) {\n  if (disabled) {\n    button.setAttribute(\"aria-disabled\", \"true\");\n  } else {\n    button.removeAttribute(\"aria-disabled\");\n  }\n}\n\nfunction directionLabel() {\n  let typeName = null;\n  if (currentCard() && state.showing && hasMirror(state.showing.type)) {\n    typeName = state.showing.type;\n  } else {\n    const card = state.pass.filter(canMirror)[0] || state.cards.filter(canMirror)[0];\n    typeName = card ? possibleTypes(card).filter(hasMirror)[0] : null;\n  }\n  if (!typeName) {\n    return STRINGS.startFrom.word;\n  }\n  const shown = state.reversed ? CARD_TYPES[typeName].mirror : typeName;\n  return STRINGS.startFrom[CARD_TYPES[CARD_TYPES[shown].mirror].front];\n}\n\nfunction positionText() {\n  const format = new Intl.NumberFormat(document.documentElement.lang || undefined);\n  const playable = playableCards(state.pass);\n  const before = playableCards(state.pass.slice(0, state.index)).length;\n  const position = Math.max(1, before + (isPlayable(state.pass[state.index]) ? 1 : 0));\n  return STRINGS.counter(format.format(position), format.format(playable.length));\n}\n\nfunction updateCounter() {\n  const parts = [];\n  if (state.config.controls.progressCounter && !state.finished) {\n    parts.push(positionText());\n  }\n  if (state.config.controls.markKnown) {\n    const left = playableCards(state.cards).filter((card) => !state.known.has(card.id)).length;\n    parts.push(plural(STRINGS.leftToLearn, left));\n  }\n  els.counter.replaceChildren(...parts.map((text) => textElement(\"span\", \"counter-part\", text)));\n  els.counter.hidden = parts.length === 0;\n}\n\nfunction announce(text) {\n  els.srStatus.textContent = \"\";\n  window.setTimeout(() => {\n    els.srStatus.textContent = text;\n  }, 50);\n}\n\n/* Keyboard */\n\nfunction handleKeydown(event) {\n  if (!state.ready || event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey) {\n    return;\n  }\n  if (isTextEntry(event.target)) {\n    return;\n  }\n  const onControl = event.target instanceof Element && event.target.closest(\"button, a, select, summary\");\n  const key = event.key;\n  const controls = state.config.controls;\n\n  if (key === \" \" || key === \"Enter\") {\n    if (onControl) {\n      return;\n    }\n    event.preventDefault();\n    flip();\n  } else if (key === \"ArrowRight\") {\n    event.preventDefault();\n    goNext();\n  } else if (key === \"ArrowLeft\") {\n    event.preventDefault();\n    goBack();\n  } else if ((key === \"s\" || key === \"S\") && controls.shuffle) {\n    shuffleCards();\n  } else if ((key === \"f\" || key === \"F\") && controls.flipDirection) {\n    switchDirection();\n  } else if ((key === \"k\" || key === \"K\") && controls.markKnown) {\n    toggleKnown();\n  } else if (key === \"r\" || key === \"R\") {\n    startOver();\n  } else if (key === \"1\" || key === \"2\" || key === \"3\") {\n    toggleKind(PICKER_KINDS[Number(key) - 1]);\n  }\n}\n\nfunction isTextEntry(target) {\n  if (!(target instanceof Element)) {\n    return false;\n  }\n  return target.isContentEditable || target.matches(\"input, textarea, select\");\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "deck.json",
          "contents": "{\n  \"schemaVersion\": 2,\n  \"deckId\": \"lesson-two\",\n  \"title\": \"Lesson Two\",\n  \"lang\": \"en-US\",\n  \"typesInPlay\": [\n    \"word-definition\",\n    \"definition-word\",\n    \"image-word\",\n    \"example-word\",\n    \"word-example\"\n  ],\n  \"cards\": [\n    {\n      \"id\": \"label\",\n      \"type\": \"example-word\",\n      \"word\": \"Label\",\n      \"definitions\": [\n        \"The answer or category you're trying to predict\"\n      ],\n      \"examples\": [\n        \"A teacher gives a computer 100 fruit photos. Each photo has a word under it: apple or banana. That word is the answer the computer learns to guess.\",\n        \"A music app studies 500 short song clips. Each clip has its genre, such as rock or pop, written on it. The computer learns to guess that genre.\",\n        \"A school tech club gives a computer 200 soccer clips. Each clip has been marked goal or no goal by a coach. The computer learns to guess which one.\"\n      ],\n      \"images\": [\n        {\n          \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 120 120\\\"><rect x=\\\"12\\\" y=\\\"58\\\" width=\\\"26\\\" height=\\\"26\\\" rx=\\\"4\\\" fill=\\\"#F46800\\\"/><rect x=\\\"47\\\" y=\\\"58\\\" width=\\\"26\\\" height=\\\"26\\\" rx=\\\"4\\\" fill=\\\"#F46800\\\"/><rect x=\\\"82\\\" y=\\\"58\\\" width=\\\"26\\\" height=\\\"26\\\" rx=\\\"4\\\" fill=\\\"#0099F3\\\"/><circle cx=\\\"25\\\" cy=\\\"71\\\" r=\\\"6\\\" fill=\\\"#FFFFFF\\\"/><circle cx=\\\"60\\\" cy=\\\"71\\\" r=\\\"6\\\" fill=\\\"#FFFFFF\\\"/><rect x=\\\"92\\\" y=\\\"65\\\" width=\\\"12\\\" height=\\\"12\\\" fill=\\\"#FFFFFF\\\"/><rect x=\\\"10\\\" y=\\\"92\\\" width=\\\"30\\\" height=\\\"14\\\" rx=\\\"7\\\" fill=\\\"#4C42CF\\\"/><rect x=\\\"45\\\" y=\\\"92\\\" width=\\\"30\\\" height=\\\"14\\\" rx=\\\"7\\\" fill=\\\"#4C42CF\\\"/><rect x=\\\"80\\\" y=\\\"92\\\" width=\\\"30\\\" height=\\\"14\\\" rx=\\\"7\\\" fill=\\\"#34BD43\\\"/><path d=\\\"M25 90V86M60 90V86M95 90V86\\\" stroke=\\\"#1F1976\\\" stroke-width=\\\"3\\\"/><rect x=\\\"30\\\" y=\\\"10\\\" width=\\\"60\\\" height=\\\"34\\\" rx=\\\"6\\\" fill=\\\"#1F1976\\\"/><rect x=\\\"36\\\" y=\\\"16\\\" width=\\\"48\\\" height=\\\"22\\\" rx=\\\"3\\\" fill=\\\"#ACA8EA\\\"/><circle cx=\\\"60\\\" cy=\\\"27\\\" r=\\\"6\\\" fill=\\\"#34BD43\\\"/><path d=\\\"M50 44L46 52M60 44V52M70 44L74 52\\\" stroke=\\\"#1F1976\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\"/></svg>\",\n          \"alt\": \"A computer screen sorting orange and blue boxes, each with a tag underneath in a matching color.\",\n          \"source\": \"claude\"\n        }\n      ]\n    },\n    {\n      \"id\": \"node\",\n      \"type\": \"example-word\",\n      \"word\": \"Node\",\n      \"definitions\": [\n        \"One of the boxes or questions on a decision tree\",\n        \"A single point that links to others in a decision tree.\"\n      ],\n      \"examples\": [\n        \"Maya is choosing a snack after school. The first question asks, \\\"Are you hungry?\\\" If yes, the next question asks, \\\"Do you want something sweet?\",\n        \"Jorge is deciding whether to bring a jacket to school. The first box asks, \\\"Is it raining?\\\" If the answer is no, the next box asks, \\\"Is it cold outside?\",\n        \"Eli is choosing a game after dinner. The first question asks whether homework is finished. If yes, the next question asks whether a friend is online.\"\n      ]\n    },\n    {\n      \"id\": \"prediction\",\n      \"type\": \"example-word\",\n      \"word\": \"Prediction\",\n      \"definitions\": [\n        \"The best guess about which category something belongs to\"\n      ],\n      \"examples\": [\n        \"An email app looks at emails you marked as spam before. Then it guesses whether a new email is spam or not.\",\n        \"A sports app looks at how your favorite team did in past games. Then it makes a best guess about whether they will win tonight's game.\",\n        \"A music app notices which songs you put in your workout playlist. When you add a new song, it guesses whether the song belongs there or in your study playlist.\"\n      ]\n    },\n    {\n      \"id\": \"data\",\n      \"type\": \"example-word\",\n      \"word\": \"Data\",\n      \"definitions\": [\n        \"Information that has been collected and recorded.\"\n      ],\n      \"examples\": [\n        \"Mia writes down how many minutes she plays her favorite game each day for two weeks. Later, she checks the list to see which day she played most.\",\n        \"Coach Lopez writes down how many free throws each player makes at practice. At the end of the month, she checks the numbers to see who improved most.\",\n        \"Jordan's class fills out a short survey about favorite lunch foods. The teacher puts every answer into a chart so the class can see which food was picked most.\"\n      ]\n    },\n    {\n      \"id\": \"feature\",\n      \"type\": \"example-word\",\n      \"word\": \"Feature\",\n      \"definitions\": [\n        \"A characteristic you can observe about something.\"\n      ],\n      \"examples\": [\n        \"A teacher sorts a box of pencils into groups. She uses what she can see, like color, length, and whether the eraser is pink.\",\n        \"In a video game, Jordan picks a new character. He compares them by height, armor color, and whether they can fly.\",\n        \"Maya wants a new phone case. She checks the color, the size, and whether it has a clip on the back.\"\n      ]\n    },\n    {\n      \"id\": \"classification\",\n      \"type\": \"example-word\",\n      \"word\": \"Classification\",\n      \"definitions\": [\n        \"Sorting something into a category based on its features.\"\n      ],\n      \"examples\": [\n        \"A photo app puts your pictures into groups like beach, food, and pets. It checks each photo and picks the group that fits best.\",\n        \"A school email app checks each new message. It puts the message in the inbox or the spam folder, based on the sender and the words used.\",\n        \"Your soccer coach watches each new player at tryouts. Based on speed and kicking, the coach puts each one in the forward, midfield, or defense group.\"\n      ]\n    },\n    {\n      \"id\": \"branching-logic\",\n      \"type\": \"example-word\",\n      \"word\": \"Branching Logic\",\n      \"definitions\": [\n        \"A way of making decisions using yes or no questions, where each answer sends you in a different direction.\"\n      ],\n      \"examples\": [\n        \"Your phone asks if you have school tomorrow. If yes, the alarm rings at 6:30. If no, it stays quiet until later.\",\n        \"In a video game, a locked door opens only if you have the key. If you have it, you go through. If not, you search the room.\",\n        \"Before soccer practice, you check the sky. If it is raining, you pack a rain jacket. If it is sunny, you bring a water bottle and sunscreen.\"\n      ]\n    }\n  ]\n}",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "style.css",
          "contents": ":root {\n  --bg: #E4E2F8;\n  --card-face: #FFFFFF;\n  --text: #000000;\n  --accent: #4C42CF;\n  --accent-text: #FFFFFF;\n  --frame-word: #0099F3;\n  --frame-definition: #003F25;\n  --frame-example: #F46800;\n  --frame-image: #4C42CF;\n  --label-text-word: #000000;\n  --label-text-definition: #FFFFFF;\n  --label-text-example: #000000;\n  --label-text-image: #FFFFFF;\n  --font: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nhtml {\n  -webkit-text-size-adjust: 100%;\n  text-size-adjust: 100%;\n}\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  background: var(--bg);\n  color: var(--text);\n  font-family: var(--font);\n  line-height: 1.4;\n}\n\n.app {\n  --word-size: clamp(1.75rem, 7cqw, 3rem);\n  --body-size: clamp(1rem, 3.6cqw, 1.375rem);\n  --sub-size: clamp(0.95rem, 3cqw, 1.125rem);\n  --radius: 16px;\n  --content-justify: center;\n  --content-align: center;\n  --text-align: center;\n  width: 100%;\n  max-width: 640px;\n  margin-inline: auto;\n  padding-block: 24px 40px;\n  padding-inline: 16px;\n  font-family: var(--font);\n  color: var(--text);\n  display: flex;\n  flex-direction: column;\n}\n\n.deck-title {\n  order: 1;\n}\n\n.style-picker {\n  order: 2;\n}\n\n.stage {\n  order: 3;\n}\n\n.controls-primary {\n  order: 4;\n}\n\n.controls-secondary {\n  order: 5;\n}\n\n.status {\n  order: 6;\n}\n\n.app[data-word-size=\"medium\"] {\n  --word-size: clamp(1.5rem, 5.5cqw, 2.25rem);\n}\n\n.app[data-word-size=\"xlarge\"] {\n  --word-size: clamp(2rem, 9cqw, 3.75rem);\n}\n\n.app[data-corner-radius=\"none\"] {\n  --radius: 0px;\n}\n\n.app[data-corner-radius=\"round\"] {\n  --radius: 32px;\n}\n\n.app[data-text-align=\"start\"] {\n  --content-align: flex-start;\n  --text-align: start;\n}\n\n.app[data-text-position=\"top\"] {\n  --content-justify: flex-start;\n}\n\n.deck-title {\n  margin-block: 0 20px;\n  font-size: clamp(1.5rem, 5vw, 2rem);\n  line-height: 1.2;\n  text-align: center;\n}\n\n.stage {\n  container-type: inline-size;\n  width: 100%;\n  max-width: 560px;\n  margin-inline: auto;\n}\n\n/* Card */\n\n.card {\n  position: relative;\n  width: 100%;\n  border-radius: var(--radius);\n  perspective: 1400px;\n}\n\n.card:focus {\n  outline: none;\n}\n\n.card:focus-visible {\n  outline: 4px solid var(--text);\n  outline-offset: 4px;\n}\n\n.card-inner {\n  display: grid;\n  aspect-ratio: 3 / 2;\n  transform-style: preserve-3d;\n  transition: transform 0.5s ease;\n}\n\n.card.is-flipped .card-inner {\n  transform: rotateY(180deg);\n}\n\n.card.no-animation .card-inner {\n  transition: none;\n}\n\n.card-face {\n  --frame: var(--frame-word);\n  --label-text: var(--label-text-word);\n  position: relative;\n  grid-area: 1 / 1;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  padding-block: 3rem 1rem;\n  padding-inline: 1.25rem;\n  border: 8px solid var(--frame);\n  border-radius: var(--radius);\n  background: var(--card-face);\n  color: var(--text);\n  -webkit-backface-visibility: hidden;\n  backface-visibility: hidden;\n}\n\n.card-back {\n  transform: rotateY(180deg);\n}\n\n.card-face[data-kind=\"definition\"] {\n  --frame: var(--frame-definition);\n  --label-text: var(--label-text-definition);\n}\n\n.card-face[data-kind=\"example\"] {\n  --frame: var(--frame-example);\n  --label-text: var(--label-text-example);\n}\n\n.card-face[data-kind=\"image\"] {\n  --frame: var(--frame-image);\n  --label-text: var(--label-text-image);\n}\n\n.card-label {\n  position: absolute;\n  inset-block-start: 0;\n  inset-inline-start: 0;\n  padding-block: 0.3rem 0.4rem;\n  padding-inline: 0.9rem;\n  border-end-end-radius: 10px;\n  background: var(--frame);\n  color: var(--label-text);\n  font-size: 0.85rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  line-height: 1.2;\n}\n\n.app[data-corner-radius=\"none\"] .card-label {\n  border-end-end-radius: 0;\n}\n\n.card-content {\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  justify-content: var(--content-justify);\n  align-items: var(--content-align);\n  gap: 0.5rem;\n  min-height: 0;\n  text-align: var(--text-align);\n}\n\n.content-word {\n  margin: 0;\n  max-width: 100%;\n  font-size: var(--word-size);\n  font-weight: 700;\n  line-height: 1.1;\n  overflow-wrap: anywhere;\n}\n\n.content-text {\n  margin: 0;\n  max-width: 36ch;\n  font-size: var(--body-size);\n  line-height: 1.4;\n}\n\n.content-sub {\n  margin: 0;\n  max-width: 40ch;\n  font-size: var(--sub-size);\n  line-height: 1.4;\n}\n\n.content-image {\n  display: block;\n  width: clamp(96px, 30cqw, 168px);\n  height: auto;\n  max-height: 100%;\n}\n\n.card-hint {\n  margin-block: 0.75rem 0;\n  font-size: 0.95rem;\n  font-weight: 600;\n  text-align: center;\n}\n\n/* Loading, error, and finish states */\n\n.message {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 1rem;\n  aspect-ratio: 3 / 2;\n  padding: 1.5rem;\n  border: 3px dashed var(--text);\n  border-radius: var(--radius);\n  background: var(--card-face);\n  color: var(--text);\n  text-align: center;\n}\n\n.message:focus {\n  outline: none;\n}\n\n.message:focus-visible {\n  outline: 4px solid var(--text);\n  outline-offset: 4px;\n}\n\n.message-text {\n  margin: 0;\n  font-size: var(--body-size);\n  font-weight: 700;\n}\n\n.message-detail {\n  margin: 0;\n}\n\n.message-actions {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 12px;\n}\n\n/* Buttons */\n\n.controls {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 12px;\n  margin-block: 20px 0;\n  margin-inline: auto;\n  max-width: 560px;\n}\n\n.controls-secondary {\n  min-width: 0;\n  padding: 0;\n  border: 0;\n}\n\n.btn {\n  display: inline-flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 2px;\n  min-width: 96px;\n  min-height: 52px;\n  padding-block: 6px;\n  padding-inline: 18px;\n  border: 3px solid var(--accent);\n  border-radius: 12px;\n  background: var(--accent);\n  color: var(--accent-text);\n  font: inherit;\n  font-weight: 700;\n  line-height: 1.2;\n  cursor: pointer;\n  touch-action: manipulation;\n}\n\n.btn-flip {\n  min-width: 128px;\n}\n\n.btn-secondary {\n  min-height: 44px;\n  border-color: var(--text);\n  background: var(--card-face);\n  color: var(--text);\n}\n\n.btn-toggle[aria-pressed=\"true\"] {\n  border-color: var(--accent);\n  background: var(--accent);\n  color: var(--accent-text);\n}\n\n.btn:focus {\n  outline: none;\n}\n\n.btn:focus-visible {\n  outline: 3px solid var(--text);\n  outline-offset: 3px;\n}\n\n.btn:disabled,\n.btn[aria-disabled=\"true\"] {\n  cursor: not-allowed;\n  opacity: 0.45;\n}\n\n.btn-label {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.btn-key {\n  font-size: 0.75rem;\n  font-weight: 500;\n}\n\n.check-icon {\n  display: none;\n  width: 1em;\n  height: 1em;\n}\n\n.btn-toggle[aria-pressed=\"true\"] .check-icon {\n  display: block;\n}\n\n/* Style picker */\n\n.style-picker {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 10px;\n  min-width: 0;\n  margin-block: 0 18px;\n  margin-inline: 0;\n  padding: 0;\n  border: 0;\n}\n\n.chip {\n  --chip-frame: var(--frame-definition);\n  display: inline-flex;\n  align-items: center;\n  gap: 10px;\n  min-height: 44px;\n  padding-block: 6px;\n  padding-inline: 12px 14px;\n  border: 2px dashed var(--text);\n  border-inline-start: 10px solid var(--chip-frame);\n  border-radius: 10px;\n  background: transparent;\n  color: var(--text);\n  font: inherit;\n  font-weight: 700;\n  line-height: 1.2;\n  cursor: pointer;\n  touch-action: manipulation;\n}\n\n.chip[data-kind=\"example\"] {\n  --chip-frame: var(--frame-example);\n}\n\n.chip[data-kind=\"image\"] {\n  --chip-frame: var(--frame-image);\n}\n\n.chip[aria-pressed=\"true\"] {\n  border-block-style: solid;\n  border-inline-end-style: solid;\n  background: var(--card-face);\n}\n\n.chip[aria-pressed=\"true\"] .check-icon {\n  display: block;\n}\n\n.chip:focus {\n  outline: none;\n}\n\n.chip:focus-visible {\n  outline: 3px solid var(--text);\n  outline-offset: 3px;\n}\n\n/* Status */\n\n.status {\n  margin-block-start: 16px;\n  text-align: center;\n}\n\n.counter {\n  margin: 0;\n  font-weight: 600;\n}\n\n.counter-part + .counter-part {\n  margin-inline-start: 1.25em;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .card-inner {\n    transition: none;\n  }\n}\n",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "config.json",
          "contents": "{\n  \"schemaVersion\": 1,\n  \"configId\": \"codeai-default\",\n  \"theme\": {\n    \"background\": \"#E4E2F8\",\n    \"cardFace\": \"#FFFFFF\",\n    \"textColor\": \"#000000\",\n    \"accent\": \"#4C42CF\",\n    \"frameColors\": {\n      \"word\": \"#0099F3\",\n      \"definition\": \"#003F25\",\n      \"example\": \"#F46800\",\n      \"image\": \"#4C42CF\"\n    },\n    \"fontFamily\": \"system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif\",\n    \"wordSize\": \"large\",\n    \"textAlign\": \"center\",\n    \"textPosition\": \"center\",\n    \"cornerRadius\": \"medium\"\n  },\n  \"controls\": {\n    \"shuffle\": false,\n    \"flipDirection\": false,\n    \"progressCounter\": true,\n    \"markKnown\": false\n  },\n  \"startFlipped\": false,\n  \"startShuffled\": true,\n  \"randomizeTypes\": false,\n  \"randomizeAlternates\": true,\n  \"studentStylePicker\": false\n}",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ]
    }
  },
  "published": true,
  "audit_log": "[{\"changed_at\":\"2026-10-21T19:44:42.312+00:00\",\"changed\":[\"cloned from \\\"data-makes-ai-lesson1-vocab-flashcards-2\\\"\"],\"cloned_from\":\"data-makes-ai-lesson1-vocab-flashcards-2\"},{\"changed_at\":\"2026-10-21 19:51:22 +0000\",\"changed\":[\"widget_view\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-21 20:14:49 +0000\",\"changed\":[\"start_sources\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-21 20:15:35 +0000\",\"changed\":[\"start_sources\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"}]"
}]]></config>
