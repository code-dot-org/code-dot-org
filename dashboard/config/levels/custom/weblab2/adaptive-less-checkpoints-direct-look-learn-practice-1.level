          "contents": "/* ==================================================================\n   CADS tokens\n   Copied from the CADS runtime (@moshebari/cads-react, manifest 0.1.0).\n   Light theme only. Do not edit this block. Build only with these\n   variables below it.\n   ================================================================== */\n\n:root{--brand-purple-5: #e4e2f8; --brand-purple-10: #cac6f5; --brand-purple-20: #aca8ea; --brand-purple-30: #928cef; --brand-purple-40: #6f67d9; --brand-purple-50: #4c42cf; --brand-purple-60: #4238c4; --brand-purple-70: #3228b7; --brand-purple-80: #2b1e9f; --brand-purple-90: #1d1590; --brand-purple-95: #1f1976; --brand-orange-5: #ffe3ce; --brand-orange-10: #ffd2b3; --brand-orange-20: #ffbd8a; --brand-orange-30: #ffa868; --brand-orange-40: #ff8b38; --brand-orange-50: #f46800; --brand-orange-60: #d15900; --brand-orange-70: #b34800; --brand-orange-80: #942f00; --brand-orange-90: #701c00; --brand-orange-95: #611d00; --brand-pink-5: #fbdae8; --brand-pink-10: #f3c3d8; --brand-pink-20: #eea1c3; --brand-pink-30: #f07fb0; --brand-pink-40: #eb5895; --brand-pink-50: #e11970; --brand-pink-60: #ce035b; --brand-pink-70: #b5004f; --brand-pink-80: #a10448; --brand-pink-90: #8d003d; --brand-pink-95: #7d0c3d; --neutral-base-black: #121212; --neutral-base-true-black: #000000; --neutral-base-white: #ffffff; --neutral-black-alpha-5: #1212120d; --neutral-black-alpha-10: #1212121a; --neutral-black-alpha-20: #12121233; --neutral-black-alpha-30: #1212124d; --neutral-black-alpha-40: #12121266; --neutral-black-alpha-50: #12121280; --neutral-black-alpha-60: #12121299; --neutral-black-alpha-70: #121212b2; --neutral-black-alpha-80: #121212cc; --neutral-black-alpha-90: #121212e5; --neutral-black-alpha-95: #121212f2; --neutral-gray-5: #f1f2f4; --neutral-gray-10: #e1e3e6; --neutral-gray-20: #d3d6da; --neutral-gray-30: #b7bcc2; --neutral-gray-40: #9ea5ad; --neutral-gray-50: #87909a; --neutral-gray-60: #6e7782; --neutral-gray-70: #596069; --neutral-gray-80: #4b5258; --neutral-gray-90: #363b40; --neutral-gray-95: #282b2f; --neutral-white-alpha-5: #ffffff0d; --neutral-white-alpha-10: #ffffff1a; --neutral-white-alpha-20: #ffffff33; --neutral-white-alpha-30: #ffffff4d; --neutral-white-alpha-40: #ffffff66; --neutral-white-alpha-50: #ffffff80; --neutral-white-alpha-60: #ffffff99; --neutral-white-alpha-70: #ffffffb2; --neutral-white-alpha-80: #ffffffcc; --neutral-white-alpha-90: #ffffffe5; --neutral-white-alpha-95: #fffffff2; --sentiment-error-5: #ffdada; --sentiment-error-10: #fac2c2; --sentiment-error-20: #f69898; --sentiment-error-30: #f37272; --sentiment-error-40: #ef4848; --sentiment-error-50: #eb1414; --sentiment-error-60: #d31212; --sentiment-error-70: #b30f0f; --sentiment-error-80: #8d0c0c; --sentiment-error-90: #6c0909; --sentiment-error-95: #620202; --sentiment-information-5: #d5efff; --sentiment-information-10: #b8e5ff; --sentiment-information-20: #94d7ff; --sentiment-information-30: #6fcaff; --sentiment-information-40: #38b3ff; --sentiment-information-50: #0099f3; --sentiment-information-60: #0082e5; --sentiment-information-70: #1570d1; --sentiment-information-80: #0855b2; --sentiment-information-90: #0b43a3; --sentiment-information-95: #06338d; --sentiment-success-5: #d8ffdc; --sentiment-success-10: #c4f1ca; --sentiment-success-20: #9be3a3; --sentiment-success-30: #7cdb87; --sentiment-success-40: #4fcf5d; --sentiment-success-50: #34bd43; --sentiment-success-60: #2da43a; --sentiment-success-70: #258830; --sentiment-success-80: #1f7028; --sentiment-success-90: #17541e; --sentiment-success-95: #003f25; --sentiment-warning-5: #fff5da; --sentiment-warning-10: #ffecb8; --sentiment-warning-20: #ffe08a; --sentiment-warning-30: #ffd35c; --sentiment-warning-40: #fdc835; --sentiment-warning-50: #f5c000; --sentiment-warning-60: #edaf02; --sentiment-warning-70: #cf8e02; --sentiment-warning-80: #b27a01; --sentiment-warning-90: #885d02; --sentiment-warning-95: #654500}\n\n:root,[data-theme=Light]{--background-neutral-primary: var(--neutral-base-white); --background-neutral-secondary: var(--neutral-gray-5); --background-neutral-tertiary: var(--neutral-gray-10); --background-neutral-quaternary: var(--neutral-gray-20); --background-neutral-quinary: var(--neutral-gray-30); --background-neutral-senary: var(--neutral-gray-50); --background-neutral-septenary: var(--neutral-gray-70); --background-neutral-octonary: var(--neutral-gray-80); --background-neutral-primary-inverse: var(--neutral-base-black); --background-neutral-true-base: var(--neutral-base-black); --background-neutral-black-fixed: var(--neutral-base-black); --background-neutral-white-fixed: var(--neutral-base-white); --background-neutral-alpha-5: var(--neutral-black-alpha-5); --background-neutral-alpha-10: var(--neutral-black-alpha-10); --background-neutral-alpha-20: var(--neutral-black-alpha-20); --background-neutral-alpha-30: var(--neutral-black-alpha-30); --background-neutral-alpha-40: var(--neutral-black-alpha-40); --background-neutral-alpha-50: var(--neutral-black-alpha-50); --background-neutral-alpha-60: var(--neutral-black-alpha-60); --background-neutral-alpha-70: var(--neutral-black-alpha-70); --background-neutral-alpha-80: var(--neutral-black-alpha-80); --background-neutral-alpha-90: var(--neutral-black-alpha-90); --background-neutral-alpha-95: var(--neutral-black-alpha-95); --background-brand-primary: var(--brand-purple-50); --background-brand-light: var(--brand-purple-5); --background-brand-mid: var(--brand-purple-20); --background-brand-strong: var(--brand-purple-80); --background-error-primary: var(--sentiment-error-50); --background-error-light: var(--sentiment-error-5); --background-error-mid: var(--sentiment-error-30); --background-error-strong: var(--sentiment-error-70); --background-warning-primary: var(--sentiment-warning-50); --background-warning-light: var(--sentiment-warning-5); --background-warning-mid: var(--sentiment-warning-30); --background-warning-strong: var(--sentiment-warning-70); --background-success-primary: var(--sentiment-success-70); --background-success-light: var(--sentiment-success-5); --background-success-mid: var(--sentiment-success-30); --background-success-strong: var(--sentiment-success-90); --background-info-primary: var(--sentiment-information-70); --background-info-light: var(--sentiment-information-5); --background-info-mid: var(--sentiment-information-30); --background-info-strong: var(--sentiment-information-90); --background-selected-primary: var(--brand-purple-80); --background-selected-strong: var(--brand-purple-95); --background-selected-primary-inverse: var(--sentiment-success-5); --background-disabled-brand: var(--brand-purple-5); --background-disabled-error: var(--sentiment-error-5); --background-disabled-info: var(--sentiment-information-5); --background-disabled-neutral: var(--neutral-gray-20); --background-disabled-orange: var(--brand-orange-5); --background-disabled-pink: var(--brand-pink-5); --background-disabled-success: var(--sentiment-success-5); --background-disabled-warning: var(--sentiment-warning-5); --background-accent-orange-primary: var(--brand-orange-50); --background-accent-orange-light: var(--brand-orange-5); --background-accent-orange-mid: var(--brand-orange-30); --background-accent-orange-strong: var(--brand-orange-70); --background-accent-pink-primary: var(--brand-pink-50); --background-accent-pink-light: var(--brand-pink-5); --background-accent-pink-mid: var(--brand-pink-30); --background-accent-pink-strong: var(--brand-pink-70); --border-neutral-primary: var(--neutral-gray-20); --border-neutral-secondary: var(--neutral-gray-40); --border-neutral-solid: var(--neutral-base-black); --border-neutral-black-fixed: var(--neutral-base-black); --border-neutral-white-fixed: var(--neutral-base-white); --border-brand-primary: var(--brand-purple-50); --border-brand-light: var(--brand-purple-10); --border-brand-mid: var(--brand-purple-30); --border-brand-strong: var(--brand-purple-70); --border-error-primary: var(--sentiment-error-50); --border-error-light: var(--sentiment-error-10); --border-error-mid: var(--sentiment-error-20); --border-error-strong: var(--sentiment-error-70); --border-warning-primary: var(--sentiment-warning-50); --border-warning-light: var(--sentiment-warning-10); --border-warning-mid: var(--sentiment-warning-30); --border-warning-strong: var(--sentiment-warning-70); --border-success-primary: var(--sentiment-success-50); --border-success-light: var(--sentiment-success-10); --border-success-mid: var(--sentiment-success-30); --border-success-strong: var(--sentiment-success-70); --border-info-primary: var(--sentiment-information-50); --border-info-light: var(--sentiment-information-10); --border-info-mid: var(--sentiment-information-30); --border-info-strong: var(--sentiment-information-70); --border-focused-primary: var(--brand-purple-50); --border-selected-primary: var(--brand-purple-80); --border-selected-strong: var(--brand-purple-95); --border-selected-primary-inverse: var(--sentiment-success-5); --border-disabled-brand: var(--brand-purple-5); --border-disabled-error: var(--sentiment-error-5); --border-disabled-info: var(--sentiment-information-5); --border-disabled-neutral: var(--neutral-gray-20); --border-disabled-orange: var(--brand-orange-5); --border-disabled-pink: var(--brand-pink-5); --border-disabled-success: var(--sentiment-success-5); --border-disabled-warning: var(--sentiment-warning-5); --border-focused-inverse: var(--sentiment-success-5); --border-accent-orange-primary: var(--brand-orange-50); --border-accent-orange-light: var(--brand-orange-10); --border-accent-orange-mid: var(--brand-orange-30); --border-accent-orange-strong: var(--brand-orange-70); --border-accent-pink-primary: var(--brand-pink-50); --border-accent-pink-light: var(--brand-pink-10); --border-accent-pink-mid: var(--brand-pink-30); --border-accent-pink-strong: var(--brand-pink-70); --text-neutral-primary: var(--neutral-base-black); --text-neutral-secondary: var(--neutral-gray-90); --text-neutral-tertiary: var(--neutral-gray-80); --text-neutral-quaternary: var(--neutral-gray-70); --text-neutral-primary-inverse: var(--neutral-base-white); --text-neutral-placeholder: var(--neutral-gray-40); --text-neutral-black-fixed: var(--neutral-base-black); --text-neutral-white-fixed: var(--neutral-base-white); --text-brand-primary: var(--brand-purple-50); --text-brand-secondary: var(--brand-purple-90); --text-brand-primary-fixed: var(--brand-purple-50); --text-error-primary: var(--sentiment-error-50); --text-error-secondary: var(--sentiment-error-70); --text-error-primary-fixed: var(--sentiment-error-50); --text-warning-primary: var(--sentiment-warning-50); --text-warning-secondary: var(--sentiment-warning-90); --text-warning-primary-fixed: var(--sentiment-warning-50); --text-success-primary: var(--sentiment-success-70); --text-success-secondary: var(--sentiment-success-90); --text-success-primary-fixed: var(--sentiment-success-70); --text-info-primary: var(--sentiment-information-70); --text-info-secondary: var(--sentiment-information-90); --text-info-primary-fixed: var(--sentiment-information-70); --text-selected-primary: var(--sentiment-success-5); --text-selected-primary-inverse: var(--brand-purple-95); --text-disabled-brand: var(--brand-purple-5); --text-disabled-error: var(--sentiment-error-5); --text-disabled-info: var(--sentiment-information-5); --text-disabled-neutral: var(--neutral-gray-20); --text-disabled-neutral-inverse: var(--neutral-base-white); --text-disabled-orange: var(--brand-orange-5); --text-disabled-pink: var(--brand-pink-5); --text-disabled-success: var(--sentiment-success-5); --text-disabled-warning: var(--sentiment-warning-5); --text-accent-orange-primary: var(--brand-orange-50); --text-accent-orange-secondary: var(--brand-orange-70); --text-accent-orange-primary-fixed: var(--brand-orange-50); --text-accent-pink-primary: var(--brand-pink-50); --text-accent-pink-secondary: var(--brand-pink-70); --text-accent-pink-primary-fixed: var(--brand-pink-50)}\n\n:root{--font-family-main: \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif; --font-family-heading: \"Space Grotesk\", \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif; --font-family-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace; --font-weight-thin: 100; --font-weight-extra-light: 200; --font-weight-light: 300; --font-weight-regular: 400; --font-weight-medium: 500; --font-weight-semi-bold: 600; --font-weight-bold: 700; --font-weight-extra-bold: 800; --font-weight-black: 900; --font-size-body-xs: .75rem; --font-size-body-sm: .875rem; --font-size-body-md: 1rem; --font-size-body-lg: 1.125rem; }\n\n:root{--text-heading-xxl: 3rem; --text-heading-xl: 2.375rem; --text-heading-lg: 1.75rem; --text-heading-md: 1.5rem; --text-heading-sm: 1.375rem; --text-heading-xs: 1.25rem; --leading-heading-xxl: 3.25rem; --leading-heading-xl: 2.5rem; --leading-heading-lg: 2.25rem; --leading-heading-md: 2rem; --leading-heading-sm: 1.875rem; --leading-heading-xs: 1.75rem; --text-body-lg: 1.125rem; --text-body-md: 1rem; --text-body-sm: .875rem; --text-body-xs: .75rem; --text-body-xxs: .625rem; --leading-body-lg: 1.75rem; --leading-body-md: 1.5rem; --leading-body-sm: 1.375rem; --leading-body-xs: 1.125rem; --leading-body-xxs: 1rem; --tracking-heading-display: -.01em; --tracking-overline: .08em; --tracking-none: 0}\n\n:root{--shape-sm: .375rem; --shape-md: .5rem; --shape-lg: .625rem; --shape-xl: .75rem; --shape-round: 62.4375rem; --spacing-p-xxs: .5rem; --spacing-p-xs: 1rem; --spacing-p-s: 1.5rem; --spacing-p-m: 2rem; --spacing-p-l: 2.5rem; --spacing-p-xl: 3rem; --spacing-p-xxl: 3.5rem; --spacing-p-xxxl: 4rem; --shadow-sm: 0 4px 7px rgb(0 0 0 / 7%), 0 2px 2px rgb(0 0 0 / 7%); --shadow-md: 0 10px 15px -3px rgb(0 0 0 / 10%), 0 4px 6px -4px rgb(0 0 0 / 10%); --shadow-lg: 0 20px 25px -5px rgb(0 0 0 / 10%), 0 8px 10px -6px rgb(0 0 0 / 10%)}\n\n:root{--duration-instant: 0ms; --duration-fast: .1s; --duration-short: .15s; --duration-medium: .2s; --easing-standard: cubic-bezier(.4, 0, .2, 1); --easing-emphasized: cubic-bezier(.2, 0, 0, 1); --easing-out: cubic-bezier(.23, 1, .32, 1); --motion-press-scale: .97; --motion-press-duration: .15s; --motion-press-easing: cubic-bezier(.23, 1, .32, 1); --motion-surface-from-scale: .96; --motion-surface-duration: .2s; --motion-surface-easing: cubic-bezier(.23, 1, .32, 1); --motion-indicator-duration: .2s; --motion-indicator-easing: cubic-bezier(.2, 0, 0, 1); --motion-fade-duration: .1s; --motion-fade-easing: cubic-bezier(.23, 1, .32, 1); --motion-highlight-chase-duration: .1s; --motion-highlight-chase-easing: cubic-bezier(.23, 1, .32, 1); --transition-colors: background-color var(--duration-short) var(--easing-standard), color var(--duration-short) var(--easing-standard), border-color var(--duration-short) var(--easing-standard), box-shadow var(--duration-short) var(--easing-standard), opacity var(--duration-short) var(--easing-standard); --transition-fade: background-color var(--motion-fade-duration) var(--motion-fade-easing), color var(--motion-fade-duration) var(--motion-fade-easing), border-color var(--motion-fade-duration) var(--motion-fade-easing), opacity var(--motion-fade-duration) var(--motion-fade-easing); --transition-press: transform var(--motion-press-duration) var(--motion-press-easing); --transition-surface: opacity var(--motion-surface-duration) var(--motion-surface-easing), transform var(--motion-surface-duration) var(--motion-surface-easing); --transition-indicator: left var(--motion-indicator-duration) var(--motion-indicator-easing), width var(--motion-indicator-duration) var(--motion-indicator-easing), transform var(--motion-indicator-duration) var(--motion-indicator-easing), background-color var(--duration-short) var(--easing-standard); --transition-highlight-chase: top var(--motion-highlight-chase-duration) var(--motion-highlight-chase-easing), height var(--motion-highlight-chase-duration) var(--motion-highlight-chase-easing), opacity var(--motion-highlight-chase-duration) var(--motion-highlight-chase-easing)}\n\n:root{--ring: var(--border-focused-primary); --control-height-large: 48px; --control-height-medium: 40px; --control-height-small: 32px; --control-height-extra-small: 24px; --control-height-l: 48px; --control-height-m: 40px; --control-height-s: 32px; --control-height-xs: 24px; --z-drawer: 1200; --z-modal: 1300; --z-dropdown: 1300; --z-popover: 1300; --z-toast: 1400; --z-tooltip: 1500; --font-fa-free: \"Font Awesome 7 Free\"; --font-fa-pro: \"Font Awesome 7 Pro\"; --font-fa-brands: \"Font Awesome 7 Brands\"; --syntax-attribute: #B34800; --syntax-comment: #69788A; --syntax-keyword: #4C42CF; --syntax-number: #0B43A3; --syntax-property: #B5004F; --syntax-punctuation: #596069; --syntax-selector: #1A7F85; --syntax-string: #1F7028; --syntax-tag: #3228B7; --syntax-value: #1570D1}\n\n/* Code colors (the light values CADS ships for syntax) */\n:root {\n  --syntax-attribute: #B34800;\n  --syntax-comment: #69788A;\n  --syntax-keyword: #4C42CF;\n  --syntax-number: #0B43A3;\n  --syntax-property: #B5004F;\n  --syntax-punctuation: #596069;\n  --syntax-selector: #1A7F85;\n  --syntax-string: #1F7028;\n  --syntax-tag: #3228B7;\n  --syntax-value: #1570D1;\n}\n\n/* ===== end CADS tokens ===== */\n/* ==================================================================\n   Prompt dial component styles\n\n   What is CADS\n   - Every color, type size, radius, spacing step, shadow and motion value\n     below comes from the CADS tokens above. No hard-coded colors.\n   - Selected look for the pressed choice buttons (selected-primary fill,\n     border and text, always as a set).\n   - Focus ring: 2px --ring, never removed.\n   - Overline labels, the Tag look for \"Practice\", the Alert look for the\n     error message and the status line, and the white card with a 1px\n     hairline and --shape-md radius.\n   - Control heights from --control-height-* (40px choice buttons).\n\n   What was rebuilt from the manifest\n   - Choice buttons are rebuilt as plain buttons that follow the Chip rules\n     (pill shape, thick label, selected tokens). The real CADS runtime is\n     not loaded, because Web Lab allows no scripts or fonts from outside.\n   - The primary and outlined Button looks for Try it and Next.\n   - The two options in each row act like a small SegmentedButton, but a\n     tap on the selected option clears it, so it is built as two buttons\n     with aria-pressed.\n\n   What was approximated\n   - Geist and Space Grotesk are named by the tokens but are not loaded.\n     The tokens' own fallback fonts show instead.\n   - Icons are small inline SVGs drawn to match the Font Awesome weight.\n     Font Awesome is not loaded.\n   - The sample page (bake sale) is\n     an illustration built only from CADS palette tokens. It is not a CADS\n     component.\n   ================================================================== */\n\n*,\n*::before,\n*::after { box-sizing: border-box; }\n\n[hidden] { display: none !important; }\n\nhtml { font-size: 100%; }\n\nbody {\n  margin: 0;\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-md);\n  line-height: var(--leading-body-md);\n  color: var(--text-neutral-primary);\n  background: var(--background-neutral-primary);\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.nowrap { white-space: nowrap; }\n\n.icon {\n  flex: none;\n  width: 1.125rem;\n  height: 1.125rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* Detail colors. Each detail keeps one color from prompt to page to note. */\n\n.is-d1,\n[data-flash=\"1\"] { --detail-line: var(--border-brand-primary); --detail-bg: var(--background-brand-light); }\n\n.is-d2,\n[data-flash=\"2\"] { --detail-line: var(--border-accent-orange-strong); --detail-bg: var(--background-accent-orange-light); }\n\n.is-d3,\n[data-flash=\"3\"] { --detail-line: var(--border-accent-pink-primary); --detail-bg: var(--background-accent-pink-light); }\n\n.is-d4,\n[data-flash=\"4\"] { --detail-line: var(--border-info-strong); --detail-bg: var(--background-info-light); }\n\n/* ---------- Intro page ---------- */\n\n.intro-screen,\n.takeaway-page {\n  display: grid;\n  justify-items: start;\n  align-content: start;\n  gap: var(--spacing-p-xs);\n  max-width: 32rem;\n  padding: var(--spacing-p-xs) var(--spacing-p-xxs);\n}\n\n.intro-title {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-md);\n  font-weight: var(--font-weight-bold);\n  line-height: var(--leading-heading-md);\n}\n\n.intro-lead { margin: 0; }\n\n.intro-steps {\n  margin: 0;\n  padding-inline-start: 1.5rem;\n  display: grid;\n  gap: .375rem;\n}\n\n.intro-steps li::marker { font-weight: var(--font-weight-bold); }\n\n.takeaway-labels {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-p-xxs) var(--spacing-p-xs);\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.takeaway-label {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.takeaway-label .icon { color: var(--detail-line); }\n\n.takeaway-last { margin: 0; }\n\n.takeaway-page:focus-visible {\n  outline: 2px solid var(--ring);\n  outline-offset: 2px;\n}\n\n.finish-row { display: flex; }\n\n/* ---------- Layout ---------- */\n\n.widget {\n  max-width: 60rem;\n  margin: 0 auto;\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs) var(--spacing-p-xs);\n}\n\n.error-banner {\n  margin-block-end: var(--spacing-p-xxs);\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border: 1px solid var(--border-error-mid);\n  border-radius: var(--shape-md);\n  background: var(--background-error-light);\n  color: var(--text-error-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.intro {\n  display: grid;\n  gap: .25rem;\n  margin-block-end: var(--spacing-p-xxs);\n}\n\n.author-row {\n  display: flex;\n  align-items: center;\n  gap: .5rem;\n}\n\n.author-row label {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.author-row select {\n  min-height: var(--control-height-small);\n  max-width: 100%;\n  padding: 0 .5rem;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font: inherit;\n}\n\n.intro-line {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: .5rem;\n}\n\n.tag {\n  display: inline-block;\n  padding: 0 .5rem;\n  border-radius: var(--shape-sm);\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: var(--leading-body-md);\n}\n\n.do-this { margin: 0; color: var(--text-neutral-secondary); }\n\n.do-this strong { color: var(--text-neutral-primary); }\n\n.text-button {\n  min-height: var(--control-height-small);\n  padding: 0 .5rem;\n  border: 0;\n  border-radius: var(--shape-sm);\n  background: transparent;\n  color: var(--text-brand-primary);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  text-decoration: underline;\n  cursor: pointer;\n}\n\n.workspace {\n  display: grid;\n  grid-template-columns: minmax(0, 5fr) 2rem minmax(0, 6fr);\n  align-items: start;\n}\n\n.col {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  min-width: 0;\n}\n\n.gutter {\n  display: flex;\n  justify-content: center;\n  padding-block-start: 3rem;\n}\n\n/* ---------- Prompt card ---------- */\n\n.card {\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n}\n\n.prompt-card { padding: .5rem .75rem .625rem; }\n\n.overline {\n  font-size: var(--text-body-md);\n  font-weight: var(--font-weight-semi-bold);\n  letter-spacing: var(--tracking-overline);\n  text-transform: uppercase;\n  color: var(--text-neutral-quaternary);\n}\n\n.prompt-box {\n  display: grid;\n  margin-block-start: .125rem;\n}\n\n.prompt-text,\n.prompt-ghost {\n  grid-area: 1 / 1;\n  margin: 0;\n}\n\n.prompt-ghost { visibility: hidden; }\n\n.phrase {\n  padding: 0 .25rem;\n  border-bottom: 2px solid var(--detail-line);\n  border-radius: var(--shape-sm);\n  background: var(--detail-bg);\n  font-weight: var(--font-weight-semi-bold);\n  -webkit-box-decoration-break: clone;\n  box-decoration-break: clone;\n}\n\n.phrase .icon { color: var(--detail-line); margin-inline-end: .25rem; vertical-align: -.2em; }\n\n.sent.is-new { animation: fade-in var(--motion-surface-duration) var(--motion-surface-easing) both; }\n\n.sent.keep {\n  display: inline-block;\n  padding: 0 .25rem;\n  border-inline-start: 3px solid var(--detail-line);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n/* ---------- Choice rows ---------- */\n\n.switches {\n  display: grid;\n  gap: .375rem;\n}\n\n.row {\n  min-width: 0;\n  margin: 0;\n  padding: 0;\n  border: 0;\n}\n\n.row legend {\n  display: flex;\n  align-items: center;\n  gap: .375rem;\n  padding: 0;\n  margin-block-end: .125rem;\n  font-weight: var(--font-weight-semi-bold);\n  line-height: 1.25rem;\n}\n\n.row legend .icon { color: var(--detail-line); }\n\n.opts {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: .5rem;\n}\n\n.opt {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: .25rem;\n  min-height: var(--control-height-medium);\n  padding: .125rem .75rem;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  line-height: 1.25rem;\n  text-align: center;\n  cursor: pointer;\n  transition: var(--transition-colors), var(--transition-press);\n}\n\n.opt:hover { background: var(--background-neutral-secondary); }\n\n.opt:active { transform: scale(var(--motion-press-scale)); }\n\n.opt .check { display: none; }\n\n.opt[aria-pressed=\"true\"] {\n  background: var(--background-selected-primary);\n  border-color: var(--border-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n.opt[aria-pressed=\"true\"] .check { display: inline-block; }\n\n.opt:focus-visible,\n.text-button:focus-visible,\n.btn:focus-visible,\n.author-row select:focus-visible {\n  outline: 2px solid var(--ring);\n  outline-offset: 2px;\n}\n\n/* ---------- Buttons (demo) ---------- */\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: var(--control-height-medium);\n  padding: 0 var(--spacing-p-xs);\n  border: 1px solid transparent;\n  border-radius: var(--shape-md);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n  transition: var(--transition-colors), var(--transition-press);\n}\n\n.btn:active { transform: scale(var(--motion-press-scale)); }\n\n.btn-primary {\n  background: var(--background-brand-primary);\n  color: var(--text-neutral-white-fixed);\n}\n\n.btn-primary:hover { background: var(--background-brand-strong); }\n\n.btn-outline {\n  background: var(--background-neutral-primary);\n  border-color: var(--border-neutral-solid);\n  color: var(--text-neutral-primary);\n}\n\n.btn-outline:hover { background: var(--background-neutral-secondary); }\n\n/* ---------- Demo panel ---------- */\n\n.demo-panel {\n  display: grid;\n  gap: .375rem;\n  padding: .75rem;\n  border-radius: var(--shape-md);\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n}\n\n.demo-step {\n  margin: 0;\n  font-weight: var(--font-weight-semi-bold);\n  letter-spacing: var(--tracking-overline);\n  text-transform: uppercase;\n}\n\n.demo-title {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-xs);\n  line-height: var(--leading-heading-xs);\n  color: var(--text-neutral-primary);\n}\n\n.demo-text {\n  margin: 0;\n  min-height: 2.75rem;\n  color: var(--text-neutral-primary);\n  font-size: var(--text-body-lg);\n  line-height: var(--leading-body-md);\n}\n\n.demo-actions {\n  display: flex;\n  align-items: center;\n  gap: .5rem;\n}\n\n.spark {\n  width: 1.5rem;\n  height: 1.5rem;\n  fill: var(--background-brand-primary);\n  transform-origin: center;\n}\n\n.spark.is-pulsing { animation: spark-pulse .8s var(--easing-out); }\n\n/* ---------- Sample page ---------- */\n\n.page-area {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  min-width: 0;\n}\n\n.site {\n  --site-bg: var(--background-neutral-primary);\n  --site-ink: var(--text-neutral-tertiary);\n  --site-line: var(--border-neutral-primary);\n  --site-a: var(--neutral-gray-10);\n  --site-b: var(--neutral-gray-20);\n  --site-c: var(--neutral-gray-10);\n  --site-label: var(--text-neutral-tertiary);\n  --site-btn-bg: var(--neutral-gray-20);\n  --site-btn-ink: var(--text-neutral-primary);\n  --site-btn-line: transparent;\n  --title-family: var(--font-family-heading);\n  --title-size: 1.25rem;\n  --title-weight: var(--font-weight-semi-bold);\n  overflow: hidden;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-md);\n  background: var(--site-bg);\n  color: var(--site-ink);\n  transition: background-color var(--duration-medium) var(--easing-standard);\n}\n\n/* Looks chosen by \"the feel\", \"colors\" or \"tone\" */\n\n.site[data-colors=\"1\"] {\n  --site-bg: var(--sentiment-warning-5);\n  --site-ink: var(--sentiment-warning-95);\n  --site-line: var(--sentiment-warning-30);\n  --site-a: var(--sentiment-warning-30);\n  --site-b: var(--sentiment-warning-20);\n}\n\n.site[data-colors=\"2\"] {\n  --site-bg: var(--sentiment-information-5);\n  --site-ink: var(--sentiment-information-95);\n  --site-line: var(--sentiment-information-30);\n  --site-a: var(--sentiment-information-20);\n  --site-b: var(--sentiment-information-30);\n}\n\n.site[data-type=\"1\"] { --title-size: 1.875rem; --title-weight: var(--font-weight-extra-bold); }\n\n.site[data-type=\"2\"] { --title-family: var(--font-family-main); --title-size: 1.125rem; --title-weight: var(--font-weight-medium); }\n\n.site-bar {\n  display: flex;\n  align-items: center;\n  gap: .25rem;\n  height: 1.75rem;\n  padding: 0 .5rem;\n  border-bottom: 1px solid var(--border-neutral-primary);\n  background: var(--background-neutral-secondary);\n}\n\n.site-dot {\n  width: .5rem;\n  height: .5rem;\n  border-radius: var(--shape-round);\n  background: var(--neutral-gray-30);\n}\n\n.site-url {\n  margin-inline-start: .5rem;\n  padding: 0 .75rem;\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-quaternary);\n  font-size: var(--text-body-sm);\n  line-height: 1.25rem;\n}\n\n.site-main {\n  display: grid;\n  gap: .625rem;\n  align-content: start;\n  min-height: 15rem;\n  padding: var(--spacing-p-xs);\n}\n\n.slot,\n.bar {\n  margin: 0;\n  width: fit-content;\n  max-width: 100%;\n  transition: color var(--duration-medium) var(--easing-standard), background-color var(--duration-medium) var(--easing-standard);\n  transition-delay: calc(var(--i, 0) * 60ms);\n}\n\n.slot.is-bar,\n.bar {\n  border-radius: var(--shape-sm);\n  background: var(--neutral-gray-10);\n  color: transparent;\n  user-select: none;\n}\n\n.site-title {\n  font-family: var(--title-family);\n  font-size: var(--title-size);\n  font-weight: var(--title-weight);\n  line-height: 1.2;\n}\n\n.site-title:not(.is-bar) { color: var(--site-ink); }\n\n.site-tag { font-size: var(--text-body-md); }\n\n.hero { display: grid; gap: .25rem; justify-items: start; border-radius: var(--shape-md); }\n\n/* Bake sale */\n\n.items { display: grid; gap: .375rem; justify-items: start; border-radius: var(--shape-md); min-height: 7rem; align-content: start; }\n\n.site[data-layout=\"1\"] .hero {\n  padding: var(--spacing-p-xs);\n  background: var(--site-a);\n}\n\n.cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .5rem; width: 100%; }\n\n.treat {\n  display: grid;\n  gap: .375rem;\n  padding: .5rem;\n  border: 1px solid var(--site-line);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n  color: var(--site-ink);\n}\n\n.swatch { display: block; border-radius: var(--shape-sm); background: var(--site-b); }\n\n.treat .swatch { aspect-ratio: 3 / 2; }\n\n.treat-name { font-weight: var(--font-weight-semi-bold); }\n\n.treat-list { display: grid; width: 100%; }\n\n.treat-row {\n  display: flex;\n  align-items: center;\n  gap: .5rem;\n  padding-block: .375rem;\n  border-bottom: 1px solid var(--site-line);\n  color: var(--site-ink);\n}\n\n.treat-row .swatch { width: 1.5rem; height: 1.5rem; }\n\n/* ---------- Note under the page ---------- */\n\n.note {\n  display: grid;\n  gap: .125rem;\n  min-height: 3.5rem;\n}\n\n.note-main {\n  display: flex;\n  align-items: flex-start;\n  gap: .5rem;\n  margin: 0;\n}\n\n.note-main .icon { margin-block-start: .1875rem; color: var(--detail-line); }\n\n.note-status {\n  margin: 0;\n  padding: .125rem .5rem;\n  border-radius: var(--shape-sm);\n  background: var(--background-success-light);\n  color: var(--text-success-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n/* ---------- Flash on the part of the page a detail reached ---------- */\n\n.flash {\n  outline: 3px solid var(--detail-line);\n  outline-offset: -3px;\n  animation: flash-fade 1s ease-out forwards;\n}\n\n/* ---------- Motion ---------- */\n\n@keyframes fade-in {\n  from { opacity: 0; transform: translateY(.25rem); }\n  to { opacity: 1; transform: none; }\n}\n\n@keyframes flash-fade {\n  from { outline-color: var(--detail-line); }\n  to { outline-color: transparent; }\n}\n\n@keyframes line-in {\n  from { background: var(--detail-bg); }\n  to { background: transparent; }\n}\n\n@keyframes spark-pulse {\n  0% { transform: scale(1); opacity: .6; }\n  40% { transform: scale(1.6); opacity: 1; }\n  100% { transform: scale(1); opacity: .9; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n}\n\n/* ---------- Narrow screens ---------- */\n\n@media (max-width: 47.99rem) {\n  .workspace { grid-template-columns: minmax(0, 1fr); }\n\n  .gutter { padding-block: 0; height: 2rem; align-items: center; }\n\n  .site-main { min-height: 0; }\n}\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Prompt dial: bake sale</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"widget\" id=\"widget\">\n    <div class=\"error-banner\" id=\"error\" role=\"alert\" hidden></div>\n    <h1 class=\"visually-hidden\" data-text=\"intro.title\"></h1>\n\n    <header class=\"intro\" id=\"header\">\n      <div class=\"intro-line\" id=\"practiceLine\">\n        <span class=\"tag\" data-text=\"intro.tag\"></span>\n      </div>\n      <p class=\"do-this\" id=\"doThis\"><strong data-text=\"intro.doThis\"></strong> <span data-text=\"intro.doThisText\"></span></p>\n    </header>\n\n    <section class=\"intro-screen\" id=\"introScreen\" hidden>\n      <span class=\"tag\" data-text=\"intro.tag\"></span>\n      <h2 class=\"intro-title\" data-text=\"intro.heading\"></h2>\n      <p class=\"intro-lead\" data-text=\"intro.lead\"></p>\n      <ol class=\"intro-steps\">\n        <li data-text=\"intro.steps.0\"></li>\n        <li data-text=\"intro.steps.1\"></li>\n        <li data-text=\"intro.steps.2\"></li>\n      </ol>\n      <button type=\"button\" class=\"btn btn-primary\" id=\"startButton\" data-text=\"intro.start\"></button>\n    </section>\n\n    <div class=\"workspace\" id=\"workspace\" data-mode=\"demo\">\n      <section class=\"col\">\n        <div class=\"card prompt-card\">\n          <span class=\"overline\" data-text=\"prompt.label\"></span>\n          <div class=\"prompt-box\">\n            <p class=\"prompt-text\" id=\"promptText\"></p>\n            <p class=\"prompt-ghost\" id=\"promptGhost\" aria-hidden=\"true\"></p>\n          </div>\n        </div>\n\n        <div class=\"switches\" id=\"switches\" hidden></div>\n\n        <div class=\"demo-panel\" id=\"demoPanel\">\n          <p class=\"demo-step\" id=\"demoStep\"></p>\n          <h2 class=\"demo-title\" id=\"demoTitle\" hidden></h2>\n          <p class=\"demo-text\" id=\"demoText\"></p>\n          <div class=\"demo-actions\">\n            <button type=\"button\" class=\"btn btn-outline\" id=\"demoNext\" data-text=\"demo.next\"></button>\n          </div>\n        </div>\n      </section>\n\n      <div class=\"gutter\" id=\"sparkHolder\"></div>\n\n      <section class=\"col\">\n        <div class=\"page-area\" id=\"pageArea\"></div>\n        <div class=\"note\" id=\"note\"></div>\n        <div class=\"finish-row\"><button type=\"button\" class=\"btn btn-primary\" id=\"finishButton\" data-text=\"finish.label\" hidden></button></div>\n      </section>\n    </div>\n\n\n    <div class=\"visually-hidden\" id=\"announcer\" aria-live=\"polite\" aria-atomic=\"true\"></div>\n\n    <section class=\"takeaway-page\" id=\"takeaway\" aria-labelledby=\"takeaway-title\" tabindex=\"-1\" hidden>\n      <h2 class=\"intro-title\" id=\"takeaway-title\" data-text=\"takeaway.title\"></h2>\n      <p class=\"intro-lead\" data-text=\"takeaway.text\"></p>\n      <ul class=\"takeaway-labels\" id=\"takeawayLabels\"></ul>\n      <p class=\"takeaway-last\"><strong data-text=\"takeaway.last\"></strong></p>\n    </section>\n  </main>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "'use strict';\n\n/* ------------------------------------------------------------------\n   Prompt dial\n   One engine, four swappable directions. Each direction supplies its\n   details, its sample page and its words (see DIRECTIONS below).\n   ------------------------------------------------------------------ */\n\nconst CONFIG = {\n  // The sample page this widget shows.\n  direction: 'style',\n  // One-line intro page with a Start button. Address override: ?intro=0\n  showIntro: true,\n  // Short opening demo. Address override: ?demo=0\n  showDemo: true,\n  flashMilliseconds: 1000,\n  completeEventName: 'widget:complete',\n  completeMessageType: 'widget-complete'\n};\n\n/* ---------- Words that are not part of a direction ---------- */\n\nconst T = {\n  intro: {\n    tag: 'Practice',\n    doThis: 'Do This:',\n    doThisText: 'Build a sample prompt step by step. Notice how each additional detail in the prompt improves the output.',\n    title: 'Prompt dial',\n    heading: 'Add details to a prompt',\n    lead: 'You will do this whenever you ask AI to build part of your project.',\n    steps: ['Watch a short demo, step by step.', 'Pick a choice in each row.', 'Change one thing and keep the rest.'],\n    start: 'Start',\n  },\n  prompt: {\n    label: 'Prompt',\n    base: 'Make a site.'\n  },\n  demo: {\n    vague: 'A prompt is your order to the AI. A vague order gets a plain page.',\n    first: (label) => `A specific order gets the page you pictured. Start with ${label}.`,\n    later: (label) => `Next, add ${label}.`,\n    endTitle: 'Every detail helped.',\n    endText: 'Each detail gave the AI more to work with, so the page came out closer to what you pictured.',\n    next: 'Next',\n    start: 'Try it',\n    stepOf: (n, total) => `Step ${n} of ${total}`,\n    ready: 'Your turn. Pick a choice in each row.'\n  },\n  status: {\n    keptRest: 'Changed one thing. The rest stayed the same.',\n    allIn: 'All four details are in. Try changing just one.'\n  },\n  announce: {\n    add: (label, option, note) => `${label}: ${option}. ${note}`,\n    swap: (label, option, note) => `${label} changed to ${option}. ${note} The rest stayed the same.`,\n    remove: (label, note) => `${label} removed. ${note}`\n  },\n  aria: {\n    site: 'Sample page',\n    spark: 'The AI is working'\n  },\n  finish: { label: 'Finish' },\n  takeaway: {\n    title: 'Takeaway: Details in your prompt shape what the AI builds.',\n    text: 'The AI can only build what your prompt says. Each detail you add gives it more to work with, so the page matches your idea.',\n    last: 'Press Continue to go to your project.'\n  },\n  error: 'Something went wrong while loading this activity. Try reloading the page.'\n};\n\n/* ---------- Icons (inline SVG, drawn with strokes) ---------- */\n\nconst ICONS = {\n  people: [\n    ['circle', { cx: 9, cy: 8, r: 3 }],\n    ['path', { d: 'M3 19c0-3.3 2.7-6 6-6s6 2.7 6 6' }],\n    ['circle', { cx: 17, cy: 9, r: 2.5 }],\n    ['path', { d: 'M16 13.2c2.8.2 5 2.4 5 5.3' }]\n  ],\n  palette: [\n    ['path', { d: 'M12 3a9 9 0 1 0 0 18c1.2 0 2-.8 2-1.8 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-1 .8-1.8 1.8-1.8H17a4 4 0 0 0 4-4c0-4.4-4-8-9-8z' }],\n    ['circle', { cx: 7.5, cy: 11, r: 1 }],\n    ['circle', { cx: 10, cy: 7, r: 1 }],\n    ['circle', { cx: 15, cy: 7, r: 1 }]\n  ],\n  type: [['path', { d: 'M5 6h14M12 6v13M9 19h6' }]],\n  layout: [\n    ['rect', { x: 3, y: 4, width: 18, height: 6, rx: 1.5 }],\n    ['rect', { x: 3, y: 13, width: 5, height: 7, rx: 1.5 }],\n    ['rect', { x: 9.5, y: 13, width: 5, height: 7, rx: 1.5 }],\n    ['rect', { x: 16, y: 13, width: 5, height: 7, rx: 1.5 }]\n  ],\n  check: [['path', { d: 'M5 12.5l4.5 4.5L19 7.5' }]]\n};\n\n/* ---------- Direction content ---------- */\n\n/*\n  Every direction has four details. Each detail has two options.\n  Option 1 is the phrase from the content table. Option 2 gives students\n  a second choice, so they can swap one detail and keep the rest.\n\n  sentence  Whole sentence that joins the prompt. {phrase} marks the\n            highlighted words.\n  swap      Sentence added to the prompt when a student swaps one option.\n  notes     One short takeaway for each state: [nothing, option 1, option 2].\n  slots     Text on the sample page that depends on a detail. State 0 is\n            the gray placeholder (or flat words when flat is true).\n*/\n\nconst DIRECTIONS = {\n  style: {\n    name: 'Style and design: bake sale',\n    globalDetail: 'colors',\n    details: [\n      {\n        id: 'who', icon: 'people', label: 'Who it is for',\n        sentence: 'It is a bake sale site for {phrase}.',\n        swap: 'Change only who it is for. Keep the rest the same.',\n        options: [\n          { label: 'Neighbors', phrase: 'neighbors' },\n          { label: 'Students', phrase: 'students' }\n        ],\n        notes: ['Not said, so the words are plain.', 'Words speak to neighbors.', 'Words speak to students.']\n      },\n      {\n        id: 'colors', icon: 'palette', label: 'Colors',\n        sentence: 'It uses {phrase}.',\n        swap: 'Change only the colors. Keep the rest the same.',\n        options: [\n          { label: 'Yellow, brown', phrase: 'warm yellow and brown' },\n          { label: 'Blue, white', phrase: 'cool blue and white' }\n        ],\n        notes: ['No colors named, so it stays gray.', 'Warm yellow and brown.', 'Cool blue and white.']\n      },\n      {\n        id: 'type', icon: 'type', label: 'Type',\n        sentence: 'It has {phrase}.',\n        swap: 'Change only the type. Keep the rest the same.',\n        options: [\n          { label: 'Big headings', phrase: 'big friendly headings' },\n          { label: 'Small headings', phrase: 'small, neat headings' }\n        ],\n        notes: ['No type named, so headings stay plain.', 'Big, friendly headings.', 'Small, neat headings.']\n      },\n      {\n        id: 'layout', icon: 'layout', label: 'Layout',\n        sentence: 'The layout is {phrase}.',\n        swap: 'Change only the layout. Keep the rest the same.',\n        options: [\n          { label: 'Hero, cards', phrase: 'a hero with three treat cards under it' },\n          { label: 'Simple list', phrase: 'a simple list of treats' }\n        ],\n        notes: ['No layout, so just lines of text.', 'A hero (big top section) and three cards.', 'A simple list of treats.']\n      }\n    ],\n    slots: {\n      title: { detail: 'who', text: ['Page title', 'Maple Street Bake Sale', 'Room 12 Bake Sale'] },\n      tag: { detail: 'who', text: ['A plain line of text.', 'Fresh treats for the neighborhood. Saturday at 10.', 'Treats for the whole school. Friday at lunch.'] }\n    },\n    treats: ['Cookies', 'Brownies', 'Lemon bars'],\n    plainLines: ['A plain line of text.', 'Another plain line.', 'One more plain line.'],\n    url: 'bakesale.web'\n  },\n\n};\n\n/* ---------- Small helpers ---------- */\n\nconst SVG_NS = 'http://www.w3.org/2000/svg';\n\nfunction h(tag, props, ...kids) {\n  const el = document.createElement(tag);\n  if (props) {\n    for (const [key, value] of Object.entries(props)) {\n      if (value === false || value === null || value === undefined) continue;\n      if (key === 'class') el.className = value;\n      else if (key === 'text') el.textContent = value;\n      else el.setAttribute(key, value === true ? '' : value);\n    }\n  }\n  for (const kid of kids) if (kid) el.append(kid);\n  return el;\n}\n\nfunction s(tag, attrs, ...kids) {\n  const el = document.createElementNS(SVG_NS, tag);\n  if (attrs) for (const [key, value] of Object.entries(attrs)) el.setAttribute(key, String(value));\n  for (const kid of kids) if (kid) el.append(kid);\n  return el;\n}\n\nfunction icon(name, extraClass) {\n  const svg = s('svg', {\n    viewBox: '0 0 24 24',\n    class: extraClass ? `icon ${extraClass}` : 'icon',\n    'aria-hidden': 'true',\n    focusable: 'false'\n  });\n  for (const [tag, attrs] of ICONS[name]) svg.append(s(tag, attrs));\n  return svg;\n}\n\nfunction prefersReducedMotion() {\n  return Boolean(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);\n}\n\nfunction readParams() {\n  try {\n    const params = new URLSearchParams(window.location.search);\n    return { demo: params.get('demo'), intro: params.get('intro') };\n  } catch (err) {\n    return { demo: null, intro: null };\n  }\n}\n\n/* ---------- State ---------- */\n\nconst els = {};\nconst state = {\n  dirId: null,\n  dir: null,\n  values: {},\n  mode: 'play',\n  swapId: null\n};\nlet demoStep = 0;\nlet timers = [];\nlet site = null;\n\nfunction later(fn, ms) {\n  timers.push(window.setTimeout(fn, ms));\n}\n\nfunction clearTimers() {\n  timers.forEach((id) => window.clearTimeout(id));\n  timers = [];\n}\n\nfunction detailIndex(id) {\n  return state.dir.details.findIndex((d) => d.id === id);\n}\n\nfunction resetValues() {\n  state.values = {};\n  state.dir.details.forEach((d) => { state.values[d.id] = 0; });\n  state.swapId = null;\n}\n\nfunction allChosen() {\n  return state.dir.details.every((d) => state.values[d.id] > 0);\n}\n\n/* ---------- Sample page builders ---------- */\n\nfunction slotEl(name, tag, extraClass) {\n  const def = state.dir.slots[name];\n  const classes = ['slot'];\n  if (extraClass) classes.push(extraClass);\n  if (def.flat) classes.push('is-flat');\n  return h(tag, { class: classes.join(' '), 'data-slot': name });\n}\n\nfunction bar(text) {\n  return h('p', { class: 'bar', 'aria-hidden': 'true', text });\n}\n\nfunction siteFrame(dir) {\n  const root = h('div', { class: 'site', role: 'group', 'aria-label': T.aria.site, 'data-dir': state.dirId });\n  if (dir.globalDetail) root.classList.add(`r-${dir.globalDetail}`);\n  const topBar = h('div', { class: 'site-bar', 'aria-hidden': 'true' },\n    h('span', { class: 'site-dot' }), h('span', { class: 'site-dot' }), h('span', { class: 'site-dot' }),\n    h('span', { class: 'site-url', text: dir.url }));\n  root.append(topBar);\n  return root;\n}\n\nconst BUILDERS = {\n  style(dir, root) {\n    root.append(h('div', { class: 'site-main' },\n      h('div', { class: 'hero r-who r-type r-layout' }, slotEl('title', 'p', 'site-title'), slotEl('tag', 'p', 'site-tag')),\n      h('div', { class: 'items r-layout' })));\n  },\n\n};\n\n/* ---------- Sample page rendering ---------- */\n\nfunction applySlots() {\n  const slots = state.dir.slots;\n  site.querySelectorAll('.slot').forEach((el, index) => {\n    const def = slots[el.getAttribute('data-slot')];\n    const value = state.values[def.detail];\n    const text = def.text[value];\n    if (el.textContent !== text) el.textContent = text;\n    const isBar = value === 0 && !def.flat;\n    el.classList.toggle('is-bar', isBar);\n    el.toggleAttribute('aria-hidden', isBar);\n    el.style.setProperty('--i', String(index));\n  });\n}\n\nfunction renderItems(layout) {\n  const dir = state.dir;\n  const items = site.querySelector('.items');\n  items.textContent = '';\n  if (layout === 0) {\n    dir.plainLines.forEach((line) => items.append(bar(line)));\n    return;\n  }\n  if (layout === 1) {\n    const cards = h('div', { class: 'cards' });\n    dir.treats.forEach((name) => cards.append(h('div', { class: 'treat' }, h('span', { class: 'swatch' }), h('span', { class: 'treat-name', text: name }))));\n    items.append(cards);\n    return;\n  }\n  const list = h('div', { class: 'treat-list' });\n  dir.treats.forEach((name) => list.append(h('div', { class: 'treat-row' }, h('span', { class: 'swatch' }), h('span', { class: 'treat-name', text: name }))));\n  items.append(list);\n}\n\nconst RENDERERS = {\n  style(prev) {\n    const v = state.values;\n    if (!prev || prev.layout !== v.layout) renderItems(v.layout);\n  },\n};\n\nfunction renderPage(prev, animate) {\n  const dir = state.dir;\n  dir.details.forEach((d) => site.setAttribute(`data-${d.id}`, String(state.values[d.id])));\n  applySlots();\n  RENDERERS[state.dirId](prev, animate);\n}\n\n/* ---------- Prompt, switches and notes ---------- */\n\nfunction sentenceEl(template, phrase, index) {\n  const [before, after] = template.split('{phrase}');\n  const words = phrase.split(' ');\n  const first = words.shift();\n  const phraseEl = h('span', { class: `phrase is-d${index + 1}` },\n    h('span', { class: 'nowrap' }, icon(state.dir.details[index].icon), first));\n  if (words.length) phraseEl.append(` ${words.join(' ')}`);\n  const sentence = h('span', { class: 'sent' });\n  sentence.append(before, phraseEl, after);\n  return sentence;\n}\n\nfunction renderPrompt(info) {\n  const box = els.promptText;\n  box.textContent = '';\n  box.append(h('span', { class: 'sent', text: T.prompt.base }));\n  state.dir.details.forEach((d, i) => {\n    const value = state.values[d.id];\n    if (!value) return;\n    const sentence = sentenceEl(d.sentence, d.options[value - 1].phrase, i);\n    if (info && info.id === d.id && info.move !== 'remove') sentence.classList.add('is-new');\n    box.append(' ', sentence);\n  });\n  if (state.swapId) {\n    box.append(' ', h('span', { class: `sent keep is-new is-d${detailIndex(state.swapId) + 1}`, text: state.dir.details[detailIndex(state.swapId)].swap }));\n  }\n}\n\nfunction buildGhost() {\n  const ghost = els.promptGhost;\n  ghost.textContent = '';\n  ghost.append(h('span', { class: 'sent', text: T.prompt.base }));\n  let longestSwap = 0;\n  state.dir.details.forEach((d, i) => {\n    let longest = 0;\n    d.options.forEach((o, k) => { if (o.phrase.length > d.options[longest].phrase.length) longest = k; });\n    ghost.append(' ', sentenceEl(d.sentence, d.options[longest].phrase, i));\n    if (d.swap.length > state.dir.details[longestSwap].swap.length) longestSwap = i;\n  });\n  const swapDetail = state.dir.details[longestSwap];\n  ghost.append(' ', h('span', { class: `sent keep is-d${longestSwap + 1}`, text: swapDetail.swap }));\n}\n\nfunction buildSwitches() {\n  els.switches.textContent = '';\n  state.dir.details.forEach((d, i) => {\n    const row = h('fieldset', { class: `row is-d${i + 1}`, 'data-detail': d.id });\n    row.append(h('legend', null, icon(d.icon), h('span', { text: d.label })));\n    const opts = h('div', { class: 'opts' });\n    d.options.forEach((o, k) => {\n      opts.append(h('button', { type: 'button', class: 'opt', 'aria-pressed': 'false', 'data-option': String(k + 1) },\n        icon('check', 'check'), h('span', { text: o.label })));\n    });\n    row.append(opts);\n    els.switches.append(row);\n  });\n}\n\nfunction renderSwitches() {\n  els.switches.querySelectorAll('.row').forEach((row) => {\n    const value = state.values[row.getAttribute('data-detail')];\n    row.querySelectorAll('.opt').forEach((btn) => {\n      btn.setAttribute('aria-pressed', String(Number(btn.getAttribute('data-option')) === value));\n    });\n  });\n}\n\nfunction renderNote(info) {\n  const note = els.note;\n  note.textContent = '';\n  if (!info) return;\n  const index = detailIndex(info.id);\n  const d = state.dir.details[index];\n  const line = h('p', { class: `note-main is-d${index + 1}` }, icon(d.icon),\n    h('span', null, h('strong', { text: `${d.label}: ` }), d.notes[state.values[d.id]]));\n  note.append(line);\n  if (info.move === 'swap') note.append(h('p', { class: 'note-status', text: T.status.keptRest }));\n  else if (state.mode === 'play' && allChosen()) note.append(h('p', { class: 'note-status', text: T.status.allIn }));\n}\n\n/* ---------- Feedback: flash, pulse, announcer ---------- */\n\nfunction flashRegion(id) {\n  const index = detailIndex(id) + 1;\n  const nodes = els.pageArea.querySelectorAll(`.r-${id}`);\n  nodes.forEach((node) => {\n    node.setAttribute('data-flash', String(index));\n    node.classList.remove('flash');\n    void node.offsetWidth;\n    node.classList.add('flash');\n  });\n  window.setTimeout(() => nodes.forEach((node) => node.classList.remove('flash')), CONFIG.flashMilliseconds);\n}\n\nfunction pulse() {\n  [els.spark].forEach((el) => {\n    if (!el) return;\n    el.classList.remove('is-pulsing');\n    void el.getBoundingClientRect();\n    el.classList.add('is-pulsing');\n  });\n}\n\nfunction announce(text) {\n  els.announcer.textContent = '';\n  window.setTimeout(() => { els.announcer.textContent = text; }, 30);\n}\n\n/* ---------- One move ---------- */\n\nfunction renderAll(prev, info) {\n  renderPrompt(info);\n  renderSwitches();\n  renderPage(prev, Boolean(info));\n  renderNote(info);\n  renderFinish();\n}\n\nfunction applyMove(id, next, options) {\n  const quiet = Boolean(options && options.quiet);\n  const prev = Object.assign({}, state.values);\n  const before = prev[id];\n  state.values[id] = next;\n  const move = next === 0 ? 'remove' : (before === 0 ? 'add' : 'swap');\n  state.swapId = move === 'swap' ? id : null;\n  const info = { id, move };\n  renderAll(prev, info);\n  flashRegion(id);\n  pulse();\n  const d = state.dir.details[detailIndex(id)];\n  if (!quiet) {\n    const note = d.notes[next];\n    if (move === 'add') announce(T.announce.add(d.label, d.options[next - 1].label, note));\n    else if (move === 'swap') announce(T.announce.swap(d.label, d.options[next - 1].label, note));\n    else announce(T.announce.remove(d.label, note));\n  }\n}\n\nfunction choose(id, option) {\n  applyMove(id, state.values[id] === option ? 0 : option);\n}\n\nlet completionReported = false;\n\nfunction reportComplete() {\n  if (completionReported) return;\n  completionReported = true;\n  try {\n    window.dispatchEvent(new CustomEvent(CONFIG.completeEventName));\n  } catch (err) { /* no listener needed */ }\n  try {\n    if (window.parent && window.parent !== window) {\n      window.parent.postMessage({ type: CONFIG.completeMessageType }, '*');\n    }\n  } catch (err) { /* sandbox may block it */ }\n}\n\nfunction renderFinish() {\n  els.finishButton.hidden = state.mode !== 'play' || !allChosen();\n}\n\nfunction finish() {\n  reportComplete();\n  buildTakeawayLabels();\n  setStage('done');\n  els.takeaway.focus();\n}\n\nfunction buildTakeawayLabels() {\n  els.takeawayLabels.textContent = '';\n  state.dir.details.forEach((d, i) => {\n    els.takeawayLabels.append(h('li', { class: `takeaway-label is-d${i + 1}` }, icon(d.icon), h('span', { text: d.label })));\n  });\n}\n\n/* ---------- Direction setup ---------- */\n\nfunction buildDirection(id) {\n  clearTimers();\n  state.dirId = id;\n  state.dir = DIRECTIONS[id];\n  resetValues();\n  els.pageArea.textContent = '';\n  site = siteFrame(state.dir);\n  BUILDERS[id](state.dir, site);\n  els.pageArea.append(site);\n  buildSwitches();\n  buildGhost();\n  renderAll(null, null);\n}\n\n/* ---------- Demo ---------- */\n\nfunction setMode(mode) {\n  state.mode = mode;\n  els.workspace.setAttribute('data-mode', mode);\n  els.switches.hidden = mode !== 'play';\n  els.demoPanel.hidden = mode !== 'demo';\n  renderFinish();\n}\n\nfunction setCaption(title, text, stepText) {\n  els.demoStep.textContent = stepText;\n  els.demoTitle.textContent = title;\n  els.demoTitle.hidden = !title;\n  els.demoText.textContent = text;\n}\n\nfunction setAllChosen() {\n  state.dir.details.forEach((d) => { state.values[d.id] = 1; });\n  state.swapId = null;\n  renderAll(null, null);\n}\n\nfunction showStep(n) {\n  clearTimers();\n  demoStep = n;\n  const details = state.dir.details;\n  const total = details.length + 2;\n  const last = n === total;\n  const stepText = T.demo.stepOf(n, total);\n  els.demoNext.textContent = last ? T.demo.start : T.demo.next;\n  els.demoNext.classList.toggle('btn-primary', last);\n  els.demoNext.classList.toggle('btn-outline', !last);\n  if (n === 1) {\n    resetValues();\n    renderAll(null, null);\n    setCaption('', T.demo.vague, stepText);\n    announce(T.demo.vague);\n    pulse();\n  } else if (!last) {\n    const index = n - 2;\n    details.forEach((d, i) => { if (i < index) state.values[d.id] = 1; });\n    const label = details[index].label.toLowerCase();\n    const caption = index === 0 ? T.demo.first(label) : T.demo.later(label);\n    setCaption('', caption, stepText);\n    announce(caption);\n    applyMove(details[index].id, 1, { quiet: true });\n  } else {\n    setAllChosen();\n    setCaption(T.demo.endTitle, T.demo.endText, stepText);\n    announce(`${T.demo.endTitle} ${T.demo.endText}`);\n    pulse();\n  }\n}\n\nfunction startDemo() {\n  setMode('demo');\n  showStep(1);\n}\n\nfunction startPlay(shouldFocus) {\n  clearTimers();\n  demoStep = 0;\n  resetValues();\n  renderAll(null, null);\n  setMode('play');\n  if (shouldFocus) {\n    announce(T.demo.ready);\n    const first = els.switches.querySelector('.opt');\n    if (first) first.focus();\n  }\n}\n\n/* ---------- Intro page ---------- */\n\nfunction setStage(stage) {\n  const intro = stage === 'intro';\n  const done = stage === 'done';\n  els.header.hidden = done;\n  els.introScreen.hidden = !intro;\n  els.practiceLine.hidden = intro;\n  els.doThis.hidden = intro;\n  els.workspace.hidden = intro || done;\n  els.takeaway.hidden = !done;\n}\n\nfunction leaveIntro() {\n  setStage('active');\n}\n\n/* ---------- Page setup ---------- */\n\nfunction buildSpark() {\n  const svg = s('svg', { viewBox: '0 0 24 24', class: 'spark', role: 'img', 'aria-label': T.aria.spark });\n  svg.append(s('path', { d: 'M12 2l2.6 7.4L22 12l-7.4 2.6L12 22l-2.6-7.4L2 12l7.4-2.6z' }));\n  return svg;\n}\n\nfunction fillText() {\n  document.querySelectorAll('[data-text]').forEach((el) => {\n    const value = el.getAttribute('data-text').split('.').reduce((obj, key) => obj[key], T);\n    el.textContent = value;\n  });\n}\n\nfunction showError() {\n  const box = els.error || document.getElementById('error');\n  if (!box) return;\n  box.textContent = T.error;\n  box.hidden = false;\n}\n\nfunction init() {\n  ['widget', 'workspace', 'pageArea', 'promptText', 'promptGhost', 'switches', 'note', 'announcer',\n    'demoPanel', 'demoStep', 'demoTitle', 'demoText', 'demoNext',  'header', 'introScreen', 'startButton', 'finishButton', 'takeaway', 'takeawayLabels', 'practiceLine', 'doThis', 'sparkHolder', 'error'].forEach((id) => {\n    els[id] = document.getElementById(id);\n  });\n  fillText();\n\n  els.spark = buildSpark();\n  els.sparkHolder.append(els.spark);\n\n\n  const params = readParams();\n  buildDirection(CONFIG.direction);\n\n  els.switches.addEventListener('click', (event) => {\n    const button = event.target.closest('.opt');\n    if (!button) return;\n    choose(button.closest('.row').getAttribute('data-detail'), Number(button.getAttribute('data-option')));\n  });\n  els.demoNext.addEventListener('click', () => {\n    if (demoStep === state.dir.details.length + 2) startPlay(true);\n    else showStep(demoStep + 1);\n  });\n\n  els.finishButton.addEventListener('click', finish);\n  els.startButton.addEventListener('click', () => {\n    leaveIntro();\n    if (CONFIG.showDemo && params.demo !== '0') startDemo();\n    else startPlay(true);\n  });\n\n  if (CONFIG.showIntro && params.intro !== '0') {\n    setStage('intro');\n    startPlay(false);\n  } else if (CONFIG.showDemo && params.demo !== '0') {\n    startDemo();\n  } else {\n    startPlay(false);\n  }\n}\n\nwindow.addEventListener('error', showError);\n\ntry {\n  init();\n} catch (err) {\n  showError();\n}\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
