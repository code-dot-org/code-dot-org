<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-11-03T04:22:34.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": true,
    "start_sources": {
      "folders": {
      },
      "files": {
        "59d70cfe-c5a8-411a-996c-64dbe4198fd8": {
          "id": "59d70cfe-c5a8-411a-996c-64dbe4198fd8",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Bake Sale Site Look Widget</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <h1>Sample Bake Sale Site</h1>\n    <div id=\"promptDisplay\">Current Prompt: <span id=\"currentPrompt\">A bake sale site.</span></div>\n    <div class=\"controls\">\n        <button id=\"toggleDetail1\">Add Detail: Colorful Theme</button>\n        <button id=\"toggleDetail2\">Add Detail: Product Grid</button>\n        <button id=\"toggleDetail3\">Add Detail: Hero Banner</button>\n    </div>\n    <div id=\"bakeSaleSite\">\n        <h2>Welcome to Our Bake Sale!</h2>\n        <p>Delicious treats for everyone.</p>\n    </div>\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "265efa57-95e9-46bc-9ba2-71b6d855a1c6": {
          "id": "265efa57-95e9-46bc-9ba2-71b6d855a1c6",
          "name": "style.css",
          "contents": "body {\n    font-family: Arial, sans-serif;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding: 20px;\n    background-color: #f0f0f0;\n    color: #333;\n}\n\nh1 {\n    color: #333;\n    margin-bottom: 10px;\n}\n\n#promptDisplay {\n    margin: 20px 0;\n    font-size: 1.1em;\n    color: #555;\n}\n\n#currentPrompt {\n    font-weight: bold;\n}\n\n.controls {\n    margin-bottom: 20px;\n}\n\nbutton {\n    padding: 10px 15px;\n    margin: 0 5px;\n    border: none;\n    background-color: #007bff;\n    color: white;\n    border-radius: 5px;\n    cursor: pointer;\n    transition: background-color 0.3s ease;\n}\n\nbutton:hover {\n    background-color: #0056b3;\n}\n\n#bakeSaleSite {\n    width: 90%;\n    max-width: 800px;\n    min-height: 200px;\n    border: 2px dashed #ccc;\n    padding: 20px;\n    background-color: #e0e0e0; /* Plain gray background */\n    color: #444;\n    text-align: center;\n    transition: all 0.5s ease-in-out;\n    border-radius: 8px;\n}\n\n#bakeSaleSite h2 {\n    color: #555;\n    margin-top: 0;\n}\n\n#bakeSaleSite p {\n    font-size: 1.1em;\n}\n\n/* Styles for detailed look (simulated by widget's JS) */\n#bakeSaleSite.colorful {\n    background-color: #FFF0F5; /* Pinkish background */\n    color: #5C4033; /* Dark brown text */\n    border-color: #FFB6C1;\n}\n\n#bakeSaleSite.colorful h2 {\n    color: #FF69B4; /* Hot pink */\n}\n\n#bakeSaleSite.product-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n    gap: 15px;\n    text-align: left;\n    background-color: #F8F8F8;\n    padding: 25px;\n}\n\n#bakeSaleSite.product-grid h2,\n#bakeSaleSite.product-grid p {\n    grid-column: 1 / -1;\n    text-align: center;\n}\n\n#bakeSaleSite.product-grid .product-card {\n    border: 1px solid #ddd;\n    border-radius: 5px;\n    padding: 10px;\n    background-color: #fff;\n    box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n}\n\n#bakeSaleSite.hero-banner {\n    background-image: url('data:image/svg+xml;base64,'); /* Simple SVG image placeholder */\n    background-size: cover;\n    background-position: center;\n    color: white;\n    text-shadow: 2px 2px 4px rgba(0,0,0,0.5);\n    padding: 40px 20px;\n}\n\n#bakeSaleSite.hero-banner h2 {\n    font-size: 2.5em;\n    color: white;\n}\n\n#bakeSaleSite.hero-banner p {\n    font-size: 1.3em;\n    margin-top: 10px;\n}\n",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "e208055e-4a97-465d-beb7-4801aafcfb09": {
          "id": "e208055e-4a97-465d-beb7-4801aafcfb09",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const currentPromptSpan = document.getElementById('currentPrompt');\n    const bakeSaleSite = document.getElementById('bakeSaleSite');\n    const toggleDetail1Btn = document.getElementById('toggleDetail1');\n    const toggleDetail2Btn = document.getElementById('toggleDetail2');\n    const toggleDetail3Btn = document.getElementById('toggleDetail3');\n\n    let activeDetails = new Set();\n\n    const updateSitePreview = () => {\n        let promptText = 'A bake sale site.';\n        let siteContent = `<h2>Welcome to Our Bake Sale!</h2><p>Delicious treats for everyone.</p>`;\n\n        // Reset classes\n        bakeSaleSite.className = '';\n\n        if (activeDetails.has('colorful')) {\n            bakeSaleSite.classList.add('colorful');\n            promptText += ' With a colorful, inviting theme.';\n        }\n        if (activeDetails.has('product-grid')) {\n            bakeSaleSite.classList.add('product-grid');\n            promptText += ' Displaying items in a clear grid layout.';\n            siteContent = `<h2>Our Scrumptious Selection!</h2>\n                           <div class=\"product-card\"><h3>Cupcakes</h3><p>$3.00 each</p></div>\n                           <div class=\"product-card\"><h3>Cookies</h3><p>$1.50 each</p></div>\n                           <div class=\"product-card\"><h3>Brownies</h3><p>$2.50 each</p></div>`;\n        }\n        if (activeDetails.has('hero-banner')) {\n            bakeSaleSite.classList.add('hero-banner');\n            promptText += ' Featuring a hero banner for special announcements.';\n            // Hero banner styling takes precedence for background/color\n            siteContent = `<h2>Freshly Baked Delights!</h2><p>Don't miss our daily specials!</p>`;\n        }\n\n        currentPromptSpan.textContent = promptText;\n        bakeSaleSite.innerHTML = siteContent;\n    };\n\n    const toggleDetail = (detailName) => {\n        if (activeDetails.has(detailName)) {\n            activeDetails.delete(detailName);\n        } else {\n            activeDetails.add(detailName);\n        }\n        updateSitePreview();\n    };\n\n    toggleDetail1Btn.addEventListener('click', () => toggleDetail('colorful'));\n    toggleDetail2Btn.addEventListener('click', () => toggleDetail('product-grid'));\n    toggleDetail3Btn.addEventListener('click', () => toggleDetail('hero-banner'));\n\n    // Initial state\n    updateSitePreview();\n\n    console.log(\"Bake Sale Site Look Widget loaded. Student will observe changes simulated by the widget.\");\n});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
        "59d70cfe-c5a8-411a-996c-64dbe4198fd8",
        "265efa57-95e9-46bc-9ba2-71b6d855a1c6",
