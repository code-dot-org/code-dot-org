        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Daily Medication Tracker</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <header>\n    <h1>Daily Medication Reminders</h1>\n  </header>\n  \n  <main id=\"app\">\n    <div class=\"med-card\" id=\"card-1\">\n      <h2 class=\"med-name\" id=\"name-1\">Loading Medication 1...</h2>\n      <p class=\"med-dosage\" id=\"dosage-1\">Dosage: Unknown</p>\n      <p class=\"med-time\" id=\"time-1\">Time: Awaiting setting</p>\n    </div>\n\n    <div class=\"med-card\" id=\"card-2\">\n      <h2 class=\"med-name\" id=\"name-2\">Loading Medication 2...</h2>\n      <p class=\"med-dosage\" id=\"dosage-2\">Dosage: Unknown</p>\n      <p class=\"med-time\" id=\"time-2\">Time: Awaiting setting</p>\n    </div>\n\n    <div class=\"med-card\" id=\"card-3\">\n      <h2 class=\"med-name\" id=\"name-3\">Loading Medication 3...</h2>\n      <p class=\"med-dosage\" id=\"dosage-3\">Dosage: Unknown</p>\n      <p class=\"med-time\" id=\"time-3\">Time: Awaiting setting</p>\n    </div>\n  </main>\n\n  <script src=\"script.js\" defer></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* Import a clean, readable font */\n@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap');\n\n:root {\n  /* Define colors for a calming medical theme (Blue/Green) */\n  --color-primary: #3F51B5;    /* Indigo/Blue */\n  --color-secondary: #00BCD4;  /* Cyan/Aqua */\n  --color-text: #333333;\n  --color-bg: #E3F2FD;         /* Light Blue Background */\n  --color-card-bg: #FFFFFF;\n}\n\nbody {\n  font-family: 'Montserrat', sans-serif;\n  background-color: var(--color-bg);\n  color: var(--color-text);\n  margin: 0;\n  padding: 0;\n  text-align: center;\n}\n\nheader {\n  background-color: var(--color-primary);\n  color: white;\n  padding: 20px;\n  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);\n  margin-bottom: 30px;\n}\n\n#app {\n  display: flex;\n  justify-content: center;\n  gap: 25px;\n  padding: 20px;\n}\n\n.med-card {\n  width: 280px;\n  padding: 25px;\n  border-radius: 12px;\n  background-color: var(--color-card-bg);\n  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);\n  text-align: left;\n  border-top: 10px solid var(--color-secondary); /* Accent color */\n}\n\n.med-card:hover {\n  box-shadow: 0 6px 15px rgba(0, 0, 0, 0.2);\n}\n\n.med-name {\n  font-size: 1.4em;\n  color: var(--color-primary);\n  margin-top: 0;\n  margin-bottom: 10px;\n  border-bottom: 1px solid #eee;\n  padding-bottom: 5px;\n}\n\n.med-dosage, .med-time {\n  font-size: 0.9em;\n  margin: 8px 0;\n  color: #555;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "// --- Data Schema: Parallel Arrays ---\n// These arrays hold the data for our Medication Tracker.\n// Each index (0, 1, 2) corresponds to a single medication reminder.\n\n\n\n// Card 1 Elements\nconst name1 = document.getElementById(\"name-1\");\nconst dosage1 = document.getElementById(\"dosage-1\");\nconst time1 = document.getElementById(\"time-1\");\n\n// Card 2 Elements\nconst name2 = document.getElementById(\"name-2\");\nconst dosage2 = document.getElementById(\"dosage-2\");\nconst time2 = document.getElementById(\"time-2\");\n\n// Card 3 Elements\nconst name3 = document.getElementById(\"name-3\");\nconst dosage3 = document.getElementById(\"dosage-3\");\nconst time3 = document.getElementById(\"time-3\");\n\n\n// Assign array values to the corresponding HTML elements by index.\nconst updateDisplay = () => {\n  \n  \n};\n\n// Call the function to run the updates when the script loads\nupdateDisplay();",
          "folderId": "0",
          "active": true
        }
