          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    \n    <h1> Visit Tucson! </h1>\n    \n    <p> This is a Tucson Appreciation page for everyone to know how great Tucson is! Here are 3 places to visit while in Tucson:</p>\n\n    \n    <img class=\"alignleft\" src=\"university.jpg\" />\n    \n    <img class=\"alignright\" src=\"mission.jpg\" />\n    \n    <ol>\n      <li>the University of Arizona</li>\n      <li>the San Xavier Mission</li>\n      <li>the Biosphere</li>\n    </ol>\n    \n    <p>Tucson is also home to beautiful mountains and sunsets!</p>\n    <p id=\"learnmore\">\n      <a href=\"https://www.visittucson.org/\">Click here to learn more about Tucson!</a>\n    </p>\n    \n    <img class=\"footerimg\" src=\"sunset.jpg\" />\n    \n    <hr />\n    \n    <p class=\"disclaimer\">All images from Pixabay and are provided with a Pixabay license</p>\n    \n  </body>\n</html>",
