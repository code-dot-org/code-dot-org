    "start_sources": {
      "folders": {},
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html>\n\n<head>\n    <meta charset=\"utf-8\">\n    <title>All About Otters!</title>\n    <style>\n        /* ── Tag Inspector sidebar ── */\n\n        #tag-inspector {\n            position: fixed;\n            top: 0;\n            right: 0;\n            width: 320px;\n            height: 100vh;\n            background: #1e1e2e;\n            color: #cdd6f4;\n            font-family: 'Consolas', 'Courier New', monospace;\n            font-size: 13px;\n            line-height: 1.5;\n            display: flex;\n            flex-direction: column;\n            z-index: 9999;\n            box-shadow: -3px 0 12px rgba(0, 0, 0, 0.35);\n            overflow: hidden;\n        }\n\n        #tag-inspector-header {\n            background: #313244;\n            color: #cba6f7;\n            font-size: 14px;\n            font-weight: bold;\n            padding: 10px 14px;\n            text-transform: uppercase;\n            letter-spacing: 0.05em;\n            flex-shrink: 0;\n            border-bottom: 1px solid #45475a;\n            user-select: none;\n        }\n\n        #tag-inspector-body {\n            flex: 1;\n            overflow-y: auto;\n            padding: 12px 14px;\n        }\n\n        #tag-inspector-placeholder {\n            color: #585b70;\n            font-style: italic;\n            margin: 0;\n        }\n\n        .ti-section {\n            margin-bottom: 16px;\n            padding-bottom: 16px;\n            border-bottom: 1px solid #313244;\n        }\n\n        .ti-section:last-child {\n            border-bottom: none;\n        }\n\n        .ti-section-title {\n            margin: 0 0 6px 0;\n            font-size: 11px;\n            font-weight: bold;\n            text-transform: uppercase;\n            letter-spacing: 0.08em;\n            color: #a6e3a1;\n        }\n\n        .ti-anatomy-line {\n            color: #89b4fa;\n            font-weight: bold;\n            overflow-wrap: break-word;\n        }\n\n        .ti-anatomy-content {\n            color: #cdd6f4;\n            font-weight: normal;\n            font-style: italic;\n            padding-left: 16px;\n        }\n\n        .ti-note {\n            color: #f9e2af;\n            font-style: italic;\n            margin-top: 4px;\n        }\n\n        #ti-path {\n            color: #89b4fa;\n            overflow-wrap: break-word;\n        }\n\n        .ti-rule-block {\n            margin-bottom: 10px;\n            background: #181825;\n            border-radius: 4px;\n            padding: 6px 8px;\n            font-size: 12px;\n        }\n\n        .ti-inherited-label {\n            color: #f9e2af;\n            font-style: italic;\n            font-size: 11px;\n            margin-bottom: 2px;\n        }\n\n        .ti-rule-selector {\n            color: #cba6f7;\n            margin-bottom: 3px;\n        }\n\n        .ti-rule-prop {\n            padding-left: 12px;\n        }\n\n        .ti-rule-prop-name {\n            color: #89dceb;\n        }\n\n        .ti-rule-prop-value {\n            color: #a6e3a1;\n        }\n\n        .ti-no-rules {\n            color: #585b70;\n            font-style: italic;\n        }\n\n        .ti-highlight {\n            outline: 2px solid #cba6f7 !important;\n            outline-offset: 2px !important;\n        }\n\n    </style>\n</head>\n\n<body>\n    <header>\n      <h1>Welcome to the Otter Zone!</h1>\n      <img src=\"otter.jpg\" alt=\"A cute brown otter floating in a river\">\n      <p id=\"image-credit\">Image by Michael Baird photography</p>\n    </header>\n\n    <main>\n      <div class=\"two-column-layout\">\n        <section id=\"otter-facts\">\n          <h2>Cool Otter Facts!</h2>\n          <ul>\n            <li>Did you know otters hold hands when they sleep so they don't drift apart? Awww!</li>\n            <li>They can also hold their breath for a loooong time underwater!</li>\n          </ul>\n        </section>\n\n        <section id=\"otter-swimmers\">\n          <h2>Otterly Amazing Swimmers!</h2>\n          <p>Otters are super speedy in the water! They use their powerful tails and webbed feet to zoom around.</p>\n          <p>They can dive deep to find yummy snacks like fish and crabs.</p>\n        </section>\n      </div>\n\n      <hr id=\"otter-divider\">\n\n      <section id=\"otter-locations\">\n        <h2>Where in the World are Otters?</h2>\n        <p>You can find different kinds of otters all over the globe, from chilly Alaska to sunny Brazil.</p>\n        <p>Some live in rivers, some in coasts, and some even in the open ocean!</p>\n      </section>\n\n    </main>\n\n    <footer>\n      <p>Thanks for visiting the otter-tastic website!</p>\n    </footer>\n\n    <div id=\"tag-inspector\">\n        <div id=\"tag-inspector-header\">Tag Inspector</div>\n        <div id=\"tag-inspector-body\">\n            <p id=\"tag-inspector-placeholder\">Hover over any element to inspect it.</p>\n\n            <div class=\"ti-section\" id=\"ti-anatomy\" hidden>\n                <div class=\"ti-section-title\">HTML Element</div>\n                <div id=\"ti-open\" class=\"ti-anatomy-line\"></div>\n                <div id=\"ti-content\" class=\"ti-anatomy-line ti-anatomy-content\"></div>\n                <div id=\"ti-close\" class=\"ti-anatomy-line\"></div>\n                <div id=\"ti-void-note\" class=\"ti-note\" hidden>self-closing: no closing tag needed</div>\n            </div>\n\n            <div class=\"ti-section\" id=\"ti-nesting\" hidden>\n                <div class=\"ti-section-title\">Nesting</div>\n                <div id=\"ti-path\"></div>\n            </div>\n\n            <div class=\"ti-section\" id=\"ti-css\" hidden>\n                <div class=\"ti-section-title\">CSS Rules</div>\n                <div id=\"ti-rules\"></div>\n            </div>\n\n        </div>\n    </div>\n\n    <script>\n        // ── Student CSS (single source of truth) ──────────────────────────────\n        // Edit styles here. They are injected into the page AND read by the\n        // inspector, so what you see in the sidebar always matches what's here.\n        const STUDENT_CSS = `\n            body {\n                font-family: 'Open Sans', sans-serif;\n                color: #333333;\n                margin: 0;\n                line-height: 1.6;\n                padding-right: 340px;\n            }\n\n            header, footer {\n                background-color: #f0f8ff;\n                padding: 1rem;\n                text-align: center;\n                border: 2px solid #a7d9f7;\n                color: #005f99;\n            }\n\n            main {\n                padding: 1rem;\n                max-width: 960px;\n                margin: 0 auto;\n            }\n\n            section {\n                margin-bottom: 1rem;\n                padding: 1rem;\n                border-radius: 8px;\n            }\n\n            #otter-facts {\n                background-color: #fff5e1;\n                border: 3px solid #ffd700;\n                font-family: 'Lato', sans-serif;\n                color: #8b4513;\n            }\n\n            #otter-swimmers {\n                background-color: #e0f8e0;\n                border: 3px solid #8bc34a;\n                font-family: 'Georgia', serif;\n                color: #33691e;\n            }\n\n            #otter-locations {\n                background-color: #ffe0b2;\n                border: 3px solid #ff9800;\n                font-family: 'Merriweather', serif;\n                color: #e65100;\n            }\n\n            .two-column-layout {\n                display: flex;\n                flex-wrap: wrap;\n                gap: 1rem;\n            }\n\n            .two-column-layout section {\n                flex: 1;\n                min-width: 300px;\n            }\n\n            img {\n                max-width: 100%;\n                height: auto;\n                border-radius: 15px;\n                border: 5px solid #a7d9f7;\n            }\n\n            h1 {\n                text-decoration: underline;\n            }\n\n            #image-credit {\n                font-size: 10px;\n                color: #6699bb;\n            }\n\n            hr#otter-divider {\n                border: 3px dashed #a7d9f7;\n                background-color: transparent;\n                color: #a7d9f7;\n            }\n        `;\n\n        // Inject student CSS into the page\n        (function () {\n            var s = document.createElement('style');\n            s.textContent = STUDENT_CSS;\n            document.head.appendChild(s);\n        })();\n\n        (function () {\n            'use strict';\n\n            const VISUAL_PROPS = new Set([\n                'color', 'background-color', 'background',\n                'border', 'border-color', 'border-style', 'border-width', 'border-radius',\n                'font-family', 'font-size', 'font-weight',\n                'text-decoration', 'text-align',\n                'padding', 'margin'\n            ]);\n\n            const INHERITABLE_PROPS = new Set(['color', 'font-family', 'font-size', 'font-weight', 'text-decoration']);\n\n            // Elements that never take a closing tag.\n            const VOID_TAGS = new Set(['img', 'hr', 'br', 'input', 'link', 'meta', 'source']);\n\n            const sidebar     = document.getElementById('tag-inspector');\n            const placeholder = document.getElementById('tag-inspector-placeholder');\n            const tiAnatomy   = document.getElementById('ti-anatomy');\n            const tiNesting   = document.getElementById('ti-nesting');\n            const tiCss       = document.getElementById('ti-css');\n            const tiOpen      = document.getElementById('ti-open');\n            const tiContent   = document.getElementById('ti-content');\n            const tiClose     = document.getElementById('ti-close');\n            const tiVoidNote  = document.getElementById('ti-void-note');\n            const tiPath      = document.getElementById('ti-path');\n            const tiRules     = document.getElementById('ti-rules');\n            let lastHighlighted = null;\n\n            // Parse STUDENT_CSS directly — values are exactly as written (hex, shorthands, etc.)\n            const SOURCE_RULES = (function () {\n                const text = STUDENT_CSS.replace(/\\/\\*[\\s\\S]*?\\*\\//g, ''); // strip comments\n                const rules = [];\n                const rulePattern = /([^{]+)\\{([^}]*)\\}/g;\n                let match;\n                while ((match = rulePattern.exec(text)) !== null) {\n                    const selector = match[1].trim();\n                    if (!selector || selector.startsWith('@')) continue;\n                    const props = [];\n                    match[2].split(';').forEach(function (decl) {\n                        const colonIdx = decl.indexOf(':');\n                        if (colonIdx === -1) return;\n                        const name  = decl.substring(0, colonIdx).trim();\n                        const value = decl.substring(colonIdx + 1).trim();\n                        if (name && value) props.push({ name: name, value: value });\n                    });\n                    if (props.length > 0) rules.push({ selector: selector, props: props });\n                }\n                return rules;\n            })();\n\n            document.addEventListener('mouseover', function (e) {\n                const target = e.target;\n                if (sidebar.contains(target) || target === sidebar) return;\n                if (target === document.body || target === document.documentElement) return;\n                updateHighlight(target);\n                updatePanel(target);\n            });\n\n            function updateHighlight(el) {\n                if (lastHighlighted && lastHighlighted !== el) {\n                    lastHighlighted.classList.remove('ti-highlight');\n                }\n                el.classList.add('ti-highlight');\n                lastHighlighted = el;\n            }\n\n            function openingTag(el) {\n                let s = '<' + el.tagName.toLowerCase();\n                for (const attr of el.attributes) {\n                    let value = attr.value;\n                    if (attr.name === 'class') {\n                        // ti-highlight is injected by the inspector itself; hide it.\n                        value = value.split(/\\s+/).filter(function (c) { return c !== 'ti-highlight'; }).join(' ');\n                        if (!value) continue;\n                    }\n                    if (value.length > 40) value = value.substring(0, 40) + '\\u2026';\n                    s += ' ' + attr.name + '=\"' + value + '\"';\n                }\n                return s + '>';\n            }\n\n            function contentPreview(el) {\n                if (el.children.length > 0) {\n                    const n = el.children.length;\n                    return '\\u2026 ' + n + ' nested element' + (n === 1 ? '' : 's') + ' inside \\u2026';\n                }\n                const t = el.textContent.trim().replace(/\\s+/g, ' ');\n                if (!t) return '(empty)';\n                return t.length > 50 ? t.substring(0, 50) + '\\u2026' : t;\n            }\n\n            function nestingPath(el) {\n                const parts = [];\n                let node = el;\n                while (node && node.tagName && node !== document.documentElement) {\n                    parts.unshift('<' + node.tagName.toLowerCase() + '>');\n                    node = node.parentElement;\n                }\n                parts.unshift('<html>');\n                return parts.join(' \\u203a ');\n            }\n\n            function updatePanel(el) {\n                placeholder.hidden = true;\n                tiAnatomy.hidden   = false;\n                tiNesting.hidden   = false;\n                tiCss.hidden       = false;\n\n                const tag = el.tagName.toLowerCase();\n                tiOpen.textContent = openingTag(el);\n                if (VOID_TAGS.has(tag)) {\n                    tiContent.textContent = '';\n                    tiClose.textContent   = '';\n                    tiVoidNote.hidden     = false;\n                } else {\n                    tiContent.textContent = contentPreview(el);\n                    tiClose.textContent   = '</' + tag + '>';\n                    tiVoidNote.hidden     = true;\n                }\n\n                tiPath.textContent = nestingPath(el);\n\n                renderRules(getMatchingSourceRules(el), getInheritedRules(el));\n            }\n\n            function getMatchingSourceRules(el) {\n                const matched = [];\n                for (const rule of SOURCE_RULES) {\n                    try { if (el.matches(rule.selector)) matched.push(rule); } catch (e) {}\n                }\n                return matched;\n            }\n\n            // Rules on ancestors whose inheritable properties reach this element.\n            // Each entry remembers which ancestor it came from, so the sidebar\n            // can say \"inherited from <body>\".\n            function getInheritedRules(el) {\n                const covered = new Set();\n                for (const rule of getMatchingSourceRules(el)) {\n                    for (const prop of rule.props) {\n                        if (INHERITABLE_PROPS.has(prop.name)) covered.add(prop.name);\n                    }\n                }\n\n                const remaining = new Set(Array.from(INHERITABLE_PROPS).filter(function (p) { return !covered.has(p); }));\n                const result = [];\n                let ancestor = el.parentElement;\n\n                while (ancestor && ancestor.nodeType === Node.ELEMENT_NODE && remaining.size > 0) {\n                    for (const rule of getMatchingSourceRules(ancestor)) {\n                        const inheritedProps = rule.props.filter(function (p) { return remaining.has(p.name); });\n                        if (inheritedProps.length > 0) {\n                            result.push({\n                                selector: rule.selector,\n                                props: inheritedProps,\n                                from: ancestor.tagName.toLowerCase()\n                            });\n                            inheritedProps.forEach(function (p) { remaining.delete(p.name); });\n                        }\n                    }\n                    ancestor = ancestor.parentElement;\n                }\n\n                return result;\n            }\n\n            function renderRuleBlock(selector, props, inheritedFrom) {\n                const shown = props.filter(function (p) { return VISUAL_PROPS.has(p.name); });\n                if (shown.length === 0) return null;\n\n                const block = document.createElement('div');\n                block.className = 'ti-rule-block';\n\n                if (inheritedFrom) {\n                    const label = document.createElement('div');\n                    label.className = 'ti-inherited-label';\n                    label.textContent = 'inherited from <' + inheritedFrom + '>';\n                    block.appendChild(label);\n                }\n\n                const open = document.createElement('div');\n                open.className = 'ti-rule-selector';\n                open.textContent = selector + ' {';\n                block.appendChild(open);\n\n                for (const prop of shown) {\n                    const line = document.createElement('div');\n                    line.className = 'ti-rule-prop';\n\n                    const n = document.createElement('span');\n                    n.className = 'ti-rule-prop-name';\n                    n.textContent = prop.name;\n\n                    const v = document.createElement('span');\n                    v.className = 'ti-rule-prop-value';\n                    v.textContent = ': ' + prop.value + ';';\n\n                    line.appendChild(n);\n                    line.appendChild(v);\n                    block.appendChild(line);\n                }\n\n                const close = document.createElement('div');\n                close.className = 'ti-rule-selector';\n                close.textContent = '}';\n                block.appendChild(close);\n\n                return block;\n            }\n\n            function renderRules(directRules, inheritedRules) {\n                tiRules.innerHTML = '';\n                let any = false;\n\n                for (const rule of directRules) {\n                    const block = renderRuleBlock(rule.selector, rule.props, null);\n                    if (block) { tiRules.appendChild(block); any = true; }\n                }\n\n                for (const entry of inheritedRules) {\n                    const block = renderRuleBlock(entry.selector, entry.props, entry.from);\n                    if (block) { tiRules.appendChild(block); any = true; }\n                }\n\n                if (!any) {\n                    const msg = document.createElement('div');\n                    msg.className = 'ti-no-rules';\n                    msg.textContent = 'No visual CSS rules apply.';\n                    tiRules.appendChild(msg);\n                }\n            }\n        })();\n    </script>\n</body>\n\n</html>\n",
          "active": true,
          "folderId": "0"
        },
