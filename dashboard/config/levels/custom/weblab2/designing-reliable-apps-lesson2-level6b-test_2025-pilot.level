  "properties": {
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Robot Chef Logic</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n    <div class=\"card\">\n        <header>\n            <h1>Robot Chef 2.0</h1>\n            <p>Task Queue Monitor</p>\n        </header>\n\n        <div id=\"logBox\" class=\"console-screen\">\n            <div class=\"line system\">> System Ready...</div>\n        </div>\n\n        <div class=\"controls\">\n            <button id=\"runBtn\" class=\"primary-btn\">RUN ROUTINE ▶</button>\n        </div>\n    </div>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n    background-color: #f0f2f5;\n    font-family: sans-serif;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    height: 100vh;\n    margin: 0;\n}\n\n.card {\n    background: white;\n    width: 400px;\n    padding: 30px;\n    border-radius: 12px;\n    box-shadow: 0 4px 15px rgba(0,0,0,0.1);\n}\n\nheader h1 { margin: 0; font-size: 1.5rem; color: #333; }\nheader p { margin: 5px 0 20px 0; color: #666; font-size: 0.9rem; }\n\n/* The Log Box */\n.console-screen {\n    background-color: #2d2d2d;\n    color: #4cd137; /* Bright green text */\n    height: 250px;\n    border-radius: 8px;\n    padding: 15px;\n    overflow-y: auto;\n    font-family: monospace;\n    font-size: 0.95rem;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n}\n\n.line { border-bottom: 1px solid #444; padding-bottom: 4px; }\n.system { color: #888; }\n.error { color: #ff4757; font-weight: bold; }\n\n/* Button & Status */\n.controls { margin-top: 20px; text-align: center; }\n\n.primary-btn {\n    background-color: #0097e6;\n    color: white;\n    border: none;\n    padding: 12px 24px;\n    font-size: 1rem;\n    font-weight: bold;\n    border-radius: 6px;\n    cursor: pointer;\n    width: 100%;\n}\n\n.primary-btn:hover { background-color: #007bbd; }\n.primary-btn:disabled { background-color: #ccc; cursor: not-allowed; }\n\n.status-text {\n    margin-top: 15px;\n    font-weight: bold;\n    color: #666;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const runBtn = document.getElementById('runBtn');\nconst logBox = document.getElementById('logBox');\n\nconst addLog = (text) => {\n    const div = document.createElement('div');\n    div.innerText = \"> \" + text;\n    logBox.appendChild(div);\n};\n\nrunBtn.addEventListener('click', () => {\n\n  \n    addLog(\"Order started...\");\n\n  \n    setTimeout(() => {\n        addLog(\"Coffee is brewed!\");\n    }, 5000);\n\n\n    setTimeout(() => {\n        addLog(\"Eggs are fried!\");\n    }, 3000);\n\n  \n    setTimeout(() => {\n        addLog(\"Toast popped!\");\n    }, 2000);\n\n\n    addLog(\"Pouring Orange Juice\");\n\n  \n    addLog(\"Ticket placed on counter.\");\n\n});",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "3"
      ]
    },
    "encrypted": "false",
    "display_name": "The Asynchronous Kitchen",
