    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <meta charset=\"utf-8\">\n    <title>Population Tracker</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    <div class=\"container\">\n      \n      <div id=\"header-section\">\n        <h1 id=\"title-section\">Title</h1>\n        <p id=\"date-section\">Date</p>\n      </div>\n      \n      <div class=\"controls\">\n        <div id=\"status\">Status: </div>\n        <button id=\"fetch-btn\">Get Live Census</button>\n      </div>\n\n      <div id=\"results\"></div>\n      \n    </div>\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&display=swap');\n\nbody {\n  font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;\n  /* Fun, bright lavender-pink gradient background */\n  background-color: #f3e8ff;\n  background-image: \n    radial-gradient(at 0% 0%, #fee2e2 0px, transparent 50%),\n    radial-gradient(at 100% 100%, #e0e7ff 0px, transparent 50%);\n  background-attachment: fixed;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  min-height: 100vh;\n  margin: 0;\n  padding: 20px;\n  box-sizing: border-box;\n}\n\n.container {\n  background: #ffffff;\n  width: 100%;\n  max-width: 420px;\n  padding: 32px;\n  border-radius: 24px;\n  /* Bold, crisp shadows and borders for that modern pop look */\n  border: 3px solid #1e1b4b;\n  box-shadow: 8px 8px 0px 0px #1e1b4b;\n}\n\n/* Header Section */\n#header-section {\n  margin-bottom: 24px;\n}\n\n#title-section {\n  font-size: 2.25rem;\n  font-weight: 800;\n  letter-spacing: -1px;\n  color: #1e1b4b; /* Ultra-deep indigo for crisp contrast */\n  margin: 0 0 4px 0;\n}\n\n#date-section {\n  color: #4f46e5; /* Electric Indigo */\n  font-size: 0.95rem;\n  font-weight: 700;\n  margin: 0;\n  text-transform: uppercase;\n  letter-spacing: 0.5px;\n}\n\n/* Controls & Status */\n.controls {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  margin-bottom: 24px;\n}\n\n#status {\n  background: #f1f5f9;\n  border: 2px solid #1e1b4b;\n  color: #0f172a;\n  padding: 12px 16px;\n  border-radius: 12px;\n  font-weight: 700;\n  font-size: 0.9rem;\n}\n\n/* Cyber-Lime High Contrast Button */\nbutton {\n  background: #ccff00; /* Ultra-bright neon lime */\n  color: #1e1b4b;\n  border: 2px solid #1e1b4b;\n  padding: 16px;\n  width: 100%;\n  border-radius: 14px;\n  font-size: 1rem;\n  font-weight: 800;\n  cursor: pointer;\n  letter-spacing: 0.5px;\n  transition: all 0.15s ease;\n  box-shadow: 4px 4px 0px 0px #1e1b4b;\n}\n\nbutton:hover {\n  transform: translate(-2px, -2px);\n  box-shadow: 6px 6px 0px 0px #1e1b4b;\n  background: #d8ff33;\n}\n\nbutton:active {\n  transform: translate(2px, 2px);\n  box-shadow: 2px 2px 0px 0px #1e1b4b;\n}\n\n/* Results Section */\n#results {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  max-height: 300px;\n  overflow-y: auto;\n  padding-right: 4px;\n}\n\n/* Custom Scrollbar */\n#results::-webkit-scrollbar {\n  width: 8px;\n}\n#results::-webkit-scrollbar-thumb {\n  background: #cbd5e1;\n  border-radius: 10px;\n  border: 2px solid #ffffff;\n}\n\n/* Visual Cues for Data Cards */\n.result-card {\n  padding: 16px;\n  border-radius: 14px;\n  background: #ffffff;\n  border: 2px solid #1e1b4b;\n  color: #1e1b4b;\n  font-weight: 700;\n  transition: transform 0.15s ease;\n}\n\n.result-card:hover {\n  transform: scale(1.02);\n}\n\n/* Bright, clear indicators that pass contrast checks easily */\n.live-data { \n  background: #ecfdf5; /* Soft emerald tint */\n  border-left: 8px solid #059669; /* Bold emerald border */\n} \n\n.backup-data { \n  background: #fffbeb; /* Soft amber tint */\n  border-left: 8px solid #d97706; /* Bold amber border */\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const apiEndpoint = \"https://restcountries.com/v3.1/all?fields=name,population\";\nconst outputElement = document.getElementById(\"results\");\nconst statusElement = document.getElementById(\"status\");\nconst headerElement = document.getElementById(\"header-section\");\nconst title = document.getElementById(\"title-section\");\nconst date = document.getElementById(\"date-section\");\n\n// --- TASK 1: STATIC CONSTANTS ---\n// A Data Engineer always sets up the app shell first.\n// This data loads instantly — no internet needed.\n// Code below defines the app's structure and renders it instantly.\n\n\n\n// --- TASK 2: BACKUP DATA ---\n// A Data Engineer always has a safety net.\n// This local data keeps the app running if the live source fails.\n// Code below stores local data that matches the API structure.\n\n\n\n// --- TASK 3: CONNECT TO LIVE DATA ---\n// A Data Engineer always plans for failure.\n// Try to fetch live data first — fall back to local data if it fails.\n// Code below fetches live country data and handles failure gracefully.",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "3"
      ]
    },
