<Weblab2>
  <config><![CDATA[{
  "published": true,
  "game_id": 74,
  "created_at": "2026-11-03T04:25:30.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": "true",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Prompt dial: save the park</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"widget\" id=\"widget\">\n    <div class=\"error-banner\" id=\"error\" role=\"alert\" hidden></div>\n    <h1 class=\"visually-hidden\" data-text=\"intro.title\"></h1>\n\n    <header class=\"intro\" id=\"header\">\n      <div class=\"intro-line\" id=\"practiceLine\">\n        <span class=\"tag\" data-text=\"intro.tag\"></span>\n      </div>\n      <p class=\"do-this\" id=\"doThis\"><strong data-text=\"intro.doThis\"></strong> <span data-text=\"intro.doThisText\"></span></p>\n    </header>\n\n    <section class=\"intro-screen\" id=\"introScreen\" hidden>\n      <span class=\"tag\" data-text=\"intro.tag\"></span>\n      <h2 class=\"intro-title\" data-text=\"intro.heading\"></h2>\n      <p class=\"intro-lead\" data-text=\"intro.lead\"></p>\n      <ol class=\"intro-steps\">\n        <li data-text=\"intro.steps.0\"></li>\n        <li data-text=\"intro.steps.1\"></li>\n        <li data-text=\"intro.steps.2\"></li>\n      </ol>\n      <button type=\"button\" class=\"btn btn-primary\" id=\"startButton\" data-text=\"intro.start\"></button>\n    </section>\n\n    <div class=\"workspace\" id=\"workspace\" data-mode=\"demo\">\n      <section class=\"col\">\n        <div class=\"card prompt-card\">\n          <span class=\"overline\" data-text=\"prompt.label\"></span>\n          <div class=\"prompt-box\">\n            <p class=\"prompt-text\" id=\"promptText\"></p>\n            <p class=\"prompt-ghost\" id=\"promptGhost\" aria-hidden=\"true\"></p>\n          </div>\n        </div>\n\n        <div class=\"switches\" id=\"switches\" hidden></div>\n\n        <div class=\"demo-panel\" id=\"demoPanel\">\n          <p class=\"demo-step\" id=\"demoStep\"></p>\n          <h2 class=\"demo-title\" id=\"demoTitle\" hidden></h2>\n          <p class=\"demo-text\" id=\"demoText\"></p>\n          <div class=\"demo-actions\">\n            <button type=\"button\" class=\"btn btn-outline\" id=\"demoNext\" data-text=\"demo.next\"></button>\n          </div>\n        </div>\n      </section>\n\n      <div class=\"gutter\" id=\"sparkHolder\"></div>\n\n      <section class=\"col\">\n        <div class=\"page-area\" id=\"pageArea\"></div>\n        <div class=\"note\" id=\"note\"></div>\n        <div class=\"finish-row\"><button type=\"button\" class=\"btn btn-primary\" id=\"finishButton\" data-text=\"finish.label\" hidden></button></div>\n      </section>\n    </div>\n\n\n    <div class=\"visually-hidden\" id=\"announcer\" aria-live=\"polite\" aria-atomic=\"true\"></div>\n\n    <section class=\"takeaway-page\" id=\"takeaway\" aria-labelledby=\"takeaway-title\" tabindex=\"-1\" hidden>\n      <h2 class=\"intro-title\" id=\"takeaway-title\" data-text=\"takeaway.title\"></h2>\n      <p class=\"intro-lead\" data-text=\"takeaway.text\"></p>\n      <ul class=\"takeaway-labels\" id=\"takeawayLabels\"></ul>\n      <p class=\"takeaway-last\"><strong data-text=\"takeaway.last\"></strong></p>\n    </section>\n  </main>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "'use strict';\n\n/* ------------------------------------------------------------------\n   Prompt dial\n   One engine, four swappable directions. Each direction supplies its\n   details, its sample page and its words (see DIRECTIONS below).\n   ------------------------------------------------------------------ */\n\nconst CONFIG = {\n  // The sample page this widget shows.\n  direction: 'story',\n  // One-line intro page with a Start button. Address override: ?intro=0\n  showIntro: true,\n  // Short opening demo. Address override: ?demo=0\n  showDemo: true,\n  flashMilliseconds: 1000,\n  completeEventName: 'widget:complete',\n  completeMessageType: 'widget-complete'\n};\n\n/* ---------- Words that are not part of a direction ---------- */\n\nconst T = {\n  intro: {\n    tag: 'Practice',\n    doThis: 'Do This:',\n    doThisText: 'Build a sample prompt step by step. Notice how each additional detail in the prompt improves the output.',\n    title: 'Prompt dial',\n    heading: 'Add details to a prompt',\n    lead: 'You will do this whenever you ask AI to build part of your project.',\n    steps: ['Watch a short demo, step by step.', 'Pick a choice in each row.', 'Change one thing and keep the rest.'],\n    start: 'Start',\n  },\n  prompt: {\n    label: 'Prompt',\n    base: 'Make a site.'\n  },\n  demo: {\n    vague: 'A prompt is your order to the AI. A vague order gets a plain page.',\n    first: (label) => `A specific order gets the page you pictured. Start with ${label}.`,\n    later: (label) => `Next, add ${label}.`,\n    endTitle: 'Every detail helped.',\n    endText: 'Each detail gave the AI more to work with, so the page came out closer to what you pictured.',\n    next: 'Next',\n    start: 'Try it',\n    stepOf: (n, total) => `Step ${n} of ${total}`,\n    ready: 'Your turn. Pick a choice in each row.'\n  },\n  status: {\n    keptRest: 'Changed one thing. The rest stayed the same.',\n    allIn: 'All four details are in. Try changing just one.'\n  },\n  announce: {\n    add: (label, option, note) => `${label}: ${option}. ${note}`,\n    swap: (label, option, note) => `${label} changed to ${option}. ${note} The rest stayed the same.`,\n    remove: (label, note) => `${label} removed. ${note}`\n  },\n  aria: {\n    site: 'Sample page',\n    spark: 'The AI is working'\n  },\n  finish: { label: 'Finish' },\n  takeaway: {\n    title: 'Takeaway: Details in your prompt shape what the AI builds.',\n    text: 'The AI can only build what your prompt says. Each detail you add gives it more to work with, so the page matches your idea.',\n    last: 'Press Continue to go to your project.'\n  },\n  error: 'Something went wrong while loading this activity. Try reloading the page.'\n};\n\n/* ---------- Icons (inline SVG, drawn with strokes) ---------- */\n\nconst ICONS = {\n  people: [\n    ['circle', { cx: 9, cy: 8, r: 3 }],\n    ['path', { d: 'M3 19c0-3.3 2.7-6 6-6s6 2.7 6 6' }],\n    ['circle', { cx: 17, cy: 9, r: 2.5 }],\n    ['path', { d: 'M16 13.2c2.8.2 5 2.4 5 5.3' }]\n  ],\n  palette: [\n    ['path', { d: 'M12 3a9 9 0 1 0 0 18c1.2 0 2-.8 2-1.8 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-1 .8-1.8 1.8-1.8H17a4 4 0 0 0 4-4c0-4.4-4-8-9-8z' }],\n    ['circle', { cx: 7.5, cy: 11, r: 1 }],\n    ['circle', { cx: 10, cy: 7, r: 1 }],\n    ['circle', { cx: 15, cy: 7, r: 1 }]\n  ],\n  bubble: [['path', { d: 'M4 5h16v11H9l-5 4z' }]],\n  button: [\n    ['rect', { x: 3, y: 8, width: 18, height: 8, rx: 4 }],\n    ['path', { d: 'M9 12h6' }]\n  ],\n  check: [['path', { d: 'M5 12.5l4.5 4.5L19 7.5' }]]\n};\n\n/* ---------- Direction content ---------- */\n\n/*\n  Every direction has four details. Each detail has two options.\n  Option 1 is the phrase from the content table. Option 2 gives students\n  a second choice, so they can swap one detail and keep the rest.\n\n  sentence  Whole sentence that joins the prompt. {phrase} marks the\n            highlighted words.\n  swap      Sentence added to the prompt when a student swaps one option.\n  notes     One short takeaway for each state: [nothing, option 1, option 2].\n  slots     Text on the sample page that depends on a detail. State 0 is\n            the gray placeholder (or flat words when flat is true).\n*/\n\nconst DIRECTIONS = {\n  story: {\n    name: 'Story and message: save the park',\n    globalDetail: 'tone',\n    details: [\n      {\n        id: 'who', icon: 'people', label: 'Who it is for',\n        sentence: 'It is a save-the-park page for {phrase}.',\n        swap: 'Change only who it is for. Keep the rest the same.',\n        options: [\n          { label: 'Neighbors', phrase: 'neighbors' },\n          { label: 'City council', phrase: 'the city council' }\n        ],\n        notes: ['No reader named, so no opening line.', 'It speaks to neighbors.', 'It speaks to the city council.']\n      },\n      {\n        id: 'tone', icon: 'palette', label: 'Tone',\n        sentence: 'The tone is {phrase}.',\n        swap: 'Change only the tone. Keep the rest the same.',\n        options: [\n          { label: 'Hopeful, warm', phrase: 'hopeful and warm' },\n          { label: 'Serious, urgent', phrase: 'serious and urgent' }\n        ],\n        notes: ['No tone, so the words stay flat.', 'Hopeful and warm.', 'Serious and urgent.']\n      },\n      {\n        id: 'message', icon: 'bubble', label: 'Message',\n        sentence: 'The message is “{phrase}”',\n        swap: 'Change only the message. Keep the rest the same.',\n        options: [\n          { label: 'Help save it', phrase: 'Help save Maple Park.' },\n          { label: 'Belongs to all', phrase: 'Maple Park belongs to everyone.' }\n        ],\n        notes: ['No message, so the headline is generic.', 'A clear call to help.', 'A message about belonging.']\n      },\n      {\n        id: 'ask', icon: 'button', label: 'The ask',\n        sentence: 'The ask is “{phrase}”',\n        swap: 'Change only the ask. Keep the rest the same.',\n        options: [\n          { label: 'Sign petition', phrase: 'Sign the petition.' },\n          { label: 'Join cleanup', phrase: 'Come to the cleanup.' }\n        ],\n        notes: ['No ask, so the button says Click here.', 'The button asks for a signature.', 'The button asks people to show up.']\n      }\n    ],\n    slots: {\n      eyebrow: { detail: 'who', text: ['Short line', 'For Maple Park neighbors', 'For the city council'] },\n      headline: { detail: 'message', flat: true, text: ['About the park', 'Help save Maple Park', 'Maple Park belongs to everyone'] },\n      body: { detail: 'tone', flat: true, text: ['There is a park. It has trees and a path.', 'Picnics, games, and sunsets all happen here. Keep them going.', 'The park may close this spring. Time is running out.'] },\n      button: { detail: 'ask', flat: true, text: ['Click here', 'Sign the petition', 'Come to the cleanup'] }\n    },\n    url: 'saveparks.web'\n  },\n\n};\n\n/* ---------- Small helpers ---------- */\n\nconst SVG_NS = 'http://www.w3.org/2000/svg';\n\nfunction h(tag, props, ...kids) {\n  const el = document.createElement(tag);\n  if (props) {\n    for (const [key, value] of Object.entries(props)) {\n      if (value === false || value === null || value === undefined) continue;\n      if (key === 'class') el.className = value;\n      else if (key === 'text') el.textContent = value;\n      else el.setAttribute(key, value === true ? '' : value);\n    }\n  }\n  for (const kid of kids) if (kid) el.append(kid);\n  return el;\n}\n\nfunction s(tag, attrs, ...kids) {\n  const el = document.createElementNS(SVG_NS, tag);\n  if (attrs) for (const [key, value] of Object.entries(attrs)) el.setAttribute(key, String(value));\n  for (const kid of kids) if (kid) el.append(kid);\n  return el;\n}\n\nfunction icon(name, extraClass) {\n  const svg = s('svg', {\n    viewBox: '0 0 24 24',\n    class: extraClass ? `icon ${extraClass}` : 'icon',\n    'aria-hidden': 'true',\n    focusable: 'false'\n  });\n  for (const [tag, attrs] of ICONS[name]) svg.append(s(tag, attrs));\n  return svg;\n}\n\nfunction prefersReducedMotion() {\n  return Boolean(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);\n}\n\nfunction readParams() {\n  try {\n    const params = new URLSearchParams(window.location.search);\n    return { demo: params.get('demo'), intro: params.get('intro') };\n  } catch (err) {\n    return { demo: null, intro: null };\n  }\n}\n\n/* ---------- State ---------- */\n\nconst els = {};\nconst state = {\n  dirId: null,\n  dir: null,\n  values: {},\n  mode: 'play',\n  swapId: null\n};\nlet demoStep = 0;\nlet timers = [];\nlet site = null;\n\nfunction later(fn, ms) {\n  timers.push(window.setTimeout(fn, ms));\n}\n\nfunction clearTimers() {\n  timers.forEach((id) => window.clearTimeout(id));\n  timers = [];\n}\n\nfunction detailIndex(id) {\n  return state.dir.details.findIndex((d) => d.id === id);\n}\n\nfunction resetValues() {\n  state.values = {};\n  state.dir.details.forEach((d) => { state.values[d.id] = 0; });\n  state.swapId = null;\n}\n\nfunction allChosen() {\n  return state.dir.details.every((d) => state.values[d.id] > 0);\n}\n\n/* ---------- Sample page builders ---------- */\n\nfunction slotEl(name, tag, extraClass) {\n  const def = state.dir.slots[name];\n  const classes = ['slot'];\n  if (extraClass) classes.push(extraClass);\n  if (def.flat) classes.push('is-flat');\n  return h(tag, { class: classes.join(' '), 'data-slot': name });\n}\n\nfunction bar(text) {\n  return h('p', { class: 'bar', 'aria-hidden': 'true', text });\n}\n\nfunction siteFrame(dir) {\n  const root = h('div', { class: 'site', role: 'group', 'aria-label': T.aria.site, 'data-dir': state.dirId });\n  if (dir.globalDetail) root.classList.add(`r-${dir.globalDetail}`);\n  const topBar = h('div', { class: 'site-bar', 'aria-hidden': 'true' },\n    h('span', { class: 'site-dot' }), h('span', { class: 'site-dot' }), h('span', { class: 'site-dot' }),\n    h('span', { class: 'site-url', text: dir.url }));\n  root.append(topBar);\n  return root;\n}\n\nconst BUILDERS = {\n  story(dir, root) {\n    root.append(h('div', { class: 'site-main story-main' },\n      h('div', { class: 'scene r-tone', 'aria-hidden': 'true' }),\n      slotEl('eyebrow', 'p', 'site-eyebrow r-who'),\n      slotEl('headline', 'p', 'site-headline r-message'),\n      slotEl('body', 'p', 'site-body r-tone'),\n      slotEl('button', 'div', 'site-btn r-ask')));\n  },\n\n};\n\n/* ---------- Sample page rendering ---------- */\n\nfunction applySlots() {\n  const slots = state.dir.slots;\n  site.querySelectorAll('.slot').forEach((el, index) => {\n    const def = slots[el.getAttribute('data-slot')];\n    const value = state.values[def.detail];\n    const text = def.text[value];\n    if (el.textContent !== text) el.textContent = text;\n    const isBar = value === 0 && !def.flat;\n    el.classList.toggle('is-bar', isBar);\n    el.toggleAttribute('aria-hidden', isBar);\n    el.style.setProperty('--i', String(index));\n  });\n}\n\nconst RENDERERS = {\n  story() {},\n};\n\nfunction renderPage(prev, animate) {\n  const dir = state.dir;\n  dir.details.forEach((d) => site.setAttribute(`data-${d.id}`, String(state.values[d.id])));\n  applySlots();\n  RENDERERS[state.dirId](prev, animate);\n}\n\n/* ---------- Prompt, switches and notes ---------- */\n\nfunction sentenceEl(template, phrase, index) {\n  const [before, after] = template.split('{phrase}');\n  const words = phrase.split(' ');\n  const first = words.shift();\n  const phraseEl = h('span', { class: `phrase is-d${index + 1}` },\n    h('span', { class: 'nowrap' }, icon(state.dir.details[index].icon), first));\n  if (words.length) phraseEl.append(` ${words.join(' ')}`);\n  const sentence = h('span', { class: 'sent' });\n  sentence.append(before, phraseEl, after);\n  return sentence;\n}\n\nfunction renderPrompt(info) {\n  const box = els.promptText;\n  box.textContent = '';\n  box.append(h('span', { class: 'sent', text: T.prompt.base }));\n  state.dir.details.forEach((d, i) => {\n    const value = state.values[d.id];\n    if (!value) return;\n    const sentence = sentenceEl(d.sentence, d.options[value - 1].phrase, i);\n    if (info && info.id === d.id && info.move !== 'remove') sentence.classList.add('is-new');\n    box.append(' ', sentence);\n  });\n  if (state.swapId) {\n    box.append(' ', h('span', { class: `sent keep is-new is-d${detailIndex(state.swapId) + 1}`, text: state.dir.details[detailIndex(state.swapId)].swap }));\n  }\n}\n\nfunction buildGhost() {\n  const ghost = els.promptGhost;\n  ghost.textContent = '';\n  ghost.append(h('span', { class: 'sent', text: T.prompt.base }));\n  let longestSwap = 0;\n  state.dir.details.forEach((d, i) => {\n    let longest = 0;\n    d.options.forEach((o, k) => { if (o.phrase.length > d.options[longest].phrase.length) longest = k; });\n    ghost.append(' ', sentenceEl(d.sentence, d.options[longest].phrase, i));\n    if (d.swap.length > state.dir.details[longestSwap].swap.length) longestSwap = i;\n  });\n  const swapDetail = state.dir.details[longestSwap];\n  ghost.append(' ', h('span', { class: `sent keep is-d${longestSwap + 1}`, text: swapDetail.swap }));\n}\n\nfunction buildSwitches() {\n  els.switches.textContent = '';\n  state.dir.details.forEach((d, i) => {\n    const row = h('fieldset', { class: `row is-d${i + 1}`, 'data-detail': d.id });\n    row.append(h('legend', null, icon(d.icon), h('span', { text: d.label })));\n    const opts = h('div', { class: 'opts' });\n    d.options.forEach((o, k) => {\n      opts.append(h('button', { type: 'button', class: 'opt', 'aria-pressed': 'false', 'data-option': String(k + 1) },\n        icon('check', 'check'), h('span', { text: o.label })));\n    });\n    row.append(opts);\n    els.switches.append(row);\n  });\n}\n\nfunction renderSwitches() {\n  els.switches.querySelectorAll('.row').forEach((row) => {\n    const value = state.values[row.getAttribute('data-detail')];\n    row.querySelectorAll('.opt').forEach((btn) => {\n      btn.setAttribute('aria-pressed', String(Number(btn.getAttribute('data-option')) === value));\n    });\n  });\n}\n\nfunction renderNote(info) {\n  const note = els.note;\n  note.textContent = '';\n  if (!info) return;\n  const index = detailIndex(info.id);\n  const d = state.dir.details[index];\n  const line = h('p', { class: `note-main is-d${index + 1}` }, icon(d.icon),\n    h('span', null, h('strong', { text: `${d.label}: ` }), d.notes[state.values[d.id]]));\n  note.append(line);\n  if (info.move === 'swap') note.append(h('p', { class: 'note-status', text: T.status.keptRest }));\n  else if (state.mode === 'play' && allChosen()) note.append(h('p', { class: 'note-status', text: T.status.allIn }));\n}\n\n/* ---------- Feedback: flash, pulse, announcer ---------- */\n\nfunction flashRegion(id) {\n  const index = detailIndex(id) + 1;\n  const nodes = els.pageArea.querySelectorAll(`.r-${id}`);\n  nodes.forEach((node) => {\n    node.setAttribute('data-flash', String(index));\n    node.classList.remove('flash');\n    void node.offsetWidth;\n    node.classList.add('flash');\n  });\n  window.setTimeout(() => nodes.forEach((node) => node.classList.remove('flash')), CONFIG.flashMilliseconds);\n}\n\nfunction pulse() {\n  [els.spark].forEach((el) => {\n    if (!el) return;\n    el.classList.remove('is-pulsing');\n    void el.getBoundingClientRect();\n    el.classList.add('is-pulsing');\n  });\n}\n\nfunction announce(text) {\n  els.announcer.textContent = '';\n  window.setTimeout(() => { els.announcer.textContent = text; }, 30);\n}\n\n/* ---------- One move ---------- */\n\nfunction renderAll(prev, info) {\n  renderPrompt(info);\n  renderSwitches();\n  renderPage(prev, Boolean(info));\n  renderNote(info);\n  renderFinish();\n}\n\nfunction applyMove(id, next, options) {\n  const quiet = Boolean(options && options.quiet);\n  const prev = Object.assign({}, state.values);\n  const before = prev[id];\n  state.values[id] = next;\n  const move = next === 0 ? 'remove' : (before === 0 ? 'add' : 'swap');\n  state.swapId = move === 'swap' ? id : null;\n  const info = { id, move };\n  renderAll(prev, info);\n  flashRegion(id);\n  pulse();\n  const d = state.dir.details[detailIndex(id)];\n  if (!quiet) {\n    const note = d.notes[next];\n    if (move === 'add') announce(T.announce.add(d.label, d.options[next - 1].label, note));\n    else if (move === 'swap') announce(T.announce.swap(d.label, d.options[next - 1].label, note));\n    else announce(T.announce.remove(d.label, note));\n  }\n}\n\nfunction choose(id, option) {\n  applyMove(id, state.values[id] === option ? 0 : option);\n}\n\nlet completionReported = false;\n\nfunction reportComplete() {\n  if (completionReported) return;\n  completionReported = true;\n  try {\n    window.dispatchEvent(new CustomEvent(CONFIG.completeEventName));\n  } catch (err) { /* no listener needed */ }\n  try {\n    if (window.parent && window.parent !== window) {\n      window.parent.postMessage({ type: CONFIG.completeMessageType }, '*');\n    }\n  } catch (err) { /* sandbox may block it */ }\n}\n\nfunction renderFinish() {\n  els.finishButton.hidden = state.mode !== 'play' || !allChosen();\n}\n\nfunction finish() {\n  reportComplete();\n  buildTakeawayLabels();\n  setStage('done');\n  els.takeaway.focus();\n}\n\nfunction buildTakeawayLabels() {\n  els.takeawayLabels.textContent = '';\n  state.dir.details.forEach((d, i) => {\n    els.takeawayLabels.append(h('li', { class: `takeaway-label is-d${i + 1}` }, icon(d.icon), h('span', { text: d.label })));\n  });\n}\n\n/* ---------- Direction setup ---------- */\n\nfunction buildDirection(id) {\n  clearTimers();\n  state.dirId = id;\n  state.dir = DIRECTIONS[id];\n  resetValues();\n  els.pageArea.textContent = '';\n  site = siteFrame(state.dir);\n  BUILDERS[id](state.dir, site);\n  els.pageArea.append(site);\n  buildSwitches();\n  buildGhost();\n  renderAll(null, null);\n}\n\n/* ---------- Demo ---------- */\n\nfunction setMode(mode) {\n  state.mode = mode;\n  els.workspace.setAttribute('data-mode', mode);\n  els.switches.hidden = mode !== 'play';\n  els.demoPanel.hidden = mode !== 'demo';\n  renderFinish();\n}\n\nfunction setCaption(title, text, stepText) {\n  els.demoStep.textContent = stepText;\n  els.demoTitle.textContent = title;\n  els.demoTitle.hidden = !title;\n  els.demoText.textContent = text;\n}\n\nfunction setAllChosen() {\n  state.dir.details.forEach((d) => { state.values[d.id] = 1; });\n  state.swapId = null;\n  renderAll(null, null);\n}\n\nfunction showStep(n) {\n  clearTimers();\n  demoStep = n;\n  const details = state.dir.details;\n  const total = details.length + 2;\n  const last = n === total;\n  const stepText = T.demo.stepOf(n, total);\n  els.demoNext.textContent = last ? T.demo.start : T.demo.next;\n  els.demoNext.classList.toggle('btn-primary', last);\n  els.demoNext.classList.toggle('btn-outline', !last);\n  if (n === 1) {\n    resetValues();\n    renderAll(null, null);\n    setCaption('', T.demo.vague, stepText);\n    announce(T.demo.vague);\n    pulse();\n  } else if (!last) {\n    const index = n - 2;\n    details.forEach((d, i) => { if (i < index) state.values[d.id] = 1; });\n    const label = details[index].label.toLowerCase();\n    const caption = index === 0 ? T.demo.first(label) : T.demo.later(label);\n    setCaption('', caption, stepText);\n    announce(caption);\n    applyMove(details[index].id, 1, { quiet: true });\n  } else {\n    setAllChosen();\n    setCaption(T.demo.endTitle, T.demo.endText, stepText);\n    announce(`${T.demo.endTitle} ${T.demo.endText}`);\n    pulse();\n  }\n}\n\nfunction startDemo() {\n  setMode('demo');\n  showStep(1);\n}\n\nfunction startPlay(shouldFocus) {\n  clearTimers();\n  demoStep = 0;\n  resetValues();\n  renderAll(null, null);\n  setMode('play');\n  if (shouldFocus) {\n    announce(T.demo.ready);\n    const first = els.switches.querySelector('.opt');\n    if (first) first.focus();\n  }\n}\n\n/* ---------- Intro page ---------- */\n\nfunction setStage(stage) {\n  const intro = stage === 'intro';\n  const done = stage === 'done';\n  els.header.hidden = done;\n  els.introScreen.hidden = !intro;\n  els.practiceLine.hidden = intro;\n  els.doThis.hidden = intro;\n  els.workspace.hidden = intro || done;\n  els.takeaway.hidden = !done;\n}\n\nfunction leaveIntro() {\n  setStage('active');\n}\n\n/* ---------- Page setup ---------- */\n\nfunction buildSpark() {\n  const svg = s('svg', { viewBox: '0 0 24 24', class: 'spark', role: 'img', 'aria-label': T.aria.spark });\n  svg.append(s('path', { d: 'M12 2l2.6 7.4L22 12l-7.4 2.6L12 22l-2.6-7.4L2 12l7.4-2.6z' }));\n  return svg;\n}\n\nfunction fillText() {\n  document.querySelectorAll('[data-text]').forEach((el) => {\n    const value = el.getAttribute('data-text').split('.').reduce((obj, key) => obj[key], T);\n    el.textContent = value;\n  });\n}\n\nfunction showError() {\n  const box = els.error || document.getElementById('error');\n  if (!box) return;\n  box.textContent = T.error;\n  box.hidden = false;\n}\n\nfunction init() {\n  ['widget', 'workspace', 'pageArea', 'promptText', 'promptGhost', 'switches', 'note', 'announcer',\n    'demoPanel', 'demoStep', 'demoTitle', 'demoText', 'demoNext',  'header', 'introScreen', 'startButton', 'finishButton', 'takeaway', 'takeawayLabels', 'practiceLine', 'doThis', 'sparkHolder', 'error'].forEach((id) => {\n    els[id] = document.getElementById(id);\n  });\n  fillText();\n\n  els.spark = buildSpark();\n  els.sparkHolder.append(els.spark);\n\n\n  const params = readParams();\n  buildDirection(CONFIG.direction);\n\n  els.switches.addEventListener('click', (event) => {\n    const button = event.target.closest('.opt');\n    if (!button) return;\n    choose(button.closest('.row').getAttribute('data-detail'), Number(button.getAttribute('data-option')));\n  });\n  els.demoNext.addEventListener('click', () => {\n    if (demoStep === state.dir.details.length + 2) startPlay(true);\n    else showStep(demoStep + 1);\n  });\n\n  els.finishButton.addEventListener('click', finish);\n  els.startButton.addEventListener('click', () => {\n    leaveIntro();\n    if (CONFIG.showDemo && params.demo !== '0') startDemo();\n    else startPlay(true);\n  });\n\n  if (CONFIG.showIntro && params.intro !== '0') {\n    setStage('intro');\n    startPlay(false);\n  } else if (CONFIG.showDemo && params.demo !== '0') {\n    startDemo();\n  } else {\n    startPlay(false);\n  }\n}\n\nwindow.addEventListener('error', showError);\n\ntry {\n  init();\n} catch (err) {\n  showError();\n}\n",
