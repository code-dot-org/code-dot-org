<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-11-03T04:25:30.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": true,
    "start_sources": {
      "folders": {
      },
      "files": {
        "395c29a5-4005-4125-96ba-24df401a133a": {
          "id": "395c29a5-4005-4125-96ba-24df401a133a",
          "name": "index.html",
          "contents": "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"><title>Save The Park Tone Widget</title><link rel=\"stylesheet\" href=\"style.css\"></head><body><h1>Sample Save-The-Park Page</h1><div id=\"promptDisplay\">Current Prompt: <span id=\"currentPrompt\">A page about saving a park.</span></div><div class=\"controls\"><button id=\"toggleDetail1\">Add Detail: Urgent Tone</button><button id=\"toggleDetail2\">Add Detail: Inspiring Tone</button><button id=\"toggleDetail3\">Add Detail: Friendly Tone</button></div><div id=\"samplePageContent\"><h2>Our Local Park Needs You!</h2><p>The park is a place for everyone. It has trees and open spaces. We need to keep it nice for the future. Please help us to do this.</p></div><script src=\"script.js\"></script></body></html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "0b925178-2035-4b94-909d-516ffdd42dd9": {
          "id": "0b925178-2035-4b94-909d-516ffdd42dd9",
          "name": "style.css",
          "contents": "body {font-family: Arial, sans-serif;display: flex;flex-direction: column;align-items: center;padding: 20px;background-color: #f0f0f0;color: #333;}h1 {color: #333;margin-bottom: 10px;}#promptDisplay {margin: 20px 0;font-size: 1.1em;color: #555;}#currentPrompt {font-weight: bold;}.controls {margin-bottom: 20px;}button {padding: 10px 15px;margin: 0 5px;border: none;background-color: #007bff;color: white;border-radius: 5px;cursor: pointer;transition: background-color 0.3s ease;}button:hover {background-color: #0056b3;}#samplePageContent {width: 90%;max-width: 800px;min-height: 200px;border: 2px dashed #ccc;padding: 20px;background-color: #ffffff;color: #444;text-align: center;transition: all 0.5s ease-in-out;border-radius: 8px;}#samplePageContent h2 {color: #555;margin-top: 0;}#samplePageContent p {font-size: 1.1em;line-height: 1.5;}/* Tone-specific styles */#samplePageContent.urgent {background-color: #fff3cd;border-color: #ffc107;color: #856404;}#samplePageContent.urgent h2 {color: #dc3545;}#samplePageContent.inspiring {background-color: #d4edda;border-color: #28a745;color: #155724;}#samplePageContent.inspiring h2 {color: #28a745;}#samplePageContent.friendly {background-color: #e2f0fe;border-color: #007bff;color: #004085;}#samplePageContent.friendly h2 {color: #007bff;}",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "1dad6eaf-f01f-40f0-ab4c-6307a86a24b8": {
          "id": "1dad6eaf-f01f-40f0-ab4c-6307a86a24b8",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {const currentPromptSpan = document.getElementById('currentPrompt');const samplePageContent = document.getElementById('samplePageContent');const toggleDetail1Btn = document.getElementById('toggleDetail1');const toggleDetail2Btn = document.getElementById('toggleDetail2');const toggleDetail3Btn = document.getElementById('toggleDetail3');let activeDetails = new Set();const updatePageContent = () => {let promptText = 'A page about saving a park.';let contentHTML = `<h2>Our Local Park Needs You!</h2><p>The park is a place for everyone. It has trees and open spaces. We need to keep it nice for the future. Please help us to do this.</p>`;samplePageContent.className = '';if (activeDetails.has('urgent')) {samplePageContent.classList.add('urgent');promptText += ' With an urgent call to action.';contentHTML = `<h2>URGENT: Our Park is in Peril!</h2><p>Time is running out to save our beloved community park. Without immediate action, we risk losing this vital green space forever. Act NOW!</p>`;}if (activeDetails.has('inspiring')) {samplePageContent.classList.add('inspiring');promptText += ' With an inspiring, hopeful message.';contentHTML = `<h2>Imagine a Thriving Park for Generations!</h2><p>Together, we can transform our local park into a vibrant sanctuary where nature flourishes and communities connect. Your contribution builds a lasting legacy!</p>`;}if (activeDetails.has('friendly')) {samplePageContent.classList.add('friendly');promptText += ' With a friendly, welcoming tone.';contentHTML = `<h2>Hi Friend, Let's Save Our Park!</h2><p>Our park is super special to all of us, right? Let's team up to keep it beautiful and fun for everyone. Every little bit of help makes a big difference!</p>`;}currentPromptSpan.textContent = promptText;samplePageContent.innerHTML = contentHTML;};const toggleDetail = (detailName) => {if (activeDetails.has(detailName)) {activeDetails.delete(detailName);} else {activeDetails.clear(); // Only one tone at a time for this demoactiveDetails.add(detailName);}updatePageContent();};toggleDetail1Btn.addEventListener('click', () => toggleDetail('urgent'));toggleDetail2Btn.addEventListener('click', () => toggleDetail('inspiring'));toggleDetail3Btn.addEventListener('click', () => toggleDetail('friendly'));updatePageContent();console.log(\"Save The Park Tone Widget loaded. Student will observe changes simulated by the widget.\");});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
        "395c29a5-4005-4125-96ba-24df401a133a",
        "0b925178-2035-4b94-909d-516ffdd42dd9",
        "1dad6eaf-f01f-40f0-ab4c-6307a86a24b8"
      ]
    },
    "long_instructions": "TODOs:\r\n- Observe how a vague prompt results in flat words.\r\n- Observe how a specific prompt creates the desired tone.\r\n- Locate the controls for adding specific details to the prompt.\r\n- Flip the switches to see how the sample save-the-park page's text changes.\r\n- Note how more detail in the prompt affects the page's tone.",
