nd-pink-50)}\n\n:root{--font-family-main: \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif; --font-family-heading: \"Space Grotesk\", \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif; --font-family-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace; --font-weight-thin: 100; --font-weight-extra-light: 200; --font-weight-light: 300; --font-weight-regular: 400; --font-weight-medium: 500; --font-weight-semi-bold: 600; --font-weight-bold: 700; --font-weight-extra-bold: 800; --font-weight-black: 900; --font-size-body-xs: .75rem; --font-size-body-sm: .875rem; --font-size-body-md: 1rem; --font-size-body-lg: 1.125rem; }\n\n:root{--text-heading-xxl: 3rem; --text-heading-xl: 2.375rem; --text-heading-lg: 1.75rem; --text-heading-md: 1.5rem; --text-heading-sm: 1.375rem; --text-heading-xs: 1.25rem; --leading-heading-xxl: 3.25rem; --leading-heading-xl: 2.5rem; --leading-heading-lg: 2.25rem; --leading-heading-md: 2rem; --leading-heading-sm: 1.875rem; --leading-heading-xs: 1.75rem; --text-body-lg: 1.125rem; --text-body-md: 1rem; --text-body-sm: .875rem; --text-body-xs: .75rem; --text-body-xxs: .625rem; --leading-body-lg: 1.75rem; --leading-body-md: 1.5rem; --leading-body-sm: 1.375rem; --leading-body-xs: 1.125rem; --leading-body-xxs: 1rem; --tracking-heading-display: -.01em; --tracking-overline: .08em; --tracking-none: 0}\n\n:root{--shape-sm: .375rem; --shape-md: .5rem; --shape-lg: .625rem; --shape-xl: .75rem; --shape-round: 62.4375rem; --spacing-p-xxs: .5rem; --spacing-p-xs: 1rem; --spacing-p-s: 1.5rem; --spacing-p-m: 2rem; --spacing-p-l: 2.5rem; --spacing-p-xl: 3rem; --spacing-p-xxl: 3.5rem; --spacing-p-xxxl: 4rem; --shadow-sm: 0 4px 7px rgb(0 0 0 / 7%), 0 2px 2px rgb(0 0 0 / 7%); --shadow-md: 0 10px 15px -3px rgb(0 0 0 / 10%), 0 4px 6px -4px rgb(0 0 0 / 10%); --shadow-lg: 0 20px 25px -5px rgb(0 0 0 / 10%), 0 8px 10px -6px rgb(0 0 0 / 10%)}\n\n:root{--duration-instant: 0ms; --duration-fast: .1s; --duration-short: .15s; --duration-medium: .2s; --easing-standard: cubic-bezier(.4, 0, .2, 1); --easing-emphasized: cubic-bezier(.2, 0, 0, 1); --easing-out: cubic-bezier(.23, 1, .32, 1); --motion-press-scale: .97; --motion-press-duration: .15s; --motion-press-easing: cubic-bezier(.23, 1, .32, 1); --motion-surface-from-scale: .96; --motion-surface-duration: .2s; --motion-surface-easing: cubic-bezier(.23, 1, .32, 1); --motion-indicator-duration: .2s; --motion-indicator-easing: cubic-bezier(.2, 0, 0, 1); --motion-fade-duration: .1s; --motion-fade-easing: cubic-bezier(.23, 1, .32, 1); --motion-highlight-chase-duration: .1s; --motion-highlight-chase-easing: cubic-bezier(.23, 1, .32, 1); --transition-colors: background-color var(--duration-short) var(--easing-standard), color var(--duration-short) var(--easing-standard), border-color var(--duration-short) var(--easing-standard), box-shadow var(--duration-short) var(--easing-standard), opacity var(--duration-short) var(--easing-standard); --transition-fade: background-color var(--motion-fade-duration) var(--motion-fade-easing), color var(--motion-fade-duration) var(--motion-fade-easing), border-color var(--motion-fade-duration) var(--motion-fade-easing), opacity var(--motion-fade-duration) var(--motion-fade-easing); --transition-press: transform var(--motion-press-duration) var(--motion-press-easing); --transition-surface: opacity var(--motion-surface-duration) var(--motion-surface-easing), transform var(--motion-surface-duration) var(--motion-surface-easing); --transition-indicator: left var(--motion-indicator-duration) var(--motion-indicator-easing), width var(--motion-indicator-duration) var(--motion-indicator-easing), transform var(--motion-indicator-duration) var(--motion-indicator-easing), background-color var(--duration-short) var(--easing-standard); --transition-highlight-chase: top var(--motion-highlight-chase-duration) var(--motion-highlight-chase-easing), height var(--motion-highlight-chase-duration) var(--motion-highlight-chase-easing), opacity var(--motion-highlight-chase-duration) var(--motion-highlight-chase-easing)}\n\n:root{--ring: var(--border-focused-primary); --control-height-large: 48px; --control-height-medium: 40px; --control-height-small: 32px; --control-height-extra-small: 24px; --control-height-l: 48px; --control-height-m: 40px; --control-height-s: 32px; --control-height-xs: 24px; --z-drawer: 1200; --z-modal: 1300; --z-dropdown: 1300; --z-popover: 1300; --z-toast: 1400; --z-tooltip: 1500; --font-fa-free: \"Font Awesome 7 Free\"; --font-fa-pro: \"Font Awesome 7 Pro\"; --font-fa-brands: \"Font Awesome 7 Brands\"; --syntax-attribute: #B34800; --syntax-comment: #69788A; --syntax-keyword: #4C42CF; --syntax-number: #0B43A3; --syntax-property: #B5004F; --syntax-punctuation: #596069; --syntax-selector: #1A7F85; --syntax-string: #1F7028; --syntax-tag: #3228B7; --syntax-value: #1570D1}\n\n/* Code colors (the light values CADS ships for syntax) */\n:root {\n  --syntax-attribute: #B34800;\n  --syntax-comment: #69788A;\n  --syntax-keyword: #4C42CF;\n  --syntax-number: #0B43A3;\n  --syntax-property: #B5004F;\n  --syntax-punctuation: #596069;\n  --syntax-selector: #1A7F85;\n  --syntax-string: #1F7028;\n  --syntax-tag: #3228B7;\n  --syntax-value: #1570D1;\n}\n\n/* ===== end CADS tokens ===== */\n/* ==================================================================\n   Prompt dial component styles\n\n   What is CADS\n   - Every color, type size, radius, spacing step, shadow and motion value\n     below comes from the CADS tokens above. No hard-coded colors.\n   - Selected look for the pressed choice buttons (selected-primary fill,\n     border and text, always as a set).\n   - Focus ring: 2px --ring, never removed.\n   - Overline labels, the Tag look for \"Practice\", the Alert look for the\n     error message and the status line, and the white card with a 1px\n     hairline and --shape-md radius.\n   - Control heights from --control-height-* (40px choice buttons).\n\n   What was rebuilt from the manifest\n   - Choice buttons are rebuilt as plain buttons that follow the Chip rules\n     (pill shape, thick label, selected tokens). The real CADS runtime is\n     not loaded, because Web Lab allows no scripts or fonts from outside.\n   - The primary and outlined Button looks for Try it and Next.\n   - The two options in each row act like a small SegmentedButton, but a\n     tap on the selected option clears it, so it is built as two buttons\n     with aria-pressed.\n\n   What was approximated\n   - Geist and Space Grotesk are named by the tokens but are not loaded.\n     The tokens' own fallback fonts show instead.\n   - Icons are small inline SVGs drawn to match the Font Awesome weight.\n     Font Awesome is not loaded.\n   - The sample page (save-the-park) is\n     an illustration built only from CADS palette tokens. It is not a CADS\n     component.\n   ================================================================== */\n\n*,\n*::before,\n*::after { box-sizing: border-box; }\n\n[hidden] { display: none !important; }\n\nhtml { font-size: 100%; }\n\nbody {\n  margin: 0;\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-md);\n  line-height: var(--leading-body-md);\n  color: var(--text-neutral-primary);\n  background: var(--background-neutral-primary);\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n.nowrap { white-space: nowrap; }\n\n.icon {\n  flex: none;\n  width: 1.125rem;\n  height: 1.125rem;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n/* Detail colors. Each detail keeps one color from prompt to page to note. */\n\n.is-d1,\n[data-flash=\"1\"] { --detail-line: var(--border-brand-primary); --detail-bg: var(--background-brand-light); }\n\n.is-d2,\n[data-flash=\"2\"] { --detail-line: var(--border-accent-orange-strong); --detail-bg: var(--background-accent-orange-light); }\n\n.is-d3,\n[data-flash=\"3\"] { --detail-line: var(--border-accent-pink-primary); --detail-bg: var(--background-accent-pink-light); }\n\n.is-d4,\n[data-flash=\"4\"] { --detail-line: var(--border-info-strong); --detail-bg: var(--background-info-light); }\n\n/* ---------- Intro page ---------- */\n\n.intro-screen,\n.takeaway-page {\n  display: grid;\n  justify-items: start;\n  align-content: start;\n  gap: var(--spacing-p-xs);\n  max-width: 32rem;\n  padding: var(--spacing-p-xs) var(--spacing-p-xxs);\n}\n\n.intro-title {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-md);\n  font-weight: var(--font-weight-bold);\n  line-height: var(--leading-heading-md);\n}\n\n.intro-lead { margin: 0; }\n\n.intro-steps {\n  margin: 0;\n  padding-inline-start: 1.5rem;\n  display: grid;\n  gap: .375rem;\n}\n\n.intro-steps li::marker { font-weight: var(--font-weight-bold); }\n\n.takeaway-labels {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--spacing-p-xxs) var(--spacing-p-xs);\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.takeaway-label {\n  display: flex;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.takeaway-label .icon { color: var(--detail-line); }\n\n.takeaway-last { margin: 0; }\n\n.takeaway-page:focus-visible {\n  outline: 2px solid var(--ring);\n  outline-offset: 2px;\n}\n\n.finish-row { display: flex; }\n\n/* ---------- Layout ---------- */\n\n.widget {\n  max-width: 60rem;\n  margin: 0 auto;\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs) var(--spacing-p-xs);\n}\n\n.error-banner {\n  margin-block-end: var(--spacing-p-xxs);\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  border: 1px solid var(--border-error-mid);\n  border-radius: var(--shape-md);\n  background: var(--background-error-light);\n  color: var(--text-error-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.intro {\n  display: grid;\n  gap: .25rem;\n  margin-block-end: var(--spacing-p-xxs);\n}\n\n.author-row {\n  display: flex;\n  align-items: center;\n  gap: .5rem;\n}\n\n.author-row label {\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.author-row select {\n  min-height: var(--control-height-small);\n  max-width: 100%;\n  padding: 0 .5rem;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-sm);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font: inherit;\n}\n\n.intro-line {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: .5rem;\n}\n\n.tag {\n  display: inline-block;\n  padding: 0 .5rem;\n  border-radius: var(--shape-sm);\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: var(--leading-body-md);\n}\n\n.do-this { margin: 0; color: var(--text-neutral-secondary); }\n\n.do-this strong { color: var(--text-neutral-primary); }\n\n.text-button {\n  min-height: var(--control-height-small);\n  padding: 0 .5rem;\n  border: 0;\n  border-radius: var(--shape-sm);\n  background: transparent;\n  color: var(--text-brand-primary);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  text-decoration: underline;\n  cursor: pointer;\n}\n\n.workspace {\n  display: grid;\n  grid-template-columns: minmax(0, 5fr) 2rem minmax(0, 6fr);\n  align-items: start;\n}\n\n.col {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  min-width: 0;\n}\n\n.gutter {\n  display: flex;\n  justify-content: center;\n  padding-block-start: 3rem;\n}\n\n/* ---------- Prompt card ---------- */\n\n.card {\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  background: var(--background-neutral-primary);\n}\n\n.prompt-card { padding: .5rem .75rem .625rem; }\n\n.overline {\n  font-size: var(--text-body-md);\n  font-weight: var(--font-weight-semi-bold);\n  letter-spacing: var(--tracking-overline);\n  text-transform: uppercase;\n  color: var(--text-neutral-quaternary);\n}\n\n.prompt-box {\n  display: grid;\n  margin-block-start: .125rem;\n}\n\n.prompt-text,\n.prompt-ghost {\n  grid-area: 1 / 1;\n  margin: 0;\n}\n\n.prompt-ghost { visibility: hidden; }\n\n.phrase {\n  padding: 0 .25rem;\n  border-bottom: 2px solid var(--detail-line);\n  border-radius: var(--shape-sm);\n  background: var(--detail-bg);\n  font-weight: var(--font-weight-semi-bold);\n  -webkit-box-decoration-break: clone;\n  box-decoration-break: clone;\n}\n\n.phrase .icon { color: var(--detail-line); margin-inline-end: .25rem; vertical-align: -.2em; }\n\n.sent.is-new { animation: fade-in var(--motion-surface-duration) var(--motion-surface-easing) both; }\n\n.sent.keep {\n  display: inline-block;\n  padding: 0 .25rem;\n  border-inline-start: 3px solid var(--detail-line);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n/* ---------- Choice rows ---------- */\n\n.switches {\n  display: grid;\n  gap: .375rem;\n}\n\n.row {\n  min-width: 0;\n  margin: 0;\n  padding: 0;\n  border: 0;\n}\n\n.row legend {\n  display: flex;\n  align-items: center;\n  gap: .375rem;\n  padding: 0;\n  margin-block-end: .125rem;\n  font-weight: var(--font-weight-semi-bold);\n  line-height: 1.25rem;\n}\n\n.row legend .icon { color: var(--detail-line); }\n\n.opts {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: .5rem;\n}\n\n.opt {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: .25rem;\n  min-height: var(--control-height-medium);\n  padding: .125rem .75rem;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-primary);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  line-height: 1.25rem;\n  text-align: center;\n  cursor: pointer;\n  transition: var(--transition-colors), var(--transition-press);\n}\n\n.opt:hover { background: var(--background-neutral-secondary); }\n\n.opt:active { transform: scale(var(--motion-press-scale)); }\n\n.opt .check { display: none; }\n\n.opt[aria-pressed=\"true\"] {\n  background: var(--background-selected-primary);\n  border-color: var(--border-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n.opt[aria-pressed=\"true\"] .check { display: inline-block; }\n\n.opt:focus-visible,\n.text-button:focus-visible,\n.btn:focus-visible,\n.author-row select:focus-visible {\n  outline: 2px solid var(--ring);\n  outline-offset: 2px;\n}\n\n/* ---------- Buttons (demo) ---------- */\n\n.btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: var(--control-height-medium);\n  padding: 0 var(--spacing-p-xs);\n  border: 1px solid transparent;\n  border-radius: var(--shape-md);\n  font: inherit;\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n  transition: var(--transition-colors), var(--transition-press);\n}\n\n.btn:active { transform: scale(var(--motion-press-scale)); }\n\n.btn-primary {\n  background: var(--background-brand-primary);\n  color: var(--text-neutral-white-fixed);\n}\n\n.btn-primary:hover { background: var(--background-brand-strong); }\n\n.btn-outline {\n  background: var(--background-neutral-primary);\n  border-color: var(--border-neutral-solid);\n  color: var(--text-neutral-primary);\n}\n\n.btn-outline:hover { background: var(--background-neutral-secondary); }\n\n/* ---------- Demo panel ---------- */\n\n.demo-panel {\n  display: grid;\n  gap: .375rem;\n  padding: .75rem;\n  border-radius: var(--shape-md);\n  background: var(--background-brand-light);\n  color: var(--text-brand-secondary);\n}\n\n.demo-step {\n  margin: 0;\n  font-weight: var(--font-weight-semi-bold);\n  letter-spacing: var(--tracking-overline);\n  text-transform: uppercase;\n}\n\n.demo-title {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-xs);\n  line-height: var(--leading-heading-xs);\n  color: var(--text-neutral-primary);\n}\n\n.demo-text {\n  margin: 0;\n  min-height: 2.75rem;\n  color: var(--text-neutral-primary);\n  font-size: var(--text-body-lg);\n  line-height: var(--leading-body-md);\n}\n\n.demo-actions {\n  display: flex;\n  align-items: center;\n  gap: .5rem;\n}\n\n.spark {\n  width: 1.5rem;\n  height: 1.5rem;\n  fill: var(--background-brand-primary);\n  transform-origin: center;\n}\n\n.spark.is-pulsing { animation: spark-pulse .8s var(--easing-out); }\n\n/* ---------- Sample page ---------- */\n\n.page-area {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n  min-width: 0;\n}\n\n.site {\n  --site-bg: var(--background-neutral-primary);\n  --site-ink: var(--text-neutral-tertiary);\n  --site-line: var(--border-neutral-primary);\n  --site-a: var(--neutral-gray-10);\n  --site-b: var(--neutral-gray-20);\n  --site-c: var(--neutral-gray-10);\n  --site-label: var(--text-neutral-tertiary);\n  --site-btn-bg: var(--neutral-gray-20);\n  --site-btn-ink: var(--text-neutral-primary);\n  --site-btn-line: transparent;\n  --title-family: var(--font-family-heading);\n  --title-size: 1.25rem;\n  --title-weight: var(--font-weight-semi-bold);\n  overflow: hidden;\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-md);\n  background: var(--site-bg);\n  color: var(--site-ink);\n  transition: background-color var(--duration-medium) var(--easing-standard);\n}\n\n/* Looks chosen by \"the feel\", \"colors\" or \"tone\" */\n\n.site[data-tone=\"1\"] {\n  --site-bg: var(--sentiment-warning-5);\n  --site-ink: var(--sentiment-warning-95);\n  --site-a: var(--sentiment-warning-10);\n  --site-b: var(--sentiment-warning-40);\n  --site-c: var(--sentiment-success-30);\n  --site-btn-bg: var(--sentiment-success-70);\n  --site-btn-ink: var(--neutral-base-white);\n}\n\n.site[data-tone=\"2\"] {\n  --site-bg: var(--sentiment-information-95);\n  --site-ink: var(--neutral-base-white);\n  --site-a: var(--sentiment-information-90);\n  --site-b: var(--neutral-gray-10);\n  --site-c: var(--sentiment-information-80);\n  --site-btn-bg: var(--sentiment-warning-40);\n  --site-btn-ink: var(--neutral-base-black);\n}\n\n.site-bar {\n  display: flex;\n  align-items: center;\n  gap: .25rem;\n  height: 1.75rem;\n  padding: 0 .5rem;\n  border-bottom: 1px solid var(--border-neutral-primary);\n  background: var(--background-neutral-secondary);\n}\n\n.site-dot {\n  width: .5rem;\n  height: .5rem;\n  border-radius: var(--shape-round);\n  background: var(--neutral-gray-30);\n}\n\n.site-url {\n  margin-inline-start: .5rem;\n  padding: 0 .75rem;\n  border-radius: var(--shape-round);\n  background: var(--background-neutral-primary);\n  color: var(--text-neutral-quaternary);\n  font-size: var(--text-body-sm);\n  line-height: 1.25rem;\n}\n\n.site-main {\n  display: grid;\n  gap: .625rem;\n  align-content: start;\n  min-height: 15rem;\n  padding: var(--spacing-p-xs);\n}\n\n.slot,\n.bar {\n  margin: 0;\n  width: fit-content;\n  max-width: 100%;\n  transition: color var(--duration-medium) var(--easing-standard), background-color var(--duration-medium) var(--easing-standard);\n  transition-delay: calc(var(--i, 0) * 60ms);\n}\n\n.slot.is-bar,\n.bar {\n  border-radius: var(--shape-sm);\n  background: var(--neutral-gray-10);\n  color: transparent;\n  user-select: none;\n}\n\n.site-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: fit-content;\n  min-height: 2.25rem;\n  padding: .125rem var(--spacing-p-xs);\n  border: 2px solid var(--site-btn-line);\n  border-radius: var(--shape-md);\n  background: var(--site-btn-bg);\n  color: var(--site-btn-ink);\n  font-weight: var(--font-weight-bold);\n  transition: background-color var(--duration-medium) var(--easing-standard), color var(--duration-medium) var(--easing-standard);\n}\n\n.site-btn.is-bar { background: var(--neutral-gray-10); color: transparent; }\n\n/* Save the park */\n\n.story-main { gap: .5rem; }\n\n.scene {\n  position: relative;\n  overflow: hidden;\n  height: 4.5rem;\n  border-radius: var(--shape-md);\n  background: var(--site-a);\n}\n\n.scene::before {\n  content: \"\";\n  position: absolute;\n  inset-block-start: .5rem;\n  inset-inline-end: 1.25rem;\n  width: 1.75rem;\n  height: 1.75rem;\n  border-radius: var(--shape-round);\n  background: var(--site-b);\n}\n\n.scene::after {\n  content: \"\";\n  position: absolute;\n  inset-block-end: -1.5rem;\n  inset-inline-start: -15%;\n  width: 130%;\n  height: 3.5rem;\n  border-radius: 50%;\n  background: var(--site-c);\n}\n\n.site-eyebrow { font-weight: var(--font-weight-semi-bold); }\n\n.site-headline {\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-md);\n  font-weight: var(--font-weight-bold);\n  line-height: var(--leading-heading-md);\n  color: var(--site-ink);\n}\n\n.site-body { font-size: var(--text-body-md); color: var(--site-ink); }\n\n/* ---------- Note under the page ---------- */\n\n.note {\n  display: grid;\n  gap: .125rem;\n  min-height: 3.5rem;\n}\n\n.note-main {\n  display: flex;\n  align-items: flex-start;\n  gap: .5rem;\n  margin: 0;\n}\n\n.note-main .icon { margin-block-start: .1875rem; color: var(--detail-line); }\n\n.note-status {\n  margin: 0;\n  padding: .125rem .5rem;\n  border-radius: var(--shape-sm);\n  background: var(--background-success-light);\n  color: var(--text-success-secondary);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n/* ---------- Flash on the part of the page a detail reached ---------- */\n\n.flash {\n  outline: 3px solid var(--detail-line);\n  outline-offset: -3px;\n  animation: flash-fade 1s ease-out forwards;\n}\n\n/* ---------- Motion ---------- */\n\n@keyframes fade-in {\n  from { opacity: 0; transform: translateY(.25rem); }\n  to { opacity: 1; transform: none; }\n}\n\n@keyframes flash-fade {\n  from { outline-color: var(--detail-line); }\n  to { outline-color: transparent; }\n}\n\n@keyframes line-in {\n  from { background: var(--detail-bg); }\n  to { background: transparent; }\n}\n\n@keyframes spark-pulse {\n  0% { transform: scale(1); opacity: .6; }\n  40% { transform: scale(1.6); opacity: 1; }\n  100% { transform: scale(1); opacity: .9; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n}\n\n/* ---------- Narrow screens ---------- */\n\n@media (max-width: 47.99rem) {\n  .workspace { grid-template-columns: minmax(0, 1fr); }\n\n  .gutter { padding-block: 0; height: 2rem; align-items: center; }\n\n  .site-main { min-height: 0; }\n}\n",
          "folderId": "0",
          "active": true
        }
      },
