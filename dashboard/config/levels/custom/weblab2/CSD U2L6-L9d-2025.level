          "name": "style.css",
          "language": "css",
          "contents": "body {\n  background: white;\n}\nh1 {\n  font-weight: bold;\n  background-color: rbg(240, 200, 250);\n}\nh3 {\n  font-weight: bold;\n  color: rgb 200, 50, 225;\n}",
