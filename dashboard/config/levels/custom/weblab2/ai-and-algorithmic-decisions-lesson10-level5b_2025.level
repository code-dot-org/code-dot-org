  "properties": {
    "encrypted": "false",
    "display_name": "Clinic Triage Helper",
    "long_instructions": "\r\n## Clinic Triage Helper\r\n\r\n**Eligibility Criteria:**\r\nA patient is **prioritized** if they have **both a chronic condition and an acute symptom**, **or** if they have **not been seen recently**.\r\n\r\n---\r\n\r\n**Do This:**\r\n\r\n1. Review the checkbox input fields in the starter code: `hasChronicCondition`, `hasAcuteSymptom`, and `seenRecently`.\r\n\r\n2. Complete the `eligible()` function so it updates the triage **message (`message`)** based on whether the current input values meet the criteria.\r\n\r\n3. In the event handler for the **Run** button (`runBtn`), call `eligible()` to test the current inputs.\r\n",
    "thumbnail_url": "https://images.code.org/294ca4e23a4516bd9ac03f5ad6433857-triage.png",
    "submittable": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
    "disable_edit_run_for_submission": "false",
    "ai_tutor_mode": "tutor",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "placeholderText": "",
      "multipleChoiceOptions": [
        ""
      ],
      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false,
      "allowMultipleAttempts": false
    },
    "bubble_choice_description": "Prioritize if a chronic condition and an acute symptom, or if not seen recently.",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <meta charset=\"utf-8\">\n    <title>Clinic Triage Helper</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    <h1>Clinic Triage Helper</h1>\n\n    <label>\n      <input id=\"hasChronicCondition\" type=\"checkbox\">\n      Chronic condition\n    </label>\n\n    <label>\n      <input id=\"hasAcuteSymptom\" type=\"checkbox\">\n      Acute symptom\n    </label>\n\n    <label>\n      <input id=\"seenRecently\" type=\"checkbox\">\n      Seen recently\n    </label>\n\n    <button id=\"runBtn\">Run</button>\n\n    <p id=\"message\">—</p>\n\n    <script src=\"script.js\"></script>\n  </body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: sans-serif;\n  text-align: center;\n  padding: 2rem;\n  background-color: #f9f9f9;\n}\n\nh1 {\n  margin-bottom: 1rem;\n}\n\nlabel {\n  display: block;\n  margin: 0.5rem 0;\n}\n\nbutton {\n  margin-top: 1rem;\n  padding: 0.5rem 1rem;\n  border: 1px solid #ccc;\n  border-radius: 6px;\n  background-color: #f2f2f2;\n  cursor: pointer;\n}\n\nbutton:hover {\n  background-color: #e2e2e2;\n}\n\n#message {\n  margin-top: 1rem;\n  font-weight: bold;\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "language": "js",
          "contents": "const hasChronicCondition = document.getElementById(\"hasChronicCondition\");\nconst hasAcuteSymptom = document.getElementById(\"hasAcuteSymptom\");\nconst seenRecently = document.getElementById(\"seenRecently\");\nconst message = document.getElementById(\"message\");\nconst runBtn = document.getElementById(\"runBtn\");\n\nconst eligible = () => {\n  \n  // Use these variables in your logic\n  const chronic = hasChronicCondition.checked;\n  const acute = hasAcuteSymptom.checked;\n  const recently = seenRecently.checked;\n\n\n}\n\nrunBtn.addEventListener(\"click\", eligible);\n",
          "folderId": "0",
          "active": true
        }
      },
