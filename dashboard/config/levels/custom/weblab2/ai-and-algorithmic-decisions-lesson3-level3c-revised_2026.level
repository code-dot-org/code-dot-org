      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Shopping Cart</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n  <header class=\"storeHeader\">\n    <div>\n      <p class=\"storeLabel\">Online Shop</p>\n      <h1>Cart Tracker</h1>\n    </div>\n    <div class=\"shopperBox\">\n      <p class=\"shopperLine\">Shopper: <span id=\"shopperNameDisplay\">Maya</span></p>\n      <p class=\"shopperLine\">Tier: <span id=\"tierDisplay\">Gold</span></p>\n    </div>\n  </header>\n  <main class=\"storeLayout\">\n    <section class=\"productsPanel\">\n      <h2>Products</h2>\n      <div class=\"productCard\">\n        <div class=\"productInfo\">\n          <div class=\"productImageWrap\">\n            <img src=\"images/shirt.png\" alt=\"T-shirt\" class=\"productImage\">\n          </div>\n          <div>\n            <h3>T-Shirt</h3>\n            <p class=\"price\">$20</p>\n          </div>\n        </div>\n        <button id=\"shirtButton\">Add T-Shirt</button>\n      </div>\n      <div class=\"productCard\">\n        <div class=\"productInfo\">\n          <div class=\"productImageWrap\">\n            <img src=\"images/sneakers.png\" alt=\"Sneakers\" class=\"productImage\">\n          </div>\n          <div>\n            <h3>Sneakers</h3>\n            <p class=\"price\">$60</p>\n          </div>\n        </div>\n        <button id=\"sneakersButton\">Add Sneakers</button>\n      </div>\n      <div class=\"productCard\">\n        <div class=\"productInfo\">\n          <div class=\"productImageWrap\">\n            <img src=\"images/hat.png\" alt=\"Hat\" class=\"productImage\">\n          </div>\n          <div>\n            <h3>Hat</h3>\n            <p class=\"price\">$15</p>\n          </div>\n        </div>\n        <button id=\"hatButton\">Add Hat</button>\n      </div>\n    </section>\n    <aside class=\"cartPanel\">\n      <h2>Cart Summary</h2>\n      <div class=\"summaryRow\">\n        <span>Items in Cart</span>\n        <strong id=\"itemsDisplay\">1</strong>\n      </div>\n      <div class=\"summaryRow\">\n        <span>Cart Total</span>\n        <strong>$<span id=\"totalDisplay\">40</span></strong>\n      </div>\n      <div class=\"summaryRow\">\n        <span>Coupon</span>\n        <strong id=\"couponDisplay\">None</strong>\n      </div>\n      <div class=\"cartHints\">\n        <p>Add T-Shirt should increase items by 1 and total by $20.</p>\n        <p>Add Sneakers should increase total by $60.</p>\n        <p>Add Hat should increase total by $15.</p>\n        <p>Apply Coupon should update the coupon to \"SAVE10\" and lower the total by $10.</p>\n        <p>Remove Item should lower the item count by 1.</p>\n      </div>\n      <div class=\"cartActions\">\n        <button id=\"couponButton\">Apply Coupon</button>\n        <button id=\"removeButton\">Remove Item</button>\n      </div>\n    </aside>\n  </main>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n  font-family: Arial, sans-serif;\n}\n\nbody {\n  background: #f6f7fb;\n  color: #222;\n  min-height: 100vh;\n}\n\n.storeHeader {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 24px 28px;\n  background: #111827;\n  color: white;\n}\n\n.storeLabel {\n  font-size: 0.85rem;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  opacity: 0.8;\n  margin-bottom: 6px;\n}\n\n.storeHeader h1 {\n  font-size: 2rem;\n}\n\n.shopperBox {\n  background: #1f2937;\n  border: 1px solid #374151;\n  border-radius: 14px;\n  padding: 14px 16px;\n  min-width: 180px;\n}\n\n.shopperLine {\n  font-size: 0.95rem;\n}\n\n.shopperLine + .shopperLine {\n  margin-top: 6px;\n}\n\n.storeLayout {\n  max-width: 1100px;\n  margin: 0 auto;\n  padding: 24px;\n  display: grid;\n  grid-template-columns: 1.4fr 1fr;\n  gap: 24px;\n}\n\n.productsPanel,\n.cartPanel {\n  background: white;\n  border-radius: 18px;\n  padding: 22px;\n  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);\n}\n\n.productsPanel h2,\n.cartPanel h2 {\n  margin-bottom: 18px;\n  font-size: 1.25rem;\n}\n\n.productCard {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 18px 0;\n  border-bottom: 1px solid #e5e7eb;\n}\n\n.productCard:last-child {\n  border-bottom: none;\n}\n\n.productCard h3 {\n  margin-bottom: 6px;\n}\n\n.productInfo {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\n\n.productImageWrap {\n  width: 56px;\n  height: 56px;\n  border-radius: 12px;\n  background: #f3f4f6;\n  border: 1px solid #e5e7eb;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n}\n\n.productImage {\n  width: 36px;\n  height: 36px;\n  object-fit: contain;\n}\n\n.price {\n  color: #6b7280;\n  font-size: 0.95rem;\n}\n\n.summaryRow {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 14px 0;\n  border-bottom: 1px solid #e5e7eb;\n  font-size: 1rem;\n}\n\n.cartHints {\n  margin-top: 18px;\n  padding: 14px;\n  background: #f3f4f6;\n  border-radius: 12px;\n  display: grid;\n  gap: 10px;\n  font-size: 0.92rem;\n  color: #4b5563;\n}\n\n.cartActions {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 12px;\n  margin-top: 18px;\n}\n\nbutton {\n  border: none;\n  border-radius: 12px;\n  padding: 12px 16px;\n  font-size: 0.95rem;\n  font-weight: bold;\n  cursor: pointer;\n  background: #111827;\n  color: white;\n}\n\nbutton:hover {\n  opacity: 0.93;\n}\n\n@media (max-width: 800px) {\n  .storeHeader {\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 16px;\n  }\n\n  .storeLayout {\n    grid-template-columns: 1fr;\n  }\n\n  .cartActions {\n    grid-template-columns: 1fr;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const itemsInCart = 1;\nlet cartTotal = \"40\";\nlet couponStatus = \"None\";\nlet shopperName = \"Maya\";\nlet membershipTier = \"Gold\";\n\ndocument.getElementById(\"shirtButton\").addEventListener(\"click\", function() {\n  itemsInCart = itemsInCart + 1;\n  cartTotal = cartTotal + 20;\n  let itemsDisplay = document.getElementById(\"itemsDisplay\");\n  let totalDisplay = document.getElementById(\"totalDisplay\");\n  itemsDisplay.textContent = itemsInCart;\n  totalDisplay.textContent = cartTotal;\n});\n\ndocument.getElementById(\"sneakersButton\").addEventListener(\"click\", function() {\n  cartTotal = cartTotal - 60;\n  let totalDisplay = document.getElementById(\"totalDisplay\");\n  totalDisplay.textContent = cartTotal;\n});\n\ndocument.getElementById(\"hatButton\").addEventListener(\"click\", function() {\n  cartTotal = cartTotal + 15;\n  let totalDisplay = document.getElementById(\"totalDisplay\");\n  totalDisplay.textContent = cartTotal;\n});\n\ndocument.getElementById(\"couponButton\").addEventListener(\"click\", function() {\n  couponStatus = \"SAVE10\";\n  cartTotal = cartTotal - 10;\n  let couponDisplay = document.getElementById(\"couponDisplay\");\n  let totalDisplay = document.getElementById(\"totalDisplay\");\n  couponDisplay.textContent = couponStatus;\n  totalDisplay.textContent = cartTotal;\n});\n\ndocument.getElementById(\"removeButton\").addEventListener(\"click\", function() {\n  itemsInCart = itemsInCart - 1;\n  let itemsDisplay = document.getElementById(\"itemsDisplay\");\n  itemsDisplay.textContent = itemsInCart;\n});",
          "folderId": "0",
          "active": false
        },
