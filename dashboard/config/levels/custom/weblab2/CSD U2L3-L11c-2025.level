      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n  </head>\n  <body>\n    \n    <!-- 2) Replace the ampersand that is causing pink code with the special code for the symbol -->\n    <h2>This &amp; That</h2>\n    <p>Favorite store: H&amp;M</p>\n    <p>Favorite TV Show: Locke & Key</p>\n    \n    <!-- 3) Fill in the blank categories or add your own using the new code. Try to come up with answers that use the symbol! -->\n    <p>Favorite candy: </p>\n    <p>Favorite food combination:</p>\n    <p>School colors: </p>\n    <p>Favorite movie:</p>\n    <p></p>\n  </body>\n</html>",
          "active": true,
