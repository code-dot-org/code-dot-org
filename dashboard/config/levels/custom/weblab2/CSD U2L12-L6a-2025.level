    "display_name": "Inversed Properties",
    "bubble_choice_description": "Practice horizontal and vertical alignment for columns!",
    "thumbnail_url": "https://images.code.org/11587f6e7278dff510444ba5958efe08-inversed.png",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    \n    <!-- div container with a class attribute around the 2 images -->\n    <div class=\"container-1\">\n      <img src=\"one.jpg\" alt=\"one\">\n      <img src=\"two.jpg\" alt=\"two\">\n    </div>\n    \n    <!-- div container with a class attribute around the 2 images -->\n    <div class=\"container-2\">\n      <img src=\"one.jpg\" alt=\"one\">\n      <img src=\"two.jpg\" alt=\"two\">\n    </div>\n    \n    <!-- div container with a class attribute around the 2 images -->\n    <div class=\"container-3\">\n      <img src=\"one.jpg\" alt=\"one\">\n      <img src=\"two.jpg\" alt=\"two\">\n    </div>\n    \n    <!-- div container with a class attribute around the 2 images -->\n    <div class=\"container-4\">\n      <img src=\"one.jpg\" alt=\"one\">\n      <img src=\"two.jpg\" alt=\"two\">\n    </div>\n    \n    <!-- div container with a class attribute around the 2 images -->\n    <div class=\"container-5\">\n      <img src=\"one.jpg\" alt=\"one\">\n      <img src=\"two.jpg\" alt=\"two\">\n    </div>\n    \n    <!-- div container with a class attribute around the 2 images -->\n    <div class=\"container-6\">\n      <img src=\"one.jpg\" alt=\"one\">\n      <img src=\"two.jpg\" alt=\"two\">\n    </div>\n    \n\n    \n    \n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "language": "css",
          "contents": "/* 1) Add the align-items property with the correct value to horizontally align the images in each container to look like the picture in the instructions */\n\n/* 2) Add the justify-content property with the correct value to vertically align the images in each container to look like the picture in the instructions */\n.container-1 {\n  /* The div container has a background color so you can see how the items are positioned within it */\n  background: #b691d6;\n  \n  /* Establish a flex layout context */\n  display: flex;\n\n  /* Define the flow direction \n  and if the items should wrap */\n  flex-direction: column;\n  flex-wrap: nowrap;\n  \n  /* Define how items should be distributed horizontally across the container */\n\n  \n  /* Define how items should be distributed vertically within the container */\n\n  \n\n\n}\n\n.container-2 {\n  /* The div container has a background color so you can see how the items are positioned within it */\n  background: #91d6ce;\n\n  /* Establish a flex layout context */\n  display: flex;\n\n  /* Define the flow direction \n  and if the items should wrap */\n  flex-direction: column;\n  flex-wrap: nowrap;\n\n  /* Define how items should be distributed horizontally across the container */\n\n\n  /* Define how items should be distributed vertically within the container */\n\n\n}\n\n.container-3 {\n  /* The div container has a background color so you can see how the items are positioned within it */\n  background: #d691c4;\n\n  /* Establish a flex layout context */\n  display: flex;\n\n  /* Define the flow direction \n  and if the items should wrap */\n  flex-direction: column;\n  flex-wrap: nowrap;\n\n  /* Define how items should be distributed horizontally across the container */\n\n\n  /* Define how items should be distributed vertically within the container */\n\n\n}\n\n.container-4 {\n  /* The div container has a background color so you can see how the items are positioned within it */\n  background: #9cd691;\n\n  /* Establish a flex layout context */\n  display: flex;\n\n  /* Define the flow direction \n  and if the items should wrap */\n  flex-direction: column;\n  flex-wrap: nowrap;\n\n  /* Define how items should be distributed horizontally across the container */\n\n\n  /* Define how items should be distributed vertically within the container */\n\n\n}\n\n.container-5 {\n  /* The div container has a background color so you can see how the items are positioned within it */\n  background: #f6f48c;\n\n  /* Establish a flex layout context */\n  display: flex;\n\n  /* Define the flow direction \n  and if the items should wrap */\n  flex-direction: column;\n  flex-wrap: nowrap;\n\n  /* Define how items should be distributed horizontally across the container */\n \n\n  /* Define how items should be distributed vertically within the container */\n\n\n}\n\n.container-6 {\n  /* The div container has a background color so you can see how the items are positioned within it */\n  background: #f68c8c;\n\n  /* Establish a flex layout context */\n  display: flex;\n\n  /* Define the flow direction \n  and if the items should wrap */\n  flex-direction: column;\n  flex-wrap: nowrap;\n\n  /* Define how items should be distributed horizontally across the container */\n\n\n  /* Define how items should be distributed vertically within the container */\n\n\n\n}\n\n\nimg{\n  height: 75px;\n  border-style: solid;\n}\n\n/* containers were given extra height so you can see all of the spacing affects */\ndiv {\n  height: 250px;\n}",
          "folderId": "0",
          "active": false
        },
