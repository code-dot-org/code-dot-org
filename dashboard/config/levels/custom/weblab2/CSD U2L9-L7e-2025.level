        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n    <link rel=\"stylesheet\" href=\"style.css\">\n  </head>\n  <body>\n    <h1> My Portfolio </h1>\n    <h3> These are some photos that I really like that I wanted to share </h3>\n    <img src=\"arctic_fox.jpg\" alt=\"An Arctic fox\">\n    <h6> David Mark, Pixabay, Pixabay License </h6>\n    <img src=\"flower.jpg\" alt=\"Close up of a flower\">\n    <h6> Jill Wellington, Pixabay, Pixabay License </h6>\n    <img src=\"watermelon.jpg\" alt=\"Cut up watermelon\">\n    <h6> Jill Wellington, Pixabay, Pixabay License </h6>\n    <img src=\"fox.jpg\" alt=\"A fox\">\n    <h6> Pexels, Pixabay, Pixabay License </h6>\n    <img src=\"poppy.jpg\" alt=\"A poppy field\">\n    <h6> Roman Grac, Pixabay, Pixabay License </h6>\n    <img src=\"bird.jpg\" alt=\"A flying bird\">\n    <h6> homecare119, Pixabay, Pixabay License </h6>\n  </body>\n</html>\n",
