      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>FieldVet</title>\n<link rel=\"stylesheet\" href=\"style.css\">\n<script src=\"script.js\" defer></script>\n</head>\n<body>\n\n<h1 class=\"sr-only\">FieldVet: Amara's mobile veterinary records app</h1>\n\n<svg class=\"sprite\" aria-hidden=\"true\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\">\n  <symbol id=\"c-processor\" viewBox=\"0 0 24 24\">\n    <rect x=\"6\" y=\"6\" width=\"12\" height=\"12\" rx=\"2\"/>\n    <rect x=\"9.5\" y=\"9.5\" width=\"5\" height=\"5\" rx=\"1\" fill=\"#FFFFFF\"/>\n    <rect x=\"8.6\" y=\"2.5\" width=\"1.6\" height=\"3\"/><rect x=\"13.8\" y=\"2.5\" width=\"1.6\" height=\"3\"/>\n    <rect x=\"8.6\" y=\"18.5\" width=\"1.6\" height=\"3\"/><rect x=\"13.8\" y=\"18.5\" width=\"1.6\" height=\"3\"/>\n    <rect x=\"2.5\" y=\"8.6\" width=\"3\" height=\"1.6\"/><rect x=\"2.5\" y=\"13.8\" width=\"3\" height=\"1.6\"/>\n    <rect x=\"18.5\" y=\"8.6\" width=\"3\" height=\"1.6\"/><rect x=\"18.5\" y=\"13.8\" width=\"3\" height=\"1.6\"/>\n  </symbol>\n  <symbol id=\"c-storage\" viewBox=\"0 0 24 24\">\n    <ellipse cx=\"12\" cy=\"6\" rx=\"8\" ry=\"3\"/>\n    <path d=\"M4 6v5c0 1.7 3.6 3 8 3s8-1.3 8-3V6c0 1.7-3.6 3-8 3S4 7.7 4 6z\"/>\n    <path d=\"M4 13v5c0 1.7 3.6 3 8 3s8-1.3 8-3v-5c0 1.7-3.6 3-8 3s-8-1.3-8-3z\"/>\n  </symbol>\n  <symbol id=\"c-network\" viewBox=\"0 0 24 24\">\n    <rect x=\"3\" y=\"15\" width=\"3.6\" height=\"6\" rx=\"1\"/>\n    <rect x=\"8.2\" y=\"11\" width=\"3.6\" height=\"10\" rx=\"1\"/>\n    <rect x=\"13.4\" y=\"7\" width=\"3.6\" height=\"14\" rx=\"1\"/>\n    <rect x=\"18.6\" y=\"3\" width=\"3.6\" height=\"18\" rx=\"1\" opacity=\"0.35\"/>\n  </symbol>\n  <symbol id=\"c-memory\" viewBox=\"0 0 24 24\">\n    <path d=\"M3 7h18v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/>\n    <rect x=\"6\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"9.6\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"13.2\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"16.8\" y=\"10\" width=\"1.8\" height=\"5\" fill=\"#FFFFFF\"/>\n    <rect x=\"5\" y=\"19\" width=\"4\" height=\"2.5\" rx=\"1\"/><rect x=\"15\" y=\"19\" width=\"4\" height=\"2.5\" rx=\"1\"/>\n  </symbol>\n  <symbol id=\"c-travel\" viewBox=\"0 0 24 24\">\n    <path d=\"M2 7h11v9H2z\"/><path d=\"M13 10h4.5l3.5 4v2h-8z\"/>\n    <circle cx=\"6.5\" cy=\"17.5\" r=\"2.6\"/><circle cx=\"17\" cy=\"17.5\" r=\"2.6\"/>\n    <circle cx=\"6.5\" cy=\"17.5\" r=\"1\" fill=\"#FFFFFF\"/><circle cx=\"17\" cy=\"17.5\" r=\"1\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"c-settings\" viewBox=\"0 0 24 24\">\n    <rect x=\"2\" y=\"4.6\" width=\"20\" height=\"2.2\" rx=\"1.1\"/>\n    <rect x=\"2\" y=\"10.9\" width=\"20\" height=\"2.2\" rx=\"1.1\"/>\n    <rect x=\"2\" y=\"17.2\" width=\"20\" height=\"2.2\" rx=\"1.1\"/>\n    <circle cx=\"8\" cy=\"5.7\" r=\"3\"/><circle cx=\"16\" cy=\"12\" r=\"3\"/><circle cx=\"10\" cy=\"18.3\" r=\"3\"/>\n    <circle cx=\"8\" cy=\"5.7\" r=\"1.3\" fill=\"#FFFFFF\"/><circle cx=\"16\" cy=\"12\" r=\"1.3\" fill=\"#FFFFFF\"/>\n    <circle cx=\"10\" cy=\"18.3\" r=\"1.3\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"i-cow\" viewBox=\"0 0 48 48\">\n    <ellipse cx=\"9\" cy=\"17\" rx=\"6\" ry=\"4\"/><ellipse cx=\"39\" cy=\"17\" rx=\"6\" ry=\"4\"/>\n    <path d=\"M13 12h22v15a11 11 0 0 1-22 0z\"/>\n    <ellipse cx=\"24\" cy=\"31\" rx=\"9\" ry=\"7\" fill=\"#FFFFFF\"/>\n    <circle cx=\"20.5\" cy=\"31\" r=\"1.6\"/><circle cx=\"27.5\" cy=\"31\" r=\"1.6\"/>\n    <circle cx=\"18\" cy=\"19\" r=\"2.1\" fill=\"#FFFFFF\"/><circle cx=\"30\" cy=\"19\" r=\"2.1\" fill=\"#FFFFFF\"/>\n    <path d=\"M17 6c-3 0-4 3-2 5l3-2z\"/><path d=\"M31 6c3 0 4 3 2 5l-3-2z\"/>\n  </symbol>\n  <symbol id=\"i-sheep\" viewBox=\"0 0 48 48\">\n    <circle cx=\"14\" cy=\"18\" r=\"7\"/><circle cx=\"34\" cy=\"18\" r=\"7\"/><circle cx=\"24\" cy=\"13\" r=\"7\"/>\n    <circle cx=\"16\" cy=\"28\" r=\"7\"/><circle cx=\"32\" cy=\"28\" r=\"7\"/>\n    <ellipse cx=\"24\" cy=\"30\" rx=\"9\" ry=\"10\" fill=\"#FFFFFF\"/>\n    <ellipse cx=\"24\" cy=\"30\" rx=\"7.5\" ry=\"8.5\"/>\n    <circle cx=\"21\" cy=\"28\" r=\"1.7\" fill=\"#FFFFFF\"/><circle cx=\"27\" cy=\"28\" r=\"1.7\" fill=\"#FFFFFF\"/>\n    <ellipse cx=\"24\" cy=\"35\" rx=\"3\" ry=\"2\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"i-cattle\" viewBox=\"0 0 48 48\">\n    <path d=\"M6 14c0-5 5-7 9-5l-2 4c-3-1-4 0-4 1z\"/><path d=\"M42 14c0-5-5-7-9-5l2 4c3-1 4 0 4 1z\"/>\n    <ellipse cx=\"10\" cy=\"20\" rx=\"5\" ry=\"3.5\"/><ellipse cx=\"38\" cy=\"20\" rx=\"5\" ry=\"3.5\"/>\n    <path d=\"M14 15h20v14a10 10 0 0 1-20 0z\"/>\n    <ellipse cx=\"24\" cy=\"32\" rx=\"8\" ry=\"6\" fill=\"#FFFFFF\"/>\n    <circle cx=\"21\" cy=\"32\" r=\"1.5\"/><circle cx=\"27\" cy=\"32\" r=\"1.5\"/>\n    <circle cx=\"19\" cy=\"22\" r=\"2\" fill=\"#FFFFFF\"/><circle cx=\"29\" cy=\"22\" r=\"2\" fill=\"#FFFFFF\"/>\n  </symbol>\n  <symbol id=\"i-goat\" viewBox=\"0 0 48 48\">\n    <path d=\"M15 12C11 6 6 6 5 9c3 0 6 2 7 6z\"/><path d=\"M33 12c4-6 9-6 10-3-3 0-6 2-7 6z\"/>\n    <ellipse cx=\"11\" cy=\"21\" rx=\"5\" ry=\"3\"/><ellipse cx=\"37\" cy=\"21\" rx=\"5\" ry=\"3\"/>\n    <path d=\"M16 14h16v13c0 6-3 9-8 9s-8-3-8-9z\"/>\n    <circle cx=\"20\" cy=\"21\" r=\"2\" fill=\"#FFFFFF\"/><circle cx=\"28\" cy=\"21\" r=\"2\" fill=\"#FFFFFF\"/>\n    <ellipse cx=\"24\" cy=\"31\" rx=\"4\" ry=\"3\" fill=\"#FFFFFF\"/>\n    <path d=\"M21 37h6l-3 7z\"/>\n  </symbol>\n  <symbol id=\"i-horse\" viewBox=\"0 0 48 48\">\n    <path d=\"M17 8c-4 0-6 3-6 7l-2 16c-1 7 3 11 9 11h8c5 0 8-3 8-8V22c0-8-5-14-13-14z\"/>\n    <path d=\"M14 6c-4 2-6 7-5 12l4-3z\"/><path d=\"M22 5c-3 1-5 5-5 9l4-2z\"/>\n    <circle cx=\"17\" cy=\"20\" r=\"2.2\" fill=\"#FFFFFF\"/>\n    <ellipse cx=\"20\" cy=\"36\" rx=\"6\" ry=\"4\" fill=\"#FFFFFF\"/>\n    <circle cx=\"18\" cy=\"36\" r=\"1.4\"/><circle cx=\"23\" cy=\"36\" r=\"1.4\"/>\n  </symbol>\n  <symbol id=\"i-hog\" viewBox=\"0 0 48 48\">\n    <path d=\"M11 13l2 8-6-2z\"/><path d=\"M37 13l-2 8 6-2z\"/>\n    <path d=\"M11 20a13 13 0 0 1 26 0v6a13 13 0 0 1-26 0z\"/>\n    <circle cx=\"18\" cy=\"21\" r=\"2.1\" fill=\"#FFFFFF\"/><circle cx=\"30\" cy=\"21\" r=\"2.1\" fill=\"#FFFFFF\"/>\n    <ellipse cx=\"24\" cy=\"31\" rx=\"8\" ry=\"6\" fill=\"#FFFFFF\"/>\n    <ellipse cx=\"21\" cy=\"31\" rx=\"1.6\" ry=\"2.2\"/><ellipse cx=\"27\" cy=\"31\" rx=\"1.6\" ry=\"2.2\"/>\n  </symbol>\n</svg>\n\n<div class=\"device\">\n  <div class=\"screen\">\n\n    <div class=\"statusbar\">\n      <div class=\"stat\"><span class=\"stat-label\">Time</span><span class=\"stat-value\" id=\"stat-clock\">7:00 AM</span></div>\n      <div class=\"stat\"><span class=\"stat-label\">Battery</span><span class=\"stat-value\" id=\"stat-battery\">100%</span></div>\n      <div class=\"stat\"><span class=\"stat-label\">Storage</span><span class=\"stat-value\" id=\"stat-storage\">45%</span></div>\n      <div class=\"stat\"><span class=\"stat-label\">Signal</span><span class=\"stat-value\" id=\"stat-signal\">None</span></div>\n      <div class=\"stat\"><span class=\"stat-label\">Open recs</span><span class=\"stat-value\" id=\"stat-load\">0</span></div>\n      <div class=\"stat\"><span class=\"stat-label\">Processing</span><span class=\"stat-value\" id=\"stat-proc\">Fast</span></div>\n    </div>\n\n    <div class=\"procbar\"><div class=\"procbar-fill\" id=\"procbar-fill\"></div></div>\n    <div class=\"cost-flash\" id=\"cost-flash\" hidden></div>\n\n    <main class=\"body\">\n\n      <section class=\"view\" id=\"view-route\">\n        <div class=\"viewhead\">\n          <h2>Today's Route</h2>\n          <p class=\"where\" id=\"route-where\">At the clinic</p>\n        </div>\n        <div class=\"alert\" id=\"route-alert\" hidden role=\"alert\"></div>\n        <div class=\"tile-grid\" id=\"farm-list\"></div>\n        <div class=\"actions\" id=\"route-actions\"></div>\n      </section>\n\n      <section class=\"view\" id=\"view-farm\" hidden>\n        <div class=\"viewhead\">\n          <h2 id=\"farm-name\">Farm</h2>\n          <button type=\"button\" class=\"linkbtn\" id=\"back-btn\">Back to the route</button>\n        </div>\n        <p class=\"amara\" id=\"farm-note\"></p>\n        <div class=\"alert\" id=\"farm-alert\" hidden role=\"alert\"></div>\n        <div class=\"quad\">\n          <section class=\"panel\" id=\"panel-record\">\n            <p class=\"panel-tag\">Processor</p>\n            <h3>The Record</h3>\n            <p class=\"panel-status\" id=\"record-status\"></p>\n            <div class=\"panel-actions\" id=\"record-actions\"></div>\n          </section>\n          <section class=\"panel\" id=\"panel-photos\">\n            <p class=\"panel-tag\">Storage drive</p>\n            <h3>Photos</h3>\n            <p class=\"panel-status\" id=\"photos-status\"></p>\n            <div class=\"bar\"><div class=\"bar-fill\" id=\"photos-bar\"></div></div>\n            <div class=\"panel-actions\" id=\"photos-actions\"></div>\n          </section>\n          <section class=\"panel\" id=\"panel-send\">\n            <p class=\"panel-tag\">Network</p>\n            <h3>Sending</h3>\n            <p class=\"panel-status\" id=\"send-status\"></p>\n            <div class=\"panel-actions\" id=\"send-actions\"></div>\n          </section>\n          <section class=\"panel\" id=\"panel-memory\">\n            <p class=\"panel-tag\">Memory</p>\n            <h3>Open in FieldVet</h3>\n            <p class=\"panel-status\" id=\"memory-status\"></p>\n            <div class=\"bar\"><div class=\"bar-fill\" id=\"memory-bar\"></div></div>\n            <div class=\"panel-actions\" id=\"memory-actions\"></div>\n          </section>\n        </div>\n      </section>\n\n      <section class=\"view\" id=\"view-activity\" hidden>\n        <div class=\"viewhead\">\n          <h2>Activity</h2>\n          <p class=\"where\">Where Amara's day actually went</p>\n        </div>\n        <div class=\"tally\" id=\"tally\"></div>\n        <div class=\"filters\" id=\"filters\" role=\"group\" aria-label=\"Show only one part of the tablet\"></div>\n        <ul class=\"log\" id=\"log\" aria-live=\"polite\"></ul>\n      </section>\n\n      <section class=\"view\" id=\"view-settings\" hidden>\n        <div class=\"viewhead\">\n          <h2>Settings</h2>\n          <p class=\"where\">Each change costs about 3 minutes</p>\n        </div>\n        <div class=\"settings-list\" id=\"settings-list\"></div>\n      </section>\n\n      <section class=\"view\" id=\"view-report\" hidden>\n        <div class=\"viewhead\">\n          <h2 id=\"report-headline\">Clinic Report</h2>\n          <p class=\"where\" id=\"report-sub\"></p>\n        </div>\n        <ul class=\"report-list\" id=\"report-list\"></ul>\n        <div class=\"report-notes\" id=\"report-notes\"></div>\n        <h3>Questions</h3>\n        <ol class=\"questions\" id=\"questions\"></ol>\n        <div class=\"actions\">\n          <button type=\"button\" class=\"btn btn-go\" id=\"again-btn\">Start the day over</button>\n        </div>\n      </section>\n\n    </main>\n\n    <nav class=\"tabbar\" aria-label=\"FieldVet sections\">\n      <button type=\"button\" class=\"tab\" data-tab=\"route\">Route</button>\n      <button type=\"button\" class=\"tab\" data-tab=\"activity\">Activity</button>\n      <button type=\"button\" class=\"tab\" data-tab=\"settings\">Settings</button>\n    </nav>\n\n  </div>\n</div>\n\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": ":root {\n  --purple-light: #E4E2F8;\n  --purple-mid: #ACA8EA;\n  --purple: #4C42CF;\n  --purple-dark: #1F1976;\n  --orange-light: #FFE3CE;\n  --orange: #F46800;\n  --orange-dark: #611D00;\n  --green-light: #CCF1D0;\n  --green: #34BD43;\n  --green-dark: #003F25;\n  --pink-light: #FBDAE8;\n  --pink: #E11970;\n  --pink-dark: #7D0C3D;\n  --ink: #17161C;\n  --ink-soft: #4A4857;\n  --line: #D6D4E0;\n  --bezel: #2A2833;\n  --tint: #F7F6FC;\n  --font-display: \"Space Grotesk\", \"Noto Sans\", system-ui, sans-serif;\n  --font-body: \"Geist\", \"Noto Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif;\n}\n\n* { box-sizing: border-box; }\n[hidden] { display: none !important; }\nhtml, body { height: 100%; }\n\nbody {\n  margin: 0;\n  padding: 8px;\n  background-color: #EFEEF6;\n  font-family: var(--font-body);\n  font-size: 15px;\n  color: var(--ink);\n  line-height: 1.45;\n}\n\n.sr-only {\n  position: absolute; width: 1px; height: 1px;\n  padding: 0; margin: -1px; overflow: hidden;\n  clip: rect(0 0 0 0); white-space: nowrap; border: 0;\n}\n\n.sprite { position: absolute; width: 0; height: 0; }\n\n.device {\n  max-width: 54rem;\n  margin-inline: auto;\n  background-color: var(--bezel);\n  border-radius: 16px;\n  padding: 9px;\n}\n\n.screen {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  height: min(38rem, calc(100dvh - 34px));\n  min-height: 24rem;\n  background-color: #FFFFFF;\n  border-radius: 9px;\n  overflow: hidden;\n}\n\n/* ---------- status bar ---------- */\n\n.statusbar {\n  display: flex; flex-wrap: wrap;\n  gap: 0.15rem 1rem;\n  padding: 0.4rem 0.75rem;\n  background-color: var(--purple-dark);\n  color: #FFFFFF;\n  flex: 0 0 auto;\n}\n\n.stat { display: flex; flex-direction: column; line-height: 1.15; }\n\n.stat-label {\n  font-size: 0.58rem; letter-spacing: 0.06em;\n  text-transform: uppercase; color: var(--purple-mid);\n}\n\n.stat-value { font-family: var(--font-display); font-weight: 700; font-size: 0.86rem; }\n.stat-value.warn { color: #FFC79E; }\n.stat-value.bad { color: #FFB3CF; }\n\n.procbar { flex: 0 0 auto; height: 4px; background-color: var(--purple-light); }\n.procbar-fill { height: 100%; width: 0; background-color: var(--orange); transition: width linear; }\n\n.cost-flash {\n  position: absolute;\n  inset-block-start: 3rem; inset-inline-end: 0.6rem;\n  background-color: var(--orange); color: #FFFFFF;\n  font-family: var(--font-display); font-weight: 700; font-size: 0.85rem;\n  padding: 0.25rem 0.7rem; border-radius: 7px;\n  z-index: 5; opacity: 0;\n  transition: opacity 180ms ease-out;\n}\n\n.cost-flash.show { opacity: 1; }\n\n@media (prefers-reduced-motion: reduce) {\n  .procbar-fill { transition: none; }\n  .cost-flash { transition: none; }\n}\n\n/* ---------- body ---------- */\n\n.body { flex: 1 1 auto; overflow-y: auto; overscroll-behavior: contain; }\n.view { padding: 0.65rem 0.8rem 0.9rem; }\n\n.viewhead {\n  display: flex; flex-wrap: wrap;\n  align-items: baseline; justify-content: space-between;\n  gap: 0.2rem 0.7rem;\n  margin-block-end: 0.45rem;\n}\n\nh2 { font-family: var(--font-display); font-size: 1.2rem; line-height: 1.1; color: var(--purple-dark); margin: 0; }\nh3 { font-family: var(--font-display); font-size: 0.95rem; color: var(--purple-dark); margin: 0 0 0.2rem; }\n.where { margin: 0; font-size: 0.82rem; color: var(--ink-soft); }\n\n.linkbtn {\n  font-family: var(--font-display); font-weight: 700; font-size: 0.82rem;\n  min-height: 32px; padding: 0.25rem 0.7rem;\n  border: 2px solid var(--purple); border-radius: 7px;\n  background-color: #FFFFFF; color: var(--purple-dark); cursor: pointer;\n}\n\n.amara {\n  margin: 0 0 0.6rem;\n  padding: 0.5rem 0.7rem;\n  border-inline-start: 4px solid var(--purple-mid);\n  background-color: var(--tint);\n  border-radius: 0 8px 8px 0;\n  font-size: 0.88rem;\n  font-style: italic;\n  color: var(--ink-soft);\n}\n\n/* ---------- alerts ---------- */\n\n.alert {\n  border-radius: 9px; padding: 0.55rem 0.75rem; margin-block-end: 0.6rem;\n  background-color: var(--pink-light);\n  border-inline-start: 5px solid var(--pink);\n  color: var(--pink-dark); font-weight: 600; font-size: 0.88rem;\n}\n\n.alert.soft {\n  background-color: var(--orange-light);\n  border-inline-start-color: var(--orange);\n  color: var(--orange-dark);\n}\n\n/* ---------- quadrants ---------- */\n\n.quad { display: grid; gap: 0.5rem; grid-template-columns: 1fr; }\n\n@media (min-width: 34rem) { .quad { grid-template-columns: 1fr 1fr; } }\n\n.panel {\n  display: flex; flex-direction: column;\n  border: 2px solid var(--line);\n  border-radius: 10px;\n  padding: 0.55rem 0.7rem 0.6rem;\n  background-color: #FFFFFF;\n}\n\n.panel.is-done { border-color: var(--green-dark); background-color: var(--green-light); }\n.panel.is-alert { border-color: var(--pink-dark); background-color: var(--pink-light); }\n.panel.is-warn { border-color: var(--orange-dark); background-color: var(--orange-light); }\n\n.panel-tag {\n  margin: 0 0 0.05rem;\n  font-family: var(--font-display);\n  font-size: 0.6rem; letter-spacing: 0.09em; text-transform: uppercase;\n  color: var(--cat-dark, #611D00);\n}\n\n.panel-status { margin: 0 0 0.4rem; font-size: 0.83rem; color: var(--ink-soft); }\n.panel-actions { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-block-start: auto; }\n\n.bar { height: 8px; border-radius: 4px; background-color: var(--purple-light); margin-block-end: 0.45rem; }\n.bar-fill { height: 100%; border-radius: 4px; background-color: var(--purple); }\n.bar-fill.warn { background-color: var(--orange); }\n.bar-fill.bad { background-color: var(--pink); }\n\n/* ---------- farm tiles ---------- */\n\n.tile-grid {\n  display: grid; gap: 0.5rem;\n  grid-template-columns: repeat(auto-fit, minmax(13.5rem, 1fr));\n  margin-block-end: 0.6rem;\n}\n\n.tile {\n  display: flex; align-items: center; gap: 0.6rem;\n  text-align: start; font: inherit; color: inherit;\n  border: 2px solid var(--line); border-radius: 10px;\n  background-color: #FFFFFF; padding: 0.45rem 0.6rem; cursor: pointer;\n}\n\n.tile.here { border-color: var(--purple); background-color: var(--purple-light); }\n.tile.done { border-color: var(--green-dark); background-color: var(--green-light); }\n\n.tile-icon {\n  flex: 0 0 auto; width: 40px; height: 40px;\n  border-radius: 9px;\n  background-color: var(--purple-light); color: var(--purple-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.tile.done .tile-icon { background-color: #FFFFFF; color: var(--green-dark); }\n.tile.here .tile-icon { background-color: #FFFFFF; color: var(--purple); }\n.tile-icon svg { width: 29px; height: 29px; fill: currentColor; }\n.tile-icon img { width: 32px; height: 32px; }\n\n.tile-text { display: flex; flex-direction: column; min-width: 0; gap: 0.03rem; }\n.tile-name { font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; color: var(--purple-dark); }\n.tile-meta { font-size: 0.73rem; color: var(--ink-soft); }\n.tile-state { font-size: 0.73rem; font-weight: 700; }\n.tile-state.s-none { color: var(--ink-soft); }\n.tile-state.s-wait { color: var(--orange-dark); }\n.tile-state.s-sent { color: var(--green-dark); }\n\n.sig { font-weight: 700; }\n.sig-strong { color: var(--green-dark); }\n.sig-weak { color: var(--orange-dark); }\n.sig-none { color: var(--pink-dark); }\n\n/* ---------- buttons ---------- */\n\n.actions { display: flex; flex-wrap: wrap; gap: 0.45rem; }\n\n.btn {\n  font-family: var(--font-display); font-weight: 700; font-size: 0.85rem;\n  min-height: 40px; padding: 0.4rem 0.8rem;\n  border-radius: 8px; border: 2px solid transparent; cursor: pointer;\n}\n\n.btn-lg { font-size: 0.92rem; min-height: 44px; padding: 0.5rem 1rem; }\n.btn-go { background-color: var(--purple); color: #FFFFFF; }\n.btn-alt { background-color: #FFFFFF; color: var(--purple-dark); border-color: var(--purple); }\n.btn-warn { background-color: #FFFFFF; color: var(--orange-dark); border-color: var(--orange); }\n.btn:disabled { cursor: not-allowed; background-color: #EDECF3; color: #56545F; border-color: var(--line); }\n\n/* ---------- log ---------- */\n\n.log {\n  list-style: none; margin: 0; padding: 0;\n  border: 2px solid var(--line); border-radius: 9px; overflow: hidden;\n}\n\n\n/* ---------- activity: category colors ---------- */\n\n.cat-processor { --cat: #4C42CF; --cat-dark: #1F1976; --cat-light: #E4E2F8; }\n.cat-storage   { --cat: #0099F3; --cat-dark: #06338D; --cat-light: #D5EFFF; }\n.cat-network   { --cat: #F46800; --cat-dark: #611D00; --cat-light: #FFE3CE; }\n.cat-memory    { --cat: #E11970; --cat-dark: #7D0C3D; --cat-light: #FBDAE8; }\n.cat-travel    { --cat: #8A879A; --cat-dark: #4A4857; --cat-light: #EFEEF6; }\n.cat-settings  { --cat: #8A879A; --cat-dark: #4A4857; --cat-light: #EFEEF6; }\n\n/* ---------- tally ---------- */\n\n.tally {\n  display: grid; gap: 0.4rem;\n  grid-template-columns: repeat(auto-fit, minmax(8.2rem, 1fr));\n  margin-block-end: 0.55rem;\n}\n\n.tally-card {\n  border: 2px solid var(--line);\n  border-radius: 9px;\n  padding: 0.4rem 0.55rem;\n  background-color: #FFFFFF;\n}\n\n.tally-card.is-top { border-color: var(--cat-dark); background-color: var(--cat-light); }\n\n.tally-head { display: flex; align-items: center; gap: 0.35rem; margin-block-end: 0.15rem; }\n\n.tally-dot {\n  width: 20px; height: 20px; flex: 0 0 auto;\n  border-radius: 5px;\n  background-color: var(--cat-light);\n  color: var(--cat-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.tally-dot svg { width: 14px; height: 14px; fill: currentColor; }\n.tally-name { font-family: var(--font-display); font-weight: 700; font-size: 0.74rem; color: var(--cat-dark); }\n.tally-val { font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; color: var(--ink); }\n.tally-sub { font-size: 0.7rem; color: var(--ink-soft); }\n.tally-flag { font-size: 0.66rem; font-weight: 700; color: var(--cat-dark); text-transform: uppercase; letter-spacing: 0.05em; }\n\n/* ---------- filters ---------- */\n\n.filters { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-block-end: 0.5rem; }\n\n.filter {\n  font-family: var(--font-display); font-weight: 700; font-size: 0.75rem;\n  min-height: 32px; padding: 0.2rem 0.6rem;\n  border-radius: 7px; border: 2px solid var(--line);\n  background-color: #FFFFFF; color: var(--ink-soft); cursor: pointer;\n}\n\n.filter[aria-pressed=\"true\"] { background-color: var(--purple-dark); border-color: var(--purple-dark); color: #FFFFFF; }\n.filter:focus-visible { outline: 3px solid var(--orange); outline-offset: 2px; }\n\n/* ---------- log rows ---------- */\n\n.log-row {\n  display: flex; align-items: flex-start; gap: 0.5rem;\n  padding: 0.3rem 0.35rem;\n  border-block-end: 1px solid var(--line);\n  border-inline-start: 4px solid var(--cat);\n  background-color: #FFFFFF;\n}\n\n.log-row:last-child { border-block-end: none; }\n.log-row.is-heavy { background-color: var(--cat-light); }\n\n.log-mark {\n  flex: 0 0 auto; width: 22px; height: 22px;\n  border-radius: 5px;\n  background-color: var(--cat-light); color: var(--cat-dark);\n  display: flex; align-items: center; justify-content: center;\n}\n\n.log-row.is-heavy .log-mark { background-color: #FFFFFF; }\n.log-mark svg { width: 15px; height: 15px; fill: currentColor; }\n\n.log-body { flex: 1 1 auto; min-width: 0; }\n.log-text { font-size: 0.83rem; }\n.log-row.is-heavy .log-text { font-weight: 600; color: var(--cat-dark); }\n\n.log-tag {\n  display: inline-block; margin-inline-start: 0.3rem;\n  font-family: var(--font-display); font-size: 0.6rem; font-weight: 700;\n  text-transform: uppercase; letter-spacing: 0.05em;\n  padding: 0.02rem 0.3rem; border-radius: 4px;\n  background-color: var(--purple-light); color: var(--purple-dark);\n}\n\n.log-cost { flex: 0 0 auto; display: flex; gap: 0.25rem; align-items: flex-start; }\n\n.cost-chip {\n  font-family: var(--font-display); font-size: 0.68rem; font-weight: 700;\n  padding: 0.08rem 0.35rem; border-radius: 5px;\n  border: 1px solid var(--line); background-color: #FFFFFF; color: var(--ink-soft);\n  white-space: nowrap;\n}\n\n.log-row.is-heavy .cost-chip { border-color: var(--cat-dark); background-color: var(--cat-dark); color: #FFFFFF; }\n\n.log-empty { padding: 0.5rem; font-size: 0.85rem; color: var(--ink-soft); }\n\n/* ---------- settings ---------- */\n\n.settings-list { display: grid; gap: 0.45rem; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); }\n.setting { border: 2px solid var(--line); border-radius: 9px; padding: 0.5rem 0.7rem; }\n.setting-name { font-family: var(--font-display); font-weight: 700; font-size: 0.88rem; margin: 0 0 0.1rem; }\n.setting-why { margin: 0 0 0.4rem; font-size: 0.78rem; color: var(--ink-soft); }\n.choices { display: flex; flex-wrap: wrap; gap: 0.35rem; }\n\n.choice {\n  font-family: var(--font-display); font-weight: 700; font-size: 0.8rem;\n  min-height: 34px; padding: 0.25rem 0.65rem;\n  border-radius: 7px; border: 2px solid var(--line);\n  background-color: #FFFFFF; color: var(--ink-soft); cursor: pointer;\n}\n\n.choice[aria-pressed=\"true\"] { background-color: var(--purple); border-color: var(--purple); color: #FFFFFF; }\n\n/* ---------- report ---------- */\n\n.report-list { list-style: none; margin: 0 0 0.6rem; padding: 0; display: grid; gap: 0.32rem; }\n\n.report-list li {\n  display: flex; flex-wrap: wrap; gap: 0.2rem 0.7rem;\n  justify-content: space-between; align-items: baseline;\n  border-radius: 9px; padding: 0.42rem 0.7rem;\n  border: 2px solid var(--line); font-size: 0.88rem;\n}\n\n.report-list li.met { background-color: var(--green-light); border-color: var(--green-dark); }\n.report-list li.unmet { background-color: var(--pink-light); border-color: var(--pink-dark); }\n\n.rep-name { font-weight: 600; }\n.rep-val { font-family: var(--font-display); font-weight: 700; }\nli.met .rep-val { color: var(--green-dark); }\nli.unmet .rep-val { color: var(--pink-dark); }\n\n.report-notes { display: grid; gap: 0.32rem; }\n\n.report-note {\n  background-color: var(--orange-light);\n  border-inline-start: 5px solid var(--orange);\n  border-radius: 9px; padding: 0.45rem 0.7rem;\n  color: var(--orange-dark); font-size: 0.85rem;\n}\n\n.questions { padding-inline-start: 1.2rem; margin: 0 0 0.7rem; font-size: 0.88rem; }\n.questions li { margin-block-end: 0.3rem; }\n\n/* ---------- tab bar ---------- */\n\n.tabbar { display: flex; flex: 0 0 auto; border-block-start: 2px solid var(--line); background-color: var(--tint); }\n\n.tab {\n  flex: 1 1 0;\n  font-family: var(--font-display); font-weight: 700; font-size: 0.86rem;\n  min-height: 44px; padding: 0.35rem;\n  border: none; border-block-start: 4px solid transparent;\n  background-color: transparent; color: var(--ink-soft); cursor: pointer;\n}\n\n.tab[aria-current=\"page\"] { color: var(--purple-dark); border-block-start-color: var(--purple); background-color: #FFFFFF; }\n\n/* ---------- focus ---------- */\n\n.btn:focus-visible,\n.choice:focus-visible,\n.tab:focus-visible,\n.tile:focus-visible,\n.linkbtn:focus-visible {\n  outline: 3px solid var(--orange);\n  outline-offset: 2px;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "const DAY_START = 420;\nconst DAY_END = 1020;\nconst STORAGE_CAP = 100;\nconst OLD_RECORD_UNITS = 45;\nconst DRIVE_MINUTES = 30;\nconst SETTING_MINUTES = 3;\nconst ARCHIVE_MINUTES = 5;\nconst CLOSE_MINUTES = 2;\nconst AUTOCLOSE_MINUTES = 3;\nconst MEMORY_CAP = 6;\nconst HEAVY_MINUTES = 20;\nconst HEAVY_BATTERY = 8;\n\nconst CATEGORIES = [\n  { id: 'processor', name: 'Processor', icon: 'c-processor', component: true },\n  { id: 'storage', name: 'Storage', icon: 'c-storage', component: true },\n  { id: 'network', name: 'Network', icon: 'c-network', component: true },\n  { id: 'memory', name: 'Memory', icon: 'c-memory', component: true },\n  { id: 'travel', name: 'Driving', icon: 'c-travel', component: false },\n  { id: 'settings', name: 'Setup', icon: 'c-settings', component: false }\n];\n\n/* To use artwork, set image to a filename uploaded to the Web Lab project,\n   for example image: 'farm-nkemdi.png'. Leave it null to use the built-in icon. */\nconst FARMS = [\n  {\n    id: 'nkemdi', name: 'Nkemdi Dairy', signal: 'strong', icon: 'i-cow', image: null,\n    note: 'Swollen hock on one of the milking cows. First stop of the day, and the signal out here is solid.'\n  },\n  {\n    id: 'halvorsen', name: 'Halvorsen Sheep', signal: 'weak', icon: 'i-sheep', image: null,\n    note: 'Three ewes due for their shots. Easy work, but I only ever get a bar or two in this yard.'\n  },\n  {\n    id: 'rocke', name: 'Rocke Ridge Cattle', signal: 'none', icon: 'i-cattle', image: null,\n    note: 'A calf that will not nurse. This place sits down in a hollow. There has never been a signal here, not once.'\n  },\n  {\n    id: 'twocreeks', name: 'Two Creeks Goats', signal: 'weak', icon: 'i-goat', image: null,\n    note: 'A rash spreading along a goat\\u2019s back. The clinic really wants pictures of this one.'\n  },\n  {\n    id: 'bellweather', name: 'Bellweather Horses', signal: 'strong', icon: 'i-horse', image: null,\n    note: 'A cut above the knee on a gelding. Best signal on my whole route is right here in this driveway.'\n  },\n  {\n    id: 'sandhill', name: 'Sandhill Hogs', signal: 'weak', icon: 'i-hog', image: null,\n    note: 'A sow that has been off her feed two days. Signal comes and goes depending on where I stand.'\n  }\n];\n\nconst SETTINGS = [\n  { id: 'quality', name: 'Photo quality', why: 'Full photos show more detail. Reduced photos take less room and send faster.',\n    choices: [{ value: 'full', label: 'Full' }, { value: 'reduced', label: 'Reduced' }], start: 'full' },\n  { id: 'photoCount', name: 'Photos per animal', why: 'Three angles catch more. One angle catches less but costs less.',\n    choices: [{ value: 3, label: 'Three' }, { value: 1, label: 'One' }], start: 3 },\n  { id: 'autoSend', name: 'Sending records', why: 'Automatic means FieldVet tries the whole queue every time Amara arrives somewhere, signal or not.',\n    choices: [{ value: 'auto', label: 'Send automatically' }, { value: 'manual', label: 'Only when I say' }], start: 'auto' },\n  { id: 'autoClose', name: 'Finished records', why: 'Records left open stay loaded in memory and slow the app down.',\n    choices: [{ value: 'keep', label: 'Leave them open' }, { value: 'close', label: 'Close automatically' }], start: 'keep' },\n  { id: 'power', name: 'Power mode', why: 'Power saver stretches the battery by slowing the tablet down.',\n    choices: [{ value: 'normal', label: 'Normal' }, { value: 'saver', label: 'Power saver' }], start: 'normal' },\n  { id: 'archive', name: 'Records older than a month', why: 'Old records take up room on the drive. Moving them frees space but they leave the truck.',\n    choices: [{ value: 'tablet', label: 'Keep on the tablet' }, { value: 'clinic', label: 'Move to the clinic' }], start: 'tablet' }\n];\n\nconst QUESTIONS = [\n  'FieldVet got slower as the day went on. What was piling up in memory, and which setting stops it?',\n  'Sending failed at Rocke Ridge no matter what Amara did. Was that FieldVet\\u2019s fault? Explain what was really going on.',\n  'Which of the four parts of the tablet caused Amara the most trouble today, and how do you know?',\n  'Name one change that helped one thing and hurt another. Was it worth it for Amara?',\n  'Nothing on the tablet was broken today. So why did her day still fall apart?'\n];\n\nconst nf = new Intl.NumberFormat();\nconst pf = new Intl.NumberFormat(undefined, { style: 'percent', maximumFractionDigits: 0 });\nconst df = new Intl.NumberFormat(undefined, { minimumFractionDigits: 1, maximumFractionDigits: 1 });\nconst tf = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });\n\nlet state;\nlet busy = false;\nconst els = {};\n\n/* ================= state ================= */\n\nfunction freshState() {\n  const settings = {};\n  SETTINGS.forEach(function (s) { settings[s.id] = s.start; });\n  const farms = {};\n  FARMS.forEach(function (f) { farms[f.id] = { written: false, closed: false, photos: 'none', sent: false }; });\n  return {\n    view: 'route', settings: settings, farms: farms, at: null,\n    clock: DAY_START, battery: 100, photoUnits: 0,\n    photoScores: [], log: [], over: false, endReason: null, missedHistory: false,\n    filter: 'all'\n  };\n}\n\nfunction farmById(id) { for (let i = 0; i < FARMS.length; i++) if (FARMS[i].id === id) return FARMS[i]; return null; }\nfunction currentSignal() { return state.at ? farmById(state.at).signal : 'none'; }\n\nfunction openRecords() {\n  let n = 0;\n  FARMS.forEach(function (f) { const s = state.farms[f.id]; if (s.written && !s.closed) n += 1; });\n  return n;\n}\n\nfunction queued() {\n  return FARMS.filter(function (f) { const s = state.farms[f.id]; return s.written && !s.sent; });\n}\n\nfunction storageUsed() {\n  return (state.settings.archive === 'clinic' ? 0 : OLD_RECORD_UNITS) + state.photoUnits;\n}\n\nfunction memoryMultiplier() { return 1 + openRecords() * 0.3; }\nfunction saverMultiplier() { return state.settings.power === 'saver' ? 1.5 : 1; }\nfunction minuteMultiplier() { return memoryMultiplier() * saverMultiplier(); }\n\n/* Charges a task's base cost to the part doing the work, then bills the\n   slowdown to whatever actually caused it. */\nfunction spendTask(baseMinutes, baseBattery, cat, text) {\n  const mem = memoryMultiplier();\n  const sav = saverMultiplier();\n  const bMult = batteryMultiplier();\n\n  const baseCost = spend(baseMinutes, baseBattery * bMult);\n  addLog(text, cat, baseCost);\n\n  const memMin = baseMinutes * (mem - 1);\n  if (Math.round(memMin) >= 3) {\n    const c = spend(memMin, baseBattery * (mem - 1) * bMult);\n    addLog(`Waiting on ${nf.format(openRecords())} open records slowed that down.`, 'memory', c);\n  }\n  const savMin = baseMinutes * mem * (sav - 1);\n  if (Math.round(savMin) >= 3) {\n    const c = spend(savMin, 0);\n    addLog('Power saver made that slower.', 'settings', c);\n  }\n  return { minutes: Math.round(baseMinutes * mem * sav), battery: baseCost.battery };\n}\n\nfunction batteryMultiplier() { return state.settings.power === 'saver' ? 0.6 : 1; }\nfunction photoUnitSize() { return state.settings.quality === 'full' ? 5 : 1.7; }\nfunction photoSetUnits() { return state.settings.photoCount * photoUnitSize(); }\nfunction uploadSizeFactor() { return (state.settings.photoCount / 3) * (state.settings.quality === 'full' ? 1 : 0.4); }\n\nfunction photoScore() {\n  const full = state.settings.quality === 'full';\n  if (full && state.settings.photoCount === 3) return 100;\n  if (full) return 70;\n  if (state.settings.photoCount === 3) return 55;\n  return 25;\n}\n\n/* ================= costs ================= */\n\nfunction spend(minutes, batteryPercent) {\n  const m = Math.round(minutes);\n  const b = Math.round(batteryPercent);\n  state.clock += m;\n  state.battery -= b;\n  if (state.battery < 0) state.battery = 0;\n  return { minutes: m, battery: b };\n}\n\nfunction addLog(text, cat, cost, auto) {\n  state.log.push({\n    text: text,\n    cat: cat || 'settings',\n    minutes: cost ? cost.minutes : 0,\n    battery: cost ? cost.battery : 0,\n    auto: !!auto\n  });\n}\n\nfunction logIndexOfLast(cat) {\n  for (let i = state.log.length - 1; i >= 0; i--) if (state.log[i].cat === cat) return i;\n  return state.log.length - 1;\n}\n\nfunction isHeavy(entry) {\n  return entry.minutes >= HEAVY_MINUTES || entry.battery >= HEAVY_BATTERY;\n}\n\nfunction categoryById(id) {\n  for (let i = 0; i < CATEGORIES.length; i++) if (CATEGORIES[i].id === id) return CATEGORIES[i];\n  return CATEGORIES[CATEGORIES.length - 1];\n}\n\nfunction checkDayOver() {\n  if (state.over) return true;\n  if (state.battery <= 0) { state.over = true; state.endReason = 'battery'; return true; }\n  if (state.clock >= DAY_END) { state.over = true; state.endReason = 'clock'; return true; }\n  return false;\n}\n\n/* ================= sending ================= */\n\nfunction attemptSend(records, source) {\n  if (records.length === 0) return null;\n  const sig = currentSignal();\n  const sf = uploadSizeFactor();\n  const mult = minuteMultiplier();\n  const bMult = batteryMultiplier();\n  const n = records.length;\n  let cost;\n\n  const auto = source === 'auto';\n  if (sig === 'strong') {\n    cost = spend(3 * n * sf, 1.5 * n * sf);\n    records.forEach(function (f) { state.farms[f.id].sent = true; });\n    addLog(`Sent ${nf.format(n)} records to the clinic on a strong signal.`, 'network', cost, auto);\n  } else if (sig === 'weak') {\n    records.forEach(function (f) { state.farms[f.id].sent = true; });\n    cost = spendTask(16 * n * sf, 10 * n * sf, 'network',\n      `The signal was weak. Sending ${nf.format(n)} records was slow.`);\n    if (auto) state.log[logIndexOfLast('network')].auto = true;\n  } else {\n    cost = spendTask(11 * n, 13 * n, 'network',\n      `No signal. FieldVet retried ${nf.format(n)} records and sent nothing.`);\n    if (auto) state.log[logIndexOfLast('network')].auto = true;\n  }\n  return cost;\n}\n\nfunction autoSendSweep() {\n  if (state.settings.autoSend !== 'auto') return null;\n  return attemptSend(queued(), 'auto');\n}\n\n/* ================= actions ================= */\n\nfunction travelTo(id) {\n  const target = farmById(id);\n  const cost = spend(DRIVE_MINUTES, 1 * batteryMultiplier());\n  state.at = id;\n  addLog(`Drove to ${target.name}.`, 'travel', cost);\n  autoSendSweep();\n  state.view = 'farm';\n  return cost;\n}\n\nfunction writeRecord() {\n  const f = farmById(state.at);\n  state.farms[f.id].written = true;\n  const cost = spendTask(32, 6, 'processor',\n    `Treated the animal and wrote the record at ${f.name}.`);\n  if (state.settings.autoClose === 'close') {\n    const closeCost = spend(AUTOCLOSE_MINUTES, 0);\n    state.farms[f.id].closed = true;\n    addLog('FieldVet closed the record automatically.', 'memory', closeCost, true);\n  }\n  autoSendSweep();\n  return cost;\n}\n\nfunction takePhotos() {\n  const units = photoSetUnits();\n  const f = farmById(state.at);\n  if (storageUsed() + units > STORAGE_CAP) {\n    state.farms[f.id].photos = 'blocked';\n    addLog('The photos did not save. The drive is full.', 'storage', null);\n    return null;\n  }\n  state.photoUnits += units;\n  state.farms[f.id].photos = 'taken';\n  state.photoScores.push(photoScore());\n  const cost = spendTask(state.settings.photoCount, state.settings.photoCount, 'storage',\n    `Photographed the animal. The drive is now ${pf.format(storageUsed() / 100)} full.`);\n  return cost;\n}\n\nfunction skipPhotos() {\n  const f = farmById(state.at);\n  state.farms[f.id].photos = 'skipped';\n  addLog(`Left ${f.name} with no photos. The clinic will not see this animal.`, 'storage', null);\n  return null;\n}\n\nfunction closeRecord() {\n  const cost = spend(CLOSE_MINUTES, 0);\n  state.farms[state.at].closed = true;\n  addLog(`Closed the record. ${nf.format(openRecords())} records are still open.`, 'memory', cost);\n  return cost;\n}\n\nfunction closeAllRecords() {\n  const open = FARMS.filter(function (f) { const s = state.farms[f.id]; return s.written && !s.closed; });\n  if (open.length === 0) return null;\n  const cost = spend(CLOSE_MINUTES * open.length, 0);\n  open.forEach(function (f) { state.farms[f.id].closed = true; });\n  addLog(`Closed ${nf.format(open.length)} open records. The app should feel quicker now.`, 'memory', cost);\n  return cost;\n}\n\nfunction sendFromHere() { return attemptSend(queued(), 'manual'); }\n\nfunction endDay() {\n  if (state.at) {\n    const cost = spend(DRIVE_MINUTES, 1 * batteryMultiplier());\n    addLog('Drove back to the clinic.', 'travel', cost);\n  }\n  state.over = true;\n  if (!state.endReason) {\n    state.endReason = state.clock >= DAY_END ? 'clock' : 'finished';\n  }\n  state.view = 'report';\n  return null;\n}\n\n/* ================= processing ================= */\n\nfunction reducedMotion() {\n  return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);\n}\n\nfunction runAction(fn) {\n  if (busy || state.over) return;\n  const duration = reducedMotion() ? 0 : Math.min(700, Math.round(140 + (minuteMultiplier() - 1) * 380));\n  if (duration === 0) { applyAction(fn); return; }\n  busy = true;\n  els.procFill.style.transitionDuration = '0ms';\n  els.procFill.style.width = '0%';\n  window.setTimeout(function () {\n    els.procFill.style.transitionDuration = `${duration}ms`;\n    els.procFill.style.width = '100%';\n  }, 20);\n  window.setTimeout(function () {\n    els.procFill.style.transitionDuration = '0ms';\n    els.procFill.style.width = '0%';\n    busy = false;\n    applyAction(fn);\n  }, duration + 40);\n}\n\nfunction applyAction(fn) {\n  const cost = fn();\n  checkDayOver();\n  if (state.over && state.view !== 'report') state.view = 'report';\n  render();\n  flashCost(cost);\n  focusMain();\n}\n\nfunction flashCost(cost) {\n  if (!cost || cost.minutes <= 0) return;\n  els.costFlash.textContent = `${nf.format(cost.minutes)} min`;\n  els.costFlash.hidden = false;\n  window.setTimeout(function () { els.costFlash.classList.add('show'); }, 10);\n  window.setTimeout(function () {\n    els.costFlash.classList.remove('show');\n    window.setTimeout(function () { els.costFlash.hidden = true; }, 200);\n  }, 1000);\n}\n\n/* ================= small helpers ================= */\n\nfunction clockText() { return tf.format(new Date(2026, 0, 1, 0, Math.round(state.clock))); }\n\nfunction signalWord(sig) {\n  if (sig === 'strong') return 'Strong';\n  if (sig === 'weak') return 'Weak';\n  return 'None';\n}\n\nfunction processingWord() {\n  const m = minuteMultiplier();\n  if (m <= 1.15) return 'Fast';\n  if (m <= 1.6) return 'Slow';\n  if (m <= 2.2) return 'Very slow';\n  return 'Crawling';\n}\n\nfunction button(label, kind, handler) {\n  const b = document.createElement('button');\n  b.type = 'button';\n  b.className = `btn ${kind}`;\n  b.textContent = label;\n  b.addEventListener('click', handler);\n  return b;\n}\n\nfunction setBar(el, fraction, level) {\n  el.style.width = `${Math.max(0, Math.min(100, fraction * 100))}%`;\n  el.className = 'bar-fill' + (level ? ` ${level}` : '');\n}\n\n/* ================= status bar ================= */\n\nfunction renderStatus() {\n  const mult = minuteMultiplier();\n  els.clock.textContent = clockText();\n  els.battery.textContent = pf.format(state.battery / 100);\n  els.storage.textContent = pf.format(storageUsed() / 100);\n  els.signal.textContent = signalWord(currentSignal());\n  els.load.textContent = nf.format(openRecords());\n  els.proc.textContent = `${processingWord()} (${df.format(mult)}x)`;\n\n  els.battery.className = 'stat-value' + (state.battery <= 20 ? ' bad' : state.battery <= 40 ? ' warn' : '');\n  els.storage.className = 'stat-value' + (storageUsed() >= 90 ? ' bad' : storageUsed() >= 75 ? ' warn' : '');\n  els.load.className = 'stat-value' + (openRecords() >= 4 ? ' bad' : openRecords() >= 2 ? ' warn' : '');\n  els.proc.className = 'stat-value' + (mult > 1.6 ? ' bad' : mult > 1.15 ? ' warn' : '');\n  els.signal.className = 'stat-value' + (state.at && currentSignal() === 'none' ? ' bad' : state.at && currentSignal() === 'weak' ? ' warn' : '');\n}\n\n/* ================= route ================= */\n\nfunction buildIcon(farm) {\n  const box = document.createElement('span');\n  box.className = 'tile-icon';\n  if (farm.image) {\n    const img = document.createElement('img');\n    img.src = farm.image;\n    img.alt = '';\n    box.appendChild(img);\n  } else {\n    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');\n    svg.setAttribute('aria-hidden', 'true');\n    svg.setAttribute('focusable', 'false');\n    const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');\n    use.setAttribute('href', `#${farm.icon}`);\n    svg.appendChild(use);\n    box.appendChild(svg);\n  }\n  return box;\n}\n\nfunction renderRoute() {\n  els.routeWhere.textContent = state.at ? `At ${farmById(state.at).name}` : 'At the clinic';\n\n  const open = openRecords();\n  els.routeAlert.hidden = true;\n  els.routeAlert.className = 'alert';\n  if (open >= 3) {\n    els.routeAlert.className = 'alert soft';\n    els.routeAlert.textContent = `FieldVet is holding ${nf.format(open)} records open. Everything Amara does is taking longer than it did this morning.`;\n    els.routeAlert.hidden = false;\n  }\n\n  els.farmList.textContent = '';\n  FARMS.forEach(function (f) {\n    const s = state.farms[f.id];\n    const here = state.at === f.id;\n    const tile = document.createElement('button');\n    tile.type = 'button';\n    tile.className = 'tile' + (here ? ' here' : '') + (s.sent ? ' done' : '');\n    tile.appendChild(buildIcon(f));\n\n    const text = document.createElement('span');\n    text.className = 'tile-text';\n\n    const name = document.createElement('span');\n    name.className = 'tile-name';\n    name.textContent = f.name;\n\n    const meta = document.createElement('span');\n    meta.className = 'tile-meta';\n    const a = document.createElement('span');\n    a.textContent = here ? 'Here now' : `${nf.format(DRIVE_MINUTES)} min drive`;\n    const b = document.createElement('span');\n    b.className = `sig sig-${f.signal}`;\n    b.textContent = ` \\u00b7 ${signalWord(f.signal)} signal`;\n    meta.appendChild(a);\n    meta.appendChild(b);\n\n    const st = document.createElement('span');\n    if (!s.written) { st.className = 'tile-state s-none'; st.textContent = 'Not started'; }\n    else if (!s.sent) { st.className = 'tile-state s-wait'; st.textContent = 'Waiting to send'; }\n    else { st.className = 'tile-state s-sent'; st.textContent = 'Record sent'; }\n\n    text.appendChild(name);\n    text.appendChild(meta);\n    text.appendChild(st);\n    tile.appendChild(text);\n\n    if (here) {\n      tile.addEventListener('click', function () { state.view = 'farm'; render(); focusMain(); });\n    } else {\n      tile.addEventListener('click', function () { runAction(function () { return travelTo(f.id); }); });\n    }\n    els.farmList.appendChild(tile);\n  });\n\n  els.routeActions.textContent = '';\n  els.routeActions.appendChild(button('Return to the clinic and end the day', 'btn-warn btn-lg', function () {\n    runAction(endDay);\n  }));\n}\n\n/* ================= farm quadrants ================= */\n\nfunction renderFarm() {\n  const f = farmById(state.at);\n  const s = state.farms[f.id];\n  const mult = minuteMultiplier();\n\n  els.farmName.textContent = f.name;\n  els.farmNote.textContent = f.note;\n\n  els.farmAlert.hidden = true;\n  els.farmAlert.className = 'alert';\n  if (s.photos === 'blocked') {\n    els.farmAlert.textContent = 'The drive is full, so the photos did not save. Change something in Settings, or move on without photos.';\n    els.farmAlert.hidden = false;\n  }\n\n  /* --- Processor: the record --- */\n  els.panelRecord.className = 'panel cat-processor' + (s.written ? ' is-done' : '');\n  if (s.written) {\n    els.recordStatus.textContent = 'The record is written and saved.';\n  } else {\n    els.recordStatus.textContent = `Not written yet. At this speed it takes about ${nf.format(Math.round(32 * mult))} minutes.`;\n  }\n  els.recordActions.textContent = '';\n  if (!s.written) {\n    els.recordActions.appendChild(button('Treat and write the record', 'btn-go', function () { runAction(writeRecord); }));\n  }\n\n  /* --- Storage: photos --- */\n  const used = storageUsed();\n  const level = used >= 90 ? 'bad' : used >= 75 ? 'warn' : '';\n  els.panelPhotos.className = 'panel cat-storage' + (s.photos === 'taken' ? ' is-done' : s.photos === 'blocked' ? ' is-alert' : '');\n  setBar(els.photosBar, used / 100, level);\n  if (s.photos === 'taken') {\n    els.photosStatus.textContent = `Photos saved. The drive is ${pf.format(used / 100)} full.`;\n  } else if (s.photos === 'skipped') {\n    els.photosStatus.textContent = 'Amara moved on without photos here.';\n  } else if (s.photos === 'blocked') {\n    els.photosStatus.textContent = `The drive is ${pf.format(used / 100)} full. There is no room for these photos.`;\n  } else if (!s.written) {\n    els.photosStatus.textContent = `Write the record first. The drive is ${pf.format(used / 100)} full.`;\n  } else {\n    els.photosStatus.textContent = `${nf.format(state.settings.photoCount)} photos at ${state.settings.quality === 'full' ? 'full' : 'reduced'} quality. The drive is ${pf.format(used / 100)} full.`;\n  }\n  els.photosActions.textContent = '';\n  if (s.written && (s.photos === 'none' || s.photos === 'blocked')) {\n    els.photosActions.appendChild(button(s.photos === 'blocked' ? 'Try again' : 'Photograph the animal', 'btn-go', function () { runAction(takePhotos); }));\n    els.photosActions.appendChild(button('Move on without', 'btn-warn', function () { runAction(skipPhotos); }));\n  }\n\n  /* --- Network: sending --- */\n  const q = queued();\n  els.panelSend.className = 'panel cat-network' + (q.length === 0 && s.sent ? ' is-done' : f.signal === 'none' ? ' is-alert' : f.signal === 'weak' ? ' is-warn' : '');\n  if (f.signal === 'none') {\n    els.sendStatus.textContent = `No signal here. ${nf.format(q.length)} records are waiting.`;\n  } else if (q.length === 0) {\n    els.sendStatus.textContent = `Nothing waiting. The signal here is ${signalWord(f.signal).toLowerCase()}.`;\n  } else {\n    els.sendStatus.textContent = `${nf.format(q.length)} records waiting. The signal here is ${signalWord(f.signal).toLowerCase()}.`;\n  }\n  els.sendActions.textContent = '';\n  if (q.length > 0) {\n    els.sendActions.appendChild(button(`Send ${nf.format(q.length)} from here`, 'btn-go', function () { runAction(sendFromHere); }));\n  }\n\n  /* --- Memory: open records --- */\n  const open = openRecords();\n  const memLevel = open >= 4 ? 'bad' : open >= 2 ? 'warn' : '';\n  els.panelMemory.className = 'panel cat-memory' + (open >= 4 ? ' is-alert' : open >= 2 ? ' is-warn' : '');\n  setBar(els.memoryBar, open / MEMORY_CAP, memLevel);\n  els.memoryStatus.textContent = open === 0\n    ? 'Nothing is loaded in memory. FieldVet is running fast.'\n    : `${nf.format(open)} records are loaded in memory. FieldVet is running at ${df.format(mult)} times its normal speed.`;\n  els.memoryActions.textContent = '';\n  if (s.written && !s.closed) {\n    els.memoryActions.appendChild(button('Close this record', 'btn-alt', function () { runAction(closeRecord); }));\n  }\n  if (open > 1) {\n    els.memoryActions.appendChild(button(`Close all ${nf.format(open)}`, 'btn-alt', function () { runAction(closeAllRecords); }));\n  }\n}\n\n/* ================= activity ================= */\n\nfunction catIcon(iconId, cls) {\n  const box = document.createElement('span');\n  box.className = cls;\n  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');\n  svg.setAttribute('aria-hidden', 'true');\n  svg.setAttribute('focusable', 'false');\n  const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');\n  use.setAttribute('href', `#${iconId}`);\n  svg.appendChild(use);\n  box.appendChild(svg);\n  return box;\n}\n\nfunction totalsByCategory() {\n  const totals = {};\n  CATEGORIES.forEach(function (c) { totals[c.id] = { minutes: 0, battery: 0 }; });\n  state.log.forEach(function (e) {\n    if (!totals[e.cat]) return;\n    totals[e.cat].minutes += e.minutes;\n    totals[e.cat].battery += e.battery;\n  });\n  return totals;\n}\n\nfunction renderTally() {\n  const totals = totalsByCategory();\n  const components = CATEGORIES.filter(function (c) { return c.component; });\n\n  /* Rank on how much of each scarce resource a part ate, not raw minutes:\n     a full day is 600 minutes and the battery is only 100. */\n  let topId = null;\n  let topScore = 0;\n  components.forEach(function (c) {\n    const score = totals[c.id].minutes / (DAY_END - DAY_START) + totals[c.id].battery / 100;\n    if (score > topScore) { topScore = score; topId = c.id; }\n  });\n\n  const cards = components.slice();\n  cards.push({ id: 'travel', name: 'Driving and setup', icon: 'c-travel', component: false });\n\n  els.tally.textContent = '';\n  cards.forEach(function (c) {\n    const mins = c.id === 'travel'\n      ? totals.travel.minutes + totals.settings.minutes\n      : totals[c.id].minutes;\n    const batt = c.id === 'travel'\n      ? totals.travel.battery + totals.settings.battery\n      : totals[c.id].battery;\n\n    const card = document.createElement('div');\n    card.className = `tally-card cat-${c.id}` + (c.id === topId ? ' is-top' : '');\n\n    const head = document.createElement('div');\n    head.className = 'tally-head';\n    head.appendChild(catIcon(c.icon, 'tally-dot'));\n    const nm = document.createElement('span');\n    nm.className = 'tally-name';\n    nm.textContent = c.name;\n    head.appendChild(nm);\n\n    const val = document.createElement('p');\n    val.className = 'tally-val';\n    val.textContent = `${nf.format(mins)} min`;\n\n    const sub = document.createElement('p');\n    sub.className = 'tally-sub';\n    sub.textContent = `${pf.format(batt / 100)} of the battery`;\n\n    card.appendChild(head);\n    card.appendChild(val);\n    card.appendChild(sub);\n\n    if (c.id === topId) {\n      const flag = document.createElement('p');\n      flag.className = 'tally-flag';\n      flag.textContent = 'Biggest cost';\n      card.appendChild(flag);\n    }\n    els.tally.appendChild(card);\n  });\n}\n\nfunction renderFilters() {\n  els.filters.textContent = '';\n  const options = [{ id: 'all', name: 'Everything' }].concat(\n    CATEGORIES.filter(function (c) { return c.component; })\n  );\n  options.forEach(function (opt) {\n    const b = document.createElement('button');\n    b.type = 'button';\n    b.className = 'filter';\n    b.textContent = opt.name;\n    b.setAttribute('aria-pressed', state.filter === opt.id ? 'true' : 'false');\n    b.addEventListener('click', function () {\n      state.filter = opt.id;\n      renderActivity();\n      const again = els.filters.querySelector(`[data-filter=\"${opt.id}\"]`);\n      if (again) again.focus();\n    });\n    b.dataset.filter = opt.id;\n    els.filters.appendChild(b);\n  });\n}\n\nfunction renderActivity() {\n  renderTally();\n  renderFilters();\n\n  const rows = state.log.filter(function (e) {\n    return state.filter === 'all' || e.cat === state.filter;\n  });\n\n  els.log.textContent = '';\n  if (rows.length === 0) {\n    const li = document.createElement('li');\n    li.className = 'log-empty';\n    li.textContent = 'Nothing in this part of the tablet yet.';\n    els.log.appendChild(li);\n    return;\n  }\n\n  rows.forEach(function (entry) {\n    const cat = categoryById(entry.cat);\n    const heavy = isHeavy(entry);\n    const li = document.createElement('li');\n    li.className = `log-row cat-${cat.id}` + (heavy ? ' is-heavy' : '');\n\n    li.appendChild(catIcon(cat.icon, 'log-mark'));\n\n    const bodyWrap = document.createElement('span');\n    bodyWrap.className = 'log-body';\n\n    const label = document.createElement('span');\n    label.className = 'sr-only';\n    label.textContent = `${cat.name}. `;\n    bodyWrap.appendChild(label);\n\n    const txt = document.createElement('span');\n    txt.className = 'log-text';\n    txt.textContent = entry.text;\n    bodyWrap.appendChild(txt);\n\n    if (entry.auto) {\n      const tag = document.createElement('span');\n      tag.className = 'log-tag';\n      tag.textContent = 'Automatic';\n      bodyWrap.appendChild(tag);\n    }\n    li.appendChild(bodyWrap);\n\n    const cost = document.createElement('span');\n    cost.className = 'log-cost';\n    if (entry.minutes > 0) {\n      const cm = document.createElement('span');\n      cm.className = 'cost-chip';\n      cm.textContent = `${nf.format(entry.minutes)} min`;\n      cost.appendChild(cm);\n    }\n    if (entry.battery > 0) {\n      const cb = document.createElement('span');\n      cb.className = 'cost-chip';\n      cb.textContent = pf.format(entry.battery / 100);\n      cost.appendChild(cb);\n    }\n    li.appendChild(cost);\n\n    els.log.appendChild(li);\n  });\n}\n\n/* ================= settings ================= */\n\nfunction renderSettings() {\n  els.settingsList.textContent = '';\n  SETTINGS.forEach(function (setting) {\n    const box = document.createElement('div');\n    box.className = 'setting';\n\n    const name = document.createElement('p');\n    name.className = 'setting-name';\n    name.textContent = setting.name;\n\n    const why = document.createElement('p');\n    why.className = 'setting-why';\n    why.textContent = setting.why;\n\n    const group = document.createElement('div');\n    group.className = 'choices';\n    group.setAttribute('role', 'group');\n    group.setAttribute('aria-label', setting.name);\n\n    setting.choices.forEach(function (choice) {\n      const b = document.createElement('button');\n      b.type = 'button';\n      b.className = 'choice';\n      b.textContent = choice.label;\n      b.setAttribute('aria-pressed', state.settings[setting.id] === choice.value ? 'true' : 'false');\n      b.addEventListener('click', function () { changeSetting(setting.id, choice.value); });\n      group.appendChild(b);\n    });\n\n    box.appendChild(name);\n    box.appendChild(why);\n    box.appendChild(group);\n    els.settingsList.appendChild(box);\n  });\n}\n\nfunction changeSetting(id, value) {\n  if (busy || state.over) return;\n  if (state.settings[id] === value) return;\n  state.settings[id] = value;\n  let minutes = SETTING_MINUTES;\n  if (id === 'archive') minutes += ARCHIVE_MINUTES;\n  spend(minutes, 0);\n  addLog('Changed a FieldVet setting.', 'settings', { minutes: minutes, battery: 0 });\n  if (id === 'archive' && value === 'clinic') state.missedHistory = true;\n  if (id === 'autoClose' && value === 'close') closeAllRecords();\n  if (checkDayOver()) state.view = 'report';\n  render();\n}\n\n/* ================= report ================= */\n\nfunction photoAverage() {\n  if (state.photoScores.length === 0) return 0;\n  let t = 0;\n  state.photoScores.forEach(function (n) { t += n; });\n  return Math.round(t / state.photoScores.length);\n}\n\nfunction buildReport() {\n  const sent = FARMS.filter(function (f) { return state.farms[f.id].sent; }).length;\n  const photoFarms = FARMS.filter(function (f) { return state.farms[f.id].photos === 'taken'; }).length;\n  const avg = photoAverage();\n\n  const rows = [\n    { name: 'Records at the clinic today', value: `${nf.format(sent)} of ${nf.format(FARMS.length)}`, met: sent === FARMS.length },\n    { name: 'Amara finished her route', value: state.endReason === 'finished' ? `Home at ${clockText()}` : 'Route not finished', met: state.endReason === 'finished' },\n    { name: 'Battery left at the end', value: pf.format(state.battery / 100), met: state.battery > 0 },\n    { name: 'Farms with photos', value: `${nf.format(photoFarms)} of ${nf.format(FARMS.length)}`, met: photoFarms >= 5 },\n    { name: 'How useful the photos were', value: `${nf.format(avg)} out of 100`, met: avg >= 50 }\n  ];\n\n  const passed = rows.every(function (r) { return r.met; });\n  els.reportHeadline.textContent = passed ? 'Amara made it through the day' : 'Amara did not make it through the day';\n\n  if (state.endReason === 'battery') {\n    els.reportSub.textContent = `The tablet died at ${clockText()} with farms still left.`;\n  } else if (state.endReason === 'clock') {\n    els.reportSub.textContent = `It hit ${clockText()} and Amara still had farms left.`;\n  } else if (passed) {\n    els.reportSub.textContent = 'Everything reached the clinic and the photos were worth taking.';\n  } else {\n    els.reportSub.textContent = 'She got home, but the clinic did not get everything it needed.';\n  }\n\n  els.reportList.textContent = '';\n  rows.forEach(function (row) {\n    const li = document.createElement('li');\n    li.className = row.met ? 'met' : 'unmet';\n    const n = document.createElement('span');\n    n.className = 'rep-name';\n    n.textContent = row.name;\n    const v = document.createElement('span');\n    v.className = 'rep-val';\n    v.textContent = row.met ? row.value : `${row.value} (not enough)`;\n    li.appendChild(n);\n    li.appendChild(v);\n    els.reportList.appendChild(li);\n  });\n\n  els.reportNotes.textContent = '';\n  const notes = [];\n  const skipped = FARMS.filter(function (f) {\n    const p = state.farms[f.id].photos;\n    return p === 'skipped' || p === 'blocked';\n  }).length;\n  if (state.missedHistory) {\n    notes.push('A farmer asked about an animal Amara treated last spring. The old records were back at the clinic, so she had to call in.');\n  }\n  if (state.settings.quality === 'reduced' && state.settings.photoCount === 1) {\n    notes.push('The clinic could barely use the photos. One low quality picture per animal was not enough to see anything.');\n  }\n  if (state.settings.power === 'saver') {\n    notes.push('Power saver stretched the battery, but every single thing Amara did on the tablet took longer.');\n  }\n  if (skipped > 0) {\n    notes.push(`Amara left ${nf.format(skipped)} farms without photos because the drive was full.`);\n  }\n  if (openRecords() >= 4) {\n    notes.push(`She finished with ${nf.format(openRecords())} records still open in FieldVet.`);\n  }\n  notes.forEach(function (text) {\n    const p = document.createElement('p');\n    p.className = 'report-note';\n    p.textContent = text;\n    els.reportNotes.appendChild(p);\n  });\n\n  els.questions.textContent = '';\n  QUESTIONS.forEach(function (q) {\n    const li = document.createElement('li');\n    li.textContent = q;\n    els.questions.appendChild(li);\n  });\n}\n\n/* ================= views ================= */\n\nfunction render() {\n  renderStatus();\n  Object.keys(els.views).forEach(function (key) { els.views[key].hidden = key !== state.view; });\n  if (state.view === 'route') renderRoute();\n  if (state.view === 'farm') renderFarm();\n  if (state.view === 'activity') renderActivity();\n  if (state.view === 'settings') renderSettings();\n  if (state.view === 'report') buildReport();\n\n  els.tabs.forEach(function (tab) {\n    const routeish = state.view === 'route' || state.view === 'farm';\n    const active = routeish ? tab.dataset.tab === 'route' : tab.dataset.tab === state.view;\n    if (active) tab.setAttribute('aria-current', 'page');\n    else tab.removeAttribute('aria-current');\n  });\n}\n\nfunction focusMain() {\n  const view = els.views[state.view];\n  if (!view) return;\n  const first = view.querySelector('.panel-actions .btn') || view.querySelector('.btn') || view.querySelector('button');\n  if (first) first.focus();\n}\n\nfunction goTab(name) {\n  if (busy || state.over) return;\n  state.view = name;\n  render();\n  focusMain();\n}\n\nfunction restart() {\n  state = freshState();\n  addLog('Amara left the clinic at 7:00 AM and opened FieldVet.', 'travel', null);\n  render();\n  focusMain();\n}\n\n/* ================= boot ================= */\n\nfunction cacheElements() {\n  els.clock = document.getElementById('stat-clock');\n  els.battery = document.getElementById('stat-battery');\n  els.storage = document.getElementById('stat-storage');\n  els.signal = document.getElementById('stat-signal');\n  els.load = document.getElementById('stat-load');\n  els.proc = document.getElementById('stat-proc');\n  els.procFill = document.getElementById('procbar-fill');\n  els.costFlash = document.getElementById('cost-flash');\n  els.views = {\n    route: document.getElementById('view-route'),\n    farm: document.getElementById('view-farm'),\n    activity: document.getElementById('view-activity'),\n    settings: document.getElementById('view-settings'),\n    report: document.getElementById('view-report')\n  };\n  els.routeWhere = document.getElementById('route-where');\n  els.routeAlert = document.getElementById('route-alert');\n  els.farmList = document.getElementById('farm-list');\n  els.routeActions = document.getElementById('route-actions');\n  els.farmName = document.getElementById('farm-name');\n  els.farmNote = document.getElementById('farm-note');\n  els.farmAlert = document.getElementById('farm-alert');\n  els.panelRecord = document.getElementById('panel-record');\n  els.recordStatus = document.getElementById('record-status');\n  els.recordActions = document.getElementById('record-actions');\n  els.panelPhotos = document.getElementById('panel-photos');\n  els.photosStatus = document.getElementById('photos-status');\n  els.photosBar = document.getElementById('photos-bar');\n  els.photosActions = document.getElementById('photos-actions');\n  els.panelSend = document.getElementById('panel-send');\n  els.sendStatus = document.getElementById('send-status');\n  els.sendActions = document.getElementById('send-actions');\n  els.panelMemory = document.getElementById('panel-memory');\n  els.memoryStatus = document.getElementById('memory-status');\n  els.memoryBar = document.getElementById('memory-bar');\n  els.memoryActions = document.getElementById('memory-actions');\n  els.log = document.getElementById('log');\n  els.tally = document.getElementById('tally');\n  els.filters = document.getElementById('filters');\n  els.settingsList = document.getElementById('settings-list');\n  els.reportHeadline = document.getElementById('report-headline');\n  els.reportSub = document.getElementById('report-sub');\n  els.reportList = document.getElementById('report-list');\n  els.reportNotes = document.getElementById('report-notes');\n  els.questions = document.getElementById('questions');\n  els.tabs = Array.prototype.slice.call(document.querySelectorAll('.tab'));\n}\n\nfunction bindEvents() {\n  document.getElementById('again-btn').addEventListener('click', restart);\n  document.getElementById('back-btn').addEventListener('click', function () {\n    if (busy || state.over) return;\n    state.view = 'route';\n    render();\n    focusMain();\n  });\n  els.tabs.forEach(function (tab) {\n    tab.addEventListener('click', function () { goTab(tab.dataset.tab); });\n  });\n}\n\nfunction init() {\n  try {\n    cacheElements();\n    bindEvents();\n    state = freshState();\n    addLog('Amara left the clinic at 7:00 AM and opened FieldVet.', 'travel', null);\n    render();\n  } catch (error) {\n    const p = document.createElement('p');\n    p.textContent = 'This activity could not load. Refresh the page, and tell your teacher if it happens again.';\n    document.body.insertBefore(p, document.body.firstChild);\n  }\n}\n\ninit();",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2",
