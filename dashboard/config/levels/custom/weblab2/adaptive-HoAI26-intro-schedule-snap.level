        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Schedule Snap</title>\n<meta name=\"description\" content=\"Try combinations of next year's classes on a weekly grid, see clashes as they happen, and bring your counselor a plan that fits.\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Instrument+Sans:wght@400;600&display=swap\">\n<link rel=\"stylesheet\" href=\"style.css\">\n<script src=\"script.js\" defer></script>\n</head>\n<body>\n<div class=\"app\">\n  <header class=\"appbar\">\n    <div class=\"brand\">\n      <!-- App icon: a tiny timetable with one block snapped in -->\n      <svg width=\"28\" height=\"28\" viewBox=\"0 0 28 28\" aria-hidden=\"true\" focusable=\"false\">\n        <rect class=\"app-icon-frame\" x=\"1\" y=\"1\" width=\"26\" height=\"26\" stroke-width=\"2\" />\n        <path class=\"app-icon-lines\" d=\"M1 10h26M1 18h26M10 1v26M18 1v26\" stroke-width=\"1\" />\n        <rect class=\"app-icon-block\" x=\"10\" y=\"10\" width=\"8\" height=\"8\" stroke-width=\"1.5\" />\n      </svg>\n      <div>\n        <h1>Schedule Snap</h1>\n        <p class=\"brand-sub\">Harbor Point High · Next year</p>\n      </div>\n    </div>\n    <p class=\"tagline\">Next year's classes are hard to picture from a course list. Try combinations here, then bring your counselor a plan that fits.</p>\n  </header>\n\n  <p class=\"load-error\" id=\"load-error\" role=\"alert\" hidden>Schedule Snap couldn't load. Try reloading the page.</p>\n  <noscript><p class=\"load-error\">Schedule Snap needs JavaScript to run.</p></noscript>\n\n  <main class=\"workspace\">\n    <section class=\"tray\" aria-label=\"Classes\">\n      <div class=\"tray-head\">\n        <div class=\"th-col\"><h2>Required</h2><span class=\"offered\">Periods offered</span></div>\n        <div class=\"th-col th-col-2\" aria-hidden=\"true\"><span class=\"offered\">Periods offered</span></div>\n      </div>\n      <ul class=\"tray-list\" id=\"required-list\"></ul>\n      <div class=\"tray-head\">\n        <div class=\"th-col\"><h2>Electives</h2><span class=\"offered\">Periods offered</span></div>\n        <div class=\"th-col th-col-2\" aria-hidden=\"true\"><span class=\"offered\">Periods offered</span></div>\n      </div>\n      <ul class=\"tray-list\" id=\"elective-list\"></ul>\n    </section>\n\n    <div class=\"week\">\n      <div class=\"weekbar-wrap\">\n        <div class=\"weekbar\">\n          <h2 class=\"weekbar-title\">Your week</h2>\n          <p class=\"weekbar-hint\" id=\"week-hint\" aria-hidden=\"true\">\n            <span class=\"hint-wide\"><svg class=\"hint-arrow\" width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M14 8H3M7 3.5L2.5 8 7 12.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"square\" /></svg>Pick a class to place it on your week</span>\n            <span class=\"hint-narrow\"><svg class=\"hint-arrow\" width=\"13\" height=\"13\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M8 14V3M3.5 7L8 2.5 12.5 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"square\" /></svg>Pick a class to place it on your week</span>\n          </p>\n          <dl class=\"counters\" id=\"counters\" hidden>\n            <div class=\"counter\">\n              <dt>Required</dt>\n              <dd><span class=\"progress\" id=\"required-progress\" aria-hidden=\"true\"></span><span id=\"required-count\"></span></dd>\n            </div>\n            <div class=\"counter\"><dt>Electives</dt><dd id=\"elective-count\"></dd></div>\n            <div class=\"counter\"><dt>Free</dt><dd id=\"free-count\"></dd></div>\n          </dl>\n          <div class=\"weekbar-end\" id=\"weekbar-end\">\n            <span class=\"pill pill-full\" id=\"nofree-pill\" hidden>No free period</span>\n            <span class=\"pill pill-ok\" id=\"fits-pill\" hidden><svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2.5 8.5l3.5 3.5 7.5-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"square\" /></svg>Plan fits</span>\n            <button type=\"button\" class=\"btn btn-invert\" id=\"copy-button\" hidden>Copy for counselor</button>\n            <span class=\"pill pill-full\" id=\"copy-note\" hidden></span>\n            <div role=\"group\" aria-label=\"Clear all classes?\" class=\"confirm\" id=\"reset-confirm\" hidden>\n              <span>Clear all?</span>\n              <button type=\"button\" class=\"textbtn\" id=\"reset-yes\">Yes</button>\n              <button type=\"button\" class=\"textbtn\" id=\"reset-no\">No</button>\n            </div>\n            <button type=\"button\" class=\"textbtn\" id=\"reset-button\" hidden>Reset</button>\n          </div>\n        </div>\n        <p class=\"sr-only\" role=\"status\" aria-live=\"polite\" id=\"status-message\"></p>\n        <div class=\"copy-fallback\" id=\"copy-fallback\" hidden>\n          <label for=\"copy-text\">Copying is blocked here. Select this text and copy it yourself:</label>\n          <textarea id=\"copy-text\" readonly rows=\"9\"></textarea>\n        </div>\n      </div>\n\n      <div class=\"grid-wrap\">\n        <table class=\"grid\" id=\"week-grid\">\n          <caption class=\"sr-only\">Your week</caption>\n        </table>\n      </div>\n    </div>\n  </main>\n\n  <p class=\"footnote\">Harbor Point High, its teachers and its classes are made up for this example.</p>\n</div>\n</body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "\"use strict\";\n\n/* =====================================================================\n   DATA — everything about the school lives here.\n   Harbor Point High, its teachers and its classes are all made up.\n   ===================================================================== */\n\nconst PERIODS = [\n  { id: \"P1\", start: \"8:05\", end: \"8:55\" },\n  { id: \"P2\", start: \"9:00\", end: \"9:50\" },\n  { id: \"P3\", start: \"9:55\", end: \"10:45\" },\n  { id: \"P4\", start: \"10:50\", end: \"11:40\" },\n  { id: \"LUNCH\", start: \"11:40\", end: \"12:15\", fixed: true },\n  { id: \"P5\", start: \"12:20\", end: \"1:10\" },\n  { id: \"P6\", start: \"1:15\", end: \"2:05\" },\n  { id: \"P7\", start: \"2:10\", end: \"3:00\" },\n];\n\nconst DAYS = [\"Mon\", \"Tue\", \"Wed\", \"Thu\", \"Fri\"];\n\n// Each subject's color is set in style.css as .subject-<key> (for example .subject-english).\nconst SUBJECTS = {\n  english:  { label: \"English\" },\n  math:     { label: \"Math\" },\n  science:  { label: \"Science\" },\n  history:  { label: \"History\" },\n  language: { label: \"World language\" },\n  pe:       { label: \"PE & Health\" },\n  art:      { label: \"Art\" },\n  robotics: { label: \"Robotics\" },\n  music:    { label: \"Music\" },\n};\n\n// Four core classes are required; the rest are electives.\n// Required classes come in mirrored pairs (English/Biology share P1 and P3), so they always fit.\n// Electives compete for the leftover periods: that's where the natural clashes come from.\n// Every class meets all five days, so a period is simply full or free.\nconst COURSES = [\n  { id: \"eng\", name: \"English 9\", code: \"ENG-9\", subject: \"english\", required: true, sections: [\n    { id: \"A\", teacher: \"Ms. Okafor\", meetings: [{ period: \"P1\", days: DAYS }] },\n    { id: \"B\", teacher: \"Mr. Brandt\", meetings: [{ period: \"P3\", days: DAYS }] },\n  ] },\n  { id: \"bio\", name: \"Biology\", code: \"BIO\", subject: \"science\", required: true, sections: [\n    { id: \"A\", teacher: \"Dr. Ramos\",      meetings: [{ period: \"P3\", days: DAYS }] },\n    { id: \"B\", teacher: \"Ms. Castellano\", meetings: [{ period: \"P1\", days: DAYS }] },\n  ] },\n  { id: \"alg\", name: \"Algebra I\", code: \"ALG-1\", subject: \"math\", required: true, sections: [\n    { id: \"A\", teacher: \"Ms. Liu\",    meetings: [{ period: \"P2\", days: DAYS }] },\n    { id: \"B\", teacher: \"Mr. Haddad\", meetings: [{ period: \"P5\", days: DAYS }] },\n  ] },\n  { id: \"hist\", name: \"World History\", code: \"HIST\", subject: \"history\", required: true, sections: [\n    { id: \"A\", teacher: \"Mr. Petrov\",  meetings: [{ period: \"P4\", days: DAYS }] },\n    { id: \"B\", teacher: \"Ms. Adeyemi\", meetings: [{ period: \"P6\", days: DAYS }] },\n  ] },\n  { id: \"span\", name: \"Spanish I\", code: \"SPAN-1\", subject: \"language\", required: false, sections: [\n    { id: \"A\", teacher: \"Sra. Medina\", meetings: [{ period: \"P5\", days: DAYS }] },\n    { id: \"B\", teacher: \"Sr. Ortiz\",   meetings: [{ period: \"P2\", days: DAYS }] },\n  ] },\n  { id: \"peh\", name: \"PE & Health\", code: \"PE-H\", subject: \"pe\", required: false, sections: [\n    { id: \"A\", teacher: \"Coach Reyes\", meetings: [{ period: \"P6\", days: DAYS }] },\n    { id: \"B\", teacher: \"Coach Lind\",  meetings: [{ period: \"P7\", days: DAYS }] },\n  ] },\n  { id: \"art\", name: \"Art Studio\", code: \"ART\", subject: \"art\", required: false, sections: [\n    { id: \"A\", teacher: \"Ms. Novak\", meetings: [{ period: \"P7\", days: DAYS }] },\n    { id: \"B\", teacher: \"Ms. Novak\", meetings: [{ period: \"P5\", days: DAYS }] },\n  ] },\n  { id: \"robo\", name: \"Robotics\", code: \"ROBO\", subject: \"robotics\", required: false, sections: [\n    { id: \"A\", teacher: \"Mr. Sato\", meetings: [{ period: \"P6\", days: DAYS }] },\n  ] },\n  { id: \"band\", name: \"Band\", code: \"BAND\", subject: \"music\", required: false, sections: [\n    { id: \"A\", teacher: \"Mr. Ellis\", meetings: [{ period: \"P7\", days: DAYS }] },\n  ] },\n];\n\n/* =====================================================================\n   SMALL HELPERS — turning data into words\n   ===================================================================== */\n\nconst COURSE_BY_ID = Object.fromEntries(COURSES.map(c => [c.id, c]));\nconst CLASS_PERIODS = PERIODS.filter(p => !p.fixed);\nconst REQUIRED = COURSES.filter(c => c.required);\nconst DAY_NAMES = { Mon: \"Monday\", Tue: \"Tuesday\", Wed: \"Wednesday\", Thu: \"Thursday\", Fri: \"Friday\" };\nconst DAY_ABBR = { Mon: \"M\", Tue: \"T\", Wed: \"W\", Thu: \"Th\", Fri: \"F\" };\nconst numberFormat = new Intl.NumberFormat(document.documentElement.lang || \"en\");\nconst formatNumber = n => numberFormat.format(n);\n\nconst periodName = id => `Period ${id.slice(1)}`;\nconst isAllWeek = days => days.length === DAYS.length;\nfunction listJoin(items) {\n  if (items.length < 2) return items.join(\"\");\n  return `${items.slice(0, -1).join(\", \")} and ${items[items.length - 1]}`;\n}\nconst daysText = days => isAllWeek(days) ? \"Mon–Fri\" : days.join(\", \");\nconst daysShort = days => isAllWeek(days) ? \"M–F\" : days.map(d => DAY_ABBR[d]).join(\"/\");\nconst daysSpoken = days => isAllWeek(days) ? \"Monday to Friday\" : listJoin(days.map(d => DAY_NAMES[d]));\nconst getSection = (courseId, sectionId) => COURSE_BY_ID[courseId].sections.find(s => s.id === sectionId);\nconst clashCountText = n => n === 1 ? `${formatNumber(n)} clash` : `${formatNumber(n)} clashes`;\nconst freeCountText = n => n === 1 ? `${formatNumber(n)} free period` : `${formatNumber(n)} free periods`;\n\n// Screen readers hear the whole thing: \"Algebra I, section A, Period 2, Monday to Friday\"\nfunction chipLabel(course, section) {\n  const where = section.meetings.map(m => `${periodName(m.period)}, ${daysSpoken(m.days)}`).join(\", plus \");\n  return course.required\n    ? `${course.name}, section ${section.id}, ${where}`\n    : `${course.name}, section ${section.id}, ${where}, optional`;\n}\n\nfunction classSpokenName(course, sectionId) {\n  return course.required\n    ? `${course.name}, section ${sectionId}`\n    : `${course.name}, section ${sectionId}, optional`;\n}\n\n/* =====================================================================\n   LOGIC — pure functions, no DOM. `chosen` looks like { eng: \"A\", alg: \"B\" }.\n   ===================================================================== */\n\n// Returns { \"P4|Tue\": [{ courseId, sectionId, label }, ...], ... }\nfunction buildCells(chosen) {\n  const cells = {};\n  COURSES.forEach(course => {\n    const sectionId = chosen[course.id];\n    if (!sectionId) return;\n    const section = course.sections.find(s => s.id === sectionId);\n    if (!section) return;\n    section.meetings.forEach(m => m.days.forEach(day => {\n      const key = `${m.period}|${day}`;\n      (cells[key] = cells[key] || []).push({ courseId: course.id, sectionId, label: m.label || course.name });\n    }));\n  });\n  return cells;\n}\n\n// Returns [{ period, days[], courses[] }], one entry per clash even if it spans several days\nfunction findClashes(cells) {\n  const groups = [];\n  CLASS_PERIODS.forEach(p => DAYS.forEach(day => {\n    const list = cells[`${p.id}|${day}`] || [];\n    if (list.length < 2) return;\n    // Group by course + section (not label), so one class split across days counts as one clash\n    const sig = list.map(e => e.courseId + e.sectionId).join(\",\");\n    let g = groups.find(x => x.period === p.id && x.sig === sig);\n    if (!g) {\n      g = { period: p.id, sig, days: [], courses: list.map(e => ({ ...e })) };\n      groups.push(g);\n    } else {\n      g.courses.forEach((c, i) => { if (c.label !== list[i].label) c.label = COURSE_BY_ID[c.courseId].name; });\n    }\n    g.days.push(day);\n  }));\n  return groups;\n}\n\nconst filled = (cells, pid) => DAYS.filter(d => (cells[`${pid}|${d}`] || []).length > 0).length;\n// Empty all five days: a free period\nconst freePeriods = cells => CLASS_PERIODS.map(p => p.id).filter(pid => filled(cells, pid) === 0);\n// Empty only some days: \"part free\", doesn't count\nconst partFree = cells => CLASS_PERIODS.map(p => p.id).filter(pid => {\n  const n = filled(cells, pid);\n  return n > 0 && n < DAYS.length;\n});\n\n// The rules: all required classes in, no clashes, at least one free period.\n// state: \"empty\" | \"clash\" | \"building\" | \"nofree\" | \"done\"\nfunction getStatus(chosen) {\n  const cells = buildCells(chosen);\n  const placed = COURSES.filter(c => chosen[c.id]).length;\n  const requiredPlaced = REQUIRED.filter(c => chosen[c.id]).length;\n  const electives = COURSES.filter(c => !c.required && chosen[c.id]).length;\n  const missing = REQUIRED.filter(c => !chosen[c.id]).map(c => c.name);\n  const clashes = findClashes(cells);\n  const free = freePeriods(cells);\n  const part = placed ? partFree(cells) : [];\n  let state, message;\n\n  if (!placed) {\n    state = \"empty\";\n    message = \"Nothing placed yet. Start with a required class.\";\n  } else if (clashes.length) {\n    state = \"clash\";\n    const c = clashes[0];\n    const who = listJoin(c.courses.map(e => `${e.label} (${e.sectionId})`));\n    const when = isAllWeek(c.days) ? \"every day\" : `on ${c.days.join(\", \")}`;\n    const more = clashes.length - 1;\n    message = more > 0\n      ? `Clash in ${periodName(c.period)} ${when}: ${who}. Plus ${formatNumber(more)} more.`\n      : `Clash in ${periodName(c.period)} ${when}: ${who}.`;\n  } else if (missing.length) {\n    state = \"building\";\n    message = `No clashes. Still need: ${missing.join(\", \")}.`;\n  } else if (!free.length) {\n    state = \"nofree\";\n    message = \"Everything fits, but there's no free period. Drop an elective to get one back.\";\n  } else {\n    state = \"done\";\n    message = free.length === 1\n      ? `This plan fits. ${periodName(free[0])} is free.`\n      : `This plan fits. ${listJoin(free.map(periodName))} are free.`;\n  }\n  return { cells, placed, requiredPlaced, electives, missing, clashes, free, part, state, message };\n}\n\n// The text that \"Copy for counselor\" puts on the clipboard\nfunction summaryText(chosen, st) {\n  const lines = [\"Schedule Snap — my plan for next year (Harbor Point High)\"];\n  CLASS_PERIODS.forEach(p => {\n    const entries = [];\n    COURSES.forEach(course => {\n      const sid = chosen[course.id];\n      if (!sid) return;\n      getSection(course.id, sid).meetings.filter(m => m.period === p.id)\n        .forEach(m => entries.push({ name: `${course.name} (${sid})`, days: m.days }));\n    });\n    if (!entries.length) {\n      lines.push(`${p.id}  — free —`);\n      return;\n    }\n    entries.forEach((e, i) => lines.push(`${i === 0 ? p.id : \"  \"}  ${e.name.padEnd(19)} ${daysText(e.days)}`));\n  });\n  const parts = [st.clashes.length ? clashCountText(st.clashes.length) : \"no clashes\", freeCountText(st.free.length)];\n  if (st.missing.length) parts.push(`still need ${st.missing.join(\", \")}`);\n  lines.push(`Status: ${parts.join(\" · \")}`);\n  return lines.join(\"\\n\");\n}\n\n/* =====================================================================\n   STATE\n   ===================================================================== */\n\nconst STORE_KEY = \"schedule-snap:v2\";\n\nconst state = { chosen: {}, preview: null, confirmingReset: false };\nconst ui = { copyNote: \"\", fallback: false };\n\nfunction loadChosen() {\n  try {\n    const saved = JSON.parse(localStorage.getItem(STORE_KEY) || \"{}\");\n    Object.keys(saved).forEach(cid => {\n      if (COURSE_BY_ID[cid] && getSection(cid, saved[cid])) state.chosen[cid] = saved[cid];\n    });\n  } catch (err) {\n    // Storage blocked (common in the sandbox): start empty and keep the plan in memory only\n  }\n}\n\nfunction saveChosen() {\n  try {\n    localStorage.setItem(STORE_KEY, JSON.stringify(state.chosen));\n  } catch (err) {\n    // Fine without it: the plan still lives in memory for this visit\n  }\n}\n\nfunction dispatch(action) {\n  switch (action.type) {\n    case \"TOGGLE_SECTION\": {\n      const chosen = { ...state.chosen };\n      if (chosen[action.courseId] === action.sectionId) delete chosen[action.courseId];   // active period again: remove\n      else chosen[action.courseId] = action.sectionId;                                     // otherwise place it (or swap)\n      state.chosen = chosen;\n      saveChosen();\n      break;\n    }\n    case \"PREVIEW\": {\n      const p = action.preview;\n      const q = state.preview;\n      if (p === q || (p && q && p.courseId === q.courseId && p.sectionId === q.sectionId)) return;\n      state.preview = p;\n      break;\n    }\n    case \"ASK_RESET\":\n      state.confirmingReset = true;\n      break;\n    case \"CONFIRM_RESET\":\n      state.chosen = {};\n      state.confirmingReset = false;\n      saveChosen();\n      break;\n    case \"CANCEL_RESET\":\n      state.confirmingReset = false;\n      break;\n    default:\n      return;\n  }\n  render();\n}\n\n/* =====================================================================\n   DOM — built once, then updated in place so animations only play\n   when something actually appears (a class snaps in, a clash shows up).\n   ===================================================================== */\n\nconst refs = {};\nconst chipButtons = [];      // [{ button, courseId, sectionId }]\nconst cellRefs = {};         // \"P1|Mon\" -> { td, kind, sig, block, stack, ghost }\nconst rowRefs = {};          // \"P1\" -> { th, clashTag, clashDays, clashSpoken, statusTag, statusKind }\nlet lastSummary = null;\nlet lastMessage = null;\nlet wasConfirming = false;\nlet wasFallback = false;\nlet prevStatusState = null;\nlet celebrateTimer = null;\n\nfunction el(tag, className, text) {\n  const node = document.createElement(tag);\n  if (className) node.className = className;\n  if (text !== undefined) node.textContent = text;\n  return node;\n}\n\nfunction srOnly(text) {\n  return el(\"span\", \"sr-only\", text);\n}\n\n/* ---------- Tray ---------- */\n\nfunction buildTray() {\n  COURSES.forEach(course => {\n    const list = course.required ? refs.requiredList : refs.electiveList;\n    list.appendChild(buildCourseRow(course));\n  });\n}\n\nfunction buildCourseRow(course) {\n  const opt = course.required ? \"\" : \" is-opt\";\n  const row = el(\"li\", `course subject-${course.subject}`);\n  const swatch = el(\"span\", `swatch${opt}`);\n  swatch.setAttribute(\"aria-hidden\", \"true\");\n  const name = el(\"span\", \"course-name\", course.name);\n  name.id = `name-${course.id}`;\n  const chips = el(\"span\", \"chips\");\n  chips.setAttribute(\"role\", \"group\");\n  chips.setAttribute(\"aria-labelledby\", name.id);\n  course.sections.forEach(section => chips.appendChild(buildChip(course, section, opt)));\n  row.append(swatch, name, chips);\n  return row;\n}\n\n// Button text is just the period (\"P1\"); part-week sections add their days as a small second line\nfunction buildChip(course, section, opt) {\n  const button = el(\"button\", `chip${opt}`);\n  button.type = \"button\";\n  button.setAttribute(\"aria-pressed\", \"false\");\n  button.setAttribute(\"aria-label\", chipLabel(course, section));\n\n  const mark = el(\"span\", \"chip-mark\");\n  mark.setAttribute(\"aria-hidden\", \"true\");\n  const text = el(\"span\", \"chip-text\");\n  text.setAttribute(\"aria-hidden\", \"true\");\n  const meeting = section.meetings[0];\n  text.appendChild(el(\"span\", \"\", meeting.period));\n  if (!isAllWeek(meeting.days)) text.appendChild(el(\"span\", \"chip-days\", daysShort(meeting.days)));\n  button.append(mark, text);\n\n  const target = { courseId: course.id, sectionId: section.id };\n  const show = () => dispatch({ type: \"PREVIEW\", preview: target });\n  const hide = () => dispatch({ type: \"PREVIEW\", preview: null });\n  button.addEventListener(\"click\", () => dispatch({ type: \"TOGGLE_SECTION\", ...target }));\n  button.addEventListener(\"mouseenter\", show);\n  button.addEventListener(\"mouseleave\", hide);\n  button.addEventListener(\"focus\", show);\n  button.addEventListener(\"blur\", hide);\n\n  chipButtons.push({ button, courseId: course.id, sectionId: section.id });\n  return button;\n}\n\nfunction renderTray() {\n  chipButtons.forEach(({ button, courseId, sectionId }) => {\n    const pressed = String(state.chosen[courseId] === sectionId);\n    if (button.getAttribute(\"aria-pressed\") !== pressed) button.setAttribute(\"aria-pressed\", pressed);\n  });\n}\n\n/* ---------- Week bar ---------- */\n\nfunction buildWeekBar() {\n  // Four squares that fill in as required classes are placed\n  REQUIRED.forEach(() => refs.requiredProgress.appendChild(el(\"span\")));\n\n  refs.copyButton.addEventListener(\"click\", copySummary);\n  refs.resetButton.addEventListener(\"click\", () => dispatch({ type: \"ASK_RESET\" }));\n  refs.resetYes.addEventListener(\"click\", () => dispatch({ type: \"CONFIRM_RESET\" }));\n  refs.resetNo.addEventListener(\"click\", () => dispatch({ type: \"CANCEL_RESET\" }));\n\n  // Escape cancels the \"Clear all?\" question\n  document.addEventListener(\"keydown\", event => {\n    if (event.key === \"Escape\" && state.confirmingReset) dispatch({ type: \"CANCEL_RESET\" });\n  });\n}\n\nasync function copySummary() {\n  const text = lastSummary;\n  try {\n    await navigator.clipboard.writeText(text);\n    ui.copyNote = \"Copied\";\n  } catch (err) {\n    ui.fallback = true;   // clipboard blocked (common inside iframes): show selectable text instead\n  }\n  render();\n}\n\nfunction renderClashPill(st) {\n  const count = st.state === \"clash\" ? st.clashes.length : 0;\n  if (refs.clashPill && refs.clashPill.dataset.count === String(count)) return;\n  if (refs.clashPill) {\n    refs.clashPill.remove();\n    refs.clashPill = null;\n  }\n  if (!count) return;\n  // A new pill each time the count changes, so it pops in again\n  const pill = el(\"span\", \"pill pill-clash\");\n  pill.dataset.count = String(count);\n  const hatch = el(\"span\", \"mini-hatch\");\n  hatch.setAttribute(\"aria-hidden\", \"true\");\n  pill.append(hatch, document.createTextNode(clashCountText(count)));\n  refs.weekbarEnd.insertBefore(pill, refs.weekbarEnd.firstChild);\n  refs.clashPill = pill;\n}\n\nfunction renderWeekBar(st) {\n  const empty = st.state === \"empty\";\n  refs.weekHint.hidden = !empty;\n  refs.counters.hidden = empty;\n\n  Array.prototype.forEach.call(refs.requiredProgress.children, (square, i) => {\n    square.classList.toggle(\"is-on\", i < st.requiredPlaced);\n  });\n  refs.requiredCount.textContent = `${formatNumber(st.requiredPlaced)}/${formatNumber(REQUIRED.length)}`;\n  refs.electiveCount.textContent = formatNumber(st.electives);\n  refs.freeCount.textContent = formatNumber(st.free.length);\n\n  renderClashPill(st);\n  refs.nofreePill.hidden = st.state !== \"nofree\";\n  refs.fitsPill.hidden = st.state !== \"done\";\n  refs.copyButton.hidden = st.state !== \"done\";\n  refs.copyNote.hidden = !ui.copyNote;\n  refs.copyNote.textContent = ui.copyNote;\n  refs.resetConfirm.hidden = !state.confirmingReset;\n  refs.resetButton.hidden = state.confirmingReset || st.placed === 0;\n\n  if (state.confirmingReset !== wasConfirming) {\n    if (state.confirmingReset) refs.resetNo.focus();\n    else if (!refs.resetButton.hidden) refs.resetButton.focus();\n    wasConfirming = state.confirmingReset;\n  }\n\n  // Screen readers hear one plain sentence after every change\n  if (st.message !== lastMessage) {\n    refs.statusMessage.textContent = st.message;\n    lastMessage = st.message;\n  }\n\n  refs.copyFallback.hidden = !ui.fallback;\n  if (ui.fallback) refs.copyText.value = lastSummary;\n  if (ui.fallback && !wasFallback) {\n    refs.copyText.focus();\n    refs.copyText.select();\n  }\n  wasFallback = ui.fallback;\n}\n\n/* ---------- Week grid ---------- */\n\nfunction buildGrid() {\n  const table = refs.grid;\n\n  const colgroup = el(\"colgroup\");\n  colgroup.appendChild(el(\"col\", \"col-period\"));\n  DAYS.forEach(() => colgroup.appendChild(el(\"col\")));\n\n  const thead = el(\"thead\");\n  const headRow = el(\"tr\");\n  headRow.appendChild(el(\"td\"));\n  DAYS.forEach(d => {\n    const th = el(\"th\");\n    th.scope = \"col\";\n    const long = el(\"span\", \"d-long\", d);\n    long.setAttribute(\"aria-hidden\", \"true\");\n    const short = el(\"span\", \"d-short\", d[0]);\n    short.setAttribute(\"aria-hidden\", \"true\");\n    th.append(srOnly(DAY_NAMES[d]), long, short);\n    headRow.appendChild(th);\n  });\n  thead.appendChild(headRow);\n\n  const tbody = el(\"tbody\");\n  PERIODS.forEach((per, ri) => {\n    if (per.fixed) {\n      const tr = el(\"tr\", \"lunch\");\n      const th = el(\"th\", \"\", `Lunch ${per.start}–${per.end}`);\n      th.scope = \"row\";\n      th.colSpan = DAYS.length + 1;\n      tr.appendChild(th);\n      tbody.appendChild(tr);\n      return;\n    }\n    const tr = el(\"tr\", `row-${ri}`);\n    tr.appendChild(buildPeriodLabel(per));\n    DAYS.forEach((d, di) => {\n      const td = el(\"td\", `day-${di}`);\n      td.appendChild(srOnly(\"Free\"));\n      cellRefs[`${per.id}|${d}`] = { td, kind: \"empty\", sig: \"\", block: null, stack: null, ghost: null };\n      tr.appendChild(td);\n    });\n    tbody.appendChild(tr);\n  });\n\n  table.append(colgroup, thead, tbody);\n}\n\nfunction buildPeriodLabel(per) {\n  const th = el(\"th\", \"period\");\n  th.scope = \"row\";\n  const line = el(\"span\", \"p-line\");\n  const num = el(\"span\", \"p-num\", per.id);\n  num.setAttribute(\"aria-hidden\", \"true\");\n  const time = el(\"span\", \"p-time\", `${per.start}–${per.end}`);\n  time.setAttribute(\"aria-hidden\", \"true\");\n  line.append(num, time);\n  th.append(line, srOnly(`${periodName(per.id)}, ${per.start} to ${per.end}`));\n  rowRefs[per.id] = { th, clashTag: null, clashDays: null, clashSpoken: null, statusTag: null, statusKind: \"\" };\n  return th;\n}\n\n// Period label tags: CLASH · TUE, THU / FREE / PART FREE\nfunction renderPeriodLabel(ref, clash, free, part) {\n  if (clash && !ref.clashTag) {\n    const tag = el(\"span\", \"tag tag-clash\", \"Clash\");\n    ref.clashDays = el(\"span\", \"tag-days\");\n    ref.clashDays.setAttribute(\"aria-hidden\", \"true\");\n    ref.clashSpoken = srOnly(\"\");\n    tag.append(ref.clashDays, ref.clashSpoken);\n    ref.th.appendChild(tag);\n    ref.clashTag = tag;\n  } else if (!clash && ref.clashTag) {\n    ref.clashTag.remove();\n    ref.clashTag = null;\n  }\n  if (clash) {\n    ref.clashDays.textContent = ` · ${daysShort(clash.days)}`;\n    ref.clashSpoken.textContent = ` on ${daysSpoken(clash.days)}`;\n  }\n\n  let kind = \"\";\n  if (!clash && free) kind = \"free\";\n  else if (!clash && part) kind = \"part\";\n  if (kind === ref.statusKind) return;\n  if (ref.statusTag) ref.statusTag.remove();\n  ref.statusTag = null;\n  if (kind === \"free\") ref.statusTag = el(\"span\", \"tag tag-free\", \"Free\");\n  if (kind === \"part\") ref.statusTag = el(\"span\", \"tag tag-part\", \"Part free\");\n  if (ref.statusTag) ref.th.appendChild(ref.statusTag);\n  ref.statusKind = kind;\n}\n\nfunction createBlock() {\n  const block = el(\"div\", \"block\");\n  const code = el(\"span\", \"block-code\");\n  code.setAttribute(\"aria-hidden\", \"true\");\n  code.append(el(\"span\", \"nowrap\"), el(\"span\", \"sec\"));\n  const name = el(\"span\", \"block-name\");\n  name.setAttribute(\"aria-hidden\", \"true\");\n  block.append(code, name, srOnly(\"\"));\n  return block;\n}\n\nfunction fillBlock(block, entry) {\n  const course = COURSE_BY_ID[entry.courseId];\n  block.className = `block subject-${course.subject}${course.required ? \"\" : \" is-opt\"}`;\n  const code = block.children[0];\n  code.children[0].textContent = course.code;\n  code.children[1].textContent = ` · ${entry.sectionId}`;\n  block.children[1].textContent = entry.label;\n  block.children[2].textContent = classSpokenName(course, entry.sectionId);\n}\n\nfunction fillClashStack(stack, entries) {\n  stack.textContent = \"\";\n  stack.appendChild(srOnly(\"Clash:\"));\n  entries.forEach(entry => {\n    const course = COURSE_BY_ID[entry.courseId];\n    const item = el(\"span\", \"clash-code\");\n    const visible = el(\"span\", \"nowrap\", course.code);\n    visible.setAttribute(\"aria-hidden\", \"true\");\n    visible.appendChild(el(\"span\", \"sec\", ` · ${entry.sectionId}`));\n    item.append(visible, srOnly(`${course.name}, section ${entry.sectionId}`));\n    stack.appendChild(item);\n  });\n}\n\n// One grid cell: empty, one class, or a clash\nfunction renderCell(ref, entries, ghost, partEmpty, di) {\n  const kind = entries.length === 0 ? \"empty\" : entries.length === 1 ? \"single\" : \"clash\";\n  const sig = entries.map(e => `${e.courseId}|${e.sectionId}|${e.label}`).join(\",\");\n\n  let stateClass = \"\";\n  if (kind === \"clash\") stateClass = \" is-clash\";\n  else if (kind === \"empty\" && partEmpty) stateClass = \" is-part\";\n  const className = `day-${di}${stateClass}`;\n  if (ref.td.className !== className) ref.td.className = className;\n\n  if (kind !== ref.kind) {\n    Array.prototype.slice.call(ref.td.childNodes).forEach(node => {\n      if (node !== ref.ghost) node.remove();\n    });\n    ref.block = null;\n    ref.stack = null;\n    let content;\n    if (kind === \"empty\") content = srOnly(\"Free\");\n    if (kind === \"single\") {\n      ref.block = createBlock();\n      fillBlock(ref.block, entries[0]);\n      content = ref.block;\n    }\n    if (kind === \"clash\") {\n      ref.stack = el(\"div\", \"clash-stack\");\n      fillClashStack(ref.stack, entries);\n      content = ref.stack;\n    }\n    ref.td.insertBefore(content, ref.ghost);\n  } else if (sig !== ref.sig) {\n    if (kind === \"single\") fillBlock(ref.block, entries[0]);\n    if (kind === \"clash\") fillClashStack(ref.stack, entries);\n  }\n  ref.kind = kind;\n  ref.sig = sig;\n\n  if (ghost && !ref.ghost) {\n    ref.ghost = el(\"span\", \"ghost\");\n    ref.ghost.setAttribute(\"aria-hidden\", \"true\");\n    ref.td.appendChild(ref.ghost);\n  } else if (!ghost && ref.ghost) {\n    ref.ghost.remove();\n    ref.ghost = null;\n  }\n  if (ref.ghost) ref.ghost.classList.toggle(\"warn\", ghost.warn);\n}\n\n// Ghost preview: where the hovered/focused section would land (skip if it's already placed)\nfunction getGhosts(cells) {\n  const ghosts = {};\n  const p = state.preview;\n  if (p && state.chosen[p.courseId] !== p.sectionId) {\n    getSection(p.courseId, p.sectionId).meetings.forEach(m => m.days.forEach(d => {\n      const key = `${m.period}|${d}`;\n      const others = (cells[key] || []).filter(e => e.courseId !== p.courseId);\n      ghosts[key] = { warn: others.length > 0 };\n    }));\n  }\n  return ghosts;\n}\n\nfunction renderGrid(st) {\n  const ghosts = getGhosts(st.cells);\n  // FREE labels only mean something once the required classes are all in\n  const allRequired = st.requiredPlaced === REQUIRED.length;\n  CLASS_PERIODS.forEach(per => {\n    const isPart = st.part.includes(per.id);\n    renderPeriodLabel(\n      rowRefs[per.id],\n      st.clashes.find(c => c.period === per.id),\n      allRequired && st.free.includes(per.id),\n      isPart\n    );\n    DAYS.forEach((d, di) => {\n      const key = `${per.id}|${d}`;\n      renderCell(cellRefs[key], st.cells[key] || [], ghosts[key], isPart, di);\n    });\n  });\n}\n\n// \"Plan fits\" moment: when the plan first fits, sweep a light flash down the rows once\nfunction updateCelebration(statusState) {\n  if (statusState === prevStatusState) return;\n  const wasDone = prevStatusState === \"done\";\n  prevStatusState = statusState;\n  clearTimeout(celebrateTimer);\n  refs.grid.classList.remove(\"celebrate\");\n  if (statusState !== \"done\" || wasDone) return;\n  refs.grid.classList.add(\"celebrate\");\n  celebrateTimer = setTimeout(() => refs.grid.classList.remove(\"celebrate\"), 1400);\n}\n\n/* ---------- Render ---------- */\n\nfunction render() {\n  const st = getStatus(state.chosen);\n\n  // A changed plan clears any old \"Copied\" note or copy fallback\n  const summary = summaryText(state.chosen, st);\n  if (summary !== lastSummary) {\n    ui.copyNote = \"\";\n    ui.fallback = false;\n    lastSummary = summary;\n  }\n\n  renderTray();\n  renderWeekBar(st);\n  renderGrid(st);\n  updateCelebration(st.state);\n}\n\nfunction start() {\n  const byId = id => document.getElementById(id);\n  Object.assign(refs, {\n    requiredList: byId(\"required-list\"),\n    electiveList: byId(\"elective-list\"),\n    weekHint: byId(\"week-hint\"),\n    counters: byId(\"counters\"),\n    requiredProgress: byId(\"required-progress\"),\n    requiredCount: byId(\"required-count\"),\n    electiveCount: byId(\"elective-count\"),\n    freeCount: byId(\"free-count\"),\n    weekbarEnd: byId(\"weekbar-end\"),\n    nofreePill: byId(\"nofree-pill\"),\n    fitsPill: byId(\"fits-pill\"),\n    copyButton: byId(\"copy-button\"),\n    copyNote: byId(\"copy-note\"),\n    resetConfirm: byId(\"reset-confirm\"),\n    resetYes: byId(\"reset-yes\"),\n    resetNo: byId(\"reset-no\"),\n    resetButton: byId(\"reset-button\"),\n    statusMessage: byId(\"status-message\"),\n    copyFallback: byId(\"copy-fallback\"),\n    copyText: byId(\"copy-text\"),\n    grid: byId(\"week-grid\"),\n    clashPill: null,\n  });\n\n  loadChosen();\n  buildTray();\n  buildWeekBar();\n  buildGrid();\n  render();\n  saveChosen();\n}\n\ntry {\n  start();\n} catch (err) {\n  const message = document.getElementById(\"load-error\");\n  if (message) message.hidden = false;\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": "/* ============ TOKENS: \"precise timetable\" palette ============ */\n:root {\n  --sheet: #F7F8FA;   /* page background */\n  --white: #FFFFFF;   /* grid cells, tray */\n  --ink: #0F1115;     /* text, thick rules */\n  --hair: #CDD2DA;    /* 1px grid hairlines (decorative) */\n  --muted: #5B6270;   /* secondary text, period times */\n  --clash: #E0261B;   /* conflicts ONLY. White on it = 4.7:1 */\n  --ok: #0E7C4A;      /* \"plan fits\" marks ONLY. 5.3:1 on white */\n  /* Subject colors: only on class blocks + tray swatches. Ink text on all of them passes 4.5:1. */\n  --eng: #FF9A7A;\n  --math: #FFD447;\n  --sci: #7BD88F;\n  --hist: #8EC5FF;\n  --lang: #FFB561;\n  --pe: #A9E5DB;\n  --art: #F6A6C9;\n  --robo: #B8DC74;\n  --band: #D9C7A7;\n  /* Patterns, not fades: electives get a light stripe over their color; clashes get a red hatch */\n  --optional: repeating-linear-gradient(135deg, rgba(255,255,255,0.45) 0 4px, transparent 4px 9px);\n  --hatch: repeating-linear-gradient(45deg, var(--clash) 0 3px, #FFFFFF 3px 7px);\n  --sans: \"Instrument Sans\", \"Helvetica Neue\", Arial, sans-serif;\n  --mono: \"DM Mono\", ui-monospace, \"SF Mono\", Consolas, monospace;\n  --row-h: 56px;      /* week grid row height: 7 rows + lunch fit one laptop screen */\n  --tray-w: 300px;\n  --pcol: 128px;      /* width of the period column on the grid */\n}\n\n/* Subject color for a tray row or a placed class (read by .swatch, .chip and .block as --c) */\n.subject-english  { --c: var(--eng); }\n.subject-math     { --c: var(--math); }\n.subject-science  { --c: var(--sci); }\n.subject-history  { --c: var(--hist); }\n.subject-language { --c: var(--lang); }\n.subject-pe       { --c: var(--pe); }\n.subject-art      { --c: var(--art); }\n.subject-robotics { --c: var(--robo); }\n.subject-music    { --c: var(--band); }\n\n/* Row number (--ri) staggers the \"plan fits\" sweep; day number (--di) staggers the snap, Mon first */\n.row-0 { --ri: 0; }\n.row-1 { --ri: 1; }\n.row-2 { --ri: 2; }\n.row-3 { --ri: 3; }\n.row-5 { --ri: 5; }\n.row-6 { --ri: 6; }\n.row-7 { --ri: 7; }\n.day-0 { --di: 0; }\n.day-1 { --di: 1; }\n.day-2 { --di: 2; }\n.day-3 { --di: 3; }\n.day-4 { --di: 4; }\n\n* { box-sizing: border-box; }\n[hidden] { display: none !important; }\nhtml { color-scheme: light; }\nbody {\n  margin: 0;\n  background: var(--sheet);\n  color: var(--ink);\n  font: 400 16px/1.5 var(--sans);\n  -webkit-font-smoothing: antialiased;\n}\nh1, h2, p, ul, ol { margin: 0; }\nul, ol { padding: 0; list-style: none; }\nbutton { font: inherit; color: inherit; border-radius: 0; }\n.sr-only {\n  position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;\n  overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;\n}\n\n/* Focus: 3px ink ring with a 2px white gap, so it shows on colored buttons too */\n:focus { outline: none; }\n:focus-visible { outline: 3px solid var(--ink); outline-offset: 2px; box-shadow: 0 0 0 2px var(--white); }\n\n.app { padding: 0 24px 16px; overflow-x: clip; }\n\n.load-error { margin-block-start: 16px; padding: 12px 16px; border: 2px solid var(--clash); background: var(--white); font-weight: 600; }\n\n/* ============ APP BAR: the app's name, with the one line beside it on wide screens ============ */\n.appbar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 32px; border-bottom: 2px solid var(--ink); padding: 16px 0 12px; }\n.brand { display: flex; align-items: center; gap: 12px; min-width: 0; flex: none; }\n.brand svg { flex: none; }\n.app-icon-frame { fill: var(--white); stroke: var(--ink); }\n.app-icon-lines { stroke: var(--hair); }\n.app-icon-block { fill: var(--math); stroke: var(--ink); }\n.brand h1 { font: 500 22px/1.1 var(--mono); letter-spacing: -0.04em; }\n.brand-sub { font: 400 12px var(--mono); color: var(--muted); letter-spacing: 0.02em; }\n\n/* ============ WEEK BAR: dark strip attached to the top of the grid ============ */\n.weekbar {\n  display: flex; flex-wrap: wrap; align-items: center; gap: 4px 24px; min-height: 52px; padding: 4px 12px;\n  background: var(--ink); color: var(--white);\n}\n.weekbar :focus-visible { outline-color: var(--white); box-shadow: 0 0 0 2px var(--ink); }\n.weekbar-title { font: 500 12px var(--mono); letter-spacing: 0.08em; text-transform: uppercase; }\n.weekbar-hint { font: 500 13px var(--mono); letter-spacing: 0.02em; }\n.hint-arrow { vertical-align: -2px; margin-inline-end: 0.6em; }\n.hint-narrow { display: none; }\n.weekbar-end { margin-inline-start: auto; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 12px; }\n.counters { display: flex; flex-wrap: wrap; gap: 4px 20px; margin: 0; font: 500 11px/1.2 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; }\n.counter { display: flex; align-items: center; gap: 8px; }\n.counter dt { color: #C9CED6; }\n.counter dd { display: flex; align-items: center; gap: 8px; margin: 0; font-size: 18px; letter-spacing: 0; font-variant-numeric: tabular-nums; }\n.progress { display: flex; gap: 3px; }\n.progress span { width: 10px; height: 10px; border: 1px solid var(--white); }\n.progress span.is-on { background: var(--white); }\n.pill {\n  display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 4px 10px;\n  font: 500 12px/1.2 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap;\n}\n.pill-clash { background: var(--clash); color: var(--white); }\n.pill-clash .mini-hatch { width: 12px; height: 12px; background: var(--hatch); border: 1px solid var(--white); }\n.pill-ok { background: var(--white); color: var(--ok); border: 2px solid var(--ok); }\n.pill-full { border: 2px solid var(--white); }\n.btn {\n  min-height: 44px; padding: 0 16px; border: 1px solid var(--ink); background: var(--white); cursor: pointer;\n  font: 600 15px var(--sans);\n}\n.btn-invert { background: var(--white); color: var(--ink); border-color: var(--white); }   /* white button on the dark strip */\n.btn-invert:hover { background: #E3E6EB; }\n.textbtn {\n  background: none; border: 0; padding: 0 8px; min-height: 44px; min-width: 44px; cursor: pointer;\n  font: 500 11px var(--mono); letter-spacing: 0.08em; text-transform: uppercase;\n  text-decoration: underline; text-underline-offset: 3px;\n}\n.textbtn:hover { color: #FFB3AD; }\n.confirm { display: flex; align-items: center; gap: 4px; font-size: 14px; }\n.tagline { flex: 1 1 360px; font-size: 17px; line-height: 1.4; }\n.copy-fallback { margin-block-start: 12px; }\n.copy-fallback label { display: block; font-size: 14px; margin-block-end: 6px; }\n.copy-fallback textarea { width: 100%; font: 400 13px/1.5 var(--mono); border: 1px solid var(--ink); padding: 8px; border-radius: 0; resize: vertical; }\n\n/* ============ WORKSPACE: tray + grid ============ */\n.workspace { margin-block-start: 16px; display: grid; grid-template-columns: var(--tray-w) minmax(0, 1fr); gap: 24px; align-items: start; }\n\n/* Tray of classes */\n.tray-head {\n  padding-block-end: 6px; border-bottom: 2px solid var(--ink);\n  font: 500 11px var(--mono); letter-spacing: 0.08em; text-transform: uppercase;\n}\n.th-col { display: flex; align-items: flex-end; gap: 8px; }\n.th-col-2 { display: none; }\n.tray-head h2 { font: inherit; }\n/* Sits right above the two button columns (2 x 64px + 6px gap) */\n.offered { margin-inline-start: auto; width: 134px; flex: none; color: var(--muted); }\n.tray-list + .tray-head { margin-block-start: 16px; }\n.course { display: flex; align-items: center; gap: 8px; min-height: 48px; padding: 2px 0; border-bottom: 1px solid var(--hair); }\n.swatch { flex: none; width: 14px; height: 14px; background: var(--c); }\n.swatch.is-opt { background: var(--optional), var(--c); }\n.course-name { flex: 1 1 auto; min-width: 0; font-weight: 600; font-size: 15px; line-height: 1.2; }\n/* Buttons sit on two fixed columns so every row lines up */\n.chips { display: grid; grid-template-columns: repeat(2, 64px); gap: 6px; flex: none; }\n.chip {\n  display: inline-flex; align-items: center; justify-content: center; gap: 6px;\n  min-height: 44px; width: 64px; padding: 0 6px;\n  background: var(--white); border: 1px solid var(--ink); cursor: pointer;\n  font: 500 13px var(--mono); white-space: nowrap;\n}\n.chip:hover { background: var(--sheet); }\n.chip-mark { width: 9px; height: 9px; border: 1px solid var(--ink); flex: none; }\n.chip[aria-pressed=\"true\"] { background: var(--c); box-shadow: inset 0 0 0 1px var(--ink); }\n.chip.is-opt[aria-pressed=\"true\"] { background: var(--optional), var(--c); }\n.chip[aria-pressed=\"true\"] .chip-mark { background: var(--ink); }\n.chip-text { display: flex; flex-direction: column; align-items: flex-start; line-height: 1.1; }\n.chip-days { font-size: 9px; letter-spacing: 0.04em; }\n\n/* Week grid */\n.grid-wrap { position: relative; overflow-x: auto; }\n.grid {\n  width: 100%; min-width: 300px; border-collapse: collapse; table-layout: fixed;\n  background: var(--white); font-size: 14px; font-variant-numeric: tabular-nums;\n}\n.grid th, .grid td { border: 1px solid var(--hair); padding: 0; vertical-align: top; position: relative; }\n.grid thead th {\n  padding: 8px; text-align: start; border-bottom: 2px solid var(--ink); background: var(--white);\n  font: 500 11px var(--mono); letter-spacing: 0.08em; text-transform: uppercase;\n}\n.grid thead td { border-bottom: 2px solid var(--ink); }\n.grid col.col-period { width: var(--pcol); }   /* wide enough for \"P2 9:00-9:50\" and one label on one line each */\n.p-line, .tag { white-space: nowrap; }\n.grid tbody td { height: var(--row-h); }\n.d-short { display: none; }\nth.period { padding: 6px 8px; text-align: start; font-weight: 400; background: var(--white); }\n.p-line { display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }\n.p-num { font: 500 18px/1 var(--mono); letter-spacing: -0.04em; }\n.p-time { font: 400 10px/1.2 var(--mono); color: var(--muted); }\n/* Labels that live on the grid instead of paragraphs */\n.tag { display: inline-block; margin-block-start: 4px; padding: 1px 4px; font: 500 10px/1.3 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; }\n.tag-clash { background: var(--clash); color: var(--white); }\n.tag-free { color: var(--ok); border: 1px solid var(--ok); }\n.tag-part { color: var(--muted); border: 1px solid var(--hair); }\ntr.lunch th {\n  height: 24px; padding: 2px 8px; text-align: start; background: var(--sheet);\n  font: 500 10px var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted);\n}\ntd.is-part { background: radial-gradient(var(--hair) 1px, transparent 1.4px) 0 0 / 8px 8px; }\n\n/* A placed class */\n.block {\n  display: flex; flex-direction: column; gap: 2px; height: 100%; min-height: var(--row-h);\n  padding: 6px 8px; background: var(--c); color: var(--ink);\n  /* SNAP: drops in from above and settles. Each day starts 45ms after the one before (Mon to Fri). */\n  animation: snap 240ms cubic-bezier(0.2, 0.7, 0.3, 1) both;\n  animation-delay: calc(var(--di, 0) * 45ms);\n}\n.block.is-opt { background: var(--optional), var(--c); }\n.block-code { font: 500 10px/1.2 var(--mono); letter-spacing: 0.02em; }\n.block-name { font: 600 14px/1.15 var(--sans); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.nowrap { white-space: nowrap; }\n@keyframes snap {\n  0%   { transform: translateY(-16px); opacity: 0; }\n  60%  { transform: translateY(2px);   opacity: 1; }   /* tiny overshoot = the \"snap\" */\n  100% { transform: none;              opacity: 1; }\n}\n\n/* A clash: hatched cell, codes stacked white-on-red. Never color-only: pattern + word + codes. */\n/* The hatch flashes, the codes shake side to side, the labels pop in. */\ntd.is-clash { background: var(--hatch); animation: flash 420ms ease-out 1; }\n@keyframes flash { 0% { opacity: 1; } 40% { opacity: 0.55; } 100% { opacity: 1; } }\n.clash-stack { display: flex; flex-direction: column; gap: 3px; padding: 4px; animation: shake 340ms ease-in-out 1; }\n@keyframes shake {\n  0%, 100% { transform: none; }\n  20% { transform: translateX(-5px); }\n  40% { transform: translateX(5px); }\n  60% { transform: translateX(-3px); }\n  80% { transform: translateX(3px); }\n}\n.tag-clash, .pill-clash, .pill-ok { animation: pop 220ms cubic-bezier(0.2, 0.7, 0.3, 1) both; }\n@keyframes pop {\n  0%   { transform: scale(0.6);  opacity: 0; }\n  70%  { transform: scale(1.08); opacity: 1; }\n  100% { transform: none;        opacity: 1; }\n}\n\n/* PLAN FITS: a light flash sweeps down the rows once, top to bottom */\n.celebrate tbody td::after {\n  content: \"\"; position: absolute; inset: 0; background: var(--white); pointer-events: none;\n  animation: sweep 380ms ease-out both;\n  animation-delay: calc(var(--ri, 0) * 70ms);\n}\n@keyframes sweep { 0% { opacity: 0; } 35% { opacity: 0.6; } 100% { opacity: 0; } }\n.clash-code { padding: 2px 6px; background: var(--clash); color: var(--white); font: 500 11px/1.2 var(--mono); }\n\n/* Ghost preview while hovering/focusing a period button (visual only) */\n.ghost { position: absolute; inset: 4px; border: 2px dashed var(--ink); pointer-events: none; }\n/* Physical top/right on purpose: the clip-path triangle is drawn for the top-right corner */\n.ghost.warn::after {\n  content: \"\"; position: absolute; top: 0; right: 0; width: 18px; height: 18px;\n  background: var(--hatch); clip-path: polygon(0 0, 100% 0, 100% 100%);\n}\n\n.footnote { margin-block-start: 12px; font: 400 12px var(--mono); color: var(--muted); }\n\n/* ============ RESPONSIVE ============ */\n@media (max-width: 899px) {\n  /* Tray moves above the grid as a compact, wrapping strip */\n  .workspace { grid-template-columns: minmax(0, 1fr); gap: 16px; }\n  .hint-wide { display: none; }     /* the tray is above now, so the hint points up */\n  .hint-narrow { display: inline; }\n}\n@media (min-width: 560px) and (max-width: 899px) {\n  /* Tablet / lesson iframe: tray in two columns, each with its own \"Periods offered\" label */\n  .tray-list, .tray-head { display: grid; grid-template-columns: 1fr 1fr; column-gap: 24px; }\n  .th-col-2 { display: flex; }\n}\n@media (max-width: 559px) {\n  :root { --pcol: 56px; }\n  .app { padding: 0 16px 16px; }\n  th.period { padding: 4px; }\n  .tag-days, .sec { display: none; }   /* phones: \"CLASH\" and \"ALG-1\" only; screen readers still get the full text */\n  .p-time { display: none; }\n  .d-long { display: none; }\n  .d-short { display: inline; }\n  .grid thead th { padding: 8px 4px; }\n  .block { padding: 4px; }\n  .clash-stack { padding: 2px; }\n  .clash-code { padding: 2px 3px; font-size: 10px; }\n  .block-name { display: none; }\n  .weekbar-end { margin-inline-start: 0; }\n}\n@media (hover: none) and (pointer: coarse) {\n  :root { --row-h: 52px; }\n}\n@media (prefers-reduced-motion: reduce) {\n  /* No movement: snap, shake and pop become instant changes */\n  .block, td.is-clash, .clash-stack, .tag-clash, .pill-clash, .pill-ok { animation: none !important; }\n  /* \"Plan fits\" becomes one shared brighten of the whole grid: no sweep, no stagger */\n  .celebrate tbody td::after { animation-duration: 600ms; animation-delay: 0s; }\n}\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    }
  },
  "audit_log": "[{\"changed_at\":\"2026-10-19T21:15:07.196+00:00\",\"changed\":[\"cloned from \\\"adaptive-HoAI26-intro-second-look\\\"\"],\"cloned_from\":\"adaptive-HoAI26-intro-second-look\"},{\"changed_at\":\"2026-10-19 21:15:08 +0000\",\"changed\":[],\"changed_by_id\":19429,\"changed_by_email\":\"liam.fryemason+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-20 18:29:21 +0000\",\"changed\":[],\"changed_by_id\":19429,\"changed_by_email\":\"liam.fryemason+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-20 18:31:17 +0000\",\"changed\":[],\"changed_by_id\":19429,\"changed_by_email\":\"liam.fryemason+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-20 18:31:23 +0000\",\"changed\":[],\"changed_by_id\":19429,\"changed_by_email\":\"liam.fryemason+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-23 00:04:00 +0000\",\"changed\":[\"ai_tutor_prompt_settings\"],\"changed_by_id\":19429,\"changed_by_email\":\"liam.fryemason+levelbuilder@code.org\"}]"
}]]></config>
