      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Pizza Order</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <h1>🍕 Pizza Order Form</h1>\n\n  <label>Choose Size:</label>\n  <select id=\"sizeSelect\">\n    <option value=\"Small\">Small</option>\n    <option value=\"Medium\">Medium</option>\n    <option value=\"Large\">Large</option>\n  </select>\n\n  <br><br>\n\n  <label>Choose Topping:</label>\n  <select id=\"toppingSelect\">\n    <option value=\"Pepperoni\">Pepperoni</option>\n    <option value=\"Olives\">Olives</option>\n    <option value=\"Veggies\">Veggies</option>\n  </select>\n\n  <br><br>\n\n  <button id=\"orderBtn\">Place Order</button>\n\n  <p id=\"output\"></p>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>\n",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// --- SELECT ELEMENTS ---\nconst sizeSelect = document.getElementById(\"sizeSelect\");\nconst toppingSelect = document.getElementById(\"toppingSelect\");\nconst orderBtn = document.getElementById(\"orderBtn\");\nconst outputElement = document.getElementById(\"output\");\n\n// --- FUNCTION WITH PARAMETERS ---\n\n\n\n\n\n// --- EVENT LISTENER ---\norderBtn.addEventListener(\"click\", () => {\n  const selectedSize = sizeSelect.value;\n  const selectedTopping = toppingSelect.value;\n  orderPizza(selectedSize, selectedTopping);\n});\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: Arial, sans-serif;\n  text-align: center;\n  margin-top: 50px;\n}\n\nselect, button {\n  padding: 6px 10px;\n  margin: 5px;\n  font-size: 16px;\n}\n\n#output {\n  margin-top: 20px;\n  font-weight: bold;\n  font-size: 18px;\n  color: darkred;\n}\n",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "documentation.md",
          "language": "md",
          "contents": "# Function: <orderPizza>\n\n# What it does\nDisplay a confirmation message for the user’s pizza order based on their selections.\n\n# Inputs\nsize — the chosen pizza size (string)\ntopping — the chosen topping (string)\n\n# What it changes\nVariables: Sets a local message string.\nOn screen: Updates outputElement.textContent to show message \n(e.g., “Order: Small pizza with pepperoni.”)",
          "folderId": "0",
          "active": true
        }
      },
