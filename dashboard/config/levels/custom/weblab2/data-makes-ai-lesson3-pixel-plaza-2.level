  "audit_log": "[{\"changed_at\":\"2026-11-18T19:58:44.164+00:00\",\"changed\":[\"cloned from \\\"data-makes-ai-lesson3-pixel-plaza\\\"\"],\"cloned_from\":\"data-makes-ai-lesson3-pixel-plaza\"},{\"changed_at\":\"2026-11-18 20:09:50 +0000\",\"changed\":[\"long_instructions\",\"hide_ai_tutor\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-11-18 20:10:18 +0000\",\"changed\":[\"start_sources\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-11-18 20:10:25 +0000\",\"changed\":[],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-11-18 20:15:45 +0000\",\"changed\":[\"start_sources\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-11-18 20:17:14 +0000\",\"changed\":[\"start_sources\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"}]"
}]]></config>
