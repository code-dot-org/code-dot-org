        "ask"
      ],
      "answerTypeCustomizations": {
      }
    },
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\" dir=\"ltr\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Gaming Chat Rules</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"app\" id=\"app\">\n    <header class=\"intro\">\n      <div class=\"intro-top\">\n        <h1 class=\"title\" data-copy=\"appTitle\"></h1>\n        <button type=\"button\" class=\"start-over\" id=\"start-over\" data-copy=\"startOver\"></button>\n      </div>\n      <p class=\"directions\" data-copy=\"directions\"></p>\n    </header>\n\n    <div class=\"bins\" id=\"bins\"></div>\n\n    <div class=\"workspace\">\n      <section class=\"tray-section\" id=\"tray-section\" aria-labelledby=\"tray-heading\">\n        <div class=\"tray-top\">\n          <h2 class=\"section-heading\" id=\"tray-heading\" data-copy=\"trayHeading\"></h2>\n          <p class=\"sorted-count\" id=\"sorted-count\"></p>\n        </div>\n        <ul class=\"tray\" id=\"tray\"></ul>\n      </section>\n\n      <section class=\"panel done\" id=\"done\" aria-labelledby=\"done-heading\" hidden>\n        <h2 class=\"section-heading\" id=\"done-heading\" data-copy=\"doneHeading\"></h2>\n        <p class=\"done-text\" data-copy=\"doneText\"></p>\n        <p class=\"done-text\" data-copy=\"doneExplain\"></p>\n      </section>\n\n      <section class=\"panel card\" id=\"card\" aria-labelledby=\"card-heading\">\n        <h2 class=\"visually-hidden\" id=\"card-heading\" data-copy=\"cardHeading\"></h2>\n        <p class=\"card-empty\" id=\"card-empty\" data-copy=\"cardEmpty\"></p>\n        <div class=\"card-body\" id=\"card-body\" hidden>\n          <h3 class=\"card-title\" id=\"card-title\"></h3>\n          <dl class=\"card-facts\">\n            <div class=\"card-fact\">\n              <dt data-copy=\"input\"></dt>\n              <dd id=\"card-input\"></dd>\n            </div>\n            <div class=\"card-fact\">\n              <dt data-copy=\"rule\"></dt>\n              <dd id=\"card-rule\"></dd>\n            </div>\n            <div class=\"card-fact\">\n              <dt data-copy=\"output\"></dt>\n              <dd id=\"card-output\"></dd>\n            </div>\n          </dl>\n          <div class=\"example\">\n            <p class=\"example-label\" data-copy=\"exampleLabel\"></p>\n            <div class=\"example-body\" id=\"card-example\"></div>\n          </div>\n          <div class=\"put-area\">\n            <p class=\"put-label\" id=\"put-label\" data-copy=\"putLabel\"></p>\n            <div class=\"put-buttons\" id=\"put-buttons\" role=\"group\" aria-labelledby=\"put-label\"></div>\n            <button type=\"button\" class=\"link-button\" id=\"put-back\" data-copy=\"putBack\" hidden></button>\n          </div>\n        </div>\n      </section>\n    </div>\n\n    <p class=\"status\" id=\"status\" role=\"status\" aria-live=\"polite\"></p>\n  </main>\n\n  <p class=\"app-error\" id=\"app-error\" role=\"alert\" hidden>Something went wrong while loading this activity. Try reloading the page.</p>\n  <noscript><p class=\"app-error\">This activity needs JavaScript to run. Ask your teacher for help.</p></noscript>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "'use strict';\n\nconst COPY = {\n  appTitle: 'Gaming Chat Rules',\n  directions: 'Put each rule on one side. Be ready to explain what happened in the gaming chat that made you decide.',\n  bins: {\n    human: { title: 'Human-written', text: 'A person wrote this rule.' },\n    learned: { title: 'Computer-learned', text: 'The computer learned this rule from examples.' },\n  },\n  binEmpty: 'No rules here yet.',\n  trayHeading: 'Rules to sort',\n  ruleLabel: (number) => `Rule #${number}`,\n  sortedCount: (sorted, total) => `${sorted} of ${total} sorted`,\n  cardHeading: 'Rule card',\n  cardEmpty: 'Pick a rule to read its card.',\n  cardTitle: (label, name) => `${label}: ${name}`,\n  input: 'Input:',\n  rule: 'Rule:',\n  output: 'Output:',\n  exampleLabel: 'In the gaming chat:',\n  nowSays: 'It now says:',\n  putLabel: 'Put this rule in:',\n  putIn: (label, binTitle) => `Put ${label} in ${binTitle}`,\n  putBack: 'Move back to the list',\n  tags: {\n    blocked: 'Blocked',\n    hidden: 'Hidden',\n    changed: 'Changed',\n    muted: 'Muted',\n  },\n  doneHeading: 'Every rule is sorted',\n  doneText: 'Now open your Activity Guide. If any of these rules are missing from it, add them.',\n  doneExplain: 'You can still move a rule if you change your mind.',\n  selected: (label, name) => `${label}: ${name}. The rule card is open.`,\n  placed: (label, binTitle) => `${label} is in ${binTitle}.`,\n  movedBack: (label) => `${label} is back in the list.`,\n  allSorted: 'Every rule is sorted. Add any missing rules to your Activity Guide.',\n  startOver: 'Start over',\n  reset: 'The sort started over.',\n};\n\nconst CONFIG = {\n  bins: ['human', 'learned'],\n  // Cards appear in this order and are numbered from 1. \"output\" is one of the tags in COPY.\n  // An example is a chat message (text, plus changedText if the chat changed it) or a note.\n  cards: [\n    {\n      name: 'Long numbers',\n      input: 'A message with 10 or more numbers in a row',\n      rule: 'Block it',\n      output: 'blocked',\n      example: { text: 'my high score is 1234567890!!' },\n    },\n    {\n      name: 'Put-downs',\n      input: 'Any message',\n      rule: 'Hide it if it puts someone down or leaves them out',\n      output: 'hidden',\n      example: { text: 'go away no one likes u' },\n    },\n    {\n      name: 'All caps',\n      input: 'A message in all capital letters',\n      rule: 'Change it to lowercase',\n      output: 'changed',\n      example: { text: 'WE WON!!!', changedText: 'we won!!!' },\n    },\n    {\n      name: 'Scams',\n      input: 'Any message',\n      rule: 'Block it if it looks like a scam',\n      output: 'blocked',\n      example: { text: 'send me ur password and ill give u 5000 coins' },\n    },\n    {\n      name: 'Banned words',\n      input: 'A message with a word from the banned list, like “trash”',\n      rule: 'Block it',\n      output: 'blocked',\n      example: { text: 'brb gotta take out the trash' },\n    },\n    {\n      name: 'Links',\n      input: 'A message with “.com”, “.net”, “.org” or “www.” in it',\n      rule: 'Block it',\n      output: 'blocked',\n      example: { text: 'check out my build at coolbuilds.com' },\n    },\n    {\n      name: 'Mute',\n      input: 'How many of a player’s messages got hidden',\n      rule: 'If it reaches 3, mute the player for 10 minutes',\n      output: 'muted',\n      example: { note: 'You got muted in Set 6.' },\n    },\n  ],\n};\n\nconst DRAG_THRESHOLD_PX = 8;\nconst CLICK_AFTER_DRAG_MS = 400;\nconst TRAY = 'tray';\n\nconst locale = document.documentElement.lang || 'en';\nconst numberFormat = new Intl.NumberFormat(locale);\nconst cardsById = {};\nconst binEls = {};\nconst timers = new Set();\nlet cardIds = [];\nlet els = {};\nlet state = createState();\n\nfunction createState() {\n  return {\n    placement: {},\n    selectedId: null,\n    drag: null,\n    dragEndedAt: -Infinity,\n  };\n}\n\n/* Setup */\n\nfunction init() {\n  els = {\n    app: document.getElementById('app'),\n    bins: document.getElementById('bins'),\n    traySection: document.getElementById('tray-section'),\n    sortedCount: document.getElementById('sorted-count'),\n    tray: document.getElementById('tray'),\n    done: document.getElementById('done'),\n    cardEmpty: document.getElementById('card-empty'),\n    cardBody: document.getElementById('card-body'),\n    cardTitle: document.getElementById('card-title'),\n    cardInput: document.getElementById('card-input'),\n    cardRule: document.getElementById('card-rule'),\n    cardOutput: document.getElementById('card-output'),\n    cardExample: document.getElementById('card-example'),\n    putButtons: document.getElementById('put-buttons'),\n    putBack: document.getElementById('put-back'),\n    status: document.getElementById('status'),\n    startOver: document.getElementById('start-over'),\n  };\n  Object.keys(els).forEach((key) => {\n    if (!els[key]) {\n      throw new Error(`Missing element: ${key}`);\n    }\n  });\n\n  buildCards();\n  buildBins();\n  fillStaticCopy();\n  bindEvents();\n  resetActivity(false);\n}\n\nfunction buildCards() {\n  cardIds = CONFIG.cards.map((card, index) => {\n    const id = `card${index + 1}`;\n    if (!COPY.tags[card.output]) {\n      throw new Error(`Card ${id} has an unknown output: ${card.output}`);\n    }\n    if (!card.example || (!card.example.text && !card.example.note)) {\n      throw new Error(`Card ${id} needs an example.`);\n    }\n    cardsById[id] = Object.assign({ id, label: COPY.ruleLabel(numberFormat.format(index + 1)) }, card);\n    return id;\n  });\n}\n\nfunction buildBins() {\n  CONFIG.bins.forEach((binId) => {\n    const copy = COPY.bins[binId];\n    if (!copy) {\n      throw new Error(`Missing copy for bin: ${binId}`);\n    }\n    const titleId = `bin-${binId}-title`;\n\n    const section = document.createElement('section');\n    section.className = 'bin';\n    section.dataset.bin = binId;\n    section.setAttribute('aria-labelledby', titleId);\n\n    const head = document.createElement('div');\n    head.className = 'bin-head';\n    const title = document.createElement('h2');\n    title.className = 'bin-title';\n    title.id = titleId;\n    title.textContent = copy.title;\n    const text = document.createElement('p');\n    text.className = 'bin-text';\n    text.textContent = copy.text;\n    head.appendChild(title);\n    head.appendChild(text);\n\n    const list = document.createElement('ul');\n    list.className = 'bin-list';\n\n    section.appendChild(head);\n    section.appendChild(list);\n    els.bins.appendChild(section);\n    binEls[binId] = { section, list };\n\n    const put = document.createElement('button');\n    put.type = 'button';\n    put.className = 'put-button';\n    put.dataset.bin = binId;\n    put.textContent = copy.title;\n    els.putButtons.appendChild(put);\n  });\n}\n\nfunction fillStaticCopy() {\n  document.querySelectorAll('[data-copy]').forEach((el) => {\n    el.textContent = COPY[el.dataset.copy];\n  });\n}\n\nfunction bindEvents() {\n  els.app.addEventListener('click', onAppClick);\n  els.app.addEventListener('pointerdown', onPointerDown);\n  document.addEventListener('pointermove', onPointerMove);\n  document.addEventListener('pointerup', onPointerUp);\n  document.addEventListener('pointercancel', cancelDrag);\n  document.addEventListener('keydown', onKeyDown);\n  els.startOver.addEventListener('click', () => resetActivity(true));\n}\n\nfunction resetActivity(announce) {\n  clearTimers();\n  cancelDrag();\n  state = createState();\n  cardIds.forEach((id) => {\n    state.placement[id] = null;\n  });\n\n  renderChips();\n  updateSelection();\n  if (announce) {\n    setStatus(COPY.reset);\n  } else {\n    els.status.textContent = '';\n  }\n}\n\n/* Timers */\n\nfunction later(fn, ms) {\n  const id = setTimeout(() => {\n    timers.delete(id);\n    fn();\n  }, ms);\n  timers.add(id);\n}\n\nfunction clearTimers() {\n  timers.forEach((id) => clearTimeout(id));\n  timers.clear();\n}\n\n/* Rendering */\n\nfunction isAllSorted() {\n  return cardIds.every((id) => state.placement[id]);\n}\n\nfunction renderChips() {\n  els.tray.textContent = '';\n  CONFIG.bins.forEach((binId) => {\n    binEls[binId].list.textContent = '';\n  });\n\n  cardIds.forEach((id) => {\n    const binId = state.placement[id];\n    const list = binId ? binEls[binId].list : els.tray;\n    const li = document.createElement('li');\n    li.appendChild(makeChip(id));\n    list.appendChild(li);\n  });\n\n  CONFIG.bins.forEach((binId) => {\n    const list = binEls[binId].list;\n    if (!list.firstElementChild) {\n      const li = document.createElement('li');\n      li.className = 'bin-empty';\n      li.textContent = COPY.binEmpty;\n      list.appendChild(li);\n    }\n  });\n\n  const sorted = cardIds.filter((id) => state.placement[id]).length;\n  els.sortedCount.textContent = COPY.sortedCount(numberFormat.format(sorted), numberFormat.format(cardIds.length));\n\n  const allSorted = isAllSorted();\n  els.traySection.hidden = allSorted;\n  els.done.hidden = !allSorted;\n}\n\nfunction makeChip(id) {\n  const button = document.createElement('button');\n  button.type = 'button';\n  button.className = 'chip';\n  button.dataset.id = id;\n  button.textContent = cardsById[id].label;\n  button.setAttribute('aria-pressed', String(id === state.selectedId));\n  return button;\n}\n\nfunction updateSelection() {\n  els.app.querySelectorAll('.chip').forEach((button) => {\n    button.setAttribute('aria-pressed', String(button.dataset.id === state.selectedId));\n  });\n\n  const card = cardsById[state.selectedId];\n  CONFIG.bins.forEach((binId) => {\n    binEls[binId].section.classList.toggle('is-open', Boolean(card));\n  });\n  els.cardEmpty.hidden = Boolean(card);\n  els.cardBody.hidden = !card;\n  if (card) {\n    renderCard(card);\n  }\n}\n\nfunction renderCard(card) {\n  els.cardTitle.textContent = COPY.cardTitle(card.label, card.name);\n  els.cardInput.textContent = card.input;\n  els.cardRule.textContent = card.rule;\n  els.cardOutput.textContent = COPY.tags[card.output];\n\n  els.cardExample.textContent = '';\n  if (card.example.note) {\n    const note = document.createElement('p');\n    note.className = 'example-note';\n    note.textContent = card.example.note;\n    els.cardExample.appendChild(note);\n    els.cardExample.appendChild(makeTag(card.output));\n  } else {\n    els.cardExample.appendChild(makeBubble(card.example.text, card.output));\n    els.cardExample.appendChild(makeTag(card.output));\n    if (card.example.changedText) {\n      const row = document.createElement('div');\n      row.className = 'example-row';\n      const nowSays = document.createElement('p');\n      nowSays.className = 'example-note';\n      nowSays.textContent = COPY.nowSays;\n      row.appendChild(nowSays);\n      row.appendChild(makeBubble(card.example.changedText, null));\n      els.cardExample.appendChild(row);\n    }\n  }\n\n  els.putButtons.querySelectorAll('.put-button').forEach((button) => {\n    button.setAttribute('aria-label', COPY.putIn(card.label, COPY.bins[button.dataset.bin].title));\n  });\n  els.putBack.hidden = !state.placement[card.id];\n}\n\nfunction makeBubble(text, outcome) {\n  const bubble = document.createElement('p');\n  bubble.className = 'bubble';\n  if (outcome === 'blocked') {\n    bubble.classList.add('is-blocked');\n  } else if (outcome === 'hidden') {\n    bubble.classList.add('is-hidden');\n  }\n  bubble.textContent = text;\n  return bubble;\n}\n\nfunction makeTag(kind) {\n  const tag = document.createElement('span');\n  tag.className = `tag tag-${kind}`;\n  tag.textContent = COPY.tags[kind];\n  return tag;\n}\n\n/* Selecting and placing */\n\nfunction selectCard(id) {\n  state.selectedId = id;\n  updateSelection();\n}\n\nfunction clearSelection() {\n  state.selectedId = null;\n  updateSelection();\n}\n\n// target is a bin id, or null to send the card back to the list.\nfunction moveCard(id, target, focusChip) {\n  const card = cardsById[id];\n  if (!card) {\n    return;\n  }\n  const wasAllSorted = isAllSorted();\n  state.placement[id] = target;\n  state.selectedId = null;\n  renderChips();\n  updateSelection();\n\n  if (focusChip) {\n    const chip = els.app.querySelector(`.chip[data-id=\"${id}\"]`);\n    if (chip) {\n      chip.focus();\n    }\n  }\n\n  if (!target) {\n    setStatus(COPY.movedBack(card.label));\n  } else if (isAllSorted() && !wasAllSorted) {\n    setStatus(COPY.allSorted);\n  } else {\n    setStatus(COPY.placed(card.label, COPY.bins[target].title));\n  }\n}\n\nfunction onAppClick(event) {\n  if (performance.now() - state.dragEndedAt < CLICK_AFTER_DRAG_MS) {\n    return;\n  }\n\n  const chip = event.target.closest('.chip');\n  if (chip) {\n    const id = chip.dataset.id;\n    if (state.selectedId === id) {\n      clearSelection();\n      clearStatus();\n    } else {\n      selectCard(id);\n      setStatus(COPY.selected(cardsById[id].label, cardsById[id].name));\n    }\n    return;\n  }\n\n  if (!state.selectedId) {\n    return;\n  }\n\n  const put = event.target.closest('.put-button');\n  if (put) {\n    moveCard(state.selectedId, put.dataset.bin, true);\n    return;\n  }\n  if (event.target.closest('#put-back')) {\n    moveCard(state.selectedId, null, true);\n    return;\n  }\n  // Clicking anywhere in a bin is a pointer shortcut for the card's own buttons.\n  const bin = event.target.closest('.bin');\n  if (bin) {\n    moveCard(state.selectedId, bin.dataset.bin, false);\n  }\n}\n\nfunction onKeyDown(event) {\n  if (event.key === 'Escape') {\n    cancelDrag();\n    if (state.selectedId) {\n      clearSelection();\n      clearStatus();\n    }\n  }\n}\n\n/* Dragging */\n\nfunction onPointerDown(event) {\n  const chip = event.target.closest('.chip');\n  if (!chip) {\n    return;\n  }\n  if (event.pointerType === 'mouse' && event.button !== 0) {\n    return;\n  }\n  state.drag = { id: chip.dataset.id, startX: event.clientX, startY: event.clientY, ghost: null };\n}\n\nfunction onPointerMove(event) {\n  const drag = state.drag;\n  if (!drag) {\n    return;\n  }\n  if (!drag.ghost) {\n    const distance = Math.hypot(event.clientX - drag.startX, event.clientY - drag.startY);\n    if (distance < DRAG_THRESHOLD_PX) {\n      return;\n    }\n    drag.ghost = createGhost(drag.id);\n    selectCard(drag.id);\n  }\n  event.preventDefault();\n  moveGhost(drag.ghost, event.clientX, event.clientY);\n  showDropTarget(dropTargetAt(event.clientX, event.clientY));\n}\n\nfunction onPointerUp(event) {\n  const drag = state.drag;\n  if (!drag) {\n    return;\n  }\n  const target = drag.ghost ? dropTargetAt(event.clientX, event.clientY) : null;\n  if (drag.ghost) {\n    state.dragEndedAt = performance.now();\n  }\n  cancelDrag();\n  if (target === TRAY) {\n    if (state.placement[drag.id]) {\n      moveCard(drag.id, null, false);\n    }\n  } else if (target) {\n    moveCard(drag.id, target, false);\n  }\n}\n\nfunction cancelDrag() {\n  if (state.drag && state.drag.ghost) {\n    state.drag.ghost.remove();\n  }\n  state.drag = null;\n  showDropTarget(null);\n}\n\nfunction createGhost(id) {\n  const ghost = document.createElement('div');\n  ghost.className = 'chip-ghost';\n  ghost.setAttribute('aria-hidden', 'true');\n  ghost.textContent = cardsById[id].label;\n  document.body.appendChild(ghost);\n  return ghost;\n}\n\nfunction moveGhost(ghost, x, y) {\n  const left = x - ghost.offsetWidth / 2;\n  const top = y - ghost.offsetHeight / 2;\n  ghost.style.transform = `translate(${left}px, ${top}px) rotate(-4deg)`;\n}\n\nfunction isInside(el, x, y) {\n  if (el.hidden) {\n    return false;\n  }\n  const rect = el.getBoundingClientRect();\n  return x >= rect.left && x <= rect.right && y >= rect.top && y <= rect.bottom;\n}\n\nfunction dropTargetAt(x, y) {\n  const binId = CONFIG.bins.find((id) => isInside(binEls[id].section, x, y));\n  if (binId) {\n    return binId;\n  }\n  return isInside(els.traySection, x, y) ? TRAY : null;\n}\n\nfunction showDropTarget(target) {\n  CONFIG.bins.forEach((binId) => {\n    binEls[binId].section.classList.toggle('is-over', binId === target);\n  });\n  els.tray.classList.toggle('is-over', target === TRAY);\n}\n\n/* Helpers */\n\nfunction setStatus(text) {\n  els.status.textContent = '';\n  later(() => {\n    els.status.textContent = text;\n  }, 50);\n}\n\nfunction clearStatus() {\n  clearTimers();\n  els.status.textContent = '';\n}\n\nfunction showLoadError(error) {\n  const app = document.getElementById('app');\n  const message = document.getElementById('app-error');\n  if (app) {\n    app.hidden = true;\n  }\n  if (message) {\n    message.hidden = false;\n  }\n  console.error(error);\n}\n\ntry {\n  init();\n} catch (error) {\n  showLoadError(error);\n}",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": ":root {\n  --purple-light: #e4e2f8;\n  --purple-mid: #aca8ea;\n  --purple: #4c42cf;\n  --purple-dark: #1f1976;\n  --ink: #1a1730;\n  --ink-soft: #4a4670;\n  --surface: #ffffff;\n  --page: #f5f4fc;\n\n  --error-bg: #ffdcdc;\n  --error-ink: #8a1020;\n  --danger-dark: #5e0a15;\n  --warning-bg: #ffefa8;\n  --warning-ink: #4f3b00;\n  --info-bg: #d5efff;\n  --info-ink: #06338d;\n  --neutral-bg: #26232f;\n  --neutral-ink: #ffffff;\n\n  --focus: #e11970;\n  --shadow-hard: 3px 3px 0 var(--purple-dark);\n  --radius: 0.75rem;\n  --font: system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans\", Arial, sans-serif;\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nbody {\n  margin: 0;\n  font-family: var(--font);\n  font-size: 1rem;\n  line-height: 1.4;\n  color: var(--ink);\n  background: var(--page);\n}\n\nbutton {\n  font: inherit;\n}\n\n:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 3px;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n/* Layout */\n\n.app {\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n  max-width: 46rem;\n  margin-inline: auto;\n  padding: 0.75rem;\n}\n\n.intro-top {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: 0.4rem 0.75rem;\n  margin-block-end: 0.3rem;\n}\n\n.start-over {\n  min-height: 2.25rem;\n  padding: 0.2rem 0.8rem;\n  font-weight: 800;\n  color: var(--surface);\n  background: var(--error-ink);\n  border: 2px solid var(--ink);\n  border-radius: 0.6rem;\n  cursor: pointer;\n}\n\n.start-over:hover {\n  background: var(--danger-dark);\n}\n\n.title {\n  margin: 0;\n  font-size: 1.25rem;\n  color: var(--purple-dark);\n}\n\n.directions {\n  margin: 0;\n  font-size: 0.95rem;\n  color: var(--ink-soft);\n}\n\n.workspace {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  gap: 0.75rem;\n  align-items: start;\n}\n\n.section-heading {\n  margin: 0;\n  font-size: 1.05rem;\n  color: var(--purple-dark);\n}\n\n/* Bins */\n\n.bins {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 0.75rem;\n}\n\n.bin {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  overflow: hidden;\n  background: var(--surface);\n  border: 3px solid var(--purple);\n  border-radius: var(--radius);\n  box-shadow: var(--shadow-hard);\n}\n\n.bin.is-open {\n  border-style: dashed;\n  cursor: pointer;\n}\n\n.bin.is-over {\n  background: var(--purple-light);\n}\n\n.bin-head {\n  padding: 0.45rem 0.65rem;\n  border-block-end: 2px solid var(--purple-mid);\n}\n\n.bin-title {\n  margin: 0;\n  font-size: 1.05rem;\n  color: var(--purple);\n  overflow-wrap: anywhere;\n}\n\n.bin-text {\n  margin: 0;\n  font-size: 0.85rem;\n}\n\n.bin-list {\n  display: flex;\n  flex-wrap: wrap;\n  align-content: flex-start;\n  gap: 0.5rem;\n  min-height: 4.25rem;\n  margin: 0;\n  padding: 0.6rem 0.65rem 0.7rem;\n  list-style: none;\n}\n\n.bin-empty {\n  margin: 0;\n  font-size: 0.85rem;\n  font-style: italic;\n  color: var(--ink-soft);\n}\n\n/* Rule chips */\n\n.tray-top {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 0.25rem 0.75rem;\n  margin-block-end: 0.5rem;\n}\n\n.sorted-count {\n  margin: 0;\n  font-size: 0.9rem;\n  font-weight: 700;\n  color: var(--ink-soft);\n}\n\n.tray {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.6rem;\n  min-height: 2.75rem;\n  margin: 0;\n  padding: 0.2rem 0.3rem 0.4rem 0.1rem;\n  border-radius: var(--radius);\n  list-style: none;\n}\n\n.tray.is-over {\n  background: var(--purple-light);\n}\n\n.chip,\n.chip-ghost {\n  min-height: 2.5rem;\n  padding: 0.3rem 0.7rem;\n  font-weight: 700;\n  white-space: nowrap;\n  color: var(--ink);\n  background: var(--surface);\n  border: 2px solid var(--purple-dark);\n  border-radius: 0.6rem;\n  box-shadow: var(--shadow-hard);\n}\n\n.chip {\n  --tilt: 0deg;\n  cursor: grab;\n  transform: rotate(var(--tilt));\n  touch-action: none;\n  -webkit-user-select: none;\n  user-select: none;\n}\n\n.tray li:nth-child(odd) .chip {\n  --tilt: -1.5deg;\n}\n\n.tray li:nth-child(even) .chip {\n  --tilt: 1.2deg;\n}\n\n.chip:hover {\n  background: var(--purple-light);\n}\n\n.chip[aria-pressed=\"true\"] {\n  color: var(--surface);\n  background: var(--purple);\n  animation: wiggle 0.4s ease-in-out;\n}\n\n.chip-ghost {\n  position: fixed;\n  top: 0;\n  left: 0;\n  z-index: 10;\n  display: flex;\n  align-items: center;\n  pointer-events: none;\n  color: var(--surface);\n  background: var(--purple);\n  opacity: 0.95;\n}\n\n/* Panels */\n\n.panel {\n  padding: 0.75rem 0.85rem;\n  background: var(--surface);\n  border: 2px solid var(--purple-dark);\n  border-radius: var(--radius);\n  box-shadow: var(--shadow-hard);\n}\n\n.done {\n  border: 3px solid var(--purple);\n  animation: panel-pop 0.35s ease-out;\n}\n\n.done-text {\n  margin: 0.4rem 0 0;\n}\n\n/* Rule card */\n\n.card-empty {\n  margin: 0;\n  font-weight: 600;\n  color: var(--purple-dark);\n}\n\n.card-title {\n  margin: 0 0 0.45rem;\n  font-size: 1.15rem;\n  color: var(--purple-dark);\n}\n\n.card-facts {\n  margin: 0 0 0.6rem;\n}\n\n.card-fact {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0 0.4rem;\n  margin-block-end: 0.15rem;\n}\n\n.card-fact dt {\n  font-weight: 700;\n  color: var(--purple);\n}\n\n.card-fact dd {\n  flex: 1 1 12rem;\n  min-width: 0;\n  margin: 0;\n}\n\n.example {\n  padding: 0.55rem 0.7rem 0.65rem;\n  background: var(--purple-light);\n  border-radius: var(--radius);\n}\n\n.example-label {\n  margin: 0 0 0.4rem;\n  font-size: 0.85rem;\n  font-weight: 700;\n  color: var(--purple-dark);\n}\n\n.example-body,\n.example-row {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.5rem 0.6rem;\n}\n\n.example-row {\n  flex-basis: 100%;\n}\n\n.example-note {\n  margin: 0;\n}\n\n.bubble {\n  margin: 0;\n  padding: 0.4rem 0.8rem;\n  color: var(--surface);\n  background: var(--purple);\n  border: 2px solid var(--purple-dark);\n  border-radius: 1rem;\n  overflow-wrap: anywhere;\n}\n\n.bubble.is-blocked {\n  border-color: var(--error-ink);\n  text-decoration: line-through;\n  text-decoration-thickness: 2px;\n}\n\n.bubble.is-hidden {\n  color: var(--ink-soft);\n  background: var(--surface);\n  border-style: dashed;\n  border-color: var(--ink-soft);\n}\n\n.tag {\n  display: inline-block;\n  padding: 0.1rem 0.55rem;\n  font-size: 0.85rem;\n  font-weight: 800;\n  border: 2px solid currentColor;\n  border-radius: 0.4rem;\n  box-shadow: 2px 2px 0 currentColor;\n  transform: rotate(-3deg);\n}\n\n.tag-blocked {\n  color: var(--error-ink);\n  background: var(--error-bg);\n}\n\n.tag-hidden {\n  color: var(--warning-ink);\n  background: var(--warning-bg);\n}\n\n.tag-changed {\n  color: var(--info-ink);\n  background: var(--info-bg);\n}\n\n.tag-muted {\n  color: var(--neutral-ink);\n  background: var(--neutral-bg);\n  border-color: var(--neutral-bg);\n  box-shadow: 2px 2px 0 var(--purple-dark);\n}\n\n/* Placing a rule */\n\n.put-area {\n  margin-block-start: 0.7rem;\n}\n\n.put-label {\n  margin: 0 0 0.4rem;\n  font-weight: 700;\n}\n\n.put-buttons {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.6rem;\n}\n\n.put-button {\n  flex: 1 1 9rem;\n  min-height: 2.75rem;\n  padding: 0.35rem 0.8rem;\n  font-weight: 800;\n  color: var(--surface);\n  background: var(--purple);\n  border: 2px solid var(--purple-dark);\n  border-radius: 0.6rem;\n  box-shadow: var(--shadow-hard);\n  cursor: pointer;\n}\n\n.put-button:hover {\n  background: var(--purple-dark);\n}\n\n.link-button {\n  align-self: flex-start;\n  min-height: 2.25rem;\n  padding: 0.25rem 0.5rem;\n  font-weight: 700;\n  color: var(--purple-dark);\n  text-decoration: underline;\n  text-underline-offset: 0.2em;\n  background: none;\n  border: 0;\n  cursor: pointer;\n}\n\n.put-area .link-button {\n  margin-block-start: 0.3rem;\n  padding-inline-start: 0;\n}\n\n/* Status and error */\n\n.status {\n  min-height: 1.4em;\n  margin: 0;\n  font-size: 0.95rem;\n  font-weight: 600;\n  color: var(--purple-dark);\n}\n\n.app-error {\n  max-width: 40rem;\n  margin: 2rem auto;\n  padding: 1rem;\n  font-weight: 700;\n  color: var(--error-ink);\n  background: var(--error-bg);\n  border: 2px solid var(--error-ink);\n  border-radius: var(--radius);\n}\n\n/* Animations */\n\n@keyframes wiggle {\n  0% { transform: rotate(var(--tilt)); }\n  30% { transform: rotate(-4deg); }\n  60% { transform: rotate(3deg); }\n  100% { transform: rotate(var(--tilt)); }\n}\n\n@keyframes panel-pop {\n  0%, 100% { transform: scale(1); }\n  50% { transform: scale(1.03); }\n}\n\n/* Wide and very narrow panes */\n\n@media (min-width: 42rem) {\n  .workspace {\n    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);\n  }\n}\n\n@media (max-width: 21rem) {\n  .bins {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n}",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    },
    "hide_ai_tutor": "true"
  },
