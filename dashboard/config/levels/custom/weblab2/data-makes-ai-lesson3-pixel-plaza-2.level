  "user_id": 18603,
  "properties": {
    "encrypted": "false",
    "long_instructions": "# Who Wrote This Rule?\r\n\r\nSort the different rules that are used in the gaming chat into `human-written` or `computer-learned` categories.\r\n\r\nClicking a rule will open details about it.\r\n\r\nAdd new rules into your Activity Guide.\r\n",
    "offer_browser_tts": "false",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "true",
    "require_edit_to_continue": "true",
    "initial_view_mode": "split",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "placeholderText": "",
      "multipleChoiceOptions": [
        ""
      ],
      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false
    },
