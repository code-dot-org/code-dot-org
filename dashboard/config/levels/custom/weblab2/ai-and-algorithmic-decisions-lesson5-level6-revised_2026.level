        "3": {
          "id": "3",
          "name": "index.html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Conditional Practice</title>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <link rel=\"stylesheet\" href=\"./style.css\">\n</head>\n<body>\n  <main class=\"container\">\n    <h1>Conditional Practice</h1>\n    <div id=\"result\" class=\"result\">\n      Result will appear here.\n    </div>\n    <div class=\"buttonRow\">\n      <button id=\"conditionTrue\">Condition True</button>\n      <button id=\"conditionFalse\">Condition False</button>\n    </div>\n  </main>\n  <script src=\"./script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "style.css",
          "contents": "body {\n  font-family: sans-serif;\n  background: #f0f4f8;\n  display: flex;\n  justify-content: center;\n  padding: 40px 20px;\n}\n\n.container {\n  background: white;\n  border-radius: 8px;\n  padding: 32px;\n  max-width: 420px;\n  width: 100%;\n  box-shadow: 0 2px 8px rgba(0,0,0,0.1);\n}\n\nh1 {\n  font-size: 22px;\n  margin-bottom: 20px;\n}\n\n.result {\n  border: 1px solid #e2e8f0;\n  border-radius: 6px;\n  padding: 12px 16px;\n  margin-bottom: 20px;\n  color: #718096;\n  font-size: 15px;\n  min-height: 52px;\n}\n\n.buttonRow {\n  display: flex;\n  gap: 12px;\n}\n\nbutton {\n  flex: 1;\n  padding: 12px;\n  background: #2b4c7e;\n  color: white;\n  border: none;\n  border-radius: 6px;\n  font-size: 15px;\n  cursor: pointer;\n}\n\nbutton:hover {\n  background: #f6ad55;\n  color: #1a202c;\n}",
