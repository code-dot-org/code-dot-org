          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html>\n  <head>\n  </head>\n  <body>\n    <h2>Breakfast Foods</h2>\n    \n    <ul>\n      <li>Cereal</li>\n      <li>Eggs</li>\n      <li>Waffles</li>\n    </ul>\n    \n    <h2>Desserts</h2>\n    \n  </body>\n</html>",
