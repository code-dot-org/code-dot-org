      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en-US\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Vocabulary cards</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"app\" id=\"app\">\n    <h1 class=\"deck-title\" id=\"deck-title\">Vocabulary cards</h1>\n\n    <div class=\"stage\">\n      <div class=\"card\" id=\"card\" tabindex=\"0\" role=\"group\" aria-labelledby=\"deck-title\" hidden>\n        <div class=\"card-inner\">\n          <section class=\"card-face card-front\" id=\"card-front\">\n            <span class=\"card-label\"></span>\n            <div class=\"card-content\"></div>\n            <p class=\"card-hint\"></p>\n          </section>\n          <section class=\"card-face card-back\" id=\"card-back\" aria-hidden=\"true\">\n            <span class=\"card-label\"></span>\n            <div class=\"card-content\"></div>\n          </section>\n        </div>\n      </div>\n\n      <div class=\"message\" id=\"message\" tabindex=\"-1\">\n        <p class=\"message-text\" id=\"message-text\">Loading cards...</p>\n        <p class=\"message-detail\" id=\"message-detail\" hidden></p>\n        <div class=\"message-actions\" id=\"message-actions\" hidden>\n          <button type=\"button\" class=\"btn\" id=\"finish-restart\">\n            <span class=\"btn-label\">Start over</span>\n            <span class=\"btn-key\">R</span>\n          </button>\n          <button type=\"button\" class=\"btn btn-secondary\" id=\"finish-review\" hidden>\n            <span class=\"btn-label\"></span>\n          </button>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"controls controls-primary\">\n      <button type=\"button\" class=\"btn\" id=\"btn-back\" disabled>\n        <span class=\"btn-label\">Back</span>\n        <span class=\"btn-key\">Left</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-flip\" id=\"btn-flip\" disabled>\n        <span class=\"btn-label\">Flip</span>\n        <span class=\"btn-key\">Space</span>\n      </button>\n      <button type=\"button\" class=\"btn\" id=\"btn-next\" disabled>\n        <span class=\"btn-label\">Next</span>\n        <span class=\"btn-key\">Right</span>\n      </button>\n    </div>\n\n    <fieldset class=\"controls controls-secondary\" id=\"options\">\n      <legend class=\"visually-hidden\" id=\"options-legend\">Card options</legend>\n      <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-shuffle\" disabled>\n        <span class=\"btn-label\">Shuffle</span>\n        <span class=\"btn-key\">S</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-direction\" disabled>\n        <span class=\"btn-label\">Start from definition</span>\n        <span class=\"btn-key\">F</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-secondary btn-toggle\" id=\"btn-known\" aria-pressed=\"false\" disabled>\n        <span class=\"btn-label\">\n          <svg class=\"check-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M2.5 8.5l3.5 3.5 7.5-8\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>\n          <span class=\"btn-text\">Got it</span>\n        </span>\n        <span class=\"btn-key\">K</span>\n      </button>\n      <button type=\"button\" class=\"btn btn-secondary\" id=\"btn-restart\" disabled>\n        <span class=\"btn-label\">Start over</span>\n        <span class=\"btn-key\">R</span>\n      </button>\n    </fieldset>\n\n    <div class=\"status\" aria-live=\"polite\">\n      <p class=\"counter\" id=\"counter\"></p>\n      <p class=\"visually-hidden\" id=\"sr-status\"></p>\n    </div>\n  </main>\n</body>\n</html>\n",
          "active": true,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "\"use strict\";\n\nconst STRINGS = {\n  pageTitle: \"Vocabulary cards\",\n  loading: \"Loading cards...\",\n  loadErrorDeck: \"The cards didn’t load. Ask your teacher to check deck.json.\",\n  loadErrorConfig: \"The cards didn’t load. Ask your teacher to check config.json.\",\n  kindLabels: {\n    word: \"WORD\",\n    definition: \"DEFINITION\",\n    example: \"EXAMPLE\",\n    image: \"IMAGE\"\n  },\n  kindNames: {\n    word: \"Word\",\n    definition: \"Definition\",\n    example: \"Example\",\n    image: \"Picture\"\n  },\n  hints: {\n    word: \"Guess the word\",\n    definition: \"Guess the definition\",\n    example: \"Guess the example\"\n  },\n  back: \"Back\",\n  flip: \"Flip\",\n  next: \"Next\",\n  keys: {\n    back: \"Left\",\n    flip: \"Space\",\n    next: \"Right\",\n    shuffle: \"S\",\n    direction: \"F\",\n    known: \"K\",\n    restart: \"R\"\n  },\n  optionsLegend: \"Card options\",\n  shuffle: \"Shuffle\",\n  startFrom: {\n    word: \"Start from word\",\n    definition: \"Start from definition\",\n    example: \"Start from example\"\n  },\n  gotIt: \"Got it\",\n  startOver: \"Start over\",\n  counter: (position, total) => `Card ${position} of ${total}`,\n  leftToLearn: {\n    one: (count) => `${count} left to learn`,\n    other: (count) => `${count} left to learn`\n  },\n  finished: {\n    one: () => \"You went through the only card\",\n    other: (count) => `You went through all ${count} cards`\n  },\n  allKnown: \"You marked every card. Nice work.\",\n  reviewUnknown: {\n    one: () => \"Review the 1 you haven’t marked\",\n    other: (count) => `Review the ${count} you haven’t marked`\n  },\n  faceAnnouncement: (kindName, content) => `${kindName}: ${content}`,\n  cardAnnouncement: (position, face, hint) => `${position}. ${face} ${hint}.`,\n  flipAnnouncement: (face) => `Other side. ${face}`,\n  shuffledAnnouncement: (position) => `Cards shuffled. ${position}.`,\n  knownAnnouncement: \"Marked as known.\",\n  unknownAnnouncement: \"Not marked as known.\",\n  firstCardAnnouncement: \"This is the first card.\",\n  pictureMissing: \"Picture not available.\"\n};\n\nconst CARD_TYPES = {\n  \"word-definition\": { front: \"word\", back: \"definition\", mirror: \"definition-word\" },\n  \"definition-word\": { front: \"definition\", back: \"word\", mirror: \"word-definition\" },\n  \"image-word\": { front: \"image\", back: \"word-definition\", mirror: null },\n  \"example-word\": { front: \"example\", back: \"word\", mirror: \"word-example\" },\n  \"word-example\": { front: \"word\", back: \"example\", mirror: \"example-word\" }\n};\n\nconst DEFAULT_CONFIG = {\n  theme: {\n    background: \"#E4E2F8\",\n    cardFace: \"#FFFFFF\",\n    textColor: \"#000000\",\n    accent: \"#4C42CF\",\n    frameColors: {\n      word: \"#0099F3\",\n      definition: \"#003F25\",\n      example: \"#F46800\",\n      image: \"#4C42CF\"\n    },\n    fontFamily: \"system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif\",\n    wordSize: \"large\",\n    textAlign: \"center\",\n    textPosition: \"center\",\n    cornerRadius: \"medium\"\n  },\n  controls: {\n    shuffle: true,\n    flipDirection: true,\n    progressCounter: true,\n    markKnown: true\n  },\n  startFlipped: false,\n  startShuffled: false\n};\n\nconst ENUMS = {\n  wordSize: [\"medium\", \"large\", \"xlarge\"],\n  textAlign: [\"start\", \"center\"],\n  textPosition: [\"top\", \"center\"],\n  cornerRadius: [\"none\", \"medium\", \"round\"]\n};\n\nconst RTL_LANGUAGES = [\"ar\", \"dv\", \"fa\", \"he\", \"ps\", \"ur\", \"yi\"];\nconst SVG_NS = \"http://www.w3.org/2000/svg\";\n\nconst state = {\n  ready: false,\n  config: DEFAULT_CONFIG,\n  title: STRINGS.pageTitle,\n  cards: [],\n  pass: [],\n  index: 0,\n  flipped: false,\n  reversed: false,\n  finished: false,\n  known: new Set()\n};\n\nconst els = {};\n\ndocument.addEventListener(\"DOMContentLoaded\", init);\n\nfunction init() {\n  cacheElements();\n  applyStrings();\n  bindEvents();\n  showMessage(STRINGS.loading);\n  loadData();\n}\n\nfunction cacheElements() {\n  const ids = [\n    \"app\", \"deck-title\", \"card\", \"card-front\", \"card-back\", \"message\", \"message-text\",\n    \"message-detail\", \"message-actions\", \"finish-restart\", \"finish-review\", \"btn-back\",\n    \"btn-flip\", \"btn-next\", \"options\", \"options-legend\", \"btn-shuffle\", \"btn-direction\",\n    \"btn-known\", \"btn-restart\", \"counter\", \"sr-status\"\n  ];\n  ids.forEach((id) => {\n    els[toCamel(id)] = document.getElementById(id);\n  });\n}\n\nfunction toCamel(id) {\n  return id.replace(/-([a-z])/g, (match, letter) => letter.toUpperCase());\n}\n\nfunction applyStrings() {\n  document.title = STRINGS.pageTitle;\n  els.deckTitle.textContent = STRINGS.pageTitle;\n  setButtonText(els.btnBack, STRINGS.back, STRINGS.keys.back);\n  setButtonText(els.btnFlip, STRINGS.flip, STRINGS.keys.flip);\n  setButtonText(els.btnNext, STRINGS.next, STRINGS.keys.next);\n  setButtonText(els.btnShuffle, STRINGS.shuffle, STRINGS.keys.shuffle);\n  setButtonText(els.btnDirection, STRINGS.startFrom.definition, STRINGS.keys.direction);\n  setButtonText(els.btnKnown, STRINGS.gotIt, STRINGS.keys.known);\n  setButtonText(els.btnRestart, STRINGS.startOver, STRINGS.keys.restart);\n  setButtonText(els.finishRestart, STRINGS.startOver, STRINGS.keys.restart);\n  els.optionsLegend.textContent = STRINGS.optionsLegend;\n}\n\nfunction setButtonText(button, label, key) {\n  const text = button.querySelector(\".btn-text\") || button.querySelector(\".btn-label\");\n  text.textContent = label;\n  const keyEl = button.querySelector(\".btn-key\");\n  if (keyEl) {\n    keyEl.textContent = key;\n  }\n}\n\nfunction bindEvents() {\n  els.btnBack.addEventListener(\"click\", goBack);\n  els.btnFlip.addEventListener(\"click\", flip);\n  els.btnNext.addEventListener(\"click\", goNext);\n  els.btnShuffle.addEventListener(\"click\", shuffleCards);\n  els.btnDirection.addEventListener(\"click\", switchDirection);\n  els.btnKnown.addEventListener(\"click\", toggleKnown);\n  els.btnRestart.addEventListener(\"click\", startOver);\n  els.finishRestart.addEventListener(\"click\", startOver);\n  els.finishReview.addEventListener(\"click\", reviewUnknown);\n  document.addEventListener(\"keydown\", handleKeydown);\n}\n\n/* Loading */\n\nasync function loadData() {\n  let config;\n  try {\n    config = normalizeConfig(await fetchJson(\"config.json\"));\n  } catch (error) {\n    console.error(\"config.json could not be loaded:\", error);\n    showMessage(STRINGS.loadErrorConfig);\n    return;\n  }\n\n  let deck;\n  try {\n    deck = normalizeDeck(await fetchJson(\"deck.json\"));\n  } catch (error) {\n    console.error(\"deck.json could not be loaded:\", error);\n    showMessage(STRINGS.loadErrorDeck);\n    return;\n  }\n\n  start(config, deck);\n}\n\nasync function fetchJson(path) {\n  const response = await fetch(path, { cache: \"no-store\" });\n  if (!response.ok) {\n    throw new Error(`${path} returned status ${response.status}`);\n  }\n  return response.json();\n}\n\nfunction normalizeConfig(raw) {\n  if (!isObject(raw)) {\n    throw new Error(\"config.json must be a JSON object.\");\n  }\n  const theme = isObject(raw.theme) ? raw.theme : {};\n  const frames = isObject(theme.frameColors) ? theme.frameColors : {};\n  const controls = isObject(raw.controls) ? raw.controls : {};\n  const defaults = DEFAULT_CONFIG;\n\n  return {\n    theme: {\n      background: pickColor(theme.background, defaults.theme.background),\n      cardFace: pickColor(theme.cardFace, defaults.theme.cardFace),\n      textColor: pickColor(theme.textColor, defaults.theme.textColor),\n      accent: pickColor(theme.accent, defaults.theme.accent),\n      frameColors: {\n        word: pickColor(frames.word, defaults.theme.frameColors.word),\n        definition: pickColor(frames.definition, defaults.theme.frameColors.definition),\n        example: pickColor(frames.example, defaults.theme.frameColors.example),\n        image: pickColor(frames.image, defaults.theme.frameColors.image)\n      },\n      fontFamily: pickFont(theme.fontFamily, defaults.theme.fontFamily),\n      wordSize: pickEnum(theme.wordSize, \"wordSize\", defaults.theme.wordSize),\n      textAlign: pickEnum(theme.textAlign, \"textAlign\", defaults.theme.textAlign),\n      textPosition: pickEnum(theme.textPosition, \"textPosition\", defaults.theme.textPosition),\n      cornerRadius: pickEnum(theme.cornerRadius, \"cornerRadius\", defaults.theme.cornerRadius)\n    },\n    controls: {\n      shuffle: pickBoolean(controls.shuffle, defaults.controls.shuffle),\n      flipDirection: pickBoolean(controls.flipDirection, defaults.controls.flipDirection),\n      progressCounter: pickBoolean(controls.progressCounter, defaults.controls.progressCounter),\n      markKnown: pickBoolean(controls.markKnown, defaults.controls.markKnown)\n    },\n    startFlipped: pickBoolean(raw.startFlipped, defaults.startFlipped),\n    startShuffled: pickBoolean(raw.startShuffled, defaults.startShuffled)\n  };\n}\n\nfunction normalizeDeck(raw) {\n  if (!isObject(raw) || !Array.isArray(raw.cards)) {\n    throw new Error(\"deck.json needs a \\\"cards\\\" list.\");\n  }\n  const cards = [];\n  raw.cards.forEach((card, position) => {\n    const problem = findCardProblem(card);\n    if (problem) {\n      console.warn(`Skipping card ${position + 1} in deck.json: ${problem}`);\n      return;\n    }\n    cards.push(card);\n  });\n  if (cards.length === 0) {\n    throw new Error(\"deck.json has no usable cards.\");\n  }\n  return {\n    title: isFilledString(raw.title) ? raw.title.trim() : STRINGS.pageTitle,\n    lang: isFilledString(raw.lang) ? raw.lang.trim() : \"\",\n    cards\n  };\n}\n\nfunction findCardProblem(card) {\n  if (!isObject(card)) {\n    return \"it is not an object\";\n  }\n  if (!isFilledString(card.id)) {\n    return \"it has no id\";\n  }\n  if (!isFilledString(card.word)) {\n    return \"it has no word\";\n  }\n  const type = CARD_TYPES[card.type];\n  if (!type) {\n    return `\"${card.type}\" is not a card type`;\n  }\n  const kinds = [type.front, type.back];\n  if (kinds.indexOf(\"definition\") !== -1 && !isFilledString(card.definition)) {\n    return \"it needs a definition\";\n  }\n  if (kinds.indexOf(\"example\") !== -1 && !isFilledString(card.example)) {\n    return \"it needs an example\";\n  }\n  if (kinds.indexOf(\"image\") !== -1) {\n    if (!isObject(card.image) || !isFilledString(card.image.svg)) {\n      return \"it needs an image\";\n    }\n    if (!isFilledString(card.image.alt)) {\n      return \"its image needs alt text\";\n    }\n  }\n  return \"\";\n}\n\nfunction isObject(value) {\n  return value !== null && typeof value === \"object\" && !Array.isArray(value);\n}\n\nfunction isFilledString(value) {\n  return typeof value === \"string\" && value.trim() !== \"\";\n}\n\nfunction pickColor(value, fallback) {\n  return typeof value === \"string\" && /^#[0-9a-f]{6}$/i.test(value.trim()) ? value.trim() : fallback;\n}\n\nfunction pickFont(value, fallback) {\n  return typeof value === \"string\" && /^[\\w\\s,'\"-]+$/.test(value) ? value : fallback;\n}\n\nfunction pickEnum(value, name, fallback) {\n  return ENUMS[name].indexOf(value) !== -1 ? value : fallback;\n}\n\nfunction pickBoolean(value, fallback) {\n  return typeof value === \"boolean\" ? value : fallback;\n}\n\n/* Setup */\n\nfunction start(config, deck) {\n  state.config = config;\n  state.title = deck.title;\n  state.cards = deck.cards;\n  state.reversed = config.startFlipped;\n\n  applyLanguage(deck.lang);\n  applyTheme(config.theme);\n  applyControls(config.controls);\n\n  document.title = deck.title;\n  els.deckTitle.textContent = deck.title;\n\n  state.ready = true;\n  setButtonsDisabled(false);\n  beginPass(config.startShuffled ? shuffled(state.cards) : state.cards.slice());\n  els.card.focus();\n}\n\nfunction applyLanguage(lang) {\n  if (!lang) {\n    return;\n  }\n  document.documentElement.lang = lang;\n  const base = lang.split(\"-\")[0].toLowerCase();\n  document.documentElement.dir = RTL_LANGUAGES.indexOf(base) !== -1 ? \"rtl\" : \"ltr\";\n}\n\nfunction applyTheme(theme) {\n  const root = document.documentElement.style;\n  root.setProperty(\"--bg\", theme.background);\n  root.setProperty(\"--card-face\", theme.cardFace);\n  root.setProperty(\"--text\", theme.textColor);\n  root.setProperty(\"--accent\", theme.accent);\n  root.setProperty(\"--accent-text\", readableTextOn(theme.accent));\n  root.setProperty(\"--font\", theme.fontFamily);\n  Object.keys(theme.frameColors).forEach((kind) => {\n    root.setProperty(`--frame-${kind}`, theme.frameColors[kind]);\n    root.setProperty(`--label-text-${kind}`, readableTextOn(theme.frameColors[kind]));\n  });\n  els.app.setAttribute(\"data-word-size\", theme.wordSize);\n  els.app.setAttribute(\"data-text-align\", theme.textAlign);\n  els.app.setAttribute(\"data-text-position\", theme.textPosition);\n  els.app.setAttribute(\"data-corner-radius\", theme.cornerRadius);\n}\n\nfunction readableTextOn(hex) {\n  const luminance = relativeLuminance(hex);\n  const withBlack = (luminance + 0.05) / 0.05;\n  const withWhite = 1.05 / (luminance + 0.05);\n  return withBlack >= withWhite ? \"#000000\" : \"#FFFFFF\";\n}\n\nfunction relativeLuminance(hex) {\n  const channels = [1, 3, 5].map((start) => {\n    const value = parseInt(hex.slice(start, start + 2), 16) / 255;\n    return value <= 0.03928 ? value / 12.92 : Math.pow((value + 0.055) / 1.055, 2.4);\n  });\n  return 0.2126 * channels[0] + 0.7152 * channels[1] + 0.0722 * channels[2];\n}\n\nfunction applyControls(controls) {\n  els.btnShuffle.hidden = !controls.shuffle;\n  els.btnDirection.hidden = !controls.flipDirection || !state.cards.some(hasMirror);\n  els.btnKnown.hidden = !controls.markKnown;\n  els.counter.hidden = false;\n}\n\nfunction hasMirror(card) {\n  return Boolean(CARD_TYPES[card.type].mirror);\n}\n\nfunction setButtonsDisabled(disabled) {\n  [els.btnBack, els.btnFlip, els.btnNext, els.btnShuffle, els.btnDirection, els.btnKnown, els.btnRestart]\n    .forEach((button) => {\n      button.disabled = disabled;\n    });\n}\n\n/* Passes through the deck */\n\nfunction beginPass(cards) {\n  state.pass = cards;\n  state.index = 0;\n  state.finished = false;\n  showCard({ announce: true });\n}\n\nfunction currentCard() {\n  return state.finished ? null : state.pass[state.index] || null;\n}\n\nfunction effectiveType(card) {\n  const type = CARD_TYPES[card.type];\n  return state.reversed && type.mirror ? type.mirror : card.type;\n}\n\nfunction showCard(options) {\n  const card = currentCard();\n  if (!card) {\n    return;\n  }\n  const type = CARD_TYPES[effectiveType(card)];\n\n  els.message.hidden = true;\n  els.card.hidden = false;\n\n  els.card.classList.add(\"no-animation\");\n  state.flipped = false;\n  els.card.classList.remove(\"is-flipped\");\n  fillFace(els.cardFront, type.front, card);\n  fillFace(els.cardBack, type.back, card);\n  els.cardFront.querySelector(\".card-hint\").textContent = STRINGS.hints[primaryKind(type.back)];\n  setFaceVisibility();\n  void els.card.offsetWidth;\n  els.card.classList.remove(\"no-animation\");\n\n  updateControls();\n  updateCounter();\n\n  if (options && options.announce) {\n    announce(STRINGS.cardAnnouncement(positionText(), describeFace(type.front, card), STRINGS.hints[primaryKind(type.back)]));\n  }\n}\n\nfunction primaryKind(kind) {\n  return kind === \"word-definition\" ? \"word\" : kind;\n}\n\nfunction fillFace(face, kind, card) {\n  const labelKind = primaryKind(kind);\n  face.setAttribute(\"data-kind\", labelKind);\n  face.querySelector(\".card-label\").textContent = STRINGS.kindLabels[labelKind];\n  face.querySelector(\".card-content\").replaceChildren(...buildContent(kind, card));\n}\n\nfunction buildContent(kind, card) {\n  if (kind === \"word\") {\n    return [textElement(\"p\", \"content-word\", card.word)];\n  }\n  if (kind === \"definition\") {\n    return [textElement(\"p\", \"content-text\", card.definition)];\n  }\n  if (kind === \"example\") {\n    return [textElement(\"p\", \"content-text\", card.example)];\n  }\n  if (kind === \"image\") {\n    const svg = buildSvg(card.image);\n    return [svg || textElement(\"p\", \"content-text\", card.image.alt || STRINGS.pictureMissing)];\n  }\n  const nodes = [textElement(\"p\", \"content-word\", card.word)];\n  if (isFilledString(card.definition)) {\n    nodes.push(textElement(\"p\", \"content-sub\", card.definition));\n  }\n  return nodes;\n}\n\nfunction textElement(tag, className, text) {\n  const element = document.createElement(tag);\n  element.className = className;\n  element.textContent = text;\n  return element;\n}\n\nfunction buildSvg(image) {\n  if (!image || typeof image.svg !== \"string\" || /<\\s*script/i.test(image.svg)) {\n    return null;\n  }\n  let source = image.svg.trim();\n  if (!/xmlns\\s*=/.test(source)) {\n    source = source.replace(/^<svg/i, `<svg xmlns=\"${SVG_NS}\"`);\n  }\n  const parsed = new DOMParser().parseFromString(source, \"image/svg+xml\");\n  const root = parsed.documentElement;\n  if (!root || root.namespaceURI !== SVG_NS || root.localName !== \"svg\") {\n    return null;\n  }\n  if (parsed.getElementsByTagName(\"parsererror\").length > 0 || root.getElementsByTagName(\"script\").length > 0) {\n    return null;\n  }\n  stripUnsafeSvg(root);\n  const svg = document.importNode(root, true);\n  svg.removeAttribute(\"width\");\n  svg.removeAttribute(\"height\");\n  svg.setAttribute(\"role\", \"img\");\n  svg.setAttribute(\"aria-label\", image.alt);\n  svg.setAttribute(\"focusable\", \"false\");\n  svg.setAttribute(\"class\", \"content-image\");\n  return svg;\n}\n\nfunction stripUnsafeSvg(root) {\n  const blocked = [\"script\", \"foreignObject\", \"iframe\", \"object\", \"embed\", \"image\", \"text\", \"style\"];\n  blocked.forEach((tag) => {\n    Array.prototype.slice.call(root.getElementsByTagName(tag)).forEach((node) => node.remove());\n  });\n  [root].concat(Array.prototype.slice.call(root.getElementsByTagName(\"*\"))).forEach((node) => {\n    Array.prototype.slice.call(node.attributes).forEach((attribute) => {\n      const name = attribute.name.toLowerCase();\n      const value = attribute.value.trim();\n      const isHandler = name.indexOf(\"on\") === 0;\n      const isExternalLink = (name === \"href\" || name === \"xlink:href\") && value.charAt(0) !== \"#\";\n      const isExternalUrl = /url\\(\\s*['\"]?(?!#)/i.test(value);\n      if (isHandler || isExternalLink || isExternalUrl) {\n        node.removeAttribute(attribute.name);\n      }\n    });\n  });\n}\n\nfunction setFaceVisibility() {\n  els.cardFront.setAttribute(\"aria-hidden\", state.flipped ? \"true\" : \"false\");\n  els.cardBack.setAttribute(\"aria-hidden\", state.flipped ? \"false\" : \"true\");\n}\n\nfunction describeFace(kind, card) {\n  const labelKind = primaryKind(kind);\n  let content;\n  if (kind === \"word\") {\n    content = card.word;\n  } else if (kind === \"definition\") {\n    content = card.definition;\n  } else if (kind === \"example\") {\n    content = card.example;\n  } else if (kind === \"image\") {\n    content = card.image.alt;\n  } else {\n    content = isFilledString(card.definition) ? `${endSentence(card.word)} ${card.definition}` : card.word;\n  }\n  return endSentence(STRINGS.faceAnnouncement(STRINGS.kindNames[labelKind], content));\n}\n\nfunction endSentence(text) {\n  const trimmed = text.trim();\n  return /[.!?”\"]$/.test(trimmed) ? trimmed : `${trimmed}.`;\n}\n\n/* Actions */\n\nfunction flip() {\n  const card = currentCard();\n  if (!state.ready || !card) {\n    return;\n  }\n  state.flipped = !state.flipped;\n  els.card.classList.toggle(\"is-flipped\", state.flipped);\n  setFaceVisibility();\n  const type = CARD_TYPES[effectiveType(card)];\n  const kind = state.flipped ? type.back : type.front;\n  announce(STRINGS.flipAnnouncement(describeFace(kind, card)));\n}\n\nfunction goNext() {\n  if (!state.ready || state.finished) {\n    return;\n  }\n  if (state.index >= state.pass.length - 1) {\n    showFinish();\n    return;\n  }\n  state.index += 1;\n  showCard({ announce: true });\n}\n\nfunction goBack() {\n  if (!state.ready) {\n    return;\n  }\n  if (state.finished) {\n    state.finished = false;\n    state.index = state.pass.length - 1;\n    showCard({ announce: true });\n    els.card.focus();\n    return;\n  }\n  if (state.index === 0) {\n    announce(STRINGS.firstCardAnnouncement);\n    return;\n  }\n  state.index -= 1;\n  showCard({ announce: true });\n}\n\nfunction shuffleCards() {\n  if (!state.ready || !state.config.controls.shuffle) {\n    return;\n  }\n  const wasFinished = state.finished;\n  state.pass = shuffled(state.pass);\n  state.index = 0;\n  state.finished = false;\n  showCard();\n  if (wasFinished) {\n    els.card.focus();\n  }\n  announce(STRINGS.shuffledAnnouncement(positionText()));\n}\n\nfunction switchDirection() {\n  if (!state.ready || !state.config.controls.flipDirection || els.btnDirection.hidden) {\n    return;\n  }\n  state.reversed = !state.reversed;\n  if (state.finished) {\n    updateControls();\n    return;\n  }\n  showCard();\n  const card = currentCard();\n  const type = CARD_TYPES[effectiveType(card)];\n  announce(STRINGS.cardAnnouncement(positionText(), describeFace(type.front, card), STRINGS.hints[primaryKind(type.back)]));\n}\n\nfunction toggleKnown() {\n  const card = currentCard();\n  if (!state.ready || !card || !state.config.controls.markKnown) {\n    return;\n  }\n  const nowKnown = !state.known.has(card.id);\n  if (nowKnown) {\n    state.known.add(card.id);\n  } else {\n    state.known.delete(card.id);\n  }\n  updateControls();\n  updateCounter();\n  announce(nowKnown ? STRINGS.knownAnnouncement : STRINGS.unknownAnnouncement);\n}\n\nfunction startOver() {\n  if (!state.ready) {\n    return;\n  }\n  beginPass(state.config.startShuffled ? shuffled(state.cards) : state.cards.slice());\n  els.card.focus();\n}\n\nfunction reviewUnknown() {\n  const remaining = state.cards.filter((card) => !state.known.has(card.id));\n  if (remaining.length === 0) {\n    return;\n  }\n  beginPass(remaining);\n  els.card.focus();\n}\n\nfunction shuffled(cards) {\n  const result = cards.slice();\n  for (let i = result.length - 1; i > 0; i -= 1) {\n    const j = Math.floor(Math.random() * (i + 1));\n    const temp = result[i];\n    result[i] = result[j];\n    result[j] = temp;\n  }\n  return result;\n}\n\n/* Finish and messages */\n\nfunction showFinish() {\n  state.finished = true;\n  state.flipped = false;\n  const total = state.pass.length;\n  const unknownCount = state.cards.filter((card) => !state.known.has(card.id)).length;\n  const markKnown = state.config.controls.markKnown;\n\n  els.card.hidden = true;\n  els.message.hidden = false;\n  els.messageText.textContent = plural(STRINGS.finished, total);\n  els.messageDetail.hidden = !(markKnown && unknownCount === 0);\n  els.messageDetail.textContent = STRINGS.allKnown;\n  els.messageActions.hidden = false;\n  els.finishReview.hidden = !(markKnown && unknownCount > 0);\n  setButtonText(els.finishReview, plural(STRINGS.reviewUnknown, unknownCount));\n\n  updateControls();\n  updateCounter();\n  els.message.focus();\n  announce(els.messageText.textContent);\n}\n\nfunction showMessage(text) {\n  els.card.hidden = true;\n  els.message.hidden = false;\n  els.messageText.textContent = text;\n  els.messageDetail.hidden = true;\n  els.messageActions.hidden = true;\n  els.counter.hidden = true;\n}\n\nfunction plural(forms, count) {\n  const category = new Intl.PluralRules(document.documentElement.lang || undefined).select(count);\n  const form = forms[category] || forms.other;\n  return form(new Intl.NumberFormat(document.documentElement.lang || undefined).format(count));\n}\n\n/* Display state */\n\nfunction updateControls() {\n  const card = currentCard();\n  setAriaDisabled(els.btnBack, !state.finished && state.index === 0);\n  setAriaDisabled(els.btnFlip, !card);\n  setAriaDisabled(els.btnNext, !card);\n  setAriaDisabled(els.btnKnown, !card);\n  els.btnKnown.setAttribute(\"aria-pressed\", card && state.known.has(card.id) ? \"true\" : \"false\");\n  setButtonText(els.btnDirection, directionLabel(), STRINGS.keys.direction);\n}\n\nfunction setAriaDisabled(button, disabled) {\n  if (disabled) {\n    button.setAttribute(\"aria-disabled\", \"true\");\n  } else {\n    button.removeAttribute(\"aria-disabled\");\n  }\n}\n\nfunction directionLabel() {\n  let card = currentCard();\n  if (!card || !hasMirror(card)) {\n    card = state.pass.filter(hasMirror)[0] || state.cards.filter(hasMirror)[0];\n  }\n  if (!card) {\n    return STRINGS.startFrom.word;\n  }\n  const mirrorType = CARD_TYPES[CARD_TYPES[effectiveType(card)].mirror];\n  return STRINGS.startFrom[mirrorType.front];\n}\n\nfunction positionText() {\n  const format = new Intl.NumberFormat(document.documentElement.lang || undefined);\n  return STRINGS.counter(format.format(state.index + 1), format.format(state.pass.length));\n}\n\nfunction updateCounter() {\n  const parts = [];\n  if (state.config.controls.progressCounter && !state.finished) {\n    parts.push(positionText());\n  }\n  if (state.config.controls.markKnown) {\n    const left = state.cards.filter((card) => !state.known.has(card.id)).length;\n    parts.push(plural(STRINGS.leftToLearn, left));\n  }\n  els.counter.replaceChildren(...parts.map((text) => textElement(\"span\", \"counter-part\", text)));\n  els.counter.hidden = parts.length === 0;\n}\n\nfunction announce(text) {\n  els.srStatus.textContent = \"\";\n  window.setTimeout(() => {\n    els.srStatus.textContent = text;\n  }, 50);\n}\n\n/* Keyboard */\n\nfunction handleKeydown(event) {\n  if (!state.ready || event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey) {\n    return;\n  }\n  if (isTextEntry(event.target)) {\n    return;\n  }\n  const onControl = event.target instanceof Element && event.target.closest(\"button, a, select, summary\");\n  const key = event.key;\n  const controls = state.config.controls;\n\n  if (key === \" \" || key === \"Enter\") {\n    if (onControl) {\n      return;\n    }\n    event.preventDefault();\n    flip();\n  } else if (key === \"ArrowRight\") {\n    event.preventDefault();\n    goNext();\n  } else if (key === \"ArrowLeft\") {\n    event.preventDefault();\n    goBack();\n  } else if ((key === \"s\" || key === \"S\") && controls.shuffle) {\n    shuffleCards();\n  } else if ((key === \"f\" || key === \"F\") && controls.flipDirection) {\n    switchDirection();\n  } else if ((key === \"k\" || key === \"K\") && controls.markKnown) {\n    toggleKnown();\n  } else if (key === \"r\" || key === \"R\") {\n    startOver();\n  }\n}\n\nfunction isTextEntry(target) {\n  if (!(target instanceof Element)) {\n    return false;\n  }\n  return target.isContentEditable || target.matches(\"input, textarea, select\");\n}\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "deck.json",
          "contents": "{\n  \"schemaVersion\": 1,\n  \"deckId\": \"\",\n  \"title\": \"\",\n  \"lang\": \"en-US\",\n  \"cards\": [\n    {\n      \"id\": \"feature\",\n      \"type\": \"word-definition\",\n      \"word\": \"feature\",\n      \"definition\": \"A characteristic you can observe about something.\",\n      \"example\": \"When you pick a pet at a shelter, you might notice its size, its fur color, and whether it has floppy ears.\",\n      \"image\": {\n        \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 120 120\\\"><path d=\\\"M26 54 L20 20 L46 38 Z\\\" fill=\\\"#F46800\\\"/><path d=\\\"M94 54 L100 20 L74 38 Z\\\" fill=\\\"#F46800\\\"/><ellipse cx=\\\"60\\\" cy=\\\"68\\\" rx=\\\"42\\\" ry=\\\"38\\\" fill=\\\"#F46800\\\"/><ellipse cx=\\\"60\\\" cy=\\\"82\\\" rx=\\\"22\\\" ry=\\\"16\\\" fill=\\\"#FFFFFF\\\"/><circle cx=\\\"44\\\" cy=\\\"62\\\" r=\\\"7\\\" fill=\\\"#1F1976\\\"/><circle cx=\\\"76\\\" cy=\\\"62\\\" r=\\\"7\\\" fill=\\\"#1F1976\\\"/><circle cx=\\\"46\\\" cy=\\\"60\\\" r=\\\"2.5\\\" fill=\\\"#FFFFFF\\\"/><circle cx=\\\"78\\\" cy=\\\"60\\\" r=\\\"2.5\\\" fill=\\\"#FFFFFF\\\"/><path d=\\\"M53 75 L67 75 L60 83 Z\\\" fill=\\\"#E11970\\\"/><path d=\\\"M60 83 L60 90 M60 90 Q54 96 49 92 M60 90 Q66 96 71 92\\\" fill=\\\"none\\\" stroke=\\\"#1F1976\\\" stroke-width=\\\"3\\\" stroke-linecap=\\\"round\\\"/><circle cx=\\\"96\\\" cy=\\\"96\\\" r=\\\"14\\\" fill=\\\"#ACA8EA\\\" stroke=\\\"#4C42CF\\\" stroke-width=\\\"5\\\"/><path d=\\\"M106 106 L116 116\\\" stroke=\\\"#4C42CF\\\" stroke-width=\\\"6\\\" stroke-linecap=\\\"round\\\"/></svg>\",\n        \"alt\": \"An orange cat face with pointed ears, big eyes and a pink nose, with a magnifying glass beside it.\",\n        \"source\": \"claude\"\n      }\n    },\n    {\n      \"id\": \"data\",\n      \"type\": \"word-definition\",\n      \"word\": \"data\",\n      \"definition\": \"Information that has been collected and recorded.\",\n      \"example\": \"Your gym teacher writes down how fast each student runs the mile every week. The times she records help her see who is getting faster.\",\n      \"image\": {\n        \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 120 120\\\"><rect x=\\\"14\\\" y=\\\"14\\\" width=\\\"92\\\" height=\\\"92\\\" rx=\\\"8\\\" fill=\\\"#FFFFFF\\\" stroke=\\\"#1F1976\\\" stroke-width=\\\"4\\\"/><rect x=\\\"26\\\" y=\\\"68\\\" width=\\\"14\\\" height=\\\"28\\\" fill=\\\"#ACA8EA\\\"/><rect x=\\\"46\\\" y=\\\"54\\\" width=\\\"14\\\" height=\\\"42\\\" fill=\\\"#0099F3\\\"/><rect x=\\\"66\\\" y=\\\"42\\\" width=\\\"14\\\" height=\\\"54\\\" fill=\\\"#34BD43\\\"/><rect x=\\\"86\\\" y=\\\"28\\\" width=\\\"14\\\" height=\\\"68\\\" fill=\\\"#F46800\\\"/><polyline points=\\\"33,60 53,46 73,34 93,22\\\" fill=\\\"none\\\" stroke=\\\"#1F1976\\\" stroke-width=\\\"3\\\" stroke-linejoin=\\\"round\\\" stroke-linecap=\\\"round\\\"/><circle cx=\\\"33\\\" cy=\\\"60\\\" r=\\\"4\\\" fill=\\\"#1F1976\\\"/><circle cx=\\\"53\\\" cy=\\\"46\\\" r=\\\"4\\\" fill=\\\"#1F1976\\\"/><circle cx=\\\"73\\\" cy=\\\"34\\\" r=\\\"4\\\" fill=\\\"#1F1976\\\"/><circle cx=\\\"93\\\" cy=\\\"22\\\" r=\\\"4\\\" fill=\\\"#1F1976\\\"/><rect x=\\\"22\\\" y=\\\"98\\\" width=\\\"78\\\" height=\\\"3\\\" fill=\\\"#1F1976\\\"/></svg>\",\n        \"alt\": \"A bar chart with four rising colorful bars and a line with dots connecting their tops inside a white frame.\",\n        \"source\": \"claude\"\n      }\n    },\n    {\n      \"id\": \"classification\",\n      \"type\": \"word-definition\",\n      \"word\": \"classification\",\n      \"definition\": \"Sorting something into a category based on its features.\",\n      \"example\": \"Your music app sorts songs into groups like rock, pop, and jazz. It looks at each song's beat, tempo, and instruments to decide which group fits best.\",\n      \"image\": {\n        \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 120 120\\\"><rect x=\\\"6\\\" y=\\\"70\\\" width=\\\"34\\\" height=\\\"40\\\" rx=\\\"5\\\" fill=\\\"#4C42CF\\\"/><rect x=\\\"43\\\" y=\\\"70\\\" width=\\\"34\\\" height=\\\"40\\\" rx=\\\"5\\\" fill=\\\"#0099F3\\\"/><rect x=\\\"80\\\" y=\\\"70\\\" width=\\\"34\\\" height=\\\"40\\\" rx=\\\"5\\\" fill=\\\"#F46800\\\"/><rect x=\\\"12\\\" y=\\\"76\\\" width=\\\"22\\\" height=\\\"6\\\" rx=\\\"3\\\" fill=\\\"#FFFFFF\\\"/><rect x=\\\"49\\\" y=\\\"76\\\" width=\\\"22\\\" height=\\\"6\\\" rx=\\\"3\\\" fill=\\\"#FFFFFF\\\"/><rect x=\\\"86\\\" y=\\\"76\\\" width=\\\"22\\\" height=\\\"6\\\" rx=\\\"3\\\" fill=\\\"#FFFFFF\\\"/><circle cx=\\\"23\\\" cy=\\\"34\\\" r=\\\"10\\\" fill=\\\"#4C42CF\\\"/><circle cx=\\\"60\\\" cy=\\\"14\\\" r=\\\"10\\\" fill=\\\"#0099F3\\\"/><rect x=\\\"84\\\" y=\\\"30\\\" width=\\\"20\\\" height=\\\"20\\\" rx=\\\"3\\\" fill=\\\"#F46800\\\"/><circle cx=\\\"60\\\" cy=\\\"46\\\" r=\\\"10\\\" fill=\\\"#0099F3\\\"/><path d=\\\"M23 46 L23 66\\\" stroke=\\\"#4C42CF\\\" stroke-width=\\\"4\\\" stroke-linecap=\\\"round\\\" stroke-dasharray=\\\"2 6\\\"/><path d=\\\"M60 58 L60 66\\\" stroke=\\\"#0099F3\\\" stroke-width=\\\"4\\\" stroke-linecap=\\\"round\\\"/><path d=\\\"M94 52 L94 66\\\" stroke=\\\"#F46800\\\" stroke-width=\\\"4\\\" stroke-linecap=\\\"round\\\" stroke-dasharray=\\\"2 6\\\"/><path d=\\\"M18 94 L28 94 M55 94 L65 94 M92 94 L102 94\\\" stroke=\\\"#FFFFFF\\\" stroke-width=\\\"5\\\" stroke-linecap=\\\"round\\\"/></svg>\",\n        \"alt\": \"Colored circles and squares drop down into three matching colored bins, each shape going to the bin of its own color.\",\n        \"source\": \"claude\"\n      }\n    },\n    {\n      \"id\": \"branching-logic\",\n      \"type\": \"word-definition\",\n      \"word\": \"branching logic\",\n      \"definition\": \"A way of making decisions using yes or no questions, where each answer sends you in a different direction.\",\n      \"example\": \"A video game asks, Do you want to open the door? If you say yes, you go into the next room. If you say no, you go back.\",\n      \"image\": {\n        \"svg\": \"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 120 120\\\"><g fill=\\\"none\\\" stroke=\\\"#1F1976\\\" stroke-width=\\\"4\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"><path d=\\\"M60 30 V44 L30 62 V80\\\"/><path d=\\\"M60 44 L90 62 V80\\\"/></g><rect x=\\\"42\\\" y=\\\"8\\\" width=\\\"36\\\" height=\\\"26\\\" rx=\\\"8\\\" fill=\\\"#4C42CF\\\"/><circle cx=\\\"60\\\" cy=\\\"21\\\" r=\\\"6\\\" fill=\\\"#FFFFFF\\\"/><circle cx=\\\"30\\\" cy=\\\"62\\\" r=\\\"7\\\" fill=\\\"#ACA8EA\\\"/><circle cx=\\\"90\\\" cy=\\\"62\\\" r=\\\"7\\\" fill=\\\"#ACA8EA\\\"/><circle cx=\\\"30\\\" cy=\\\"98\\\" r=\\\"16\\\" fill=\\\"#34BD43\\\"/><path d=\\\"M22 98 L28 104 L39 91\\\" fill=\\\"none\\\" stroke=\\\"#FFFFFF\\\" stroke-width=\\\"4\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\"/><circle cx=\\\"90\\\" cy=\\\"98\\\" r=\\\"16\\\" fill=\\\"#F46800\\\"/><path d=\\\"M82 90 L98 106 M98 90 L82 106\\\" fill=\\\"none\\\" stroke=\\\"#FFFFFF\\\" stroke-width=\\\"4\\\" stroke-linecap=\\\"round\\\"/></svg>\",\n        \"alt\": \"A purple box at the top splits into two paths leading to a green check circle and an orange X circle.\",\n        \"source\": \"claude\"\n      }\n    }\n  ]\n}",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "style.css",
          "contents": ":root {\n  --bg: #E4E2F8;\n  --card-face: #FFFFFF;\n  --text: #000000;\n  --accent: #4C42CF;\n  --accent-text: #FFFFFF;\n  --frame-word: #0099F3;\n  --frame-definition: #003F25;\n  --frame-example: #F46800;\n  --frame-image: #4C42CF;\n  --label-text-word: #000000;\n  --label-text-definition: #FFFFFF;\n  --label-text-example: #000000;\n  --label-text-image: #FFFFFF;\n  --font: system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nhtml {\n  -webkit-text-size-adjust: 100%;\n  text-size-adjust: 100%;\n}\n\nbody {\n  margin: 0;\n  min-height: 100vh;\n  background: var(--bg);\n  color: var(--text);\n  font-family: var(--font);\n  line-height: 1.4;\n}\n\n.app {\n  --word-size: clamp(1.75rem, 7cqw, 3rem);\n  --body-size: clamp(1rem, 3.6cqw, 1.375rem);\n  --sub-size: clamp(0.95rem, 3cqw, 1.125rem);\n  --radius: 16px;\n  --content-justify: center;\n  --content-align: center;\n  --text-align: center;\n  width: 100%;\n  max-width: 640px;\n  margin-inline: auto;\n  padding-block: 24px 40px;\n  padding-inline: 16px;\n  font-family: var(--font);\n  color: var(--text);\n}\n\n.app[data-word-size=\"medium\"] {\n  --word-size: clamp(1.5rem, 5.5cqw, 2.25rem);\n}\n\n.app[data-word-size=\"xlarge\"] {\n  --word-size: clamp(2rem, 9cqw, 3.75rem);\n}\n\n.app[data-corner-radius=\"none\"] {\n  --radius: 0px;\n}\n\n.app[data-corner-radius=\"round\"] {\n  --radius: 32px;\n}\n\n.app[data-text-align=\"start\"] {\n  --content-align: flex-start;\n  --text-align: start;\n}\n\n.app[data-text-position=\"top\"] {\n  --content-justify: flex-start;\n}\n\n.deck-title {\n  margin-block: 0 20px;\n  font-size: clamp(1.5rem, 5vw, 2rem);\n  line-height: 1.2;\n  text-align: center;\n}\n\n.stage {\n  container-type: inline-size;\n  width: 100%;\n  max-width: 560px;\n  margin-inline: auto;\n}\n\n/* Card */\n\n.card {\n  position: relative;\n  width: 100%;\n  border-radius: var(--radius);\n  perspective: 1400px;\n}\n\n.card:focus {\n  outline: none;\n}\n\n.card:focus-visible {\n  outline: 4px solid var(--text);\n  outline-offset: 4px;\n}\n\n.card-inner {\n  display: grid;\n  aspect-ratio: 3 / 2;\n  transform-style: preserve-3d;\n  transition: transform 0.5s ease;\n}\n\n.card.is-flipped .card-inner {\n  transform: rotateY(180deg);\n}\n\n.card.no-animation .card-inner {\n  transition: none;\n}\n\n.card-face {\n  --frame: var(--frame-word);\n  --label-text: var(--label-text-word);\n  position: relative;\n  grid-area: 1 / 1;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  padding-block: 3rem 1rem;\n  padding-inline: 1.25rem;\n  border: 8px solid var(--frame);\n  border-radius: var(--radius);\n  background: var(--card-face);\n  color: var(--text);\n  -webkit-backface-visibility: hidden;\n  backface-visibility: hidden;\n}\n\n.card-back {\n  transform: rotateY(180deg);\n}\n\n.card-face[data-kind=\"definition\"] {\n  --frame: var(--frame-definition);\n  --label-text: var(--label-text-definition);\n}\n\n.card-face[data-kind=\"example\"] {\n  --frame: var(--frame-example);\n  --label-text: var(--label-text-example);\n}\n\n.card-face[data-kind=\"image\"] {\n  --frame: var(--frame-image);\n  --label-text: var(--label-text-image);\n}\n\n.card-label {\n  position: absolute;\n  inset-block-start: 0;\n  inset-inline-start: 0;\n  padding-block: 0.3rem 0.4rem;\n  padding-inline: 0.9rem;\n  border-end-end-radius: 10px;\n  background: var(--frame);\n  color: var(--label-text);\n  font-size: 0.85rem;\n  font-weight: 700;\n  letter-spacing: 0.08em;\n  line-height: 1.2;\n}\n\n.app[data-corner-radius=\"none\"] .card-label {\n  border-end-end-radius: 0;\n}\n\n.card-content {\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  justify-content: var(--content-justify);\n  align-items: var(--content-align);\n  gap: 0.5rem;\n  min-height: 0;\n  text-align: var(--text-align);\n}\n\n.content-word {\n  margin: 0;\n  max-width: 100%;\n  font-size: var(--word-size);\n  font-weight: 700;\n  line-height: 1.1;\n  overflow-wrap: anywhere;\n}\n\n.content-text {\n  margin: 0;\n  max-width: 36ch;\n  font-size: var(--body-size);\n  line-height: 1.4;\n}\n\n.content-sub {\n  margin: 0;\n  max-width: 40ch;\n  font-size: var(--sub-size);\n  line-height: 1.4;\n}\n\n.content-image {\n  display: block;\n  width: clamp(96px, 30cqw, 168px);\n  height: auto;\n  max-height: 100%;\n}\n\n.card-hint {\n  margin-block: 0.75rem 0;\n  font-size: 0.95rem;\n  font-weight: 600;\n  text-align: center;\n}\n\n/* Loading, error, and finish states */\n\n.message {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 1rem;\n  aspect-ratio: 3 / 2;\n  padding: 1.5rem;\n  border: 3px dashed var(--text);\n  border-radius: var(--radius);\n  background: var(--card-face);\n  color: var(--text);\n  text-align: center;\n}\n\n.message:focus {\n  outline: none;\n}\n\n.message:focus-visible {\n  outline: 4px solid var(--text);\n  outline-offset: 4px;\n}\n\n.message-text {\n  margin: 0;\n  font-size: var(--body-size);\n  font-weight: 700;\n}\n\n.message-detail {\n  margin: 0;\n}\n\n.message-actions {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 12px;\n}\n\n/* Buttons */\n\n.controls {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 12px;\n  margin-block: 20px 0;\n  margin-inline: auto;\n  max-width: 560px;\n}\n\n.controls-secondary {\n  min-width: 0;\n  padding: 0;\n  border: 0;\n}\n\n.btn {\n  display: inline-flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 2px;\n  min-width: 96px;\n  min-height: 52px;\n  padding-block: 6px;\n  padding-inline: 18px;\n  border: 3px solid var(--accent);\n  border-radius: 12px;\n  background: var(--accent);\n  color: var(--accent-text);\n  font: inherit;\n  font-weight: 700;\n  line-height: 1.2;\n  cursor: pointer;\n  touch-action: manipulation;\n}\n\n.btn-flip {\n  min-width: 128px;\n}\n\n.btn-secondary {\n  min-height: 44px;\n  border-color: var(--text);\n  background: var(--card-face);\n  color: var(--text);\n}\n\n.btn-toggle[aria-pressed=\"true\"] {\n  border-color: var(--accent);\n  background: var(--accent);\n  color: var(--accent-text);\n}\n\n.btn:focus {\n  outline: none;\n}\n\n.btn:focus-visible {\n  outline: 3px solid var(--text);\n  outline-offset: 3px;\n}\n\n.btn:disabled,\n.btn[aria-disabled=\"true\"] {\n  cursor: not-allowed;\n  opacity: 0.45;\n}\n\n.btn-label {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n}\n\n.btn-key {\n  font-size: 0.75rem;\n  font-weight: 500;\n}\n\n.check-icon {\n  display: none;\n  width: 1em;\n  height: 1em;\n}\n\n.btn-toggle[aria-pressed=\"true\"] .check-icon {\n  display: block;\n}\n\n/* Status */\n\n.status {\n  margin-block-start: 16px;\n  text-align: center;\n}\n\n.counter {\n  margin: 0;\n  font-weight: 600;\n}\n\n.counter-part + .counter-part {\n  margin-inline-start: 1.25em;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .card-inner {\n    transition: none;\n  }\n}\n",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "config.json",
          "contents": "{\n  \"schemaVersion\": 1,\n  \"configId\": \"codeai-default\",\n  \"theme\": {\n    \"background\": \"#E4E2F8\",\n    \"cardFace\": \"#FFFFFF\",\n    \"textColor\": \"#000000\",\n    \"accent\": \"#4C42CF\",\n    \"frameColors\": {\n      \"word\": \"#0099F3\",\n      \"definition\": \"#003F25\",\n      \"example\": \"#F46800\",\n      \"image\": \"#4C42CF\"\n    },\n    \"fontFamily\": \"system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif\",\n    \"wordSize\": \"large\",\n    \"textAlign\": \"center\",\n    \"textPosition\": \"center\",\n    \"cornerRadius\": \"medium\"\n  },\n  \"controls\": {\n    \"shuffle\": true,\n    \"flipDirection\": true,\n    \"progressCounter\": true,\n    \"markKnown\": true\n  },\n  \"startFlipped\": false,\n  \"startShuffled\": false\n}",
          "folderId": "0",
          "active": false
        }
      },
