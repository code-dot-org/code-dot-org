          "name": "style.css",
          "language": "css",
          "contents": "/* 2) Use at least three CSS properties to style the special haiku */\n\nbody {\n  background: mistyrose;\n  color: darkviolet;\n}\np {\n  font-family:serif;\n  margin: 10px;\n  font-size: 14px;\n}\nh1 {\n  font-weight:lighter;\n}\n\nh2 {\n  font-weight: lighter;\n}\n\nh3 { \n    \n}\nh4 {\n  font-family: sans-serif\n}\nh5 {\n  font-family:serif;\n  text-align: right;\n}\nh6 {\n  font-style: italic;\n}\n\nhr {\n  width: 100%;\n}\nimg {\n  width: 300px;\n  border-radius: 20px;\n  margin: 10px;\n}",
