        "4": {
          "id": "4",
          "name": "helpers.js",
          "contents": "// Calculates the score for a comment.\nconst getCommentScore = (comment) => {\n  return comment.upvotes - comment.downvotes;\n};\n\n// Formats how recently a comment was made.\nconst formatTime = (minutesAgo) => {\n  return minutesAgo + \"m ago\";\n};\n\n// Formats the gold badge for a comment.\nconst formatGoldBadge = (comment) => {\n  if (comment.hasGold) {\n    return \" ⭐\";\n  }\n\n  return \"\";\n};\n\n// Creates one comment card.\n// Students do not need to edit this function.\nconst createCommentCard = (comment) => {\n  const threadContainer = document.getElementById(\"thread-container\");\n\n  const card = document.createElement(\"article\");\n  card.className = \"comment-card\";\n  card.id = \"commentCard\" + comment.id;\n\n  if (comment.isFlagged) {\n    card.classList.add(\"flagged-warning\");\n  }\n\n  const votes = document.createElement(\"div\");\n  votes.className = \"votes\";\n  votes.id = \"commentVotes\" + comment.id;\n  votes.textContent = \"⬆️ \" + getCommentScore(comment);\n\n  const content = document.createElement(\"div\");\n  content.className = \"content\";\n  content.id = \"commentContent\" + comment.id;\n\n  const author = document.createElement(\"h4\");\n  author.className = \"comment-author\";\n  author.id = \"commentAuthor\" + comment.id;\n  author.textContent = \"u/\" + comment.user + formatGoldBadge(comment);\n\n  const time = document.createElement(\"span\");\n  time.className = \"time\";\n  time.id = \"commentTime\" + comment.id;\n  time.textContent = formatTime(comment.minutesAgo);\n\n  author.appendChild(document.createTextNode(\" \"));\n  author.appendChild(time);\n\n  const text = document.createElement(\"p\");\n  text.className = \"comment-text\";\n  text.id = \"commentText\" + comment.id;\n  text.textContent = comment.text;\n\n  content.appendChild(author);\n  content.appendChild(text);\n\n  card.appendChild(votes);\n  card.appendChild(content);\n\n  threadContainer.appendChild(card);\n};\n\n// Displays the current comments on the page.\nconst renderThread = () => {\n  const threadContainer = document.getElementById(\"thread-container\");\n\n  threadContainer.innerHTML = \"\";\n\n  displayComments.map((comment) => {\n    createCommentCard(comment);\n  });\n};\n",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "script.js",
          "contents": "// View 1\n\n// This array controls which comments are currently shown.\nlet displayComments = threadData;\n\n// First page load\nrenderThread();\n\n// Moderator Algorithm\n\n// Builds the moderated thread.\nconst runModeratorBot = () => {\n  // filter → sort → render\n\n\n\n\n\n\n\n};\n\n// Event listeners\ndocument.getElementById(\"run-mod-btn\").addEventListener(\"click\", runModeratorBot);\n",
          "folderId": "0",
          "active": false
        },
        "6": {
          "id": "6",
          "name": "style.css",
          "contents": ":root {\n  --card-bg: rgba(15, 23, 42, 0.86);\n  --card-bg-strong: rgba(17, 26, 48, 0.96);\n  --text-main: #F4F7FB;\n  --text-meta: #91A0B8;\n  --blue: #7193FF;\n  --danger-strong: #FF4D6D;\n  --cyan: #29F2D1;\n  --line: rgba(148, 163, 184, 0.22);\n  --shadow: 0 24px 80px rgba(0, 0, 0, 0.38);\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  min-height: 100vh;\n  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n  background:\n    radial-gradient(circle at top left, rgba(41, 242, 209, 0.16), transparent 34rem),\n    radial-gradient(circle at top right, rgba(113, 147, 255, 0.18), transparent 32rem),\n    linear-gradient(135deg, #070917 0%, #0B1022 48%, #111827 100%);\n  color: var(--text-main);\n  margin: 0;\n  padding-bottom: 48px;\n}\n\nbody::before {\n  content: \"\";\n  position: fixed;\n  inset: 0;\n  pointer-events: none;\n  background-image:\n    linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);\n  background-size: 44px 44px;\n  mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.72), transparent 72%);\n}\n\nbutton {\n  font: inherit;\n  background: linear-gradient(135deg, var(--cyan), var(--blue));\n  color: #05111A;\n  border: 0;\n  padding: 10px 18px;\n  border-radius: 999px;\n  cursor: pointer;\n  font-weight: 800;\n  box-shadow: 0 12px 32px rgba(41, 242, 209, 0.22);\n  transition: transform 160ms ease, box-shadow 160ms ease, filter 160ms ease;\n}\n\nbutton:hover {\n  filter: brightness(1.08);\n  transform: translateY(-1px);\n  box-shadow: 0 16px 42px rgba(113, 147, 255, 0.30);\n}\n\nbutton:focus-visible {\n  outline: 3px solid rgba(41, 242, 209, 0.52);\n  outline-offset: 3px;\n}\n\n.topbar {\n  background: rgba(7, 9, 23, 0.82);\n  border-bottom: 1px solid var(--line);\n  padding: 14px 24px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 16px;\n  position: sticky;\n  top: 0;\n  z-index: 100;\n  backdrop-filter: blur(18px);\n  box-shadow: 0 12px 42px rgba(0, 0, 0, 0.24);\n}\n\n.brand {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  min-width: 0;\n}\n\n.brand-mark {\n  width: 44px;\n  height: 44px;\n  display: grid;\n  place-items: center;\n  border-radius: 16px;\n  color: #061018;\n  font-weight: 900;\n  letter-spacing: -0.08em;\n  background: linear-gradient(135deg, var(--cyan), var(--blue));\n  box-shadow: 0 0 32px rgba(41, 242, 209, 0.32);\n}\n\n.logo {\n  font-weight: 800;\n  font-size: 1.14rem;\n  color: var(--text-main);\n  letter-spacing: -0.03em;\n}\n\n.app-shell {\n  width: min(980px, 100%);\n  margin: 0 auto;\n  padding: 26px 24px 0;\n}\n\n.feed-panel {\n  min-width: 0;\n}\n\n#thread-container {\n  width: 100%;\n  margin: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.comment-card {\n  border: 1px solid var(--line);\n  background: var(--card-bg);\n  box-shadow: var(--shadow);\n  backdrop-filter: blur(16px);\n  border-radius: 20px;\n  display: flex;\n  gap: 14px;\n  padding: 14px;\n  position: relative;\n  overflow: hidden;\n  transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;\n}\n\n.comment-card::before {\n  content: \"\";\n  position: absolute;\n  inset: 0 auto 0 0;\n  width: 3px;\n  background: linear-gradient(to bottom, var(--cyan), var(--blue));\n  opacity: 0.85;\n}\n\n.comment-card:hover {\n  transform: translateY(-2px);\n  border-color: rgba(41, 242, 209, 0.36);\n  background: var(--card-bg-strong);\n}\n\n.comment-card.flagged-warning {\n  background:\n    linear-gradient(135deg, rgba(255, 77, 109, 0.18), rgba(15, 23, 42, 0.86)),\n    var(--card-bg);\n  border-color: rgba(255, 77, 109, 0.55);\n}\n\n.comment-card.flagged-warning::before {\n  background: var(--danger-strong);\n}\n\n.comment-card.flagged-warning::after {\n  content: \"FLAGGED\";\n  position: absolute;\n  top: 12px;\n  right: 12px;\n  border: 1px solid rgba(255, 77, 109, 0.45);\n  border-radius: 999px;\n  color: #FFDDE4;\n  background: rgba(255, 77, 109, 0.14);\n  padding: 4px 8px;\n  font-size: 0.68rem;\n  font-weight: 900;\n  letter-spacing: 0.08em;\n}\n\n.votes {\n  width: auto;\n  min-width: 72px;\n  text-align: center;\n  font-weight: 900;\n  color: var(--cyan);\n  border-right: 1px solid var(--line);\n  padding: 10px 14px 10px 4px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  text-shadow: 0 0 20px rgba(41, 242, 209, 0.24);\n}\n\n.content {\n  min-width: 0;\n  flex: 1;\n}\n\n.comment-card.flagged-warning .content {\n  padding-right: 72px;\n}\n\n.comment-author {\n  margin: 0 0 7px 0;\n  color: var(--text-main);\n  font-size: 0.92rem;\n  line-height: 1.4;\n}\n\n.time {\n  color: var(--text-meta);\n  font-weight: 500;\n  font-size: 0.78rem;\n}\n\n.comment-text {\n  margin: 0;\n  color: #DCE5F3;\n  font-size: 1rem;\n  line-height: 1.55;\n}\n\n@media (max-width: 780px) {\n  .topbar {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n\n  button {\n    width: 100%;\n  }\n\n  .app-shell {\n    padding: 18px 14px 0;\n  }\n\n  .comment-card {\n    gap: 10px;\n    padding: 12px;\n  }\n\n  .votes {\n    min-width: 56px;\n    padding-right: 10px;\n    font-size: 0.92rem;\n  }\n\n  .comment-card.flagged-warning::after {\n    position: static;\n    align-self: flex-start;\n    margin-left: auto;\n    order: 3;\n  }\n}\n\n@media (max-width: 520px) {\n  .brand-mark {\n    width: 38px;\n    height: 38px;\n    border-radius: 14px;\n  }\n\n  .comment-card {\n    flex-direction: column;\n  }\n\n  .comment-card::before {\n    width: 100%;\n    height: 3px;\n    inset: 0 0 auto;\n  }\n\n  .votes {\n    width: 100%;\n    min-width: 0;\n    border-right: 0;\n    border-bottom: 1px solid var(--line);\n    justify-content: flex-start;\n    padding: 6px 0 10px;\n  }\n}\n",
          "folderId": "0",
          "active": false
        },
        "7": {
          "id": "7",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>r/TechLife Moderator</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <header class=\"topbar\">\n    <div class=\"brand\" aria-label=\"r/TechLife\">\n      <span class=\"brand-mark\">r/</span>\n      <div class=\"logo\">r/TechLife</div>\n    </div>\n\n    <button id=\"run-mod-btn\" type=\"button\">Run Moderator Bot</button>\n  </header>\n\n  <main class=\"app-shell\" aria-label=\"TechLife discussion thread\">\n    <section class=\"feed-panel\" aria-label=\"Comments\">\n      <div id=\"thread-container\" aria-live=\"polite\"></div>\n    </section>\n  </main>\n\n  <script src=\"data.js\"></script>\n  <script src=\"helpers.js\"></script>\n  <script src=\"script.js\"></script>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
