      "files": {
        "3": {
          "id": "3",
          "name": "data.js",
          "contents": "const threadData = [\n  {\n    id: 1,\n    user: \"dev_king\",\n    text: \"Always backup your data!\",\n    upvotes: 450,\n    downvotes: 2,\n    minutesAgo: 120,\n    hasGold: true,\n    isFlagged: false\n  },\n  {\n    id: 2,\n    user: \"troll_bot_99\",\n    text: \"CLICK HERE FOR FREE RAM\",\n    upvotes: 0,\n    downvotes: 50,\n    minutesAgo: 1,\n    hasGold: false,\n    isFlagged: true\n  },\n  {\n    id: 3,\n    user: \"newbie_coder\",\n    text: \"Is this safe?\",\n    upvotes: 5,\n    downvotes: 0,\n    minutesAgo: 2,\n    hasGold: false,\n    isFlagged: false\n  },\n  {\n    id: 4,\n    user: \"python_fan\",\n    text: \"Python is better.\",\n    upvotes: 120,\n    downvotes: 110,\n    minutesAgo: 60,\n    hasGold: false,\n    isFlagged: false\n  },\n  {\n    id: 5,\n    user: \"java_lover\",\n    text: \"Java is better.\",\n    upvotes: 115,\n    downvotes: 100,\n    minutesAgo: 55,\n    hasGold: false,\n    isFlagged: false\n  },\n  {\n    id: 6,\n    user: \"spammer_2\",\n    text: \"Buy cheap crypto now!\",\n    upvotes: 1,\n    downvotes: 20,\n    minutesAgo: 5,\n    hasGold: false,\n    isFlagged: true\n  },\n  {\n    id: 7,\n    user: \"helpful_guy\",\n    text: \"Try restarting the router.\",\n    upvotes: 300,\n    downvotes: 10,\n    minutesAgo: 200,\n    hasGold: true,\n    isFlagged: false\n  },\n  {\n    id: 8,\n    user: \"angry_user\",\n    text: \"I hate this update!\",\n    upvotes: 10,\n    downvotes: 8,\n    minutesAgo: 15,\n    hasGold: false,\n    isFlagged: false\n  },\n  {\n    id: 9,\n    user: \"mod_official\",\n    text: \"Please read the rules.\",\n    upvotes: 1000,\n    downvotes: 0,\n    minutesAgo: 300,\n    hasGold: true,\n    isFlagged: false\n  },\n  {\n    id: 10,\n    user: \"random_dude\",\n    text: \"First!\",\n    upvotes: 2,\n    downvotes: 50,\n    minutesAgo: 1,\n    hasGold: false,\n    isFlagged: false\n  },\n  {\n    id: 11,\n    user: \"web_wiz\",\n    text: \"Check your console log.\",\n    upvotes: 45,\n    downvotes: 2,\n    minutesAgo: 45,\n    hasGold: false,\n    isFlagged: false\n  },\n  {\n    id: 12,\n    user: \"css_master\",\n    text: \"Flexbox is life.\",\n    upvotes: 80,\n    downvotes: 5,\n    minutesAgo: 90,\n    hasGold: true,\n    isFlagged: false\n  },\n  {\n    id: 13,\n    user: \"bad_link\",\n    text: \"http://malware.site\",\n    upvotes: 0,\n    downvotes: 100,\n    minutesAgo: 10,\n    hasGold: false,\n    isFlagged: true\n  },\n  {\n    id: 14,\n    user: \"react_fan\",\n    text: \"Components are reusable.\",\n    upvotes: 60,\n    downvotes: 10,\n    minutesAgo: 30,\n    hasGold: false,\n    isFlagged: false\n  },\n  {\n    id: 15,\n    user: \"scam_bot\",\n    text: \"You won a prize!\",\n    upvotes: 2,\n    downvotes: 30,\n    minutesAgo: 3,\n    hasGold: false,\n    isFlagged: true\n  }\n];\n",
          "folderId": "0",
