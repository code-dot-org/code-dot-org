      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <title>App Store</title>\n\n  <style>\n    * {\n      box-sizing: border-box;\n    }\n\n    body {\n      margin: 0;\n      font-family: system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n      background: radial-gradient(circle at top left, #e0f2fe 0, #eef2ff 35%, #f9fafb 70%);\n      color: #111827;\n      display: flex;\n      justify-content: center;\n      padding: 24px;\n    }\n\n    .app-container {\n      width: 100%;\n      max-width: 1000px;\n      background: #ffffff;\n      border-radius: 22px;\n      box-shadow: 0 18px 45px rgba(15, 23, 42, 0.18);\n      padding: 22px 24px 26px;\n      border: 1px solid rgba(148, 163, 184, 0.3);\n    }\n\n    .header {\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: space-between;\n      gap: 16px;\n      align-items: flex-start;\n      margin-bottom: 12px;\n    }\n\n    .header-title {\n      font-size: 1.4rem;\n      font-weight: 750;\n      letter-spacing: 0.03em;\n    }\n\n    .header-right {\n      display: flex;\n      flex-direction: column;\n      align-items: flex-end;\n      gap: 6px;\n      min-width: 280px; /* keeps buttons from bouncing */\n    }\n\n    .sort-controls {\n      display: inline-flex;\n      flex-wrap: wrap;\n      gap: 6px;\n      justify-content: flex-end;\n    }\n\n    .sort-button {\n      border: none;\n      border-radius: 999px;\n      padding: 8px 16px;\n      font-size: 0.85rem;\n      cursor: pointer;\n      background: #e5e7eb;\n      color: #374151;\n      transition: transform 0.08s ease, box-shadow 0.08s ease, background 0.15s ease, color 0.15s ease;\n      white-space: nowrap;\n    }\n\n    .sort-button:hover {\n      transform: translateY(-1px);\n      box-shadow: 0 3px 8px rgba(15, 23, 42, 0.16);\n    }\n\n    .sort-button.active {\n      background: #111827;\n      color: #f9fafb;\n      box-shadow: 0 4px 12px rgba(15, 23, 42, 0.35);\n    }\n\n    .sort-info {\n      font-size: 0.78rem;\n      color: #6b7280;\n      min-height: 30px; /* space reserved so layout doesn’t jump */\n    }\n\n    .apps-grid {\n      margin-top: 16px;\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));\n      gap: 16px;\n    }\n\n    .app-card {\n      background: #f9fafb;\n      border-radius: 18px;\n      padding: 14px 14px 12px;\n      display: flex;\n      flex-direction: column;\n      border: 1px solid #e5e7eb;\n      position: relative;\n      overflow: hidden;\n      transition: transform 0.12s ease, box-shadow 0.12s ease, border-color 0.12s ease, background 0.12s ease;\n    }\n\n    .app-card:hover {\n      transform: translateY(-3px);\n      box-shadow: 0 10px 20px rgba(15, 23, 42, 0.15);\n      border-color: #cbd5f5;\n      background: #f3f4ff;\n    }\n\n    .app-card.top-app {\n      border: 2px solid #111827;\n      background: #e0e7ff;\n      box-shadow: 0 14px 24px rgba(15, 23, 42, 0.28);\n    }\n\n    .top-badge {\n      align-self: flex-start;\n      font-size: 0.7rem;\n      text-transform: uppercase;\n      letter-spacing: 0.07em;\n      padding: 3px 10px;\n      border-radius: 999px;\n      background: #111827;\n      color: #f9fafb;\n      margin-bottom: 6px;\n    }\n\n    .app-header {\n      display: flex;\n      gap: 10px;\n      align-items: center;\n      margin-bottom: 6px;\n    }\n\n    .app-icon {\n      width: 38px;\n      height: 38px;\n      border-radius: 14px;\n      flex-shrink: 0;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 0.95rem;\n      font-weight: 700;\n      color: white;\n      box-shadow: inset 0 0 0 1px rgba(15, 23, 42, 0.15);\n    }\n\n    /* fun icon gradients */\n    .icon-a { background: linear-gradient(135deg, #4f46e5, #22c55e); }\n    .icon-b { background: linear-gradient(135deg, #0ea5e9, #6366f1); }\n    .icon-c { background: linear-gradient(135deg, #f97316, #ec4899); }\n    .icon-d { background: linear-gradient(135deg, #22c55e, #84cc16); }\n    .icon-e { background: linear-gradient(135deg, #6366f1, #db2777); }\n    .icon-m { background: linear-gradient(135deg, #14b8a6, #0ea5e9); }\n    .icon-s { background: linear-gradient(135deg, #8b5cf6, #ec4899); }\n    .icon-t { background: linear-gradient(135deg, #ef4444, #f97316); }\n    .icon-z { background: linear-gradient(135deg, #0ea5e9, #22c55e); }\n\n    .app-name {\n      font-size: 0.98rem;\n      font-weight: 650;\n    }\n\n    .app-category {\n      font-size: 0.76rem;\n      color: #6b7280;\n    }\n\n    .app-meta {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n      margin: 4px 0 8px;\n      font-size: 0.75rem;\n      color: #4b5563;\n    }\n\n    .app-meta span {\n      display: inline-flex;\n      align-items: center;\n      gap: 3px;\n      padding: 3px 8px;\n      border-radius: 999px;\n      background: #e5e7eb;\n    }\n\n    .app-meta span.meta-rating::before {\n      content: \"★\";\n      font-size: 0.8rem;\n    }\n\n    .app-description {\n      font-size: 0.78rem;\n      color: #4b5563;\n      margin-top: auto;\n    }\n\n    @media (max-width: 600px) {\n      body {\n        padding: 14px;\n      }\n\n      .app-container {\n        padding: 16px 14px 20px;\n      }\n\n      .header-right {\n        align-items: flex-start;\n        min-width: 0;\n      }\n\n      .sort-controls {\n        justify-content: flex-start;\n      }\n    }\n  </style>\n</head>\n<body>\n\n  <div class=\"app-container\">\n    <div class=\"header\">\n      <div class=\"header-left\">\n        <div class=\"header-title\">App Store</div>\n      </div>\n\n      <div class=\"header-right\">\n        <div class=\"sort-controls\">\n          <button class=\"sort-button active\" data-sort=\"popular\">Most Popular</button>\n          <button class=\"sort-button\" data-sort=\"alphabetical\">Alphabetical</button>\n          <button class=\"sort-button\" data-sort=\"newest\">Newest</button>\n        </div>\n        <div class=\"sort-info\" id=\"sortInfo\"></div>\n      </div>\n    </div>\n\n    <div class=\"apps-grid\" id=\"appsGrid\">\n      <!-- Cards rendered by JavaScript -->\n    </div>\n  </div>\n\n  <script>\n    const apps = [\n      {\n        id: 1,\n        name: \"Alpha Fitness\",\n        category: \"Health & Fitness\",\n        downloads: 520000,\n        rating: 4.8,\n        releaseDate: \"2023-03-15\",\n        description: \"Short daily workouts and progress tracking.\"\n      },\n      {\n        id: 2,\n        name: \"Zen Garden\",\n        category: \"Lifestyle\",\n        downloads: 18000,\n        rating: 4.9,\n        releaseDate: \"2025-01-31\",\n        description: \"Mindfulness reminders and calming soundscapes.\"\n      },\n      {\n        id: 3,\n        name: \"Budget Buddy\",\n        category: \"Finance\",\n        downloads: 83000,\n        rating: 4.3,\n        releaseDate: \"2024-09-09\",\n        description: \"Track spending, savings goals, and bills.\"\n      },\n      {\n        id: 4,\n        name: \"ChatterBox\",\n        category: \"Social\",\n        downloads: 1400000,\n        rating: 4.6,\n        releaseDate: \"2022-11-04\",\n        description: \"Group chats, stories, and reactions.\"\n      },\n      {\n        id: 5,\n        name: \"Study Spark\",\n        category: \"Education\",\n        downloads: 97000,\n        rating: 4.4,\n        releaseDate: \"2024-04-21\",\n        description: \"Flashcards, timers, and study streaks.\"\n      },\n      {\n        id: 6,\n        name: \"Tiny Town Builder\",\n        category: \"Games\",\n        downloads: 310000,\n        rating: 4.2,\n        releaseDate: \"2021-07-18\",\n        description: \"Design your own tiny city and villages.\"\n      },\n      {\n        id: 7,\n        name: \"EverList\",\n        category: \"Productivity\",\n        downloads: 49000,\n        rating: 4.1,\n        releaseDate: \"2025-01-09\",\n        description: \"Simple to-do lists that sync across devices.\"\n      },\n      {\n        id: 8,\n        name: \"MoveMore\",\n        category: \"Health & Fitness\",\n        downloads: 210000,\n        rating: 4.0,\n        releaseDate: \"2023-09-01\",\n        description: \"Step counter and movement reminders.\"\n      }\n    ];\n\n    const sortDescriptions = {\n      popular: \"Most Popular: Apps with the highest number of downloads appear first.\",\n      alphabetical: \"Alphabetical: Apps are ordered from A to Z by name.\",\n      newest: \"Newest: Apps released most recently appear first.\"\n    };\n\n    const iconClassForName = name => {\n      const first = name.trim().charAt(0).toLowerCase();\n      if (\"abc\".includes(first)) return \"icon-a\";\n      if (\"de\".includes(first)) return \"icon-b\";\n      if (\"fg\".includes(first)) return \"icon-c\";\n      if (\"hij\".includes(first)) return \"icon-d\";\n      if (\"klm\".includes(first)) return \"icon-m\";\n      if (\"nopq\".includes(first)) return \"icon-e\";\n      if (\"rst\".includes(first)) return \"icon-t\";\n      if (\"uvwx\".includes(first)) return \"icon-s\";\n      return \"icon-z\";\n    };\n\n    const appsGrid = document.getElementById(\"appsGrid\");\n    const sortInfo = document.getElementById(\"sortInfo\");\n    const sortButtons = document.querySelectorAll(\".sort-button\");\n\n    function formatDownloads(n) {\n      if (n >= 1_000_000) {\n        return (n / 1_000_000).toFixed(1).replace(/\\.0$/, \"\") + \"M downloads\";\n      }\n      if (n >= 1_000) {\n        return Math.round(n / 1_000) + \"K downloads\";\n      }\n      return n.toLocaleString() + \" downloads\";\n    }\n\n    function formatDate(iso) {\n      const date = new Date(iso);\n      return date.toLocaleDateString(undefined, {\n        year: \"numeric\",\n        month: \"short\",\n        day: \"numeric\"\n      });\n    }\n\n    function renderApps(sortMode = \"popular\") {\n      const sorted = [...apps];\n\n      if (sortMode === \"popular\") {\n        sorted.sort((a, b) => b.downloads - a.downloads || b.rating - a.rating);\n      } else if (sortMode === \"alphabetical\") {\n        sorted.sort((a, b) => a.name.localeCompare(b.name));\n      } else if (sortMode === \"newest\") {\n        sorted.sort((a, b) => new Date(b.releaseDate) - new Date(a.releaseDate));\n      }\n\n      appsGrid.innerHTML = \"\";\n      sorted.forEach((app, index) => {\n        const card = document.createElement(\"article\");\n        card.className = \"app-card\" + (index === 0 ? \" top-app\" : \"\");\n\n        const iconClass = iconClassForName(app.name);\n\n        card.innerHTML = `\n          ${index === 0 ? `<div class=\"top-badge\">#1 in this view</div>` : \"\"}\n          <div class=\"app-header\">\n            <div class=\"app-icon ${iconClass}\">${app.name.charAt(0)}</div>\n            <div>\n              <div class=\"app-name\">${app.name}</div>\n              <div class=\"app-category\">${app.category}</div>\n            </div>\n          </div>\n          <div class=\"app-meta\">\n            <span class=\"meta-rating\">${app.rating.toFixed(1)}</span>\n            <span>${formatDownloads(app.downloads)}</span>\n            <span>Released ${formatDate(app.releaseDate)}</span>\n          </div>\n          <p class=\"app-description\">${app.description}</p>\n        `;\n\n        appsGrid.appendChild(card);\n      });\n\n      sortInfo.textContent = sortDescriptions[sortMode];\n    }\n\n    function setActiveButton(mode) {\n      sortButtons.forEach(btn => {\n        const isActive = btn.dataset.sort === mode;\n        btn.classList.toggle(\"active\", isActive);\n      });\n    }\n\n    sortButtons.forEach(button => {\n      button.addEventListener(\"click\", () => {\n        const mode = button.dataset.sort;\n        setActiveButton(mode);\n        renderApps(mode);\n      });\n    });\n\n    // Initial render\n    renderApps(\"popular\");\n  </script>\n</body>\n</html>",
          "active": true,
          "folderId": "0"
        },
        "2": {
