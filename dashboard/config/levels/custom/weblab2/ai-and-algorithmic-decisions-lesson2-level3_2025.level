          "contents": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Selection → Event Listener→ DOM Update</title>\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <link rel=\"stylesheet\" href=\"./style.css\">\n</head>\n<body>\n  <main class=\"container\">\n    <h1>Selection → Event Listener→ DOM Update</h1>\n    <p class=\"hint\">Your goal: wire one button to update the message below.</p>\n    <button id=\"actionBtn\">Click me</button>\n    <div id=\"message\" class=\"message\">Message will appear here.</div>\n  </main>\n  <script src=\"./script.js\"></script>\n</body>\n</html>\n",
