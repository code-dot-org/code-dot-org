      ],
      "answerTypeCustomizations": {
        "buildJavaScript": "You are a coding assistant helping a student write JavaScript functions for a task list app.\n\nThe student is learning how arrays work. Only focus on using .push() to add items to arrays.\n\nThe app uses three parallel arrays:\n\n- titleArray\n- detailArray\n- isPriorityArray\n\nRequirements:\n\n- Add values to all three arrays using .push()\n- Add false to isPriorityArray\n- Call renderTasks() at the end\n- Use the existing variables: inputTitle, inputDetails, and addTaskButton\n\nExample of correct structure:\n\n```\nconst addNewTask = () => {\n  const title = inputTitle.value;\n  const details = inputDetails.value;\n\n  titleArray.push(title);\n  detailArray.push(details);\n  isPriorityArray.push(false);\n\n  renderTasks();\n};\n\ndocument.getElementById(\"addTaskButton\").addEventListener(\"click\", addNewTask);\n```\n\nDo not:\n\n- Add validation or error handling\n- Introduce new concepts or extra features\n- Change variable names\n\nReturn only the final function and event listener code. No explanation."
      }
    },
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Task List</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <main class=\"phone\">\n      <header class=\"app-header\">\n        <h1>Task List</h1>\n      </header>\n\n      <section class=\"composer\">\n        <h2>Add a Task</h2>\n\n        <input id=\"inputTitle\" type=\"text\" placeholder=\"Task title...\" />\n        <textarea\n          id=\"inputDetails\"\n          placeholder=\"Task details (optional)...\"\n        ></textarea>\n\n        <div class=\"action-row\">\n          <button id=\"addTaskButton\" class=\"primary-button\">\n            <span class=\"button-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\">\n                <path d=\"M12 5v14M5 12h14\" />\n              </svg>\n            </span>\n            <span>\n              <strong>Add New Task</strong>\n              \n            </span>\n          </button>\n\n          <button id=\"addPriorityButton\" class=\"priority-button\">\n            <span class=\"button-icon\" aria-hidden=\"true\">\n              <svg viewBox=\"0 0 24 24\">\n                <path\n                  d=\"M12 3.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L12 17l-5.3 2.8 1-5.8-4.2-4.1 5.9-.9L12 3.5z\"\n                />\n              </svg>\n            </span>\n            <span>\n              <strong>Add Priority Task</strong>\n\n            </span>\n          </button>\n        </div>\n      </section>\n\n      <section class=\"tasks-section\">\n        <div class=\"tasks-header\">\n          <h2>Your Tasks</h2>\n\n          <div class=\"mini-actions\">\n            <button id=\"removeFirstButton\" class=\"icon-button\" aria-label=\"Remove first task\">\n  <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n    <polyline points=\"3 6 5 6 21 6\"></polyline>\n    <path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"></path>\n    <line x1=\"10\" y1=\"11\" x2=\"10\" y2=\"17\"></line>\n    <line x1=\"14\" y1=\"11\" x2=\"14\" y2=\"17\"></line>\n  </svg>\n              <span>First</span>\n            </button>\n\n            <button id=\"removeLastButton\" class=\"icon-button\" aria-label=\"Remove last task\">\n  <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n    <polyline points=\"3 6 5 6 21 6\"></polyline>\n    <path d=\"M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2\"></path>\n    <line x1=\"10\" y1=\"11\" x2=\"10\" y2=\"17\"></line>\n    <line x1=\"14\" y1=\"11\" x2=\"14\" y2=\"17\"></line>\n  </svg>\n              <span>Last</span>\n            </button>\n          </div>\n        </div>\n\n       \n\n        <div id=\"taskList\" class=\"task-list\"></div>\n      </section>\n    </main>\n\n    <script src=\"helpers.js\"></script>\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  font-family: Inter, Arial, sans-serif;\n  background: #f2f2f7;\n  color: #1f2937;\n}\n\n.phone {\n  width: 100%;\n  max-width: 430px;\n  min-height: 100vh;\n  margin: 0 auto;\n  background: #ffffff;\n  padding-bottom: 32px;\n}\n\n.app-header {\n  padding: 28px 20px 20px;\n  border-bottom: 1px solid #e5e7eb;\n  text-align: center;\n}\n\n.app-header h1 {\n  margin: 0;\n  font-size: 2.1rem;\n  font-weight: 700;\n  letter-spacing: -0.04em;\n  color: #1f2a44;\n}\n\n.composer,\n.tasks-section {\n  padding: 20px;\n}\n\n.composer h2,\n.tasks-section h2 {\n  margin: 0 0 14px;\n  font-size: 1.1rem;\n  font-weight: 700;\n  letter-spacing: -0.02em;\n  color: #1f2a44;\n}\n\n#inputTitle,\n#inputDetails {\n  width: 100%;\n  border: 1px solid #d1d5db;\n  border-radius: 14px;\n  padding: 14px 16px;\n  font-size: 1rem;\n  font-family: inherit;\n  background: #ffffff;\n  color: #1f2937;\n  outline: none;\n}\n\n#inputTitle {\n  margin-bottom: 12px;\n}\n\n#inputDetails {\n  min-height: 110px;\n  resize: none;\n  margin-bottom: 14px;\n}\n\n#inputTitle:focus,\n#inputDetails:focus {\n  border-color: #9ca3af;\n}\n\n.action-row {\n  display: flex;\n  gap: 10px;\n}\n\n.primary-button,\n.priority-button {\n  flex: 1;\n  border: none;\n  border-radius: 14px;\n  color: #ffffff;\n  padding: 14px 12px;\n  min-height: 58px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  cursor: pointer;\n  font: inherit;\n}\n\n.primary-button {\n  background: #3478f6;\n}\n\n.priority-button {\n  background: #7c4dff;\n}\n\n.button-icon {\n  width: 18px;\n  height: 18px;\n  display: inline-flex;\n  flex-shrink: 0;\n}\n\n.button-icon svg {\n  width: 18px;\n  height: 18px;\n  stroke: currentColor;\n  fill: none;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.button-label {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  line-height: 1.05;\n}\n\n.button-label strong {\n  font-size: 0.95rem;\n  font-weight: 700;\n}\n\n.button-label small {\n  display: none;\n}\n\n.tasks-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 8px;\n}\n\n.mini-actions {\n  display: flex;\n  gap: 8px;\n}\n\n.icon-button {\n  width: 58px;\n  height: 58px;\n  border: 1px solid #d1d5db;\n  border-radius: 14px;\n  background: #ffffff;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n  padding: 0;\n  cursor: pointer;\n  color: #475569;\n}\n\n.icon-button svg {\n  width: 18px;\n  height: 18px;\n  stroke: currentColor;\n  fill: none;\n  stroke-width: 2;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.icon-button span {\n  font-size: 0.7rem;\n  font-weight: 600;\n  line-height: 1;\n  text-align: center;\n}\n\n#removeFirstButton:hover,\n#removeLastButton:hover {\n  background: #f8fafc;\n}\n\n.task-count {\n  margin: 0 0 14px;\n  color: #6b7280;\n  font-size: 0.95rem;\n}\n\n.task-list {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.task-card {\n  border: 1px solid #e5e7eb;\n  border-radius: 16px;\n  padding: 16px;\n  background: #ffffff;\n}\n\n.task-card.priority {\n  background: #f7f3ff;\n  border-color: #ddd6fe;\n}\n\n.task-top {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  margin-bottom: 6px;\n}\n\n.priority-badge {\n  width: 18px;\n  height: 18px;\n  color: #7c4dff;\n  flex-shrink: 0;\n}\n\n.priority-badge svg {\n  width: 100%;\n  height: 100%;\n  fill: currentColor;\n}\n\n.task-title {\n  margin: 0;\n  font-size: 1rem;\n  font-weight: 700;\n  letter-spacing: -0.02em;\n  color: #1f2a44;\n}\n\n.task-details {\n  margin: 0;\n  color: #667085;\n  font-size: 0.95rem;\n  line-height: 1.35;\n}\n\n.empty-state {\n  border: 1px dashed #d1d5db;\n  border-radius: 16px;\n  padding: 24px 16px;\n  text-align: center;\n  color: #6b7280;\n  background: #fafafa;\n  font-size: 0.95rem;\n}\n\n@media (max-width: 430px) {\n  .composer,\n  .tasks-section {\n    padding: 16px;\n  }\n\n  .action-row {\n    display: flex;\n    flex-direction: row;\n    gap: 10px;\n  }\n\n  .primary-button,\n  .priority-button {\n    min-height: 54px;\n    padding: 12px 10px;\n  }\n\n  .button-label strong {\n    font-size: 0.88rem;\n  }\n\n  .tasks-header {\n    align-items: center;\n  }\n\n  .icon-button {\n    width: 56px;\n    height: 56px;\n  }\n\n  .icon-button span {\n    font-size: 0.68rem;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "helpers.js",
          "contents": "const createTaskCard = (title, details, isPriority) => {\n  const card = document.createElement(\"div\");\n  card.classList.add(\"task-card\");\n\n  if (isPriority) {\n    card.classList.add(\"priority\");\n  }\n\n  const topRow = document.createElement(\"div\");\n  topRow.classList.add(\"task-top\");\n\n  if (isPriority) {\n    const badge = document.createElement(\"div\");\n    badge.classList.add(\"priority-badge\");\n    badge.innerHTML = `\n      <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n        <path d=\"M12 3.5l2.6 5.3 5.9.9-4.2 4.1 1 5.8L12 17l-5.3 2.8 1-5.8-4.2-4.1 5.9-.9L12 3.5z\"></path>\n      </svg>\n    `;\n    topRow.appendChild(badge);\n  }\n\n  const taskTitle = document.createElement(\"h3\");\n  taskTitle.classList.add(\"task-title\");\n  taskTitle.textContent = title;\n\n  const taskDetails = document.createElement(\"p\");\n  taskDetails.classList.add(\"task-details\");\n  taskDetails.textContent = details;\n\n  topRow.appendChild(taskTitle);\n  card.appendChild(topRow);\n  card.appendChild(taskDetails);\n  taskList.appendChild(card);\n};\n\n",
          "folderId": "0",
          "active": false,
          "type": "starter"
        },
        "4": {
          "id": "4",
          "name": "script.js",
          "contents": "// Inputs and task list\nconst inputTitle = document.getElementById(\"inputTitle\");\nconst inputDetails = document.getElementById(\"inputDetails\");\nconst taskList = document.getElementById(\"taskList\");\n\n// Arrays that store task data\nconst titleArray = [\"Finish math homework\", \"Study for biology quiz\", \"Text group chat about project\", \"Clean up backpack\"];\nconst detailArray = [\"Complete problems 1-10 on worksheet\", \"Review notes and flashcards\", \"Decide who is doing each part\", \"Throw away old papers and organize folders\"];\nconst isPriorityArray = [false, false, false, false];\n\n\n// Displays all tasks from the arrays\nconst renderTasks = () => {\n  taskList.innerHTML = \"\";\n  inputTitle.value = \"\";\n  inputDetails.value = \"\";\n  \n  titleArray.map((title, index) => {\n    createTaskCard(titleArray[index], detailArray[index], isPriorityArray[index]);\n  });\n};\n\nrenderTasks();\n",
          "folderId": "0",
          "active": true
        },
        "5": {
          "id": "5",
          "name": "prompt.md",
          "contents": "",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "4",
        "5"
      ]
    },
