          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>My Pet Fish Page</title>\n</head>\n<body>\n\n</body>\n</html>",
