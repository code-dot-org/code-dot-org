<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-11-03T03:30:56.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": true,
    "start_sources": {
      "folders": {
      },
      "files": {
        "c95ce5ea-d6ab-47e7-a970-5c51d4e2f5c6": {
          "id": "c95ce5ea-d6ab-47e7-a970-5c51d4e2f5c6",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Decision Picker Widget</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <div class=\"container\">\n        <h1>What Should I Pick?</h1>\n        <p>Edit the list of options below, then click \"Pick One!\" to get a random selection.</p>\n\n        <div class=\"options-list-editor\">\n            <h2>Your Options:</h2>\n            <ul id=\"optionsList\" contenteditable=\"true\">\n                <li>Pizza</li>\n                <li>Tacos</li>\n                <li>Sushi</li>\n                <li>Burgers</li>\n                <li>Pasta</li>\n            </ul>\n            <small>(Click to edit these choices directly)</small>\n        </div>\n\n        <button id=\"pickButton\">Pick One!</button>\n\n        <div class=\"results\">\n            <h2>Last Pick: <span id=\"lastPick\">None yet!</span></h2>\n            <p>Times Picked: <span id=\"timesPicked\">0</span></p>\n            <div class=\"recent-picks\">\n                <h3>Recent Picks:</h3>\n                <ul id=\"recentPicksList\">\n                    <!-- Recent picks will be added here -->\n                </ul>\n            </div>\n        </div>\n    </div>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "a272403d-ddae-45cf-b870-3da33ad3887d": {
          "id": "a272403d-ddae-45cf-b870-3da33ad3887d",
          "name": "style.css",
          "contents": "body {\n    font-family: sans-serif;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    min-height: 100vh;\n    background-color: #f0f2f5;\n    color: #333;\n    margin: 0;\n    padding: 20px;\n    box-sizing: border-box;\n}\n\nh1 {\n    color: #0056b3;\n    margin-bottom: 10px;\n}\n\np {\n    margin-bottom: 25px;\n    text-align: center;\n    max-width: 600px;\n}\n\n.container {\n    background-color: #fff;\n    padding: 30px;\n    border-radius: 12px;\n    box-shadow: 0 4px 15px rgba(0,0,0,0.1);\n    width: 90%;\n    max-width: 500px;\n    text-align: center;\n    margin-bottom: 30px;\n}\n\n.options-list-editor {\n    margin-bottom: 20px;\n    border: 1px solid #ddd;\n    border-radius: 8px;\n    padding: 15px;\n    background-color: #f9f9f9;\n}\n\n.options-list-editor h2 {\n    color: #4CAF50;\n    margin-top: 0;\n    margin-bottom: 10px;\n}\n\n#optionsList {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n    text-align: left;\n    min-height: 100px;\n    border: 1px dashed #ccc;\n    padding: 10px;\n    border-radius: 5px;\n    background-color: #fff;\n    cursor: text;\n}\n\n#optionsList li {\n    padding: 5px 0;\n    border-bottom: 1px dotted #eee;\n}\n\n#optionsList li:last-child {\n    border-bottom: none;\n}\n\nsmall {\n    color: #666;\n    font-size: 0.8em;\n    display: block;\n    margin-top: 5px;\n}\n\n#pickButton {\n    background-color: #007bff;\n    color: white;\n    padding: 12px 25px;\n    border: none;\n    border-radius: 25px;\n    font-size: 1.1em;\n    cursor: pointer;\n    margin-top: 20px;\n    margin-bottom: 30px;\n    transition: background-color 0.3s ease, transform 0.2s ease;\n}\n\n#pickButton:hover {\n    background-color: #0056b3;\n    transform: translateY(-2px);\n}\n\n.results {\n    border-top: 1px solid #eee;\n    padding-top: 20px;\n}\n\n.results h2 {\n    color: #3f51b5;\n    font-size: 1.6em;\n}\n\n.results p {\n    font-size: 1.1em;\n    color: #555;\n    margin-bottom: 15px;\n}\n\n#lastPick {\n    font-weight: bold;\n    color: #E91E63;\n}\n\n#timesPicked {\n    font-weight: bold;\n    color: #FF9800;\n}\n\n.recent-picks {\n    background-color: #e8f5e9;\n    border: 1px solid #c8e6c9;\n    border-radius: 8px;\n    padding: 15px;\n    margin-top: 20px;\n}\n\n.recent-picks h3 {\n    color: #388E3C;\n    margin-top: 0;\n    margin-bottom: 10px;\n}\n\n#recentPicksList {\n    list-style: decimal inside;\n    padding-left: 0;\n    margin: 0;\n    text-align: left;\n    max-height: 150px;\n    overflow-y: auto;\n}\n\n#recentPicksList li {\n    padding: 3px 0;\n    color: #4CAF50;\n    font-size: 0.95em;\n}",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "3f396512-bc1d-4b39-ac37-89fcdf932328": {
          "id": "3f396512-bc1d-4b39-ac37-89fcdf932328",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const optionsList = document.getElementById('optionsList');\n    const pickButton = document.getElementById('pickButton');\n    const lastPickSpan = document.getElementById('lastPick');\n    const timesPickedSpan = document.getElementById('timesPicked');\n    const recentPicksList = document.getElementById('recentPicksList');\n\n    let timesPicked = 0;\n    const MAX_RECENT_PICKS = 5;\n\n    pickButton.addEventListener('click', () => {\n        // Get current options from the editable list\n        const options = Array.from(optionsList.children)\n                             .map(li => li.textContent.trim())\n                             .filter(text => text !== ''); // Filter out empty lines\n\n        if (options.length === 0) {\n            lastPickSpan.textContent = \"No options to pick!\";\n            return;\n        }\n\n        // Pick a random item\n        const randomIndex = Math.floor(Math.random() * options.length);\n        const pickedItem = options[randomIndex];\n\n        // Update last pick display\n        lastPickSpan.textContent = pickedItem;\n\n        // Update times picked counter\n        timesPicked++;\n        timesPickedSpan.textContent = timesPicked;\n\n        // Add to recent picks list\n        const newRecentPick = document.createElement('li');\n        newRecentPick.textContent = pickedItem;\n        recentPicksList.prepend(newRecentPick); // Add to the top\n\n        // Limit the number of recent picks shown\n        while (recentPicksList.children.length > MAX_RECENT_PICKS) {\n            recentPicksList.removeChild(recentPicksList.lastChild);\n        }\n    });\n});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
        "c95ce5ea-d6ab-47e7-a970-5c51d4e2f5c6",
