<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-11-02T19:51:18.000Z",
  "level_num": "custom",
  "user_id": 23870,
  "properties": {
    "require_edit_to_continue": "false",
    "encrypted": "false",
    "long_instructions": "In regular expressions, special symbols represent **character classes**—collections of more than one character.\r\n\r\n`\\w` represents all \"word characters\": the upper- and lower-case letters A–Z, the digits 0–9, and the underscore (_). These are the characters that commonly make up words or numbers.\r\n\r\n`\\s` represents all whitespace: spaces, tabs, and linebreaks.\r\n\r\n**☑️ Do This:**\r\n- Try the character classes you’ve learned about.\r\n  - Try `\\w` as a regular expression. What becomes a token?\r\n  - Try `\\s` as a regular expression. What becomes a token?\r\n",
    "offer_browser_tts": "false",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "true",
    "initial_view_mode": "split",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "placeholderText": "",
      "multipleChoiceOptions": [
        ""
      ],
      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false
    },
    "ai_tutor_prompt_settings": {
      "answerTypes": [
        "ask"
      ],
      "answerTypeCustomizations": {
      },
      "disableCommitMessages": true
    },
    "start_sources": {
      "folders": {
        "1": {
          "id": "1",
          "name": "components",
          "parentId": "0",
          "open": true
        }
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Tokenization</title>\n    <link rel=\"stylesheet\" href=\"styles.css\" />\n\n    <!-- Google Fonts -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link\n      href=\"https://fonts.googleapis.com/css2?family=Geist+Mono:ital,wght@0,100..900;1,100..900&family=Geist:ital,wght@0,100..900;1,100..900&family=Space+Grotesk:wght@300..700&display=swap\"\n      rel=\"stylesheet\"\n    />\n  </head>\n  <body>\n    <header>\n      <h1>Tokenization</h1>\n    </header>\n    <main>\n      <section class=\"regex-input-section\" aria-label=\"Expression and text\">\n        <div class=\"field\">\n          <label class=\"field__label\" for=\"regex-input\"\n            >Regular expression</label\n          >\n          <div class=\"regex-input\">\n            <span class=\"regex-input__affix\" aria-hidden=\"true\">r&quot;</span>\n            <input\n              id=\"regex-input\"\n              type=\"text\"\n              value=\"\"\n              spellcheck=\"false\"\n              autocomplete=\"off\"\n              autocapitalize=\"off\"\n              autocorrect=\"off\"\n              aria-describedby=\"regex-error\"\n            />\n            <span class=\"regex-input__affix\" aria-hidden=\"true\">&quot;</span>\n          </div>\n          <p class=\"field__error\" id=\"regex-error\" aria-live=\"polite\"></p>\n        </div>\n\n        <div class=\"field\">\n          <label class=\"field__label\" for=\"regex-text\">Text</label>\n          <div class=\"highlighted-text\">\n            <div class=\"highlighted-text__backdrop\" aria-hidden=\"true\"></div>\n            <textarea id=\"regex-text\" spellcheck=\"false\">\nOur home galaxy is called the Milky Way. It's a spiral galaxy with a disk of stars spanning more than 100,000 light-years.</textarea\n            >\n          </div>\n        </div>\n      </section>\n\n      <section class=\"token-output-section\" aria-labelledby=\"tokens-heading\">\n        <div class=\"token-output-section__header\">\n          <h2 id=\"tokens-heading\">Tokens</h2>\n          <p class=\"token-count\" aria-live=\"polite\"></p>\n        </div>\n        <div class=\"token-list-area\">\n          <ol class=\"token-list\"></ol>\n          <p class=\"token-list__note\" aria-live=\"polite\"></p>\n        </div>\n      </section>\n    </main>\n\n    <template id=\"token-template\">\n      <li class=\"token\"></li>\n    </template>\n\n    <script type=\"module\" src=\"app.js\"></script>\n  </body>\n</html>\n",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
        "2": {
          "id": "2",
          "name": "styles.css",
          "contents": "@import url(\"components/highlighted-text.css\");\n@import url(\"components/token-list.css\");\n\n:root {\n    --gray-0: #fdfdfd;\n    --gray-50: #f9f9f9;\n    --gray-100: #f4f4f4;\n    --gray-150: #eeeeee;\n    --gray-200: #e5e5e5;\n    --gray-300: #d4d4d4;\n    --gray-400: #a3a3a3;\n    --gray-500: #737373;\n    --gray-600: #525252;\n    --gray-700: #404040;\n    --gray-800: #262626;\n    --gray-900: #171717;\n    --gray-950: #0a0a0a;\n    --purple-0: rgb(245, 244, 253);\n    --purple-100: rgb(234, 232, 251);\n    --purple-200: rgb(214, 210, 246);\n    --purple-300: rgb(192, 188, 240);\n    --purple-400: rgb(169, 163, 232);\n    --purple-500: rgb(105, 98, 210);\n    --purple-600: rgb(82, 75, 184);\n    --purple-700: rgb(59, 53, 153);\n    --purple-800: rgb(41, 35, 126);\n    --purple-900: rgb(30, 25, 113);\n    --mint-0: rgb(244, 252, 247);\n    --mint-100: rgb(230, 247, 237);\n    --mint-200: rgb(211, 240, 211);\n    --mint-300: rgb(184, 228, 196);\n    --mint-400: rgb(141, 207, 170);\n    --mint-500: rgb(91, 175, 138);\n    --mint-600: rgb(56, 140, 110);\n    --mint-700: rgb(34, 107, 86);\n    --mint-800: rgb(21, 74, 60);\n    --mint-900: rgb(12, 46, 38);\n    --red-700: rgb(155, 28, 28);\n}\n\nh1,\nh2,\nh3,\nh4,\nh5,\nh6,\np {\n    margin: 0;\n}\n\nbody {\n    align-items: center;\n    background-color: var(--gray-50);\n    box-sizing: border-box;\n    display: flex;\n    flex-direction: column;\n    font-family: \"Geist\", sans-serif;\n    justify-content: center;\n    margin: 0;\n    gap: 1em;\n    min-height: 100vh;\n    padding: 1.5em 1em;\n    color: var(--purple-900);\n}\n\nheader {\n    text-align: center;\n    max-width: 34em;\n}\n\nheader h1 {\n    font-family: \"Space Grotesk\", monospace;\n    font-weight: 700;\n}\n\n/* The two sections sit side by side while both fit at their natural width, and\n   drop into a single column once they don't. No media query: the sections\n   themselves decide when there is no longer room, so the widget reflows at\n   whatever width it happens to be given — including Web Lab's preview pane. */\nmain {\n    align-items: stretch;\n    display: flex;\n    flex-wrap: wrap;\n    gap: 1em;\n    justify-content: center;\n    width: 100%;\n}\n\n/* `stretch` above is what makes the two the same height; this is what lets\n   them wrap rather than squeeze. */\nmain > section {\n    flex: 1 1 420px;\n    max-width: 420px;\n}\n\n.row {\n    display: flex;\n    gap: 1em;\n}\n\nsection {\n    background-color: var(--gray-0);\n    border-radius: 0.5em;\n    box-sizing: border-box;\n    box-shadow: 0px 2px 2px rgba(0, 0, 0, 0.3);\n    padding: 1em;\n}\n\n.heading,\nh2 {\n    font-family: \"Space Grotesk\", monospace;\n    font-weight: bold;\n}\n\n/* Fields */\n\n.field {\n    display: flex;\n    flex-direction: column;\n    gap: 0.35em;\n}\n\n.field__label {\n    font-family: \"Space Grotesk\", monospace;\n    font-size: 0.875rem;\n    font-weight: bold;\n}\n\n.field__error {\n    color: var(--red-700);\n    font-size: 0.875rem;\n    /* Held open whether or not there is an error, so a message arriving mid-edit\n       doesn't shove the text box down the page. */\n    min-height: 1.4em;\n}\n\n/* Regex input section */\n\n.regex-input-section {\n    display: flex;\n    flex-direction: column;\n    gap: 0.5em;\n}\n\n/* The border is the only thing marking out where this field starts and stops,\n   so it carries 3:1 against the card behind it (WCAG 1.4.11) — darker than the\n   hairline borders elsewhere in the repo, and thinner to make up for it. */\n.regex-input {\n    align-items: center;\n    background-color: var(--gray-50);\n    border: 0.125rem solid var(--gray-500);\n    border-radius: 0.5rem;\n    display: flex;\n    gap: 0.15em;\n    padding: 0.5rem;\n}\n\n.regex-input:focus-within {\n    border-color: var(--purple-600);\n    outline: 3px solid var(--purple-900);\n    outline-offset: 2px;\n}\n\n/* The r\"…\" around the field is the Python this expression is standing in for.\n   It is decoration: the field's own label already names it. */\n.regex-input__affix {\n    color: var(--purple-500);\n    font-family: \"Geist Mono\", monospace;\n    font-size: 1.5rem;\n    user-select: none;\n}\n\n#regex-input {\n    background-color: transparent;\n    border: none;\n    color: inherit;\n    font-family: \"Geist Mono\", monospace;\n    font-size: 1.5rem;\n    min-width: 0;\n    outline: none;\n    padding: 0;\n    width: 100%;\n}\n",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
        "3": {
          "id": "3",
          "name": "tokenizer.js",
          "contents": "/**\n * tokenizer.js — the widget's model layer: a Python-flavored regular\n * expression in, tokens out. No DOM.\n *\n * Students write the expression they would hand to Python's `re`, so this file\n * translates the few places where Python and JavaScript spell the same idea\n * differently — named groups, `\\A` and `\\Z`, leading inline flags — and turns\n * down, in plain English, the handful of Python constructs JavaScript has no\n * answer for. Anything the two languages already agree on is passed through\n * untouched, so what a student types is what gets run.\n *\n * Matching follows `re.findall`: the expression is applied globally, and when\n * it captures groups the groups are the tokens — otherwise the whole match is.\n * Each token carries the slice of text it came from, so the highlighter and the\n * token list can never disagree about where a token starts and ends. Tokens are\n * returned in order and never overlap: with groups nested inside groups, only\n * the outermost is kept, since a character can't belong to two chips at once.\n *\n * Two divergences from `re` are worth knowing about. Zero-length matches are\n * dropped — `re.findall(r\"\\w*\", \"hi\")` counts the empty string at the end, but\n * an empty token is nothing to look at. And `\\w`, `\\d`, and `\\s` are ASCII\n * here, where Python 3 reads them as Unicode.\n */\n\n// A careless expression over a long paste can match more times than anyone\n// wants to read. Stop counting rather than lock up the page.\nconst MAX_MATCHES = 5000;\n\n// Python only honors these at the very start of an expression, and so do we.\nconst INLINE_FLAGS = /^\\(\\?([aiLmsux]+)\\)/;\n\nclass PatternError extends Error {}\n\n/**\n * Compile a Python-flavored expression.\n * Returns `{ regex }`, or `{ error }` with a message to show the student.\n */\nexport function compile(pattern) {\n  try {\n    const { body, flags } = takeInlineFlags(pattern);\n    const source = translate(body);\n    // `g` walks every match the way `findall` does; `d` reports where each\n    // group landed, which is the whole basis of the highlighting.\n    const base = `gd${flags}`;\n    // The `u` flag keeps astral characters — emoji — whole. It also rejects\n    // escapes Python is happy with, like `\\-` or a bare `{`, so ask for it\n    // first and settle for the looser mode when the expression needs it.\n    try {\n      return { regex: new RegExp(source, `${base}u`) };\n    } catch {\n      return { regex: new RegExp(source, base) };\n    }\n  } catch (error) {\n    return { error: readableMessage(error) };\n  }\n}\n\n/** Find every token `regex` picks out of `text`. */\nexport function tokenize(text, regex) {\n  const tokens = [];\n  let cursor = 0; // end of the last token kept, so tokens can't overlap\n  let matches = 0;\n\n  regex.lastIndex = 0;\n  let match;\n  while ((match = regex.exec(text)) !== null) {\n    // With capturing groups, `findall` hands back the groups; without any, the\n    // whole match.\n    const spans =\n      match.length > 1 ? match.indices.slice(1) : [match.indices[0]];\n\n    for (const span of spans) {\n      // An optional group that never took part has no span at all.\n      if (!span) continue;\n      const [start, end] = span;\n      if (end <= start) continue; // nothing to highlight, nothing to chip\n      if (start < cursor) continue; // nested inside a group already kept\n      tokens.push({ start, end, text: text.slice(start, end) });\n      cursor = end;\n    }\n\n    // A zero-length match leaves lastIndex where it was; step over it or exec\n    // returns the same match forever.\n    if (match.index === regex.lastIndex) regex.lastIndex += 1;\n    if (++matches >= MAX_MATCHES) break;\n  }\n\n  return tokens;\n}\n\n// Peel off leading `(?i)`-style flags, which Python reads as switches on the\n// whole expression. JavaScript has no inline form, so they become real flags.\nfunction takeInlineFlags(pattern) {\n  let body = pattern;\n  let flags = \"\";\n  let match;\n\n  while ((match = INLINE_FLAGS.exec(body)) !== null) {\n    for (const flag of match[1]) {\n      if (flag === \"x\") {\n        throw new PatternError('Verbose mode \"(?x)\" is not supported here.');\n      }\n      // a, L, and u pick Python's ASCII, locale, or Unicode reading of \\w and\n      // friends. JavaScript offers no such choice, so there is nothing to set.\n      if (\"ims\".includes(flag) && !flags.includes(flag)) flags += flag;\n    }\n    body = body.slice(match[0].length);\n  }\n\n  return { body, flags };\n}\n\n// Rewrite the Python-only spellings, and name the constructs we can't rewrite.\n// Walking the pattern rather than running replacements over it keeps escapes\n// and character classes honest: `\\(?P<x>` and `[(?P<x>]` are both just text.\nfunction translate(pattern) {\n  let source = \"\";\n  let inClass = false;\n\n  for (let i = 0; i < pattern.length; i++) {\n    const char = pattern[i];\n\n    if (char === \"\\\\\") {\n      const next = pattern[i + 1];\n      if (next === undefined) {\n        throw new PatternError(\"The expression ends with a lone backslash.\");\n      }\n      // Python anchors the whole string with \\A and \\Z; JavaScript spells\n      // those ^ and $, which mean the same thing while the m flag is off.\n      if (!inClass && next === \"A\") source += \"^\";\n      else if (!inClass && next === \"Z\") source += \"$\";\n      else source += char + next;\n      i += 1;\n      continue;\n    }\n\n    if (inClass) {\n      if (char === \"]\") inClass = false;\n      source += char;\n      continue;\n    }\n\n    if (char === \"[\") {\n      inClass = true;\n      source += char;\n      continue;\n    }\n\n    if (char === \"(\") {\n      const rest = pattern.slice(i);\n      const group = translateGroup(rest);\n      if (group !== null) {\n        source += group.source;\n        i += group.length - 1;\n        continue;\n      }\n    }\n\n    source += char;\n  }\n\n  if (inClass) {\n    throw new PatternError('A character class is missing its closing \"]\".');\n  }\n\n  return source;\n}\n\n// Handle the `(?…)` forms Python spells its own way. Returns null for every\n// group JavaScript already understands, so it falls through untouched.\nfunction translateGroup(rest) {\n  // Python names a group (?P<name>…); JavaScript writes (?<name>…).\n  let match = /^\\(\\?P<([^>]*)>/.exec(rest);\n  if (match) return { source: `(?<${match[1]}>`, length: match[0].length };\n\n  // Python refers back to a named group with (?P=name); JavaScript, \\k<name>.\n  match = /^\\(\\?P=([^)]*)\\)/.exec(rest);\n  if (match) return { source: `\\\\k<${match[1]}>`, length: match[0].length };\n\n  // (?#…) is a Python comment. JavaScript has none, so drop it entirely.\n  match = /^\\(\\?#[^)]*\\)/.exec(rest);\n  if (match) return { source: \"\", length: match[0].length };\n\n  if (/^\\(\\?>/.test(rest)) {\n    throw new PatternError('Atomic groups \"(?>…)\" are not supported here.');\n  }\n  if (/^\\(\\?\\(/.test(rest)) {\n    throw new PatternError(\n      'Conditional groups \"(?(1)…)\" are not supported here.',\n    );\n  }\n  if (INLINE_FLAGS.test(rest)) {\n    throw new PatternError(\n      'Flags like \"(?i)\" only work at the very start of the expression.',\n    );\n  }\n\n  return null;\n}\n\n// What the browser says about the common mistakes, and what to say instead: a\n// message that names the missing piece is worth more to someone learning this\n// than one that names the symptom.\nconst SUGGESTIONS = [\n  [/Unterminated group/, 'This expression is missing a closing \")\".'],\n  [/Unmatched '\\)'/, 'This expression has a \")\" with no \"(\" to open it.'],\n  [\n    /Nothing to repeat/,\n    'A repeat like \"*\", \"+\", or \"?\" has nothing in front of it to repeat.',\n  ],\n  [/Lone quantifier brackets/, 'A repeat like \"{2,3}\" is missing its \"}\".'],\n  [\n    /Range out of order/,\n    'A range like \"[z-a]\" runs backwards — put the earlier character first.',\n  ],\n  [/Invalid group/, 'This expression opens a group \"(?…\" it never finishes.'],\n  [\n    /Duplicate capture group name/,\n    \"Two groups in this expression share a name. Give each one its own.\",\n  ],\n];\n\n// Our own complaints are already written for a student. The browser's arrive as\n// \"Invalid regular expression: /…/: Nothing to repeat\", where the middle is the\n// translated source rather than what the student typed, so keep only the\n// reason — and swap in a better sentence where we have one.\nfunction readableMessage(error) {\n  if (error instanceof PatternError) return error.message;\n  const match = /^Invalid regular expression: .*?: (.*)$/s.exec(error.message);\n  const reason = match ? match[1] : error.message;\n  const suggestion = SUGGESTIONS.find(([pattern]) => pattern.test(reason));\n  return suggestion ? suggestion[1] : `${reason}.`;\n}\n",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
        "4": {
          "id": "4",
          "name": "app.js",
          "contents": "/**\n * app.js — the Tokenization controller.\n *\n * Holds the one piece of state neither component owns: the compiled expression.\n * Every edit to either field runs the same short path — compile what's in the\n * expression field, run it over what's in the text field, hand the tokens to\n * both the highlighting and the chip list — so the two views are always showing\n * the same result of the same expression.\n *\n * An expression that doesn't compile clears both views rather than leaving the\n * last good result sitting under a message that contradicts it. Half-typed\n * expressions are invalid too, which is the point: `[a-z` says what it's\n * missing while the student is still missing it.\n */\n\nimport { compile, tokenize } from \"./tokenizer.js\";\nimport { createHighlightedText } from \"./components/highlighted-text.js\";\nimport { createTokenList } from \"./components/token-list.js\";\n\nconst regexInput = document.getElementById(\"regex-input\");\nconst regexError = document.getElementById(\"regex-error\");\n\nconst highlightedText = createHighlightedText(\n  document.querySelector(\".highlighted-text\"),\n  { onInput: render },\n);\nconst tokenList = createTokenList(\n  document.querySelector(\".token-output-section\"),\n);\n\nfunction render() {\n  const pattern = regexInput.value;\n\n  if (pattern === \"\") {\n    setError(\"\");\n    clear(\"Write a regular expression to see its tokens.\");\n    return;\n  }\n\n  const { regex, error } = compile(pattern);\n  if (error) {\n    setError(error);\n    clear(\"Fix the expression to see its tokens.\");\n    return;\n  }\n\n  setError(\"\");\n  const tokens = tokenize(highlightedText.getText(), regex);\n  highlightedText.setTokens(tokens);\n  tokenList.render({ tokens });\n}\n\n// Nothing to tokenize. The reason goes where the tokens would have been, as\n// well as under the expression field, so it is wherever the student is looking.\nfunction clear(message) {\n  highlightedText.setTokens([]);\n  tokenList.render({ message });\n}\n\nfunction setError(message) {\n  regexError.textContent = message;\n  regexInput.setAttribute(\"aria-invalid\", message ? \"true\" : \"false\");\n}\n\nregexInput.addEventListener(\"input\", render);\n\nrender();\n",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
        "5": {
          "id": "5",
          "name": "token-list.css",
          "contents": "/* token-list.css — the Tokens section: count, chips, and the note that stands\n   in for the chips when there are none. */\n\n.token-output-section {\n    display: flex;\n    flex-direction: column;\n    gap: 0.75em;\n}\n\n.token-output-section__header {\n    align-items: baseline;\n    display: flex;\n    gap: 1em;\n    justify-content: space-between;\n}\n\n.token-count {\n    color: var(--purple-700);\n    font-size: 0.875rem;\n}\n\n/* Takes whatever height the section has left after the heading, so that beside\n   the text box the two sections come out level. The floor is what holds the\n   column layout up, where there is no row height to fill and nothing else here\n   has a height of its own — and either way the height never depends on how many\n   chips there are, which is what keeps the section still while a student types. */\n.token-list-area {\n    flex: 1;\n    min-height: 16em;\n    position: relative;\n}\n\n/* Out of flow, filling the area exactly. In flow, a tall list still counts\n   towards the section's intrinsic height even with `overflow-y: auto` on it —\n   which, once the sections shared a row, let three hundred chips stretch both\n   of them. Out of flow, the area's height depends only on the layout around it\n   and never on how much is in it. */\n.token-list {\n    /* Pack the rows against the top: a wrapping flex container stretches its\n       lines to fill itself by default, which would pull a lone chip down the\n       full height of the area. */\n    align-content: flex-start;\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.4em;\n    inset: 0;\n    list-style: none;\n    margin: 0;\n    overflow-y: auto;\n    padding: 0;\n    position: absolute;\n}\n\n/* The list takes a tab stop only while it scrolls (set by the component), so a\n   keyboard user can always reach the tokens the box is hiding. */\n.token-list:focus-visible {\n    outline: 3px solid var(--purple-900);\n    outline-offset: 2px;\n}\n\n.token {\n    background-color: var(--purple-0);\n    /* The same outline the matches wear in the text box, for the same two\n       reasons: it says where one token stops and the next starts without\n       relying on color, and it clears 3:1 against the card. */\n    border: 1px solid var(--purple-500);\n    border-radius: 0.25em;\n    font-family: \"Geist Mono\", monospace;\n    padding: 0.25em;\n    /* A token can be whitespace — `\\s+` and `.` both match a space — so keep it\n       rather than collapsing it, and hold the chip open around it. */\n    min-width: 0.6em;\n    /* `pre-wrap` rather than `pre`: a chip is a flex item and will be squeezed\n       narrower than its text when one token runs the width of the list, so the\n       text has to be free to reflow into the box it ends up with. `break-word`\n       covers the token that is long with no space in it to break at. */\n    overflow-wrap: break-word;\n    white-space: pre-wrap;\n}\n\n/* Sits where the first chip would be, so the reason there are no chips lands\n   where the student is already looking — and out of flow, so it moves nothing. */\n.token-list__note {\n    color: var(--purple-700);\n    font-size: 0.875rem;\n    left: 0;\n    position: absolute;\n    top: 0;\n}\n",
          "folderId": "1",
          "active": false,
          "type": "support"
        },
        "6": {
          "id": "6",
          "name": "highlighted-text.css",
          "contents": "/* highlighted-text.css — the text box and the highlight layer behind it.\n\n   The backdrop and the textarea have to break their lines in exactly the same\n   places, or the highlights drift off the words they belong to. Everything that\n   could make them differ — font, size, line height, padding, wrapping — is set\n   once, for both. The border and background live on the wrapper instead of on\n   the textarea, so the two layers have identical box metrics; the textarea's\n   own background stays transparent to let the backdrop through. */\n\n.highlighted-text {\n    --text-padding: 0.5em;\n    /* Room for the textarea's scrollbar, measured and set by the component. */\n    --gutter: 0px;\n\n    background-color: var(--gray-50);\n    /* 3:1 against the card behind it: this border is the only thing marking out\n       where the text box starts and stops. */\n    border: 0.125rem solid var(--gray-500);\n    border-radius: 0.5rem;\n    overflow: hidden;\n    position: relative;\n}\n\n.highlighted-text:focus-within {\n    border-color: var(--purple-600);\n    outline: 3px solid var(--purple-900);\n    outline-offset: 2px;\n}\n\n.highlighted-text__backdrop,\n#regex-text {\n    box-sizing: border-box;\n    font-family: \"Geist Mono\", monospace;\n    font-size: 1rem;\n    letter-spacing: normal;\n    line-height: 1.6;\n    margin: 0;\n    overflow-wrap: break-word;\n    padding: var(--text-padding);\n    tab-size: 4;\n    white-space: pre-wrap;\n    width: 100%;\n}\n\n.highlighted-text__backdrop {\n    color: var(--purple-900);\n    inset: 0;\n    overflow: hidden;\n    padding-right: calc(var(--text-padding) + var(--gutter));\n    /* Clicks, drags, and text selection all belong to the textarea on top. */\n    pointer-events: none;\n    position: absolute;\n    user-select: none;\n}\n\n#regex-text {\n    background-color: transparent;\n    border: none;\n    /* Transparent glyphs: the backdrop is drawing this same text, in color. The\n       caret has to be painted back in by hand, or it would vanish too — and in\n       a mid-tone, because it crosses both the pale background and the black\n       fill of a match and has to stay visible on either. */\n    caret-color: var(--purple-500);\n    color: transparent;\n    -webkit-text-fill-color: transparent;\n    display: block;\n    height: 12.5em;\n    outline: none;\n    position: relative;\n    resize: none;\n}\n\n/* Matched runs invert to white on black — 19.8:1, the most contrast this widget\n   has to give. It is also a difference in luminance rather than hue, so it\n   survives greyscale, color blindness, and a washed-out projector, none of\n   which a tint can be relied on for. */\n.highlighted-text__match {\n    /* A token that wraps across two lines is drawn as two fragments; clone the\n       fill so each one is rounded off rather than left open at the break. */\n    -webkit-box-decoration-break: clone;\n    box-decoration-break: clone;\n    background-color: transparent;\n    background-repeat: no-repeat;\n    background-size: calc(100% - 0.08em) 100%;\n    color: var(--gray-0);\n}\n\n/* One fill for every token, not two alternating ones: the sliver of background\n   left unpainted on the right of each run (above) is what says where one token\n   stops and the next starts, so neighbors no longer have to differ in shade to\n   be told apart. The two classes stay so they can diverge again if they need\n   to. */\n.highlighted-text__match--even {\n    background-image: linear-gradient(var(--gray-950), var(--gray-950));\n}\n\n.highlighted-text__match--odd {\n    background-image: linear-gradient(var(--gray-950), var(--gray-950));\n}\n\n/* In a forced-colors theme the backdrop can't be trusted — its fills are\n   overridden and its text would print over the textarea's. Drop it and hand the\n   textarea its own glyphs back; the chips below still list every token. */\n@media (forced-colors: active) {\n    .highlighted-text__backdrop {\n        display: none;\n    }\n\n    #regex-text {\n        color: CanvasText;\n        -webkit-text-fill-color: CanvasText;\n    }\n}\n",
          "folderId": "1",
          "active": false,
          "type": "support"
        },
        "7": {
          "id": "7",
          "name": "highlighted-text.js",
          "contents": "/**\n * highlighted-text.js — the editable text, with its tokens highlighted.\n *\n * A textarea cannot paint parts of its own value, so the highlights live on a\n * div sitting directly behind it. The div draws the text and the colored spans;\n * the textarea on top has transparent glyphs and keeps everything that makes a\n * textarea worth using — the caret, selection, undo, and a real labeled form\n * control for screen reader and keyboard users.\n *\n * The illusion only holds while the two lay out identically, so they share\n * every property that affects line breaking (see highlighted-text.css), the\n * backdrop is padded to leave room for the textarea's scrollbar, and scrolling\n * one scrolls the other.\n *\n * The backdrop is aria-hidden. It is a picture of the textarea's value, which\n * assistive technology already reads from the textarea itself.\n */\n\nconst ESCAPES = { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\" };\n\nexport function createHighlightedText(container, { onInput } = {}) {\n  const textarea = container.querySelector(\"textarea\");\n  const backdrop = container.querySelector(\".highlighted-text__backdrop\");\n\n  // Set by the controller after every edit; the backdrop is redrawn from the\n  // textarea's current value and these, and from nothing else.\n  let tokens = [];\n\n  function render() {\n    const text = textarea.value;\n    let html = \"\";\n    let cursor = 0;\n\n    tokens.forEach((token, index) => {\n      html += toMarkup(text.slice(cursor, token.start));\n      // Neighboring tokens alternate shade, so `\\w` on a word reads as five\n      // tokens rather than one long stripe.\n      const shade = index % 2 === 0 ? \"even\" : \"odd\";\n      html += `<span class=\"highlighted-text__match highlighted-text__match--${shade}\">${toMarkup(\n        text.slice(token.start, token.end),\n      )}</span>`;\n      cursor = token.end;\n    });\n\n    html += toMarkup(text.slice(cursor));\n    // A textarea shows one more empty line for a trailing newline; `pre-wrap`\n    // in a div does not. Pad the backdrop so the two scroll to the same depth.\n    backdrop.innerHTML = `${html}\\n`;\n\n    syncGutter();\n    syncScroll();\n  }\n\n  // A vertical scrollbar takes width away from the textarea's text. The\n  // backdrop has no scrollbar of its own, so give it that width back as\n  // padding — without it the two wrap at different words and every highlight\n  // below the first wrap slides off the text it belongs to.\n  function syncGutter() {\n    const gutter = textarea.offsetWidth - textarea.clientWidth;\n    container.style.setProperty(\"--gutter\", `${Math.max(0, gutter)}px`);\n  }\n\n  // Setting innerHTML resets the backdrop to the top, so this runs after every\n  // render as well as on the textarea's own scroll events.\n  function syncScroll() {\n    backdrop.scrollTop = textarea.scrollTop;\n    backdrop.scrollLeft = textarea.scrollLeft;\n  }\n\n  textarea.addEventListener(\"input\", () => onInput?.(textarea.value));\n  textarea.addEventListener(\"scroll\", syncScroll);\n  // The textarea's content box shrinks the moment a scrollbar appears, and\n  // again when the window narrows or the monospace font finally loads. Any of\n  // those needs the gutter re-measured, and none of them is an edit.\n  new ResizeObserver(syncGutter).observe(textarea);\n\n  render();\n\n  return {\n    getText: () => textarea.value,\n    setTokens(next) {\n      tokens = next;\n      render();\n    },\n  };\n}\n\nfunction toMarkup(text) {\n  return text.replace(/[&<>]/g, (char) => ESCAPES[char]);\n}\n",
          "folderId": "1",
          "active": false,
          "type": "support"
        },
        "8": {
          "id": "8",
          "name": "token-list.js",
          "contents": "/**\n * token-list.js — the tokens the expression found, as chips.\n *\n * Owns the whole Tokens section: the running count, the chips themselves, and\n * the note that stands in for them when there is nothing to show. An ordered\n * list, because the order is the point — these are the pieces the text was cut\n * into, in the order they appear in it.\n *\n * The count and the note are both polite live regions, so a student editing the\n * expression hears the new total — or hears why there isn't one — without\n * having to go looking. The chips carry the same information as text, which is\n * what keeps the colored highlighting in the text box from being the only way\n * to tell where one token ends and the next begins.\n *\n * A short expression over a long text can match thousands of times. Past a cap\n * the list stops building chips and the count says so: a wall of chips teaches\n * nobody anything, and building one per match on every keystroke would make\n * typing feel broken.\n */\n\nconst MAX_CHIPS = 400;\nconst WHITESPACE_NAMES = { \" \": \"space\", \"\\n\": \"newline\", \"\\t\": \"tab\" };\n\nexport function createTokenList(container) {\n  const count = container.querySelector(\".token-count\");\n  const list = container.querySelector(\".token-list\");\n  const note = container.querySelector(\".token-list__note\");\n  const template = document.getElementById(\"token-template\");\n\n  /**\n   * Show `tokens`, or `message` on its own when there are no tokens to show\n   * (no expression yet, or an expression that doesn't compile).\n   */\n  function render({ tokens = [], message = \"\" } = {}) {\n    const shown = message ? [] : tokens.slice(0, MAX_CHIPS);\n\n    const chips = shown.map((token) => {\n      const chip = template.content.firstElementChild.cloneNode(true);\n      chip.textContent = token.text;\n      // A chip made of nothing but whitespace reads out as silence, so say in\n      // words what it holds.\n      const name = whitespaceName(token.text);\n      if (name) chip.setAttribute(\"aria-label\", name);\n      return chip;\n    });\n    list.replaceChildren(...chips);\n\n    count.textContent = message ? \"\" : countText(tokens.length, shown.length);\n    note.textContent = message || (tokens.length === 0 ? \"No matches.\" : \"\");\n\n    // Only a list that actually scrolls should take a tab stop; an unreachable\n    // one is just a stop on the way to somewhere else.\n    const scrolls = list.scrollHeight > list.clientHeight;\n    if (scrolls) list.setAttribute(\"tabindex\", \"0\");\n    else list.removeAttribute(\"tabindex\");\n  }\n\n  // Start from the empty state rather than whatever the markup happens to hold.\n  render();\n\n  return { render };\n}\n\nfunction whitespaceName(text) {\n  if (text.trim() !== \"\") return \"\";\n  const [first] = text;\n  const name = WHITESPACE_NAMES[first];\n  // A mixed run — a newline and the indent after it — is more than a count.\n  if (!name || [...text].some((char) => char !== first)) return \"whitespace\";\n  return `${text.length} ${name}${text.length === 1 ? \"\" : \"s\"}`;\n}\n\n// The count doubles as the notice when the list is capped: it already has a\n// fixed place in the header, so saying it there costs nothing in layout.\nfunction countText(total, shown) {\n  const word = total === 1 ? \"token\" : \"tokens\";\n  return shown < total\n    ? `First ${shown} of ${total} ${word}`\n    : `${total} ${word}`;\n}\n",
          "folderId": "1",
          "active": true,
          "type": "support"
        }
      },
      "openFiles": [
        "1",
        "2",
        "3",
        "4",
        "5",
        "6",
        "7",
        "8"
      ]
    }
  },
  "published": true,
  "audit_log": "[{\"changed_at\":\"2026-11-02 19:55:45 +0000\",\"changed\":[\"require_edit_to_continue\"],\"changed_by_id\":23870,\"changed_by_email\":\"carter.zenke@code.org\"},{\"changed_at\":\"2026-11-02 19:56:10 +0000\",\"changed\":[\"require_edit_to_continue\",\"widget_view\",\"ai_tutor_prompt_settings\"],\"changed_by_id\":23870,\"changed_by_email\":\"carter.zenke@code.org\"},{\"changed_at\":\"2026-11-02 19:58:06 +0000\",\"changed\":[],\"changed_by_id\":23870,\"changed_by_email\":\"carter.zenke@code.org\"},{\"changed_at\":\"2026-11-02 19:58:23 +0000\",\"changed\":[\"start_sources\"],\"changed_by_id\":23870,\"changed_by_email\":\"carter.zenke@code.org\"}]"
}]]></config>
