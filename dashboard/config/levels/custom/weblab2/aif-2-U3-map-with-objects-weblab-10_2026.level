        }
      },
      "files": {
        "1": {
          "id": "1",
          "name": "script.js",
          "contents": "const travelDeals = [\n  {\n    destination: \"Paris Weekend\",\n    image: \"images/paris.png\",\n    duration: \"3 nights\",\n    price: \"$499\"\n  },\n  {\n    destination: \"Denver Adventure\",\n    image: \"images/denver.png\",\n    duration: \"4 nights\",\n    price: \"$389\"\n  },\n  {\n    destination: \"Miami Beach Trip\",\n    image: \"images/miami.png\",\n    duration: \"2 nights\",\n    price: \"$299\"\n  }\n];\n\ntravelDeals.map(deal => {\n  createCard(deal.image, deal.destination, deal.duration, deal.price);\n});",
          "folderId": "0",
          "active": true
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  font-family: Inter, Arial, sans-serif;\n  background: #f3f4f6;\n  color: #1f2937;\n}\n\n/* App Shell */\n.app {\n  max-width: 480px;\n  margin: 0 auto;\n  min-height: 100vh;\n  background: #ffffff;\n}\n\n/* Header */\n.app-header {\n  padding: 24px 20px 16px;\n  border-bottom: 1px solid #e5e7eb;\n}\n\n.eyebrow {\n  margin: 0 0 4px;\n  font-size: 0.8rem;\n  text-transform: uppercase;\n  color: #6b7280;\n}\n\n.app-header h1 {\n  margin: 0;\n  font-size: 1.8rem;\n  font-weight: 700;\n}\n\n.subtitle {\n  margin: 6px 0 0;\n  font-size: 0.95rem;\n  color: #6b7280;\n}\n\n/* Section */\n.deals-section {\n  padding: 20px;\n}\n\n.deals-section h2 {\n  margin: 0 0 12px;\n  font-size: 1.1rem;\n  font-weight: 700;\n}\n\n/* Card Container */\n.deal-container {\n  display: flex;\n  flex-direction: column;\n  gap: 16px;\n}\n\n/* Deal Card */\n.deal-card {\n  border-radius: 16px;\n  overflow: hidden;\n  background: #ffffff;\n  border: 1px solid #e5e7eb;\n}\n\n/* Image */\n.deal-image {\n  width: 100%;\n  height: 160px;\n  object-fit: cover;\n  display: block;\n}\n\n/* Content */\n.deal-content {\n  padding: 14px 16px;\n}\n\n.deal-title {\n  margin: 0 0 6px;\n  font-size: 1.1rem;\n  font-weight: 700;\n}\n\n.deal-meta {\n  margin: 0;\n  font-size: 0.9rem;\n  color: #6b7280;\n}\n\n.deal-price {\n  margin-top: 8px;\n  font-size: 1rem;\n  font-weight: 600;\n  color: #111827;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "helpers.js",
          "contents": "let cardCount = 0;\n\nconst createCard = (imageSrc, destination, duration, price) => {\n  const container = document.getElementById(\"dealContainer\");\n\n  const card = document.createElement(\"div\");\n  card.className = \"deal-card\";\n  card.id = \"card\" + cardCount;\n\n  const image = document.createElement(\"img\");\n  image.className = \"deal-image\";\n  image.id = \"image\" + cardCount;\n  image.src = imageSrc;\n  image.alt = destination;\n\n  const content = document.createElement(\"div\");\n  content.className = \"deal-content\";\n  content.id = \"content\" + cardCount;\n\n  const title = document.createElement(\"h3\");\n  title.className = \"deal-title\";\n  title.id = \"title\" + cardCount;\n  title.textContent = destination;\n\n  const meta = document.createElement(\"p\");\n  meta.className = \"deal-meta\";\n  meta.id = \"meta\" + cardCount;\n  meta.textContent = duration;\n\n  const priceEl = document.createElement(\"p\");\n  priceEl.className = \"deal-price\";\n  priceEl.id = \"price\" + cardCount;\n  priceEl.textContent = price;\n\n  content.appendChild(title);\n  content.appendChild(meta);\n  content.appendChild(priceEl);\n\n  card.appendChild(image);\n  card.appendChild(content);\n\n  container.appendChild(card);\n\n  cardCount++;\n};",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Travel Deals</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n  </head>\n  <body>\n    <main class=\"app\">\n      <header class=\"app-header\">\n        <p class=\"eyebrow\">Weekend Explorer</p>\n        <h1>Travel Deals</h1>\n        <p class=\"subtitle\">Find quick trips that fit your budget.</p>\n      </header>\n\n      <section class=\"deals-section\">\n        <h2>Featured Deals</h2>\n        <div id=\"dealContainer\" class=\"deal-container\"></div>\n      </section>\n    </main>\n\n    <script src=\"helpers.js\"></script>\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "folderId": "0",
          "active": false
        },
