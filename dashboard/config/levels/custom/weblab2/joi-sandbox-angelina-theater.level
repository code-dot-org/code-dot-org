      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Python Lab — Theater</title>\n<link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css\">\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js\"></script>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/python/python.min.js\"></script>\n<style>\n  :root{\n    --purple-primary:#4C42CF;\n    --purple-dark:#1F1976;\n    --purple-mid:#ACA8EA;\n    --purple-light:#E4E2F8;\n    --panel-border:#dde1e6;\n    --panel-header-bg:#f4f5f7;\n    --text-dark:#1c1e21;\n    --text-mid:#5b6270;\n  }\n  *{ box-sizing:border-box; }\n  html,body{ height:100%; }\n  body{\n    margin:0;\n    font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n    background:#eceef1;\n    color:var(--text-dark);\n  }\n\n  /* ---------- top bar ---------- */\n  .topbar{\n    background:var(--purple-primary);\n    padding:10px 20px;\n    display:flex;\n    align-items:center;\n    gap:14px;\n    height:56px;\n  }\n  .topbar img.logo{ height:22px; display:block; }\n  /* levelbuilder-tag removed per request */\n\n  /* ---------- app layout ---------- */\n  .app{\n    display:flex;\n    height:calc(100% - 56px);\n    padding:12px;\n    gap:0;\n  }\n\n  .panel{\n    background:#fff;\n    border:1px solid var(--panel-border);\n    overflow:hidden;\n    display:flex;\n    flex-direction:column;\n  }\n  .panel-label{\n    text-align:center;\n    font-size:11px;\n    font-weight:800;\n    letter-spacing:.08em;\n    color:var(--text-mid);\n    padding:10px 0;\n    border-bottom:1px solid var(--panel-border);\n    background:#fff;\n    flex-shrink:0;\n  }\n\n  /* Resize handles */\n  .resize-handle{ flex-shrink:0; background:transparent; position:relative; z-index:2; }\n  .resize-handle.v{ width:12px; cursor:col-resize; margin:0 -6px; }\n  .resize-handle.h{ height:12px; cursor:row-resize; margin:-6px 0; }\n  .resize-handle.v::after{\n    content:''; position:absolute; left:5px; top:0; bottom:0; width:2px;\n    background:var(--panel-border);\n  }\n  .resize-handle.h::after{\n    content:''; position:absolute; top:5px; left:0; right:0; height:2px;\n    background:var(--panel-border);\n  }\n  .resize-handle:hover::after, .resize-handle.dragging::after{ background:var(--purple-mid); }\n\n  /* Files panel */\n  .files-panel{ width:200px; flex-shrink:0; border-radius:10px 0 0 10px; }\n  .files-header{\n    display:flex; align-items:center; justify-content:space-between;\n    padding:9px 10px;\n    font-size:11px; font-weight:800; letter-spacing:.05em; text-transform:uppercase;\n    color:var(--text-mid);\n    border-bottom:1px solid var(--panel-border);\n  }\n  .add-file-menu-wrap{ position:relative; }\n  .add-file-menu{\n    display:none;\n    position:absolute;\n    top:26px; right:0;\n    background:#fff;\n    border:1px solid var(--panel-border);\n    border-radius:10px;\n    box-shadow:0 8px 24px rgba(0,0,0,.16);\n    padding:6px;\n    min-width:180px;\n    z-index:30;\n  }\n  .add-file-menu.open{ display:block; }\n  .add-file-menu-item{\n    display:flex; align-items:center; gap:10px;\n    width:100%;\n    padding:9px 10px;\n    border:none; background:transparent;\n    font-size:13px; color:#1c1e21;\n    text-align:left;\n    border-radius:6px;\n    cursor:pointer;\n  }\n  .add-file-menu-item:hover{ background:#f4f4f8; }\n  .add-file-menu-item .menu-item-icon{\n    width:16px; height:16px; display:flex; align-items:center; justify-content:center;\n    color:#5b6270; flex-shrink:0;\n  }\n  .add-file-menu-item .menu-item-icon svg{ width:100%; height:100%; }\n  .icon-square-btn{\n    width:19px; height:19px; border-radius:5px; border:none;\n    background:#eef0f2; color:#5b6270;\n    cursor:pointer; display:flex; align-items:center; justify-content:center;\n    padding:0;\n  }\n  .icon-square-btn.primary{ background:var(--purple-primary); color:#fff; }\n  .icon-square-btn:hover{ filter:brightness(0.95); }\n  .icon-square-btn svg{ width:11px; height:11px; }\n  .file-rows{ flex:1; overflow-y:auto; padding:4px 0; }\n  .file-row{\n    position:relative;\n    display:flex; align-items:center; gap:6px;\n    padding:6px 8px 6px 10px;\n    font-size:12px; color:#4b5058;\n    cursor:pointer;\n  }\n  .file-row:hover{ background:#f4f4f8; }\n  .file-row.active{ background:var(--purple-light); color:var(--purple-dark); font-weight:600; box-shadow: inset 2px 0 0 var(--purple-primary); }\n  .file-row .file-icon{ width:16px; flex-shrink:0; font-size:13px; line-height:1; display:flex; align-items:center; justify-content:center; }\n  .file-row .file-name{ flex:1; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .file-row .file-actions{ display:flex; gap:1px; opacity:0; flex-shrink:0; }\n  .file-row:hover .file-actions{ opacity:1; }\n  .file-action-btn{\n    width:18px; height:18px; border:none; background:transparent; color:#9aa0a8;\n    cursor:pointer; display:flex; align-items:center; justify-content:center; border-radius:4px;\n    padding:3px;\n  }\n  .file-action-btn:hover{ background:#e5e7ea; color:#4b5058; }\n  .file-action-btn svg{ width:100%; height:100%; }\n  .rename-input{\n    flex:1; font-size:12px; padding:2px 5px; border:1px solid var(--purple-primary);\n    border-radius:4px; outline:none; font-family:inherit; min-width:0;\n  }\n  .rename-input.invalid{ border-color:#e0463f; }\n  .flash-msg{\n    position:absolute; right:8px; top:-24px; z-index:5;\n    background:#26282c; color:#fff; font-size:10px; padding:3px 7px; border-radius:4px;\n    white-space:nowrap; animation:fadeOut 1.6s forwards; pointer-events:none;\n  }\n  @keyframes fadeOut{ 0%{opacity:1;} 70%{opacity:1;} 100%{opacity:0;} }\n\n  /* Workspace column */\n  .workspace-col{\n    flex:1; min-width:0;\n    display:flex; flex-direction:column;\n    border:1px solid var(--panel-border); border-left:none;\n    border-radius:0 10px 10px 0;\n    overflow:hidden;\n    background:#fff;\n  }\n  .workspace-col .panel-label{ border-radius:0 10px 0 0; }\n\n  /* editor-panel rule removed: editor now lives in .code-column, sized by main-row */\n  .tab-strip{\n    display:flex;\n    background:#f7f8fa;\n    border-bottom:1px solid var(--panel-border);\n    overflow-x:auto;\n    flex-shrink:0;\n  }\n  .tab{\n    padding:8px 8px 8px 14px;\n    font-size:12.5px;\n    color:#6b7280;\n    border-right:1px solid var(--panel-border);\n    display:flex;\n    align-items:center;\n    gap:8px;\n    background:#eef0f2;\n    cursor:pointer;\n    white-space:nowrap;\n    flex-shrink:0;\n  }\n  .tab.active{\n    background:#fff;\n    color:#1c1e21;\n    font-weight:600;\n    box-shadow: inset 0 -2px 0 var(--purple-primary);\n  }\n  .tab .tab-icon{ width:12px; height:12px; color:#4b8bbe; display:flex; flex-shrink:0; }\n  .tab .tab-close{\n    width:16px; height:16px; border:none; background:transparent; color:#9aa0a8;\n    border-radius:4px; display:flex; align-items:center; justify-content:center; cursor:pointer;\n    flex-shrink:0; padding:2px;\n  }\n  .tab .tab-close:hover{ background:#e2e4e8; color:#4b5058; }\n  .tab .tab-close svg{ width:100%; height:100%; }\n\n  .editor-host{ flex:1; min-height:0; position:relative; }\n  .editor-host .CodeMirror{ height:100%; font:12.5px/1.6 \"SFMono-Regular\",Consolas,\"Liberation Mono\",monospace; }\n  #codeFallback{\n    width:100%; height:100%; border:none; outline:none; resize:none;\n    padding:12px 14px; font:12.5px/1.6 \"SFMono-Regular\",Consolas,monospace; color:#1c1e21;\n  }\n  .empty-editor-msg{\n    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;\n    color:#a7acb3; font-size:13px;\n  }\n\n  /* Main row: code (left, flexible) + preview (right, fixed-ish width) */\n  .main-row{ flex:1; min-height:120px; display:flex; min-width:0; }\n  .code-column{ flex:1; min-width:280px; display:flex; flex-direction:column; min-height:0; }\n  .preview-panel{ width:420px; flex-shrink:0; min-width:220px; }\n  .console-panel{ height:180px; flex-shrink:0; min-height:100px; border-top:1px solid var(--panel-border); }\n  .panel-header{\n    background:var(--panel-header-bg);\n    border-bottom:1px solid var(--panel-border);\n    padding:8px 12px;\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    flex-shrink:0;\n  }\n  .panel-header .label{\n    font-size:11px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:var(--text-mid);\n  }\n  .header-icon-btn{\n    width:22px; height:22px; border:none; background:transparent; color:#9aa0a8;\n    display:flex; align-items:center; justify-content:center; border-radius:5px; cursor:pointer;\n  }\n  .header-icon-btn:hover{ background:#eef0f2; color:#5b6270; }\n  .run-btn{\n    background:var(--purple-primary);\n    border:none;\n    color:#fff;\n    font-weight:700;\n    font-size:12px;\n    padding:7px 16px;\n    border-radius:6px;\n    display:flex;\n    align-items:center;\n    gap:7px;\n    cursor:pointer;\n  }\n  .run-btn:hover{ filter:brightness(1.08); }\n  .run-btn:active{ transform:translateY(1px); }\n\n  .preview-body{\n    flex:1;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    justify-content:center;\n    gap:10px;\n    background:#24262b;\n    padding:16px;\n    min-height:0;\n  }\n  canvas#stage{\n    background:#000;\n    border-radius:6px;\n    box-shadow:0 6px 24px rgba(0,0,0,.45);\n    max-width:100%; max-height:100%;\n  }\n  .speed-row{\n    display:flex; align-items:center; gap:10px;\n    color:#8b909a;\n    width:100%;\n    max-width:280px;\n  }\n  .speed-row .emoji-icon{ font-size:16px; line-height:1; flex-shrink:0; }\n  .speed-row input[type=range]{ flex:1; accent-color:var(--purple-mid); }\n\n  .console-panel .console-body{\n    flex:1;\n    background:#1a1b1e;\n    color:#d7dbe0;\n    font:11.5px/1.55 \"SFMono-Regular\",Consolas,monospace;\n    padding:10px 12px;\n    overflow-y:auto;\n  }\n  .console-body .line{ white-space:pre-wrap; margin-bottom:2px; }\n  .console-body .line.sys{ color:#ff8a1e; }\n  .console-body .line.sim{ color:#7ea8ff; }\n  .console-body .line.echo{ color:#8be08b; }\n  .console-input-row{\n    display:flex; align-items:center; gap:7px;\n    margin:2px 0 4px;\n  }\n  .console-input-caret{ color:#8be08b; font-weight:700; }\n  .console-input-field{\n    flex:1;\n    background:#26282e;\n    border:1px solid #4C42CF;\n    border-radius:5px;\n    color:#e8eaf0;\n    font:11.5px/1.55 \"SFMono-Regular\",Consolas,monospace;\n    padding:4px 8px;\n    outline:none;\n  }\n  .console-input-field:focus{ border-color:#ACA8EA; box-shadow:0 0 0 2px rgba(76,66,207,.25); }\n</style>\n</head>\n<body>\n\n  <div class=\"topbar\">\n    <img class=\"logo\" src=\"data:image/png;base64,\" alt=\"CodeAI\">\n    <div class=\"spacer\"></div>\n  </div>\n  <div class=\"app\">\n    <div class=\"panel files-panel\" id=\"filesPanel\">\n      <div class=\"files-header\">\n        <span>Files</span>\n        <div class=\"add-file-menu-wrap\">\n          <button class=\"icon-square-btn primary\" id=\"addMenuBtn\" title=\"Add\">+</button>\n          <div class=\"add-file-menu\" id=\"addFileMenu\">\n            <button class=\"add-file-menu-item\" id=\"menuNewFile\">\n              <span class=\"menu-item-icon\">\n                <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M11 5h2v6h6v2h-6v6h-2v-6H5v-2h6V5Z\"/></svg>\n              </span>\n              New File\n            </button>\n            <button class=\"add-file-menu-item\" id=\"menuUploadImage\">\n              <span class=\"menu-item-icon\">\n                <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M20 5H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h9v-2H5V8l4 4 3-3 4 4V6a1 1 0 0 0-1-1Zm2 9h-3v3h-2v-3h-3v-2h3v-3h2v3h3v2Z\"/></svg>\n              </span>\n              Upload File\n            </button>\n          </div>\n        </div>\n      </div>\n      <div class=\"file-rows\" id=\"fileRows\"></div>\n      <input type=\"file\" id=\"imageUploadInput\" accept=\"image/*,audio/*,video/*\" multiple style=\"display:none\">\n    </div>\n    <div class=\"resize-handle v\" id=\"resizeFiles\"></div>\n\n    <div class=\"workspace-col\">\n      <div class=\"panel-label\">WORKSPACE</div>\n      <div class=\"main-row\" id=\"mainRow\">\n        <div class=\"code-column\" id=\"codeColumn\">\n          <div class=\"tab-strip\" id=\"tabStrip\"></div>\n          <div class=\"editor-host\" id=\"editorHost\">\n            <div id=\"cmHost\" style=\"height:100%;\"></div>\n            <textarea id=\"codeFallback\" spellcheck=\"false\" style=\"display:none;\"></textarea>\n          </div>\n        </div>\n        <div class=\"resize-handle v\" id=\"resizeCodePreview\"></div>\n        <div class=\"panel preview-panel\" id=\"previewPanel\">\n          <div class=\"panel-header\">\n            <button class=\"run-btn\" id=\"runBtn\">\n              ▶️ Run\n            </button>\n            <span class=\"label\">Preview</span>\n            <button class=\"header-icon-btn\" title=\"Reset\">\n              🔄\n            </button>\n          </div>\n          <div class=\"preview-body\">\n            <canvas id=\"stage\" width=\"400\" height=\"400\"></canvas>\n            <div class=\"speed-row\">\n              <span class=\"emoji-icon\" title=\"Slow\">🐢</span>\n              <input type=\"range\" id=\"speedSlider\" min=\"0\" max=\"100\" value=\"50\">\n              <span class=\"emoji-icon\" title=\"Fast\">🐇</span>\n            </div>\n          </div>\n        </div>\n      </div>\n      <div class=\"resize-handle h\" id=\"resizeConsole\"></div>\n      <div class=\"panel console-panel\" id=\"consolePanel\">\n        <div class=\"panel-header\">\n          <span class=\"label\">Console</span>\n          <button class=\"header-icon-btn\" id=\"clearConsoleBtn\" title=\"Clear console\">\n            🗑️\n          </button>\n        </div>\n        <div class=\"console-body\" id=\"console\">\n          <div class=\"line sys\">Ready. Click Run to play the scene.</div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n<script>\n(function(){\n  const runBtn = document.getElementById('runBtn');\n  const consoleEl = document.getElementById('console');\n  const canvas = document.getElementById('stage');\n  const ctx = canvas.getContext('2d');\n  const W = canvas.width, H = canvas.height;\n  const fileRowsEl = document.getElementById('fileRows');\n  const tabStripEl = document.getElementById('tabStrip');\n  const addMenuBtn = document.getElementById('addMenuBtn');\n  const addFileMenu = document.getElementById('addFileMenu');\n  const menuNewFile = document.getElementById('menuNewFile');\n  const menuUploadImage = document.getElementById('menuUploadImage');\n  const imageUploadInput = document.getElementById('imageUploadInput');\n  const clearConsoleBtn = document.getElementById('clearConsoleBtn');\n  const speedSlider = document.getElementById('speedSlider');\n\n  const DEFAULT_MAIN_PY = `scene = Scene()\n\n# ---- Variables & data types ----\nmood = \"main character energy\"   # string\nvibe_score = 97                  # int\nbg_color = \"#1B1035\"              # string (hex color)\n\nscene.clear(bg_color)\n\n# ---- List: a rotating aesthetic color palette ----\npalette = [\"#FF6EC7\", \"#7CFFCB\", \"#FFD36E\", \"#6EC7FF\"]\n\n# ---- Array: fixed coordinates for a 5-point star sticker ----\nstar_points = [200, 50, 215, 85, 253, 88, 224, 112, 234, 149, 200, 128, 166, 149, 176, 112, 147, 88, 185, 85]\n\n# ---- Reusable function: stamp a sticker anywhere, any shape, any color ----\ndef stamp_sticker(x, y, sides, radius, color):\n    scene.set_fill_color(color)\n    scene.remove_stroke_color()\n    scene.draw_regular_polygon(x, y, sides, radius)\n\n# Centerpiece: the array drawn once as a big gold star\nscene.set_fill_color(\"gold\")\nscene.remove_stroke_color()\nscene.draw_shape(star_points, True)\n\n# Scatter stickers across the bottom using the list + the reusable function\nx = 60\nfor color in palette:\n    stamp_sticker(x, 320, 5, 26, color)\n    x = x + 90\n\n# ---- Caption ----\nscene.set_text_style(Font.SANS, FontStyle.BOLD)\nscene.set_text_color(\"white\")\nscene.set_text_height(26)\nscene.draw_text(mood, 40, 200)\n\n# Your vibe score becomes a little musical sting\nscene.play_note(vibe_score, 0.4)\nscene.pause(0.4)\nscene.play_note(vibe_score, 0.2)\n\nTheater.play_scenes(scene)`;\n\n  // ---------- sample project files ----------\n  const SAMPLE_1_NAME_TAG_PY = `scene = Scene()\n\n# ============================================\n#  NAME TAG\n#  Concepts: variables, data types, draw_text\n# ============================================\n\n# ---- Variables hold pieces of data ----\nname = \"Jordan\"              # string\ngrade = 10                   # int\nlucky_number = 7             # int\ncard_color = \"#4C42CF\"       # string (hex color)\n\nscene.clear(card_color)\n\n# ---- The badge card ----\nscene.set_fill_color(\"white\")\nscene.remove_stroke_color()\nscene.draw_rectangle(40, 100, 320, 200)\n\n# ---- A little accent stripe on top of the card ----\nscene.set_fill_color(\"#FFD36E\")\nscene.draw_rectangle(40, 100, 320, 18)\n\n# ---- Text uses the variables above ----\nscene.set_text_style(Font.SANS, FontStyle.BOLD)\nscene.set_text_color(\"#1F1976\")\nscene.set_text_height(20)\nscene.draw_text(\"HELLO, MY NAME IS\", 70, 140)\n\nscene.set_text_height(46)\nscene.draw_text(name, 70, 170)\n\nscene.set_text_style(Font.SANS, FontStyle.NORMAL)\nscene.set_text_height(16)\nscene.draw_text(f\"Grade: {grade}\", 70, 240)\nscene.draw_text(f\"Lucky number: {lucky_number}\", 70, 264)\n\n# A tiny fanfare for your arrival\nscene.play_note(72, 0.25)\nscene.pause(0.25)\nscene.play_note(76, 0.4)\n\nTheater.play_scenes(scene)`;\n  const SAMPLE_2_CITY_SKYLINE_PY = `scene = Scene()\n\n# ============================================\n#  CITY SKYLINE\n#  Concepts: lists, for loops, while loops\n# ============================================\n\nscene.clear(\"#1B1035\")\n\n# ---- Moon ----\nscene.set_fill_color(\"#FFD36E\")\nscene.remove_stroke_color()\nscene.draw_ellipse(300, 35, 55, 55)\n\n# ---- A list of building heights ----\n# Change these numbers and re-run: the skyline changes with the data!\nheights = [140, 220, 170, 260, 190, 235, 150]\n\nbuilding_width = 50\nx = 10\n\nfor h in heights:\n    # The building\n    scene.set_fill_color(\"#2E2555\")\n    scene.draw_rectangle(x, 400 - h, building_width, h)\n\n    # Lit windows, from the roof down (a loop inside a loop)\n    window_y = 400 - h + 14\n    while window_y < 375:\n        scene.set_fill_color(\"#FFD36E\")\n        scene.draw_rectangle(x + 9, window_y, 9, 9)\n        scene.draw_rectangle(x + 30, window_y, 9, 9)\n        window_y = window_y + 24\n\n    x = x + building_width + 5\n\n# ---- Caption ----\nscene.set_text_style(Font.SANS, FontStyle.BOLD)\nscene.set_text_color(\"white\")\nscene.set_text_height(20)\nscene.draw_text(f\"{len(heights)} buildings, 1 list\", 12, 12)\n\nTheater.play_scenes(scene)`;\n  const SAMPLE_3_MELODY_MAKER_PY = `scene = Scene()\n\n# ============================================\n#  MELODY MAKER\n#  Concepts: lists, indexing, loops + sound\n# ============================================\n\nscene.clear(\"#003F25\")\n\nscene.set_text_style(Font.SANS, FontStyle.BOLD)\nscene.set_text_color(\"white\")\nscene.set_text_height(22)\nscene.draw_text(\"now playing: C major\", 20, 20)\n\n# ---- MIDI note numbers for a C major scale ----\n# 60 = middle C. Try changing notes or adding your own!\nnotes = [60, 62, 64, 65, 67, 69, 71, 72]\n\n# A color palette the bars will cycle through\npalette = [\"#7CDB87\", \"#FFD36E\", \"#F07FB0\", \"#6FCAFF\"]\n\ni = 0\nfor note in notes:\n    # Taller bar = higher note\n    bar_height = (note - 54) * 14\n    color = palette[i % 4]\n\n    scene.set_fill_color(color)\n    scene.remove_stroke_color()\n    scene.draw_rectangle(20 + i * 45, 380 - bar_height, 36, bar_height)\n\n    # Each bar appears exactly when its note plays\n    scene.play_note_and_pause(note, 0.3)\n\n    i = i + 1\n\n# Big finish\nscene.play_note(72, 0.6)\n\nTheater.play_scenes(scene)`;\n  const SAMPLE_4_EMOJI_FACTORY_PY = `scene = Scene()\n\n# ============================================\n#  EMOJI FACTORY\n#  Concepts: functions, parameters, conditionals\n# ============================================\n\nscene.clear(\"#D5EFFF\")\n\n# ---- One function, endless faces ----\n# Parameters let us reuse the same code with different data.\ndef draw_face(x, y, size, color, mood):\n    # Head\n    scene.set_fill_color(color)\n    scene.set_stroke_color(\"#06338D\")\n    scene.set_stroke_width(3)\n    scene.draw_ellipse(x, y, size, size)\n\n    # Eyes\n    eye = size / 8\n    scene.set_fill_color(\"black\")\n    scene.remove_stroke_color()\n    scene.draw_ellipse(x + size * 0.25, y + size * 0.3, eye, eye)\n    scene.draw_ellipse(x + size * 0.62, y + size * 0.3, eye, eye)\n\n    # Mouth depends on the mood parameter\n    if mood == \"happy\":\n        scene.set_fill_color(\"#7D0C3D\")\n        scene.draw_ellipse(x + size * 0.3, y + size * 0.58, size * 0.4, size * 0.22)\n    elif mood == \"wow\":\n        scene.set_fill_color(\"#7D0C3D\")\n        scene.draw_ellipse(x + size * 0.4, y + size * 0.58, size * 0.2, size * 0.28)\n    else:\n        # a flat, unimpressed line\n        scene.set_stroke_color(\"#7D0C3D\")\n        scene.set_stroke_width(4)\n        scene.draw_line(x + size * 0.3, y + size * 0.68, x + size * 0.7, y + size * 0.68)\n\n# ---- Call it with different arguments ----\ndraw_face(30, 40, 120, \"#FFD36E\", \"happy\")\ndraw_face(220, 60, 150, \"#7CDB87\", \"wow\")\ndraw_face(70, 230, 100, \"#F07FB0\", \"meh\")\ndraw_face(230, 250, 130, \"#6FCAFF\", \"happy\")\n\nscene.set_text_style(Font.SANS, FontStyle.BOLD)\nscene.set_text_color(\"#06338D\")\nscene.set_text_height(18)\nscene.draw_text(\"4 faces, 1 function\", 130, 10)\n\nTheater.play_scenes(scene)`;\n  const SAMPLE_5_MOOD_RING_PY = `scene = Scene()\n\n# ============================================\n#  MOOD RING\n#  Concepts: input(), if / elif / else, loops\n# ============================================\n\nprint(\"Welcome to the Mood Ring.\")\nmood = input(\"How are you feeling? (happy / calm / fired-up)\")\n\n# ---- The program makes a decision based on your input ----\nif mood == \"happy\":\n    bg = \"#FFD36E\"\n    ring_color = \"#F46800\"\n    message = \"sunshine mode: ON\"\n    note = 76\nelif mood == \"calm\":\n    bg = \"#D5EFFF\"\n    ring_color = \"#0099F3\"\n    message = \"deep breaths, smooth seas\"\n    note = 62\nelif mood == \"fired-up\":\n    bg = \"#FBDAE8\"\n    ring_color = \"#E11970\"\n    message = \"unstoppable energy detected\"\n    note = 84\nelse:\n    bg = \"#E4E2F8\"\n    ring_color = \"#4C42CF\"\n    message = f\"'{mood}' is a whole new mood\"\n    note = 69\n\nscene.clear(bg)\n\n# ---- Concentric rings, drawn with a loop ----\nradius = 160\nwhile radius > 20:\n    scene.remove_fill_color()\n    scene.set_stroke_color(ring_color)\n    scene.set_stroke_width(6)\n    scene.draw_ellipse(200 - radius, 210 - radius, radius * 2, radius * 2)\n    scene.pause(0.15)\n    radius = radius - 28\n\n# ---- The reading ----\nscene.set_text_style(Font.SANS, FontStyle.BOLD)\nscene.set_text_color(\"#1F1976\")\nscene.set_text_height(22)\nscene.draw_text(message, 30, 20)\n\nscene.play_note(note, 0.5)\n\nTheater.play_scenes(scene)`;\n  const SAMPLE_6_PIXEL_QUILT_PY = `scene = Scene()\n\n# ============================================\n#  PIXEL QUILT\n#  Concepts: nested loops, range(), % (modulo)\n# ============================================\n\nscene.clear(\"white\")\n\n# ---- The quilt's color pattern ----\n# The % operator cycles through this list over and over.\ncolors = [\"#4C42CF\", \"#E4E2F8\", \"#ACA8EA\", \"#FFD36E\"]\n\ntile = 40\nrows = 10\ncols = 10\n\nfor row in range(rows):\n    for col in range(cols):\n        # (row + col) makes diagonal stripes.\n        # Try (row * col) or just (col) and see what happens!\n        color = colors[(row + col) % 4]\n        scene.set_fill_color(color)\n        scene.remove_stroke_color()\n        scene.draw_rectangle(col * tile, row * tile, tile, tile)\n\n# ---- Stamp a star on every 3rd diagonal ----\nfor row in range(rows):\n    for col in range(cols):\n        if (row + col) % 3 == 0:\n            scene.set_fill_color(\"#1F1976\")\n            scene.draw_regular_polygon(col * tile + 20, row * tile + 20, 5, 9)\n\nTheater.play_scenes(scene)`;\n  const SAMPLE_7_SUNRISE_STORY_PY = `# ============================================\n#  SUNRISE, IN THREE ACTS\n#  Concepts: multiple scenes, sequencing, pause\n# ============================================\n\n# A helper that draws the ground + sun in ANY scene, at ANY height\ndef draw_world(s, sky, sun_y, label):\n    s.clear(sky)\n\n    # The sun\n    s.set_fill_color(\"#FFD36E\")\n    s.remove_stroke_color()\n    s.draw_ellipse(160, sun_y, 80, 80)\n\n    # The ground\n    s.set_fill_color(\"#003F25\")\n    s.draw_rectangle(0, 320, 400, 80)\n\n    # Some hills\n    s.set_fill_color(\"#34BD43\")\n    s.draw_ellipse(-60, 290, 240, 100)\n    s.draw_ellipse(220, 295, 260, 100)\n\n    # Act title\n    s.set_text_style(Font.SERIF, FontStyle.BOLD_ITALIC)\n    s.set_text_color(\"white\")\n    s.set_text_height(24)\n    s.draw_text(label, 20, 20)\n\n    # Let the audience take it in\n    s.pause(1.2)\n\n# ---- Act 1: night ----\nact1 = Scene()\ndraw_world(act1, \"#1B1035\", 340, \"Act I: still dark\")\nact1.play_note(48, 0.8)\n\n# ---- Act 2: dawn ----\nact2 = Scene()\ndraw_world(act2, \"#F07FB0\", 220, \"Act II: first light\")\nact2.play_note(60, 0.8)\n\n# ---- Act 3: morning ----\nact3 = Scene()\ndraw_world(act3, \"#6FCAFF\", 90, \"Act III: good morning\")\nact3.play_note(72, 1.0)\n\n# The Theater plays the scenes in order, like a story\nTheater.play_scenes(act1, act2, act3)`;\n  const SAMPLE_8_SEASON_WRAPPED_PY = `scene = Scene()\n\n# ================================================\n#  SEASON WRAPPED   (theme: team sports highlights)\n#  Interview the user about their team's season,\n#  crunch the numbers, then play the animated recap.\n#  Concepts: sequencing, variables, strings,\n#            input/output, arithmetic\n# ================================================\n\n# ---------- THE INTERVIEW (console) ----------\nprint(\"The season is over. Time to make it official.\")\nprint(\"Answer a few questions to build your team's Season Wrapped.\")\nprint(\"\")\nname = input(\"What's your name? \")\nteam = input(\"What's your team called? \")\nsport = input(\"What sport? (basketball, soccer, esports...) \")\nwins = int(input(\"How many games did you WIN? \"))\nlosses = int(input(\"How many did you lose? (be honest) \"))\npoints = int(input(\"Total points/goals the team scored all season? \"))\nmvp = input(\"Who was the team MVP? \")\nmoment = input(\"The best moment of the season, in a few words: \")\n\n# ---------- THE MATH ----------\n# These three variables are CALCULATED, not typed in.\ngames = wins + losses\nwin_pct = int(wins * 100 / games)\navg_points = int(points / games)\n\n# ---------- THE STORY (console) ----------\nprint(\"\")\nprint(\"Crunching stats from \" + str(games) + \" games...\")\nprint(name + \", the \" + team + \" won \" + str(win_pct) + \"% of their games.\")\nprint(\"That's about \" + str(avg_points) + \" points per game. Roll the recap!\")\n\n# ---------- SLIDE 1: THE COVER ----------\nscene.clear(\"#4C42CF\")\nscene.set_text_style(Font.SANS, FontStyle.BOLD)\nscene.set_text_color(\"#E4E2F8\")\nscene.set_text_height(20)\nscene.draw_text(name + \" presents\", 40, 100)\nscene.set_text_color(\"white\")\nscene.set_text_height(36)\nscene.draw_text(team, 40, 135)\nscene.set_text_color(\"#FFD36E\")\nscene.set_text_height(44)\nscene.draw_text(sport + \" WRAPPED\", 40, 190)\nscene.play_note(60, 0.3)\nscene.pause(0.4)\nscene.play_note(64, 0.3)\nscene.pause(0.4)\nscene.play_note(67, 0.5)\nscene.pause(1.4)\n\n# ---------- SLIDE 2: THE RECORD ----------\n# The math draws the picture: each bar's width is computed\n# from the data. (What happens if you enter 50 wins? Try it.)\nscene.clear(\"#06338D\")\nscene.set_text_color(\"#6FCAFF\")\nscene.set_text_height(18)\nscene.draw_text(\"YOUR RECORD: \" + str(games) + \" GAMES\", 40, 60)\nscene.play_note(62, 0.3)\nscene.pause(0.8)\n\nscene.set_fill_color(\"#34BD43\")\nscene.remove_stroke_color()\nscene.draw_rectangle(40, 110, wins * 12, 40)\nscene.set_text_color(\"white\")\nscene.set_text_height(20)\nscene.draw_text(str(wins) + \" wins\", 50, 160)\nscene.play_note(72, 0.3)\nscene.pause(0.8)\n\nscene.set_fill_color(\"#E11970\")\nscene.draw_rectangle(40, 200, losses * 12, 40)\nscene.draw_text(str(losses) + \" losses\", 50, 250)\nscene.play_note(52, 0.3)\nscene.pause(0.8)\n\nscene.set_text_color(\"#FFD36E\")\nscene.set_text_height(30)\nscene.draw_text(\"You won \" + str(win_pct) + \"% of your games\", 40, 320)\nscene.play_note(74, 0.5)\nscene.pause(1.6)\n\n# ---------- SLIDE 3: THE OFFENSE ----------\nscene.clear(\"#F46800\")\nscene.set_text_color(\"#FFE3CE\")\nscene.set_text_height(18)\nscene.draw_text(\"THE \" + team + \" PUT UP\", 40, 80)\nscene.play_note(65, 0.3)\nscene.pause(0.8)\nscene.set_text_color(\"white\")\nscene.set_text_height(64)\nscene.draw_text(str(points), 40, 120)\nscene.set_text_height(26)\nscene.draw_text(\"points this season\", 40, 200)\nscene.pause(0.8)\nscene.set_text_color(\"#FFE3CE\")\nscene.set_text_height(20)\nscene.draw_text(\"that's about \" + str(avg_points) + \" per game\", 40, 300)\nscene.play_note(76, 0.5)\nscene.pause(1.6)\n\n# ---------- SLIDE 4: THE MVP ----------\nscene.clear(\"#003F25\")\nscene.set_text_color(\"#7CDB87\")\nscene.set_text_height(18)\nscene.draw_text(\"AND YOUR MVP IS...\", 40, 90)\nscene.play_note(55, 0.2)\nscene.pause(0.5)\nscene.play_note(55, 0.2)\nscene.pause(0.5)\nscene.play_note(55, 0.2)\nscene.pause(0.9)\nscene.set_fill_color(\"#FFD36E\")\nscene.remove_stroke_color()\nscene.draw_regular_polygon(90, 190, 5, 28)\nscene.set_text_style(Font.SERIF, FontStyle.BOLD_ITALIC)\nscene.set_text_color(\"white\")\nscene.set_text_height(42)\nscene.draw_text(mvp, 135, 165)\nscene.set_text_style(Font.SANS, FontStyle.BOLD)\nscene.set_text_color(\"#7CDB87\")\nscene.set_text_height(16)\nscene.draw_text(\"legend behavior.\", 40, 320)\nscene.play_note(79, 0.7)\nscene.pause(1.6)\n\n# ---------- SLIDE 5: THE SHARE CARD ----------\nscene.clear(\"#12122b\")\nscene.set_fill_color(\"#FFD36E\")\nscene.draw_rectangle(40, 45, 320, 4)\nscene.set_text_color(\"#FFD36E\")\nscene.set_text_height(24)\nscene.draw_text(team + \" Wrapped\", 40, 62)\nscene.set_text_color(\"white\")\nscene.set_text_height(17)\nscene.draw_text(str(wins) + \"-\" + str(losses) + \" record (\" + str(win_pct) + \"%)\", 40, 120)\nscene.draw_text(str(points) + \" points, \" + str(avg_points) + \" per game\", 40, 152)\nscene.draw_text(\"MVP: \" + mvp, 40, 184)\nscene.draw_text(\"Best moment: \" + moment, 40, 216)\nscene.set_fill_color(\"#FFD36E\")\nscene.draw_rectangle(40, 280, 320, 4)\nscene.set_text_color(\"#ACA8EA\")\nscene.set_text_height(16)\nscene.draw_text(\"See you next season, \" + name + \".\", 40, 310)\nscene.play_note(60, 0.25)\nscene.pause(0.25)\nscene.play_note(64, 0.25)\nscene.pause(0.25)\nscene.play_note(67, 0.25)\nscene.pause(0.25)\nscene.play_note(72, 0.8)\n\nTheater.play_scenes(scene)`;\n\n  // ---------- file manager state ----------\n  let files = { 'main.py': DEFAULT_MAIN_PY, '1_name_tag.py': SAMPLE_1_NAME_TAG_PY, '2_city_skyline.py': SAMPLE_2_CITY_SKYLINE_PY, '3_melody_maker.py': SAMPLE_3_MELODY_MAKER_PY, '4_emoji_factory.py': SAMPLE_4_EMOJI_FACTORY_PY, '5_mood_ring.py': SAMPLE_5_MOOD_RING_PY, '6_pixel_quilt.py': SAMPLE_6_PIXEL_QUILT_PY, '7_sunrise_story.py': SAMPLE_7_SUNRISE_STORY_PY, '8_season_wrapped.py': SAMPLE_8_SEASON_WRAPPED_PY };\n  let fileTypes = { 'main.py': 'code', '1_name_tag.py': 'code', '2_city_skyline.py': 'code', '3_melody_maker.py': 'code', '4_emoji_factory.py': 'code', '5_mood_ring.py': 'code', '6_pixel_quilt.py': 'code', '7_sunrise_story.py': 'code', '8_season_wrapped.py': 'code' };\n  let imageObjects = {};\n  let openTabs = ['main.py'];\n  let activeFile = 'main.py';\n\n  const FILE_ICON_SVG = '<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M6 2h9l5 5v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1Zm8 1.5V8h4.5L14 3.5Z\"/></svg>';\n  const PENCIL_SVG = '<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25ZM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83Z\"/></svg>';\n  const TRASH_SVG = '<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M9 3h6l1 2h4v2H4V5h4l1-2Zm-2 6h2v9H7V9Zm4 0h2v9h-2V9Zm4 0h2v9h-2V9ZM6 7h12l-1 14a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L6 7Z\"/></svg>';\n  const CLOSE_SVG = '<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M18.3 5.71 12 12l6.3 6.29-1.41 1.42L10.59 13.4 4.3 19.71 2.88 18.3 9.17 12 2.88 5.71 4.3 4.29l6.29 6.3 6.29-6.3z\"/></svg>';\n\n  // ---------- CodeMirror (with plain-textarea fallback) ----------\n  let cm = null;\n  let useCM = false;\n  const cmHost = document.getElementById('cmHost');\n  const fallbackTa = document.getElementById('codeFallback');\n\n  function initEditor(){\n    if (window.CodeMirror){\n      useCM = true;\n      cm = CodeMirror(cmHost, {\n        value: files[activeFile] || '',\n        mode: 'python',\n        lineNumbers: true,\n        indentUnit: 4,\n        tabSize: 4,\n        smartIndent: true,\n        viewportMargin: 10\n      });\n      cm.on('change', () => { if (activeFile) files[activeFile] = cm.getValue(); });\n    } else {\n      useCM = false;\n      cmHost.style.display = 'none';\n      fallbackTa.style.display = '';\n      fallbackTa.value = files[activeFile] || '';\n      fallbackTa.addEventListener('input', () => { if (activeFile) files[activeFile] = fallbackTa.value; });\n    }\n  }\n  function getEditorContent(){ return useCM ? cm.getValue() : fallbackTa.value; }\n  function setEditorContent(text){\n    if (useCM) cm.setValue(text || '');\n    else fallbackTa.value = text || '';\n  }\n  function refreshEditor(){ if (useCM && cm) cm.refresh(); }\n\n  // ---------- console helper ----------\n  function resetConsole(){ consoleEl.innerHTML = ''; }\n  function log(text, cls){\n    const div = document.createElement('div');\n    div.className = 'line' + (cls ? ' ' + cls : '');\n    div.textContent = text;\n    consoleEl.appendChild(div);\n    consoleEl.scrollTop = consoleEl.scrollHeight;\n  }\n  clearConsoleBtn.addEventListener('click', () => {\n    resetConsole();\n    log('Console cleared.', 'sys');\n  });\n\n  // ---------- console input (for the Python input() builtin) ----------\n  // Shows the prompt text, then renders an inline input row in the console\n  // and returns a Promise that resolves with what the user types on Enter.\n  function requestConsoleInput(promptText){\n    return new Promise((resolve) => {\n      if (promptText) log(promptText);\n\n      const row = document.createElement('div');\n      row.className = 'console-input-row';\n      const caret = document.createElement('span');\n      caret.className = 'console-input-caret';\n      caret.textContent = '>';\n      const field = document.createElement('input');\n      field.className = 'console-input-field';\n      field.type = 'text';\n      field.setAttribute('aria-label', promptText || 'Program input');\n      row.appendChild(caret);\n      row.appendChild(field);\n      consoleEl.appendChild(row);\n      consoleEl.scrollTop = consoleEl.scrollHeight;\n      field.focus();\n\n      field.addEventListener('keydown', (e) => {\n        if (e.key === 'Enter'){\n          const value = field.value;\n          row.remove();\n          log('> ' + value, 'echo');\n          resolve(value);\n        }\n      });\n    });\n  }\n\n  // ---------- playback speed (from the speed slider) ----------\n  // slider 0-100 maps to a 0.25x - 2x multiplier; higher = faster (shorter pauses)\n  function speedMultiplier(){\n    const v = parseInt(speedSlider.value, 10);\n    return 0.25 + (v / 100) * 1.75;\n  }\n\n  // ---------- unique name helper (for uploaded images and new files) ----------\n  function uniqueName(base){\n    if (!Object.prototype.hasOwnProperty.call(files, base)) return base;\n    const dot = base.lastIndexOf('.');\n    const stem = dot > 0 ? base.slice(0, dot) : base;\n    const ext = dot > 0 ? base.slice(dot) : '';\n    let n = 2;\n    let candidate = `${stem} (${n})${ext}`;\n    while (Object.prototype.hasOwnProperty.call(files, candidate)){ n++; candidate = `${stem} (${n})${ext}`; }\n    return candidate;\n  }\n\n  // ---------- file upload (image / audio / video) ----------\n  let audioBuffers = {}; // filename -> decoded AudioBuffer, for uploaded audio files\n\n  function getExtension(name){\n    const dot = name.lastIndexOf('.');\n    return dot >= 0 ? name.slice(dot + 1).toLowerCase() : '';\n  }\n  function classifyFile(file){\n    const ext = getExtension(file.name);\n    if (file.type.startsWith('image/') || ['png','jpg','jpeg','gif','webp','svg','bmp'].includes(ext)) return 'image';\n    if (file.type.startsWith('audio/') || ['mp3','wav','ogg','m4a','aac','flac'].includes(ext)) return 'audio';\n    if (file.type.startsWith('video/') || ['mp4','webm','mov','ogv','mkv'].includes(ext)) return 'video';\n    return 'other';\n  }\n\n  function handleUploadedFile(file){\n    const category = classifyFile(file);\n    const reader = new FileReader();\n    reader.onload = () => {\n      const name = uniqueName(file.name);\n      const dataUrl = reader.result;\n      files[name] = dataUrl;\n      fileTypes[name] = category;\n\n      if (category === 'image'){\n        const img = new Image();\n        img.onload = () => renderFileList();\n        img.src = dataUrl;\n        imageObjects[name] = img;\n      } else if (category === 'audio'){\n        // Decode it for real, so play_sound(\"this-file.mp3\") can actually play it.\n        fetch(dataUrl)\n          .then(r => r.arrayBuffer())\n          .then(buf => ensureAudio().decodeAudioData(buf))\n          .then(decoded => { audioBuffers[name] = decoded; })\n          .catch(() => { /* decoding failed silently; play_sound falls back to the placeholder tone */ });\n      }\n      renderFileList();\n    };\n    reader.readAsDataURL(file);\n  }\n  addMenuBtn.addEventListener('click', (e) => {\n    e.stopPropagation();\n    addFileMenu.classList.toggle('open');\n  });\n  document.addEventListener('click', () => addFileMenu.classList.remove('open'));\n  addFileMenu.addEventListener('click', (e) => e.stopPropagation());\n\n  menuUploadImage.addEventListener('click', () => {\n    addFileMenu.classList.remove('open');\n    imageUploadInput.click();\n  });\n  imageUploadInput.addEventListener('change', (e) => {\n    Array.from(e.target.files || []).forEach(handleUploadedFile);\n    imageUploadInput.value = '';\n  });\n\n  // ---------- flash message ----------\n  function flashMessage(row, text){\n    const bubble = document.createElement('div');\n    bubble.className = 'flash-msg';\n    bubble.textContent = text;\n    row.appendChild(bubble);\n    setTimeout(() => bubble.remove(), 1600);\n  }\n\n  // ---------- open tabs <-> files ----------\n  function openFileInTab(name){\n    if (fileTypes[name] === 'image') return; // images don't open as editor tabs\n    files[activeFile] = getEditorContent();\n    if (!openTabs.includes(name)) openTabs.push(name);\n    activeFile = name;\n    setEditorContent(files[name] || '');\n    renderFileList();\n    renderTabStrip();\n  }\n\n  function closeTab(name){\n    const idx = openTabs.indexOf(name);\n    if (idx === -1) return;\n    if (activeFile === name) files[activeFile] = getEditorContent();\n    openTabs.splice(idx, 1);\n    if (activeFile === name){\n      const next = openTabs[idx - 1] || openTabs[idx] || openTabs[0] || null;\n      if (next){\n        activeFile = next;\n        setEditorContent(files[next] || '');\n      } else {\n        activeFile = null;\n        setEditorContent('');\n      }\n    }\n    renderTabStrip();\n    renderFileList();\n  }\n\n  function renderTabStrip(){\n    tabStripEl.innerHTML = '';\n    if (openTabs.length === 0){\n      const msg = document.createElement('div');\n      msg.style.cssText = 'padding:8px 14px;font-size:12px;color:#a7acb3;';\n      msg.textContent = 'No file open — select one from Files';\n      tabStripEl.appendChild(msg);\n      return;\n    }\n    openTabs.forEach(name => {\n      const tab = document.createElement('div');\n      tab.className = 'tab' + (name === activeFile ? ' active' : '');\n\n      const icon = document.createElement('span');\n      icon.className = 'tab-icon';\n      icon.innerHTML = FILE_ICON_SVG;\n\n      const label = document.createElement('span');\n      label.textContent = name;\n\n      const closeBtn = document.createElement('button');\n      closeBtn.className = 'tab-close';\n      closeBtn.innerHTML = CLOSE_SVG;\n      closeBtn.title = 'Close';\n      closeBtn.addEventListener('click', (e) => { e.stopPropagation(); closeTab(name); });\n\n      tab.appendChild(icon);\n      tab.appendChild(label);\n      tab.appendChild(closeBtn);\n      tab.addEventListener('click', () => {\n        if (name !== activeFile){\n          files[activeFile] = getEditorContent();\n          activeFile = name;\n          setEditorContent(files[name] || '');\n          renderFileList();\n          renderTabStrip();\n        }\n      });\n      tabStripEl.appendChild(tab);\n    });\n  }\n\n  function deleteFile(name, row){\n    const type = fileTypes[name] || 'code';\n    if (type === 'code'){\n      const codeCount = Object.keys(files).filter(n => (fileTypes[n] || 'code') === 'code').length;\n      if (codeCount <= 1){\n        flashMessage(row, \"Can't delete the only code file\");\n        return;\n      }\n    }\n    if (openTabs.includes(name)) closeTab(name);\n    delete files[name];\n    delete fileTypes[name];\n    delete imageObjects[name];\n    delete audioBuffers[name];\n    renderFileList();\n  }\n\n  function enterRenameMode(row, oldName){\n    row.innerHTML = '';\n    const input = document.createElement('input');\n    input.className = 'rename-input';\n    input.value = oldName;\n    row.appendChild(input);\n    input.focus();\n    input.select();\n    let cancelled = false;\n\n    function commit(){\n      if (cancelled){ renderFileList(); return; }\n      const newName = input.value.trim();\n      if (!newName){\n        input.classList.add('invalid'); input.title = 'Name cannot be empty'; input.focus(); return;\n      }\n      if (Object.prototype.hasOwnProperty.call(files, newName) && newName !== oldName){\n        input.classList.add('invalid'); input.title = 'A file with that name already exists'; input.focus(); return;\n      }\n      if (newName !== oldName){\n        const content = files[oldName];\n        const type = fileTypes[oldName] || 'code';\n        delete files[oldName];\n        delete fileTypes[oldName];\n        files[newName] = content;\n        fileTypes[newName] = type;\n        if (type === 'image'){\n          imageObjects[newName] = imageObjects[oldName];\n          delete imageObjects[oldName];\n        }\n        if (type === 'audio'){\n          audioBuffers[newName] = audioBuffers[oldName];\n          delete audioBuffers[oldName];\n        }\n        const tabIdx = openTabs.indexOf(oldName);\n        if (tabIdx !== -1) openTabs[tabIdx] = newName;\n        if (activeFile === oldName) activeFile = newName;\n      }\n      renderFileList();\n      renderTabStrip();\n    }\n\n    input.addEventListener('keydown', (e) => {\n      if (e.key === 'Enter'){ e.preventDefault(); input.blur(); }\n      else if (e.key === 'Escape'){ cancelled = true; input.blur(); }\n    });\n    input.addEventListener('blur', commit);\n  }\n\n  function iconForFile(name, type){\n    if (type === 'image') return '🖼️';\n    if (type === 'audio') return '🎵';\n    if (type === 'video') return '🎬';\n    if (name.toLowerCase().endsWith('.py')) return '🐍';\n    return '📄';\n  }\n\n  function renderFileList(){\n    fileRowsEl.innerHTML = '';\n    Object.keys(files).forEach(name => {\n      const type = fileTypes[name] || 'code';\n      const row = document.createElement('div');\n      row.className = 'file-row' + (name === activeFile ? ' active' : '');\n      row.dataset.file = name;\n\n      const icon = document.createElement('span');\n      icon.className = 'file-icon';\n      icon.textContent = iconForFile(name, type);\n\n      const label = document.createElement('span');\n      label.className = 'file-name';\n      label.textContent = name;\n      label.title = type !== 'code' ? name + ' (' + type + ' asset)' : name;\n      label.addEventListener('dblclick', (e) => { e.stopPropagation(); enterRenameMode(row, name); });\n\n      const actions = document.createElement('span');\n      actions.className = 'file-actions';\n\n      const renameBtn = document.createElement('button');\n      renameBtn.className = 'file-action-btn';\n      renameBtn.title = 'Rename';\n      renameBtn.innerHTML = PENCIL_SVG;\n      renameBtn.addEventListener('click', (e) => { e.stopPropagation(); enterRenameMode(row, name); });\n\n      const delBtn = document.createElement('button');\n      delBtn.className = 'file-action-btn';\n      delBtn.title = 'Delete';\n      delBtn.innerHTML = TRASH_SVG;\n      delBtn.addEventListener('click', (e) => { e.stopPropagation(); deleteFile(name, row); });\n\n      actions.appendChild(renameBtn);\n      actions.appendChild(delBtn);\n\n      row.appendChild(icon);\n      row.appendChild(label);\n      row.appendChild(actions);\n      row.addEventListener('click', () => { if (type === 'code') openFileInTab(name); });\n\n      fileRowsEl.appendChild(row);\n    });\n  }\n\n  menuNewFile.addEventListener('click', () => {\n    addFileMenu.classList.remove('open');\n    let n = 1;\n    let name = `untitled${n}.py`;\n    while (Object.prototype.hasOwnProperty.call(files, name)){ n++; name = `untitled${n}.py`; }\n    files[name] = '';\n    fileTypes[name] = 'code';\n    openFileInTab(name);\n    const row = [...fileRowsEl.children].find(r => r.dataset.file === name);\n    if (row) enterRenameMode(row, name);\n  });\n\n  const FONT_MAP = { SANS: 'sans-serif', SERIF: 'serif', MONOSPACE: 'monospace', HANDWRITING: 'cursive' };\n  const FONT_STYLE_MAP = {\n    NORMAL: {weight:'normal', style:'normal'},\n    BOLD: {weight:'bold', style:'normal'},\n    ITALIC: {weight:'normal', style:'italic'},\n    BOLD_ITALIC: {weight:'bold', style:'italic'}\n  };\n\n  // ---------- Scene recorder (mirrors the Theater API's Scene class) ----------\n  class SceneRecorder{\n    constructor(){\n      this.actions = [];\n      this.fill = 'black';\n      this.stroke = 'black';\n      this.strokeWidth = 1;\n      this.textColor = 'black';\n      this.textHeight = 20;\n      this.font = 'sans-serif';\n      this.fontStyle = {weight:'normal', style:'normal'};\n    }\n    clear(color){ this.actions.push({t:'clear', color}); }\n    set_fill_color(color){ this.fill = color; }\n    set_stroke_color(color){ this.stroke = color; }\n    remove_fill_color(){ this.fill = null; }\n    remove_stroke_color(){ this.stroke = null; }\n    set_stroke_width(w){ this.strokeWidth = w; }\n    set_text_color(color){ this.textColor = color; }\n    set_text_height(h){ this.textHeight = h; }\n    set_text_style(font, style){ this.font = font; this.fontStyle = style; }\n    draw_rectangle(x,y,w,h){ this.actions.push({t:'rect', x,y,w,h, fill:this.fill, stroke:this.stroke, sw:this.strokeWidth}); }\n    draw_ellipse(x,y,w,h){ this.actions.push({t:'ellipse', x,y,w,h, fill:this.fill, stroke:this.stroke, sw:this.strokeWidth}); }\n    draw_line(x1,y1,x2,y2){ this.actions.push({t:'line', x1,y1,x2,y2, stroke:this.stroke||'black', sw:this.strokeWidth}); }\n    draw_regular_polygon(x,y,sides,radius){ this.actions.push({t:'polygon', x,y,sides,radius, fill:this.fill, stroke:this.stroke, sw:this.strokeWidth}); }\n    draw_shape(points, close){ this.actions.push({t:'shape', points, close:!!close, fill:this.fill, stroke:this.stroke, sw:this.strokeWidth}); }\n    draw_text(text,x,y,rotation){\n      this.actions.push({t:'text', text, x, y, rotation:rotation||0, color:this.textColor, height:this.textHeight, font:this.font, weight:this.fontStyle.weight, style:this.fontStyle.style});\n    }\n    draw_image(...args){\n      let source, x, y, w, h, rotation=0;\n      if (args.length === 4){ [source,x,y,w] = args; h = w; }\n      else if (args.length === 5){ [source,x,y,w,rotation] = args; h = w; }\n      else if (args.length === 6){ [source,x,y,w,h,rotation] = args; }\n      else return;\n      const filename = (source && source.__image) ? source.filename : String(source);\n      this.actions.push({t:'image', filename, x, y, w, h, rotation});\n    }\n    play_note(a,b,c){\n      let instrument='piano', note, seconds;\n      if (c !== undefined){ instrument = a; note = b; seconds = c; }\n      else { note = a; seconds = b; }\n      this.actions.push({t:'note', instrument, note, seconds});\n    }\n    play_note_and_pause(a,b,c){\n      this.play_note(a,b,c);\n      this.pause(c !== undefined ? c : b);\n    }\n    play_sound(source){\n      if (Array.isArray(source)) this.actions.push({t:'sound', samples: source});\n      else this.actions.push({t:'sound', filename: String(source)});\n    }\n    pause(seconds){ this.actions.push({t:'pause', seconds: Math.max(seconds, 0.1)}); }\n    get_width(){ return W; }\n    get_height(){ return H; }\n  }\n\n  // ---------- tiny line-based interpreter for the Theater API surface ----------\n  // ---------- preprocessing ----------\n  function stripComment(line){\n    let inQuote = null, out = '';\n    for (let ch of line){\n      if (inQuote){ out += ch; if (ch === inQuote) inQuote = null; continue; }\n      if (ch === '\"' || ch === \"'\"){ inQuote = ch; out += ch; continue; }\n      if (ch === '#') break;\n      out += ch;\n    }\n    return out;\n  }\n  function preprocessLines(sourceCode){\n    const rawLines = sourceCode.replace(/\\t/g, '    ').split('\\n');\n    const out = [];\n    for (const raw of rawLines){\n      const stripped = stripComment(raw).replace(/\\s+$/, '');\n      if (stripped.trim() === '') continue;\n      const indent = stripped.match(/^ */)[0].length;\n      out.push({ indent, text: stripped.trim() });\n    }\n    return out;\n  }\n\n  // ---------- tokenizer ----------\n  function tokenize(s){\n    const tokens = [];\n    let i = 0;\n    const n = s.length;\n    while (i < n){\n      const c = s[i];\n      if (c === ' ' || c === '\\t'){ i++; continue; }\n      if ((c === 'f' || c === 'F') && (s[i+1] === '\"' || s[i+1] === \"'\")){\n        const quote = s[i+1]; let j = i + 2; let str = '';\n        while (j < n && s[j] !== quote){ str += s[j]; j++; }\n        tokens.push({ type: 'FSTRING', value: str });\n        i = j + 1; continue;\n      }\n      if (c === '\"' || c === \"'\"){\n        const quote = c; let j = i + 1; let str = '';\n        while (j < n && s[j] !== quote){ str += s[j]; j++; }\n        tokens.push({ type: 'STRING', value: str });\n        i = j + 1; continue;\n      }\n      if (/[0-9]/.test(c)){\n        let j = i; let numStr = '';\n        while (j < n && /[0-9.]/.test(s[j])){ numStr += s[j]; j++; }\n        tokens.push({ type: 'NUMBER', value: parseFloat(numStr) });\n        i = j; continue;\n      }\n      if (/[A-Za-z_]/.test(c)){\n        let j = i; let ident = '';\n        while (j < n && /[A-Za-z0-9_]/.test(s[j])){ ident += s[j]; j++; }\n        tokens.push({ type: 'IDENT', value: ident });\n        i = j; continue;\n      }\n      const two = s.slice(i, i + 2);\n      if (['==', '!=', '<=', '>='].includes(two)){ tokens.push({ type: 'OP', value: two }); i += 2; continue; }\n      if ('+-*/%()[]{},.<>:'.includes(c)){ tokens.push({ type: 'OP', value: c }); i++; continue; }\n      i++; // skip unknown character\n    }\n    return tokens;\n  }\n\n  // ---------- recursive-descent expression parser ----------\n  class ExprParser{\n    constructor(tokens){ this.tokens = tokens; this.pos = 0; }\n    peek(){ return this.tokens[this.pos]; }\n    next(){ return this.tokens[this.pos++]; }\n    isOp(v){ const t = this.peek(); return !!t && t.type === 'OP' && t.value === v; }\n    isKw(v){ const t = this.peek(); return !!t && t.type === 'IDENT' && t.value === v; }\n    expectOp(op){ const t = this.next(); if (!t || t.value !== op) throw new Error(\"Expected '\" + op + \"'\"); return t; }\n\n    parseExpression(){ return this.parseOr(); }\n    parseOr(){\n      let left = this.parseAnd();\n      while (this.isKw('or')){ this.next(); left = { type:'or', left, right:this.parseAnd() }; }\n      return left;\n    }\n    parseAnd(){\n      let left = this.parseNot();\n      while (this.isKw('and')){ this.next(); left = { type:'and', left, right:this.parseNot() }; }\n      return left;\n    }\n    parseNot(){\n      if (this.isKw('not')){ this.next(); return { type:'not', expr:this.parseNot() }; }\n      return this.parseComparison();\n    }\n    parseComparison(){\n      let left = this.parseAdditive();\n      const ops = ['==','!=','<','<=','>','>='];\n      while (this.peek() && this.peek().type === 'OP' && ops.includes(this.peek().value)){\n        const op = this.next().value;\n        left = { type:'compare', op, left, right:this.parseAdditive() };\n      }\n      return left;\n    }\n    parseAdditive(){\n      let left = this.parseMultiplicative();\n      while (this.isOp('+') || this.isOp('-')){\n        const op = this.next().value;\n        left = { type:'binop', op, left, right:this.parseMultiplicative() };\n      }\n      return left;\n    }\n    parseMultiplicative(){\n      let left = this.parseUnary();\n      while (this.isOp('*') || this.isOp('/') || this.isOp('%')){\n        const op = this.next().value;\n        left = { type:'binop', op, left, right:this.parseUnary() };\n      }\n      return left;\n    }\n    parseUnary(){\n      if (this.isOp('-')){ this.next(); return { type:'neg', expr:this.parseUnary() }; }\n      return this.parsePostfix();\n    }\n    parsePostfix(){\n      let node = this.parsePrimary();\n      while (true){\n        if (this.isOp('[')){\n          this.next();\n          const idx = this.parseExpression();\n          this.expectOp(']');\n          node = { type:'index', base:node, index:idx };\n        } else if (this.isOp('.')){\n          this.next();\n          const nameTok = this.next();\n          node = { type:'attr', base:node, name: nameTok.value };\n        } else if (this.isOp('(')){\n          this.next();\n          const args = [];\n          if (!this.isOp(')')){\n            args.push(this.parseExpression());\n            while (this.isOp(',')){ this.next(); args.push(this.parseExpression()); }\n          }\n          this.expectOp(')');\n          node = { type:'call', callee:node, args };\n        } else break;\n      }\n      return node;\n    }\n    parsePrimary(){\n      const t = this.next();\n      if (!t) throw new Error('Unexpected end of expression');\n      if (t.type === 'NUMBER') return { type:'num', value:t.value };\n      if (t.type === 'STRING') return { type:'str', value:t.value };\n      if (t.type === 'FSTRING') return { type:'fstring', parts: parseFStringParts(t.value) };\n      if (t.type === 'IDENT'){\n        if (t.value === 'True') return { type:'bool', value:true };\n        if (t.value === 'False') return { type:'bool', value:false };\n        if (t.value === 'None') return { type:'none' };\n        return { type:'name', value:t.value };\n      }\n      if (t.type === 'OP' && t.value === '('){\n        const inner = this.parseExpression();\n        this.expectOp(')');\n        return inner;\n      }\n      if (t.type === 'OP' && t.value === '['){\n        const items = [];\n        if (!this.isOp(']')){\n          items.push(this.parseExpression());\n          while (this.isOp(',')){ this.next(); items.push(this.parseExpression()); }\n        }\n        this.expectOp(']');\n        return { type:'list', items };\n      }\n      if (t.type === 'OP' && t.value === '{'){\n        const pairs = [];\n        if (!this.isOp('}')){\n          const readPair = () => {\n            const keyNode = this.parseExpression();\n            this.expectOp(':');\n            const valNode = this.parseExpression();\n            pairs.push({ key: keyNode, value: valNode });\n          };\n          readPair();\n          while (this.isOp(',')){ this.next(); readPair(); }\n        }\n        this.expectOp('}');\n        return { type:'dict', pairs };\n      }\n      throw new Error('Unexpected token: ' + JSON.stringify(t));\n    }\n  }\n  function parseExpr(text){\n    const tokens = tokenize(text);\n    if (tokens.length === 0) return { type:'none' };\n    return new ExprParser(tokens).parseExpression();\n  }\n\n  // ---------- f-string content parsing ----------\n  // Splits the raw text inside f\"...\" into literal chunks and {expr} chunks.\n  function parseFStringParts(raw){\n    const parts = [];\n    let i = 0; let lit = '';\n    while (i < raw.length){\n      const c = raw[i];\n      if (c === '{'){\n        if (raw[i+1] === '{'){ lit += '{'; i += 2; continue; }\n        if (lit){ parts.push({ type:'lit', value: lit }); lit = ''; }\n        let depth = 1; let j = i + 1; let exprText = '';\n        while (j < raw.length && depth > 0){\n          if (raw[j] === '{') depth++;\n          else if (raw[j] === '}'){ depth--; if (depth === 0) break; }\n          exprText += raw[j];\n          j++;\n        }\n        parts.push({ type:'expr', node: parseExpr(exprText) });\n        i = j + 1;\n      } else if (c === '}' && raw[i+1] === '}'){\n        lit += '}'; i += 2;\n      } else {\n        lit += c; i++;\n      }\n    }\n    if (lit) parts.push({ type:'lit', value: lit });\n    return parts;\n  }\n\n  // ---------- splitting comma-separated text (for tuple unpacking) ----------\n  function splitTopLevelCommas(text){\n    const parts = []; let cur = ''; let depth = 0; let inQuote = null;\n    for (const ch of text){\n      if (inQuote){ cur += ch; if (ch === inQuote) inQuote = null; continue; }\n      if (ch === '\"' || ch === \"'\"){ inQuote = ch; cur += ch; continue; }\n      if ('([{'.includes(ch)){ depth++; cur += ch; continue; }\n      if (')]}'.includes(ch)){ depth--; cur += ch; continue; }\n      if (ch === ',' && depth === 0){ parts.push(cur); cur = ''; continue; }\n      cur += ch;\n    }\n    if (cur.trim() !== '') parts.push(cur);\n    return parts.map(p => p.trim());\n  }\n\n  // ---------- control-flow / error signals ----------\n  class PlaySignal { constructor(actions){ this.actions = actions; } }\n  class ReturnSignal { constructor(value){ this.value = value; } }\n  class PyError extends Error {\n    constructor(pyType, message){ super(message); this.pyType = pyType; }\n  }\n\n  // ---------- block builder ----------\n  function buildBlock(lines, i, parentIndent){\n    const stmts = [];\n    while (i < lines.length && lines[i].indent > parentIndent){\n      const line = lines[i];\n      let m;\n      if ((m = line.text.match(/^def\\s+(\\w+)\\s*\\((.*)\\)\\s*:$/))){\n        const params = m[2].split(',').map(s => s.trim()).filter(s => s !== '');\n        const sub = buildBlock(lines, i + 1, line.indent);\n        stmts.push({ type:'def', name:m[1], params, body:sub.block });\n        i = sub.next;\n      } else if ((m = line.text.match(/^class\\s+(\\w+)\\s*:$/))){\n        const sub = buildBlock(lines, i + 1, line.indent);\n        stmts.push({ type:'class', name:m[1], body:sub.block });\n        i = sub.next;\n      } else if ((m = line.text.match(/^for\\s+(\\w+)\\s+in\\s+(.+):$/))){\n        const sub = buildBlock(lines, i + 1, line.indent);\n        stmts.push({ type:'for', varName:m[1], iterExprText:m[2], body:sub.block });\n        i = sub.next;\n      } else if ((m = line.text.match(/^while\\s+(.+):$/))){\n        const sub = buildBlock(lines, i + 1, line.indent);\n        stmts.push({ type:'while', condText:m[1], body:sub.block });\n        i = sub.next;\n      } else if ((m = line.text.match(/^if\\s+(.+):$/))){\n        const sub = buildBlock(lines, i + 1, line.indent);\n        const branches = [{ condText:m[1], body:sub.block }];\n        let j = sub.next;\n        while (j < lines.length && lines[j].indent === line.indent && (m = lines[j].text.match(/^elif\\s+(.+):$/))){\n          const elifSub = buildBlock(lines, j + 1, line.indent);\n          branches.push({ condText:m[1], body:elifSub.block });\n          j = elifSub.next;\n        }\n        let elseBody = null;\n        if (j < lines.length && lines[j].indent === line.indent && /^else\\s*:$/.test(lines[j].text)){\n          const elseSub = buildBlock(lines, j + 1, line.indent);\n          elseBody = elseSub.block;\n          j = elseSub.next;\n        }\n        stmts.push({ type:'if', branches, elseBody });\n        i = j;\n      } else if (/^try\\s*:$/.test(line.text)){\n        const trySub = buildBlock(lines, i + 1, line.indent);\n        let j = trySub.next;\n        const exceptClauses = [];\n        while (j < lines.length && lines[j].indent === line.indent && /^except(\\s+.*)?:$/.test(lines[j].text)){\n          const em = lines[j].text.match(/^except(?:\\s+(\\w+))?(?:\\s+as\\s+(\\w+))?\\s*:$/);\n          const exceptSub = buildBlock(lines, j + 1, line.indent);\n          exceptClauses.push({ exceptionName: em && em[1] ? em[1] : null, bindName: em && em[2] ? em[2] : null, body: exceptSub.block });\n          j = exceptSub.next;\n        }\n        let finallyBody = null;\n        if (j < lines.length && lines[j].indent === line.indent && /^finally\\s*:$/.test(lines[j].text)){\n          const finallySub = buildBlock(lines, j + 1, line.indent);\n          finallyBody = finallySub.block;\n          j = finallySub.next;\n        }\n        stmts.push({ type:'try', tryBody: trySub.block, exceptClauses, finallyBody });\n        i = j;\n      } else if ((m = line.text.match(/^return(\\s+(.*))?$/))){\n        stmts.push({ type:'return', exprText: m[2] !== undefined ? m[2] : null });\n        i++;\n      } else {\n        stmts.push({ type:'simple', text: line.text });\n        i++;\n      }\n    }\n    return { block: stmts, next: i };\n  }\n\n  const MAX_WHILE_ITERATIONS = 5000;\n\n  async function runProgram(sourceCode){\n      resetConsole();\n      ctx.fillStyle = '#000'; ctx.fillRect(0,0,W,H);\n\n      const env = {};\n    const functions = {};\n    const classes = {};\n\n    function truthy(v){\n      if (Array.isArray(v)) return v.length > 0;\n      if (typeof v === 'string') return v.length > 0;\n      if (typeof v === 'number') return v !== 0;\n      if (v === undefined || v === null) return false;\n      return !!v;\n    }\n    function isPlainDict(v){\n      return v && typeof v === 'object' && !Array.isArray(v) && !(v instanceof SceneRecorder) &&\n        !v.__instance && !v.__builtin_ns && !v.__image;\n    }\n    function pyStr(v){\n      if (typeof v === 'boolean') return v ? 'True' : 'False';\n      if (v === undefined || v === null) return 'None';\n      if (Array.isArray(v)) return '[' + v.map(x => (typeof x === 'string' ? \"'\" + x + \"'\" : pyStr(x))).join(', ') + ']';\n      if (v && v.__instance) return `<${v.__class} object>`;\n      if (isPlainDict(v)){\n        return '{' + Object.keys(v).map(k => `'${k}': ` + (typeof v[k] === 'string' ? `'${v[k]}'` : pyStr(v[k]))).join(', ') + '}';\n      }\n      return String(v);\n    }\n    function typeName(v){\n      if (v instanceof SceneRecorder) return 'Scene';\n      if (v && v.__instance) return v.__class;\n      if (Array.isArray(v)) return 'list';\n      if (typeof v === 'string') return 'str';\n      if (typeof v === 'number') return 'int';\n      if (typeof v === 'boolean') return 'bool';\n      if (isPlainDict(v)) return 'dict';\n      return 'NoneType';\n    }\n\n    async function evalExpr(node){\n      switch (node.type){\n        case 'num': return node.value;\n        case 'str': return node.value;\n        case 'bool': return node.value;\n        case 'none': return undefined;\n        case 'list': { const out = []; for (const item of node.items) out.push(await evalExpr(item)); return out; }\n        case 'dict': {\n          const obj = {};\n          for (const p of node.pairs) obj[await evalExpr(p.key)] = await evalExpr(p.value);\n          return obj;\n        }\n        case 'fstring': { let s = ''; for (const p of node.parts) s += p.type === 'lit' ? p.value : pyStr(await evalExpr(p.node)); return s; }\n        case 'name': {\n          if (Object.prototype.hasOwnProperty.call(env, node.value)) return env[node.value];\n          if (['Color','Image','Scene','Theater','Font','FontStyle','Instrument'].includes(node.value)){\n            return { __builtin_ns: node.value };\n          }\n          return undefined;\n        }\n        case 'attr': {\n          const base = await evalExpr(node.base);\n          if (base && base.__builtin_ns){\n            const ns = base.__builtin_ns;\n            if (ns === 'Color') return node.name.toLowerCase();\n            if (ns === 'Instrument') return node.name.toLowerCase();\n            if (ns === 'Font') return FONT_MAP[node.name] || 'sans-serif';\n            if (ns === 'FontStyle') return FONT_STYLE_MAP[node.name] || { weight:'normal', style:'normal' };\n            return undefined;\n          }\n          if (base && base.__instance) return base.attrs[node.name];\n          if (base && typeof base === 'object') return base[node.name];\n          return undefined;\n        }\n        case 'index': {\n          const base = await evalExpr(node.base);\n          const idx = await evalExpr(node.index);\n          if (Array.isArray(base) || typeof base === 'string') return base[idx];\n          if (isPlainDict(base)) return base[idx];\n          return undefined;\n        }\n        case 'neg': return -(await evalExpr(node.expr));\n        case 'not': return !truthy(await evalExpr(node.expr));\n        case 'and': { const l = await evalExpr(node.left); return truthy(l) ? await evalExpr(node.right) : l; }\n        case 'or': { const l = await evalExpr(node.left); return truthy(l) ? l : await evalExpr(node.right); }\n        case 'compare': {\n          const l = await evalExpr(node.left), r = await evalExpr(node.right);\n          switch (node.op){\n            case '==': return l === r;\n            case '!=': return l !== r;\n            case '<': return l < r;\n            case '<=': return l <= r;\n            case '>': return l > r;\n            case '>=': return l >= r;\n          }\n          return false;\n        }\n        case 'binop': {\n          const l = await evalExpr(node.left), r = await evalExpr(node.right);\n          if (node.op === '+'){\n            if (typeof l === 'string' && typeof r === 'string') return l + r;\n            if (typeof l === 'number' && typeof r === 'number') return l + r;\n            if (Array.isArray(l) && Array.isArray(r)) return l.concat(r);\n            throw new PyError('TypeError', `unsupported operand type(s) for +: '${typeName(l)}' and '${typeName(r)}'`);\n          }\n          if (typeof l !== 'number' || typeof r !== 'number'){\n            throw new PyError('TypeError', `unsupported operand type(s) for ${node.op}: '${typeName(l)}' and '${typeName(r)}'`);\n          }\n          switch (node.op){\n            case '-': return l - r;\n            case '*': return l * r;\n            case '/': return r !== 0 ? l / r : 0;\n            case '%': return r !== 0 ? l % r : 0;\n          }\n          return 0;\n        }\n        case 'call': return await evalCall(node);\n      }\n      return undefined;\n    }\n\n    async function evalCall(node){\n      const callee = node.callee;\n\n      if (callee.type === 'attr'){\n        const base = await evalExpr(callee.base);\n        if (base && base.__builtin_ns === 'Theater' && ['play_scenes','play','playScenes'].includes(callee.name)){\n          const sceneVals = []; for (const a of node.args) sceneVals.push(await evalExpr(a));\n          const actions = [];\n          for (const s of sceneVals){ if (s instanceof SceneRecorder) actions.push(...s.actions); }\n          throw new PlaySignal(actions);\n        }\n        const args = []; for (const a of node.args) args.push(await evalExpr(a));\n        if (base && base.__instance){\n          const cls = classes[base.__class];\n          const methodDef = cls && cls.methods[callee.name];\n          if (methodDef) return await invokeMethod(base, methodDef, args);\n          return undefined;\n        }\n        if (base && typeof base[callee.name] === 'function') return base[callee.name](...args);\n        return undefined;\n      }\n\n      if (callee.type === 'name'){\n        const name = callee.value;\n        const args = []; for (const a of node.args) args.push(await evalExpr(a));\n\n        if (name === 'Scene') return new SceneRecorder();\n        if (name === 'Color') return `rgb(${args[0]}, ${args[1]}, ${args[2]})`;\n        if (name === 'Image') return { __image:true, filename: args[0] };\n        if (name === 'str') return pyStr(args[0]);\n        if (name === 'len'){\n          if (Array.isArray(args[0]) || typeof args[0] === 'string') return args[0].length;\n          if (isPlainDict(args[0])) return Object.keys(args[0]).length;\n          return 0;\n        }\n        if (name === 'print'){ log(args.map(pyStr).join(' ')); return undefined; }\n        if (name === 'input'){\n          const promptText = args.length ? pyStr(args[0]) : '';\n          return await requestConsoleInput(promptText);\n        }\n        if (name === 'int'){\n          const v = args[0];\n          const nres = parseInt(v, 10);\n          if (isNaN(nres)) throw new PyError('ValueError', `invalid literal for int(): '${pyStr(v)}'`);\n          return nres;\n        }\n        if (name === 'float'){\n          const v = args[0];\n          const nres = parseFloat(v);\n          if (isNaN(nres)) throw new PyError('ValueError', `could not convert string to float: '${pyStr(v)}'`);\n          return nres;\n        }\n        if (name === 'range'){\n          let start = 0, stop = 0, step = 1;\n          if (args.length === 1){ stop = args[0]; }\n          else if (args.length === 2){ start = args[0]; stop = args[1]; }\n          else { start = args[0]; stop = args[1]; step = args[2]; }\n          const out = [];\n          if (step > 0) for (let v = start; v < stop; v += step) out.push(v);\n          else if (step < 0) for (let v = start; v > stop; v += step) out.push(v);\n          return out;\n        }\n        if (functions[name]) return await callFunction(name, args);\n        if (classes[name]) return await instantiateClass(name, args);\n        return undefined;\n      }\n      return undefined;\n    }\n\n    async function instantiateClass(className, args){\n      const cls = classes[className];\n      const instance = { __instance:true, __class:className, attrs:{} };\n      const initDef = cls.methods.__init__;\n      if (initDef) await invokeMethod(instance, initDef, args);\n      return instance;\n    }\n\n    async function invokeMethod(instance, methodDef, args){\n      const allArgs = [instance, ...args];\n      const saved = {};\n      methodDef.params.forEach((p, idx) => {\n        saved[p] = Object.prototype.hasOwnProperty.call(env, p) ? { had:true, val:env[p] } : { had:false };\n        env[p] = allArgs[idx];\n      });\n      let result;\n      try {\n        await execStatements(methodDef.body);\n        result = undefined;\n      } catch (e){\n        if (e instanceof ReturnSignal){ result = e.value; }\n        else {\n          methodDef.params.forEach(p => { if (saved[p].had) env[p] = saved[p].val; else delete env[p]; });\n          throw e;\n        }\n      }\n      methodDef.params.forEach(p => { if (saved[p].had) env[p] = saved[p].val; else delete env[p]; });\n      return result;\n    }\n\n    async function callFunction(name, args){\n      const fn = functions[name];\n      if (!fn) return undefined;\n      const saved = {};\n      fn.params.forEach((p, idx) => {\n        saved[p] = Object.prototype.hasOwnProperty.call(env, p) ? { had:true, val:env[p] } : { had:false };\n        env[p] = args[idx];\n      });\n      let result;\n      try {\n        await execStatements(fn.body);\n        result = undefined;\n      } catch (e){\n        if (e instanceof ReturnSignal){ result = e.value; }\n        else {\n          fn.params.forEach(p => { if (saved[p].had) env[p] = saved[p].val; else delete env[p]; });\n          throw e;\n        }\n      }\n      fn.params.forEach(p => { if (saved[p].had) env[p] = saved[p].val; else delete env[p]; });\n      return result;\n    }\n\n    function findTopLevelAssignEq(text){\n      let depth = 0; let inQuote = null;\n      for (let i = 0; i < text.length; i++){\n        const c = text[i];\n        if (inQuote){ if (c === inQuote) inQuote = null; continue; }\n        if (c === '\"' || c === \"'\"){ inQuote = c; continue; }\n        if ('([{'.includes(c)){ depth++; continue; }\n        if (')]}'.includes(c)){ depth--; continue; }\n        if (c !== '=') continue;\n        if (depth !== 0) continue;\n        const prev = i > 0 ? text[i-1] : '';\n        const next = i+1 < text.length ? text[i+1] : '';\n        if (next === '='){ i++; continue; }\n        if (prev === '=' || prev === '!' || prev === '<' || prev === '>') continue;\n        return i;\n      }\n      return -1;\n    }\n\n    async function assignTo(lhsText, value){\n      if (/^\\w+$/.test(lhsText)){ env[lhsText] = value; return; }\n\n      let m = lhsText.match(/^(\\w+)\\[(.*)\\]$/s);\n      if (m){\n        const arr = env[m[1]];\n        const idx = await evalExpr(parseExpr(m[2]));\n        if (Array.isArray(arr) || (arr && typeof arr === 'object')) arr[idx] = value;\n        return;\n      }\n\n      m = lhsText.match(/^(\\w+)\\.(\\w+)$/);\n      if (m){\n        const base = env[m[1]];\n        if (base && base.__instance){ base.attrs[m[2]] = value; return; }\n        if (base && typeof base === 'object'){ base[m[2]] = value; return; }\n        return;\n      }\n    }\n\n    async function execSimpleLine(text){\n      if (/^import\\s+/.test(text) || /^from\\s+\\S+\\s+import\\s+/.test(text)) return; // nothing to import in this sandbox; safely ignored\n\n      let m = text.match(/^return(\\s+(.*))?$/);\n      if (m){ throw new ReturnSignal(m[2] !== undefined ? await evalExpr(parseExpr(m[2])) : undefined); }\n\n      const eqIdx = findTopLevelAssignEq(text);\n      if (eqIdx !== -1){\n        const lhsText = text.slice(0, eqIdx).trim();\n        const rhsText = text.slice(eqIdx + 1).trim();\n\n        const lhsTargets = splitTopLevelCommas(lhsText);\n        if (lhsTargets.length > 1){\n          const rhsTargets = splitTopLevelCommas(rhsText);\n          let values;\n          if (rhsTargets.length === lhsTargets.length){\n            values = []; for (const t of rhsTargets) values.push(await evalExpr(parseExpr(t)));\n          } else {\n            const single = await evalExpr(parseExpr(rhsText));\n            values = Array.isArray(single) ? single : [single];\n          }\n          for (let ti = 0; ti < lhsTargets.length; ti++) await assignTo(lhsTargets[ti], values[ti]);\n          return;\n        }\n\n        await assignTo(lhsText, await evalExpr(parseExpr(rhsText)));\n        return;\n      }\n\n      await evalExpr(parseExpr(text));\n    }\n\n    async function execStatements(stmts){\n      for (const stmt of stmts){\n        if (stmt.type === 'def'){\n          functions[stmt.name] = { params: stmt.params, body: stmt.body };\n        } else if (stmt.type === 'class'){\n          const methods = {};\n          for (const inner of stmt.body){\n            if (inner.type === 'def') methods[inner.name] = { params: inner.params, body: inner.body };\n          }\n          classes[stmt.name] = { methods };\n        } else if (stmt.type === 'for'){\n          const iterVal = await evalExpr(parseExpr(stmt.iterExprText));\n          const list = Array.isArray(iterVal) ? iterVal : [];\n          for (const item of list){\n            env[stmt.varName] = item;\n            await execStatements(stmt.body);\n          }\n        } else if (stmt.type === 'while'){\n          let guard = 0;\n          while (truthy(await evalExpr(parseExpr(stmt.condText)))){\n            await execStatements(stmt.body);\n            guard++;\n            if (guard > MAX_WHILE_ITERATIONS){\n              log('while loop stopped after ' + MAX_WHILE_ITERATIONS + ' iterations (safety limit)', 'sys');\n              break;\n            }\n          }\n        } else if (stmt.type === 'if'){\n          let matched = false;\n          for (const branch of stmt.branches){\n            if (truthy(await evalExpr(parseExpr(branch.condText)))){\n              await execStatements(branch.body);\n              matched = true;\n              break;\n            }\n          }\n          if (!matched && stmt.elseBody) await execStatements(stmt.elseBody);\n        } else if (stmt.type === 'try'){\n          try {\n            try {\n              await execStatements(stmt.tryBody);\n            } catch (e){\n              if (e instanceof PlaySignal || e instanceof ReturnSignal) throw e;\n              let handled = false;\n              for (const clause of stmt.exceptClauses){\n                const errType = e.pyType || 'Exception';\n                if (!clause.exceptionName || clause.exceptionName === errType || clause.exceptionName === 'Exception'){\n                  if (clause.bindName) env[clause.bindName] = e.message || String(e);\n                  await execStatements(clause.body);\n                  handled = true;\n                  break;\n                }\n              }\n              if (!handled) throw e;\n            }\n          } finally {\n            if (stmt.finallyBody) await execStatements(stmt.finallyBody);\n          }\n        } else if (stmt.type === 'return'){\n          throw new ReturnSignal(stmt.exprText !== null ? await evalExpr(parseExpr(stmt.exprText)) : undefined);\n        } else {\n          await execSimpleLine(stmt.text);\n        }\n      }\n    }\n\n    const lines = preprocessLines(sourceCode);\n    const topBlock = buildBlock(lines, 0, -1).block;\n\n    let playbackActions = null;\n    let errorMsg = null;\n    try {\n      await execStatements(topBlock);\n    } catch (e){\n      if (e instanceof PlaySignal) playbackActions = e.actions;\n      else if (e instanceof ReturnSignal) { /* stray top-level return, ignore */ }\n      else if (e instanceof PyError) { log(e.pyType + ': ' + e.message, 'sys'); }\n      else { errorMsg = (e && e.message) ? e.message : String(e); log('Error: ' + errorMsg, 'sys'); }\n    }\n\n    if (playbackActions && playbackActions.length){\n        log('Theater.play_scenes(scene) — playing ' + playbackActions.length + ' action(s)...', 'sys');\n        playActions(playbackActions);\n      } else {\n        log('No Theater.play_scenes(...) call found — nothing to play.', 'sys');\n    }\n  }\n\n  // ---------- rendering ----------\n  function hasRealImage(filename){\n    const img = imageObjects[filename];\n    return !!(img && img.complete && img.naturalWidth > 0);\n  }\n\n  function renderImageAction(a){\n    if (hasRealImage(a.filename)){\n      const img = imageObjects[a.filename];\n      ctx.save();\n      const cx = a.x + a.w/2, cy = a.y + a.h/2;\n      ctx.translate(cx, cy);\n      ctx.rotate((a.rotation || 0) * Math.PI / 180);\n      ctx.drawImage(img, -a.w/2, -a.h/2, a.w, a.h);\n      ctx.restore();\n    } else {\n      drawImagePlaceholder(a);\n    }\n  }\n\n  function drawImagePlaceholder(a){\n    ctx.save();\n    const cx = a.x + a.w/2, cy = a.y + a.h/2;\n    ctx.translate(cx, cy);\n    ctx.rotate((a.rotation || 0) * Math.PI / 180);\n    ctx.translate(-a.w/2, -a.h/2);\n\n    ctx.fillStyle = '#3a3d44';\n    ctx.fillRect(0, 0, a.w, a.h);\n    ctx.strokeStyle = '#8a8f98';\n    ctx.setLineDash([4,3]);\n    ctx.lineWidth = 1.5;\n    ctx.strokeRect(1, 1, Math.max(a.w-2,0), Math.max(a.h-2,0));\n    ctx.setLineDash([]);\n\n    ctx.fillStyle = '#9aa0a8';\n    ctx.beginPath();\n    ctx.arc(a.w*0.28, a.h*0.32, Math.max(Math.min(a.w,a.h)*0.07, 3), 0, Math.PI*2);\n    ctx.fill();\n    ctx.beginPath();\n    ctx.moveTo(a.w*0.1, a.h*0.8);\n    ctx.lineTo(a.w*0.38, a.h*0.48);\n    ctx.lineTo(a.w*0.58, a.h*0.68);\n    ctx.lineTo(a.w*0.82, a.h*0.35);\n    ctx.lineTo(a.w*0.9, a.h*0.9);\n    ctx.lineTo(a.w*0.1, a.h*0.9);\n    ctx.closePath();\n    ctx.fill();\n\n    if (a.w > 40 && a.h > 24){\n      ctx.fillStyle = '#d7dbe0';\n      ctx.font = '10px monospace';\n      ctx.textAlign = 'center';\n      ctx.fillText(a.filename, a.w/2, a.h - 6);\n      ctx.textAlign = 'left';\n    }\n    ctx.restore();\n  }\n\n  function drawShapeAction(a){\n    switch(a.t){\n      case 'clear':\n        ctx.fillStyle = a.color || '#000';\n        ctx.fillRect(0,0,W,H);\n        break;\n      case 'rect':\n        if (a.fill){ ctx.fillStyle = a.fill; ctx.fillRect(a.x,a.y,a.w,a.h); }\n        if (a.stroke && a.sw > 0){ ctx.strokeStyle = a.stroke; ctx.lineWidth = a.sw; ctx.strokeRect(a.x,a.y,a.w,a.h); }\n        break;\n      case 'ellipse':\n        ctx.beginPath();\n        ctx.ellipse(a.x + a.w/2, a.y + a.h/2, Math.abs(a.w/2), Math.abs(a.h/2), 0, 0, Math.PI*2);\n        if (a.fill){ ctx.fillStyle = a.fill; ctx.fill(); }\n        if (a.stroke && a.sw > 0){ ctx.strokeStyle = a.stroke; ctx.lineWidth = a.sw; ctx.stroke(); }\n        break;\n      case 'line':\n        ctx.beginPath();\n        ctx.moveTo(a.x1,a.y1);\n        ctx.lineTo(a.x2,a.y2);\n        ctx.strokeStyle = a.stroke; ctx.lineWidth = a.sw || 1; ctx.stroke();\n        break;\n      case 'polygon': {\n        ctx.beginPath();\n        for (let i = 0; i < a.sides; i++){\n          const angle = -Math.PI/2 + i * 2 * Math.PI / a.sides;\n          const px = a.x + a.radius * Math.cos(angle);\n          const py = a.y + a.radius * Math.sin(angle);\n          if (i === 0) ctx.moveTo(px,py); else ctx.lineTo(px,py);\n        }\n        ctx.closePath();\n        if (a.fill){ ctx.fillStyle = a.fill; ctx.fill(); }\n        if (a.stroke && a.sw > 0){ ctx.strokeStyle = a.stroke; ctx.lineWidth = a.sw; ctx.stroke(); }\n        break;\n      }\n      case 'shape': {\n        ctx.beginPath();\n        for (let i = 0; i + 1 < a.points.length; i += 2){\n          const px = a.points[i], py = a.points[i+1];\n          if (i === 0) ctx.moveTo(px,py); else ctx.lineTo(px,py);\n        }\n        if (a.close){\n          ctx.closePath();\n          if (a.fill){ ctx.fillStyle = a.fill; ctx.fill(); }\n        }\n        if (a.stroke && a.sw > 0){ ctx.strokeStyle = a.stroke; ctx.lineWidth = a.sw; ctx.stroke(); }\n        break;\n      }\n      case 'text':\n        ctx.save();\n        ctx.translate(a.x, a.y);\n        ctx.rotate((a.rotation || 0) * Math.PI / 180);\n        ctx.fillStyle = a.color || '#000';\n        ctx.font = `${a.style||'normal'} ${a.weight||'normal'} ${a.height || 20}px ${a.font || 'sans-serif'}`;\n        ctx.textBaseline = 'top';\n        ctx.fillText(a.text, 0, 0);\n        ctx.restore();\n        break;\n      case 'image':\n        renderImageAction(a);\n        break;\n    }\n  }\n\n  // ---------- audio ----------\n  let audioCtx = null;\n  function ensureAudio(){\n    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n    if (audioCtx.state === 'suspended') audioCtx.resume();\n    return audioCtx;\n  }\n  function playTone(note, seconds, instrument){\n    const ac = ensureAudio();\n    const freq = 440 * Math.pow(2, (note - 69) / 12);\n    const osc = ac.createOscillator();\n    const gain = ac.createGain();\n    osc.type = instrument === 'bass' ? 'sawtooth' : 'sine';\n    osc.frequency.value = instrument === 'bass' ? freq / 2 : freq;\n    gain.gain.setValueAtTime(0.0001, ac.currentTime);\n    gain.gain.exponentialRampToValueAtTime(0.28, ac.currentTime + 0.02);\n    gain.gain.exponentialRampToValueAtTime(0.0001, ac.currentTime + Math.max(seconds, 0.1));\n    osc.connect(gain).connect(ac.destination);\n    osc.start();\n    osc.stop(ac.currentTime + seconds + 0.05);\n  }\n  function playSoundPlaceholder(){\n    const ac = ensureAudio();\n    const dur = 0.35;\n    const bufferSize = Math.floor(ac.sampleRate * dur);\n    const buffer = ac.createBuffer(1, bufferSize, ac.sampleRate);\n    const data = buffer.getChannelData(0);\n    for (let i = 0; i < bufferSize; i++){\n      data[i] = (Math.random()*2 - 1) * Math.exp(-4 * i / bufferSize);\n    }\n    const src = ac.createBufferSource();\n    src.buffer = buffer;\n    const gain = ac.createGain();\n    gain.gain.value = 0.25;\n    src.connect(gain).connect(ac.destination);\n    src.start();\n  }\n  function playSoundSamples(samples){\n    const ac = ensureAudio();\n    const buffer = ac.createBuffer(1, samples.length, ac.sampleRate);\n    const data = buffer.getChannelData(0);\n    for (let i = 0; i < samples.length; i++) data[i] = Math.max(-1, Math.min(1, samples[i]));\n    const src = ac.createBufferSource();\n    src.buffer = buffer;\n    src.connect(ac.destination);\n    src.start();\n  }\n  function playDecodedBuffer(buffer){\n    const ac = ensureAudio();\n    const src = ac.createBufferSource();\n    src.buffer = buffer;\n    src.connect(ac.destination);\n    src.start();\n  }\n\n  function delay(ms){ return new Promise(resolve => setTimeout(resolve, ms / speedMultiplier())); }\n\n  async function playActions(actions){\n    for (const a of actions){\n      if (a.t === 'note'){\n        playTone(a.note, a.seconds, a.instrument);\n      } else if (a.t === 'sound'){\n        if (a.samples){\n          log('playSound: ' + a.samples.length + ' raw samples (played for real)', 'sim');\n          playSoundSamples(a.samples);\n        } else if (audioBuffers[a.filename]){\n          log('playSound: ' + a.filename + ' (uploaded audio file)', 'sim');\n          playDecodedBuffer(audioBuffers[a.filename]);\n        } else {\n          log('playSound: ' + a.filename + ' (simulated — no real file to load)', 'sim');\n          playSoundPlaceholder();\n        }\n      } else if (a.t === 'image'){\n        const real = hasRealImage(a.filename);\n        log('drawImage: ' + a.filename + (real ? ' (uploaded image)' : ' (placeholder — no file uploaded with this name)'), 'sim');\n        renderImageAction(a);\n      } else if (a.t === 'pause'){\n        await delay(a.seconds * 1000);\n      } else {\n        drawShapeAction(a);\n      }\n    }\n    log('Done.', 'sys');\n  }\n\n\n  // ---------- resizable panels ----------\n  function makeResizable(handle, target, axis, min, max, invert){\n    handle.addEventListener('mousedown', (e) => {\n      e.preventDefault();\n      const startPos = axis === 'x' ? e.clientX : e.clientY;\n      const startSize = axis === 'x' ? target.offsetWidth : target.offsetHeight;\n      // Lock the target to a fixed flex-basis so flex-grow/shrink can't\n      // silently override the width/height we're about to set manually.\n      target.style.flexGrow = '0';\n      target.style.flexShrink = '0';\n      handle.classList.add('dragging');\n      document.body.style.cursor = axis === 'x' ? 'col-resize' : 'row-resize';\n      document.body.style.userSelect = 'none';\n\n      function onMove(ev){\n        const pos = axis === 'x' ? ev.clientX : ev.clientY;\n        let delta = pos - startPos;\n        if (invert) delta = -delta;\n        const newSize = Math.min(max, Math.max(min, startSize + delta));\n        if (axis === 'x') target.style.width = newSize + 'px';\n        else target.style.height = newSize + 'px';\n        refreshEditor();\n      }\n      function onUp(){\n        document.removeEventListener('mousemove', onMove);\n        document.removeEventListener('mouseup', onUp);\n        handle.classList.remove('dragging');\n        document.body.style.cursor = '';\n        document.body.style.userSelect = '';\n        refreshEditor();\n      }\n      document.addEventListener('mousemove', onMove);\n      document.addEventListener('mouseup', onUp);\n    });\n  }\n\n  makeResizable(document.getElementById('resizeFiles'), document.getElementById('filesPanel'), 'x', 140, 380, false);\n  makeResizable(document.getElementById('resizeCodePreview'), document.getElementById('previewPanel'), 'x', 220, 900, true);\n  makeResizable(document.getElementById('resizeConsole'), document.getElementById('consolePanel'), 'y', 100, 700, true);\n\n  runBtn.addEventListener('click', () => {\n    if (!activeFile){\n      resetConsole();\n      log('No file open — select a file from Files to run it.', 'sys');\n      return;\n    }\n    runProgram(getEditorContent());\n  });\n\n  // ---------- init ----------\n  initEditor();\n  renderFileList();\n  renderTabStrip();\n})();\n\n</script>\n<script>\nwindow.__THEATER_MOCKUP_JS__ = true;\n</script>\n</body>\n</html>\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1"
      ]
    }
  },
  "audit_log": "[{\"changed_at\":\"2026-08-11 19:50:01 +0000\",\"changed\":[\"require_edit_to_continue\"],\"changed_by_id\":22366,\"changed_by_email\":\"joi.anderson@code.org\"},{\"changed_at\":\"2026-08-11 19:52:49 +0000\",\"changed\":[],\"changed_by_id\":22366,\"changed_by_email\":\"joi.anderson@code.org\"},{\"changed_at\":\"2026-08-11 19:53:21 +0000\",\"changed\":[\"require_edit_to_continue\",\"initial_view_mode\"],\"changed_by_id\":22366,\"changed_by_email\":\"joi.anderson@code.org\"}]"
}]]></config>
