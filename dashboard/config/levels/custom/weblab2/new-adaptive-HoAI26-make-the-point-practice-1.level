<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-11-03T03:33:06.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": true,
    "start_sources": {
      "folders": {
      },
      "files": {
        "8fe9b7a8-9d39-4e8d-adaf-798a5b6c811c": {
          "id": "8fe9b7a8-9d39-4e8d-adaf-798a5b6c811c",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Clear Button Labels</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <div class=\"container\">\n        <h1>Make the Point: Clear Button Labels</h1>\n        <p>A good button label tells the visitor exactly what will happen when they click. Try to make these labels clear and action-oriented.</p>\n\n        <div class=\"section\">\n            <h2>Vague Button</h2>\n            <button class=\"sample-button vague-button\">Click Here</button>\n            <p class=\"description\">This button is vague. What does \"Click Here\" actually do?</p>\n        </div>\n\n        <div class=\"section\">\n            <h2>Type Your New Label:</h2>\n            <input type=\"text\" id=\"newLabelInput\" placeholder=\"e.g., 'Find My Location', 'Download Report'\" maxlength=\"30\">\n            <p class=\"description\">Type a clear, action-oriented label above.</p>\n        </div>\n\n        <div class=\"section\">\n            <h2>Proposed New Button</h2>\n            <button class=\"sample-button\" id=\"proposedButton\"></button>\n            <p class=\"description\">This button shows your proposed label. Does it clearly state its purpose?</p>\n        </div>\n    </div>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "e08c6fb5-748e-4e74-99a5-0a46532f2a81": {
          "id": "e08c6fb5-748e-4e74-99a5-0a46532f2a81",
          "name": "style.css",
          "contents": "body {\n    font-family: Arial, sans-serif;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    min-height: 100vh;\n    background-color: #f0f2f5;\n    color: #333;\n    margin: 0;\n    padding: 20px;\n    box-sizing: border-box;\n}\n\nh1 {\n    color: #0056b3;\n    margin-bottom: 10px;\n}\n\np {\n    margin-bottom: 25px;\n    text-align: center;\n    max-width: 600px;\n}\n\n.container {\n    background-color: #fff;\n    padding: 30px;\n    border-radius: 12px;\n    box-shadow: 0 4px 15px rgba(0,0,0,0.1);\n    width: 90%;\n    max-width: 500px;\n    text-align: center;\n}\n\n.section {\n    margin-bottom: 30px;\n    border-bottom: 1px solid #eee;\n    padding-bottom: 20px;\n}\n\n.section:last-child {\n    border-bottom: none;\n    margin-bottom: 0;\n    padding-bottom: 0;\n}\n\n.section h2 {\n    color: #4CAF50;\n    margin-top: 0;\n    margin-bottom: 15px;\n}\n\n.sample-button {\n    background-color: #007bff;\n    color: white;\n    padding: 12px 25px;\n    border: none;\n    border-radius: 25px;\n    font-size: 1.1em;\n    cursor: pointer;\n    margin: 10px 0;\n    transition: background-color 0.3s ease, transform 0.2s ease;\n}\n\n.sample-button:hover {\n    background-color: #0056b3;\n    transform: translateY(-2px);\n}\n\n.vague-button {\n    background-color: #ffc107;\n    color: #333;\n}\n\n.vague-button:hover {\n    background-color: #e0a800;\n    color: #333;\n}\n\n#newLabelInput {\n    width: calc(100% - 20px);\n    padding: 10px;\n    margin-top: 10px;\n    border: 1px solid #ccc;\n    border-radius: 8px;\n    font-size: 1em;\n    text-align: center;\n}\n\n.description {\n    font-size: 0.9em;\n    color: #666;\n    margin-top: 5px;\n    margin-bottom: 0;\n    text-align: center;\n}\n",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "75d81029-1bcd-4a71-b192-9cc8bbc8f83e": {
          "id": "75d81029-1bcd-4a71-b192-9cc8bbc8f83e",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const newLabelInput = document.getElementById('newLabelInput');\n    const proposedButton = document.getElementById('proposedButton');\n\n    // Set initial text for the proposed button\n    proposedButton.textContent = 'Proposed Button'; \n\n    newLabelInput.addEventListener('input', () => {\n        const newLabel = newLabelInput.value.trim();\n        if (newLabel === '') {\n            proposedButton.textContent = 'Proposed Button'; // Default text if input is empty\n        } else {\n            proposedButton.textContent = newLabel;\n        }\n    });\n});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
        "8fe9b7a8-9d39-4e8d-adaf-798a5b6c811c",
        "e08c6fb5-748e-4e74-99a5-0a46532f2a81",
        "75d81029-1bcd-4a71-b192-9cc8bbc8f83e"
      ]
    },
    "long_instructions": "TODOs:\r\n- Identify the vague label on the sample button in `index.html`.\r\n- Type a new, clear, action-oriented label into the input field.\r\n- Observe the 'Proposed New Button' update in real-time on the page.\r\n- Practice writing different clear button labels in the input field.",
