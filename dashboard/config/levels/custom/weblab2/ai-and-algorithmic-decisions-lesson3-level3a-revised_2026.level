      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Pet Care Simulator</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <header>\n    <h1>Pet Care Simulator</h1>\n    <p class=\"subtitle\">Find and fix the bugs so your pet is taken care of.</p>\n  </header>\n  <main>\n    <section id=\"dashboardCard\">\n      <div id=\"petPanel\">\n        <img id=\"petImage\" src=\"images/dog-face.png\" alt=\"Image of a hand-drawn dog's face\">\n      </div>\n      <div id=\"infoPanel\">\n        <div id=\"petInfo\">\n          <h2 id=\"petNameDisplay\">Mochi</h2>\n          <p id=\"petTypeDisplay\">Puppy</p>\n        </div>\n        <div class=\"statBox\">\n          <div class=\"iconWrapper\">\n            <img src=\"images/energy-icon.png\" alt=\"Energy icon\" class=\"statIcon\">\n          </div>\n          <div class=\"statMain\">\n            <h3>Energy</h3>\n            <p id=\"energyDisplay\">10</p>\n          </div>\n          <div class=\"statButtons\">\n            <button id=\"playButton\">Play (-2)</button>\n          </div>\n        </div>\n        <div class=\"statBox\">\n          <div class=\"iconWrapper\">\n            <img src=\"images/dog-food-icon.png\" alt=\"Hunger icon\" class=\"statIcon\">\n          </div>\n          <div class=\"statMain\">\n            <h3>Hunger</h3>\n            <p id=\"hungerDisplay\">5</p>\n          </div>\n          <div class=\"statButtons\">\n            <button id=\"feedButton\">Feed (-2)</button>\n          </div>\n        </div>\n        <div class=\"statBox\">\n          <div class=\"iconWrapper\">\n            <img src=\"images/mood-icon.png\" alt=\"Mood icon\" class=\"statIcon\">\n          </div>\n          <div class=\"statMain\">\n            <h3>Mood</h3>\n            <p id=\"moodDisplay\">8</p>\n          </div>\n          <div class=\"statButtons\">\n            <button id=\"petButton\">Pet (+1)</button>\n          </div>\n        </div>\n      </div>\n    </section>\n  </main>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": "* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n  font-family: Arial, sans-serif;\n}\nbody {\n  background: linear-gradient(to bottom, #fdf6f0, #f4e6d8);\n  color: #4a3427;\n  min-height: 100vh;\n}\nheader {\n  text-align: center;\n  padding: 24px 20px 12px;\n}\nheader h1 {\n  font-size: 2rem;\n  color: #6a4330;\n  letter-spacing: 0.4px;\n}\n.subtitle {\n  margin-top: 8px;\n  font-size: 1rem;\n  color: #8a6854;\n}\nmain {\n  max-width: 860px;\n  margin: 0 auto;\n  padding: 20px;\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\nsection {\n  background-color: #fffaf5;\n  border: 3px solid #e2c8ae;\n  border-radius: 20px;\n  padding: 20px;\n  box-shadow: 0 6px 0 rgba(120, 91, 62, 0.1);\n}\n#dashboardCard {\n  display: flex;\n  gap: 16px;\n  align-items: stretch;\n}\n#petPanel {\n  flex: 1.05;\n}\n#petPanel img {\n  width: 100%;\n  height: 100%;\n  min-height: 320px;\n  object-fit: cover;\n  display: block;\n  border-radius: 16px;\n  border: 3px solid #e2c8ae;\n  background-color: #f7ede2;\n}\n#infoPanel {\n  flex: 0.95;\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n}\n#petInfo {\n  background-color: #fff3e8;\n  border: 2px solid #ead2ba;\n  border-radius: 16px;\n  padding: 16px;\n  text-align: center;\n}\n#petNameDisplay {\n  font-size: 1.6rem;\n  color: #5a3d2d;\n  margin-bottom: 4px;\n}\n#petTypeDisplay {\n  font-size: 1rem;\n  color: #8d6b57;\n}\n.statBox {\n  background-color: #fff3e8;\n  border: 2px solid #ead2ba;\n  border-radius: 16px;\n  padding: 14px 16px;\n  display: grid;\n  grid-template-columns: 52px 1fr auto;\n  align-items: center;\n  column-gap: 14px;\n}\n.iconWrapper {\n  width: 48px;\n  height: 48px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n.statIcon {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  border-radius: 10px;\n  background-color: #f7ede2;\n  border: 2px solid #ead2ba;\n}\n.statMain {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  gap: 4px;\n  min-width: 0;\n}\n.statMain h3 {\n  font-size: 1rem;\n  color: #7a5843;\n  font-weight: bold;\n  line-height: 1.1;\n}\n.statMain p {\n  font-size: 2.2rem;\n  font-weight: bold;\n  color: #4a3427;\n  line-height: 1;\n}\n.statButtons {\n  display: flex;\n  gap: 8px;\n}\nbutton {\n  border: none;\n  border-radius: 10px;\n  padding: 8px 12px;\n  min-width: 80px;\n  font-size: 0.9rem;\n  font-weight: bold;\n  cursor: pointer;\n  color: #fffaf5;\n  transition: transform 0.15s ease, filter 0.15s ease;\n}\nbutton:hover {\n  transform: translateY(-1px);\n  filter: brightness(1.05);\n}\nbutton:active {\n  transform: translateY(1px);\n}\n#playButton {\n  background-color: #f29e4c;\n}\n#feedButton {\n  background-color: #e76f51;\n}\n#petButton {\n  background-color: #8e7dbe;\n}\n@media (max-width: 700px) {\n  #dashboardCard {\n    flex-direction: column;\n  }\n  #petPanel img {\n    min-height: 240px;\n  }\n  .statBox {\n    grid-template-columns: 44px 1fr auto;\n    column-gap: 12px;\n  }\n  .statMain p {\n    font-size: 2rem;\n  }\n  button {\n    min-width: 72px;\n    padding: 8px 10px;\n  }\n}",
          "folderId": "0",
          "active": false
        },
