          "name": "script.js",
          "contents": "let energy = 10;\nlet hunger = 5;\nlet mood = 8;\n\ndocument.getElementById(\"playButton\").addEventListener(\"click\", function() {\n  energy = energy + 2;\n  let energyDisplay = document.getElementById(\"energyDisplay\");\n  energyDisplay.textContent = energy;\n});\n\ndocument.getElementById(\"feedButton\").addEventListener(\"click\", function() {\n  hunger = hunger - 2;\n  let hungerDisplay = document.getElementById(\"hungerDisplay\");\n  hungerDisplay.textContent = hungar;\n});\n\ndocument.getElementById(\"petButton\").addEventListener(\"click\", function() {\n  mood = mood + 1;\n  let moodDisplay = document.getElementById(\"moodDisplay\");\n  moodDisplay.textContent = moood;\n});",
