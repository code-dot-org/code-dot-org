        "11": {
          "id": "11",
          "name": "triage.md",
          "contents": "Bug Triage\n\nBug 1\n\nWhat I observed:\nSeverity (high / medium / low):\nMy hypothesis:\n\n---\n\nBug 2\n\nWhat I observed:\nSeverity (high / medium / low):\nMy hypothesis:\n\n---\n\nBug 3\n\nWhat I observed:\nSeverity (high / medium / low):\nMy hypothesis:\n\n---\n\nFix order\n\nI'll fix these in this order:\n\n1.\n2.\n3.\n\nBecause:\n",
          "folderId": "0",
          "active": true
        }
