        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Weekly Drop Tracker</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n    <script defer src=\"script.js\"></script>\n  </head>\n  <body>\n    <h1 class=\"title\">🔥 Weekly Drop Tracker</h1>\n    <p class=\"subtitle\">Tap a day to see what's dropping</p>\n    <main class=\"container\">\n      <section class=\"left\">\n        <img id=\"image\" class=\"image\" src=\"images/default.png\" alt=\"Drop illustration\" />\n      </section>\n      <section class=\"right\">\n        <div id=\"textArea\" class=\"textArea\" aria-live=\"polite\">Select a day to see the drop.</div>\n        <div class=\"buttons\">\n          <button id=\"mondayButton\" type=\"button\">Monday</button>\n          <button id=\"tuesdayButton\" type=\"button\">Tuesday</button>\n          <button id=\"wednesdayButton\" type=\"button\">Wednesday</button>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "* {\n  box-sizing: border-box;\n}\nhtml, body {\n  height: 100%;\n}\nbody {\n  margin: 0;\n  font-family: Arial, sans-serif;\n  background: #0d0d0d;\n  color: #f0f0f0;\n}\n.title {\n  text-align: center;\n  margin: 24px 0 4px;\n  font-size: 2rem;\n  color: #ffffff;\n}\n.subtitle {\n  text-align: center;\n  margin: 0 0 16px;\n  font-size: 1rem;\n  color: #888;\n}\n.container {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 24px;\n  padding: 24px;\n  max-width: 1000px;\n  margin: 0 auto;\n}\n.left {\n  background: #1a1a1a;\n  border: 2px solid #333;\n  border-radius: 16px;\n  padding: 16px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n}\n.image {\n  display: block;\n  max-width: 100%;\n  height: auto;\n  border-radius: 12px;\n  object-fit: contain;\n}\n.right {\n  display: flex;\n  flex-direction: column;\n  gap: 24px;\n}\n.textArea {\n  min-height: 120px;\n  border: 2px solid #333;\n  border-radius: 16px;\n  padding: 20px;\n  background: #1a1a1a;\n  font-size: 1.1rem;\n  line-height: 1.6;\n  color: #f0f0f0;\n}\n.buttons {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  width: 240px;\n  margin-inline: auto;\n}\n.buttons button {\n  padding: 12px 16px;\n  font-size: 1rem;\n  border-radius: 12px;\n  border: 2px solid #444;\n  background: #1a1a1a;\n  color: #f0f0f0;\n  cursor: pointer;\n}\n.buttons button:hover {\n  background: #2a2a2a;\n  border-color: #ff4d4d;\n  color: #ff4d4d;\n}\n.buttons button:active {\n  transform: translateY(1px);\n}\n@media (max-width: 800px) {\n  .container {\n    grid-template-columns: 1fr;\n  }\n  .buttons {\n    width: 100%;\n  }\n}",
