    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n  <title>Daily Advice</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n<body>\n\n  <main class=\"app\">\n    <header class=\"app-header\">\n      <p class=\"eyebrow\">✦ a little wisdom ✦</p>\n      <h1>Daily Advice</h1>\n    </header>\n\n    <section class=\"scroll-card\" id=\"adviceCard\">\n      <div class=\"scroll-edge scroll-edge-top\" aria-hidden=\"true\"></div>\n      <p class=\"advice-label\">TODAY'S ADVICE</p>\n      <p class=\"advice-text\" id=\"adviceText\">Tap below for your first piece of advice.</p>\n      <div class=\"scroll-edge scroll-edge-bottom\" aria-hidden=\"true\"></div>\n    </section>\n\n    <button id=\"getAdviceButton\">\n      <span class=\"btn-icon\">🔮</span> Get advice\n    </button>\n  </main>\n\n</body>\n<script src=\"script.js\"></script>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "const getAdviceButton = document.getElementById(\"getAdviceButton\");\nconst adviceText      = document.getElementById(\"adviceText\");\n\ngetAdviceButton.addEventListener(\"click\", () => {\n  fetch(\"https://api.adviceslip.com/advice\")\n    .then(response => response.json())\n    .then(data => {\n      adviceText.textContent = data.slip.advice;\n    })\n});",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "/* ────────────────────────────────────────\n   TOKENS\n──────────────────────────────────────── */\n:root {\n  --ink:       #232020;\n  --paper:     #FAF6EF;\n  --plum:      #5B3A5C;\n  --plum-dark: #3E2840;\n  --gold:      #C7973E;\n  --muted:     #8A7F78;\n  --card-bg:   #FFFDF9;\n}\n\n/* ────────────────────────────────────────\n   RESET / BASE\n──────────────────────────────────────── */\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  font-family: 'Georgia', 'Times New Roman', serif;\n  background: var(--plum-dark);\n  background-image:\n    radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.05), transparent 40%),\n    radial-gradient(circle at 80% 80%, rgba(255, 255, 255, 0.04), transparent 40%);\n  color: var(--ink);\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 20px;\n}\n\n/* ────────────────────────────────────────\n   APP SHELL — mobile-first, max 400px\n──────────────────────────────────────── */\n.app {\n  width: 100%;\n  max-width: 400px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 20px;\n}\n\n/* ────────────────────────────────────────\n   HEADER\n──────────────────────────────────────── */\n.app-header {\n  text-align: center;\n  color: var(--paper);\n}\n\n.eyebrow {\n  font-family: system-ui, sans-serif;\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: var(--gold);\n  margin-bottom: 6px;\n}\n\n.app-header h1 {\n  font-size: 28px;\n  font-weight: 700;\n  letter-spacing: -0.01em;\n}\n\n/* ────────────────────────────────────────\n   SCROLL CARD\n──────────────────────────────────────── */\n.scroll-card {\n  position: relative;\n  width: 100%;\n  background: var(--card-bg);\n  border-radius: 6px;\n  padding: 32px 24px 30px;\n  box-shadow:\n    0 1px 2px rgba(0, 0, 0, 0.08),\n    0 12px 28px rgba(0, 0, 0, 0.25);\n  text-align: center;\n}\n\n.scroll-edge {\n  position: absolute;\n  left: 0;\n  width: 100%;\n  height: 10px;\n  background: repeating-linear-gradient(\n    90deg,\n    var(--plum) 0,\n    var(--plum) 14px,\n    var(--gold) 14px,\n    var(--gold) 16px\n  );\n}\n\n.scroll-edge-top { top: 0; border-radius: 6px 6px 0 0; }\n.scroll-edge-bottom { bottom: 0; border-radius: 0 0 6px 6px; }\n\n.advice-label {\n  font-family: system-ui, sans-serif;\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: 0.18em;\n  color: var(--muted);\n  margin-bottom: 14px;\n}\n\n.advice-text {\n  font-size: 19px;\n  line-height: 1.55;\n  font-style: italic;\n  color: var(--plum-dark);\n  min-height: 3.6em;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n/* ────────────────────────────────────────\n   BUTTON\n──────────────────────────────────────── */\nbutton {\n  width: 100%;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  padding: 14px;\n  font-family: system-ui, sans-serif;\n  font-size: 16px;\n  font-weight: 700;\n  letter-spacing: 0.02em;\n  background: var(--gold);\n  color: var(--plum-dark);\n  border: none;\n  border-radius: 100px;\n  cursor: pointer;\n  transition: transform 0.1s ease, box-shadow 0.15s ease;\n  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);\n}\n\nbutton:hover {\n  transform: translateY(-1px);\n}\n\nbutton:active {\n  transform: translateY(0);\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);\n}\n\n.btn-icon {\n  font-size: 18px;\n}\n\n/* ────────────────────────────────────────\n   SMALL SCREEN TWEAKS (< 360px)\n──────────────────────────────────────── */\n@media (max-width: 360px) {\n  .app-header h1 { font-size: 24px; }\n  .advice-text { font-size: 17px; }\n  .scroll-card { padding: 28px 18px 26px; }\n}\n\n/* ────────────────────────────────────────\n   REDUCED MOTION\n──────────────────────────────────────── */\n@media (prefers-reduced-motion: reduce) {\n  button { transition: none; }\n}",
          "folderId": "0",
          "active": false
        }
      },
      "openFiles": [
        "2"
      ]
    },
