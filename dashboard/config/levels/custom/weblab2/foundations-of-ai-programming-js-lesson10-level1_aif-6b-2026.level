  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-08-25T21:12:52.000Z",
  "level_num": "custom",
  "user_id": 18762,
  "properties": {
    "require_edit_to_continue": "true",
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html>\n<head>\n    <title>Temperature Logic</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n    <div class=\"container\">\n        <h1>Fashion Thermometer</h1>\n        \n        <div class=\"thermometer\">\n            <div id=\"mercury\"></div>\n        </div>\n\n        <h2 id=\"message\">Wear pants.</h2>\n        \n        <p>Temperature: <span id=\"temp-number\">60</span>°F</p>\n        <input type=\"range\" id=\"slider\" min=\"0\" max=\"100\" value=\"60\">\n    </div>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "// Link HTML elements to JS variables\nconst slider = document.getElementById(\"slider\");\nconst mercury = document.getElementById(\"mercury\");\nconst message = document.getElementById(\"message\");\nconst tempNumber = document.getElementById(\"temp-number\");\n\n// Define the function\nconst updateThermometer = () => {\n    // Get the current number from the slider\n    let temperature = slider.value;\n\n    // Update the text and the red bar height\n    tempNumber.innerText = temperature;\n    mercury.style.height = temperature + \"%\";\n\n    // Conditional Logic\n    if (temperature > 70) {\n        message.innerText = \"Put on shorts!\";\n        message.style.color = \"orange\";\n        document.body.style.backgroundColor = \"#ff7e5f\"; // Warm Orange\n    } else {\n        message.innerText = \"Wear pants.\";\n        message.style.color = \"blue\";\n        document.body.style.backgroundColor = \"#70a1ff\"; // Cool Blue\n    }\n};\n\n// Tell the slider to call the updateThermometer function\nslider.addEventListener(\"input\", updateThermometer);",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": "/* Basic Page Setup */\nbody {\n    font-family: sans-serif;\n    text-align: center;\n    background-color: #f0f0f0;\n    padding: 20px;\n}\n\n/* A white box to hold our app */\n.container {\n    background: white;\n    padding: 20px;\n    border-radius: 10px;\n    max-width: 400px; /* Limits width on big screens */\n    margin: auto;     /* Centers the box on the screen */\n}\n\n/* The Thermometer \"Tube\" */\n.thermometer {\n    width: 40px;\n    height: 200px;\n    background-color: #ddd;\n    border: 3px solid black;\n    border-radius: 20px;\n    margin: 20px auto; /* Centers the thermometer */\n    \n    /* This makes the red part grow from the bottom */\n    display: flex;\n    flex-direction: column-reverse;\n    overflow: hidden;\n}\n\n/* The \"Mercury\" (the red part) */\n#mercury {\n    width: 100%;\n    height: 60%; /* This is what the JS will change */\n    background-color: red;\n}\n\n/* The Slider */\n#slider {\n    width: 100%;\n}",
          "folderId": "0",
          "active": false
        }
      },
