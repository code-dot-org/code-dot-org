  "properties": {
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n    <title>Eco Actions</title>\n    <link rel=\"stylesheet\" href=\"style.css\" />\n    <script defer src=\"script.js\"></script>\n  </head>\n  <body>\n    <h1 class=\"title\">Eco Actions</h1>\n    <main class=\"container\">\n      <section class=\"left\">\n        <img id=\"main-image\" src=\"main-image.png\" alt=\"Eco actions illustration showing water, energy, and reuse\" />\n      </section>\n      <section class=\"right\">\n        <div id=\"output\" class=\"output\" aria-live=\"polite\">Choose a category to get one tiny habit to try today.</div>\n        <div class=\"buttons\">\n          <button id=\"water-btn\" type=\"button\">Water</button>\n          <button id=\"energy-btn\" type=\"button\">Energy</button>\n          <button id=\"transit-btn\" type=\"button\">Transit</button>\n          <button id=\"food-btn\" type=\"button\">Food</button>\n          <button id=\"reuse-btn\" type=\"button\">Reuse</button>\n        </div>\n      </section>\n    </main>\n  </body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// SELECTORS and LISTENERS: connect user actions (clicks) to handlers for specific UI elements\ndocument.querySelector('#water-btn').addEventListener('click', () => {\n  // UI CHANGE: show a new message in the output box\n  document.querySelector('#output').textContent = 'Water: Turn off the tap while brushing—save a few gallons today.';\n});\n\n// TODO: Attach an event listener to the Energy button\n\n  // TODO: update text for Energy\n\n// TODO: Attach an event listener to the Transit button\n\n  // TODO: update text for Transit\n\n// TODO: Attach an event listener to the Food button\n\n  // TODO: update text for Food\n\n// TODO: Attach an event listener to the Reuse button\n\n  // TODO: update text for Reuse\n\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "* { box-sizing: border-box; }\nhtml, body { height: 100%; }\nbody { margin: 0; font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; background: #3ba36a; color: #1f2937; }\n\n.title { text-align: center; margin: 16px 0 0; font-size: 1.75rem; letter-spacing: 0.5px; color: #0f172a; }\n\n.container { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; padding: 24px; max-width: 1000px; margin: 0 auto; }\n.left { background: #fff; border: 1px solid #e5e7eb; border-radius: 12px; padding: 16px; display: flex; align-items: center; justify-content: center; overflow: hidden; }\n#main-image { display: block; max-width: 100%; height: auto; border-radius: 8px; object-fit: contain; }\n\n.right { display: flex; flex-direction: column; gap: 24px; }\n.output { min-height: 120px; border: 1px dashed #cbd5e1; border-radius: 12px; padding: 16px; background: #fff; font-size: 1.1rem; line-height: 1.6; color: #111827; }\n\n.buttons { display: flex; flex-direction: column; gap: 12px; width: 240px; margin-inline: auto; }\n.buttons button { padding: 12px 16px; font-size: 1rem; border-radius: 10px; border: 1px solid #1f2937; background: #ffffff; color: #111827; cursor: pointer; transition: background-color 120ms ease, color 120ms ease, border-color 120ms ease; }\n.buttons button:hover { background: #111827; color: #ffffff; border-color: #111827; }\n.buttons button:active { transform: translateY(1px); }\n\n@media (max-width: 800px) {\n  .container { grid-template-columns: 1fr; }\n  .buttons { width: 100%; }\n}",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "main-image.png",
          "language": "png",
          "contents": "",
