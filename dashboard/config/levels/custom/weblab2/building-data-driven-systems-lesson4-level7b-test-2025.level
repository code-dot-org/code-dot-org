    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Backpack Upgrade</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n\n  <div class=\"card\">\n    <h2>My Gear</h2>\n    <div class=\"stats\">\n      <p>Color: <span id=\"display-color\"></span></p>\n      <p>Size: <span id=\"display-capacity\"></span>L</p>\n      <p>Laptop Pocket: <span id=\"display-laptop\"></span></p>\n    </div>\n  </div>\n\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "// Object\nconst backpack = {\n  color: \"blue\",\n  capacityLiters: 20,\n  hasLaptopPocket: false\n};\n\n// Update\n\n\n\n// Render function\nfunction render() {\n  document.getElementById(\"display-color\").textContent = backpack.color;\n  document.getElementById(\"display-capacity\").textContent = backpack.capacityLiters; \n  if (backpack.hasLaptopPocket) {\n    document.getElementById(\"display-laptop\").textContent = \"Yes\";\n  } else {\n    document.getElementById(\"display-laptop\").textContent = \"No\";\n  }\n\n}\n\nrender();",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "body {\n  font-family: 'Roboto', sans-serif;\n  background-color: #2c3e50;\n  color: #333;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  height: 100vh;\n  margin: 0;\n}\n\n.card {\n  background-color: #ecf0f1;\n  width: 280px;\n  padding: 20px;\n  border-radius: 8px;\n  border-left: 10px solid #e67e22; /* Orange accent for \"gear\" look */\n  box-shadow: 0 10px 20px rgba(0,0,0,0.3);\n}\n\nh2 {\n  margin-top: 0;\n  text-transform: uppercase;\n  letter-spacing: 2px;\n  color: #2c3e50;\n  border-bottom: 2px solid #bdc3c7;\n  padding-bottom: 10px;\n}\n\n.stats p {\n  background: white;\n  padding: 10px;\n  margin: 8px 0;\n  border-radius: 4px;\n  display: flex;\n  justify-content: space-between;\n  font-weight: 500;\n}\n\nspan {\n  color: #e67e22;\n  font-weight: bold;\n}",
          "folderId": "0",
          "active": false
        }
      },
