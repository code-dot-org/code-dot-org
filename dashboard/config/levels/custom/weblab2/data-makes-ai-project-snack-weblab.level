      },
      "disableCommitMessages": true
    },
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>User Profiles: After-School Snacks</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <header class=\"console\">\n    <div class=\"console-lights\" aria-hidden=\"true\">\n      <span class=\"light light-orange\"></span>\n      <span class=\"light light-mustard\"></span>\n      <span class=\"light light-teal\"></span>\n    </div>\n    <h1 class=\"console-title\">User Profiles</h1>\n    <p class=\"console-pack\">After-School Snacks</p>\n  </header>\n\n  <main>\n    <p id=\"load-error\" class=\"load-error\" role=\"alert\" hidden>\n      User Profiles could not start. Reload the page, and tell your teacher if you still see this message.\n    </p>\n\n    <section id=\"pick-view\" aria-labelledby=\"pick-heading\">\n      <p>\n        These four users want to use a Snack Checker model. Pick the <b>two</b> you want to investigate.\n        The machine will print a case file for each one.\n      </p>\n      <ul id=\"user-list\" class=\"user-list\"></ul>\n      <p id=\"pick-status\" class=\"pick-status\" aria-live=\"polite\"></p>\n      <button id=\"print-button\" class=\"primary-button\" type=\"button\" disabled>Print case files</button>\n    </section>\n\n    <section id=\"files-view\" aria-labelledby=\"files-heading\" hidden>\n      <h2 id=\"files-heading\" tabindex=\"-1\">Your case files</h2>\n      <p>\n        Read what each person wants to know. Then use the clues to decide what you will test.\n      </p>\n\n      <div id=\"case-tabs\" class=\"case-tabs\" role=\"tablist\" aria-label=\"Switch between your two case files\"></div>\n      <div id=\"case-panels\"></div>\n\n      <aside class=\"guide\" aria-labelledby=\"guide-heading\">\n        <h3 id=\"guide-heading\">In your activity guide</h3>\n        <ol>\n          <li>Write who each person is and what they want to know.</li>\n          <li>Use the clues to decide what you will enter in Make a prediction to find out.</li>\n        </ol>\n      </aside>\n\n      <button id=\"restart-button\" class=\"secondary-button\" type=\"button\">Pick different people</button>\n    </section>\n  </main>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": ":root {\n  --cream: #f4ead5;\n  --paper: #fffdf6;\n  --navy: #1b2a41;\n  --teal: #0e6e6e;\n  --orange: #b8400f;\n  --mustard: #e0a526;\n  --font-body: \"Trebuchet MS\", \"Segoe UI\", Arial, sans-serif;\n  --font-machine: \"Courier New\", Courier, monospace;\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nbody {\n  margin: 0;\n  background: var(--cream);\n  color: var(--navy);\n  font-family: var(--font-body);\n  font-size: 1rem;\n  line-height: 1.5;\n}\n\nmain {\n  max-width: 46rem;\n  margin-inline: auto;\n  padding: 1rem;\n}\n\nh1,\nh2,\nh3,\nh4,\np {\n  margin-block: 0 0.5rem;\n}\n\nh2 {\n  font-size: 1.25rem;\n}\n\nh2:focus {\n  outline: none;\n}\n\nh3 {\n  font-size: 1.125rem;\n}\n\nh4 {\n  margin-block-start: 0.75rem;\n  font-family: var(--font-machine);\n  font-size: 0.875rem;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--teal);\n}\n\nbutton {\n  font: inherit;\n  color: inherit;\n  cursor: pointer;\n}\n\nbutton:focus-visible {\n  outline: 3px solid var(--orange);\n  outline-offset: 3px;\n}\n\n/* Console header */\n\n.console {\n  padding: 0.75rem 1rem;\n  background: var(--navy);\n  color: var(--cream);\n  border-block-end: 6px solid var(--mustard);\n  text-align: center;\n}\n\n.console-lights {\n  display: flex;\n  justify-content: center;\n  gap: 0.5rem;\n  margin-block-end: 0.375rem;\n}\n\n.light {\n  width: 0.75rem;\n  height: 0.75rem;\n  border: 2px solid var(--cream);\n  border-radius: 50%;\n}\n\n.light-orange {\n  background: var(--orange);\n}\n\n.light-mustard {\n  background: var(--mustard);\n}\n\n.light-teal {\n  background: var(--teal);\n}\n\n.console-title {\n  margin: 0;\n  font-family: var(--font-machine);\n  font-size: clamp(1.375rem, 5vw, 2rem);\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n}\n\n.console-pack {\n  margin: 0;\n  font-family: var(--font-machine);\n  font-size: 0.875rem;\n  color: var(--mustard);\n}\n\n.load-error {\n  padding: 0.75rem;\n  background: var(--paper);\n  border: 2px solid var(--orange);\n  border-radius: 0.5rem;\n}\n\n/* Pick view */\n\n.user-list {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));\n  gap: 0.75rem;\n  margin-block: 0.75rem;\n  padding: 0;\n  list-style: none;\n}\n\n.user-button {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  width: 100%;\n  min-height: 100%;\n  padding: 0.625rem;\n  background: var(--paper);\n  border: 2px solid var(--navy);\n  border-radius: 0.75rem;\n  box-shadow: 4px 4px 0 var(--navy);\n  text-align: start;\n}\n\n.user-button[aria-pressed=\"true\"] {\n  border-color: var(--teal);\n  box-shadow: 4px 4px 0 var(--teal);\n  transform: translate(2px, 2px);\n}\n\n.user-photo {\n  flex: none;\n  width: 4.5rem;\n  height: 4.5rem;\n  object-fit: cover;\n  background: var(--cream);\n  border: 2px solid var(--navy);\n  border-radius: 50%;\n}\n\n.user-text {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 0.125rem;\n}\n\n.user-name {\n  font-weight: 700;\n}\n\n.user-role {\n  font-size: 0.875rem;\n}\n\n.user-tag {\n  margin-block-start: 0.25rem;\n  padding: 0.0625rem 0.5rem;\n  border: 2px solid var(--navy);\n  border-radius: 1rem;\n  font-family: var(--font-machine);\n  font-size: 0.8125rem;\n}\n\n.user-button[aria-pressed=\"true\"] .user-tag {\n  background: var(--teal);\n  border-color: var(--teal);\n  color: #ffffff;\n  font-weight: 700;\n}\n\n.pick-status {\n  min-height: 1.5rem;\n  font-family: var(--font-machine);\n  font-size: 0.9375rem;\n}\n\n.primary-button,\n.secondary-button {\n  min-height: 2.75rem;\n  padding: 0.5rem 1.25rem;\n  border: 2px solid var(--navy);\n  border-radius: 2rem;\n  font-family: var(--font-machine);\n  font-weight: 700;\n  letter-spacing: 0.04em;\n}\n\n.primary-button {\n  background: var(--orange);\n  color: #ffffff;\n  box-shadow: 0 4px 0 var(--navy);\n}\n\n.primary-button:disabled {\n  background: var(--cream);\n  color: var(--navy);\n  border-style: dashed;\n  box-shadow: none;\n  cursor: not-allowed;\n}\n\n.secondary-button {\n  background: var(--paper);\n}\n\n/* Case file tabs */\n\n.case-tabs {\n  position: sticky;\n  inset-block-start: 0;\n  z-index: 1;\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 0.5rem;\n  padding-block: 0.5rem;\n  background: var(--cream);\n}\n\n.case-tab {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  min-height: 3.5rem;\n  padding: 0.375rem 0.75rem;\n  background: var(--paper);\n  border: 2px solid var(--navy);\n  border-block-end-width: 6px;\n  border-radius: 0.75rem 0.75rem 0 0;\n  text-align: start;\n}\n\n.case-tab[aria-selected=\"true\"] {\n  background: var(--navy);\n  border-block-end-color: var(--mustard);\n  color: var(--cream);\n}\n\n.case-tab-number {\n  font-family: var(--font-machine);\n  font-size: 0.8125rem;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n}\n\n.case-tab-name {\n  font-weight: 700;\n}\n\n/* Case file */\n\n.case-file {\n  padding: 1rem;\n  background: var(--paper);\n  border: 2px solid var(--navy);\n  border-radius: 0 0 0.75rem 0.75rem;\n}\n\n.case-top {\n  display: grid;\n  grid-template-columns: minmax(8rem, 13rem) minmax(0, 1fr);\n  align-items: start;\n  gap: 1rem;\n}\n\n.case-photo {\n  display: block;\n  width: 100%;\n  aspect-ratio: 1;\n  object-fit: cover;\n  background: var(--cream);\n  border: 2px solid var(--navy);\n  border-radius: 0.75rem;\n  box-shadow: 4px 4px 0 var(--mustard);\n}\n\n.case-name,\n.case-role {\n  margin: 0;\n}\n\n.case-message {\n  margin: 0.5rem 0 0;\n  padding: 0.5rem 0.75rem;\n  background: var(--cream);\n  border-inline-start: 6px solid var(--mustard);\n  border-radius: 0.25rem;\n}\n\n.case-message p {\n  margin: 0;\n}\n\n.clue-heading {\n  margin-block: 1rem 0.375rem;\n}\n\n.clue-list {\n  display: grid;\n  gap: 0.5rem;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n  counter-reset: clue;\n}\n\n.clue {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.625rem;\n  padding: 0.5rem 0.75rem;\n  border: 2px solid var(--teal);\n  border-radius: 0.5rem;\n  counter-increment: clue;\n}\n\n.clue::before {\n  content: counter(clue);\n  flex: none;\n  min-width: 1.75rem;\n  padding: 0.0625rem 0;\n  background: var(--teal);\n  border-radius: 50%;\n  color: #ffffff;\n  font-family: var(--font-machine);\n  font-weight: 700;\n  text-align: center;\n}\n\n@media (max-width: 26rem) {\n  .case-top {\n    grid-template-columns: 1fr;\n  }\n\n  .case-photo {\n    max-width: 14rem;\n    margin-inline: auto;\n  }\n}\n\n.guide {\n  margin-block: 0.75rem 1rem;\n  padding: 0.75rem 1rem;\n  background: var(--navy);\n  color: var(--cream);\n  border-radius: 0.75rem;\n}\n\n.guide h3 {\n  font-family: var(--font-machine);\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  color: var(--mustard);\n}\n\n.guide ol {\n  margin: 0;\n  padding-inline-start: 1.25rem;\n}\n\n@media (prefers-reduced-motion: no-preference) {\n  .user-button {\n    transition: transform 0.1s ease-out;\n  }\n\n  .case-file {\n    animation: print-out 0.3s ease-out both;\n  }\n}\n\n@keyframes print-out {\n  from {\n    opacity: 0;\n    transform: translateY(-1.5rem);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "'use strict';\n\nconst PLACEHOLDER_IMAGE = 'placeholder.svg';\nconst PICK_LIMIT = 2;\n\nconst USERS = [\n  {\n    id: 'okafor',\n    name: 'Ms. Okafor',\n    role: 'After-school program director',\n    image: 'case-file-1.jpg',\n    alt: 'Ms. Okafor stands behind a snack table with a bowl of white rice, a stack of corn tortillas, and a bowl of tortilla chips.',\n    message: 'A lot of our kids bring food from home for snack. Plain rice and corn tortillas come up all the time. I want to know if the Snack Checker gives the same answer for those as it does for a bag of chips.',\n    clues: [\n      'Plain rice, corn tortillas, and tortilla chips are all grain foods.',\n      'A serving of each one has almost no sugar, no vitamin C, and less than 200 mg of sodium.',\n      'A serving of each one has between 100 and 200 calories. They do not need a fridge.'\n    ]\n  },\n  {\n    id: 'devon',\n    name: 'Devon',\n    role: '8th grader who restocks the snack cart',\n    image: 'case-file-2.jpg',\n    alt: 'Devon stands next to a rolling snack cart and holds up a vanilla pudding cup.',\n    message: 'I restock the snack cart on Tuesdays and Thursdays. The cart does not have a fridge, so the pudding cups just sit on the shelf. Does the Snack Checker give the same answer for a pudding cup whether it is cold or not?',\n    clues: [\n      'A vanilla pudding cup counts as a sweet. One cup has 17 grams of sugar.',\n      'One cup has under 100 calories, about 135 mg of sodium, and no vitamin C.',\n      'At the store, pudding cups are sold from the cold case. On Devon\\u2019s cart, they sit on a shelf.'\n    ]\n  },\n  {\n    id: 'rivera',\n    name: 'Coach Rivera',\n    role: 'Soccer coach',\n    image: 'case-file-3.jpg',\n    alt: 'Coach Rivera holds a clipboard next to a bench with a soft pretzel and turkey jerky.',\n    message: 'My team is worn out after practice, and they always ask for something salty. I have two ideas. Can you run them through the Snack Checker before I buy anything?',\n    clues: [\n      'Her first idea is half of a large soft pretzel. It is a grain food with about 480 mg of sodium and about 190 calories.',\n      'Her second idea is a small pack of turkey jerky. It is a protein food with about 450 mg of sodium and under 100 calories.',\n      'Neither snack has much sugar or any vitamin C, and neither one needs a fridge.'\n    ]\n  },\n  {\n    id: 'priya',\n    name: 'Priya',\n    role: '7th grader with soccer after school',\n    image: 'case-file-4.jpg',\n    alt: 'Priya wears a soccer jersey and backpack and holds a container of trail mix.',\n    message: 'I have soccer right after school, and practice goes until 6. A small snack is not enough for me, so I have been bringing trail mix. Would that pass the Snack Checker?',\n    clues: [\n      'Her trail mix is nuts and raisins with no added salt.',\n      'A serving has about 230 calories and 14 grams of sugar. Most of the sugar comes from the raisins.',\n      'It has almost no sodium or vitamin C, and it stays in her backpack all day.'\n    ]\n  }\n];\n\nconst language = document.documentElement.lang || 'en';\nconst numberFormat = new Intl.NumberFormat(language);\n\nconst pickedIds = [];\nlet caseFiles = [];\n\nconst pickView = document.getElementById('pick-view');\nconst filesView = document.getElementById('files-view');\nconst userList = document.getElementById('user-list');\nconst pickStatus = document.getElementById('pick-status');\nconst printButton = document.getElementById('print-button');\nconst restartButton = document.getElementById('restart-button');\nconst caseTabs = document.getElementById('case-tabs');\nconst casePanels = document.getElementById('case-panels');\n\nfunction createElement(tag, className, text) {\n  const element = document.createElement(tag);\n  if (className) {\n    element.className = className;\n  }\n  if (text) {\n    element.textContent = text;\n  }\n  return element;\n}\n\nfunction createUserImage(user, className) {\n  const image = createElement('img', className);\n  image.alt = user.alt;\n  image.addEventListener('error', () => {\n    image.src = PLACEHOLDER_IMAGE;\n  }, { once: true });\n  image.src = user.image;\n  return image;\n}\n\n/* Pick view */\n\nfunction getPickStatusText(count, limitReached) {\n  if (limitReached) {\n    return 'You already picked two people. Unpick one if you want to change.';\n  }\n  if (count === 0) {\n    return 'You have not picked anyone yet.';\n  }\n  if (count === 1) {\n    return 'You picked 1 person. Pick 1 more.';\n  }\n  return 'You picked 2 people. Print their case files when you are ready.';\n}\n\nfunction updatePickState(limitReached) {\n  userList.querySelectorAll('.user-button').forEach((button) => {\n    const isPicked = pickedIds.includes(button.dataset.userId);\n    button.setAttribute('aria-pressed', String(isPicked));\n    button.querySelector('.user-tag').textContent = isPicked ? 'Picked' : 'Not picked';\n  });\n  pickStatus.textContent = getPickStatusText(pickedIds.length, limitReached);\n  printButton.disabled = pickedIds.length !== PICK_LIMIT;\n}\n\nfunction togglePick(userId) {\n  const index = pickedIds.indexOf(userId);\n  if (index !== -1) {\n    pickedIds.splice(index, 1);\n    updatePickState(false);\n    return;\n  }\n  if (pickedIds.length >= PICK_LIMIT) {\n    updatePickState(true);\n    return;\n  }\n  pickedIds.push(userId);\n  updatePickState(false);\n}\n\nfunction renderUserList() {\n  USERS.forEach((user) => {\n    const item = createElement('li', 'user-item');\n    const button = createElement('button', 'user-button');\n    button.type = 'button';\n    button.dataset.userId = user.id;\n    button.setAttribute('aria-pressed', 'false');\n\n    const text = createElement('span', 'user-text');\n    text.append(\n      createElement('span', 'user-name', user.name),\n      createElement('span', 'user-role', user.role),\n      createElement('span', 'user-tag', 'Not picked')\n    );\n    button.append(createUserImage(user, 'user-photo'), text);\n    button.addEventListener('click', () => togglePick(user.id));\n\n    item.append(button);\n    userList.append(item);\n  });\n}\n\n/* Case file tabs */\n\nfunction selectCaseFile(index, moveFocus) {\n  caseFiles.forEach((caseFile, fileIndex) => {\n    const isSelected = fileIndex === index;\n    caseFile.tab.setAttribute('aria-selected', String(isSelected));\n    caseFile.tab.tabIndex = isSelected ? 0 : -1;\n    caseFile.panel.hidden = !isSelected;\n  });\n  if (moveFocus) {\n    caseFiles[index].tab.focus();\n  }\n}\n\nfunction handleTabKeydown(event, index) {\n  if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') {\n    return;\n  }\n  event.preventDefault();\n  const step = event.key === 'ArrowRight' ? 1 : -1;\n  const nextIndex = (index + step + caseFiles.length) % caseFiles.length;\n  selectCaseFile(nextIndex, true);\n}\n\nfunction createTab(caseFile, index) {\n  const tab = createElement('button', 'case-tab');\n  tab.type = 'button';\n  tab.id = `tab-${caseFile.user.id}`;\n  tab.setAttribute('role', 'tab');\n  tab.setAttribute('aria-controls', `panel-${caseFile.user.id}`);\n\n  tab.append(\n    createElement('span', 'case-tab-number', `Case file ${numberFormat.format(index + 1)}`),\n    createElement('span', 'case-tab-name', caseFile.user.name)\n  );\n  tab.addEventListener('click', () => selectCaseFile(index, false));\n  tab.addEventListener('keydown', (event) => handleTabKeydown(event, index));\n  return tab;\n}\n\nfunction createPanel(caseFile) {\n  const user = caseFile.user;\n  const panel = createElement('article', 'case-file');\n  panel.id = `panel-${user.id}`;\n  panel.setAttribute('role', 'tabpanel');\n  panel.setAttribute('aria-labelledby', `tab-${user.id}`);\n\n  const top = createElement('div', 'case-top');\n  const title = createElement('div', 'case-title');\n  const message = createElement('blockquote', 'case-message');\n  message.append(createElement('p', '', user.message));\n  title.append(createElement('h3', 'case-name', user.name), createElement('p', 'case-role', user.role), message);\n  top.append(createUserImage(user, 'case-photo'), title);\n\n  const clues = createElement('ol', 'clue-list');\n  user.clues.forEach((clue) => clues.append(createElement('li', 'clue', clue)));\n\n  panel.append(top, createElement('h4', 'clue-heading', 'Clues'), clues);\n  return panel;\n}\n\n/* Views */\n\nfunction showView(view, heading) {\n  pickView.hidden = view !== pickView;\n  filesView.hidden = view !== filesView;\n  heading.focus();\n}\n\nfunction printCaseFiles() {\n  caseFiles = USERS\n    .filter((user) => pickedIds.includes(user.id))\n    .map((user) => ({ user }));\n\n  caseTabs.replaceChildren();\n  casePanels.replaceChildren();\n\n  caseFiles.forEach((caseFile, index) => {\n    caseFile.tab = createTab(caseFile, index);\n    caseFile.panel = createPanel(caseFile);\n    caseTabs.append(caseFile.tab);\n    casePanels.append(caseFile.panel);\n  });\n\n  selectCaseFile(0, false);\n  showView(filesView, document.getElementById('files-heading'));\n}\n\nfunction restart() {\n  pickedIds.length = 0;\n  updatePickState(false);\n  showView(pickView, document.getElementById('pick-heading'));\n}\n\nfunction start() {\n  renderUserList();\n  updatePickState(false);\n  printButton.addEventListener('click', printCaseFiles);\n  restartButton.addEventListener('click', restart);\n}\n\ntry {\n  start();\n} catch (error) {\n  pickView.hidden = true;\n  filesView.hidden = true;\n  document.getElementById('load-error').hidden = false;\n}",
          "folderId": "0",
          "active": true
        },
