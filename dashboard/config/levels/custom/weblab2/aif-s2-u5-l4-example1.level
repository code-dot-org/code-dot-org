    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "script.js",
          "language": "js",
          "contents": "const apiEndpoint = 'https://restcountries.com/v3.1/all?fields=name,population';\nconst statusElement = document.getElementById('app-status');\nconst outputElement = document.getElementById('data-output');\n\n// Declare async function\nconst fetchCountries = async () => {\n\n  // 1. Send the request\n  const response = await fetch(apiEndpoint);\n\n  statusElement.textContent =\n    `Status: Response received (${response.status}).`;\n\n  // 2. Convert response to JSON (array of countries)\n  const countries = await response.json();\n\n  statusElement.textContent =\n    `Status: Success! Displaying ${countries.length} countries.`;\n\n  // 3. Build the HTML output\n  let htmlList = `\n    <h3>🌍 Populations for ${countries.length} Countries</h3>\n    <ul>\n  `;\n\n  // Loop through the array of country objects\n  countries.forEach(country => {\n    const name = country.name.common;\n    const population = country.population;\n    htmlList += `<li>${name}: ${population}</li>`;\n  });\n\n  htmlList += '</ul>';\n\n  // 4. Update the DOM\n  outputElement.innerHTML = htmlList;\n};\n\n// Run async function on button click\ndocument\n  .getElementById('fetch-button')\n  .addEventListener('click', fetchCountries);\n",
          "folderId": "0",
          "active": true
        },
        "2": {
          "id": "2",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n  </head>\n  <body>\n    \n    <div id=\"app-status\" style=\"font-weight: bold; margin-top: 10px;\">Status: Ready</div>\n    \n    <div id=\"data-output\" style=\"border: 1px dashed #444; padding: 10px; margin-top: 10px;\">\n    </div>\n\n    <button id=\"fetch-button\">▶ Get Population Data</button> \n\n    <script src=\"script.js\"></script>\n  </body>\n</html>",
          "folderId": "0",
          "active": false
        }
