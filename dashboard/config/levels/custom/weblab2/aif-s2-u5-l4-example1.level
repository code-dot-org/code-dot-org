  "properties": {
    "encrypted": "false",
    "long_instructions": "**Snippet 1: The Core async/await Structure (Success Path Only)**\r\n\r\nThis example shows the conversion of the L3 Promise chain into the L4 `async`/`await` structure, focusing solely on the success path. We intentionally leave potential errors unhandled to demonstrate the need for L8.",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "false",
    "initial_view_mode": "split",
    "ai_tutor_mode": "engineer",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "placeholderText": "",
