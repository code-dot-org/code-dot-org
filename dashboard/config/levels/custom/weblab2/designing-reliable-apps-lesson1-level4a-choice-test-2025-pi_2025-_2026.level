  "level_num": "custom",
  "user_id": 18762,
  "properties": {
    "bubble_choice_description": "Predict what will be displayed on screen.",
    "display_name": "Pokémon API",
    "encrypted": "false",
    "submittable": "false",
    "hide_share_and_remix": "false",
    "disable_edit_run_for_submission": "false",
    "widget_view": "false",
