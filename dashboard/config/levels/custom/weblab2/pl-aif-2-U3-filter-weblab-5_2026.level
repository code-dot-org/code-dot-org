        "9": {
          "id": "9",
          "name": "data.js",
          "contents": "const movies = [\n  {\n    id: 1,\n    title: \"Night Run\",\n    genre: \"Action\",\n    year: 2021,\n    rating: 8.1,\n    image: \"images/movie1.png\",\n    alt: \"Night Run movie poster\",\n    isNew: true\n  },\n  {\n    id: 2,\n    title: \"Space Camp\",\n    genre: \"Sci-Fi\",\n    year: 2023,\n    rating: 8.6,\n    image: \"images/movie2.png\",\n    alt: \"Space Camp movie poster\",\n    isNew: true\n  },\n  {\n    id: 3,\n    title: \"The Last Slice\",\n    genre: \"Comedy\",\n    year: 2019,\n    rating: 7.4,\n    image: \"images/movie3.png\",\n    alt: \"The Last Slice movie poster\",\n    isNew: false\n  },\n  {\n    id: 4,\n    title: \"Final Round\",\n    genre: \"Action\",\n    year: 2018,\n    rating: 7.9,\n    image: \"images/movie4.png\",\n    alt: \"Final Round movie poster\",\n    isNew: false\n  },\n  {\n    id: 5,\n    title: \"Quiet Signal\",\n    genre: \"Drama\",\n    year: 2020,\n    rating: 8.3,\n    image: \"images/movie5.png\",\n    alt: \"Quiet Signal movie poster\",\n    isNew: false\n  },\n  {\n    id: 6,\n    title: \"Weekend Weirdos\",\n    genre: \"Comedy\",\n    year: 2022,\n    rating: 7.8,\n    image: \"images/movie6.png\",\n    alt: \"Weekend Weirdos movie poster\",\n    isNew: true\n  },\n  {\n    id: 7,\n    title: \"Deep Orbit\",\n    genre: \"Sci-Fi\",\n    year: 2017,\n    rating: 7.1,\n    image: \"images/movie7.png\",\n    alt: \"Deep Orbit movie poster\",\n    isNew: false\n  },\n  {\n    id: 8,\n    title: \"Chase Mode\",\n    genre: \"Action\",\n    year: 2024,\n    rating: 8.4,\n    image: \"images/movie8.png\",\n    alt: \"Chase Mode movie poster\",\n    isNew: true\n  }\n];",
          "folderId": "0",
          "active": false
        },
        "10": {
          "id": "10",
          "name": "helpers.js",
          "contents": "const createMovieCard = (movie) => {\n  const movieGrid = document.getElementById(\"movieGrid\");\n\n  const card = document.createElement(\"article\");\n  card.className = \"movie-card\";\n  card.id = \"movieCard\" + movie.id;\n\n  const posterWrap = document.createElement(\"div\");\n  posterWrap.className = \"poster-wrap\";\n  posterWrap.id = \"posterWrap\" + movie.id;\n\n  const image = document.createElement(\"img\");\n  image.className = \"poster-image\";\n  image.id = \"movieImage\" + movie.id;\n  image.src = movie.image;\n  image.alt = movie.alt;\n\n  posterWrap.appendChild(image);\n\n  if (movie.isNew === true) {\n    const badge = document.createElement(\"span\");\n    badge.className = \"movie-badge\";\n    badge.id = \"movieBadge\" + movie.id;\n    badge.textContent = \"NEW\";\n\n    posterWrap.appendChild(badge);\n  }\n\n  const info = document.createElement(\"div\");\n  info.className = \"movie-info\";\n  info.id = \"movieInfo\" + movie.id;\n\n  const title = document.createElement(\"h2\");\n  title.className = \"movie-title\";\n  title.id = \"movieTitle\" + movie.id;\n  title.textContent = movie.title;\n\n  const meta = document.createElement(\"p\");\n  meta.className = \"movie-meta\";\n  meta.id = \"movieMeta\" + movie.id;\n  meta.textContent = movie.genre + \" / \" + movie.year;\n\n  const rating = document.createElement(\"p\");\n  rating.className = \"movie-rating\";\n  rating.id = \"movieRating\" + movie.id;\n  rating.textContent = movie.rating + \" match\";\n\n  info.appendChild(title);\n  info.appendChild(meta);\n  info.appendChild(rating);\n\n  card.appendChild(posterWrap);\n  card.appendChild(info);\n\n  movieGrid.appendChild(card);\n};\n\n// Shows all movies.\nconst showAllMovies = () => {\n  displayMovies = [];\n\n  movies.map((movie) => {\n    displayMovies.push(movie);\n  });\n\n  renderMovies();\n};\n\ndocument.getElementById(\"showAllBtn\").addEventListener(\"click\", showAllMovies);",
          "folderId": "0",
          "active": false
        },
        "11": {
          "id": "11",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Streamline</title>\n  <link rel=\"stylesheet\" href=\"style.css\" />\n</head>\n\n<body id=\"mainBody\">\n  <div id=\"appShell\" class=\"app-shell\">\n\n    <header id=\"siteHeader\" class=\"site-header\">\n      <h1 id=\"siteLogo\" class=\"logo\">STREAMLINE</h1>\n\n      <nav id=\"mainNav\" class=\"main-nav\">\n        <span id=\"navHome\">Home</span>\n        <span id=\"navMovies\">Movies</span>\n        <span id=\"navTrending\">Trending</span>\n        <span id=\"navMyList\">My List</span>\n      </nav>\n    </header>\n\n    <section id=\"heroSection\" class=\"hero-section\">\n      <p id=\"heroEyebrow\" class=\"hero-eyebrow\">Tonight’s picks</p>\n      <h2 id=\"heroTitle\" class=\"hero-title\">Find a movie that fits your mood.</h2>\n      <p id=\"heroText\" class=\"hero-text\">\n        Use filters to narrow the list. A filter keeps movies that match a condition.\n      </p>\n    </section>\n\n    <section id=\"filterSection\" class=\"filter-section\">\n      <div id=\"filterControls\" class=\"filter-controls\">\n        <button id=\"showAllBtn\" class=\"filter-chip\" type=\"button\">All Movies</button>\n        <button id=\"filterActionBtn\" class=\"filter-chip\" type=\"button\">Action</button>\n        <button id=\"filterComedyBtn\" class=\"filter-chip\" type=\"button\">Comedy</button>\n        <button id=\"filterRecentBtn\" class=\"filter-chip\" type=\"button\">Recent Movies</button>\n        <button id=\"filterHighRatedBtn\" class=\"filter-chip\" type=\"button\">High Rated</button>\n      </div>\n\n      <p id=\"movieCount\" class=\"movie-count\">0 movies found</p>\n    </section>\n\n    <main id=\"movieGrid\" class=\"movie-grid\" aria-live=\"polite\"></main>\n\n  </div>\n\n  <script src=\"data.js\"></script>\n  <script src=\"helpers.js\"></script>\n  <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "active": false
        },
        "12": {
          "id": "12",
