          "active": false
        },
        "13": {
          "id": "13",
          "name": "script.js",
          "contents": "const movieGrid = document.getElementById(\"movieGrid\");\nconst movieCount = document.getElementById(\"movieCount\");\n\n// This array controls which movies are currently shown.\nlet displayMovies = movies;\n\n// Displays the current movies on the page.\nconst renderMovies = () => {\n  movieGrid.innerHTML = \"\";\n  movieCount.textContent = displayMovies.length + \" movies found\";\n\n  displayMovies.map((movie) => {\n    createMovieCard(movie);\n  });\n};\n\nrenderMovies();\n\n// Shows only action movies.\nconst filterActionMovies = () => {\n\n\n\n\n\n\n};",
          "folderId": "0",
          "active": false
        },
        "14": {
          "id": "14",
          "name": "style.css",
          "contents": "* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  font-family: system-ui, -apple-system, sans-serif;\n  background-color: #050505;\n  color: white;\n}\n\n.app-shell {\n  width: 100%;\n  max-width: 400px;\n  margin: 0 auto;\n  padding: 0 14px 32px;\n}\n\n/* Header */\n.site-header {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  padding: 18px 0 14px;\n}\n\n.logo {\n  color: #e50914;\n  font-size: 22px;\n  font-weight: 900;\n  letter-spacing: 1px;\n  flex-shrink: 0;\n}\n\n.main-nav {\n  display: flex;\n  gap: 12px;\n  color: #d7d7d7;\n  font-size: 12px;\n  overflow-x: auto;\n  white-space: nowrap;\n}\n\n.main-nav span {\n  cursor: default;\n  flex-shrink: 0;\n}\n\n/* Hero */\n.hero-section {\n  min-height: 170px;\n  padding: 28px 18px 22px;\n  background:\n    linear-gradient(to right, rgba(5, 5, 5, 1), rgba(5, 5, 5, 0.72), rgba(5, 5, 5, 1)),\n    linear-gradient(135deg, #2c0f16, #111827, #050505);\n  border-radius: 16px;\n  margin-bottom: 18px;\n}\n\n.hero-eyebrow {\n  color: #e50914;\n  font-weight: 800;\n  text-transform: uppercase;\n  letter-spacing: 0.08em;\n  font-size: 11px;\n  margin-bottom: 10px;\n}\n\n.hero-title {\n  font-size: 28px;\n  line-height: 1.05;\n  margin-bottom: 12px;\n}\n\n.hero-text {\n  color: #d4d4d4;\n  font-size: 13px;\n  line-height: 1.45;\n}\n\n/* Filters */\n.filter-section {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 11px;\n  margin-bottom: 16px;\n}\n\n.filter-controls {\n  width: 100%;\n  display: flex;\n  flex-wrap: nowrap;\n  gap: 8px;\n  overflow-x: auto;\n  padding-bottom: 4px;\n}\n\n.filter-chip {\n  flex-shrink: 0;\n  border: 1px solid #444;\n  background-color: #171717;\n  color: white;\n  border-radius: 999px;\n  padding: 8px 13px;\n  font-size: 13px;\n  cursor: pointer;\n}\n\n.filter-chip:hover {\n  background-color: #2b2b2b;\n  border-color: #777;\n}\n\n.filter-chip:focus {\n  background-color: #e50914;\n  border-color: #e50914;\n  outline: none;\n}\n\n.movie-count {\n  color: #b8b8b8;\n  font-size: 12px;\n  white-space: nowrap;\n}\n\n/* Movie Grid */\n.movie-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 12px;\n}\n\n.movie-card {\n  background-color: #151515;\n  border-radius: 9px;\n  overflow: hidden;\n  transition: transform 0.2s, background-color 0.2s;\n}\n\n.movie-card:hover {\n  transform: scale(1.02);\n  background-color: #202020;\n}\n\n.poster-wrap {\n  position: relative;\n  aspect-ratio: 2 / 3;\n  background-color: #222;\n  overflow: hidden;\n}\n\n.poster-image {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.movie-badge {\n  position: absolute;\n  top: 8px;\n  left: 8px;\n  background-color: #e50914;\n  color: white;\n  font-size: 10px;\n  font-weight: 800;\n  padding: 3px 6px;\n  border-radius: 4px;\n}\n\n.movie-info {\n  padding: 9px;\n}\n\n.movie-title {\n  font-size: 14px;\n  line-height: 1.25;\n  margin-bottom: 6px;\n}\n\n.movie-meta {\n  color: #b8b8b8;\n  font-size: 12px;\n  margin-bottom: 5px;\n}\n\n.movie-rating {\n  color: #46d369;\n  font-size: 12px;\n  font-weight: 700;\n}\n\n/* Extra-small windows */\n@media (max-width: 330px) {\n  .app-shell {\n    padding: 0 10px 28px;\n  }\n\n  .site-header {\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 8px;\n  }\n\n  .hero-title {\n    font-size: 24px;\n  }\n\n  .movie-grid {\n    gap: 10px;\n  }\n\n  .movie-title {\n    font-size: 13px;\n  }\n}\n\n/* Wider preview windows */\n@media (min-width: 520px) {\n  .app-shell {\n    max-width: 760px;\n    padding: 0 22px 44px;\n  }\n\n  .movie-grid {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 16px;\n  }\n\n  .hero-title {\n    font-size: 36px;\n  }\n}\n\n@media (min-width: 900px) {\n  .app-shell {\n    max-width: 1100px;\n  }\n\n  .movie-grid {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 18px;\n  }\n}",
          "folderId": "0",
          "active": true
        }
