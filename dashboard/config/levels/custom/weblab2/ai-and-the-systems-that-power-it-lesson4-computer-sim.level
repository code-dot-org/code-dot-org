    },
    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Computer Simulator</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <header class=\"page-header\">\n    <h1>Computer Simulator</h1>\n    <p class=\"page-intro\">\n      This is a pretend laptop. Open any app to look around, then use\n      <strong>Back to Desktop</strong> (or the Escape key) to return.\n      You can move between apps with the Tab key and open one with Enter or Space.\n    </p>\n  </header>\n\n  <main>\n    <div id=\"status\" class=\"visually-hidden\" aria-live=\"polite\"></div>\n\n    <noscript>\n      <p class=\"notice\">This simulator needs JavaScript to open apps. Please turn JavaScript on and reload the page.</p>\n    </noscript>\n\n    <div class=\"laptop\">\n      <!-- ============ DESKTOP ============ -->\n      <section id=\"desktop\" class=\"desktop\" aria-labelledby=\"desktop-heading\">\n        <h2 id=\"desktop-heading\" class=\"visually-hidden\">Desktop</h2>\n\n        <div class=\"menu-bar\">\n          <span class=\"menu-bar-name\">Laptop</span>\n          <span class=\"menu-bar-status\">\n            <span class=\"status-pill\">Wi-Fi: Connected</span>\n            <span class=\"status-pill\">Battery: 77%</span>\n            <span id=\"menu-clock\" class=\"status-pill\">--:--</span>\n          </span>\n        </div>\n\n        <ul class=\"icon-grid\">\n          <li>\n            <button type=\"button\" class=\"app-icon\" data-app=\"settings\">\n              <svg class=\"icon\" viewBox=\"0 0 64 64\" aria-hidden=\"true\" focusable=\"false\">\n                <rect class=\"tile tile-gray\" width=\"64\" height=\"64\" rx=\"14\"/>\n                <circle cx=\"32\" cy=\"32\" r=\"16\" fill=\"none\" stroke=\"#fff\" stroke-width=\"6\" stroke-dasharray=\"8 6\"/>\n                <circle cx=\"32\" cy=\"32\" r=\"6\" fill=\"#fff\"/>\n              </svg>\n              <span class=\"app-label\">System Settings</span>\n            </button>\n          </li>\n          <li>\n            <button type=\"button\" class=\"app-icon\" data-app=\"about\">\n              <svg class=\"icon\" viewBox=\"0 0 64 64\" aria-hidden=\"true\" focusable=\"false\">\n                <rect class=\"tile tile-blue\" width=\"64\" height=\"64\" rx=\"14\"/>\n                <rect x=\"14\" y=\"16\" width=\"36\" height=\"24\" rx=\"3\" fill=\"#fff\"/>\n                <rect x=\"17\" y=\"19\" width=\"30\" height=\"18\" fill=\"#3a8bd6\"/>\n                <rect x=\"8\" y=\"42\" width=\"48\" height=\"5\" rx=\"2\" fill=\"#dbe7f5\"/>\n              </svg>\n              <span class=\"app-label\">About This Device</span>\n            </button>\n          </li>\n          <li>\n            <button type=\"button\" class=\"app-icon\" data-app=\"update\">\n              <svg class=\"icon\" viewBox=\"0 0 64 64\" aria-hidden=\"true\" focusable=\"false\">\n                <rect class=\"tile tile-gray\" width=\"64\" height=\"64\" rx=\"14\"/>\n                <circle cx=\"32\" cy=\"32\" r=\"17\" fill=\"none\" stroke=\"#fff\" stroke-width=\"5\"/>\n                <path d=\"M32 21v18M24 31l8 8 8-8\" fill=\"none\" stroke=\"#fff\" stroke-width=\"5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n              <span class=\"app-label\">Software Update</span>\n            </button>\n          </li>\n          <li>\n            <button type=\"button\" class=\"app-icon\" data-app=\"docs\">\n              <svg class=\"icon\" viewBox=\"0 0 64 64\" aria-hidden=\"true\" focusable=\"false\">\n                <rect class=\"tile tile-purple\" width=\"64\" height=\"64\" rx=\"14\"/>\n                <path d=\"M20 12h18l10 10v30H20z\" fill=\"#fff\"/>\n                <path d=\"M38 12v10h10\" fill=\"#d9cff0\"/>\n                <rect x=\"25\" y=\"30\" width=\"18\" height=\"3\" fill=\"#5b3fa8\"/>\n                <rect x=\"25\" y=\"37\" width=\"18\" height=\"3\" fill=\"#5b3fa8\"/>\n                <rect x=\"25\" y=\"44\" width=\"12\" height=\"3\" fill=\"#5b3fa8\"/>\n              </svg>\n              <span class=\"app-label\">Docs</span>\n            </button>\n          </li>\n          <li>\n            <button type=\"button\" class=\"app-icon\" data-app=\"meet\">\n              <svg class=\"icon\" viewBox=\"0 0 64 64\" aria-hidden=\"true\" focusable=\"false\">\n                <rect class=\"tile tile-indigo\" width=\"64\" height=\"64\" rx=\"14\"/>\n                <circle cx=\"24\" cy=\"26\" r=\"7\" fill=\"#fff\"/>\n                <circle cx=\"42\" cy=\"26\" r=\"7\" fill=\"#fff\"/>\n                <path d=\"M11 48c1-8 6-12 13-12s12 4 13 12z\" fill=\"#fff\"/>\n                <path d=\"M31 48c1-8 5-12 11-12s10 4 11 12z\" fill=\"#c9cbff\"/>\n              </svg>\n              <span class=\"app-label\">Video Meet</span>\n            </button>\n          </li>\n          <li>\n            <button type=\"button\" class=\"app-icon\" data-app=\"watch\">\n              <svg class=\"icon\" viewBox=\"0 0 64 64\" aria-hidden=\"true\" focusable=\"false\">\n                <rect class=\"tile tile-red\" width=\"64\" height=\"64\" rx=\"14\"/>\n                <rect x=\"10\" y=\"14\" width=\"44\" height=\"36\" rx=\"3\" fill=\"#fff\"/>\n                <rect x=\"14\" y=\"20\" width=\"36\" height=\"24\" fill=\"#8b1c1c\"/>\n                <rect x=\"10\" y=\"14\" width=\"44\" height=\"4\" fill=\"#d9a3a3\"/>\n                <rect x=\"10\" y=\"46\" width=\"44\" height=\"4\" fill=\"#d9a3a3\"/>\n                <rect x=\"17\" y=\"14\" width=\"3\" height=\"36\" fill=\"#8b1c1c\"/>\n                <rect x=\"44\" y=\"14\" width=\"3\" height=\"36\" fill=\"#8b1c1c\"/>\n              </svg>\n              <span class=\"app-label\">Watch</span>\n            </button>\n          </li>\n          <li>\n            <button type=\"button\" class=\"app-icon\" data-app=\"photos\">\n              <svg class=\"icon\" viewBox=\"0 0 64 64\" aria-hidden=\"true\" focusable=\"false\">\n                <rect class=\"tile tile-white\" width=\"64\" height=\"64\" rx=\"14\"/>\n                <rect x=\"10\" y=\"12\" width=\"44\" height=\"40\" rx=\"4\" fill=\"#4f9be8\"/>\n                <circle cx=\"42\" cy=\"23\" r=\"5\" fill=\"#ffd54f\"/>\n                <path d=\"M10 48l14-16 10 10 8-7 12 13z\" fill=\"#2fa860\"/>\n                <rect x=\"10\" y=\"12\" width=\"44\" height=\"40\" rx=\"4\" fill=\"none\" stroke=\"#1f2430\" stroke-width=\"3\"/>\n              </svg>\n              <span class=\"app-label\">Photos</span>\n            </button>\n          </li>\n          <li>\n            <button type=\"button\" class=\"app-icon\" data-app=\"camera\">\n              <svg class=\"icon\" viewBox=\"0 0 64 64\" aria-hidden=\"true\" focusable=\"false\">\n                <rect class=\"tile tile-dark\" width=\"64\" height=\"64\" rx=\"14\"/>\n                <rect x=\"12\" y=\"20\" width=\"40\" height=\"28\" rx=\"6\" fill=\"#fff\"/>\n                <rect x=\"24\" y=\"14\" width=\"16\" height=\"8\" rx=\"2\" fill=\"#fff\"/>\n                <circle cx=\"32\" cy=\"34\" r=\"9\" fill=\"#2b2b33\"/>\n                <circle cx=\"32\" cy=\"34\" r=\"4\" fill=\"#8fb3ff\"/>\n              </svg>\n              <span class=\"app-label\">Camera</span>\n            </button>\n          </li>\n          <li>\n            <button type=\"button\" class=\"app-icon\" data-app=\"music\">\n              <svg class=\"icon\" viewBox=\"0 0 64 64\" aria-hidden=\"true\" focusable=\"false\">\n                <rect class=\"tile tile-green\" width=\"64\" height=\"64\" rx=\"14\"/>\n                <path d=\"M26 42V18l18-4v24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"5\" stroke-linejoin=\"round\"/>\n                <circle cx=\"21\" cy=\"43\" r=\"6\" fill=\"#fff\"/>\n                <circle cx=\"39\" cy=\"39\" r=\"6\" fill=\"#fff\"/>\n              </svg>\n              <span class=\"app-label\">Music</span>\n            </button>\n          </li>\n          <li>\n            <button type=\"button\" class=\"app-icon\" data-app=\"design\">\n              <svg class=\"icon\" viewBox=\"0 0 64 64\" aria-hidden=\"true\" focusable=\"false\">\n                <rect class=\"tile tile-teal\" width=\"64\" height=\"64\" rx=\"14\"/>\n                <path d=\"M18 46l6-18 12 12-18 6z\" fill=\"#fff\"/>\n                <path d=\"M30 22l8-8 12 12-8 8z\" fill=\"#fff\"/>\n              </svg>\n              <span class=\"app-label\">Design Studio</span>\n            </button>\n          </li>\n          <li>\n            <button type=\"button\" class=\"app-icon\" data-app=\"battery\">\n              <svg class=\"icon\" viewBox=\"0 0 64 64\" aria-hidden=\"true\" focusable=\"false\">\n                <rect class=\"tile tile-green\" width=\"64\" height=\"64\" rx=\"14\"/>\n                <rect x=\"12\" y=\"22\" width=\"36\" height=\"20\" rx=\"4\" fill=\"none\" stroke=\"#fff\" stroke-width=\"4\"/>\n                <rect x=\"49\" y=\"28\" width=\"5\" height=\"8\" rx=\"1\" fill=\"#fff\"/>\n                <rect x=\"16\" y=\"26\" width=\"22\" height=\"12\" rx=\"2\" fill=\"#fff\"/>\n              </svg>\n              <span class=\"app-label\">Battery</span>\n            </button>\n          </li>\n          <li>\n            <button type=\"button\" class=\"app-icon\" data-app=\"storage\">\n              <svg class=\"icon\" viewBox=\"0 0 64 64\" aria-hidden=\"true\" focusable=\"false\">\n                <rect class=\"tile tile-blue\" width=\"64\" height=\"64\" rx=\"14\"/>\n                <path d=\"M14 22h36l-4 24H18z\" fill=\"#fff\"/>\n                <path d=\"M14 22l4-8h28l4 8\" fill=\"#dbe7f5\"/>\n                <rect x=\"24\" y=\"38\" width=\"16\" height=\"3\" fill=\"#3a8bd6\"/>\n              </svg>\n              <span class=\"app-label\">Storage</span>\n            </button>\n          </li>\n          <li>\n            <button type=\"button\" class=\"app-icon\" data-app=\"antivirus\">\n              <svg class=\"icon\" viewBox=\"0 0 64 64\" aria-hidden=\"true\" focusable=\"false\">\n                <rect class=\"tile tile-orange\" width=\"64\" height=\"64\" rx=\"14\"/>\n                <path d=\"M32 12l16 6v14c0 10-7 17-16 20-9-3-16-10-16-20V18z\" fill=\"#fff\"/>\n                <path d=\"M24 32l6 6 10-12\" fill=\"none\" stroke=\"#e07a10\" stroke-width=\"5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n              </svg>\n              <span class=\"app-label\">Antivirus</span>\n            </button>\n          </li>\n          <li>\n            <button type=\"button\" class=\"app-icon\" data-app=\"memos\">\n              <svg class=\"icon\" viewBox=\"0 0 64 64\" aria-hidden=\"true\" focusable=\"false\">\n                <rect class=\"tile tile-dark\" width=\"64\" height=\"64\" rx=\"14\"/>\n                <path d=\"M14 32h4M22 24v16M30 16v32M38 22v20M46 28v8\" fill=\"none\" stroke=\"#ff5a5a\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n              </svg>\n              <span class=\"app-label\">Voice Memos</span>\n            </button>\n          </li>\n          <li>\n            <button type=\"button\" class=\"app-icon\" data-app=\"code\">\n              <svg class=\"icon\" viewBox=\"0 0 64 64\" aria-hidden=\"true\" focusable=\"false\">\n                <rect class=\"tile tile-indigo\" width=\"64\" height=\"64\" rx=\"14\"/>\n                <path d=\"M24 20L12 32l12 12M40 20l12 12-12 12\" fill=\"none\" stroke=\"#fff\" stroke-width=\"5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n                <path d=\"M36 16l-8 32\" fill=\"none\" stroke=\"#fff\" stroke-width=\"4\" stroke-linecap=\"round\"/>\n              </svg>\n              <span class=\"app-label\">Code Editor</span>\n            </button>\n          </li>\n        </ul>\n      </section>\n\n      <!-- ============ APP WINDOWS ============ -->\n      <div id=\"app-area\" class=\"app-area\" hidden>\n        <div class=\"app-toolbar\">\n          <button type=\"button\" id=\"back-button\" class=\"back-button\">\n            <svg class=\"back-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\">\n              <path d=\"M15 5l-7 7 7 7\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n            </svg>\n            Back to Desktop\n          </button>\n        </div>\n\n        <!-- System Settings -->\n        <section class=\"app-window\" data-window=\"settings\" aria-labelledby=\"title-settings\" hidden>\n          <div class=\"title-bar\">\n            <span class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n            <h2 id=\"title-settings\" class=\"window-title\">System Settings</h2>\n          </div>\n          <div class=\"window-body split\">\n            <aside class=\"sidebar\">\n              <p class=\"sidebar-user\"><span class=\"avatar\" aria-hidden=\"true\"></span> Sam Rivera<br><small>Account</small></p>\n              <ul class=\"sidebar-list\" aria-label=\"Settings categories\">\n                <li>Wi-Fi</li>\n                <li>Bluetooth</li>\n                <li class=\"is-selected\" aria-current=\"true\">Network</li>\n                <li>Notifications</li>\n                <li>Sound</li>\n                <li>Focus</li>\n                <li>Screen Time</li>\n                <li>General</li>\n                <li>Appearance</li>\n                <li>Accessibility</li>\n              </ul>\n            </aside>\n            <div class=\"pane\">\n              <h3>Network</h3>\n              <ul class=\"row-list\">\n                <li class=\"row\"><span class=\"row-name\">Wi-Fi</span><span class=\"row-status status-ok\">Connected</span></li>\n                <li class=\"row\"><span class=\"row-name\">Firewall</span><span class=\"row-status status-ok\">Active</span></li>\n              </ul>\n              <h4>Other Services</h4>\n              <ul class=\"row-list\">\n                <li class=\"row\"><span class=\"row-name\">Classroom Micro-controller 2</span><span class=\"row-status status-off\">Not configured</span></li>\n                <li class=\"row\"><span class=\"row-name\">Classroom Micro-controller</span><span class=\"row-status status-off\">Not configured</span></li>\n                <li class=\"row\"><span class=\"row-name\">Debug Link</span><span class=\"row-status status-off\">Not configured</span></li>\n                <li class=\"row\"><span class=\"row-name\">Thunderbolt Ethernet</span><span class=\"row-status status-off\">Not connected</span></li>\n                <li class=\"row\"><span class=\"row-name\">USB-C Dock Ethernet</span><span class=\"row-status status-off\">Not connected</span></li>\n                <li class=\"row\"><span class=\"row-name\">USB 10/100/1000 LAN</span><span class=\"row-status status-off\">Not connected</span></li>\n              </ul>\n            </div>\n          </div>\n        </section>\n\n        <!-- About This Device -->\n        <section class=\"app-window app-window-narrow\" data-window=\"about\" aria-labelledby=\"title-about\" hidden>\n          <div class=\"title-bar\">\n            <span class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n            <h2 id=\"title-about\" class=\"window-title\">About This Device</h2>\n          </div>\n          <div class=\"window-body centered\">\n            <svg class=\"laptop-art\" viewBox=\"0 0 200 130\" role=\"img\" aria-label=\"A silver laptop with its screen open, showing a blue background.\">\n              <rect x=\"30\" y=\"8\" width=\"140\" height=\"92\" rx=\"6\" fill=\"#2b2b33\"/>\n              <rect x=\"37\" y=\"15\" width=\"126\" height=\"78\" fill=\"#4f9be8\"/>\n              <path d=\"M10 104h180l6 12H4z\" fill=\"#c9ccd3\"/>\n              <rect x=\"80\" y=\"106\" width=\"40\" height=\"4\" rx=\"2\" fill=\"#9ea3ad\"/>\n            </svg>\n            <h3 class=\"device-name\">MacBook Air</h3>\n            <p class=\"device-sub\">M1, 2020</p>\n            <dl class=\"spec-list\">\n              <dt>Chip</dt><dd>Apple M1</dd>\n              <dt>Memory</dt><dd>8 GB</dd>\n              <dt>Serial number</dt><dd>FVFGHD0EQ6L4</dd>\n              <dt>Operating system</dt><dd>macOS Sonoma 14.5</dd>\n            </dl>\n            <button type=\"button\" id=\"more-info-button\" class=\"soft-button\" aria-expanded=\"false\" aria-controls=\"more-info\">More Info</button>\n            <dl id=\"more-info\" class=\"spec-list\" hidden>\n              <dt>Display</dt><dd>13.3-inch (2560 x 1600)</dd>\n              <dt>Graphics</dt><dd>7-core GPU (built into the chip)</dd>\n              <dt>Storage</dt><dd>245 GB solid-state drive</dd>\n              <dt>Ports</dt><dd>2 USB-C, headphone jack</dd>\n            </dl>\n            <p class=\"fine-print\">Regulatory certification information is available in Settings.</p>\n          </div>\n        </section>\n\n        <!-- Software Update -->\n        <section class=\"app-window\" data-window=\"update\" aria-labelledby=\"title-update\" hidden>\n          <div class=\"title-bar\">\n            <span class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n            <h2 id=\"title-update\" class=\"window-title\">Software Update</h2>\n          </div>\n          <div class=\"window-body split\">\n            <aside class=\"sidebar sidebar-art\">\n              <svg class=\"big-gear\" viewBox=\"0 0 64 64\" aria-hidden=\"true\" focusable=\"false\">\n                <circle cx=\"32\" cy=\"32\" r=\"22\" fill=\"none\" stroke=\"#6b6f78\" stroke-width=\"7\" stroke-dasharray=\"6 5\"/>\n                <circle cx=\"32\" cy=\"32\" r=\"12\" fill=\"none\" stroke=\"#6b6f78\" stroke-width=\"6\"/>\n                <circle cx=\"32\" cy=\"32\" r=\"4\" fill=\"#6b6f78\"/>\n              </svg>\n              <p class=\"sidebar-caption\">Software Update</p>\n            </aside>\n            <div class=\"pane\">\n              <div class=\"pane-header\">\n                <h3 id=\"update-heading\">Updates are available for your computer</h3>\n                <button type=\"button\" id=\"update-button\" class=\"soft-button\">Update Now</button>\n              </div>\n              <ul id=\"update-list\" class=\"plain-list\">\n                <li>macOS Sonoma 14.6</li>\n                <li>Web Browser 17.6</li>\n              </ul>\n              <div id=\"update-progress\" class=\"progress\" hidden>\n                <p id=\"update-progress-text\">Downloading update</p>\n                <progress id=\"update-progress-bar\" max=\"100\" value=\"0\" aria-labelledby=\"update-progress-text\"></progress>\n              </div>\n              <p class=\"fine-print\">Use of this software is subject to the original license agreement that came with the software being updated.</p>\n              <label class=\"check-row\"><input type=\"checkbox\" id=\"auto-update\"> Automatically keep my computer up to date</label>\n            </div>\n          </div>\n        </section>\n\n        <!-- Docs -->\n        <section class=\"app-window\" data-window=\"docs\" aria-labelledby=\"title-docs\" hidden>\n          <div class=\"title-bar\">\n            <span class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n            <h2 id=\"title-docs\" class=\"window-title\">Docs</h2>\n          </div>\n          <div class=\"window-body\">\n            <div class=\"doc-toolbar\" aria-hidden=\"true\">\n              <span class=\"fake-tab\">Untitled document</span>\n              <span class=\"fake-menu\">File</span><span class=\"fake-menu\">Edit</span><span class=\"fake-menu\">View</span><span class=\"fake-menu\">Insert</span><span class=\"fake-menu\">Format</span>\n            </div>\n            <label for=\"doc-text\" class=\"visually-hidden\">Document text</label>\n            <textarea id=\"doc-text\" class=\"doc-page\" rows=\"10\" spellcheck=\"false\">I can write here</textarea>\n          </div>\n        </section>\n\n        <!-- Video Meet -->\n        <section class=\"app-window\" data-window=\"meet\" aria-labelledby=\"title-meet\" hidden>\n          <div class=\"title-bar\">\n            <span class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n            <h2 id=\"title-meet\" class=\"window-title\">Video Meet</h2>\n          </div>\n          <div class=\"window-body split\">\n            <div class=\"pane\">\n              <p class=\"meet-time\"><span id=\"meet-clock\">--:--</span><br><small id=\"meet-date\"></small></p>\n              <ul class=\"tile-buttons\">\n                <li><button type=\"button\" class=\"tile-button tile-button-orange\">New Meeting</button></li>\n                <li><button type=\"button\" class=\"tile-button tile-button-blue\">Join</button></li>\n                <li><button type=\"button\" class=\"tile-button tile-button-blue\">Schedule</button></li>\n                <li><button type=\"button\" class=\"tile-button tile-button-blue\">Share Screen</button></li>\n              </ul>\n              <p id=\"meet-message\" class=\"small-note\" aria-live=\"polite\">You have no meetings today.</p>\n            </div>\n            <aside class=\"pane pane-secondary\">\n              <h3>AI Companion</h3>\n              <p class=\"small-note\">Ask questions during meetings. Get summaries of what was said. Draft chat replies.</p>\n              <p class=\"small-note\">Write a message or topic to get started.</p>\n            </aside>\n          </div>\n        </section>\n\n        <!-- Watch -->\n        <section class=\"app-window app-window-dark\" data-window=\"watch\" aria-labelledby=\"title-watch\" hidden>\n          <div class=\"title-bar\">\n            <span class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n            <h2 id=\"title-watch\" class=\"window-title\">Watch</h2>\n          </div>\n          <div class=\"window-body\">\n            <div class=\"channel-header\">\n              <span class=\"channel-avatar\" aria-hidden=\"true\"></span>\n              <div>\n                <h3>CodeAI</h3>\n                <p class=\"small-note\">Learning computer science should be fun and creative. New videos every week.</p>\n              </div>\n            </div>\n            <ul class=\"card-grid\">\n              <li class=\"media-card\">\n                <img src=\"video-1.png\" alt=\"Video thumbnail: a teenager laughing while typing on a laptop in a classroom.\" width=\"320\" height=\"180\">\n                <p class=\"card-title\">Computer Science Is Everything</p>\n                <p class=\"small-note\">1.2M views</p>\n              </li>\n              <li class=\"media-card\">\n                <img src=\"video-2.png\" alt=\"Video thumbnail: colorful blocks of code stacked like building blocks.\" width=\"320\" height=\"180\">\n                <p class=\"card-title\">How Computers Learn</p>\n                <p class=\"small-note\">640K views</p>\n              </li>\n              <li class=\"media-card\">\n                <img src=\"video-3.png\" alt=\"Video thumbnail: a student holding up a small circuit board.\" width=\"320\" height=\"180\">\n                <p class=\"card-title\">Build Your First App</p>\n                <p class=\"small-note\">312K views</p>\n              </li>\n            </ul>\n          </div>\n        </section>\n\n        <!-- Photos -->\n        <section class=\"app-window\" data-window=\"photos\" aria-labelledby=\"title-photos\" hidden>\n          <div class=\"title-bar\">\n            <span class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n            <h2 id=\"title-photos\" class=\"window-title\">Photos</h2>\n          </div>\n          <div class=\"window-body split\">\n            <aside class=\"sidebar\">\n              <ul class=\"sidebar-list\" aria-label=\"Photo albums\">\n                <li class=\"is-selected\" aria-current=\"true\">Library</li>\n                <li>Recents</li>\n                <li>Favorites</li>\n                <li>Screenshots</li>\n                <li>Shared</li>\n              </ul>\n            </aside>\n            <div class=\"pane\">\n              <h3>Library <small class=\"small-note\">6 photos</small></h3>\n              <ul class=\"photo-grid\">\n                <li><img src=\"photo-1.png\" alt=\"A hiking trail winding through a green forest.\" width=\"200\" height=\"200\"></li>\n                <li><img src=\"photo-2.png\" alt=\"A golden retriever sitting on a beach at sunset.\" width=\"200\" height=\"200\"></li>\n                <li><img src=\"photo-3.png\" alt=\"A close-up of a bowl of ramen with an egg on top.\" width=\"200\" height=\"200\"></li>\n                <li><img src=\"photo-4.png\" alt=\"City skyline at night with lit-up windows.\" width=\"200\" height=\"200\"></li>\n                <li><img src=\"photo-5.png\" alt=\"A skateboarder mid-jump at a skate park.\" width=\"200\" height=\"200\"></li>\n                <li><img src=\"photo-6.png\" alt=\"A desk with a laptop, notebook, and a cup of tea.\" width=\"200\" height=\"200\"></li>\n              </ul>\n            </div>\n          </div>\n        </section>\n\n        <!-- Camera -->\n        <section class=\"app-window app-window-dark\" data-window=\"camera\" aria-labelledby=\"title-camera\" hidden>\n          <div class=\"title-bar\">\n            <span class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n            <h2 id=\"title-camera\" class=\"window-title\">Camera</h2>\n          </div>\n          <div class=\"window-body centered\">\n            <div class=\"viewfinder\" role=\"img\" aria-label=\"Camera preview. The camera is off, so the preview is dark.\"></div>\n            <p id=\"camera-message\" class=\"small-note\" aria-live=\"polite\">Camera preview is off.</p>\n            <button type=\"button\" id=\"shutter-button\" class=\"soft-button\">Take Photo</button>\n          </div>\n        </section>\n\n        <!-- Music -->\n        <section class=\"app-window app-window-dark\" data-window=\"music\" aria-labelledby=\"title-music\" hidden>\n          <div class=\"title-bar\">\n            <span class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n            <h2 id=\"title-music\" class=\"window-title\">Music</h2>\n          </div>\n          <div class=\"window-body\">\n            <h3>Good afternoon</h3>\n            <ul class=\"card-grid\">\n              <li class=\"media-card\">\n                <img src=\"cover-1.png\" alt=\"Album cover: bold white letters on a bright red background.\" width=\"200\" height=\"200\">\n                <p class=\"card-title\">Big on the Internet</p>\n                <p class=\"small-note\">Podcast</p>\n              </li>\n              <li class=\"media-card\">\n                <img src=\"cover-2.png\" alt=\"Album cover: a black-and-white photo of a crowded city street.\" width=\"200\" height=\"200\">\n                <p class=\"card-title\">The Tortured Poets Department</p>\n                <p class=\"small-note\">Album</p>\n              </li>\n              <li class=\"media-card\">\n                <img src=\"cover-3.png\" alt=\"Playlist cover: neon purple and blue waves.\" width=\"200\" height=\"200\">\n                <p class=\"card-title\">Focus Beats</p>\n                <p class=\"small-note\">Playlist</p>\n              </li>\n            </ul>\n            <div class=\"now-playing\">\n              <span class=\"now-playing-text\">Now playing: <strong>Focus Beats</strong></span>\n              <button type=\"button\" id=\"play-button\" class=\"soft-button\" aria-pressed=\"false\">Play</button>\n            </div>\n          </div>\n        </section>\n\n        <!-- Design Studio -->\n        <section class=\"app-window\" data-window=\"design\" aria-labelledby=\"title-design\" hidden>\n          <div class=\"title-bar\">\n            <span class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n            <h2 id=\"title-design\" class=\"window-title\">Design Studio</h2>\n          </div>\n          <div class=\"window-body\">\n            <div class=\"design-hero\">\n              <h3>What will you design today?</h3>\n              <ul class=\"chip-row\">\n                <li><button type=\"button\" class=\"chip\">Presentation</button></li>\n                <li><button type=\"button\" class=\"chip\">Poster</button></li>\n                <li><button type=\"button\" class=\"chip\">Social post</button></li>\n                <li><button type=\"button\" class=\"chip\">Video</button></li>\n                <li><button type=\"button\" class=\"chip\">Logo</button></li>\n              </ul>\n            </div>\n            <h4>You might want to try</h4>\n            <ul class=\"template-grid\" aria-label=\"Templates\">\n              <li class=\"template template-a\">Doc</li>\n              <li class=\"template template-b\">Whiteboard</li>\n              <li class=\"template template-c\">Presentation</li>\n              <li class=\"template template-d\">Instagram post</li>\n              <li class=\"template template-e\">Poster</li>\n            </ul>\n          </div>\n        </section>\n\n        <!-- Battery -->\n        <section class=\"app-window\" data-window=\"battery\" aria-labelledby=\"title-battery\" hidden>\n          <div class=\"title-bar\">\n            <span class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n            <h2 id=\"title-battery\" class=\"window-title\">Battery</h2>\n          </div>\n          <div class=\"window-body split\">\n            <aside class=\"sidebar\">\n              <ul class=\"sidebar-list\" aria-label=\"Settings categories\">\n                <li>Displays</li>\n                <li>Wallpaper</li>\n                <li>Screen Saver</li>\n                <li class=\"is-selected\" aria-current=\"true\">Battery</li>\n                <li>Lock Screen</li>\n                <li>Users &amp; Groups</li>\n                <li>Passwords</li>\n                <li>Keyboard</li>\n                <li>Mouse</li>\n              </ul>\n            </aside>\n            <div class=\"pane\">\n              <h3>Battery <small class=\"small-note\">Charging: 77%</small></h3>\n              <ul class=\"row-list\">\n                <li class=\"row\">\n                  <label for=\"low-power\" class=\"row-name\">Low Power Mode<br><small>Your computer will use less energy to make the battery last longer.</small></label>\n                  <select id=\"low-power\">\n                    <option>Never</option>\n                    <option selected>Only on Battery</option>\n                    <option>Only on Power Adapter</option>\n                    <option>Always</option>\n                  </select>\n                </li>\n                <li class=\"row\"><span class=\"row-name\">Battery Health</span><span class=\"row-status\">Normal</span></li>\n              </ul>\n              <h4>Last 24 Hours</h4>\n              <p class=\"small-note\">Charging: 77% &mdash; 1 hour 17 minutes until fully charged</p>\n              <h5>Battery Level</h5>\n              <svg class=\"chart\" viewBox=\"0 0 320 120\" role=\"img\" aria-label=\"Bar chart of battery level over the last 24 hours. The battery stayed near 100 percent from 3 AM to about 6 PM, dropped to about 20 percent by 11 PM, then climbed back to 77 percent while charging.\">\n                <line x1=\"30\" y1=\"10\" x2=\"30\" y2=\"95\" stroke=\"#9ea3ad\"/>\n                <line x1=\"30\" y1=\"95\" x2=\"310\" y2=\"95\" stroke=\"#9ea3ad\"/>\n                <text x=\"0\" y=\"14\" class=\"chart-label\">100%</text>\n                <text x=\"0\" y=\"57\" class=\"chart-label\">50%</text>\n                <text x=\"0\" y=\"98\" class=\"chart-label\">0%</text>\n                <rect x=\"32\" y=\"12\" width=\"150\" height=\"83\" fill=\"#3a8a3a\"/>\n                <rect x=\"182\" y=\"14\" width=\"40\" height=\"81\" fill=\"#3a8a3a\"/>\n                <rect x=\"222\" y=\"30\" width=\"30\" height=\"65\" fill=\"#3a8a3a\"/>\n                <rect x=\"252\" y=\"55\" width=\"22\" height=\"40\" fill=\"#3a8a3a\"/>\n                <rect x=\"274\" y=\"78\" width=\"12\" height=\"17\" fill=\"#3a8a3a\"/>\n                <rect x=\"286\" y=\"56\" width=\"10\" height=\"39\" fill=\"#3a8a3a\"/>\n                <rect x=\"296\" y=\"31\" width=\"12\" height=\"64\" fill=\"#3a8a3a\"/>\n                <text x=\"32\" y=\"112\" class=\"chart-label\">3 AM</text>\n                <text x=\"120\" y=\"112\" class=\"chart-label\">12 PM</text>\n                <text x=\"210\" y=\"112\" class=\"chart-label\">6 PM</text>\n                <text x=\"280\" y=\"112\" class=\"chart-label\">12 AM</text>\n              </svg>\n              <h5>Screen On Usage</h5>\n              <svg class=\"chart\" viewBox=\"0 0 320 90\" role=\"img\" aria-label=\"Bar chart of screen-on time per hour. The screen was on for about an hour each around 3 to 5 AM and again from 8 PM to midnight.\">\n                <line x1=\"30\" y1=\"10\" x2=\"30\" y2=\"65\" stroke=\"#9ea3ad\"/>\n                <line x1=\"30\" y1=\"65\" x2=\"310\" y2=\"65\" stroke=\"#9ea3ad\"/>\n                <text x=\"0\" y=\"14\" class=\"chart-label\">60m</text>\n                <text x=\"0\" y=\"42\" class=\"chart-label\">30m</text>\n                <rect x=\"34\" y=\"12\" width=\"9\" height=\"53\" fill=\"#2f5fd6\"/>\n                <rect x=\"46\" y=\"12\" width=\"9\" height=\"53\" fill=\"#2f5fd6\"/>\n                <rect x=\"58\" y=\"40\" width=\"9\" height=\"25\" fill=\"#2f5fd6\"/>\n                <rect x=\"232\" y=\"48\" width=\"9\" height=\"17\" fill=\"#2f5fd6\"/>\n                <rect x=\"244\" y=\"20\" width=\"9\" height=\"45\" fill=\"#2f5fd6\"/>\n                <rect x=\"256\" y=\"14\" width=\"9\" height=\"51\" fill=\"#2f5fd6\"/>\n                <rect x=\"268\" y=\"12\" width=\"9\" height=\"53\" fill=\"#2f5fd6\"/>\n                <rect x=\"280\" y=\"12\" width=\"9\" height=\"53\" fill=\"#2f5fd6\"/>\n                <rect x=\"292\" y=\"35\" width=\"9\" height=\"30\" fill=\"#2f5fd6\"/>\n                <text x=\"32\" y=\"82\" class=\"chart-label\">3 AM</text>\n                <text x=\"120\" y=\"82\" class=\"chart-label\">12 PM</text>\n                <text x=\"210\" y=\"82\" class=\"chart-label\">6 PM</text>\n                <text x=\"280\" y=\"82\" class=\"chart-label\">12 AM</text>\n              </svg>\n            </div>\n          </div>\n        </section>\n\n        <!-- Storage -->\n        <section class=\"app-window\" data-window=\"storage\" aria-labelledby=\"title-storage\" hidden>\n          <div class=\"title-bar\">\n            <span class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n            <h2 id=\"title-storage\" class=\"window-title\">Storage</h2>\n          </div>\n          <div class=\"window-body split\">\n            <aside class=\"sidebar\">\n              <ul class=\"sidebar-list\" aria-label=\"Settings categories\">\n                <li class=\"is-selected\" aria-current=\"true\">Storage</li>\n                <li>Storage Settings</li>\n              </ul>\n            </aside>\n            <div class=\"pane\">\n              <h3>Storage</h3>\n              <div class=\"storage-card\">\n                <p class=\"row\"><span class=\"row-name\">Main Drive</span><span>214.23 GB of 245.11 GB used</span></p>\n                <div class=\"storage-bar\" role=\"img\" aria-label=\"Storage bar. Applications, Documents, Messages, Files, and Photos together use about 60 percent. System Data uses about 27 percent. About 13 percent is free.\">\n                  <span class=\"seg seg-apps\"></span>\n                  <span class=\"seg seg-docs\"></span>\n                  <span class=\"seg seg-msgs\"></span>\n                  <span class=\"seg seg-files\"></span>\n                  <span class=\"seg seg-photos\"></span>\n                  <span class=\"seg seg-system\"></span>\n                </div>\n                <ul class=\"legend\">\n                  <li><span class=\"swatch seg-apps\" aria-hidden=\"true\"></span>Applications</li>\n                  <li><span class=\"swatch seg-docs\" aria-hidden=\"true\"></span>Documents</li>\n                  <li><span class=\"swatch seg-msgs\" aria-hidden=\"true\"></span>Messages</li>\n                  <li><span class=\"swatch seg-files\" aria-hidden=\"true\"></span>Files</li>\n                  <li><span class=\"swatch seg-photos\" aria-hidden=\"true\"></span>Photos</li>\n                  <li><span class=\"swatch seg-system\" aria-hidden=\"true\"></span>System Data</li>\n                </ul>\n              </div>\n              <h4>Recommendations</h4>\n              <ul class=\"row-list\">\n                <li class=\"row\"><span class=\"row-name\">Store in the Cloud<br><small>Keep only recent files on this computer to save space.</small></span><button type=\"button\" class=\"soft-button storage-action\">Store in Cloud</button></li>\n                <li class=\"row\"><span class=\"row-name\">Optimize Storage<br><small>Automatically remove movies and TV shows you have already watched.</small></span><button type=\"button\" class=\"soft-button storage-action\">Optimize</button></li>\n                <li class=\"row\"><span class=\"row-name\">Empty Trash automatically<br><small>Erase items that have been in the Trash for more than 30 days.</small></span><button type=\"button\" class=\"soft-button storage-action\">Turn On</button></li>\n              </ul>\n              <p id=\"storage-message\" class=\"small-note\" aria-live=\"polite\"></p>\n              <h4>Categories</h4>\n              <ul class=\"row-list\">\n                <li class=\"row\"><span class=\"row-name\">Applications</span><span>33.78 GB</span></li>\n                <li class=\"row\"><span class=\"row-name\">Documents</span><span>29.10 GB</span></li>\n                <li class=\"row\"><span class=\"row-name\">Messages</span><span>21.44 GB</span></li>\n                <li class=\"row\"><span class=\"row-name\">Photos</span><span>12.02 GB</span></li>\n                <li class=\"row\"><span class=\"row-name\">Developer</span><span>2.60 GB</span></li>\n                <li class=\"row\"><span class=\"row-name\">System Data</span><span>66.85 GB</span></li>\n              </ul>\n            </div>\n          </div>\n        </section>\n\n        <!-- Antivirus -->\n        <section class=\"app-window app-window-dark\" data-window=\"antivirus\" aria-labelledby=\"title-antivirus\" hidden>\n          <div class=\"title-bar\">\n            <span class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n            <h2 id=\"title-antivirus\" class=\"window-title\">Antivirus</h2>\n          </div>\n          <div class=\"window-body split\">\n            <aside class=\"sidebar sidebar-dark\">\n              <ul class=\"sidebar-list\" aria-label=\"Antivirus sections\">\n                <li>Dashboard</li>\n                <li class=\"is-selected\" aria-current=\"true\">Protection</li>\n                <li>Privacy</li>\n                <li>Notifications</li>\n                <li>My Account</li>\n                <li>Preferences</li>\n              </ul>\n            </aside>\n            <div class=\"pane\">\n              <h3><span class=\"shield-badge\" aria-hidden=\"true\"></span> Protection: You are protected</h3>\n              <ul class=\"scan-grid\">\n                <li class=\"scan-card\">\n                  <h4>Quick Scan</h4>\n                  <p class=\"small-note\">Checks the places threats hide most often.</p>\n                  <button type=\"button\" class=\"soft-button scan-button\" data-scan=\"Quick Scan\">Start Scan</button>\n                </li>\n                <li class=\"scan-card\">\n                  <h4>System Scan</h4>\n                  <p class=\"small-note\">Checks every file on the computer. Takes longer.</p>\n                  <button type=\"button\" class=\"soft-button scan-button\" data-scan=\"System Scan\">Start Scan</button>\n                </li>\n                <li class=\"scan-card\">\n                  <h4>Custom Scan</h4>\n                  <p class=\"small-note\">Pick the folders you want to check.</p>\n                  <button type=\"button\" class=\"soft-button scan-button\" data-scan=\"Custom Scan\">Choose</button>\n                </li>\n              </ul>\n              <p id=\"scan-message\" class=\"small-note\" aria-live=\"polite\">Last scan: today, 0 threats found.</p>\n              <ul class=\"row-list\">\n                <li class=\"row\"><span class=\"row-name\">Quarantine</span><span>0 items</span></li>\n                <li class=\"row\"><span class=\"row-name\">Exceptions</span><span>0 items</span></li>\n              </ul>\n            </div>\n          </div>\n        </section>\n\n        <!-- Voice Memos -->\n        <section class=\"app-window\" data-window=\"memos\" aria-labelledby=\"title-memos\" hidden>\n          <div class=\"title-bar\">\n            <span class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n            <h2 id=\"title-memos\" class=\"window-title\">Voice Memos</h2>\n          </div>\n          <div class=\"window-body split\">\n            <aside class=\"sidebar\">\n              <h3 class=\"sidebar-heading\">All Recordings</h3>\n              <ul id=\"memo-list\" class=\"sidebar-list\" aria-label=\"Recordings\">\n                <li class=\"is-selected\" aria-current=\"true\">New Recording<br><small>0:01</small></li>\n              </ul>\n            </aside>\n            <div class=\"pane centered\">\n              <svg class=\"waveform\" viewBox=\"0 0 300 80\" aria-hidden=\"true\" focusable=\"false\">\n                <path d=\"M0 40h20l6-18 6 36 6-30 6 24 6-12 6 6 6-20 6 34 6-28 6 16 6-8 6 4 6-22 6 30 6-24 6 12 6-6 6 20 6-30 6 26 6-14 6 8 6-4 6 18 6-26 6 22 6-10 6 6 6-16 6 24 6-20 6 12 6-8 6 4 6-14 6 20 6-16 6 8 6-4 6 12 6-16 6 12 6-6 6 4h20\" fill=\"none\" stroke=\"#5a5f6a\" stroke-width=\"2\"/>\n              </svg>\n              <p id=\"memo-timer\" class=\"memo-timer\">00:00</p>\n              <p id=\"memo-message\" class=\"small-note\" aria-live=\"polite\">Press Record to start a new voice memo.</p>\n              <button type=\"button\" id=\"record-button\" class=\"record-button\" aria-pressed=\"false\">Record</button>\n            </div>\n          </div>\n        </section>\n\n        <!-- Code Editor -->\n        <section class=\"app-window app-window-dark\" data-window=\"code\" aria-labelledby=\"title-code\" hidden>\n          <div class=\"title-bar\">\n            <span class=\"window-dots\" aria-hidden=\"true\"><i></i><i></i><i></i></span>\n            <h2 id=\"title-code\" class=\"window-title\">Code Editor</h2>\n          </div>\n          <div class=\"window-body split\">\n            <aside class=\"sidebar sidebar-dark\">\n              <h3 class=\"sidebar-heading\">Explorer</h3>\n              <ul class=\"sidebar-list\" aria-label=\"Files\">\n                <li>my-project</li>\n                <li class=\"indent\">index.html</li>\n                <li class=\"indent\">style.css</li>\n                <li class=\"indent\">script.js</li>\n              </ul>\n            </aside>\n            <div class=\"pane\">\n              <h3>Welcome</h3>\n              <div class=\"two-col\">\n                <div>\n                  <h4>Start</h4>\n                  <ul class=\"plain-list\">\n                    <li><button type=\"button\" class=\"link-button\" data-code-action=\"new\">New File</button></li>\n                    <li><button type=\"button\" class=\"link-button\" data-code-action=\"open\">Open Folder</button></li>\n                  </ul>\n                  <h4>Recent</h4>\n                  <ul class=\"plain-list small-note\">\n                    <li>my-project</li>\n                    <li>ai-lesson-4</li>\n                  </ul>\n                </div>\n                <div>\n                  <h4>Walkthroughs</h4>\n                  <ul class=\"plain-list\">\n                    <li><button type=\"button\" class=\"link-button\" data-code-action=\"tour\">Get Started with the Code Editor</button></li>\n                    <li><button type=\"button\" class=\"link-button\" data-code-action=\"tour\">Learn the Basics</button></li>\n                  </ul>\n                </div>\n              </div>\n              <p id=\"code-message\" class=\"small-note\" aria-live=\"polite\"></p>\n            </div>\n          </div>\n        </section>\n      </div>\n    </div>\n  </main>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": ":root {\n  --page-bg: #f4f5f7;\n  --text: #1f2430;\n  --text-muted: #555c68;\n  --text-on-dark: #f3f4f6;\n  --muted-on-dark: #c7ccd4;\n  --window-bg: #f2f2f4;\n  --window-dark-bg: #23262d;\n  --sidebar-bg: #e6e7ea;\n  --sidebar-dark-bg: #1a1c22;\n  --card-bg: #ffffff;\n  --card-dark-bg: #2f333b;\n  --border: #c9ccd3;\n  --border-dark: #444955;\n  --accent: #1f4fd6;\n  --accent-text: #ffffff;\n  --focus: #ffbf00;\n  --ok: #1e7a34;\n  --off: #b3261e;\n  --record: #d32f2f;\n  --desktop-top: #7d3fc8;\n  --desktop-mid: #c84fb0;\n  --desktop-bottom: #2a95d8;\n  --label-bg: rgba(20, 20, 30, 0.72);\n  --tile-gray: #6b6f78;\n  --tile-blue: #2f7fd6;\n  --tile-indigo: #4a4fd6;\n  --tile-red: #d32f2f;\n  --tile-green: #2f9e58;\n  --tile-teal: #1d9c9c;\n  --tile-orange: #e07a10;\n  --tile-dark: #2b2b33;\n  --tile-white: #ffffff;\n  --tile-purple: #5b3fa8;\n}\n\n* {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  padding: 1rem;\n  font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\n  font-size: 1rem;\n  line-height: 1.45;\n  color: var(--text);\n  background: var(--page-bg);\n}\n\nh1 {\n  font-size: 1.6rem;\n  margin: 0 0 0.25rem;\n}\n\nh2, h3, h4, h5 {\n  margin: 0.75rem 0 0.4rem;\n  line-height: 1.25;\n}\n\nh3 { font-size: 1.15rem; }\nh4 { font-size: 1rem; }\nh5 { font-size: 0.95rem; }\n\np {\n  margin: 0.35rem 0;\n}\n\nsmall,\n.small-note {\n  font-size: 0.875rem;\n  color: var(--text-muted);\n}\n\n.page-intro {\n  max-width: 60ch;\n  margin-bottom: 1rem;\n}\n\n.notice {\n  padding: 0.75rem 1rem;\n  border: 2px solid var(--off);\n  border-radius: 8px;\n  background: #fff3f2;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\nbutton,\nselect,\ntextarea,\ninput {\n  font: inherit;\n  color: inherit;\n}\n\nbutton {\n  cursor: pointer;\n}\n\n*:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 2px;\n}\n\n/* ---------- laptop frame ---------- */\n\n.laptop {\n  max-width: 1024px;\n  margin: 0 auto;\n  border: 8px solid #2b2b33;\n  border-radius: 18px;\n  background: #2b2b33;\n  overflow: hidden;\n}\n\n/* ---------- desktop ---------- */\n\n.desktop {\n  position: relative;\n  min-height: 420px;\n  padding-bottom: 1rem;\n  background:\n    radial-gradient(ellipse at 20% 110%, var(--desktop-bottom) 0, transparent 55%),\n    radial-gradient(ellipse at 90% 40%, var(--desktop-mid) 0, transparent 50%),\n    linear-gradient(160deg, var(--desktop-top), var(--desktop-mid) 60%, var(--desktop-bottom));\n}\n\n.menu-bar {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-between;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.35rem 0.75rem;\n  background: rgba(255, 255, 255, 0.85);\n  font-size: 0.875rem;\n}\n\n.menu-bar-name {\n  font-weight: 700;\n}\n\n.menu-bar-status {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.5rem;\n}\n\n.status-pill {\n  padding: 0.05rem 0.5rem;\n  border-radius: 999px;\n  background: rgba(0, 0, 0, 0.08);\n}\n\n.icon-grid {\n  list-style: none;\n  margin: 0;\n  padding: 1rem;\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));\n  gap: 0.75rem;\n}\n\n.app-icon {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.4rem;\n  width: 100%;\n  min-height: 44px;\n  padding: 0.6rem 0.4rem;\n  border: 2px solid transparent;\n  border-radius: 12px;\n  background: transparent;\n  transition: transform 120ms ease;\n}\n\n.app-icon:hover,\n.app-icon:focus-visible {\n  background: rgba(255, 255, 255, 0.18);\n  transform: scale(1.04);\n}\n\n.app-icon:active {\n  transform: scale(0.98);\n}\n\n.icon {\n  width: 64px;\n  height: 64px;\n  filter: drop-shadow(0 3px 4px rgba(0, 0, 0, 0.35));\n}\n\n.tile-gray   { fill: var(--tile-gray); }\n.tile-blue   { fill: var(--tile-blue); }\n.tile-indigo { fill: var(--tile-indigo); }\n.tile-red    { fill: var(--tile-red); }\n.tile-green  { fill: var(--tile-green); }\n.tile-teal   { fill: var(--tile-teal); }\n.tile-orange { fill: var(--tile-orange); }\n.tile-dark   { fill: var(--tile-dark); }\n.tile-white  { fill: var(--tile-white); }\n.tile-purple { fill: var(--tile-purple); }\n\n.app-label {\n  padding: 0.15rem 0.6rem;\n  border-radius: 999px;\n  background: var(--label-bg);\n  color: #fff;\n  font-size: 0.875rem;\n  font-weight: 600;\n  text-align: center;\n}\n\n/* ---------- app area ---------- */\n\n.app-area {\n  background: linear-gradient(160deg, var(--desktop-top), var(--desktop-mid) 60%, var(--desktop-bottom));\n  padding: 0.75rem;\n}\n\n.app-toolbar {\n  margin-bottom: 0.75rem;\n}\n\n.back-button {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.35rem;\n  min-height: 44px;\n  padding: 0.5rem 1rem;\n  border: 2px solid transparent;\n  border-radius: 999px;\n  background: #ffffff;\n  color: var(--text);\n  font-weight: 700;\n}\n\n.back-button:hover {\n  background: #e8f0ff;\n}\n\n.back-icon {\n  width: 1.1em;\n  height: 1.1em;\n}\n\n.app-window {\n  max-width: 900px;\n  margin: 0 auto;\n  border-radius: 12px;\n  background: var(--window-bg);\n  color: var(--text);\n  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);\n  overflow: hidden;\n}\n\n.app-window-narrow {\n  max-width: 420px;\n}\n\n.app-window-dark {\n  background: var(--window-dark-bg);\n  color: var(--text-on-dark);\n}\n\n.app-window-dark .small-note,\n.app-window-dark small {\n  color: var(--muted-on-dark);\n}\n\n.title-bar {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  padding: 0.5rem 0.75rem;\n  border-bottom: 1px solid var(--border);\n  background: rgba(0, 0, 0, 0.04);\n}\n\n.app-window-dark .title-bar {\n  border-color: var(--border-dark);\n  background: rgba(255, 255, 255, 0.04);\n}\n\n.window-title {\n  margin: 0;\n  font-size: 1rem;\n}\n\n.window-dots i {\n  display: inline-block;\n  width: 12px;\n  height: 12px;\n  margin-inline-end: 6px;\n  border-radius: 50%;\n  background: #d9534f;\n}\n\n.window-dots i:nth-child(2) { background: #e9b949; }\n.window-dots i:nth-child(3) { background: #4fb85a; }\n\n.window-body {\n  padding: 1rem;\n}\n\n.window-body.split {\n  display: grid;\n  grid-template-columns: minmax(150px, 1fr) 3fr;\n  gap: 0;\n  padding: 0;\n}\n\n.centered {\n  text-align: center;\n}\n\n/* ---------- sidebars & panes ---------- */\n\n.sidebar {\n  padding: 1rem 0.75rem;\n  background: var(--sidebar-bg);\n  border-inline-end: 1px solid var(--border);\n}\n\n.sidebar-dark {\n  background: var(--sidebar-dark-bg);\n  border-color: var(--border-dark);\n}\n\n.sidebar-art {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n}\n\n.big-gear {\n  width: 96px;\n  height: 96px;\n}\n\n.sidebar-caption,\n.sidebar-heading {\n  margin: 0.5rem 0;\n  font-size: 0.9rem;\n  font-weight: 700;\n}\n\n.sidebar-user {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  margin: 0 0 0.75rem;\n  font-weight: 600;\n  line-height: 1.2;\n}\n\n.avatar {\n  flex: none;\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  background: linear-gradient(135deg, #7c4dc4, #2fa860);\n}\n\n.sidebar-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  font-size: 0.95rem;\n}\n\n.sidebar-list li {\n  padding: 0.35rem 0.6rem;\n  border-radius: 6px;\n}\n\n.sidebar-list .indent {\n  padding-inline-start: 1.5rem;\n}\n\n.sidebar-list .is-selected {\n  background: var(--accent);\n  color: var(--accent-text);\n  font-weight: 600;\n}\n\n.sidebar-list .is-selected small {\n  color: var(--accent-text);\n}\n\n.pane {\n  min-width: 0;\n  padding: 1rem;\n}\n\n.pane h3:first-child {\n  margin-top: 0;\n}\n\n.pane-secondary {\n  background: rgba(0, 0, 0, 0.04);\n  border-inline-start: 1px solid var(--border);\n}\n\n.pane-header {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-between;\n  align-items: flex-start;\n  gap: 0.75rem;\n}\n\n.two-col {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n  gap: 1rem;\n}\n\n/* ---------- rows, lists, cards ---------- */\n\n.row-list,\n.plain-list {\n  list-style: none;\n  margin: 0.5rem 0;\n  padding: 0;\n}\n\n.plain-list li {\n  padding: 0.2rem 0;\n}\n\n.row-list {\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  background: var(--card-bg);\n}\n\n.app-window-dark .row-list {\n  border-color: var(--border-dark);\n  background: var(--card-dark-bg);\n}\n\n.row {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-between;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.65rem 0.85rem;\n  border-bottom: 1px solid var(--border);\n}\n\n.app-window-dark .row {\n  border-color: var(--border-dark);\n}\n\n.row:last-child {\n  border-bottom: 0;\n}\n\n.row-name {\n  font-weight: 600;\n}\n\n.row-name small {\n  display: block;\n  font-weight: 400;\n}\n\n.row-status::before {\n  content: \"\";\n  display: inline-block;\n  width: 10px;\n  height: 10px;\n  margin-inline-end: 0.4rem;\n  border-radius: 50%;\n  background: currentColor;\n}\n\n.status-ok  { color: var(--ok); }\n.status-off { color: var(--off); }\n\n.check-row {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  margin-top: 0.75rem;\n}\n\n.check-row input {\n  width: 20px;\n  height: 20px;\n}\n\n.fine-print {\n  font-size: 0.8rem;\n  color: var(--text-muted);\n}\n\n.soft-button {\n  min-height: 36px;\n  padding: 0.4rem 1rem;\n  border: 1px solid var(--border);\n  border-radius: 8px;\n  background: #ffffff;\n  color: var(--text);\n  font-weight: 600;\n}\n\n.soft-button:hover {\n  background: #e8f0ff;\n}\n\n.soft-button[disabled] {\n  cursor: default;\n  opacity: 0.6;\n}\n\n.link-button {\n  padding: 0.2rem 0;\n  border: 0;\n  background: none;\n  color: #8fb3ff;\n  text-decoration: underline;\n}\n\n.app-window:not(.app-window-dark) .link-button {\n  color: var(--accent);\n}\n\n.progress {\n  margin: 0.75rem 0;\n}\n\nprogress {\n  width: 100%;\n  height: 12px;\n}\n\n/* ---------- specs (About) ---------- */\n\n.laptop-art {\n  width: 200px;\n  max-width: 100%;\n  margin: 0.5rem auto;\n}\n\n.device-name {\n  margin: 0.5rem 0 0;\n  font-size: 1.5rem;\n}\n\n.device-sub {\n  margin-top: 0;\n}\n\n.spec-list {\n  display: grid;\n  grid-template-columns: auto auto;\n  justify-content: center;\n  column-gap: 1rem;\n  row-gap: 0.25rem;\n  margin: 0.75rem 0;\n  text-align: start;\n}\n\n.spec-list dt {\n  font-weight: 600;\n  text-align: end;\n}\n\n.spec-list dd {\n  margin: 0;\n}\n\n/* ---------- Docs ---------- */\n\n.doc-toolbar {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.75rem;\n  margin-bottom: 0.75rem;\n  font-size: 0.875rem;\n  color: var(--text-muted);\n}\n\n.fake-tab {\n  font-weight: 700;\n  color: var(--text);\n}\n\n.doc-page {\n  display: block;\n  width: 100%;\n  min-height: 240px;\n  padding: 1.25rem;\n  border: 1px solid var(--border);\n  border-radius: 4px;\n  background: #ffffff;\n  resize: vertical;\n}\n\n/* ---------- Video Meet ---------- */\n\n.meet-time {\n  margin: 0 0 0.75rem;\n  font-size: 2rem;\n  font-weight: 700;\n  line-height: 1.1;\n}\n\n.tile-buttons {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));\n  gap: 0.6rem;\n}\n\n.tile-button {\n  width: 100%;\n  min-height: 64px;\n  padding: 0.5rem;\n  border: 0;\n  border-radius: 12px;\n  color: #ffffff;\n  font-weight: 700;\n}\n\n.tile-button-orange { background: #c85a13; }\n.tile-button-blue   { background: #1f4fd6; }\n\n.tile-button:hover {\n  opacity: 0.9;\n}\n\n/* ---------- media cards ---------- */\n\n.channel-header {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  margin-bottom: 0.5rem;\n}\n\n.channel-avatar {\n  flex: none;\n  width: 48px;\n  height: 48px;\n  border-radius: 50%;\n  background: linear-gradient(135deg, #2f7fd6, #7c4dc4);\n}\n\n.card-grid,\n.photo-grid {\n  list-style: none;\n  margin: 0.5rem 0 0;\n  padding: 0;\n  display: grid;\n  gap: 0.75rem;\n}\n\n.card-grid {\n  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));\n}\n\n.photo-grid {\n  grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));\n}\n\n.media-card img,\n.photo-grid img {\n  display: block;\n  width: 100%;\n  height: auto;\n  border-radius: 8px;\n  background: #d5d8de;\n}\n\n.card-title {\n  margin: 0.4rem 0 0;\n  font-weight: 600;\n}\n\n.now-playing {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: space-between;\n  align-items: center;\n  gap: 0.5rem;\n  margin-top: 1rem;\n  padding: 0.6rem 0.85rem;\n  border-radius: 10px;\n  background: var(--card-dark-bg);\n}\n\n/* ---------- Camera ---------- */\n\n.viewfinder {\n  width: 100%;\n  max-width: 480px;\n  aspect-ratio: 4 / 3;\n  margin: 0 auto 0.75rem;\n  border-radius: 8px;\n  background: #3a3d46;\n  transition: background 200ms ease;\n}\n\n.viewfinder.is-flash {\n  background: #ffffff;\n}\n\n/* ---------- Design Studio ---------- */\n\n.design-hero {\n  padding: 1.25rem 1rem;\n  border-radius: 12px;\n  background: linear-gradient(135deg, #1d9c9c, #4a4fd6);\n  color: #ffffff;\n  text-align: center;\n}\n\n.design-hero h3 {\n  margin-top: 0;\n  color: #ffffff;\n}\n\n.chip-row {\n  list-style: none;\n  margin: 0.5rem 0 0;\n  padding: 0;\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 0.5rem;\n}\n\n.chip {\n  min-height: 36px;\n  padding: 0.35rem 0.9rem;\n  border: 0;\n  border-radius: 999px;\n  background: #ffffff;\n  color: var(--text);\n  font-weight: 600;\n}\n\n.chip:hover,\n.chip[aria-pressed=\"true\"] {\n  background: #ffe7a3;\n}\n\n.template-grid {\n  list-style: none;\n  margin: 0.5rem 0 0;\n  padding: 0;\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));\n  gap: 0.75rem;\n}\n\n.template {\n  display: flex;\n  align-items: flex-end;\n  min-height: 90px;\n  padding: 0.5rem;\n  border-radius: 8px;\n  color: #ffffff;\n  font-weight: 700;\n  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);\n}\n\n.template-a { background: #2f7fd6; }\n.template-b { background: #2f9e58; }\n.template-c { background: #c84fb0; }\n.template-d { background: #e07a10; }\n.template-e { background: #4a4fd6; }\n\n/* ---------- charts ---------- */\n\n.chart {\n  display: block;\n  width: 100%;\n  max-width: 560px;\n  margin: 0.25rem 0 0.75rem;\n  padding: 0.5rem;\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  background: var(--card-bg);\n}\n\n.chart-label {\n  font-size: 9px;\n  fill: var(--text-muted);\n}\n\n/* ---------- Storage ---------- */\n\n.storage-card {\n  padding: 0.75rem 0.85rem;\n  border: 1px solid var(--border);\n  border-radius: 10px;\n  background: var(--card-bg);\n}\n\n.storage-card .row {\n  padding: 0;\n  border: 0;\n}\n\n.storage-bar {\n  display: flex;\n  height: 22px;\n  margin: 0.5rem 0;\n  border-radius: 6px;\n  overflow: hidden;\n  background: #cfd3da;\n}\n\n.seg {\n  display: block;\n  height: 100%;\n}\n\n.seg-apps   { flex: 14; background: #c62828; }\n.seg-docs   { flex: 12; background: #d9541e; }\n.seg-msgs   { flex: 9;  background: #b5741a; }\n.seg-files  { flex: 5;  background: #2e7d32; }\n.seg-photos { flex: 5;  background: #1e88a8; }\n.seg-system { flex: 27; background: #6b6f78; }\n\n.legend {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 0.4rem 1rem;\n  font-size: 0.875rem;\n}\n\n.swatch {\n  display: inline-block;\n  width: 10px;\n  height: 10px;\n  margin-inline-end: 0.35rem;\n  border-radius: 50%;\n}\n\n/* ---------- Antivirus ---------- */\n\n.shield-badge {\n  display: inline-block;\n  width: 14px;\n  height: 14px;\n  border-radius: 50% 50% 50% 50% / 40% 40% 60% 60%;\n  background: var(--ok);\n  vertical-align: -2px;\n}\n\n.scan-grid {\n  list-style: none;\n  margin: 0.5rem 0;\n  padding: 0;\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));\n  gap: 0.75rem;\n}\n\n.scan-card {\n  display: flex;\n  flex-direction: column;\n  gap: 0.35rem;\n  padding: 0.85rem;\n  border: 1px solid var(--border-dark);\n  border-radius: 10px;\n  background: var(--card-dark-bg);\n}\n\n.scan-card h4 {\n  margin: 0;\n}\n\n.scan-card .small-note {\n  flex: 1;\n}\n\n/* ---------- Voice Memos ---------- */\n\n.waveform {\n  display: block;\n  width: 100%;\n  max-width: 420px;\n  margin: 0 auto;\n}\n\n.memo-timer {\n  margin: 0.25rem 0;\n  font-size: 2rem;\n  font-variant-numeric: tabular-nums;\n  font-weight: 700;\n}\n\n.record-button {\n  min-width: 44px;\n  min-height: 44px;\n  padding: 0.5rem 1.4rem;\n  border: 3px solid var(--record);\n  border-radius: 999px;\n  background: #ffffff;\n  color: var(--record);\n  font-weight: 700;\n}\n\n.record-button[aria-pressed=\"true\"] {\n  background: var(--record);\n  color: #ffffff;\n}\n\n/* ---------- responsive ---------- */\n\n@media (max-width: 600px) {\n  body {\n    padding: 0.5rem;\n  }\n\n  .laptop {\n    border-width: 5px;\n    border-radius: 12px;\n  }\n\n  .icon-grid {\n    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));\n    padding: 0.75rem 0.5rem;\n  }\n\n  .icon {\n    width: 52px;\n    height: 52px;\n  }\n\n  .window-body.split {\n    grid-template-columns: 1fr;\n  }\n\n  .sidebar {\n    border-inline-end: 0;\n    border-bottom: 1px solid var(--border);\n  }\n\n  .sidebar-list {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 0.25rem;\n  }\n\n  .pane-secondary {\n    border-inline-start: 0;\n    border-top: 1px solid var(--border);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .app-icon,\n  .viewfinder {\n    transition: none;\n  }\n\n  .app-icon:hover,\n  .app-icon:focus-visible,\n  .app-icon:active {\n    transform: none;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "(function () {\n  'use strict';\n\n  const desktop = document.getElementById('desktop');\n  const appArea = document.getElementById('app-area');\n  const backButton = document.getElementById('back-button');\n  const status = document.getElementById('status');\n  const windows = Array.from(document.querySelectorAll('.app-window'));\n  const appIcons = Array.from(document.querySelectorAll('.app-icon'));\n\n  const reduceMotion =\n    window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  let lastIcon = null;\n  const timers = [];\n\n  if (!desktop || !appArea || !backButton) {\n    showFatalError();\n    return;\n  }\n\n  function showFatalError() {\n    const message = document.createElement('p');\n    message.className = 'notice';\n    message.textContent = 'Something went wrong while loading the simulator. Please reload the page.';\n    document.querySelector('main').appendChild(message);\n  }\n\n  function announce(text) {\n    status.textContent = '';\n    window.setTimeout(() => {\n      status.textContent = text;\n    }, 50);\n  }\n\n  function trackTimer(id) {\n    timers.push(id);\n    return id;\n  }\n\n  function clearTimers() {\n    while (timers.length) {\n      window.clearInterval(timers.pop());\n    }\n  }\n\n  /* ---------- navigation ---------- */\n\n  function openApp(appName, icon) {\n    const target = windows.find((win) => win.dataset.window === appName);\n    if (!target) {\n      return;\n    }\n    lastIcon = icon;\n    windows.forEach((win) => {\n      win.hidden = win !== target;\n    });\n    desktop.hidden = true;\n    appArea.hidden = false;\n    backButton.focus();\n    const title = target.querySelector('.window-title').textContent;\n    announce(`${title} opened.`);\n  }\n\n  function closeApp() {\n    clearTimers();\n    resetTransientState();\n    appArea.hidden = true;\n    desktop.hidden = false;\n    if (lastIcon) {\n      lastIcon.focus();\n    }\n    announce('Back to the desktop.');\n  }\n\n  appIcons.forEach((icon) => {\n    icon.addEventListener('click', () => openApp(icon.dataset.app, icon));\n  });\n\n  backButton.addEventListener('click', closeApp);\n\n  document.addEventListener('keydown', (event) => {\n    if (event.key === 'Escape' && !appArea.hidden) {\n      closeApp();\n    }\n  });\n\n  /* ---------- clocks ---------- */\n\n  const menuClock = document.getElementById('menu-clock');\n  const meetClock = document.getElementById('meet-clock');\n  const meetDate = document.getElementById('meet-date');\n  const timeFormat = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });\n  const dateFormat = new Intl.DateTimeFormat(undefined, {\n    weekday: 'long',\n    month: 'long',\n    day: 'numeric'\n  });\n\n  function updateClocks() {\n    const now = new Date();\n    const time = timeFormat.format(now);\n    menuClock.textContent = time;\n    meetClock.textContent = time;\n    meetDate.textContent = dateFormat.format(now);\n  }\n\n  updateClocks();\n  window.setInterval(updateClocks, 30000);\n\n  /* ---------- About This Device ---------- */\n\n  const moreInfoButton = document.getElementById('more-info-button');\n  const moreInfo = document.getElementById('more-info');\n\n  moreInfoButton.addEventListener('click', () => {\n    const expanded = moreInfoButton.getAttribute('aria-expanded') === 'true';\n    moreInfoButton.setAttribute('aria-expanded', String(!expanded));\n    moreInfo.hidden = expanded;\n    moreInfoButton.textContent = expanded ? 'More Info' : 'Less Info';\n  });\n\n  /* ---------- Software Update ---------- */\n\n  const updateButton = document.getElementById('update-button');\n  const updateList = document.getElementById('update-list');\n  const updateProgress = document.getElementById('update-progress');\n  const updateProgressText = document.getElementById('update-progress-text');\n  const updateProgressBar = document.getElementById('update-progress-bar');\n  const updateHeading = document.getElementById('update-heading');\n\n  function runUpdate() {\n    updateButton.disabled = true;\n    updateList.hidden = true;\n    updateProgress.hidden = false;\n    updateProgressBar.value = reduceMotion ? 100 : 0;\n    updateProgressText.textContent = 'Downloading update';\n\n    const finish = () => {\n      updateProgressText.textContent = 'Update downloaded. Restart to finish installing.';\n      updateHeading.textContent = 'Your computer is ready to restart';\n      updateButton.disabled = false;\n      updateButton.textContent = 'Restart Now';\n      announce('Update downloaded. Restart to finish installing.');\n    };\n\n    if (reduceMotion) {\n      finish();\n      return;\n    }\n\n    const id = trackTimer(window.setInterval(() => {\n      updateProgressBar.value = Math.min(100, updateProgressBar.value + 5);\n      if (updateProgressBar.value >= 100) {\n        window.clearInterval(id);\n        finish();\n      }\n    }, 120));\n  }\n\n  function restartComputer() {\n    updateHeading.textContent = 'Your computer is up to date';\n    updateProgress.hidden = true;\n    updateList.hidden = true;\n    updateButton.hidden = true;\n    announce('The computer restarted. Software is up to date.');\n  }\n\n  updateButton.addEventListener('click', () => {\n    if (updateButton.textContent === 'Restart Now') {\n      restartComputer();\n    } else {\n      runUpdate();\n    }\n  });\n\n  /* ---------- Video Meet ---------- */\n\n  const meetMessage = document.getElementById('meet-message');\n\n  document.querySelectorAll('.tile-button').forEach((button) => {\n    button.addEventListener('click', () => {\n      const label = button.textContent.trim();\n      meetMessage.textContent = `${label} is not available in this simulator.`;\n    });\n  });\n\n  /* ---------- Camera ---------- */\n\n  const shutterButton = document.getElementById('shutter-button');\n  const viewfinder = document.querySelector('.viewfinder');\n  const cameraMessage = document.getElementById('camera-message');\n\n  shutterButton.addEventListener('click', () => {\n    if (!reduceMotion) {\n      viewfinder.classList.add('is-flash');\n      window.setTimeout(() => viewfinder.classList.remove('is-flash'), 150);\n    }\n    cameraMessage.textContent = 'Photo saved to the Photos app.';\n  });\n\n  /* ---------- Music ---------- */\n\n  const playButton = document.getElementById('play-button');\n\n  playButton.addEventListener('click', () => {\n    const playing = playButton.getAttribute('aria-pressed') === 'true';\n    playButton.setAttribute('aria-pressed', String(!playing));\n    playButton.textContent = playing ? 'Play' : 'Pause';\n  });\n\n  /* ---------- Design Studio ---------- */\n\n  document.querySelectorAll('.chip').forEach((chip) => {\n    chip.setAttribute('aria-pressed', 'false');\n    chip.addEventListener('click', () => {\n      document.querySelectorAll('.chip').forEach((other) => {\n        other.setAttribute('aria-pressed', String(other === chip));\n      });\n    });\n  });\n\n  /* ---------- Storage ---------- */\n\n  const storageMessage = document.getElementById('storage-message');\n\n  document.querySelectorAll('.storage-action').forEach((button) => {\n    button.addEventListener('click', () => {\n      const label = button.textContent.trim();\n      storageMessage.textContent = `\"${label}\" is turned on. Freed-up space will show here later.`;\n      button.disabled = true;\n    });\n  });\n\n  /* ---------- Antivirus ---------- */\n\n  const scanMessage = document.getElementById('scan-message');\n\n  document.querySelectorAll('.scan-button').forEach((button) => {\n    button.addEventListener('click', () => {\n      const scanName = button.dataset.scan;\n      scanMessage.textContent = `${scanName} is running.`;\n      button.disabled = true;\n      const delay = reduceMotion ? 0 : 1500;\n      window.setTimeout(() => {\n        scanMessage.textContent = `${scanName} finished. 0 threats found.`;\n        button.disabled = false;\n      }, delay);\n    });\n  });\n\n  /* ---------- Voice Memos ---------- */\n\n  const recordButton = document.getElementById('record-button');\n  const memoTimer = document.getElementById('memo-timer');\n  const memoMessage = document.getElementById('memo-message');\n  const memoList = document.getElementById('memo-list');\n  let memoSeconds = 0;\n  let memoInterval = null;\n  let memoCount = 1;\n\n  function formatSeconds(total) {\n    const minutes = Math.floor(total / 60);\n    const seconds = total % 60;\n    const two = new Intl.NumberFormat(undefined, { minimumIntegerDigits: 2 });\n    return `${two.format(minutes)}:${two.format(seconds)}`;\n  }\n\n  function startRecording() {\n    memoSeconds = 0;\n    memoTimer.textContent = formatSeconds(0);\n    memoMessage.textContent = 'Recording. Press Stop when you are done.';\n    recordButton.setAttribute('aria-pressed', 'true');\n    recordButton.textContent = 'Stop';\n    memoInterval = trackTimer(window.setInterval(() => {\n      memoSeconds += 1;\n      memoTimer.textContent = formatSeconds(memoSeconds);\n    }, 1000));\n  }\n\n  function stopRecording() {\n    window.clearInterval(memoInterval);\n    memoInterval = null;\n    recordButton.setAttribute('aria-pressed', 'false');\n    recordButton.textContent = 'Record';\n    memoCount += 1;\n    const item = document.createElement('li');\n    item.textContent = `New Recording ${memoCount} (${formatSeconds(memoSeconds)})`;\n    memoList.appendChild(item);\n    memoMessage.textContent = `Saved a ${formatSeconds(memoSeconds)} recording.`;\n  }\n\n  recordButton.addEventListener('click', () => {\n    if (memoInterval) {\n      stopRecording();\n    } else {\n      startRecording();\n    }\n  });\n\n  /* ---------- Code Editor ---------- */\n\n  const codeMessage = document.getElementById('code-message');\n  const codeMessages = {\n    new: 'A new empty file named Untitled-1 is open.',\n    open: 'Choose a folder to open. (Folders cannot be opened in this simulator.)',\n    tour: 'Walkthroughs are not available in this simulator.'\n  };\n\n  document.querySelectorAll('[data-code-action]').forEach((button) => {\n    button.addEventListener('click', () => {\n      codeMessage.textContent = codeMessages[button.dataset.codeAction];\n    });\n  });\n\n  /* ---------- reset when leaving an app ---------- */\n\n  function resetTransientState() {\n    if (memoInterval) {\n      memoInterval = null;\n      recordButton.setAttribute('aria-pressed', 'false');\n      recordButton.textContent = 'Record';\n      memoMessage.textContent = 'Press Record to start a new voice memo.';\n      memoTimer.textContent = formatSeconds(0);\n    }\n    if (updateButton.disabled) {\n      updateButton.disabled = false;\n      updateList.hidden = false;\n      updateProgress.hidden = true;\n    }\n  }\n})();",
          "folderId": "0",
          "active": true
        },
