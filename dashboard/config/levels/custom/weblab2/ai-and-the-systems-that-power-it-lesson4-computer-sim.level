<Weblab2>
  <config><![CDATA[{
  "published": true,
  "game_id": 74,
  "created_at": "2026-09-09T18:18:40.000Z",
  "level_num": "custom",
  "user_id": 18603,
  "properties": {
    "encrypted": "false",
    "display_name": "Computer Simulation",
    "long_instructions": "# Computer Simulation\r\n\r\nThis is a simulation of a laptop. \r\n\r\nYou can select apps by clicking them, or you can select them with the **Tab** key and open one with **Enter** or **Space**.\r\n\r\nUse **Back to Desktop** button or the **Escape** key to return to the main screen. \r\n\r\n\r\n",
    "bubble_choice_description": "This is a simulation of a computer system that you can explore.",
    "offer_browser_tts": "false",
    "submittable": "false",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "widget_view": "true",
    "require_edit_to_continue": "true",
    "initial_view_mode": "split",
    "predict_settings": {
      "isPredictLevel": false,
      "solution": "",
      "questionType": "freeResponse",
      "placeholderText": "",
      "multipleChoiceOptions": [
        ""
      ],
      "freeResponseHeight": 50,
      "codeEditableAfterSubmit": false
    },
    "ai_tutor_prompt_settings": {
      "answerTypes": [
        "ask"
      ],
      "answerTypeCustomizations": {
