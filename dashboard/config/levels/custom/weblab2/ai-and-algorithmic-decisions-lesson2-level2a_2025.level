  "properties": {
    "encrypted": "false",
    "display_name": "Broken Photo Carousel",
    "bubble_choice_description": "The Next button should change the picture, but it's stuck on the same one. Figure out what's stopping the photos from switching.",
    "submittable": "false",
    "hide_share_and_remix": "false",
