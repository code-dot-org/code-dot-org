        "14": {
          "id": "14",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Sensor Explorer: The Park</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body data-scene=\"park\">\n  <main class=\"app\">\n    <header class=\"app-header\">\n      <h1>Sensor Explorer: The Park</h1>\n      <p class=\"intro\">Pick one sensor, then click something in the park to see the data that sensor collects.</p>\n    </header>\n\n    <div class=\"sensor-bar\" role=\"group\" aria-label=\"Sensors\">\n      <span class=\"sensor-bar-label\">Sensors:</span>\n      <button class=\"sensor-btn\" type=\"button\" data-sensor=\"temperature\" aria-pressed=\"false\"><img src=\"icon-temperature.png\" alt=\"\"><span>Temperature</span></button>\n      <button class=\"sensor-btn\" type=\"button\" data-sensor=\"sound\" aria-pressed=\"false\"><img src=\"icon-sound.png\" alt=\"\"><span>Sound</span></button>\n      <button class=\"sensor-btn\" type=\"button\" data-sensor=\"camera\" aria-pressed=\"false\"><img src=\"icon-camera.png\" alt=\"\"><span>Optical / Camera</span></button>\n      <button class=\"sensor-btn\" type=\"button\" data-sensor=\"gps\" aria-pressed=\"false\"><img src=\"icon-gps.png\" alt=\"\"><span>GPS / Position</span></button>\n      <button class=\"sensor-btn\" type=\"button\" data-sensor=\"weight\" aria-pressed=\"false\"><img src=\"icon-weight.png\" alt=\"\"><span>Weight</span></button>\n      <button class=\"sensor-btn\" type=\"button\" data-sensor=\"heartRate\" aria-pressed=\"false\"><img src=\"icon-heart-rate.png\" alt=\"\"><span>Heart rate</span></button>\n      <label class=\"checkbox-label\"><input type=\"checkbox\" id=\"sound-toggle\" checked><span>Play sounds</span></label>\n    </div>\n\n    <div class=\"workspace\">\n      <section class=\"panel scene-panel\" aria-labelledby=\"scene-heading\">\n        <h2 id=\"scene-heading\">The park</h2>\n        <p id=\"scene-help\" class=\"help\">Hover or tap to preview a reading. Click to record it. With a keyboard, press Tab to reach the picture, use the arrow keys to move between objects, and press Enter to record.</p>\n\n        <div class=\"scene\">\n          <img class=\"scene-image\" id=\"scene-image\" src=\"park-scene.jpg\" width=\"1312\" height=\"816\"\n            alt=\"A painting of a sunny park with a large tree, a dog, a wooden bench, a pond with a duck, and the sun in the sky.\">\n          <svg class=\"scene-hotspots\" id=\"scene\" viewBox=\"0 0 1312 816\" role=\"group\" aria-labelledby=\"scene-heading\" aria-describedby=\"scene-help\"></svg>\n        </div>\n        <p class=\"notice\" id=\"image-message\" hidden>The picture didn&#x27;t load, but you can still use the arrow keys to take readings.</p>\n      </section>\n\n      <div class=\"side\">\n        <section class=\"panel readout-panel\" aria-labelledby=\"readout-heading\">\n          <h2 id=\"readout-heading\">Sensor Reading</h2>\n          <div class=\"lcd\">\n            <p class=\"lcd-sensor\" id=\"readout-sensor\">No sensor selected</p>\n            <p class=\"lcd-target\" id=\"readout-target\">Not pointing at anything yet</p>\n            <p class=\"lcd-value\" id=\"readout-value\">No reading</p>\n          </div>\n          <canvas class=\"viz\" id=\"viz\" aria-hidden=\"true\"></canvas>\n          <p class=\"viz-caption\" id=\"viz-caption\"></p>\n          <p class=\"readout-note\" id=\"readout-note\">Choose a sensor above to start taking readings.</p>\n          <button class=\"button\" id=\"replay-sound\" type=\"button\" hidden>Play sound again</button>\n          <p class=\"notice\" id=\"audio-message\" hidden>This browser can't play sounds, but the sound readings and sound waves still work.</p>\n          <p class=\"visually-hidden\" id=\"status\" role=\"status\" aria-live=\"polite\"></p>\n        </section>\n\n        <section class=\"panel log-panel\" aria-labelledby=\"log-heading\">\n          <h2 id=\"log-heading\">Recorded Readings</h2>\n          <p class=\"help\">Click an object to save its reading here.</p>\n          <div class=\"table-wrap\">\n            <table>\n              <thead>\n                <tr><th scope=\"col\">Object</th><th scope=\"col\">Sensor</th><th scope=\"col\">Reading</th></tr>\n              </thead>\n              <tbody id=\"log-body\"></tbody>\n            </table>\n          </div>\n          <button class=\"button\" id=\"clear-log\" type=\"button\">Clear readings</button>\n        </section>\n      </div>\n    </div>\n\n    <p class=\"app-error\" id=\"app-error\" role=\"alert\" hidden>The sensor explorer couldn't start. Reload the page to try again.</p>\n  </main>\n</body>\n</html>\n",
          "folderId": "0",
          "active": true
        },
        "15": {
          "id": "15",
          "name": "script.js",
          "contents": "(function () {\n  'use strict';\n\n  const SVG_NS = 'http://www.w3.org/2000/svg';\n  const LOCALE = document.documentElement.lang || 'en';\n  const LOUDEST_DB = 100;\n  const LOG_LIMIT = 10;\n  const DEGREES_PER_SCENE_UNIT = 0.00001;\n  // Set to true while authoring hotspots: outlines every hotspot and logs\n  // clicked scene coordinates to the console.\n  const SHOW_HOTSPOTS = false;\n  const SENSOR_ORDER = ['temperature', 'sound', 'camera', 'gps', 'weight', 'heartRate'];\n\n  const SENSORS = {\n    temperature: {\n      label: 'Temperature',\n      icon: 'icon-temperature.png',\n      note: 'The sensor measures how hot or cold it is at the spot you pointed at.',\n      zeroNote: 'Nothing here gives the temperature sensor a reading, so it reads 0.'\n    },\n    sound: {\n      label: 'Sound',\n      icon: 'icon-sound.png',\n      note: 'The sensor measures how loud the sound is in decibels (dB) and records its sound wave.',\n      zeroNote: 'This is silent, so the sound sensor reads 0 and there is nothing to play.'\n    },\n    camera: {\n      label: 'Optical / Camera',\n      icon: 'icon-camera.png',\n      note: 'The camera takes a picture, and a computer vision model labels what it sees and how confident it is.',\n      zeroNote: 'The camera cannot recognize anything here, so it records 0.'\n    },\n    gps: {\n      label: 'GPS / Position',\n      icon: 'icon-gps.png',\n      note: 'The sensor finds where this is on Earth using latitude and longitude.',\n      zeroNote: 'There is no position to report here, so the sensor reads 0.'\n    },\n    weight: {\n      label: 'Weight',\n      icon: 'icon-weight.png',\n      note: 'The scale measures how heavy this is.',\n      zeroNote: 'Nothing can rest on the scale here, so it reads 0.'\n    },\n    heartRate: {\n      label: 'Heart rate',\n      icon: 'icon-heart-rate.png',\n      note: 'The sensor counts heartbeats per minute (bpm). It only works when it is worn by, or touching, a living person or animal.',\n      zeroNote: 'There is no heartbeat here, so the heart rate sensor reads 0.'\n    }\n  };\n\n  /* ---------- Formatting ---------- */\n\n  function makeUnitFormatter(unit, suffix, options) {\n    try {\n      return new Intl.NumberFormat(LOCALE, Object.assign({ style: 'unit', unit: unit, unitDisplay: 'short' }, options));\n    } catch (error) {\n      const plain = new Intl.NumberFormat(LOCALE, options);\n      return { format: (value) => `${plain.format(value)} ${suffix}` };\n    }\n  }\n\n  const fmt = {\n    fahrenheit: makeUnitFormatter('fahrenheit', '°F', { maximumFractionDigits: 1 }),\n    celsius: makeUnitFormatter('celsius', '°C', { maximumFractionDigits: 1 }),\n    pound: makeUnitFormatter('pound', 'lb', { maximumFractionDigits: 1 }),\n    inch: makeUnitFormatter('inch', 'in', { maximumFractionDigits: 0 }),\n    mph: makeUnitFormatter('mile-per-hour', 'mph', { maximumFractionDigits: 1 }),\n    coordinate: new Intl.NumberFormat(LOCALE, { maximumSignificantDigits: 4 }),\n    integer: new Intl.NumberFormat(LOCALE, { maximumFractionDigits: 0 }),\n    decimal: new Intl.NumberFormat(LOCALE, { minimumFractionDigits: 1, maximumFractionDigits: 1 }),\n    percent: new Intl.NumberFormat(LOCALE, { style: 'percent', maximumFractionDigits: 0 })\n  };\n\n  const format = {\n    decibels: (value) => `${fmt.integer.format(value)} dB`,\n    bpm: (value) => `${fmt.integer.format(value)} bpm`,\n    bodyWeight: (value) => `${fmt.decimal.format(value)} times body weight`,\n    pound: (value) => fmt.pound.format(value),\n    degrees: (value) => `${fmt.coordinate.format(value)}°`\n  };\n\n  /* ---------- Scenes ----------\n     Each Web Lab version sets <body data-scene=\"...\"> to pick one scene.\n     size is the coordinate space for every point below; the JPEG can be\n     any size with the same aspect ratio.\n\n     mode \"explore\": students pick one sensor, then point at objects.\n       Object readings: temperature, sound dB, weight, heartRate bpm,\n       camera { sees, confidence, note }, gps true/false. A missing key reads 0.\n       Hotspots are listed in keyboard order; layer sets paint order\n       (higher layers sit on top and win clicks where shapes overlap).\n\n     mode \"plan\": students toggle sensors on to build a plan.\n       Every sensor shows where it would go and what it would record, whether or\n       not it helps. Students decide which ones are useful; the notes describe\n       the data without saying so. A sensor left out reads 0. */\n\n  const SCENES = {\n    park: {\n      mode: 'explore',\n      size: { width: 1312, height: 816 },\n      tempUnit: 'fahrenheit',\n      tempRange: { min: 0, max: 120 },\n      weightMax: 100,\n      mapOrigin: { lat: 40.7812, lon: -73.9665 },\n      hotspots: [\n        {\n          id: 'tree', name: 'Tree', layer: 1,\n          points: [[55, 270], [70, 200], [110, 130], [180, 85], [250, 60], [330, 75], [400, 110], [455, 170], [505, 240], [510, 300], [470, 340], [400, 350], [330, 370], [310, 500], [330, 525], [210, 525], [250, 490], [255, 375], [180, 350], [100, 350], [60, 320]],\n          readings: { temperature: 72, camera: { sees: 'tree', confidence: 0.97 }, gps: true },\n          notes: {\n            temperature: 'The shade under the tree keeps this spot cooler.',\n            weight: 'The tree is rooted in the ground and cannot be placed on the scale, so the scale reads 0.',\n            heartRate: 'Trees are alive, but they do not have a heart, so the heart rate sensor reads 0.'\n          }\n        },\n        {\n          id: 'dog', name: 'Dog', layer: 2, soundType: 'bark',\n          points: [[130, 690], [180, 640], [200, 605], [260, 580], [335, 575], [345, 555], [380, 555], [408, 578], [380, 600], [365, 640], [355, 745], [170, 745], [185, 690]],\n          readings: { temperature: 101, sound: 85, camera: { sees: 'dog', confidence: 0.96, note: 'Standing' }, gps: true, weight: 62, heartRate: 90 },\n          notes: { temperature: 'Dogs make their own body heat, so this reading is warmer than the air.' }\n        },\n        {\n          id: 'bench', name: 'Bench', layer: 1,\n          points: [[510, 455], [730, 440], [800, 480], [805, 590], [790, 595], [600, 630], [530, 610], [520, 520]],\n          readings: { temperature: 81, camera: { sees: 'bench', confidence: 0.95, note: 'Empty' }, gps: true, weight: 77 },\n          notes: { temperature: 'The wooden bench has been soaking up sunlight.' }\n        },\n        {\n          id: 'sun', name: 'Sun', layer: 1,\n          circle: { x: 1138, y: 148, r: 100 },\n          readings: { temperature: 88, camera: { sees: 'sun', confidence: 0.98, note: 'Bright light source' } },\n          notes: {\n            temperature: 'This is the air temperature in direct sunlight, not the temperature of the sun itself.',\n            gps: 'The sun is not on Earth, so it has no latitude or longitude. The sensor reads 0.',\n            weight: 'The sun cannot be placed on the scale, so the scale reads 0.'\n          }\n        },\n        {\n          id: 'pond', name: 'Pond', layer: 1, soundType: 'water',\n          points: [[990, 540], [1050, 520], [1280, 515], [1280, 785], [1110, 785], [1010, 720], [905, 690], [880, 645], [930, 605], [1030, 570]],\n          readings: { temperature: 63, sound: 45, camera: { sees: 'water', confidence: 0.93, note: 'Still surface' }, gps: true },\n          notes: {\n            temperature: 'Water stays cooler than the air on a sunny day.',\n            weight: 'The pond cannot be placed on the scale, so the scale reads 0.'\n          }\n        },\n        {\n          id: 'duck', name: 'Duck', layer: 2, soundType: 'quack',\n          points: [[1093, 610], [1110, 590], [1135, 595], [1150, 612], [1192, 618], [1185, 642], [1105, 645]],\n          readings: { temperature: 106, sound: 70, camera: { sees: 'duck', confidence: 0.9, note: 'Swimming' }, gps: true, weight: 2.6, heartRate: 140 },\n          notes: {\n            temperature: 'Ducks make their own body heat, so this reading is warmer than the air.',\n            heartRate: 'Small animals like ducks have much faster heartbeats than people do.'\n          }\n        },\n        {\n          id: 'grass', name: 'Grass', layer: 0,\n          points: [[35, 455], [1280, 455], [1280, 785], [35, 785]],\n          readings: { temperature: 75, camera: { sees: 'grass', confidence: 0.97 }, gps: true },\n          notes: { heartRate: 'Grass is alive, but it does not have a heart, so the heart rate sensor reads 0.' }\n        }\n      ]\n    },\n\n    amara: {\n      mode: 'plan',\n      person: 'Amara',\n      size: { width: 1100, height: 614 },\n      tempUnit: 'fahrenheit',\n      tempRange: { min: 0, max: 120 },\n      sensors: {\n        temperature: {\n          where: 'A collar on each goat',\n          markers: [[190, 300], [335, 395], [660, 418]],\n          lines: [`Goat collar: ${fmt.fahrenheit.format(102.6)}`, 'Checked at 9:00 a.m.'],\n          note: 'Each collar measures one goat\\'s body temperature many times a day. Every goat wears one; the picture shows three.',\n          viz: { type: 'temperature', value: 102.6 }\n        },\n        heartRate: {\n          where: 'A collar on each goat',\n          markers: [[190, 300], [335, 395], [660, 418]],\n          lines: [`Goat collar: ${format.bpm(84)}`, 'Checked at 9:00 a.m.'],\n          note: 'The collar counts one goat\\'s heartbeats per minute.',\n          viz: { type: 'heartRate', bpm: 84 }\n        },\n        gps: {\n          where: 'A collar on each goat',\n          markers: [[190, 300], [335, 395], [660, 418]],\n          lines: ['Goat collar at 9:00 a.m.', 'Square D3, the grazing area'],\n          note: 'The collar reports which square of the farm map the goat is standing in.',\n          viz: { type: 'gps' }\n        },\n        weight: {\n          where: 'A scale at the shed door',\n          markers: [[372, 268]],\n          lines: [`One goat: ${fmt.pound.format(73)}`],\n          note: 'Each goat steps on the scale as it walks into the shed.',\n          viz: { type: 'weight', value: 73, max: 150 }\n        },\n        sound: {\n          where: 'A microphone inside the shed',\n          markers: [[315, 225]],\n          lines: [format.decibels(55), 'All the goats in the shed at once'],\n          note: 'The microphone records every sound in the shed together: bleats, footsteps, and coughs from all eight goats.',\n          viz: { type: 'sound', db: 55, soundType: 'mixed' }\n        },\n        camera: {\n          where: 'A camera watching the muddy pond',\n          markers: [[1010, 405]],\n          lines: ['Detected: goat', `Confidence: ${fmt.percent.format(0.91)}`, 'Near the water'],\n          note: 'The camera takes pictures, and a computer vision model labels what it sees.',\n          viz: { type: 'camera', box: [545, 385, 150, 175], label: `goat ${fmt.percent.format(0.91)}` }\n        }\n      }\n    },\n\n    joaquin: {\n      mode: 'plan',\n      person: 'Joaquín',\n      size: { width: 1312, height: 816 },\n      tempUnit: 'fahrenheit',\n      tempRange: { min: 0, max: 120 },\n      sensors: {\n        heartRate: {\n          where: 'A heart rate strap on each player',\n          markers: [[875, 355], [990, 340], [1122, 330], [458, 318]],\n          lines: [`Player strap: ${format.bpm(158)}`, 'During a sprint drill'],\n          note: 'The strap counts one player\\'s heartbeats per minute, all practice long. Every player wears one; the picture shows four.',\n          viz: { type: 'heartRate', bpm: 158 }\n        },\n        gps: {\n          where: 'A position tracker on each player',\n          markers: [[875, 355], [990, 340], [1122, 330], [458, 318]],\n          lines: ['Player tracker', `Speed: ${fmt.mph.format(13.9)}`, 'Running down the left side'],\n          note: 'The tracker records where the player is many times a second. Speed is calculated from how fast the position changes.',\n          viz: { type: 'gps' }\n        },\n        weight: {\n          where: 'A scale next to the bench',\n          markers: [[140, 520]],\n          lines: [`One player before practice: ${fmt.pound.format(152)}`],\n          note: 'Players step on the scale before and after practice.',\n          viz: { type: 'weight', value: 152, max: 200 }\n        },\n        camera: {\n          where: 'A camera recording the sideline',\n          markers: [[45, 450]],\n          lines: ['Detected: water cooler', `Confidence: ${fmt.percent.format(0.93)}`, 'Sideline between drills'],\n          note: 'The camera records video, and a computer vision model labels what it sees.',\n          viz: { type: 'camera', box: [300, 405, 115, 165], label: `water cooler ${fmt.percent.format(0.93)}` }\n        },\n        temperature: {\n          where: 'A temperature sensor on the sideline table',\n          markers: [[470, 525]],\n          lines: [`Air: ${fmt.fahrenheit.format(91)}`, 'Sunny afternoon'],\n          note: 'The sensor records the air temperature at the field every few minutes. It gives one reading for the whole field.',\n          viz: { type: 'temperature', value: 91 }\n        },\n        sound: {\n          where: 'A microphone on the sideline',\n          markers: [[700, 480]],\n          lines: [format.decibels(68), 'Shouts, whistles, and kicks'],\n          note: 'The microphone records all the sounds on the field together: players calling out, the coach\\'s whistle, and the ball being kicked.',\n          viz: { type: 'sound', db: 68, soundType: 'mixed' }\n        }\n      }\n    },\n\n    denise: {\n      mode: 'plan',\n      person: 'Denise',\n      size: { width: 1312, height: 816 },\n      tempUnit: 'fahrenheit',\n      tempRange: { min: 0, max: 120 },\n      sensors: {\n        weight: {\n          where: 'A scale on the harvester',\n          markers: [[95, 330]],\n          lines: ['Harvester scale', `Last row pass: ${fmt.pound.format(64)}`],\n          note: 'The harvester weighs the sweet potatoes as it digs them up.',\n          viz: { type: 'weight', value: 64, max: 100 }\n        },\n        gps: {\n          where: 'A position sensor on the harvester and on the drone',\n          markers: [[95, 330], [418, 140]],\n          lines: ['Harvester position', `Latitude ${format.degrees(35.0231)}`, `Longitude ${format.degrees(-78.3275)}`],\n          note: 'The position sensor tags every weight and every photo with where it was taken.',\n          viz: { type: 'gps' }\n        },\n        camera: {\n          where: 'A camera on the drone and a camera on a fence post by the woods',\n          markers: [[418, 140], [1183, 440]],\n          lines: ['Detected: healthy rows', `Confidence: ${fmt.percent.format(0.95)}`, 'Drone photo, daytime'],\n          note: 'The cameras take pictures, and a computer vision model labels what it sees.',\n          viz: { type: 'camera', box: [20, 520, 300, 260], label: `healthy rows ${fmt.percent.format(0.95)}` }\n        },\n        sound: {\n          where: 'A microphone on a fence post by the woods',\n          markers: [[1003, 410]],\n          lines: [format.decibels(41), 'A quiet afternoon by the woods'],\n          note: 'The microphone records how loud it is at the edge of the field, day and night.',\n          viz: { type: 'sound', db: 41 }\n        },\n        temperature: {\n          where: 'A soil temperature sensor in the field',\n          markers: [[450, 620]],\n          lines: [`Soil: ${fmt.fahrenheit.format(73)}`],\n          note: 'The sensor measures how warm the soil is where the sweet potatoes grow.',\n          viz: { type: 'temperature', value: 73 }\n        },\n        heartRate: {\n          where: 'A heart rate sensor clipped to a sweet potato plant',\n          markers: [[250, 700]],\n          lines: [format.bpm(0)],\n          note: 'A heart rate sensor counts heartbeats. It is clipped to a plant, so this is what it records.',\n          viz: { type: 'heartRate', bpm: 0 }\n        }\n      }\n    },\n\n    marcus: {\n      mode: 'plan',\n      person: 'Marcus',\n      size: { width: 1312, height: 816 },\n      tempUnit: 'fahrenheit',\n      tempRange: { min: 0, max: 120 },\n      sensors: {\n        weight: {\n          where: 'A force plate in the floor under the landing mat',\n          markers: [[640, 563]],\n          lines: ['Small practice hop', format.bodyWeight(1.6)],\n          note: 'The force plate measures how hard the floor pushes back, as a multiple of the performer\\'s body weight.',\n          viz: { type: 'weight', value: 1.6, max: 4, unit: 'bodyWeight' }\n        },\n        gps: {\n          where: 'A GPS sensor worn by the performer',\n          markers: [[440, 250]],\n          lines: [`Latitude ${format.degrees(34.05224)}`, `Longitude ${format.degrees(-118.24368)}`, 'Same position for the whole jump'],\n          note: 'GPS finds a location on Earth to within a few feet. The performer moves only a few feet during the jump, so the reading stays the same the whole time.',\n          viz: { type: 'gps' }\n        },\n        temperature: {\n          where: 'A temperature sensor on the studio wall',\n          markers: [[1150, 300]],\n          lines: [`Studio air: ${fmt.fahrenheit.format(68)}`, 'Same for every take'],\n          note: 'The sensor records the air temperature in the studio. The air conditioning keeps it steady.',\n          viz: { type: 'temperature', value: 68 }\n        },\n        sound: {\n          where: 'A boom microphone above the mat',\n          markers: [[662, 282]],\n          lines: [format.decibels(52), 'Crew talking between takes'],\n          note: 'The microphone records how loud each moment of the shot is.',\n          viz: { type: 'sound', db: 52 }\n        },\n        heartRate: {\n          where: 'A heart rate monitor worn by the performer',\n          markers: [[440, 205]],\n          lines: [format.bpm(97), 'Waiting on the platform'],\n          note: 'The monitor counts the performer\\'s heartbeats per minute.',\n          viz: { type: 'heartRate', bpm: 97 }\n        },\n        camera: {\n          where: 'Cameras on tripods around the mat, tracking the markers on the performer\\'s suit',\n          markers: [[757, 352], [930, 360], [1030, 387], [845, 527], [421, 540], [212, 493]],\n          lines: ['Detected: person', `Confidence: ${fmt.percent.format(0.94)}`, `Hips: ${fmt.inch.format(38)} above the platform`, `Knees bent: ${format.degrees(12)}`],\n          note: 'The cameras record video. A computer finds every marker on the suit in each frame and calculates how the body moves.',\n          viz: { type: 'camera', box: [370, 100, 115, 280], label: `person ${fmt.percent.format(0.94)}` }\n        }\n      }\n    },\n\n    layla: {\n      mode: 'plan',\n      person: 'Layla',\n      size: { width: 1312, height: 816 },\n      tempUnit: 'celsius',\n      tempRange: { min: 0, max: 40 },\n      sensors: {\n        temperature: {\n          where: 'Inside the front fridge, inside the back-room fridge, and on the wall by the front fridge',\n          markers: [[235, 420], [890, 420], [345, 240]],\n          lines: [`Front fridge: ${fmt.celsius.format(5)}`, `Back-room fridge: ${fmt.celsius.format(4.1)}`, `Room: ${fmt.celsius.format(23)}`],\n          note: 'Each sensor records the temperature every few minutes, all day and all night.',\n          viz: { type: 'temperature', value: 5 }\n        },\n        camera: {\n          where: 'A camera watching the front fridge door',\n          markers: [[300, 175]],\n          lines: ['Detected: fridge', `Confidence: ${fmt.percent.format(0.93)}`, 'Front of the shop'],\n          note: 'The camera records video, and a computer vision model labels what it sees.',\n          viz: { type: 'camera', box: [100, 270, 230, 420], label: `fridge ${fmt.percent.format(0.93)}` }\n        },\n        sound: {\n          where: 'A microphone by the counter',\n          markers: [[700, 470]],\n          lines: [format.decibels(58), 'Customers talking at the counter'],\n          note: 'The microphone records all the sounds in the shop together: customers, the cash register, and traffic outside.',\n          viz: { type: 'sound', db: 58, soundType: 'mixed' }\n        },\n        weight: {\n          where: 'A scale under the insulin shelf in the front fridge',\n          markers: [[235, 480]],\n          lines: [`Insulin shelf: ${fmt.pound.format(3.2)}`],\n          note: 'The scale records how much the medicine on the shelf weighs. The weight changes when boxes are added or taken out.',\n          viz: { type: 'weight', value: 3.2, max: 10 }\n        },\n        gps: {\n          where: 'A GPS sensor on the front fridge',\n          markers: [[175, 300]],\n          lines: [`Latitude ${format.degrees(31.9539)}`, `Longitude ${format.degrees(35.9106)}`, 'Same position all day'],\n          note: 'GPS finds where the fridge is on Earth. The fridge does not move, so the reading stays the same all day.',\n          viz: { type: 'gps' }\n        },\n        heartRate: {\n          where: 'A heart rate sensor worn by Layla',\n          markers: [[545, 395]],\n          lines: [format.bpm(76), 'Helping a customer'],\n          note: 'The sensor counts Layla\\'s heartbeats per minute while she works.',\n          viz: { type: 'heartRate', bpm: 76 }\n        }\n      }\n    }\n  };\n\n  const scene = SCENES[document.body.dataset.scene] || SCENES.park;\n  const SCENE_SIZE = scene.size;\n  const IS_PLAN = scene.mode === 'plan';\n\n  const state = {\n    sensorId: null,\n    objectId: null,\n    soundEnabled: false,\n    log: [],\n    active: [],\n    previewId: null\n  };\n\n  const els = {};\n  const sceneObjects = {};\n  const objects = {};\n  const palette = {};\n  let vizCtx = null;\n\n  function formatTemperature(value) {\n    return fmt[scene.tempUnit].format(value);\n  }\n\n  /* ---------- Readings ---------- */\n\n  function zeroReading(sensorId) {\n    switch (sensorId) {\n      case 'temperature':\n        return { lines: [formatTemperature(0)], isZero: true, viz: { type: 'temperature', value: 0 } };\n      case 'sound':\n        return { lines: [format.decibels(0)], isZero: true, viz: { type: 'sound', db: 0 } };\n      case 'camera':\n        return { lines: ['Detected: nothing (0)'], isZero: true, viz: { type: 'camera' } };\n      case 'gps':\n        return { lines: ['Latitude 0', 'Longitude 0'], isZero: true, viz: { type: 'gps', pins: [] } };\n      case 'weight':\n        return { lines: [fmt.pound.format(0)], isZero: true, viz: { type: 'weight', value: 0 } };\n      case 'heartRate':\n        return { lines: [format.bpm(0)], isZero: true, viz: { type: 'heartRate', bpm: 0 } };\n      default:\n        return { lines: ['0'], isZero: true, viz: null };\n    }\n  }\n\n  function objectReading(sensorId, obj) {\n    const r = obj.readings;\n    switch (sensorId) {\n      case 'temperature':\n        return r.temperature\n          ? { lines: [formatTemperature(r.temperature)], isZero: false, viz: { type: 'temperature', value: r.temperature } }\n          : zeroReading(sensorId);\n      case 'sound':\n        return r.sound\n          ? { lines: [format.decibels(r.sound)], isZero: false, viz: { type: 'sound', db: r.sound, soundType: obj.soundType } }\n          : zeroReading(sensorId);\n      case 'camera': {\n        const seen = r.camera;\n        if (!seen) {\n          return zeroReading(sensorId);\n        }\n        const lines = [`Detected: ${seen.sees}`, `Confidence: ${fmt.percent.format(seen.confidence)}`];\n        if (seen.note) {\n          lines.push(seen.note);\n        }\n        const box = obj.box;\n        return {\n          lines: lines,\n          isZero: false,\n          viz: { type: 'camera', box: [box.x, box.y, box.width, box.height], label: `${seen.sees} ${fmt.percent.format(seen.confidence)}` }\n        };\n      }\n      case 'gps':\n        if (!r.gps) {\n          return zeroReading(sensorId);\n        }\n        return {\n          lines: [`Latitude ${format.degrees(obj.position.lat)}`, `Longitude ${format.degrees(obj.position.lon)}`],\n          isZero: false,\n          viz: { type: 'gps', pins: [[obj.center.x, obj.center.y]] }\n        };\n      case 'weight':\n        return r.weight\n          ? { lines: [fmt.pound.format(r.weight)], isZero: false, viz: { type: 'weight', value: r.weight, max: scene.weightMax } }\n          : zeroReading(sensorId);\n      case 'heartRate':\n        return r.heartRate\n          ? { lines: [format.bpm(r.heartRate)], isZero: false, viz: { type: 'heartRate', bpm: r.heartRate } }\n          : zeroReading(sensorId);\n      default:\n        return zeroReading(sensorId);\n    }\n  }\n\n  function planReading(sensorId) {\n    const plan = scene.sensors[sensorId];\n    if (!plan) {\n      const reading = zeroReading(sensorId);\n      reading.where = 'Not placed in this scene';\n      reading.note = SENSORS[sensorId].zeroNote;\n      return reading;\n    }\n    const viz = Object.assign({}, plan.viz);\n    if (viz.type === 'gps') {\n      viz.pins = plan.markers;\n    }\n    return { lines: plan.lines, isZero: false, viz: viz, where: plan.where, note: plan.note };\n  }\n\n  function objectNote(sensorId, obj, reading) {\n    const custom = obj.notes[sensorId];\n    if (custom) {\n      return custom;\n    }\n    return reading.isZero ? SENSORS[sensorId].zeroNote : SENSORS[sensorId].note;\n  }\n\n  function captionFor(viz) {\n    switch (viz.type) {\n      case 'temperature': {\n        const range = scene.tempRange;\n        return `The thermometer is filled to ${formatTemperature(viz.value)} on a scale from ${formatTemperature(range.min)} to ${formatTemperature(range.max)}.`;\n      }\n      case 'sound':\n        return viz.db\n          ? 'The sound wave shows how the sound changes over time. Taller waves mean a louder sound.'\n          : 'The sound wave is a flat line because there is no sound.';\n      case 'camera':\n        return viz.box\n          ? 'The camera view shows a box around what the computer vision model detected, with its label.'\n          : 'The camera view is empty.';\n      case 'gps':\n        if (viz.pins.length === 0) {\n          return 'The map has no pin because there is no position.';\n        }\n        return viz.pins.length === 1\n          ? 'The map shows a pin where the position was measured.'\n          : 'The map shows a pin at each place a position sensor would be.';\n      case 'weight': {\n        const toText = viz.unit === 'bodyWeight' ? format.bodyWeight : format.pound;\n        const max = viz.max || scene.weightMax || 100;\n        return `The dial points to ${toText(viz.value)} on a dial from ${toText(0)} to ${toText(max)}.`;\n      }\n      case 'heartRate':\n        return viz.bpm\n          ? `The trace shows a heart beating ${format.bpm(viz.bpm)}. Each spike is one heartbeat.`\n          : 'The trace is a flat line because there is no heartbeat.';\n      default:\n        return '';\n    }\n  }\n\n  /* ---------- Sound ---------- */\n\n  const AudioContextClass = window.AudioContext || window.webkitAudioContext;\n  const audio = { ctx: null, master: null, noise: null, sources: [] };\n\n  function ensureAudio() {\n    if (!AudioContextClass || IS_PLAN) {\n      return null;\n    }\n    try {\n      if (!audio.ctx) {\n        audio.ctx = new AudioContextClass();\n        audio.master = audio.ctx.createGain();\n        audio.master.gain.value = 0.35;\n        audio.master.connect(audio.ctx.destination);\n      }\n      if (audio.ctx.state === 'suspended') {\n        audio.ctx.resume().catch(() => {});\n      }\n      return audio.ctx;\n    } catch (error) {\n      return null;\n    }\n  }\n\n  function isAudioReady() {\n    return Boolean(audio.ctx && audio.ctx.state === 'running');\n  }\n\n  function stopSound() {\n    audio.sources.forEach((source) => {\n      try {\n        source.stop();\n      } catch (error) {\n        // Already stopped.\n      }\n    });\n    audio.sources = [];\n  }\n\n  function getNoiseBuffer(ctx) {\n    if (!audio.noise) {\n      const length = ctx.sampleRate * 2;\n      audio.noise = ctx.createBuffer(1, length, ctx.sampleRate);\n      const data = audio.noise.getChannelData(0);\n      for (let i = 0; i < length; i++) {\n        data[i] = Math.random() * 2 - 1;\n      }\n    }\n    return audio.noise;\n  }\n\n  function envelope(ctx, start, attack, hold, release, peak) {\n    const gain = ctx.createGain();\n    gain.gain.setValueAtTime(0.0001, start);\n    gain.gain.exponentialRampToValueAtTime(peak, start + attack);\n    gain.gain.setValueAtTime(peak, start + attack + hold);\n    gain.gain.exponentialRampToValueAtTime(0.0001, start + attack + hold + release);\n    gain.connect(audio.master);\n    return gain;\n  }\n\n  function track(source, start, stop) {\n    source.start(start);\n    source.stop(stop);\n    audio.sources.push(source);\n  }\n\n  const SOUND_BUILDERS = {\n    water(ctx, t) {\n      const duration = 1.8;\n      const source = ctx.createBufferSource();\n      source.buffer = getNoiseBuffer(ctx);\n      const band = ctx.createBiquadFilter();\n      band.type = 'bandpass';\n      band.frequency.value = 700;\n      band.Q.value = 0.9;\n      const gain = ctx.createGain();\n      gain.gain.setValueAtTime(0.0001, t);\n      for (let step = 0.06; step < duration - 0.2; step += 0.06) {\n        gain.gain.linearRampToValueAtTime(0.25 + Math.random() * 0.45, t + step);\n      }\n      gain.gain.linearRampToValueAtTime(0.0001, t + duration);\n      source.connect(band);\n      band.connect(gain);\n      gain.connect(audio.master);\n      track(source, t, t + duration);\n    },\n    quack(ctx, t) {\n      for (let i = 0; i < 2; i++) {\n        const start = t + i * 0.26;\n        const osc = ctx.createOscillator();\n        osc.type = 'sawtooth';\n        osc.frequency.setValueAtTime(330, start);\n        osc.frequency.linearRampToValueAtTime(240, start + 0.16);\n        const band = ctx.createBiquadFilter();\n        band.type = 'bandpass';\n        band.frequency.value = 1200;\n        band.Q.value = 4;\n        osc.connect(band);\n        band.connect(envelope(ctx, start, 0.02, 0.08, 0.08, 0.9));\n        track(osc, start, start + 0.2);\n      }\n    },\n    bark(ctx, t) {\n      for (let i = 0; i < 2; i++) {\n        const start = t + i * 0.3;\n        const osc = ctx.createOscillator();\n        osc.type = 'sawtooth';\n        osc.frequency.setValueAtTime(230, start);\n        osc.frequency.exponentialRampToValueAtTime(120, start + 0.15);\n        const low = ctx.createBiquadFilter();\n        low.type = 'lowpass';\n        low.frequency.value = 1100;\n        osc.connect(low);\n        low.connect(envelope(ctx, start, 0.01, 0.05, 0.1, 0.9));\n        track(osc, start, start + 0.18);\n\n        const noise = ctx.createBufferSource();\n        noise.buffer = getNoiseBuffer(ctx);\n        const band = ctx.createBiquadFilter();\n        band.type = 'bandpass';\n        band.frequency.value = 1500;\n        noise.connect(band);\n        band.connect(envelope(ctx, start, 0.005, 0.02, 0.06, 0.3));\n        track(noise, start, start + 0.1);\n      }\n    }\n  };\n\n  function playSoundFor(objectId, fromUserGesture) {\n    if (IS_PLAN || state.sensorId !== 'sound' || !state.soundEnabled) {\n      return;\n    }\n    const obj = objects[objectId];\n    const build = obj.soundType ? SOUND_BUILDERS[obj.soundType] : null;\n    stopSound();\n    if (!build) {\n      return;\n    }\n    if (!fromUserGesture && !isAudioReady()) {\n      return;\n    }\n    const ctx = ensureAudio();\n    if (ctx) {\n      build(ctx, ctx.currentTime + 0.02);\n    }\n  }\n\n  /* ---------- Visualizations ---------- */\n\n  function readPalette() {\n    const styles = getComputedStyle(document.documentElement);\n    ['viz-bg', 'viz-grid', 'viz-ink', 'viz-hot', 'viz-map', 'accent'].forEach((name) => {\n      palette[name] = styles.getPropertyValue(`--${name}`).trim();\n    });\n  }\n\n  function prepareCanvas() {\n    const canvas = els.viz;\n    const rect = canvas.getBoundingClientRect();\n    const ratio = window.devicePixelRatio || 1;\n    const width = Math.max(1, Math.round(rect.width * ratio));\n    const height = Math.max(1, Math.round(rect.height * ratio));\n    if (canvas.width !== width || canvas.height !== height) {\n      canvas.width = width;\n      canvas.height = height;\n    }\n    vizCtx.setTransform(ratio, 0, 0, ratio, 0, 0);\n    vizCtx.fillStyle = palette['viz-bg'];\n    vizCtx.fillRect(0, 0, rect.width, rect.height);\n    return { w: rect.width, h: rect.height };\n  }\n\n  function roundedRect(ctx, x, y, w, h, r) {\n    const radius = Math.min(r, w / 2, h / 2);\n    ctx.beginPath();\n    ctx.moveTo(x + radius, y);\n    ctx.arcTo(x + w, y, x + w, y + h, radius);\n    ctx.arcTo(x + w, y + h, x, y + h, radius);\n    ctx.arcTo(x, y + h, x, y, radius);\n    ctx.arcTo(x, y, x + w, y, radius);\n    ctx.closePath();\n  }\n\n  function clamp(value, min, max) {\n    return Math.min(max, Math.max(min, value));\n  }\n\n  function isImageReady() {\n    return Boolean(els.image && els.image.complete && els.image.naturalWidth > 0);\n  }\n\n  function drawTemperature(ctx, w, h, degrees) {\n    const range = scene.tempRange;\n    const tubeH = Math.max(12, h * 0.18);\n    const bulbR = tubeH * 1.1;\n    const cy = h * 0.6;\n    const x0 = w * 0.06 + bulbR;\n    const x1 = w * 0.94;\n    const span = range.max - range.min;\n    const step = span / 6;\n    ctx.strokeStyle = palette['viz-ink'];\n    ctx.lineWidth = 2;\n    for (let t = range.min; t <= range.max; t += step) {\n      const x = x0 + (x1 - x0) * ((t - range.min) / span);\n      ctx.beginPath();\n      ctx.moveTo(x, cy - tubeH / 2 - 6);\n      ctx.lineTo(x, cy - tubeH / 2 - 16);\n      ctx.stroke();\n    }\n    roundedRect(ctx, x0, cy - tubeH / 2, x1 - x0, tubeH, tubeH / 2);\n    ctx.fillStyle = '#ffffff';\n    ctx.fill();\n    ctx.stroke();\n    const fraction = clamp((degrees - range.min) / span, 0, 1);\n    roundedRect(ctx, x0, cy - tubeH / 2 + 3, Math.max(tubeH, (x1 - x0) * fraction), tubeH - 6, (tubeH - 6) / 2);\n    ctx.fillStyle = palette['viz-hot'];\n    ctx.fill();\n    ctx.beginPath();\n    ctx.arc(x0, cy, bulbR, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.stroke();\n    ctx.fillStyle = palette['viz-ink'];\n    ctx.font = '11px sans-serif';\n    ctx.fillText(fmt.integer.format(range.min), x0 - 4, cy + tubeH / 2 + 18);\n    ctx.fillText(fmt.integer.format(range.max), x1 - 16, cy + tubeH / 2 + 18);\n  }\n\n  function soundSamples(soundType, count) {\n    let seed = 7;\n    const random = () => {\n      seed = (seed * 16807) % 2147483647;\n      return (seed / 2147483647) * 2 - 1;\n    };\n    const samples = [];\n    for (let i = 0; i < count; i++) {\n      const t = i / count;\n      const phase = (t * 6) % 1;\n      const on = Math.floor(t * 6) % 2 === 0;\n      let value = 0;\n      if (soundType === 'water' || soundType === 'mixed') {\n        value = random() * (0.45 + 0.35 * Math.sin(t * 23));\n      } else {\n        value = on ? Math.sin(Math.PI * phase) * ((((i * 0.3) % 1) * 2 - 1) * 0.8 + random() * 0.2) : 0;\n      }\n      samples.push(value);\n    }\n    return samples;\n  }\n\n  function drawSound(ctx, w, h, decibels, soundType) {\n    const mid = h / 2;\n    ctx.strokeStyle = palette['viz-grid'];\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(0, mid);\n    ctx.lineTo(w, mid);\n    ctx.stroke();\n    const count = Math.max(60, Math.round(w / 2));\n    const samples = soundSamples(soundType || 'generic', count);\n    const amplitude = (decibels / LOUDEST_DB) * h * 0.42;\n    ctx.strokeStyle = palette.accent;\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    samples.forEach((sample, i) => {\n      const x = (i / (count - 1)) * w;\n      const y = mid - sample * amplitude;\n      if (i === 0) {\n        ctx.moveTo(x, y);\n      } else {\n        ctx.lineTo(x, y);\n      }\n    });\n    ctx.stroke();\n  }\n\n  function drawVision(ctx, w, h, box, label) {\n    const [x, y, width, height] = box;\n    const cropW = Math.min(SCENE_SIZE.width, Math.max(width * 1.8, height * 1.8 * (w / h)));\n    const cropH = cropW * (h / w);\n    const sx = clamp(x + width / 2 - cropW / 2, 0, SCENE_SIZE.width - cropW);\n    const sy = clamp(y + height / 2 - cropH / 2, 0, Math.max(0, SCENE_SIZE.height - cropH));\n    const scale = w / cropW;\n\n    if (isImageReady()) {\n      const pixels = els.image.naturalWidth / SCENE_SIZE.width;\n      ctx.imageSmoothingEnabled = true;\n      ctx.drawImage(els.image, sx * pixels, sy * pixels, cropW * pixels, cropH * pixels, 0, 0, w, h);\n    }\n\n    const bx = (x - sx) * scale;\n    const by = (y - sy) * scale;\n    const bw = width * scale;\n    const bh = height * scale;\n    ctx.strokeStyle = '#ffffff';\n    ctx.lineWidth = 4;\n    ctx.strokeRect(bx, by, bw, bh);\n    ctx.strokeStyle = palette['viz-hot'];\n    ctx.lineWidth = 2;\n    ctx.strokeRect(bx, by, bw, bh);\n\n    ctx.font = '600 13px sans-serif';\n    const textW = ctx.measureText(label).width + 12;\n    const labelY = by > 22 ? by - 22 : by + bh;\n    ctx.fillStyle = palette['viz-hot'];\n    ctx.fillRect(bx, labelY, textW, 22);\n    ctx.fillStyle = '#ffffff';\n    ctx.fillText(label, bx + 6, labelY + 16);\n  }\n\n  function drawPin(ctx, x, y, size) {\n    ctx.fillStyle = palette['viz-hot'];\n    ctx.strokeStyle = '#ffffff';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.moveTo(x, y);\n    ctx.bezierCurveTo(x - size * 0.9, y - size, x - size * 0.6, y - size * 1.9, x, y - size * 1.9);\n    ctx.bezierCurveTo(x + size * 0.6, y - size * 1.9, x + size * 0.9, y - size, x, y);\n    ctx.fill();\n    ctx.stroke();\n  }\n\n  function drawGps(ctx, w, h, pins) {\n    const scale = Math.min(w / SCENE_SIZE.width, h / SCENE_SIZE.height);\n    const mapW = SCENE_SIZE.width * scale;\n    const mapH = SCENE_SIZE.height * scale;\n    const offsetX = (w - mapW) / 2;\n    const offsetY = (h - mapH) / 2;\n\n    ctx.fillStyle = palette['viz-map'];\n    ctx.fillRect(offsetX, offsetY, mapW, mapH);\n    if (isImageReady()) {\n      ctx.globalAlpha = 0.4;\n      ctx.drawImage(els.image, offsetX, offsetY, mapW, mapH);\n      ctx.globalAlpha = 1;\n    }\n    ctx.strokeStyle = palette['viz-grid'];\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    for (let i = 0; i <= 8; i++) {\n      ctx.moveTo(offsetX + (mapW * i) / 8, offsetY);\n      ctx.lineTo(offsetX + (mapW * i) / 8, offsetY + mapH);\n    }\n    for (let i = 0; i <= 5; i++) {\n      ctx.moveTo(offsetX, offsetY + (mapH * i) / 5);\n      ctx.lineTo(offsetX + mapW, offsetY + (mapH * i) / 5);\n    }\n    ctx.stroke();\n\n    pins.forEach((pin) => {\n      drawPin(ctx, offsetX + pin[0] * scale, offsetY + pin[1] * scale, 8);\n    });\n  }\n\n  function drawWeight(ctx, w, h, value, max, unit) {\n    const cx = w / 2;\n    const cy = h * 0.9;\n    const radius = Math.min(w * 0.42, h * 0.78);\n    ctx.fillStyle = '#ffffff';\n    ctx.strokeStyle = palette['viz-ink'];\n    ctx.lineWidth = 3;\n    ctx.beginPath();\n    ctx.arc(cx, cy, radius, Math.PI, Math.PI * 2);\n    ctx.closePath();\n    ctx.fill();\n    ctx.stroke();\n    ctx.lineWidth = 2;\n    for (let i = 0; i <= 10; i++) {\n      const tick = Math.PI + (i / 10) * Math.PI;\n      const inner = radius * (i % 5 === 0 ? 0.8 : 0.88);\n      ctx.beginPath();\n      ctx.moveTo(cx + Math.cos(tick) * inner, cy + Math.sin(tick) * inner);\n      ctx.lineTo(cx + Math.cos(tick) * radius * 0.96, cy + Math.sin(tick) * radius * 0.96);\n      ctx.stroke();\n    }\n    const angle = Math.PI + (clamp(value, 0, max) / max) * Math.PI;\n    ctx.strokeStyle = palette['viz-hot'];\n    ctx.lineWidth = 4;\n    ctx.lineCap = 'round';\n    ctx.beginPath();\n    ctx.moveTo(cx, cy);\n    ctx.lineTo(cx + Math.cos(angle) * radius * 0.75, cy + Math.sin(angle) * radius * 0.75);\n    ctx.stroke();\n    ctx.lineCap = 'butt';\n    ctx.fillStyle = palette['viz-ink'];\n    ctx.beginPath();\n    ctx.arc(cx, cy, 6, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.font = '11px sans-serif';\n    const maxText = unit === 'bodyWeight' ? fmt.decimal.format(max) : fmt.integer.format(max);\n    ctx.fillText('0', cx - radius, cy + 14);\n    ctx.fillText(maxText, cx + radius - 18, cy + 14);\n  }\n\n  function drawHeartRate(ctx, w, h, bpm) {\n    const mid = h * 0.6;\n    const windowSeconds = 4;\n    ctx.strokeStyle = palette['viz-grid'];\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    for (let s = 0; s <= windowSeconds; s++) {\n      const x = (s / windowSeconds) * w;\n      ctx.moveTo(x, 0);\n      ctx.lineTo(x, h);\n    }\n    ctx.stroke();\n\n    ctx.strokeStyle = palette['viz-hot'];\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.moveTo(0, mid);\n    if (bpm > 0) {\n      const spacing = w / ((bpm / 60) * windowSeconds);\n      const spike = Math.min(spacing * 0.35, 18);\n      for (let x = spacing / 2; x < w; x += spacing) {\n        ctx.lineTo(x - spike, mid);\n        ctx.lineTo(x - spike * 0.5, mid + h * 0.08);\n        ctx.lineTo(x, mid - h * 0.45);\n        ctx.lineTo(x + spike * 0.5, mid + h * 0.18);\n        ctx.lineTo(x + spike, mid);\n      }\n    }\n    ctx.lineTo(w, mid);\n    ctx.stroke();\n  }\n\n  let currentViz = null;\n\n  function drawVisualization() {\n    if (!vizCtx) {\n      return;\n    }\n    const size = prepareCanvas();\n    const viz = currentViz;\n    if (!viz) {\n      return;\n    }\n    switch (viz.type) {\n      case 'temperature':\n        drawTemperature(vizCtx, size.w, size.h, viz.value);\n        break;\n      case 'sound':\n        drawSound(vizCtx, size.w, size.h, viz.db, viz.soundType);\n        break;\n      case 'camera':\n        if (viz.box) {\n          drawVision(vizCtx, size.w, size.h, viz.box, viz.label);\n        }\n        break;\n      case 'gps':\n        drawGps(vizCtx, size.w, size.h, viz.pins);\n        break;\n      case 'weight':\n        drawWeight(vizCtx, size.w, size.h, viz.value, viz.max || scene.weightMax || 100, viz.unit);\n        break;\n      case 'heartRate':\n        drawHeartRate(vizCtx, size.w, size.h, viz.bpm);\n        break;\n      default:\n        break;\n    }\n  }\n\n  /* ---------- Readout ---------- */\n\n  function setValueLines(lines) {\n    while (els.value.firstChild) {\n      els.value.removeChild(els.value.firstChild);\n    }\n    lines.forEach((line) => {\n      const span = document.createElement('span');\n      span.className = 'lcd-line';\n      span.textContent = line;\n      els.value.appendChild(span);\n    });\n  }\n\n  function showReadout(sensorId, target, reading, note) {\n    els.sensor.textContent = sensorId ? `${SENSORS[sensorId].label} sensor` : 'No sensor selected';\n    els.target.textContent = target;\n    if (!reading) {\n      setValueLines(['No reading']);\n      els.caption.textContent = '';\n      els.note.textContent = note;\n      currentViz = null;\n    } else {\n      setValueLines(reading.lines);\n      els.caption.textContent = captionFor(reading.viz);\n      els.note.textContent = note;\n      currentViz = reading.viz;\n    }\n    drawVisualization();\n  }\n\n  function addRow(body, cells, className) {\n    const row = document.createElement('tr');\n    if (className) {\n      row.className = className;\n    }\n    cells.forEach((content) => {\n      const cell = document.createElement('td');\n      if (typeof content === 'string') {\n        cell.textContent = content;\n      } else {\n        cell.appendChild(content);\n      }\n      row.appendChild(cell);\n    });\n    body.appendChild(row);\n  }\n\n  function clearChildren(el) {\n    while (el.firstChild) {\n      el.removeChild(el.firstChild);\n    }\n  }\n\n  /* ---------- Explore mode ---------- */\n\n  function renderExplore() {\n    const obj = state.objectId ? objects[state.objectId] : null;\n    els.replay.hidden = !(AudioContextClass && state.soundEnabled && state.sensorId === 'sound' && obj && obj.soundType);\n    els.audioMessage.hidden = Boolean(AudioContextClass) || state.sensorId !== 'sound';\n\n    const target = obj ? `Pointing at: ${obj.name}` : 'Not pointing at anything yet';\n    if (!state.sensorId || !obj) {\n      const note = state.sensorId\n        ? 'Hover over or tap something in the picture to take a reading.'\n        : 'Choose a sensor above to start taking readings.';\n      showReadout(state.sensorId, target, null, note);\n      return null;\n    }\n    const reading = objectReading(state.sensorId, obj);\n    showReadout(state.sensorId, target, reading, objectNote(state.sensorId, obj, reading));\n    return reading;\n  }\n\n  function announceExplore(reading) {\n    if (!reading || !state.sensorId || !state.objectId) {\n      return;\n    }\n    els.status.textContent = `${SENSORS[state.sensorId].label} sensor reading for ${objects[state.objectId].name}: ${reading.lines.join(', ')}.`;\n  }\n\n  function renderLog() {\n    clearChildren(els.logBody);\n    if (state.log.length === 0) {\n      addRow(els.logBody, ['No readings yet. Click an object in the picture to record one.', '', ''], 'log-empty');\n      els.clearLog.hidden = true;\n      return;\n    }\n    state.log.forEach((entry) => addRow(els.logBody, [entry.object, entry.sensor, entry.reading]));\n    els.clearLog.hidden = false;\n  }\n\n  function recordReading(reading) {\n    if (!reading || !state.sensorId || !state.objectId) {\n      return;\n    }\n    state.log.unshift({\n      object: objects[state.objectId].name,\n      sensor: SENSORS[state.sensorId].label,\n      reading: reading.lines.join(', ')\n    });\n    if (state.log.length > LOG_LIMIT) {\n      state.log.length = LOG_LIMIT;\n    }\n    renderLog();\n  }\n\n  function setActiveObject(objectId) {\n    Object.keys(sceneObjects).forEach((id) => {\n      sceneObjects[id].ring.classList.toggle('is-visible', id === objectId);\n    });\n  }\n\n  function selectObject(objectId, options) {\n    state.objectId = objectId;\n    setActiveObject(objectId);\n    const reading = renderExplore();\n    announceExplore(reading);\n    if (options.record) {\n      recordReading(reading);\n    }\n    playSoundFor(objectId, Boolean(options.fromUserGesture));\n  }\n\n  function keyboardOrder() {\n    return scene.hotspots.map((spot) => spot.id);\n  }\n\n  function focusObject(objectId) {\n    keyboardOrder().forEach((id) => {\n      sceneObjects[id].el.setAttribute('tabindex', id === objectId ? '0' : '-1');\n    });\n    sceneObjects[objectId].el.focus();\n  }\n\n  function handleSceneKeydown(event) {\n    const objectEl = event.target.closest('.scene-object');\n    if (!objectEl) {\n      return;\n    }\n    const order = keyboardOrder();\n    const index = order.indexOf(objectEl.dataset.object);\n    let nextIndex = null;\n    switch (event.key) {\n      case 'ArrowRight':\n      case 'ArrowDown':\n        nextIndex = (index + 1) % order.length;\n        break;\n      case 'ArrowLeft':\n      case 'ArrowUp':\n        nextIndex = (index - 1 + order.length) % order.length;\n        break;\n      case 'Home':\n        nextIndex = 0;\n        break;\n      case 'End':\n        nextIndex = order.length - 1;\n        break;\n      case 'Enter':\n      case ' ':\n        event.preventDefault();\n        ensureAudio();\n        selectObject(objectEl.dataset.object, { record: true, fromUserGesture: true });\n        return;\n      default:\n        return;\n    }\n    event.preventDefault();\n    focusObject(order[nextIndex]);\n  }\n\n  function circlePoints(circle) {\n    const points = [];\n    for (let i = 0; i < 16; i++) {\n      const angle = (i / 16) * Math.PI * 2;\n      points.push([Math.round(circle.x + Math.cos(angle) * circle.r), Math.round(circle.y + Math.sin(angle) * circle.r)]);\n    }\n    return points;\n  }\n\n  function pointsAttribute(points) {\n    return points.map((point) => point.join(',')).join(' ');\n  }\n\n  function boundsOf(points) {\n    const xs = points.map((point) => point[0]);\n    const ys = points.map((point) => point[1]);\n    const x = Math.min.apply(null, xs);\n    const y = Math.min.apply(null, ys);\n    return { x: x, y: y, width: Math.max.apply(null, xs) - x, height: Math.max.apply(null, ys) - y };\n  }\n\n  function createPolygon(points, className) {\n    const polygon = document.createElementNS(SVG_NS, 'polygon');\n    polygon.setAttribute('points', pointsAttribute(points));\n    polygon.setAttribute('class', className);\n    return polygon;\n  }\n\n  function createRing(points) {\n    const ring = document.createElementNS(SVG_NS, 'g');\n    ring.setAttribute('class', 'focus-ring');\n    ring.appendChild(createPolygon(points, 'ring-outer'));\n    ring.appendChild(createPolygon(points, 'ring-inner'));\n    return ring;\n  }\n\n  function sceneCoordinates(event) {\n    const rect = els.scene.getBoundingClientRect();\n    return [\n      Math.round(((event.clientX - rect.left) / rect.width) * SCENE_SIZE.width),\n      Math.round(((event.clientY - rect.top) / rect.height) * SCENE_SIZE.height)\n    ];\n  }\n\n  function buildObject(spot, points) {\n    const box = boundsOf(points);\n    const center = { x: box.x + box.width / 2, y: box.y + box.height / 2 };\n    const origin = scene.mapOrigin;\n    return {\n      name: spot.name,\n      soundType: spot.soundType,\n      readings: spot.readings || {},\n      notes: spot.notes || {},\n      box: box,\n      center: center,\n      position: {\n        lat: Number((origin.lat - (center.y - SCENE_SIZE.height / 2) * DEGREES_PER_SCENE_UNIT).toFixed(5)),\n        lon: Number((origin.lon + (center.x - SCENE_SIZE.width / 2) * DEGREES_PER_SCENE_UNIT).toFixed(5))\n      }\n    };\n  }\n\n  function createHotspot(spot) {\n    const id = spot.id;\n    const points = spot.points || circlePoints(spot.circle);\n    const obj = buildObject(spot, points);\n    objects[id] = obj;\n\n    const el = createPolygon(points, 'scene-object');\n    el.dataset.object = id;\n    el.setAttribute('role', 'button');\n    el.setAttribute('aria-label', obj.name);\n    el.setAttribute('tabindex', '-1');\n\n    el.addEventListener('mouseenter', () => {\n      if (state.objectId !== id) {\n        selectObject(id, {});\n      }\n    });\n    el.addEventListener('focus', () => {\n      keyboardOrder().forEach((otherId) => {\n        sceneObjects[otherId].el.setAttribute('tabindex', otherId === id ? '0' : '-1');\n      });\n      if (state.objectId !== id) {\n        selectObject(id, {});\n      } else {\n        setActiveObject(id);\n      }\n    });\n    el.addEventListener('click', (event) => {\n      if (SHOW_HOTSPOTS) {\n        console.log(`${id}: [${sceneCoordinates(event).join(', ')}]`);\n      }\n      ensureAudio();\n      selectObject(id, { record: true, fromUserGesture: true });\n    });\n\n    sceneObjects[id] = { el: el, ring: createRing(points) };\n    return el;\n  }\n\n  function setUpHotspots() {\n    els.scene.classList.toggle('show-hotspots', SHOW_HOTSPOTS);\n    const paintOrder = scene.hotspots.map((spot, index) => ({ spot: spot, index: index }));\n    paintOrder.sort((a, b) => (a.spot.layer || 0) - (b.spot.layer || 0) || a.index - b.index);\n    paintOrder.forEach((entry) => {\n      els.scene.appendChild(createHotspot(entry.spot));\n    });\n\n    const ringLayer = document.createElementNS(SVG_NS, 'g');\n    ringLayer.setAttribute('aria-hidden', 'true');\n    scene.hotspots.forEach((spot) => ringLayer.appendChild(sceneObjects[spot.id].ring));\n    els.scene.appendChild(ringLayer);\n\n    sceneObjects[scene.hotspots[0].id].el.setAttribute('tabindex', '0');\n    els.scene.addEventListener('keydown', handleSceneKeydown);\n  }\n\n  function selectExploreSensor(sensorId) {\n    state.sensorId = state.sensorId === sensorId ? null : sensorId;\n    stopSound();\n    if (state.sensorId === 'sound' && state.soundEnabled) {\n      ensureAudio();\n    }\n    syncSensorButtons();\n    announceExplore(renderExplore());\n    if (state.objectId) {\n      playSoundFor(state.objectId, true);\n    }\n  }\n\n  function setUpExploreControls() {\n    state.soundEnabled = els.soundToggle.checked;\n    els.soundToggle.addEventListener('change', () => {\n      state.soundEnabled = els.soundToggle.checked;\n      if (state.soundEnabled) {\n        ensureAudio();\n      } else {\n        stopSound();\n      }\n      renderExplore();\n    });\n\n    els.replay.addEventListener('click', () => {\n      if (state.objectId) {\n        playSoundFor(state.objectId, true);\n      }\n    });\n\n    els.clearLog.addEventListener('click', () => {\n      state.log = [];\n      renderLog();\n      els.status.textContent = 'Recorded readings cleared.';\n    });\n  }\n\n  /* ---------- Plan mode ---------- */\n\n  function markerRadius() {\n    return SCENE_SIZE.width * 0.022;\n  }\n\n  function createMarker(sensorId, x, y) {\n    const r = markerRadius();\n    const group = document.createElementNS(SVG_NS, 'g');\n    group.setAttribute('class', 'sensor-marker');\n    const circle = document.createElementNS(SVG_NS, 'circle');\n    circle.setAttribute('cx', String(x));\n    circle.setAttribute('cy', String(y));\n    circle.setAttribute('r', String(r));\n    circle.setAttribute('class', 'marker-disc');\n    const icon = document.createElementNS(SVG_NS, 'image');\n    icon.setAttribute('href', SENSORS[sensorId].icon);\n    icon.setAttribute('x', String(x - r * 0.7));\n    icon.setAttribute('y', String(y - r * 0.7));\n    icon.setAttribute('width', String(r * 1.4));\n    icon.setAttribute('height', String(r * 1.4));\n    group.appendChild(circle);\n    group.appendChild(icon);\n    return group;\n  }\n\n  // Sensors that share a spot (like several sensors on one collar) are nudged\n  // sideways so every marker stays visible.\n  function placeMarker(placed, point) {\n    const r = markerRadius();\n    let x = point[0];\n    const y = point[1];\n    const overlaps = () => placed.some((p) => Math.abs(p[0] - x) < r * 1.6 && Math.abs(p[1] - y) < r * 1.6);\n    while (overlaps()) {\n      x += r * 1.7;\n    }\n    placed.push([x, y]);\n    return [x, y];\n  }\n\n  function renderMarkers() {\n    clearChildren(els.scene);\n    const placed = [];\n    const drawOrder = SENSOR_ORDER.filter((id) => state.active.indexOf(id) !== -1 && id !== state.previewId);\n    if (state.previewId) {\n      drawOrder.push(state.previewId);\n    }\n    const positions = {};\n    SENSOR_ORDER.forEach((sensorId) => {\n      const plan = scene.sensors[sensorId];\n      if (state.active.indexOf(sensorId) === -1 || !plan || !plan.markers) {\n        return;\n      }\n      positions[sensorId] = plan.markers.map((point) => placeMarker(placed, point));\n    });\n    drawOrder.forEach((sensorId) => {\n      if (!positions[sensorId]) {\n        return;\n      }\n      const layer = document.createElementNS(SVG_NS, 'g');\n      layer.setAttribute('class', sensorId === state.previewId ? 'marker-layer is-current' : 'marker-layer');\n      positions[sensorId].forEach((point) => layer.appendChild(createMarker(sensorId, point[0], point[1])));\n      els.scene.appendChild(layer);\n    });\n  }\n\n  function renderPlanTable() {\n    clearChildren(els.planBody);\n    els.previewButtons = {};\n    const activeInOrder = SENSOR_ORDER.filter((id) => state.active.indexOf(id) !== -1);\n    if (activeInOrder.length === 0) {\n      addRow(els.planBody, ['No sensors turned on yet.', '', '', ''], 'log-empty');\n      return;\n    }\n    activeInOrder.forEach((sensorId) => {\n      const reading = planReading(sensorId);\n      const button = document.createElement('button');\n      button.type = 'button';\n      button.className = 'button button-small';\n      button.textContent = 'Preview';\n      button.setAttribute('aria-label', `Preview ${SENSORS[sensorId].label} sensor`);\n      button.setAttribute('aria-pressed', sensorId === state.previewId ? 'true' : 'false');\n      button.addEventListener('click', () => {\n        state.previewId = sensorId;\n        renderPlan();\n        els.previewButtons[sensorId].focus();\n        announcePlan(sensorId, true);\n      });\n      els.previewButtons[sensorId] = button;\n      addRow(els.planBody, [SENSORS[sensorId].label, reading.where, reading.lines.join(', '), button]);\n    });\n  }\n\n  function renderPlan() {\n    syncSensorButtons();\n    renderMarkers();\n    renderPlanTable();\n    if (!state.previewId) {\n      const note = state.active.length\n        ? 'Choose Preview in your sensor plan to see a sensor\\'s data again.'\n        : 'Turn on a sensor above to see where it would go and what data it would collect.';\n      showReadout(null, 'No sensor to preview', null, note);\n      return;\n    }\n    const reading = planReading(state.previewId);\n    showReadout(state.previewId, `Where: ${reading.where}`, reading, reading.note);\n  }\n\n  function announcePlan(sensorId, isOn) {\n    const label = SENSORS[sensorId].label;\n    if (!isOn) {\n      els.status.textContent = `${label} sensor turned off.`;\n      return;\n    }\n    const reading = planReading(sensorId);\n    els.status.textContent = `${label} sensor on. Where: ${reading.where}. Sample reading: ${reading.lines.join(', ')}.`;\n  }\n\n  function togglePlanSensor(sensorId) {\n    const index = state.active.indexOf(sensorId);\n    const isOn = index === -1;\n    if (isOn) {\n      state.active.push(sensorId);\n      state.previewId = sensorId;\n    } else {\n      state.active.splice(index, 1);\n      if (state.previewId === sensorId) {\n        state.previewId = state.active.length ? state.active[state.active.length - 1] : null;\n      }\n    }\n    renderPlan();\n    announcePlan(sensorId, isOn);\n  }\n\n  /* ---------- Shared setup ---------- */\n\n  function syncSensorButtons() {\n    els.sensorButtons.forEach((button) => {\n      const id = button.dataset.sensor;\n      const pressed = IS_PLAN ? state.active.indexOf(id) !== -1 : state.sensorId === id;\n      button.setAttribute('aria-pressed', pressed ? 'true' : 'false');\n    });\n  }\n\n  function watchImage() {\n    const showError = () => {\n      els.imageMessage.hidden = false;\n    };\n    if (els.image.complete && els.image.naturalWidth === 0) {\n      showError();\n    }\n    els.image.addEventListener('error', showError);\n    els.image.addEventListener('load', () => {\n      els.imageMessage.hidden = true;\n      drawVisualization();\n    });\n  }\n\n  function setUpCanvas() {\n    try {\n      vizCtx = els.viz.getContext('2d');\n    } catch (error) {\n      vizCtx = null;\n    }\n    if (!vizCtx) {\n      els.viz.hidden = true;\n      return;\n    }\n    if (window.ResizeObserver) {\n      new ResizeObserver(() => drawVisualization()).observe(els.viz);\n    } else {\n      window.addEventListener('resize', drawVisualization);\n    }\n  }\n\n  function init() {\n    ['scene', 'viz', 'status'].forEach((id) => {\n      els[id] = document.getElementById(id);\n    });\n    els.image = document.getElementById('scene-image');\n    els.imageMessage = document.getElementById('image-message');\n    els.sensor = document.getElementById('readout-sensor');\n    els.target = document.getElementById('readout-target');\n    els.value = document.getElementById('readout-value');\n    els.caption = document.getElementById('viz-caption');\n    els.note = document.getElementById('readout-note');\n    els.sensorButtons = Array.from(document.querySelectorAll('.sensor-btn'));\n\n    readPalette();\n    setUpCanvas();\n    watchImage();\n\n    if (IS_PLAN) {\n      els.planBody = document.getElementById('plan-body');\n      els.sensorButtons.forEach((button) => {\n        button.addEventListener('click', () => togglePlanSensor(button.dataset.sensor));\n      });\n      renderPlan();\n      return;\n    }\n\n    els.replay = document.getElementById('replay-sound');\n    els.audioMessage = document.getElementById('audio-message');\n    els.logBody = document.getElementById('log-body');\n    els.clearLog = document.getElementById('clear-log');\n    els.soundToggle = document.getElementById('sound-toggle');\n    els.sensorButtons.forEach((button) => {\n      button.addEventListener('click', () => selectExploreSensor(button.dataset.sensor));\n    });\n    setUpHotspots();\n    setUpExploreControls();\n    syncSensorButtons();\n    renderLog();\n    renderExplore();\n  }\n\n  try {\n    init();\n  } catch (error) {\n    const message = document.getElementById('app-error');\n    if (message) {\n      message.hidden = false;\n    }\n  }\n})();\n",
