          "active": false
        },
        "16": {
          "id": "16",
          "name": "style.css",
          "contents": ":root {\n  --ink: #15302a;\n  --ink-muted: #3d5750;\n  --page: #eef3ee;\n  --panel: #ffffff;\n  --line: #6f877d;\n  --line-soft: #c7d6ce;\n  --accent: #1f5f8b;\n  --accent-dark: #0e3754;\n  --accent-soft: #e3edf5;\n  --focus: #0b3d91;\n  --lcd: #d8e6c3;\n  --lcd-ink: #1e2a10;\n  --lcd-edge: #5d6e48;\n  --viz-bg: #f6f9f7;\n  --viz-grid: #d3e0d8;\n  --viz-ink: #2b4a42;\n  --viz-hot: #c0392b;\n  --viz-map: #efe6d2;\n  --map-water: #9cc9dd;\n  --map-building: #cfae7e;\n  --map-tree: #a9c79a;\n  --hotspot-debug: #ff00aa;\n  --error-bg: #fbe9e7;\n  --error-ink: #8a1c10;\n  --font: \"Trebuchet MS\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  background: var(--page);\n  color: var(--ink);\n  font-family: var(--font);\n  font-size: 15px;\n  line-height: 1.4;\n}\n\n.app {\n  max-width: 1280px;\n  margin: 0 auto;\n  padding: 12px 16px 20px;\n}\n\n.app-header {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  gap: 4px 16px;\n  margin-bottom: 8px;\n}\n\nh1 {\n  margin: 0;\n  font-size: 1.35rem;\n  line-height: 1.2;\n}\n\nh2 {\n  margin: 0 0 6px;\n  font-size: 1rem;\n  line-height: 1.3;\n}\n\n.intro,\n.help {\n  margin: 0;\n  color: var(--ink-muted);\n}\n\n.help {\n  font-size: 0.9rem;\n  margin-bottom: 8px;\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n/* Sensor bar */\n\n.sensor-bar {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 6px;\n  margin-bottom: 10px;\n}\n\n.sensor-bar-label {\n  font-weight: 700;\n  margin-inline-end: 2px;\n}\n\n.sensor-btn {\n  display: inline-flex;\n  align-items: center;\n  gap: 4px;\n  min-height: 32px;\n  padding: 2px 8px 2px 4px;\n  background: var(--panel);\n  color: var(--ink);\n  border: 2px solid var(--line);\n  border-radius: 6px;\n  font: inherit;\n  font-size: 0.85rem;\n  font-weight: 600;\n  line-height: 1.2;\n  white-space: nowrap;\n  cursor: pointer;\n}\n\n.sensor-btn img {\n  display: block;\n  width: 20px;\n  height: 20px;\n}\n\n.sensor-btn:hover {\n  border-color: var(--ink);\n}\n\n.sensor-btn[aria-pressed=\"true\"] {\n  background: var(--accent);\n  border-color: var(--accent-dark);\n  color: #ffffff;\n}\n\n.sensor-btn:focus-visible,\n.button:focus-visible,\n.checkbox-label input:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 2px;\n}\n\n.checkbox-label {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  margin-inline-start: auto;\n  min-height: 32px;\n  font-size: 0.85rem;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.checkbox-label input {\n  width: 20px;\n  height: 20px;\n  margin: 0;\n  accent-color: var(--accent);\n}\n\n/* Layout */\n\n.workspace {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  gap: 12px;\n}\n\n@media (min-width: 960px) {\n  .workspace {\n    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);\n    align-items: start;\n  }\n}\n\n.panel {\n  padding: 12px;\n  background: var(--panel);\n  border: 1px solid var(--line-soft);\n  border-radius: 12px;\n}\n\n.side {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n/* Scene */\n\n.scene {\n  position: relative;\n  border: 2px solid var(--line-soft);\n  border-radius: 8px;\n  overflow: hidden;\n  background: var(--viz-map);\n}\n\n.scene-image {\n  display: block;\n  width: 100%;\n  height: auto;\n}\n\n.scene-hotspots {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  touch-action: manipulation;\n}\n\n.scene-markers {\n  pointer-events: none;\n}\n\n.scene-object {\n  fill: transparent;\n  stroke: none;\n  pointer-events: all;\n  cursor: pointer;\n}\n\n.scene-object:focus {\n  outline: none;\n}\n\n.show-hotspots .scene-object {\n  fill: rgba(255, 0, 170, 0.12);\n  stroke: var(--hotspot-debug);\n  stroke-width: 2;\n}\n\n.focus-ring {\n  display: none;\n  pointer-events: none;\n  fill: none;\n  stroke-linejoin: round;\n}\n\n.focus-ring.is-visible {\n  display: inline;\n}\n\n.ring-outer {\n  stroke: #ffffff;\n  stroke-width: 9;\n}\n\n.ring-inner {\n  stroke: var(--focus);\n  stroke-width: 4;\n  stroke-dasharray: 12 6;\n}\n\n.marker-disc {\n  fill: #ffffff;\n  stroke: var(--accent);\n  stroke-width: 4;\n}\n\n.marker-layer.is-current .marker-disc {\n  stroke: var(--viz-hot);\n  stroke-width: 7;\n}\n\n/* Problem */\n\n.problem {\n  margin: 0 0 10px;\n  padding: 10px 12px;\n  background: var(--panel);\n  border: 1px solid var(--line-soft);\n  border-inline-start: 6px solid var(--accent);\n  border-radius: 8px;\n}\n\n.problem h2 {\n  margin-bottom: 4px;\n}\n\n.problem p {\n  margin: 0;\n}\n\n/* Readout */\n\n.lcd {\n  margin-bottom: 8px;\n  padding: 8px 12px;\n  background: var(--lcd);\n  color: var(--lcd-ink);\n  border: 3px solid var(--lcd-edge);\n  border-radius: 8px;\n  box-shadow: inset 0 2px 6px rgba(30, 42, 16, 0.25);\n}\n\n.lcd-sensor {\n  margin: 0;\n  font-weight: 700;\n}\n\n.lcd-target {\n  margin: 0;\n  font-size: 0.9rem;\n}\n\n.lcd-value {\n  margin: 4px 0 0;\n  font-size: 1.25rem;\n  font-weight: 700;\n  line-height: 1.3;\n  font-variant-numeric: tabular-nums;\n  overflow-wrap: anywhere;\n  max-height: 7.8em;\n  overflow-y: auto;\n}\n\n.lcd-line {\n  display: block;\n}\n\n\n.viz {\n  display: block;\n  width: 100%;\n  height: 130px;\n  background: var(--viz-bg);\n  border: 1px solid var(--line-soft);\n  border-radius: 8px;\n}\n\n.viz-caption {\n  margin: 6px 0 0;\n  color: var(--ink-muted);\n  font-size: 0.85rem;\n}\n\n.readout-note {\n  margin: 8px 0;\n  font-size: 0.95rem;\n}\n\n.notice {\n  margin: 8px 0 0;\n  padding: 6px 10px;\n  background: var(--accent-soft);\n  border-radius: 8px;\n  font-size: 0.9rem;\n}\n\n.button {\n  min-height: 40px;\n  margin-top: 8px;\n  padding: 6px 14px;\n  background: var(--panel);\n  color: var(--accent-dark);\n  border: 2px solid var(--accent);\n  border-radius: 8px;\n  font: inherit;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.button-small {\n  min-height: 32px;\n  margin-top: 0;\n  padding: 2px 10px;\n  font-size: 0.85rem;\n}\n\n.button[aria-pressed=\"true\"] {\n  background: var(--accent);\n  color: #ffffff;\n}\n\n.button:hover {\n  background: var(--accent-soft);\n}\n\n.table-wrap {\n  max-height: 260px;\n  overflow-y: auto;\n}\n\ntable {\n  width: 100%;\n  border-collapse: collapse;\n  font-size: 0.9rem;\n}\n\nth,\ntd {\n  padding: 4px 6px;\n  border-bottom: 1px solid var(--line-soft);\n  text-align: start;\n  vertical-align: top;\n}\n\nth {\n  position: sticky;\n  top: 0;\n  background: var(--panel);\n}\n\n.log-empty td {\n  color: var(--ink-muted);\n}\n\n.app-error {\n  margin: 12px 0 0;\n  padding: 10px 12px;\n  background: var(--error-bg);\n  color: var(--error-ink);\n  border-radius: 8px;\n  font-weight: 700;\n}\n\n.button[aria-pressed=\"true\"]:hover {\n  background: var(--accent-dark);\n}\n",
