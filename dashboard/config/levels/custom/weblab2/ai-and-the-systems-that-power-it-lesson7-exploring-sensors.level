    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Park Sensor Lab</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"app\">\n    <header class=\"app-header\">\n      <h1>Park Sensor Lab</h1>\n      <p class=\"intro\">Pick a sensor, then point at something in the park to see the data that sensor collects.</p>\n    </header>\n\n    <section class=\"controls\" aria-labelledby=\"controls-heading\">\n      <h2 id=\"controls-heading\" class=\"visually-hidden\">Sensor settings</h2>\n\n      <fieldset class=\"sensor-picker\">\n        <legend>Choose a sensor</legend>\n        <div class=\"sensor-options\">\n          <label class=\"choice\">\n            <input type=\"radio\" name=\"sensor\" value=\"temperature\">\n            <span class=\"choice-card sensor-card\">\n              <svg class=\"sensor-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M10 4a2 2 0 0 1 4 0v10.5a4 4 0 1 1-4 0Z\"/><path d=\"M12 9v8\"/></svg>\n              <span>Temperature</span>\n            </span>\n          </label>\n          <label class=\"choice\">\n            <input type=\"radio\" name=\"sensor\" value=\"sound\">\n            <span class=\"choice-card sensor-card\">\n              <svg class=\"sensor-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 9h4l5-4v14l-5-4H4Z\"/><path d=\"M16.5 8.5a5 5 0 0 1 0 7\"/><path d=\"M19 6a8.5 8.5 0 0 1 0 12\"/></svg>\n              <span>Sound</span>\n            </span>\n          </label>\n          <label class=\"choice\">\n            <input type=\"radio\" name=\"sensor\" value=\"camera\">\n            <span class=\"choice-card sensor-card\">\n              <svg class=\"sensor-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M4 8h3l2-3h6l2 3h3v11H4Z\"/><circle cx=\"12\" cy=\"13\" r=\"3.5\"/></svg>\n              <span>Optical / Camera</span>\n            </span>\n          </label>\n          <label class=\"choice\">\n            <input type=\"radio\" name=\"sensor\" value=\"gps\">\n            <span class=\"choice-card sensor-card\">\n              <svg class=\"sensor-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M12 21s-6-6.2-6-11a6 6 0 0 1 12 0c0 4.8-6 11-6 11Z\"/><circle cx=\"12\" cy=\"10\" r=\"2.2\"/></svg>\n              <span>GPS / Position</span>\n            </span>\n          </label>\n          <label class=\"choice\">\n            <input type=\"radio\" name=\"sensor\" value=\"weight\">\n            <span class=\"choice-card sensor-card\">\n              <svg class=\"sensor-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\" focusable=\"false\"><path d=\"M8 9h8l3 11H5Z\"/><circle cx=\"12\" cy=\"5.5\" r=\"2.5\"/></svg>\n              <span>Weight</span>\n            </span>\n          </label>\n        </div>\n      </fieldset>\n\n      <div class=\"settings\">\n        <fieldset class=\"unit-picker\">\n          <legend>Temperature unit</legend>\n          <div class=\"unit-options\">\n            <label class=\"choice\">\n              <input type=\"radio\" name=\"temp-unit\" value=\"celsius\" checked>\n              <span class=\"choice-card unit-card\">Celsius</span>\n            </label>\n            <label class=\"choice\">\n              <input type=\"radio\" name=\"temp-unit\" value=\"fahrenheit\">\n              <span class=\"choice-card unit-card\">Fahrenheit</span>\n            </label>\n          </div>\n        </fieldset>\n        <label class=\"checkbox-label\">\n          <input type=\"checkbox\" id=\"sound-toggle\" checked>\n          <span>Play sounds</span>\n        </label>\n      </div>\n    </section>\n\n    <div class=\"workspace\">\n      <section class=\"panel scene-panel\" aria-labelledby=\"scene-heading\">\n        <h2 id=\"scene-heading\">The park</h2>\n        <p id=\"scene-help\" class=\"help\">Hover over or tap an object to take a reading. Click it to record the reading below. With a keyboard, press Tab to reach the park, use the arrow keys to move between objects, and press Enter to record.</p>\n\n        <svg class=\"scene\" id=\"scene\" viewBox=\"0 0 800 500\" role=\"group\" aria-labelledby=\"scene-heading\" aria-describedby=\"scene-help\">\n          <rect width=\"800\" height=\"300\" fill=\"#bfe3f0\"/>\n          <ellipse cx=\"210\" cy=\"58\" rx=\"60\" ry=\"18\" fill=\"#ffffff\"/>\n          <ellipse cx=\"250\" cy=\"46\" rx=\"36\" ry=\"18\" fill=\"#ffffff\"/>\n          <ellipse cx=\"450\" cy=\"92\" rx=\"54\" ry=\"15\" fill=\"#ffffff\"/>\n          <ellipse cx=\"480\" cy=\"82\" rx=\"30\" ry=\"14\" fill=\"#ffffff\"/>\n\n          <g class=\"scene-object\" data-object=\"sun\" role=\"button\" tabindex=\"0\" aria-label=\"Sun\">\n            <g stroke=\"#e0a91f\" stroke-width=\"6\" stroke-linecap=\"round\">\n              <line x1=\"736\" y1=\"80\" x2=\"752\" y2=\"80\"/>\n              <line x1=\"719.6\" y1=\"119.6\" x2=\"730.9\" y2=\"130.9\"/>\n              <line x1=\"680\" y1=\"136\" x2=\"680\" y2=\"152\"/>\n              <line x1=\"640.4\" y1=\"119.6\" x2=\"629.1\" y2=\"130.9\"/>\n              <line x1=\"624\" y1=\"80\" x2=\"608\" y2=\"80\"/>\n              <line x1=\"640.4\" y1=\"40.4\" x2=\"629.1\" y2=\"29.1\"/>\n              <line x1=\"680\" y1=\"24\" x2=\"680\" y2=\"8\"/>\n              <line x1=\"719.6\" y1=\"40.4\" x2=\"730.9\" y2=\"29.1\"/>\n            </g>\n            <circle cx=\"680\" cy=\"80\" r=\"44\" fill=\"#f5c542\"/>\n          </g>\n\n          <g class=\"scene-object\" data-object=\"grass\" role=\"button\" tabindex=\"-1\" aria-label=\"Grass\">\n            <path d=\"M0 262 Q200 232 400 256 T800 250 L800 500 L0 500 Z\" fill=\"#6aa84f\"/>\n            <g stroke=\"#3f7a33\" stroke-width=\"3\" stroke-linecap=\"round\" fill=\"none\">\n              <path d=\"M60 480 l-4 -14 M66 480 l0 -16 M72 480 l4 -13\"/>\n              <path d=\"M740 470 l-4 -14 M746 470 l0 -16 M752 470 l4 -13\"/>\n              <path d=\"M250 340 l-4 -12 M256 340 l0 -14 M262 340 l4 -11\"/>\n              <path d=\"M600 300 l-4 -12 M606 300 l0 -14 M612 300 l4 -11\"/>\n              <path d=\"M40 330 l-4 -12 M46 330 l0 -14 M52 330 l4 -11\"/>\n            </g>\n          </g>\n\n          <g class=\"scene-object\" data-object=\"tree\" role=\"button\" tabindex=\"-1\" aria-label=\"Tree\">\n            <rect x=\"136\" y=\"160\" width=\"28\" height=\"140\" rx=\"4\" fill=\"#7a5230\"/>\n            <path d=\"M160 228 L285 214\" stroke=\"#7a5230\" stroke-width=\"8\" stroke-linecap=\"round\"/>\n            <circle cx=\"95\" cy=\"160\" r=\"45\" fill=\"#2f7d3a\"/>\n            <circle cx=\"205\" cy=\"160\" r=\"48\" fill=\"#2f7d3a\"/>\n            <circle cx=\"150\" cy=\"130\" r=\"70\" fill=\"#2f7d3a\"/>\n            <circle cx=\"128\" cy=\"104\" r=\"28\" fill=\"#3b9147\"/>\n          </g>\n\n          <g class=\"scene-object\" data-object=\"bird\" role=\"button\" tabindex=\"-1\" aria-label=\"Bird\">\n            <path d=\"M244 204 L226 214 L246 212 Z\" fill=\"#8f1f1a\"/>\n            <ellipse cx=\"258\" cy=\"202\" rx=\"16\" ry=\"11\" fill=\"#c8322b\"/>\n            <circle cx=\"272\" cy=\"191\" r=\"9\" fill=\"#c8322b\"/>\n            <path d=\"M267 185 L271 171 L277 184 Z\" fill=\"#c8322b\"/>\n            <path d=\"M280 189 L291 192 L280 196 Z\" fill=\"#f0a830\"/>\n            <circle cx=\"274\" cy=\"189\" r=\"2\" fill=\"#1a1a1a\"/>\n            <line x1=\"256\" y1=\"212\" x2=\"256\" y2=\"217\" stroke=\"#5a3a1a\" stroke-width=\"2\"/>\n          </g>\n\n          <g class=\"scene-object\" data-object=\"bench\" role=\"button\" tabindex=\"-1\" aria-label=\"Bench\">\n            <rect x=\"306\" y=\"262\" width=\"6\" height=\"56\" fill=\"#3d3d3d\"/>\n            <rect x=\"398\" y=\"262\" width=\"6\" height=\"56\" fill=\"#3d3d3d\"/>\n            <rect x=\"300\" y=\"262\" width=\"110\" height=\"10\" rx=\"3\" fill=\"#8a5a34\"/>\n            <rect x=\"300\" y=\"278\" width=\"110\" height=\"10\" rx=\"3\" fill=\"#8a5a34\"/>\n            <rect x=\"296\" y=\"296\" width=\"118\" height=\"10\" rx=\"3\" fill=\"#6f4526\"/>\n          </g>\n\n          <g class=\"scene-object\" data-object=\"rock\" role=\"button\" tabindex=\"-1\" aria-label=\"Rock\">\n            <path d=\"M660 350 L672 318 L700 306 L730 314 L748 340 L740 356 L672 358 Z\" fill=\"#8d8f94\"/>\n            <path d=\"M680 322 L700 314 L716 318\" stroke=\"#b4b6ba\" stroke-width=\"4\" fill=\"none\" stroke-linecap=\"round\"/>\n          </g>\n\n          <g class=\"scene-object\" data-object=\"pond\" role=\"button\" tabindex=\"-1\" aria-label=\"Pond\">\n            <ellipse cx=\"470\" cy=\"398\" rx=\"190\" ry=\"76\" fill=\"#8a7a5a\"/>\n            <ellipse cx=\"470\" cy=\"398\" rx=\"180\" ry=\"68\" fill=\"#3a86a8\"/>\n            <g stroke=\"#8cc7df\" stroke-width=\"3\" fill=\"none\" stroke-linecap=\"round\">\n              <path d=\"M380 420 q20 -8 40 0\"/>\n              <path d=\"M430 440 q24 -8 48 0\"/>\n              <path d=\"M600 420 q16 -6 32 0\"/>\n              <path d=\"M360 370 q18 -6 36 0\"/>\n            </g>\n          </g>\n\n          <g class=\"scene-object\" data-object=\"duck\" role=\"button\" tabindex=\"-1\" aria-label=\"Duck\">\n            <path d=\"M508 386 L496 378 L506 394 Z\" fill=\"#6b5d48\"/>\n            <path d=\"M510 392 Q512 372 540 372 Q568 372 572 388 Q560 404 530 404 Q512 402 510 392 Z\" fill=\"#b9a88a\"/>\n            <path d=\"M530 382 Q545 377 556 387\" stroke=\"#8a7a5e\" stroke-width=\"3\" fill=\"none\"/>\n            <path d=\"M558 378 Q560 362 566 356\" stroke=\"#1f6b3a\" stroke-width=\"10\" fill=\"none\" stroke-linecap=\"round\"/>\n            <circle cx=\"568\" cy=\"352\" r=\"11\" fill=\"#1f6b3a\"/>\n            <path d=\"M577 349 L592 353 L577 358 Z\" fill=\"#f08a24\"/>\n            <circle cx=\"570\" cy=\"349\" r=\"2\" fill=\"#1a1a1a\"/>\n          </g>\n\n          <g class=\"scene-object\" data-object=\"dog\" role=\"button\" tabindex=\"-1\" aria-label=\"Dog\">\n            <path d=\"M104 414 Q84 396 92 378\" stroke=\"#c4843f\" stroke-width=\"8\" fill=\"none\" stroke-linecap=\"round\"/>\n            <rect x=\"116\" y=\"428\" width=\"9\" height=\"34\" rx=\"3\" fill=\"#a86c2e\"/>\n            <rect x=\"132\" y=\"430\" width=\"9\" height=\"32\" rx=\"3\" fill=\"#a86c2e\"/>\n            <rect x=\"164\" y=\"430\" width=\"9\" height=\"32\" rx=\"3\" fill=\"#a86c2e\"/>\n            <rect x=\"180\" y=\"428\" width=\"9\" height=\"34\" rx=\"3\" fill=\"#a86c2e\"/>\n            <ellipse cx=\"150\" cy=\"420\" rx=\"50\" ry=\"20\" fill=\"#c4843f\"/>\n            <circle cx=\"205\" cy=\"398\" r=\"20\" fill=\"#c4843f\"/>\n            <ellipse cx=\"224\" cy=\"405\" rx=\"12\" ry=\"9\" fill=\"#d9a066\"/>\n            <circle cx=\"234\" cy=\"402\" r=\"4\" fill=\"#1a1a1a\"/>\n            <path d=\"M194 382 Q184 398 192 412 L204 388 Z\" fill=\"#8a5424\"/>\n            <circle cx=\"210\" cy=\"393\" r=\"2.5\" fill=\"#1a1a1a\"/>\n          </g>\n        </svg>\n      </section>\n\n      <section class=\"panel readout-panel\" aria-labelledby=\"readout-heading\">\n        <h2 id=\"readout-heading\">Sensor reading</h2>\n        <div class=\"lcd\" id=\"lcd\">\n          <p class=\"lcd-sensor\" id=\"readout-sensor\">No sensor selected</p>\n          <p class=\"lcd-target\" id=\"readout-target\">Not pointing at anything yet</p>\n          <p class=\"lcd-value\" id=\"readout-value\">No reading</p>\n          <p class=\"lcd-badge\" id=\"readout-zero\" hidden>Reading is 0</p>\n        </div>\n        <canvas class=\"viz\" id=\"viz\" aria-hidden=\"true\"></canvas>\n        <p class=\"viz-caption\" id=\"viz-caption\"></p>\n        <p class=\"readout-note\" id=\"readout-note\">Choose a sensor above to start taking readings.</p>\n        <button class=\"button\" id=\"replay-sound\" type=\"button\" hidden>Play sound again</button>\n        <p class=\"notice\" id=\"audio-message\" hidden>This browser can't play sounds, but the sound readings and sound waves still work.</p>\n        <p class=\"visually-hidden\" id=\"status\" role=\"status\" aria-live=\"polite\"></p>\n      </section>\n    </div>\n\n    <section class=\"panel log-panel\" aria-labelledby=\"log-heading\">\n      <h2 id=\"log-heading\">Recorded readings</h2>\n      <p class=\"help\">Click an object, or press Enter on it, to save its reading here. Use these readings to fill in your sensor table.</p>\n      <div class=\"table-wrap\">\n        <table>\n          <thead>\n            <tr>\n              <th scope=\"col\">Object</th>\n              <th scope=\"col\">Sensor</th>\n              <th scope=\"col\">Reading</th>\n            </tr>\n          </thead>\n          <tbody id=\"log-body\"></tbody>\n        </table>\n      </div>\n      <button class=\"button\" id=\"clear-log\" type=\"button\">Clear readings</button>\n    </section>\n\n    <p class=\"app-error\" id=\"app-error\" role=\"alert\" hidden>The sensor lab couldn't start. Reload the page to try again.</p>\n  </main>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "style.css",
          "contents": ":root {\n  --ink: #15302a;\n  --ink-muted: #3d5750;\n  --page: #eef3ee;\n  --panel: #ffffff;\n  --line: #6f877d;\n  --line-soft: #c7d6ce;\n  --accent: #1f5f8b;\n  --accent-dark: #0e3754;\n  --accent-soft: #e3edf5;\n  --accent-ink: #ffffff;\n  --focus: #0b3d91;\n  --lcd: #d8e6c3;\n  --lcd-ink: #1e2a10;\n  --lcd-edge: #5d6e48;\n  --viz-bg: #f6f9f7;\n  --viz-grid: #d3e0d8;\n  --viz-ink: #2b4a42;\n  --viz-hot: #c0392b;\n  --viz-map: #e4efe0;\n  --error-bg: #fbe9e7;\n  --error-ink: #8a1c10;\n  --radius-lg: 14px;\n  --radius-sm: 8px;\n  --font: \"Trebuchet MS\", \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\n}\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\nbody {\n  margin: 0;\n  background: var(--page);\n  color: var(--ink);\n  font-family: var(--font);\n  font-size: 1rem;\n  line-height: 1.5;\n}\n\n.app {\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: clamp(12px, 3vw, 32px);\n}\n\nh1 {\n  margin: 0 0 0.25em;\n  font-size: clamp(1.6rem, 4vw, 2.3rem);\n  line-height: 1.15;\n}\n\nh2 {\n  margin: 0 0 0.5em;\n  font-size: 1.2rem;\n  line-height: 1.3;\n}\n\n.intro {\n  max-width: 65ch;\n  margin: 0 0 1.25rem;\n  color: var(--ink-muted);\n}\n\n.visually-hidden {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  clip: rect(0 0 0 0);\n  white-space: nowrap;\n  border: 0;\n}\n\n/* Controls */\n\n.controls {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: flex-end;\n  gap: 16px 24px;\n  margin-bottom: 16px;\n}\n\nfieldset {\n  min-width: 0;\n  margin: 0;\n  padding: 0;\n  border: 0;\n}\n\nlegend {\n  margin-bottom: 8px;\n  padding: 0;\n  font-weight: 700;\n}\n\n.sensor-picker {\n  flex: 1 1 520px;\n}\n\n.sensor-options {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(112px, 1fr));\n  gap: 8px;\n}\n\n.choice {\n  position: relative;\n  display: block;\n  cursor: pointer;\n}\n\n.choice input {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  opacity: 0;\n  cursor: pointer;\n}\n\n.choice-card {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 44px;\n  padding: 8px 14px;\n  background: var(--panel);\n  border: 2px solid var(--line);\n  border-radius: var(--radius-sm);\n  font-weight: 600;\n  text-align: center;\n}\n\n.sensor-card {\n  flex-direction: column;\n  gap: 6px;\n  min-height: 92px;\n}\n\n.sensor-icon {\n  width: 32px;\n  height: 32px;\n  fill: none;\n  stroke: currentColor;\n  stroke-width: 1.8;\n  stroke-linecap: round;\n  stroke-linejoin: round;\n}\n\n.choice input:hover + .choice-card {\n  border-color: var(--ink);\n}\n\n.choice input:checked + .choice-card {\n  background: var(--accent);\n  border-color: var(--accent-dark);\n  color: var(--accent-ink);\n  box-shadow: inset 0 -5px 0 var(--accent-dark);\n}\n\n.choice input:focus-visible + .choice-card {\n  outline: 3px solid var(--focus);\n  outline-offset: 3px;\n}\n\n.settings {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: flex-end;\n  gap: 16px;\n}\n\n.unit-options {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.checkbox-label {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-height: 44px;\n  font-weight: 600;\n  cursor: pointer;\n}\n\n.checkbox-label input {\n  width: 24px;\n  height: 24px;\n  margin: 0;\n  accent-color: var(--accent);\n}\n\n.checkbox-label input:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 3px;\n}\n\n/* Layout */\n\n.workspace {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  gap: 16px;\n}\n\n@media (min-width: 900px) {\n  .workspace {\n    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);\n    align-items: start;\n  }\n}\n\n.panel {\n  padding: 16px;\n  background: var(--panel);\n  border: 1px solid var(--line-soft);\n  border-radius: var(--radius-lg);\n}\n\n.help {\n  max-width: 70ch;\n  margin: 0 0 12px;\n  color: var(--ink-muted);\n  font-size: 0.95rem;\n}\n\n/* Scene */\n\n.scene {\n  display: block;\n  width: 100%;\n  height: auto;\n  border: 2px solid var(--line-soft);\n  border-radius: var(--radius-sm);\n  touch-action: manipulation;\n}\n\n.scene-object {\n  cursor: pointer;\n}\n\n/* Focus is shown with the drawn ring in the ring layer instead. */\n.scene-object:focus {\n  outline: none;\n}\n\n.focus-ring {\n  display: none;\n  pointer-events: none;\n}\n\n.focus-ring.is-visible {\n  display: inline;\n}\n\n.ring-outer {\n  fill: none;\n  stroke: #ffffff;\n  stroke-width: 9;\n}\n\n.ring-inner {\n  fill: none;\n  stroke: var(--focus);\n  stroke-width: 4;\n  stroke-dasharray: 12 6;\n}\n\n/* Readout */\n\n.lcd {\n  margin-bottom: 12px;\n  padding: 12px 16px;\n  background: var(--lcd);\n  color: var(--lcd-ink);\n  border: 3px solid var(--lcd-edge);\n  border-radius: var(--radius-sm);\n  box-shadow: inset 0 2px 6px rgba(30, 42, 16, 0.25);\n}\n\n.lcd-sensor {\n  margin: 0;\n  font-weight: 700;\n}\n\n.lcd-target {\n  margin: 0;\n  font-size: 0.95rem;\n}\n\n.lcd-value {\n  margin: 0.2em 0 0;\n  font-size: clamp(1.5rem, 4vw, 2.3rem);\n  font-weight: 700;\n  line-height: 1.2;\n  font-variant-numeric: tabular-nums;\n  overflow-wrap: anywhere;\n}\n\n.lcd-line {\n  display: block;\n}\n\n.lcd-badge {\n  display: inline-block;\n  margin: 8px 0 0;\n  padding: 2px 10px;\n  border: 2px solid var(--lcd-ink);\n  border-radius: 999px;\n  font-size: 0.9rem;\n  font-weight: 700;\n}\n\n.viz {\n  display: block;\n  width: 100%;\n  aspect-ratio: 2 / 1;\n  background: var(--viz-bg);\n  border: 1px solid var(--line-soft);\n  border-radius: var(--radius-sm);\n}\n\n.viz-caption {\n  margin: 8px 0 0;\n  color: var(--ink-muted);\n  font-size: 0.9rem;\n}\n\n.readout-note {\n  margin: 12px 0;\n}\n\n.notice {\n  margin: 12px 0 0;\n  padding: 8px 12px;\n  background: var(--accent-soft);\n  border-inline-start: 4px solid var(--accent);\n  border-radius: var(--radius-sm);\n}\n\n.button {\n  min-height: 44px;\n  padding: 8px 16px;\n  background: var(--panel);\n  color: var(--accent);\n  border: 2px solid var(--accent);\n  border-radius: var(--radius-sm);\n  font: inherit;\n  font-weight: 700;\n  cursor: pointer;\n}\n\n.button:hover {\n  background: var(--accent-soft);\n}\n\n.button:focus-visible {\n  outline: 3px solid var(--focus);\n  outline-offset: 3px;\n}\n\n/* Log */\n\n.log-panel {\n  margin-top: 16px;\n}\n\n.table-wrap {\n  overflow-x: auto;\n  margin-bottom: 12px;\n}\n\ntable {\n  width: 100%;\n  border-collapse: collapse;\n}\n\nth,\ntd {\n  padding: 8px 12px;\n  border-bottom: 1px solid var(--line-soft);\n  text-align: start;\n  vertical-align: top;\n}\n\nth {\n  font-size: 0.9rem;\n  border-bottom-color: var(--line);\n}\n\n.log-empty td {\n  color: var(--ink-muted);\n  font-style: italic;\n}\n\n.app-error {\n  margin: 16px 0 0;\n  padding: 12px 16px;\n  background: var(--error-bg);\n  color: var(--error-ink);\n  border-inline-start: 4px solid var(--error-ink);\n  border-radius: var(--radius-sm);\n  font-weight: 700;\n}\n\n[hidden] {\n  display: none !important;\n}",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "script.js",
          "contents": "(function () {\n  'use strict';\n\n  const SVG_NS = 'http://www.w3.org/2000/svg';\n  const LOCALE = document.documentElement.lang || 'en';\n  const SCENE_SIZE = { width: 800, height: 500 };\n  const TEMP_RANGE_C = { min: -10, max: 50 };\n  const WEIGHT_MAX_KG = 50;\n  const LOUDEST_DB = 90;\n  const LOG_LIMIT = 10;\n  // Positions are derived from where each object sits in the scene.\n  const MAP_ORIGIN = { lat: 40.7812, lon: -73.9665 };\n  const DEGREES_PER_SCENE_UNIT = 0.00001;\n  const KEYBOARD_ORDER = ['sun', 'tree', 'bird', 'bench', 'rock', 'pond', 'duck', 'dog', 'grass'];\n\n  const SENSORS = {\n    temperature: { label: 'Temperature' },\n    sound: { label: 'Sound' },\n    camera: { label: 'Optical / Camera' },\n    gps: { label: 'GPS / Position' },\n    weight: { label: 'Weight' }\n  };\n\n  const OBJECTS = {\n    sun: {\n      name: 'Sun',\n      temperature: 31,\n      sound: 0,\n      soundType: null,\n      color: [245, 197, 66],\n      weight: 0,\n      onEarth: false,\n      notes: {\n        temperature: 'This is the air temperature in direct sunlight, not the temperature of the sun itself.',\n        gps: 'The sun is not on Earth, so it has no latitude or longitude. The sensor reads 0.',\n        weight: 'The sun cannot be placed on the scale, so the scale reads 0.'\n      }\n    },\n    tree: {\n      name: 'Tree',\n      temperature: 22,\n      sound: 0,\n      soundType: null,\n      color: [47, 125, 58],\n      weight: 0,\n      onEarth: true,\n      notes: {\n        temperature: 'The shade under the tree keeps this spot cooler.',\n        weight: 'The tree is rooted in the ground and cannot be placed on the scale, so the scale reads 0.'\n      }\n    },\n    bird: {\n      name: 'Bird',\n      temperature: 40,\n      sound: 65,\n      soundType: 'chirp',\n      color: [200, 50, 43],\n      weight: 0.045,\n      onEarth: true,\n      notes: {\n        temperature: 'Birds make their own body heat, so this reading is warmer than the air.'\n      }\n    },\n    bench: {\n      name: 'Bench',\n      temperature: 27,\n      sound: 0,\n      soundType: null,\n      color: [138, 90, 52],\n      weight: 35,\n      onEarth: true,\n      notes: {\n        temperature: 'The wooden bench has been soaking up sunlight.'\n      }\n    },\n    rock: {\n      name: 'Rock',\n      temperature: 29,\n      sound: 0,\n      soundType: null,\n      color: [141, 143, 148],\n      weight: 12,\n      onEarth: true,\n      notes: {\n        temperature: 'Rocks soak up heat from the sun and stay warm.'\n      }\n    },\n    pond: {\n      name: 'Pond',\n      temperature: 17,\n      sound: 45,\n      soundType: 'water',\n      color: [58, 134, 168],\n      weight: 0,\n      onEarth: true,\n      notes: {\n        temperature: 'Water stays cooler than the air on a sunny day.',\n        weight: 'The pond cannot be placed on the scale, so the scale reads 0.'\n      }\n    },\n    duck: {\n      name: 'Duck',\n      temperature: 41,\n      sound: 70,\n      soundType: 'quack',\n      color: [185, 168, 138],\n      weight: 1.2,\n      onEarth: true,\n      notes: {\n        temperature: 'Ducks make their own body heat, so this reading is warmer than the air.'\n      }\n    },\n    dog: {\n      name: 'Dog',\n      temperature: 38.5,\n      sound: 85,\n      soundType: 'bark',\n      color: [196, 132, 63],\n      weight: 18,\n      onEarth: true,\n      notes: {\n        temperature: 'Dogs make their own body heat, so this reading is warmer than the air.'\n      }\n    },\n    grass: {\n      name: 'Grass',\n      temperature: 24,\n      sound: 0,\n      soundType: null,\n      color: [106, 168, 79],\n      weight: 0,\n      onEarth: true,\n      notes: {}\n    }\n  };\n\n  const state = {\n    sensorId: null,\n    objectId: null,\n    tempUnit: 'celsius',\n    soundEnabled: true,\n    log: []\n  };\n\n  const els = {};\n  const sceneObjects = {};\n  const palette = {};\n  let vizCtx = null;\n  let sceneImage = null;\n  let pixelCanvas = null;\n\n  /* ---------- Formatting ---------- */\n\n  function makeUnitFormatter(unit, suffix, options) {\n    try {\n      return new Intl.NumberFormat(LOCALE, Object.assign({ style: 'unit', unit: unit, unitDisplay: 'short' }, options));\n    } catch (error) {\n      const plain = new Intl.NumberFormat(LOCALE, options);\n      return { format: (value) => `${plain.format(value)} ${suffix}` };\n    }\n  }\n\n  const formatters = {\n    celsius: makeUnitFormatter('celsius', '°C', { maximumFractionDigits: 1 }),\n    fahrenheit: makeUnitFormatter('fahrenheit', '°F', { maximumFractionDigits: 1 }),\n    kilogram: makeUnitFormatter('kilogram', 'kg', { maximumFractionDigits: 3 }),\n    degree: makeUnitFormatter('degree', '°', { maximumFractionDigits: 5 }),\n    integer: new Intl.NumberFormat(LOCALE, { maximumFractionDigits: 0 })\n  };\n\n  function formatTemperature(celsius) {\n    if (state.tempUnit === 'fahrenheit') {\n      return formatters.fahrenheit.format(celsius * 9 / 5 + 32);\n    }\n    return formatters.celsius.format(celsius);\n  }\n\n  function buildReading(sensorId, obj) {\n    const notes = obj.notes;\n    switch (sensorId) {\n      case 'temperature': {\n        const text = formatTemperature(obj.temperature);\n        return {\n          lines: [text],\n          isZero: false,\n          note: notes.temperature || 'The sensor measures how hot or cold it is at the spot you pointed at.',\n          caption: `The thermometer is filled to ${text} on a scale from ${formatTemperature(TEMP_RANGE_C.min)} to ${formatTemperature(TEMP_RANGE_C.max)}.`\n        };\n      }\n      case 'sound': {\n        const isZero = obj.sound === 0;\n        return {\n          lines: [`${formatters.integer.format(obj.sound)} dB`],\n          isZero: isZero,\n          note: isZero\n            ? 'This object is silent, so the sensor reads 0 and there is nothing to play.'\n            : 'The sensor measures how loud the sound is in decibels (dB) and records its sound wave.',\n          caption: isZero\n            ? 'The sound wave is a flat line because there is no sound.'\n            : 'The sound wave shows how the sound changes over time. Taller waves mean a louder sound.'\n        };\n      }\n      case 'camera': {\n        const red = formatters.integer.format(obj.color[0]);\n        const green = formatters.integer.format(obj.color[1]);\n        const blue = formatters.integer.format(obj.color[2]);\n        return {\n          lines: [`Red ${red}`, `Green ${green}`, `Blue ${blue}`],\n          isZero: false,\n          note: 'The camera saves the picture as a grid of pixels. Each pixel is stored as three numbers for how much red, green, and blue it has. These numbers are for the main color of this object.',\n          caption: 'The camera view is zoomed in so you can see the individual pixels.'\n        };\n      }\n      case 'gps': {\n        const position = obj.position;\n        const isZero = !position;\n        const lat = formatters.degree.format(position ? position.lat : 0);\n        const lon = formatters.degree.format(position ? position.lon : 0);\n        return {\n          lines: [`Latitude ${lat}`, `Longitude ${lon}`],\n          isZero: isZero,\n          note: isZero\n            ? (notes.gps || 'No position was found, so the sensor reads 0.')\n            : 'The sensor finds where this object is on Earth using latitude and longitude.',\n          caption: isZero\n            ? 'The map has no pin because there is no position.'\n            : 'The map of the park shows a pin where this object is.'\n        };\n      }\n      case 'weight': {\n        const isZero = obj.weight === 0;\n        const text = formatters.kilogram.format(obj.weight);\n        return {\n          lines: [text],\n          isZero: isZero,\n          note: isZero\n            ? (notes.weight || 'Nothing is resting on the scale, so the scale reads 0.')\n            : 'The scale measures how heavy the object is.',\n          caption: `The scale dial points to ${text} on a dial from ${formatters.kilogram.format(0)} to ${formatters.kilogram.format(WEIGHT_MAX_KG)}.`\n        };\n      }\n      default:\n        return null;\n    }\n  }\n\n  /* ---------- Sound ---------- */\n\n  const AudioContextClass = window.AudioContext || window.webkitAudioContext;\n  const audio = { ctx: null, master: null, noise: null, sources: [] };\n\n  function ensureAudio() {\n    if (!AudioContextClass) {\n      return null;\n    }\n    try {\n      if (!audio.ctx) {\n        audio.ctx = new AudioContextClass();\n        audio.master = audio.ctx.createGain();\n        audio.master.gain.value = 0.35;\n        audio.master.connect(audio.ctx.destination);\n      }\n      if (audio.ctx.state === 'suspended') {\n        audio.ctx.resume().catch(() => {});\n      }\n      return audio.ctx;\n    } catch (error) {\n      return null;\n    }\n  }\n\n  function isAudioReady() {\n    return Boolean(audio.ctx && audio.ctx.state === 'running');\n  }\n\n  function stopSound() {\n    audio.sources.forEach((source) => {\n      try {\n        source.stop();\n      } catch (error) {\n        // Already stopped.\n      }\n    });\n    audio.sources = [];\n  }\n\n  function getNoiseBuffer(ctx) {\n    if (!audio.noise) {\n      const length = ctx.sampleRate * 2;\n      audio.noise = ctx.createBuffer(1, length, ctx.sampleRate);\n      const data = audio.noise.getChannelData(0);\n      for (let i = 0; i < length; i++) {\n        data[i] = Math.random() * 2 - 1;\n      }\n    }\n    return audio.noise;\n  }\n\n  function envelope(ctx, start, attack, hold, release, peak) {\n    const gain = ctx.createGain();\n    gain.gain.setValueAtTime(0.0001, start);\n    gain.gain.exponentialRampToValueAtTime(peak, start + attack);\n    gain.gain.setValueAtTime(peak, start + attack + hold);\n    gain.gain.exponentialRampToValueAtTime(0.0001, start + attack + hold + release);\n    gain.connect(audio.master);\n    return gain;\n  }\n\n  function track(source, start, stop) {\n    source.start(start);\n    source.stop(stop);\n    audio.sources.push(source);\n  }\n\n  const SOUND_BUILDERS = {\n    chirp(ctx, t) {\n      for (let i = 0; i < 4; i++) {\n        const start = t + i * 0.16;\n        const osc = ctx.createOscillator();\n        osc.type = 'sine';\n        osc.frequency.setValueAtTime(2600, start);\n        osc.frequency.exponentialRampToValueAtTime(4200, start + 0.08);\n        osc.connect(envelope(ctx, start, 0.01, 0.05, 0.04, 0.6));\n        track(osc, start, start + 0.12);\n      }\n    },\n    water(ctx, t) {\n      const duration = 1.8;\n      const source = ctx.createBufferSource();\n      source.buffer = getNoiseBuffer(ctx);\n      const band = ctx.createBiquadFilter();\n      band.type = 'bandpass';\n      band.frequency.value = 700;\n      band.Q.value = 0.9;\n      const gain = ctx.createGain();\n      gain.gain.setValueAtTime(0.0001, t);\n      for (let step = 0.06; step < duration - 0.2; step += 0.06) {\n        gain.gain.linearRampToValueAtTime(0.25 + Math.random() * 0.45, t + step);\n      }\n      gain.gain.linearRampToValueAtTime(0.0001, t + duration);\n      source.connect(band);\n      band.connect(gain);\n      gain.connect(audio.master);\n      track(source, t, t + duration);\n    },\n    quack(ctx, t) {\n      for (let i = 0; i < 2; i++) {\n        const start = t + i * 0.26;\n        const osc = ctx.createOscillator();\n        osc.type = 'sawtooth';\n        osc.frequency.setValueAtTime(330, start);\n        osc.frequency.linearRampToValueAtTime(240, start + 0.16);\n        const band = ctx.createBiquadFilter();\n        band.type = 'bandpass';\n        band.frequency.value = 1200;\n        band.Q.value = 4;\n        osc.connect(band);\n        band.connect(envelope(ctx, start, 0.02, 0.08, 0.08, 0.9));\n        track(osc, start, start + 0.2);\n      }\n    },\n    bark(ctx, t) {\n      for (let i = 0; i < 2; i++) {\n        const start = t + i * 0.3;\n        const osc = ctx.createOscillator();\n        osc.type = 'sawtooth';\n        osc.frequency.setValueAtTime(230, start);\n        osc.frequency.exponentialRampToValueAtTime(120, start + 0.15);\n        const low = ctx.createBiquadFilter();\n        low.type = 'lowpass';\n        low.frequency.value = 1100;\n        osc.connect(low);\n        low.connect(envelope(ctx, start, 0.01, 0.05, 0.1, 0.9));\n        track(osc, start, start + 0.18);\n\n        const noise = ctx.createBufferSource();\n        noise.buffer = getNoiseBuffer(ctx);\n        const band = ctx.createBiquadFilter();\n        band.type = 'bandpass';\n        band.frequency.value = 1500;\n        noise.connect(band);\n        band.connect(envelope(ctx, start, 0.005, 0.02, 0.06, 0.3));\n        track(noise, start, start + 0.1);\n      }\n    }\n  };\n\n  function playSound(soundType) {\n    stopSound();\n    const ctx = ensureAudio();\n    const build = SOUND_BUILDERS[soundType];\n    if (!ctx || !build) {\n      return;\n    }\n    build(ctx, ctx.currentTime + 0.02);\n  }\n\n  function playSoundFor(objectId, fromUserGesture) {\n    if (state.sensorId !== 'sound' || !state.soundEnabled) {\n      return;\n    }\n    const obj = OBJECTS[objectId];\n    if (!obj.soundType) {\n      stopSound();\n      return;\n    }\n    if (fromUserGesture || isAudioReady()) {\n      playSound(obj.soundType);\n    }\n  }\n\n  /* ---------- Visualizations ---------- */\n\n  function readPalette() {\n    const styles = getComputedStyle(document.documentElement);\n    ['viz-bg', 'viz-grid', 'viz-ink', 'viz-hot', 'viz-map', 'accent', 'lcd-edge'].forEach((name) => {\n      palette[name] = styles.getPropertyValue(`--${name}`).trim();\n    });\n  }\n\n  function prepareCanvas() {\n    const canvas = els.viz;\n    const rect = canvas.getBoundingClientRect();\n    const ratio = window.devicePixelRatio || 1;\n    const width = Math.max(1, Math.round(rect.width * ratio));\n    const height = Math.max(1, Math.round(rect.height * ratio));\n    if (canvas.width !== width || canvas.height !== height) {\n      canvas.width = width;\n      canvas.height = height;\n    }\n    vizCtx.setTransform(ratio, 0, 0, ratio, 0, 0);\n    vizCtx.fillStyle = palette['viz-bg'];\n    vizCtx.fillRect(0, 0, rect.width, rect.height);\n    return { w: rect.width, h: rect.height };\n  }\n\n  function roundedRect(ctx, x, y, w, h, r) {\n    const radius = Math.min(r, w / 2, h / 2);\n    ctx.beginPath();\n    ctx.moveTo(x + radius, y);\n    ctx.arcTo(x + w, y, x + w, y + h, radius);\n    ctx.arcTo(x + w, y + h, x, y + h, radius);\n    ctx.arcTo(x, y + h, x, y, radius);\n    ctx.arcTo(x, y, x + w, y, radius);\n    ctx.closePath();\n  }\n\n  function clamp(value, min, max) {\n    return Math.min(max, Math.max(min, value));\n  }\n\n  function drawTemperature(ctx, w, h, celsius) {\n    const tubeH = Math.max(14, h * 0.16);\n    const bulbR = tubeH * 1.1;\n    const cy = h * 0.58;\n    const x0 = w * 0.06 + bulbR;\n    const x1 = w * 0.94;\n    const span = TEMP_RANGE_C.max - TEMP_RANGE_C.min;\n\n    ctx.strokeStyle = palette['viz-ink'];\n    ctx.lineWidth = 2;\n    for (let t = TEMP_RANGE_C.min; t <= TEMP_RANGE_C.max; t += 10) {\n      const x = x0 + (x1 - x0) * ((t - TEMP_RANGE_C.min) / span);\n      const tickLength = t === 0 ? 22 : 12;\n      ctx.beginPath();\n      ctx.moveTo(x, cy - tubeH / 2 - 6);\n      ctx.lineTo(x, cy - tubeH / 2 - 6 - tickLength);\n      ctx.stroke();\n    }\n\n    roundedRect(ctx, x0, cy - tubeH / 2, x1 - x0, tubeH, tubeH / 2);\n    ctx.fillStyle = '#ffffff';\n    ctx.fill();\n    ctx.stroke();\n\n    const fraction = clamp((celsius - TEMP_RANGE_C.min) / span, 0, 1);\n    roundedRect(ctx, x0, cy - tubeH / 2 + 3, Math.max(tubeH, (x1 - x0) * fraction), tubeH - 6, (tubeH - 6) / 2);\n    ctx.fillStyle = palette['viz-hot'];\n    ctx.fill();\n\n    ctx.beginPath();\n    ctx.arc(x0, cy, bulbR, 0, Math.PI * 2);\n    ctx.fill();\n    ctx.stroke();\n  }\n\n  function soundSamples(soundType, count) {\n    let seed = 7;\n    const random = () => {\n      seed = (seed * 16807) % 2147483647;\n      return (seed / 2147483647) * 2 - 1;\n    };\n    const samples = [];\n    for (let i = 0; i < count; i++) {\n      const t = i / count;\n      let value = 0;\n      if (soundType === 'chirp') {\n        const phase = (t * 8) % 1;\n        const on = Math.floor(t * 8) % 2 === 0;\n        value = on ? Math.sin(Math.PI * phase) * Math.sin(i * 1.9) : 0;\n      } else if (soundType === 'water') {\n        value = random() * (0.45 + 0.35 * Math.sin(t * 23));\n      } else if (soundType === 'quack') {\n        const phase = (t * 4) % 1;\n        const on = Math.floor(t * 4) % 2 === 0;\n        value = on ? Math.sin(Math.PI * phase) * (((i * 0.3) % 1) * 2 - 1) : 0;\n      } else if (soundType === 'bark') {\n        const phase = (t * 4) % 1;\n        const on = Math.floor(t * 4) % 2 === 0;\n        const env = on ? Math.exp(-phase * 3) * Math.min(1, phase * 25) : 0;\n        value = env * ((((i * 0.2) % 1) * 2 - 1) * 0.8 + random() * 0.2);\n      }\n      samples.push(value);\n    }\n    return samples;\n  }\n\n  function drawSound(ctx, w, h, obj) {\n    const mid = h / 2;\n    ctx.strokeStyle = palette['viz-grid'];\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(0, mid);\n    ctx.lineTo(w, mid);\n    ctx.stroke();\n\n    const count = Math.max(60, Math.round(w / 2));\n    const samples = soundSamples(obj.soundType, count);\n    const amplitude = (obj.sound / LOUDEST_DB) * h * 0.42;\n    ctx.strokeStyle = palette.accent;\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    samples.forEach((sample, i) => {\n      const x = (i / (count - 1)) * w;\n      const y = mid - sample * amplitude;\n      if (i === 0) {\n        ctx.moveTo(x, y);\n      } else {\n        ctx.lineTo(x, y);\n      }\n    });\n    ctx.stroke();\n  }\n\n  function drawCamera(ctx, w, h, objectId) {\n    const cols = 32;\n    const rows = 16;\n    if (!pixelCanvas) {\n      pixelCanvas = document.createElement('canvas');\n      pixelCanvas.width = cols;\n      pixelCanvas.height = rows;\n    }\n    const pctx = pixelCanvas.getContext('2d');\n    const box = sceneObjects[objectId].box;\n    const cropW = Math.min(SCENE_SIZE.width, Math.max(box.width, box.height * 2) * 1.3);\n    const cropH = cropW / 2;\n    const cx = box.x + box.width / 2;\n    const cy = box.y + box.height / 2;\n    const sx = clamp(cx - cropW / 2, 0, SCENE_SIZE.width - cropW);\n    const sy = clamp(cy - cropH / 2, 0, Math.max(0, SCENE_SIZE.height - cropH));\n\n    if (sceneImage) {\n      pctx.clearRect(0, 0, cols, rows);\n      pctx.drawImage(sceneImage, sx, sy, cropW, cropH, 0, 0, cols, rows);\n    } else {\n      const [r, g, b] = OBJECTS[objectId].color;\n      for (let y = 0; y < rows; y++) {\n        for (let x = 0; x < cols; x++) {\n          const shade = ((x * 7 + y * 13) % 5) * 6 - 12;\n          pctx.fillStyle = `rgb(${clamp(r + shade, 0, 255)}, ${clamp(g + shade, 0, 255)}, ${clamp(b + shade, 0, 255)})`;\n          pctx.fillRect(x, y, 1, 1);\n        }\n      }\n    }\n\n    ctx.imageSmoothingEnabled = false;\n    ctx.drawImage(pixelCanvas, 0, 0, w, h);\n\n    ctx.strokeStyle = 'rgba(255, 255, 255, 0.35)';\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    for (let x = 1; x < cols; x++) {\n      ctx.moveTo((x * w) / cols, 0);\n      ctx.lineTo((x * w) / cols, h);\n    }\n    for (let y = 1; y < rows; y++) {\n      ctx.moveTo(0, (y * h) / rows);\n      ctx.lineTo(w, (y * h) / rows);\n    }\n    ctx.stroke();\n\n    const cellW = w / cols;\n    const cellH = h / rows;\n    ctx.lineWidth = 3;\n    ctx.strokeStyle = '#ffffff';\n    ctx.strokeRect(cellW * (cols / 2 - 1), cellH * (rows / 2 - 1), cellW * 2, cellH * 2);\n  }\n\n  function drawGps(ctx, w, h, obj) {\n    const scale = Math.min(w / SCENE_SIZE.width, h / SCENE_SIZE.height);\n    const offsetX = (w - SCENE_SIZE.width * scale) / 2;\n    const offsetY = (h - SCENE_SIZE.height * scale) / 2;\n    const toMap = (x, y) => ({ x: offsetX + x * scale, y: offsetY + y * scale });\n\n    ctx.fillStyle = palette['viz-map'];\n    ctx.fillRect(offsetX, offsetY, SCENE_SIZE.width * scale, SCENE_SIZE.height * scale);\n\n    ctx.strokeStyle = palette['viz-grid'];\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    for (let x = 0; x <= SCENE_SIZE.width; x += 100) {\n      const p = toMap(x, 0);\n      ctx.moveTo(p.x, offsetY);\n      ctx.lineTo(p.x, offsetY + SCENE_SIZE.height * scale);\n    }\n    for (let y = 0; y <= SCENE_SIZE.height; y += 100) {\n      const p = toMap(0, y);\n      ctx.moveTo(offsetX, p.y);\n      ctx.lineTo(offsetX + SCENE_SIZE.width * scale, p.y);\n    }\n    ctx.stroke();\n\n    const pondCenter = toMap(470, 398);\n    ctx.fillStyle = '#b7d7e4';\n    ctx.beginPath();\n    ctx.ellipse(pondCenter.x, pondCenter.y, 180 * scale, 68 * scale, 0, 0, Math.PI * 2);\n    ctx.fill();\n\n    const treeCenter = toMap(150, 150);\n    ctx.fillStyle = '#b9d6b4';\n    ctx.beginPath();\n    ctx.arc(treeCenter.x, treeCenter.y, 80 * scale, 0, Math.PI * 2);\n    ctx.fill();\n\n    if (!obj.position) {\n      return;\n    }\n    const pin = toMap(obj.sceneCenter.x, obj.sceneCenter.y);\n    const size = Math.max(10, 18 * scale * 2);\n    ctx.fillStyle = palette['viz-hot'];\n    ctx.strokeStyle = '#ffffff';\n    ctx.lineWidth = 2;\n    ctx.beginPath();\n    ctx.moveTo(pin.x, pin.y);\n    ctx.bezierCurveTo(pin.x - size * 0.9, pin.y - size, pin.x - size * 0.6, pin.y - size * 1.9, pin.x, pin.y - size * 1.9);\n    ctx.bezierCurveTo(pin.x + size * 0.6, pin.y - size * 1.9, pin.x + size * 0.9, pin.y - size, pin.x, pin.y);\n    ctx.fill();\n    ctx.stroke();\n    ctx.fillStyle = '#ffffff';\n    ctx.beginPath();\n    ctx.arc(pin.x, pin.y - size * 1.25, size * 0.28, 0, Math.PI * 2);\n    ctx.fill();\n  }\n\n  function drawWeight(ctx, w, h, kilograms) {\n    const cx = w / 2;\n    const cy = h * 0.88;\n    const radius = Math.min(w * 0.42, h * 0.75);\n\n    ctx.fillStyle = '#ffffff';\n    ctx.strokeStyle = palette['viz-ink'];\n    ctx.lineWidth = 3;\n    ctx.beginPath();\n    ctx.arc(cx, cy, radius, Math.PI, Math.PI * 2);\n    ctx.closePath();\n    ctx.fill();\n    ctx.stroke();\n\n    ctx.lineWidth = 2;\n    for (let kg = 0; kg <= WEIGHT_MAX_KG; kg += 5) {\n      const angle = Math.PI + (kg / WEIGHT_MAX_KG) * Math.PI;\n      const inner = radius * (kg % 10 === 0 ? 0.8 : 0.88);\n      ctx.beginPath();\n      ctx.moveTo(cx + Math.cos(angle) * inner, cy + Math.sin(angle) * inner);\n      ctx.lineTo(cx + Math.cos(angle) * radius * 0.96, cy + Math.sin(angle) * radius * 0.96);\n      ctx.stroke();\n    }\n\n    const needleAngle = Math.PI + (clamp(kilograms, 0, WEIGHT_MAX_KG) / WEIGHT_MAX_KG) * Math.PI;\n    ctx.strokeStyle = palette['viz-hot'];\n    ctx.lineWidth = 4;\n    ctx.lineCap = 'round';\n    ctx.beginPath();\n    ctx.moveTo(cx, cy);\n    ctx.lineTo(cx + Math.cos(needleAngle) * radius * 0.75, cy + Math.sin(needleAngle) * radius * 0.75);\n    ctx.stroke();\n    ctx.lineCap = 'butt';\n\n    ctx.fillStyle = palette['viz-ink'];\n    ctx.beginPath();\n    ctx.arc(cx, cy, 7, 0, Math.PI * 2);\n    ctx.fill();\n  }\n\n  function drawVisualization() {\n    if (!vizCtx) {\n      return;\n    }\n    const size = prepareCanvas();\n    const obj = state.objectId ? OBJECTS[state.objectId] : null;\n    if (!state.sensorId || !obj) {\n      return;\n    }\n    switch (state.sensorId) {\n      case 'temperature':\n        drawTemperature(vizCtx, size.w, size.h, obj.temperature);\n        break;\n      case 'sound':\n        drawSound(vizCtx, size.w, size.h, obj);\n        break;\n      case 'camera':\n        drawCamera(vizCtx, size.w, size.h, state.objectId);\n        break;\n      case 'gps':\n        drawGps(vizCtx, size.w, size.h, obj);\n        break;\n      case 'weight':\n        drawWeight(vizCtx, size.w, size.h, obj.weight);\n        break;\n      default:\n        break;\n    }\n  }\n\n  /* ---------- Rendering ---------- */\n\n  function setValueLines(lines) {\n    const value = els.value;\n    while (value.firstChild) {\n      value.removeChild(value.firstChild);\n    }\n    lines.forEach((line) => {\n      const span = document.createElement('span');\n      span.className = 'lcd-line';\n      span.textContent = line;\n      value.appendChild(span);\n    });\n  }\n\n  function updateReplayButton(obj) {\n    els.replay.hidden = !(\n      AudioContextClass &&\n      state.soundEnabled &&\n      state.sensorId === 'sound' &&\n      obj &&\n      obj.soundType\n    );\n    els.audioMessage.hidden = Boolean(AudioContextClass) || state.sensorId !== 'sound';\n  }\n\n  function render() {\n    const sensor = state.sensorId ? SENSORS[state.sensorId] : null;\n    const obj = state.objectId ? OBJECTS[state.objectId] : null;\n\n    els.sensor.textContent = sensor ? `${sensor.label} sensor` : 'No sensor selected';\n    els.target.textContent = obj ? `Pointing at: ${obj.name}` : 'Not pointing at anything yet';\n    updateReplayButton(obj);\n\n    if (!sensor || !obj) {\n      setValueLines(['No reading']);\n      els.zero.hidden = true;\n      els.caption.textContent = '';\n      els.note.textContent = sensor\n        ? 'Hover over or tap something in the park to take a reading.'\n        : 'Choose a sensor above to start taking readings.';\n      drawVisualization();\n      return null;\n    }\n\n    const reading = buildReading(state.sensorId, obj);\n    setValueLines(reading.lines);\n    els.zero.hidden = !reading.isZero;\n    els.note.textContent = reading.note;\n    els.caption.textContent = reading.caption;\n    drawVisualization();\n    return reading;\n  }\n\n  function announce(reading) {\n    if (!reading) {\n      return;\n    }\n    const sensor = SENSORS[state.sensorId];\n    const obj = OBJECTS[state.objectId];\n    els.status.textContent = `${sensor.label} sensor reading for ${obj.name}: ${reading.lines.join(', ')}.`;\n  }\n\n  function renderLog() {\n    const body = els.logBody;\n    while (body.firstChild) {\n      body.removeChild(body.firstChild);\n    }\n    if (state.log.length === 0) {\n      const row = document.createElement('tr');\n      row.className = 'log-empty';\n      const cell = document.createElement('td');\n      cell.colSpan = 3;\n      cell.textContent = 'No readings yet. Click an object in the park to record one.';\n      row.appendChild(cell);\n      body.appendChild(row);\n      els.clearLog.hidden = true;\n      return;\n    }\n    state.log.forEach((entry) => {\n      const row = document.createElement('tr');\n      [entry.object, entry.sensor, entry.reading].forEach((text) => {\n        const cell = document.createElement('td');\n        cell.textContent = text;\n        row.appendChild(cell);\n      });\n      body.appendChild(row);\n    });\n    els.clearLog.hidden = false;\n  }\n\n  function recordReading(reading) {\n    if (!reading) {\n      return;\n    }\n    state.log.unshift({\n      object: OBJECTS[state.objectId].name,\n      sensor: SENSORS[state.sensorId].label,\n      reading: reading.lines.join(', ')\n    });\n    if (state.log.length > LOG_LIMIT) {\n      state.log.length = LOG_LIMIT;\n    }\n    renderLog();\n  }\n\n  /* ---------- Scene ---------- */\n\n  function setActiveObject(objectId) {\n    Object.keys(sceneObjects).forEach((id) => {\n      sceneObjects[id].ring.classList.toggle('is-visible', id === objectId);\n    });\n  }\n\n  function selectObject(objectId, options) {\n    state.objectId = objectId;\n    setActiveObject(objectId);\n    const reading = render();\n    announce(reading);\n    if (options.record) {\n      recordReading(reading);\n    }\n    if (options.playSound) {\n      playSoundFor(objectId, options.fromUserGesture);\n    }\n  }\n\n  function focusObject(objectId) {\n    KEYBOARD_ORDER.forEach((id) => {\n      sceneObjects[id].el.setAttribute('tabindex', id === objectId ? '0' : '-1');\n    });\n    sceneObjects[objectId].el.focus();\n  }\n\n  function handleSceneKeydown(event) {\n    const objectEl = event.target.closest('.scene-object');\n    if (!objectEl) {\n      return;\n    }\n    const index = KEYBOARD_ORDER.indexOf(objectEl.dataset.object);\n    let nextIndex = null;\n    switch (event.key) {\n      case 'ArrowRight':\n      case 'ArrowDown':\n        nextIndex = (index + 1) % KEYBOARD_ORDER.length;\n        break;\n      case 'ArrowLeft':\n      case 'ArrowUp':\n        nextIndex = (index - 1 + KEYBOARD_ORDER.length) % KEYBOARD_ORDER.length;\n        break;\n      case 'Home':\n        nextIndex = 0;\n        break;\n      case 'End':\n        nextIndex = KEYBOARD_ORDER.length - 1;\n        break;\n      case 'Enter':\n      case ' ':\n        event.preventDefault();\n        ensureAudio();\n        selectObject(objectEl.dataset.object, { record: true, playSound: true, fromUserGesture: true });\n        return;\n      default:\n        return;\n    }\n    event.preventDefault();\n    focusObject(KEYBOARD_ORDER[nextIndex]);\n  }\n\n  function buildSceneImage() {\n    const clone = els.scene.cloneNode(true);\n    clone.setAttribute('width', String(SCENE_SIZE.width));\n    clone.setAttribute('height', String(SCENE_SIZE.height));\n    const markup = new XMLSerializer().serializeToString(clone);\n    const image = new Image();\n    image.onload = () => {\n      sceneImage = image;\n      if (state.sensorId === 'camera') {\n        drawVisualization();\n      }\n    };\n    image.onerror = () => {\n      sceneImage = null;\n    };\n    image.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(markup)}`;\n  }\n\n  function createRing(box) {\n    const pad = 8;\n    const ring = document.createElementNS(SVG_NS, 'g');\n    ring.setAttribute('class', 'focus-ring');\n    ['ring-outer', 'ring-inner'].forEach((className) => {\n      const rect = document.createElementNS(SVG_NS, 'rect');\n      rect.setAttribute('class', className);\n      rect.setAttribute('x', String(Math.max(3, box.x - pad)));\n      rect.setAttribute('y', String(Math.max(3, box.y - pad)));\n      rect.setAttribute('width', String(Math.min(SCENE_SIZE.width - 6, box.width + pad * 2)));\n      rect.setAttribute('height', String(Math.min(SCENE_SIZE.height - 6, box.height + pad * 2)));\n      rect.setAttribute('rx', '10');\n      ring.appendChild(rect);\n    });\n    return ring;\n  }\n\n  function setUpScene() {\n    buildSceneImage();\n\n    const ringLayer = document.createElementNS(SVG_NS, 'g');\n    ringLayer.setAttribute('aria-hidden', 'true');\n\n    els.scene.querySelectorAll('.scene-object').forEach((el) => {\n      const id = el.dataset.object;\n      const bbox = el.getBBox();\n      const box = { x: bbox.x, y: bbox.y, width: bbox.width, height: bbox.height };\n      const ring = createRing(box);\n      ringLayer.appendChild(ring);\n      sceneObjects[id] = { el: el, box: box, ring: ring };\n\n      const obj = OBJECTS[id];\n      obj.sceneCenter = { x: box.x + box.width / 2, y: box.y + box.height / 2 };\n      obj.position = obj.onEarth\n        ? {\n            lat: Number((MAP_ORIGIN.lat - (obj.sceneCenter.y - SCENE_SIZE.height / 2) * DEGREES_PER_SCENE_UNIT).toFixed(5)),\n            lon: Number((MAP_ORIGIN.lon + (obj.sceneCenter.x - SCENE_SIZE.width / 2) * DEGREES_PER_SCENE_UNIT).toFixed(5))\n          }\n        : null;\n\n      el.addEventListener('mouseenter', () => {\n        if (state.objectId !== id) {\n          selectObject(id, { playSound: true, fromUserGesture: false });\n        }\n      });\n      el.addEventListener('focus', () => {\n        KEYBOARD_ORDER.forEach((otherId) => {\n          sceneObjects[otherId].el.setAttribute('tabindex', otherId === id ? '0' : '-1');\n        });\n        if (state.objectId !== id) {\n          selectObject(id, { playSound: true, fromUserGesture: false });\n        } else {\n          setActiveObject(id);\n        }\n      });\n      el.addEventListener('click', () => {\n        ensureAudio();\n        selectObject(id, { record: true, playSound: true, fromUserGesture: true });\n      });\n    });\n\n    els.scene.appendChild(ringLayer);\n    els.scene.addEventListener('keydown', handleSceneKeydown);\n  }\n\n  /* ---------- Controls ---------- */\n\n  function setUpControls() {\n    document.querySelectorAll('input[name=\"sensor\"]').forEach((input) => {\n      input.addEventListener('change', () => {\n        state.sensorId = input.value;\n        stopSound();\n        if (state.sensorId === 'sound' && state.soundEnabled) {\n          ensureAudio();\n        }\n        const reading = render();\n        announce(reading);\n        if (state.objectId) {\n          playSoundFor(state.objectId, true);\n        }\n      });\n    });\n\n    document.querySelectorAll('input[name=\"temp-unit\"]').forEach((input) => {\n      input.addEventListener('change', () => {\n        state.tempUnit = input.value;\n        render();\n      });\n    });\n\n    els.soundToggle.addEventListener('change', () => {\n      state.soundEnabled = els.soundToggle.checked;\n      if (state.soundEnabled) {\n        ensureAudio();\n      } else {\n        stopSound();\n      }\n      render();\n    });\n\n    els.replay.addEventListener('click', () => {\n      if (state.objectId) {\n        playSoundFor(state.objectId, true);\n      }\n    });\n\n    els.clearLog.addEventListener('click', () => {\n      state.log = [];\n      renderLog();\n      els.status.textContent = 'Recorded readings cleared.';\n      els.scene.querySelector('.scene-object[tabindex=\"0\"]').focus();\n    });\n  }\n\n  function setUpCanvas() {\n    try {\n      vizCtx = els.viz.getContext('2d');\n    } catch (error) {\n      vizCtx = null;\n    }\n    if (!vizCtx) {\n      els.viz.hidden = true;\n      return;\n    }\n    if (window.ResizeObserver) {\n      new ResizeObserver(() => drawVisualization()).observe(els.viz);\n    } else {\n      window.addEventListener('resize', drawVisualization);\n    }\n  }\n\n  function init() {\n    els.scene = document.getElementById('scene');\n    els.sensor = document.getElementById('readout-sensor');\n    els.target = document.getElementById('readout-target');\n    els.value = document.getElementById('readout-value');\n    els.zero = document.getElementById('readout-zero');\n    els.viz = document.getElementById('viz');\n    els.caption = document.getElementById('viz-caption');\n    els.note = document.getElementById('readout-note');\n    els.replay = document.getElementById('replay-sound');\n    els.audioMessage = document.getElementById('audio-message');\n    els.status = document.getElementById('status');\n    els.logBody = document.getElementById('log-body');\n    els.clearLog = document.getElementById('clear-log');\n    els.soundToggle = document.getElementById('sound-toggle');\n\n    // Restore control state if the browser remembered form values.\n    const checkedSensor = document.querySelector('input[name=\"sensor\"]:checked');\n    state.sensorId = checkedSensor ? checkedSensor.value : null;\n    const checkedUnit = document.querySelector('input[name=\"temp-unit\"]:checked');\n    state.tempUnit = checkedUnit ? checkedUnit.value : 'celsius';\n    state.soundEnabled = els.soundToggle.checked;\n\n    readPalette();\n    setUpCanvas();\n    setUpScene();\n    setUpControls();\n    renderLog();\n    render();\n  }\n\n  try {\n    init();\n  } catch (error) {\n    const message = document.getElementById('app-error');\n    if (message) {\n      message.hidden = false;\n    }\n  }\n})();\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
        "1",
        "2",
        "3"
      ]
    }
  },
  "audit_log": "[{\"changed_at\":\"2026-09-22 20:59:28 +0000\",\"changed\":[],\"changed_by_id\":23972,\"changed_by_email\":\"julian.jackson+levelbuilder@code.org\"},{\"changed_at\":\"2026-09-22 20:59:46 +0000\",\"changed\":[],\"changed_by_id\":23972,\"changed_by_email\":\"julian.jackson+levelbuilder@code.org\"}]"
}]]></config>
