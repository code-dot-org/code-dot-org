    "start_sources": {
      "folders": {
      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>VibeCheck Queue</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n  <main class=\"app-container\">\n    <header>\n      <h1>VibeCheck 🎧</h1>\n      <p>Party Playlist Manager</p>\n    </header>\n\n    <section class=\"input-card\">\n      <h3>Queue Controls</h3>\n\n      <div class=\"input-group\">\n        <label for=\"input-song\">Song Title</label>\n        <input type=\"text\" id=\"input-song\" placeholder=\"e.g. Levitating\">\n      </div>\n\n      <div class=\"input-group\">\n        <label for=\"input-artist\">Artist Name</label>\n        <input type=\"text\" id=\"input-artist\" placeholder=\"e.g. Dua Lipa\">\n      </div>\n\n      <div class=\"controls\">\n        <button id=\"btn-add\" class=\"btn primary\">Add to End (push)</button>\n        <button id=\"btn-vip\" class=\"btn special\">VIP Bump (unshift)</button>\n        <button id=\"btn-play\" class=\"btn action\">Play Next (shift)</button>\n        <button id=\"btn-veto\" class=\"btn danger\">Veto Last (pop)</button>\n      </div>\n    </section>\n\n    <hr>\n\n    <section id=\"player-display\">\n      <div class=\"status-bar\">\n        <p>Total in Queue: <span id=\"count\">0</span></p>\n      </div>\n\n      <div id=\"listContainer\"></div>\n    </section>\n  </main>\n\n  <script src=\"helpers.js\"></script>\n  <script src=\"script.js\"></script>\n  <script src=\"listeners.js\"></script>\n</body>\n</html>",
          "active": false,
          "folderId": "0"
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "language": "js",
          "contents": "const inputSong = document.getElementById(\"input-song\");\nconst inputArtist = document.getElementById(\"input-artist\");\nconst count = document.getElementById(\"count\");\nconst listContainer = document.getElementById(\"listContainer\");\n\n\nconst songsArray = [\"Midnight City\", \"Blinding Lights\", \"Good 4 U\"];\nconst artistsArray = [\"M83\", \"The Weeknd\", \"Olivia Rodrigo\"];\n\n\nconst renderSongCards = () => {\n  \n  listContainer.innerHTML = \"\";\n  inputArtist.value = \"\";\n  inputSong.value = \"\";\n\n  songsArray.map((song, index) => {\n    createSongCard(song, artistsArray[index]);\n  });\n\n  count.textContent = songsArray.length;\n};\n\n\n\nconst addRequest = () => {\n  const song = inputSong.value;\n  const artist = inputArtist.value;\n\n  songsArray.push(song);\n  artistsArray.push(artist);\n\n  renderSongCards();\n  \n  };\n\nconst vipBump = () => {\n  const song = inputSong.value;\n  const artist = inputArtist.value;\n\n  songsArray.unshift(song);\n  artistsArray.unshift(artist);\n  \n  renderSongCards();\n\n};\n\nconst playNext = () => {\n  if (songsArray.length > 0) {\n    songsArray.shift();\n    artistsArray.shift();\n    renderSongCards();\n  }\n};\n\nconst vetoLast = () => {\n  if (songsArray.length > 0) {\n    songsArray.pop();\n    artistsArray.pop();\n    renderSongCards();\n  }\n};\n\n\nrenderSongCards();",
          "folderId": "0",
          "active": true
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "language": "css",
          "contents": "@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@400;700&display=swap');\n\nbody {\n  background-color: #121212;\n  color: #ffffff;\n  font-family: 'Outfit', sans-serif;\n  margin: 0;\n  min-height: 100vh;\n}\n\n.app-container {\n  background-color: #1E1E24;\n  padding: 2rem;\n  border-radius: 16px;\n  width: calc(100% - 32px);\n  max-width: 420px;\n  margin: 2rem auto;\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);\n  box-sizing: border-box;\n}\n\nheader {\n  text-align: center;\n  margin-bottom: 1.5rem;\n}\n\nheader h1 {\n  margin: 0;\n  color: #00FFC6;\n  font-size: 2rem;\n}\n\nheader p {\n  color: #AAAAAA;\n  margin-top: 0.5rem;\n}\n\n.input-card {\n  background: #2A2A35;\n  padding: 1.5rem;\n  border-radius: 12px;\n  margin-bottom: 1rem;\n}\n\n.input-card h3 {\n  margin-top: 0;\n  font-size: 1rem;\n  color: #8A2BE2;\n  text-transform: uppercase;\n}\n\n.input-group {\n  margin-bottom: 1rem;\n}\n\n.input-group label {\n  display: block;\n  font-size: 0.8rem;\n  color: #AAAAAA;\n  margin-bottom: 0.4rem;\n}\n\n.input-group input {\n  width: 100%;\n  padding: 10px;\n  background: #121212;\n  border: 1px solid #444;\n  border-radius: 6px;\n  color: white;\n  font-family: inherit;\n  box-sizing: border-box;\n}\n\n.input-group input:focus {\n  outline: 2px solid #00FFC6;\n  border-color: transparent;\n}\n\n.controls {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 10px;\n  margin-top: 1rem;\n}\n\n.btn {\n  padding: 12px;\n  border: none;\n  border-radius: 8px;\n  font-weight: 700;\n  cursor: pointer;\n  transition: 0.2s;\n}\n\n.btn:hover {\n  opacity: 0.9;\n}\n\n.btn:active {\n  transform: scale(0.96);\n}\n\n.primary {\n  background-color: #8A2BE2;\n  color: white;\n}\n\n.action {\n  background-color: #00FFC6;\n  color: #121212;\n}\n\n.danger {\n  background-color: transparent;\n  border: 2px solid #FF4B4B;\n  color: #FF4B4B;\n}\n\n.special {\n  background-color: #FFD700;\n  color: #121212;\n}\n\nhr {\n  border: 0;\n  border-top: 1px solid #333;\n  margin: 1.5rem 0;\n}\n\n.status-bar {\n  text-align: right;\n  font-size: 0.8rem;\n  color: #AAAAAA;\n  margin-bottom: 0.5rem;\n}\n\n#player-display {\n  width: 100%;\n}\n\n#listContainer {\n  margin-top: 1rem;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n\n.song-card {\n  display: flex;\n  align-items: center;\n  background: #252530;\n  padding: 0.8rem;\n  border-radius: 8px;\n  box-sizing: border-box;\n}\n\n.slot-num {\n  font-size: 1.5rem;\n  font-weight: bold;\n  color: #AAAAAA;\n  width: 40px;\n  opacity: 0.3;\n  flex-shrink: 0;\n}\n\n.track-info p {\n  margin: 0;\n}\n\n.song {\n  font-size: 1.1rem;\n  font-weight: 700;\n  color: white;\n}\n\n.artist {\n  font-size: 0.9rem;\n  color: #AAAAAA;\n}\n\n@media (max-width: 480px) {\n  .app-container {\n    padding: 1.25rem;\n    border-radius: 12px;\n    width: calc(100% - 20px);\n    margin: 10px auto;\n  }\n\n  .controls {\n    grid-template-columns: 1fr;\n  }\n\n  header h1 {\n    font-size: 1.7rem;\n  }\n\n  .song {\n    font-size: 1rem;\n  }\n\n  .artist {\n    font-size: 0.85rem;\n  }\n}",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "helpers.js",
          "contents": "const createSongCard = (song, artist) => {\n  const listContainer = document.getElementById(\"listContainer\");\n\n  const item = document.createElement(\"div\");\n  item.className = \"song-card\";\n\n  const slotNumber = document.createElement(\"div\");\n  slotNumber.className = \"slot-num\";\n  slotNumber.textContent = listContainer.children.length + 1;\n\n  const trackInfo = document.createElement(\"div\");\n  trackInfo.className = \"track-info\";\n\n  const songText = document.createElement(\"p\");\n  songText.className = \"song\";\n  songText.textContent = song;\n\n  const artistText = document.createElement(\"p\");\n  artistText.className = \"artist\";\n  artistText.textContent = artist;\n\n  trackInfo.appendChild(songText);\n  trackInfo.appendChild(artistText);\n\n  item.appendChild(slotNumber);\n  item.appendChild(trackInfo);\n\n  listContainer.appendChild(item);\n};\n",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
        "5": {
          "id": "5",
          "name": "listeners.js",
          "contents": "const addButton = document.getElementById(\"btn-add\");\nconst vipButton = document.getElementById(\"btn-vip\");\nconst playButton = document.getElementById(\"btn-play\");\nconst vetoButton = document.getElementById(\"btn-veto\");\n\naddButton.addEventListener(\"click\", addRequest);\nvipButton.addEventListener(\"click\", vipBump);\nplayButton.addEventListener(\"click\", playNext);\nvetoButton.addEventListener(\"click\", vetoLast);",
          "folderId": "0",
          "active": false,
          "type": "support"
        }
      },
      "openFiles": [
        "2"
      ]
    },
