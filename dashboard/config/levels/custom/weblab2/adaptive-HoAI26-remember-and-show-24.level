      },
      "files": {
        "1": {
          "id": "1",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>What does the page remember?</title>\n  <link rel=\"stylesheet\" href=\"style.css\">\n  <script src=\"script.js\" defer></script>\n</head>\n<body>\n  <main class=\"app\" id=\"app\">\n    <h1 class=\"visually-hidden\">What does the page remember?</h1>\n\n    <div class=\"error-banner\" id=\"error-banner\" role=\"alert\" hidden></div>\n\n    <div class=\"toolbar\">\n      <div class=\"author-controls\" id=\"author-controls\" hidden>\n        <span class=\"author-label\">Author</span>\n        <button type=\"button\" class=\"author-btn\" data-preset=\"empty\">Empty</button>\n        <button type=\"button\" class=\"author-btn\" data-preset=\"partial\">Partial</button>\n        <button type=\"button\" class=\"author-btn\" data-preset=\"full\">Full</button>\n      </div>\n      <button type=\"button\" class=\"code-btn\" id=\"code-btn\" aria-expanded=\"false\" aria-controls=\"code-panel\">See the code</button>\n    </div>\n\n    <div class=\"layout\">\n      <fieldset class=\"stand-set\">\n        <legend class=\"visually-hidden\">Snacks</legend>\n        <div class=\"stand\" id=\"stand\"></div>\n      </fieldset>\n\n      <div class=\"result\">\n        <section class=\"card shelf-card\" id=\"shelf-card\" data-fill=\"empty\" aria-labelledby=\"memory-title\">\n          <div class=\"card-head\">\n            <h2 class=\"card-title\" id=\"memory-title\">Memory</h2>\n            <button type=\"button\" class=\"clear-btn\" id=\"clear-btn\" disabled>Clear</button>\n          </div>\n          <ol class=\"shelf\" id=\"shelf\"></ol>\n          <p class=\"note\" id=\"memory-note\">\n            <span class=\"note-label\" id=\"memory-note-label\"></span>\n            <span class=\"note-text\" id=\"memory-note-text\"></span>\n          </p>\n        </section>\n\n        <section class=\"card display-card\" id=\"display-card\" data-view=\"count\" aria-labelledby=\"display-title\">\n          <div class=\"card-head\">\n            <h2 class=\"card-title\" id=\"display-title\">Display</h2>\n            <div class=\"switch\" role=\"group\" aria-label=\"Show memory as\">\n              <button type=\"button\" class=\"switch-btn\" data-view-choice=\"count\" aria-pressed=\"true\">Count</button>\n              <button type=\"button\" class=\"switch-btn\" data-view-choice=\"bar\" aria-pressed=\"false\">Bar</button>\n              <button type=\"button\" class=\"switch-btn\" data-view-choice=\"recent\" aria-pressed=\"false\">Recent</button>\n            </div>\n          </div>\n          <div class=\"views\">\n            <ul class=\"view view-count count-grid\" id=\"count-grid\"></ul>\n            <ul class=\"view view-bar bar-list\" id=\"bar-list\"></ul>\n            <ol class=\"view view-recent recent-list\" id=\"recent-list\"></ol>\n          </div>\n          <p class=\"note\" id=\"display-note\">\n            <span class=\"note-label\" id=\"display-note-label\"></span>\n            <span class=\"note-text\" id=\"display-note-text\"></span>\n          </p>\n        </section>\n      </div>\n    </div>\n\n    <section class=\"code-panel\" id=\"code-panel\" aria-labelledby=\"code-title\" hidden>\n      <h2 class=\"visually-hidden\" id=\"code-title\">The code</h2>\n      <div class=\"card prompt-card\">\n        <h3 class=\"card-title\">Sample prompt to build this with AI</h3>\n        <p class=\"prompt-text\" id=\"prompt-text\"></p>\n      </div>\n      <div class=\"card code-card\">\n        <h3 class=\"card-title\" id=\"code-memory-title\">Memory</h3>\n        <pre class=\"code\" tabindex=\"0\" aria-labelledby=\"code-memory-title\"><code id=\"code-memory\"></code></pre>\n        <h3 class=\"card-title\" id=\"code-display-title\"></h3>\n        <pre class=\"code\" tabindex=\"0\" aria-labelledby=\"code-display-title\"><code id=\"code-display\"></code></pre>\n      </div>\n    </section>\n\n    <div class=\"visually-hidden\" id=\"announcer\" aria-live=\"polite\" aria-atomic=\"true\"></div>\n  </main>\n\n  <template id=\"icon-apple\">\n    <svg class=\"snack-icon\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\">\n      <rect class=\"detail\" x=\"22.5\" y=\"5\" width=\"3\" height=\"11\" rx=\"1.5\"/>\n      <path class=\"accent\" d=\"M26 11c0-4 3-7 8-7 0 4-3 7-8 7z\"/>\n      <path class=\"fill\" d=\"M24 15c-3-3-7-3-10-1-4 3-5 9-3 15 2 6 6 11 10 11 2 0 2-1 3-1s1 1 3 1c4 0 8-5 10-11 2-6 1-12-3-15-3-2-7-2-10 1z\"/>\n    </svg>\n  </template>\n\n  <template id=\"icon-cookie\">\n    <svg class=\"snack-icon\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\">\n      <circle class=\"fill\" cx=\"24\" cy=\"24\" r=\"18\"/>\n      <circle class=\"detail chip\" cx=\"17\" cy=\"18\" r=\"3\"/>\n      <circle class=\"detail chip\" cx=\"31\" cy=\"17\" r=\"2.6\"/>\n      <circle class=\"detail chip\" cx=\"25\" cy=\"26\" r=\"3\"/>\n      <circle class=\"detail chip\" cx=\"15\" cy=\"31\" r=\"2.6\"/>\n      <circle class=\"detail chip\" cx=\"33\" cy=\"32\" r=\"2.8\"/>\n    </svg>\n  </template>\n\n  <template id=\"icon-grapes\">\n    <svg class=\"snack-icon\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\">\n      <rect class=\"detail\" x=\"22.5\" y=\"3\" width=\"3\" height=\"10\" rx=\"1.5\"/>\n      <path class=\"accent\" d=\"M26 8c0-3 3-5 8-5 0 3-3 5-8 5z\"/>\n      <circle class=\"fill\" cx=\"15\" cy=\"17\" r=\"6.5\"/>\n      <circle class=\"fill\" cx=\"33\" cy=\"17\" r=\"6.5\"/>\n      <circle class=\"fill\" cx=\"24\" cy=\"17\" r=\"6.5\"/>\n      <circle class=\"fill\" cx=\"19.5\" cy=\"26\" r=\"6.5\"/>\n      <circle class=\"fill\" cx=\"28.5\" cy=\"26\" r=\"6.5\"/>\n      <circle class=\"fill\" cx=\"24\" cy=\"35\" r=\"6.5\"/>\n    </svg>\n  </template>\n\n  <template id=\"icon-cheese\">\n    <svg class=\"snack-icon\" viewBox=\"0 0 48 48\" aria-hidden=\"true\" focusable=\"false\">\n      <path class=\"fill\" d=\"M5 18 43 10v26a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z\"/>\n      <circle class=\"detail chip\" cx=\"16\" cy=\"28\" r=\"3.5\"/>\n      <circle class=\"detail chip\" cx=\"30\" cy=\"31\" r=\"3\"/>\n      <circle class=\"detail chip\" cx=\"36\" cy=\"20\" r=\"2.4\"/>\n      <circle class=\"detail chip\" cx=\"23\" cy=\"20\" r=\"2\"/>\n    </svg>\n  </template>\n</body>\n</html>\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "script.js",
          "contents": "/*\n  What does the page remember? (Remember and show, step 2: Snack Stand)\n\n  Shaped like Test a Sensor: CONFIG and COPY first, then state, then small\n  named functions. The CADS notes (what is CADS, rebuilt, approximated) are in\n  the comment block at the top of style.css.\n\n  Takeaway: the page remembers each tap, then shows it however you choose.\n  Repeated action: tap a snack.\n*/\n'use strict';\n\n/* ---------- CONFIG (author edits here) ---------- */\n\nconst CONFIG = {\n  showAuthorControls: false, // true shows the Empty / Partial / Full presets, top left\n  shelfSlots: 20,            // how many taps memory holds before it is full\n  recentRows: 5,             // rows in the Recent display\n  startView: 'count',        // count, bar or recent\n  snacks: ['apple', 'cookie', 'grapes', 'cheese'],\n  partialTaps: ['apple', 'cookie', 'apple', 'grapes', 'apple', 'cheese', 'cookie'],\n  flightMs: 420,             // how long a tile takes to travel to the shelf\n  bumpMs: 300,               // how long a changed number or row stays highlighted\n};\n\n/* ---------- COPY (all text the script writes) ---------- */\n\nconst numberFormat = new Intl.NumberFormat(document.documentElement.lang || undefined);\nconst formatNumber = (value) => numberFormat.format(value);\n\nconst COPY = {\n  snackNames: { apple: 'Apple', cookie: 'Cookie', grapes: 'Grapes', cheese: 'Cheese' },\n  views: {\n    count: { label: 'Count', takeaway: 'One number for each snack.' },\n    bar: { label: 'Bar', takeaway: 'A longer bar means more taps.' },\n    recent: { label: 'Recent', takeaway: 'The latest taps, newest first.' },\n  },\n  memoryTakeaway: (total) => `Saved. Memory holds ${formatNumber(total)}.`,\n  memoryFullTakeaway: 'Saved. Memory is full.',\n  order: (position) => `#${formatNumber(position)}`,\n  readCount: (name, count) => `${name}: ${formatNumber(count)}`,\n  readRecent: (position, name) => `${COPY.order(position)}, ${name}`,\n  announceTap: (name, count, total) =>\n    `${name} saved. ${name} count: ${formatNumber(count)}. Memory holds ${formatNumber(total)}.`,\n  announceFull: 'Memory is full. Clear it to start again.',\n  announceView: (label, takeaway) => `${label} display. ${takeaway}`,\n  announceCleared: 'Memory cleared.',\n  errorBanner: 'This activity could not start. Reload the page to try again.',\n  codeShow: 'See the code',\n  codeHide: 'Hide the code',\n  announceCodeShown: 'Code shown.',\n  announceCodeHidden: 'Code hidden.',\n  codeDisplayTitle: (label) => `Display (${label})`,\n  samplePrompts: {\n    count: 'Make my page remember each button tap and show a count for each button.',\n    bar: 'Make my page remember each button tap and show a bar that grows with every tap.',\n    recent: 'Make my page remember each button tap and show a list of the latest five taps.',\n  },\n\n  codeCalls: { count: 'showCount(snack)', bar: 'showBar(snack)', recent: 'showRecent()' },\n  codeMemory: (call) => [\n    'let taps = [];',\n    '',\n    'function tapSnack(snack) {',\n    '  taps.push(snack);',\n    `  ${call};`,\n    '}',\n  ].join('\\n'),\n  codeDisplay: {\n    count: [\n      'function showCount(snack) {',\n      '  const count = taps.filter((t) => t === snack).length;',\n      '  document.getElementById(snack + \"-count\").textContent = count;',\n      '}',\n    ].join('\\n'),\n    bar: [\n      'function showBar(snack) {',\n      '  const count = taps.filter((t) => t === snack).length;',\n      '  const bar = document.getElementById(snack + \"-bar\");',\n      '  bar.style.width = (count / 20) * 100 + \"%\";',\n      '}',\n    ].join('\\n'),\n    recent: [\n      'function showRecent() {',\n      '  const latest = taps.slice(-5).reverse();',\n      '  document.getElementById(\"recent\").textContent = latest.join(\", \");',\n      '}',\n    ].join('\\n'),\n  },\n};\n\n/* ---------- State ---------- */\n\nconst state = {\n  taps: [],                  // snack ids, oldest first\n  view: CONFIG.startView,\n  displayNoted: false,       // the display note stays gray until something happens\n  codeOpen: false,\n};\n\nconst el = {};               // cached nodes, filled in by cacheElements\nconst bumpTimers = new Map();\nlet announceTimer = 0;\n\n/* ---------- Small helpers ---------- */\n\nfunction byId(id) {\n  const node = document.getElementById(id);\n  if (!node) {\n    throw new Error(`Missing element: ${id}`);\n  }\n  return node;\n}\n\nfunction makeIcon(snackId) {\n  const template = document.getElementById(`icon-${snackId}`);\n  if (!template) {\n    throw new Error(`Missing icon template: ${snackId}`);\n  }\n  return template.content.firstElementChild.cloneNode(true);\n}\n\nfunction makeNode(tag, className) {\n  const node = document.createElement(tag);\n  if (className) {\n    node.className = className;\n  }\n  return node;\n}\n\nfunction longest(strings) {\n  return strings.reduce((best, text) => (text.length > best.length ? text : best), '');\n}\n\nfunction prefersReducedMotion() {\n  return window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n}\n\n/* A reserved text spot holds a hidden copy of the longest text, so the real\n   text can change without moving anything. */\nfunction makeReserved(container, ghostText) {\n  container.classList.add('reserve');\n  const ghost = makeNode('span', 'ghost');\n  ghost.setAttribute('aria-hidden', 'true');\n  ghost.textContent = ghostText;\n  const live = makeNode('span', 'live');\n  container.append(ghost, live);\n  return live;\n}\n\n/* Pass null to show the gray placeholder bar for text that is not there yet. */\nfunction setLive(live, text) {\n  const empty = text === null;\n  live.textContent = empty ? live.previousElementSibling.textContent : text;\n  live.dataset.empty = String(empty);\n  if (empty) {\n    live.setAttribute('aria-hidden', 'true');\n  } else {\n    live.removeAttribute('aria-hidden');\n  }\n}\n\nfunction announce(text) {\n  window.clearTimeout(announceTimer);\n  el.announcer.textContent = '';\n  announceTimer = window.setTimeout(() => {\n    el.announcer.textContent = text;\n  }, 40);\n}\n\nfunction showError(text) {\n  const banner = document.getElementById('error-banner');\n  if (banner) {\n    banner.textContent = text;\n    banner.hidden = false;\n  }\n}\n\nfunction tally() {\n  const counts = {};\n  CONFIG.snacks.forEach((id) => {\n    counts[id] = 0;\n  });\n  state.taps.forEach((id) => {\n    counts[id] += 1;\n  });\n  return counts;\n}\n\n/* ---------- Build ---------- */\n\nfunction cacheElements() {\n  el.app = byId('app');\n  el.errorBanner = byId('error-banner');\n  el.authorControls = byId('author-controls');\n  el.stand = byId('stand');\n  el.shelfCard = byId('shelf-card');\n  el.shelf = byId('shelf');\n  el.clear = byId('clear-btn');\n  el.displayCard = byId('display-card');\n  el.countGrid = byId('count-grid');\n  el.barList = byId('bar-list');\n  el.recentList = byId('recent-list');\n  el.announcer = byId('announcer');\n  el.codeButton = byId('code-btn');\n  el.codePanel = byId('code-panel');\n  el.layout = document.querySelector('.layout');\n  el.promptText = byId('prompt-text');\n  el.codeMemory = byId('code-memory');\n  el.codeDisplay = byId('code-display');\n  el.codeDisplayTitle = byId('code-display-title');\n  el.viewButtons = Array.from(document.querySelectorAll('[data-view-choice]'));\n}\n\nfunction buildStand() {\n  CONFIG.snacks.forEach((id) => {\n    const button = makeNode('button', 'snack-btn');\n    button.type = 'button';\n    button.dataset.snack = id;\n    const iconBox = makeNode('span', 'icon-box');\n    iconBox.append(makeIcon(id));\n    const name = makeNode('span', 'snack-name');\n    name.textContent = COPY.snackNames[id];\n    button.append(iconBox, name);\n    el.stand.append(button);\n  });\n  el.snackButtons = Array.from(el.stand.children);\n}\n\nfunction buildShelf() {\n  const columns = Math.ceil(CONFIG.shelfSlots / 2);\n  el.app.style.setProperty('--shelf-columns', String(columns));\n  el.app.style.setProperty('--slots', String(CONFIG.shelfSlots));\n  el.slots = [];\n  for (let i = 0; i < CONFIG.shelfSlots; i += 1) {\n    const slot = makeNode('li', 'slot');\n    slot.setAttribute('aria-hidden', 'true');\n    el.shelf.append(slot);\n    el.slots.push(slot);\n  }\n}\n\nfunction buildCountCells() {\n  el.countCells = {};\n  CONFIG.snacks.forEach((id) => {\n    const root = makeNode('li', 'count-cell');\n    root.dataset.snack = id;\n    const reader = makeNode('span', 'visually-hidden');\n    const iconBox = makeNode('span', 'icon-box');\n    iconBox.setAttribute('aria-hidden', 'true');\n    iconBox.append(makeIcon(id));\n    const number = makeNode('span', 'count-num');\n    number.setAttribute('aria-hidden', 'true');\n    const live = makeReserved(number, '00');\n    const name = makeNode('span', 'count-name');\n    name.setAttribute('aria-hidden', 'true');\n    name.textContent = COPY.snackNames[id];\n    root.append(reader, iconBox, number, name);\n    el.countGrid.append(root);\n    el.countCells[id] = { root, reader, live };\n  });\n}\n\nfunction buildBarRows() {\n  el.barRows = {};\n  const ghostNumber = '00';\n  CONFIG.snacks.forEach((id) => {\n    const root = makeNode('li', 'bar-row');\n    root.dataset.snack = id;\n    const reader = makeNode('span', 'visually-hidden');\n    const iconBox = makeNode('span', 'icon-box');\n    iconBox.setAttribute('aria-hidden', 'true');\n    iconBox.append(makeIcon(id));\n    const name = makeNode('span', 'bar-name');\n    name.setAttribute('aria-hidden', 'true');\n    name.textContent = COPY.snackNames[id];\n    const track = makeNode('span', 'bar-track');\n    track.setAttribute('aria-hidden', 'true');\n    const fill = makeNode('span', 'bar-fill');\n    fill.dataset.empty = 'true';\n    track.append(fill);\n    const number = makeNode('span', 'bar-num');\n    number.setAttribute('aria-hidden', 'true');\n    const live = makeReserved(number, ghostNumber);\n    root.append(reader, iconBox, name, track, number);\n    el.barList.append(root);\n    el.barRows[id] = { root, reader, fill, live };\n  });\n}\n\nfunction buildRecentRows() {\n  el.recentRows = [];\n  const names = CONFIG.snacks.map((id) => COPY.snackNames[id]);\n  const ghostName = longest(names);\n  const ghostOrder = COPY.order(CONFIG.shelfSlots);\n  for (let i = 0; i < CONFIG.recentRows; i += 1) {\n    const root = makeNode('li', 'recent-row');\n    root.dataset.empty = 'true';\n    root.setAttribute('aria-hidden', 'true');\n    const reader = makeNode('span', 'visually-hidden');\n    const order = makeNode('span', 'order');\n    order.setAttribute('aria-hidden', 'true');\n    const orderLive = makeReserved(order, ghostOrder);\n    const iconBox = makeNode('span', 'icon-box');\n    iconBox.setAttribute('aria-hidden', 'true');\n    iconBox.dataset.empty = 'true';\n    const name = makeNode('span', 'recent-name');\n    name.setAttribute('aria-hidden', 'true');\n    const nameLive = makeReserved(name, ghostName);\n    root.append(reader, order, iconBox, name);\n    el.recentList.append(root);\n    el.recentRows.push({ root, reader, iconBox, orderLive, nameLive });\n  }\n}\n\nfunction buildNotes() {\n  const names = CONFIG.snacks.map((id) => COPY.snackNames[id]);\n  const viewLabels = Object.keys(COPY.views).map((key) => COPY.views[key].label);\n  const viewTakeaways = Object.keys(COPY.views).map((key) => COPY.views[key].takeaway);\n\n  el.memoryNoteLabel = makeReserved(byId('memory-note-label'), longest(names));\n  el.memoryNoteText = makeReserved(\n    byId('memory-note-text'),\n    longest([COPY.memoryTakeaway(CONFIG.shelfSlots), COPY.memoryFullTakeaway]),\n  );\n  el.displayNoteLabel = makeReserved(byId('display-note-label'), longest(viewLabels));\n  el.displayNoteText = makeReserved(byId('display-note-text'), longest(viewTakeaways));\n}\n\n/* ---------- Render ---------- */\n\nfunction makeTile(snackId) {\n  const tile = makeNode('span', 'tile');\n  tile.append(makeIcon(snackId));\n  const reader = makeNode('span', 'visually-hidden');\n  reader.textContent = COPY.snackNames[snackId];\n  tile.append(reader);\n  return tile;\n}\n\nfunction renderShelf() {\n  el.slots.forEach((slot, index) => {\n    const snackId = state.taps[index];\n    if (snackId && slot.dataset.snack !== snackId) {\n      slot.dataset.snack = snackId;\n      slot.replaceChildren(makeTile(snackId));\n      slot.removeAttribute('aria-hidden');\n    } else if (!snackId && slot.dataset.snack) {\n      delete slot.dataset.snack;\n      slot.replaceChildren();\n      slot.setAttribute('aria-hidden', 'true');\n    }\n  });\n}\n\nfunction renderCounts(counts) {\n  CONFIG.snacks.forEach((id) => {\n    const count = counts[id];\n    const cell = el.countCells[id];\n    cell.reader.textContent = COPY.readCount(COPY.snackNames[id], count);\n    setLive(cell.live, count > 0 ? formatNumber(count) : null);\n  });\n}\n\nfunction renderBars(counts) {\n  CONFIG.snacks.forEach((id) => {\n    const count = counts[id];\n    const row = el.barRows[id];\n    row.reader.textContent = COPY.readCount(COPY.snackNames[id], count);\n    row.root.style.setProperty('--count', String(count));\n    row.fill.dataset.empty = String(count === 0);\n    setLive(row.live, count > 0 ? formatNumber(count) : null);\n  });\n}\n\nfunction renderRecent() {\n  const total = state.taps.length;\n  el.recentRows.forEach((row, index) => {\n    const position = total - index;\n    const snackId = position > 0 ? state.taps[position - 1] : null;\n    if (snackId) {\n      const name = COPY.snackNames[snackId];\n      row.root.dataset.snack = snackId;\n      row.root.dataset.empty = 'false';\n      row.root.dataset.newest = String(index === 0);\n      row.root.removeAttribute('aria-hidden');\n      row.reader.textContent = COPY.readRecent(position, name);\n      setLive(row.orderLive, COPY.order(position));\n      setLive(row.nameLive, name);\n      row.iconBox.dataset.empty = 'false';\n      row.iconBox.replaceChildren(makeIcon(snackId));\n    } else {\n      delete row.root.dataset.snack;\n      delete row.root.dataset.newest;\n      row.root.dataset.empty = 'true';\n      row.root.setAttribute('aria-hidden', 'true');\n      row.reader.textContent = '';\n      setLive(row.orderLive, null);\n      setLive(row.nameLive, null);\n      row.iconBox.dataset.empty = 'true';\n      row.iconBox.replaceChildren();\n    }\n  });\n}\n\nfunction renderNotes() {\n  const total = state.taps.length;\n  if (total === 0) {\n    setLive(el.memoryNoteLabel, null);\n    setLive(el.memoryNoteText, null);\n  } else {\n    const lastName = COPY.snackNames[state.taps[total - 1]];\n    const full = total >= CONFIG.shelfSlots;\n    setLive(el.memoryNoteLabel, lastName);\n    setLive(el.memoryNoteText, full ? COPY.memoryFullTakeaway : COPY.memoryTakeaway(total));\n  }\n\n  if (state.displayNoted) {\n    const view = COPY.views[state.view];\n    setLive(el.displayNoteLabel, view.label);\n    setLive(el.displayNoteText, view.takeaway);\n  } else {\n    setLive(el.displayNoteLabel, null);\n    setLive(el.displayNoteText, null);\n  }\n}\n\nfunction renderControls() {\n  const total = state.taps.length;\n  const full = total >= CONFIG.shelfSlots;\n  el.shelfCard.dataset.fill = total === 0 ? 'empty' : full ? 'full' : 'some';\n  el.clear.disabled = total === 0;\n  el.snackButtons.forEach((button) => {\n    button.disabled = full;\n  });\n  el.displayCard.dataset.view = state.view;\n  el.viewButtons.forEach((button) => {\n    button.setAttribute('aria-pressed', String(button.dataset.viewChoice === state.view));\n  });\n}\n\nfunction renderCode() {\n  const view = COPY.views[state.view];\n  el.promptText.textContent = COPY.samplePrompts[state.view];\n  el.codeMemory.textContent = COPY.codeMemory(COPY.codeCalls[state.view]);\n  el.codeDisplay.textContent = COPY.codeDisplay[state.view];\n  el.codeDisplayTitle.textContent = COPY.codeDisplayTitle(view.label);\n  el.codeButton.setAttribute('aria-expanded', String(state.codeOpen));\n  el.codeButton.textContent = state.codeOpen ? COPY.codeHide : COPY.codeShow;\n  el.codePanel.hidden = !state.codeOpen;\n  el.layout.hidden = state.codeOpen;\n}\n\nfunction render() {\n  const counts = tally();\n  renderShelf();\n  renderCounts(counts);\n  renderBars(counts);\n  renderRecent();\n  renderNotes();\n  renderControls();\n  renderCode();\n}\n\n/* ---------- Motion ---------- */\n\nfunction retrigger(node) {\n  window.clearTimeout(bumpTimers.get(node));\n  delete node.dataset.bump;\n  void node.offsetWidth; // restart the animation if it was already running\n  node.dataset.bump = 'true';\n  bumpTimers.set(node, window.setTimeout(() => {\n    delete node.dataset.bump;\n  }, CONFIG.bumpMs));\n}\n\nfunction bump(snackId) {\n  retrigger(el.countCells[snackId].root);\n  retrigger(el.barRows[snackId].root);\n  retrigger(el.recentRows[0].root);\n}\n\n/* The new tile travels from the tapped snack to its slot, so the change\n   points back to its cause. */\nfunction flyTile(sourceButton, slot) {\n  const tile = slot.firstElementChild;\n  if (!tile || !tile.animate || !sourceButton || prefersReducedMotion()) {\n    return;\n  }\n  const from = sourceButton.querySelector('.icon-box').getBoundingClientRect();\n  const to = tile.getBoundingClientRect();\n  const dx = from.left + from.width / 2 - (to.left + to.width / 2);\n  const dy = from.top + from.height / 2 - (to.top + to.height / 2);\n  const startScale = from.width / to.width;\n  const easing = getComputedStyle(document.documentElement).getPropertyValue('--easing-out').trim() || 'ease-out';\n\n  tile.dataset.flying = 'true';\n  const flight = tile.animate(\n    [\n      { transform: `translate(${dx}px, ${dy}px) scale(${startScale})`, opacity: 0.9 },\n      { transform: 'translate(0, 0) scale(0.85)', opacity: 1, offset: 0.7 },\n      { transform: 'translate(0, 0) scale(1)', opacity: 1 },\n    ],\n    { duration: CONFIG.flightMs, easing },\n  );\n  const land = () => {\n    delete tile.dataset.flying;\n  };\n  flight.onfinish = land;\n  flight.oncancel = land;\n}\n\n/* ---------- Actions ---------- */\n\nfunction tapSnack(snackId, sourceButton) {\n  if (state.taps.length >= CONFIG.shelfSlots) {\n    return;\n  }\n  state.taps.push(snackId);\n  state.displayNoted = true;\n  render();\n\n  const total = state.taps.length;\n  const count = tally()[snackId];\n  flyTile(sourceButton, el.slots[total - 1]);\n  bump(snackId);\n\n  const full = total >= CONFIG.shelfSlots;\n  const message = COPY.announceTap(COPY.snackNames[snackId], count, total);\n  announce(full ? `${message} ${COPY.announceFull}` : message);\n  if (full) {\n    el.clear.focus();\n  }\n}\n\nfunction setView(view) {\n  if (!COPY.views[view] || (view === state.view && state.displayNoted)) {\n    return;\n  }\n  state.view = view;\n  state.displayNoted = true;\n  render();\n  const { label, takeaway } = COPY.views[view];\n  announce(COPY.announceView(label, takeaway));\n}\n\nfunction toggleCode(open) {\n  state.codeOpen = open;\n  render();\n  announce(open ? COPY.announceCodeShown : COPY.announceCodeHidden);\n}\n\nfunction clearMemory() {\n  state.taps = [];\n  state.displayNoted = false;\n  render();\n  announce(COPY.announceCleared);\n  el.snackButtons[0].focus();\n}\n\nfunction applyPreset(name) {\n  if (name === 'empty') {\n    state.taps = [];\n  } else if (name === 'partial') {\n    state.taps = CONFIG.partialTaps.slice();\n  } else if (name === 'full') {\n    state.taps = Array.from({ length: CONFIG.shelfSlots }, (_, i) =>\n      CONFIG.snacks[(i * 2 + Math.floor(i / 3)) % CONFIG.snacks.length]);\n  }\n  state.displayNoted = name !== 'empty';\n  render();\n}\n\n/* ---------- Start ---------- */\n\nfunction bindEvents() {\n  el.stand.addEventListener('click', (event) => {\n    const button = event.target.closest('.snack-btn');\n    if (button && !button.disabled) {\n      tapSnack(button.dataset.snack, button);\n    }\n  });\n  el.clear.addEventListener('click', clearMemory);\n  el.codeButton.addEventListener('click', () => toggleCode(!state.codeOpen));\n  document.addEventListener('keydown', (event) => {\n    if (event.key === 'Escape' && state.codeOpen) {\n      toggleCode(false);\n      el.codeButton.focus();\n    }\n  });\n  el.viewButtons.forEach((button) => {\n    button.addEventListener('click', () => setView(button.dataset.viewChoice));\n  });\n  el.authorControls.addEventListener('click', (event) => {\n    const button = event.target.closest('[data-preset]');\n    if (button) {\n      applyPreset(button.dataset.preset);\n    }\n  });\n}\n\nfunction init() {\n  try {\n    cacheElements();\n    buildStand();\n    buildShelf();\n    buildCountCells();\n    buildBarRows();\n    buildRecentRows();\n    buildNotes();\n    bindEvents();\n    el.authorControls.hidden = !CONFIG.showAuthorControls;\n    render();\n  } catch (error) {\n    showError(COPY.errorBanner);\n    console.error(error);\n  }\n}\n\ninit();\n",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "style.css",
          "contents": "/* ==========================================================================\n   What does the page remember?  (Remember and show, step 2: Snack Stand)\n   Web Lab widget: index.html, style.css, script.js.\n\n   WHAT IS CADS\n   - Every color, font family, type size, weight, radius, shadow, spacing\n     step, control height, motion duration and easing is a CADS token used\n     as var(--token-name). No hard-coded colors anywhere else in this file.\n   - The :root block below mirrors the CADS runtime tokens this widget uses\n     (runtime v0.1.0, manifest built 2026-10-13), same names and values.\n     Web Lab cannot load the CADS stylesheet, so it is the only place hex\n     values appear. Delete the block if Web Lab ever supplies CADS itself.\n   - Focus ring: 2px --border-focused-primary, as in CADS.\n   - Selected chrome (the active display button, the full-shelf Clear button)\n     uses selected tokens, never brand fills, as the CADS rules say.\n\n   WHAT WAS REBUILT\n   CADS components are React, so these follow the CADS recipe in plain CSS:\n   - Display switch: SegmentedButton (connected buttons, selected tokens,\n     32px). It uses aria-pressed buttons, not the radiogroup arrow-key pattern.\n   - Clear and See the code: Button, outlined, small (32px), CADS disabled\n     tokens. See the code uses selected tokens while the panel is open.\n   - Error banner: Alert, error sentiment.\n\n   WHAT WAS APPROXIMATED\n   - Fonts: the tokens name Geist and Space Grotesk, but Web Lab bans\n     external font files, so the stacks fall back to Noto Sans or the system.\n   - Display switch border: unselected segments use --border-neutral-solid,\n     not the SegmentedButton recipe's --border-neutral-secondary, which is\n     only 2.5:1 on white (WCAG 2.2 AA needs 3:1 for component edges).\n   - Code panel: a plain card with the --font-family-mono token; CADS has no\n     code block component.\n   - Micro gaps (.25rem): the smallest CADS spacing token is .5rem.\n   - Snack art, tiles, shelf slots, bars and the gray placeholder bars have\n     no CADS equivalent. Their colors are CADS accent, brand and warning\n     tokens, with outlines from --border-neutral-solid. Their sizes are\n     plain rem values.\n   - Custom properties that are not CADS: --snack-light, --snack-fill,\n     --snack-accent, --snack-detail (set per snack), --count, --slots and\n     --shelf-columns (set by script.js).\n   ========================================================================== */\n\n:root {\n  /* CADS tokens, mirrored (see the comment block above). Base values first. */\n  --brand-orange-5: #ffe3ce;\n  --brand-orange-30: #ffa868;\n  --brand-orange-50: #f46800;\n  --brand-orange-70: #b34800;\n  --brand-pink-5: #fbdae8;\n  --brand-pink-50: #e11970;\n  --brand-purple-5: #e4e2f8;\n  --brand-purple-20: #aca8ea;\n  --sentiment-error-5: #ffdada;\n  --neutral-base-white: #ffffff;\n  --neutral-gray-20: #d3d6da;\n  --neutral-gray-5: #f1f2f4;\n  --neutral-gray-10: #e1e3e6;\n  --brand-purple-80: #2b1e9f;\n  --sentiment-success-70: #258830;\n  --sentiment-warning-5: #fff5da;\n  --sentiment-warning-30: #ffd35c;\n  --sentiment-warning-50: #f5c000;\n  --sentiment-warning-70: #cf8e02;\n  --brand-purple-30: #928cef;\n  --sentiment-error-50: #eb1414;\n  --brand-purple-50: #4c42cf;\n  --neutral-gray-40: #9ea5ad;\n  --neutral-base-black: #121212;\n  --control-height-extra-small: 24px;\n  --control-height-small: 32px;\n  --duration-medium: .2s;\n  --duration-short: .15s;\n  --easing-out: cubic-bezier(.23, 1, .32, 1);\n  --easing-standard: cubic-bezier(.4, 0, .2, 1);\n  --font-family-heading: \"Space Grotesk\", \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-family-main: \"Geist\", \"Noto Sans\", \"Noto Sans Arabic\", \"Noto Sans Armenian\", \"Noto Sans Bengali\", \"Noto Sans SC\", \"Noto Sans TC\", \"Noto Sans Devanagari\", \"Noto Sans Georgian\", \"Noto Sans Hebrew\", \"Noto Sans JP\", \"Noto Sans Kannada\", \"Noto Sans Khmer\", \"Noto Sans KR\", \"Noto Sans Myanmar\", \"Noto Sans Sinhala\", \"Noto Sans Tamil\", \"Noto Sans Telugu\", \"Noto Sans Thai\", \"Noto Sans Thaana\", \"Noto Sans Math\", sans-serif;\n  --font-family-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace;\n  --font-weight-bold: 700;\n  --font-weight-medium: 500;\n  --font-weight-semi-bold: 600;\n  --leading-body-md: 1.5rem;\n  --leading-body-sm: 1.375rem;\n  --leading-body-xs: 1.125rem;\n  --leading-heading-md: 2rem;\n  --motion-press-scale: .97;\n  --shadow-md: 0 10px 15px -3px rgb(0 0 0 / 10%), 0 4px 6px -4px rgb(0 0 0 / 10%);\n  --shape-lg: .625rem;\n  --shape-md: .5rem;\n  --shape-round: 62.4375rem;\n  --shape-sm: .375rem;\n  --spacing-p-xs: 1rem;\n  --spacing-p-xxs: .5rem;\n  --text-body-md: 1rem;\n  --text-body-sm: .875rem;\n  --text-body-xs: .75rem;\n  --sentiment-error-70: #b30f0f;\n  --text-heading-md: 1.5rem;\n  --neutral-gray-70: #596069;\n  --neutral-gray-80: #4b5258;\n  --sentiment-success-5: #d8ffdc;\n\n  /* Semantic tokens */\n  --background-accent-orange-light: var(--brand-orange-5);\n  --background-accent-orange-mid: var(--brand-orange-30);\n  --background-accent-orange-primary: var(--brand-orange-50);\n  --background-accent-orange-strong: var(--brand-orange-70);\n  --background-accent-pink-light: var(--brand-pink-5);\n  --background-accent-pink-primary: var(--brand-pink-50);\n  --background-brand-light: var(--brand-purple-5);\n  --background-brand-mid: var(--brand-purple-20);\n  --background-error-light: var(--sentiment-error-5);\n  --background-neutral-primary: var(--neutral-base-white);\n  --background-neutral-quaternary: var(--neutral-gray-20);\n  --background-neutral-secondary: var(--neutral-gray-5);\n  --background-neutral-tertiary: var(--neutral-gray-10);\n  --background-selected-primary: var(--brand-purple-80);\n  --background-success-primary: var(--sentiment-success-70);\n  --background-warning-light: var(--sentiment-warning-5);\n  --background-warning-mid: var(--sentiment-warning-30);\n  --background-warning-primary: var(--sentiment-warning-50);\n  --background-warning-strong: var(--sentiment-warning-70);\n  --border-brand-mid: var(--brand-purple-30);\n  --border-disabled-neutral: var(--neutral-gray-20);\n  --border-error-primary: var(--sentiment-error-50);\n  --border-focused-primary: var(--brand-purple-50);\n  --border-neutral-primary: var(--neutral-gray-20);\n  --border-neutral-secondary: var(--neutral-gray-40);\n  --border-neutral-solid: var(--neutral-base-black);\n  --border-selected-primary: var(--brand-purple-80);\n  --text-disabled-neutral: var(--neutral-gray-20);\n  --text-error-secondary: var(--sentiment-error-70);\n  --text-neutral-primary: var(--neutral-base-black);\n  --text-neutral-quaternary: var(--neutral-gray-70);\n  --text-neutral-tertiary: var(--neutral-gray-80);\n  --text-selected-primary: var(--sentiment-success-5);\n}\n\n\n*,\n*::before,\n*::after {\n  box-sizing: border-box;\n}\n\n[hidden] {\n  display: none !important;\n}\n\nhtml,\nbody {\n  block-size: 100%;\n  margin: 0;\n}\n\nbody {\n  background: var(--background-neutral-secondary);\n  color: var(--text-neutral-primary);\n  font-family: var(--font-family-main);\n  font-size: var(--text-body-sm);\n  line-height: var(--leading-body-sm);\n}\n\nbutton {\n  color: inherit;\n  font: inherit;\n}\n\nul,\nol {\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n:focus-visible {\n  outline: 2px solid var(--border-focused-primary);\n  outline-offset: 2px;\n}\n\n.visually-hidden {\n  position: absolute;\n  inline-size: 1px;\n  block-size: 1px;\n  margin: -1px;\n  padding: 0;\n  overflow: hidden;\n  border: 0;\n  clip: rect(0 0 0 0);\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n\n/* ---------- Snack colors (one set per snack, read by every piece of that snack) ---------- */\n\n[data-snack=\"apple\"] {\n  --snack-light: var(--background-accent-pink-light);\n  --snack-fill: var(--background-accent-pink-primary);\n  --snack-accent: var(--background-success-primary);\n  --snack-detail: var(--background-accent-orange-strong);\n}\n\n[data-snack=\"cookie\"] {\n  --snack-light: var(--background-accent-orange-light);\n  --snack-fill: var(--background-accent-orange-mid);\n  --snack-accent: var(--background-accent-orange-primary);\n  --snack-detail: var(--background-accent-orange-strong);\n}\n\n[data-snack=\"grapes\"] {\n  --snack-light: var(--background-brand-light);\n  --snack-fill: var(--background-brand-mid);\n  --snack-accent: var(--background-success-primary);\n  --snack-detail: var(--background-accent-orange-strong);\n}\n\n[data-snack=\"cheese\"] {\n  --snack-light: var(--background-warning-light);\n  --snack-fill: var(--background-warning-mid);\n  --snack-accent: var(--background-warning-primary);\n  --snack-detail: var(--background-warning-strong);\n}\n\n.snack-icon {\n  display: block;\n  inline-size: 100%;\n  block-size: 100%;\n}\n\n.snack-icon * {\n  stroke: var(--border-neutral-solid);\n  stroke-width: 2;\n  stroke-linejoin: round;\n}\n\n.snack-icon .fill {\n  fill: var(--snack-fill);\n}\n\n.snack-icon .accent {\n  fill: var(--snack-accent);\n}\n\n.snack-icon .detail {\n  fill: var(--snack-detail);\n}\n\n.snack-icon .chip {\n  stroke-width: 1.2;\n}\n\n.icon-box {\n  display: grid;\n  flex: none;\n  place-items: center;\n}\n\n.icon-box[data-empty=\"true\"] {\n  background: var(--background-neutral-quaternary);\n  border-radius: var(--shape-round);\n}\n\n/* ---------- Layout ---------- */\n\n.app {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-p-xxs);\n  container-type: inline-size;\n  max-inline-size: 55rem;\n  min-block-size: 100%;\n  margin-inline: auto;\n  padding: var(--spacing-p-xxs);\n}\n\n.layout {\n  display: grid;\n  flex: 1;\n  grid-template-columns: 13rem minmax(0, 1fr);\n  gap: var(--spacing-p-xxs);\n}\n\n.stand-set {\n  min-inline-size: 0;\n  margin: 0;\n  padding: 0;\n  border: 0;\n}\n\n.stand {\n  display: grid;\n  align-content: start;\n  gap: var(--spacing-p-xxs);\n}\n\n.result {\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  gap: var(--spacing-p-xxs);\n  min-inline-size: 0;\n}\n\n/* ---------- Snack buttons (the one action students repeat) ---------- */\n\n.snack-btn {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  align-items: center;\n  gap: var(--spacing-p-xs);\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  background: var(--background-neutral-primary);\n  border: 2px solid var(--border-neutral-solid);\n  border-radius: var(--shape-md);\n  color: var(--text-neutral-primary);\n  font-size: var(--text-body-md);\n  font-weight: var(--font-weight-semi-bold);\n  line-height: var(--leading-body-md);\n  text-align: start;\n  cursor: pointer;\n  transition: transform var(--duration-short) var(--easing-out),\n    background-color var(--duration-short) var(--easing-standard);\n}\n\n.snack-btn .icon-box {\n  inline-size: 2.5rem;\n  block-size: 2.5rem;\n}\n\n.snack-btn:hover:not(:disabled) {\n  background: var(--snack-light);\n}\n\n.snack-btn:active:not(:disabled) {\n  transform: scale(var(--motion-press-scale));\n}\n\n.snack-btn:disabled {\n  border-color: var(--border-neutral-primary);\n  color: var(--text-neutral-quaternary);\n  cursor: default;\n}\n\n/* ---------- Cards ---------- */\n\n.card {\n  display: flex;\n  flex-direction: column;\n  gap: var(--spacing-p-xxs);\n  min-inline-size: 0;\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  background: var(--background-neutral-primary);\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-lg);\n}\n\n.card-head {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--spacing-p-xxs);\n  min-block-size: var(--control-height-small);\n}\n\n.card-title {\n  margin: 0;\n  font-family: var(--font-family-heading);\n  font-size: var(--text-body-md);\n  font-weight: var(--font-weight-bold);\n  line-height: var(--leading-body-md);\n}\n\n/* ---------- Code panel ---------- */\n\n.code-btn {\n  margin-inline-start: auto;\n}\n\n.code-btn[aria-expanded=\"true\"] {\n  background: var(--background-selected-primary);\n  border-color: var(--border-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n.code-panel {\n  display: grid;\n  flex: 1;\n  grid-template-columns: 13rem minmax(0, 1fr);\n  gap: var(--spacing-p-xxs);\n}\n\n.prompt-card {\n  align-self: start;\n}\n\n.prompt-text {\n  margin: 0;\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  background: var(--background-brand-light);\n  border: 1px solid var(--border-brand-mid);\n  border-radius: var(--shape-md);\n  font-size: var(--text-body-md);\n  line-height: var(--leading-body-md);\n}\n\n.code-card {\n  min-block-size: 0;\n}\n\n.code {\n  margin: 0;\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  overflow-x: auto;\n  background: var(--background-neutral-secondary);\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n  font-family: var(--font-family-mono);\n  font-size: var(--text-body-xs);\n  line-height: var(--leading-body-xs);\n}\n\n.code code {\n  font: inherit;\n  white-space: pre;\n}\n\n/* ---------- Memory shelf ---------- */\n\n.clear-btn,\n.code-btn {\n  min-block-size: var(--control-height-small);\n  padding-inline: var(--spacing-p-xs);\n  background: var(--background-neutral-primary);\n  border: 1px solid var(--border-neutral-solid);\n  border-radius: var(--shape-sm);\n  color: var(--text-neutral-primary);\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n  transition: transform var(--duration-short) var(--easing-out),\n    background-color var(--duration-short) var(--easing-standard);\n}\n\n.clear-btn:hover:not(:disabled),\n.code-btn:hover:not([aria-expanded=\"true\"]) {\n  background: var(--background-neutral-tertiary);\n}\n\n.clear-btn:active:not(:disabled),\n.code-btn:active {\n  transform: scale(var(--motion-press-scale));\n}\n\n.clear-btn:disabled {\n  border-color: var(--border-disabled-neutral);\n  color: var(--text-disabled-neutral);\n  cursor: default;\n}\n\n.shelf-card[data-fill=\"full\"] .clear-btn {\n  background: var(--background-selected-primary);\n  border-color: var(--border-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n.shelf {\n  display: grid;\n  grid-template-columns: repeat(var(--shelf-columns, 10), minmax(0, 1fr));\n  gap: var(--spacing-p-xxs);\n}\n\n.slot {\n  position: relative;\n  aspect-ratio: 1;\n  background: var(--background-neutral-secondary);\n  border: 2px dashed var(--border-neutral-secondary);\n  border-radius: var(--shape-sm);\n}\n\n.slot[data-snack] {\n  background: transparent;\n  border-color: transparent;\n}\n\n.tile {\n  position: absolute;\n  inset: -2px;\n  display: grid;\n  place-items: center;\n  background: var(--snack-light);\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-sm);\n}\n\n.tile .snack-icon {\n  inline-size: 72%;\n  block-size: 72%;\n}\n\n.tile[data-flying=\"true\"] {\n  z-index: 5;\n  box-shadow: var(--shadow-md);\n}\n\n/* ---------- Display card ---------- */\n\n.switch {\n  display: inline-flex;\n}\n\n.switch-btn {\n  min-block-size: var(--control-height-small);\n  margin-inline-start: -1px;\n  padding-inline: var(--spacing-p-xs);\n  background: var(--background-neutral-primary);\n  border: 1px solid var(--border-neutral-solid);\n  color: var(--text-neutral-primary);\n  font-weight: var(--font-weight-semi-bold);\n  cursor: pointer;\n  transition: background-color var(--duration-short) var(--easing-standard);\n}\n\n.switch-btn:first-child {\n  margin-inline-start: 0;\n  border-start-start-radius: var(--shape-sm);\n  border-end-start-radius: var(--shape-sm);\n}\n\n.switch-btn:last-child {\n  border-start-end-radius: var(--shape-sm);\n  border-end-end-radius: var(--shape-sm);\n}\n\n.switch-btn:hover:not([aria-pressed=\"true\"]) {\n  background: var(--background-neutral-tertiary);\n}\n\n.switch-btn[aria-pressed=\"true\"] {\n  position: relative;\n  z-index: 1;\n  background: var(--background-selected-primary);\n  border-color: var(--border-selected-primary);\n  color: var(--text-selected-primary);\n}\n\n.views {\n  display: grid;\n  flex: 1;\n}\n\n.view {\n  grid-area: 1 / 1;\n  align-self: center;\n  visibility: hidden;\n  opacity: 0;\n  transform: translateY(0.25rem);\n  transition: opacity var(--duration-medium) var(--easing-out),\n    transform var(--duration-medium) var(--easing-out),\n    visibility 0s linear var(--duration-medium);\n}\n\n.display-card[data-view=\"count\"] .view-count,\n.display-card[data-view=\"bar\"] .view-bar,\n.display-card[data-view=\"recent\"] .view-recent {\n  visibility: visible;\n  opacity: 1;\n  transform: none;\n  transition: opacity var(--duration-medium) var(--easing-out),\n    transform var(--duration-medium) var(--easing-out),\n    visibility 0s;\n}\n\n/* Count */\n\n.count-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: var(--spacing-p-xxs);\n}\n\n.count-cell {\n  display: grid;\n  justify-items: center;\n  align-content: center;\n  gap: 0.25rem;\n  padding: var(--spacing-p-xxs);\n  background: var(--background-neutral-secondary);\n  border: 1px solid var(--border-neutral-primary);\n  border-radius: var(--shape-md);\n}\n\n.count-cell .icon-box {\n  inline-size: 2.5rem;\n  block-size: 2.5rem;\n}\n\n.count-num {\n  font-family: var(--font-family-heading);\n  font-size: var(--text-heading-md);\n  font-weight: var(--font-weight-bold);\n  line-height: var(--leading-heading-md);\n}\n\n.count-name {\n  color: var(--text-neutral-tertiary);\n  font-size: var(--text-body-xs);\n  line-height: var(--leading-body-xs);\n  overflow-wrap: anywhere;\n  text-align: center;\n}\n\n/* Bar */\n\n.bar-list {\n  display: grid;\n  gap: var(--spacing-p-xxs);\n}\n\n.bar-row {\n  display: grid;\n  grid-template-columns: 1.5rem 5rem minmax(0, 1fr) 2rem;\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n}\n\n.bar-row .icon-box,\n.recent-row .icon-box {\n  inline-size: 1.5rem;\n  block-size: 1.5rem;\n}\n\n.bar-name {\n  font-weight: var(--font-weight-medium);\n  overflow-wrap: anywhere;\n}\n\n.bar-track {\n  display: block;\n  block-size: 1rem;\n  overflow: hidden;\n  background: var(--background-neutral-tertiary);\n  border-radius: var(--shape-round);\n}\n\n.bar-fill {\n  display: block;\n  block-size: 100%;\n  inline-size: calc(var(--count, 0) / var(--slots, 20) * 100%);\n  min-inline-size: 1rem;\n  background: var(--snack-fill);\n  border-radius: var(--shape-round);\n  box-shadow: inset 0 0 0 2px var(--border-neutral-solid);\n}\n\n.bar-fill[data-empty=\"true\"] {\n  inline-size: 0;\n  min-inline-size: 0;\n  box-shadow: none;\n}\n\n.bar-num {\n  justify-self: end;\n  font-weight: var(--font-weight-bold);\n  text-align: end;\n}\n\n/* Recent */\n\n.recent-list {\n  display: grid;\n  gap: 0.25rem;\n}\n\n.recent-row {\n  display: grid;\n  grid-template-columns: 2.75rem 1.5rem minmax(0, 1fr);\n  align-items: center;\n  gap: var(--spacing-p-xxs);\n  min-block-size: 1.75rem;\n  padding-inline: var(--spacing-p-xxs);\n  border-radius: var(--shape-sm);\n}\n\n.recent-row[data-newest=\"true\"] {\n  background: var(--background-brand-light);\n  box-shadow: inset 0 0 0 1px var(--border-brand-mid);\n}\n\n.order {\n  color: var(--text-neutral-quaternary);\n  font-variant-numeric: tabular-nums;\n}\n\n.recent-name {\n  font-weight: var(--font-weight-medium);\n  overflow-wrap: anywhere;\n}\n\n/* ---------- Reserved text and gray placeholder bars ---------- */\n\n.reserve {\n  display: grid;\n}\n\n.reserve > .ghost,\n.reserve > .live {\n  grid-area: 1 / 1;\n}\n\n.ghost {\n  visibility: hidden;\n}\n\n.live[data-empty=\"true\"] {\n  align-self: center;\n  justify-self: start;\n  block-size: 0.875em;\n  overflow: hidden;\n  background: var(--background-neutral-quaternary);\n  border-radius: var(--shape-sm);\n  color: transparent;\n  line-height: 1;\n  user-select: none;\n}\n\n.count-num .live[data-empty=\"true\"] {\n  justify-self: center;\n}\n\n.bar-num .live[data-empty=\"true\"] {\n  justify-self: end;\n}\n\n/* ---------- Notes: a label plus one short takeaway ---------- */\n\n.note {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: baseline;\n  gap: 0.25rem var(--spacing-p-xxs);\n  margin: 0;\n  margin-block-start: auto;\n  color: var(--text-neutral-tertiary);\n}\n\n.note-label {\n  color: var(--text-neutral-primary);\n  font-weight: var(--font-weight-bold);\n  white-space: nowrap;\n}\n\n/* ---------- Author controls and error banner ---------- */\n\n.toolbar {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--spacing-p-xxs);\n}\n\n.author-controls {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.25rem;\n}\n\n.author-label {\n  color: var(--text-neutral-quaternary);\n  font-size: var(--text-body-xs);\n  font-weight: var(--font-weight-semi-bold);\n}\n\n.author-btn {\n  min-block-size: var(--control-height-extra-small);\n  padding-inline: var(--spacing-p-xxs);\n  background: var(--background-neutral-primary);\n  border: 1px solid var(--border-neutral-secondary);\n  border-radius: var(--shape-sm);\n  font-size: var(--text-body-xs);\n  cursor: pointer;\n}\n\n.error-banner {\n  padding: var(--spacing-p-xxs) var(--spacing-p-xs);\n  background: var(--background-error-light);\n  border: 1px solid var(--border-error-primary);\n  border-radius: var(--shape-md);\n  color: var(--text-error-secondary);\n  font-weight: var(--font-weight-medium);\n}\n\n/* ---------- Motion ---------- */\n\n@keyframes bump {\n  0% {\n    transform: scale(1);\n  }\n\n  40% {\n    transform: scale(1.12);\n  }\n\n  100% {\n    transform: scale(1);\n  }\n}\n\n@keyframes slide-in {\n  from {\n    opacity: 0;\n    transform: translateY(-0.5rem);\n  }\n\n  to {\n    opacity: 1;\n    transform: none;\n  }\n}\n\n.count-cell[data-bump=\"true\"] {\n  animation: bump var(--duration-medium) var(--easing-out);\n}\n\n.bar-row[data-bump=\"true\"] .bar-num {\n  animation: bump var(--duration-medium) var(--easing-out);\n}\n\n.recent-row[data-bump=\"true\"] {\n  animation: slide-in var(--duration-medium) var(--easing-out);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n}\n\n/* ---------- Stacked layout under 48rem ---------- */\n\n@container (max-width: 47.9375rem) {\n  .layout {\n    grid-template-columns: minmax(0, 1fr);\n    align-content: start;\n  }\n\n  .result {\n    grid-template-rows: auto auto;\n  }\n\n  .code-panel {\n    grid-template-columns: minmax(0, 1fr);\n    align-content: start;\n  }\n\n  .stand {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .snack-btn {\n    gap: var(--spacing-p-xxs);\n    padding: var(--spacing-p-xxs);\n  }\n\n  .shelf {\n    gap: 0.25rem;\n  }\n}\n",
