<Weblab2>
  <config><![CDATA[{
  "game_id": 74,
  "created_at": "2026-11-03T03:20:41.000Z",
  "level_num": "custom",
  "user_id": 18754,
  "properties": {
    "require_edit_to_continue": true,
    "start_sources": {
      "folders": {
      },
      "files": {
        "7a4f36d9-1cdc-4fe9-867a-5cb2007b1909": {
          "id": "7a4f36d9-1cdc-4fe9-867a-5cb2007b1909",
          "name": "index.html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Bake Sale Site</title>\n    <link rel=\"stylesheet\" href=\"style.css\">\n</head>\n<body>\n    <div class=\"container\" id=\"bakeSaleSite\">\n        <h1>Delicious Treats for a Cause!</h1>\n        <p>Support our local community by purchasing homemade goodies. Every bite helps!</p>\n        \n        <div class=\"item-list\">\n            <div class=\"item-card\">\n                <h2>Chocolate Chip Cookies</h2>\n                <p>Classic, chewy, and packed with chocolatey goodness. Perfect for any occasion!</p>\n                <span class=\"price\">$2.00 each</span>\n            </div>\n            <div class=\"item-card\">\n                <h2>Blueberry Muffins</h2>\n                <p>Freshly baked with juicy blueberries. A delightful start to your day!</p>\n                <span class=\"price\">$2.50 each</span>\n            </div>\n            <div class=\"item-card\">\n                <h2>Lemon Bars</h2>\n                <p>Tangy lemon curd on a buttery shortbread crust. A refreshing dessert!</p>\n                <span class=\"price\">$3.00 each</span>\n            </div>\n        </div>\n\n        <button class=\"cta-button\">View Our Full Menu</button>\n    </div>\n\n    <div class=\"prompt-controls\">\n        <h2>Prompt Dial: Describe the Look</h2>\n        <div class=\"control-item\">\n            <label for=\"vibrantTheme\">Vibrant Theme</label>\n            <label class=\"switch\">\n                <input type=\"checkbox\" id=\"vibrantTheme\">\n                <span class=\"slider\"></span>\n            </label>\n        </div>\n        <div class=\"control-item\">\n            <label for=\"playfulFont\">Playful Font</label>\n            <label class=\"switch\">\n                <input type=\"checkbox\" id=\"playfulFont\">\n                <span class=\"slider\"></span>\n            </label>\n        </div>\n        <div class=\"control-item\">\n            <label for=\"centeredLayout\">Centered Layout</label>\n            <label class=\"switch\">\n                <input type=\"checkbox\" id=\"centeredLayout\">\n                <span class=\"slider\"></span>\n            </label>\n        </div>\n    </div>\n\n    <script src=\"script.js\"></script>\n</body>\n</html>",
          "folderId": "0",
          "type": "starter",
          "active": true
        },
        "cf09f55b-8136-4f30-8441-61253ea9bb96": {
          "id": "cf09f55b-8136-4f30-8441-61253ea9bb96",
          "name": "style.css",
          "contents": "body {\n    font-family: Arial, sans-serif;\n    margin: 20px;\n    background-color: #f8f8f8;\n    color: #333;\n    line-height: 1.6;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    min-height: calc(100vh - 40px);\n}\n\n.container {\n    background-color: #fff;\n    padding: 30px;\n    border-radius: 10px;\n    box-shadow: 0 4px 10px rgba(0,0,0,0.1);\n    max-width: 800px;\n    width: 100%;\n    margin-bottom: 30px;\n}\n\nh1 {\n    color: #4CAF50;\n    text-align: left;\n    margin-top: 0;\n}\n\np {\n    margin-bottom: 15px;\n}\n\n.item-list {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n    gap: 20px;\n    margin: 30px 0;\n}\n\n.item-card {\n    border: 1px solid #e0e0e0;\n    border-radius: 8px;\n    padding: 20px;\n    text-align: left;\n    background-color: #fefefe;\n}\n\n.item-card h2 {\n    color: #2196F3;\n    margin-top: 0;\n    font-size: 1.4em;\n}\n\n.item-card .price {\n    font-weight: bold;\n    color: #E91E63;\n    display: block;\n    margin-top: 10px;\n}\n\n.cta-button {\n    background-color: #FF9800;\n    color: white;\n    padding: 12px 25px;\n    border: none;\n    border-radius: 5px;\n    font-size: 1.1em;\n    cursor: pointer;\n    transition: background-color 0.3s ease;\n    display: block;\n    margin: 20px auto 0 auto;\n}\n\n.cta-button:hover {\n    background-color: #FB8C00;\n}\n\n/* Prompt Dial Controls Styling (reused from Level 13) */\n.prompt-controls {\n    background-color: #fff;\n    padding: 25px;\n    border-radius: 10px;\n    box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n    display: flex;\n    flex-direction: column;\n    gap: 15px;\n    width: 300px;\n}\n.control-item {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n}\n.control-item label {\n    font-size: 1.1em;\n    color: #555;\n}\n.switch {\n    position: relative;\n    display: inline-block;\n    width: 40px;\n    height: 24px;\n}\n.switch input {\n    opacity: 0;\n    width: 0;\n    height: 0;\n}\n.slider {\n    position: absolute;\n    cursor: pointer;\n    top: 0;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    background-color: #ccc;\n    -webkit-transition: .4s;\n    transition: .4s;\n    border-radius: 24px;\n}\n.slider:before {\n    position: absolute;\n    content: \"\";\n    height: 16px;\n    width: 16px;\n    left: 4px;\n    bottom: 4px;\n    background-color: white;\n    -webkit-transition: .4s;\n    transition: .4s;\n    border-radius: 50%;\n}\ninput:checked + .slider {\n    background-color: #2196F3;\n}\ninput:focus + .slider {\n    box-shadow: 0 0 1px #2196F3;\n}\ninput:checked + .slider:before {\n    -webkit-transform: translateX(16px);\n    -ms-transform: translateX(16px);\n    transform: translateX(16px);\n}\n\n/* Dynamic Styling based on Prompt Dial */\n.vibrant-theme body {\n    background-color: #E8F5E9; /* Light green */\n    color: #1A237E; /* Dark blue */\n}\n.vibrant-theme .container {\n    box-shadow: 0 6px 15px rgba(0,0,0,0.2);\n}\n.vibrant-theme h1 {\n    color: #388E3C; /* Darker green */\n}\n.vibrant-theme .item-card h2 {\n    color: #0288D1; /* Brighter blue */\n}\n.vibrant-theme .item-card {\n    border-color: #A5D6A7;\n    background-color: #C8E6C9;\n}\n.vibrant-theme .item-card .price {\n    color: #D81B60; /* More vibrant pink */\n}\n.vibrant-theme .cta-button {\n    background-color: #FF5722;\n}\n.vibrant-theme .cta-button:hover {\n    background-color: #F4511E;\n}\n\n.playful-font body {\n    font-family: 'Comic Sans MS', 'Chalkboard SE', cursive;\n}\n.playful-font h1, .playful-font .item-card h2 {\n    font-family: 'Comic Sans MS', 'Chalkboard SE', cursive;\n}\n\n.centered-layout .container {\n    text-align: center;\n}\n.centered-layout h1 {\n    text-align: center;\n}\n.centered-layout .item-list {\n    justify-content: center;\n}\n.centered-layout .item-card {\n    text-align: center;\n}\n",
          "folderId": "0",
          "type": "starter",
          "active": false
        },
        "363340bf-7899-4714-b613-929e97a8ecfc": {
          "id": "363340bf-7899-4714-b613-929e97a8ecfc",
          "name": "script.js",
          "contents": "document.addEventListener('DOMContentLoaded', () => {\n    const bakeSaleSite = document.getElementById('bakeSaleSite');\n    const body = document.body;\n\n    const vibrantThemeToggle = document.getElementById('vibrantTheme');\n    const playfulFontToggle = document.getElementById('playfulFont');\n    const centeredLayoutToggle = document.getElementById('centeredLayout');\n\n    vibrantThemeToggle.addEventListener('change', function() {\n        if (this.checked) {\n            body.classList.add('vibrant-theme');\n        } else {\n            body.classList.remove('vibrant-theme');\n        }\n    });\n\n    playfulFontToggle.addEventListener('change', function() {\n        if (this.checked) {\n            body.classList.add('playful-font');\n        } else {\n            body.classList.remove('playful-font');\n        }\n    });\n\n    centeredLayoutToggle.addEventListener('change', function() {\n        if (this.checked) {\n            body.classList.add('centered-layout');\n        } else {\n            body.classList.remove('centered-layout');\n        }\n    });\n});",
          "folderId": "0",
          "type": "starter",
          "active": false
        }
      },
      "openFiles": [
        "7a4f36d9-1cdc-4fe9-867a-5cb2007b1909",
        "cf09f55b-8136-4f30-8441-61253ea9bb96",
        "363340bf-7899-4714-b613-929e97a8ecfc"
      ]
    },
    "long_instructions": "TODOs:\r\n- Open index.html to see the bake sale site and the prompt dial controls.\r\n- Toggle the \"Vibrant Theme\" switch to change the site's colors.\r\n- Toggle the \"Playful Font\" switch to change the site's typography.\r\n- Toggle the \"Centered Layout\" switch to adjust how content is aligned.\r\n- Observe how adding or removing these 'details' changes the visual appearance of the bake sale site.\r\n- Understand that each switch represents a detail you might add to a prompt to describe a specific look.",
