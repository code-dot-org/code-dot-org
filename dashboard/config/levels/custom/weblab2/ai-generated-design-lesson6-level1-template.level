          "name": "index.html",
          "language": "html",
          "contents": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>My Website</title>\n</head>\n<body>\n\n<header>\n  <h1>My Website</h1>\n  <p>Your brand message goes here.</p>\n  <nav>\n    <a href=\"index.html\">Home</a>\n    <a href=\"contact.html\">Contact</a>\n  </nav>\n</header>\n\n<main>\n  <section>\n    <h2>About</h2>\n    <p>This is a short description of your website.</p>\n  </section>\n\n  <section>\n    <h2>Services</h2>\n    <p>Describe what you offer here.</p>\n  </section>\n\n  <section>\n    <h2>Updates</h2>\n    <p>Share recent news or highlights.</p>\n    <p>Learn more on our <a href=\"contact.html\">contact page</a>.</p>\n  </section>\n</main>\n\n<footer>\n  <p>&copy; 2026 My Website</p>\n</footer>\n\n</body>\n</html>\n",
