          "name": "style.css",
          "language": "css",
          "contents": ".container {\n  /* We gave the div container a background color so you can see how the items are positioned within it */\n  background: #b691d6;\n  \n  /* First, create a flex layout context */\n\n\n\n  /* Then, define the flow direction \n  and if the items should wrap */\n\n \n}\n\n\nimg {\n  border-style: solid;\n  width: 100px;\n}",
