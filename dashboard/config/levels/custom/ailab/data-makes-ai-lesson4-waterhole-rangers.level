    "mode": "{\r\n  \"trainer\": \"decisionTree\",\r\n  \"reserveLastRows\": true,\r\n  \"datasets\": [\r\n    \"SC1-L04-waterhole-ranger-patrols\"\r\n  ],\r\n  \"pretrained\": true,\r\n  \"hideSelectLabel\": true,\r\n  \"lockFeatures\": true,\r\n  \"hideDatasetView\": true,\r\n  \"label\": \"Elephants Visit\",\r\n  \"features\": [\r\n    \"Season\",\r\n    \"Time of Day\",\r\n    \"Water Level\",\r\n    \"Temperature\"\r\n  ],\r\n  \"hideSave\": true\r\n}",
