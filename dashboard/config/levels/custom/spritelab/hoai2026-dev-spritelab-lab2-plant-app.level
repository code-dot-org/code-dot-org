                          "next": {
                            "block": {
                              "type": "spritelab2_showText",
                              "id": "showText-70",
                              "fields": {
                                "SIZE": "body",
                                "NAME": "about"
                              },
                              "inputs": {
                                "TEXT": {
                                  "block": {
                                    "type": "text",
                                    "id": "text-68",
                                    "fields": {
                                      "TEXT": "This app uses an AI model trained on plant data. The model looks at leaf spots, leaf color, drooping and soil moisture, and predicts if a plant is healthy or sick. It can be wrong, so check with a person who knows plants."
                                    }
                                  }
                                },
                                "LOCATION": {
                                  "block": {
