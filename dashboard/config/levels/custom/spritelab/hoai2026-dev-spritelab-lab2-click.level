    "guide_steps": [
      {
        "text": "**Add your new character on the right.** Use **make new sprite** with position **right** - they'll turn to face your hero. Then add **when clicked** with a **say** block inside, so clicking them makes them speak. Press **Play** and try it."
      },
      {
        "text": "**It's interactive!** Click your new character to hear from them, then continue when you're ready.",
        "showContinue": true,
        "after": {
          "tab": "Play"
        }
      }
    ],
    "long_instructions": "# Click to talk\nAdd your new character on the **right** of the scene. Then add **when clicked** with a **say** block inside, so clicking them makes them speak.",
    "toolbox_definition": {
      "kind": "flyoutToolbox",
      "contents": [
        {
          "kind": "block",
          "type": "spritelab2_makeSpriteAtPosition",
          "fields": {
            "POSITION": "right"
          }
        },
        {
          "kind": "block",
          "type": "gamelab_spriteClicked",
          "inputs": {
            "SPRITE": {
