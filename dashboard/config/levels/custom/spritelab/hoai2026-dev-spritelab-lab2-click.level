                "type": "gamelab_allSpritesWithAnimation"
              }
            }
          }
        },
        {
          "kind": "block",
          "type": "gamelab_spriteSay",
          "fields": {
            "SPEECH": "You clicked me!"
          },
          "inputs": {
            "SPRITE": {
              "shadow": {
                "type": "gamelab_allSpritesWithAnimation"
              }
            }
          }
        }
      ]
    }
