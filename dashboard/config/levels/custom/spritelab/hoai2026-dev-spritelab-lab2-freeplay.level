<GamelabJr>
  <config><![CDATA[{
  "published": true,
  "game_id": 64,
  "created_at": "2026-08-10T00:00:00.000Z",
  "level_num": "custom",
  "user_id": 1,
  "properties": {
    "uses_lab2": "true",
    "block_pools": [
      "GamelabJr",
      "GameDev"
    ],
    "helper_libraries": [
      "NativeSpriteLab",
      "zGameDev"
    ],
    "standalone_app_name": "spritelab",
    "skin": "gamelab",
    "hide_custom_blocks": true,
    "hide_share_and_remix": "true",
    "encrypted": "false",
    "project_template_level_name": "hoai2026-dev-spritelab-lab2-template",
    "visible_tabs": [
      "Code",
      "Images",
      "World",
      "Play"
