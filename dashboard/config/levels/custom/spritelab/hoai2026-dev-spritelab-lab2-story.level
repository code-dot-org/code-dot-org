    "guide_steps": [
      {
        "text": "**Code your story scene.** Use the blocks to set your background, add your character, and make them speak or move. Your changes run live in the preview. When it feels right, click **Play**."
      },
      {
        "text": "**That's your story!** Watch it play, then continue when you're ready.",
        "showContinue": true,
        "after": {
          "tab": "Play"
        }
      }
    ],
    "long_instructions": "# Code your story scene\nUse the blocks to set your background, add your character, and make them speak or move. Your changes run live in the preview.",
    "toolbox_definition": {
      "kind": "flyoutToolbox",
      "contents": [
        {
          "kind": "block",
          "type": "gamelab_setBackgroundImageAs"
        },
        {
          "kind": "block",
          "type": "gamelab_makeNewSpriteAnon",
          "inputs": {
            "LOCATION": {
              "block": {
                "type": "gamelab_location_picker",
                "fields": {
                  "LOCATION": "{\"x\":200,\"y\":200}"
                }
              }
            }
          }
        },
        {
          "kind": "block",
          "type": "gamelab_spriteSay",
          "fields": {
            "SPEECH": "Hello!"
          },
          "inputs": {
            "SPRITE": {
              "shadow": {
                "type": "gamelab_allSpritesWithAnimation"
              }
            }
          }
        }
      ]
    }
  }
