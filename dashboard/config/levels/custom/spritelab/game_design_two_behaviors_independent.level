    "authored_hints": "[{\"hint_class\":null,\"hint_markdown\":\"Connect two <code style=\\\"color:black; background-color:#5ED5DD\\\">sprite begins</code> behavior block to your program. One for each of the sprites.\",\"hint_id\":\"hint\",\"hint_type\":\"general\",\"hint_path\":\"\",\"hint_video\":\"\",\"tts_url\":\"https://tts.code.org/sharon22k/180/100/503a59d5393568c1f418364084b45d7d/game_design_two_behaviors.mp3\"},{\"hint_class\":null,\"hint_markdown\":\"Choose the <code style=\\\"color:black; background-color:#6AF36C\\\">wandering</code> behavior from the dropdown menu of one behavior and <code style=\\\"color:black; background-color:#6AF36C\\\">moving with arrow keys</code> from the other.\\n\\n<xml>\\n<block xmlns=\\\"https://developers.google.com/blockly/xml\\\" type=\\\"gamelab_toggleBehaviorSimple\\\" id=\\\"hRWdfU%m;Xh{Q$^j;m$i\\\">\\n  <field name=\\\"TOGGLE\\\">\\\"begins\\\"</field>\\n  <value name=\\\"SPRITE\\\">\\n    <block type=\\\"gamelab_allSpritesWithAnimation\\\" id=\\\"t0W!3R@~{dtD4GL+tNly\\\">\\n      <field name=\\\"ANIMATION\\\">\\\"game_penguin\\\"</field>\\n    </block>\\n  </value>\\n  <value name=\\\"BEHAVIOR\\\">\\n    <block type=\\\"gamelab_behaviorPicker\\\" id=\\\"SBAfO|#Hj`n1jI^;75z~\\\">\\n      <field name=\\\"BEHAVIOR\\\">moving with arrow keys</field>\\n    </block>\\n  </value>\\n  <next>\\n    <block type=\\\"gamelab_toggleBehaviorSimple\\\" id=\\\"u6OH-GmCML0:d:9(YUPe\\\">\\n      <field name=\\\"TOGGLE\\\">\\\"begins\\\"</field>\\n      <value name=\\\"SPRITE\\\">\\n        <block type=\\\"gamelab_allSpritesWithAnimation\\\" id=\\\"yPUOOqo]MR]nFtaBmoB?\\\">\\n          <field name=\\\"ANIMATION\\\">\\\"game_fire\\\"</field>\\n        </block>\\n      </value>\\n      <value name=\\\"BEHAVIOR\\\">\\n        <block type=\\\"gamelab_behaviorPicker\\\" id=\\\"ZU)0G)!(/u)jY!_SXke^\\\">\\n          <field name=\\\"BEHAVIOR\\\">wandering</field>\\n        </block>\\n      </value>\\n    </block>\\n  </next>\\n</block>\\n</xml> \",\"hint_id\":\"hint2\",\"hint_type\":\"general\",\"hint_path\":\"\",\"hint_video\":\"\",\"tts_url\":\"https://tts.code.org/sharon22k/180/100/0e35803c64ea5e21a2fb62d51ba43041/game_design_two_behaviors.mp3\"}]",
    "short_instructions": "Make one sprite chase the other. Add `moving with arrow keys` behavior to a sprite.",
    "validation_code": "if (World.frameCount == 1) {\r\n  addCriteria(function() {\r\n    return minimumSprites(2); // Check whether or not the student created a sprite.\r\n  }, \"spritelabFeedbackCreateTwoDifferentSprites\");  // Failure message: \"You need two sprites with different costumes.\"\r\n\r\n  addCriteria(function() {\r\n    return minimumMatchingBehaviors(\"moving_with_arrow_keys\", 1); // Check if second sprite is moving with arrow keys\r\n  }, \"oneArrowKeysSprite\");  // Failure message: \"Make sure one sprite has the behavior that makes it move with your arrow keys.\"\r\n  \r\n  addCriteria(function() {\r\n    return isKeyPressed(\"up\") || isKeyPressed(\"down\") || isKeyPressed(\"left\") || isKeyPressed(\"right\");\r\n  }, \"didntPressKey\");  // Failure message: \"Make sure one sprite has the behavior that makes it move with your arrow keys.\"\r\n  \r\n}\r\ncheck();\r\n",
    "encrypted_examples": "JnBfsZlxvTe+uVUiIKuLIm+VUcBWhV6wtFpnQJqjtPVXUDDXSyXH//OxrgBA\nvVvOUHI4nPVb5s+bR+SdDSRllg==\n",
    "instructions_icon": "fox",
    "hint_prompt_attempts_threshold": "1",
    "callout_json": "[\r\n {\r\n  \"localization_key\": \"arrows\",\r\n  \"callout_text\": \"Move the sprite with the arrows!\",\r\n  \"element_id\": \"[id = \\\"soft-buttons\\\"]\",\r\n  \"on\": \"\",\r\n  \"qtip_config\": {\r\n   \"codeStudio\": {\r\n    \"canReappear\": false,\r\n    \"dropletPaletteCategory\": \"\"\r\n   },\r\n   \"style\": {\r\n    \"classes\": \"\"\r\n   },\r\n   \"position\": {\r\n    \"my\": \"left center\",\r\n    \"at\": \"right center\",\r\n    \"adjust\": {\r\n     \"x\": 0,\r\n     \"y\": 20\r\n    }\r\n   }\r\n  }\r\n }\r\n]",
