        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "# Caterpillar — original by Coach Alvarez\nfrom theater import *\n\nclear(\"#E8F5E9\")\n\n# Body segments, each with a bump on top\nfor j in range(7):\n    set_fill_color(\"lime\")\n    draw_ellipse(j * 42 + 30, 200, 44, 44)\n    set_fill_color(\"green\")\n    draw_ellipse(j * 42 + 40, 190, 8, 8)\n    pause(0.1)\n\n# Head and eye\nset_fill_color(\"red\")\ndraw_ellipse(320, 196, 52, 52)\nset_fill_color(\"black\")\ndraw_ellipse(340, 210, 8, 8)\nplay()",
