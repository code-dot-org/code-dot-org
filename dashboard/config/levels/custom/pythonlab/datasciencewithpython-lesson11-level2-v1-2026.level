    },
    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "import pandas as pd\nimport matplotlib.pyplot as plt\n\ndf = pd.read_csv('new_superhero_roster.csv')\n\n# Check whether each Alias ends with \"r\"\ncondition = df['Alias'].str.endswith('r')\n\n# Display the Boolean values\nprint(\"Boolean Condition:\")\nprint(condition)\n\n# Keep the rows where the condition is True\nfiltered_heroes = df[condition]\n\n# Display the filtered DataFrame\nprint(\"\\nFiltered Superheroes:\")\nprint(filtered_heroes)",
          "folderId": "0",
          "active": true,
          "open": true
        },
