          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 5.8\n# Standard Description: Explain bias-variance trade-off in a machine learning model.\n#\n# Rationale: This is one of the most fundamental concepts in AI performance. \n# - Bias: The model is too simple (it \"assumes\" too much and misses the pattern).\n# - Variance: The model is too sensitive (it \"memorizes\" the noise instead of the pattern).\n# This tutorial uses different \"degrees\" of a model to show this trade-off.\n\n\"\"\"\nWelcome! Have you ever seen a target at an archery range?\n- High Bias: You are always hitting the same spot, but it's the WRONG spot. \n  (The model is stubborn and too simple).\n- High Variance: Your arrows are all over the place. (The model is too sensitive \n  and random).\n\nThe \"Sweet Spot\" is right in the middle!\n\"\"\"\n\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom sklearn.pipeline import make_pipeline\nfrom sklearn.preprocessing import PolynomialFeatures\nfrom sklearn.linear_model import LinearRegression\n\n# --- GENERATE CURVY DATA ---\nnp.random.seed(0)\nX = np.sort(np.random.rand(20))\ny = np.cos(1.5 * np.pi * X) + np.random.randn(20) * 0.1\nX = X[:, np.newaxis]\n\n# --- DEGREES OF COMPLEXITY ---\ndegrees = [1, 4, 15] # 1 = Simple Line, 4 = Good Curve, 15 = Crazy Squiggle\n\nplt.figure(figsize=(14, 4))\nfor i, degree in enumerate(degrees):\n    ax = plt.subplot(1, 3, i + 1)\n    \n    # Create and fit the model\n    # A \"Polynomial\" model is just a linear model that can bend.\n    # Higher degree = more bending power!\n    pipeline = make_pipeline(PolynomialFeatures(degree), LinearRegression())\n    pipeline.fit(X, y)\n    \n    # Plot results\n    X_test = np.linspace(0, 1, 100)[:, np.newaxis]\n    plt.plot(X_test, pipeline.predict(X_test), label=\"Model\")\n    plt.scatter(X, y, edgecolor='b', s=20, label=\"Data\")\n    plt.title(f\"Degree {degree}\")\n    \n    if degree == 1:\n        plt.xlabel(\"High Bias\\n(Too Simple)\")\n    elif degree == 4:\n        plt.xlabel(\"Sweet Spot\\n(Just Right)\")\n    else:\n        plt.xlabel(\"High Variance\\n(Overfitting)\")\n\nplt.tight_layout()\nplt.show()\n\nprint(\"Degree 1: The model is a straight line. It's too simple to see the curve (High Bias).\")\nprint(\"Degree 15: The model squiggles to hit every single dot. It's memorizing noise (High Variance).\")\n\n\"\"\"\n--- YOUR TURN ---\nLook at the 'Degree 15' graph. \n1. If we added ONE new data point, would the model's prediction \n   change a little, or a LOT?\n2. Is 'High Variance' usually associated with Overfitting or Underfitting?\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\n# TODO: Answer the questions!\n# Change_Amount = \"___\"\n# Associated_With = \"___\"\n",
