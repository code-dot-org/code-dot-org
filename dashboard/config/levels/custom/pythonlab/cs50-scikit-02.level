          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 5.1\n# Standard Description: Identify supervised, unsupervised, reinforcement, and transfer learning types.\n#\n# Rationale: This tutorial focuses on the distinction between Supervised Learning (learning with labels) \n# and Unsupervised Learning (finding patterns in unlabeled data). By using a classifier vs. a \n# clustering algorithm on the same data, students see how the presence or absence of \"answers\" \n# changes the AI's task.\n\n\"\"\"\nWelcome back! Today we're looking at two different \"styles\" of learning:\n1. Supervised Learning: Like a student with a teacher who provides the correct answers.\n2. Unsupervised Learning: Like a detective trying to find groups or patterns without any clues.\n\nWe'll use scikit-learn to see both in action!\n\"\"\"\n\nfrom sklearn.datasets import make_blobs\nfrom sklearn.linear_model import LogisticRegression\nfrom sklearn.cluster import KMeans\nimport matplotlib.pyplot as plt\n\n# --- PREPARING OUR DATA ---\n# We'll create some \"blobs\" of data points.\n# X contains the coordinates (location) of the points.\n# y contains the \"true\" group each point belongs to (our labels).\nX, y = make_blobs(n_samples=300, centers=3, cluster_std=0.60, random_state=0)\n\n# --- PART 1: SUPERVISED LEARNING (Classification) ---\nprint(\"--- Part 1: Supervised Learning ---\")\n# In supervised learning, we give the AI the \"answers\" (y).\n# It learns to associate locations (X) with groups (y).\nsupervised_model = LogisticRegression()\nsupervised_model.fit(X, y) \n\n# --- PART 2: UNSUPERVISED LEARNING (Clustering) ---\nprint(\"--- Part 2: Unsupervised Learning ---\")\n# In unsupervised learning, we DON'T give the AI the answers.\n# It only sees the locations (X) and has to find patterns on its own.\nunsupervised_model = KMeans(n_clusters=3)\nunsupervised_model.fit(X) # Notice we ONLY pass X here, no 'y'!\nclusters = unsupervised_model.predict(X)\n\n# --- VISUALIZATION ---\nplt.figure(figsize=(12, 5))\n\n# Plot Supervised Results\nplt.subplot(1, 2, 1)\nplt.scatter(X[:, 0], X[:, 1], c=y, cmap='viridis', edgecolors='k')\nplt.title(\"Supervised Learning\\n(The AI was told the groups)\")\n\n# Plot Unsupervised Results\nplt.subplot(1, 2, 2)\nplt.scatter(X[:, 0], X[:, 1], c=clusters, cmap='plasma', edgecolors='k')\nplt.title(\"Unsupervised Learning\\n(The AI found these groups on its own)\")\n\nprint(\"Look at the graphs! One uses known labels, the other finds clusters.\")\nplt.show()\n\n\"\"\"\n--- YOUR TURN ---\nWe've set up a new dataset for you. Your job is to apply Unsupervised Learning \n(Clustering) to see if the AI can group these points.\n\n1. We've created 'X_mystery' for you.\n2. Create a KMeans model with n_clusters=2.\n3. Fit the model using ONLY X_mystery.\n4. Use plt.scatter to see what the AI found!\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\nX_mystery, _ = make_blobs(n_samples=200, centers=2, random_state=42)\n\n# TODO: Create a KMeans model with 2 clusters\n# TODO: Fit the model to X_mystery\n# TODO: Get the predictions (labels) using .predict(X_mystery)\n\n# We've provided the plotting code for you below!\n# plt.scatter(X_mystery[:, 0], X_mystery[:, 1], c=YOUR_PREDICTIONS_HERE)\n# plt.title(\"Mystery Clusters\")\n# plt.show()\n",
          "folderId": "0",
          "active": true
