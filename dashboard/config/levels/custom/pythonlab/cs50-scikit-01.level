      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 3.9\n# Standard Description: Explain the difference between classification and regression.\n#\n# Rationale: This tutorial introduces the two most common types of supervised learning.\n# By using scikit-learn to build both a classifier and a regressor, students can \n# see firsthand how the output type (categorical vs. continuous) determines the \n# nature of the machine learning task.\n\n\"\"\"\nWelcome! In this tutorial, we are going to explore two main ways machines \"learn\" \nfrom data: Classification and Regression.\n\nThink of it like this:\n- Classification is like sorting mail into boxes (Category A, Category B, Category C).\n- Regression is like guessing the price of a house or the temperature outside (A specific number).\n\nLet's see how scikit-learn handles both!\n\"\"\"\n\n# First, we import the tools we need\nfrom sklearn.datasets import load_iris, load_diabetes\nfrom sklearn.linear_model import LogisticRegression, LinearRegression\nimport numpy as np\nimport matplotlib.pyplot as plt\n\n# --- PART 1: CLASSIFICATION ---\n# Classification is used when we want to predict a LABEL or CATEGORY.\n\nprint(\"--- Part 1: Classification (Predicting Categories) ---\")\n\n# We'll use the famous \"Iris\" dataset. It contains measurements of flowers.\n# Our goal is to predict which SPECIES (category) the flower belongs to.\niris = load_iris()\n# To keep the graph simple, we will only use the first two features (Length/Width)\nX_class = iris.data[:, :2] \ny_class = iris.target\n\n# We create a \"Classifier\"\nclassifier = LogisticRegression(max_iter=200)\nclassifier.fit(X_class, y_class)\n\n# Visualization for Classification\nplt.figure(figsize=(10, 4))\nplt.subplot(1, 2, 1)\nplt.scatter(X_class[:, 0], X_class[:, 1], c=y_class, cmap='brg', edgecolors='k')\nplt.title(\"Classification: Sorting by Category\\n(Iris Species)\")\nplt.xlabel(\"Sepal Length\")\nplt.ylabel(\"Sepal Width\")\n\n# Let's make a prediction for a new flower\nnew_flower = [[5.1, 3.5]]\nprediction = classifier.predict(new_flower)\nspecies_name = iris.target_names[prediction][0]\n\nprint(f\"For measurements {new_flower}, the AI predicts the species is: {species_name}\")\n\n# --- PART 2: REGRESSION ---\n# Regression is used when we want to predict a CONTINUOUS NUMBER.\n\nprint(\"\\n--- Part 2: Regression (Predicting Numbers) ---\")\n\n# We'll use the \"Diabetes\" dataset. \ndiabetes = load_diabetes()\n# We will use just one feature (BMI) to see the relationship clearly on a graph\nX_reg = diabetes.data[:, np.newaxis, 2] \ny_reg = diabetes.target\n\n# We create a \"Regressor\"\nregressor = LinearRegression()\nregressor.fit(X_reg, y_reg)\n\n# Visualization for Regression\nplt.subplot(1, 2, 2)\nplt.scatter(X_reg, y_reg, color='gray', alpha=0.5)\nplt.plot(X_reg, regressor.predict(X_reg), color='red', linewidth=2)\nplt.title(\"Regression: Predicting a Number\\n(Disease Progression)\")\nplt.xlabel(\"BMI (scaled)\")\nplt.ylabel(\"Progression Score\")\n\nplt.tight_layout()\nprint(\"Look for the popup window to see the difference visually!\")\nplt.show()\n\n\"\"\"\n--- YOUR TURN ---\nNow it's your chance to try! We've started the code for you below.\n\nTask: Complete this fruit classifier (Apple vs. Orange) by creating the model \nand making the final prediction.\n\n1. We've provided the data (X_fruit) and labels (y_fruit).\n2. Create the LogisticRegression model.\n3. Use .fit() to train it.\n4. Predict the type of the 'unknown_fruit'.\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\nfrom sklearn.linear_model import LogisticRegression\n\n# X_fruit features: [Weight (grams), Texture (1=Smooth, 2=Rough)]\nX_fruit = [[140, 1], [155, 1], [180, 2], [195, 2]]\ny_fruit = [0, 0, 1, 1] # 0 = Apple, 1 = Orange\n\nunknown_fruit = [[160, 1.5]]\n\n# TODO: Create the model (name it 'fruit_model')\n# TODO: Fit the model to X_fruit and y_fruit\n# TODO: Predict for 'unknown_fruit' and print the result!\n",
          "folderId": "0",
          "active": true
        }
