    "validation_file": {
      "id": "2",
      "name": "test.py",
      "contents": "from unittest import TestCase\nfrom unittest_runner import ValidationProtocol\n\n\nclass TestModifyChecks(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Run the student's code once and save the results\"\"\"\n        cls.log = ValidationProtocol().get_neighborhood_log()\n        cls.stdout = ValidationProtocol().get_stdout_logs()\n        if not cls.log.painter_logs:\n            cls.painter = None\n        else:\n            cls.painter = cls.log.painter_logs[0]\n\n    def setUp(self):\n        if self.painter is None:\n            self.skipTest(\"Your code didn't run far enough to check yet. Make sure the starter code is still there and run again.\")\n\n    def test_enough_prints_exist(self):\n        \"\"\"You've printed ready_to_paint and needs_supplies both times\"\"\"\n        self.assertGreaterEqual(\n            len(self.stdout),\n            9,\n            \"Make sure you've printed ready_to_paint and needs_supplies both the first time and after moving back to the bucket.\"\n        )\n\n    def test_first_ready_to_paint_is_false(self):\n        \"\"\"The first ready_to_paint correctly says False\"\"\"\n        self.assertGreater(len(self.stdout), 5, \"Print ready_to_paint before checking needs_supplies.\")\n        self.assertIn(\n            \"False\",\n            self.stdout[5],\n            \"ready_to_paint should be False here -- the square is already painted.\"\n        )\n\n    def test_first_needs_supplies_is_true(self):\n        \"\"\"The first needs_supplies correctly says True\"\"\"\n        self.assertGreater(len(self.stdout), 6, \"Print needs_supplies right after ready_to_paint.\")\n        self.assertIn(\n            \"True\",\n            self.stdout[6],\n            \"needs_supplies should be True here -- the Painter is out of paint.\"\n        )\n\n    def test_painter_made_it_back_to_start(self):\n        \"\"\"Your painter made it back to where it started\"\"\"\n        self.assertEqual(\n            (self.painter.ending_position.x, self.painter.ending_position.y),\n            (self.painter.starting_position.x, self.painter.starting_position.y),\n            \"At the end of your program, the Painter should be back at the square it started on.\"\n        )\n\n    def test_painter_turned_around(self):\n        \"\"\"Your painter turned all the way around\"\"\"\n        opposite = {\"north\": \"south\", \"south\": \"north\", \"east\": \"west\", \"west\": \"east\"}\n        start_dir = self.painter.starting_position.direction.lower()\n        end_dir = self.painter.ending_position.direction.lower()\n        self.assertEqual(\n            end_dir,\n            opposite[start_dir],\n            \"By the end, your Painter should be facing the opposite direction from where it started.\"\n        )\n\n    def test_painter_picked_up_more_paint(self):\n        \"\"\"Your painter picked up more paint\"\"\"\n        self.assertGreaterEqual(\n            self.painter.ending_paint_count,\n            1,\n            \"By the end of your program, the Painter should have picked up more paint from the bucket.\"\n        )\n\n    def test_second_checks_show_updated_values(self):\n        \"\"\"ready_to_paint and needs_supplies flipped after moving back\"\"\"\n        self.assertGreaterEqual(\n            len(self.stdout),\n            9,\n            \"Make sure you've created and printed ready_to_paint and needs_supplies again after moving back to the bucket.\"\n        )\n        last_two = self.stdout[-2], self.stdout[-1]\n        self.assertTrue(\n            any(\"True\" in line for line in last_two) and any(\"False\" in line for line in last_two),\n            \"After moving back and taking more paint, one of your checks should now say True and the other should say False.\"\n        )",
      "folderId": "0",
      "active": false,
      "type": "validation"
    }
  },
