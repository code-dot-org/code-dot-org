        "0": {
          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "import pandas as pd\nimport matplotlib.pyplot as plt\n\n# Read the dataset\ndata = pd.read_csv('Titanic.csv')\n\n# Group passengers by class and survival status\nstacked_data = data.groupby(\n    ['Pclass', 'Survived']\n).size().unstack()\n\n# Create the stacked bar chart\nstacked_data.plot(kind='bar', stacked=True)\n\nplt.legend(title='Survived (0 = No, 1 = Yes)')\nplt.xticks(rotation=0)\nplt.xlabel('Passenger Class')\nplt.ylabel('Number of Passengers')\nplt.title('Passenger Survival by Class')\n\nplt.show()\n\n# Group passengers by survival status\n\n\n# Create the pie chart",
          "folderId": "0",
          "active": false,
          "open": true,
          "type": "locked_starter"
        },
