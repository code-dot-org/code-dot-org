          "name": "main.py",
          "contents": "from sklearn.linear_model import LinearRegression\n\n# Input features: [distance walked, price]\n# TODO 1: Add the remaining training data inputs\ninputs = [[5, 30]]\n\n# Output: weeks until shoes are worn out\n# TODO 2: Add the remaining training data outputs\noutputs = [40]\n\nmodel = LinearRegression()\n\n# TODO 3: Fit the model to the inputs and outputs\n\n# Make a prediction for a new pair of shoes\ndistance = int(input(\"Enter distance walked per week (in miles): \"))\nprice = int(input(\"Enter price of shoes (in dollars): \"))\nprediction = model.predict([[distance, price]])\n\nprint(\"Predicted weeks until shoes are worn out:\", round(prediction[0]))",
