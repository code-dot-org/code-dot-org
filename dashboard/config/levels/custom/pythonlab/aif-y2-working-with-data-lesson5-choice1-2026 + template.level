          "name": "main.py",
          "contents": "import csv\n \nfile_1 = open(\"athlete_1.csv\")\nreader_1 = csv.DictReader(file_1)\nathlete_1_times = []\nfor row in reader_1:\n    time = row[\"sprint_time\"]\n    athlete_1_times.append(time)\nfile_1.close()\n\nfile_2 = open(\"athlete_2.csv\")\nreader_2 = csv.DictReader(file_2)\nathlete_2_times = []\nfor row in reader_2:\n    time = row[\"sprint_time\"]\n    athlete_2_times.append(time)\nfile_2.close()\n\nprint(athlete_1_times)\nprint(athlete_2_times)",
