        "0": {
          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 5.7\n# Standard Description: Evaluate a prediction model where outcome of interest is a continuous variable.\n#\n# Rationale: When predicting a category (Cat vs. Dog), \"Accuracy\" is easy to \n# calculate (percentage correct). But when predicting a NUMBER (like Temperature), \n# there is no \"correct\" or \"incorrect\". Instead, we measure ERROR: \"How close \n# was I?\" This tutorial introduces MAE (Mean Absolute Error) and R^2 Score.\n\n\"\"\"\nWelcome! How do you grade an AI that guesses numbers?\nIf the answer is 70 and the AI guesses 71, is it wrong? Yes. \nBut is it as wrong as guessing 100? No!\n\nIn Regression, we measure DISTANCE from the truth.\n1. MAE (Mean Absolute Error): On average, how far off are we?\n2. R^2 Score: How well does our model explain the data (1.0 is perfect, 0.0 is bad).\n\"\"\"\n\nfrom sklearn.datasets import load_diabetes\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.linear_model import LinearRegression\nfrom sklearn.metrics import mean_absolute_error, r2_score\nimport matplotlib.pyplot as plt\n\n# --- LOAD DATA ---\ndiabetes = load_diabetes()\nX, y = diabetes.data, diabetes.target\n\nX_train, X_test, y_train, y_test = train_test_split(X, y, random_state=42)\n\n# --- PART 1: TRAINING ---\nprint(\"--- Part 1: Training the Model ---\")\nregressor = LinearRegression()\nregressor.fit(X_train, y_train)\n\n# --- PART 2: EVALUATION ---\nprint(\"--- Part 2: Evaluating the Model ---\")\n# First, we make predictions\ny_pred = regressor.predict(X_test)\n\n# Now we calculate the metrics\nmae = mean_absolute_error(y_test, y_pred)\nr2 = r2_score(y_test, y_pred)\n\nprint(f\"Mean Absolute Error (MAE): {mae:.2f}\")\nprint(f\"R^2 Score: {r2:.2f}\")\n\nprint(\"\\nInterpretation:\")\nprint(f\"On average, our prediction is off by about {mae:.2f} points.\")\nprint(f\"Our model explains {r2:.2%} of the variance in the data.\")\n\n# --- VISUALIZATION ---\nplt.figure(figsize=(6, 6))\nplt.scatter(y_test, y_pred, color='blue', alpha=0.5)\nplt.plot([y.min(), y.max()], [y.min(), y.max()], 'k--', lw=2) # Perfect prediction line\nplt.xlabel(\"True Values\")\nplt.ylabel(\"Predictions\")\nplt.title(\"True vs Predicted Values\\n(Points on the line are perfect!)\")\nplt.show()\n\n\"\"\"\n--- YOUR TURN ---\nWe've loaded a simple dataset of housing prices (california_housing).\n1. Train a LinearRegression model.\n2. Predict the prices for the test set.\n3. Calculate the MAE and R^2 score.\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\n# from sklearn.datasets import fetch_california_housing <-- This is broken\n\n# DAN NOTE: This section is \"faking\" the california housing dataset.\n# I downloaded it outside of PythonLab as a CSV and have re-uploaded it to this project\n# And then I create a new function for fetch_california_housing that fetches from the CSV instead of downloading\n# In theory, this could get patched somehow\nimport pandas as pd\nclass DataBunch:\n    def __init__(self, X, y):\n        self.data = X\n        self.target = y\n\ndef fetch_california_housing():\n  df = pd.read_csv(\"california_housing.csv\")\n  return DataBunch(df.drop(\"MedHouseVal\", axis=1).values, df[\"MedHouseVal\"].values)\n# </end Dan custom code>\n\n# Remaining code is same as original example\nhousing = fetch_california_housing()\nX_h, y_h = housing.data, housing.target\nX_train_h, X_test_h, y_train_h, y_test_h = train_test_split(X_h, y_h, random_state=42)\n\n# TODO: Train the model\n# model = ...\n\n# TODO: Predict\n# predictions = ...\n\n# TODO: Calculate MAE and R^2\n# mae = ...\n# r2 = ...\n\n# TODO: Print them!\n",
          "folderId": "0",
          "active": true
        },
