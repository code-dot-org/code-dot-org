        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "def decide(want_it, can_afford_it):\n  if want_it:\n    return \"Buy it\"\n  else:\n    return \"Skip it\"\n\n\ndef main():\n  want_it = True\n  can_afford_it = False\n  decision = decide(want_it, can_afford_it)\n  print(f\"You should: {decision}\")\n\n\nmain()\n",
