      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "import pandas as pd\nimport matplotlib.pyplot as plt\n\n# Read the dataset\ndata = pd.read_csv('Urban_Mythical_Creature_Sightings.csv')\n\n# Group the data by Region and count the rows in each group\nregion_counts = data.groupby('Region').size()\nprint(region_counts)\n\n# Create a pie chart\nplt.figure(figsize=(6, 6))\nplt.pie(\n    region_counts,\n    labels=region_counts.index,\n    autopct='%1.1f%%',\n    startangle=140\n)\nplt.title('Distribution of Sighting Records by Region')\n\n# Display the chart\nplt.show()",
          "folderId": "0",
          "active": true,
          "open": true
        },
