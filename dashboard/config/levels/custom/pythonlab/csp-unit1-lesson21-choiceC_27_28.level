        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "# Rainy Day — original by Priya Nair\nfrom theater import *\n\nclear(\"#6B7A8F\")\n\n# Cloud\nset_fill_color(\"silver\")\ndraw_ellipse(100, 60, 120, 70)\ndraw_ellipse(160, 40, 120, 80)\ndraw_ellipse(220, 60, 120, 70)\n\n# Raindrops falling on a diagonal\nset_fill_color(\"aqua\")\nremove_stroke_color()\nfor j in range(9):\n    draw_ellipse(j * 36 + 110, j * 25 + 140, 8, 20)\n    pause(0.1)\nplay()",
