      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "import csv\nimport statistics\n\nfile_1 = open(\"app_1.csv\")\nreader_1 = csv.DictReader(file_1)\napp_1_times = []\nfor row in reader_1:\n    time = float(row[\"delivery_time\"])\n    app_1_times.append(time)\nfile_1.close()\n\nfile_2 = open(\"app_2.csv\")\nreader_2 = csv.DictReader(file_2)\napp_2_times = []\nfor row in reader_2:\n    time = float(row[\"delivery_time\"])\n    app_2_times.append(time)\nfile_2.close()\n\napp_1_min = min(app_1_times)\napp_1_max = max(app_1_times)\napp_1_range = round(app_1_max - app_1_min, 2)\n\nprint(f\"App 1 min: {app_1_min}\")\nprint(f\"App 1 max: {app_1_max}\")\nprint(f\"App 1 range: {app_1_range}\")\n\n# TODO 1: Compute and print the mean value for App 1\n# TODO 2: Compute and print the standard deviation for App 1\n\napp_2_min = min(app_2_times)\napp_2_max = max(app_2_times)\napp_2_range = round(app_2_max - app_2_min, 2)\n\nprint(f\"App 2 min: {app_2_min}\")\nprint(f\"App 2 max: {app_2_max}\")\nprint(f\"App 2 range: {app_2_range}\")\n\n# TODO 3: Compute and print the mean value for App 2\n# TODO 4: Compute and print the standard deviation for App 2",
          "folderId": "0",
          "active": false
        },
