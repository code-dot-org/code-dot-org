      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "def decide(wants_people_around, wants_warm_weather):\n    if wants_people_around:\n        return \"A city\"\n    else:\n        return \"Somewhere far away\"\n\n\ndef main():\n    wants_people_around = True\n    wants_warm_weather = False\n    decision = decide(wants_people_around, wants_warm_weather)\n    print(f\"You should look for: {decision}\")\n\n\nmain()\n",
