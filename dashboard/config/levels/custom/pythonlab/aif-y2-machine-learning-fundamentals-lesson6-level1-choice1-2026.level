    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from helpers import visualize_model\n\ndef loss(actual, predicted):\n  # TODO: Write a loss function\n  return 0\n\n# First model\ndef predict_percent_made_1(practice_years):\n  return 4 * practice_years + 49\n\n# Second model\ndef predict_percent_made_2(practice_years):\n  return 6 * practice_years + 45\n\nvisualize_model(predict_percent_made_1, loss)",
          "folderId": "0",
          "active": true
        },
        "1": {
          "id": "1",
          "name": "helpers.py",
          "contents": "import matplotlib.pyplot as plt\n\n# Dataset: (years of practice, percent of penalty kicks made)\nDATA = [\n    (1, 52),\n    (2, 58),\n    (3, 61),\n    (4, 68),\n    (5, 71),\n    (6, 75),\n    (7, 79),\n    (8, 81),\n]\n\nX_LABEL = \"Years of practice\"\nY_LABEL = \"Penalty kicks made (%)\"\n\n\ndef _total_error(model, error):\n    \"\"\"Add up the student's loss function results across every data point.\"\"\"\n    total = 0\n    for x, actual in DATA:\n        predicted = model(x)\n        total += error(actual, predicted)\n    return total\n\n\ndef visualize_model(model, error):\n    \"\"\"Score the model with the student's loss function and draw the chart.\"\"\"\n    # Calculate loss\n    total_error = _total_error(model, error)\n\n    # Set up plot\n    fig, ax = plt.subplots()\n\n    # Plot data points\n    xs = [x for x, _ in DATA]\n    ys = [y for _, y in DATA]\n    ax.scatter(xs, ys, color=\"black\", zorder=3, label=\"Data\")\n\n    # Draw model's line\n    line_xs = [min(xs), max(xs)]\n    line_ys = [model(x) for x in line_xs]\n    ax.plot(\n        line_xs,\n        line_ys,\n        linestyle=\"-\",\n        color=\"#1f77b4\",\n        label=\"Model\",\n    )\n    ax.legend()\n\n    # Display the model's loss\n    ax.set_title(f\"Total loss: {total_error:.2f}\")\n\n    # Add labels, show plot\n    ax.set_xlabel(X_LABEL)\n    ax.set_ylabel(Y_LABEL)\n    plt.show()",
          "folderId": "0",
          "active": false,
          "type": "support"
        }
