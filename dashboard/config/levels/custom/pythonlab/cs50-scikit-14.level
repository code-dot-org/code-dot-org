          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 2.4\n# Standard Description: Describe the importance of dataset curation.\n#\n# Rationale: Curation is like being a museum curator. You don't just throw \n# things in a room; you organize, label, and clean them so they make sense. \n# Curating a dataset means making sure column names are clear, units are \n# consistent, and the data is \"balanced\" and fair.\n\n\"\"\"\nWelcome! Have you ever tried to read someone else's messy handwriting? \nIt's hard! AI also struggles with \"messy\" data. \n\nCuration is the art of polishing data. It involves:\n1. Renaming columns so they are easy to understand.\n2. Converting units (like changing inches to centimeters).\n3. Ensuring the data is organized in a logical way.\n\"\"\"\n\nimport pandas as pd\n\n# --- THE RAW (UNCURATED) DATA ---\n# This data is a mess! The column names are vague and the units are mixed.\nraw_data = {\n    'c1': ['apple', 'BANANA', 'cherry '], # Inconsistent capitalization and spaces\n    'val_x': [1.2, 0.5, 2.1],             # What does \"val_x\" mean?\n    'temp': [72, 25, 68]                   # Wait, is 25 hot or cold? (Mixed Fahrenheit/Celsius)\n}\ndf = pd.DataFrame(raw_data)\n\nprint(\"--- Raw Uncurated Data ---\")\nprint(df)\nprint(\"\\n\")\n\n# --- STEP 1: CLEAR LABELING ---\nprint(\"--- Step 1: Labeling ---\")\n# Let's rename columns to be descriptive.\ndf = df.rename(columns={'c1': 'Fruit_Name', 'val_x': 'Weight_Kg', 'temp': 'Temperature_F'})\nprint(df)\nprint(\"\\n\")\n\n# --- STEP 2: CONSISTENCY ---\nprint(\"--- Step 2: Ensuring Consistency ---\")\n# Fix the fruit names (lowercase and remove extra spaces)\ndf['Fruit_Name'] = df['Fruit_Name'].str.lower().str.strip()\n\n# Fix the temperature (the 25 was actually Celsius, let's convert to Fahrenheit)\n# Formula: (C * 9/5) + 32\ndf.loc[df['Temperature_F'] == 25, 'Temperature_F'] = (25 * 9/5) + 32\n\nprint(\"--- Final Curated Dataset ---\")\nprint(df)\nprint(\"\\n\")\nprint(\"Much better! Now a human AND an AI can understand this data.\")\n\n\"\"\"\n--- YOUR TURN ---\nWe have a tiny dataset of people's heights. \n1. The column 'h' is vague. Rename it to 'Height_Inches'.\n2. The name '   alex  ' has extra spaces. Use .str.strip() to fix it.\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\npeople = pd.DataFrame({\n    'n': ['   alex  ', 'sam', 'jo'],\n    'h': [65, 70, 62]\n})\n\n# TODO: Rename 'n' to 'Name' and 'h' to 'Height_Inches'\n# TODO: Strip the extra spaces from the 'Name' column\n\nprint(\"Clean and curate this data!\")\n",
          "folderId": "0",
