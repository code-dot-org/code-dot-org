          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 2.3\n# Standard Description: Describe dataset selection techniques and methods.\n#\n# Rationale: Just because you gathered data doesn't mean you should use ALL of it. \n# Dataset selection is the process of choosing the specific pieces of data \n# that are actually relevant to the problem you want to solve. This tutorial \n# uses pandas to filter out unnecessary information.\n\n\"\"\"\nWelcome! Imagine you have a giant toy box with 1,000 toys, but you only \nwant to play with \"Blue LEGOs\". You wouldn't dump the whole box on the floor; \nyou would SELECT just the ones you need.\n\nIn AI, we do the same thing. If we want to predict if it will rain, we don't \nneed to know what color the weather station is painted! We select the \nimportant parts.\n\"\"\"\n\nimport pandas as pd\n\n# --- OUR BIG DATASET ---\n# Let's imagine we have a dataset about Cars.\ndata = {\n    'Brand': ['Toyota', 'Ford', 'Tesla', 'Ford', 'Toyota', 'Tesla'],\n    'Color': ['Red', 'Blue', 'White', 'Black', 'Silver', 'Red'],\n    'Year': [2015, 2018, 2022, 2012, 2020, 2023],\n    'Type': ['Gas', 'Gas', 'Electric', 'Gas', 'Hybrid', 'Electric'],\n    'Price': [15000, 12000, 45000, 8000, 25000, 52000]\n}\ndf = pd.DataFrame(data)\n\nprint(\"--- The Full Dataset ---\")\nprint(df)\nprint(\"\\n\")\n\n# --- TECHNIQUE 1: SELECTING COLUMNS ---\nprint(\"--- Technique 1: Column Selection ---\")\n# If we only want to study prices, we don't need the 'Color' column.\n# We \"select\" only the columns we want to keep.\nuseful_cols = df[['Brand', 'Type', 'Price']]\nprint(\"Only keeping relevant columns:\")\nprint(useful_cols)\nprint(\"\\n\")\n\n# --- TECHNIQUE 2: SELECTING ROWS (FILTERING) ---\nprint(\"--- Technique 2: Row Selection (Filtering) ---\")\n# If we only care about Electric cars, we \"select\" only those rows.\nelectric_only = df[df['Type'] == 'Electric']\nprint(\"Only keeping Electric cars:\")\nprint(electric_only)\nprint(\"\\n\")\n\n# --- TECHNIQUE 3: COMBINED SELECTION ---\nprint(\"--- Technique 3: Precise Selection ---\")\n# We can select rows AND columns at the same time!\n# Let's find the Price of Ford cars only.\nford_prices = df.loc[df['Brand'] == 'Ford', ['Brand', 'Price']]\nprint(\"Finding just the Brand and Price for Ford cars:\")\nprint(ford_prices)\n\n\"\"\"\n--- YOUR TURN ---\nWe have a dataset of students. \nYour goal: Select only the students who scored HIGHER than 85.\n\n1. Create a filter to select rows where 'Score' > 85.\n2. Only show the 'Name' and 'Score' columns for those students.\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\nstudents = pd.DataFrame({\n    'Name': ['Alice', 'Bob', 'Charlie', 'David', 'Eva'],\n    'Score': [92, 78, 88, 70, 95],\n    'Grade': [10, 11, 10, 12, 9]\n})\n\n# TODO: Select rows where Score > 85\n# high_scores = ...\n\n# TODO: Print only Name and Score for those high-scoring students\n",
          "folderId": "0",
