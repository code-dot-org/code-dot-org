    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from neighborhood import *\n\nset_paint(14)\n\nfor garden_row in range(1):\n    for step in range(7):\n        move()\n        paint(\"yellow\")\n    turn_left()\n    turn_left()\n    turn_left()\n    move()\n    move()\n    turn_left()\n    turn_left()\n    turn_left()",
          "folderId": "0",
          "active": true
        }
