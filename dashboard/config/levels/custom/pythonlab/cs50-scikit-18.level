        "0": {
          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 2.9\n# Standard Description: Find and filter out missing or N/A data.\n#\n# Rationale: Before you can fix missing data, you have to FIND it. \n# This tutorial teaches students how to use pandas to scan a large dataset \n# for \"NaN\" (Not a Number) values and then decide whether to \"Filter\" \n# (remove) them or not.\n\n\"\"\"\nWelcome! Imagine you are a teacher grading tests, but some students \nleft their names blank or skipped entire pages. You can't just ignore \nthe empty spaces—you have to identify them and decide what to do.\n\nIn data science, we call this \"Finding and Filtering\". \nWe use the tool 'isna()' to find the gaps and 'dropna()' to filter them out.\n\"\"\"\n\nimport pandas as pd\nimport numpy as np\n\n# --- OUR BROKEN DATASET ---\n# Let's create a dataset of 10 runners. Some values are missing (np.nan).\ndata = {\n    'Runner_Name': ['Alice', 'Bob', 'Charlie', 'David', 'Eva', 'Frank', 'Grace', 'Hank', 'Ivy', 'Jack'],\n    'Time_Seconds': [120, np.nan, 145, 130, np.nan, 125, 140, np.nan, 135, 128],\n    'Heart_Rate': [160, 165, np.nan, 155, 170, 162, np.nan, 158, 163, 160]\n}\ndf = pd.DataFrame(data)\n\nprint(\"--- The Original Dataset ---\")\nprint(df)\nprint(\"\\n\")\n\n# --- STEP 1: FINDING THE GAPS ---\nprint(\"--- Step 1: Finding Missing Data ---\")\n# .isna() turns the table into True/False. True means a value is missing.\nmissing_map = df.isna()\nprint(\"Missing Value Map (True = Missing):\")\nprint(missing_map)\n\n# We can also get a count for each column\nprint(\"\\nCount of missing values per column:\")\nprint(df.isna().sum())\nprint(\"\\n\")\n\n# --- STEP 2: FILTERING (DROPPING) ---\nprint(\"--- Step 2: Filtering (Removing) Missing Data ---\")\n# Sometimes, if a row is missing too much info, we just delete it.\n# 'dropna()' removes any row that has at least one missing value.\nfiltered_df = df.dropna()\n\nprint(f\"Original rows: {len(df)}\")\nprint(f\"Filtered rows: {len(filtered_df)}\")\nprint(\"\\nCleaned Dataset (Only people with ALL information):\")\nprint(filtered_df)\n\n\"\"\"\n--- YOUR TURN ---\nWe have a dataset of weather reports.\n1. Use 'df_weather.isna().sum()' to find which column has the most missing data.\n2. Use 'df_weather.dropna(subset=[\"Temperature\"])' to ONLY remove rows \n   where Temperature is missing (keeping the rows where only Humidity is missing).\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\ndf_weather = pd.DataFrame({\n    'Day': ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'],\n    'Temperature': [72, np.nan, 68, np.nan, 75],\n    'Humidity': [40, 45, np.nan, 50, 42]\n})\n\n# TODO: Find the counts of missing values\n# TODO: Filter the data only for missing Temperatures\n# df_clean = ...\n\nprint(\"\\nFinal clean weather data:\")\n# print(df_clean)\n",
          "folderId": "0",
          "active": true
        }
