          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 2.8\n# Standard Description: Explain what data distribution shift is and its implications in production.\n#\n# Rationale: An AI is only as good as the data it was trained on. If the \n# real-world data (Production) looks different from the training data, the \n# AI will fail. This is called \"Distribution Shift\". This tutorial simulates \n# a shift in temperature data to show how it breaks a model.\n\n\"\"\"\nWelcome! Imagine you trained a robot to wear a coat when it's 30 degrees \nFahrenheit. Then, you move the robot to a desert where \"30\" actually means \nCelsius! The robot would be very confused.\n\nThis is \"Distribution Shift\". The \"shape\" of the data changed, and the AI \ndidn't know how to handle the new environment.\n\"\"\"\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nfrom sklearn.linear_model import LinearRegression\n\n# --- PART 1: TRAINING DATA (The \"Past\") ---\nprint(\"--- Part 1: Training the Model ---\")\n# Let's say we train a model to predict ice cream sales based on \n# temperatures between 60 and 80 degrees.\nnp.random.seed(42)\ntrain_temp = np.random.normal(70, 5, 100) # Average 70 degrees\ntrain_sales = train_temp * 2 + np.random.normal(0, 5, 100)\n\nmodel = LinearRegression()\nmodel.fit(train_temp.reshape(-1, 1), train_sales)\nprint(f\"Model trained on temperatures around {train_temp.mean():.1f} degrees.\")\n\n# --- PART 2: PRODUCTION DATA (The \"Future\" Shift) ---\nprint(\"\\n--- Part 2: Moving to Production (Data Shift!) ---\")\n# Suddenly, a heatwave hits! The temperatures shift to 90-110 degrees.\nprod_temp = np.random.normal(100, 5, 100) # Average 100 degrees\nprod_sales_real = prod_temp * 2 + np.random.normal(0, 5, 100)\n\n# The AI tries to predict in this new environment\nprod_preds = model.predict(prod_temp.reshape(-1, 1))\n\n# --- VISUALIZATION ---\nplt.figure(figsize=(10, 5))\n\n# Plot the Shift\nplt.hist(train_temp, alpha=0.5, label='Training Data (Normal)', color='blue')\nplt.hist(prod_temp, alpha=0.5, label='Production Data (Shifted)', color='red')\nplt.title(\"Visualizing Data Distribution Shift\")\nplt.xlabel(\"Temperature\")\nplt.ylabel(\"Frequency\")\nplt.legend()\nplt.show()\n\nprint(f\"Original Training Average: {train_temp.mean():.1f}\")\nprint(f\"New Production Average: {prod_temp.mean():.1f}\")\nprint(\"Implication: The AI is now making predictions for temperatures it has NEVER seen before!\")\n\n\"\"\"\n--- YOUR TURN ---\nWe've shifted the data for you. \n1. Calculate the 'Error' by subtracting prod_preds from prod_sales_real.\n2. Print the average error.\n3. Why is the error likely to be higher in the shifted production data \n   than it was during training?\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\n# TODO: Calculate how \"wrong\" the AI was in the new environment\n# errors = prod_sales_real - prod_preds\n# print(f\"Average Error in Production: {np.abs(errors).mean():.2f}\")\n",
          "folderId": "0",
