        "0": {
          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 3.11\n# Standard Description: Explain the k-means clustering algorithm starting values.\n#\n# Rationale: K-Means is a \"Greedy\" algorithm. It starts by picking random \n# locations (starting values) for the centers of its groups. But if it \n# picks \"bad\" starting spots, it might get stuck and find a poor solution! \n# This tutorial shows how different starting values lead to different results.\n\n\"\"\"\nWelcome! Imagine you and a friend are told to \"find the two biggest groups \nof people\" in a park. \n- You start at the north end.\n- Your friend starts at the south end.\n\nYou might end up finding different groups because of where you STARTED! \nThis is exactly what happens in K-Means clustering.\n\"\"\"\n\nimport matplotlib.pyplot as plt\nfrom sklearn.cluster import KMeans\nfrom sklearn.datasets import make_blobs\nimport numpy as np\n\n# --- PART 1: THE DATA ---\nX, y = make_blobs(n_samples=300, centers=4, cluster_std=0.60, random_state=0)\n\n# --- PART 2: COMPARING STARTING VALUES ---\nprint(\"--- Part 2: Running K-Means with different 'Starts' ---\")\n\n# Experiment 1: Good initialization (k-means++)\n# 'k-means++' is a smart way to pick starting values far apart from each other.\nmodel_smart = KMeans(n_clusters=4, init='k-means++', n_init=1, random_state=0)\nclusters_smart = model_smart.fit_predict(X)\n\n# Experiment 2: Bad initialization (Randomly picking points that might be too close)\n# We force it to use specific \"bad\" starting values\nbad_init = np.array([[0,0], [0.1,0.1], [0.2,0.2], [10,10]])\nmodel_bad = KMeans(n_clusters=4, init=bad_init, n_init=1)\nclusters_bad = model_bad.fit_predict(X)\n\n# --- VISUALIZATION ---\nplt.figure(figsize=(12, 5))\n\nplt.subplot(1, 2, 1)\nplt.scatter(X[:, 0], X[:, 1], c=clusters_smart, cmap='viridis', edgecolors='k')\nplt.scatter(model_smart.cluster_centers_[:, 0], model_smart.cluster_centers_[:, 1], s=200, c='red', marker='X')\nplt.title(\"Smart Start (k-means++)\\nFound 4 clear groups!\")\n\nplt.subplot(1, 2, 2)\nplt.scatter(X[:, 0], X[:, 1], c=clusters_bad, cmap='viridis', edgecolors='k')\nplt.scatter(model_bad.cluster_centers_[:, 0], model_bad.cluster_centers_[:, 1], s=200, c='red', marker='X')\nplt.title(\"Random/Bad Start\\nGot stuck with overlapping groups!\")\n\nplt.show()\n\nprint(\"The red X's are the 'Starting Values' (Centroids).\")\nprint(\"Notice how the bad start failed to separate the groups on the left correctly.\")\n\n\"\"\"\n--- YOUR TURN ---\nWe used 'n_init=1' to force the AI to only try ONCE. \nIn the real world, we usually set 'n_init=10'. \n\n1. What do you think 'n_init=10' does?\n2. If you try 10 different random starts, are you MORE or LESS likely \n   to find the best groups?\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\n# TODO: Experiment with n_init\n# my_model = KMeans(n_clusters=4, n_init=10)\n# my_model.fit(X)\n",
          "folderId": "0",
