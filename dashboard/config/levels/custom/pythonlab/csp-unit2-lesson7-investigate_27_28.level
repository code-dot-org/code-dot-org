          "name": "main.py",
          "contents": "from neighborhood import *\n\nprint(\"can_move():\", can_move())\nprint(\"has_paint():\", has_paint())\nmove()\ntake_paint()\nmove()\npaint(\"white\")\n\nready = can_move() and has_paint()\nprint(\"ready:\", ready)\n\non_something = is_on_bucket() or is_on_paint()\nprint(\"on_something:\", on_something)\nprint(\"not is_on_paint():\", not is_on_paint())",
