          "name": "main.py",
          "language": "py",
          "contents": "import pandas as pd\n\ndf = pd.read_csv('new_superhero_roster.csv')\n\ntotal_years_active = df[(df['Alias'].str.endswith('a')) | (df['City'].str.endswith('s'))]['YearsActive'].sum()\nprint(\"total_years_active:\\n\", total_years_active)\n",
