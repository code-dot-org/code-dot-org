          "name": "main.py",
          "contents": "from neighborhood import *\n\nset_paint(3)\n\nwhile can_move():\n    paint(\"blue\")\n    move()\n\nturn_left()\nturn_left()\nturn_left()\n\nwhile can_move():\n    paint(\"blue\")\n    move()",
