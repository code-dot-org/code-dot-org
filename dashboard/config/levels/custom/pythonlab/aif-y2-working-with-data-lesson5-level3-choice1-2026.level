      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "import csv\nimport statistics\n\nfile_1 = open(\"athlete_1.csv\")\nreader_1 = csv.DictReader(file_1)\nathlete_1_times = []\nfor row in reader_1:\n    time = float(row[\"sprint_time\"])\n    athlete_1_times.append(time)\nfile_1.close()\n\nfile_2 = open(\"athlete_2.csv\")\nreader_2 = csv.DictReader(file_2)\nathlete_2_times = []\nfor row in reader_2:\n    time = float(row[\"sprint_time\"])\n    athlete_2_times.append(time)\nfile_2.close()\n\nathlete_1_min = min(athlete_1_times)\nathlete_1_max = max(athlete_1_times)\nathlete_1_range = round(athlete_1_max - athlete_1_min, 2)\n\nprint(f\"Athlete 1 min: {athlete_1_min}\")\nprint(f\"Athlete 1 max: {athlete_1_max}\")\nprint(f\"Athlete 1 range: {athlete_1_range}\")\n\n# TODO 1: Compute and print the mean value for Athlete 1\n# TODO 2: Compute and print the standard deviation for Athlete 1\n\nathlete_2_min = min(athlete_2_times)\nathlete_2_max = max(athlete_2_times)\nathlete_2_range = round(athlete_2_max - athlete_2_min, 2)\n\nprint(f\"Athlete 2 min: {athlete_2_min}\")\nprint(f\"Athlete 2 max: {athlete_2_max}\")\nprint(f\"Athlete 2 range: {athlete_2_range}\")\n\n# TODO 3: Compute and print the mean value for Athlete 2\n# TODO 4: Compute and print the standard deviation for Athlete 2",
          "folderId": "0",
          "active": true
        },
