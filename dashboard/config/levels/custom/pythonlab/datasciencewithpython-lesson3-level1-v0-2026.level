        "0": {
          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "pet_type = \"dog\"\nhuman_years = [5, 7, 3, 2, 8]\nindex = 3\n\npet_years = human_years[index] * 7\n\nprint(\"The \"+ pet_type + \" is \" + str(human_years[index]) + \" human years old.\")\nprint(\"The \"+ pet_type + \" is \" + str(pet_years) + \" pet years old.\")\n",
