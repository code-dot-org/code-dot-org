    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from sklearn.linear_model import LinearRegression\nfrom sklearn.metrics import mean_squared_error\n\n# Input features: [win percentage, forecast temperature]\ninputs1  = [[30, 50], [55, 65], [70, 45], [90, 70], [25, 75]]\ninputs2 = [[40, 45], [60, 60], [35, 70], [85, 50], [75, 75]]\n\n# Output feature: game attendance\noutputs1 = [380, 560, 610, 780, 400]\noutputs2 = [350, 560, 640, 480, 760]\n\n# First model\nmodel1 = LinearRegression()\nmodel1.fit(inputs1, outputs1)\n\n# Second model\nmodel2 = LinearRegression()\nmodel2.fit(inputs2, outputs2)\n\n# Test data\ntest_inputs = [[85, 40], [30, 72], [95, 38], [45, 68], [65, 55]]\ntest_outputs = [360, 650, 350, 640, 510]\n\npredictions1 = model1.predict(test_inputs)\n# TODO 1: Have model 2 predict outputs for each of the test inputs\n\n# TODO 2: Calculate mean squared error for each model\n# TODO 3: Print the mean squared error for each model",
