c\nxkF8Y19hfqNZRfFy7Q4fJ+JOBht/kcbzHmox3qVlOoSxQHU8yulZjVtjVjt/\nBy5oAj3sDaUFjpl5dlLjwl9XJYv4UJKH93ffcKcd3RTlH81YqdiFy+5ov1hw\nGi7liHk4bYNghRWKdDAjxrPsM16mkg==\n",
    "display_name": "No Pets, No Problem?",
    "bubble_choice_description": "Figure out what kind of error is crashing this program, then fix it.",
    "teacher_markdown": "The crash only shows up for one specific input — `num_pets = 0` — so a student with at least one pet won’t hit it on a first run and may assume the program works fine. \r\n\r\nPrompt them to try `0` for pets if they haven’t already, framing it as “what if a classmate who doesn’t have any pets ran this?” rather than asking them to search for an edge case abstractly. \r\n\r\nIf students struggle to name the error type, point them back to Level 2's runtime-error crash from earlier in this lesson as a reference point.",
    "thumbnail_url": "https://images.code.org/c5b8fb188cd27fd150ea616b9bd5591a-pet-food.png",
    "validation_file": {
      "id": "1",
      "name": "test.py",
      "contents": "import contextlib\nimport io\nfrom unittest import TestCase\nfrom unittest.mock import patch\n\n\nclass TestDebugPetFoodCost(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Read the student's source once; each test execs it fresh with\n        mocked input() so the zero-pets case and a normal case run independently.\"\"\"\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n\n    def _run_with_inputs(self, num_pets_input, food_cost_input):\n        namespace = {}\n        stdout = io.StringIO()\n        with patch(\"builtins.input\", side_effect=[num_pets_input, food_cost_input]), contextlib.redirect_stdout(stdout):\n            exec(compile(self.source, \"main.py\", \"exec\"), namespace)\n        return stdout.getvalue()\n\n    def test_handles_zero_pets_without_crashing(self):\n        \"\"\"Doesn't crash when the number of pets is 0\"\"\"\n        try:\n            output = self._run_with_inputs(\"0\", \"30\")\n        except ZeroDivisionError:\n            self.fail(\n                \"Your program crashed with a divide-by-zero error when num_pets is 0. \"\n                \"Add a check before dividing: if num_pets is 0, there's no per-pet cost to calculate.\"\n            )\n        except Exception as e:\n            self.fail(f\"Your program raised an error with 0 pets: {e}\")\n        self.assertNotIn(\n            \"Cost per pet:\",\n            output,\n            \"With 0 pets, your program shouldn't try to print a cost per pet -- there isn't one to calculate. \"\n            \"Make sure that line only runs when num_pets is greater than 0.\"\n        )\n\n    def test_calculates_cost_per_pet_normally(self):\n        \"\"\"Calculates the correct cost per pet when there's at least one pet\"\"\"\n        try:\n            output = self._run_with_inputs(\"3\", \"30\")\n        except Exception as e:\n            self.fail(f\"Your program raised an error with a normal input: {e}\")\n        self.assertIn(\n            \"Cost per pet: 10.0\",\n            output,\n            f\"With 3 pets and $30 total food cost, expected to see 'Cost per pet: 10.0' -- but got: {output.strip()}\"\n        )",
      "folderId": "0",
      "active": false,
      "type": "validation"
    }
  },
