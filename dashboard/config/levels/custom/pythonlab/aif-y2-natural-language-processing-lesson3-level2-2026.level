          "id": "0",
          "name": "main.py",
          "contents": "import re\n\nentries = [\n  \"Volcanoes\",\n  \"The Volcano Book\",\n  \"volcanoes of the world.\",\n  \"VOLCANOES!\",\n  \"Volcanic Eruptions\",\n  \"volcano book\",\n  \"Volcanoes of the World\",\n  \"volcanoes\",\n  \"VOLCANOES OF THE WORLD\",\n]\n\nSTOP_WORDS = [\"a\", \"an\", \"the\", \"of\", \"and\", \"in\", \"to\"]\n\n\ndef normalize(text):\n  text = text.lower()\n\n  # TODO: Tokenize and remove punctuation\n  \n  return text\n\n\n# Count unique entries\nuniques = []\nfor entry in entries:\n  form = normalize(entry)\n  if form not in uniques:\n    uniques.append(form)\n\nprint(\"Entries:\", len(entries))\nprint(\"Unique entries:\", len(uniques))",
