    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from theater import *\n\nprint(\"PLAN YOUR PERFECT THEME PARK DAY\")\nname = input(\"What's your name? \")\n\n# ----- questions -----\nprint(\"\")\nprint(\"Q1: How wild do you want your rides?\")\nprint(\"  1 = gentle\")\nprint(\"  2 = a few thrills\")\nprint(\"  3 = as wild as it gets\")\nthrill = input(\"Type 1, 2, or 3: \")\nwhile thrill != \"1\" and thrill != \"2\" and thrill != \"3\":\n    print(\"Please type 1 (gentle), 2 (a few thrills), or 3 (wild).\")\n    thrill = input(\"Type 1, 2, or 3: \")\nthrill = int(thrill)\n\nprint(\"\")\nprint(\"Q2: Are you okay getting wet?\")\nprint(\"  1 = soak me\")\nprint(\"  2 = keep me dry\")\nwet = input(\"Type 1 or 2: \")\nwhile wet != \"1\" and wet != \"2\":\n    print(\"Please type 1 (soak me) or 2 (keep me dry).\")\n    wet = input(\"Type 1 or 2: \")\nwet = int(wet)\n\nprint(\"\")\nprint(\"Q3: Who is coming with you?\")\nprint(\"  1 = little kids\")\nprint(\"  2 = teens and adults only\")\ngroup = input(\"Type 1 or 2: \")\nwhile group != \"1\" and group != \"2\":\n    print(\"Please type 1 (little kids) or 2 (teens and adults only).\")\n    group = input(\"Type 1 or 2: \")\ngroup = int(group)\n\nprint(\"\")\nprint(\"Q4: How many hours will you be at the park?\")\nhours_text = input(\"Type a whole number of hours (like 6): \")\nwhile not hours_text.isdigit():\n    print(\"Please type a whole number, like 6 (no letters or decimals).\")\n    hours_text = input(\"Type a whole number of hours (like 6): \")\nhours = int(hours_text)\n\n# ----- build the five stops -----\n\n# stop 1: a big coaster needs thrills AND enough hours for the line\nif thrill >= 2:\n    if hours >= 6:\n        stop1 = \"Thunderbolt Coaster\"\n        caption1 = \"Big thrills, and you have time for the line.\"\n    else:\n        stop1 = \"Canyon Coaster\"\n        caption1 = \"Fast turns with a shorter line.\"\nelse:\n    stop1 = \"Moonlight Carousel\"\n    caption1 = \"An easygoing start, just your style.\"\n\n# stop 2: rapids need wet AND thrills; wet but gentle gets the lazy river\nif wet == 1 and thrill >= 2:\n    stop2 = \"Jungle Rapids\"\n    caption2 = \"You said yes to getting soaked!\"\nelif wet == 1:\n    stop2 = \"Lazy River\"\n    caption2 = \"Float and cool off, no drops.\"\nelse:\n    stop2 = \"Enchanted Maze\"\n    caption2 = \"All the adventure. None of the splash.\"\n\n# stop 3: a quick snack if you are short on time OR have little kids\nif hours <= 4 or group == 1:\n    stop3 = \"Snack Stand Tacos\"\n    caption3 = \"A quick bite, then back to the fun.\"\nelse:\n    stop3 = \"Adventure Cafe\"\n    caption3 = \"Sit down, relax, and enjoy lunch.\"\n\n# stop 4: the biggest ride needs (wild OR wet) AND a long day\nif (thrill == 3 or wet == 1) and hours >= 7:\n    stop4 = \"Volcano Falls\"\n    caption4 = \"A big drop with an even bigger splash.\"\nelif thrill >= 2:\n    stop4 = \"Sky Drop\"\n    caption4 = \"One tall tower, one fast fall.\"\nelse:\n    stop4 = \"Park Railway\"\n    caption4 = \"Take the scenic route around the park.\"\n\n# stop 5: the parade is late, so a short day OR little kids means games\nif hours < 6 or group == 1:\n    stop5 = \"Midway Games\"\n    caption5 = \"One last chance to win bragging rights.\"\nelse:\n    stop5 = \"Main Street Parade\"\n    caption5 = \"A colorful show to close out your day.\"\n\n# override A: little kids can't ride the big coasters, no matter the thrill level\nif group == 1:\n    if stop1 == \"Thunderbolt Coaster\" or stop1 == \"Canyon Coaster\":\n        stop1 = \"Moonlight Carousel\"\n        caption1 = \"Little riders first: a gentle start.\"\n    if stop4 == \"Volcano Falls\" or stop4 == \"Sky Drop\":\n        stop4 = \"Park Railway\"\n        caption4 = \"Everyone can ride the railway.\"\n\n# override B: under 3 hours, skip the sit-down meal and end early\nif hours < 3:\n    if stop3 != \"Snack Stand Tacos\":\n        stop3 = \"Snack Stand Tacos\"\n        caption3 = \"No time to sit. Grab and go.\"\n    stop5 = \"Souvenir Stop\"\n    caption5 = \"Short visit, but you leave with a memory.\"\n\nprint(\"\")\nprint(name + \"'s FIVE-STOP ITINERARY\")\nprint(\"1. \" + stop1)\nprint(\"2. \" + stop2)\nprint(\"3. \" + stop3)\nprint(\"4. \" + stop4)\nprint(\"5. \" + stop5)\nprint(\"Check the Theater for your tickets!\")\n\n# ============================================================\n# THEATER: one slide per stop, then a keepsake ticket.\n# The loop below only draws. All five stops were decided above.\n# ============================================================\nfor stop in range(1, 6):\n    # look up which stop we are drawing (display only)\n    if stop == 1:\n        heading = \"START THE ADVENTURE\"\n        activity = stop1\n        caption = caption1\n    elif stop == 2:\n        heading = \"KEEP EXPLORING\"\n        activity = stop2\n        caption = caption2\n    elif stop == 3:\n        heading = \"TIME TO REFUEL\"\n        activity = stop3\n        caption = caption3\n    elif stop == 4:\n        heading = \"ONE MORE ADVENTURE\"\n        activity = stop4\n        caption = caption4\n    else:\n        heading = \"THE GRAND FINALE\"\n        activity = stop5\n        caption = caption5\n\n    # sky, sun, and grass\n    clear(\"#DFF6FF\")\n    remove_stroke_color()\n    set_fill_color(\"#FFD166\")\n    draw_ellipse(326, 16, 48, 48)\n    set_fill_color(\"#B7DEC2\")\n    draw_rectangle(0, 310, 400, 90)\n\n    # carnival flags along the top\n    for flag in range(10):\n        if flag % 2 == 0:\n            set_fill_color(\"#EF6474\")\n        else:\n            set_fill_color(\"#087F8C\")\n        x = flag * 40\n        draw_shape([x, 0, x + 36, 0, x + 18, 23], True)\n\n    # ticket card with shadow and side notches\n    set_fill_color(\"#A7CED4\")\n    draw_rectangle(26, 49, 356, 267)\n    set_fill_color(\"#FFF9EA\")\n    draw_rectangle(22, 45, 356, 267)\n    set_fill_color(\"#DFF6FF\")\n    draw_ellipse(12, 168, 20, 20)\n    draw_ellipse(368, 168, 20, 20)\n\n    set_text_style(\"sans\", \"bold\")\n    set_text_color(\"#087F8C\")\n    set_text_height(13)\n    draw_text(\"ADVENTURE PARK / STOP \" + str(stop), 44, 72)\n    set_text_color(\"#173B50\")\n    set_text_height(17)\n    draw_text(heading, 44, 100)\n\n    # a different illustration for each slide\n    if stop == 1:\n        if activity == \"Moonlight Carousel\":\n            # carousel: roof, poles, and horses\n            set_fill_color(\"#EF6474\")\n            draw_shape([128, 150, 200, 110, 272, 150], True)\n            set_fill_color(\"#FFD166\")\n            draw_rectangle(136, 150, 128, 10)\n            set_stroke_color(\"#173B50\")\n            set_stroke_width(3)\n            draw_line(152, 160, 152, 210)\n            draw_line(200, 160, 200, 210)\n            draw_line(248, 160, 248, 210)\n            remove_stroke_color()\n            set_fill_color(\"#087F8C\")\n            draw_ellipse(140, 178, 26, 16)\n            draw_ellipse(188, 184, 26, 16)\n            draw_ellipse(236, 178, 26, 16)\n            set_fill_color(\"#173B50\")\n            draw_rectangle(128, 210, 144, 8)\n        else:\n            # coaster: a track with a hill and a car\n            set_stroke_color(\"#087F8C\")\n            set_stroke_width(5)\n            draw_line(120, 210, 165, 125)\n            draw_line(165, 125, 210, 210)\n            draw_line(210, 210, 245, 150)\n            draw_line(245, 150, 280, 210)\n            remove_stroke_color()\n            set_fill_color(\"#EF6474\")\n            draw_rectangle(152, 118, 28, 14)\n            set_fill_color(\"#173B50\")\n            draw_ellipse(154, 130, 8, 8)\n            draw_ellipse(170, 130, 8, 8)\n\n    elif stop == 2:\n        if wet == 1:\n            # raft floating on waves\n            set_fill_color(\"#66C5DF\")\n            for wave in range(5):\n                draw_ellipse(110 + wave * 34, 185, 44, 25)\n            set_fill_color(\"#C5854B\")\n            draw_rectangle(146, 157, 108, 24)\n            set_fill_color(\"#FFD166\")\n            draw_ellipse(170, 133, 60, 28)\n        else:\n            # hedge maze\n            set_stroke_color(\"#378260\")\n            set_stroke_width(10)\n            draw_line(139, 211, 139, 130)\n            draw_line(139, 130, 261, 130)\n            draw_line(261, 130, 261, 211)\n            draw_line(165, 211, 261, 211)\n            draw_line(165, 211, 165, 156)\n            draw_line(165, 156, 233, 156)\n            draw_line(233, 156, 233, 183)\n            remove_stroke_color()\n\n    elif stop == 3:\n        # striped food stand\n        set_fill_color(\"#FFD166\")\n        draw_rectangle(147, 147, 106, 67)\n        set_fill_color(\"#173B50\")\n        draw_rectangle(164, 157, 72, 30)\n        for stripe in range(6):\n            if stripe % 2 == 0:\n                set_fill_color(\"#EF6474\")\n            else:\n                set_fill_color(\"#FFF9EA\")\n            draw_rectangle(134 + stripe * 22, 130, 22, 25)\n        set_fill_color(\"#087F8C\")\n        draw_rectangle(139, 208, 122, 10)\n\n    elif stop == 4:\n        if activity == \"Park Railway\":\n            # railway car\n            set_stroke_color(\"#173B50\")\n            set_stroke_width(3)\n            draw_line(119, 215, 280, 215)\n            remove_stroke_color()\n            set_fill_color(\"#EF6474\")\n            draw_rectangle(139, 153, 124, 47)\n            set_fill_color(\"#087F8C\")\n            draw_rectangle(133, 143, 136, 10)\n            set_fill_color(\"#DFF6FF\")\n            for window in range(3):\n                draw_rectangle(150 + window * 36, 160, 24, 21)\n            set_fill_color(\"#173B50\")\n            draw_ellipse(152, 190, 24, 24)\n            draw_ellipse(226, 190, 24, 24)\n        else:\n            # a tall tower with a splash at the bottom\n            set_fill_color(\"#173B50\")\n            draw_rectangle(192, 110, 16, 100)\n            set_fill_color(\"#EF6474\")\n            draw_rectangle(176, 120, 48, 18)\n            set_fill_color(\"#66C5DF\")\n            draw_ellipse(150, 200, 100, 24)\n            for drop in range(4):\n                draw_ellipse(160 + drop * 24, 178, 10, 16)\n\n    else:\n        if activity == \"Souvenir Stop\":\n            # a shopping bag\n            set_fill_color(\"#EF6474\")\n            draw_rectangle(160, 150, 80, 64)\n            set_stroke_color(\"#173B50\")\n            set_stroke_width(4)\n            draw_line(178, 150, 186, 128)\n            draw_line(222, 150, 214, 128)\n            draw_line(186, 128, 214, 128)\n            remove_stroke_color()\n            set_fill_color(\"#FFD166\")\n            draw_regular_polygon(200, 182, 5, 16)\n        else:\n            # carnival tent\n            set_fill_color(\"#FFD166\")\n            draw_rectangle(140, 163, 120, 52)\n            set_fill_color(\"#EF6474\")\n            draw_shape([128, 163, 200, 119, 272, 163], True)\n            set_fill_color(\"#173B50\")\n            draw_rectangle(186, 179, 28, 36)\n            set_stroke_color(\"#173B50\")\n            set_stroke_width(2)\n            draw_line(200, 119, 200, 102)\n            remove_stroke_color()\n            set_fill_color(\"#087F8C\")\n            draw_shape([200, 102, 222, 109, 200, 116], True)\n\n    # the chosen activity and a short reason\n    set_text_style(\"sans\", \"bold\")\n    set_text_color(\"#173B50\")\n    set_text_height(22)\n    draw_text(activity, 44, 257)\n    set_text_style(\"sans\", \"normal\")\n    set_text_height(13)\n    draw_text(caption, 44, 284)\n\n    # five route markers fill as the day unfolds\n    for marker in range(1, 6):\n        remove_stroke_color()\n        if marker <= stop:\n            set_fill_color(\"#087F8C\")\n        else:\n            set_fill_color(\"#FFFFFF\")\n        draw_ellipse(47 + (marker - 1) * 65, 329, 26, 26)\n        if marker <= stop:\n            set_text_color(\"#FFFFFF\")\n        else:\n            set_text_color(\"#173B50\")\n        set_text_style(\"sans\", \"bold\")\n        set_text_height(14)\n        draw_text(str(marker), 56 + (marker - 1) * 65, 348)\n\n    # a little cart travels to this stop\n    for frame in range(6):\n        remove_stroke_color()\n        set_fill_color(\"#B7DEC2\")\n        draw_rectangle(0, 362, 400, 38)\n        cart_x = 15 + (stop - 1) * 65 + frame * 6\n        set_fill_color(\"#EF6474\")\n        draw_rectangle(cart_x, 366, 30, 15)\n        set_fill_color(\"#173B50\")\n        draw_ellipse(cart_x + 3, 378, 8, 8)\n        draw_ellipse(cart_x + 20, 378, 8, 8)\n        pause(0.12)\n\n    pause(3)\n\n# keepsake ticket with the whole day\nclear(\"#087F8C\")\nremove_stroke_color()\nset_fill_color(\"#FFF9EA\")\ndraw_rectangle(24, 35, 352, 330)\nset_fill_color(\"#FFD166\")\ndraw_rectangle(24, 35, 352, 65)\nset_text_style(\"sans\", \"bold\")\nset_text_color(\"#173B50\")\nset_text_height(23)\ndraw_text(name.upper() + \"'S PARK DAY\", 39, 77)\nset_text_height(17)\ndraw_text(\"1. \" + stop1, 44, 139)\ndraw_text(\"2. \" + stop2, 44, 179)\ndraw_text(\"3. \" + stop3, 44, 219)\ndraw_text(\"4. \" + stop4, 44, 259)\ndraw_text(\"5. \" + stop5, 44, 299)\nset_text_style(\"sans\", \"normal\")\nset_text_height(12)\ndraw_text(str(hours) + \" hours. Your choices. Your adventure.\", 44, 343)\nplay()\n\n# ============================================================\n# MY NOTES\n# ============================================================\n# WHY SHORT LIST: A park day is a whole itinerary, not one pick.\n# Five stops means the user actually gets a plan they can follow.\n#\n# WHY MY OVERRIDES BEAT THE STOP RULES: Override A: a group with\n# little kids can't ride the big coasters, even if the person\n# answering wants wild. Height limits are a safety rule, so they\n# beat the thrill answer instead of just lowering it. Override B:\n# under 3 hours there's no time for a sit-down meal or the late\n# parade, so the day gets cut down no matter what else was answered.\n#\n# WHY MY COMPOUNDS NEED EVERY PART: Jungle Rapids needs wet AND\n# thrills; drop either and the rapids are the wrong pick (lazy river\n# or maze instead). Volcano Falls is (wild OR wet) AND 7+ hours: the\n# OR is there because either kind of rider would love it, the AND is\n# there because its line eats a short day. Snack Stand is hours <= 4\n# OR little kids: either one alone is enough reason to eat fast.\n#\n# WHY A NUMBER FOR HOURS: so I could use <, <=, and >= with real\n# thresholds (3, 4, 6, 7) and test the edges.\n#\n# TESTED PATHS (thrill/wet/group/hours -> stops 1-5):\n#   3/1/2/8 -> Thunderbolt, Rapids, Cafe, Volcano Falls, Parade\n#   3/1/2/5 -> Canyon, Rapids, Cafe, Sky Drop, Games   (hours < 6, < 7)\n#   2/2/2/6 -> Thunderbolt, Maze, Cafe, Sky Drop, Parade (exactly 6)\n#   1/1/2/8 -> Carousel, Lazy River, Cafe, Volcano Falls, Parade\n#   1/2/2/8 -> Carousel, Maze, Cafe, Railway, Parade\n#   3/1/1/8 -> Carousel, Rapids, Tacos, Railway, Games  (Override A)\n#   2/2/2/4 -> Canyon, Maze, Tacos, Sky Drop, Games     (hours <= 4)\n#   3/1/2/2 -> Canyon, Rapids, Tacos, Sky Drop, Souvenir (Override B)\n#   3/1/2/7 -> Thunderbolt, Rapids, Cafe, Volcano Falls, Parade (exactly 7)\n#\n# AI TUTOR EDGE CASE: \"wild, soak me, little kids, 8 hours.\"\n# I traced it: stop 1 is Thunderbolt and stop 4 is Volcano Falls,\n# then Override A turns both into Carousel and Railway. I ACCEPTED\n# that; it's what I wanted. AI also flagged that Rapids stays on the\n# list for little kids. I REJECTED changing it, because the rapids\n# are a family raft ride with no height limit.",
          "folderId": "0",
          "active": true
        }
      },
