          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standards: 3.7 (Search Algorithms) & 3.13 (Informed vs Uninformed Search)\n# Standard Descriptions:\n#   3.7: Explain search algorithms and operators commonly used in AI.\n#   3.13: Identify the differences between informed and uninformed search techniques.\n#\n# Rationale: Training a model is only half the battle. Often, we need to \"tune\" \n# the settings (hyperparameters) to get the best performance. This tutorial \n# introduces GridSearchCV, which performs a systematic search to find the \n# optimal configuration.\n\n\"\"\"\nWelcome! Imagine you are baking a cake. You have a recipe, but you don't know \nthe perfect temperature or baking time. You could guess... or you could try \nevery combination!\n\nIn AI, this is called \"Hyperparameter Tuning\". We test many different settings \nto find the one that gives the best result.\n\"\"\"\n\nfrom sklearn.datasets import load_iris\nfrom sklearn.model_selection import train_test_split, GridSearchCV\nfrom sklearn.neighbors import KNeighborsClassifier\nimport matplotlib.pyplot as plt\n\n# --- LOAD DATA ---\niris = load_iris()\nX, y = iris.data, iris.target\n\nX_train, X_test, y_train, y_test = train_test_split(X, y, random_state=42)\n\n# --- PART 1: GUESSING ---\nprint(\"--- Part 1: Guessing Parameters ---\")\n# Let's try k=5 neighbors. Is it the best? Who knows!\nknn = KNeighborsClassifier(n_neighbors=5)\nknn.fit(X_train, y_train)\nscore = knn.score(X_test, y_test)\nprint(f\"Accuracy with k=5: {score:.2%}\")\n\n# --- PART 2: GRID SEARCH (Systematic Search) ---\nprint(\"--- Part 2: Grid Search ---\")\n# Instead of guessing, we define a \"grid\" of options.\n# We want to test 'n_neighbors' from 1 to 30.\n# We also want to test 'weights': 'uniform' vs 'distance'.\nparam_grid = {\n    'n_neighbors': list(range(1, 31)),\n    'weights': ['uniform', 'distance']\n}\n\n# We create a GridSearchCV object.\n# It will train a model for EVERY combination in the grid!\n# cv=5 means it uses 5-fold cross-validation for each setting.\ngrid_search = GridSearchCV(KNeighborsClassifier(), param_grid, cv=5)\n\nprint(\"Searching for the best parameters... (this might take a second)\")\ngrid_search.fit(X_train, y_train)\n\n# --- RESULTS ---\nprint(f\"\\nBest Parameters Found: {grid_search.best_params_}\")\nprint(f\"Best Cross-Validation Score: {grid_search.best_score_:.2%}\")\n\n# We can even use the best model directly to predict!\nbest_model = grid_search.best_estimator_\ntest_score = best_model.score(X_test, y_test)\nprint(f\"Test Set Accuracy with Best Model: {test_score:.2%}\")\n\n\"\"\"\n--- YOUR TURN ---\nWe've set up a Support Vector Machine (SVC) for you. \nSVCs have a parameter called 'C' (Regularization) and 'kernel' (Shape of boundary).\n\n1. Create a parameter grid for 'C': [0.1, 1, 10, 100]\n2. Create a parameter grid for 'kernel': ['linear', 'rbf']\n3. Run a GridSearchCV to find the best combination.\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\nfrom sklearn.svm import SVC\n\n# TODO: Define the parameter grid\n# param_grid_svc = { ... }\n\n# TODO: Create GridSearchCV with SVC() and your grid\n# grid_svc = ...\n\n# TODO: Fit the grid search to X_train and y_train\n# grid_svc.fit(...)\n\n# TODO: Print the best parameters!\n",
          "folderId": "0",
