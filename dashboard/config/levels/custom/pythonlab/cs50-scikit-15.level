          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 2.6\n# Standard Description: Explain the importance of feature engineering.\n#\n# Rationale: Feature Engineering isn't just about scaling numbers; it's also \n# about CREATING new information. Often, the \"raw\" data doesn't tell the whole \n# story. By combining or extracting data, we can create a feature that is \n# much more powerful. For example, knowing the \"Date\" is okay, but knowing \n# \"Is it a Weekend?\" might be much more useful for predicting sales.\n\n\"\"\"\nWelcome! Feature Engineering is like being a chef. \nYou take raw ingredients (raw data) and you combine them to make \nsomething better (new features).\n\nSometimes, a computer is \"blind\" to certain patterns. We use feature \nengineering to \"point\" at the patterns so the AI can see them easily.\n\"\"\"\n\nimport pandas as pd\n\n# --- OUR RAW DATA ---\n# Imagine we are tracking sales for a lemonade stand.\ndata = {\n    'Date': ['2026-07-04', '2026-07-05', '2026-07-06', '2026-07-07'],\n    'Lemons_Used': [10, 15, 5, 8],\n    'Sugar_Used_Cups': [2, 3, 1, 2],\n    'Sales_Total': [50, 75, 20, 35]\n}\ndf = pd.DataFrame(data)\n\nprint(\"--- Original Sales Data ---\")\nprint(df)\nprint(\"\\n\")\n\n# --- FEATURE 1: COMBINING DATA ---\nprint(\"--- Step 1: Combining Features (Efficiency) ---\")\n# Instead of just Lemons and Sugar, maybe the RATIO is what matters.\n# Let's create a 'Sweetness_Ratio' feature.\ndf['Sweetness_Ratio'] = df['Sugar_Used_Cups'] / df['Lemons_Used']\n\n# --- FEATURE 2: EXTRACTING DATA ---\nprint(\"--- Step 2: Extracting Information (Is it a Weekend?) ---\")\n# The AI doesn't automatically know that July 4th and 5th were Saturday and Sunday!\n# We convert the 'Date' column and extract the day of the week.\ndf['Date'] = pd.to_datetime(df['Date'])\ndf['Day_of_Week'] = df['Date'].dt.day_name()\ndf['Is_Weekend'] = df['Date'].dt.dayofweek // 5 == 1 # Returns True for Sat/Sun\n\nprint(\"--- Data with New Engineered Features ---\")\nprint(df[['Date', 'Sweetness_Ratio', 'Day_of_Week', 'Is_Weekend', 'Sales_Total']])\nprint(\"\\n\")\nprint(\"Now the AI can easily see if weekends or sweetness impact sales!\")\n\n\"\"\"\n--- YOUR TURN ---\nWe have data about a runner. \n1. Create a new feature called 'Pace' by dividing 'Minutes' by 'Miles'.\n2. Create a new feature called 'Is_Long_Run' that is True if Miles > 5.\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\nruns = pd.DataFrame({\n    'Date': ['2026-01-01', '2026-01-02', '2026-01-03'],\n    'Miles': [3, 10, 2],\n    'Minutes': [24, 90, 16]\n})\n\n# TODO: Create 'Pace' (Minutes per Mile)\n# TODO: Create 'Is_Long_Run' (Miles > 5)\n\nprint(\"Engineer some new features for the runner!\")\n",
          "folderId": "0",
          "active": true
        }
