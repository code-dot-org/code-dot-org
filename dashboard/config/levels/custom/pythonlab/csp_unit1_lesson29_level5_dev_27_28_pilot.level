      "id": "1",
      "name": "test.py",
      "contents": "import ast\nfrom unittest import TestCase\n\n\nCOLOR_FUNCS = {\"Color\"}\nSOUND_FUNCS = {\"play_note\", \"play_note_and_pause\"}\nDRAWING_FUNCS = {\"draw_rectangle\", \"draw_ellipse\", \"draw_line\", \"draw_shape\", \"draw_text\"}\n\n\nclass TestMakeRandomSketch(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Parse the source statically -- same limitation as every other\n        Theater level in this lesson: no safe way to execute a full\n        draw-and-play() scene, so this only checks structure, not runtime\n        behavior or visual correctness.\"\"\"\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n        cls.tree = ast.parse(cls.source)\n        cls.randint_vars = cls._collect_randint_vars(cls.tree)\n        cls.used_random_vars = cls._find_used_random_vars(cls.tree, cls.randint_vars)\n\n    @staticmethod\n    def _collect_randint_vars(tree):\n        names = set()\n        for node in ast.walk(tree):\n            if (isinstance(node, ast.Assign) and isinstance(node.value, ast.Call)\n                    and isinstance(node.value.func, ast.Name) and node.value.func.id == \"randint\"):\n                for t in node.targets:\n                    if isinstance(t, ast.Name):\n                        names.add(t.id)\n        return names\n\n    @staticmethod\n    def _find_used_random_vars(tree, randint_vars):\n        \"\"\"Only count a random variable as 'used' if it's referenced\n        inside a call to a drawing, color, or sound function -- matching\n        the rubric's distinction between a variable that's actually\n        connected to the random effect vs. one that's just declared.\"\"\"\n        used = set()\n        for node in ast.walk(tree):\n            if not (isinstance(node, ast.Call) and isinstance(node.func, ast.Name)):\n                continue\n            if node.func.id not in (COLOR_FUNCS | SOUND_FUNCS | DRAWING_FUNCS):\n                continue\n            for arg in node.args:\n                referenced_names = {n.id for n in ast.walk(arg) if isinstance(n, ast.Name)}\n                used |= referenced_names & randint_vars\n        return used\n\n    def test_scene_has_drawing_and_sound(self):\n        \"\"\"Includes at least one drawn element and at least one sound\"\"\"\n        called_names = {\n            n.func.id for n in ast.walk(self.tree)\n            if isinstance(n, ast.Call) and isinstance(n.func, ast.Name)\n        }\n        self.assertTrue(\n            called_names & DRAWING_FUNCS,\n            \"We didn't find any drawing commands (draw_rectangle, draw_ellipse, etc.). Build out your scene's background and objects.\"\n        )\n        self.assertTrue(\n            called_names & SOUND_FUNCS,\n            \"We didn't find any play_note() or play_note_and_pause() calls. Add music to your scene.\"\n        )\n\n    def test_at_least_two_random_values_connected(self):\n        \"\"\"Uses randint() to randomize at least two values that are actually connected to the scene\"\"\"\n        self.assertGreaterEqual(\n            len(self.randint_vars),\n            2,\n            f\"Expected at least 2 randint() calls, but found {len(self.randint_vars)}.\"\n        )\n        self.assertGreaterEqual(\n            len(self.used_random_vars),\n            2,\n            f\"We found {len(self.randint_vars)} randint() variable(s), but only {len(self.used_random_vars)} are \"\n            \"actually used in a drawing, color, or sound command. Make sure each random variable is connected to \"\n            \"something in your scene -- e.g. Color(red, green, blue) or draw_ellipse(x, y, ...).\"\n        )\n\n    def test_has_comment_explaining_randomization(self):\n        \"\"\"Has a comment explaining what was randomized\"\"\"\n        has_relevant_comment = any(\n            line.strip().startswith(\"#\") and \"random\" in line.lower()\n            for line in self.source.splitlines()\n        )\n        self.assertTrue(\n            has_relevant_comment,\n            \"We didn't find a comment mentioning what you randomized. Add a comment explaining it (e.g. '# Random fish colors').\"\n        )",
      "folderId": "0",
      "active": false,
      "type": "validation"
    },
    "name_suffix": "_pilot"
  },
