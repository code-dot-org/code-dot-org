        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "# Train — original by Ms. Nakamura\nfrom theater import *\n\nclear(\"#B3E5FC\")\n\n# Track\nset_fill_color(\"#5D4037\")\ndraw_rectangle(0, 300, 400, 10)\n\n# Train cars, each with two wheels and a chug\nfor j in range(4):\n    set_fill_color(\"blue\")\n    draw_rectangle(j * 90 + 20, 240, 70, 50)\n    set_fill_color(\"black\")\n    draw_ellipse(j * 90 + 28, 282, 20, 20)\n    draw_ellipse(j * 90 + 62, 282, 20, 20)\n    play_note_and_pause(48, 0.15, \"bass\")\nplay()",
