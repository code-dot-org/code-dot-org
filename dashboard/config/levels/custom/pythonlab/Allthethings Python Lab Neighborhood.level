        "0": {
          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "from object_oriented import run_oo_test\nfrom functional import run_functional_test\n# CHANGE THIS BOOLEAN TO USE FUNCTIONAL VERSION OVER OBJECT-ORIENTED VERSION\nuse_functional = False\n\nif (use_functional):\n  run_functional_test()\nelse:\n  run_oo_test()\n",
          "folderId": "0",
          "active": true,
          "open": true,
          "type": "locked_starter"
        },
        "5": {
          "id": "5",
          "name": "object_oriented.py",
          "contents": "from neighborhood import Painter\n\nGRID_SIZE = 12\n# Squares along the top row to paint, and what to paint them. The four spellings\n# cover every color format paint() accepts.\nTOP_ROW_COLORS = {2: \"blue\", 4: \"MediumVioletRed\", 6: \"#0f0\", 8: \"#123456\"}\n\n\ndef turn_right(painter):\n    # turn_left is the only rotation primitive, so a right turn is three lefts.\n    painter.turn_left()\n    painter.turn_left()\n    painter.turn_left()\n\n\ndef move_forward(painter, squares):\n    for _ in range(squares):\n        painter.move()\n\n\ndef report(label, value):\n    print(label + \": \" + str(value))\n\ndef run_oo_test():\n  painter = Painter()\n  \n  # Where are we and what are we standing on?\n  report(\"x\", painter.get_x())\n  report(\"y\", painter.get_y())\n  report(\"direction\", painter.get_direction())\n  report(\"facing north\", painter.is_facing_north())\n  report(\"facing east\", painter.is_facing_east())\n  report(\"facing south\", painter.is_facing_south())\n  report(\"facing west\", painter.is_facing_west())\n  report(\"on a bucket\", painter.is_on_bucket())\n  report(\"on paint\", painter.is_on_paint())\n  report(\"has paint\", painter.has_paint())\n  report(\"my paint\", painter.get_my_paint())\n  \n  # Painting with an empty bucket prints a message rather than stopping the program.\n  painter.paint(\"red\")\n  \n  # Drain the bucket, then ask it for one unit too many.\n  while painter.is_on_bucket():\n      painter.take_paint()\n  report(\"my paint after collecting\", painter.get_my_paint())\n  painter.take_paint()\n  \n  # Display toggles. These change nothing about the grid or the painter.\n  painter.hide_buckets()\n  painter.show_buckets()\n  painter.hide_painter()\n  painter.show_painter()\n  \n  # The bucket is empty now, so this square will finally accept paint.\n  painter.paint(\"#F00\")\n  report(\"on paint after painting\", painter.is_on_paint())\n  report(\"color\", painter.get_color())\n  painter.scrape_paint()\n  report(\"color after scraping\", painter.get_color())\n  painter.scrape_paint()\n  \n  # East along the top row, painting every other square.\n  report(\"can move east\", painter.can_move())\n  report(\"can move north\", painter.can_move(\"north\"))\n  for _ in range(GRID_SIZE - 1):\n      painter.move()\n      if painter.get_x() in TOP_ROW_COLORS:\n          painter.paint(TOP_ROW_COLORS[painter.get_x()])\n  report(\"my paint after the top row\", painter.get_my_paint())\n  report(\"can move east from the corner\", painter.can_move())\n  \n  # A full rotation through all four directions, ending where it started.\n  for _ in range(4):\n      painter.turn_left()\n      report(\"now facing\", painter.get_direction())\n  \n  # Down the east edge, then west until the first bench blocks the way.\n  turn_right(painter)\n  move_forward(painter, 4)\n  turn_right(painter)\n  move_forward(painter, 3)\n  report(\"bench west of (8, 4)\", painter.can_move())\n  \n  # Step around it: one square south is still blocked, two squares south is clear.\n  painter.turn_left()\n  move_forward(painter, 1)\n  report(\"bench west of (8, 5)\", painter.can_move(\"west\"))\n  move_forward(painter, 1)\n  report(\"clear west of (8, 6)\", painter.can_move(\"west\"))\n  \n  # West along row 6, north to row 3, then east under the other bench.\n  turn_right(painter)\n  move_forward(painter, 8)\n  turn_right(painter)\n  move_forward(painter, 3)\n  turn_right(painter)\n  move_forward(painter, 2)\n  report(\"open north of (2, 3)\", painter.can_move(\"north\"))\n  painter.move()\n  report(\"bench north of (3, 3)\", painter.can_move(\"north\"))\n  painter.move()\n  report(\"bench north of (4, 3)\", painter.can_move(\"north\"))\n  painter.move()\n  report(\"open north of (5, 3)\", painter.can_move(\"north\"))\n  painter.paint(\"purple\")\n  \n  # Home, the long way around: west along row 3, then north up the west edge.\n  painter.turn_left()\n  painter.turn_left()\n  move_forward(painter, 5)\n  turn_right(painter)\n  move_forward(painter, 3)\n  report(\"home\", str(painter.get_x()) + \", \" + str(painter.get_y()))\n  report(\"bucket left at home\", painter.is_on_bucket())\n  report(\"my paint at home\", painter.get_my_paint())\n  \n  # A negative amount is refused with a message; a valid one replaces the count.\n  painter.set_paint(-1)\n  painter.set_paint(2)\n  report(\"my paint after set_paint\", painter.get_my_paint())\n  report(\"has paint\", painter.has_paint())\n  \n  # A second painter shares the same grid, so it sees the first painter's work.\n  inspector = Painter(x=2, y=0, direction=\"west\", paint=1)\n  report(\"inspector direction\", inspector.get_direction())\n  report(\"inspector on paint\", inspector.is_on_paint())\n  report(\"inspector sees\", inspector.get_color())\n  inspector.scrape_paint()\n  inspector.paint(\"gold\")\n  report(\"inspector color\", inspector.get_color())\n  report(\"inspector paint\", inspector.get_my_paint())\n  report(\"inspector has paint\", inspector.has_paint())",
          "folderId": "0",
          "active": false
        },
        "6": {
          "id": "6",
          "name": "functional.py",
          "contents": "from neighborhood import (\n    can_move,\n    get_color,\n    get_direction,\n    get_my_paint,\n    get_x,\n    get_y,\n    has_paint,\n    hide_buckets,\n    hide_painter,\n    is_facing_east,\n    is_facing_north,\n    is_facing_south,\n    is_facing_west,\n    is_on_bucket,\n    is_on_paint,\n    move,\n    paint,\n    scrape_paint,\n    set_paint,\n    show_buckets,\n    show_painter,\n    take_paint,\n    turn_left,\n)\n\nGRID_SIZE = 12\n# Squares along the top row to paint, and what to paint them. The four spellings\n# cover every color format paint() accepts.\nTOP_ROW_COLORS = {2: \"blue\", 4: \"MediumVioletRed\", 6: \"#0f0\", 8: \"#123456\"}\n\n\ndef turn_right():\n    # turn_left is the only rotation primitive, so a right turn is three lefts.\n    turn_left()\n    turn_left()\n    turn_left()\n\n\ndef move_forward(squares):\n    for _ in range(squares):\n        move()\n\n\ndef report(label, value):\n    print(label + \": \" + str(value))\n\ndef run_functional_test():\n  # Where are we and what are we standing on?\n  report(\"x\", get_x())\n  report(\"y\", get_y())\n  report(\"direction\", get_direction())\n  report(\"facing north\", is_facing_north())\n  report(\"facing east\", is_facing_east())\n  report(\"facing south\", is_facing_south())\n  report(\"facing west\", is_facing_west())\n  report(\"on a bucket\", is_on_bucket())\n  report(\"on paint\", is_on_paint())\n  report(\"has paint\", has_paint())\n  report(\"my paint\", get_my_paint())\n  \n  # Painting with an empty bucket prints a message rather than stopping the program.\n  paint(\"red\")\n  \n  # Drain the bucket, then ask it for one unit too many.\n  while is_on_bucket():\n      take_paint()\n  report(\"my paint after collecting\", get_my_paint())\n  take_paint()\n  \n  # Display toggles. These change nothing about the grid or the painter.\n  hide_buckets()\n  show_buckets()\n  hide_painter()\n  show_painter()\n  \n  # The bucket is empty now, so this square will finally accept paint.\n  paint(\"#F00\")\n  report(\"on paint after painting\", is_on_paint())\n  report(\"color\", get_color())\n  scrape_paint()\n  report(\"color after scraping\", get_color())\n  scrape_paint()\n  \n  # East along the top row, painting every other square.\n  report(\"can move east\", can_move())\n  report(\"can move north\", can_move(\"north\"))\n  for _ in range(GRID_SIZE - 1):\n      move()\n      if get_x() in TOP_ROW_COLORS:\n          paint(TOP_ROW_COLORS[get_x()])\n  report(\"my paint after the top row\", get_my_paint())\n  report(\"can move east from the corner\", can_move())\n  \n  # A full rotation through all four directions, ending where it started.\n  for _ in range(4):\n      turn_left()\n      report(\"now facing\", get_direction())\n  \n  # Down the east edge, then west until the first bench blocks the way.\n  turn_right()\n  move_forward(4)\n  turn_right()\n  move_forward(3)\n  report(\"bench west of (8, 4)\", can_move())\n  \n  # Step around it: one square south is still blocked, two squares south is clear.\n  turn_left()\n  move_forward(1)\n  report(\"bench west of (8, 5)\", can_move(\"west\"))\n  move_forward(1)\n  report(\"clear west of (8, 6)\", can_move(\"west\"))\n  \n  # West along row 6, north to row 3, then east under the other bench.\n  turn_right()\n  move_forward(8)\n  turn_right()\n  move_forward(3)\n  turn_right()\n  move_forward(2)\n  report(\"open north of (2, 3)\", can_move(\"north\"))\n  move()\n  report(\"bench north of (3, 3)\", can_move(\"north\"))\n  move()\n  report(\"bench north of (4, 3)\", can_move(\"north\"))\n  move()\n  report(\"open north of (5, 3)\", can_move(\"north\"))\n  paint(\"purple\")\n  \n  # Home, the long way around: west along row 3, then north up the west edge.\n  turn_left()\n  turn_left()\n  move_forward(5)\n  turn_right()\n  move_forward(3)\n  report(\"home\", str(get_x()) + \", \" + str(get_y()))\n  report(\"bucket left at home\", is_on_bucket())\n  report(\"my paint at home\", get_my_paint())\n  \n  # A negative amount is refused with a message; a valid one replaces the count.\n  set_paint(-1)\n  set_paint(1)\n  report(\"my paint after set_paint\", get_my_paint())\n  report(\"has paint\", has_paint())\n  \n  # Spend the last unit back where the run started.\n  paint(\"gold\")\n  report(\"color at home\", get_color())\n  report(\"my paint\", get_my_paint())\n  report(\"has paint\", has_paint())",
          "folderId": "0",
          "active": false
        }
