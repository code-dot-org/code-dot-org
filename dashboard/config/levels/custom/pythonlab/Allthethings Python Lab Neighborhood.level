        "0": {
          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "from object_oriented import run_oo_test\nfrom functional import run_functional_test\n# CHANGE THIS BOOLEAN TO USE FUNCTIONAL VERSION OVER OBJECT-ORIENTED VERSION\nuse_functional = False\n\nif (use_functional):\n  run_functional_test()\nelse:\n  run_oo_test()\n",
          "folderId": "0",
          "active": true,
          "open": true,
          "type": "locked_starter"
        },
        "4": {
          "id": "4",
          "name": "painter_plus.py",
          "contents": "from neighborhood import Painter\n\n\nclass PainterPlus(Painter):\n    \"\"\"A Painter that also knows a few compound moves.\"\"\"\n\n    def turn_right(self):\n        \"\"\"Rotates 90 degrees clockwise from the current direction.\"\"\"\n        self.turn_left()\n        self.turn_left()\n        self.turn_left()\n\n    def turn_around(self):\n        self.turn_left()\n        self.turn_left()\n\n    def move_fast(self):\n        self.move()\n        self.move()\n\n    def paint_line_segment(self, color):\n        \"\"\"Paints a line of length three in the direction the painter is facing.\"\"\"\n        self.paint(color)\n        self.move()\n        self.paint(color)\n        self.move()\n        self.paint(color)\n\n    def paint_full_line(self, color):\n        \"\"\"Paints in the direction the painter is facing until a barrier is reached.\"\"\"\n        while self.can_move():\n            self.paint(color)\n            self.move()\n        self.paint(color)\n\n    def paint_diagonal_segment(self, color):\n        \"\"\"Paints a diagonal of length two, 45 degrees counter clockwise of the\n        direction the painter is facing.\"\"\"\n        self.paint(color)\n        if self.can_move():\n            self.move()\n            self.turn_left()\n            if self.can_move():\n                self.move()\n                self.paint(color)\n                self.turn_right()\n\n    def paint_full_diagonal(self, color):\n        while self.can_move():\n            self.paint_diagonal_segment(color)\n\n    def paint_border(self, color):\n        \"\"\"Paints a border around the neighborhood. Start at (0, 0).\"\"\"\n        if self.is_facing_south():\n            self.turn_left()\n        elif self.is_facing_west():\n            self.turn_around()\n        elif self.is_facing_north():\n            self.turn_right()\n\n        self.paint_full_line(color)\n        self.turn_right()\n        self.move()\n        self.turn_right()\n        self.paint_full_line(color)\n        self.turn_left()\n        self.paint_full_line(color)\n        self.turn_left()\n        self.move()\n        self.turn_left()\n        self.paint_full_line(color)\n        self.turn_right()\n        while self.can_move():\n            self.move()\n        self.turn_right()\n        while self.can_move():\n            self.move()\n        self.turn_right()\n        self.paint_full_line(color)\n        self.turn_right()\n        self.move()\n        self.turn_right()\n        self.paint_full_line(color)\n        self.turn_left()\n        self.paint_full_line(color)\n        self.turn_left()\n        self.move()\n        self.turn_left()\n        self.paint_full_line(color)",
          "folderId": "0",
          "active": false
        },
        "5": {
          "id": "5",
          "name": "object_oriented.py",
          "contents": "from painter_plus import PainterPlus\n\ndef run_oo_test():\n  # A\n  dalia = PainterPlus(3, 3, \"south\", 1000)\n  dalia.paint(\"gold\")\n  dalia.move()\n  dalia.move()\n  dalia.move()\n  dalia.paint(\"gold\")\n  dalia.move()\n  dalia.turn_left()\n  dalia.move()\n  dalia.turn_left()\n  for i in range(4):\n      dalia.paint(\"gold\")\n      dalia.move()\n  dalia.turn_left()\n  dalia.move()\n  dalia.move()\n  dalia.turn_left()\n  dalia.move()\n  for i in range(4):\n      dalia.paint(\"gold\")\n      dalia.move()\n  \n  # B\n  dalia.move_fast()\n  dalia.paint(\"gainsboro\")\n  for i in range(4):\n      dalia.move()\n      dalia.paint(\"gainsboro\")\n  dalia.turn_left()\n  dalia.move()\n  dalia.paint(\"gainsboro\")\n  dalia.turn_left()\n  dalia.move_fast()\n  dalia.paint(\"gainsboro\")\n  dalia.move_fast()\n  dalia.paint(\"gainsboro\")\n  dalia.turn_right()\n  dalia.move()\n  dalia.turn_right()\n  dalia.move()\n  dalia.paint(\"gainsboro\")\n  dalia.move_fast()\n  dalia.paint(\"gainsboro\")\n  \n  # small circle\n  bob = PainterPlus(8, 3, \"south\", 1000)\n  bob.paint(\"teal\")\n  bob.move()\n  bob.move()\n  bob.paint(\"teal\")\n  bob.turn_right()\n  bob.move()\n  bob.turn_right()\n  bob.move()\n  bob.turn_right()\n  bob.paint(\"teal\")\n  bob.move()\n  bob.move()\n  bob.paint(\"teal\")\n  \n  # big circle\n  ann = PainterPlus(8, 11, \"east\", 100)\n  for i in range(4):\n      ann.paint(\"pink\")\n      ann.move()\n      ann.paint(\"pink\")\n      ann.move()\n      ann.turn_right()\n      ann.move()\n  \n  # filled circle\n  ann.move_fast()\n  ann.move_fast()\n  ann.move_fast()\n  ann.turn_right()\n  ann.paint(\"teal\")\n  ann.move()\n  ann.move()\n  ann.paint(\"teal\")\n  ann.turn_right()\n  ann.move()\n  ann.turn_right()\n  ann.move()\n  ann.turn_right()\n  ann.paint(\"teal\")\n  ann.move()\n  ann.move()\n  ann.paint(\"teal\")\n  ann.turn_around()\n  ann.move()\n  ann.paint(\"gold\")\n  \n  # diagonal line\n  jen = PainterPlus(16, 3, \"south\", 1000)\n  jen.paint_diagonal_segment(\"coral\")\n  jen.paint_diagonal_segment(\"coral\")\n  jen.paint_diagonal_segment(\"coral\")\n  jen.paint_diagonal_segment(\"coral\")\n  jen.turn_right()\n  jen.move()\n  jen.move()\n  jen.turn_right()\n  jen.paint_diagonal_segment(\"white\")\n  jen.paint_diagonal_segment(\"white\")\n  jen.paint_diagonal_segment(\"white\")\n  jen.paint_diagonal_segment(\"white\")\n  \n  # side by side diagonals\n  jen.turn_right()\n  jen.move_fast()\n  jen.move_fast()\n  jen.move_fast()\n  jen.move_fast()\n  jen.move_fast()\n  jen.turn_right()\n  jen.paint_diagonal_segment(\"white\")\n  jen.paint_diagonal_segment(\"white\")\n  jen.paint_diagonal_segment(\"white\")\n  jen.paint_diagonal_segment(\"white\")\n  jen.turn_left()\n  jen.move()\n  jen.turn_left()\n  jen.paint_diagonal_segment(\"teal\")\n  jen.paint_diagonal_segment(\"teal\")\n  jen.paint_diagonal_segment(\"teal\")\n  jen.paint_diagonal_segment(\"teal\")\n  \n  # big triangle\n  don = PainterPlus(16, 16, \"east\", 1000)\n  don.paint(\"lightGreen\")\n  don.move()\n  don.paint(\"lightGreen\")\n  don.move()\n  don.paint(\"lightGreen\")\n  don.move()\n  don.paint(\"lightGreen\")\n  don.move()\n  don.turn_right()\n  don.paint(\"lightGreen\")\n  don.move()\n  don.paint(\"lightGreen\")\n  don.move()\n  don.paint(\"lightGreen\")\n  don.move()\n  don.paint(\"lightGreen\")\n  don.move()\n  don.turn_right()\n  don.turn_right()\n  don.paint_diagonal_segment(\"lightGreen\")\n  don.paint_diagonal_segment(\"lightGreen\")\n  don.paint_diagonal_segment(\"lightGreen\")\n  \n  # small triangle\n  don.move()\n  don.turn_right()\n  don.move_fast()\n  don.move_fast()\n  don.move_fast()\n  don.paint(\"gold\")\n  don.move()\n  don.paint(\"gold\")\n  don.turn_right()\n  don.move()\n  don.paint(\"gold\")\n  \n  # L with leg\n  stan = PainterPlus(3, 20, \"east\", 1000)\n  stan.paint(\"white\")\n  stan.move()\n  stan.paint(\"white\")\n  stan.move()\n  stan.paint(\"white\")\n  stan.turn_around()\n  stan.move()\n  stan.move()\n  stan.turn_right()\n  stan.move()\n  stan.paint(\"white\")\n  stan.hide_painter()",
          "folderId": "0",
          "active": false
        },
        "6": {
          "id": "6",
          "name": "functional.py",
          "contents": "from neighborhood import *\n\n\n# The PainterPlus methods, as functions on the one implicit painter.\n\ndef turn_right():\n    turn_left()\n    turn_left()\n    turn_left()\n\n\ndef turn_around():\n    turn_left()\n    turn_left()\n\n\ndef move_fast():\n    move()\n    move()\n\n\ndef paint_line_segment(color):\n    \"\"\"Paints a line of length three in the direction the painter is facing.\"\"\"\n    paint(color)\n    move()\n    paint(color)\n    move()\n    paint(color)\n\n\ndef paint_full_line(color):\n    \"\"\"Paints in the direction the painter is facing until a barrier is reached.\"\"\"\n    while can_move():\n        paint(color)\n        move()\n    paint(color)\n\n\ndef paint_diagonal_segment(color):\n    \"\"\"Paints a diagonal of length two, 45 degrees counter clockwise of the\n    direction the painter is facing.\"\"\"\n    paint(color)\n    if can_move():\n        move()\n        turn_left()\n        if can_move():\n            move()\n            paint(color)\n            turn_right()\n\n\ndef paint_full_diagonal(color):\n    while can_move():\n        paint_diagonal_segment(color)\n\n\ndef paint_border(color):\n    \"\"\"Paints a border around the neighborhood. Start at (0, 0).\"\"\"\n    if is_facing_south():\n        turn_left()\n    elif is_facing_west():\n        turn_around()\n    elif is_facing_north():\n        turn_right()\n\n    paint_full_line(color)\n    turn_right()\n    move()\n    turn_right()\n    paint_full_line(color)\n    turn_left()\n    paint_full_line(color)\n    turn_left()\n    move()\n    turn_left()\n    paint_full_line(color)\n    turn_right()\n    while can_move():\n        move()\n    turn_right()\n    while can_move():\n        move()\n    turn_right()\n    paint_full_line(color)\n    turn_right()\n    move()\n    turn_right()\n    paint_full_line(color)\n    turn_left()\n    paint_full_line(color)\n    turn_left()\n    move()\n    turn_left()\n    paint_full_line(color)\n\n\ndef face(direction):\n    while get_direction() != direction:\n        turn_left()\n\n\ndef start_at(x, y, direction):\n    \"\"\"Walks the painter to (x, y) and faces it, painting nothing on the way.\n    Stands in for the constructor calls of the object-oriented version: there is\n    only one implicit painter, so each shape has to be walked to.\"\"\"\n    if get_x() != x:\n        face(\"east\" if get_x() < x else \"west\")\n        while get_x() != x:\n            move()\n    if get_y() != y:\n        face(\"south\" if get_y() < y else \"north\")\n        while get_y() != y:\n            move()\n    face(direction)\n\n\ndef run_functional_test():\n  # A\n  start_at(3, 3, \"south\")\n  paint(\"gold\")\n  move()\n  move()\n  move()\n  paint(\"gold\")\n  move()\n  turn_left()\n  move()\n  turn_left()\n  for i in range(4):\n      paint(\"gold\")\n      move()\n  turn_left()\n  move()\n  move()\n  turn_left()\n  move()\n  for i in range(4):\n      paint(\"gold\")\n      move()\n  \n  # B\n  move_fast()\n  paint(\"gainsboro\")\n  for i in range(4):\n      move()\n      paint(\"gainsboro\")\n  turn_left()\n  move()\n  paint(\"gainsboro\")\n  turn_left()\n  move_fast()\n  paint(\"gainsboro\")\n  move_fast()\n  paint(\"gainsboro\")\n  turn_right()\n  move()\n  turn_right()\n  move()\n  paint(\"gainsboro\")\n  move_fast()\n  paint(\"gainsboro\")\n  \n  # small circle\n  start_at(8, 3, \"south\")\n  paint(\"teal\")\n  move()\n  move()\n  paint(\"teal\")\n  turn_right()\n  move()\n  turn_right()\n  move()\n  turn_right()\n  paint(\"teal\")\n  move()\n  move()\n  paint(\"teal\")\n  \n  # big circle\n  start_at(8, 11, \"east\")\n  for i in range(4):\n      paint(\"pink\")\n      move()\n      paint(\"pink\")\n      move()\n      turn_right()\n      move()\n  \n  # filled circle\n  move_fast()\n  move_fast()\n  move_fast()\n  turn_right()\n  paint(\"teal\")\n  move()\n  move()\n  paint(\"teal\")\n  turn_right()\n  move()\n  turn_right()\n  move()\n  turn_right()\n  paint(\"teal\")\n  move()\n  move()\n  paint(\"teal\")\n  turn_around()\n  move()\n  paint(\"gold\")\n  \n  # diagonal line\n  start_at(16, 3, \"south\")\n  paint_diagonal_segment(\"coral\")\n  paint_diagonal_segment(\"coral\")\n  paint_diagonal_segment(\"coral\")\n  paint_diagonal_segment(\"coral\")\n  turn_right()\n  move()\n  move()\n  turn_right()\n  paint_diagonal_segment(\"white\")\n  paint_diagonal_segment(\"white\")\n  paint_diagonal_segment(\"white\")\n  paint_diagonal_segment(\"white\")\n  \n  # side by side diagonals\n  turn_right()\n  move_fast()\n  move_fast()\n  move_fast()\n  move_fast()\n  move_fast()\n  turn_right()\n  paint_diagonal_segment(\"white\")\n  paint_diagonal_segment(\"white\")\n  paint_diagonal_segment(\"white\")\n  paint_diagonal_segment(\"white\")\n  turn_left()\n  move()\n  turn_left()\n  paint_diagonal_segment(\"teal\")\n  paint_diagonal_segment(\"teal\")\n  paint_diagonal_segment(\"teal\")\n  paint_diagonal_segment(\"teal\")\n  \n  # big triangle\n  start_at(16, 16, \"east\")\n  paint(\"lightGreen\")\n  move()\n  paint(\"lightGreen\")\n  move()\n  paint(\"lightGreen\")\n  move()\n  paint(\"lightGreen\")\n  move()\n  turn_right()\n  paint(\"lightGreen\")\n  move()\n  paint(\"lightGreen\")\n  move()\n  paint(\"lightGreen\")\n  move()\n  paint(\"lightGreen\")\n  move()\n  turn_right()\n  turn_right()\n  paint_diagonal_segment(\"lightGreen\")\n  paint_diagonal_segment(\"lightGreen\")\n  paint_diagonal_segment(\"lightGreen\")\n  \n  # small triangle\n  move()\n  turn_right()\n  move_fast()\n  move_fast()\n  move_fast()\n  paint(\"gold\")\n  move()\n  paint(\"gold\")\n  turn_right()\n  move()\n  paint(\"gold\")\n  \n  # L with leg\n  start_at(3, 20, \"east\")\n  paint(\"white\")\n  move()\n  paint(\"white\")\n  move()\n  paint(\"white\")\n  turn_around()\n  move()\n  move()\n  turn_right()\n  move()\n  paint(\"white\")\n  hide_painter()",
          "folderId": "0",
          "active": false
        }
      },
