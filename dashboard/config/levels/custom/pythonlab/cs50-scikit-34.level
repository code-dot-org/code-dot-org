          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 5.3\n# Standard Description: Describe how predictions or decisions are made with AI models.\n#\n# Rationale: AI doesn't just say \"Yes\" or \"No\". Internally, it calculates a \n# PROBABILITY (like 78% likely to rain). A \"Decision\" is made by comparing \n# that probability to a threshold (usually 50%). This tutorial shows how \n# to look under the hood of a prediction.\n\n\"\"\"\nWelcome! How does an AI \"make up its mind\"? \nIt's actually a two-step process:\n1. Prediction: The AI calculates a probability (e.g., 0.85).\n2. Decision: The computer compares that number to a limit (e.g., Is 0.85 > 0.5?).\n\nIf the limit (threshold) is 0.5, then 0.85 becomes a \"YES\".\n\"\"\"\n\nimport numpy as np\nfrom sklearn.linear_model import LogisticRegression\n\n# --- OUR DATA ---\n# X = Height of a Wave (meters)\n# y = 0 (Safe to swim) or 1 (Danger!)\nX = np.array([0.5, 0.8, 1.2, 1.5, 2.0, 2.5, 3.0, 4.0]).reshape(-1, 1)\ny = np.array([0, 0, 0, 0, 1, 1, 1, 1])\n\n# --- THE MODEL ---\nmodel = LogisticRegression()\nmodel.fit(X, y)\n\n# --- LOOKING UNDER THE HOOD ---\nprint(\"--- Step 1: Probabilities ---\")\n# Let's predict for a 2.2 meter wave\nnew_wave = [[2.2]]\nprob = model.predict_proba(new_wave)\n\nprint(f\"Wave Height: {new_wave[0][0]} meters\")\nprint(f\"Probability of being Safe (0): {prob[0][0]:.2%}\")\nprint(f\"Probability of being Dangerous (1): {prob[0][1]:.2%}\")\n\nprint(\"\\n--- Step 2: The Decision ---\")\n# The standard decision threshold is 0.5 (50%)\nprediction = model.predict(new_wave)\ndecision = \"DANGEROUS\" if prediction[0] == 1 else \"SAFE\"\n\nprint(f\"Final AI Decision: {decision}\")\nprint(f\"Reason: {prob[0][1]:.2f} is greater than 0.50\")\n\n\"\"\"\n--- YOUR TURN ---\nWhat if we want to be VERY safe? We can change the threshold!\n1. If our threshold is 0.10 (10%), would a wave with a 15% danger \n   chance be called \"Dangerous\"?\n2. Why might a doctor use a LOWER threshold (like 0.10) for \n   detecting a serious disease?\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\n# TODO: Answer the questions!\n# Threshold_010_Result = \"___\"\n# Doctor_Reason = \"___\"\n",
