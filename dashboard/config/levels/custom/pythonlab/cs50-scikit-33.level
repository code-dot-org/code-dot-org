        "0": {
          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 6.3\n# Standard Description: Estimate the mean and standard error of the mean given the data.\n#\n# Rationale: This tutorial covers the absolute basics of statistical \n# estimation. It's one thing to calculate a \"Mean\" (the average), but it's \n# another to calculate the \"Standard Error\" (how much we expect that \n# average to jump around if we measured a different group).\n\n\"\"\"\nWelcome! Today we are looking at two important numbers:\n1. The Mean: The \"Middle\" or \"Average\" of our group.\n2. The Standard Error: A measure of how \"solid\" our average is.\n\nIf you measure 10,000 people, your average is very \"solid\" (Low Standard Error).\nIf you measure only 3 people, your average is \"shaky\" (High Standard Error).\n\"\"\"\n\nimport numpy as np\n\n# --- OUR DATA ---\n# Imagine we measured the battery life of 10 phones (in hours).\nbattery_life = [12, 14, 11, 15, 13, 10, 16, 12, 14, 13]\n\n# --- PART 1: THE MEAN ---\nprint(\"--- Part 1: Calculating the Mean ---\")\nmean_val = np.mean(battery_life)\nprint(f\"Average Battery Life: {mean_val:.2f} hours\")\n\n# --- PART 2: THE STANDARD ERROR ---\nprint(\"\\n--- Part 2: Calculating the Standard Error (SEM) ---\")\n# Standard Error = Standard Deviation / Square Root of (Number of items)\nstd_dev = np.std(battery_life, ddof=1) # ddof=1 is for samples\nn = len(battery_life)\nsem = std_dev / np.sqrt(n)\n\nprint(f\"Standard Deviation: {std_dev:.2f}\")\nprint(f\"Number of Phones (n): {n}\")\nprint(f\"Standard Error of the Mean (SEM): {sem:.2f}\")\n\nprint(\"\\nInterpretation:\")\nprint(f\"Our best guess for battery life is {mean_val:.2f} hours,\")\nprint(f\"but we expect this guess to be off by about {sem:.2f} hours on average.\")\n\n\"\"\"\n--- YOUR TURN ---\nWe've doubled the number of phones to 20!\n1. Recalculate the Mean and the Standard Error.\n2. Did the Standard Error get BIGGER or SMALLER when we added more data?\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\nmore_battery = [12, 14, 11, 15, 13, 10, 16, 12, 14, 13, \n                11, 15, 12, 13, 14, 12, 11, 15, 14, 13]\n\n# TODO: Calculate mean\n# TODO: Calculate sem (std / sqrt(n))\n# TODO: Print results!\n",
          "folderId": "0",
