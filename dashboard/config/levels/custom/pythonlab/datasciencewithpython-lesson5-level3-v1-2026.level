      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "import matplotlib.pyplot as plt\nimport pandas as pd\n\n#Import the data\nchart_one_data = pd.read_csv('US_Gas_Prices.csv')\nchart_two_data = pd.read_csv('gas_prices_by_city.csv')\n\n#CREATE A LINE CHART\nplt.figure()\nplt.plot(chart_one_data['Date'], chart_one_data['US Average'], marker='*', linestyle='-', color='blue')\n\n# Add title and labels to the line chart\nplt.title('US Average Gas Prices')\nplt.xlabel('Date')\nplt.ylabel('Price (US$)')\n\n# Display the line chart\nplt.show()\n\n#CREATE A BAR CHART\nplt.figure()\nplt.bar(chart_two_data['City'], chart_two_data['Price'], color='blue')\n\n# Add title and labels to the bar chart\nplt.xlabel('City')\nplt.ylabel('Price')\n\n# Display the bar chart\nplt.show()",
          "folderId": "0",
          "active": true,
          "open": true
