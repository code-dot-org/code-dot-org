          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 3.8\n# Standard Description: Explain the algorithm for fitting bivariate linear regression models.\n#\n# Rationale: \"Bivariate\" just means \"Two Variables\" (like Height and Weight). \n# How does a computer draw the \"Perfect\" line through a cloud of dots? \n# It uses an algorithm called \"Ordinary Least Squares\" (OLS). This tutorial \n# shows how the algorithm minimizes the distance between the dots and the line.\n\n\"\"\"\nWelcome! How do you draw the \"best\" line through a bunch of scattered points?\nYou can't hit every point exactly, so you try to be as \"close\" as possible \nto all of them.\n\nThe AI uses an algorithm that measures the \"Error\" (the distance from the \npoint to the line) and tries to make the total error as small as possible.\n\"\"\"\n\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom sklearn.linear_model import LinearRegression\n\n# --- PART 1: OUR BIVARIATE DATA ---\n# X = Study Hours, y = Test Score\nX = np.array([1, 2, 3, 4, 5]).reshape(-1, 1)\ny = np.array([60, 72, 65, 85, 90])\n\n# --- PART 2: THE \"LEAST SQUARES\" ALGORITHM ---\nprint(\"--- Part 2: Fitting the Line ---\")\nmodel = LinearRegression()\nmodel.fit(X, y)\n\n# The algorithm finds two numbers:\n# 1. The Intercept (where the line starts)\n# 2. The Slope (how steep the line goes up)\nprint(f\"Algorithm Result: Intercept = {model.intercept_:.2f}, Slope = {model.coef_[0]:.2f}\")\n\n# --- VISUALIZATION ---\nplt.scatter(X, y, color='blue', label='Actual Scores')\nplt.plot(X, model.predict(X), color='red', label='Best Fit Line (OLS)')\n\n# Let's draw the \"Errors\" (Residuals)\nfor i in range(len(X)):\n    plt.plot([X[i], X[i]], [y[i], model.predict(X)[i]], color='gray', linestyle='--', alpha=0.5)\n\nplt.title(\"Bivariate Regression: Minimizing the Error (Dashed Lines)\")\nplt.xlabel(\"Study Hours\")\nplt.ylabel(\"Test Score\")\nplt.legend()\nplt.show()\n\nprint(\"The algorithm minimizes the SQUARE of the length of those dashed lines.\")\nprint(\"If the line moves up or down, the total length of the dashed lines increases.\")\n\n\"\"\"\n--- YOUR TURN ---\nWe've provided a new set of points. \n1. Predict what the \"Slope\" will be (Positive, Negative, or Zero).\n2. Train a LinearRegression model on this data.\n3. Print the Slope (coef_) and see if you were right!\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\n# Data: [Hours spent Gaming, Test Score]\nX_game = np.array([1, 2, 3, 4, 5]).reshape(-1, 1)\ny_score = np.array([95, 85, 70, 60, 50])\n\n# TODO: Create the model\n# TODO: Fit the model\n# TODO: Print the slope (model.coef_)\n",
          "folderId": "0",
