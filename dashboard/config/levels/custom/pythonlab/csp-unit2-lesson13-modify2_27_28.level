        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "place = input(\"Where are you, school or home? \")\nminutes = int(input(\"How many minutes do you have? \"))\n\n# What changed when I swapped the order: \nif place == \"school\":\n    if minutes >= 30:\n        lunch = \"Cafeteria\"\n    else:\n        lunch = \"Snack bar\"\nelse:\n    if minutes >= 30:\n        lunch = \"Sandwich\"\n    else:\n        lunch = \"Leftovers\"\n\nprint(\"Lunch: \" + lunch)",
          "folderId": "0",
          "active": false
        }
