          "id": "0",
          "name": "main.py",
          "contents": "from sklearn.linear_model import LinearRegression\n\n# Input features: [marketing_budget, social_media_posts]\n# TODO 1: Add the remaining training data inputs\ninputs = [[5, 15]]\n\n# Output: opening weekend box office revenue\n# TODO 2: Add the remaining training data outputs\noutputs = [6]\n\nmodel = LinearRegression()\n\n# TODO 3: Fit the model to the inputs and outputs\n\n# Make a prediction for a new movie\nmarketing = int(input(\"Enter marketing budget (in millions of dollars): \"))\nsocial_media = int(input(\"Enter number of social media posts (in thousands): \"))\nprediction = model.predict([[marketing, social_media]])\n\nprint(\"Predicted opening weekend (in millions of dollars):\", round(prediction[0]))",
