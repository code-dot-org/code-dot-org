          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 5.12\n# Standard Description: Explain the concepts of 'agent' and 'action' in reinforcement learning.\n#\n# Rationale: Reinforcement Learning (RL) is like training a dog with treats. \n# It doesn't have a \"key\" of answers; it just has rewards and punishments. \n# This tutorial uses the concept of a \"Fish Battle\" to explain the two \n# main parts of RL: The Agent and the Action.\n\n\"\"\"\nWelcome! Today we are learning about Reinforcement Learning (RL). \nIn RL, we don't tell the AI the answer. Instead, we let it play a game \nand give it points for winning.\n\nThink of a \"Fish Battle\" game:\n1. The Agent: The AI player (the Fish).\n2. The Action: The move the AI makes (using a Skill like 'Water Gun').\n3. The Reward: Getting points for winning the battle.\n\"\"\"\n\nimport random\n\nclass FishAgent:\n    \"\"\"The 'Agent' is the AI character that makes decisions.\"\"\"\n    def __init__(self, name):\n        self.name = name\n        self.points = 0\n    \n    def choose_action(self):\n        \"\"\"The 'Action' is the specific move the agent chooses.\"\"\"\n        actions = [\"Bubbles\", \"Tail Whip\", \"Water Gun\"]\n        choice = random.choice(actions)\n        return choice\n\n# --- THE SIMULATION ---\nprint(\"--- Reinforcement Learning: The Fish Battle ---\")\n\n# 1. Create our Agent\nmy_fish = FishAgent(name=\"Bubbles\")\n\n# 2. Let the Agent take Actions in the environment\nfor turn in range(1, 6):\n    action = my_fish.choose_action()\n    \n    # Let's say \"Water Gun\" is a good move that gets a reward\n    if action == \"Water Gun\":\n        reward = 10\n        my_fish.points += reward\n        outcome = \"CRITICAL HIT! +10 Points (Reward)\"\n    else:\n        reward = 0\n        outcome = \"It was okay. +0 Points\"\n        \n    print(f\"Turn {turn}: {my_fish.name} used {action}. {outcome}\")\n\nprint(f\"\\nFinal Score: {my_fish.points}\")\nprint(\"If we did this 1,000 times, the Agent would 'Learn' to use Water Gun every time!\")\n\n\"\"\"\n--- YOUR TURN ---\nWe've added a new move called \"Deep Dive\" which gives a HUGE reward (+50).\n1. Add \"Deep Dive\" to the 'actions' list in the choose_action function.\n2. Add an 'if' statement to give the fish 50 points if it uses \"Deep Dive\".\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\nclass SmartFish:\n    def __init__(self):\n        self.score = 0\n        \n    def act(self):\n        # TODO: Add \"Deep Dive\" to this list\n        moves = [\"Bubbles\", \"Tail Whip\"]\n        return random.choice(moves)\n\n# TODO: Create a loop and give rewards for \"Deep Dive\"!\n",
          "folderId": "0",
          "active": true
        }
