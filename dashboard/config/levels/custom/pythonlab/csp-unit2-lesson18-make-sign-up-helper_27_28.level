          "name": "main.py",
          "contents": "# Guard the Gate\n# The guardian only lets visitors through if they say one of the secret passwords\n\nprint(\"A guardian blocks your path.\")\nprint(\"Speak the secret password to pass.\")\npassword = input(\"Password: \")",
