      "contents": "import unittest\nfrom unittest_runner import ValidationProtocol\n\nclass SampleTest(unittest.TestCase):\n\n  def test_validation_protocol(self):\n    \"\"\"Test can get first line from main\"\"\"\n    lines = ValidationProtocol().get_stdout_logs()\n    assert lines[0] == \"stage is 400x400\"\n  ",
