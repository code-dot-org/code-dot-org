        "2": {
          "id": "2",
          "name": "oo_program.py",
          "contents": "from theater import Color, Font, FontStyle, Image, Instrument, Scene, play_scenes\nfrom helpers import chime\n\ndef play_oo_scene():\n\n  # --- Scene 1: shapes, strokes and fills ----------------------------------\n  shapes = Scene()\n  shapes.clear(\"ivory\")\n  \n  shapes.set_text_color(\"navy\")\n  shapes.set_text_height(28)\n  shapes.set_text_style('serif', 'bold')\n  shapes.draw_text(\"Theater check\", 20, 45)\n  # Sound starts where the last pause left off, so a note placed just before a\n  # pause plays over the frame that pause shows.\n  shapes.play_note(60, 0.6)\n  shapes.pause(0.6)\n  \n  # x, y is the top left corner of the box the shape fits in.\n  shapes.set_fill_color(\"turquoise\")\n  shapes.set_stroke_color(\"teal\")\n  shapes.set_stroke_width(4)\n  shapes.draw_rectangle(30, 80, 150, 90)\n  shapes.play_note(62, 0.4)\n  shapes.pause(0.4)\n  \n  shapes.set_fill_color(Color(255, 140, 0))\n  shapes.draw_ellipse(220, 80, 150, 90)\n  shapes.play_note(64, 0.4)\n  shapes.pause(0.4)\n  \n  # Outline only, then fill only.\n  shapes.remove_fill_color()\n  shapes.set_stroke_color(\"purple\")\n  shapes.draw_regular_polygon(105, 250, 6, 55)\n  shapes.play_note(65, 0.4)\n  shapes.pause(0.4)\n  \n  shapes.set_fill_color(\"#e91e63\")\n  shapes.remove_stroke_color()\n  shapes.draw_regular_polygon(295, 250, 3, 55)\n  shapes.play_note(67, 0.4)\n  shapes.pause(0.4)\n  \n  shapes.set_stroke_color(\"black\")\n  shapes.set_stroke_width(3)\n  shapes.draw_line(30, 330, 370, 330)\n  # A closed triangle from a flat list of x, y pairs.\n  shapes.set_fill_color(\"gold\")\n  shapes.draw_shape([60, 390, 200, 345, 340, 390], True)\n  # Notes with no pause between them start together, so these three make a chord.\n  shapes.play_note(60, 0.8)\n  shapes.play_note(64, 0.8)\n  shapes.play_note(67, 0.8)\n  shapes.pause(0.8)\n  \n  # --- Scene 2: fonts, styles and rotation --------------------------------\n  text = Scene()\n  text.clear(\"white\")\n  text.set_text_height(24)\n  text.set_text_color(\"black\")\n  \n  # draw_text puts the baseline at y, so each line steps down by more than the\n  # text height.\n  for index, (font, label) in enumerate(\n    [(Font.SANS, \"sans\"), (Font.SERIF, \"serif\"), (Font.MONO, \"mono\")]\n  ):\n    text.set_text_style(font, FontStyle.NORMAL)\n    text.draw_text(f\"{label} normal\", 25, 60 + index * 40)\n  \n  text.set_text_style(Font.SANS, FontStyle.BOLD)\n  text.draw_text(\"sans bold\", 25, 200)\n  text.set_text_style(Font.SANS, FontStyle.ITALIC)\n  text.draw_text(\"sans italic\", 25, 240)\n  text.set_text_style(Font.SANS, FontStyle.BOLD_ITALIC)\n  text.draw_text(\"sans bold italic\", 25, 280)\n  # The bass instrument under a piano note, both held for the frame.\n  text.play_note(48, 0.7, Instrument.BASS)\n  text.play_note(72, 0.7)\n  text.pause(0.7)\n  \n  # Rotation is clockwise, about the point given.\n  text.set_text_style(Font.SANS, FontStyle.BOLD)\n  text.set_text_color(\"red\")\n  text.set_text_height(20)\n  for angle in range(0, 360, 45):\n    text.draw_text(\"spin\", 200, 360, angle)\n  text.play_note(50, 0.7, Instrument.BASS)\n  text.pause(0.7)\n  \n  # --- Scene 3: images ----------------------------------------------------\n  images = Scene()\n  images.clear(\"beige\")\n  \n  # No image files can reach Python Lab's filesystem yet, so build one by pixel.\n  swatch = Image(40, 40)\n  for x in range(40):\n    for y in range(40):\n      swatch.set_pixel(x, y, Color(x * 6, y * 6, 200))\n  \n  # size sets the width and scales the height to match.\n  images.draw_image(swatch, 30, 40, size=120)\n  # width and height together stretch it instead.\n  images.draw_image(swatch, 190, 40, width=180, height=90)\n  # play_sound takes samples a program computed itself, no instrument involved.\n  images.play_sound(chime(0.5, 880))\n  images.pause(0.5)\n  \n  # Rotation pivots about the top left corner, so leave room for the swing.\n  images.draw_image(swatch, 200, 260, size=90, rotation=30)\n  images.set_text_color(\"black\")\n  images.set_text_height(18)\n  images.set_text_style(Font.MONO, FontStyle.NORMAL)\n  images.draw_text(f\"pixel at (0,0): {swatch.get_pixel(0, 0).get_color()}\", 20, 380)\n  images.play_sound(chime(0.6, 440))\n  images.pause(0.6)\n  \n  print(f\"stage is {shapes.get_width()}x{shapes.get_height()}\")\n  print(\"playing 3 object-oriented scenes\")\n  \n  play_scenes(shapes, text, images)\n  \n  print(\"done\")",
          "folderId": "0",
          "active": false
        },
        "3": {
          "id": "3",
          "name": "functional_program.py",
          "contents": "from helpers import chime\nfrom theater import *\n\ndef play_functional_scene():\n  # --- Part 1: shapes, strokes and fills ----------------------------------\n  scene.clear(\"ivory\")\n  \n  scene.set_text_color(\"navy\")\n  scene.set_text_height(28)\n  scene.set_text_style('serif', 'bold')\n  scene.draw_text(\"Theater check\", 20, 45)\n  # Sound starts where the last pause left off, so a note placed just before a\n  # pause plays over the frame that pause shows.\n  play_note(60, 0.6)\n  scene.pause(0.6)\n  \n  # x, y is the top left corner of the box the shape fits in.\n  set_fill_color(\"turquoise\")\n  set_stroke_color(\"teal\")\n  set_stroke_width(4)\n  draw_rectangle(30, 80, 150, 90)\n  play_note(62, 0.4)\n  pause(0.4)\n  \n  scene.set_fill_color(Color(255, 140, 0))\n  scene.draw_ellipse(220, 80, 150, 90)\n  scene.play_note(64, 0.4)\n  scene.pause(0.4)\n  \n  # Outline only, then fill only.\n  scene.remove_fill_color()\n  scene.set_stroke_color(\"purple\")\n  scene.draw_regular_polygon(105, 250, 6, 55)\n  scene.play_note(65, 0.4)\n  scene.pause(0.4)\n  \n  scene.set_fill_color(\"#e91e63\")\n  scene.remove_stroke_color()\n  scene.draw_regular_polygon(295, 250, 3, 55)\n  scene.play_note(67, 0.4)\n  scene.pause(0.4)\n  \n  scene.set_stroke_color(\"black\")\n  scene.set_stroke_width(3)\n  scene.draw_line(30, 330, 370, 330)\n  # A closed triangle from a flat list of x, y pairs.\n  scene.set_fill_color(\"gold\")\n  scene.draw_shape([60, 390, 200, 345, 340, 390], True)\n  # Notes with no pause between them start together, so these three make a chord.\n  scene.play_note(60, 0.8)\n  scene.play_note(64, 0.8)\n  scene.play_note(67, 0.8)\n  scene.pause(0.8)\n  \n  # --- Part 2: fonts, styles and rotation ---------------------------------\n  # clear() paints over everything, which is what separated the scenes before.\n  scene.clear(\"white\")\n  scene.set_text_height(24)\n  scene.set_text_color(\"black\")\n  \n  # draw_text puts the baseline at y, so each line steps down by more than the\n  # text height.\n  for index, (font, label) in enumerate(\n    [(Font.SANS, \"sans\"), (Font.SERIF, \"serif\"), (Font.MONO, \"mono\")]\n  ):\n    scene.set_text_style(font, FontStyle.NORMAL)\n    scene.draw_text(f\"{label} normal\", 25, 60 + index * 40)\n  \n  scene.set_text_style(Font.SANS, FontStyle.BOLD)\n  scene.draw_text(\"sans bold\", 25, 200)\n  scene.set_text_style(Font.SANS, FontStyle.ITALIC)\n  scene.draw_text(\"sans italic\", 25, 240)\n  scene.set_text_style(Font.SANS, FontStyle.BOLD_ITALIC)\n  scene.draw_text(\"sans bold italic\", 25, 280)\n  # The bass instrument under a piano note, both held for the frame.\n  scene.play_note(48, 0.7, Instrument.BASS)\n  scene.play_note(72, 0.7)\n  scene.pause(0.7)\n  \n  # Rotation is clockwise, about the point given.\n  scene.set_text_style(Font.SANS, FontStyle.BOLD)\n  scene.set_text_color(\"red\")\n  scene.set_text_height(20)\n  for angle in range(0, 360, 45):\n    scene.draw_text(\"spin\", 200, 360, angle)\n  scene.play_note(50, 0.7, Instrument.BASS)\n  scene.pause(0.7)\n  \n  # --- Part 3: images -----------------------------------------------------\n  scene.clear(\"beige\")\n  \n  # No image files can reach Python Lab's filesystem yet, so build one by pixel.\n  swatch = Image(40, 40)\n  for x in range(40):\n    for y in range(40):\n      swatch.set_pixel(x, y, Color(x * 6, y * 6, 200))\n  \n  # size sets the width and scales the height to match.\n  scene.draw_image(swatch, 30, 40, size=120)\n  # width and height together stretch it instead.\n  scene.draw_image(swatch, 190, 40, width=180, height=90)\n  # play_sound takes samples a program computed itself, no instrument involved.\n  scene.play_sound(chime(0.5, 880))\n  scene.pause(0.5)\n  \n  # Rotation pivots about the top left corner, so leave room for the swing.\n  scene.draw_image(swatch, 200, 260, size=90, rotation=30)\n  scene.set_text_color(\"black\")\n  scene.set_text_height(18)\n  scene.set_text_style(Font.MONO, FontStyle.NORMAL)\n  scene.draw_text(f\"pixel at (0,0): {swatch.get_pixel(0, 0).get_color()}\", 20, 380)\n  scene.play_sound(chime(0.6, 440))\n  scene.pause(0.6)\n  \n  print(f\"stage is {scene.get_width()}x{scene.get_height()}\")\n  print(\"playing 1 functional scene\")\n  \n  play()",
          "folderId": "0",
          "active": false
        },
        "4": {
          "id": "4",
          "name": "helpers.py",
          "contents": "import math\nSAMPLE_RATE = 44100\n\ndef chime(seconds, frequency):\n  \"\"\"A fading sine wave, as a list of samples between -1.0 and 1.0.\"\"\"\n  samples = []\n  for index in range(int(seconds * SAMPLE_RATE)):\n    time = index / SAMPLE_RATE\n    fade = math.exp(-4 * time)\n    samples.append(0.7 * fade * math.sin(2 * math.pi * frequency * time))\n  return samples",
          "folderId": "0",
          "active": false
        }
