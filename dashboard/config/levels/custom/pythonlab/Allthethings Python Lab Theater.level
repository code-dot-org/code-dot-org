        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from oo_program import play_oo_scene\nfrom functional_program import play_functional_scene\n\n# Change this to false to run the object-oriented version of the program\nUSE_FUNCTIONAL = True\n\nif USE_FUNCTIONAL:\n  play_functional_scene()\nelse:\n  play_oo_scene()",
          "folderId": "0",
          "active": true
