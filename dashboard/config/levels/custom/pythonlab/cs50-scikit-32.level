        "0": {
          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standards: 6.4 (Bootstrapping) & 6.7 (Uncertainty)\n# Standard Descriptions:\n#   6.4: Explain definition, purpose and application of bootstrapping.\n#   6.7: Explain the sources of uncertainty in a prediction model.\n#\n# Rationale: AI isn't 100% certain. If you train a model on 10 people, \n# how do you know it will work on the next 1,000? Bootstrapping is a \n# technique where we \"re-sample\" our data to see how much our results \n# wiggle. This wiggling is our \"Uncertainty\".\n\n\"\"\"\nWelcome! How \"sure\" are you about your grade?\nIf you take 10 practice tests and get a 90 on every single one, you are \nvery certain. If you get a 60, then a 100, then a 70, you are uncertain.\n\nIn AI, we use \"Bootstrapping\" (sampling with replacement) to measure this \nuncertainty. It's like taking multiple \"mini-tests\" from the same data.\n\"\"\"\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\n\n# --- OUR SMALL DATASET ---\n# Let's say we measured the height of 10 people.\nheights = np.array([62, 65, 68, 70, 72, 64, 66, 69, 71, 63])\nprint(f\"Original Average Height: {heights.mean():.2f}\")\n\n# --- THE BOOTSTRAP PROCESS ---\nprint(\"\\n--- Running 1,000 Bootstrap Samples ---\")\n# Bootstrapping means picking 10 people from our list, but \n# we can pick the SAME person twice (Sampling with Replacement).\nbootstrap_means = []\n\nfor i in range(1000):\n    # 'replace=True' is the key to bootstrapping!\n    sample = np.random.choice(heights, size=len(heights), replace=True)\n    bootstrap_means.append(sample.mean())\n\n# --- VISUALIZATION ---\nplt.hist(bootstrap_means, bins=30, color='skyblue', edgecolor='black')\nplt.axvline(heights.mean(), color='red', linestyle='--', label='Original Mean')\nplt.title(\"Bootstrap Distribution: How much does the average 'wiggle'?\")\nplt.xlabel(\"Average Height (Inches)\")\nplt.ylabel(\"Frequency\")\nplt.legend()\nplt.show()\n\n# --- CALCULATING UNCERTAINTY ---\n# We can find the \"Confidence Interval\" (The range where 95% of results fall)\nlower = np.percentile(bootstrap_means, 2.5)\nupper = np.percentile(bootstrap_means, 97.5)\n\nprint(f\"We are 95% certain the TRUE average height is between {lower:.2f} and {upper:.2f}\")\nprint(\"This range represents our UNCERTAINTY. A wider range means more uncertainty!\")\n\n\"\"\"\n--- YOUR TURN ---\nWe have data from a runner's last 5 miles: [8, 9, 7, 8, 10] minutes.\n1. Run a bootstrap by choosing 5 numbers from that list (with replacement).\n2. Do this 3 times and write down the averages. \n3. Did the average change each time?\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\nmiles = [8, 9, 7, 8, 10]\n\n# TODO: Take a bootstrap sample (pick 5 with replacement)\n# sample1 = np.random.choice(miles, 5, replace=True)\n# print(f\"Sample 1 Average: {np.mean(sample1)}\")\n\n# TODO: Do it again!\n",
          "folderId": "0",
