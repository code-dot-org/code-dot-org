          "id": "0",
          "name": "main.py",
          "contents": "import csv\nimport random\nimport re\n\nmodel = {}\n\n\ndef tokenize(text):\n  return text\n\n\ndef learn(tokens):\n  return tokens\n\n\ndef generate(start):\n  return start\n\n\ndef detokenize(tokens):\n  return tokens\n\n\ndef main():\n\n  # Read data\n  f = open(\"curiosities.csv\")\n  curiosities = [row[\"question\"] for row in csv.DictReader(f)]\n  f.close()\n\n  # Learn from data\n  for question in curiosities:\n    tokens = tokenize(question)\n    learn(tokens)\n\n  # Generate text\n  text = detokenize(generate(\"Why\"))\n  print(text)\n\n\nmain()",
