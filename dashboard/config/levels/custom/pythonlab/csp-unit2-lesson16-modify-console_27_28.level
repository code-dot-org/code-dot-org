          "id": "0",
          "name": "main.py",
          "contents": "num = 2\nif num % 2 == 0:\n    print(str(num) + \" is even\")\nelse:\n    print(str(num) + \" is odd\")\n\nnum = 3\nif num % 2 == 0:\n    print(str(num) + \" is even\")\nelse:\n    print(str(num) + \" is odd\")\n\nnum = 4\nif num % 2 == 0:\n    print(str(num) + \" is even\")\nelse:\n    print(str(num) + \" is odd\")\n\nnum = 5\nif num % 2 == 0:\n    print(str(num) + \" is even\")\nelse:\n    print(str(num) + \" is odd\")\n\n",
