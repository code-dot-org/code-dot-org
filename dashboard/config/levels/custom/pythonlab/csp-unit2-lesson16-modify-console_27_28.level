      "id": "1",
      "name": "test.py",
      "contents": "import ast\nfrom unittest import TestCase\nfrom unittest_runner import ValidationProtocol\n\n\nclass TestInvestigateModify(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Run the student's code and parse its structure\"\"\"\n        cls.stdout = ValidationProtocol().get_stdout_logs()\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n        cls.tree = ast.parse(cls.source)\n        cls.while_nodes = [n for n in ast.walk(cls.tree) if isinstance(n, ast.While)]\n\n    def test_uses_while_loop(self):\n        \"\"\"Uses a while loop instead of repeating the if/else block\"\"\"\n        self.assertTrue(\n            self.while_nodes,\n            \"We didn't find a while loop in your code. Replace the repeated if/else blocks with a single while loop.\"\n        )\n\n    def test_while_loop_has_required_parts(self):\n        \"\"\"The while loop has a starting value, a condition, and an update\"\"\"\n        if not self.while_nodes:\n            self.skipTest(\"No while loop found yet -- add one before checking its parts.\")\n\n        while_node = self.while_nodes[0]\n\n        condition = while_node.test\n        condition_vars = {n.id for n in ast.walk(condition) if isinstance(n, ast.Name)}\n        self.assertTrue(\n            isinstance(condition, ast.Compare) and condition_vars,\n            \"Your while loop's condition should compare a variable to a value, like `while num <= 5:`. Check what you wrote after `while`.\"\n        )\n\n        body_nodes = []\n        for stmt in while_node.body:\n            body_nodes.extend(ast.walk(stmt))\n        updated_vars = set()\n        for node in body_nodes:\n            if isinstance(node, ast.Assign):\n                updated_vars |= {t.id for t in node.targets if isinstance(t, ast.Name)}\n            elif isinstance(node, ast.AugAssign) and isinstance(node.target, ast.Name):\n                updated_vars.add(node.target.id)\n        self.assertTrue(\n            condition_vars & updated_vars,\n            \"We didn't find the loop's condition variable being updated inside the loop. Make sure you're changing the same variable you check in the while condition (e.g., num = num + 1) -- otherwise the loop runs forever or never runs.\"\n        )\n\n        loop_line = while_node.lineno\n        initialized_vars = set()\n        for node in ast.walk(self.tree):\n            if getattr(node, \"lineno\", None) is not None and node.lineno < loop_line:\n                if isinstance(node, ast.Assign):\n                    initialized_vars |= {t.id for t in node.targets if isinstance(t, ast.Name)}\n                elif isinstance(node, ast.AugAssign) and isinstance(node.target, ast.Name):\n                    initialized_vars.add(node.target.id)\n        self.assertTrue(\n            condition_vars & initialized_vars,\n            \"We didn't find your loop's variable being set to a starting value before the while loop. Make sure you initialize it (e.g., num = 2) above your while loop.\"\n        )\n\n    def test_prints_even_odd_for_each_number(self):\n        \"\"\"Prints whether each number from 2 to 5 is even or odd\"\"\"\n        if not self.while_nodes:\n            self.skipTest(\"Add your while loop first -- we'll check the output once the loop is in place.\")\n        if not self.stdout:\n            self.skipTest(\"Nothing printed at all. Make sure your loop still prints a result for each number.\")\n        expected = [\"2 is even\", \"3 is odd\", \"4 is even\", \"5 is odd\"]\n        self.assertEqual(\n            self.stdout,\n            expected,\n            f\"Expected to see whether 2, 3, 4, and 5 are each even or odd, in that order -- but we got {self.stdout}. \"\n            \"Check your loop's starting value, ending condition, and that num is updating each pass.\"\n        )",
      "folderId": "0",
      "active": false,
      "type": "validation"
    }
  },
