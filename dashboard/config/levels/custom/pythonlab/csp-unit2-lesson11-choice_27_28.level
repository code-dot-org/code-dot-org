    "validation_file": {
      "id": "2",
      "name": "test.py",
      "contents": "import re\nfrom unittest import TestCase\nfrom unittest_runner import ValidationProtocol\n\nSENSOR_IF = re.compile(r'^\\s*if\\s+.*\\b(can_move|is_on_bucket|has_paint|is_on_paint)\\s*\\(')\nSTARTER_COMMENTS = {\n    \"# Painter setup: the Painter starts in the top-left corner, facing east.\",\n    \"# Add your code below.\",\n}\n\n\ndef read_lines():\n    with open('main.py') as main_file:\n        return main_file.read().splitlines()\n\n\nclass TestChoiceLevel(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Run the student's code once and save the results\"\"\"\n        cls.log = ValidationProtocol().get_neighborhood_log()\n        cls.painter = cls.log.painter_logs[0] if cls.log.painter_logs else None\n\n    def find_if_index(self):\n        for i, line in enumerate(read_lines()):\n            if SENSOR_IF.match(line):\n                return i\n        return None\n\n    def test_if_checks_the_neighborhood(self):\n        \"\"\"Your if checks something in the Neighborhood\"\"\"\n        if self.find_if_index() is None:\n            self.fail(\"Add an if that checks one of these: can_move(), is_on_bucket(), has_paint(), or is_on_paint().\")\n\n    def test_uses_else(self):\n        \"\"\"Your program uses an else branch\"\"\"\n        if not re.search(r'^\\s*else\\s*:', \"\\n\".join(read_lines()), re.MULTILINE):\n            self.fail(\"Add an else branch after your if, with an indented line that tells the Painter what to do.\")\n\n    def test_comment_explains_the_check(self):\n        \"\"\"You explain what the Painter is checking for\"\"\"\n        idx = self.find_if_index()\n        if idx is None:\n            self.skipTest(\"Add your if first, then we can check the comment above it.\")\n        lines = read_lines()\n        j = idx - 1\n        while j >= 0 and not lines[j].strip():\n            j -= 1\n        above = lines[j].strip() if j >= 0 else \"\"\n        if not above.startswith('#') or above in STARTER_COMMENTS or len(above.lstrip('#').strip()) < 10:\n            self.fail(\"Put a comment right above your if that explains what the Painter is checking for and why.\")\n\n    def test_painter_changed(self):\n        \"\"\"Your Painter ends in a different state than it started\"\"\"\n        if self.painter is None:\n            self.skipTest(\"Your code didn't run far enough to check yet. Make sure the starter code is still there and run again.\")\n        p = self.painter\n        start = (p.starting_position.x, p.starting_position.y, p.starting_position.direction)\n        end = (p.ending_position.x, p.ending_position.y, p.ending_position.direction)\n        if start == end and p.ending_paint_count == 0:\n            self.fail(\"Your Painter ends exactly where it started, facing the same way, with no paint. Make your if/else move, turn, or take paint.\")",
      "folderId": "0",
      "active": false,
      "type": "validation"
    },
    "teacher_markdown": "update"
