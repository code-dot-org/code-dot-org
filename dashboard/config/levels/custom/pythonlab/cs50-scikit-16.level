          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 2.7\n# Standard Description: Explain various sampling plans, including subsampling.\n#\n# Rationale: Sometimes a dataset is too big to work with, or it's \"unbalanced\" \n# (too many examples of one thing). Sampling is the technique of picking a \n# subset of data that accurately represents the whole group. We use \n# \"Random Sampling\" to avoid bias.\n\n\"\"\"\nWelcome! Have you ever tasted a single spoonful of soup to see if it needs \nmore salt? You don't have to eat the whole pot! That spoonful is a \"Sample\".\n\nIn AI, we use sampling when:\n1. The data is too huge for our computer to handle (Subsampling).\n2. We want to test our AI on a small group first.\n\"\"\"\n\nimport pandas as pd\nimport numpy as np\n\n# --- OUR GIANT DATASET ---\n# Let's create a \"giant\" dataset of 1,000 students.\nnp.random.seed(42)\ngiant_df = pd.DataFrame({\n    'Student_ID': range(1, 1001),\n    'Grade': np.random.randint(60, 100, 1000),\n    'Subject': np.random.choice(['Math', 'Science', 'History', 'Art'], 1000)\n})\n\nprint(f\"Total rows in giant dataset: {len(giant_df)}\")\nprint(f\"Average Grade of ALL students: {giant_df['Grade'].mean():.2f}\")\nprint(\"\\n\")\n\n# --- TECHNIQUE 1: SIMPLE RANDOM SAMPLING ---\nprint(\"--- Technique 1: Simple Random Sample ---\")\n# We'll take a sample of 50 students (5% of the data).\nsample_df = giant_df.sample(n=50, random_state=42)\n\nprint(f\"Total rows in sample: {len(sample_df)}\")\nprint(f\"Average Grade of the SAMPLE: {sample_df['Grade'].mean():.2f}\")\nprint(\"Notice: The sample average is very close to the real average!\")\nprint(\"\\n\")\n\n# --- TECHNIQUE 2: FRACTIONAL SAMPLING ---\nprint(\"--- Technique 2: Fractional Sample (Subsampling) ---\")\n# Instead of a number, we can ask for a percentage (e.g., 10%).\nsubsample_df = giant_df.sample(frac=0.1, random_state=42)\nprint(f\"Total rows in 10% subsample: {len(subsample_df)}\")\n\n\"\"\"\n--- YOUR TURN ---\nWe have a dataset of 200 \"Website Visits\". \n1. Use .sample() to take a 25% (frac=0.25) sample of the visits.\n2. Calculate the mean 'Duration' of your sample.\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\nvisits = pd.DataFrame({\n    'Visit_ID': range(200),\n    'Duration': np.random.randint(10, 300, 200) # Seconds on site\n})\n\n# TODO: Take a 25% sample of 'visits'\n# my_sample = ...\n\n# TODO: Print the mean Duration of your sample\n# print(my_sample['Duration'].mean())\n",
          "folderId": "0",
