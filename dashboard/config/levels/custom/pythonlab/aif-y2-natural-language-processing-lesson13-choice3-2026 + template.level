          "contents": "import csv\nimport random\nimport re\n\nmodel = {}\n\n\ndef tokenize(text):\n  return text\n\n\ndef learn(tokens):\n  return tokens\n\n\ndef generate(start):\n  return start\n\n\ndef detokenize(tokens):\n  return tokens\n\n\ndef main():\n\n  # Read data\n  f = open(\"invitations.csv\")\n  invitations = [row[\"invitation\"] for row in csv.DictReader(f)]\n  f.close()\n\n  # Learn from data\n  for invitation in invitations:\n    tokens = tokenize(invitation)\n    learn(tokens)\n\n  # Generate text\n  text = detokenize(generate(\"Please\"))\n  print(text)\n\n\nmain()",
