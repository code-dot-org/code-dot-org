      "name": "test.py",
      "contents": "import contextlib\nimport io\nfrom unittest import TestCase\n\n\nclass TestModifyRandomBonus(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Run the student's code once and capture int variables + output\"\"\"\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n        cls.namespace = {}\n        stdout = io.StringIO()\n        cls.run_error = None\n        try:\n            with contextlib.redirect_stdout(stdout):\n                exec(compile(cls.source, \"main.py\", \"exec\"), cls.namespace)\n        except Exception as e:\n            cls.run_error = e\n        cls.stdout_text = stdout.getvalue()\n\n    def _int_vars(self):\n        return {\n            name: value for name, value in self.namespace.items()\n            if isinstance(value, int) and not isinstance(value, bool) and not name.startswith(\"__\")\n        }\n\n    def test_has_score_bonus_and_total(self):\n        \"\"\"Creates a starting score, a bonus, and a total that's their sum\"\"\"\n        self.assertIsNone(\n            self.run_error,\n            f\"Your program raised an error while running: {self.run_error}.\"\n        )\n        int_vars = self._int_vars()\n        self.assertGreaterEqual(\n            len(int_vars),\n            3,\n            f\"Expected at least 3 whole-number variables (score, bonus, total), but found: {list(int_vars.keys())}.\"\n        )\n        # Look for any pair of variables whose sum equals a third variable --\n        # this is the actual requirement, regardless of what the student\n        # named each one or what starting score they chose.\n        names = list(int_vars.keys())\n        found_valid_trio = False\n        for i, name_a in enumerate(names):\n            for name_b in names:\n                if name_a == name_b:\n                    continue\n                expected_sum = int_vars[name_a] + int_vars[name_b]\n                for name_total in names:\n                    if name_total in (name_a, name_b):\n                        continue\n                    if int_vars[name_total] == expected_sum:\n                        found_valid_trio = True\n        self.assertTrue(\n            found_valid_trio,\n            f\"We found these whole-number variables: {int_vars}, but couldn't find three where one equals the sum of the other two. \"\n            \"Make sure total = score + bonus.\"\n        )\n\n    def test_prints_score_bonus_and_total(self):\n        \"\"\"Prints the starting score, bonus points, and total\"\"\"\n        if self.run_error is not None:\n            self.skipTest(\"Fix the error above first.\")\n        int_vars = self._int_vars()\n        if len(int_vars) < 3:\n            self.skipTest(\"Create score, bonus, and total variables first -- we'll check they're printed once they exist.\")\n        missing = [name for name, value in int_vars.items() if str(value) not in self.stdout_text]\n        self.assertFalse(\n            missing,\n            f\"These variables' values didn't show up in the printed output: {missing}. \"\n            \"Make sure you print the starting score, bonus points, and total.\"\n        )",
