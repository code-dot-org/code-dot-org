          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standards: 5.11 (Cross Validation) & 5.13 (Under/Overfitting)\n# Standard Descriptions: \n#   5.11: Explain k-fold cross validation and its purpose.\n#   5.13: Explain the concepts of underfitting and overfitting in data modeling.\n#\n# Rationale: Just because an AI gets an answer right doesn't mean it's smart! \n# This tutorial teaches students how to \"test\" their AI on data it hasn't seen before. \n# We'll see how a model can \"overfit\" (memorize the answers) and how we use \n# techniques like Train/Test splitting to catch it.\n\n\"\"\"\nWelcome! How do we know if our AI is actually learning, or just memorizing?\nIf you give a student the exact same questions from their textbook on a test, \nthey might get 100% just by memorizing. To see if they *learned*, you need to \ngive them NEW questions.\n\nIn AI, we call this \"Train/Test Splitting\" and \"Cross-Validation\".\n\"\"\"\n\nfrom sklearn.datasets import load_breast_cancer\nfrom sklearn.model_selection import train_test_split, cross_val_score\nfrom sklearn.tree import DecisionTreeClassifier\nimport matplotlib.pyplot as plt\n\n# --- LOAD DATA ---\ndata = load_breast_cancer()\nX, y = data.data, data.target\n\n# --- PART 1: THE TRAIN/TEST SPLIT ---\nprint(\"--- Part 1: Splitting the Data ---\")\n# We split our data into two piles: \n# 1. Training (to learn from)\n# 2. Testing (to check the final grade)\nX_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)\n\nprint(f\"Total examples: {len(X)}\")\nprint(f\"Training examples: {len(X_train)}\")\nprint(f\"Testing examples: {len(X_test)}\\n\")\n\n# --- PART 2: OVERFITTING ---\nprint(\"--- Part 2: Spotting Overfitting ---\")\n# An \"Overfit\" model is one that is too complex. It memorizes the training data \n# perfectly but fails on the test data.\ncomplex_tree = DecisionTreeClassifier(max_depth=20) # A very deep, complex tree\ncomplex_tree.fit(X_train, y_train)\n\ntrain_score = complex_tree.score(X_train, y_train)\ntest_score = complex_tree.score(X_test, y_test)\n\nprint(f\"Complex Model Score on Training Data: {train_score:.2%}\")\nprint(f\"Complex Model Score on Test Data: {test_score:.2%}\")\nprint(\"If the training score is much higher than the test score, it's OVERFITTING!\\n\")\n\n# --- PART 3: CROSS-VALIDATION (Standard 5.11) ---\nprint(\"--- Part 3: Cross-Validation ---\")\n# Instead of just one test, what if we tested the AI 5 different times \n# on 5 different pieces of data? That's Cross-Validation.\nsimple_tree = DecisionTreeClassifier(max_depth=3)\nscores = cross_val_score(simple_tree, X, y, cv=5)\n\nprint(f\"Scores for each of the 5 tests: {scores}\")\nprint(f\"Average Accuracy: {scores.mean():.2%}\")\n\n# --- VISUALIZATION ---\nplt.bar(range(1, 6), scores, color='skyblue')\nplt.ylim(0.8, 1.0)\nplt.title(\"5-Fold Cross Validation Scores\")\nplt.xlabel(\"Test Run #\")\nplt.ylabel(\"Accuracy Score\")\nplt.show()\n\n\"\"\"\n--- YOUR TURN ---\nWe've set up a Decision Tree for you. Your job is to experiment with the \n'max_depth' to see if you can find the \"Sweet Spot\" between Underfitting \n(too simple) and Overfitting (too complex).\n\n1. Try a 'max_depth' of 1. Is the score good or bad? (This is Underfitting!)\n2. Try a 'max_depth' of 10. Does the gap between train and test scores grow?\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\n# TODO: Change the number 2 to something else!\nmy_tree = DecisionTreeClassifier(max_depth=2) \nmy_tree.fit(X_train, y_train)\n\nprint(f\"\\nTraining Score: {my_tree.score(X_train, y_train):.2%}\")\nprint(f\"Test Score: {my_tree.score(X_test, y_test):.2%}\")\n",
          "folderId": "0",
          "active": true
        }
