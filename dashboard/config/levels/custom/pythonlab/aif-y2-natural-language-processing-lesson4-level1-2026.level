  "properties": {
    "encrypted": "false",
    "long_instructions": "You’re given a program to search a set of sites for a keyword. Complete the program by finishing the `get_frequencies` function.\r\n\r\n**☑️ Do This:**\r\n\r\nComplete the `get_frequencies` function. It should build the `frequencies` dictionary, such that each word is a key and each key’s value is the number of times that words appears in `text`.\r\n\r\nThen, test your program! Try a few keywords (e.g. “pizza”, “soup”, “chicken”, “taco”, “shrimp”, or anything else you’d like) and observe what results you get.",
    "offer_browser_tts": "false",
    "submittable": "true",
    "disable_edit_run_for_submission": "false",
    "hide_share_and_remix": "false",
    "enable_micro_bit": "false",
    "widget_view": "false",
    "widget_view_allow_show_code": "false",
    "predict_settings": {
      "isPredictLevel": false
    },
    "ai_tutor_prompt_settings": {
