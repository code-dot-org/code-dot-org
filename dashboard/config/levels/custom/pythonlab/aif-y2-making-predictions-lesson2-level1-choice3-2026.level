          "id": "0",
          "name": "main.py",
          "contents": "from sklearn.linear_model import LinearRegression\n\n# Input features: [rows, stitch types]\n# TODO 1: Add the remaining training data inputs\ninputs = [[100, 8]]\n\n# Output: hours of knitting\n# TODO 2: Add the remaining training data outputs\noutputs = [6]\n\nmodel = LinearRegression()\n\n# TODO 3: Fit the model to the inputs and outputs\n\n# Make a prediction for a new knitting project\nrows = int(input(\"Enter number of rows of stitches: \"))\nstitch_types = int(input(\"Enter number of stitch types: \"))\nprediction = model.predict([[rows, stitch_types]])\n\nprint(\"Predicted hours of knitting: \", round(prediction[0]))\n",
