      "id": "1",
      "name": "test.py",
      "contents": "import contextlib\nimport io\nfrom unittest import TestCase\n\n\nclass TestModifyTwoDice(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Run the student's code once and capture both the actual\n        variable values and the printed output.\"\"\"\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n        cls.namespace = {}\n        stdout = io.StringIO()\n        cls.run_error = None\n        try:\n            with contextlib.redirect_stdout(stdout):\n                exec(compile(cls.source, \"main.py\", \"exec\"), cls.namespace)\n        except Exception as e:\n            cls.run_error = e\n        cls.stdout_text = stdout.getvalue()\n\n    def _int_variables(self):\n        return {\n            name: value for name, value in self.namespace.items()\n            if isinstance(value, int) and not isinstance(value, bool) and not name.startswith(\"__\")\n        }\n\n    def test_prints_two_separate_rolls(self):\n        \"\"\"Creates two separate dice roll variables, each between 1 and 6, and prints both\"\"\"\n        int_vars = self._int_variables()\n        roll_like_vars = {name: v for name, v in int_vars.items() if \"roll\" in name.lower()}\n        self.assertGreaterEqual(\n            len(roll_like_vars),\n            2,\n            f\"Expected at least 2 roll variables, but found: {list(roll_like_vars.keys())}. \"\n            \"Make sure you create a second variable to store another random roll.\"\n        )\n        out_of_range = {name: v for name, v in roll_like_vars.items() if not (1 <= v <= 6)}\n        self.assertFalse(\n            out_of_range,\n            f\"These roll variable(s) are outside 1-6: {out_of_range}. Make sure both use randint(1, 6).\"\n        )\n        for name, value in roll_like_vars.items():\n            self.assertIn(\n                str(value),\n                self.stdout_text,\n                f\"{name}'s value ({value}) wasn't found anywhere in the printed output. Make sure you print both rolls.\"\n            )\n\n    def test_prints_correct_total(self):\n        \"\"\"Stores and prints a total equal to the sum of the two rolls\"\"\"\n        int_vars = self._int_variables()\n        roll_values = [v for name, v in int_vars.items() if \"roll\" in name.lower()]\n        total_vars = {name: v for name, v in int_vars.items() if \"total\" in name.lower()}\n        if len(roll_values) < 2:\n            self.skipTest(\"Add both roll variables first -- we'll check the total once they're in place.\")\n        self.assertTrue(\n            total_vars,\n            \"We didn't find a variable with 'total' in its name. Store the sum of both rolls in a total variable.\"\n        )\n        expected_total = sum(roll_values)\n        matches_expected = any(v == expected_total for v in total_vars.values())\n        self.assertTrue(\n            matches_expected,\n            f\"Expected a total of {expected_total} (the sum of your rolls {roll_values}), but found: {total_vars}.\"\n        )\n        total_value = next(iter(total_vars.values()))\n        self.assertIn(\n            str(total_value),\n            self.stdout_text,\n            f\"The total ({total_value}) wasn't found in the printed output. Make sure you print the total.\"\n        )",
      "folderId": "0",
      "active": false,
      "type": "validation"
    }
