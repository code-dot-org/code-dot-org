        "4": {
          "id": "4",
          "name": "helpers.py",
          "contents": "import csv\n\ndef read_column(csv_filename, column_name):\n    with open(csv_filename, newline='', encoding='utf-8') as f:\n        reader = csv.DictReader(f)\n        raw_values = [row[column_name] for row in reader]\n\n    def convert(value):\n        value = value.strip()\n        try:\n            return int(value)\n        except ValueError:\n            pass\n        try:\n            return float(value)\n        except ValueError:\n            pass\n        if value.lower() in ('true', 'false'):\n            return value.lower() == 'true'\n        return value\n\n    return [convert(v) for v in raw_values]",
          "folderId": "0",
          "active": false,
          "type": "support"
