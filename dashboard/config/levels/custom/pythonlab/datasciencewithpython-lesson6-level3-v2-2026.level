        "0": {
          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "import pandas as pd\nimport matplotlib.pyplot as plt\n\nsurvey_data = pd.read_csv(\"survey_data.csv\")\n\n# Display the original data and data types\nprint(survey_data.head())\nsurvey_data.info()\n\n# Use AI Tutor to convert the data types here\n\n\n# Visualize height over time\nsurvey_data = survey_data.sort_values(by=\"Join Date\")\n\nplt.plot(\n    survey_data[\"Join Date\"],\n    survey_data[\"Height\"],\n    marker=\"o\"\n)\nplt.title(\"Height Over Time\")\nplt.xlabel(\"Join Date\")\nplt.ylabel(\"Height\")\nplt.xticks(rotation=45)\nplt.tight_layout()\nplt.show()",
