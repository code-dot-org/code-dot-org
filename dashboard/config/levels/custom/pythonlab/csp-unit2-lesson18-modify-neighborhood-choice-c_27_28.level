        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from neighborhood import *\n\nmove()\ntake_paint()\ntake_paint()\ntake_paint()\ntake_paint()\nmove()\nturn_left()\nturn_left()\nturn_left()\nmove()\nturn_left()\n\n# Square 1\npaint(\"white\")\nif can_move():\n    move()\nelse:\n    turn_left()\n    turn_left()\n    turn_left()\n\n# Square 2\npaint(\"white\")\nif can_move():\n    move()\nelse:\n    turn_left()\n    turn_left()\n    turn_left()\n\n# Square 3\npaint(\"white\")\nif can_move():\n    move()\nelse:\n    turn_left()\n    turn_left()\n    turn_left()\n\n# Square 4\npaint(\"white\")\nif can_move():\n    move()\nelse:\n    turn_left()\n    turn_left()\n    turn_left()",
          "folderId": "0",
