    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from theater import *\nimport math\n\n# --- Dragon variables ---\ndragon_awake_answer = input(\"Is the dragon awake? (Yes/No) \").lower()\nif dragon_awake_answer == \"yes\" or dragon_awake_answer == \"y\":\n    dragon_awake = True\nelse:\n    dragon_awake = False\n\nintruder_answer = input(\"Has an intruder been detected? (Yes/No) \").lower()\nif intruder_answer == \"yes\" or intruder_answer == \"y\":\n    intruder_detected = True\nelse:\n    intruder_detected = False\n\n# --- Dragon eye logic ---\nif dragon_awake and intruder_detected:\n    eye_open = True\nelse:\n    eye_open = False\n\n# --- Provided: scale background, fills full 400x400 stage, do not edit ---\nclear(\"#321307\")\n\nscale_a = \"#4a1b0c\"\nscale_b = \"#712b13\"\nscale_c = \"#321307\"\ncell = 25\n\nfor row in range(16):\n    for col in range(16):\n        shade = (row * 31 + col * 17 + (row ^ col)) % 3\n        if shade == 0:\n            set_fill_color(scale_a)\n        elif shade == 1:\n            set_fill_color(scale_b)\n        else:\n            set_fill_color(scale_c)\n        draw_rectangle(col * cell, row * cell, cell, cell)\n\n# --- Provided: builds a rotated ellipse as a point list for draw_shape ---\ndef ellipse_points(cx, cy, a, b, angle_deg, n=28):\n    theta = math.radians(angle_deg)\n    points = []\n    for i in range(n):\n        t = 2 * math.pi * i / n\n        ex = a * math.cos(t)\n        ey = b * math.sin(t)\n        points.append(cx + ex * math.cos(theta) - ey * math.sin(theta))\n        points.append(cy + ex * math.sin(theta) + ey * math.cos(theta))\n    return points\n\n# --- Provided: draw the eye, do not edit ---\nif eye_open:\n    set_fill_color(\"#639922\")\n    draw_shape(ellipse_points(200, 200, 100, 62, 12), True)\n    set_fill_color(\"#0a0a0a\")\n    draw_shape(ellipse_points(200, 200, 14, 54, 12), True)\n    set_fill_color(\"#97c459\")\n    draw_shape(ellipse_points(165, 178, 16, 11, 12), True)\nelse:\n    set_fill_color(\"#000000\")\n    draw_rectangle(100, 194, 200, 25)\n\nplay()",
          "folderId": "0",
          "active": false
        }
      },
