    "validation_file": {
      "id": "1",
      "name": "test.py",
      "contents": "from unittest import TestCase\nfrom unittest.mock import patch\n\n\nPROVIDED_MARKER = \"# --- Provided: scale background\"\n\n\nclass TestDebugDragonEye(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Read the student's source and isolate just the input-gathering\n        and eye-logic portion, above the provided drawing code. We exec that\n        isolated snippet ourselves (with input() mocked) for every Yes/No\n        combination, so we can check the resulting eye_open value directly --\n        without ever running the drawing/play() calls.\"\"\"\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n        cls.logic_snippet = cls.source.split(PROVIDED_MARKER)[0] if PROVIDED_MARKER in cls.source else None\n\n    def _run_logic(self, awake_answer, intruder_answer):\n        namespace = {}\n        with patch(\"builtins.input\", side_effect=[awake_answer, intruder_answer]):\n            exec(compile(self.logic_snippet, \"main.py\", \"exec\"), namespace)\n        return namespace\n\n    def test_eye_matches_dragon_and_intruder_state(self):\n        \"\"\"The eye's open/shut state correctly reflects dragon_awake and intruder_detected for every combination of answers\"\"\"\n        if self.logic_snippet is None:\n            self.skipTest(\n                \"We couldn't find the provided drawing section marker in main.py. \"\n                \"Make sure you haven't edited or removed the '--- Provided ---' comment lines.\"\n            )\n\n        scenarios = [\n            (\"yes\", \"yes\", True),\n            (\"yes\", \"no\", True),\n            (\"no\", \"yes\", True),\n            (\"no\", \"no\", False),\n        ]\n\n        mismatches = []\n        for awake_answer, intruder_answer, expected_eye_open in scenarios:\n            try:\n                namespace = self._run_logic(awake_answer, intruder_answer)\n            except Exception as e:\n                self.fail(\n                    f\"Your program raised an error when dragon_awake was '{awake_answer}' and intruder_detected was '{intruder_answer}': {e}\"\n                )\n            actual = namespace.get(\"eye_open\")\n            if actual != expected_eye_open:\n                mismatches.append(\n                    f\"awake='{awake_answer}', intruder='{intruder_answer}' -> expected eye_open={expected_eye_open}, got {actual}\"\n                )\n\n        self.assertFalse(\n            mismatches,\n            \"The eye isn't matching the dragon's state for every combination of answers. Mismatches found:\\n\"\n            + \"\\n\".join(mismatches)\n            + \"\\nRe-check how dragon_awake and intruder_detected combine to set eye_open.\"\n        )",
      "folderId": "0",
      "active": false,
      "type": "validation"
    }
  },
