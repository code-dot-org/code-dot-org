        "2": {
          "id": "2",
          "name": "helpers.py",
          "contents": "from typing import Any, Sequence\n\nimport matplotlib.pyplot as plt\nimport numpy as np\nfrom matplotlib.colors import ListedColormap\nfrom scipy import sparse\n\nCLASS_COLORS = (\"#0072B2\", \"#E69F00\", \"#009E73\", \"#CC79A7\", \"#56B4E9\", \"#D55E00\")\nCLASS_MARKERS = (\"o\", \"^\", \"s\", \"D\", \"v\", \"P\")\n\n\ndef create_matrix(columns: Sequence[Any]) -> list[list[Any]]:\n    \"\"\"Build a 2-D feature matrix from column-shaped inputs.\n\n    :param columns: One array- or matrix-like object per feature, each with one\n        row per sample. A 1-D entry (e.g. a plain list of numbers) contributes a\n        single column. A 2-D entry (e.g. a NumPy array, a list of lists, or a\n        SciPy sparse matrix, such as the output of\n        ``OneHotEncoder.fit_transform``) contributes one column per column of\n        that entry.\n    :type columns: Sequence[Any]\n    :returns: A list of rows, suitable to pass as ``X`` to ``model.fit``.\n    :rtype: list[list[Any]]\n    :raises ValueError: If the columns do not all have the same number of\n        rows.\n    \"\"\"\n    if not columns:\n        return []\n\n    dense_columns = [\n        col.toarray() if sparse.issparse(col) else np.asarray(col) for col in columns\n    ]\n\n    rows = dense_columns[0].shape[0]\n    for i, col in enumerate(dense_columns):\n        if col.shape[0] != rows:\n            raise ValueError(f\"column {i} has {col.shape[0]} rows, expected {rows}\")\n\n    X: list[list[Any]] = []\n    for i in range(rows):\n        row: list[Any] = []\n        for col in dense_columns:\n            value = col[i]\n            if np.ndim(value) > 0:\n                row.extend(value.tolist())\n            else:\n                row.append(value.item())\n        X.append(row)\n    return X\n\n\ndef print_matrix(\n    X: Sequence[Sequence[Any]],\n    feature_names: Sequence[str] | None = None,\n    precision: int = 1,\n) -> None:\n    \"\"\"Print a feature matrix as an aligned table.\n\n    :param X: The matrix, as a sequence of rows of numbers or strings.\n    :type X: Sequence[Sequence[Any]]\n    :param feature_names: Column headers, in column order. If omitted, headers\n        of ``x0``, ``x1``, and so on are generated.\n    :type feature_names: Sequence[str] | None\n    :param precision: Number of decimal places for float values. Integers and\n        strings are printed unchanged.\n    :type precision: int\n    :returns: Nothing; the table is printed. Every row is printed, so slice ``X``\n        before calling for a large matrix.\n    :rtype: None\n    :raises ValueError: If the rows are not all the same length, or if the number\n        of feature names does not match the number of columns.\n    \"\"\"\n    if not X:\n        print(\"(empty matrix)\")\n        return\n\n    def fmt(value: Any) -> str:\n        if isinstance(value, float):\n            return f\"{value:.{precision}f}\"\n        return str(value)\n\n    n_cols = len(X[0])\n    for i, row in enumerate(X):\n        if len(row) != n_cols:\n            raise ValueError(f\"row {i} has {len(row)} values, expected {n_cols}\")\n\n    if feature_names is None:\n        header = [f\"x{j}\" for j in range(n_cols)]\n    else:\n        if len(feature_names) != n_cols:\n            raise ValueError(f\"{len(feature_names)} names for {n_cols} columns\")\n        header = [str(name) for name in feature_names]\n\n    rows = [[fmt(v) for v in row] for row in X]\n    widths = [max(len(header[j]), max(len(r[j]) for r in rows)) for j in range(n_cols)]\n\n    def line(cells: Sequence[str]) -> str:\n        return \"  \".join(f\"{c:>{w}}\" for c, w in zip(cells, widths))\n\n    print(line(header))\n    print(\"-\" * len(line(header)))\n    for r in rows:\n        print(line(r))\n    print()\n\n\ndef visualize_model(model, feature_names=None, decimals=2, vertical=True):\n    \"\"\"Show what a trained classifier has learned.\n\n    A ``DecisionTreeClassifier`` is printed to the terminal as the tree of\n    questions it asks. Any other classifier, such as a\n    ``KNeighborsClassifier``, is drawn as a plot: every point on the plane is\n    shaded with the label the model would predict there, and the training\n    examples are drawn on top of that shading.\n\n    Name one feature per name you gave to :func:`create_matrix`, not one per\n    column. A categorical feature encoded with ``OneHotEncoder`` takes up\n    several columns but still gets a single name, and the plot gets one panel\n    per category of it.\n\n    The plot needs a model trained on exactly 2 numerical features, since the\n    picture has one of them on each axis, plus at most one categorical feature.\n    It also needs the examples the model was trained on, which a trained\n    ``KNeighborsClassifier`` keeps a copy of. Note that the plot shows the\n    numbers the model was trained on, so a model trained on scaled data gets\n    axes that run from 0 to 1.\n\n    The order of ``feature_names`` cannot be checked, only how many there are.\n    Whenever a categorical feature is found, the reading of the columns is\n    printed first, so that names given in the wrong order can be spotted.\n\n    :param model: A trained scikit-learn classifier.\n    :type model: Any\n    :param feature_names: One name per feature, in the order the features were\n        passed to ``create_matrix``. If omitted, names of ``feature_0``,\n        ``feature_1``, and so on are generated, one per column.\n    :type feature_names: Sequence[str] | None\n    :param decimals: Number of decimal places for the numbers in a decision\n        tree's questions. Ignored by the plot.\n    :type decimals: int\n    :param vertical: Whether a plot's panels are stacked one above another.\n        Pass False to lay them out side by side instead. Ignored by the tree.\n    :type vertical: bool\n    :returns: Nothing; the tree is printed, or the plot is shown.\n    :rtype: None\n    :raises TypeError: If ``model`` is not a scikit-learn classifier.\n    :raises ValueError: If the model has not been trained, if there are more\n        names than the model has columns, or if a model to be plotted was not\n        trained on exactly 2 numerical features.\n    \"\"\"\n    _check_trained_classifier(model)\n\n    columns = int(model.n_features_in_)\n    points = _training_points(model)\n    slots = _resolve_slots(model, feature_names, columns, points)\n\n    # When a categorical feature takes up several columns, the names no longer\n    # line up with the columns one for one, so say how the columns were read.\n    # Names given in the wrong order then show up as an obviously wrong reading.\n    if any(categories for _, _, categories in slots):\n        print(_describe_slots(slots, columns))\n\n    # Only a decision tree has a tree_ to print, so anything else gets a plot.\n    if hasattr(model, \"tree_\"):\n        _print_decision_tree(model, slots, decimals)\n    else:\n        _plot_decision_regions(model, slots, points, vertical)\n\n\ndef _check_trained_classifier(model):\n    \"\"\"Stop early, with an explanation, unless model is a trained classifier.\"\"\"\n    if not hasattr(model, \"predict\"):\n        raise TypeError(\n            \"visualize_model needs a scikit-learn model, but it was given a \"\n            \"{}. Pass the model you called .fit on.\".format(type(model).__name__)\n        )\n    if not hasattr(model, \"n_features_in_\"):\n        raise ValueError(\n            \"This {} has not been trained yet. Call model.fit(inputs, outputs) \"\n            \"before calling visualize_model(model).\".format(type(model).__name__)\n        )\n    if not hasattr(model, \"classes_\"):\n        raise TypeError(\n            \"visualize_model can only show classifiers, and a {} is not one. \"\n            \"Try a DecisionTreeClassifier or a \"\n            \"KNeighborsClassifier.\".format(type(model).__name__)\n        )\n    if isinstance(model.classes_, list):\n        raise ValueError(\n            \"visualize_model can only show a model with one output per \"\n            \"example, but this model predicts several at once.\"\n        )\n\n\ndef _training_points(model):\n    \"\"\"Return the examples the model was trained on, or None if it kept none.\n\n    A trained KNeighborsClassifier keeps its training inputs, since it needs\n    them to find neighbors later. A DecisionTreeClassifier keeps none.\n    \"\"\"\n    points = getattr(model, \"_fit_X\", None)\n    if points is None:\n        return None\n    if sparse.issparse(points):\n        points = points.toarray()\n    return np.asarray(points, dtype=float)\n\n\ndef _resolve_slots(model, feature_names, columns, points):\n    \"\"\"Group the model's columns into features, and pair each with its name.\n\n    Returns one ``(name, column_indices, categories)`` triple per feature.\n    ``categories`` is None for a numerical feature. For a categorical feature it\n    is one ``(label, column_values)`` pair per category: a feature encoded by\n    ``OneHotEncoder`` has one column per category, and a feature encoded as a\n    single 0 or 1 has one column holding two categories.\n    \"\"\"\n    if feature_names is None:\n        # With no names to go by, let the columns themselves say how many\n        # features there are, then number those features.\n        if points is not None:\n            groups = _group_columns_by_data(points, None)\n        else:\n            groups = [([j], None) for j in range(columns)]\n        names = [\"feature_\" + str(i) for i in range(len(groups))]\n        return _join(names, groups)\n\n    names = [str(name) for name in feature_names]\n    if len(names) > columns:\n        raise ValueError(\n            \"visualize_model got {} for a model with {} columns. Give one \"\n            \"name per feature you passed to create_matrix.\".format(\n                _count_of_names(len(names)), columns\n            )\n        )\n\n    if points is not None:\n        groups = _group_columns_by_data(points, len(names))\n    else:\n        groups = _group_columns_by_questions(model, len(names), columns)\n\n    return _join(names, groups)\n\n\ndef _join(names, groups):\n    \"\"\"Pair each name with the columns and categories found for it.\"\"\"\n    return [\n        (name, group_columns, categories)\n        for name, (group_columns, categories) in zip(names, groups)\n    ]\n\n\ndef _group_columns_by_data(points, n_names):\n    \"\"\"Group columns by looking at the training data itself.\n\n    A run of columns holding only 0s and 1s, where every row has exactly one 1,\n    is one categorical feature with one column per category.\n\n    A lone column holding only 0s and 1s is harder to place, since a feature\n    that was encoded as a 0 or a 1 looks exactly like a numerical feature that\n    happens to have two values. It is read as categorical only when that is what\n    leaves the 2 numerical features a plot needs.\n    \"\"\"\n    columns = points.shape[1]\n    is_binary = [\n        bool(np.all((points[:, j] == 0) | (points[:, j] == 1))) for j in range(columns)\n    ]\n\n    groups = []\n    start = 0\n    while start < columns:\n        stop = start\n        while stop < columns and is_binary[stop]:\n            stop += 1\n        run = list(range(start, stop))\n        if len(run) > 1 and np.all(points[:, run].sum(axis=1) == 1):\n            groups.append((run, _one_hot_categories(len(run))))\n            start = stop\n        else:\n            groups.append(([start], None))\n            start += 1\n\n    groups = _read_lone_binary_columns_as_categories(groups, is_binary)\n    _check_group_count(groups, n_names, columns)\n    return groups\n\n\ndef _one_hot_categories(width):\n    \"\"\"Describe the categories of a feature given one column each.\"\"\"\n    categories = []\n    for position in range(width):\n        values = [1.0 if i == position else 0.0 for i in range(width)]\n        categories.append((\"#{}\".format(position + 1), values))\n    return categories\n\n\ndef _read_lone_binary_columns_as_categories(groups, is_binary):\n    \"\"\"Read lone 0/1 columns as categorical when that makes the plot work.\n\n    A plot needs exactly 2 numerical features and at most 1 categorical one, so\n    if reading every lone 0/1 column that way lands on exactly that, it is the\n    reading that was meant. Otherwise the columns are left as they are, and the\n    plot reports what it found instead of guessing.\n    \"\"\"\n    lone_binary = [\n        i\n        for i, (group_columns, categories) in enumerate(groups)\n        if categories is None and is_binary[group_columns[0]]\n    ]\n    if not lone_binary:\n        return groups\n\n    numerical = sum(1 for _, categories in groups if categories is None)\n    categorical = len(groups) - numerical\n    if numerical - len(lone_binary) != 2 or categorical + len(lone_binary) != 1:\n        return groups\n\n    for i in lone_binary:\n        groups[i] = (groups[i][0], [(\"= 0\", [0.0]), (\"= 1\", [1.0])])\n    return groups\n\n\ndef _group_columns_by_questions(model, n_names, columns):\n    \"\"\"Group columns when there is no training data to look at.\n\n    A decision tree keeps no copy of its data, so the extra columns have to be\n    placed by reasoning about the questions the tree asks: a column holding\n    only 0s and 1s can only ever be split at 0.5, so any placement that puts a\n    column split somewhere else inside the categorical feature is impossible.\n    \"\"\"\n    surplus = columns - n_names\n    if surplus <= 0:\n        groups = [([j], None) for j in range(columns)]\n        _check_group_count(groups, n_names, columns)\n        return groups\n\n    tree = model.tree_\n    thresholds = {}\n    for node in range(tree.node_count):\n        column = int(tree.feature[node])\n        if column >= 0:\n            thresholds.setdefault(column, []).append(float(tree.threshold[node]))\n\n    def could_be_categorical(start):\n        return all(\n            all(abs(value - 0.5) < 1e-9 for value in thresholds.get(column, []))\n            for column in range(start, start + surplus + 1)\n        )\n\n    possible = [start for start in range(n_names) if could_be_categorical(start)]\n\n    # Every placement left over fits the questions equally well, which happens\n    # when the tree never asks about the categorical feature at all. Fall back\n    # to the last feature, since create_matrix is usually given the encoded\n    # feature last, and let the printed reading show the assumption.\n    start = possible[0] if len(possible) == 1 else n_names - 1\n\n    block = list(range(start, start + surplus + 1))\n    groups = [([j], None) for j in range(start)]\n    groups.append((block, _one_hot_categories(len(block))))\n    groups += [([j], None) for j in range(start + surplus + 1, columns)]\n    return groups\n\n\ndef _check_group_count(groups, n_names, columns):\n    \"\"\"Complain unless the features found match the names that were given.\"\"\"\n    if n_names is not None and len(groups) != n_names:\n        raise ValueError(\n            \"visualize_model read the model's {} columns as {} features, but \"\n            \"it was given {}. Give one name per feature you passed to \"\n            \"create_matrix.\".format(columns, len(groups), _count_of_names(n_names))\n        )\n\n\ndef _count_of_names(count):\n    \"\"\"Phrase a number of feature names, so the message reads properly.\"\"\"\n    return \"{} feature name{}\".format(count, \"\" if count == 1 else \"s\")\n\n\ndef _describe_slots(slots, columns):\n    \"\"\"Describe how the columns were read, so a wrong reading is visible.\"\"\"\n    parts = []\n    for name, _, categories in slots:\n        if categories is None:\n            parts.append(name)\n        else:\n            parts.append(\"{} ({} categories)\".format(name, len(categories)))\n    return \"Reading {} columns as: {}\".format(columns, \", \".join(parts))\n\n\ndef _print_decision_tree(model, slots, decimals):\n    \"\"\"Pretty-print the questions a fitted DecisionTreeClassifier asks.\"\"\"\n    tree = model.tree_\n\n    # The tree asks about one column at a time, so every column needs its own\n    # name. The categories of a categorical feature are numbered, since the\n    # model kept no record of what they were called.\n    feature_names = []\n    category_columns = set()\n    for name, group_columns, categories in slots:\n        if categories is None or len(group_columns) == 1:\n            feature_names.append(name)\n        else:\n            for position, column in enumerate(group_columns):\n                feature_names.append(\"{} #{}\".format(name, position + 1))\n                category_columns.add(column)\n\n    TEE, ELBOW, BAR, ARROW = \"├─\", \"└─\", \"│\", \"→\"\n    LABELS = (\"YES\", \"NO \")\n    STEM = len(TEE) + 1 + len(LABELS[0]) + 1 + len(ARROW) + 1\n\n    def number(x):\n        text = \"{:.{}f}\".format(x, decimals)\n        return text.rstrip(\"0\").rstrip(\".\") if \".\" in text else text\n\n    def class_counts(node):\n        raw = list(tree.value[node][0])\n        total = tree.n_node_samples[node]\n        if abs(sum(raw) - total) > 1e-6:  # sklearn >= 1.4 stores proportions\n            raw = [p * total for p in raw]\n        return [int(round(c)) for c in raw], total\n\n    def is_leaf(node):\n        return tree.children_left[node] == -1\n\n    def describe_leaf(node):\n        counts, total = class_counts(node)\n        best = max(range(len(counts)), key=lambda i: counts[i])\n        answer = str(model.classes_[best])\n        if counts[best] == total:\n            plural = \"\" if total == 1 else \"s\"\n            return \"{}  ({} example{})\".format(answer, total, plural)\n        order = sorted(range(len(counts)), key=lambda i: -counts[i])\n        mix = \", \".join(\n            \"{} {}\".format(counts[i], model.classes_[i]) for i in order if counts[i] > 0\n        )\n        return \"{}  ({})\".format(answer, mix)\n\n    def question(node):\n        # A categorical column holds a 1 when the example is of that category,\n        # so asking whether it is above 0.5 is just asking whether it is.\n        if tree.feature[node] in category_columns:\n            return \"Is {}?\".format(feature_names[tree.feature[node]])\n        return \"Is {} <= {}?\".format(\n            feature_names[tree.feature[node]],\n            number(float(tree.threshold[node])),\n        )\n\n    def children_of(node):\n        left, right = tree.children_left[node], tree.children_right[node]\n        # The left child is where the answer is at or below the threshold. For\n        # a categorical column that is the child where the example is NOT of\n        # that category, so the children swap to keep YES meaning yes.\n        if tree.feature[node] in category_columns:\n            return (right, left)\n        return (left, right)\n\n    def describe(node):\n        return describe_leaf(node) if is_leaf(node) else question(node)\n\n    def walk(node, prefix):\n        children = children_of(node)\n        for i, child in enumerate(children):\n            last = i == len(children) - 1\n            connector = ELBOW if last else TEE\n            print(\n                \"{}{} {} {} {}\".format(\n                    prefix, connector, LABELS[i], ARROW, describe(child)\n                )\n            )\n            if not is_leaf(child):\n                spacer = \" \" if last else BAR\n                walk(child, prefix + spacer + \" \" * (STEM - len(spacer)))\n\n    print(describe(0))\n    if not is_leaf(0):\n        walk(0, \"\")\n\n\ndef _plot_decision_regions(model, slots, points, vertical=True, resolution=250):\n    \"\"\"Shade the plane with the label the model predicts at every point.\"\"\"\n    numerical = [\n        (name, group_columns[0])\n        for name, group_columns, categories in slots\n        if categories is None\n    ]\n    categorical = [slot for slot in slots if slot[2] is not None]\n\n    if len(numerical) != 2:\n        raise ValueError(\n            \"visualize_model draws a flat plane, with one feature on each \"\n            \"axis, so it needs exactly 2 numerical features. This {} has \"\n            \"{}.\".format(type(model).__name__, len(numerical))\n        )\n    if len(categorical) > 1:\n        raise ValueError(\n            \"visualize_model draws one panel per category, so it can show at \"\n            \"most 1 categorical feature. This {} has {}.\".format(\n                type(model).__name__, len(categorical)\n            )\n        )\n    if points is None or not hasattr(model, \"_y\"):\n        raise ValueError(\n            \"A trained {} keeps no copy of its training data, so \"\n            \"visualize_model cannot draw it. Try a KNeighborsClassifier, \"\n            \"which does.\".format(type(model).__name__)\n        )\n\n    labels = model.classes_[model._y]\n    (x_name, x_column), (y_name, y_column) = numerical\n\n    # classes_ lists every label the model knows, in a fixed order. That order\n    # decides which color and marker each label gets.\n    classes = list(model.classes_)\n    colors = [CLASS_COLORS[i % len(CLASS_COLORS)] for i in range(len(classes))]\n    markers = [CLASS_MARKERS[i % len(CLASS_MARKERS)] for i in range(len(classes))]\n\n    # One grid, shared by every panel, so the panels can be compared directly.\n    grid_x, grid_y = np.meshgrid(\n        _axis_values(points[:, x_column], resolution),\n        _axis_values(points[:, y_column], resolution),\n    )\n\n    if categorical:\n        category_name, category_columns, categories = categorical[0]\n    else:\n        category_name, category_columns, categories = None, [], []\n    panels = list(range(len(categories))) if categories else [0]\n\n    # Styling\n    plt.rcParams.update({\"font.size\": 11, \"figure.dpi\": 140})\n\n    # Plotting\n    if vertical:\n        rows, panel_columns = len(panels), 1\n        size = (6, 6 if len(panels) == 1 else 4 * len(panels))\n    else:\n        rows, panel_columns = 1, len(panels)\n        size = (6 if len(panels) == 1 else 4.5 * len(panels), 5.5)\n\n    figure, axes_list = plt.subplots(\n        rows, panel_columns, figsize=size, sharex=True, sharey=True, squeeze=False\n    )\n    axes_list = list(axes_list.ravel())\n\n    for panel, axes in zip(panels, axes_list):\n        if categories:\n            label, values = categories[panel]\n            on_panel = np.all(points[:, category_columns] == values, axis=1)\n            title = \"{} {} (n={})\".format(category_name, label, int(np.sum(on_panel)))\n        else:\n            # Without a categorical feature there is one panel holding\n            # everything, and the figure's own title already names the model.\n            on_panel = np.ones(len(points), dtype=bool)\n            title = \"{} examples\".format(len(points))\n\n        regions = _predict_grid(\n            model,\n            grid_x,\n            grid_y,\n            x_column,\n            y_column,\n            category_columns,\n            categories[panel][1] if categories else None,\n            classes,\n        )\n\n        # One block of color per grid square, so no color can appear that the\n        # model did not actually predict. vmin and vmax pin each label to its\n        # own color, even on a panel where some label is predicted nowhere.\n        axes.pcolormesh(\n            grid_x,\n            grid_y,\n            regions,\n            cmap=ListedColormap(colors),\n            vmin=-0.5,\n            vmax=len(classes) - 0.5,\n            alpha=0.25,\n            shading=\"auto\",\n        )\n\n        for index, label in enumerate(classes):\n            on_panel_and_label = on_panel & (labels == label)\n            axes.scatter(\n                points[on_panel_and_label, x_column],\n                points[on_panel_and_label, y_column],\n                marker=markers[index],\n                color=colors[index],\n                s=55,\n                edgecolors=\"black\",\n                linewidths=0.5,\n                label=str(label),\n            )\n\n        axes.set_title(title)\n        axes.grid(True, linestyle=\":\", alpha=0.6)\n\n    # The panels share both axes, so only the outside edge of the figure needs\n    # labelling: the bottom of a column of panels, the left of a row of them.\n    if vertical:\n        for axes in axes_list:\n            axes.set_ylabel(y_name)\n        axes_list[-1].set_xlabel(x_name)\n    else:\n        for axes in axes_list:\n            axes.set_xlabel(x_name)\n        axes_list[0].set_ylabel(y_name)\n    axes_list[0].legend(loc=\"upper left\")\n\n    figure.suptitle(\"{} Decision Regions\".format(type(model).__name__))\n    figure.tight_layout()\n    plt.show()\n\n\ndef _predict_grid(\n    model, grid_x, grid_y, x_column, y_column, category_columns, values, classes\n):\n    \"\"\"Ask the model for a label at every point of one panel's grid.\"\"\"\n    rows = np.zeros((grid_x.size, int(model.n_features_in_)))\n    rows[:, x_column] = grid_x.ravel()\n    rows[:, y_column] = grid_y.ravel()\n    if values is not None:\n        rows[:, category_columns] = values\n\n    # Predictions are labels, like \"sold\". Turn each one into its position in\n    # classes_, since a color map needs numbers.\n    positions = {label: index for index, label in enumerate(classes)}\n    regions = np.array([positions[label] for label in model.predict(rows)])\n    return regions.reshape(grid_x.shape)\n\n\ndef _axis_values(column, resolution):\n    \"\"\"Evenly spaced values covering one feature, with a little room to spare.\"\"\"\n    low, high = float(np.min(column)), float(np.max(column))\n    padding = 0.05 * (high - low) if high > low else 0.5\n    return np.linspace(low - padding, high + padding, resolution)\n",
          "folderId": "0",
          "active": false,
          "type": "support"
        }
      },
