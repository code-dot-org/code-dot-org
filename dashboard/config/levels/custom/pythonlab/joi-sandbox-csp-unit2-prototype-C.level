        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "# MOVIE NIGHT MATCHER\n# A strong sample submission for the Build Your Own Recommender project.\n#\n# AI USE LOG (Skill 3.F):\n\n\nfrom theater import *\n\nprint(\"MOVIE NIGHT MATCHER\")\nprint(\"Answer a few questions and I'll find your movie.\\n\")\n\n# ---------- QUESTION 1: mood, with input validation ----------\nmood = input(\"Are you in the mood for something INTENSE or something RELAXING? (type intense or relaxing) \")\nwhile mood != \"intense\" and mood != \"relaxing\":\n    print(\"Hmm, that's not one of the options -- please type exactly 'intense' or 'relaxing'.\")\n    mood = input(\"Intense or relaxing? \")\n\n# ---------- QUESTION 2: company, with input validation ----------\nwatching_with = input(\"Are you watching ALONE or with OTHERS? (type alone or others) \")\nwhile watching_with != \"alone\" and watching_with != \"others\":\n    print(\"That's not a valid option -- please type exactly 'alone' or 'others'.\")\n    watching_with = input(\"Alone or others? \")\n\n# ---------- QUESTION 3: scare tolerance, with input validation ----------\nscary_ok = input(\"Are you okay with something scary tonight? (yes/no) \")\nwhile scary_ok != \"yes\" and scary_ok != \"no\":\n    print(\"Please answer with exactly 'yes' or 'no'.\")\n    scary_ok = input(\"Okay with scary? (yes/no) \")\n\n# ---------- THE ALGORITHM: nested if-else + a compound if that both matter ----------\nif mood == \"intense\":\n    if watching_with == \"alone\":\n        if scary_ok == \"yes\":\n            recommendation = \"Horror Movie\"\n            reason = \"intense, alone, and okay with scares -- horror hits different solo.\"\n        else:\n            recommendation = \"Action Thriller\"\n            reason = \"intense and alone, but keeping the scares out.\"\n    else:\n        recommendation = \"Group Action Movie\"\n        reason = \"intense with company -- something everyone can react to together.\"\nelse:\n    # Compound condition: BOTH parts matter here. Change either one and the\n    # recommendation changes -- this isn't just an \"and\" for show.\n    if watching_with == \"others\" and scary_ok == \"no\":\n        recommendation = \"Comedy Special\"\n        reason = \"relaxing, with others, and no scares -- comedy's the easy win.\"\n    else:\n        recommendation = \"Documentary\"\n        reason = \"relaxing, and either solo or open to something heavier -- a documentary fits.\"\n\nprint(\"\")\nprint(\"Your movie:\", recommendation)\nprint(\"Check the Theater for your full reveal!\")\n\n# ---------- THE REVEAL ----------\n# Each outcome gets its OWN background, frame shape, decoration pattern,\n# color language, and sound -- not one shared template with a swapped icon.\n\nif recommendation == \"Horror Movie\":\n    # near-black background, scattered \"stars,\" a jagged tombstone frame\n    clear(\"#0A0A12\")\n    remove_stroke_color()\n    set_fill_color(\"#E8E3D3\")\n    for i in range(14):\n        star_x = 10 + (i * 28) % 390\n        star_y = 20 + (i * 53) % 90\n        draw_ellipse(star_x, star_y, 3, 3)\n\n    set_fill_color(\"#1A1A28\")\n    draw_shape([130, 360, 130, 180, 150, 140, 250, 140, 270, 180, 270, 360], True)\n    set_stroke_color(\"#7A0C0C\")\n    set_stroke_width(3)\n    remove_fill_color()\n    draw_shape([130, 360, 130, 180, 150, 140, 250, 140, 270, 180, 270, 360], True)\n\n    remove_stroke_color()\n    set_text_style(\"serif\", \"bold\")\n    set_text_color(\"#7A0C0C\")\n    set_text_height(16)\n    draw_text(\"TONIGHT'S PICK\", 148, 175)\n    set_text_color(\"#E8E3D3\")\n    set_text_height(22)\n    draw_text(recommendation, 148, 210)\n    set_text_style(\"sans\", \"italic\")\n    set_text_height(11)\n    draw_text(\"Because it's \" + reason, 140, 240)\n\n    # the ghost\n    set_fill_color(\"#E8E3D3\")\n    draw_ellipse(165, 255, 60, 55)\n    draw_rectangle(165, 280, 60, 35)\n    draw_ellipse(165, 305, 20, 20)\n    draw_ellipse(187, 305, 20, 20)\n    draw_ellipse(207, 305, 20, 20)\n    set_fill_color(\"#0A0A12\")\n    draw_ellipse(178, 270, 8, 10)\n    draw_ellipse(200, 270, 8, 10)\n\n    play_note(52, 1.0)\n    pause(1.2)\n\nelif recommendation == \"Action Thriller\":\n    # bold red-orange background, diagonal impact stripes, angular burst frame\n    clear(\"#B23A1D\")\n    remove_stroke_color()\n    set_fill_color(\"#8A2614\")\n    for i in range(6):\n        stripe_x = -40 + i * 90\n        draw_shape([stripe_x, 400, stripe_x + 50, 400, stripe_x + 110, 0, stripe_x + 60, 0], True)\n\n    set_fill_color(\"#FFD23F\")\n    draw_shape([200, 60, 225, 130, 300, 130, 240, 175, 265, 250,\n                200, 205, 135, 250, 160, 175, 100, 130, 175, 130], True)\n\n    set_text_style(\"mono\", \"bold\")\n    set_text_color(\"#B23A1D\")\n    set_text_height(16)\n    draw_text(\"TONIGHT'S PICK\", 130, 155)\n    set_text_height(22)\n    draw_text(recommendation, 130, 190)\n    set_text_style(\"sans\", \"normal\")\n    set_text_color(\"#5C1A0E\")\n    set_text_height(11)\n    draw_text(\"Because it's \" + reason, 110, 220)\n\n    # the lightning bolt\n    set_fill_color(\"#5C1A0E\")\n    draw_shape([190, 255, 205, 255, 192, 285, 210, 285, 185, 330, 193, 292, 178, 292], True)\n\n    play_note(80, 0.3)\n    pause(0.3)\n    play_note(84, 0.5)\n    pause(1.0)\n\nelif recommendation == \"Group Action Movie\":\n    # team-navy background with alternating banner stripes, shield frame\n    clear(\"#15294A\")\n    remove_stroke_color()\n    colors = \"stripe\"\n    set_fill_color(\"#E8743B\")\n    draw_rectangle(0, 0, 50, 400)\n    draw_rectangle(100, 0, 50, 400)\n    draw_rectangle(200, 0, 50, 400)\n    draw_rectangle(300, 0, 50, 400)\n\n    set_fill_color(\"#0D1930\")\n    draw_shape([200, 70, 290, 100, 290, 210, 200, 280, 110, 210, 110, 100], True)\n    set_stroke_color(\"#E8743B\")\n    set_stroke_width(3)\n    remove_fill_color()\n    draw_shape([200, 70, 290, 100, 290, 210, 200, 280, 110, 210, 110, 100], True)\n\n    remove_stroke_color()\n    set_text_style(\"sans\", \"bold\")\n    set_text_color(\"#E8743B\")\n    set_text_height(14)\n    draw_text(\"TONIGHT'S PICK\", 135, 110)\n    set_text_color(\"#F4F1E8\")\n    set_text_height(18)\n    draw_text(recommendation, 125, 140)\n    set_text_style(\"sans\", \"italic\")\n    set_text_height(11)\n    draw_text(\"Because it's \" + reason, 118, 170)\n\n    # three bursts -- squad energy, alternating colors\n    set_fill_color(\"#E8743B\")\n    draw_regular_polygon(155, 220, 6, 16)\n    draw_regular_polygon(245, 220, 6, 16)\n    set_fill_color(\"#F4F1E8\")\n    draw_regular_polygon(200, 200, 6, 20)\n\n    play_note(60, 0.25)\n    pause(0.25)\n    play_note(64, 0.25)\n    pause(0.25)\n    play_note(67, 0.5)\n    pause(1.0)\n\nelif recommendation == \"Comedy Special\":\n    # bright pink background, polka dots, round spotlight frame\n    clear(\"#FF6FA5\")\n    remove_stroke_color()\n    set_fill_color(\"#FFD66B\")\n    for row in range(5):\n        for col in range(5):\n            dot_x = 20 + col * 90\n            dot_y = 20 + row * 80\n            draw_ellipse(dot_x, dot_y, 14, 14)\n\n    set_fill_color(\"#FFF4DC\")\n    draw_ellipse(100, 110, 200, 200)\n\n    set_text_style(\"sans\", \"bold\")\n    set_text_color(\"#FF6FA5\")\n    set_text_height(16)\n    draw_text(\"TONIGHT'S PICK\", 125, 155)\n    set_text_color(\"#5C3A1E\")\n    set_text_height(22)\n    draw_text(recommendation, 118, 195)\n    set_text_style(\"sans\", \"italic\")\n    set_text_height(11)\n    draw_text(\"Because it's \" + reason, 110, 224)\n\n    # the laughing face\n    set_fill_color(\"#FFD66B\")\n    draw_ellipse(155, 230, 90, 85)\n    set_fill_color(\"#5C3A1E\")\n    draw_ellipse(178, 262, 11, 13)\n    draw_ellipse(216, 262, 11, 13)\n    remove_fill_color()\n    set_stroke_color(\"#5C3A1E\")\n    set_stroke_width(4)\n    draw_shape([172, 295, 190, 310, 212, 310, 230, 295], False)\n\n    play_note(76, 0.15)\n    pause(0.15)\n    play_note(72, 0.15)\n    pause(0.15)\n    play_note(79, 0.4)\n    pause(1.0)\n\nelse:\n    # Documentary -- muted teal background, map grid, clean lower-third bar\n    clear(\"#1F3B34\")\n    remove_stroke_color()\n    set_stroke_color(\"#2E5A50\")\n    set_stroke_width(1)\n    for col in range(8):\n        line_x = col * 57\n        draw_line(line_x, 0, line_x, 400)\n    for row in range(8):\n        line_y = row * 57\n        draw_line(0, line_y, 400, line_y)\n\n    # the camera, as the scene's one focal object\n    remove_stroke_color()\n    set_fill_color(\"#0F221D\")\n    draw_rectangle(140, 120, 120, 75)\n    draw_rectangle(175, 102, 45, 24)\n    set_fill_color(\"#5E8C80\")\n    draw_ellipse(178, 138, 42, 42)\n    set_fill_color(\"#D6E8E2\")\n    draw_ellipse(190, 150, 18, 18)\n\n    # lower-third caption bar, like a nature documentary title card\n    set_fill_color(\"#0F221D\")\n    draw_rectangle(0, 290, 400, 70)\n    set_text_style(\"sans\", \"bold\")\n    set_text_color(\"#D6E8E2\")\n    set_text_height(16)\n    draw_text(recommendation, 24, 320)\n    set_text_style(\"sans\", \"normal\")\n    set_text_height(11)\n    draw_text(\"Because it's \" + reason, 24, 346)\n\n    play_note(57, 1.4)\n    pause(1.6)\n\nplay()",
          "folderId": "0",
          "active": true
        }
