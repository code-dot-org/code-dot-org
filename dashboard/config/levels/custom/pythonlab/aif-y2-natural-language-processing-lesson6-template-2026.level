        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "import csv\n\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.tree import DecisionTreeClassifier\n\nfrom helpers import visualize_model\n\n\n# Compute the features for one message\ndef get_features(message):\n  # TODO 1: Compute a value for exclamation_count\n  exclamation_count = 0\n\n  # TODO 2: Compute a value for dollar_sign_count\n  dollar_sign_count = 0\n\n  # TODO 3: Compute a value for all_caps_words\n  all_caps_words = 0\n\n  return {\n    \"exclamation_count\": exclamation_count,\n    \"has_dollar_sign\": dollar_sign_count,\n    \"all_caps_words\": all_caps_words,\n  }\n\n\n# Read data from CSV file\nf = open(\"messages.csv\")\nmessages = list(csv.DictReader(f))\nf.close()\n\n# Convert data into inputs (features) and outputs (labels)\nmessage_features = [get_features(row[\"message\"]) for row in messages]\nfeature_names = list(message_features[0].keys())\ninputs = [[features[name] for name in feature_names] for features in message_features]\noutputs = [row[\"label\"] for row in messages]\n\n# Split data into training and testing sets\ntrain_inputs, test_inputs, train_outputs, test_outputs = train_test_split(\n  inputs, outputs, test_size=0.25\n)\n\n# Train model\nmodel = DecisionTreeClassifier()\nmodel.fit(train_inputs, train_outputs)\n\n# Visualize decision tree\nvisualize_model(model, feature_names)\n\n# Test model\nmodel_score = model.score(test_inputs, test_outputs)\nprint(\"Model score on test data:\", model_score)",
