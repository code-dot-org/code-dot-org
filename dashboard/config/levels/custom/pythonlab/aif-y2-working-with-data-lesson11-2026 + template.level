        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "import csv\n\n# Read logbooks\nrows = []\n\nfile = open(\"logbook_1.csv\")\nfor row in csv.DictReader(file):\n    rows.append(row)\nfile.close()\n\nfile = open(\"logbook_2.csv\")\nfor row in csv.DictReader(file):\n    rows.append(row)\nfile.close()\n\n# TODO 1: Read logbook_3.csv and add its rows to the list.\n\n# Initialize site counts\ntemple_artifacts = 0\nriver_gate_artifacts = 0\ncauseway_artifacts = 0\n\n# Count artifacts\nfor row in rows:\n    # TODO 2: Skip rows with lost data\n\n    # TODO 3: Finish repairing the site names\n    site = row[\"site\"]\n    if site == \"Sun Temple\" or site == \"sun temple\":\n        site = \"Temple of the Sun\"\n\n    # Add artifacts to site counts\n    artifacts = int(row[\"artifacts_found\"])\n    if site == \"Temple of the Sun\":\n        temple_artifacts += artifacts\n    elif site == \"River Gate\":\n        river_gate_artifacts += artifacts\n    elif site == \"Broken Causeway\":\n        causeway_artifacts += artifacts\n\n# Print number of artifacts found at each location\nprint(f\"Temple of the Sun: {temple_artifacts}\")\nprint(f\"River Gate: {river_gate_artifacts}\")\nprint(f\"Broken Causeway: {causeway_artifacts}\")",
          "folderId": "0",
          "active": true
        },
