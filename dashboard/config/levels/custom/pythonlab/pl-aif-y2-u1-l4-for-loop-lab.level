          "id": "0",
          "name": "main.py",
          "contents": "def simulate(views, growth, days):\n  print(f\"Day 0: {views} views\")\n  views = views + views * growth\n  \n  print(f\"Day 1: {views} views\")\n  views = views + views * growth\n\n  print(f\"Day 2: {views} views\")\n  views = views + views * growth\n\n\nsimulate(100, 1, 3)\n",
