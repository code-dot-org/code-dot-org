    "display_name": "Countdown Launch",
    "bubble_choice_description": "Mission Control’s countdown program repeats a print statement for every number. Replace the repetition with a while loop.",
    "thumbnail_url": "https://images.code.org/8835652467796a638f21a64fd693d5f8-battery.png",
    "validation_file": {
      "id": "1",
      "name": "test.py",
      "contents": "import ast\nfrom unittest import TestCase\nfrom unittest_runner import ValidationProtocol\n\n\nclass TestModifyBatteryLevel(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Run the student's code and parse its structure\"\"\"\n        cls.stdout = ValidationProtocol().get_stdout_logs()\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n        cls.tree = ast.parse(cls.source)\n        cls.while_nodes = [n for n in ast.walk(cls.tree) if isinstance(n, ast.While)]\n\n    def test_uses_while_loop(self):\n        \"\"\"Uses a while loop instead of repeating print() calls\"\"\"\n        self.assertTrue(\n            self.while_nodes,\n            \"We didn't find a while loop in your code. Replace the repeated print() calls with a single while loop.\"\n        )\n\n    def test_while_loop_has_required_parts(self):\n        \"\"\"The while loop has a starting value, a condition, and an update\"\"\"\n        if not self.while_nodes:\n            self.skipTest(\"No while loop found yet -- add one before checking its parts.\")\n\n        while_node = self.while_nodes[0]\n\n        condition = while_node.test\n        condition_vars = {n.id for n in ast.walk(condition) if isinstance(n, ast.Name)}\n        self.assertTrue(\n            isinstance(condition, ast.Compare) and condition_vars,\n            \"Your while loop's condition should compare a variable to a value, like `while battery >= 0:`. Check what you wrote after `while`.\"\n        )\n\n        body_nodes = []\n        for stmt in while_node.body:\n            body_nodes.extend(ast.walk(stmt))\n        updated_vars = set()\n        for node in body_nodes:\n            if isinstance(node, ast.Assign):\n                updated_vars |= {t.id for t in node.targets if isinstance(t, ast.Name)}\n            elif isinstance(node, ast.AugAssign) and isinstance(node.target, ast.Name):\n                updated_vars.add(node.target.id)\n        self.assertTrue(\n            condition_vars & updated_vars,\n            \"We didn't find the loop's condition variable being updated inside the loop. Make sure you're changing the same variable you check in the while condition (e.g., battery = battery - 5) -- otherwise the loop runs forever or never runs.\"\n        )\n\n        loop_line = while_node.lineno\n        initialized_vars = set()\n        for node in ast.walk(self.tree):\n            if getattr(node, \"lineno\", None) is not None and node.lineno < loop_line:\n                if isinstance(node, ast.Assign):\n                    initialized_vars |= {t.id for t in node.targets if isinstance(t, ast.Name)}\n                elif isinstance(node, ast.AugAssign) and isinstance(node.target, ast.Name):\n                    initialized_vars.add(node.target.id)\n        self.assertTrue(\n            condition_vars & initialized_vars,\n            \"We didn't find your counting variable being set to a starting value before the while loop. Make sure you initialize it (e.g., battery = 100) above your while loop.\"\n        )\n\n    def test_prints_battery_100_down_to_0(self):\n        \"\"\"Prints the battery level from 100 down to 0, in steps of 5\"\"\"\n        if not self.while_nodes:\n            self.skipTest(\"Add your while loop first -- we'll check the output once the loop is in place.\")\n        if not self.stdout:\n            self.skipTest(\"Nothing printed at all. Make sure your loop still prints each battery level.\")\n        expected = [str(n) for n in range(100, -1, -5)]\n        self.assertEqual(\n            self.stdout,\n            expected,\n            f\"Expected to see 100 down to 0, dropping by 5 each time -- but we got {self.stdout}. \"\n            \"Check your loop's starting value, ending condition, and that your counting variable is decreasing by 5 each pass.\"\n        )",
      "folderId": "0",
      "active": false,
      "type": "validation"
    }
  },
