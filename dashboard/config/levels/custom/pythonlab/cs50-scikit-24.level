      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 3.10\n# Standard Description: Explain the effect of computational complexity on solving algorithms.\n#\n# Rationale: Not all algorithms are created equal! Some are \"fast\" and can \n# handle millions of rows. Others are \"slow\" and get exponentially slower \n# as the data grows. This tutorial compares how long it takes to train \n# a simple model (Linear Regression) versus a complex model (SVM) on \n# different amounts of data.\n\n\"\"\"\nWelcome! Have you ever tried to find a name in a phone book? \nIf there are 10 names, it's instant. If there are 10 million names, it takes \nlonger. This is \"Computational Complexity\".\n\nIn AI, we have to choose algorithms that are fast enough for our data. \nIf an algorithm is too complex, it might take WEEKS to train on a large \ndataset!\n\"\"\"\n\nimport time\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom sklearn.linear_model import LinearRegression\nfrom sklearn.svm import SVC\nfrom sklearn.datasets import make_classification\n\n# --- PART 1: THE EXPERIMENT ---\nprint(\"--- Part 1: Timing Different Algorithms ---\")\n\n# We will test sizes from 100 to 5,000 rows\nsizes = [100, 500, 1000, 2500, 5000]\nlr_times = []\nsvc_times = []\n\nfor size in sizes:\n    # Generate some random data\n    X, y = make_classification(n_samples=size, n_features=20, random_state=42)\n    \n    # Time the Linear Model (Fast)\n    start = time.time()\n    LinearRegression().fit(X, y)\n    lr_times.append(time.time() - start)\n    \n    # Time the Support Vector Machine (Slower/More Complex)\n    start = time.time()\n    SVC().fit(X, y)\n    svc_times.append(time.time() - start)\n    \n    print(f\"Finished size {size}...\")\n\n# --- VISUALIZATION ---\nplt.plot(sizes, lr_times, label=\"Linear Regression (Low Complexity)\", marker='o')\nplt.plot(sizes, svc_times, label=\"SVC (Higher Complexity)\", marker='o')\nplt.title(\"Computational Complexity: Time vs. Data Size\")\nplt.xlabel(\"Number of Rows (Data Size)\")\nplt.ylabel(\"Training Time (Seconds)\")\nplt.legend()\nplt.show()\n\nprint(\"\\nNotice how the blue line (Linear) stays nearly flat.\")\nprint(\"The orange line (SVC) starts to curve upwards as it gets harder.\")\n\n\"\"\"\n--- YOUR TURN ---\nWe've seen that SVC gets slower as data grows. \n1. If you had 1,000,000 rows of data, which model would you choose to \n   get a result quickly?\n2. What happens to the SVC time if you DOUBLE the number of rows? \n   Does it double, or does it increase by MORE than double?\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\n# TODO: Answer the questions based on the graph!\n# Best_for_Big_Data = \"___\"\n# Growth_Rate = \"___\"\n",
          "folderId": "0",
