          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "import matplotlib.pyplot as plt\nimport pandas as pd\n\nchart_one_data = pd.read_csv('US_Gas_Prices.csv')\nchart_two_data = pd.read_csv('gas_prices_by_city.csv')\n\nplt.figure()\nplt.plot(chart_one_data['Date'], chart_one_data['US Average'], marker='*', linestyle='-', color='blue')\n\nplt.title('US Average Gas Prices')\nplt.xlabel('Date')\nplt.ylabel('Price')\n\nplt.show()\n\nplt.figure()\nplt.bar(chart_two_data['City'], chart_two_data['Price'], color='blue')\n\nplt.xlabel('Cities')\nplt.ylabel('Average Price (US$)')\n\nplt.show()\n",
