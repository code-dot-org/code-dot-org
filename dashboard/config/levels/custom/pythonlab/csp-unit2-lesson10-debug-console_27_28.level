          "id": "0",
          "name": "main.py",
          "contents": "# This program should print whether you can go to the movies, then always print \"Program finished\".\ntime = int(input(\"What hour is it? \"))\ncan_go = time < 8\nif can_go\n    print(\"I can go to the movies!\")\n    print(\"Program finished\")",
