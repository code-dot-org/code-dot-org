        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "import csv\n\nfrom sklearn.linear_model import SGDRegressor\nfrom sklearn.metrics import mean_squared_error\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.neural_network import MLPRegressor\nfrom sklearn.pipeline import make_pipeline\nfrom sklearn.preprocessing import StandardScaler\n\n# Read data from CSV file\nf = open(\"videos.csv\")\nvideos = list(csv.DictReader(f))\nf.close()\n\n# Convert data into inputs (features) and outputs (labels)\nfeature_names = [\"video_length\", \"avg_watch_time\", \"creator_watched\", \"creator_skipped\"]\ninputs = [[int(video[feature]) for feature in feature_names] for video in videos]\noutputs = [int(video[\"watch_score\"]) for video in videos]\n\n# Split data into training and testing sets\ntrain_inputs, test_inputs, train_outputs, test_outputs = train_test_split(\n  inputs, outputs, test_size=0.25\n)\n\n# TODO 1: Create a pipeline with a StandardScaler and a regressor\n\n# TODO 2: Fit the model to the training data\n\n# Test network\npredictions = model.predict(test_inputs)\nprint(\"Mean squared error on test data:\", mean_squared_error(test_outputs, predictions))\n",
          "folderId": "0",
          "active": true
