      "id": "1",
      "name": "test.py",
      "contents": "import ast\nfrom unittest import TestCase\n\n\nREQUIRED_STARTER_NAMES = {\"name\", \"grade\", \"lucky_number\", \"card_color\", \"favorite_color\", \"is_new_member\"}\n\n\nclass TestModifyBadge(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Parse the source statically -- this level's starter code uses\n        patterns (Scene() class, input() in Theater) not yet confirmed\n        against the real platform, so we avoid executing it.\"\"\"\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n        cls.tree = ast.parse(cls.source)\n        cls.top_level_assigns = [n for n in cls.tree.body if isinstance(n, ast.Assign)]\n\n    def _assigned_value(self, var_name):\n        for node in self.top_level_assigns:\n            if any(isinstance(t, ast.Name) and t.id == var_name for t in node.targets):\n                return node.value\n        return None\n\n    def test_name_uses_input(self):\n        \"\"\"Asks for your name with input() instead of setting it directly\"\"\"\n        value = self._assigned_value(\"name\")\n        self.assertIsNotNone(value, \"We couldn't find a `name = ...` line.\")\n        self.assertTrue(\n            isinstance(value, ast.Call) and isinstance(value.func, ast.Name) and value.func.id == \"input\",\n            \"name should be set using input(\\\"...\\\"), not a fixed value like \\\"Jordan\\\".\"\n        )\n\n    def test_grade_and_lucky_number_updated(self):\n        \"\"\"Updates grade and lucky_number away from the starter values\"\"\"\n        grade_value = self._assigned_value(\"grade\")\n        lucky_value = self._assigned_value(\"lucky_number\")\n        self.assertIsNotNone(grade_value, \"We couldn't find a `grade = ...` line.\")\n        self.assertIsNotNone(lucky_value, \"We couldn't find a `lucky_number = ...` line.\")\n        self.assertFalse(\n            isinstance(grade_value, ast.Constant) and grade_value.value == 10,\n            \"grade is still set to the starter value (10). Update it to your own grade.\"\n        )\n        self.assertFalse(\n            isinstance(lucky_value, ast.Constant) and lucky_value.value == 7,\n            \"lucky_number is still set to the starter value (7). Update it to your own lucky number.\"\n        )\n\n    def test_favorite_color_added(self):\n        \"\"\"Adds a favorite_color variable with a value\"\"\"\n        value = self._assigned_value(\"favorite_color\")\n        self.assertIsNotNone(\n            value,\n            \"We didn't find a favorite_color variable. Add one and give it a value, like favorite_color = \\\"blue\\\".\"\n        )\n\n    def test_is_new_member_added_as_boolean(self):\n        \"\"\"Adds is_new_member and sets it to True or False\"\"\"\n        value = self._assigned_value(\"is_new_member\")\n        self.assertIsNotNone(\n            value,\n            \"We didn't find an is_new_member variable. Add one and set it to True or False.\"\n        )\n        self.assertTrue(\n            isinstance(value, ast.Constant) and isinstance(value.value, bool),\n            \"is_new_member should be set to True or False (not a string like \\\"True\\\" or a number).\"\n        )\n\n    def test_adds_math_derived_variable(self):\n        \"\"\"Adds a new variable that uses math to create a value from an existing one\"\"\"\n        existing_names = REQUIRED_STARTER_NAMES\n        found = False\n        for node in self.top_level_assigns:\n            target_names = {t.id for t in node.targets if isinstance(t, ast.Name)}\n            if target_names & existing_names:\n                continue  # skip the required variables themselves\n            if isinstance(node.value, ast.BinOp):\n                referenced = {n.id for n in ast.walk(node.value) if isinstance(n, ast.Name)}\n                if referenced & existing_names:\n                    found = True\n                    break\n        self.assertTrue(\n            found,\n            \"We didn't find a new variable that does math using one of your existing variables \"\n            \"(e.g., double_lucky_number = lucky_number * 2).\"\n        )\n\n    def test_favorite_color_used_in_visual(self):\n        \"\"\"Uses favorite_color somewhere in the badge visual\"\"\"\n        uses_favorite_color = any(\n            isinstance(n, ast.Name) and n.id == \"favorite_color\" and isinstance(n.ctx, ast.Load)\n            for n in ast.walk(self.tree)\n            if n not in (node.targets[0] for node in self.top_level_assigns if node.targets)\n        )\n        self.assertTrue(\n            uses_favorite_color,\n            \"We didn't find favorite_color being used anywhere besides where it's defined. \"\n            \"Use it in one of the scene drawing calls to add it to the badge visual.\"\n        )",
      "folderId": "0",
      "active": false,
      "type": "validation"
    }
  },
