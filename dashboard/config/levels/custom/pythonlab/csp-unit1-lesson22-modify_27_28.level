        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "# Variables hold the badge info\nname = \"Jordan\"\ngrade = 10\nlucky_number = 7\ncard_color = \"#4C42CF\"\n\n\n# --- Code to set up the Scene below --- #\nfrom theater import Scene, play_scenes\nscene = Scene()\nscene.clear(card_color)\n\nscene.set_fill_color(\"white\")\nscene.remove_stroke_color()\nscene.draw_rectangle(40, 100, 320, 200)\n\nscene.set_fill_color(\"#FFD36E\")\nscene.draw_rectangle(40, 100, 320, 18)\n\nscene.set_text_color(\"#1F1976\")\nscene.set_text_height(20)\nscene.draw_text(\"HELLO, MY NAME IS\", 70, 150)\n\nscene.set_text_height(46)\nscene.draw_text(name, 70, 200)\n\nscene.set_text_height(16)\nscene.draw_text(\"Grade:\", 70, 240)\nscene.draw_text(str(grade), 130, 240)\nscene.draw_text(\"Lucky number:\", 70, 264)\nscene.draw_text(str(lucky_number), 190, 264)\n\nscene.play_note(72, 0.25)\nscene.pause(0.25)\nscene.play_note(76, 0.4)\n\nplay_scenes(scene)",
