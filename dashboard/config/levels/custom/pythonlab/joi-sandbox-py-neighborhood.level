    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from neighborhood_helper import *\n\ndef turn_right():\n    turn_left()\n    turn_left()\n    turn_left()\n\nmove()  # steps onto the bucket\n\nif not has_paint():\n    print(\"Tank's empty. Filling up...\")\n    while get_my_paint() < 10:\n        take_paint()\nelse:\n    print(\"Already carrying some paint.\")\n\nprint(\"Now carrying\", get_my_paint(), \"units.\")\n\nturn_right()\n\n# List: a sequence of colors to paint as we go\ncolors = [\"red\", \"orange\", \"yellow\", \"green\", \"blue\"]\n\n# Loop: paint one square per color in the list\nfor color in colors:\n    if can_move():\n        move()\n        paint(color)\n    else:\n        print(\"Blocked at\", get_x(), get_y(), \"-- stopping early.\")\n        break\n\nprint(\"Done! Painter is at\", get_x(), get_y(), \"facing\", get_direction())",
          "folderId": "0",
          "active": true
        },
        "2": {
          "id": "2",
          "name": "neighborhood_helper.py",
          "contents": "from neighborhood import Painter\n\n# A single Painter instance lives here, hidden from students.\n# Default: (0, 0), facing \"East\", 0 units of paint.\n_painter = Painter()\n\n\ndef configure(x=0, y=0, direction=\"East\", paint=0):\n    \"\"\"Optional: re-place the painter with custom starting values.\n    Call this first (instead of relying on the default) if a level\n    needs the painter to start somewhere other than (0, 0) facing East.\"\"\"\n    global _painter\n    _painter = Painter(x, y, direction, paint)\n\n\n# --- movement ---\n\ndef move():\n    _painter.move()\n\n\ndef turn_left():\n    _painter.turn_left()\n\n\n# --- paint ---\n\ndef paint(color):\n    _painter.paint(color)\n\n\ndef take_paint():\n    _painter.take_paint()\n\n\ndef scrape_paint():\n    _painter.scrape_paint()\n\n\ndef set_paint(amount):\n    _painter.set_paint(amount)\n\n\n# --- sensing ---\n\ndef can_move(direction=None):\n    if direction is None:\n        return _painter.can_move()\n    return _painter.can_move(direction)\n\n\ndef is_on_paint():\n    return _painter.is_on_paint()\n\n\ndef is_on_bucket():\n    return _painter.is_on_bucket()\n\n\ndef has_paint():\n    return _painter.has_paint()\n\n\ndef is_facing_north():\n    return _painter.is_facing_north()\n\n\ndef is_facing_south():\n    return _painter.is_facing_south()\n\n\ndef is_facing_east():\n    return _painter.is_facing_east()\n\n\ndef is_facing_west():\n    return _painter.is_facing_west()\n\n\n# --- getters ---\n\ndef get_my_paint():\n    return _painter.get_my_paint()\n\n\ndef get_color():\n    return _painter.get_color()\n\n\ndef get_x():\n    return _painter.get_x()\n\n\ndef get_y():\n    return _painter.get_y()\n\n\ndef get_direction():\n    return _painter.get_direction()",
          "folderId": "0",
          "active": false
        }
      },
      "folders": {
      },
      "openFiles": [
        "0",
        "2"
      ]
    }
