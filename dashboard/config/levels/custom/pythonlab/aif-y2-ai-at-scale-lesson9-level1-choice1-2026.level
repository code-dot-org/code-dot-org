          "contents": "pan_temp_f,cook_minutes,label\n358,7.8,ruined\n342,5.0,perfect\n353,5.5,perfect\n392,5.8,perfect\n339,4.2,perfect\n324,6.3,ruined\n416,9.5,ruined\n338,10.0,ruined\n276,5.9,ruined\n386,5.4,perfect\n479,5.9,ruined\n401,5.4,perfect\n354,3.1,perfect\n370,5.2,perfect\n366,5.3,perfect\n402,3.3,ruined\n392,5.0,perfect\n301,6.6,ruined\n369,8.5,ruined\n383,5.4,perfect\n362,3.7,perfect\n416,3.5,ruined\n275,6.2,ruined\n400,4.9,perfect\n423,7.9,ruined\n269,2.9,ruined\n329,4.4,perfect\n438,2.5,ruined\n312,1.8,ruined\n271,2.1,ruined\n275,4.7,ruined\n452,6.7,ruined\n372,8.4,ruined\n350,4.6,perfect\n385,3.6,perfect\n357,3.7,perfect\n336,3.5,perfect\n375,4.2,perfect\n366,9.2,ruined\n352,4.8,perfect\n376,4.3,perfect\n386,4.6,perfect\n378,8.5,ruined\n383,4.6,perfect\n475,1.6,ruined\n326,6.1,ruined\n254,2.6,ruined\n479,3.8,ruined\n357,1.9,ruined\n372,4.6,perfect\n366,5.1,perfect\n331,4.9,perfect\n423,1.4,ruined\n389,6.2,ruined\n399,3.7,perfect\n497,3.4,ruined\n402,2.1,ruined\n367,1.1,ruined\n372,3.0,perfect\n365,4.6,perfect\n364,5.5,perfect\n344,4.2,perfect\n366,4.5,perfect\n395,6.6,ruined\n379,4.3,perfect\n474,10.0,ruined\n334,4.3,perfect\n365,6.9,ruined\n277,8.0,ruined\n337,5.5,perfect\n296,9.0,ruined\n425,9.7,ruined\n279,7.1,ruined\n412,4.4,perfect\n267,5.2,ruined\n457,1.6,ruined\n352,4.3,perfect\n282,5.3,ruined\n351,5.0,perfect\n384,6.0,perfect\n397,4.5,perfect\n284,6.6,ruined\n391,5.5,perfect\n277,8.2,ruined\n316,4.7,ruined\n301,2.0,ruined\n390,5.4,perfect\n360,3.6,perfect\n417,3.4,ruined\n371,5.1,perfect\n363,3.4,perfect\n375,3.2,perfect\n367,5.2,perfect\n349,2.7,ruined\n437,1.7,ruined\n369,4.4,perfect\n382,4.4,perfect\n479,5.7,ruined\n380,2.8,ruined\n406,3.9,perfect\n",
