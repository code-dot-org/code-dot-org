          "id": "0",
          "name": "main.py",
          "contents": "# ---------------- Vacation Wrapped: Console Prototype ----------------\n# Unit 1 concepts only: sequencing, variables, strings, input/output,\n# arithmetic expressions (no conditionals, no loops, no custom functions)\n\ndestination = input(\"Where did you go on your trip? \")\ntrip_cost = float(input(\"How much did the whole trip cost, in dollars? \"))\nnum_days = int(input(\"How many days was the trip? \"))\ntravel_minutes = int(input(\"About how many total minutes did you spend traveling (flights, drives, layovers, etc.)? \"))\n\n# --- Money math: cost per day of the trip ---\ncost_per_day = trip_cost / num_days\n\n# --- Time math: convert total travel minutes into hours + leftover minutes ---\ntravel_hours = travel_minutes // 60\nleftover_minutes = travel_minutes % 60\n\n# --- \"Was it worth it\" math: cost per hour spent traveling ---\ntravel_hours_decimal = travel_minutes / 60\ncost_per_travel_hour = trip_cost / travel_hours_decimal\n\n# --- Build the Wrapped-style summary using string concatenation ---\nsummary = destination + \" Wrapped: \" + str(num_days) + \" days, $\" + str(round(cost_per_day, 2)) + \" per day.\"\ntravel_summary = \"You spent \" + str(travel_hours) + \" hours and \" + str(leftover_minutes) + \" minutes just traveling.\"\nworth_it_summary = \"That travel time cost you about $\" + str(round(cost_per_travel_hour, 2)) + \" per hour.\"\n\nprint(summary)\nprint(travel_summary)\nprint(worth_it_summary)",
