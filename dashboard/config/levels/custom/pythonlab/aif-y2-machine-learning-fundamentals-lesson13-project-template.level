        "1": {
          "id": "1",
          "name": "helpers.py",
          "contents": "def predict_category(image, training_images, get_distance):\n    nearest_image = None\n    nearest_distance = None\n    for training_image in training_images:\n        distance = get_distance(image, training_image)\n        if nearest_distance is None or distance < nearest_distance:\n            nearest_image = training_image\n            nearest_distance = distance\n    return nearest_image[\"category\"]",
