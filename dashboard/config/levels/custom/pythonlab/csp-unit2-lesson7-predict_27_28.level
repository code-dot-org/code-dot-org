          "id": "0",
          "name": "main.py",
          "contents": "print(\"1:\", True and False)   \nprint(\"2:\", True or False)    \nprint(\"3:\", not False)        \nprint(\"4:\", not True)        \nprint(\"5:\", True and True)\nprint(\"6:\", True or True)\nprint(\"7:\", False and False)\nprint(\"8:\", False or False)  ",
