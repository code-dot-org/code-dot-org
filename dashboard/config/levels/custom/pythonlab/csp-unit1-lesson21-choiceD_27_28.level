        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "# Flower Garden — original by Dana Li\nfrom theater import *\n\nclear(\"#CDEFFF\")\n\n# Grass\nset_fill_color(\"green\")\ndraw_rectangle(0, 320, 400, 80)\n\n# Each pass draws one flower: stem, petals, center\nset_stroke_color(\"green\")\nset_stroke_width(6)\nfor j in range(5):\n    draw_line(j * 75 + 60, 320, j * 75 + 60, 220)\n    set_fill_color(\"pink\")\n    draw_ellipse(j * 75 + 35, 180, 50, 50)\n    set_fill_color(\"gold\")\n    draw_ellipse(j * 75 + 50, 195, 20, 20)\n    pause(0.1)\nplay()",
