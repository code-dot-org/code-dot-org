    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from sklearn.model_selection import train_test_split\nfrom sklearn.neighbors import KNeighborsClassifier\nfrom sklearn.preprocessing import MinMaxScaler\n\n# Input features: [elevation gain (ft), distance (miles), average heart rate (bpm)]\ninputs = [\n  [40, 3.1, 158],\n  [420, 4.5, 164],\n  [120, 2.0, 150],\n  [650, 6.2, 168],\n  [80, 5.0, 155],\n  [300, 3.5, 161],\n  [60, 4.0, 118],\n  [900, 14.0, 142],\n  [350, 6.5, 128],\n  [1800, 22.0, 150],\n  [150, 8.0, 132],\n  [600, 11.0, 138],\n]\n\noutputs = [\n  \"walk\",\n  \"walk\",\n  \"walk\",\n  \"walk\",\n  \"walk\",\n  \"walk\",\n  \"bicycle\",\n  \"bicycle\",\n  \"bicycle\",\n  \"bicycle\",\n  \"bicycle\",\n  \"bicycle\",\n]\n\n# Split into training and testing data\ntrain_inputs, test_inputs, train_outputs, test_outputs = train_test_split(\n  inputs,\n  outputs,\n  test_size=0.3,\n)\n\n# TODO 2: Create a new MinMaxScaler\n# TODO 3: Fit the scaler and scale the training inputs\n# TODO 4: Scale the test inputs\n\n# Train the classifier\n# TODO 5: Train the model using the scaled training inputs\nmodel = KNeighborsClassifier(n_neighbors=1)\nmodel.fit(train_inputs, train_outputs)\n\n# TODO 6: Test the model using the scaled test inputs\naccuracy = model.score(test_inputs, test_outputs)\nprint(f\"Model Accuracy: {accuracy}\")",
          "folderId": "0",
          "active": true
