      "id": "1",
      "name": "test.py",
      "contents": "import ast\nfrom unittest import TestCase\n\n\nclass TestModifyStageDirector(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Parse the source statically -- same reasoning as the Sound\n        Designer level: this draws a full Theater scene and calls play(),\n        which we have no safe way to execute or verify visually.\"\"\"\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n        cls.tree = ast.parse(cls.source)\n\n    def _find_calls(self, func_name):\n        return [\n            n for n in ast.walk(self.tree)\n            if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == func_name\n        ]\n\n    def _find_moon_ellipse(self):\n        \"\"\"The moon is the only draw_ellipse() call sized 70, 70 -- the\n        six stars are all sized 4-6, and per the instructions, only the\n        moon's position should change.\"\"\"\n        for call in self._find_calls(\"draw_ellipse\"):\n            if len(call.args) != 4:\n                continue\n            width, height = call.args[2], call.args[3]\n            if (isinstance(width, ast.Constant) and width.value == 70\n                    and isinstance(height, ast.Constant) and height.value == 70):\n                return call\n        return None\n\n    def test_uses_randint_for_x_and_y(self):\n        \"\"\"Uses randint() to generate both a random x and a random y, ranging 0 to 400\"\"\"\n        randint_calls = self._find_calls(\"randint\")\n        self.assertGreaterEqual(\n            len(randint_calls),\n            2,\n            f\"Expected 2 separate randint() calls (one for x, one for y), but found {len(randint_calls)}.\"\n        )\n        for call in randint_calls:\n            self.assertEqual(len(call.args), 2, \"Each randint() call should take two numbers, like randint(0, 400).\")\n            low_node, high_node = call.args\n            low = low_node.value if isinstance(low_node, ast.Constant) else None\n            high = high_node.value if isinstance(high_node, ast.Constant) else None\n            self.assertEqual(\n                (low, high),\n                (0, 400),\n                f\"Expected randint(0, 400), but found randint({low}, {high}).\"\n            )\n\n    def test_moon_position_uses_random_variables(self):\n        \"\"\"Updates the moon's draw_ellipse() to use random x and y variables, not the original hardcoded 280, 60\"\"\"\n        moon_call = self._find_moon_ellipse()\n        self.assertIsNotNone(\n            moon_call,\n            \"We couldn't find the moon's draw_ellipse() call (sized 70, 70). Make sure you haven't changed its size.\"\n        )\n        x_arg, y_arg = moon_call.args[0], moon_call.args[1]\n        self.assertFalse(\n            isinstance(x_arg, ast.Constant) and x_arg.value == 280,\n            \"The moon's x position is still hardcoded to 280. Update it to use your random x variable.\"\n        )\n        self.assertFalse(\n            isinstance(y_arg, ast.Constant) and y_arg.value == 60,\n            \"The moon's y position is still hardcoded to 60. Update it to use your random y variable.\"\n        )\n        self.assertIsInstance(x_arg, ast.Name, \"The moon's x position should be a variable, not a number written directly.\")\n        self.assertIsInstance(y_arg, ast.Name, \"The moon's y position should be a variable, not a number written directly.\")\n\n        assigned_names = {\n            t.id\n            for node in ast.walk(self.tree)\n            if isinstance(node, ast.Assign)\n            and isinstance(node.value, ast.Call)\n            and isinstance(node.value.func, ast.Name)\n            and node.value.func.id == \"randint\"\n            for t in node.targets\n            if isinstance(t, ast.Name)\n        }\n        self.assertIn(\n            x_arg.id, assigned_names,\n            f\"The variable used for the moon's x position ({x_arg.id}) doesn't appear to be set from randint().\"\n        )\n        self.assertIn(\n            y_arg.id, assigned_names,\n            f\"The variable used for the moon's y position ({y_arg.id}) doesn't appear to be set from randint().\"\n        )",
      "folderId": "0",
      "active": false,
