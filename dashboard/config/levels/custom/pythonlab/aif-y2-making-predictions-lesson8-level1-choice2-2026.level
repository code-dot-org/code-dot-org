    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from sklearn.model_selection import train_test_split\nfrom sklearn.neighbors import KNeighborsClassifier\nfrom sklearn.preprocessing import MinMaxScaler\n\n# Input features: [eccentricity, orbit size (km), density (kg/m^3)]\ninputs = [\n  [0.204, 168000000, 1190],\n  [0.079, 414000000, 2160],\n  [0.186, 476000000, 1400],\n  [0.081, 519000000, 1290],\n  [0.142, 594000000, 1500],\n  [0.848, 331000000, 500],\n  [0.512, 470000000, 470],\n  [0.538, 516000000, 600],\n  [0.641, 518000000, 533],\n  [0.624, 540000000, 300],\n]\n\noutputs = [\n  \"asteroid\",\n  \"asteroid\",\n  \"asteroid\",\n  \"asteroid\",\n  \"asteroid\",\n  \"comet\",\n  \"comet\",\n  \"comet\",\n  \"comet\",\n  \"comet\",\n]\n\n# Split into training and testing data\ntrain_inputs, test_inputs, train_outputs, test_outputs = train_test_split(\n  inputs,\n  outputs,\n  test_size=0.3,\n)\n\n# TODO 2: Create a new MinMaxScaler\n# TODO 3: Fit the scaler and scale the training inputs\n# TODO 4: Scale the test inputs\n\n# Train the classifier\n# TODO 5: Train the model using the scaled training inputs\nmodel = KNeighborsClassifier(n_neighbors=1)\nmodel.fit(train_inputs, train_outputs)\n\n# TODO 6: Test the model using the scaled test inputs\naccuracy = model.score(test_inputs, test_outputs)\nprint(f\"Model Accuracy: {accuracy}\")",
