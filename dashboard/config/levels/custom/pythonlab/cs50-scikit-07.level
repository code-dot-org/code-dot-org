          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 6.6\n# Standard Description: Explain the curse of dimensionality.\n#\n# Rationale: Sometimes, more data is NOT better. If we have too many features \n# (columns), our model can get confused by the \"noise\". This is called the \n# \"Curse of Dimensionality\". We use PCA (Principal Component Analysis) to \n# reduce the number of features while keeping the most important information.\n\n\"\"\"\nWelcome! Imagine you are trying to find a needle in a haystack. \nIf the haystack is huge (lots of dimensions), it's really hard. \nIf we can make the haystack smaller without losing the needle, it gets easier!\n\nThat's what PCA does: it squishes data down to its most important parts.\n\"\"\"\n\nfrom sklearn.datasets import load_digits\nfrom sklearn.decomposition import PCA\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.neighbors import KNeighborsClassifier\nimport matplotlib.pyplot as plt\n\n# --- LOAD DATA ---\n# The Digits dataset has 64 features (pixels in an 8x8 image)\ndigits = load_digits()\nX, y = digits.data, digits.target\n\nprint(f\"Original shape of data: {X.shape} (1797 images, 64 features)\")\n\nX_train, X_test, y_train, y_test = train_test_split(X, y, random_state=42)\n\n# --- PART 1: WITH ALL FEATURES ---\nprint(\"--- Part 1: Training with all 64 Features ---\")\nknn = KNeighborsClassifier()\nknn.fit(X_train, y_train)\nscore_full = knn.score(X_test, y_test)\nprint(f\"Accuracy with all 64 features: {score_full:.2%}\")\n\n# --- PART 2: DIMENSIONALITY REDUCTION (PCA) ---\nprint(\"--- Part 2: Reducing to just 2 Features ---\")\n# We'll squash the 64 features down to just 2 \"Principal Components\".\npca = PCA(n_components=2)\nX_pca = pca.fit_transform(X)\n\nprint(f\"New shape of data: {X_pca.shape} (1797 images, 2 features)\")\n\n# Let's visualize the data now that it's 2D!\nplt.figure(figsize=(8, 6))\nplt.scatter(X_pca[:, 0], X_pca[:, 1], c=y, cmap='tab10', edgecolors='k', alpha=0.7)\nplt.colorbar()\nplt.title(\"Digits Data Squished to 2 Dimensions\")\nplt.xlabel(\"Principal Component 1\")\nplt.ylabel(\"Principal Component 2\")\nplt.show()\n\n# --- PART 3: TRAINING ON REDUCED DATA ---\nprint(\"--- Part 3: Training on the Compressed Data ---\")\nX_train_pca, X_test_pca, y_train_pca, y_test_pca = train_test_split(X_pca, y, random_state=42)\n\nknn_pca = KNeighborsClassifier()\nknn_pca.fit(X_train_pca, y_train_pca)\nscore_pca = knn_pca.score(X_test_pca, y_test_pca)\nprint(f\"Accuracy with only 2 features: {score_pca:.2%}\")\n\nprint(\"\\nNotice: We lost some accuracy, but we made the data 32x smaller!\")\nprint(\"This makes training MUCH faster for huge datasets.\")\n\n\"\"\"\n--- YOUR TURN ---\nWe reduced 64 features down to 2, which was a huge jump. \nWhat if we keep more information?\n\n1. Create a new PCA model with n_components=10.\n2. Transform the original digits data (X).\n3. Split the new data into train/test sets.\n4. Train a KNeighborsClassifier and print the score.\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\n# TODO: Create a PCA with 10 components\n# pca_10 = ...\n\n# TODO: Fit and transform X\n# X_10 = ...\n\n# TODO: Split the data\n# X_train_10, X_test_10, y_train_10, y_test_10 = ...\n\n# TODO: Train and score the model!\n",
          "folderId": "0",
