        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "# Highway — original by Mr. Okafor\nfrom theater import *\n\nclear(\"#7CB342\")\n\n# Road\nset_fill_color(\"gray\")\ndraw_rectangle(0, 150, 400, 120)\n\n# Lane dashes\nset_fill_color(\"yellow\")\nfor j in range(8):\n    draw_rectangle(j * 50 + 10, 206, 30, 8)\n    pause(0.1)\n\n# Car\nset_fill_color(\"red\")\ndraw_rectangle(40, 170, 80, 40)\nset_fill_color(\"black\")\ndraw_ellipse(48, 200, 20, 20)\ndraw_ellipse(92, 200, 20, 20)\nplay()",
