      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "import csv\nimport statistics\n\nfile_1 = open(\"bus_1.csv\")\nreader_1 = csv.DictReader(file_1)\nbus_1_times = []\nfor row in reader_1:\n    time = float(row[\"wait_time\"])\n    bus_1_times.append(time)\nfile_1.close()\n\nfile_2 = open(\"bus_2.csv\")\nreader_2 = csv.DictReader(file_2)\nbus_2_times = []\nfor row in reader_2:\n    time = float(row[\"wait_time\"])\n    bus_2_times.append(time)\nfile_2.close()\n\nbus_1_min = min(bus_1_times)\nbus_1_max = max(bus_1_times)\nbus_1_range = round(bus_1_max - bus_1_min, 2)\n\nprint(f\"Bus 1 min: {bus_1_min}\")\nprint(f\"Bus 1 max: {bus_1_max}\")\nprint(f\"Bus 1 range: {bus_1_range}\")\n\n# TODO 1: Compute and print the mean value for Bus 1\n# TODO 2: Compute and print the standard deviation for Bus 1\n\nbus_2_min = min(bus_2_times)\nbus_2_max = max(bus_2_times)\nbus_2_range = round(bus_2_max - bus_2_min, 2)\n\nprint(f\"Bus 2 min: {bus_2_min}\")\nprint(f\"Bus 2 max: {bus_2_max}\")\nprint(f\"Bus 2 range: {bus_2_range}\")\n\n# TODO 3: Compute and print the mean value for Bus 2\n# TODO 4: Compute and print the standard deviation for Bus 2",
          "folderId": "0",
          "active": true
        },
