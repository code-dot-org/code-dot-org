      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "import pandas as pd\nimport matplotlib.pyplot as plt\n\n# Read the dataset\ndata = pd.read_csv('Urban_Mythical_Creature_Sightings.csv')\n\n# Group the data by Year and Creature, then total the Sightings\ngrouped_data = data.groupby(['Year', 'Creature'])['Sightings'].sum().unstack()\n\n# Create a stacked bar chart\ngrouped_data.plot(kind='bar', stacked=True)\n\n# Add labels and a title\nplt.legend(title='Creature Type', loc='upper left')\nplt.xticks(rotation=90)\nplt.xlabel('Year')\nplt.ylabel('Number of Sightings')\nplt.title('Mythical Creature Sightings by Year and Creature Type')\n\n# Display the chart\nplt.show()",
          "folderId": "0",
          "active": true,
          "open": true
        },
