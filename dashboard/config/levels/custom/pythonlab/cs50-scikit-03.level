          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standards: 2.9 (Missing Data) & 5.10 (Categorical Data)\n# Standard Descriptions: \n#   2.9: Find and filter out missing or N/A data.\n#   5.10: Explain how to include a categorical variable into a prediction model.\n#\n# Rationale: Real-world data is messy! Before an AI can learn, we often have to \n# \"clean\" it. This tutorial shows how to fill in missing gaps (Imputation) \n# and how to turn words like \"Sunny\" or \"Rainy\" into numbers the AI can \n# understand (One-Hot Encoding).\n\n\"\"\"\nWelcome! Today we're learning how to \"talk\" to AI using data it understands.\nAI models are like calculators—they love numbers, but they get confused by \nempty spaces (missing data) or words (categorical data).\n\nWe'll use scikit-learn's \"Pre-processing\" tools to fix these problems.\n\"\"\"\n\nimport numpy as np\nimport pandas as pd # We use pandas to make the data look like a nice table\nfrom sklearn.impute import SimpleImputer\nfrom sklearn.preprocessing import OneHotEncoder\n\n# --- OUR MESSY DATA ---\n# Imagine we are predicting if someone will play sports based on the weather.\n# Look closely: one row has a MISSING value (np.nan)!\ndata = {\n    'Outlook': ['Sunny', 'Rainy', 'Overcast', 'Sunny', 'Rainy'],\n    'Temperature': [85, 70, np.nan, 80, 75] \n}\ndf = pd.DataFrame(data)\n\nprint(\"--- Original Messy Data ---\")\nprint(df)\nprint(\"\\n\")\n\n# --- PART 1: HANDLING MISSING DATA (Standard 2.9) ---\nprint(\"--- Part 1: Filling in the Gaps (Imputation) ---\")\n# We use SimpleImputer to fill missing numbers with the \"mean\" (average).\nimputer = SimpleImputer(strategy='mean')\n# We have to reshape the data because scikit-learn expects a 2D grid\ntemp_column = df['Temperature'].values.reshape(-1, 1)\ndf['Temperature'] = imputer.fit_transform(temp_column)\n\nprint(\"Data after filling missing temperature:\")\nprint(df)\nprint(\"\\n\")\n\n# --- PART 2: HANDLING WORDS (Standard 5.10) ---\nprint(\"--- Part 2: Turning Words into Numbers (One-Hot Encoding) ---\")\n# The AI can't read \"Sunny\". One-Hot Encoding creates a new column for each word.\n# If it's \"Sunny\", it puts a '1' in the Sunny column and '0' elsewhere.\nencoder = OneHotEncoder(sparse_output=False)\noutlook_encoded = encoder.fit_transform(df[['Outlook']])\n\n# Let's see the new columns the encoder made\ncolumn_names = encoder.get_feature_names_out(['Outlook'])\nencoded_df = pd.DataFrame(outlook_encoded, columns=column_names)\n\nprint(\"The 'Outlook' words have become these columns:\")\nprint(encoded_df)\n\n\"\"\"\n--- YOUR TURN ---\nWe have a new dataset of pet sizes, but it has some problems!\n1. One pet is missing its weight.\n2. The 'Type' column uses words ('Dog', 'Cat').\n\nTask:\n1. Use the 'pet_imputer' to fill the missing weight with the 'median'.\n2. Use the 'pet_encoder' to turn 'Type' into numbers.\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\npet_data = {\n    'Type': ['Dog', 'Cat', 'Dog', 'Cat'],\n    'Weight': [25, np.nan, 30, 10]\n}\npet_df = pd.DataFrame(pet_data)\n\n# TODO 1: Fill missing weight\npet_imputer = SimpleImputer(strategy='median')\n# pet_df['Weight'] = pet_imputer.fit_transform(...)\n\n# TODO 2: Encode the 'Type' column\npet_encoder = OneHotEncoder(sparse_output=False)\n# type_encoded = pet_encoder.fit_transform(...)\n\nprint(\"\\nTry to clean the pet data and print the results!\")\n",
          "folderId": "0",
          "active": true
        }
