          "contents": "import matplotlib.pyplot as plt\n\n# NBA\nnba_attempts_per_game = [7.2, 4.8, 8.1, 3.4, 5.9, 2.6, 6.6, 5.1, 3.8, 4.3, 7.6, 2.9, 6.2, 4.5, 5.4, 3.1, 6.9, 4.0]\nnba_percent_made = [90, 74, 86, 79, 92, 71, 84, 88, 77, 81, 83, 87, 72, 89, 76, 85, 80, 91]\n\n# WNBA\nwnba_attempts_per_game = [6.8, 5.2, 7.4, 3.9, 4.6, 2.8, 6.1, 5.7, 3.2, 4.9, 7.0, 2.5, 5.5, 4.1, 6.4, 3.6, 5.0, 4.4]\nwnba_percent_made = [90, 81, 93, 86, 78, 84, 89, 75, 92, 83, 87, 80, 94, 82, 76, 88, 85, 79]\n\nplt.scatter(nba_attempts_per_game, nba_percent_made)\nplt.scatter(wnba_attempts_per_game, wnba_percent_made)\n\nplt.show()",
