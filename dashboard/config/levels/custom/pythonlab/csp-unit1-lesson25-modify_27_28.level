      "id": "1",
      "name": "test.py",
      "contents": "import contextlib\nimport io\nfrom unittest import TestCase\n\n\nKNOWN_NAMES = {\"pet_name\", \"birth_month\", \"code_name\"}\n\n\ndef _contains_substring_of(value, text, min_length=2):\n    \"\"\"True if any contiguous substring of `value`, at least min_length\n    characters long, appears in `text`. Used to check for 'a substring\n    from it' without assuming a specific slice was taken.\"\"\"\n    for length in range(len(value), min_length - 1, -1):\n        for start in range(len(value) - length + 1):\n            if value[start:start + length] in text:\n                return True\n    return False\n\n\nclass TestModifyStringIngredients(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Run the student's code once and capture variables + output\"\"\"\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n        cls.namespace = {}\n        stdout = io.StringIO()\n        cls.run_error = None\n        try:\n            with contextlib.redirect_stdout(stdout):\n                exec(compile(cls.source, \"main.py\", \"exec\"), cls.namespace)\n        except Exception as e:\n            cls.run_error = e\n        cls.stdout_text = stdout.getvalue()\n        cls.improved_line = cls._find_improved_line(cls.stdout_text)\n\n    @staticmethod\n    def _find_improved_line(stdout_text):\n        for line in stdout_text.splitlines():\n            if line.startswith(\"Your improved code name is:\"):\n                return line[len(\"Your improved code name is:\"):].strip()\n        return None\n\n    def setUp(self):\n        if self.run_error is not None:\n            self.fail(\n                f\"Your program raised an error while running: {self.run_error}. \"\n                \"If this is about concatenating str and int, use str() to fix it (step 4).\"\n            )\n        if self.improved_line is None:\n            self.fail(\n                \"We didn't find a line starting with 'Your improved code name is:'. Make sure that print statement is still there.\"\n            )\n\n    def _new_variables(self):\n        return {\n            name: value for name, value in self.namespace.items()\n            if name not in KNOWN_NAMES and not name.startswith(\"__\")\n        }\n\n    def test_uses_last_three_letters_of_pet_name(self):\n        \"\"\"Uses the last 3 letters of pet_name in the improved code name\"\"\"\n        pet_name = str(self.namespace.get(\"pet_name\", \"\"))\n        last_three = pet_name[-3:]\n        self.assertIn(\n            last_three,\n            self.improved_line,\n            f\"Expected the last 3 letters of pet_name ('{last_three}') somewhere in the improved code name, \"\n            f\"but got: {self.improved_line}. Change the slice so it grabs the END of pet_name, not the beginning.\"\n        )\n        first_three = pet_name[0:3]\n        if first_three != last_three:\n            self.assertNotIn(\n                first_three,\n                self.improved_line,\n                f\"We still found the FIRST 3 letters of pet_name ('{first_three}') in the improved code name. \"\n                \"Make sure you changed the slice to grab the last 3 letters instead.\"\n            )\n\n    def test_adds_media_variable_in_improved_code_name(self):\n        \"\"\"Adds a new variable for a favorite movie, show, or book, and includes a substring of it\"\"\"\n        string_vars = {\n            name: value for name, value in self._new_variables().items()\n            if isinstance(value, str) and value\n        }\n        self.assertTrue(\n            string_vars,\n            \"We didn't find a new string variable (e.g. for your favorite movie, show, or book). \"\n            \"Add one and include part of it in your improved code name.\"\n        )\n        matched = any(_contains_substring_of(value, self.improved_line) for value in string_vars.values())\n        self.assertTrue(\n            matched,\n            f\"We found new variable(s) {list(string_vars.keys())}, but didn't find a substring from any of them \"\n            f\"in the improved code name ({self.improved_line}). Make sure you're including a slice from it.\"\n        )\n\n    def test_adds_number_variable_in_improved_code_name(self):\n        \"\"\"Adds a favorite number variable and includes it (converted with str()) in the improved code name\"\"\"\n        number_vars = {\n            name: value for name, value in self._new_variables().items()\n            if isinstance(value, (int, float)) and not isinstance(value, bool)\n        }\n        self.assertTrue(\n            number_vars,\n            \"We didn't find a new number variable for your favorite number (stored as a number, not a string). Add one, e.g. my_num = 13.\"\n        )\n        matched = any(str(value) in self.improved_line for value in number_vars.values())\n        self.assertTrue(\n            matched,\n            f\"We found number variable(s) {list(number_vars.keys())}, but didn't find it in the improved code name. \"\n            \"Use str() to add it to your improved code_name (e.g. ... + str(my_num)).\"\n        )",
      "folderId": "0",
      "active": false,
      "type": "validation"
    }
  },
