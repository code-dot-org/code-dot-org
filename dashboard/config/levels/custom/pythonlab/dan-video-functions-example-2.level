    "name_suffix": "_2025",
    "display_name": "Study Session Organizer",
    "bubble_choice_description": "You're designing a simple program to simulate a productive study session. The code includes repeated reminders to take breaks and check your to-do list, but it's messy and hard to maintain. Clean things up by writing two functions that organize these tasks.",
    "thumbnail_url": "https://images.code.org/6eba48f516b96c9a26bd57c649391701-study.png",
    "start_sources": {
