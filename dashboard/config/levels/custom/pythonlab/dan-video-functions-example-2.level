          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# TODO - Write the lander_status_check() function\n\n\n# TODO - Replace the repeated blocks by calling your new function\nprint(\"Running diagnostic sequence 1 of 3...\")\n\n# first diagnostic update\nprint(\"DIAGNOSTIC: All systems nominal.\")\nprint(\"FUEL: 97.5 Liters remaining.\")\nprint(\"---------------------------------------\")\n\n# The lander performs a small adjustment\nprint(\"System Check complete at 09:00\")\n\n# second diagnostic update\nprint(\"DIAGNOSTIC: All systems nominal.\")\nprint(\"FUEL: 97.5 Liters remaining.\")\nprint(\"---------------------------------------\")\n\n# altitude check\nprint(\"Current Altitude: 12000m\")\nprint(\"Awaiting final descent command.\")\n\n# third diagnostic update\nprint(\"DIAGNOSTIC: All systems nominal.\")\nprint(\"FUEL: 97.5 Liters remaining.\")\nprint(\"---------------------------------------\")\n\nprint(\"Pre-flight checklist complete.\")",
