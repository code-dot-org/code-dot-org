    "validation_file": {
      "id": "2",
      "name": "test.py",
      "contents": "import ast\nfrom unittest import TestCase\nfrom unittest_runner import ValidationProtocol\n\n\nclass TestModifyNeighborhood(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Run the student's code and parse its structure\"\"\"\n        cls.log = ValidationProtocol().get_neighborhood_log()\n        cls.painter = cls.log.painter_logs[0] if cls.log.painter_logs else None\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n        cls.tree = ast.parse(cls.source)\n        cls.while_nodes = [n for n in ast.walk(cls.tree) if isinstance(n, ast.While)]\n\n    def _calls_named(self, node, name):\n        \"\"\"True if name(...) is called anywhere inside node\"\"\"\n        return any(\n            isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == name\n            for n in ast.walk(node)\n        )\n\n    def _find_loop_with_call_in_test(self, func_name):\n        for node in self.while_nodes:\n            if self._calls_named(node.test, func_name):\n                return node\n        return None\n\n    def _find_counting_loop(self):\n        \"\"\"A while loop whose condition is a numeric comparison, not is_on_bucket()\"\"\"\n        for node in self.while_nodes:\n            if isinstance(node.test, ast.Compare) and not self._calls_named(node.test, \"is_on_bucket\"):\n                return node\n        return None\n\n    # --- Refactor 1: take_paint() loop using is_on_bucket() ---\n\n    def test_uses_is_on_bucket_loop_for_take_paint(self):\n        \"\"\"Replaces the repeated take_paint() calls with a while loop using is_on_bucket()\"\"\"\n        loop = self._find_loop_with_call_in_test(\"is_on_bucket\")\n        self.assertIsNotNone(\n            loop,\n            \"We didn't find a while loop whose condition calls is_on_bucket(). Replace the four take_paint() lines with something like `while is_on_bucket(): take_paint()`.\"\n        )\n        self.assertTrue(\n            self._calls_named(loop, \"take_paint\"),\n            \"Your is_on_bucket() loop doesn't call take_paint() inside it. Make sure take_paint() is in the loop body, not just the condition.\"\n        )\n\n    # --- Refactor 2: counting loop for the 4 painting blocks ---\n\n    def test_uses_counting_loop_for_painting(self):\n        \"\"\"Replaces the four repeated painting blocks with a counting variable and a while loop\"\"\"\n        loop = self._find_counting_loop()\n        self.assertIsNotNone(\n            loop,\n            \"We didn't find a while loop with a counting condition (like `while count < 4:`). Replace the four repeated Square blocks with a counting variable and a while loop.\"\n        )\n\n        condition_vars = {n.id for n in ast.walk(loop.test) if isinstance(n, ast.Name)}\n\n        body_nodes = []\n        for stmt in loop.body:\n            body_nodes.extend(ast.walk(stmt))\n        updated_vars = set()\n        for node in body_nodes:\n            if isinstance(node, ast.Assign):\n                updated_vars |= {t.id for t in node.targets if isinstance(t, ast.Name)}\n            elif isinstance(node, ast.AugAssign) and isinstance(node.target, ast.Name):\n                updated_vars.add(node.target.id)\n        self.assertTrue(\n            condition_vars & updated_vars,\n            \"We didn't find your counting variable being updated inside the loop. Make sure you're changing the same variable you check in the while condition -- otherwise the loop runs forever or never runs.\"\n        )\n\n        loop_line = loop.lineno\n        initialized_vars = set()\n        for node in ast.walk(self.tree):\n            if getattr(node, \"lineno\", None) is not None and node.lineno < loop_line:\n                if isinstance(node, ast.Assign):\n                    initialized_vars |= {t.id for t in node.targets if isinstance(t, ast.Name)}\n                elif isinstance(node, ast.AugAssign) and isinstance(node.target, ast.Name):\n                    initialized_vars.add(node.target.id)\n        self.assertTrue(\n            condition_vars & initialized_vars,\n            \"We didn't find your counting variable being set to a starting value before the while loop. Make sure you initialize it (e.g., count = 0) above your while loop.\"\n        )\n\n        self.assertTrue(\n            self._calls_named(loop, \"paint\"),\n            \"Your counting loop doesn't call paint() inside it. Make sure the painting logic is inside the loop body.\"\n        )\n\n    # --- Functional outcome ---\n\n    def test_paints_four_squares(self):\n        \"\"\"Paints exactly 4 squares, just like the original repeated code did\"\"\"\n        if not self._find_counting_loop():\n            self.skipTest(\"Add your counting loop first -- we'll check the painted squares once it's in place.\")\n        if self.painter is None:\n            self.skipTest(\"No painter actions found yet. Make sure your program runs without errors.\")\n        self.assertEqual(\n            self.painter.action_count(\"PAINT\"),\n            4,\n            f\"Expected exactly 4 squares to be painted, but found {self.painter.action_count('PAINT')}. Check that your loop runs the right number of times and still calls paint() each pass.\"\n        )",
      "folderId": "0",
      "active": false,
      "type": "validation"
    }
