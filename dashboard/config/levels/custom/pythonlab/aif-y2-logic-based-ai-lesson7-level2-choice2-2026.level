          "id": "0",
          "name": "main.py",
          "contents": "def simulate(infections, growth, days):\n  print(f\"Day 0: {infections} infections\")\n  infections = infections + infections * growth\n  \n  print(f\"Day 1: {infections} infections\")\n  infections = infections + infections * growth\n\n  print(f\"Day 2: {infections} infections\")\n  infections = infections + infections * growth\n\n\nsimulate(100, 1, 3)\n",
