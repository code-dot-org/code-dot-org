        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "# Piano — original by Jamal Brooks\nfrom theater import *\n\nclear(\"#3A2A1A\")\n\n# White keys, each one plays a note as it appears\nset_stroke_color(\"black\")\nset_fill_color(\"white\")\nfor j in range(8):\n    draw_rectangle(j * 48 + 8, 160, 46, 200)\n    play_note_and_pause(60 + j, 0.2)\n\n# Black keys\nset_fill_color(\"black\")\nfor j in range(7):\n    draw_rectangle(j * 48 + 40, 160, 28, 120)\n    pause(0.1)\nplay()",
