      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from neighborhood import *\n\n# Painter setup: the Painter starts at the left end of the street, facing east.\nmove()\nmove()\nmove()\nmove()\n\n# Check 1 (finish this comment): \nif can_move():\n    move()\n    print(\"I moved!\")\n\n# Check 2 (finish this comment): \nif can_move():\n    move()\n    print(\"I moved!\")",
