          "id": "0",
          "name": "main.py",
          "contents": "keep_testing = \"y\"\nwhile keep_testing == \"y\":\n    cents_text = input(\"Cents inserted: \")\n    cents = int(cents_text)\n\n    if cents < 0:\n        message = \"Invalid amount\"\n    elif cents <= 150:\n        message = \"Insert \" + str(150 - cents) + \" more\"\n    elif cents == 150:\n        message = \"Enjoy your snack\"\n    elif cents <= 500:\n        message = \"Enjoy your snack. Change: \" + str(cents - 150)\n    else:\n        message = \"Too much money. Returned \" + str(cents)\n\n    print(message)\n    keep_testing = input(\"Test another? (Type y or n) \")",
