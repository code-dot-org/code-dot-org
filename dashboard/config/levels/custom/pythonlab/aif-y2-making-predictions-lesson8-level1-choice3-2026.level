    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from sklearn.model_selection import train_test_split\nfrom sklearn.neighbors import KNeighborsClassifier\nfrom sklearn.preprocessing import MinMaxScaler\n\n# Input features: [body mass (kg), claw length (cm), top speed (km/h)]\ninputs = [\n  [15, 6.5, 39],\n  [70, 13.0, 35],\n  [500, 24.0, 32],\n  [2000, 15.0, 32],\n  [7000, 20.0, 27],\n  [180, 3.0, 13],\n  [3500, 3.0, 8],\n  [6000, 4.0, 10],\n  [8000, 2.0, 19],\n  [50000, 8.0, 10],\n]\n\noutputs = [\n  \"carnivore\",\n  \"carnivore\",\n  \"carnivore\",\n  \"carnivore\",\n  \"carnivore\",\n  \"herbivore\",\n  \"herbivore\",\n  \"herbivore\",\n  \"herbivore\",\n  \"herbivore\",\n]\n\n# Split into training and testing data\ntrain_inputs, test_inputs, train_outputs, test_outputs = train_test_split(\n  inputs,\n  outputs,\n  test_size=0.3,\n)\n\n# TODO 2: Create a new MinMaxScaler\n# TODO 3: Fit the scaler and scale the training inputs\n# TODO 4: Scale the test inputs\n\n# Train the classifier\n# TODO 5: Train the model using the scaled training inputs\nmodel = KNeighborsClassifier(n_neighbors=1)\nmodel.fit(train_inputs, train_outputs)\n\n# TODO 6: Test the model using the scaled test inputs\naccuracy = model.score(test_inputs, test_outputs)\nprint(f\"Model Accuracy: {accuracy}\")",
          "folderId": "0",
          "active": true
