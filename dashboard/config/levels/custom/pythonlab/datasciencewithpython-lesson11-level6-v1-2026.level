          "name": "main.py",
          "language": "py",
          "contents": "import pandas as pd\n\ndf = pd.read_csv('new_superhero_roster.csv')\n\nfiltered_heroes = df[df['City'].str.endswith('y') & df['Alias'].str.endswith('e')]\nprint(\"Filtered Superheroes:\\n\", filtered_heroes)\n",
