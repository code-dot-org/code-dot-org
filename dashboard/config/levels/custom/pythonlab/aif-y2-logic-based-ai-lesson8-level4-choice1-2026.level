          "id": "0",
          "name": "main.py",
          "contents": "def simulate(views, growth, target):\n    days = 0\n    print(f\"Day {days}: {views} views\")\n\n    while views < target:\n        views += views * growth\n        days += 1\n        print(f\"Day {days}: {views} views\")\n\n\nsimulate(10, 10, 1000)\n",
