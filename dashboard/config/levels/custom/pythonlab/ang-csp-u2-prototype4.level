    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "# MOVIE NIGHT MATCHER\n# A strong sample submission for the Build Your Own Recommender project.\n#\n# AI USE LOG (Skill 3.F):\n\n\nfrom theater import *\n\nprint(\"MOVIE NIGHT MATCHER\")\nprint(\"Answer a few questions and I'll find your movie.\\n\")\n\n# ---------- QUESTION 1: mood, with input validation ----------\nmood = input(\"Are you in the mood for something INTENSE or something RELAXING? (type intense or relaxing) \")\nwhile mood != \"intense\" and mood != \"relaxing\":\n    print(\"Hmm, that's not one of the options -- please type exactly 'intense' or 'relaxing'.\")\n    mood = input(\"Intense or relaxing? \")\n\n# ---------- QUESTION 2: company, with input validation ----------\nwatching_with = input(\"Are you watching ALONE or with OTHERS? (type alone or others) \")\nwhile watching_with != \"alone\" and watching_with != \"others\":\n    print(\"That's not a valid option -- please type exactly 'alone' or 'others'.\")\n    watching_with = input(\"Alone or others? \")\n\n# ---------- QUESTION 3: scare tolerance, with input validation ----------\nscary_ok = input(\"Are you okay with something scary tonight? (yes/no) \")\nwhile scary_ok != \"yes\" and scary_ok != \"no\":\n    print(\"Please answer with exactly 'yes' or 'no'.\")\n    scary_ok = input(\"Okay with scary? (yes/no) \")\n\n# ---------- THE ALGORITHM: nested if-else + a compound if that both matter ----------\nif mood == \"intense\":\n    if watching_with == \"alone\":\n        if scary_ok == \"yes\":\n            recommendation = \"Horror Movie\"\n            reason = \"intense, alone, and okay with scares -- horror hits different solo.\"\n        else:\n            recommendation = \"Action Thriller\"\n            reason = \"intense and alone, but keeping the scares out.\"\n    else:\n        recommendation = \"Group Action Movie\"\n        reason = \"intense with company -- something everyone can react to together.\"\nelse:\n    # Compound condition: BOTH parts matter here. Change either one and the\n    # recommendation changes -- this isn't just an \"and\" for show.\n    if watching_with == \"others\" and scary_ok == \"no\":\n        recommendation = \"Comedy Special\"\n        reason = \"relaxing, with others, and no scares -- comedy's the easy win.\"\n    else:\n        recommendation = \"Documentary\"\n        reason = \"relaxing, and either solo or open to something heavier -- a documentary fits.\"\n\nprint(\"\")\nprint(\"Your movie:\", recommendation)\nprint(\"Check the Theater for your full reveal!\")\n\n# ---------- THE REVEAL (one Theater scene, built from the values above) ----------\n",
          "folderId": "0",
          "active": true
        }
