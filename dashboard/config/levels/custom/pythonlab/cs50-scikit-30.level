          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 5.5\n# Standard Description: Describe the issue of \"black-box\" ML models.\n#\n# Rationale: Why did the AI say \"No\" to my loan? If the AI is a \"Black Box,\" \n# even the engineers might not know why! This tutorial compares a \n# Decision Tree (which is transparent) with a Random Forest (which is a \n# Black Box) to show why \"Explainability\" is important in AI ethics.\n\n\"\"\"\nWelcome! Have you ever asked a friend \"Why?\" and they just said \"Because!\"?\nThat's a Black Box model. It gives you an answer, but it can't explain its \nreasoning.\n\n1. Interpretable Models: Like a recipe. You can see every step.\n2. Black Box Models: Like a magic crystal ball. It works well, but it's a mystery.\n\"\"\"\n\nimport matplotlib.pyplot as plt\nfrom sklearn.datasets import load_iris\nfrom sklearn.tree import DecisionTreeClassifier, plot_tree\nfrom sklearn.ensemble import RandomForestClassifier\n\n# --- THE DATA ---\niris = load_iris()\nX, y = iris.data, iris.target\n\n# --- PART 1: THE INTERPRETABLE MODEL (Decision Tree) ---\nprint(\"--- Part 1: The Transparent Model ---\")\n# A single tree is easy to read. We can literally DRAW the logic.\ntree = DecisionTreeClassifier(max_depth=3)\ntree.fit(X, y)\n\nplt.figure(figsize=(12, 6))\nplot_tree(tree, feature_names=iris.feature_names, class_names=iris.target_names, filled=True)\nplt.title(\"Interpretable: You can follow the lines to see WHY it chose a species!\")\nplt.show()\n\n# --- PART 2: THE BLACK BOX (Random Forest) ---\nprint(\"\\n--- Part 2: The Black Box ---\")\n# A Forest has 100 trees. How do you follow 100 different logic paths at once?\n# You can't! It's too complex for a human to explain.\nforest = RandomForestClassifier(n_estimators=100)\nforest.fit(X, y)\n\nprint(\"The Forest is trained. It is very accurate!\")\nprint(\"But... can you tell me exactly why it predicted 'Setosa' for a specific flower?\")\nprint(\"No. It's a Black Box.\")\n\n\"\"\"\n--- YOUR TURN ---\nThink about these two situations. Which one NEEDS an interpretable model \n(where you can explain 'Why')?\n\nScenario A: An AI that suggests which Netflix movie to watch.\nScenario B: An AI that decides if a person should be allowed to go to jail.\n\n1. Which scenario requires an explanation?\n2. Why is a \"Black Box\" dangerous in Scenario B?\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\n# TODO: Answer the questions!\n# Needs_Explanation = \"___\"\n# Danger_Reason = \"___\"\n",
          "folderId": "0",
