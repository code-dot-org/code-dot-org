        "0": {
          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "import pandas as pd\nimport matplotlib.pyplot as plt\n\n# Read the dataset\ndata = pd.read_csv('Airline_Ratings.csv')\n\n# Group passenger counts by class and satisfaction\nstacked_data = data.groupby(\n    ['Class', 'Satisfaction']\n)['Count'].sum().unstack()\n\n# Create the stacked bar chart\nstacked_data.plot(kind='bar', stacked=True)\n\nplt.legend(title='Satisfaction')\nplt.xticks(rotation=0)\nplt.xlabel('Passenger Class')\nplt.ylabel('Number of Passengers')\nplt.title('Passenger Satisfaction by Class')\n\nplt.show()\n\n# Total passenger counts by satisfaction\n\n\n# Create the pie chart",
          "folderId": "0",
          "active": false,
          "open": true,
          "type": "locked_starter"
        },
        "1": {
          "id": "1",
          "name": "Airline_Ratings.csv",
          "language": "csv",
          "contents": "Class,Satisfaction,Count\nBusiness,Neutral or Dissatisfied,18994\nBusiness,Satisfied,43166\nEconomy,Neutral or Dissatisfied,47366\nEconomy,Satisfied,10943\nEconomy Plus,Neutral or Dissatisfied,7092\nEconomy Plus,Satisfied,2319\n",
          "folderId": "0",
