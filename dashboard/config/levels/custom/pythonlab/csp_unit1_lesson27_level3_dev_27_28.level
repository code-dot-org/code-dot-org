    "validation_file": {
      "id": "1",
      "name": "test.py",
      "contents": "import ast\nimport contextlib\nimport io\nfrom unittest import TestCase\nfrom unittest.mock import patch\n\n\nclass TestMakeCustomCalculator(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Parse the source for required patterns, then run it with\n        mocked input() and capture the output.\"\"\"\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n        cls.tree = ast.parse(cls.source)\n\n        input_call_count = sum(\n            1 for n in ast.walk(cls.tree)\n            if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == \"input\"\n        )\n        mock_answers = [str(10 + i) for i in range(max(input_call_count, 1))]\n\n        cls.namespace = {}\n        stdout = io.StringIO()\n        cls.run_error = None\n        try:\n            with patch(\"builtins.input\", side_effect=mock_answers), contextlib.redirect_stdout(stdout):\n                exec(compile(cls.source, \"main.py\", \"exec\"), cls.namespace)\n        except Exception as e:\n            cls.run_error = e\n        cls.stdout_text = stdout.getvalue()\n        cls.stdout_before_input, cls.stdout_after_input = cls._split_output_around_first_input(cls.tree, cls.source)\n\n    @staticmethod\n    def _split_output_around_first_input(tree, source):\n        \"\"\"Best-effort: find the line number of the first input() call,\n        then separate printed output into before/after that point by\n        re-running twice -- once stopping input() early to force a\n        failure after any pre-input prints, once running fully.\"\"\"\n        return None, None  # see note below; not used by current tests\n\n    def test_asks_for_input(self):\n        \"\"\"Asks the user for input\"\"\"\n        has_input_call = any(\n            isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == \"input\"\n            for n in ast.walk(self.tree)\n        )\n        self.assertTrue(\n            has_input_call,\n            \"We didn't find any input() calls. Ask the user for input to use in your calculator.\"\n        )\n\n    def test_runs_without_error(self):\n        \"\"\"Runs without crashing\"\"\"\n        self.assertIsNone(\n            self.run_error,\n            f\"Your program raised an error while running: {self.run_error}.\"\n        )\n\n    def test_converts_input_with_type_functions(self):\n        \"\"\"Converts input using str(), int(), or float()\"\"\"\n        called_names = {\n            n.func.id for n in ast.walk(self.tree)\n            if isinstance(n, ast.Call) and isinstance(n.func, ast.Name)\n        }\n        self.assertTrue(\n            called_names & {\"str\", \"int\", \"float\"},\n            \"We didn't find str(), int(), or float() being used anywhere. Convert your input() values to the correct data type.\"\n        )\n\n    def test_uses_arithmetic_formula(self):\n        \"\"\"Uses a formula with arithmetic operators\"\"\"\n        arithmetic_ops = (ast.Add, ast.Sub, ast.Mult, ast.Div, ast.Mod, ast.Pow, ast.FloorDiv)\n        has_arithmetic = any(\n            isinstance(n, ast.BinOp) and isinstance(n.op, arithmetic_ops)\n            for n in ast.walk(self.tree)\n        )\n        self.assertTrue(\n            has_arithmetic,\n            \"We didn't find any arithmetic (+, -, *, /, %, etc.) being used in a formula. Use one to calculate your result.\"\n        )\n\n    def test_prints_a_result(self):\n        \"\"\"Prints a result to the user\"\"\"\n        if self.run_error is not None:\n            self.skipTest(\"Fix the error above first.\")\n        self.assertTrue(\n            self.stdout_text.strip(),\n            \"Your program didn't print anything. Make sure you print the result, with units and guidance.\"\n        )",
      "folderId": "0",
      "active": false,
      "type": "validation"
    }
