    "teacher_markdown": "**Coding Tip:** If nothing inside the loop changes the value being checked, the condition can never become False.",
    "validation_file": {
      "id": "1",
      "name": "test.py",
      "contents": "from unittest import TestCase\nfrom unittest_runner import ValidationProtocol\n\n\nclass TestInvestigateDebug(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Run the student's code once and save the results\"\"\"\n        cls.stdout = ValidationProtocol().get_stdout_logs()\n\n    def test_loop_prints_correct_sequence_and_stops(self):\n        \"\"\"Prints 0, 1, 2, 3, 4 and then stops\"\"\"\n        if not self.stdout:\n            self.skipTest(\"Nothing printed at all. Make sure print(count) is still inside the loop.\")\n        expected = [\"0\", \"1\", \"2\", \"3\", \"4\"]\n        self.assertEqual(\n            self.stdout,\n            expected,\n            f\"Expected the loop to print 0 through 4, in order, then stop — but we got {self.stdout}. \"\n            \"If the list is longer than 5 or missing, check whether count is actually being updated inside the loop.\"\n        )",
