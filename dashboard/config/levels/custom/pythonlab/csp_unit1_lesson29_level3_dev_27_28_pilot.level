      "name": "test.py",
      "contents": "import ast\nfrom unittest import TestCase\n\n\nclass TestModifyLightingDesigner(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Parse the source statically -- same reasoning as the Sound\n        Designer and Stage Director levels: this draws a full Theater\n        scene and calls play(), which we have no safe way to execute or\n        verify visually.\"\"\"\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n        cls.tree = ast.parse(cls.source)\n\n    def _find_calls(self, func_name):\n        return [\n            n for n in ast.walk(self.tree)\n            if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == func_name\n        ]\n\n    def test_uses_randint_for_red_green_and_blue(self):\n        \"\"\"Uses randint() to generate red, green, and blue values, ranging 0 to 255\"\"\"\n        randint_calls = self._find_calls(\"randint\")\n        self.assertGreaterEqual(\n            len(randint_calls),\n            3,\n            f\"Expected 3 separate randint() calls (one each for red, green, blue), but found {len(randint_calls)}.\"\n        )\n        for call in randint_calls:\n            self.assertEqual(len(call.args), 2, \"Each randint() call should take two numbers, like randint(0, 255).\")\n            low_node, high_node = call.args\n            low = low_node.value if isinstance(low_node, ast.Constant) else None\n            high = high_node.value if isinstance(high_node, ast.Constant) else None\n            self.assertEqual(\n                (low, high),\n                (0, 255),\n                f\"Expected randint(0, 255), but found randint({low}, {high}).\"\n            )\n\n    def test_color_uses_random_variables(self):\n        \"\"\"Updates the spotlight's Color() to use the random red, green, and blue variables, not the original hardcoded 255, 0, 255\"\"\"\n        color_calls = self._find_calls(\"Color\")\n        self.assertEqual(\n            len(color_calls),\n            1,\n            f\"Expected exactly 1 Color() call, but found {len(color_calls)}. Make sure you haven't added or removed one.\"\n        )\n        color_call = color_calls[0]\n        self.assertEqual(\n            len(color_call.args),\n            3,\n            \"Color() should take three arguments: red, green, and blue.\"\n        )\n\n        original_values = (255, 0, 255)\n        randint_assigned_names = {\n            t.id\n            for node in ast.walk(self.tree)\n            if isinstance(node, ast.Assign)\n            and isinstance(node.value, ast.Call)\n            and isinstance(node.value.func, ast.Name)\n            and node.value.func.id == \"randint\"\n            for t in node.targets\n            if isinstance(t, ast.Name)\n        }\n\n        for i, (arg, original_value) in enumerate(zip(color_call.args, original_values)):\n            self.assertFalse(\n                isinstance(arg, ast.Constant) and arg.value == original_value,\n                f\"Color()'s argument #{i + 1} is still hardcoded to {original_value}. Update it to use your random variable.\"\n            )\n            self.assertIsInstance(\n                arg,\n                ast.Name,\n                f\"Color()'s argument #{i + 1} should be a variable, not a number written directly.\"\n            )\n            self.assertIn(\n                arg.id,\n                randint_assigned_names,\n                f\"The variable used for Color()'s argument #{i + 1} ({arg.id}) doesn't appear to be set from randint().\"\n            )",
      "folderId": "0",
