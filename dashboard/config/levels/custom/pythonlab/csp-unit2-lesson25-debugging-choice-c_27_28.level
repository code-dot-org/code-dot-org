    "validation_file": {
      "id": "2",
      "name": "test.py",
      "contents": "import ast\nfrom unittest import TestCase\nfrom unittest_runner import ValidationProtocol\n\n\ndef _count_calls(node, name):\n    return sum(\n        1 for n in ast.walk(node)\n        if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == name\n    )\n\n\ndef _find_wall_hug_units(tree):\n    \"\"\"Find each `if can_move(): while can_move(): move(); paint()\n    else: turn_left() * k` block, returning the number of turn_left()\n    calls in its else-branch (k).\"\"\"\n    units = []\n    for node in ast.walk(tree):\n        if not isinstance(node, ast.If):\n            continue\n        test_calls_can_move = _count_calls(node.test, \"can_move\") > 0\n        has_inner_while = any(\n            isinstance(s, ast.While) and _count_calls(s.test, \"can_move\") > 0\n            and _count_calls(s, \"move\") > 0 and _count_calls(s, \"paint\") > 0\n            for s in node.body\n        )\n        if test_calls_can_move and has_inner_while:\n            turn_count = sum(_count_calls(stmt, \"turn_left\") for stmt in node.orelse)\n            units.append((node.lineno, turn_count))\n    return units\n\n\nclass TestDebugZigzagPath(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Parse the source's wall-hugging structure, then try running the\n        program to catch any out-of-paint or invalid-move crash.\"\"\"\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n        cls.tree = ast.parse(cls.source)\n        cls.wall_hug_units = _find_wall_hug_units(cls.tree)\n\n        cls.painter = None\n        cls.run_error = None\n        try:\n            log = ValidationProtocol().get_neighborhood_log()\n            cls.painter = log.painter_logs[0] if log.painter_logs else None\n        except Exception as e:\n            cls.run_error = e\n\n    def test_runs_without_running_out_of_paint_or_hitting_a_wall(self):\n        \"\"\"Runs without an out-of-paint or invalid-move error\"\"\"\n        self.assertIsNone(\n            self.run_error,\n            f\"Your program raised an error while running: {self.run_error}. \"\n            \"This usually means either set_paint() wasn't given enough paint for the full path, \"\n            \"or the Painter tried to move/paint somewhere it can't.\"\n        )\n\n    def test_has_two_wall_hugging_loops(self):\n        \"\"\"Has two separate wall-hugging loops: the original path, and a new one for the zig-zag\"\"\"\n        self.assertGreaterEqual(\n            len(self.wall_hug_units),\n            2,\n            f\"Expected to find 2 wall-hugging loops (if can_move(): while can_move(): move(); paint() ...), \"\n            f\"but found {len(self.wall_hug_units)}. Make sure you added a second loop after debugging the first.\"\n        )\n\n    def test_second_loop_turns_once_instead_of_reversing(self):\n        \"\"\"The added loop turns once (90 degrees) instead of reversing, to create the zig-zag\"\"\"\n        if len(self.wall_hug_units) < 2:\n            self.skipTest(\"Add the second wall-hugging loop first.\")\n        turn_counts = [count for _, count in self.wall_hug_units]\n        self.assertIn(\n            1,\n            turn_counts,\n            f\"None of your wall-hugging loops turn just once when blocked (found turn counts: {turn_counts}). \"\n            \"The zig-zag loop should turn_left() a single time when it can't move, not reverse direction with multiple turns.\"\n        )\n\n    def test_moves_and_paints_match(self):\n        \"\"\"Paints a yellow square every time the Painter moves\"\"\"\n        if self.run_error is not None:\n            self.skipTest(\"Fix the run-time error above first.\")\n        if self.painter is None:\n            self.skipTest(\"No painter actions found yet. Make sure your program runs without errors.\")\n        move_count = self.painter.action_count(\"MOVE\")\n        paint_count = self.painter.action_count(\"PAINT\")\n        self.assertGreater(move_count, 0, \"We didn't see the Painter move at all.\")\n        self.assertEqual(\n            move_count,\n            paint_count,\n            f\"Expected every move() to be paired with a paint() ({move_count} moves vs {paint_count} paints). \"\n            \"If these don't match, the Painter may have run out of paint partway through.\"\n        )\n\n    def test_ends_at_food_truck(self):\n        \"\"\"Ends at the food truck's location (6th column, 7th row down)\"\"\"\n        if self.run_error is not None:\n            self.skipTest(\"Fix the run-time error above first.\")\n        if self.painter is None:\n            self.skipTest(\"No painter actions found yet. Make sure your program runs without errors.\")\n        ending = self.painter.ending_position\n        self.assertEqual(\n            (ending.x, ending.y),\n            (5, 6),\n            f\"Expected the Painter to end at column 6, row 7 (x=5, y=6) where the food truck is, \"\n            f\"but it ended at x={ending.x}, y={ending.y}. Check your zig-zag loop's range and turn count.\"\n        )",
      "folderId": "0",
      "active": false,
      "type": "validation"
