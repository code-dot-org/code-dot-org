    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from neighborhood import *\n\nset_paint(16)\n\nfor step in range(7):\n    if can_move():\n        while can_move():\n            move()\n            paint(\"yellow\")\n    else:\n        turn_left()\n        turn_left()\n        turn_left()",
          "folderId": "0",
          "active": true
        }
      },
