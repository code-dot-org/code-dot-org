          "id": "0",
          "name": "main.py",
          "contents": "def ask(question):\n  while True:\n    answer = input(f\"{question} (yes, no): \")\n    if answer.lower() == \"yes\":\n      return True\n    elif answer.lower() == \"no\":\n      return False\n    else:\n      print(\"Try again!\")\n\n\ndef main():\n  # TODO: Implement your conversational AI here\n  print(\"Hi! I can help you make a decision.\")\n\n\nmain()\n",
