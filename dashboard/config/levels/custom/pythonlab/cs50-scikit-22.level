          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 3.6\n# Standard Description: Explain Maximum Likelihood Estimation (MLE).\n#\n# Rationale: How does an AI know which \"guess\" is the best? It uses Maximum \n# Likelihood Estimation (MLE). MLE is a way of saying: \"Which set of rules \n# makes the data we ALREADY HAVE look the most normal and expected?\" \n# This tutorial uses Logistic Regression to show how we pick the \"most \n# likely\" line.\n\n\"\"\"\nWelcome! Imagine you find a wet umbrella on the floor. \nWhich is the most LIKELY reason it's there?\nA) It rained outside.\nB) Someone spilled a giant bucket of water by accident.\n\nBoth could be true, but \"A\" is much more LIKELY based on what we know \nabout the world. AI models use a math version of this called MLE.\n\"\"\"\n\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom sklearn.linear_model import LogisticRegression\nfrom scipy.stats import norm\n\n# --- PART 1: THE IDEA OF LIKELIHOOD ---\nprint(\"--- Part 1: Visualizing Likelihood ---\")\n# Let's say we have a data point at X=10.\n# Which center (mean) is more likely for this data? \n# A center at 10, or a center at 50?\n\nx_axis = np.linspace(0, 60, 100)\nplt.plot(x_axis, norm.pdf(x_axis, 10, 5), label=\"Guess A: Center=10\", color='green')\nplt.plot(x_axis, norm.pdf(x_axis, 50, 5), label=\"Guess B: Center=50\", color='red')\nplt.scatter([10], [0.01], color='black', s=100, label=\"Our Data Point\")\n\nplt.title(\"Maximum Likelihood: Which 'Mountain' fits our data best?\")\nplt.legend()\nplt.show()\n\nprint(\"Notice the black dot is at the TOP of the green mountain.\")\nprint(\"The Green Mountain is the 'Maximum Likelihood' for that data point.\")\n\n# --- PART 2: MLE IN MODELS ---\nprint(\"\\n--- Part 2: MLE in Logistic Regression ---\")\n# When we run Logistic Regression, the computer is actually testing \n# thousands of \"mountains\" to find the one that fits our data best.\n\nX = np.array([[1], [2], [3], [4], [5], [6], [7], [8]])\ny = np.array([0, 0, 0, 0, 1, 1, 1, 1]) # 0s for low numbers, 1s for high\n\nmodel = LogisticRegression()\nmodel.fit(X, y)\n\n# The 'coef_' and 'intercept_' are the values the computer found \n# using the MLE method!\nprint(f\"The model found that the most likely 'split point' is between 4 and 5.\")\n\n\"\"\"\n--- YOUR TURN ---\nImagine you have a coin. You flip it 10 times and get \"Heads\" 9 times.\n1. What is the Maximum Likelihood for the probability of getting heads?\n   A) 0.5 (It's a fair coin)\n   B) 0.9 (It's a biased coin)\n2. Why does MLE choose the answer that it does?\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\n# TODO: Explain your answer!\n# MLE_Answer = \"___\"\n# Reason = \"___\"\n",
