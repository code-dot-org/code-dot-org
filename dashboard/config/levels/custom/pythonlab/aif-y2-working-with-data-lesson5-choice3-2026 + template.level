          "name": "main.py",
          "contents": "import csv\n\nfile_1 = open(\"app_1.csv\")\nreader_1 = csv.DictReader(file_1)\napp_1_times = []\nfor row in reader_1:\n    time = row[\"delivery_time\"]\n    app_1_times.append(time)\nfile_1.close()\n\nfile_2 = open(\"app_2.csv\")\nreader_2 = csv.DictReader(file_2)\napp_2_times = []\nfor row in reader_2:\n    time = row[\"delivery_time\"]\n    app_2_times.append(time)\nfile_2.close()\n\nprint(app_1_times)\nprint(app_2_times)",
