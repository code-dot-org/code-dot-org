    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "import csv\n\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.tree import DecisionTreeClassifier\n\nfrom helpers import tokenize, visualize_model\n\n\ndef get_features(text):\n  # TODO: Compute bag of words features\n  counts = {}\n  return counts\n\n\n# Read data\nf = open(\"recipes.csv\")\ndata = list(csv.DictReader(f))\n\n# Compute features and labels for data\nall_features = [get_features(row[\"text\"]) for row in data]\noutputs = [row[\"label\"] for row in data]\n\n\n# Get all unique words in dataset\nvocabulary = []\nfor features in all_features:\n  for word in features:\n    if word not in vocabulary:\n      vocabulary.append(word)\nvocabulary.sort()\n\n# For each input, compute feature values for all words in vocabulary\ninputs = []\nfor features in all_features:\n  vector = []\n  for word in vocabulary:\n    if word in features:\n      vector.append(features[word])\n    else:\n      vector.append(0)\n  inputs.append(vector)\n\n# Split data into training and testing sets\ntrain_inputs, test_inputs, train_outputs, test_outputs = train_test_split(\n  inputs, outputs, test_size=0.25\n)\n\n# Train model\nmodel = DecisionTreeClassifier()\nmodel.fit(train_inputs, train_outputs)\n\n# Visualize decision tree\nvisualize_model(model, vocabulary)\n\n# Test model\nmodel_score = model.score(test_inputs, test_outputs)\nprint(\"Model score on test data:\", model_score)\n\nf.close()",
          "folderId": "0",
          "active": true
        },
        "1": {
          "id": "1",
          "name": "recipes.csv",
          "contents": "text,label\n\"Scoop the dough onto the baking sheet and bake until the edges are golden.\",cookie\n\"Pour the batter into the pan and bake until a toothpick comes out clean.\",cake\n\"Chill the dough so it does not spread across the baking sheet.\",cookie\n\"Let the layers cool in the pan before you spread the frosting.\",cake\n\"Stir the chocolate chips into the dough until they are evenly mixed.\",cookie\n\"Whisk the cocoa into the batter until the batter is smooth.\",cake\n\"Roll the dough into balls and press each one flat on the sheet.\",cookie\n\"Divide the batter between two round pans and bake for thirty minutes.\",cake\n\"Bake for ten minutes, then move them from the hot sheet to a rack.\",cookie\n\"Frost the cooled layers with a thin coat, then chill and frost again.\",cake\n\"The dough should be stiff enough to hold a ball on the baking sheet.\",cookie\n\"The batter should be thin enough to pour smoothly into the pan.\",cake\n\"Pull them off the sheet while the centers still look soft and chewy.\",cookie\n\"Do not open the oven while it bakes or the center of the layer may sink.\",cake\n\"Freeze the dough in balls and bake them straight from the freezer.\",cookie\n\"Brush each layer with syrup so every slice stays moist under the frosting.\",cake\n\"Mix the oats into the dough last, then scoop it onto the sheet.\",cookie\n\"Fold the egg whites into the batter gently to keep the layers light.\",cake\n\"Space the balls of dough far apart because they spread as they bake.\",cookie\n\"Run a knife around the pan before you turn the layer out to cool.\",cake\n\"Bake one test round to see how much the dough spreads on your sheet.\",cookie\n\"Bake until the top springs back and a toothpick comes out clean.\",cake\n\"Line the baking sheet with parchment so they lift off cleanly.\",cookie\n\"Line the pan with a parchment circle so the layer releases cleanly.\",cake\n\"Cream the butter and sugar, then work the flour into the dough.\",cookie\n\"Beat the butter and sugar, then alternate the flour and milk into the batter.\",cake\n\"Sprinkle salt over the balls of dough on the sheet right before baking.\",cookie\n\"Dust the cooled layers with powdered sugar instead of spreading frosting.\",cake\n\"Add flour a spoonful at a time until the dough is no longer sticky.\",cookie\n\"Fill each pan two thirds full so the batter has room to rise.\",cake\n\"Cut shapes from the rolled dough and lift them onto the baking sheet.\",cookie\n\"Stack the cooled layers with frosting spread between each one.\",cake\n\"Store them in a sealed container so they stay soft and chewy.\",cookie\n\"Keep the frosted layers under a dome so the slices do not dry out.\",cake\n\"Press a fork into each ball of dough before they go in the oven.\",cookie\n\"Smooth the frosting over the sides with an offset spatula.\",cake\n\"Watch the sheet closely because they go from golden to burnt quickly.\",cookie\n\"Check at twenty five minutes because every oven bakes a layer differently.\",cake\n\"Dip them in melted chocolate once cooled and set them on the parchment.\",cookie\n\"Pipe a border of frosting around the top edge of the stacked layers.\",cake\n\"Stir sprinkles into the dough by hand, then scoop it onto the baking sheet.\",cookie\n\"Beat cream cheese and butter smooth, then spread the frosting over the layers.\",cake\n\"Roll each ball of dough in cinnamon sugar before it hits the sheet.\",cookie\n\"Pour the batter into a greased bundt pan and smooth the top with a spatula.\",cake\n\"Let them rest on the hot sheet five minutes before you move them.\",cookie\n\"Let the layers cool completely or the frosting will slide right off.\",cake\n\"Swap half the chocolate chips in the dough for chopped walnuts.\",cookie\n\"Bake the batter in one sheet pan if you want squares instead of stacked layers.\",cake\n\"Flatten each ball of dough with a glass so they bake evenly.\",cookie\n\"Lower the oven to 325 and bake the layers longer for an even crumb.\",cake\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "helpers.py",
          "contents": "import re\n\n\ndef tokenize(text):\n  return re.findall(r\"\\w+\", text.lower())\n\n\ndef visualize_model(model, feature_names=None, decimals=2):\n  \"\"\"Pretty-print the questions a fitted DecisionTreeClassifier asks.\"\"\"\n  tree = model.tree_\n\n  if feature_names is None:\n    n = getattr(model, \"n_features_in_\", None) or tree.n_features\n    feature_names = [\"feature_\" + str(i) for i in range(n)]\n\n  TEE, ELBOW, BAR, ARROW = \"├─\", \"└─\", \"│\", \"→\"\n  LABELS = (\"YES\", \"NO \")\n  STEM = len(TEE) + 1 + len(LABELS[0]) + 1 + len(ARROW) + 1\n\n  def number(x):\n    text = \"{:.{}f}\".format(x, decimals)\n    return text.rstrip(\"0\").rstrip(\".\") if \".\" in text else text\n\n  def class_counts(node):\n    raw = list(tree.value[node][0])\n    total = tree.n_node_samples[node]\n    if abs(sum(raw) - total) > 1e-6:  # sklearn >= 1.4 stores proportions\n      raw = [p * total for p in raw]\n    return [int(round(c)) for c in raw], total\n\n  def is_leaf(node):\n    return tree.children_left[node] == -1\n\n  def describe_leaf(node):\n    counts, total = class_counts(node)\n    best = max(range(len(counts)), key=lambda i: counts[i])\n    answer = str(model.classes_[best])\n    if counts[best] == total:\n      plural = \"\" if total == 1 else \"s\"\n      return \"{}  ({} example{})\".format(answer, total, plural)\n    order = sorted(range(len(counts)), key=lambda i: -counts[i])\n    mix = \", \".join(\n      \"{} {}\".format(counts[i], model.classes_[i]) for i in order if counts[i] > 0\n    )\n    return \"{}  ({})\".format(answer, mix)\n\n  def question(node):\n    return \"Is {} <= {}?\".format(\n      feature_names[tree.feature[node]],\n      number(float(tree.threshold[node])),\n    )\n\n  def describe(node):\n    return describe_leaf(node) if is_leaf(node) else question(node)\n\n  def walk(node, prefix):\n    children = (tree.children_left[node], tree.children_right[node])\n    for i, child in enumerate(children):\n      last = i == len(children) - 1\n      connector = ELBOW if last else TEE\n      print(\n        \"{}{} {} {} {}\".format(\n          prefix, connector, LABELS[i], ARROW, describe(child)\n        )\n      )\n      if not is_leaf(child):\n        spacer = \" \" if last else BAR\n        walk(child, prefix + spacer + \" \" * (STEM - len(spacer)))\n\n  print(describe(0))\n  if not is_leaf(0):\n    walk(0, \"\")",
          "folderId": "0",
          "active": false,
          "type": "support"
        }
      },
