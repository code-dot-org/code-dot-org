    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from sklearn.linear_model import SGDClassifier\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.pipeline import make_pipeline\n\n# Recyclable items: [weight (ounces), transparency (0-10)]\ninputs = [[0.4, 0], [1.0, 0], [0.3, 0], [1.5, 0], [3, 5], [14, 6], \n          [10, 4], [10, 2], [2, 5], [3, 4], [0.5, 9], [2, 7]]\n          \n# The bin each item belongs in\noutputs = [\"Aluminum\", \"Aluminum\", \"Aluminum\", \"Aluminum\", \"Glass\", \"Glass\", \n           \"Glass\", \"Glass\", \"Plastic\", \"Plastic\", \"Plastic\", \"Plastic\"]\n           \n# Three new items the network has never seen: [weight (ounces), transparency (0-10)]\nred_can = [0.5, 0]\ngreen_bottle = [10, 6]\nsmall_jar = [4, 8]\n\n# The names of the new items and the bin each one actually belongs in\nitems = [red_can, green_bottle, small_jar]\nitem_names = [\"Red Can\", \"Green Bottle\", \"Small Jar\"]\nactual_bins = [\"Aluminum\", \"Glass\", \"Glass\"]\n\n# Train a new network for each max_iter and report how it did on the three new items\n# Then try training for more iterations by changing max_iter in [1, 10] to [1, 10, 50, 100]\nfor max_iter in [1, 10]:\n    # tol=None makes each network use all of its passes instead of stopping early\n    model = make_pipeline(StandardScaler(), SGDClassifier(max_iter=max_iter, tol=None, random_state=4))\n    model.fit(inputs, outputs)\n    predictions = model.predict(items)\n    results = []\n    number_correct = 0\n    for name, prediction, actual in zip(item_names, predictions, actual_bins):\n        if prediction == actual:\n            results.append(f\"{name}: correct\")\n            number_correct += 1\n        else:\n            results.append(f\"{name}: wrong\")\n    accuracy = number_correct / len(actual_bins)\n    print(f\"max_iter {max_iter}: {accuracy:.0%} correct | {', '.join(results)}\")\n",
          "folderId": "0",
          "active": true
        }
      },
