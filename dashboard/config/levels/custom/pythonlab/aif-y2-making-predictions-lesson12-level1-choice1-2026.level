    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "import csv\n\nimport matplotlib.pyplot as plt\n\n# Data\nwith open(\"fishing.csv\") as f:\n  data = list(csv.DictReader(f))\n\ntimes = [\"dawn\", \"midday\", \"dusk\"]\n\n# Styling\nplt.rcParams.update({\"font.size\": 11, \"figure.dpi\": 140})\nstyles = {\n  \"caught\": {\n    \"marker\": \"o\",\n    \"color\": \"#0072B2\",\n    \"label\": \"Caught\"\n  },\n  \"not caught\": {\n    \"marker\": \"^\",\n    \"color\": \"#E69F00\",\n    \"label\": \"Not Caught\"\n  },\n}\n\n# Plotting\nfigure, axes_list = plt.subplots(\n  3,\n  1,\n  figsize=(6, 12),\n  sharex=True,\n  sharey=True\n)\n\nfor axes, time_of_day in zip(axes_list, times):\n  subset = [row for row in data if row[\"time-of-day\"] == time_of_day]\n\n  for outcome, style in styles.items():\n    x = [float(row[\"temp\"]) for row in subset if row[\"outcome\"] == outcome]\n    y = [\n      float(row[\"turbidity\"]) for row in subset if row[\"outcome\"] == outcome\n    ]\n    axes.scatter(\n      x,\n      y,\n      marker=style[\"marker\"],\n      color=style[\"color\"],\n      s=55,\n      edgecolors=\"black\",\n      linewidths=0.5,\n      label=style[\"label\"],\n    )\n\n  axes.set_title(f\"{time_of_day.title()} (n={len(subset)})\")\n  axes.set_ylabel(\"Turbidity (NTU)\")\n  axes.grid(True, linestyle=\":\", alpha=0.6)\n\naxes_list[-1].set_xlabel(\"Water Temperature (℉)\")\naxes_list[0].legend(title=\"Outcome\", loc=\"upper right\")\n\nfigure.suptitle(\"Bass Fishing\")\nfigure.tight_layout()\nplt.show()\n",
          "folderId": "0",
          "active": true
        },
