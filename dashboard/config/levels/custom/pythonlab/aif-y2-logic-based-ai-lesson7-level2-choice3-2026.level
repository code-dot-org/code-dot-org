          "name": "main.py",
          "contents": "def simulate(population, growth, days):\n  print(f\"Day 0: population of {population}\")\n  population = population + population * growth\n  \n  print(f\"Day 1: population of {population}\")\n  population = population + population * growth\n\n  print(f\"Day 2: population of {population}\")\n  population = population + population * growth\n\n\nsimulate(100, 1, 3)\n",
