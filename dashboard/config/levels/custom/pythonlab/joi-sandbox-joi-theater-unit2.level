        "1": {
          "id": "1",
          "name": "struggling_student.py",
          "contents": "# GAME PICKER -- Single Match (STRUGGLING STUDENT SAMPLE)\n\nfrom theater import *\n\nprint(\"GAME PICKER\")\nname = input(\"Name: \")\n\n# FLAW (Readability): option1..option4 are the template's placeholder names.\noption1 = \"Puzzle Quest\"\noption2 = \"Speed Racer\"\noption3 = \"Farm Life\"\noption4 = \"Zombie Zone\"\n\n# welcome screen\nclear(\"#222222\")\nset_text_style(\"sans\", \"bold\")\nset_text_color(\"#ffffff\")\nset_text_height(24)\ndraw_text(\"GAME PICKER\", 120, 200)\nplay()\n\n# ----- QUESTION 1 -----\n# This is the ONLY input with a while loop, and the error message is a\n# bare \"try again.\"\n# FLAW (Validation): one loop on one input, no explanation of what's wrong\nanswer = input(\"Chill or hyped? 1 = chill, 2 = hyped: \")\nwhile answer != \"1\" and answer != \"2\":\n    print(\"Try again\")\n    answer = input(\"Chill or hyped? 1 = chill, 2 = hyped: \")\nmood = answer\n\n# FLAW (Validation): no loop here, so typing \"banana\" slips through\nfriends = input(\"Playing with friends? 1 = yes, 2 = no: \")\n\n# FLAW (Validation): same\ntime = input(\"How long do you have? 1 = short, 2 = long: \")\n\n# ----- THE ALGORITHM -----\n# FLAW (Conditional Logic): the core decision is a flat list of simple ifs.\n# Only the mood answer actually picks the game.\nif mood == \"1\":\n    result = option3\nif mood == \"2\":\n    result = option2\n\n# This is the project's one real nested if. The inner branch is reachable\n# and does change the result, so it partly meets the criterion.\nif friends == \"1\":\n    if mood == \"2\":\n        result = option4\n\n# FLAW (Conditional Logic): this \"compound\" is always true when the\n# input is valid, and it never changes the result. It is there to check a box.\nif time == \"1\" or time == \"2\":\n    print(\"Thanks for telling me how much time you have!\")\n\n# FLAW (Logic Coverage): nothing in the code can ever pick option1\n# (Puzzle Quest). The \"time\" answer is collected and then never used\n# to choose a game.\n\nprint(\"\")\nprint(\"You should play: \" + result)\n\n# FLAW (Personalization): the Theater screen shows the winner's name,\n# which is right, but the design and the text are identical for every\n# outcome. There is no reason shown, and nothing reflects the other answers.\nclear(\"#222222\")\nset_text_style(\"sans\", \"bold\")\nset_text_color(\"#ffffff\")\nset_text_height(18)\ndraw_text(\"Tonight you should play:\", 90, 170)\nset_text_color(\"#f5c518\")\nset_text_height(28)\ndraw_text(result, 90, 220)\nplay()\n\n# FLAW (Understanding & AI Evaluation): the reflection is on-topic but\n# generic. No original reasoning, no hand-traced case, and the AI feedback\n# is named but never accepted, revised, or rejected with a reason.\n# WHY SINGLE MATCH: Because you only play one game at a time.\n# OVERRIDE RULE: If you have friends and you're hyped you get Zombie Zone.\n# AI TUTOR: It told me to test a tie. I tried it and it was fine.\n\n# ============================================================\n# SCORING NOTES \n# ============================================================\n# Personalization & Responsiveness ...... Partial (mood and friends change\n#                                         the result; time and the theater\n#                                         screen don't)\n# Input Validation & Error Handling ..... Partial (one while loop exists, but\n#                                         the message is \"Try again\" and 2 of\n#                                         3 inputs are unprotected)\n# Conditional Logic (Nested & Compound) . Does not meet (the nested if works;\n#                                         the compound never affects the result)\n# Code Readability & Naming ............. Does not meet (option1..option4)\n# Understanding & AI Evaluation ......... Does not meet (generic; no traced\n#                                         case or accept/revise/reject)\n# Logic Coverage & Testing .............. Does not meet (Puzzle Quest is\n#                                         unreachable; no tested paths shown)",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "prototype.py",
          "contents": "# WHAT DO WE WATCH TONIGHT?\n# A recommendation engine. The Theater shows a screen before\n# each question, the console collects the answers, and the\n# Theater plays the final reveal.\n#\n# HOW THE SCREENS WORK: during the interview, every screen is a\n# single still picture -- we draw it and call play(), with NO\n# pause(). Pauses only appear in the finale, which is the\n# animated part.\n#\n# THE LOOK: every screen shares one design system --\n#   background   #101430  (deep cinema navy)\n#   panel        #1a2142  (card behind content)\n#   gold         #f5c518  (marquee gold)\n#   cream        #f8f4e3  (main text)\n#   dim          #8a91b4  (secondary text)\n# plus a film-strip border drawn by a for loop on every screen.\n\nfrom theater import *\n\n# ============================================================\n# SCREEN 1 -- WELCOME MARQUEE\n# ============================================================\nclear(\"#101430\")\n\n# film-strip borders: a loop draws the sprocket holes\nset_fill_color(\"#05070f\")\nremove_stroke_color()\ndraw_rectangle(0, 0, 400, 34)\ndraw_rectangle(0, 366, 400, 34)\nset_fill_color(\"#f8f4e3\")\nfor i in range(9):\n    hole_x = 14 + i * 44\n    draw_rectangle(hole_x, 11, 18, 12)\n    draw_rectangle(hole_x, 377, 18, 12)\n\n# red curtains on the sides\nset_fill_color(\"#7a1023\")\ndraw_rectangle(0, 34, 26, 332)\ndraw_rectangle(374, 34, 26, 332)\nset_fill_color(\"#5c0b1a\")\ndraw_rectangle(8, 34, 6, 332)\ndraw_rectangle(386, 34, 6, 332)\n\n# the marquee panel, with a soft shadow behind it\nset_fill_color(\"#05070f\")\ndraw_rectangle(52, 132, 300, 110)\nset_fill_color(\"#1a2142\")\ndraw_rectangle(46, 126, 300, 110)\nset_stroke_color(\"#f5c518\")\nset_stroke_width(3)\nremove_fill_color()\ndraw_rectangle(46, 126, 300, 110)\n\n# marquee bulbs around the panel, drawn by a loop\nremove_stroke_color()\nset_fill_color(\"#f5c518\")\nfor i in range(8):\n    bulb_x = 56 + i * 40\n    draw_ellipse(bulb_x, 114, 10, 10)\n    draw_ellipse(bulb_x, 240, 10, 10)\n\n# title\nset_text_style(\"serif\", \"bold\")\nset_text_color(\"#f5c518\")\nset_text_height(26)\ndraw_text(\"THE RECOMMENDER\", 50, 178)\nset_text_style(\"sans\", \"italic\")\nset_text_color(\"#f8f4e3\")\nset_text_height(15)\ndraw_text(\"what do we watch tonight?\", 108, 212)\nplay()\n\n# ----- THE FOUR OPTIONS -----\nmovie1 = \"Space Chase\"        # action / exciting\nmovie2 = \"The Last Laugh\"     # comedy / light\nmovie3 = \"Midnight Signal\"    # mystery / suspense\nmovie4 = \"Summer of Us\"       # drama / emotional\n\nscore1 = 0\nscore2 = 0\nscore3 = 0\nscore4 = 0\n\nprint(\"WHAT DO WE WATCH TONIGHT?\")\nname = input(\"First, what's your name? \")\n\n# ============================================================\n# SCREEN 2 -- PERSONALIZED WELCOME (a ticket with their name)\n# ============================================================\nclear(\"#101430\")\n\n# film-strip borders\nset_fill_color(\"#05070f\")\ndraw_rectangle(0, 0, 400, 34)\ndraw_rectangle(0, 366, 400, 34)\nset_fill_color(\"#f8f4e3\")\nfor i in range(9):\n    hole_x = 14 + i * 44\n    draw_rectangle(hole_x, 11, 18, 12)\n    draw_rectangle(hole_x, 377, 18, 12)\n\n# the ticket, tilted slightly, with shadow\nset_fill_color(\"#05070f\")\ndraw_rectangle(62, 150, 290, 96)\nset_fill_color(\"#f5c518\")\ndraw_rectangle(55, 142, 290, 96)\n# perforation line\nset_fill_color(\"#101430\")\nfor i in range(7):\n    draw_ellipse(296, 148 + i * 13, 6, 6)\n\nset_text_style(\"serif\", \"bold\")\nset_text_color(\"#101430\")\nset_text_height(13)\ndraw_text(\"ADMIT ONE\", 78, 168)\nset_text_height(24)\ndraw_text(\"Welcome, \" + name + \"!\", 78, 202)\nset_text_style(\"sans\", \"normal\")\nset_text_height(12)\ndraw_text(\"5 questions. 1 perfect movie.\", 78, 226)\nplay()\n\n# ============================================================\n# SCREEN 3 -- THE BATTERY CHECK (Q1 visual)\n# ============================================================\nclear(\"#101430\")\n\nset_fill_color(\"#05070f\")\ndraw_rectangle(0, 0, 400, 34)\ndraw_rectangle(0, 366, 400, 34)\nset_fill_color(\"#f8f4e3\")\nfor i in range(9):\n    hole_x = 14 + i * 44\n    draw_rectangle(hole_x, 11, 18, 12)\n    draw_rectangle(hole_x, 377, 18, 12)\n\nset_text_style(\"serif\", \"bold\")\nset_text_color(\"#f8f4e3\")\nset_text_height(22)\ndraw_text(\"Battery check\", 132, 76)\nset_stroke_color(\"#f5c518\")\nset_stroke_width(2)\ndraw_line(132, 88, 268, 88)\n\n# three battery cards with shadows\nremove_stroke_color()\nset_fill_color(\"#05070f\")\ndraw_rectangle(42, 122, 96, 130)\ndraw_rectangle(158, 122, 96, 130)\ndraw_rectangle(274, 122, 96, 130)\nset_fill_color(\"#1a2142\")\ndraw_rectangle(38, 116, 96, 130)\ndraw_rectangle(154, 116, 96, 130)\ndraw_rectangle(270, 116, 96, 130)\n\n# battery bodies (outline + nub)\nset_stroke_color(\"#f8f4e3\")\nset_stroke_width(3)\nremove_fill_color()\ndraw_rectangle(56, 140, 56, 30)\ndraw_rectangle(172, 140, 56, 30)\ndraw_rectangle(288, 140, 56, 30)\nremove_stroke_color()\nset_fill_color(\"#f8f4e3\")\ndraw_rectangle(112, 149, 6, 12)\ndraw_rectangle(228, 149, 6, 12)\ndraw_rectangle(344, 149, 6, 12)\n\n# the fills: full / half / 1%\nset_fill_color(\"#4ade80\")\ndraw_rectangle(59, 143, 50, 24)\nset_fill_color(\"#f5c518\")\ndraw_rectangle(175, 143, 25, 24)\nset_fill_color(\"#ef4444\")\ndraw_rectangle(291, 143, 5, 24)\n\nset_text_style(\"sans\", \"bold\")\nset_text_height(14)\nset_text_color(\"#4ade80\")\ndraw_text(\"1  HYPED\", 52, 200)\nset_text_color(\"#f5c518\")\ndraw_text(\"2  chill\", 178, 200)\nset_text_color(\"#ef4444\")\ndraw_text(\"3  at 1%\", 292, 200)\nset_text_style(\"sans\", \"italic\")\nset_text_height(11)\nset_text_color(\"#8a91b4\")\ndraw_text(\"menace mode\", 50, 222)\ndraw_text(\"cruising\", 178, 222)\ndraw_text(\"barely here\", 286, 222)\nplay()\n\n# ----- QUESTION 1 -----\nprint(\"\")\nprint(\"Q1: What's your energy level tonight?\")\nanswer = input(\"Type 1, 2, or 3: \")\nwhile answer != \"1\" and answer != \"2\" and answer != \"3\":\n    print(\"Oops -- please type 1, 2, or 3.\")\n    answer = input(\"Type 1, 2, or 3: \")\n\nenergy = int(answer)\n\nif energy == 1:\n    score1 = score1 + 3\n    score2 = score2 + 1\n    energy_label = \"battery: FULL\"\nif energy == 2:\n    score2 = score2 + 2\n    score4 = score4 + 2\n    energy_label = \"battery: chillin\"\nif energy == 3:\n    score3 = score3 + 2\n    score2 = score2 + 1\n    energy_label = \"battery: 1%\"\n\n# ============================================================\n# SCREEN 4 -- THE LIGHTBULB (Q2 visual)\n# ============================================================\nclear(\"#101430\")\n\nset_fill_color(\"#05070f\")\ndraw_rectangle(0, 0, 400, 34)\ndraw_rectangle(0, 366, 400, 34)\nset_fill_color(\"#f8f4e3\")\nfor i in range(9):\n    hole_x = 14 + i * 44\n    draw_rectangle(hole_x, 11, 18, 12)\n    draw_rectangle(hole_x, 377, 18, 12)\n\nset_text_style(\"serif\", \"bold\")\nset_text_color(\"#f8f4e3\")\nset_text_height(22)\ndraw_text(\"Brain status\", 138, 76)\nset_stroke_color(\"#f5c518\")\nset_stroke_width(2)\ndraw_line(138, 88, 262, 88)\n\n# bulb ON: glow rays drawn by a loop, then halo, then bulb\nset_stroke_color(\"#f5c518\")\nset_stroke_width(2)\ndraw_line(120, 105, 120, 92)\ndraw_line(78, 122, 68, 112)\ndraw_line(162, 122, 172, 112)\ndraw_line(64, 160, 50, 160)\ndraw_line(176, 160, 190, 160)\nremove_stroke_color()\nset_fill_color(\"#3a3413\")\ndraw_ellipse(78, 118, 84, 84)\nset_fill_color(\"#f5c518\")\ndraw_ellipse(90, 130, 60, 60)\nset_fill_color(\"#f8f4e3\")\ndraw_ellipse(102, 140, 16, 16)          # highlight\nset_fill_color(\"#8a91b4\")\ndraw_rectangle(108, 192, 24, 8)\ndraw_rectangle(111, 202, 18, 6)\n\n# bulb OFF: gray, unbothered\nset_fill_color(\"#2a2f4a\")\ndraw_ellipse(250, 130, 60, 60)\nset_fill_color(\"#8a91b4\")\ndraw_rectangle(268, 192, 24, 8)\ndraw_rectangle(271, 202, 18, 6)\n# little z z z\nset_text_style(\"sans\", \"bold\")\nset_text_color(\"#8a91b4\")\nset_text_height(14)\ndraw_text(\"z\", 318, 130)\nset_text_height(11)\ndraw_text(\"z\", 330, 118)\nset_text_height(8)\ndraw_text(\"z\", 340, 108)\n\nset_text_height(14)\nset_text_color(\"#f5c518\")\ndraw_text(\"1  make me think\", 55, 245)\nset_text_color(\"#8a91b4\")\ndraw_text(\"2  brain off\", 248, 245)\nplay()\n\n# ----- QUESTION 2 -----\nprint(\"\")\nprint(\"Q2: Do you want to think, or turn your brain off?\")\nanswer = input(\"Type 1 or 2: \")\nwhile answer != \"1\" and answer != \"2\":\n    print(\"Oops -- please type 1 or 2.\")\n    answer = input(\"Type 1 or 2: \")\n\nbrain = int(answer)\n\nif brain == 1:\n    score3 = score3 + 3\n    score4 = score4 + 1\n    brain_label = \"brain: ON\"\nelse:\n    score1 = score1 + 2\n    score2 = score2 + 2\n    brain_label = \"brain: OFF\"\n\n# ============================================================\n# SCREEN 5 -- THE TEARS FORECAST (Q3 visual)\n# ============================================================\nclear(\"#101430\")\n\nset_fill_color(\"#05070f\")\ndraw_rectangle(0, 0, 400, 34)\ndraw_rectangle(0, 366, 400, 34)\nset_fill_color(\"#f8f4e3\")\nfor i in range(9):\n    hole_x = 14 + i * 44\n    draw_rectangle(hole_x, 11, 18, 12)\n    draw_rectangle(hole_x, 377, 18, 12)\n\nset_text_style(\"serif\", \"bold\")\nset_text_color(\"#f8f4e3\")\nset_text_height(22)\ndraw_text(\"Tears forecast\", 128, 76)\nset_stroke_color(\"#f5c518\")\nset_stroke_width(2)\ndraw_line(128, 88, 272, 88)\n\n# rainy side: a cloud built from overlapping ellipses\nremove_stroke_color()\nset_fill_color(\"#8a91b4\")\ndraw_ellipse(58, 118, 46, 46)\ndraw_ellipse(86, 104, 56, 56)\ndraw_ellipse(120, 120, 44, 44)\ndraw_rectangle(64, 140, 96, 24)\n# raindrops under it, drawn by a loop\nset_fill_color(\"#6ee7ff\")\nfor i in range(4):\n    drop_x = 66 + i * 26\n    draw_ellipse(drop_x, 178, 10, 16)\n    draw_ellipse(drop_x + 13, 204, 10, 16)\n\n# sunny side: one unbothered sun\nset_fill_color(\"#f5c518\")\ndraw_ellipse(252, 120, 64, 64)\nset_fill_color(\"#f8f4e3\")\ndraw_ellipse(264, 130, 16, 16)          # highlight\n# sunglasses on the sun, because it chose peace\nset_fill_color(\"#101430\")\ndraw_rectangle(262, 142, 18, 10)\ndraw_rectangle(288, 142, 18, 10)\ndraw_rectangle(280, 145, 8, 4)\n\nset_text_style(\"sans\", \"bold\")\nset_text_height(14)\nset_text_color(\"#6ee7ff\")\ndraw_text(\"1  destroy me\", 56, 250)\nset_text_color(\"#f5c518\")\ndraw_text(\"2  zero tears\", 244, 250)\nset_text_style(\"sans\", \"italic\")\nset_text_height(11)\nset_text_color(\"#8a91b4\")\ndraw_text(\"100% chance\", 62, 270)\ndraw_text(\"emotional damage: declined\", 214, 270)\nplay()\n\n# ----- QUESTION 3 -----\nprint(\"\")\nprint(\"Q3: Is it okay if the movie makes you cry?\")\nanswer = input(\"Type 1 or 2: \")\nwhile answer != \"1\" and answer != \"2\":\n    print(\"Oops -- please type 1 or 2.\")\n    answer = input(\"Type 1 or 2: \")\n\ncrying_ok = int(answer)\n\nif crying_ok == 1:\n    score4 = score4 + 3\n    tears_label = \"tears: 100% chance\"\nelse:\n    score2 = score2 + 2\n    tears_label = \"tears: 0% chance\"\n\n# ============================================================\n# SCREEN 6 -- THE POPCORN COUNT (Q4 visual)\n# ============================================================\nclear(\"#101430\")\n\nset_fill_color(\"#05070f\")\ndraw_rectangle(0, 0, 400, 34)\ndraw_rectangle(0, 366, 400, 34)\nset_fill_color(\"#f8f4e3\")\nfor i in range(9):\n    hole_x = 14 + i * 44\n    draw_rectangle(hole_x, 11, 18, 12)\n    draw_rectangle(hole_x, 377, 18, 12)\n\nset_text_style(\"serif\", \"bold\")\nset_text_color(\"#f8f4e3\")\nset_text_height(22)\ndraw_text(\"Who's watching?\", 122, 76)\nset_stroke_color(\"#f5c518\")\nset_stroke_width(2)\ndraw_line(122, 88, 278, 88)\n\n# popcorn box with shadow, stripes drawn by a loop\nremove_stroke_color()\nset_fill_color(\"#05070f\")\ndraw_ellipse(150, 268, 110, 22)          # floor shadow\nset_fill_color(\"#c22030\")\ndraw_rectangle(158, 150, 88, 120)\nset_fill_color(\"#f8f4e3\")\nfor i in range(3):\n    stripe_x = 168 + i * 30\n    draw_rectangle(stripe_x, 150, 14, 120)\n# box label band\nset_fill_color(\"#f5c518\")\ndraw_rectangle(158, 196, 88, 24)\nset_text_style(\"sans\", \"bold\")\nset_text_color(\"#101430\")\nset_text_height(13)\ndraw_text(\"POPCORN\", 170, 213)\n# kernels piled on top\nset_fill_color(\"#f8f4e3\")\ndraw_ellipse(154, 126, 34, 34)\ndraw_ellipse(182, 114, 40, 40)\ndraw_ellipse(216, 126, 34, 34)\nset_fill_color(\"#f5c518\")\ndraw_ellipse(172, 120, 18, 18)\ndraw_ellipse(206, 116, 16, 16)\n\nset_text_style(\"sans\", \"italic\")\nset_text_color(\"#8a91b4\")\nset_text_height(13)\ndraw_text(\"count everyone on the couch\", 116, 300)\nplay()\n\n# ----- QUESTION 4 -----\nprint(\"\")\nprint(\"Q4: How many people are watching with you?\")\nanswer = input(\"Type a number: \")\nwhile answer == \"\":\n    print(\"Oops -- please type a number.\")\n    answer = input(\"Type a number: \")\n\ngroup_size = int(answer)\n\nif group_size >= 3:\n    score1 = score1 + 2\n    score2 = score2 + 2\nif group_size == 1 or group_size == 2:\n    score3 = score3 + 2\n    score4 = score4 + 1\n\n# ============================================================\n# SCREEN 7 -- THE GHOST (Q5 visual)\n# ============================================================\nclear(\"#101430\")\n\nset_fill_color(\"#05070f\")\ndraw_rectangle(0, 0, 400, 34)\ndraw_rectangle(0, 366, 400, 34)\nset_fill_color(\"#f8f4e3\")\nfor i in range(9):\n    hole_x = 14 + i * 44\n    draw_rectangle(hole_x, 11, 18, 12)\n    draw_rectangle(hole_x, 377, 18, 12)\n\nset_text_style(\"serif\", \"bold\")\nset_text_color(\"#f8f4e3\")\nset_text_height(22)\ndraw_text(\"Jump scare tolerance\", 96, 76)\nset_stroke_color(\"#f5c518\")\nset_stroke_width(2)\ndraw_line(96, 88, 304, 88)\n\n# moonlit spotlight behind the ghost\nremove_stroke_color()\nset_fill_color(\"#1a2142\")\ndraw_ellipse(120, 100, 160, 160)\n\n# the ghost: dome + wavy hem + shadow\nset_fill_color(\"#05070f\")\ndraw_ellipse(150, 258, 100, 18)          # floor shadow\nset_fill_color(\"#f8f4e3\")\ndraw_ellipse(160, 112, 80, 80)\ndraw_rectangle(160, 150, 80, 60)\ndraw_ellipse(160, 198, 22, 24)\ndraw_ellipse(189, 204, 22, 24)\ndraw_ellipse(218, 198, 22, 24)\n# face\nset_fill_color(\"#101430\")\ndraw_ellipse(180, 140, 12, 18)\ndraw_ellipse(208, 140, 12, 18)\ndraw_ellipse(194, 168, 14, 12)           # the \"boo\" mouth\nset_fill_color(\"#f8f4e3\")\ndraw_ellipse(183, 143, 4, 5)             # eye shine\ndraw_ellipse(211, 143, 4, 5)\n# blush, because it is a friendly ghost until it isn't\nset_fill_color(\"#c22030\")\ndraw_ellipse(168, 160, 10, 6)\ndraw_ellipse(222, 160, 10, 6)\n\nset_text_style(\"sans\", \"bold\")\nset_text_color(\"#8a91b4\")\nset_text_height(14)\ndraw_text(\"1  nope\", 92, 300)\nset_text_color(\"#f5c518\")\ndraw_text(\"5  bring it\", 246, 300)\nset_stroke_color(\"#8a91b4\")\nset_stroke_width(2)\ndraw_line(160, 295, 236, 295)\nplay()\n\n# ----- QUESTION 5 -----\nprint(\"\")\nprint(\"Q5: Rate how much you trust jump scares, 1 (nope) to 5 (bring it).\")\nanswer = input(\"Type 1-5: \")\nwhile answer != \"1\" and answer != \"2\" and answer != \"3\" and answer != \"4\" and answer != \"5\":\n    print(\"Oops -- please type a number 1 through 5.\")\n    answer = input(\"Type 1-5: \")\n\nscares = int(answer)\n\nif scares >= 4:\n    score3 = score3 + 2\n\n# ============================================================\n# THE ALGORITHM -- find the winner\n# ============================================================\nwinner = movie1\ntop_score = score1\n\nif score2 > top_score:\n    winner = movie2\n    top_score = score2\nif score3 > top_score:\n    winner = movie3\n    top_score = score3\nif score4 > top_score:\n    winner = movie4\n    top_score = score4\n\n# ----- THE OVERRIDE RULE -----\n# House rule: a big group that wants brains OFF always gets\n# the comedy, no matter what the scores say.\nif group_size >= 3:\n    if brain == 2:\n        winner = movie2\n        top_score = score2\n\n# ----- BUILD THE REASON, IN TWO LINES -----\nreason1 = \"Because\"\nif energy == 1:\n    reason1 = reason1 + \" you're hyped\"\nif energy == 2:\n    reason1 = reason1 + \" you're keeping it chill\"\nif energy == 3:\n    reason1 = reason1 + \" you're tired but fighting it\"\nif crying_ok == 1:\n    reason2 = \"and you're okay with feelings,\"\nelse:\n    reason2 = \"and you want zero tears,\"\nreason2 = reason2 + \" with \" + str(group_size) + \" watching.\"\n\nprint(\"\")\nprint(\"Check the Theater for your results, \" + name + \"...\")\n\n# ============================================================\n# THE FINALE -- the animated part (pauses start here)\n# ============================================================\n\n# ----- LOADING SCREEN: their vibe, on file -----\nclear(\"#101430\")\nset_fill_color(\"#05070f\")\ndraw_rectangle(0, 0, 400, 34)\ndraw_rectangle(0, 366, 400, 34)\nset_fill_color(\"#f8f4e3\")\nfor i in range(9):\n    hole_x = 14 + i * 44\n    draw_rectangle(hole_x, 11, 18, 12)\n    draw_rectangle(hole_x, 377, 18, 12)\n\n# the vibe file, as a card\nset_fill_color(\"#05070f\")\ndraw_rectangle(76, 108, 260, 190)\nset_fill_color(\"#1a2142\")\ndraw_rectangle(70, 102, 260, 190)\nset_stroke_color(\"#f5c518\")\nset_stroke_width(2)\nremove_fill_color()\ndraw_rectangle(70, 102, 260, 190)\n\nset_text_style(\"serif\", \"bold\")\nset_text_color(\"#f8f4e3\")\nset_text_height(20)\ndraw_text(\"Analyzing your vibe\", 96, 136)\n\nset_text_style(\"mono\", \"normal\")\nset_text_height(14)\nset_text_color(\"#4ade80\")\ndraw_text(energy_label, 96, 176)\nset_text_color(\"#f5c518\")\ndraw_text(brain_label, 96, 202)\nset_text_color(\"#6ee7ff\")\ndraw_text(tears_label, 96, 228)\nset_text_color(\"#f8f4e3\")\ndraw_text(\"crowd: \" + str(group_size) + \" watching\", 96, 254)\npause(2)\n\n# ----- SUSPENSE: a for loop drives the dots -----\ndots = \"\"\nfor i in range(3):\n    dots = dots + \".\"\n    clear(\"#101430\")\n    remove_stroke_color()\n    set_fill_color(\"#05070f\")\n    draw_rectangle(0, 0, 400, 34)\n    draw_rectangle(0, 366, 400, 34)\n    set_fill_color(\"#f8f4e3\")\n    for j in range(9):\n        hole_x = 14 + j * 44\n        draw_rectangle(hole_x, 11, 18, 12)\n        draw_rectangle(hole_x, 377, 18, 12)\n    set_text_style(\"serif\", \"bold\")\n    set_text_color(\"#f8f4e3\")\n    set_text_height(26)\n    draw_text(\"Finding your match\" + dots, 62, 205)\n    play_note(60 + i, 0.2)        # rising note each frame\n    pause(0.8)                     # ends the frame\n\n# ----- THE REVEAL: marquee moment -----\nclear(\"#101430\")\nremove_stroke_color()\nset_fill_color(\"#05070f\")\ndraw_rectangle(0, 0, 400, 34)\ndraw_rectangle(0, 366, 400, 34)\nset_fill_color(\"#f8f4e3\")\nfor i in range(9):\n    hole_x = 14 + i * 44\n    draw_rectangle(hole_x, 11, 18, 12)\n    draw_rectangle(hole_x, 377, 18, 12)\n\n# spotlight beams behind the title\nset_fill_color(\"#1a2142\")\ndraw_shape([120, 340, 40, 60, 90, 60, 200, 340], True)\ndraw_shape([280, 340, 310, 60, 360, 60, 200, 340], True)\n\n# gold starburst behind the title card\nset_fill_color(\"#f5c518\")\ndraw_regular_polygon(200, 150, 8, 26)\n\n# the title card with shadow\nset_fill_color(\"#05070f\")\ndraw_rectangle(56, 172, 300, 84)\nset_fill_color(\"#f8f4e3\")\ndraw_rectangle(50, 166, 300, 84)\n\nset_text_style(\"sans\", \"bold\")\nset_text_color(\"#c22030\")\nset_text_height(15)\ndraw_text(\"TONIGHT'S PICK\", 145, 192)\nset_text_style(\"serif\", \"bold\")\nset_text_color(\"#101430\")\nset_text_height(30)\ndraw_text(winner, 66, 232)\nplay_note(72, 0.5)                 # the ta-da note\npause(1.5)\n\n# ----- PERSONALIZATION: the reason + match meter -----\nset_text_style(\"sans\", \"italic\")\nset_text_color(\"#8a91b4\")\nset_text_height(13)\ndraw_text(reason1, 90, 280)\ndraw_text(reason2, 90, 298)\n\n# the bar's width is computed FROM the score, so the visual\n# reflects their data.\nbar_width = top_score * 30\nremove_stroke_color()\nset_fill_color(\"#1a2142\")\ndraw_rectangle(50, 312, 300, 18)   # empty track\nset_fill_color(\"#f5c518\")\ndraw_rectangle(200 - bar_width / 2, 312, bar_width, 18)\nset_text_style(\"sans\", \"bold\")\nset_text_color(\"#f5c518\")\nset_text_height(14)\ndraw_text(str(top_score) + \" point match\", 155, 350)\npause(2)\n\n# ----- SIGN-OFF: their ticket -----\nclear(\"#101430\")\nremove_stroke_color()\nset_fill_color(\"#05070f\")\ndraw_rectangle(0, 0, 400, 34)\ndraw_rectangle(0, 366, 400, 34)\nset_fill_color(\"#f8f4e3\")\nfor i in range(9):\n    hole_x = 14 + i * 44\n    draw_rectangle(hole_x, 11, 18, 12)\n    draw_rectangle(hole_x, 377, 18, 12)\n\nset_fill_color(\"#05070f\")\ndraw_rectangle(58, 152, 296, 104)\nset_fill_color(\"#f5c518\")\ndraw_rectangle(50, 144, 296, 104)\nset_fill_color(\"#101430\")\nfor i in range(7):\n    draw_ellipse(294, 150 + i * 14, 6, 6)\n\nset_text_style(\"serif\", \"bold\")\nset_text_color(\"#101430\")\nset_text_height(13)\ndraw_text(\"NOW SHOWING\", 74, 172)\nset_text_height(24)\ndraw_text(name + \"'s Movie Night\", 74, 206)\nset_text_style(\"sans\", \"italic\")\nset_text_height(12)\ndraw_text(\"enjoy the show\", 74, 230)\nplay_note(64, 0.3)\nplay_note(67, 0.3)\nplay_note(72, 0.6)                 # a little closing chord\nplay()                             # render the full animation",
          "folderId": "0",
