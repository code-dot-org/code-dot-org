        "3": {
          "id": "3",
          "name": "strong_student.py",
          "contents": "# PET MATCH -- Single Match (STRONG STUDENT SAMPLE)\n# Picks ONE pet that fits the user's space, schedule, and vibe.\n# Branching only: nested if-else + compound conditions, no points.\n#\n# HOW IT WORKS: the console runs the interview. The Theater shows ONE\n# screen at the end: a ticket with the pet and a one-line reason.\n# The only loop in the drawing code is decorative (the flags).\n\nfrom theater import *\n\nprint(\"PET MATCH: which pet fits your life?\")\nname = input(\"What's your name? \")\n\n# ============================================================\n# THE INTERVIEW (console)\n# ============================================================\nprint(\"\")\nprint(\"Q1: What's your space like?\")\nprint(\"  1 = cozy apartment\")\nprint(\"  2 = house + yard\")\nspace = input(\"Type 1 or 2: \")\nwhile space != \"1\" and space != \"2\":\n    print(\"Please type 1 (cozy apartment) or 2 (house + yard).\")\n    space = input(\"Type 1 or 2: \")\nspace = int(space)\n\nprint(\"\")\nprint(\"Q2: How much are you home?\")\nprint(\"  1 = out most of the day\")\nprint(\"  2 = home a lot\")\nhome_time = input(\"Type 1 or 2: \")\nwhile home_time != \"1\" and home_time != \"2\":\n    print(\"Please type 1 (out most of the day) or 2 (home a lot).\")\n    home_time = input(\"Type 1 or 2: \")\nhome_time = int(home_time)\n\nprint(\"\")\nprint(\"Q3: What's the vibe?\")\nprint(\"  1 = cuddles\")\nprint(\"  2 = playtime\")\nprint(\"  3 = just watching\")\nvibe = input(\"Type 1, 2, or 3: \")\nwhile vibe != \"1\" and vibe != \"2\" and vibe != \"3\":\n    print(\"Please type 1 (cuddles), 2 (playtime), or 3 (just watching).\")\n    vibe = input(\"Type 1, 2, or 3: \")\nvibe = int(vibe)\n\nprint(\"\")\nprint(\"Q4: What's your monthly pet budget?\")\nprint(\"  1 = under $30\")\nprint(\"  2 = $30 or more\")\nbudget = input(\"Type 1 or 2: \")\nwhile budget != \"1\" and budget != \"2\":\n    print(\"Please type 1 (under $30) or 2 ($30 or more).\")\n    budget = input(\"Type 1 or 2: \")\nbudget = int(budget)\n\n# ============================================================\n# THE ALGORITHM\n# ============================================================\n\n# ----- STEP 1: nested decision on vibe, then compound checks -----\nif vibe == 1:\n    # cuddly: a dog needs a yard AND a budget for food and vet visits\n    if space == 2 and budget == 2:\n        pet = \"Golden Retriever\"\n        adopt_reason = \"A yard, a budget, and a cuddle buddy.\"\n    else:\n        pet = \"Cat\"\n        adopt_reason = \"Cuddles without the big-dog costs: a cat.\"\nelif vibe == 2:\n    # playful: a dog needs room AND time at home AND a budget.\n    # if ANY of the three is missing, the answer changes.\n    if space == 2 and home_time == 2 and budget == 2:\n        pet = \"Golden Retriever\"\n        adopt_reason = \"Room, time, money, and energy: a dog.\"\n    elif space == 2 or home_time == 2:\n        # a rabbit needs EITHER room to hop OR lots of attention\n        pet = \"Rabbit\"\n        adopt_reason = \"Playful, with room or time to give: a rabbit.\"\n    else:\n        pet = \"Hamster\"\n        adopt_reason = \"Playful in a small spot: a hamster!\"\nelse:\n    pet = \"Betta Fish\"\n    adopt_reason = \"Calm to watch and easy on your space.\"\n\n# ----- STEP 2: OVERRIDE RULE (beats Step 1) -----\n# A dog left alone all day is unfair to the dog. Step 1 can still hand\n# out a dog to a cuddly person with a yard who is never home, so this\n# rule changes that pet to a cat. It's an override, not a score tweak,\n# because it protects the animal's wellbeing, which shouldn't be traded\n# off against what the user likes.\nif home_time == 1:\n    if pet == \"Golden Retriever\":\n        pet = \"Cat\"\n        adopt_reason = \"Out all day? A cat is happier solo.\"\n\nprint(\"\")\nprint(\"Check the Theater for your match, \" + name + \"!\")\n\n# ============================================================\n# THE THEATER SCREEN -- one ticket with the result\n# ============================================================\nclear(\"#FFF1E6\")\nremove_stroke_color()\n\n# decorative flags along the top (the loop only draws flags)\nfor flag in range(10):\n    if flag % 2 == 0:\n        set_fill_color(\"#EF6474\")\n    else:\n        set_fill_color(\"#087F8C\")\n    draw_shape([flag * 40, 0, flag * 40 + 36, 0, flag * 40 + 18, 23], True)\n\n# ticket with shadow and notches\nset_fill_color(\"#E8C9B4\")\ndraw_rectangle(26, 49, 356, 267)\nset_fill_color(\"#FFFFFF\")\ndraw_rectangle(22, 45, 356, 267)\nset_fill_color(\"#FFF1E6\")\ndraw_ellipse(12, 168, 20, 20)\ndraw_ellipse(368, 168, 20, 20)\n\n# a different illustration for each possible result\nif pet == \"Golden Retriever\":\n    set_fill_color(\"#C5854B\")\n    draw_ellipse(220, 120, 36, 70)       # ears\n    draw_ellipse(144, 120, 36, 70)\n    set_fill_color(\"#E8B866\")\n    draw_ellipse(160, 118, 80, 80)       # head\n    set_fill_color(\"#173B50\")\n    draw_ellipse(178, 146, 10, 12)       # eyes\n    draw_ellipse(212, 146, 10, 12)\n    draw_ellipse(190, 166, 20, 14)       # nose\n    set_fill_color(\"#EF6474\")\n    draw_ellipse(194, 182, 12, 16)       # tongue\nelif pet == \"Cat\":\n    set_fill_color(\"#8A91B4\")\n    draw_shape([156, 130, 160, 88, 186, 118], True)   # ears\n    draw_shape([244, 130, 240, 88, 214, 118], True)\n    draw_ellipse(156, 112, 88, 84)       # head\n    set_fill_color(\"#FFD166\")\n    draw_ellipse(178, 142, 14, 16)       # eyes\n    draw_ellipse(208, 142, 14, 16)\n    set_fill_color(\"#173B50\")\n    draw_ellipse(184, 146, 4, 10)\n    draw_ellipse(214, 146, 4, 10)\n    set_fill_color(\"#EF6474\")\n    draw_ellipse(194, 166, 12, 8)        # nose\n    set_stroke_color(\"#173B50\")\n    set_stroke_width(2)\n    draw_line(150, 166, 176, 170)        # whiskers\n    draw_line(150, 178, 176, 174)\n    draw_line(250, 166, 224, 170)\n    draw_line(250, 178, 224, 174)\n    remove_stroke_color()\nelif pet == \"Hamster\":\n    set_fill_color(\"#E8B866\")\n    draw_ellipse(150, 126, 100, 84)      # body\n    set_fill_color(\"#FFF1E6\")\n    draw_ellipse(168, 168, 64, 40)       # belly\n    set_fill_color(\"#C5854B\")\n    draw_ellipse(152, 112, 24, 24)       # ears\n    draw_ellipse(224, 112, 24, 24)\n    set_fill_color(\"#173B50\")\n    draw_ellipse(176, 144, 10, 10)       # eyes\n    draw_ellipse(214, 144, 10, 10)\n    set_fill_color(\"#EF6474\")\n    draw_ellipse(194, 158, 12, 8)        # nose\n    draw_ellipse(160, 160, 16, 10)       # cheeks\n    draw_ellipse(224, 160, 16, 10)\nelif pet == \"Rabbit\":\n    set_fill_color(\"#C9B8A6\")\n    draw_ellipse(172, 76, 22, 66)        # ears\n    draw_ellipse(206, 76, 22, 66)\n    set_fill_color(\"#F4A9B5\")\n    draw_ellipse(178, 86, 10, 48)        # inner ears\n    draw_ellipse(212, 86, 10, 48)\n    set_fill_color(\"#C9B8A6\")\n    draw_ellipse(160, 120, 80, 76)       # head\n    set_fill_color(\"#173B50\")\n    draw_ellipse(180, 146, 9, 11)        # eyes\n    draw_ellipse(211, 146, 9, 11)\n    set_fill_color(\"#F4A9B5\")\n    draw_ellipse(193, 164, 14, 9)        # nose\nelse:\n    set_fill_color(\"#66C5DF\")\n    draw_rectangle(120, 112, 160, 100)   # water\n    set_fill_color(\"#EF6474\")\n    draw_shape([226, 162, 262, 136, 262, 188], True)   # tail\n    draw_ellipse(152, 138, 84, 48)       # body\n    set_fill_color(\"#FFFFFF\")\n    draw_ellipse(166, 152, 12, 12)       # eye\n    set_fill_color(\"#173B50\")\n    draw_ellipse(169, 155, 5, 5)\n    set_fill_color(\"#FFFFFF\")\n    # decorative bubbles: the loop only draws them\n    for bubble in range(3):\n        draw_ellipse(144 + bubble * 12, 126 - bubble * 8, 8, 8)\n\n# just the result and a one-line reason\nset_text_style(\"sans\", \"bold\")\nset_text_color(\"#173B50\")\nset_text_height(22)\ndraw_text(pet, 44, 252)\nset_text_style(\"sans\", \"normal\")\nset_text_height(13)\ndraw_text(adopt_reason, 44, 278)\n\nplay_note(72, 0.5)\nplay()\n\n# ============================================================\n# STUDENT NOTES (these map to the rubric)\n# ============================================================\n# WHY SINGLE MATCH: Adopting a pet is one big decision. Nobody\n# adopts a whole list of pets, so the best answer is one pet.\n#\n# WHY MY OVERRIDE BEATS THE VIBE RULE: A cuddly person with a yard\n# but who is out all day would be handed a Golden Retriever by\n# Step 1. That's a bad outcome for the dog. If I only \"factored in\"\n# time at home, the dog's preference for company would lose to the\n# user's preference for cuddles. The override treats the animal's\n# wellbeing as a limit that can't be traded away.\n#\n# WHY MY COMPOUNDS NEED EVERY PART: For playful users, a dog needs\n# a yard AND time at home AND a budget. No yard means no room to\n# play. No time means the dog is alone. No budget means food and vet\n# bills the user can't cover. Remove any one part and a dog is the\n# wrong answer. My rabbit rule uses \"or\" instead: a rabbit is fine\n# with EITHER room to hop OR lots of attention, so one half is enough.\n#\n# TESTED PATHS (traced by hand, then run; every answer set gives a pet):\n#   space/time/vibe/budget\n#   1/1/1/1 -> Cat            (cuddly, apartment)\n#   2/2/1/2 -> Golden Ret.    (cuddly, yard, can afford it)\n#   2/2/1/1 -> Cat            (cuddly, yard, but budget half missing)\n#   2/1/1/2 -> Cat            (override: dog -> cat)\n#   2/2/2/2 -> Golden Ret.    (playful: all three parts true)\n#   2/2/2/1 -> Rabbit         (playful, budget missing, so no dog)\n#   1/2/2/2 -> Rabbit         (playful, no yard, but home a lot)\n#   1/1/2/2 -> Hamster        (playful, no room AND no time)\n#   1/1/3/1 -> Betta Fish     (watching, any space, any schedule)\n#\n# AI TUTOR EDGE CASE: \"cuddly, house + yard, out all day, big budget.\"\n# I traced it by hand: Step 1 gives Golden Retriever, then the\n# override flips it to Cat. I ACCEPTED this result. AI also suggested\n# adding the budget check to my rabbit rule; I REJECTED that, because\n# rabbits cost far less than dogs, so the extra condition would\n# only block people who'd be fine.",
