      "name": "test.py",
      "contents": "import contextlib\nimport io\nfrom unittest import TestCase\nfrom unittest.mock import patch\n\n\nclass TestModifyCustomRange(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Run the student's code with mocked, controlled low/high inputs\"\"\"\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n        cls.namespace = {}\n        stdout = io.StringIO()\n        cls.run_error = None\n        try:\n            with patch(\"builtins.input\", side_effect=[\"10\", \"20\"]), contextlib.redirect_stdout(stdout):\n                exec(compile(cls.source, \"main.py\", \"exec\"), cls.namespace)\n        except Exception as e:\n            cls.run_error = e\n        cls.stdout_text = stdout.getvalue()\n\n    def _int_vars(self):\n        return {\n            name: value for name, value in self.namespace.items()\n            if isinstance(value, int) and not isinstance(value, bool) and not name.startswith(\"__\")\n        }\n\n    def test_uses_both_inputs_as_randint_range(self):\n        \"\"\"Uses the two entered values as randint()'s range\"\"\"\n        self.assertIsNone(\n            self.run_error,\n            f\"Your program raised an error while running: {self.run_error}. \"\n            \"Make sure you're asking for two integers with input() and int().\"\n        )\n        int_vars = self._int_vars()\n        self.assertIn(10, int_vars.values(), \"We didn't find a variable holding 10, the smallest value we entered. Make sure you're using int(input(...)) to store it.\")\n        self.assertIn(20, int_vars.values(), \"We didn't find a variable holding 20, the largest value we entered. Make sure you're using int(input(...)) to store it.\")\n\n    def test_random_number_within_entered_range(self):\n        \"\"\"The random number stays within the entered range\"\"\"\n        if self.run_error is not None:\n            self.skipTest(\"Fix the error above first.\")\n        int_vars = self._int_vars()\n        result_candidates = [v for v in int_vars.values() if v not in (10, 20)]\n        self.assertTrue(\n            result_candidates,\n            \"We didn't find a third number variable (the random result) besides the two you entered.\"\n        )\n        result = result_candidates[0]\n        self.assertTrue(\n            10 <= result <= 20,\n            f\"Expected the random number to be between 10 and 20, but got {result}.\"\n        )\n\n    def test_prints_the_random_number(self):\n        \"\"\"Prints the random number\"\"\"\n        if self.run_error is not None:\n            self.skipTest(\"Fix the error above first.\")\n        int_vars = self._int_vars()\n        result_candidates = [v for v in int_vars.values() if v not in (10, 20)]\n        if not result_candidates:\n            self.skipTest(\"Generate the random number first -- we'll check it's printed once it exists.\")\n        self.assertIn(\n            str(result_candidates[0]),\n            self.stdout_text,\n            f\"The random number ({result_candidates[0]}) wasn't found in the printed output. Make sure you print it.\"\n        )",
      "folderId": "0",
      "active": false,
      "type": "validation"
    }
