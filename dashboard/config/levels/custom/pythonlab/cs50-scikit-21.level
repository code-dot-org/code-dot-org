          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standards: 3.1 & 3.2\n# Standard Descriptions: \n#   3.1: Define main algorithms of different machine learning methods.\n#   3.2: Describe classification, approximation, inference optimization, recognition, search families of reasoning algorithms.\n#\n# Rationale: AI is a big family of different \"tools\". Just like a carpenter \n# uses a hammer for nails and a saw for wood, an AI engineer chooses the \n# \"family\" of algorithm that fits the task. This tutorial provides a map \n# of these families.\n\n\"\"\"\nWelcome! AI isn't just one thing—it's a collection of families.\n1. Classification: Sorting things into bins (Is it a Cat or Dog?).\n2. Approximation (Regression): Guessing a number (What is the price?).\n3. Recognition: Identifying patterns (Face ID or Voice ID).\n4. Search/Optimization: Finding the best path or settings.\n\nLet's look at a few of these families in scikit-learn!\n\"\"\"\n\nimport pandas as pd\nfrom sklearn.linear_model import LogisticRegression, LinearRegression\nfrom sklearn.cluster import KMeans\nfrom sklearn.neighbors import NearestNeighbors\nimport numpy as np\n\n# --- FAMILY 1: CLASSIFICATION (Categorization) ---\nprint(\"--- Family 1: Classification ---\")\n# Task: Identify the species of a flower.\n# Common Algorithm: Logistic Regression.\nprint(\"Used for: Yes/No questions or 'Which bin?' questions.\")\n\n# --- FAMILY 2: APPROXIMATION (Regression) ---\nprint(\"\\n--- Family 2: Approximation ---\")\n# Task: Guess the value of a house.\n# Common Algorithm: Linear Regression.\nprint(\"Used for: 'How much?' or 'How many?' questions.\")\n\n# --- FAMILY 3: SEARCH & RECOGNITION ---\nprint(\"\\n--- Family 3: Search/Recognition ---\")\n# Task: Find the closest match to a fingerprint.\n# Common Algorithm: K-Nearest Neighbors (KNN).\nprint(\"Used for: Finding similarities or patterns in data.\")\n\n# --- FAMILY 4: OPTIMIZATION ---\nprint(\"\\n--- Family 4: Optimization ---\")\n# Task: Find the best way to group these dots together.\n# Common Algorithm: KMeans.\nprint(\"Used for: Finding the most efficient 'best' grouping or path.\")\n\n\"\"\"\n--- YOUR TURN ---\nWe've listed 4 scenarios below. For each one, identify which \"Family\" it \nbelongs to (Classification, Approximation, Recognition, or Search).\n\nScenario A: A self-driving car identifying a \"Stop Sign\".\nScenario B: A bank predicting exactly how many dollars you will spend next month.\nScenario C: A website suggesting a \"New Friend\" based on who you already know.\nScenario D: A factory finding the fastest way to pack 1,000 boxes.\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\n# TODO: Match the families!\n# Scenario_A = \"___\"\n# Scenario_B = \"___\"\n# Scenario_C = \"___\"\n# Scenario_D = \"___\"\n\nprint(\"\\nThink about how each family solves a different kind of problem!\")\n",
          "folderId": "0",
          "active": true
        }
