          "id": "0",
          "name": "main.py",
          "contents": "import re\n\n\ndef get_ngrams(tokens, n):\n  ngrams = []\n  # TODO: Complete a function that returns all the n-grams in a list\n\n  return ngrams\n\n\ndef tokenize(text):\n  return re.findall(r\"\\w+\", text)\n\n\ndef main():\n  text = \"Alice was beginning to get very tired of sitting by her sister on the bank.\"\n\n  # Tokenize text\n  tokens = tokenize(text)\n\n  # Ask for n\n  n = int(input(\"Enter n: \"))\n\n  # Get n-grams\n  ngrams = get_ngrams(tokens, n)\n\n  # Print n-grams\n  for ngram in ngrams:\n    print(ngram)\n\n\nmain()",
