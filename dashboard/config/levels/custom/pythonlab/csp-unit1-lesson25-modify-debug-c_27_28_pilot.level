      "name": "test.py",
      "contents": "import contextlib\nimport io\nfrom unittest import TestCase\n\n\nEXPECTED_OUTPUT_LINE = \"I live in Austin Texas\"  # TODO: confirm -- instructions say \"Austin, Texas\" (comma), exemplar produces \"Austin Texas\" (space only, no comma)\n\n\nclass TestDebugCityState(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Run the student's code once and capture output\"\"\"\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n        cls.namespace = {}\n        stdout = io.StringIO()\n        cls.run_error = None\n        try:\n            with contextlib.redirect_stdout(stdout):\n                exec(compile(cls.source, \"main.py\", \"exec\"), cls.namespace)\n        except Exception as e:\n            cls.run_error = e\n        cls.stdout_text = stdout.getvalue()\n\n    def test_runs_without_error(self):\n        \"\"\"Runs without an error\"\"\"\n        self.assertIsNone(\n            self.run_error,\n            f\"Your program raised an error while running: {self.run_error}.\"\n        )\n\n    def test_prints_correct_location(self):\n        \"\"\"Prints the location with something separating the city and state\"\"\"\n        if self.run_error is not None:\n            self.skipTest(\"Fix the error above first.\")\n        self.assertTrue(\n            any(EXPECTED_OUTPUT_LINE in line for line in self.stdout_text.splitlines()),\n            f\"Expected to see '{EXPECTED_OUTPUT_LINE}' printed, but got: {self.stdout_text.strip()}. \"\n            \"Concatenation doesn't add spaces automatically -- check what's between city and state.\"\n        )",
