          "id": "0",
          "name": "main.py",
          "contents": "# City at Night — original by Ms. Rivera\nfrom theater import *\n\nclear(\"navy\")\n\n# Moon\nset_fill_color(\"ivory\")\ndraw_ellipse(300, 40, 50, 50)\n\n# Building\nset_fill_color(\"#2F3B4C\")\ndraw_rectangle(60, 120, 220, 280)\n\n# Two rows of lit windows\nset_fill_color(\"gold\")\nfor j in range(5):\n    draw_rectangle(j * 40 + 75, 140, 24, 30)\n    draw_rectangle(j * 40 + 75, 200, 24, 30)\n    pause(0.1)\nplay()",
