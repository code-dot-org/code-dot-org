        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "import re\n\n\ndef get_bigrams(tokens):\n  bigrams = []\n  # TODO: Complete the function to return all the bigrams in a list\n  \t\n  return bigrams\n\n\ndef tokenize(text):\n  return re.findall(r\"\\w+\", text)\n\n\ndef main():\n  text = \"Once upon a midnight dreary, while I pondered, weak and weary\"\n\n  # Tokenize text\n  tokens = tokenize(text)\n\n  # Get bigrams\n  bigrams = get_bigrams(tokens)\n\n  # Print bigrams\n  for bigram in bigrams:\n    print(bigram)\n\n\nmain()",
