    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from sklearn.linear_model import LinearRegression\nfrom sklearn.metrics import mean_squared_error\n\n# Input features: [grams of butter, minutes chilled]\ninputs1 = [[40, 10], [60, 30], [80, 15], [100, 45], [45, 60]]\ninputs2 = [[50, 15], [70, 35], [55, 55], [95, 25], [85, 70]]\n\n# Output feature: cookie size\noutputs1 = [6.3, 7.4, 9.2, 10.1, 5.7]\noutputs2 = [10.2, 8.6, 6.6, 9.7, 5.6]\n\n# First model\nmodel1 = LinearRegression()\nmodel1.fit(inputs1, outputs1)\n\n# Second model\nmodel2 = LinearRegression()\nmodel2.fit(inputs2, outputs2)\n\n# Test data\ntest_inputs = [[100, 70], [40, 0], [95, 55], [50, 5], [110, 65]]\ntest_outputs = [5.9, 11.2, 7.0, 10.8, 6.3]\n\npredictions1 = model1.predict(test_inputs)\n# TODO 1: Have model 2 predict outputs for each of the test inputs\n\n# TODO 2: Calculate mean squared error for each model\n# TODO 3: Print the mean squared error for each model",
