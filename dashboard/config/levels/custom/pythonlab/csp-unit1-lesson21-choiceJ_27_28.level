          "name": "main.py",
          "contents": "# Night Sky — original by Luis Herrera\nfrom theater import *\n\nclear(\"#0B1030\")\n\n# Moon\nset_fill_color(\"ivory\")\ndraw_ellipse(290, 50, 60, 60)\n\n# Stars climbing on a diagonal\nset_fill_color(\"gold\")\nremove_stroke_color()\nfor j in range(9):\n    draw_regular_polygon(j * 42 + 30, j * 18 + 60, 5, 10)\n    pause(0.1)\nplay()",
