        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "# PROTOTYPE 1 — \"Movie Night Matcher\" — THEATER PROGRAM\n# Theater can't take input(), so the value below stands in for whatever\n# the console program actually calculated. In the real project, this is\n# the value a student carries over once their console program works —\n# either by hand, or via AI Tutor once they're prompting for the scene.\n\nbest_option = \"Action Flick\"  # <-- carried over from the console program\n\nfrom theater import Scene, play_scenes\n\nscene = Scene()\nscene.set_fill_color(\"navy\")\nscene.draw_rectangle(0, 0, 400, 400)\nscene.set_text_color(\"white\")\nscene.set_text_height(28)\nscene.draw_text(\"Tonight's pick:\", 40, 160)\nscene.set_text_height(36)\nscene.draw_text(best_option, 40, 220)\nscene.play_note(64, 0.6)\nscene.pause(1.0)\n\nplay_scenes(scene)",
