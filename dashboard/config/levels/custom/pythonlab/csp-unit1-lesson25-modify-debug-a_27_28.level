    "long_instructions": "### Modify: Debug\r\n\r\nThis code should print a birthday message, but it causes an error. \r\n\r\nFind the bug and fix it. ",
    "encrypted_exemplar_sources": "A3vaHWcrNLyiKjVtNgHDFXFU4wUoGwMZZd5XD39qeii5wGPevnxczbgEwyFi\nWMD1VtUw+hiun2p9xPlDbE2m33rSwIF1oO1W9B9lPC7EzMraRGpcpYu1d1d8\nrprebCIZB0cvwW8pqK00vzqbiiz+lXL8aIVGT+Hpg8KjcDKcIEgw/dCbp/Mg\nziJkxesxAWHrh0eiLUGFNySaf9rYw/c6xxz2CfvyXHiaGj38swr6T7eIJpjf\nuSTE/Jem24H+pd4Z8u05lKrnysMiHLN37IU3ZcvD8J0b35MRykAv8B4OiGtc\nhtp0T+q89u09WDxwwMPoFBkSUJXrTP/QtDgcZDkCQlhjCIGnxttsHuu2Emdy\nUk+KAzGydGWsagzDTizBK4ZQOTEsA/56Fb7fyATG6MtwicTW1NCj42imAsTb\n+EP05bez0/MuJP+0pJyzC3psEo9xsHOS8y7xMwgo4hRnwQZ1zw==\n",
    "display_name": "The Broken Greeting",
    "bubble_choice_description": "Fix a birthday message that crashes before it can print.",
    "thumbnail_url": "https://images.code.org/f87061dd354a1ba9788150b401a5d77e-birthday-cake.png",
    "validation_file": {
      "id": "1",
      "name": "test.py",
      "contents": "import contextlib\nimport io\nfrom unittest import TestCase\n\n\nclass TestDebugBirthdayMessage(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Run the student's code once and capture output\"\"\"\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n        cls.namespace = {}\n        stdout = io.StringIO()\n        cls.run_error = None\n        try:\n            with contextlib.redirect_stdout(stdout):\n                exec(compile(cls.source, \"main.py\", \"exec\"), cls.namespace)\n        except Exception as e:\n            cls.run_error = e\n        cls.stdout_text = stdout.getvalue()\n\n    def test_runs_without_error(self):\n        \"\"\"Runs without a type error\"\"\"\n        self.assertIsNone(\n            self.run_error,\n            f\"Your program raised an error while running: {self.run_error}. \"\n            \"age is a number, and you can't combine a number directly with text using +. \"\n            \"Use str() to convert it first.\"\n        )\n\n    def test_prints_correct_birthday_message(self):\n        \"\"\"Prints the birthday message with the correct name and age\"\"\"\n        if self.run_error is not None:\n            self.skipTest(\"Fix the error above first.\")\n        name = self.namespace.get(\"name\")\n        age = self.namespace.get(\"age\")\n        expected = f\"Happy birthday, {name}! You are {age}!\"\n        self.assertTrue(\n            any(expected in line for line in self.stdout_text.splitlines()),\n            f\"Expected to see \\\"{expected}\\\" printed, but got: {self.stdout_text.strip()}\"\n        )",
      "folderId": "0",
      "active": false,
      "type": "validation"
    }
