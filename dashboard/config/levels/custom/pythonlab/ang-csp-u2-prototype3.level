    "long_instructions": "Prototype 3\r\n\r\nTop 5 Recommendations",
    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "# PROTOTYPE 3 — \"Amusement Park Ride Finder\" — CONSOLE PROGRAM \n# threshold filter: check each of 5 named rides independently against a\n# score bar and an exclusion rule. \n\ncoaster_score = 0\ndrop_tower_score = 0\nlog_flume_score = 0\nhaunted_manor_score = 0\nferris_wheel_score = 0\n\n# ---------- THE INTERVIEW ----------\n# Same shape as Prototype 1&2's for loop: 5 same-style rating questions,\n# branching by round number to know which named ride is being scored.\nfor question_number in range(5):\n    if question_number == 0:\n        answer = input(\"On a scale of 1-5, how much do you like fast, intense rides? \")\n        rating = int(answer)\n        coaster_score = rating\n    elif question_number == 1:\n        answer = input(\"On a scale of 1-5, how much do you like big drops and heights? \")\n        rating = int(answer)\n        drop_tower_score = rating\n    elif question_number == 2:\n        answer = input(\"On a scale of 1-5, how much do you want a water ride? \")\n        rating = int(answer)\n        log_flume_score = rating\n    elif question_number == 3:\n        answer = input(\"On a scale of 1-5, how much do you like spooky stuff? \")\n        rating = int(answer)\n        haunted_manor_score = rating\n    elif question_number == 4:\n        answer = input(\"On a scale of 1-5, how much do you want something calm and relaxing? \")\n        rating = int(answer)\n        ferris_wheel_score = rating\n\n# Independent exclusion questions — these can knock a ride out no matter\n# how it scored, the same override idea from Prototype 1's horror check.\ngets_motion_sick = input(\"Do you get motion sick easily? (yes/no) \")\nokay_wet = input(\"Are you okay getting wet? (yes/no) \")\n\n# ---------- THE ALGORITHM: a reusable threshold-and-exclusion check ----------\n# Same shape as Prototype 1's \"does this beat the bar, unless excluded\"\n# logic — applied here to 5 named rides instead of being compared against\n# each other, since without a list there's nothing to sort by score.\nthreshold = 3\n\nprint(\"Rides we recommend for you:\")\n\nif coaster_score >= threshold and gets_motion_sick == \"no\":\n    print(\"-\", \"Coaster Storm\")\n\nif drop_tower_score >= threshold:\n    print(\"-\", \"Drop Tower\")\n\nif log_flume_score >= threshold and okay_wet == \"yes\":\n    print(\"-\", \"Log Flume\")\n\nif haunted_manor_score >= threshold:\n    print(\"-\", \"Haunted Manor\")\n\nif ferris_wheel_score >= threshold:\n    print(\"-\", \"Ferris Wheel\")\n\n# Students carry these five yes/no results into the Theater program.\nrecommend_coaster = coaster_score >= threshold and gets_motion_sick == \"no\"\nrecommend_drop_tower = drop_tower_score >= threshold\nrecommend_log_flume = log_flume_score >= threshold and okay_wet == \"yes\"\nrecommend_haunted_manor = haunted_manor_score >= threshold\nrecommend_ferris_wheel = ferris_wheel_score >= threshold",
          "folderId": "0",
          "active": true
        }
      },
