        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "import csv\n\nimport matplotlib.pyplot as plt\n\n# Data\nwith open(\"selling.csv\") as f:\n  data = list(csv.DictReader(f))\n\nitem_types = [\"Electronics\", \"Furniture\", \"Clothing\"]\n\n# Styling\nplt.rcParams.update({\"font.size\": 11, \"figure.dpi\": 140})\nstyles = {\n    \"sold\": {\n        \"marker\": \"o\",\n        \"color\": \"#0072B2\",\n        \"label\": \"Sold\"\n    },\n    \"unsold\": {\n        \"marker\": \"^\",\n        \"color\": \"#E69F00\",\n        \"label\": \"Unsold\"\n    },\n}\n\n# Plotting\nfigure, axes_list = plt.subplots(3,\n                                 1,\n                                 figsize=(6, 12),\n                                 sharex=True,\n                                 sharey=True)\n\nfor axes, item_type in zip(axes_list, item_types):\n  subset = [row for row in data if row[\"type\"] == item_type.lower()]\n\n  for outcome, style in styles.items():\n    x = [float(row[\"original\"]) for row in subset if row[\"outcome\"] == outcome]\n    y = [float(row[\"asking\"]) for row in subset if row[\"outcome\"] == outcome]\n    axes.scatter(\n        x,\n        y,\n        marker=style[\"marker\"],\n        color=style[\"color\"],\n        s=55,\n        edgecolors=\"black\",\n        linewidths=0.5,\n        label=style[\"label\"],\n    )\n\n  axes.set_title(f\"{item_type.title()} (n={len(subset)})\")\n  axes.set_ylabel(\"Asking Price (dollars)\")\n  axes.grid(True, linestyle=\":\", alpha=0.6)\n\naxes_list[-1].set_xlabel(\"Original Price (dollars)\")\naxes_list[0].legend(title=\"Outcome\", loc=\"upper left\")\n\nfigure.suptitle(\"Secondhand Listings\")\nfigure.tight_layout()\nplt.show()\n",
          "folderId": "0",
          "active": true
        },
