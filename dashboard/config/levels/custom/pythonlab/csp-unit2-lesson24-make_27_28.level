    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from theater import *\nfrom mosaic_stage import *\n\n# ----- YOUR THEME: change these to match your idea -----\ntitle = \"Sunset Sky\"\nitem = \"Tile\"\nunit = \"warmth\"\nspecial_name = \"glow tile\"\nspecial_every = 3\ncount = 6\n\n# These functions are provided. They draw the mosaic for you:\n#   setup_stage(title, special_name)\n#   draw_tile(j, value, is_special)\n#   draw_report(total, average, special_count, special_name)\n\ntotal = 0\nspecial_count = 0\n\nsetup_stage(title, special_name)\n\nfor j in range(count):\n    prompt = item + \" \" + str(j + 1) + \" (0 to 100 \" + unit + \"): \"\n    value = int(input(prompt))\n    total = total + value\n    is_special = (j + 1) % special_every == 0\n    if is_special:\n        special_count = special_count + 1\n    draw_tile(j, value, is_special)\n\naverage = total / count\n\ndraw_report(total, average, special_count, special_name)\n\nprint(\"Total: \" + str(total))\nprint(\"Average: \" + str(average))\nprint(special_name + \"s: \" + str(special_count))\nplay()",
          "folderId": "0",
          "active": true
        },
        "1": {
          "id": "1",
          "name": "mosaic_stage.py",
          "contents": "# mosaic_stage.py (provided)\n# This file draws the mosaic. You do not need to edit it.\nfrom theater import *\n\n__all__ = [\"setup_stage\", \"draw_tile\", \"draw_report\"]\n\n\ndef color_for(value):\n    \"\"\"Turns a number from 0 to 100 into a color, from cool blue (0) to warm orange (100).\"\"\"\n    red = 30 + int(value * 2.2)\n    green = 110 - int(value * 0.6)\n    blue = 240 - int(value * 2.2)\n    return Color(red, green, blue)\n\n\ndef setup_stage(title, special_name):\n    \"\"\"Draws the background, the title, and the legend.\"\"\"\n    clear(\"#F4F1EA\")\n    remove_stroke_color()\n    set_text_color(\"black\")\n    set_text_height(24)\n    draw_text(title, 20, 36)\n    # color scale: cool to warm\n    for i in range(11):\n        set_fill_color(color_for(i * 10))\n        draw_rectangle(20 + i * 14, 48, 14, 12)\n    set_text_height(12)\n    draw_text(\"cool\", 20, 76)\n    draw_text(\"warm\", 134, 76)\n    # special legend\n    set_fill_color(\"#F4F1EA\")\n    set_stroke_color(\"gold\")\n    set_stroke_width(4)\n    draw_rectangle(215, 48, 14, 14)\n    remove_stroke_color()\n    set_text_height(14)\n    draw_text(special_name, 236, 60)\n\n\ndef draw_tile(j, value, is_special):\n    \"\"\"Draws tile number j in the color for value, with a gold border if it is special.\"\"\"\n    x = 20 + (j % 3) * 120\n    y = 90 + (j // 3) * 110\n    set_fill_color(color_for(value))\n    if is_special:\n        set_stroke_color(\"gold\")\n        set_stroke_width(6)\n    else:\n        remove_stroke_color()\n    draw_rectangle(x, y, 100, 100)\n    remove_stroke_color()\n    pause(0.4)\n\n\ndef draw_report(total, average, special_count, special_name):\n    \"\"\"Draws the average color as one big swatch, and writes the totals beside it.\"\"\"\n    pause(0.6)\n    set_fill_color(color_for(average))\n    draw_rectangle(20, 318, 150, 64)\n    set_text_color(\"black\")\n    set_text_height(16)\n    draw_text(\"average color\", 186, 338)\n    draw_text(\"Total: \" + str(total), 186, 360)\n    draw_text(special_name + \"s: \" + str(special_count), 186, 380)",
          "folderId": "0",
          "active": false
        }
      },
