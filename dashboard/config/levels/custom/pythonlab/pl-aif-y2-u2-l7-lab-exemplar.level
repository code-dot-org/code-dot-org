          "id": "0",
          "name": "main.py",
          "contents": "from helpers import predict_category\n\ntraining_images = [\n  {\"category\": \"Ocean\", \"white_waves\": True, \"trees\": False, \"touch_sky\": True},\n  {\"category\": \"Ocean\", \"white_waves\": False, \"trees\": False, \"touch_sky\": True},\n  {\"category\": \"Ocean\", \"white_waves\": True, \"trees\": True, \"touch_sky\": True},\n  {\"category\": \"Ocean\", \"white_waves\": True, \"trees\": False, \"touch_sky\": True},\n  {\"category\": \"River\", \"white_waves\": False, \"trees\": True, \"touch_sky\": False},\n  {\"category\": \"River\", \"white_waves\": False, \"trees\": False, \"touch_sky\": False},\n  {\"category\": \"River\", \"white_waves\": False, \"trees\": True, \"touch_sky\": True},\n  {\"category\": \"River\", \"white_waves\": True, \"trees\": True, \"touch_sky\": False},\n]\n\n\ndef distance(image1, image2):\n  differences = 0\n  if image1[\"white_waves\"] != image2[\"white_waves\"]:\n    differences += 1\n  if image1[\"trees\"] != image2[\"trees\"]:\n    differences += 1\n  if image1[\"touch_sky\"] != image2[\"touch_sky\"]:\n    differences += 1\n  return differences\n\ntest_image = {\"white_waves\": True, \"trees\": True, \"touch_sky\": False}\n\nprediction = predict_category(test_image, training_images, distance)\nprint(f\"Predicted category for test image: {prediction}\")",
