        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "age = int(input(\"How old is the visitor? \"))\n\nif age < 5:\n    price = 0\nelse:\n    if age < 18:\n        price = 8\n    else:\n        if age >= 65:\n            price = 10\n        else:\n            price = 15\n\nprint(\"Ticket price: $\" + str(price))",
