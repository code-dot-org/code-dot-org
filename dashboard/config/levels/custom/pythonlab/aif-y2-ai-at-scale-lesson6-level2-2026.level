      "answerTypeCustomizations": {
      }
    },
    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from sklearn.linear_model import SGDRegressor\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.pipeline import make_pipeline\n\n# Twelve practice drives: [rock height (inches), ground slope (degrees)]\ninputs = [[0, 0], [3, 0], [0, 20], [1, 5], [3, 10], [4, 15],\n          [5, 20], [6, 30], [2, 25], [1, 30], [5, 5], [0, 10]]\n\n# The speed that got the rover through each drive (meters per hour)\noutputs = [90, 72, 70, 79, 62, 51, 40, 24, 53, 54, 55, 80]\n\n# This line creates a new, untrained network: a scaler, then one neuron\nmodel = make_pipeline(StandardScaler(), SGDRegressor())\n\nmodel.fit(inputs, outputs)\n\nprediction = round(model.predict([[2, 10]])[0])\nprint(f\"Drive 1: predicted {prediction}, the engineers guessed 62\")\nprediction = round(model.predict([[4, 30]])[0])\nprint(f\"Drive 2: predicted {prediction}, the engineers guessed 14\")\n\n# Train a new network for each max_iter and print its prediction for drive 1\nfor max_iter in [1, 10, 100, 1000]:\n    model = make_pipeline(StandardScaler(), SGDRegressor(max_iter=max_iter))\n    model.fit(inputs, outputs)\n    prediction = round(model.predict([[2, 10]])[0])\n    print(f\"max_iter {max_iter}: predicted {prediction}\")\n",
          "folderId": "0",
          "active": true
        }
