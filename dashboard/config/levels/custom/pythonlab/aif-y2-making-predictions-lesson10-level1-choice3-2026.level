    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "import csv\n\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.tree import DecisionTreeClassifier\n\nfrom helpers import visualize_model\n\n# Read data from CSV file\nf = open(\"games.csv\")\ngames = list(csv.DictReader(f))\nf.close()\n\n# Convert data into inputs (features) and outputs (labels)\nfeature_names = [\"TODO 1\", \"TODO 1\", \"TODO 1\", \"TODO 1\", \"TODO 1\"]\ninputs = [[int(game[feature]) for feature in feature_names] for game in games]\noutputs = [game[\"TODO 2\"] for game in games]\n\n# Split data into training and testing sets\ntrain_inputs, test_inputs, train_outputs, test_outputs = train_test_split(\n  inputs, outputs, test_size=0.25\n)\n\n# TODO 3: Create a decision tree model\n# TODO 4: Train the model\n\n# Visualize decision tree\nvisualize_model(model, feature_names)\n\n# TODO 5: Test the model and print its score",
          "folderId": "0",
          "active": true
        },
        "1": {
          "id": "1",
          "name": "helpers.py",
          "contents": "def visualize_model(model, feature_names=None, decimals=2):\n  \"\"\"Pretty-print the questions a fitted DecisionTreeClassifier asks.\"\"\"\n  tree = model.tree_\n\n  if feature_names is None:\n    n = getattr(model, \"n_features_in_\", None) or tree.n_features\n    feature_names = [\"feature_\" + str(i) for i in range(n)]\n\n  TEE, ELBOW, BAR, ARROW = \"├─\", \"└─\", \"│\", \"→\"\n  LABELS = (\"YES\", \"NO \")\n  STEM = len(TEE) + 1 + len(LABELS[0]) + 1 + len(ARROW) + 1\n\n  def number(x):\n    text = \"{:.{}f}\".format(x, decimals)\n    return text.rstrip(\"0\").rstrip(\".\") if \".\" in text else text\n\n  def class_counts(node):\n    raw = list(tree.value[node][0])\n    total = tree.n_node_samples[node]\n    if abs(sum(raw) - total) > 1e-6:  # sklearn >= 1.4 stores proportions\n      raw = [p * total for p in raw]\n    return [int(round(c)) for c in raw], total\n\n  def is_leaf(node):\n    return tree.children_left[node] == -1\n\n  def describe_leaf(node):\n    counts, total = class_counts(node)\n    best = max(range(len(counts)), key=lambda i: counts[i])\n    answer = str(model.classes_[best])\n    if counts[best] == total:\n      plural = \"\" if total == 1 else \"s\"\n      return \"{}  ({} example{})\".format(answer, total, plural)\n    order = sorted(range(len(counts)), key=lambda i: -counts[i])\n    mix = \", \".join(\n      \"{} {}\".format(counts[i], model.classes_[i]) for i in order if counts[i] > 0\n    )\n    return \"{}  ({})\".format(answer, mix)\n\n  def question(node):\n    return \"Is {} <= {}?\".format(\n      feature_names[tree.feature[node]],\n      number(float(tree.threshold[node])),\n    )\n\n  def describe(node):\n    return describe_leaf(node) if is_leaf(node) else question(node)\n\n  def walk(node, prefix):\n    children = (tree.children_left[node], tree.children_right[node])\n    for i, child in enumerate(children):\n      last = i == len(children) - 1\n      connector = ELBOW if last else TEE\n      print(\n        \"{}{} {} {} {}\".format(\n          prefix, connector, LABELS[i], ARROW, describe(child)\n        )\n      )\n      if not is_leaf(child):\n        spacer = \" \" if last else BAR\n        walk(child, prefix + spacer + \" \" * (STEM - len(spacer)))\n\n  print(describe(0))\n  if not is_leaf(0):\n    walk(0, \"\")",
          "folderId": "0",
          "active": false,
          "type": "support"
        },
