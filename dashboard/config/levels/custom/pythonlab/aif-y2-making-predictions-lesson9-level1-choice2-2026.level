          "name": "main.py",
          "contents": "samples = [\n  {\"chlorine\": 4.2, \"pH\": 7.8, \"risk\": \"high\"},\n  {\"chlorine\": 4.6, \"pH\": 7.9, \"risk\": \"high\"},\n  {\"chlorine\": 5.1, \"pH\": 7.6, \"risk\": \"high\"},\n  {\"chlorine\": 4.9, \"pH\": 8.1, \"risk\": \"high\"},\n  {\"chlorine\": 5.4, \"pH\": 7.7, \"risk\": \"high\"},\n  {\"chlorine\": 4.1, \"pH\": 7.6, \"risk\": \"low\"},\n  {\"chlorine\": 4.2, \"pH\": 7.2, \"risk\": \"high\"},\n  {\"chlorine\": 4.8, \"pH\": 7.1, \"risk\": \"high\"},\n  {\"chlorine\": 5.3, \"pH\": 6.9, \"risk\": \"high\"},\n  {\"chlorine\": 4.3, \"pH\": 7.3, \"risk\": \"low\"},\n  {\"chlorine\": 3.6, \"pH\": 8.2, \"risk\": \"high\"},\n  {\"chlorine\": 2.8, \"pH\": 7.7, \"risk\": \"low\"},\n  {\"chlorine\": 3.1, \"pH\": 7.9, \"risk\": \"low\"},\n  {\"chlorine\": 1.9, \"pH\": 7.6, \"risk\": \"low\"},\n  {\"chlorine\": 0.4, \"pH\": 6.8, \"risk\": \"high\"},\n  {\"chlorine\": 3.8, \"pH\": 7.4, \"risk\": \"high\"},\n  {\"chlorine\": 0.9, \"pH\": 6.5, \"risk\": \"high\"},\n  {\"chlorine\": 2.1, \"pH\": 7.2, \"risk\": \"low\"},\n  {\"chlorine\": 1.6, \"pH\": 7.4, \"risk\": \"low\"},\n  {\"chlorine\": 2.5, \"pH\": 7.0, \"risk\": \"low\"},\n  {\"chlorine\": 3.0, \"pH\": 7.3, \"risk\": \"low\"},\n  {\"chlorine\": 1.8, \"pH\": 6.9, \"risk\": \"low\"},\n  {\"chlorine\": 2.3, \"pH\": 7.1, \"risk\": \"low\"},\n  {\"chlorine\": 2.9, \"pH\": 7.4, \"risk\": \"low\"},\n  {\"chlorine\": 1.4, \"pH\": 7.2, \"risk\": \"low\"},\n  {\"chlorine\": 2.6, \"pH\": 6.8, \"risk\": \"low\"},\n  {\"chlorine\": 3.3, \"pH\": 7.3, \"risk\": \"low\"},\n  {\"chlorine\": 2.0, \"pH\": 6.7, \"risk\": \"low\"},\n  {\"chlorine\": 1.2, \"pH\": 7.0, \"risk\": \"low\"},\n  {\"chlorine\": 3.5, \"pH\": 7.1, \"risk\": \"low\"},\n]\n\n# TODO 1 and TODO 2: Compute values for high_risk and low_risk when pH is greater than 7.5\nhigh_risk = 0\nlow_risk = 0\n\ntotal = high_risk + low_risk\n\nhigh_proportion = high_risk / total\nlow_proportion = low_risk / total\n\n# TODO 3: Compute impurity\nimpurity = 0\n\nprint(f\"Impurity for high chlorine group: {round(impurity, 2)}\")",
