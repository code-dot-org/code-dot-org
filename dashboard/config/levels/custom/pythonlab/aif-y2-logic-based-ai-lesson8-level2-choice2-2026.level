          "name": "main.py",
          "contents": "def simulate(customers, growth, target):\n    months = 0\n    print(f\"Month {months}: {customers} customers\")\n\n    customers += customers * growth\n    months += 1\n    print(f\"Month {months}: {customers} customers\")\n\n    customers += customers * growth\n    months += 1\n    print(f\"Month {months}: {customers} customers\")\n\n\nsimulate(50, 1, 1000000)\n",
