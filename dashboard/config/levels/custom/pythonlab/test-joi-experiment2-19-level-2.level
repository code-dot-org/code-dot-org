      "files": {
        "80a31f50-48aa-4938-9f1b-40f234ae8991": {
          "id": "80a31f50-48aa-4938-9f1b-40f234ae8991",
          "name": "neighborhood.py",
          "contents": "_x = 0\n_y = 0\n_direction = 0 # 0: East, 1: North, 2: West, 3: South\n_painted_cells = {}\n\ndef set_paint(level):\n    # This function is called but its specific effect on `paint()` isn't defined here.\n    # We'll just acknowledge it for now.\n    print(f\"DEBUG: Painter received set_paint({level}) command.\")\n\ndef move():\n    global _x, _y\n    if _direction == 0: # East\n        _x += 1\n    elif _direction == 1: # North\n        _y += 1\n    elif _direction == 2: # West\n        _x -= 1\n    elif _direction == 3: # South\n        _y -= 1\n    print(f\"DEBUG: Painter moved to ({_x}, {_y}).\")\n\ndef paint(color):\n    _painted_cells[(_x, _y)] = color\n    print(f\"DEBUG: Painter painted ({_x}, {_y}) {color}.\")\n\ndef turn_left():\n    global _direction\n    _direction = (_direction + 1) % 4\n    directions_map = {0: \"East\", 1: \"North\", 2: \"West\", 3: \"South\"}\n    print(f\"DEBUG: Painter turned left. Now facing {directions_map[_direction]}.\")\n\ndef print_final_state():\n    directions_map = {0: \"East\", 1: \"North\", 2: \"West\", 3: \"South\"}\n    print(\"\\n--- Final Painter State ---\")\n    print(f\"Position: ({_x}, {_y})\")\n    print(f\"Direction: {directions_map[_direction]}\")\n    print(f\"Painted cells: {_painted_cells}\")\n    print(\"---------------------------\\n\")\n",
          "folderId": "0",
          "active": false
        },
        "518c74a7-fced-4685-8c2d-d0ade14eeedb": {
          "id": "518c74a7-fced-4685-8c2d-d0ade14eeedb",
          "name": "main.py",
          "contents": "from neighborhood import *\n\n# The Painter starts at (0, 0), facing east.\n# Paint a short path for the block party.\nset_paint(6)\n\nmove()\npaint(\"white\")\nmove()\nturn_left()\nmove()\npaint(\"white\")\nturn_left()\nturn_left()\nturn_left()\nmove()\npaint(\"white\")\n",
          "folderId": "0",
          "active": true
        }
      },
      "openFiles": [
