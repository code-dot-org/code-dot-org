    "thumbnail_url": "https://images.code.org/06f43725803c35118a5726aeea420f9c-800b26df-7e7b-4273-b102-5b31c85b30c9.gif",
    "validation_file": {
      "id": "1",
      "name": "test.py",
      "contents": "import ast\nfrom unittest import TestCase\n\n\nclass TestModifySoundDesigner(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Parse the source statically -- this level draws a full Theater\n        scene and calls play(), which we don't have a way to safely\n        execute or verify output from, so we check structure only.\"\"\"\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n        cls.tree = ast.parse(cls.source)\n\n    def _find_call(self, func_name):\n        return next(\n            (n for n in ast.walk(self.tree)\n             if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == func_name),\n            None,\n        )\n\n    def test_uses_randint_with_correct_range(self):\n        \"\"\"Uses randint() with a range from 48 to 84 to generate the note\"\"\"\n        randint_call = self._find_call(\"randint\")\n        self.assertIsNotNone(\n            randint_call,\n            \"We didn't find a randint() call. Use randint() to generate a random note.\"\n        )\n        self.assertEqual(\n            len(randint_call.args),\n            2,\n            \"randint() should be called with two numbers, like randint(48, 84).\"\n        )\n        low_node, high_node = randint_call.args\n        low = low_node.value if isinstance(low_node, ast.Constant) else None\n        high = high_node.value if isinstance(high_node, ast.Constant) else None\n        self.assertEqual(\n            (low, high),\n            (48, 84),\n            f\"Expected randint(48, 84), but found randint({low}, {high}). Notes should range from 48 to 84.\"\n        )\n\n    def test_play_note_uses_the_random_value(self):\n        \"\"\"Updates play_note() to use the random note, not the original hardcoded 60\"\"\"\n        randint_call = self._find_call(\"randint\")\n        play_note_call = self._find_call(\"play_note\")\n        self.assertIsNotNone(\n            play_note_call,\n            \"We didn't find a play_note() call. Make sure it's still there.\"\n        )\n        self.assertTrue(\n            play_note_call.args,\n            \"play_note() doesn't seem to have any arguments.\"\n        )\n        first_arg = play_note_call.args[0]\n        self.assertFalse(\n            isinstance(first_arg, ast.Constant) and first_arg.value == 60,\n            \"play_note() is still using the original hardcoded value (60). Update it to use your random note variable instead.\"\n        )\n        if randint_call is not None:\n            # Trace the variable play_note()'s first argument refers to,\n            # and confirm that variable was assigned from the randint() call.\n            self.assertIsInstance(\n                first_arg,\n                ast.Name,\n                \"play_note()'s first argument should be a variable (e.g. random_note), not a number or expression written directly.\"\n            )\n            assigned_from_randint = any(\n                isinstance(node, ast.Assign)\n                and any(isinstance(t, ast.Name) and t.id == first_arg.id for t in node.targets)\n                and isinstance(node.value, ast.Call)\n                and isinstance(node.value.func, ast.Name)\n                and node.value.func.id == \"randint\"\n                for node in ast.walk(self.tree)\n            )\n            self.assertTrue(\n                assigned_from_randint,\n                f\"The variable passed to play_note() ({first_arg.id}) doesn't appear to be set from randint(). \"\n                \"Make sure play_note() uses the same variable that stores your random note.\"\n            )",
      "folderId": "0",
      "active": false,
      "type": "validation"
    },
    "mini_app_variant": "functional"
