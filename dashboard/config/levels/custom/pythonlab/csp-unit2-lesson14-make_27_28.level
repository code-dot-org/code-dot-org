        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "# Weekend Recommender\n# Sunny: $50 or more is Theme park day, $20 to $49 is Mini golf, under $20 is Park picnic.\n# Rainy: $20 or more is Movie theater, under $20 is Library game afternoon.\n\nweather = input(\"Will it be sunny or rainy? \")\nmoney = int(input(\"How much can you spend? \"))\n\n# Your code goes below",
