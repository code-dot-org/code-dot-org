    "display_name": "Collect and Cover",
    "bubble_choice_description": "The Painter is standing at a paint bucket, at the start of a path that dead-ends at a wall. Help it collect all the paint, then paint the whole path using while loops.",
    "thumbnail_url": "https://images.code.org/2964ec695df3e214f8df22d949ee79e0-Screenshot 2026-11-04 101741.png",
    "validation_file": {
      "id": "2",
      "name": "test.py",
      "contents": "import ast\nfrom unittest import TestCase\nfrom unittest_runner import ValidationProtocol\n\n\nclass TestModifyPaintCollection(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Run the student's code and parse its structure\"\"\"\n        cls.log = ValidationProtocol().get_neighborhood_log()\n        cls.painter = cls.log.painter_logs[0] if cls.log.painter_logs else None\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n        cls.tree = ast.parse(cls.source)\n        cls.while_nodes = [n for n in ast.walk(cls.tree) if isinstance(n, ast.While)]\n\n    def setUp(self):\n        if self.painter is None:\n            self.skipTest(\"No painter actions found yet. Make sure your program runs without errors.\")\n\n    def _calls_named(self, node, name):\n        \"\"\"True if name(...) is called anywhere inside node\"\"\"\n        return any(\n            isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == name\n            for n in ast.walk(node)\n        )\n\n    def test_adds_paint_collection_loop(self):\n        \"\"\"Adds a while loop that collects all the paint using is_on_bucket()\"\"\"\n        loop = next((n for n in self.while_nodes if self._calls_named(n.test, \"is_on_bucket\")), None)\n        self.assertIsNotNone(\n            loop,\n            \"We didn't find a while loop whose condition calls is_on_bucket(). Add `while is_on_bucket(): take_paint()` where the single take_paint() call used to be.\"\n        )\n        self.assertTrue(\n            self._calls_named(loop, \"take_paint\"),\n            \"Your is_on_bucket() loop doesn't call take_paint() inside it. Make sure take_paint() is in the loop body.\"\n        )\n        self.assertGreater(\n            self.painter.action_count(\"IS_ON_BUCKET\"),\n            0,\n            \"is_on_bucket() didn't actually run when we ran your program. Double-check your loop is placed where the painter starts on the bucket.\"\n        )\n\n    def test_paint_loops_check_has_paint(self):\n        \"\"\"Both paint loops stop as soon as can_move() or has_paint() is False\"\"\"\n        paint_loops = [\n            n for n in self.while_nodes\n            if self._calls_named(n.test, \"can_move\") and not self._calls_named(n.test, \"is_on_bucket\")\n        ]\n        self.assertEqual(\n            len(paint_loops),\n            2,\n            f\"Expected to find 2 while loops checking can_move() (the painting loops), but found {len(paint_loops)}. Make sure you didn't remove or combine either loop.\"\n        )\n        for loop in paint_loops:\n            condition = loop.test\n            is_and_combo = (\n                isinstance(condition, ast.BoolOp)\n                and isinstance(condition.op, ast.And)\n                and self._calls_named(condition, \"can_move\")\n                and self._calls_named(condition, \"has_paint\")\n            )\n            self.assertTrue(\n                is_and_combo,\n                \"Each paint loop's condition should check can_move() and has_paint() together, like `while can_move() and has_paint():`. We found a loop still checking only one of them, or combining them with `or` instead of `and`.\"\n            )\n        self.assertGreater(\n            self.painter.action_count(\"HAS_PAINT\"),\n            0,\n            \"has_paint() didn't actually get called when we ran your program. Make sure it's part of the while condition, not just written somewhere else.\"\n        )",
      "folderId": "0",
      "active": false,
      "type": "validation"
    }
