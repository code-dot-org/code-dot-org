    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from sklearn.linear_model import SGDRegressor\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.pipeline import make_pipeline\n\n# Twelve practice drives: [rock height (inches), ground slope (degrees)]\ninputs = [[0, 0], [3, 0], [0, 20], [1, 5], [3, 10], [4, 15],\n          [5, 20], [6, 30], [2, 25], [1, 30], [5, 5], [0, 10]]\n\n# The speed that got the rover through each drive (meters per hour)\noutputs = [90, 72, 70, 79, 62, 51, 40, 24, 53, 54, 55, 80]\n\n# This line creates a new, untrained network: a scaler, then one neuron\nmodel = make_pipeline(StandardScaler(), SGDRegressor())\n\n# TODO 1: Train the network on the drives\n\n# TODO 2: Predict and print the speed for drives 1 and 2\n",
          "folderId": "0",
          "active": false
        }
      },
      "folders": {
