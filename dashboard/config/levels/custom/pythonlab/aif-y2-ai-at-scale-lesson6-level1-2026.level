      ]
    },
    "validation_file": {
      "id": "1",
      "name": "validation.py",
      "contents": "import contextlib\nimport io\nimport re\nfrom unittest import TestCase\n\nfrom sklearn.exceptions import NotFittedError\nfrom sklearn.utils.validation import check_is_fitted\nfrom unittest_runner import ValidationProtocol\n\n\ndef load_student_program():\n    \"\"\"Imports main into test, preventing additional output\"\"\"\n    with contextlib.redirect_stdout(io.StringIO()):\n        import main\n    return main\n\n\nclass TestSpeedNetwork(TestCase):\n    longMessage = False\n\n    def test_model_is_trained(self):\n        \"\"\"The network is trained\"\"\"\n        try:\n            check_is_fitted(load_student_program().model)\n        except NotFittedError:\n            self.fail(\"The network hasn't been trained yet\")\n\n    def test_print_drive_1(self):\n        \"\"\"Prints network's prediction for drive 1\"\"\"\n        output = \"\\n\".join(ValidationProtocol().get_stdout_logs())\n        printed = {round(float(n)) for n in re.findall(r\"-?\\d+(?:\\.\\d+)?\", output)}\n        self.assertIn(68, printed, \"Output doesn't include correct prediction for drive 1\")\n\n    def test_print_drive_2(self):\n        \"\"\"Prints network's prediction for drive 2\"\"\"\n        output = \"\\n\".join(ValidationProtocol().get_stdout_logs())\n        printed = {round(float(n)) for n in re.findall(r\"-?\\d+(?:\\.\\d+)?\", output)}\n        self.assertIn(36, printed, \"Output doesn't include correct prediction for drive 2\")\n",
      "folderId": "0",
