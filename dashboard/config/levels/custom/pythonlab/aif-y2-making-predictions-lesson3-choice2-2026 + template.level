    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from sklearn.linear_model import LinearRegression\nfrom sklearn.preprocessing import OneHotEncoder\n\nfrom helpers import create_matrix, print_linear_model, print_matrix\n\n# Data\ndata = [\n  {\"hours\": 6, \"rainy\": \"no\", \"location\": \"downtown\", \"sales\": 1145},\n  {\"hours\": 4, \"rainy\": \"yes\", \"location\": \"park\", \"sales\": 495},\n  {\"hours\": 8, \"rainy\": \"no\", \"location\": \"downtown\", \"sales\": 1380},\n  {\"hours\": 6, \"rainy\": \"no\", \"location\": \"campus\", \"sales\": 890},\n  {\"hours\": 5, \"rainy\": \"yes\", \"location\": \"campus\", \"sales\": 540},\n]\n\n# TODO: Encodings\nhours_encoding = []\nfor row in data:\n  hours_encoding.append(row[\"hours\"])\n\n# Inputs\nfeatures = [hours_encoding]\ninputs = create_matrix(features)\nprint_matrix(inputs)\n\n# Outputs\noutputs = []\nfor row in data:\n  outputs.append(row[\"sales\"])\n\n# Model\nmodel = LinearRegression()\nmodel.fit(inputs, outputs)\n\nprint_linear_model(model)",
          "folderId": "0",
          "active": true
        },
        "1": {
          "id": "1",
          "name": "helpers.py",
          "contents": "from typing import Any, Sequence\n\nimport numpy as np\nfrom scipy import sparse\n\n\ndef print_linear_model(\n    model: Any,\n    feature_names: Sequence[str] | None = None,\n    target_name: str = \"y\",\n    precision: int = 1,\n) -> None:\n    \"\"\"Print a fitted linear model as an equation.\n\n    :param model: A fitted scikit-learn linear model exposing ``coef_`` and\n        ``intercept_``.\n    :type model: Any\n    :param feature_names: Names to use for the features, in column order. If\n        omitted, the model's ``feature_names_in_`` attribute is used, falling\n        back to ``x0``, ``x1``, and so on.\n    :type feature_names: Sequence[str] | None\n    :param target_name: Name to print on the left-hand side of the equation.\n    :type target_name: str\n    :param precision: Number of decimal places for each coefficient.\n    :type precision: int\n    :returns: Nothing; the equation is printed. One line is printed per target\n        for a multi-target model.\n    :rtype: None\n    \"\"\"\n    coefs = np.atleast_2d(model.coef_)\n    intercepts = np.atleast_1d(model.intercept_)\n\n    if feature_names is None:\n        feature_names = getattr(\n            model, \"feature_names_in_\", [f\"x{i}\" for i in range(coefs.shape[1])]\n        )\n\n    equations: list[str] = []\n    for row, c in zip(coefs, intercepts):\n        terms = [f\"{row[0]:.{precision}f} * {feature_names[0]}\"]\n        for b, name in zip(row[1:], feature_names[1:]):\n            terms.append(f\" {'-' if b < 0 else '+'} {abs(b):.{precision}f} * {name}\")\n        terms.append(f\" {'-' if c < 0 else '+'} {abs(c):.{precision}f}\")\n        equations.append(f\"{target_name} = \" + \"\".join(terms))\n\n    print(\"\\n\".join(equations))\n\n\ndef create_matrix(columns: Sequence[Any]) -> list[list[Any]]:\n    \"\"\"Build a 2-D feature matrix from column-shaped inputs.\n\n    :param columns: One array- or matrix-like object per feature, each with one\n        row per sample. A 1-D entry (e.g. a plain list of numbers) contributes a\n        single column. A 2-D entry (e.g. a NumPy array, a list of lists, or a\n        SciPy sparse matrix, such as the output of\n        ``OneHotEncoder.fit_transform``) contributes one column per column of\n        that entry.\n    :type columns: Sequence[Any]\n    :returns: A list of rows, suitable to pass as ``X`` to ``model.fit``.\n    :rtype: list[list[Any]]\n    :raises ValueError: If the columns do not all have the same number of\n        rows.\n    \"\"\"\n    if not columns:\n        return []\n\n    dense_columns = [\n        col.toarray() if sparse.issparse(col) else np.asarray(col) for col in columns\n    ]\n\n    rows = dense_columns[0].shape[0]\n    for i, col in enumerate(dense_columns):\n        if col.shape[0] != rows:\n            raise ValueError(f\"column {i} has {col.shape[0]} rows, expected {rows}\")\n\n    X: list[list[Any]] = []\n    for i in range(rows):\n        row: list[Any] = []\n        for col in dense_columns:\n            value = col[i]\n            if np.ndim(value) > 0:\n                row.extend(value.tolist())\n            else:\n                row.append(value.item())\n        X.append(row)\n    return X\n\n\ndef print_matrix(\n    X: Sequence[Sequence[Any]],\n    feature_names: Sequence[str] | None = None,\n    precision: int = 0,\n) -> None:\n    \"\"\"Print a feature matrix as an aligned table.\n\n    :param X: The matrix, as a sequence of rows of numbers or strings.\n    :type X: Sequence[Sequence[Any]]\n    :param feature_names: Column headers, in column order. If omitted, headers\n        of ``x0``, ``x1``, and so on are generated.\n    :type feature_names: Sequence[str] | None\n    :param precision: Number of decimal places for float values. Integers and\n        strings are printed unchanged.\n    :type precision: int\n    :returns: Nothing; the table is printed. Every row is printed, so slice ``X``\n        before calling for a large matrix.\n    :rtype: None\n    :raises ValueError: If the rows are not all the same length, or if the number\n        of feature names does not match the number of columns.\n    \"\"\"\n    if not X:\n        print(\"(empty matrix)\")\n        return\n\n    def fmt(value: Any) -> str:\n        if isinstance(value, float):\n            return f\"{value:.{precision}f}\"\n        return str(value)\n\n    n_cols = len(X[0])\n    for i, row in enumerate(X):\n        if len(row) != n_cols:\n            raise ValueError(f\"row {i} has {len(row)} values, expected {n_cols}\")\n\n    if feature_names is None:\n        header = [f\"x{j}\" for j in range(n_cols)]\n    else:\n        if len(feature_names) != n_cols:\n            raise ValueError(f\"{len(feature_names)} names for {n_cols} columns\")\n        header = [str(name) for name in feature_names]\n\n    rows = [[fmt(v) for v in row] for row in X]\n    widths = [max(len(header[j]), max(len(r[j]) for r in rows)) for j in range(n_cols)]\n\n    def line(cells: Sequence[str]) -> str:\n        return \"  \".join(f\"{c:>{w}}\" for c, w in zip(cells, widths))\n\n    print(line(header))\n    print(\"-\" * len(line(header)))\n    for r in rows:\n        print(line(r))\n    print()",
          "folderId": "0",
          "active": false,
          "type": "support"
        }
      },
