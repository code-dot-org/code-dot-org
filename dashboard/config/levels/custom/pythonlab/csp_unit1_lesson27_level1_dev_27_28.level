      "id": "1",
      "name": "test.py",
      "contents": "import contextlib\nimport io\nfrom unittest import TestCase\nfrom unittest.mock import patch\n\n\nclass TestModifyBobaSplitterToppings(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Run the student's code with fixed, known inputs so we can\n        verify the toppings cost actually changes the total by a\n        predictable amount.\"\"\"\n        with open(\"main.py\") as f:\n            cls.source = f.read()\n\n        # Baseline: no-topping-equivalent run and a with-toppings run,\n        # everything else held constant, so we can isolate toppings' effect.\n        cls.run_error = None\n        cls.stdout_with_toppings = None\n        cls.stdout_zero_toppings = None\n        try:\n            cls.stdout_with_toppings = cls._run(cls.source, [\"4\", \"5.00\", \"0\", \"3.00\", \"2\"])\n            cls.stdout_zero_toppings = cls._run(cls.source, [\"4\", \"5.00\", \"0\", \"0.00\", \"2\"])\n        except Exception as e:\n            cls.run_error = e\n\n    @staticmethod\n    def _run(source, inputs):\n        stdout = io.StringIO()\n        with patch(\"builtins.input\", side_effect=inputs), contextlib.redirect_stdout(stdout):\n            exec(compile(source, \"main.py\", \"exec\"), {})\n        return stdout.getvalue()\n\n    def test_runs_without_error(self):\n        \"\"\"Runs without an error when given a toppings amount\"\"\"\n        self.assertIsNone(\n            self.run_error,\n            f\"Your program raised an error while running: {self.run_error}. \"\n            \"Make sure you added a new input() for toppings cost, in addition to the existing inputs.\"\n        )\n\n    def test_toppings_included_in_subtotal(self):\n        \"\"\"Including a toppings cost changes the resulting total\"\"\"\n        if self.run_error is not None:\n            self.skipTest(\"Fix the error above first.\")\n        self.assertNotEqual(\n            self.stdout_with_toppings,\n            self.stdout_zero_toppings,\n            \"Running your program with $3.00 in toppings produced the exact same output as running it with $0.00 in toppings. \"\n            \"Make sure toppings is actually included in your subtotal calculation.\"\n        )\n\n    def test_group_total_printed_before_split_amount(self):\n        \"\"\"Prints the group total before the per-person split amount\"\"\"\n        if self.run_error is not None:\n            self.skipTest(\"Fix the error above first.\")\n        lines = self.stdout_with_toppings.splitlines()\n        total_index = next((i for i, line in enumerate(lines) if \"group total\" in line.lower() or \"total:\" in line.lower()), None)\n        split_index = next((i for i, line in enumerate(lines) if \"each person pays\" in line.lower()), None)\n        self.assertIsNotNone(\n            total_index,\n            \"We didn't find a line printing the group total. Make sure you print the group total before the split amount.\"\n        )\n        self.assertIsNotNone(split_index, \"We didn't find the 'Each person pays' line -- make sure it's still there.\")\n        self.assertLess(\n            total_index,\n            split_index,\n            \"The group total should print BEFORE the split amount, but we found it printed after (or in the wrong order).\"\n        )\n\n    def test_group_total_shown_in_dollars_and_cents(self):\n        \"\"\"The group total is shown as dollars and cents, derived using round() and %\"\"\"\n        if self.run_error is not None:\n            self.skipTest(\"Fix the error above first.\")\n        lines = self.stdout_with_toppings.splitlines()\n        total_line = next((line for line in lines if \"group total\" in line.lower() or \"total:\" in line.lower()), None)\n        self.assertIsNotNone(total_line, \"We didn't find a line printing the group total.\")\n        # 4 drinks x $5.00 + $3.00 toppings - $0 coupon = $23.00, x 1.18 tip = $27.14 -> 2714 cents -> $27.14\n        self.assertIn(\n            \"27.14\",\n            total_line.replace(\"$\", \"\"),\n            f\"Expected the group total to come out to $27.14 with these inputs, but got: {total_line}. \"\n            \"Check that toppings is added to the subtotal, and that you're using round() and % correctly to split it into dollars and cents.\"\n        )",
      "folderId": "0",
