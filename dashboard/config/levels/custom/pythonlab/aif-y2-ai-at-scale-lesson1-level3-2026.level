      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "# TODO 1: Import LinearRegression from scikit-learn\nfrom helpers import draw_chart\n\n# The day's readings, one per hour from midnight (0) to 11 pm (23)\nhours = [[hour] for hour in range(24)]\nuv_levels = [0, 0, 0, 0, 0, 0, 0, 2, 4, 6, 7, 8,\n             9, 9, 9, 8, 7, 6, 4, 2, 0, 0, 0, 0]\n\n# TODO 2: Create a new, untrained linear regression model\n\n# TODO 3: Train the model on the hours and the UV levels\n\n# TODO 4: Predict and print the 3 pm and 11 pm UV levels\n\n# Draw the chart\ndraw_chart(hours, uv_levels, model, \"UV index\")\n",
          "folderId": "0",
          "active": true
        },
        "2": {
          "id": "2",
          "name": "helpers.py",
          "contents": "import matplotlib.pyplot as plt\n\n\n# Draws the day's readings as dots and, once the model is trained, its line.\ndef draw_chart(hours, readings, model, label):\n    x = [hour[0] for hour in hours]\n    plt.scatter(x, readings)\n    if hasattr(model, \"coef_\"):\n        plt.plot(x, model.predict(hours))\n    plt.xlabel(\"Hour of the day\")\n    plt.ylabel(label)\n    plt.xticks(range(0, 24, 3))\n    plt.show()\n",
          "folderId": "0",
          "active": false,
          "type": "support"
        }
      },
      "folders": {
      },
