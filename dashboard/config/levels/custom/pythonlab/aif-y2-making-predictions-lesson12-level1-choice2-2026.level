      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "import csv\n\nimport matplotlib.pyplot as plt\n\n# Data\nwith open(\"knitting.csv\") as f:\n  data = list(csv.DictReader(f))\n\ngroups = [(\"yes\", \"Has Deadline\"), (\"no\", \"Has No Deadline\")]\n\n# Styling\nplt.rcParams.update({\"font.size\": 11, \"figure.dpi\": 140})\nstyles = {\n    \"finished\": {\n        \"marker\": \"o\",\n        \"color\": \"#0072B2\",\n        \"label\": \"Finished\"\n    },\n    \"abandoned\": {\n        \"marker\": \"^\",\n        \"color\": \"#E69F00\",\n        \"label\": \"Abandoned\"\n    },\n}\n\n# Plotting\nfigure, axes_list = plt.subplots(2,\n                                 1,\n                                 figsize=(6, 9),\n                                 sharex=True,\n                                 sharey=True)\n\nfor axes, (value, heading) in zip(axes_list, groups):\n  subset = [row for row in data if row[\"deadline\"] == value]\n\n  for outcome, style in styles.items():\n    x = [\n        float(row[\"estimated-hours\"]) for row in subset\n        if row[\"outcome\"] == outcome\n    ]\n    y = [\n        float(row[\"hours-per-week\"]) for row in subset\n        if row[\"outcome\"] == outcome\n    ]\n    axes.scatter(\n        x,\n        y,\n        marker=style[\"marker\"],\n        color=style[\"color\"],\n        s=55,\n        edgecolors=\"black\",\n        linewidths=0.5,\n        label=style[\"label\"],\n    )\n\n  axes.set_title(f\"{heading} (n={len(subset)})\")\n  axes.set_ylabel(\"Hours Available per Week\")\n  axes.grid(True, linestyle=\":\", alpha=0.6)\n\naxes_list[-1].set_xlabel(\"Estimated Hours to Complete\")\naxes_list[0].legend(title=\"Outcome\", loc=\"lower right\")\n\nfigure.suptitle(\"Knitting Projects\")\nfigure.tight_layout()\nplt.show()\n",
          "folderId": "0",
          "active": true
        },
