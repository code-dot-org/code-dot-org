        "0": {
          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "import pandas as pd\nimport matplotlib.pyplot as plt\n\ndf = pd.read_csv('new_superhero_roster.csv')\n\n# Filter for superheroes whose Alias ends with \"r\"\nalias_condition = df['Alias'].str.endswith('r')\nfiltered_heroes = df[alias_condition]\n\nprint(\"Superheroes with aliases ending in r:\")\nprint(filtered_heroes)\n\n# Check which filtered superheroes have an Affiliation\nnotnull_condition = filtered_heroes['Affiliation'].notnull()\n\nprint(\"\\nBoolean Condition:\")\nprint(notnull_condition)\n\n# Keep the rows where the condition is True\nfinal_heroes = filtered_heroes[notnull_condition]\n\nprint(\"\\nFinal Filtered Superheroes:\")\nprint(final_heroes)",
          "folderId": "0",
          "active": true,
          "open": true
        },
