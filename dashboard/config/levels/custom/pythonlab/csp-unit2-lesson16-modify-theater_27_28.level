      "id": "1",
      "name": "test.py",
      "contents": "import re\nfrom unittest import TestCase\n\n\nclass TestInvestigateModify(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Read the student's source code\"\"\"\n        with open(\"main.py\") as f:\n            cls.source = f.read().replace(\" \", \"\")\n\n    def test_skips_every_other_spot(self):\n        \"\"\"Modifies the loop so it skips every other spot\"\"\"\n        doubled_step = bool(re.search(r\"x(\\+=|=x\\+)40\\b\", self.source))\n        modulo_skip = \"%2\" in self.source and \"draw_ellipse\" in self.source\n        self.assertTrue(\n            doubled_step or modulo_skip,\n            \"We didn't detect a change that skips every other spot. Try doubling how much x increases each pass (e.g., x = x + 40), or add a check (like using % 2) so draw_ellipse only runs on every other pass.\"\n        )",
