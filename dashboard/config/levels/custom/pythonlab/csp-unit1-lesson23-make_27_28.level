      "id": "1",
      "name": "test.py",
      "contents": "import ast\nimport contextlib\nimport io\nfrom unittest import TestCase\nfrom unittest.mock import patch\n\n\nMARKER_SUBSTRING = \"AI-generated visual\"\n\n\nclass TestMakeVariablesScene(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Isolate the logic section above the AI-generated visual marker,\n        then run just that section with input() mocked -- we never touch\n        the Scene()/play_scenes() code below the marker.\"\"\"\n        with open(\"main.py\") as f:\n            full_lines = f.read().splitlines()\n        marker_index = next(\n            (i for i, line in enumerate(full_lines) if MARKER_SUBSTRING in line),\n            None,\n        )\n        cls.logic_source = \"\\n\".join(full_lines[:marker_index] if marker_index is not None else full_lines)\n        cls.tree = ast.parse(cls.logic_source)\n        cls.top_assigns = [n for n in cls.tree.body if isinstance(n, ast.Assign)]\n\n        input_call_count = sum(\n            1 for n in ast.walk(cls.tree)\n            if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == \"input\"\n        )\n        cls.mock_answers = [f\"test_input_{i + 1}\" for i in range(max(input_call_count, 1))]\n\n        cls.namespace = {}\n        cls.run_error = None\n        stdout = io.StringIO()\n        try:\n            with patch(\"builtins.input\", side_effect=cls.mock_answers), contextlib.redirect_stdout(stdout):\n                exec(compile(cls.logic_source, \"main.py\", \"exec\"), cls.namespace)\n        except Exception as e:\n            cls.run_error = e\n        cls.stdout_text = stdout.getvalue()\n\n    def setUp(self):\n        if self.run_error is not None:\n            self.skipTest(f\"Your code raised an error before reaching the AI-generated visual: {self.run_error}\")\n\n    def _first_assigned_value(self, name):\n        for node in self.top_assigns:\n            if any(isinstance(t, ast.Name) and t.id == name for t in node.targets):\n                return node.value\n        return None\n\n    def _assign_count(self, name):\n        return sum(\n            1 for node in self.top_assigns\n            if any(isinstance(t, ast.Name) and t.id == name for t in node.targets)\n        )\n\n    def _distinct_assigned_names(self):\n        names = []\n        seen = set()\n        for node in self.top_assigns:\n            for t in node.targets:\n                if isinstance(t, ast.Name) and t.id not in seen:\n                    seen.add(t.id)\n                    names.append(t.id)\n        return names\n\n    def test_has_string_variable_from_input(self):\n        \"\"\"Creates at least one string variable directly from input()\"\"\"\n        input_vars = [\n            name for name in self._distinct_assigned_names()\n            if isinstance(self._first_assigned_value(name), ast.Call)\n            and isinstance(self._first_assigned_value(name).func, ast.Name)\n            and self._first_assigned_value(name).func.id == \"input\"\n        ]\n        self.assertTrue(\n            input_vars,\n            \"We didn't find any variable set directly to input(...). Create a string variable for each label on your sketch using input().\"\n        )\n        for name in input_vars:\n            self.assertIn(\n                self.namespace.get(name),\n                self.mock_answers,\n                f\"The variable {name} didn't end up holding what input() returned. Make sure it's set directly, like {name} = input(\\\"...\\\").\"\n            )\n\n    def test_has_int_variable_assigned_directly(self):\n        \"\"\"Creates an int variable assigned directly to a number, not input()\"\"\"\n        found = any(\n            isinstance(self._first_assigned_value(name), ast.Constant)\n            and isinstance(self._first_assigned_value(name).value, int)\n            and not isinstance(self._first_assigned_value(name).value, bool)\n            for name in self._distinct_assigned_names()\n        )\n        self.assertTrue(\n            found,\n            \"We didn't find an int variable assigned directly to a number (not input()). Add one, e.g. goals_scored = 5.\"\n        )\n\n    def test_has_bool_variable_assigned_directly(self):\n        \"\"\"Creates a bool variable assigned directly to True or False, not input()\"\"\"\n        found = any(\n            isinstance(self._first_assigned_value(name), ast.Constant)\n            and isinstance(self._first_assigned_value(name).value, bool)\n            for name in self._distinct_assigned_names()\n        )\n        self.assertTrue(\n            found,\n            \"We didn't find a bool variable assigned directly to True or False. Add one, e.g. is_team_winning = True.\"\n        )\n\n    def test_reassigns_a_variable(self):\n        \"\"\"Reassigns one of the variables to a new value\"\"\"\n        reassigned = [name for name in self._distinct_assigned_names() if self._assign_count(name) > 1]\n        self.assertTrue(\n            reassigned,\n            \"We didn't find any variable being assigned a second time. Reassign one of your variables based on a new value.\"\n        )\n\n    def test_prints_all_variables_including_reassigned_value(self):\n        \"\"\"Prints all variables, with the reassigned one showing its new value\"\"\"\n        self.assertTrue(\n            any(isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == \"print\" for n in ast.walk(self.tree)),\n            \"We didn't find any print() statements. Print out all of your variables.\"\n        )\n        missing = []\n        for name in self._distinct_assigned_names():\n            final_value_str = str(self.namespace.get(name))\n            if final_value_str not in self.stdout_text:\n                missing.append(name)\n        self.assertFalse(\n            missing,\n            f\"These variables' current values didn't show up anywhere in your printed output: {missing}. \"\n            \"Make sure every variable is printed, and that reassigned ones are printed with their new value.\"\n        )",
      "folderId": "0",
      "active": false,
      "type": "validation"
    }
  },
