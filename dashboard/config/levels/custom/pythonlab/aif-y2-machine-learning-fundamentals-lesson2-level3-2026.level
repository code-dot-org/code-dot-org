    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "import random\n\n\ndef get_random_slices():\n    return random.randint(1, 3)\n\n\ndef simulate_party():\n    total = 0\n    for i in range(20):\n        slices = get_random_slices()\n        total += slices\n    return total\n\n# TODO 1: Define a variable to keep track of how many parties were successful\n\nfor i in range(100):\n    slices = simulate_party()\n    \n    # TODO 2: If there was enough pizza, add 1 to the number of successes\n\n# TODO 3: Print how many successful parties there were",
