          "name": "main.py",
          "contents": "import csv\n \nfile_1 = open(\"bus_1.csv\")\nreader_1 = csv.DictReader(file_1)\nbus_1_times = []\nfor row in reader_1:\n    time = row[\"wait_time\"]\n    bus_1_times.append(time)\nfile_1.close()\n\nfile_2 = open(\"bus_2.csv\")\nreader_2 = csv.DictReader(file_2)\nbus_2_times = []\nfor row in reader_2:\n    time = row[\"wait_time\"]\n    bus_2_times.append(time)\nfile_2.close()\n\nprint(bus_1_times)\nprint(bus_2_times)",
