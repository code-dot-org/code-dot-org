          "name": "main.py",
          "language": "py",
          "contents": "import pandas as pd\nimport matplotlib.pyplot as plt\n\ndata = pd.read_csv('Hurricane_Maria.csv')\n\n# Remove placeholder values that do not represent temperatures\ndata = data[data['ANALYSED_SST'] > -100]\n\ndata.info()\nprint(data.describe())\n\n# Add your analysis below",
