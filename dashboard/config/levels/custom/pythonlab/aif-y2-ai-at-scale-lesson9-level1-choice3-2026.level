        "3": {
          "id": "3",
          "name": "helpers.py",
          "contents": "import matplotlib.pyplot as plt\nimport numpy as np\nfrom matplotlib.colors import ListedColormap\nfrom sklearn.inspection import DecisionBoundaryDisplay\n\nPALETTE = [\"tab:blue\", \"tab:orange\"]\n\n\ndef visualize_model(model, inputs, outputs, x_label, y_label):\n    labels = list(model.classes_)\n    colors = PALETTE[: len(labels)]\n    display = DecisionBoundaryDisplay.from_estimator(\n        model,\n        np.array(inputs),\n        response_method=\"predict\",\n        cmap=ListedColormap(colors),\n        alpha=0.25,\n        xlabel=x_label,\n        ylabel=y_label,\n    )\n    for label, color in zip(labels, colors):\n        xs = [x for (x, y), out in zip(inputs, outputs) if out == label]\n        ys = [y for (x, y), out in zip(inputs, outputs) if out == label]\n        display.ax_.scatter(xs, ys, c=color, label=label, edgecolors=\"black\")\n    display.ax_.legend()\n    plt.show()\n\n\n",
          "folderId": "0",
          "active": false,
          "type": "support"
        }
