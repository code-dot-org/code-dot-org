    "validation_file": {
      "id": "2",
      "name": "validation.py",
      "contents": "import contextlib\nimport io\nfrom unittest import TestCase\n\nfrom sklearn.exceptions import NotFittedError\nfrom sklearn.utils.validation import check_is_fitted\nfrom unittest_runner import ValidationProtocol\n\n\ndef load_student_program():\n    \"\"\"Imports main into test, preventing additional output and chart calls\"\"\"\n    import helpers\n    helpers.visualize_model = lambda *args, **kwargs: None\n    with contextlib.redirect_stdout(io.StringIO()):\n        import main\n    return main\n\n\nclass TestComfortPredictor(TestCase):\n    longMessage = False\n\n    def test_inputs_use_right_columns(self):\n        \"\"\"Inputs are temperature, then humidity\"\"\"\n        main = load_student_program()\n        first = main.rooms[0]\n        expected = [float(first[\"temperature_f\"]), float(first[\"humidity_pct\"])]\n        self.assertEqual(main.inputs[0], expected, \"Inputs don't use temperature, then humidity\")\n\n    def test_model_is_trained(self):\n        \"\"\"The model is trained\"\"\"\n        try:\n            check_is_fitted(load_student_program().model)\n        except NotFittedError:\n            self.fail(\"The model hasn't been trained yet\")\n\n    def test_print_accuracy(self):\n        \"\"\"Prints the model's accuracy score\"\"\"\n        output = \"\\n\".join(ValidationProtocol().get_stdout_logs())\n        self.assertRegex(output, r\"\\d\", \"Output doesn't include the accuracy score\")\n",
      "folderId": "0",
      "active": false,
      "type": "validation"
    },
