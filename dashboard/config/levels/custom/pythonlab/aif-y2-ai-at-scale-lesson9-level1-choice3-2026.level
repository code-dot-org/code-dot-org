    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "import csv\n\nfrom sklearn.linear_model import SGDClassifier\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.pipeline import make_pipeline\nfrom sklearn.preprocessing import StandardScaler\n\nfrom helpers import visualize_model\n\n# TODO 1: Open classroom.csv and read the data into a variable called rooms\nrooms = []\n\n# TODO 2: Fill in the TODOs with the column names for inputs and outputs\ninputs = [[float(room[\"TODO\"]), float(room[\"TODO\"])] for room in rooms]\noutputs = [room[\"TODO\"] for room in rooms]\n\n# Split into training and testing data\ntrain_inputs, test_inputs, train_outputs, test_outputs = train_test_split(\n    inputs,\n    outputs,\n    test_size=0.4,\n)\n\n# Configure the classifier\nmodel = make_pipeline(StandardScaler(), SGDClassifier(max_iter=1000))\n\n# TODO 3: Train the model\n\n# TODO 4: Score the model and print the accuracy score\n\n# Visualize model\nvisualize_model(model, inputs, outputs, \"Temperature\", \"Humidity\")\n",
          "folderId": "0",
          "active": true
        },
        "1": {
          "id": "1",
          "name": "classroom.csv",
          "contents": "temperature_f,humidity_pct,label\n72,23,uncomfortable\n71,53,comfortable\n86,63,uncomfortable\n69,44,comfortable\n71,58,comfortable\n77,55,comfortable\n70,56,comfortable\n71,53,comfortable\n67,30,uncomfortable\n90,37,uncomfortable\n87,74,uncomfortable\n75,37,comfortable\n73,56,comfortable\n63,16,uncomfortable\n83,18,uncomfortable\n68,56,comfortable\n72,52,comfortable\n75,34,comfortable\n81,29,uncomfortable\n73,37,comfortable\n75,46,comfortable\n68,32,comfortable\n77,46,comfortable\n73,45,comfortable\n61,85,uncomfortable\n77,33,comfortable\n75,34,comfortable\n63,65,uncomfortable\n70,51,comfortable\n85,22,uncomfortable\n76,48,comfortable\n76,55,comfortable\n85,72,uncomfortable\n72,60,comfortable\n71,41,comfortable\n66,81,uncomfortable\n73,49,comfortable\n80,10,uncomfortable\n77,53,comfortable\n61,20,uncomfortable\n85,16,uncomfortable\n78,42,uncomfortable\n89,77,uncomfortable\n71,35,comfortable\n76,86,uncomfortable\n77,53,comfortable\n67,71,uncomfortable\n81,49,uncomfortable\n68,30,comfortable\n64,83,uncomfortable\n77,45,comfortable\n68,51,comfortable\n74,35,comfortable\n74,33,comfortable\n78,82,uncomfortable\n76,40,comfortable\n88,18,uncomfortable\n75,66,uncomfortable\n74,36,comfortable\n76,51,comfortable\n69,28,uncomfortable\n71,65,uncomfortable\n76,48,comfortable\n68,33,comfortable\n80,65,uncomfortable\n75,83,uncomfortable\n84,55,uncomfortable\n63,77,uncomfortable\n73,41,comfortable\n79,30,uncomfortable\n84,68,uncomfortable\n70,46,comfortable\n67,13,uncomfortable\n77,60,comfortable\n79,25,uncomfortable\n84,22,uncomfortable\n81,24,uncomfortable\n76,58,comfortable\n72,64,uncomfortable\n71,48,comfortable\n90,24,uncomfortable\n84,53,uncomfortable\n75,13,uncomfortable\n87,61,uncomfortable\n77,38,comfortable\n74,47,comfortable\n70,32,comfortable\n77,60,comfortable\n63,20,uncomfortable\n78,64,uncomfortable\n80,81,uncomfortable\n59,87,uncomfortable\n65,80,uncomfortable\n74,35,comfortable\n65,46,uncomfortable\n74,56,comfortable\n86,39,uncomfortable\n64,57,uncomfortable\n72,38,comfortable\n72,39,comfortable\n",
