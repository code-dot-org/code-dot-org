    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from sklearn.linear_model import LinearRegression\nfrom helpers import draw_chart\n\n# The day's readings, one per hour from midnight (0) to 11 pm (23)\nhours = [[hour] for hour in range(24)]\ntemperatures = [62, 60, 58, 58, 58, 60, 62, 65, 68, 72, 76, 79,\n                82, 84, 86, 86, 86, 84, 82, 79, 76, 72, 68, 65]\n\n# This line creates a new, untrained model:\nmodel = LinearRegression()\n\n# TODO 1: Train the model on the hours and the temperatures\n\n# TODO 2: Predict and print the 3 pm and 11 pm temperatures\n\n# Draw the chart\ndraw_chart(hours, temperatures, model, \"Temperature (°F)\")\n",
          "folderId": "0",
          "active": false
        },
        "2": {
          "id": "2",
          "name": "helpers.py",
          "contents": "import matplotlib.pyplot as plt\n\n\n# Draws the day's readings as dots and, once the model is trained, its line.\ndef draw_chart(hours, readings, model, label):\n    x = [hour[0] for hour in hours]\n    plt.scatter(x, readings)\n    if hasattr(model, \"coef_\"):\n        plt.plot(x, model.predict(hours))\n    plt.xlabel(\"Hour of the day\")\n    plt.ylabel(label)\n    plt.xticks(range(0, 24, 3))\n    plt.show()\n",
          "folderId": "0",
          "active": false,
          "type": "support"
        }
      },
      "folders": {
      },
      "openFiles": [
        "0"
      ]
    },
    "validation_file": {
      "id": "1",
      "name": "validation.py",
      "contents": "import contextlib\nimport io\nimport re\nfrom unittest import TestCase\n\nfrom sklearn.exceptions import NotFittedError\nfrom sklearn.utils.validation import check_is_fitted\nfrom unittest_runner import ValidationProtocol\n\n\ndef load_student_program():\n    \"\"\"Imports main into test, preventing additional output and chart calls\"\"\"\n    import helpers\n    helpers.draw_chart = lambda *args, **kwargs: None\n    with contextlib.redirect_stdout(io.StringIO()):\n        import main\n    return main\n\n\nclass TestTemperatureModel(TestCase):\n    longMessage = False\n\n    def test_model_is_trained(self):\n        \"\"\"The model is trained\"\"\"\n        try:\n            check_is_fitted(load_student_program().model)\n        except NotFittedError:\n            self.fail(\"The model hasn't been trained yet\")\n\n    def test_print_1500(self):\n        \"\"\"Prints model's prediction for 3pm\"\"\"\n        output = \"\\n\".join(ValidationProtocol().get_stdout_logs())\n        printed = {round(float(n)) for n in re.findall(r\"-?\\d+(?:\\.\\d+)?\", output)}\n        self.assertIn(75, printed, \"Output doesn't include correct prediction for 3 pm\")\n\n    def test_print_2300(self):\n        \"\"\"Prints model's prediction for 11pm\"\"\"\n        output = \"\\n\".join(ValidationProtocol().get_stdout_logs())\n        printed = {round(float(n)) for n in re.findall(r\"-?\\d+(?:\\.\\d+)?\", output)}\n        self.assertIn(82, printed, \"Output doesn't include correct prediction for 11 pm\")\n",
      "folderId": "0",
      "active": false,
      "type": "validation"
    },
