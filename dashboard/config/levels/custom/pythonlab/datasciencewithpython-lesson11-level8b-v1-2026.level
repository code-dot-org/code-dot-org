    "display_name": "Intergalactic Travel Logs",
    "bubble_choice_description": "Practice using pandas functions to filter a dataset that contains information about a series of fictional intergalactic trips.",
    "thumbnail_url": "https://images.code.org/565f9cca41752e13b8215ddf1b38b298-space-travel.png",
    "teacher_markdown": "**Student Takeaways:**\r\n- Students learn how to filter a dataset based on multiple conditions, including non-null values, specific string patterns, and categorical attributes. \r\n- Students understand how to calculate and interpret aggregate measures such as total and median values within specific categories, which is essential for summarizing data.\r\n\r\n**Possible Misconceptions and/or Difficulties:**\r\n- Students might confuse how to properly apply string methods like str.endswith() in combination with other filtering conditions.\r\n- There might be confusion about how to calculate aggregate measures like count and mean, particularly when grouping data by a specific category such as passenger class.",
    "validation_file": {
      "id": "2",
      "name": "test.py",
      "language": "py",
      "contents": "import unittest\nimport ast\n\nclass TestIntergalacticTravelLog(unittest.TestCase):\n    def setUp(self):\n        # Set up the initial context and parse the AST of the student's code.\n        with open('main.py', 'r') as f:\n            self.tree = ast.parse(f.read())\n\n    def detect_filter_class_notnull(self):\n        \"\"\"Detects filtering for Lux class passengers with a non-null 'PassengerName'.\"\"\"\n        class_detected = False\n        notnull_detected = False\n        for node in ast.walk(self.tree):\n            if isinstance(node, ast.BoolOp) and isinstance(node.op, ast.And):\n                # Check for the combination of conditions with `and`\n                for comp in node.values:\n                    if isinstance(comp, ast.Compare):\n                        if isinstance(comp.left, ast.Subscript) and comp.left.slice.value == 'Class':\n                            if isinstance(comp.comparators[0], ast.Constant) and comp.comparators[0].value == 'Lux':\n                                class_detected = True\n                    elif isinstance(comp, ast.Call) and isinstance(comp.func, ast.Attribute):\n                        if comp.func.attr == 'notnull' and isinstance(comp.func.value, ast.Subscript):\n                            if comp.func.value.slice.value == 'PassengerName':\n                                notnull_detected = True\n                if class_detected and notnull_detected:\n                    return True\n\n            # Handle scenarios where the filtering might not be wrapped in an `and` operation\n            elif isinstance(node, ast.Compare):\n                # Check for `Class == 'Lux'` independently\n                if isinstance(node.left, ast.Subscript) and node.left.slice.value == 'Class':\n                    if isinstance(node.comparators[0], ast.Constant) and node.comparators[0].value == 'Lux':\n                        class_detected = True\n            elif isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):\n                # Check for `PassengerName.notnull()` independently\n                if node.func.attr == 'notnull' and isinstance(node.func.value, ast.Subscript):\n                    if node.func.value.slice.value == 'PassengerName':\n                        notnull_detected = True\n\n        return class_detected and notnull_detected\n\n    def detect_filter_shipname_endswith(self):\n        \"\"\"Detects filtering using str.endswith('Explorer') on the 'ShipName' column.\"\"\"\n        for node in ast.walk(self.tree):\n            if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):\n                if node.func.attr == 'endswith':\n                    if isinstance(node.func.value, ast.Attribute):\n                        if isinstance(node.func.value.value, ast.Subscript) and node.func.value.value.slice.value == 'ShipName':\n                            if isinstance(node.args[0], ast.Constant) and node.args[0].value == 'Explorer':\n                                return True\n        return False\n\n    def detect_filter_long_travels_to_pandora(self):\n        \"\"\"Detects filtering for trips to Pandora with a duration > 6000 in the year 2302.\"\"\"\n        planet_detected = False\n        duration_detected = False\n        year_detected = False\n        for node in ast.walk(self.tree):\n            # Check for comparison operations\n            if isinstance(node, ast.Compare):\n                # Check for 'Planet == Pandora'\n                if isinstance(node.left, ast.Subscript) and node.left.slice.value == 'Planet':\n                    if isinstance(node.comparators[0], ast.Constant) and node.comparators[0].value == 'Pandora':\n                        planet_detected = True\n                # Check for 'Duration > 6000'\n                elif isinstance(node.left, ast.Subscript) and node.left.slice.value == 'Duration':\n                    if isinstance(node.comparators[0], ast.Constant) and isinstance(node.ops[0], ast.Gt) and node.comparators[0].value == 6000:\n                        duration_detected = True\n\n            # Check for string methods like `endswith` on 'TravelDate'\n            elif isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):\n                if node.func.attr == 'endswith' and isinstance(node.func.value, ast.Attribute):\n                    if isinstance(node.func.value.value, ast.Subscript) and node.func.value.value.slice.value == 'TravelDate':\n                        if isinstance(node.args[0], ast.Constant) and node.args[0].value == '2302':\n                            year_detected = True\n        # Return True if all three conditions are detected\n        return planet_detected and duration_detected and year_detected\n\n    def detect_class_aggregation(self):\n        \"\"\"Detects the groupby() and agg() operations on 'Class' for 'TicketPrice'.\"\"\"\n        for node in ast.walk(self.tree):\n            if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):\n                if node.func.attr == 'agg':\n                    if isinstance(node.func.value, ast.Subscript) and isinstance(node.func.value.value, ast.Call):\n                        if isinstance(node.func.value.value.func, ast.Attribute) and node.func.value.value.func.attr == 'groupby':\n                            if isinstance(node.func.value.value.args[0], ast.Constant) and node.func.value.value.args[0].value == 'Class':\n                                if isinstance(node.args[0], ast.List):\n                                    operations = {elt.value for elt in node.args[0].elts if isinstance(elt, ast.Constant)}\n                                    if {'count', 'mean'}.issubset(operations):\n                                        return True\n        return False\n\n    def test_step_1_class_notnull_filter(self):\n        \"\"\"Filter for all Lux class passengers that have a non-null 'PassengerName'.\"\"\"\n        class_filter_detected = self.detect_filter_class_notnull()\n        self.assertTrue(class_filter_detected, \"Filter for all Lux class passengers that have a non-null 'PassengerName'.\")\n\n    def test_step_2_shipname_endswith_filter(self):\n        \"\"\"Filter for all ship names that end in 'Explorer'.\"\"\"\n        endswith_filter_detected = self.detect_filter_shipname_endswith()\n        self.assertTrue(endswith_filter_detected, \"Filter for all ship names that end in 'Explorer'.\")\n\n    def test_step_3_long_travels_to_pandora_filter(self):\n        \"\"\"Filter for all trips to Pandora with a duration of greater than 6000 that occurred in the year 2302.\"\"\"\n        pandora_filter_detected = self.detect_filter_long_travels_to_pandora()\n        self.assertTrue(pandora_filter_detected, \"Filter for all trips to Pandora with a duration of greater than 6000 that occurred in the year 2302.\")\n\n    def test_step_4_class_aggregation(self):\n        \"\"\"Calculate the count and mean 'TicketPrice' for each Class.\"\"\"\n        aggregation_detected = self.detect_class_aggregation()\n        self.assertTrue(aggregation_detected, \"Calculate the count and mean 'TicketPrice' for each Class.\")\n\nif __name__ == \"__main__\":\n    unittest.main()\n",
