          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "import pandas as pd\n\ndata = pd.read_csv(\"ocean_heat_content.csv\")\n\n# Calculate and print the overall mean\noverall_mean = data[\"Ocean Heat Content\"].mean()\nprint(\"OVERALL MEAN OCEAN HEAT CONTENT:\\n\", overall_mean)\n\n# Group the data by Decade and calculate the mean\n\n\n# Calculate the change from the 1990s to the 2010s",
          "folderId": "0",
