          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 2.12\n# Standard Description: Modify existing script to clean data.\n#\n# Rationale: In the real world, you rarely start from scratch. You will \n# often inherit \"Legacy\" code (scripts written by someone else) that \n# doesn't work perfectly. This tutorial provides a script with bugs in \n# the cleaning logic and asks students to find and fix them.\n\n\"\"\"\nWelcome to your first job as a Data Engineer! \nA co-worker wrote a script to clean some sales data, but they forgot to \nhandle a few things. The data is still messy!\n\nYour task is to \"Modify the existing script\" to make it work.\n\"\"\"\n\nimport pandas as pd\n\n# --- THE RAW MESSY DATA ---\ndata = {\n    'Item': ['Apple', 'apple', 'BANANA', '  Cherry  ', 'Date'],\n    'Price_String': ['$1.50', '$2.00', '3.50', '$0.75', 'FREE'],\n    'Quantity': [10, 5, 8, 12, 0]\n}\ndf = pd.DataFrame(data)\n\ndef broken_cleaning_script(df_input):\n    \"\"\"This script is incomplete!\"\"\"\n    df_clean = df_input.copy()\n    \n    # PROBLEM 1: The items have inconsistent capitalization and spaces\n    # TODO: Make everything lowercase and remove extra spaces\n    \n    # PROBLEM 2: The 'Price_String' column has dollar signs and words\n    # TODO: Remove the '$' sign and change 'FREE' to '0.00'\n    # TODO: Convert the whole column to a FLOAT (number)\n    \n    return df_clean\n\n# --- THE CHALLENGE ---\nprint(\"--- Data Before Cleaning ---\")\nprint(df)\n\n# We want the 'Item' column to be: ['apple', 'apple', 'banana', 'cherry', 'date']\n# We want the 'Price' column to be: [1.50, 2.00, 3.50, 0.75, 0.00]\n\n\"\"\"\n--- YOUR TURN ---\nModify the 'broken_cleaning_script' below to fix the Item and Price columns.\nWe've provided some hints to get you started!\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\ndef my_fixed_script(df_input):\n    df_clean = df_input.copy()\n    \n    # 1. Fix the Item names\n    # Hint: Use .str.lower() and .str.strip()\n    df_clean['Item'] = df_clean['Item'].str.lower().str.strip()\n    \n    # 2. Fix the Prices\n    # Hint: Use .str.replace('$', '') and .replace('FREE', '0.00')\n    # Hint: Use .astype(float) at the end!\n    \n    # TODO: Add your code here!\n    \n    return df_clean\n\n# Test your script!\n# df_final = my_fixed_script(df)\n# print(\"\\n--- Data After YOUR Cleaning ---\")\n# print(df_final)\n",
