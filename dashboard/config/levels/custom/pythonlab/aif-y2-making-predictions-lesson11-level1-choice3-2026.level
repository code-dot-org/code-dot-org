    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "import csv\n\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.neighbors import KNeighborsClassifier\nfrom sklearn.preprocessing import MinMaxScaler\n\n# Read data\nf = open(\"players.csv\")\ndata = list(csv.DictReader(f))\nf.close()\n\n# Define inputs and outputs\ninputs = []\noutputs = []\nfor row in data:\n  inputs.append([int(row[\"time\"]), int(row[\"levels\"])])\n  outputs.append(row[\"verdict\"])\n\n# Split data\ntrain_inputs, test_inputs, train_outputs, test_outputs = train_test_split(\n  inputs, outputs, test_size=0.25, random_state=42)\n\n# Scale features\nscaler = MinMaxScaler()\nscaled_train_inputs = scaler.fit_transform(train_inputs)\nscaled_test_inputs = scaler.transform(test_inputs)\n\n# Train classifier\nn_neighbors = [1, 3, 5, 7, 9, 11, 13, 15]\n\n# TODO: Use a loop to find the best hyperparameter\nmodel = KNeighborsClassifier(n_neighbors=1)\nmodel.fit(scaled_train_inputs, train_outputs)\naccuracy = model.score(scaled_test_inputs, test_outputs)\nprint(f\"n_neighbors = 1: accuracy {accuracy}\")\n",
          "folderId": "0",
          "active": true
        },
