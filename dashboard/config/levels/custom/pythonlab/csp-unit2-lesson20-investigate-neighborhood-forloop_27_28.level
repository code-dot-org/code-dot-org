      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from neighborhood import *\nset_paint(10)\n\nfor j in range(8):\n\n    if j % 2 == 0:\n        paint(\"blue\")\n    else:\n        paint(\"red\")\n    \n    if can_move(): \n      move()",
