        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "import csv\nimport random\nimport re\n\nmodel = {}\n\n\ndef tokenize(text):\n  return re.findall(r\"\\w+\", text.lower())\n\n\ndef learn(tokens):\n  return tokens\n\n\ndef predict(token):\n  return token\n\n\ndef detokenize(tokens):\n  return tokens\n\n\ndef main():\n\n  # Read data\n  f = open(\"announcements.csv\")\n  announcements = []\n  for row in csv.DictReader(f):\n    announcements.append(row[\"announcement\"])\n  f.close()\n\n  # Learn from data\n  for announcement in announcements:\n    tokens = tokenize(announcement)\n    learn(tokens)\n\n  # Get word\n  word = input(\"Word: \").lower()\n\n  # Make prediction\n  prediction = detokenize(predict(word))\n  print(f\"Prediction: {prediction}\")\n\n\nmain()",
