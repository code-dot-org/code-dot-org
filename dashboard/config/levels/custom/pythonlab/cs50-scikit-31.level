          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 6.8\n# Standard Description: Give examples for continuous, binary, categorical and ordinal data types.\n#\n# Rationale: Computers see everything as numbers, but those numbers mean \n# different things. Is the number \"1\" a price, a \"Yes\", or a \"First Place\" \n# ribbon? This tutorial uses a Pandas DataFrame to define and demonstrate \n# the four main types of data used in AI.\n\n\"\"\"\nWelcome! Not all numbers are created equal. \n1. Continuous: Any value (like 5.25 feet).\n2. Binary: Only two options (Yes/No, 0/1).\n3. Categorical: Bins with names (Apple, Orange, Banana).\n4. Ordinal: Categories with a SPECIFIC ORDER (Small, Medium, Large).\n\"\"\"\n\nimport pandas as pd\n\n# --- CREATING A MIXED DATASET ---\ndata = {\n    'Student_Name': ['Alice', 'Bob', 'Charlie', 'David'],\n    'Test_Score': [92.5, 88.0, 75.2, 98.1], # CONTINUOUS\n    'Passed': [1, 1, 0, 1],                # BINARY\n    'Favorite_Color': ['Red', 'Blue', 'Green', 'Red'], # CATEGORICAL\n    'T_Shirt_Size': ['S', 'M', 'L', 'XL']  # ORDINAL\n}\ndf = pd.DataFrame(data)\n\nprint(\"--- The Student Dataset ---\")\nprint(df)\nprint(\"\\n--- Identifying the Types ---\")\n\n# --- 1. CONTINUOUS ---\nprint(\"1. Continuous (Test_Score): Numbers that can have decimals.\")\nprint(f\"Average Score: {df['Test_Score'].mean():.2f}\")\n\n# --- 2. BINARY ---\nprint(\"\\n2. Binary (Passed): 0 or 1. True or False.\")\nprint(f\"Number of students who passed: {df['Passed'].sum()}\")\n\n# --- 3. CATEGORICAL ---\nprint(\"\\n3. Categorical (Favorite_Color): Names or Labels.\")\nprint(f\"Unique colors: {df['Favorite_Color'].unique()}\")\n\n# --- 4. ORDINAL ---\nprint(\"\\n4. Ordinal (T_Shirt_Size): Categories where order MATTERS.\")\nprint(\"Even though they are letters, we know that L is bigger than M.\")\n\n\"\"\"\n--- YOUR TURN ---\nWe have three pieces of data. Identify if they are Continuous, Binary, \nCategorical, or Ordinal.\n\nA) The temperature outside (e.g., 72.5 degrees).\nB) A star rating for a movie (1 Star, 2 Stars, 3 Stars, 4 Stars).\nC) Whether a person is a subscriber (Yes or No).\nD) A person's home state (California, Texas, New York).\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\n# TODO: Match the types!\n# Data_A = \"___\"\n# Data_B = \"___\"\n# Data_C = \"___\"\n# Data_D = \"___\"\n",
