      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from theater import *\nimport math\n\nclear(\"#CFF0FB\")\n\nchance_of_rain = 100\n\n# --- Scene Logic ---\nif chance_of_rain < 20:\n    scene = \"sunny\"\nelif chance_of_rain < 60:\n    scene = \"overcast\"\nelse:\n    scene = \"rainy\"\n\n# --- Provided: scene-drawing, do not edit ---\ndef draw_sunny_scene():\n    clear(\"#CFF0FB\")\n    cx, cy, r = 200, 150, 50\n    set_stroke_color(\"#F5B800\")\n    set_stroke_width(6)\n    for i in range(8):\n        angle = math.radians(i * 45)\n        x1 = cx + math.cos(angle) * (r + 8)\n        y1 = cy + math.sin(angle) * (r + 8)\n        x2 = cx + math.cos(angle) * (r + 38)\n        y2 = cy + math.sin(angle) * (r + 38)\n        draw_line(x1, y1, x2, y2)\n    remove_stroke_color()\n    set_fill_color(\"gold\")\n    draw_ellipse(cx - r, cy - r, r * 2, r * 2)\n    set_fill_color(\"black\")\n    draw_ellipse(cx - 18, cy - 10, 10, 10)\n    draw_ellipse(cx + 8, cy - 10, 10, 10)\n    smile = []\n    for i in range(10):\n        t = math.pi * i / 9\n        smile.append(cx + math.cos(t) * -20)\n        smile.append(cy + 10 + math.sin(t) * 15)\n    set_stroke_color(\"black\")\n    set_stroke_width(3)\n    draw_shape(smile, False)\n\ndef draw_overcast_scene():\n    clear(\"#D6D9DC\")\n    set_fill_color(\"gray\")\n    draw_ellipse(70, 140, 110, 90)\n    draw_ellipse(150, 100, 130, 110)\n    draw_ellipse(240, 140, 110, 90)\n    set_fill_color(\"black\")\n    draw_ellipse(185, 165, 12, 12)\n    draw_ellipse(213, 165, 12, 12)\n    set_stroke_color(\"black\")\n    set_stroke_width(4)\n    draw_line(195, 200, 225, 200)\n\ndef draw_rainy_scene():\n    clear(\"#8B98A1\")\n    set_fill_color(\"#101F4A\")\n    draw_ellipse(70, 110, 110, 90)\n    draw_ellipse(150, 70, 130, 110)\n    draw_ellipse(240, 110, 110, 90)\n    set_fill_color(\"white\")\n    draw_ellipse(185, 135, 12, 12)\n    draw_ellipse(213, 135, 12, 12)\n    set_stroke_color(\"white\")\n    set_stroke_width(4)\n    draw_line(195, 170, 225, 170)\n    set_fill_color(\"#FFE266\")\n    draw_shape([210,190, 185,250, 205,250, 180,320, 230,240, 207,240], True)\n    set_stroke_color(\"#4FA8D8\")\n    set_stroke_width(4)\n    draw_line(110, 210, 100, 250)\n    draw_line(140, 210, 130, 250)\n    draw_line(260, 210, 250, 250)\n    draw_line(290, 210, 280, 250)\n    remove_stroke_color()\n    set_fill_color(\"#4FA8D8\")\n    draw_ellipse(150, 340, 100, 20)\n\n# --- Provided: draws the scene, do not edit ---\nif scene == \"sunny\":\n    draw_sunny_scene()\nelif scene == \"overcast\":\n    draw_overcast_scene()\nelif scene == \"rainy\":\n    draw_rainy_scene()\n\nplay()",
