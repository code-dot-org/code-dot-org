    "validation_file": {
      "id": "1",
      "name": "test.py",
      "contents": "from unittest import TestCase\nfrom unittest_runner import ValidationProtocol\n\n\nclass TestInvestigateRandomRoll(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Read the source for comment checks, and run the program once\n        to confirm roll still falls within the expected 1-6 range.\"\"\"\n        with open(\"main.py\") as f:\n            cls.lines = f.read().splitlines()\n        cls.stdout = ValidationProtocol().get_stdout_logs()\n\n    def _comment_text(self, prefix):\n        for line in self.lines:\n            stripped = line.strip()\n            if stripped.startswith(\"#\") and stripped.lstrip(\"#\").strip().lower().startswith(prefix.lower()):\n                return stripped.lstrip(\"#\").strip()\n        return None\n\n    def test_randint_comment_completed(self):\n        \"\"\"Finishes the comment explaining what randint(1, 6) does\"\"\"\n        comment = self._comment_text(\"randint(1, 6)\")\n        self.assertIsNotNone(\n            comment,\n            \"We couldn't find the 'randint(1, 6) ...' comment. Make sure you haven't removed it.\"\n        )\n        self.assertFalse(\n            comment.rstrip().endswith(\"...\"),\n            \"Finish the comment explaining what randint(1, 6) does -- it still ends with '...'.\"\n        )\n\n    def test_print_comment_completed(self):\n        \"\"\"Finishes the comment explaining why the output can change each time\"\"\"\n        comment = self._comment_text(\"this prints\")\n        self.assertIsNotNone(\n            comment,\n            \"We couldn't find the 'This prints ...' comment. Make sure you haven't removed it.\"\n        )\n        self.assertFalse(\n            comment.rstrip().endswith(\"...\"),\n            \"Finish this comment explaining why the output can change each time you run the program -- it still ends with '...'.\"\n        )\n\n    def test_roll_still_within_expected_range(self):\n        \"\"\"roll is still generated using randint(1, 6)\"\"\"\n        self.assertTrue(\n            self.stdout,\n            \"Nothing printed. Make sure print(roll) is still there.\"\n        )\n        try:\n            value = int(self.stdout[0])\n        except (ValueError, IndexError):\n            self.fail(f\"Expected a single number to be printed, but got: {self.stdout}\")\n        self.assertTrue(\n            1 <= value <= 6,\n            f\"Expected the printed value to be between 1 and 6, but got {value}. Make sure roll is still generated with randint(1, 6).\"\n        )",
      "folderId": "0",
