          "contents": "TEST_DATA = [\n    {\"label\": \"cello\", \"frequency\": 83, \"volume\": 72, \"brightness\": 61},\n    {\"label\": \"cello\", \"frequency\": 147, \"volume\": 61, \"brightness\": 71},\n    {\"label\": \"cello\", \"frequency\": 164, \"volume\": 60, \"brightness\": 68},\n    {\"label\": \"cello\", \"frequency\": 111, \"volume\": 69, \"brightness\": 73},\n    {\"label\": \"cello\", \"frequency\": 130, \"volume\": 77, \"brightness\": 59},\n    {\"label\": \"cello\", \"frequency\": 97, \"volume\": 80, \"brightness\": 60},\n    {\"label\": \"cello\", \"frequency\": 165, \"volume\": 74, \"brightness\": 75},\n    {\"label\": \"cello\", \"frequency\": 131, \"volume\": 66, \"brightness\": 68},\n    {\"label\": \"cello\", \"frequency\": 66, \"volume\": 75, \"brightness\": 69},\n    {\"label\": \"cello\", \"frequency\": 65, \"volume\": 74, \"brightness\": 73},\n    {\"label\": \"cello\", \"frequency\": 146, \"volume\": 58, \"brightness\": 72},\n    {\"label\": \"cello\", \"frequency\": 1047, \"volume\": 64, \"brightness\": 57},\n    {\"label\": \"cello\", \"frequency\": 294, \"volume\": 78, \"brightness\": 50},\n    {\"label\": \"cello\", \"frequency\": 349, \"volume\": 57, \"brightness\": 37},\n    {\"label\": \"cello\", \"frequency\": 587, \"volume\": 76, \"brightness\": 44},\n    {\"label\": \"cello\", \"frequency\": 523, \"volume\": 77, \"brightness\": 53},\n    {\"label\": \"cello\", \"frequency\": 393, \"volume\": 65, \"brightness\": 49},\n    {\"label\": \"cello\", \"frequency\": 441, \"volume\": 84, \"brightness\": 47},\n    {\"label\": \"cello\", \"frequency\": 1319, \"volume\": 56, \"brightness\": 46},\n    {\"label\": \"cello\", \"frequency\": 524, \"volume\": 67, \"brightness\": 49},\n    {\"label\": \"cello\", \"frequency\": 440, \"volume\": 75, \"brightness\": 40},\n    {\"label\": \"cello\", \"frequency\": 261, \"volume\": 71, \"brightness\": 38},\n    {\"label\": \"cello\", \"frequency\": 880, \"volume\": 62, \"brightness\": 36},\n    {\"la