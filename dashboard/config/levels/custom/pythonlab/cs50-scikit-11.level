          "id": "0",
          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 6.1\n# Standard Description: Define a cost function, given the outcome, to train a neural network.\n#\n# Rationale: A Neural Network learns by trying to minimize its \"Cost\" (also called \n# \"Loss\"). Think of a cost function as a teacher's red pen: it marks how far off \n# the student's answer was. This tutorial uses a Multi-layer Perceptron (MLP) \n# and plots its \"Loss Curve\" to show how the cost function guides the learning.\n\n\"\"\"\nWelcome! Today we are looking inside the \"brain\" of a Neural Network.\nHow does a computer know it's getting smarter? It uses a Cost Function.\n\nA Cost Function is a math formula that calculates one number: \n\"How much did I mess up?\"\n- High Cost = The AI is guessing wildly.\n- Low Cost = The AI is getting very close to the truth.\n\nWe will watch the AI look at its \"Cost\" and try to make it smaller!\n\"\"\"\n\nfrom sklearn.neural_network import MLPClassifier\nfrom sklearn.datasets import make_moons\nimport matplotlib.pyplot as plt\n\n# --- PREPARING DATA ---\n# We'll use the \"Moons\" dataset again because it requires a \"smart\" brain to solve.\nX, y = make_moons(n_samples=500, noise=0.2, random_state=42)\n\n# --- THE NEURAL NETWORK ---\nprint(\"--- Training the Neural Network ---\")\n\n# We create a Multi-layer Perceptron (MLP).\n# 'max_iter=1' means we will train it one step at a time so we can see the cost.\n# 'warm_start=True' lets us keep training the same brain instead of starting over.\nnn = MLPClassifier(hidden_layer_sizes=(10, 10), \n                    max_iter=1, \n                    warm_start=True, \n                    solver='sgd', \n                    learning_rate_init=0.01,\n                    random_state=42)\n\ncosts = []\n\n# We will \"loop\" through training 100 times to watch the cost change.\nfor i in range(100):\n    nn.fit(X, y)\n    # The 'loss_' attribute is the result of the Cost Function for this step!\n    costs.append(nn.loss_)\n    \n    if i % 10 == 0:\n        print(f\"Step {i}: The Cost is {nn.loss_:.4f}\")\n\n# --- VISUALIZATION ---\nplt.figure(figsize=(10, 5))\n\n# Plot the Loss Curve\nplt.subplot(1, 2, 1)\nplt.plot(costs, color='red', linewidth=2)\nplt.title(\"The Cost Function in Action\")\nplt.xlabel(\"Training Steps (Epochs)\")\nplt.ylabel(\"Cost (Error Score)\")\nplt.grid(True, alpha=0.3)\n\n# Plot the Decision Boundary\nimport numpy as np\nplt.subplot(1, 2, 2)\nh = .02\nx_min, x_max = X[:, 0].min() - .5, X[:, 0].max() + .5\ny_min, y_max = X[:, 1].min() - .5, X[:, 1].max() + .5\nxx, yy = np.meshgrid(np.arange(x_min, x_max, h), np.arange(y_min, y_max, h))\nZ = nn.predict(np.c_[xx.ravel(), yy.ravel()])\nZ = Z.reshape(xx.shape)\nplt.contourf(xx, yy, Z, alpha=0.8, cmap='coolwarm')\nplt.scatter(X[:, 0], X[:, 1], c=y, edgecolors='k', cmap='coolwarm')\nplt.title(\"The Final 'Brain' Results\")\n\nplt.tight_layout()\nprint(\"\\nLook at the graph! As the red line (Cost) goes down, the AI gets smarter.\")\nplt.show()\n\n\"\"\"\n--- YOUR TURN ---\nThe \"Learning Rate\" determines how much the AI listens to the Cost Function.\n- If it's too high, the AI overreacts and the cost might jump around.\n- If it's too low, the AI learns too slowly.\n\n1. We've set a learning rate of 0.01.\n2. Try changing it to 0.0001 (very slow) and look at the graph.\n3. Try changing it to 0.5 (very fast) and see if the cost curve gets \"shaky\".\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\n# TODO: Experiment with 'learning_rate_init'\n# my_nn = MLPClassifier(hidden_layer_sizes=(10, 10), learning_rate_init=0.01)\n",
          "folderId": "0",
