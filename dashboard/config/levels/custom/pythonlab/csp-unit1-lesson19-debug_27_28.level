M\n17R2e+eiKM8TmOnR7pc08cmkTM2Vvkd7h6I6NuX05E4CwnZPk13xQmVKbBBC\ndx5tV8HBll3ThhWy2bVpippL+lmGVS7/oydvIJPFMHd1/GQNrI/VXVJ6B/2O\ngmshE0XqUqINt9hdlYdmrLg8prMRTvNsFpMQ+AM36W8Kbvp7eSmOVl6NFJYR\n6xd914jjaUG7Phe5Q4/I2U7rIFnLyJre5O+Sm+YGTvUFN9s+5+2MJhEABdII\nJvJ79OV723U29eez16nsAwf8VV86FPm4Zj/rgy3SH3n+002hZbbHew+vNrJt\nkiTG26Z3TH3pHbduQ/ZQ5fGzcx3dFYYyByHktvGBqeWus+SUKpX3gQjCEMeB\nMY6+JmelwiZ47vZLadxxigpNf1q3dNxbeazUUjlD9SLUJ5UDx5YEkssYxj+r\nxIfWQhW6BYElg/qwEjT0niQMpmYnqBX4RNG6yvLPkmIS3tNByDk044KK2wg2\nkrzlkDzlUSSolJOjg5tLMejuSSe8fjBVd7m7UHbGozp/LhAvCB1JUfS5kSBV\nDZoM8VmyBOUMto2t8wBGBpnAIm/SavboutQB\n",
    "thumbnail_url": "https://images.code.org/73e19868c3beebfc3ac90e7f6a3f5da7-Screenshot 2026-08-26 101623.png",
    "display_name": "Down the Second Street",
    "bubble_choice_description": "Modify the program so the painter finishes painting the street to the traffic cone, going around the row of benches and down the second street.",
    "validation_file": {
      "id": "2",
      "name": "test.py",
      "contents": "from unittest import TestCase\nfrom unittest_runner import ValidationProtocol\n\n\nclass TestDebugPathToCone(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Run the student's code once and save the results\"\"\"\n        cls.painter = None\n        cls.run_error = None\n        try:\n            log = ValidationProtocol().get_neighborhood_log()\n            cls.painter = log.painter_logs[0] if log.painter_logs else None\n        except Exception as e:\n            cls.run_error = e\n\n    def setUp(self):\n        if self.run_error is not None:\n            self.skipTest(f\"Your program raised an error while running: {self.run_error}.\")\n        if self.painter is None:\n            self.skipTest(\"No painter actions found yet. Make sure your program runs without errors.\")\n\n    def _relevant_events(self):\n        \"\"\"paint() auto-logs a HAS_PAINT check right before it fires, even\n        though the student's code never calls has_paint(). Filter those\n        out so pairing/grouping checks reflect only what the student wrote.\"\"\"\n        all_events = [e.neighborhood_action_type for e in self.painter.get_events()]\n        return [a for a in all_events if a != \"HAS_PAINT\"]\n\n    def _turn_group_sizes(self):\n        \"\"\"Returns the size of each consecutive run of TURN_LEFT actions,\n        in order (e.g. three turn_left() in a row, then later two more,\n        shows up as [3, 2]).\"\"\"\n        events = self._relevant_events()\n        groups = []\n        current_run = 0\n        for action in events:\n            if action == \"TURN_LEFT\":\n                current_run += 1\n            else:\n                if current_run:\n                    groups.append(current_run)\n                current_run = 0\n        if current_run:\n            groups.append(current_run)\n        return groups\n\n    def test_turn_groups_match_corrected_path(self):\n        \"\"\"The painter's turns match the corrected path to the cone\"\"\"\n        self.assertEqual(\n            self._turn_group_sizes(),\n            [3, 1, 3, 3],\n            \"The pattern of turns doesn't match the fixed path yet. Compare where your painter ends up to where \"\n            \"the traffic cone is, then trace back through the turn_left() groups to find the one that's turning \"\n            \"the wrong amount.\"\n        )\n\n    def test_paints_after_every_move(self):\n        \"\"\"Paints after every move(), all the way through the path\"\"\"\n        events = self._relevant_events()\n        move_indices = [i for i, a in enumerate(events) if a == \"MOVE\"]\n        unpainted_moves = [\n            i for i in move_indices\n            if i + 1 >= len(events) or events[i + 1] != \"PAINT\"\n        ]\n        self.assertFalse(\n            unpainted_moves,\n            f\"Found {len(unpainted_moves)} move() call(s) not immediately followed by a paint() call.\"\n        )",
      "folderId": "0",
      "active": false,
      "type": "validation"
    }
  },
