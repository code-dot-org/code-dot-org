    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "def ask(question):\n    while True:\n        answer = input(f\"{question} (yes, no): \")\n        if answer.lower() == \"yes\":\n            return True\n        elif answer.lower() == \"no\":\n            return False\n        else:\n            print(\"Try again!\")\n\n\ndef main():\n    if ask(\"Are you at a traffic light?\"):\n        if ask(\"Is the traffic light red?\"):\n            print(\"Stop!\")\n        else:\n            print(\"Go!\")\n    else:\n        print(\"Go!\")\n\n\nmain()",
