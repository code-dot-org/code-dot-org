        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "def decide(fever, cough):\n    if fever:\n        if cough:\n            return \"Visit clinic\"\n        else:\n            return \"Get rest\"\n    else:\n        if cough:\n            return \"Take cough medicine\"\n        else:\n            return \"Hydrate\"\n\n\ndef main():\n    fever = False\n    cough = True\n    decision = decide(fever, cough)\n    print(f\"You might need to: {decision}\")\n\n\nmain()\n",
