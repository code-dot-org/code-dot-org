    "teacher_markdown": "Expected trace: \r\n\r\nPrints 0, 1, 2, 3, 4 — five passes. \r\n\r\n`count` is 5 when the loop exits, since the condition is checked one more time after the last update and found False.",
    "validation_file": {
      "id": "1",
      "name": "test.py",
      "contents": "from unittest import TestCase\nfrom unittest_runner import ValidationProtocol\n\n\nclass TestInvestigateTrace(TestCase):\n    @classmethod\n    def setUpClass(cls):\n        \"\"\"Run the student's code once and save the results\"\"\"\n        cls.stdout = ValidationProtocol().get_stdout_logs()\n        cls.condition_lines = [line for line in cls.stdout if \"True\" in line or \"False\" in line]\n\n    def test_prints_condition_each_pass(self):\n        \"\"\"Prints True or False for count < 5 every time through the loop\"\"\"\n        if not self.condition_lines:\n            self.skipTest(\"We didn't find True or False printed anywhere. Add a print statement inside the loop that shows the result of count < 5.\")\n\n        self.assertEqual(\n            len(self.condition_lines),\n            5,\n            f\"The loop runs 5 times, so we expected to see the condition's result printed 5 times — we found it {len(self.condition_lines)} time(s). Make sure your print statement is inside the loop, not after it.\"\n        )\n\n        results = [\"True\" in line for line in self.condition_lines]\n        # Valid depending on where the print sits relative to the increment:\n        #   before incrementing count: True, True, True, True, True\n        #   after incrementing count:  True, True, True, True, False\n        valid_patterns = [\n            [True, True, True, True, True],\n            [True, True, True, True, False],\n        ]\n        self.assertIn(\n            results,\n            valid_patterns,\n            \"The pattern of True/False values doesn't match what count < 5 should actually produce. Double-check your print statement is checking count < 5, and that it's positioned consistently relative to count = count + 1.\"\n        )",
      "folderId": "0",
