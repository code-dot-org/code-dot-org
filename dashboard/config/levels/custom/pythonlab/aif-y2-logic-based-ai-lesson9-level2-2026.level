          "name": "main.py",
          "contents": "position = \"5\"\n    \nprint(f\"📍 Currently at: {position}\")\n\n# Move right\nposition = position + 1\nprint(f\"📍 Currently at: {position}\")\n\n# Move right\nposition = position + 1\nprint(f\"📍 Currently at: {position}\")\n\n# Move left\nposition = position - 1\nprint(f\"📍 Currently at: {position}\")",
