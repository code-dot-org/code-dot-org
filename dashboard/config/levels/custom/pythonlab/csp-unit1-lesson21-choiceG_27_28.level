        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "# Birthday Cake — original by Mx. Chen\nfrom theater import *\n\nclear(\"#FFF3E0\")\n\n# Cake and frosting\nset_fill_color(\"#8D6E63\")\ndraw_rectangle(70, 260, 260, 100)\nset_fill_color(\"pink\")\ndraw_rectangle(70, 240, 260, 30)\n\n# Candles, each with a flame\nfor j in range(6):\n    set_fill_color(\"aqua\")\n    draw_rectangle(j * 44 + 90, 190, 10, 50)\n    set_fill_color(\"orange\")\n    draw_ellipse(j * 44 + 88, 170, 14, 20)\n    pause(0.1)\nplay()",
