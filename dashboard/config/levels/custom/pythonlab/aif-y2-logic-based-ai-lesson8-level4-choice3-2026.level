          "id": "0",
          "name": "main.py",
          "contents": "def simulate(cfu, growth, target):\n    hours = 0\n    print(f\"Hour {hours}: {cfu} CFU\")\n\n    while cfu < target:\n        cfu += cfu * growth\n        hours += 1\n        print(f\"Hour {hours}: {cfu} CFU\")\n\n\nsimulate(100, 7, 100000)",
