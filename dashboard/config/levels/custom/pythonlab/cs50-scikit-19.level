          "name": "main.py",
          "language": "py",
          "contents": "# CIW AI Associate Standard: 2.11\n# Standard Description: Identify univariate and multivariate outliers in a dataset.\n#\n# Rationale: An outlier is a data point that is \"weird\" or doesn't fit the pattern. \n# - Univariate: An outlier in ONE column (e.g., a student who is 12 feet tall).\n# - Multivariate: An outlier that only looks weird when you look at TWO columns \n#   (e.g., a student who is 3 feet tall but weighs 500 lbs).\n# This tutorial uses Box Plots and Isolation Forests to find them.\n\n\"\"\"\nWelcome! Imagine you are looking at a line of 100 people. \nIf one person is 8 feet tall, they are an OUTLIER. \n\nBut sometimes, a point is only an outlier when you combine facts. \nIf someone is 4 years old, that's normal. If someone has a PhD, that's normal. \nBut a 4-year-old WITH a PhD? That's a multivariate outlier!\n\"\"\"\n\nimport pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom sklearn.ensemble import IsolationForest\n\n# --- PART 1: UNIVARIATE OUTLIERS (One Column) ---\nprint(\"--- Part 1: Finding Outliers in One Column ---\")\n# Let's look at a list of test scores (0-100). \n# Notice the '999'—that's probably a typo!\nscores = [85, 92, 78, 88, 95, 82, 999, 90, 87, 84]\ndf_uni = pd.DataFrame({'Score': scores})\n\n# We visualize this with a Box Plot\nplt.figure(figsize=(10, 5))\nplt.subplot(1, 2, 1)\nplt.boxplot(df_uni['Score'])\nplt.title(\"Univariate: Spot the Typo!\")\nplt.ylabel(\"Test Score\")\n\n# --- PART 2: MULTIVARIATE OUTLIERS (Two+ Columns) ---\nprint(\"--- Part 2: Finding Outliers in Multiple Columns ---\")\n# We'll create data for Height and Weight.\n# Most points follow a pattern, but one point is a 4ft tall, 300lb person.\nheights = [60, 62, 65, 68, 70, 72, 48] \nweights = [120, 130, 150, 165, 180, 200, 300]\nX = pd.DataFrame({'Height': heights, 'Weight': weights})\n\n# We use an \"Isolation Forest\" to find multivariate outliers.\n# It works by \"isolating\" points that are in lonely areas of the graph.\niso = IsolationForest(contamination=0.15, random_state=42)\noutlier_labels = iso.fit_predict(X) # -1 means Outlier, 1 means Normal\n\nplt.subplot(1, 2, 2)\n# Color points by whether they are outliers\nplt.scatter(X['Height'], X['Weight'], c=outlier_labels, cmap='RdYlGn', edgecolors='k')\nplt.title(\"Multivariate: Spot the Weird Combo!\")\nplt.xlabel(\"Height\")\nplt.ylabel(\"Weight\")\n\nplt.tight_layout()\nplt.show()\n\nprint(\"In the scatter plot, the RED point is the outlier.\")\nprint(\"Even if 48 inches is a normal height and 300 lbs is a normal weight,\")\nprint(\"the COMBINATION is what makes it an outlier.\")\n\n\"\"\"\n--- YOUR TURN ---\nWe have a dataset of \"Bank Transactions\". \nOne person spent $5,000 on a Tuesday at 3:00 AM. \n\n1. Use the Isolation Forest logic to detect if that transaction is an outlier.\n2. We've provided the data for you below.\n\"\"\"\n\n# STARTING CODE FOR STUDENT:\n# Transaction Features: [Amount ($), Hour of Day (0-23)]\ntransactions = [\n    [20, 12], [15, 14], [50, 18], [10, 9], [30, 13], [5000, 3]\n]\nX_bank = pd.DataFrame(transactions, columns=['Amount', 'Hour'])\n\n# TODO: Create the IsolationForest\n# TODO: Use fit_predict(X_bank) to get labels\n# TODO: Print the labels! (Look for the -1)\n",
          "folderId": "0",
