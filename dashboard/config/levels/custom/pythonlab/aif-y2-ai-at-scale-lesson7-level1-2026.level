    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "from sklearn.linear_model import SGDClassifier\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.pipeline import make_pipeline\n\n# Recyclable items [weight (ounces), transparency (0-10)]\ninputs = [[0.4, 0], [1.0, 0], [0.3, 0], [1.5, 0],\n          [3, 5], [14, 6], [10, 4], [10, 2],\n          [2, 5], [3, 4], [0.5, 9], [2, 7]]\n\n# The bin each item belongs in\noutputs = [\"Aluminum\", \"Aluminum\", \"Aluminum\", \"Aluminum\",\n           \"Glass\", \"Glass\", \"Glass\", \"Glass\",\n           \"Plastic\", \"Plastic\", \"Plastic\", \"Plastic\"]\n\nmodel = make_pipeline(StandardScaler(), SGDClassifier())\n\n# Three new items the network has never seen: [weight (ounces), transparency (0-10)]\nred_can = [0.5, 0]  # Correct bin: aluminum\ngreen_bottle = [10, 6]  # Correct bin: glass\nsmall_jar = [4, 8]  # Correct bin: glass\n\n# TODO 1: Train the network on the training data\n\n# TODO 2: Predict and print the bin for the red can, green bottle, and small jar\n",
          "folderId": "0",
          "active": false
        }
      },
      "folders": {
      },
      "openFiles": [
        "0"
      ]
    },
    "validation_file": {
      "id": "1",
      "name": "validation.py",
      "contents": "import contextlib\nimport io\nimport re\nfrom unittest import TestCase\n\nfrom sklearn.exceptions import NotFittedError\nfrom sklearn.utils.validation import check_is_fitted\nfrom unittest_runner import ValidationProtocol\n\n\ndef load_student_program():\n    \"\"\"Imports main into test, preventing additional output\"\"\"\n    with contextlib.redirect_stdout(io.StringIO()):\n        import main\n    return main\n\n\nclass TestSortingNetwork(TestCase):\n    longMessage = False\n\n    def test_model_is_trained(self):\n        \"\"\"The network is trained\"\"\"\n        try:\n            check_is_fitted(load_student_program().model)\n        except NotFittedError:\n            self.fail(\"The network hasn't been trained yet\")\n\n    def test_print_three_predictions(self):\n        \"\"\"Prints network's predictions for all three items\"\"\"\n        output = \"\\n\".join(ValidationProtocol().get_stdout_logs()).lower()\n        bins = re.findall(r\"aluminum|glass|plastic\", output)\n        self.assertGreaterEqual(len(bins), 3, \"Output doesn't include a prediction for all three items\")\n",
      "folderId": "0",
      "active": false,
      "type": "validation"
    },
