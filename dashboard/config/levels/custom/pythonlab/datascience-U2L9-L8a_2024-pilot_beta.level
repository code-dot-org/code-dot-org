    "display_name": "Hurricane Maria",
    "bubble_choice_description": "Practice using pandas functions to identify key temperature statistics and uncover initial insights.",
    "thumbnail_url": "https://images.code.org/6e7efa33cd1b673c12742673565104db-hurricane.png",
    "teacher_markdown": "**What Students Should Take Away:**\r\n- Students practice using the min() and max() functions to identify key temperature extremes in the dataset.\r\n- Students learn how to apply the sum() function to calculate total sea surface temperatures, helping them understand cumulative changes.\r\n- Students reinforce their skills in using the agg() function combined with groupby() to summarize data, providing insights into overall trends.\r\n\r\n**Misconceptions Students Might Have or Points They Might Struggle With and Tips to Assist:**\r\n- Students might think that only one statistic (e.g., mean) is important, neglecting the significance of other statistics.\r\n  - Tip: Encourage students to consider how each statistic offers a different perspective. For instance, the mean shows overall trends, while min and max highlight extremes.\r\n- Students may have difficulty interpreting how temperature changes relate to the progression of the hurricane.\r\n  - Tip: Guide students to think about how rising or falling temperatures could indicate changes in the hurricane's intensity. Use guiding questions to help them connect the data to real-world events.",
    "validation_file": {
      "id": "2",
      "name": "test.py",
      "language": "py",
      "contents": "import unittest\nimport ast\n\nclass TestSeaSurfaceTemperature(unittest.TestCase):\n    def setUp(self):\n        # Set up the initial context and parse the AST of the student's code.\n        with open('main.py', 'r') as f:\n            self.tree = ast.parse(f.read())\n\n    def detect_min_max_sum(self, column_name):\n        \"\"\"Detects min(), max(), and sum() calls on a specific DataFrame column.\"\"\"\n        min_detected = False\n        max_detected = False\n        sum_detected = False\n\n        for node in ast.walk(self.tree):\n            # Look for function calls like `data['ANALYSED_SST'].min()`\n            if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):\n                # Check if it's a min, max, or sum function\n                if node.func.attr in {'min', 'max', 'sum'}:\n                    if isinstance(node.func.value, ast.Subscript):\n                        # Ensure it's applied to the correct column in the DataFrame\n                        if isinstance(node.func.value.value, ast.Name) and node.func.value.value.id == 'data':\n                            if isinstance(node.func.value.slice, ast.Constant) and node.func.value.slice.value == column_name:\n                                if node.func.attr == 'min':\n                                    min_detected = True\n                                elif node.func.attr == 'max':\n                                    max_detected = True\n                                elif node.func.attr == 'sum':\n                                    sum_detected = True\n        return min_detected, max_detected, sum_detected\n\n    def detect_agg_function(self, column_name):\n        \"\"\"Detect if the agg() function is used with specific operations on a grouped DataFrame column.\"\"\"\n        for node in ast.walk(self.tree):\n            if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):\n                if node.func.attr == 'agg':\n                    # Check if agg is applied on a groupby operation\n                    if isinstance(node.func.value, ast.Subscript):\n                        if isinstance(node.func.value.value, ast.Call) and isinstance(node.func.value.value.func, ast.Attribute):\n                            if node.func.value.value.func.attr == 'groupby':\n                                # Check that the groupby is applied to the correct column\n                                if isinstance(node.func.value.value.args[0], ast.Constant) and node.func.value.value.args[0].value == 'DATETIME':\n                                    # Ensure the aggregation operations are ['sum', 'mean', 'min', 'max']\n                                    if isinstance(node.args[0], ast.List):\n                                        operations = {elt.value for elt in node.args[0].elts if isinstance(elt, ast.Constant)}\n                                        if {'sum', 'mean', 'min', 'max'}.issubset(operations):\n                                            return True\n        return False\n\n    def test_a_min_max_sum_on_sea_surface_temperature(self):\n        \"\"\"Use min(), max(), and sum() to identify the minimum, maximum, and total sea surface temperatures.\"\"\"\n        min_detected, max_detected, sum_detected = self.detect_min_max_sum('ANALYSED_SST')\n\n        # Debug information for identifying what was or wasn't detected\n        print(f\"Min Detected: {min_detected}, Max Detected: {max_detected}, Sum Detected: {sum_detected}\")\n\n        # Check that all three functions are detected\n        self.assertTrue(min_detected, \"The code should use min() to identify the minimum sea surface temperature in 'ANALYSED_SST'.\")\n        self.assertTrue(max_detected, \"The code should use max() to identify the maximum sea surface temperature in 'ANALYSED_SST'.\")\n        self.assertTrue(sum_detected, \"The code should use sum() to calculate the total sea surface temperature in 'ANALYSED_SST'.\")\n\n    def test_b_agg_on_sea_surface_temperature(self):\n        \"\"\"Use the agg() function to calculate the total, average, minimum, and maximum sea surface temperatures for each date.\"\"\"\n        agg_detected = self.detect_agg_function('ANALYSED_SST')\n\n        # Debug information for identifying if agg was correctly detected\n        print(f\"agg() Detected: {agg_detected}\")\n\n        # Check that the agg() function is used correctly\n        self.assertTrue(agg_detected, \"The code should use the agg() function to calculate total, average, minimum, and maximum sea surface temperatures for each date.\")\n\nif __name__ == \"__main__\":\n    unittest.main()\n",
