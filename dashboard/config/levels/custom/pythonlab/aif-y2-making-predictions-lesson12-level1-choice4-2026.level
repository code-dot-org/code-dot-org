      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "import csv\n\nimport matplotlib.pyplot as plt\n\n# Data\nwith open(\"surgery.csv\") as f:\n  data = list(csv.DictReader(f))\n\ngroups = [(\"yes\", \"Emergency\"), (\"no\", \"Non-Emergency\")]\n\n# Styling\nplt.rcParams.update({\"font.size\": 11, \"figure.dpi\": 140})\nstyles = {\n  \"healed\": {\n    \"marker\": \"o\",\n    \"color\": \"#0072B2\",\n    \"size\": 45,\n    \"label\": \"Healed\"\n  },\n  \"infected\": {\n    \"marker\": \"^\",\n    \"color\": \"#E69F00\",\n    \"size\": 90,\n    \"label\": \"Infected\"\n  },\n}\n\n# Plotting\nfigure, axes_list = plt.subplots(\n  2,\n  1,\n  figsize=(6, 9),\n  sharex=True,\n  sharey=True\n)\n\nfor axes, (value, heading) in zip(axes_list, groups):\n  subset = [row for row in data if row[\"emergency\"] == value]\n\n  for outcome in [\"healed\", \"infected\"]:\n    style = styles[outcome]\n    x = [float(row[\"length\"]) for row in subset if row[\"outcome\"] == outcome]\n    y = [float(row[\"glucose\"]) for row in subset if row[\"outcome\"] == outcome]\n    axes.scatter(\n      x,\n      y,\n      marker=style[\"marker\"],\n      color=style[\"color\"],\n      s=style[\"size\"],\n      edgecolors=\"black\",\n      linewidths=0.5,\n      label=f\"{style['label']} (n={len(x)})\",\n    )\n\n  axes.set_title(f\"{heading} (n={len(subset)})\")\n  axes.set_ylabel(\"Blood Glucose (mg/dL)\")\n  axes.legend(loc=\"upper left\", fontsize=9)\n  axes.grid(True, linestyle=\":\", alpha=0.6)\n\naxes_list[-1].set_xlabel(\"Operation Length (minutes)\")\n\nfigure.suptitle(\"Post-Surgery Healing\")\nfigure.tight_layout()\nplt.show()\n",
          "folderId": "0",
          "active": true
        },
