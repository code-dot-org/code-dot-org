    "start_sources": {
      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "import csv\n\nfrom sklearn.linear_model import SGDClassifier\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.pipeline import make_pipeline\nfrom sklearn.preprocessing import StandardScaler\n\nfrom helpers import visualize_model\n\n# TODO 1: Open food_truck.csv and read the data into a variable called hours\nhours = []\n\n# TODO 2: Fill in the TODOs with the column names for inputs and outputs\ninputs = [[float(hour[\"TODO\"]), float(hour[\"TODO\"])] for hour in hours]\noutputs = [hour[\"TODO\"] for hour in hours]\n\n# Split into training and testing data\ntrain_inputs, test_inputs, train_outputs, test_outputs = train_test_split(\n    inputs,\n    outputs,\n    test_size=0.4,\n)\n\n# Configure the classifier\nmodel = make_pipeline(StandardScaler(), SGDClassifier(max_iter=1000))\n\n# TODO 3: Train the model\n\n# TODO 4: Score the model and print the accuracy score\n\n# Visualize model\nvisualize_model(model, inputs, outputs, \"Hour of day\", \"Day of week\")\n",
          "folderId": "0",
          "active": true
        },
        "1": {
          "id": "1",
          "name": "food_truck.csv",
          "contents": "hour_of_day,day_of_week,label\n11,7,busy\n17,1,busy\n22,1,slow\n22,4,slow\n8,1,slow\n15,5,slow\n17,7,busy\n11,7,busy\n18,4,busy\n14,4,slow\n13,6,busy\n16,1,slow\n10,5,slow\n14,5,slow\n22,2,slow\n8,2,slow\n14,6,busy\n18,1,busy\n20,3,slow\n11,2,busy\n12,6,busy\n19,5,busy\n22,4,slow\n19,6,busy\n20,7,busy\n16,2,slow\n22,7,slow\n22,7,slow\n14,5,slow\n11,2,busy\n9,6,slow\n22,6,slow\n8,1,slow\n17,1,busy\n15,5,slow\n21,3,slow\n18,2,busy\n19,1,busy\n14,3,slow\n7,6,slow\n22,6,slow\n21,5,slow\n22,2,slow\n14,6,busy\n11,6,busy\n20,1,slow\n14,7,busy\n20,1,slow\n16,4,slow\n17,5,busy\n14,6,busy\n8,5,slow\n19,1,busy\n8,5,slow\n8,7,slow\n17,2,busy\n9,7,slow\n22,3,slow\n19,1,busy\n13,4,busy\n10,5,slow\n19,5,busy\n17,3,busy\n7,4,slow\n7,2,slow\n19,7,busy\n13,5,busy\n12,1,busy\n22,1,slow\n8,2,slow\n10,6,busy\n9,3,slow\n12,1,busy\n19,4,busy\n13,7,busy\n20,6,busy\n18,3,busy\n13,5,busy\n17,2,busy\n17,4,busy\n18,3,busy\n11,7,busy\n12,6,busy\n9,5,slow\n15,7,slow\n14,1,slow\n17,3,busy\n15,3,slow\n10,7,busy\n7,5,slow\n11,1,busy\n15,5,slow\n19,4,busy\n13,5,busy\n10,4,slow\n7,5,slow\n11,1,busy\n8,7,slow\n18,3,busy\n21,5,slow\n",
          "folderId": "0",
