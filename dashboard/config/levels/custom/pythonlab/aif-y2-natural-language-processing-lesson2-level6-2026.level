          "name": "main.py",
          "contents": "import re\n\ntext = \"Our home galaxy is called the Milky Way. \\\nIt's a spiral galaxy with a disk of stars spanning \\\nmore than 100,000 light-years.\"\n\n\ndef tokenize(text):\n  return re.findall(r\"\", text)\n\n\ntokens = tokenize(text)\nprint(tokens)\n",
