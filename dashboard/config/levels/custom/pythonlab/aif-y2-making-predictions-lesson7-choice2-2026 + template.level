          "id": "0",
          "name": "main.py",
          "contents": "from sklearn.model_selection import train_test_split\nfrom sklearn.neighbors import KNeighborsClassifier\n\n# Input features: [canvas_age (years), pigment_match (%), brushstroke_similarity (%), crack_density (cracks/cm^2)]\ninputs = [\n  [372, 96, 91, 11],\n  [24, 38, 71, 1],\n  [361, 90, 58, 10],\n  [358, 94, 88, 12],\n  [348, 38, 68, 3],\n  [377, 93, 52, 11],\n  [381, 97, 93, 10],\n  [41, 31, 66, 2],\n  [354, 88, 63, 9],\n  [365, 92, 86, 13],\n  [362, 44, 74, 2],\n  [369, 91, 47, 12],\n  [349, 95, 90, 9],\n  [339, 36, 70, 1],\n  [346, 89, 55, 8]\n]\n\noutputs = [\n  \"authentic\",\n  \"forgery\",\n  \"workshop copy\",\n  \"authentic\",\n  \"forgery\",\n  \"workshop copy\",\n  \"authentic\",\n  \"forgery\",\n  \"workshop copy\",\n  \"authentic\",\n  \"forgery\",\n  \"workshop copy\",\n  \"authentic\",\n  \"forgery\",\n  \"workshop copy\"\n]\n\n# Split into training and testing data\ntrain_inputs, test_inputs, train_outputs, test_outputs = train_test_split(\n  inputs,\n  outputs,\n  test_size=0.4,\n)\n\n# TODO 1: Configure the classifier using KNeighborsClassifier\n# TODO 2: Train the model with model.fit\n\n# TODO 3: Compute the accuracy using model.score() and print it out\n# TODO 4: Classify a new, unknown painting that just arrived at the gallery for appraisal\nunknown_painting = [[355, 42, 72, 2]]",
