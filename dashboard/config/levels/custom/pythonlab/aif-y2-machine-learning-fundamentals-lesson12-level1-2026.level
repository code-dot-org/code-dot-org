      "files": {
        "0": {
          "id": "0",
          "name": "main.py",
          "contents": "\"\"\"\nAvailable characteristics to try:\n  \"calories\"\n  \"shelf_life\"\n  \"price\"\n  \"allergen_count\"\n  \"spice\"\n  \"protein\"\n\"\"\"\n\nfrom helpers import testing_data, train_model, training_data, visualize_model\n\n# TODO: Replace the second parameter with the characteristic name that you want to build a model for. Test out a few different characteristics.\npredict_top_snacks = train_model(training_data, \"price\")\n\n# Predict ratings for the test snacks\npredictions = predict_top_snacks(testing_data)\n\n# Print the top 5 predicted snacks\nprint(\"\\nTop 5 snacks by predicted rating:\")\nfor i in range(5):\n  print(predictions[i])\n\n# Show the regression graph\nvisualize_model(predict_top_snacks)\n",
          "folderId": "0",
          "active": true
        },
        "1": {
          "id": "1",
          "name": "helpers.py",
          "contents": "import matplotlib.pyplot as plt\nfrom sklearn.linear_model import LinearRegression\n\nTARGET_COLUMN = \"rating\"\nNAME_COLUMN = \"name\"\n\ntraining_data = [\n    {\"name\": \"Snack 1\", \"shelf_life\": 270, \"price\": 3.25, \"protein\": 3.5, \"calories\": 90, \"allergen_count\": 1, \"spice\": 0, \"rating\": 7.5},\n    {\"name\": \"Snack 2\", \"shelf_life\": 330, \"price\": 3.25, \"protein\": 3.5, \"calories\": 220, \"allergen_count\": 0, \"spice\": 1, \"rating\": 8.0},\n    {\"name\": \"Snack 3\", \"shelf_life\": 225, \"price\": 3.0, \"protein\": 4.0, \"calories\": 140, \"allergen_count\": 2, \"spice\": 0, \"rating\": 7.0},\n    {\"name\": \"Snack 4\", \"shelf_life\": 365, \"price\": 4.0, \"protein\": 3.0, \"calories\": 250, \"allergen_count\": 0, \"spice\": 0, \"rating\": 8.0},\n    {\"name\": \"Snack 5\", \"shelf_life\": 7, \"price\": 2.0, \"protein\": 5.0, \"calories\": 60, \"allergen_count\": 1, \"spice\": 0, \"rating\": 7.0},\n    {\"name\": \"Snack 6\", \"shelf_life\": 10, \"price\": 3.75, \"protein\": 2.5, \"calories\": 35, \"allergen_count\": 1, \"spice\": 0, \"rating\": 7.0},\n    {\"name\": \"Snack 7\", \"shelf_life\": 75, \"price\": 3.75, \"protein\": 2.0, \"calories\": 150, \"allergen_count\": 1, \"spice\": 6, \"rating\": 8.5},\n    {\"name\": \"Snack 8\", \"shelf_life\": 60, \"price\": 3.0, \"protein\": 2.0, \"calories\": 150, \"allergen_count\": 0, \"spice\": 0, \"rating\": 7.5},\n    {\"name\": \"Snack 9\", \"shelf_life\": 150, \"price\": 3.0, \"protein\": 2.0, \"calories\": 160, \"allergen_count\": 0, \"spice\": 0, \"rating\": 8.0},\n    {\"name\": \"Snack 10\", \"shelf_life\": 150, \"price\": 4.0, \"protein\": 2.0, \"calories\": 160, \"allergen_count\": 0, \"spice\": 0, \"rating\": 8.0},\n    {\"name\": \"Snack 11\", \"shelf_life\": 180, \"price\": 3.0, \"protein\": 4.0, \"calories\": 80, \"allergen_count\": 2, \"spice\": 0, \"rating\": 6.5},\n    {\"name\": \"Snack 12\", \"shelf_life\": 150, \"price\": 3.75, \"protein\": 2.5, \"calories\": 150, \"allergen_count\": 0, \"spice\": 0, \"rating\": 7.5},\n    {\"name\": \"Snack 13\", \"shelf_life\": 270, \"price\": 3.25, \"protein\": 3.0, \"calories\": 130, \"allergen_count\": 1, \"spice\": 0, \"rating\": 7.0},\n    {\"name\": \"Snack 14\", \"shelf_life\": 365, \"price\": 3.75, \"protein\": 2.0, \"calories\": 240, \"allergen_count\": 0, \"spice\": 0, \"rating\": 8.0},\n    {\"name\": \"Snack 15\", \"shelf_life\": 365, \"price\": 3.5, \"protein\": 3.0, \"calories\": 60, \"allergen_count\": 0, \"spice\": 0, \"rating\": 7.5},\n    {\"name\": \"Snack 16\", \"shelf_life\": 225, \"price\": 3.0, \"protein\": 2.0, \"calories\": 190, \"allergen_count\": 2, \"spice\": 0, \"rating\": 6.5},\n    {\"name\": \"Snack 17\", \"shelf_life\": 270, \"price\": 3.25, \"protein\": 2.5, \"calories\": 150, \"allergen_count\": 0, \"spice\": 0, \"rating\": 8.0},\n    {\"name\": \"Snack 18\", \"shelf_life\": 270, \"price\": 3.0, \"protein\": 5.0, \"calories\": 50, \"allergen_count\": 0, \"spice\": 0, \"rating\": 7.0},\n    {\"name\": \"Snack 19\", \"shelf_life\": 10, \"price\": 2.5, \"protein\": 3.0, \"calories\": 70, \"allergen_count\": 1, \"spice\": 0, \"rating\": 6.0},\n    {\"name\": \"Snack 20\", \"shelf_life\": 7, \"price\": 2.5, \"protein\": 7.0, \"calories\": 150, \"allergen_count\": 1, \"spice\": 0, \"rating\": 6.5},\n    {\"name\": \"Snack 21\", \"shelf_life\": 225, \"price\": 1.0, \"protein\": 4.5, \"calories\": 35, \"allergen_count\": 3, \"spice\": 0, \"rating\": 3.5},\n    {\"name\": \"Snack 22\", \"shelf_life\": 300, \"price\": 1.0, \"protein\": 3.5, \"calories\": 70, \"allergen_count\": 3, \"spice\": 0, \"rating\": 4.0},\n    {\"name\": \"Snack 23\", \"shelf_life\": 225, \"price\": 1.75, \"protein\": 4.5, \"calories\": 140, \"allergen_count\": 3, \"spice\": 0, \"rating\": 4.5},\n    {\"name\": \"Snack 24\", \"shelf_life\": 10, \"price\": 0.5, \"protein\": 8.0, \"calories\": 15, \"allergen_count\": 3, \"spice\": 0, \"rating\": 3.0},\n    {\"name\": \"Snack 25\", \"shelf_life\": 200, \"price\": 2.75, \"protein\": 6.0, \"calories\": 100, \"allergen_count\": 2, \"spice\": 0, \"rating\": 6.5},\n    {\"name\": \"Snack 26\", \"shelf_life\": 150, \"price\": 2.5, \"protein\": 1.5, \"calories\": 175, \"allergen_count\": 1, \"spice\": 3, \"rating\": 7.5},\n    {\"name\": \"Snack 27\", \"shelf_life\": 300, \"price\": 3.25, \"protein\": 3.5, \"calories\": 190, \"allergen_count\": 0, \"spice\": 0, \"rating\": 8.0},\n    {\"name\": \"Snack 28\", \"shelf_life\": 120, \"price\": 3.0, \"protein\": 4.0, \"calories\": 85, \"allergen_count\": 2, \"spice\": 0, \"rating\": 6.0},\n    {\"name\": \"Snack 29\", \"shelf_life\": 240, \"price\": 3.0, \"protein\": 2.5, \"calories\": 130, \"allergen_count\": 2, \"spice\": 0, \"rating\": 7.0},\n    {\"name\": \"Snack 30\", \"shelf_life\": 270, \"price\": 3.75, \"protein\": 0.0, \"calories\": 205, \"allergen_count\": 0, \"spice\": 4, \"rating\": 8.5},\n]\n\ntesting_data = [\n    {\"name\": \"Takis Fuego\", \"shelf_life\": 240, \"price\": 1.75, \"protein\": 2, \"calories\": 140, \"allergen_count\": 1, \"spice\": 8},\n    {\"name\": \"Sour Patch Kids\", \"shelf_life\": 300, \"price\": 1.5, \"protein\": 0, \"calories\": 200, \"allergen_count\": 0, \"spice\": 0},\n    {\"name\": \"Flamin' Hot Cheetos\", \"shelf_life\": 75, \"price\": 1.75, \"protein\": 2, \"calories\": 160, \"allergen_count\": 1, \"spice\": 7},\n    {\"name\": \"Welch's Fruit Snacks\", \"shelf_life\": 270, \"price\": 0.5, \"protein\": 0, \"calories\": 80, \"allergen_count\": 0, \"spice\": 0},\n    {\"name\": \"Rice Krispies Treats\", \"shelf_life\": 180, \"price\": 0.75, \"protein\": 1, \"calories\": 90, \"allergen_count\": 0, \"spice\": 0},\n    {\"name\": \"Reese's Peanut Butter Cups\", \"shelf_life\": 300, \"price\": 1.0, \"protein\": 4, \"calories\": 210, \"allergen_count\": 3, \"spice\": 0},\n    {\"name\": \"Oreos\", \"shelf_life\": 150, \"price\": 4.0, \"protein\": 1, \"calories\": 160, \"allergen_count\": 2, \"spice\": 0},\n    {\"name\": \"Chobani Yogurt Cup\", \"shelf_life\": 24, \"price\": 1.0, \"protein\": 8, \"calories\": 135, \"allergen_count\": 1, \"spice\": 0},\n    {\"name\": \"Apple Slices\", \"shelf_life\": 3, \"price\": 0.5, \"protein\": 0, \"calories\": 60, \"allergen_count\": 0, \"spice\": 0},\n    {\"name\": \"Bananas\", \"shelf_life\": 5, \"price\": 0.3, \"protein\": 1, \"calories\": 105, \"allergen_count\": 0, \"spice\": 0},\n]\n\n\nclass SnackPrediction:\n    \"\"\"\n    A single snack's predicted rating, bundled together with the\n    feature value that produced it. Just print() it to see what's inside:\n\n        print(some_prediction)\n        -> Reese's Peanut Butter Cups (calories: 210) -> Predicted Rating: 8.02\n    \"\"\"\n\n    def __init__(self, snack_name, predicted_rating, features):\n        self.snack_name = snack_name\n        self.predicted_rating = predicted_rating\n        self.features = features  # dict of column_name -> value\n\n    def __str__(self):\n        feature_str = \", \".join(f\"{col}: {val}\" for col, val in self.features.items())\n        return (\n            f\"{self.snack_name} ({feature_str}) -> \"\n            f\"Predicted {TARGET_COLUMN}: {self.predicted_rating}\"\n        )\n\n    __repr__ = __str__\n\n\nclass TrainedModel:\n    \"\"\"\n    A fitted linear regression model. Call it with your testing data to\n    predict ratings, or pass it to visualize_model() to see the graph.\n\n        predict_top_snacks = train_model(training_data, \"calories\")\n        predictions = predict_top_snacks(testing_data)\n    \"\"\"\n\n    def __init__(self, model, column_name, data):\n        self.model = model\n        self.column_name = column_name\n        self.data = data\n\n    def __call__(self, testing_data):\n        column = self.column_name\n        X = [[row[column]] for row in testing_data]\n        ratings = self.model.predict(X).round(2)\n\n        predictions = [\n            SnackPrediction(row[NAME_COLUMN], rating, {column: row[column]})\n            for row, rating in zip(testing_data, ratings)\n        ]\n        predictions.sort(key=lambda p: p.predicted_rating, reverse=True)\n        return predictions\n\n\ndef train_model(training_data, column_name):\n    \"\"\"\n    Train a linear regression model predicting Rating from a single\n    feature column (e.g. \"calories\"). Returns a callable TrainedModel.\n    \"\"\"\n    features = [c for c in training_data[0] if c not in (NAME_COLUMN, TARGET_COLUMN)]\n    if column_name not in features:\n        raise ValueError(\n            f\"'{column_name}' isn't a column you can train on. \"\n            f\"Check your spelling — valid options are: {features}\"\n        )\n\n    X = [[row[column_name]] for row in training_data]\n    y = [row[TARGET_COLUMN] for row in training_data]\n\n    model = LinearRegression()\n    model.fit(X, y)\n\n    print(\n        f\"Trained on {column_name} -> {TARGET_COLUMN} = {model.intercept_:.3f} + \"\n        f\"{model.coef_[0]:.5f} * {column_name}\"\n    )\n\n    return TrainedModel(model, column_name, training_data)\n\n\ndef visualize_model(trained_model):\n    \"\"\"Plot the training data and the fitted regression line.\"\"\"\n    model = trained_model.model\n    column = trained_model.column_name\n\n    x_vals = [row[column] for row in trained_model.data]\n    y = [row[TARGET_COLUMN] for row in trained_model.data]\n\n    # Draw the regression line across the sorted feature values so it\n    # renders as a clean straight line rather than zig-zagging.\n    line_x = sorted(x_vals)\n    line_y = model.predict([[x] for x in line_x])\n\n    plt.figure(figsize=(8, 6))\n    plt.scatter(x_vals, y, color=\"steelblue\", label=\"Snacks\")\n    plt.plot(line_x, line_y, color=\"firebrick\", linewidth=2, label=\"Regression line\")\n    plt.xlabel(column)\n    plt.ylabel(TARGET_COLUMN)\n    plt.title(f\"{TARGET_COLUMN} vs. {column}\")\n    plt.legend()\n    plt.tight_layout()\n    plt.show()\n",
          "folderId": "0",
          "active": false,
          "type": "support"
        }
      },
