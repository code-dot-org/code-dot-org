          "name": "main.py",
          "contents": "from sklearn.linear_model import LinearRegression\n\n# TODO 1: Fix the definition of temperatures\ntemperatures = [62, 70, 78, 82, 92]\ndrinks = [30, 43, 53, 67, 80]\n\n# This line confirms how many examples the data holds:\nprint(\"Data loaded:\", len(temperatures), \"examples\")\n\n# This line creates a new, untrained model:\nmodel = LinearRegression()\n\n# This line trains the model on the client's data:\nmodel.fit(temperatures, drinks)\n\n# TODO 2: Predict the value you made on paper\n",
