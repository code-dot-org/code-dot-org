  "properties": {
    "encrypted": "false",
    "long_instructions": "## Career Finder v.1\r\n\r\nClick into \"User View\" to view the model card for this project and interact with the chatbot.",
    "system_prompt": "deprecated",
    "bot_title": "deprecated",
