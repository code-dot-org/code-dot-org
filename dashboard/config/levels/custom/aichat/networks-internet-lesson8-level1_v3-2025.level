        "modelCardInfo": {
          "botName": "Advocacy Message Bot",
          "description": "Advocacy Message Bot helps students design, test, and refine short campaign messages for their Internet Advocacy projects. It supports brainstorming slogans, drafting persuasive paragraphs, and giving constructive feedback on clarity, fairness, and tone. The chatbot models an ethical, iterative co-creation process where students generate, evaluate, and improve their own advocacy messages.",
          "intendedUse": "- Educational tool for developing advocacy and communication skills\n- Support for refining Internet equity and digital divide campaign messaging\n- Practice using AI collaboratively and responsibly in creative writing\n- Classroom activity for the “AI Message Testing” level in Lesson 8",
          "limitationsAndWarnings": "- The chatbot provides guidance and examples, not final drafts; students are responsible for all original writing.\n- Responses are generated from patterns in text and may occasionally produce phrasing that feels too formal or generic; students should edit for authenticity and fairness.\n- The chatbot avoids political opinions or advocacy positions beyond those described in the project context.",
          "testingAndEvaluation": "Advocacy Message Bot was tested with sample campaign topics on Internet access, digital equity, and net neutrality. Evaluation focused on message clarity, tone, and appropriateness for high school audiences.",
          "exampleTopics": [
            "“Draft a short advocacy pitch about expanding rural Internet access for students.”",
            "“Suggest three slogans for a campaign that supports affordable home Wi-Fi.”",
            "“How can we make this message more persuasive but still fair and respectful?”",
            "“Can you reword this pitch so it sounds more like students speaking to school leaders?”",
            "“What facts or examples could make our campaign stronger?”"
          ],
          "isPublished": false
        }
      },
      "visibilities": {
        "selectedModelId": "hidden",
