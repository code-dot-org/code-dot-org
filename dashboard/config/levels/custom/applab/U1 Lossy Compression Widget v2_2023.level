    "start_blocks": "var WIDTH = 320;\nvar HEIGHT = 210;\nvar originalBytes;\nvar busImageURL = \"/media?u=https%3A%2F%2Fimages.code.org%2F94fc42764aa25d608f2489cee7a04d11-image-1564414597427.jpg\";\nvar pixelImage = busImageURL;\n\ncreateCanvas(\"imgCanv\", WIDTH, HEIGHT);\ncreateCanvas(\"drawCanv\", WIDTH, HEIGHT);\n\nsetup();\n\nonEvent(\"newImageButton\", \"click\", function () {\n  var raw = prompt(\"Enter your picture URL\");\n  if (!raw) return;\n  var candidate = wrapForMediaProxy(raw);\n  // Try loading first; only commit if it succeeds.\n  setActiveCanvas(\"imgCanv\");\n  drawImageURL(candidate, function (success) {\n    if (!success) {\n      console.log(\"Image load failed. Try an allowlisted host.\");\n      return;\n    }\n    pixelImage = candidate; // commit only on success\n    drawImg(pixelImage);    // redraw both canvases from canonical source\n    setProperty(\"bitsSlider\", \"value\", 1);\n    setText(\"sampleSizeOutput\", 1);\n  });\n});\n\nonEvent(\"bitsSlider\", \"change\", function( ) {\n  setText(\"sampleSizeOutput\", getNumber(\"bitsSlider\"));\n  hideElement(\"compressedOutput\");\n  hideElement(\"originalOutput\");\n  hideElement(\"sampleSizeOutput\");\n  showElement(\"waitingImage\");\n  if(getNumber(\"bitsSlider\")==1){\n    drawImg(pixelImage);\n  } else {\n    sampleImage(getNumber(\"bitsSlider\"));\n  }\n  playSound(\"sound://category_hits/puzzle_game_button_03.mp3\");\n  hideElement(\"waitingImage\");\n  showElement(\"compressedOutput\");\n  showElement(\"originalOutput\");\n  showElement(\"sampleSizeOutput\");\n});\n\nfunction drawImg(url) {\n  setActiveCanvas(\"drawCanv\");\n  clearCanvas();\n  setActiveCanvas(\"imgCanv\");\n  clearCanvas();\n  setFillColor(\"black\");\n  rect(0, 0, WIDTH, HEIGHT);\n  drawImageURL(url);\n  \n}\n\nfunction sampleImage(size) {\n  var cols = Math.floor(WIDTH / size) + 1;\n  var rows = Math.floor(HEIGHT / size) + 1;\n  \n  //DEBUGGING STATEMENTS\n  //console.log(\"columns: \" + cols);\n  //console.log(\"rows: \" + rows);\n  //console.log(imgRect);\n  //console.log(\"red: \" + red);\n  //console.log(\"green: \" + green);\n  //console.log(\"blue: \" + blue);\n  \n  \n  var imgRect;\n  var red;\n  var green;\n  var blue;\n  setStrokeWidth(0.1);\n  \n  setActiveCanvas(\"drawCanv\");\n  clearCanvas();\n  \n  for(var r = 0; r < rows; r++) {\n    for(var c = 0; c < cols; c++) {\n      setActiveCanvas(\"imgCanv\");\n      imgRect = getImageData(c*size, r*size, size, size); //c, r, size, size    \n      red = getRed(imgRect, size / 2, size / 2);\n      green = getGreen(imgRect, size / 2, size / 2);\n      blue = getBlue(imgRect, size / 2, size / 2);\n      setActiveCanvas(\"drawCanv\");\n      setFillColor(rgb(red, green, blue));\n      setStrokeColor(rgb(red,green, blue));\n      rect(c*size, r*size, size, size);\n    }\n  }\n  \n  var compressedBytes = rows * cols * 3;\n  setText(\"compressedOutput\", compressedBytes + \" bytes\");\n  \n}\n\nfunction setup() {\n  setProperty(\"bitsSlider\", \"value\", 1);\n  //drawImg(\"https://www.amphi.com/cms/lib/AZ01901095/Centricity/Domain/999/Schneider.jpg\");\n  drawImg(pixelImage);\n  \n  //setText(\"compressBtn\", \"Sample Size: \" + getNumber(\"bitsSlider\"));\n  setText(\"sampleSizeOutput\", 1);\n  //Next line represents original image: # pixels * 3 colors per pixel\n  originalBytes = WIDTH * HEIGHT * 3;\n  setText(\"originalOutput\", originalBytes + \" bytes\");\n  setText(\"compressedOutput\", originalBytes + \" bytes\");  \n\n}\n\nfunction wrapForMediaProxy(rawUrl) {\n  return \"/media?u=\" + encodeURIComponent((rawUrl || \"\").trim());\n}\n",
