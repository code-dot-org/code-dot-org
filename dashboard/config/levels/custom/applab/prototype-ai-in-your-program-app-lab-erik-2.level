    "data_tables": "{\r\n  \"_ai_model_BedtimeStory\": [\r\n    {\r\n      \"hero\": \"bunny\",\r\n      \"place\": \"forest\",\r\n      \"problem\": \"lost\",\r\n      \"label\": \"just right\"\r\n    },\r\n    {\r\n      \"hero\": \"bunny\",\r\n      \"place\": \"forest\",\r\n      \"problem\": \"hungry\",\r\n      \"label\": \"just right\"\r\n    },\r\n    {\r\n      \"hero\": \"bunny\",\r\n      \"place\": \"forest\",\r\n      \"problem\": \"monster\",\r\n      \"label\": \"too scary\"\r\n    },\r\n    {\r\n      \"hero\": \"bunny\",\r\n      \"place\": \"moon\",\r\n      \"problem\": \"lost\",\r\n      \"label\": \"just right\"\r\n    },\r\n    {\r\n      \"hero\": \"bunny\",\r\n      \"place\": \"moon\",\r\n      \"problem\": \"hungry\",\r\n      \"label\": \"just right\"\r\n    },\r\n    {\r\n      \"hero\": \"bunny\",\r\n      \"place\": \"basement\",\r\n      \"problem\": \"lost\",\r\n      \"label\": \"too scary\"\r\n    },\r\n    {\r\n      \"hero\": \"bunny\",\r\n      \"place\": \"basement\",\r\n      \"problem\": \"monster\",\r\n      \"label\": \"too scary\"\r\n    },\r\n    {\r\n      \"hero\": \"robot\",\r\n      \"place\": \"forest\",\r\n      \"problem\": \"hungry\",\r\n      \"label\": \"just right\"\r\n    },\r\n    {\r\n      \"hero\": \"robot\",\r\n      \"place\": \"forest\",\r\n      \"problem\": \"lost\",\r\n      \"label\": \"just right\"\r\n    },\r\n    {\r\n      \"hero\": \"robot\",\r\n      \"place\": \"moon\",\r\n      \"problem\": \"lost\",\r\n      \"label\": \"just right\"\r\n    },\r\n    {\r\n      \"hero\": \"robot\",\r\n      \"place\": \"moon\",\r\n      \"problem\": \"monster\",\r\n      \"label\": \"just right\"\r\n    },\r\n    {\r\n      \"hero\": \"robot\",\r\n      \"place\": \"basement\",\r\n      \"problem\": \"hungry\",\r\n      \"label\": \"just right\"\r\n    },\r\n    {\r\n      \"hero\": \"robot\",\r\n      \"place\": \"basement\",\r\n      \"problem\": \"monster\",\r\n      \"label\": \"too scary\"\r\n    },\r\n    {\r\n      \"hero\": \"dragon\",\r\n      \"place\": \"forest\",\r\n      \"problem\": \"monster\",\r\n      \"label\": \"just right\"\r\n    },\r\n    {\r\n      \"hero\": \"dragon\",\r\n      \"place\": \"forest\",\r\n      \"problem\": \"lost\",\r\n      \"label\": \"just right\"\r\n    },\r\n    {\r\n      \"hero\": \"dragon\",\r\n      \"place\": \"moon\",\r\n      \"problem\": \"hungry\",\r\n      \"label\": \"just right\"\r\n    },\r\n    {\r\n      \"hero\": \"dragon\",\r\n      \"place\": \"basement\",\r\n      \"problem\": \"lost\",\r\n      \"label\": \"too scary\"\r\n    },\r\n    {\r\n      \"hero\": \"dragon\",\r\n      \"place\": \"basement\",\r\n      \"problem\": \"monster\",\r\n      \"label\": \"too scary\"\r\n    }\r\n  ],\r\n  \"_ai_responses\": [\r\n    {\r\n      \"context\": \"\",\r\n      \"keyword\": \"\",\r\n      \"reply\": \"Once upon a time, someone went on an adventure. It was a nice day. Then they went home and went to sleep. The End.\"\r\n    },\r\n    {\r\n      \"context\": \"forest, lost\",\r\n      \"keyword\": \"\",\r\n      \"reply\": \"Once upon a time, a little {hero} went for a walk in the forest and got lost. All the trees looked the same! Then a firefly blinked and said, \\\"Follow me.\\\" The {hero} followed the tiny light all the way home. After a big hug, the {hero} snuggled into bed, warm and safe. The End.\"\r\n    },\r\n    {\r\n      \"context\": \"forest, hungry\",\r\n      \"keyword\": \"\",\r\n      \"reply\": \"Once upon a time, a little {hero} had a picnic in the forest, but the basket was empty! A friendly squirrel shared some berries. A bird brought a crunchy nut. Soon the {hero}'s tummy was full and happy. The {hero} said thank you, gave a big yawn, and fell asleep under the stars. The End.\"\r\n    },\r\n    {\r\n      \"context\": \"forest, monster\",\r\n      \"keyword\": \"\",\r\n      \"reply\": \"One night in the forest, a little {hero} heard a rustle. Two big eyes peeked out from the bushes! It was a fuzzy monster, and it was scared of the dark too. The {hero} held its paw. They counted fireflies together until they both felt brave, then fell asleep side by side. The End.\"\r\n    },\r\n    {\r\n      \"context\": \"moon, lost\",\r\n      \"keyword\": \"\",\r\n      \"reply\": \"Once upon a time, a little {hero} flew all the way to the moon. But which way was home? The {hero} looked up and saw the big blue Earth glowing in the sky. \\\"There it is!\\\" The {hero} zoomed home, landed softly in bed, and dreamed about the stars. The End.\"\r\n    },\r\n    {\r\n      \"context\": \"moon, hungry\",\r\n      \"keyword\": \"\",\r\n      \"reply\": \"A little {hero} was exploring the moon when its tummy rumbled. There was no food anywhere, just dusty craters! Then the {hero} found a crater shaped like a bowl, filled with moon cheese. Yum! With a full tummy, the {hero} curled up in the soft moon dust and fell fast asleep. The End.\"\r\n    },\r\n    {\r\n      \"context\": \"moon, monster\",\r\n      \"keyword\": \"\",\r\n      \"reply\": \"On the quiet moon, a little {hero} saw a big shadow behind a rock. Was it a monster? The {hero} took a deep breath and said hello. Out came a shy moon monster who just wanted a friend. They bounced across the craters together, then waved goodnight to Earth. The End.\"\r\n    },\r\n    {\r\n      \"context\": \"basement, lost\",\r\n      \"keyword\": \"\",\r\n      \"reply\": \"A little {hero} went down to the basement to find a lost teddy bear. It was dim, and the boxes made funny shapes. The {hero} turned on the light. Click! The shapes were just boxes, and teddy was waiting on a shelf. The {hero} carried teddy upstairs to bed. The End.\"\r\n    },\r\n    {\r\n      \"context\": \"basement, hungry\",\r\n      \"keyword\": \"\",\r\n      \"reply\": \"Late one night, a little {hero} got hungry and tiptoed down to the basement, where the snacks were kept. Creak went the stairs! The {hero} found the cookie jar and took two cookies, one to share with Dad. They ate a cozy snack, brushed their teeth, and went to sleep. The End.\"\r\n    },\r\n    {\r\n      \"context\": \"basement, monster\",\r\n      \"keyword\": \"\",\r\n      \"reply\": \"In the basement, a little {hero} saw two glowing eyes in a dark corner. The {hero} felt scared, but reached up and turned on the light. It was only the cat! The cat purred and rubbed against the {hero}'s leg. They went upstairs together and curled up in bed. The End.\"\r\n    },\r\n    {\r\n      \"context\": \"lost\",\r\n      \"keyword\": \"silly, funny\",\r\n      \"reply\": \"Once upon a time, a little {hero} got so lost that it asked a tree for directions. The tree said nothing, because it was a tree. Then the {hero} asked a rock. Also nothing! Finally, the {hero} followed its own nose all the way home and giggled itself to sleep. The End.\"\r\n    },\r\n    {\r\n      \"context\": \"hungry\",\r\n      \"keyword\": \"silly, funny\",\r\n      \"reply\": \"A little {hero} was so hungry it tried to eat its pillow. \\\"Too fluffy!\\\" Then it tried to eat a sock. \\\"Too stinky!\\\" Finally, Grandma made pancakes, and they were just right. The {hero} ate ten, burped, and fell asleep with syrup on its nose. The End.\"\r\n    },\r\n    {\r\n      \"context\": \"monster\",\r\n      \"keyword\": \"silly, funny\",\r\n      \"reply\": \"A little {hero} met a monster who was terrible at being scary. \\\"Roar,\\\" said the monster, very quietly. \\\"You need practice,\\\" said the {hero}. They practiced roaring until they both got the giggles. Then the monster said goodnight, and the {hero} fell asleep smiling. The End.\"\r\n    }\r\n  ]\r\n}",
    "start_libraries": "[{\"name\":\"AI\",\"description\":\"Functions that let your program use AI models: classify what a user enters, ask a generative AI for a reply, show messages, check for missing input, and log tests\",\"functions\":[\"classify\",\"ask\",\"show\",\"isMissing\",\"logTest\"],\"dropletConfig\":[{\"func\":\"AI.classify\",\"category\":\"Functions\",\"comment\":\"asks a trained AI model to sort what the user entered into a category\\nmodelName {string} - the name of your AI model\\ninputIds {list} - the ids of the inputs the model looks at\\nonResult {function} - the function to run when the model answers. It gets the model's answer.\",\"type\":\"either\",\"params\":[\"modelName\",\"inputIds\",\"onResult\"],\"paletteParams\":[\"modelName\",\"inputIds\",\"onResult\"]},{\"func\":\"AI.ask\",\"category\":\"Functions\",\"comment\":\"asks a generative AI to write a reply and shows it on the screen\\ninstructions {string} - what you want the AI to write, and how\\ncontext {string} - extra information the AI should use. This can be text, like your model's answer, or a list of input ids.\\noutputId {string} - the id of the label where the AI's reply should appear\",\"type\":\"either\",\"params\":[\"instructions\",\"context\",\"outputId\"],\"paletteParams\":[\"instructions\",\"context\",\"outputId\"]},{\"func\":\"AI.show\",\"category\":\"Functions\",\"comment\":\"shows a message on the screen\\nelementId {string} - the id of the label where the message should appear\\nmessage {string} - the message to show. Use \\\"\\\" to clear the label.\",\"type\":\"either\",\"params\":[\"elementId\",\"message\"],\"paletteParams\":[\"elementId\",\"message\"]},{\"func\":\"AI.isMissing\",\"category\":\"Functions\",\"comment\":\"checks whether the user left any of these inputs empty\\ninputIds {list} - the ids of the inputs to check\\nreturn {boolean} - true if any input is empty, otherwise false\",\"type\":\"either\",\"params\":[\"inputIds\"],\"paletteParams\":[\"inputIds\"]},{\"func\":\"AI.logTest\",\"category\":\"Functions\",\"comment\":\"saves one test of your app to the \\\"Test Log\\\" table so you can look back at how it did\\nwhatITried {string} - what you entered when you tested the app\\nwhatItSaid {string} - what your app showed\\ndidItHelp {string} - did it help the user? For example: yes, no, or sort of\",\"type\":\"either\",\"params\":[\"whatITried\",\"whatItSaid\",\"didItHelp\"],\"paletteParams\":[\"whatITried\",\"whatItSaid\",\"didItHelp\"]}],\"source\":\"// asks a trained AI model to sort what the user entered into a category\\n// modelName {string} - the name of your AI model\\n// inputIds {list} - the ids of the inputs the model looks at\\n// onResult {function} - the function to run when the model answers. It gets the model's answer.\\nfunction classify(modelName, inputIds, onResult) {\\n  if (!checkCallback(onResult, \\\"classify\\\")) {\\n    return;\\n  }\\n  var answers = readInputs(inputIds);\\n  simClassify(modelName, answers, function(result) {\\n    later(function() {\\n      onResult(result);\\n    });\\n  });\\n}\\n\\n// asks a generative AI to write a reply and shows it on the screen\\n// instructions {string} - what you want the AI to write, and how\\n// context {string} - extra information the AI should use. This can be text, like your model's answer, or a list of input ids.\\n// outputId {string} - the id of the label where the AI's reply should appear\\nfunction ask(instructions, context, outputId) {\\n  if (typeof outputId != \\\"string\\\") {\\n    console.log(\\\"AI.ask: the last part needs to be the id of a label, in quotes.\\\");\\n    return;\\n  }\\n  setText(outputId, \\\"Thinking...\\\");\\n  var filled = {};\\n  var contextText = context;\\n  if (typeof context == \\\"object\\\" && context !== null) {\\n    filled = readInputs(context);\\n    contextText = joinValues(filled);\\n  }\\n  simAsk(instructions, contextText, function(reply) {\\n    later(function() {\\n      setText(outputId, fillIn(reply, filled));\\n    });\\n  });\\n}\\n\\n// shows a message on the screen\\n// elementId {string} - the id of the label where the message should appear\\n// message {string} - the message to show. Use \\\"\\\" to clear the label.\\nfunction show(elementId, message) {\\n  setText(elementId, message);\\n}\\n\\n// checks whether the user left any of these inputs empty\\n// inputIds {list} - the ids of the inputs to check\\n// return {boolean} - true if any input is empty, otherwise false\\nfunction isMissing(inputIds) {\\n  var ids = toList(inputIds);\\n  for (var i = 0; i < ids.length; i++) {\\n    if (normalize(getText(ids[i])) == \\\"\\\") {\\n      return true;\\n    }\\n  }\\n  return false;\\n}\\n\\n// saves one test of your app to the \\\"Test Log\\\" table so you can look back at how it did\\n// whatITried {string} - what you entered when you tested the app\\n// whatItSaid {string} - what your app showed\\n// didItHelp {string} - did it help the user? For example: yes, no, or sort of\\nfunction logTest(whatITried, whatItSaid, didItHelp) {\\n  createRecord(\\\"Test Log\\\", {tried: whatITried, appSaid: whatItSaid, helped: didItHelp}, function(record) {\\n  });\\n}\\n\\n// private: simulated classifier. Finds the rows that match the most inputs\\n// and returns the most common label among them. Always gives an answer.\\nfunction simClassify(modelName, answers, done) {\\n  readRecords(\\\"_ai_model_\\\" + modelName, {}, function(records) {\\n    if (!records || records.length == 0) {\\n      console.log(\\\"AI: couldn't find a model named \\\\\\\"\\\" + modelName + \\\"\\\\\\\". Check the spelling.\\\");\\n      done(\\\"\\\");\\n      return;\\n    }\\n    var bestScore = -1;\\n    var votes = {};\\n    for (var i = 0; i < records.length; i++) {\\n      var score = matchScore(records[i], answers);\\n      if (score > bestScore) {\\n        bestScore = score;\\n        votes = {};\\n      }\\n      if (score == bestScore) {\\n        var label = records[i].label;\\n        if (votes[label]) {\\n          votes[label] = votes[label] + 1;\\n        } else {\\n          votes[label] = 1;\\n        }\\n      }\\n    }\\n    done(topVote(votes));\\n  });\\n}\\n\\n// private: simulated generative AI. A row's context is a comma-separated list of words\\n// that must ALL appear in the context (blank = any context); each word scores 2.\\n// Each keyword found in the instructions scores 10. Keyword rows with no hits are skipped.\\n// Picks randomly among the top-scoring rows.\\nfunction simAsk(instructions, context, done) {\\n  readRecords(\\\"_ai_responses\\\", {}, function(records) {\\n    if (!records) {\\n      records = [];\\n    }\\n    var instr = normalize(instructions);\\n    var ctx = normalize(context);\\n    var best = -1;\\n    var choices = [];\\n    for (var i = 0; i < records.length; i++) {\\n      var score = 0;\\n      var rowCtx = normalize(records[i].context);\\n      if (rowCtx != \\\"\\\") {\\n        var parts = contextParts(rowCtx, ctx);\\n        if (parts < 0) {\\n          continue;\\n        }\\n        score = parts * 2;\\n      }\\n      var keywords = normalize(records[i].keyword);\\n      if (keywords != \\\"\\\") {\\n        var hits = keywordHits(keywords, instr);\\n        if (hits == 0) {\\n          continue;\\n        }\\n        score = score + hits * 10;\\n      }\\n      if (score > best) {\\n        best = score;\\n        choices = [];\\n      }\\n      if (score == best) {\\n        choices.push(records[i].reply);\\n      }\\n    }\\n    if (choices.length == 0) {\\n      done(\\\"I'm not sure how to help with that. Try giving me more specific instructions.\\\");\\n    } else {\\n      done(choices[randomNumber(0, choices.length - 1)]);\\n    }\\n  });\\n}\\n\\n// private: counts the comma-separated words of a row's context, or -1 if any are missing\\nfunction contextParts(rowContext, context) {\\n  var words = rowContext.split(\\\",\\\");\\n  var count = 0;\\n  for (var i = 0; i < words.length; i++) {\\n    var word = normalize(words[i]);\\n    if (word != \\\"\\\") {\\n      if (context.indexOf(word) == -1) {\\n        return -1;\\n      }\\n      count = count + 1;\\n    }\\n  }\\n  return count;\\n}\\n\\n// private: joins the values of an object into one piece of text\\nfunction joinValues(values) {\\n  var text = \\\"\\\";\\n  for (var key in values) {\\n    text = text + \\\" \\\" + values[key];\\n  }\\n  return text;\\n}\\n\\n// private: replaces {inputId} in a reply with what the user entered.\\n// Any placeholder left over becomes \\\"friend\\\".\\nfunction fillIn(reply, filled) {\\n  for (var key in filled) {\\n    reply = reply.split(\\\"{\\\" + key + \\\"}\\\").join(filled[key]);\\n  }\\n  return reply.replace(/\\\\{[^}]*\\\\}/g, \\\"friend\\\");\\n}\\n\\n// private: counts how many inputs match a row\\nfunction matchScore(record, answers) {\\n  var score = 0;\\n  for (var column in record) {\\n    if (column == \\\"label\\\" || column == \\\"id\\\") {\\n      continue;\\n    }\\n    for (var key in answers) {\\n      if (normalize(key) == normalize(column) && normalize(answers[key]) == normalize(record[column])) {\\n        score = score + 1;\\n      }\\n    }\\n  }\\n  return score;\\n}\\n\\n// private: counts how many comma-separated keywords appear in the instructions\\nfunction keywordHits(keywordText, instructions) {\\n  var words = keywordText.split(\\\",\\\");\\n  var hits = 0;\\n  for (var i = 0; i < words.length; i++) {\\n    var word = normalize(words[i]);\\n    if (word != \\\"\\\" && instructions.indexOf(word) != -1) {\\n      hits = hits + 1;\\n    }\\n  }\\n  return hits;\\n}\\n\\n// private: returns the label with the most votes\\nfunction topVote(votes) {\\n  var top = \\\"\\\";\\n  var topCount = -1;\\n  for (var label in votes) {\\n    if (votes[label] > topCount) {\\n      top = label;\\n      topCount = votes[label];\\n    }\\n  }\\n  return top;\\n}\\n\\n// private: reads the text of each input into an object\\nfunction readInputs(inputIds) {\\n  var ids = toList(inputIds);\\n  var answers = {};\\n  for (var i = 0; i < ids.length; i++) {\\n    answers[ids[i]] = getText(ids[i]);\\n  }\\n  return answers;\\n}\\n\\n// private: lets students pass one id instead of a list\\nfunction toList(value) {\\n  if (typeof value == \\\"string\\\") {\\n    return [value];\\n  }\\n  if (!value) {\\n    return [];\\n  }\\n  return value;\\n}\\n\\n// private: lowercases and trims a value so comparisons are forgiving\\nfunction normalize(value) {\\n  if (value === null || value === undefined) {\\n    return \\\"\\\";\\n  }\\n  return (\\\"\\\" + value).toLowerCase().trim();\\n}\\n\\n// private: warns the student if they forgot to pass a function\\nfunction checkCallback(fn, functionName) {\\n  if (typeof fn != \\\"function\\\") {\\n    console.log(\\\"AI.\\\" + functionName + \\\": the last part needs to be the name of a function you wrote.\\\");\\n    return false;\\n  }\\n  return true;\\n}\\n\\n// private: waits a moment so the AI feels like it is thinking\\nfunction later(fn) {\\n  setTimeout(fn, randomNumber(400, 1200));\\n}\\n\",\"originalName\":\"AI\",\"versionId\":\"REPLACE_WITH_VERSION_ID\",\"channelId\":\"REPLACE_WITH_CHANNEL_ID\",\"fromLevelbuilder\":true}]",
    "start_blocks": "// Bedtime Story Builder: sample student program using the AI library\r\n// The user is about 5 years old. They tap one picture in each row,\r\n// the classifier checks if the story would be too scary,\r\n// and the generative AI writes the story if it's just right.\r\n\r\nonEvent(\"startButton\", \"click\", function() {\r\n  setScreen(\"pickScreen\");\r\n});\r\n\r\n// Hero pictures\r\nonEvent(\"bunnyTile\", \"click\", function() {\r\n  AI.show(\"hero\", \"bunny\");\r\n});\r\nonEvent(\"robotTile\", \"click\", function() {\r\n  AI.show(\"hero\", \"robot\");\r\n});\r\nonEvent(\"dragonTile\", \"click\", function() {\r\n  AI.show(\"hero\", \"dragon\");\r\n});\r\n\r\n// Place pictures\r\nonEvent(\"forestTile\", \"click\", function() {\r\n  AI.show(\"place\", \"forest\");\r\n});\r\nonEvent(\"moonTile\", \"click\", function() {\r\n  AI.show(\"place\", \"moon\");\r\n});\r\nonEvent(\"basementTile\", \"click\", function() {\r\n  AI.show(\"place\", \"basement\");\r\n});\r\n\r\n// Problem pictures\r\nonEvent(\"lostTile\", \"click\", function() {\r\n  AI.show(\"problem\", \"lost\");\r\n});\r\nonEvent(\"hungryTile\", \"click\", function() {\r\n  AI.show(\"problem\", \"hungry\");\r\n});\r\nonEvent(\"monsterTile\", \"click\", function() {\r\n  AI.show(\"problem\", \"monster\");\r\n});\r\n\r\nonEvent(\"storyButton\", \"click\", function() {\r\n  if (AI.isMissing([\"hero\", \"place\", \"problem\"])) {\r\n    AI.show(\"messageLabel\", \"Pick one picture in every row!\");\r\n  } else {\r\n    AI.show(\"messageLabel\", \"Checking your story...\");\r\n    AI.classify(\"BedtimeStory\", [\"hero\", \"place\", \"problem\"], checkStory);\r\n  }\r\n});\r\n\r\nfunction checkStory(result) {\r\n  AI.show(\"messageLabel\", \"\");\r\n  if (result == \"just right\") {\r\n    setScreen(\"storyScreen\");\r\n    AI.ask(\"Write a short, gentle bedtime story for a 5-year-old.\", [\"hero\", \"place\", \"problem\"], \"storyText\");\r\n  } else if (result == \"too scary\") {\r\n    setScreen(\"tooScaryScreen\");\r\n  } else {\r\n    AI.show(\"messageLabel\", \"Something went wrong. Please try again.\");\r\n  }\r\n}\r\n\r\nonEvent(\"tryAgainButton\", \"click\", function() {\r\n  setScreen(\"pickScreen\");\r\n});\r\n\r\nonEvent(\"newStoryButton\", \"click\", function() {\r\n  AI.show(\"hero\", \"\");\r\n  AI.show(\"place\", \"\");\r\n  AI.show(\"problem\", \"\");\r\n  setScreen(\"pickScreen\");\r\n});",
    "preload_asset_list": null,
    "encrypted_examples": [

    ]
  },
  "audit_log": "[{\"changed_at\":\"2026-10-08T15:02:16.275+00:00\",\"changed\":[\"cloned from \\\"prototype-ai-in-your-program-app-lab-erik\\\"\"],\"cloned_from\":\"prototype-ai-in-your-program-app-lab-erik\"},{\"changed_at\":\"2026-10-08 15:09:57 +0000\",\"changed\":[\"code_functions\",\"start_html\",\"data_tables\",\"start_libraries\",\"long_instructions\",\"start_blocks\",\"preload_asset_list\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-08 15:11:22 +0000\",\"changed\":[\"code_functions\",\"start_html\",\"preload_asset_list\",\"encrypted_examples\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"}]"
}]]></config>
