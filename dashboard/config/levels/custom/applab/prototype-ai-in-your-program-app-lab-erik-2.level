    "start_html": "<div id=\"designModeViz\" class=\"appModern\" tabindex=\"1\" data-radium=\"true\" style=\"display: none; width: 320px; height: 450px;\"><div class=\"screen\" tabindex=\"1\" data-theme=\"glowInTheDark\" id=\"titleScreen\" style=\"display: block; height: 450px; width: 320px; left: 0px; top: 0px; position: absolute; z-index: 0; background-color: rgb(27, 38, 74);\"><label style=\"margin: 0px; line-height: 1; overflow: hidden; overflow-wrap: break-word; max-width: 320px; border-style: solid; text-rendering: optimizespeed; color: rgb(255, 244, 222); background-color: rgb(44, 58, 107); border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 0px; font-family: Tahoma, Geneva, sans-serif; font-size: 24px; padding: 4px 15px; width: 320px; height: 34px; position: absolute; left: 0px; top: 15px; text-align: center;\" id=\"titleText\">Bedtime Story Builder</label><img src=\"https://images.code.org/7cf048ebdd5cd1b747a2ccd72cb10633-image-1791471853108.png\" data-canonical-image-url=\"https://images.code.org/7cf048ebdd5cd1b747a2ccd72cb10633-image-1791471853108.png\" data-object-fit=\"contain\" id=\"titleArt\" style=\"height: 210px; width: 280px; border-style: solid; border-width: 0px; border-color: rgb(255, 244, 222); border-radius: 0px; position: absolute; left: 20px; top: 65px; margin: 0px;\"><label style=\"margin: 0px; line-height: 1; overflow: hidden; overflow-wrap: break-word; max-width: 320px; border-style: solid; text-rendering: optimizespeed; color: rgb(255, 244, 222); background-color: rgba(0, 0, 0, 0); border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 0px; font-family: Tahoma, Geneva, sans-serif; font-size: 17px; padding: 2px 15px; width: 320px; height: 24px; position: absolute; left: 0px; top: 295px; text-align: center;\" id=\"subtitleText\">Make a story for someone little.</label><button id=\"startButton\" style=\"padding: 0px; margin: 0px; border-style: solid; height: 45px; width: 150px; background-color: rgb(255, 214, 11