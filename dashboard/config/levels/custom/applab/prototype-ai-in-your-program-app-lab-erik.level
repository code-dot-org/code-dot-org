    "data_tables": "{\r\n  \"_ai_model_PlantHealth\": [\r\n    {\r\n      \"light\": \"high\",\r\n      \"water\": \"rarely\",\r\n      \"leaves\": \"droopy\",\r\n      \"label\": \"thirsty\"\r\n    },\r\n    {\r\n      \"light\": \"medium\",\r\n      \"water\": \"rarely\",\r\n      \"leaves\": \"brown\",\r\n      \"label\": \"thirsty\"\r\n    },\r\n    {\r\n      \"light\": \"high\",\r\n      \"water\": \"sometimes\",\r\n      \"leaves\": \"droopy\",\r\n      \"label\": \"thirsty\"\r\n    },\r\n    {\r\n      \"light\": \"low\",\r\n      \"water\": \"rarely\",\r\n      \"leaves\": \"droopy\",\r\n      \"label\": \"thirsty\"\r\n    },\r\n    {\r\n      \"light\": \"medium\",\r\n      \"water\": \"sometimes\",\r\n      \"leaves\": \"green\",\r\n      \"label\": \"healthy\"\r\n    },\r\n    {\r\n      \"light\": \"high\",\r\n      \"water\": \"sometimes\",\r\n      \"leaves\": \"green\",\r\n      \"label\": \"healthy\"\r\n    },\r\n    {\r\n      \"light\": \"medium\",\r\n      \"water\": \"often\",\r\n      \"leaves\": \"green\",\r\n      \"label\": \"healthy\"\r\n    },\r\n    {\r\n      \"light\": \"low\",\r\n      \"water\": \"often\",\r\n      \"leaves\": \"yellow\",\r\n      \"label\": \"overwatered\"\r\n    },\r\n    {\r\n      \"light\": \"medium\",\r\n      \"water\": \"often\",\r\n      \"leaves\": \"yellow\",\r\n      \"label\": \"overwatered\"\r\n    },\r\n    {\r\n      \"light\": \"high\",\r\n      \"water\": \"often\",\r\n      \"leaves\": \"yellow\",\r\n      \"label\": \"overwatered\"\r\n    }\r\n  ],\r\n  \"_ai_responses\": [\r\n    {\r\n      \"context\": \"\",\r\n      \"keyword\": \"\",\r\n      \"reply\": \"Plants are living things that need light, water, and air to grow.\"\r\n    },\r\n    {\r\n      \"context\": \"healthy\",\r\n      \"keyword\": \"\",\r\n      \"reply\": \"Your plant appears to be in good condition. Continue to provide appropriate care based on the needs of its species.\"\r\n    },\r\n    {\r\n      \"context\": \"healthy\",\r\n      \"keyword\": \"tip, today\",\r\n      \"reply\": \"Turn the pot a little bit each week so every side gets light. That helps it grow straight.\"\r\n    },\r\n    {\r\n      \"context\": \"healthy\",\r\n      \"keyword\": \"tip, today\",\r\n      \"reply\": \"Wipe the dust off a few leaves with a damp cloth. Clean leaves can soak up more light.\"\r\n    },\r\n    {\r\n      \"context\": \"thirsty\",\r\n      \"keyword\": \"\",\r\n      \"reply\": \"Water is essential for many plant processes, including photosynthesis and moving nutrients, so proper hydration is important for overall plant health.\"\r\n    },\r\n    {\r\n      \"context\": \"thirsty\",\r\n      \"keyword\": \"tip, today\",\r\n      \"reply\": \"Push your finger about an inch into the soil. If it feels dry, water it until water comes out the bottom of the pot.\"\r\n    },\r\n    {\r\n      \"context\": \"thirsty\",\r\n      \"keyword\": \"funny, joke\",\r\n      \"reply\": \"Your plant is basically saying, 'Hello? Is anyone going to get me a drink?' Give it some water.\"\r\n    },\r\n    {\r\n      \"context\": \"overwatered\",\r\n      \"keyword\": \"\",\r\n      \"reply\": \"Too much water can harm roots. Consider adjusting your watering schedule based on soil moisture and drainage.\"\r\n    },\r\n    {\r\n      \"context\": \"overwatered\",\r\n      \"keyword\": \"tip, today\",\r\n      \"reply\": \"Skip watering for a few days so the top of the soil can dry out. Check that the pot has holes in the bottom.\"\r\n    }\r\n  ]\r\n}",
    "start_libraries": "[{\"name\":\"AI\",\"description\":\"Functions that let your program use AI models: classify what a user enters, ask a generative AI for a reply, show messages, check for missing input, and log tests\",\"functions\":[\"classify\",\"ask\",\"show\",\"isMissing\",\"logTest\"],\"dropletConfig\":[{\"func\":\"AI.classify\",\"category\":\"Functions\",\"comment\":\"asks a trained AI model to sort what the user entered into a category\\nmodelName {string} - the name of your AI model\\ninputIds {list} - the ids of the inputs the model looks at\\nonResult {function} - the function to run when the model answers. It gets the model's answer.\",\"type\":\"either\",\"params\":[\"modelName\",\"inputIds\",\"onResult\"],\"paletteParams\":[\"modelName\",\"inputIds\",\"onResult\"]},{\"func\":\"AI.ask\",\"category\":\"Functions\",\"comment\":\"asks a generative AI to write a reply and shows it on the screen\\ninstructions {string} - what you want the AI to write, and how\\ncontext {string} - extra information the AI should use, like your model's answer\\noutputId {string} - the id of the label where the AI's reply should appear\",\"type\":\"either\",\"params\":[\"instructions\",\"context\",\"outputId\"],\"paletteParams\":[\"instructions\",\"context\",\"outputId\"]},{\"func\":\"AI.show\",\"category\":\"Functions\",\"comment\":\"shows a message on the screen\\nelementId {string} - the id of the label where the message should appear\\nmessage {string} - the message to show. Use \\\"\\\" to clear the label.\",\"type\":\"either\",\"params\":[\"elementId\",\"message\"],\"paletteParams\":[\"elementId\",\"message\"]},{\"func\":\"AI.isMissing\",\"category\":\"Functions\",\"comment\":\"checks whether the user left any of these inputs empty\\ninputIds {list} - the ids of the inputs to check\\nreturn {boolean} - true if any input is empty, otherwise false\",\"type\":\"either\",\"params\":[\"inputIds\"],\"paletteParams\":[\"inputIds\"]},{\"func\":\"AI.logTest\",\"category\":\"Functions\",\"comment\":\"saves one test of your app to the \\\"Test Log\\\" table so you can look back at how it did\\nwhatITried {string} - what you entered when you tested the app\\nwhatItSaid {string} - what your app showed\\ndidItHelp {string} - did it help the user? For example: yes, no, or sort of\",\"type\":\"either\",\"params\":[\"whatITried\",\"whatItSaid\",\"didItHelp\"],\"paletteParams\":[\"whatITried\",\"whatItSaid\",\"didItHelp\"]}],\"source\":\"// asks a trained AI model to sort what the user entered into a category\\n// modelName {string} - the name of your AI model\\n// inputIds {list} - the ids of the inputs the model looks at\\n// onResult {function} - the function to run when the model answers. It gets the model's answer.\\nfunction classify(modelName, inputIds, onResult) {\\n  if (!checkCallback(onResult, \\\"classify\\\")) {\\n    return;\\n  }\\n  var answers = readInputs(inputIds);\\n  simClassify(modelName, answers, function(result) {\\n    later(function() {\\n      onResult(result);\\n    });\\n  });\\n}\\n\\n// asks a generative AI to write a reply and shows it on the screen\\n// instructions {string} - what you want the AI to write, and how\\n// context {string} - extra information the AI should use, like your model's answer\\n// outputId {string} - the id of the label where the AI's reply should appear\\nfunction ask(instructions, context, outputId) {\\n  if (typeof outputId != \\\"string\\\") {\\n    console.log(\\\"AI.ask: the last part needs to be the id of a label, in quotes.\\\");\\n    return;\\n  }\\n  setText(outputId, \\\"Thinking...\\\");\\n  simAsk(instructions, context, function(reply) {\\n    later(function() {\\n      setText(outputId, reply);\\n    });\\n  });\\n}\\n\\n// shows a message on the screen\\n// elementId {string} - the id of the label where the message should appear\\n// message {string} - the message to show. Use \\\"\\\" to clear the label.\\nfunction show(elementId, message) {\\n  setText(elementId, message);\\n}\\n\\n// checks whether the user left any of these inputs empty\\n// inputIds {list} - the ids of the inputs to check\\n// return {boolean} - true if any input is empty, otherwise false\\nfunction isMissing(inputIds) {\\n  var ids = toList(inputIds);\\n  for (var i = 0; i < ids.length; i++) {\\n    if (normalize(getText(ids[i])) == \\\"\\\") {\\n      return true;\\n    }\\n  }\\n  return false;\\n}\\n\\n// saves one test of your app to the \\\"Test Log\\\" table so you can look back at how it did\\n// whatITried {string} - what you entered when you tested the app\\n// whatItSaid {string} - what your app showed\\n// didItHelp {string} - did it help the user? For example: yes, no, or sort of\\nfunction logTest(whatITried, whatItSaid, didItHelp) {\\n  createRecord(\\\"Test Log\\\", {tried: whatITried, appSaid: whatItSaid, helped: didItHelp}, function(record) {\\n  });\\n}\\n\\n// private: simulated classifier. Finds the rows that match the most inputs\\n// and returns the most common label among them. Always gives an answer.\\nfunction simClassify(modelName, answers, done) {\\n  readRecords(\\\"_ai_model_\\\" + modelName, {}, function(records) {\\n    if (!records || records.length == 0) {\\n      console.log(\\\"AI: couldn't find a model named \\\\\\\"\\\" + modelName + \\\"\\\\\\\". Check the spelling.\\\");\\n      done(\\\"\\\");\\n      return;\\n    }\\n    var bestScore = -1;\\n    var votes = {};\\n    for (var i = 0; i < records.length; i++) {\\n      var score = matchScore(records[i], answers);\\n      if (score > bestScore) {\\n        bestScore = score;\\n        votes = {};\\n      }\\n      if (score == bestScore) {\\n        var label = records[i].label;\\n        if (votes[label]) {\\n          votes[label] = votes[label] + 1;\\n        } else {\\n          votes[label] = 1;\\n        }\\n      }\\n    }\\n    done(topVote(votes));\\n  });\\n}\\n\\n// private: simulated generative AI. +2 if a row's context matches (blank = any),\\n// +1 per keyword found in the instructions. Keyword rows with no hits are skipped.\\n// Picks randomly among the top-scoring rows.\\nfunction simAsk(instructions, context, done) {\\n  readRecords(\\\"_ai_responses\\\", {}, function(records) {\\n    if (!records) {\\n      records = [];\\n    }\\n    var instr = normalize(instructions);\\n    var ctx = normalize(context);\\n    var best = -1;\\n    var choices = [];\\n    for (var i = 0; i < records.length; i++) {\\n      var rowCtx = normalize(records[i].context);\\n      if (rowCtx != \\\"\\\" && rowCtx != ctx) {\\n        continue;\\n      }\\n      var score = 0;\\n      if (rowCtx != \\\"\\\") {\\n        score = 2;\\n      }\\n      var keywords = normalize(records[i].keyword);\\n      if (keywords != \\\"\\\") {\\n        var hits = keywordHits(keywords, instr);\\n        if (hits == 0) {\\n          continue;\\n        }\\n        score = score + hits;\\n      }\\n      if (score > best) {\\n        best = score;\\n        choices = [];\\n      }\\n      if (score == best) {\\n        choices.push(records[i].reply);\\n      }\\n    }\\n    if (choices.length == 0) {\\n      done(\\\"I'm not sure how to help with that. Try giving me more specific instructions.\\\");\\n    } else {\\n      done(choices[randomNumber(0, choices.length - 1)]);\\n    }\\n  });\\n}\\n\\n// private: counts how many inputs match a row\\nfunction matchScore(record, answers) {\\n  var score = 0;\\n  for (var column in record) {\\n    if (column == \\\"label\\\" || column == \\\"id\\\") {\\n      continue;\\n    }\\n    for (var key in answers) {\\n      if (normalize(key) == normalize(column) && normalize(answers[key]) == normalize(record[column])) {\\n        score = score + 1;\\n      }\\n    }\\n  }\\n  return score;\\n}\\n\\n// private: counts how many comma-separated keywords appear in the instructions\\nfunction keywordHits(keywordText, instructions) {\\n  var words = keywordText.split(\\\",\\\");\\n  var hits = 0;\\n  for (var i = 0; i < words.length; i++) {\\n    var word = normalize(words[i]);\\n    if (word != \\\"\\\" && instructions.indexOf(word) != -1) {\\n      hits = hits + 1;\\n    }\\n  }\\n  return hits;\\n}\\n\\n// private: returns the label with the most votes\\nfunction topVote(votes) {\\n  var top = \\\"\\\";\\n  var topCount = -1;\\n  for (var label in votes) {\\n    if (votes[label] > topCount) {\\n      top = label;\\n      topCount = votes[label];\\n    }\\n  }\\n  return top;\\n}\\n\\n// private: reads the text of each input into an object\\nfunction readInputs(inputIds) {\\n  var ids = toList(inputIds);\\n  var answers = {};\\n  for (var i = 0; i < ids.length; i++) {\\n    answers[ids[i]] = getText(ids[i]);\\n  }\\n  return answers;\\n}\\n\\n// private: lets students pass one id instead of a list\\nfunction toList(value) {\\n  if (typeof value == \\\"string\\\") {\\n    return [value];\\n  }\\n  if (!value) {\\n    return [];\\n  }\\n  return value;\\n}\\n\\n// private: lowercases and trims a value so comparisons are forgiving\\nfunction normalize(value) {\\n  if (value === null || value === undefined) {\\n    return \\\"\\\";\\n  }\\n  return (\\\"\\\" + value).toLowerCase().trim();\\n}\\n\\n// private: warns the student if they forgot to pass a function\\nfunction checkCallback(fn, functionName) {\\n  if (typeof fn != \\\"function\\\") {\\n    console.log(\\\"AI.\\\" + functionName + \\\": the last part needs to be the name of a function you wrote.\\\");\\n    return false;\\n  }\\n  return true;\\n}\\n\\n// private: waits a moment so the AI feels like it is thinking\\nfunction later(fn) {\\n  setTimeout(fn, randomNumber(400, 1200));\\n}\\n\",\"originalName\":\"AI\",\"versionId\":\"REPLACE_WITH_VERSION_ID\",\"channelId\":\"REPLACE_WITH_CHANNEL_ID\",\"fromLevelbuilder\":true}]",
    "long_instructions": "![](https://images.code.org/52744d439340bec901cb5d0cf8a933d9-image-1791470278179.png)\r\n\r\n![](https://images.code.org/71bf4b8b42c32a12ca0bf253c227f388-image-1791470283003.png)\r\n\r\n![](https://images.code.org/da917acfe8c333949b38bc7c9c8d9cdc-image-1791470291056.png)",
    "start_blocks": "// Plant Helper: sample student program using the AI library\r\n// questionScreen: dropdowns \"light\", \"water\", \"leaves\", button \"checkButton\", label \"messageLabel\"\r\n// healthyScreen, thirstyScreen, overwateredScreen: each has its own tip label and Start over button\r\n\r\nonEvent(\"checkButton\", \"click\", function() {\r\n  if (AI.isMissing([\"light\", \"water\", \"leaves\"])) {\r\n    AI.show(\"messageLabel\", \"Please answer all three questions.\");\r\n  } else {\r\n    AI.show(\"messageLabel\", \"Checking your plant...\");\r\n    AI.classify(\"PlantHealth\", [\"light\", \"water\", \"leaves\"], showResult);\r\n  }\r\n});\r\n\r\nfunction showResult(result) {\r\n  AI.show(\"messageLabel\", \"\");\r\n  if (result == \"healthy\") {\r\n    setScreen(\"healthyScreen\");\r\n    AI.ask(\"Give one short tip a middle schooler could do today.\", result, \"healthyTip\");\r\n  } else if (result == \"thirsty\") {\r\n    setScreen(\"thirstyScreen\");\r\n    AI.ask(\"Give one short tip a middle schooler could do today.\", result, \"thirstyTip\");\r\n  } else if (result == \"overwatered\") {\r\n    setScreen(\"overwateredScreen\");\r\n    AI.ask(\"Give one short tip a middle schooler could do today.\", result, \"overwateredTip\");\r\n  } else {\r\n    AI.show(\"messageLabel\", \"Something went wrong. Please try again.\");\r\n  }\r\n}\r\n\r\nonEvent(\"healthyStartOver\", \"click\", function() {\r\n  setScreen(\"questionScreen\");\r\n});\r\n\r\nonEvent(\"thirstyStartOver\", \"click\", function() {\r\n  setScreen(\"questionScreen\");\r\n});\r\n\r\nonEvent(\"overwateredStartOver\", \"click\", function() {\r\n  setScreen(\"questionScreen\");\r\n});"
  },
  "audit_log": "[{\"changed_at\":\"2026-10-08 13:48:17 +0000\",\"changed\":[\"validation_enabled\",\"code_functions\",\"preload_asset_list\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-08 13:48:35 +0000\",\"changed\":[],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-08 13:59:33 +0000\",\"changed\":[\"code_functions\",\"libraries_enabled\",\"preload_asset_list\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-08 14:06:53 +0000\",\"changed\":[\"code_functions\",\"preload_asset_list\",\"encrypted_examples\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-08 14:09:04 +0000\",\"changed\":[\"code_functions\",\"preload_asset_list\",\"encrypted_examples\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-08 14:09:16 +0000\",\"changed\":[\"code_functions\",\"preload_asset_list\",\"encrypted_examples\",\"data_tables\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-08 14:09:43 +0000\",\"changed\":[\"code_functions\",\"preload_asset_list\",\"encrypted_examples\",\"start_libraries\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-08 14:13:13 +0000\",\"changed\":[\"code_functions\",\"preload_asset_list\",\"encrypted_examples\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-08 14:18:36 +0000\",\"changed\":[\"code_functions\",\"start_html\",\"preload_asset_list\",\"encrypted_examples\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-08 14:42:30 +0000\",\"changed\":[\"code_functions\",\"start_html\",\"preload_asset_list\",\"encrypted_examples\",\"data_tables\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"},{\"changed_at\":\"2026-10-08 14:43:11 +0000\",\"changed\":[\"code_functions\",\"preload_asset_list\",\"encrypted_examples\",\"start_libraries\"],\"changed_by_id\":18603,\"changed_by_email\":\"erik+levelbuilder@code.org\"}]"
}]]></config>
