    "start_html": "<div id=\"designModeViz\" class=\"appModern\" tabindex=\"1\" data-radium=\"true\" style=\"display: none; width: 320px; height: 450px;\"><div class=\"screen\" tabindex=\"1\" data-theme=\"glowInTheDark\" id=\"questionScreen\" style=\"display: block; height: 450px; width: 320px; left: 0px; top: 0px; position: absolute; z-index: 0; background-color: rgb(125, 108, 166);\"><label style=\"margin: 0px; line-height: 1; overflow: hidden; overflow-wrap: break-word; max-width: 320px; border-style: solid; text-rendering: optimizespeed; color: rgb(217, 255, 217); background-color: rgb(99, 89, 130); border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 0px; font-family: Tahoma, Geneva, sans-serif; font-size: 24px; padding: 2px 15px; width: 320px; height: 30px; position: absolute; left: 0px; top: 10px; text-align: center;\" id=\"titleText\">Is your plant OK?</label><label style=\"margin: 0px; line-height: 1; overflow: hidden; overflow-wrap: break-word; max-width: 320px; border-style: solid; text-rendering: optimizespeed; color: rgb(217, 255, 217); background-color: rgba(0, 0, 0, 0); border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 0px; font-family: Tahoma, Geneva, sans-serif; font-size: 15px; padding: 2px 15px; width: 300px; height: 20px; position: absolute; left: 0px; top: 60px;\" id=\"lightQuestion\">How much light does it get?</label><select id=\"light\" style=\"width: 300px; height: 30px; font-size: 15px; margin: 0px; color: rgb(217, 255, 217); background-color: rgb(77, 87, 95); border-style: solid; border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 1px; font-family: Tahoma, Geneva, sans-serif; padding: 0px 10px; position: absolute; left: 10px; top: 85px;\"><option></option><option>low</option><option>medium</option><option>high</option></select><label style=\"margin: 0px; line-height: 1; overflow: hidden; overflow-wrap: break-word; max-width: 320px; border-style: solid; text-rendering: optimizespeed; color: rgb(217, 255, 217); background-color: rgba(0, 0, 0, 0); border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 0px; font-family: Tahoma, Geneva, sans-serif; font-size: 15px; padding: 2px 15px; width: 300px; height: 20px; position: absolute; left: 0px; top: 130px;\" id=\"waterQuestion\">How often do you water it?</label><select id=\"water\" style=\"width: 300px; height: 30px; font-size: 15px; margin: 0px; color: rgb(217, 255, 217); background-color: rgb(77, 87, 95); border-style: solid; border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 1px; font-family: Tahoma, Geneva, sans-serif; padding: 0px 10px; position: absolute; left: 10px; top: 155px;\"><option></option><option>rarely</option><option>sometimes</option><option>often</option></select><label style=\"margin: 0px; line-height: 1; overflow: hidden; overflow-wrap: break-word; max-width: 320px; border-style: solid; text-rendering: optimizespeed; color: rgb(217, 255, 217); background-color: rgba(0, 0, 0, 0); border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 0px; font-family: Tahoma, Geneva, sans-serif; font-size: 15px; padding: 2px 15px; width: 300px; height: 20px; position: absolute; left: 0px; top: 200px;\" id=\"leavesQuestion\">What do the leaves look like?</label><select id=\"leaves\" style=\"width: 300px; height: 30px; font-size: 15px; margin: 0px; color: rgb(217, 255, 217); background-color: rgb(77, 87, 95); border-style: solid; border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 1px; font-family: Tahoma, Geneva, sans-serif; padding: 0px 10px; position: absolute; left: 10px; top: 225px;\"><option></option><option>green</option><option>yellow</option><option>brown</option><option>droopy</option></select><button id=\"checkButton\" style=\"padding: 0px; margin: 0px; border-style: solid; height: 40px; width: 150px; background-color: rgb(217, 255, 217); color: rgb(0, 0, 0); border-color: rgb(94, 255, 94); border-width: 2px; font-family: Tahoma, Geneva, sans-serif; font-size: 17px; position: absolute; left: 85px; top: 285px; border-radius: 0px;\">Check my plant</button><label style=\"margin: 0px; line-height: 1; overflow: hidden; overflow-wrap: break-word; max-width: 320px; border-style: solid; text-align: center; text-rendering: optimizespeed; color: rgb(255, 214, 214); background-color: rgba(0, 0, 0, 0); border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 0px; font-family: Tahoma, Geneva, sans-serif; font-size: 15px; padding: 2px 15px; width: 320px; height: 40px; position: absolute; left: 0px; top: 345px;\" id=\"messageLabel\"></label></div><div class=\"screen\" tabindex=\"1\" data-theme=\"glowInTheDark\" id=\"healthyScreen\" style=\"display: none; height: 450px; width: 320px; left: 0px; top: 0px; position: absolute; z-index: 0; background-color: rgb(125, 108, 166);\"><label style=\"margin: 0px; line-height: 1; overflow: hidden; overflow-wrap: break-word; max-width: 320px; border-style: solid; text-rendering: optimizespeed; color: rgb(217, 255, 217); background-color: rgb(99, 89, 130); border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 0px; font-family: Tahoma, Geneva, sans-serif; font-size: 20px; padding: 4px 15px; width: 320px; height: 50px; position: absolute; left: 0px; top: 10px; text-align: center;\" id=\"healthyTitle\">Your plant looks healthy!</label><img src=\"https://images.code.org/71bf4b8b42c32a12ca0bf253c227f388-image-1791470283003.png\" data-canonical-image-url=\"https://images.code.org/71bf4b8b42c32a12ca0bf253c227f388-image-1791470283003.png\" data-object-fit=\"contain\" id=\"healthyImage\" style=\"height: 150px; width: 150px; border-style: solid; border-width: 0px; border-color: rgb(0, 0, 0); border-radius: 0px; position: absolute; left: 85px; top: 70px; margin: 0px;\"><label style=\"margin: 0px; line-height: 1; overflow: hidden; overflow-wrap: break-word; max-width: 320px; border-style: solid; text-rendering: optimizespeed; color: rgb(217, 255, 217); background-color: rgba(0, 0, 0, 0); border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 0px; font-family: Tahoma, Geneva, sans-serif; font-size: 17px; padding: 2px 15px; width: 300px; height: 20px; position: absolute; left: 0px; top: 230px;\" id=\"healthyTipTitle\">A tip for you:</label><label style=\"margin: 0px; line-height: 1.3; overflow: hidden; overflow-wrap: break-word; max-width: 320px; border-style: solid; text-rendering: optimizespeed; color: rgb(217, 255, 217); background-color: rgb(99, 89, 130); border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 0px; font-family: Tahoma, Geneva, sans-serif; font-size: 15px; padding: 10px 15px; width: 300px; height: 115px; position: absolute; left: 10px; top: 255px; \" id=\"healthyTip\"></label><button id=\"healthyStartOver\" style=\"padding: 0px; margin: 0px; border-style: solid; height: 40px; width: 150px; background-color: rgb(217, 255, 217); color: rgb(0, 0, 0); border-color: rgb(94, 255, 94); border-width: 2px; font-family: Tahoma, Geneva, sans-serif; font-size: 17px; position: absolute; left: 85px; top: 390px; border-radius: 0px;\">Start over</button></div><div class=\"screen\" tabindex=\"1\" data-theme=\"glowInTheDark\" id=\"thirstyScreen\" style=\"display: none; height: 450px; width: 320px; left: 0px; top: 0px; position: absolute; z-index: 0; background-color: rgb(125, 108, 166);\"><label style=\"margin: 0px; line-height: 1; overflow: hidden; overflow-wrap: break-word; max-width: 320px; border-style: solid; text-rendering: optimizespeed; color: rgb(217, 255, 217); background-color: rgb(99, 89, 130); border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 0px; font-family: Tahoma, Geneva, sans-serif; font-size: 20px; padding: 4px 15px; width: 320px; height: 50px; position: absolute; left: 0px; top: 10px; text-align: center;\" id=\"thirstyTitle\">Your plant might need more water.</label><img src=\"https://images.code.org/da917acfe8c333949b38bc7c9c8d9cdc-image-1791470291056.png\" data-canonical-image-url=\"https://images.code.org/da917acfe8c333949b38bc7c9c8d9cdc-image-1791470291056.png\" data-object-fit=\"contain\" id=\"thirstyImage\" style=\"height: 150px; width: 150px; border-style: solid; border-width: 0px; border-color: rgb(0, 0, 0); border-radius: 0px; position: absolute; left: 85px; top: 70px; margin: 0px;\"><label style=\"margin: 0px; line-height: 1; overflow: hidden; overflow-wrap: break-word; max-width: 320px; border-style: solid; text-rendering: optimizespeed; color: rgb(217, 255, 217); background-color: rgba(0, 0, 0, 0); border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 0px; font-family: Tahoma, Geneva, sans-serif; font-size: 17px; padding: 2px 15px; width: 300px; height: 20px; position: absolute; left: 0px; top: 230px;\" id=\"thirstyTipTitle\">A tip for you:</label><label style=\"margin: 0px; line-height: 1.3; overflow: hidden; overflow-wrap: break-word; max-width: 320px; border-style: solid; text-rendering: optimizespeed; color: rgb(217, 255, 217); background-color: rgb(99, 89, 130); border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 0px; font-family: Tahoma, Geneva, sans-serif; font-size: 15px; padding: 10px 15px; width: 300px; height: 115px; position: absolute; left: 10px; top: 255px; \" id=\"thirstyTip\"></label><button id=\"thirstyStartOver\" style=\"padding: 0px; margin: 0px; border-style: solid; height: 40px; width: 150px; background-color: rgb(217, 255, 217); color: rgb(0, 0, 0); border-color: rgb(94, 255, 94); border-width: 2px; font-family: Tahoma, Geneva, sans-serif; font-size: 17px; position: absolute; left: 85px; top: 390px; border-radius: 0px;\">Start over</button></div><div class=\"screen\" tabindex=\"1\" data-theme=\"glowInTheDark\" id=\"overwateredScreen\" style=\"display: none; height: 450px; width: 320px; left: 0px; top: 0px; position: absolute; z-index: 0; background-color: rgb(125, 108, 166);\"><label style=\"margin: 0px; line-height: 1; overflow: hidden; overflow-wrap: break-word; max-width: 320px; border-style: solid; text-rendering: optimizespeed; color: rgb(217, 255, 217); background-color: rgb(99, 89, 130); border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 0px; font-family: Tahoma, Geneva, sans-serif; font-size: 20px; padding: 4px 15px; width: 320px; height: 50px; position: absolute; left: 0px; top: 10px; text-align: center;\" id=\"overwateredTitle\">Your plant might be getting too much water.</label><img src=\"https://images.code.org/52744d439340bec901cb5d0cf8a933d9-image-1791470278179.png\" data-canonical-image-url=\"https://images.code.org/52744d439340bec901cb5d0cf8a933d9-image-1791470278179.png\" data-object-fit=\"contain\" id=\"overwateredImage\" style=\"height: 150px; width: 150px; border-style: solid; border-width: 0px; border-color: rgb(0, 0, 0); border-radius: 0px; position: absolute; left: 85px; top: 70px; margin: 0px;\"><label style=\"margin: 0px; line-height: 1; overflow: hidden; overflow-wrap: break-word; max-width: 320px; border-style: solid; text-rendering: optimizespeed; color: rgb(217, 255, 217); background-color: rgba(0, 0, 0, 0); border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 0px; font-family: Tahoma, Geneva, sans-serif; font-size: 17px; padding: 2px 15px; width: 300px; height: 20px; position: absolute; left: 0px; top: 230px;\" id=\"overwateredTipTitle\">A tip for you:</label><label style=\"margin: 0px; line-height: 1.3; overflow: hidden; overflow-wrap: break-word; max-width: 320px; border-style: solid; text-rendering: optimizespeed; color: rgb(217, 255, 217); background-color: rgb(99, 89, 130); border-color: rgb(255, 255, 255); border-radius: 0px; border-width: 0px; font-family: Tahoma, Geneva, sans-serif; font-size: 15px; padding: 10px 15px; width: 300px; height: 115px; position: absolute; left: 10px; top: 255px; \" id=\"overwateredTip\"></label><button id=\"overwateredStartOver\" style=\"padding: 0px; margin: 0px; border-style: solid; height: 40px; width: 150px; background-color: rgb(217, 255, 217); color: rgb(0, 0, 0); border-color: rgb(94, 255, 94); border-width: 2px; font-family: Tahoma, Geneva, sans-serif; font-size: 17px; position: absolute; left: 85px; top: 390px; border-radius: 0px;\">Start over</button></div></div>",
