  "lessons": [
    {
      "key": "Teaching Designing Reliable Apps with AI and APIs",
      "name": "Teaching Designing Reliable Apps with AI and APIs",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": false,
      "relative_position": 1,
      "properties": {
        "overview": "\n#### **By the end of this professional learning module, you will be able to:**\n\n* #### Use JavaScript to get data from an external API and show it in a web app.\n\n* #### Write asynchronous code with `async/await` to load data without freezing the page.\n\n* #### Compare using local data versus API data and explain when each makes sense.",
        "student_overview": "\n#### **By the end of this professional learning module, you will be able to:**\n\n* #### Use JavaScript to get data from an external API and show it in a web app.\n\n* #### Write asynchronous code with `async/await` to load data without freezing the page.\n\n* #### Compare using local data versus API data and explain when each makes sense."
      },
      "seeding_key": {
        "lesson.key": "Teaching Designing Reliable Apps with AI and APIs",
        "lesson_group.key": "",
        "script.name": "self-paced-pl-teaching-designing-reliable-apps-with-ai-and-apis-2026"
      }
    }
  ],
