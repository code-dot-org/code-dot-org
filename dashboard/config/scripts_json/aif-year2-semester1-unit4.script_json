    {
      "chapter": 11,
      "position": 1,
      "activity_section_position": 1,
      "assessment": false,
      "properties": {
        "progression": "Regression Project"
      },
      "bonus": false,
      "seeding_key": {
        "script_level.level_keys": [
          "aif-y2-making-predictions-lesson6-level1-2026"
        ],
