      }
    },
    {
      "key": "overfitting",
      "word": "overfitting",
      "definition": "when a model memorizes the training data’s exact details and noise instead of learning the general pattern, so it performs poorly on new data",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "overfitting"
      }
    },
    {
