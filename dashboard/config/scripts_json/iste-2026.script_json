    },
    {
      "key": "ac90ad1e-8cb6-4736-9912-2abab98e06f6",
      "properties": {
        "description": "Explain how prompts, context, and training-data patterns can shape AI outputs."
      },
      "seeding_key": {
        "lesson.key": "Intro to Web Lab",
