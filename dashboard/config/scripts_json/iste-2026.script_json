    {
      "key": "5a6c0ee7-521c-4cb4-93ce-e5f22d53ba56",
      "properties": {
        "description": "Evaluate whether an AI-assisted webpage matches the intended goal and make thoughtful revisions."
      },
      "seeding_key": {
        "lesson.key": "Intro to Web Lab",
        "objective.key": "5a6c0ee7-521c-4cb4-93ce-e5f22d53ba56"
