  "objectives": [
    {
      "key": "5a6c0ee7-521c-4cb4-93ce-e5f22d53ba56",
      "properties": {
        "description": "Recognize how established instructional best practices — inquiry, collaboration, communication, choice, differentiation, and reflection — remain central to learning even when AI is present."
      },
      "seeding_key": {
        "lesson.key": "Intro to Web Lab",
        "objective.key": "5a6c0ee7-521c-4cb4-93ce-e5f22d53ba56"
      }
    },
    {
      "key": "ac90ad1e-8cb6-4736-9912-2abab98e06f6",
      "properties": {
        "description": "Describe how AI can support student creativity and artifact creation without replacing student thinking, judgment, or voice."
      },
      "seeding_key": {
        "lesson.key": "Intro to Web Lab",
        "objective.key": "ac90ad1e-8cb6-4736-9912-2abab98e06f6"
      }
    },
    {
      "key": "b152c850-392b-495e-950b-a3653c912df7",
      "properties": {
        "description": "Use the Pilot / Co-Pilot / Passenger framework to describe their own relationship with AI during a creative task."
      },
      "seeding_key": {
        "lesson.key": "Intro to Web Lab",
        "objective.key": "b152c850-392b-495e-950b-a3653c912df7"
      }
    },
    {
      "key": "c65c1bd1-71ae-4509-a41d-53cd61d57349",
      "properties": {
        "description": "Identify how AI assumptions and training data can produce biased or incomplete outputs."
      },
      "seeding_key": {
        "lesson.key": "Intro to Web Lab",
        "objective.key": "c65c1bd1-71ae-4509-a41d-53cd61d57349"
      }
    },
    {
      "key": "e0404d79-819f-4724-956a-c956df929f41",
      "properties": {
        "description": "Explain how AI generates output based on patterns and why context improves results."
      },
      "seeding_key": {
        "lesson.key": "Intro to Web Lab",
        "objective.key": "e0404d79-819f-4724-956a-c956df929f41"
      }
    }
  ],
