  "activity_sections": [
    {
      "key": "3d4e8ccf-897b-4b0f-8f32-b8868d67855e",
      "position": 1,
      "properties": {
        "progression_name": "Pre-Assessment"
      },
      "seeding_key": {
        "activity_section.key": "3d4e8ccf-897b-4b0f-8f32-b8868d67855e",
        "lesson_activity.key": "ac6d1f96-9927-4f16-a7d4-629ed93d530e"
      }
    },
    {
      "key": "dd494682-01be-4547-ad32-38b9a56c206a",
      "position": 1,
      "properties": {
        "description": "<i class=\"fa-solid fa-bullseye-arrow\"></i> **Goal of this Activity:** Introduce students to a task for which machine learning is well-suited, but logic-based AI is not.\n\n<i class=\"fa fa-check-square-o\" aria-hidden=\"true\"></i> **Do This:** Introduce the Cat or Dog? activity, in which students guess whether a doodle represents a cat or a dog.",
        "duration": "10",
        "name": "Cat or Dog?"
      },
      "seeding_key": {
        "activity_section.key": "dd494682-01be-4547-ad32-38b9a56c206a",
        "lesson_activity.key": "e8d63a02-a271-4da9-b8c2-fc23cb2a198b"
      }
    },
    {
      "key": "5f805f7a-ec5f-4d88-afee-535d5227f5de",
      "position": 2,
      "properties": {
        "description": "Let’s kick things off today with a quick game: Cat or Dog? Your job is to look at a doodle and determine whether it’s a cat or a dog. Ready?",
        "remarks": true
      },
      "seeding_key": {
        "activity_section.key": "5f805f7a-ec5f-4d88-afee-535d5227f5de",
        "lesson_activity.key": "e8d63a02-a271-4da9-b8c2-fc23cb2a198b"
      }
    },
    {
      "key": "c77c0ac0-0b19-477c-b491-b7ec3ae88609",
      "position": 3,
      "properties": {
        "description": "Is this a cat or a dog?",
        "remarks": true
      },
      "seeding_key": {
        "activity_section.key": "c77c0ac0-0b19-477c-b491-b7ec3ae88609",
        "lesson_activity.key": "e8d63a02-a271-4da9-b8c2-fc23cb2a198b"
      }
    },
    {
      "key": "9369f68a-93e5-46d2-aa06-962e2fb27ec9",
      "position": 4,
      "properties": {
        "description": "<i class=\"fa fa-check-square-o\" aria-hidden=\"true\"></i> **Do This:** Ask students to raise their hands if they think if the doodle represents a dog. Ask students to raise their hands if they think the doodle represents a cat.\n\n<i class=\"fa fa-check-square-o\" aria-hidden=\"true\"></i> **Do This:** Reveal that the doodle represents a dog."
      },
      "seeding_key": {
        "activity_section.key": "9369f68a-93e5-46d2-aa06-962e2fb27ec9",
        "lesson_activity.key": "e8d63a02-a271-4da9-b8c2-fc23cb2a198b"
      }
    },
