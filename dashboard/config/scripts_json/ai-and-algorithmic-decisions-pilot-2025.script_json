      }
    },
    {
      "key": "4ee873b5-1a52-4331-8605-809170089cc4",
      "position": 2,
      "properties": {
        "name": "End of Lesson Survey",
        "progression_name": "End of Lesson Survey"
      },
      "seeding_key": {
        "activity_section.key": "4ee873b5-1a52-4331-8605-809170089cc4",
