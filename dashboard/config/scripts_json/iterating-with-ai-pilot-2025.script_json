      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "loop_variable"
      }
    },
    {
      "key": "off_by_one_error",
      "word": "off-by-one error",
      "definition": "a programming mistake where a loop runs one time too many or one time too few",
      "properties": {
      },
      "seeding_key": {
