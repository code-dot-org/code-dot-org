      }
    },
    {
      "key": "pipeline",
      "word": "pipeline",
      "definition": "a series of steps that you run in order, where the output from one step becomes the input to the next",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "pipeline"
      }
    },
    {
      "key": "pure_function",
      "word": "pure function",
      "definition": "a function that always returns the same output for the same input and does not change anything outside itself",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "pure_function"
      }
    },
    {
      "key": "side_effect",
      "word": "side effect",
      "definition": "a change that a function causes outside itself, such as modifying external variables, changing an array passed in, updating the screen, or logging to the console",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "side_effect"
      }
    },
    {
      "key": "state_variable",
      "word": "state variable",
      "definition": "a value in a program that tracks where you are so the code knows when to stop or change behavior",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "state_variable"
      }
    },
    {
      "key": "threshold",
