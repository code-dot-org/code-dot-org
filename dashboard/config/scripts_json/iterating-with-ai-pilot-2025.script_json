    {
      "key": "e11e3d1a-478e-4e87-b2c6-182457013a4b",
      "position": 9,
      "properties": {
        "description": "<i class=\"fa fa-desktop\" aria-hidden=\"true\"></i> **Transition:** Direct students to Lesson 7, Level 6 to complete the Check for Understanding on pure vs side-effect methods.\n\n<i class=\"fa fa-refresh\" aria-hidden=\"true\"></i> **Circulate:** Remind students to think about: Do you want a method that returns new data or changes something that already exists?",
        "progression_name": "Check For Understanding",
        "tips": [
          {
            "type": "assessmentOpportunity",
            "markdown": "Use responses on Level 6 to decide whether to briefly re-teach the difference between transforming and mutating data."
          }
        ]
      },
      "seeding_key": {
