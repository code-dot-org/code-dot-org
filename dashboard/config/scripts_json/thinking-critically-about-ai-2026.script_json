    {
      "key": "b48a8b37-06ee-4755-9cb5-443d28aa643b",
      "position": 1,
      "properties": {
        "description": "<i class=\"fa-solid fa-bullseye-arrow\"></i> **Goal of this activity:** Help students reconnect with their previous investigations to prepare for synthesizing their findings into project guidance.\n\n<i class=\"fa fa-comments\" aria-hidden=\"true\"></i> **Discuss:** *What different explorations or mini-lessons did you complete in the last lesson?*\n\n<i class=\"fa fa-lightbulb-o\" aria-hidden=\"true\"></i> **Discussion Goal:** Briefly recap the three explorations and mini-lessons from Lesson 7. Remind students that this is the third day of their project work.\n\n<i class=\"fa fa-check-square-o\" aria-hidden=\"true\"></i> **Do This:** Introduce the lesson objectives.\n\n<i class=\"fa fa-check-square-o\" aria-hidden=\"true\"></i> **Do This:** Introduce the Question of the Day."
      },
      "seeding_key": {
        "activity_section.key": "b48a8b37-06ee-4755-9cb5-443d28aa643b",
        "lesson_activity.key": "cc109b38-4223-45e4-b0dd-441ca7fa4624"
      }
    },
