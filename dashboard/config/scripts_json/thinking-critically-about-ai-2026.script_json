    {
      "key": "7e2cb395-dafb-4cd6-9757-5683626fbaed",
      "position": 7,
      "properties": {
        "description": "Choose one jigsaw learning from your Learning Log and write one or more responses in the KWL chart that reflects your new understanding or new questions.",
        "remarks": true
      },
      "seeding_key": {
        "activity_section.key": "7e2cb395-dafb-4cd6-9757-5683626fbaed",
