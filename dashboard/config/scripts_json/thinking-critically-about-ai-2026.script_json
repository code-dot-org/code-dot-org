    {
      "key": "387a6a8e-b89e-4deb-9554-8d392303c558",
      "position": 1,
      "properties": {
        "description": "<i class=\"fa fa-check-square-o\" aria-hidden=\"true\"></i> **Do This:** Review the lesson objectives.\n\n<i class=\"fa fa-check-square-o\" aria-hidden=\"true\"></i> **Do This:** Review the Question of the Day.\n\n<i class=\"fa fa-check-square-o\" aria-hidden=\"true\"></i> **Do This:** Add one new question that came up while working on the project to the 'Want to Know' section of the KWL Chart."
      },
      "seeding_key": {
