    {
      "key": "artificial_intelligence_ai_",
      "word": "artificial intelligence (AI)",
      "definition": "a computer system that is trained on data to find patterns and make predictions or decisions",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "artificial_intelligence_ai_"
      }
    },
    {
      "key": "bias",
      "word": "bias",
      "definition": "when a person, source, or piece of information favors one side of a topic in a way that is unfair or leaves out important details",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "bias"
      }
    },
    {
      "key": "co_creation",
      "word": "co-creation",
      "definition": "the process of humans and AI working together to produce a creative output",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "co_creation"
      }
    },
    {
      "key": "credible",
      "word": "credible",
      "definition": "a source or information can be trusted because there are good reasons to believe it is accurate or reliable",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "credible"
      }
    },
    {
      "key": "human_oversight",
