      "position": 4,
      "properties": {
        "description": "<i class=\"fa fa-desktop\" aria-hidden=\"true\"></i> **Transition:** Direct students to Lesson 4, Level 2 to complete the End of Lesson Survey.",
        "name": "End of Lesson Survey",
        "progression_name": "End of Lesson Survey"
      },
      "seeding_key": {
        "activity_section.key": "fdc9ab59-9f7f-4881-a8a4-3b3ceaac934c",
