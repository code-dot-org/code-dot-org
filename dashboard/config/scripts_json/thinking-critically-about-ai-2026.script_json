      "position": 1,
      "properties": {
        "description": "<i class=\"fa fa-check-square-o\" aria-hidden=\"true\"></i> **Do This:** Prompt students to take out their Learning Logs and to turn to Milestone 5."
      },
      "seeding_key": {
