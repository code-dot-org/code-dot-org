    {
      "key": "active_filter",
      "word": "active filter",
      "definition": "the current rules that are being applied to a set of data and are clearly shown to the user",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "active_filter"
      }
    },
    {
      "key": "fallback_value",
      "word": "fallback value",
      "definition": "a default shown when data is missing or null",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "fallback_value"
      }
    },
    {
      "key": "filter_bubble",
      "word": "filter bubble",
      "definition": "a situation where algorithms mostly show content that matches what you already like or agree with, and hide other viewpoints or topic",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "filter_bubble"
      }
    },
    {
      "key": "for_loop",
      "word": "for loop",
      "definition": "a loop that repeats a set of steps a specific number of times",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "for_loop"
      }
    },
    {
      "key": "infinite_loop",
      "word": "infinite loop",
      "definition": "a loop that never ends because its condition never becomes false or nothing in the loop can stop it",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "infinite_loop"
      }
    },
    {
      "key": "iteration",
      "word": "iteration",
      "definition": "doing the same set of steps over and over again",
