  "vocabularies": [
    {
      "key": "abstraction",
      "word": "abstraction",
      "definition": "hides complex details and shows only the essential features",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "abstraction"
      }
    },
    {
      "key": "accessibility",
      "word": "accessibility",
      "definition": "the practice of designing products, websites, and spaces so that people with a wide range of abilities, disabilities, and needs can use them fully and independently",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "accessibility"
      }
    },
    {
      "key": "event_handler",
      "word": "event handler",
      "definition": "a block of code that runs in response to an event on a web page element",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "event_handler"
      }
    },
    {
      "key": "event_listener",
      "word": "event listener",
      "definition": "a JavaScript feature that you attach to a web page element to wait for a specific event",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "event_listener"
      }
    },
    {
      "key": "function",
      "word": "function",
      "definition": "a block of reusable code used to perform a single action",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "function"
      }
    },
    {
      "key": "pour_principles",
      "word": "POUR principles",
      "definition": "four guidelines that define what it means for a web app to be fully accessible to all users",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "pour_principles"
      }
    },
    {
      "key": "prompt_engineering",
