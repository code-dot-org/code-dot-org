  "lessons": [
    {
      "key": "Introduction to Teaching AI Foundations (Semester 2)",
      "name": "Introduction to Teaching AI Foundations (Semester 2)",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": false,
      "relative_position": 1,
      "properties": {
        "overview": "\n **By the end of this professional learning module, you will be able to:**\n\n*  Introduce the foundaitonal concepts in the AI Foundations (Semester 2) course.\n*  Understand the basics of web applications and how they support interactive, AI-powered projects.\n*  Understand how to integrate AI tools and concepts into coding lessons to model responsible and creative AI use.\n\n**Suggested Time:** 20 minutes",
        "student_overview": "\n **By the end of this professional learning module, you will be able to:**\n\n*  Introduce the foundaitonal concepts in the AI Foundations (Semester 2) course.\n*  Understand the basics of web applications and how they support interactive, AI-powered projects.\n*  Understand how to integrate AI tools and concepts into coding lessons to model responsible and creative AI use.\n\n**Suggested Time:** 20 minutes"
      },
      "seeding_key": {
