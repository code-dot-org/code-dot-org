    {
      "key": "1c81522b-7332-4223-8956-2fed0b903b28",
      "position": 6,
      "properties": {
        "description": "<i class=\"fa fa-file-text-o\" aria-hidden=\"true\"></i> **Distribute:** Give each student a copy of the Wrapped Project Rubric."
