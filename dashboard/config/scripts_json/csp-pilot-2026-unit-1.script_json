    {
      "key": "e993015a-7931-47a8-ab4f-10c3b90689d8",
      "position": 16,
      "properties": {
        "duration": "5",
        "name": "Wrap Up"
      },
      "seeding_key": {
        "activity_section.key": "e993015a-7931-47a8-ab4f-10c3b90689d8",
