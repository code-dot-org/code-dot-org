    {
      "key": "45b5423a-1538-489d-ae43-6837b73f79cd",
      "position": 2,
      "properties": {
        "description": "<i class=\"fa fa-check-square-o\" aria-hidden=\"true\"></i> **Do This:** Display the Question of the Day. Give students about 30 seconds of silent think time — no partner discussion — then cold-call 3–4 students rapid-fire for a one-sentence answer each. After each response, ask the class \"anything to add to what they said?\" to keep it moving without formal turn-taking.",
        "tips": [
          {
            "type": "teachingTip",
            "markdown": "Keep this fast — the goal is a few different voices, not a full discussion. If the first couple answers already name concatenation and substrings clearly, it's fine to stop early and move to Key Vocabulary rather than pushing for a fourth response."
          }
        ]
      },
      "seeding_key": {
        "activity_section.key": "45b5423a-1538-489d-ae43-6837b73f79cd",
        "lesson_activity.key": "66760c65-56be-48d1-b4d7-137f8d5cdf6a"
      }
    },
    {
      "key": "22204c5a-0b33-42d4-9824-c279c71f43ab",
      "position": 3,
      "properties": {
        "description": "<i class=\"fa fa-check-square-o\" aria-hidden=\"true\"></i> **Do This:** Review the Key Vocabulary."
      },
      "seeding_key": {
        "activity_section.key": "22204c5a-0b33-42d4-9824-c279c71f43ab",
        "lesson_activity.key": "66760c65-56be-48d1-b4d7-137f8d5cdf6a"
      }
