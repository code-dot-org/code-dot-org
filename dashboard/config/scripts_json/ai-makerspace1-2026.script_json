  "lessons": [
    {
      "key": "lesson-1",
      "name": "Hour of AI",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 1,
      "properties": {
        "overview": "In AI Makerspace, students build a website in Web Lab based on their own interests, with AI as a co-creator. They learn to direct AI using the language of web development, check the changes AI makes, and revise their prompts until the site does what they want. A quick Skill Check finds each student’s starting point, then students choose which skill to work on next, so expect your class to be working on different skills at the same time.\n\nNote: This tutorial uses AI features that require verified teacher permissions. See this support article for more information on how to become a verified teacher.",
        "preparation": "- Test out AI Makerspace to ensure familiarity with the platform.\n- Review the introduction video and practice walking students through the steps to co-create with AI.\n- *[Optional]* Find the resources you need to plan, implement, and celebrate the Hour of AI at your school [here](https://csforall.org/en-US/hour-of-ai/how-to/k-12educator)!",
        "student_overview": "Ready to build a website about something you’re interested in? In AI Makerspace, you’ll create it in Web Lab with AI as your co-creator, choosing which skills to learn as you go, like describing your design in real web terms or checking whether AI’s fix actually worked. You’ll finish with a site that’s all yours to share."
      },
      "seeding_key": {
        "lesson.key": "lesson-1",
        "lesson_group.key": "",
        "script.name": "ai-makerspace1-2026"
      }
    }
  ],
