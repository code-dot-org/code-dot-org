  "lessons": [
    {
      "key": "lesson-1",
      "name": "Introduction to WebApps",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": false,
      "relative_position": 1,
      "properties": {
        "overview": "####**By the end of this professional learning module, you will be able to:**\n- Prepare to teach what a web app is and explain how it serves as the foundation for AI-assisted projects.\n- Guide students through human-centered design practices, including developing user personas, defining user problems, and establishing a brand identity.\n- Practice foundational web development skills using AI to build HTML files for structure and CSS files for styling.\n- Support students in visual planning, preparing to introduce sitemaps and wireframes that emphasize accessibility and responsive design.\n\n**Suggested Time:** 60 minutes",
        "student_overview": "####**By the end of this professional learning module, you will be able to:**\n- Prepare to teach what a web app is and explain how it serves as the foundation for AI-assisted projects.\n- Guide students through human-centered design practices, including developing user personas, defining user problems, and establishing a brand identity.\n- Practice foundational web development skills using AI to build HTML files for structure and CSS files for styling.\n- Support students in visual planning, preparing to introduce sitemaps and wireframes that emphasize accessibility and responsive design.\n\n**Suggested Time:** 60 minutes"
      },
      "seeding_key": {
        "lesson.key": "lesson-1",
        "lesson_group.key": "",
        "script.name": "pl-sandbox-aif-sem-2-unit-1"
      }
    }
  ],
