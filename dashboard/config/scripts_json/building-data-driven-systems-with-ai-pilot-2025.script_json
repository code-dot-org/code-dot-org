  "vocabularies": [
    {
      "key": "array",
      "word": "array",
      "definition": "a special kind of variable that stores an ordered list of related values",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "array"
      }
    },
    {
      "key": "bias",
      "word": "bias",
      "definition": "when some people, ideas, or situations are represented more than others in a way that is unfair",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "bias"
      }
    },
    {
      "key": "filter",
      "word": "filter",
      "definition": "a rule or condition that chooses which items from a larger collection are included in a smaller result set",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "filter"
      }
    },
    {
      "key": "pipeline",
      "word": "pipeline",
      "definition": "a series of steps that you run in order, where the output from one step becomes the input to the next",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "pipeline"
      }
    },
    {
      "key": "query",
      "word": "query",
      "definition": "the question or request you send to a computer to get specific information back from a larger set of data",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "query"
      }
    },
    {
      "key": "schema",
      "word": "schema",
      "definition": "a clear, repeatable plan for how each item in a dataset is structured",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "schema"
      }
    }
  ],
