    {
      "key": "6c8a3ab8-d0da-478c-b0fc-5ac5fe340665",
      "position": 5,
      "properties": {
        "progression_name": "End of Lesson Survey"
      },
      "seeding_key": {
        "activity_section.key": "6c8a3ab8-d0da-478c-b0fc-5ac5fe340665",
