  "lessons": [
    {
      "key": "lesson-1",
      "name": "Sorting by Rules",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 1,
      "properties": {
        "overview": "This lesson introduces how choosing features affects the way data is sorted. Taking on the role of data scientists, students sort monster cards using yes/no questions, identify each other’s rules, and solve secret sorting challenges. Through hands-on activities and discussion, students explore how different features produce different classifications and why more data may be needed to identify a rule.",
        "preparation": "- Print and cut one set of monster cards per groups of 2–4 students \n- Print the activity guide: one per student",
        "student_overview": "In this lesson, you take on the role of a data scientist to learn how to use information to sort data. You will practice by sorting monsters and finding secret sorting rules."
      },
      "seeding_key": {
        "lesson.key": "lesson-1",
        "lesson_group.key": "",
        "script.name": "6-12-aid-data-makes-ai-2026"
      }
    },
