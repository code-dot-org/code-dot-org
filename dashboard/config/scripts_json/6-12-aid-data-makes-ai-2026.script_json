  "lessons": [
    {
      "key": "lesson-1",
      "name": "Sorting by Rules",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 1,
      "properties": {
        "overview": "This lesson introduces how choosing features affects the way data is sorted. Taking on the role of data scientists, students sort monster cards using yes/no questions, identify each other’s rules, and solve secret sorting challenges. Through hands-on activities and discussion, students explore how different features produce different classifications and why more data may be needed to identify a rule.",
        "preparation": "- Print and cut one set of monster cards per groups of 2–4 students \n- Print the activity guide: one per student",
        "student_overview": "In this lesson, you take on the role of a data scientist to learn how to use information to sort data. You will practice by sorting monsters and finding secret sorting rules."
      },
      "seeding_key": {
        "lesson.key": "lesson-1",
        "lesson_group.key": "",
        "script.name": "6-12-aid-data-makes-ai-2026"
      }
    },
    {
      "key": "lesson-2",
      "name": "How Does the Model Decide?",
      "absolute_position": 2,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 2,
      "properties": {
        "overview": "In this lesson, students work as data scientists and learn to read a decision tree. A husky-or-wolf model calls a husky a wolf. Its training pictures show the shortcut it found, so students see that a prediction comes from the data. Students then trace monsters from Lesson 1 through a decision tree. In groups, they act out a human decision tree that predicts the wrong group for a platypus, and they propose one question that fixes it. In Recycling Robot Trace, each student traces four items through a tree in Sketch Lab, finds the wrong prediction and adds a question to fix it.",
        "preparation": "- Print the Human Decision Tree Cards (one set for each group: three question cards and 10 animal data cards).\n- Put each group's animal data cards in order, with the platypus card last.\n- Read the Human Decision Tree How to Play sheet and plan a clear space for each group.",
        "student_overview": "How does a decision tree reach an answer? You will follow items through a decision tree, one question at a time, to see how it makes a prediction. Then you'll check the tree's predictions against what each item really is."
      },
      "seeding_key": {
        "lesson.key": "lesson-2",
        "lesson_group.key": "",
        "script.name": "6-12-aid-data-makes-ai-2026"
      }
    },
    {
      "key": "lesson-3",
      "name": "Who Writes the Rules?",
      "absolute_position": 3,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 3,
      "properties": {
        "overview": "Students act as Data Scientists and find out who writes the rules inside a computer system. Pairs first write keyword rules to block spam and keep patching them as new emails get through or get caught by mistake. Then pairs explore a simulated game chat and notice which messages it blocks or hides. Groups sort seven rule cards from the chat into human-written and computer-learned rules, using what they saw in the game as evidence. Students ultimately learn that both human-written and computer-learned rules exist within systems.",
        "purpose": "* Print and cut out the Gaming Chat Rule Cards that students will use in a card sort activity to differentiate human-written and computer-learned rules.",
        "student_overview": "You will act as a Data Scientist and find out who writes the rules inside a computer system. First, you will write rules to block spam from an email inbox. Then you will explore a game chat and notice which messages it blocks or hides based on rules. By the end of the lesson, you will be able to answer: who writes the rules?"
      },
      "seeding_key": {
        "lesson.key": "lesson-3",
        "lesson_group.key": "",
        "script.name": "6-12-aid-data-makes-ai-2026"
      }
    },
