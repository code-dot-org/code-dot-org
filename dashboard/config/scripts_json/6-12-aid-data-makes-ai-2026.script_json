  "learning_goal_evidence_levels": [
    {
      "understanding": 0,
      "teacher_description": "Names a bin without following the questions. The new question is missing, or doesn't connect to the item that went wrong.",
      "ai_prompt": "",
      "seeding_key": {
        "understanding": 0,
        "learning_goal.key": "0ab63f60-52ea-48c9-b59d-a5ada20bc05d",
        "lesson.key": "lesson-2",
        "lesson_group.key": "lessonGroup-2",
        "script.name": "6-12-aid-data-makes-ai-2026"
      }
    },
    {
      "understanding": 1,
      "teacher_description": "The sketch moves each item down the right path. The response names a new question and where it goes in the tree, and it fixes the wrong item.",
      "ai_prompt": "",
      "seeding_key": {
        "understanding": 1,
        "learning_goal.key": "0ab63f60-52ea-48c9-b59d-a5ada20bc05d",
        "lesson.key": "lesson-2",
        "lesson_group.key": "lessonGroup-2",
        "script.name": "6-12-aid-data-makes-ai-2026"
      }
    },
    {
      "understanding": 2,
      "teacher_description": "Also explains why the tree got it wrong: the people who wrote the questions never asked about that feature, so the tree had no way to catch it.",
      "ai_prompt": "",
      "seeding_key": {
        "understanding": 2,
        "learning_goal.key": "0ab63f60-52ea-48c9-b59d-a5ada20bc05d",
        "lesson.key": "lesson-2",
        "lesson_group.key": "lessonGroup-2",
        "script.name": "6-12-aid-data-makes-ai-2026"
      }
    },
    {
      "understanding": 3,
      "teacher_description": "Rare here. Notices the new question might send a different item the wrong way, or that a whole kind of item keeps getting missed.",
      "ai_prompt": "",
      "seeding_key": {
        "understanding": 3,
        "learning_goal.key": "0ab63f60-52ea-48c9-b59d-a5ada20bc05d",
        "lesson.key": "lesson-2",
        "lesson_group.key": "lessonGroup-2",
        "script.name": "6-12-aid-data-makes-ai-2026"
      }
    },
    {
      "understanding": 0,
      "teacher_description": "No missing feature, or names one without saying what the app loses. Blames the app.",
      "ai_prompt": "",
      "seeding_key": {
        "understanding": 0,
        "learning_goal.key": "0b27e257-ef12-4281-b447-bbb0f4e9361b",
        "lesson.key": "lesson-5",
        "lesson_group.key": "lessonGroup-2",
        "script.name": "6-12-aid-data-makes-ai-2026"
      }
    },
    {
      "understanding": 1,
      "teacher_description": "Names a specific missing feature and connects it to a mistake the app could make.",
      "ai_prompt": "",
      "seeding_key": {
        "understanding": 1,
        "learning_goal.key": "0b27e257-ef12-4281-b447-bbb0f4e9361b",
        "lesson.key": "lesson-5",
        "lesson_group.key": "lessonGroup-2",
        "script.name": "6-12-aid-data-makes-ai-2026"
      }
    },
    {
      "understanding": 2,
      "teacher_description": "Also names the assumption behind the choice.",
      "ai_prompt": "",
      "seeding_key": {
        "understanding": 2,
        "learning_goal.key": "0b27e257-ef12-4281-b447-bbb0f4e9361b",
        "lesson.key": "lesson-5",
        "lesson_group.key": "lessonGroup-2",
        "script.name": "6-12-aid-data-makes-ai-2026"
      }
    },
    {
      "understanding": 3,
      "teacher_description": "Names whose idea of \"clean\" the dataset reflects and how someone else would build it differently.",
      "ai_prompt": "",
      "seeding_key": {
        "understanding": 3,
        "learning_goal.key": "0b27e257-ef12-4281-b447-bbb0f4e9361b",
        "lesson.key": "lesson-5",
        "lesson_group.key": "lessonGroup-2",
        "script.name": "6-12-aid-data-makes-ai-2026"
      }
    },
    {
      "understanding": 0,
      "teacher_description": "Apologizes or repeats the complaint.",
      "ai_prompt": "",
      "seeding_key": {
        "understanding": 0,
        "learning_goal.key": "3e77ea3a-aaba-40e4-80a0-0ea5ee891f38",
        "lesson.key": "lesson-10",
        "lesson_group.key": "lessonGroup-2",
        "script.name": "6-12-aid-data-makes-ai-2026"
      }
    },
    {
      "understanding": 1,
      "teacher_description": "Describes what the app did to the student, maybe that it happens to others too, but not why.",
      "ai_prompt": "",
      "seeding_key": {
        "understanding": 1,
        "learning_goal.key": "3e77ea3a-aaba-40e4-80a0-0ea5ee891f38",
        "lesson.key": "lesson-10",
        "lesson_group.key": "lessonGroup-2",
        "script.name": "6-12-aid-data-makes-ai-2026"
      }
    },
    {
      "understanding": 2,
      "teacher_description": "Explains how the model decides, shows it happens to a group (not a one-time glitch), ties it to a decision a person made, and suggests a fix that matches the cause.",
      "ai_prompt": "",
      "seeding_key": {
        "understanding": 2,
        "learning_goal.key": "3e77ea3a-aaba-40e4-80a0-0ea5ee891f38",
        "lesson.key": "lesson-10",
        "lesson_group.key": "lessonGroup-2",
