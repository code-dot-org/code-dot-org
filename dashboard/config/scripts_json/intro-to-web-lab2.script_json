  "lessons": [
    {
      "key": "Web Design",
      "name": "Intro to Web Lab 2",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 1,
      "properties": {
        "overview": "This self-paced lesson introduces students to building webpages in Web Lab, working with AI Tutor as an assistant and collaborative partner. Students write a vision, use AI to generate a first draft, learn to read the HTML and CSS behind the page, fix small pieces of code with their own hands, and return to iterate on their own page. By the end, students will have built a complete webpage that reflects their own creative decisions, can read the basic anatomy of the code behind it, and have developed a working relationship with AI."
      },
      "seeding_key": {
        "lesson.key": "Web Design",
        "lesson_group.key": "",
        "script.name": "intro-to-web-lab2"
      }
    }
  ],
