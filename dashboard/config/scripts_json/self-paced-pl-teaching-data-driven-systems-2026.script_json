  "lessons": [
    {
      "key": "Teaching Data-Driven Systems",
      "name": "Teaching Data-Driven Systems",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": false,
      "relative_position": 1,
      "properties": {
        "overview": "#### **By the end of this professional learning module, you will be able to:**\n\n* #### Explain how arrays, objects, and schemas organize real-world data and support clear, predictable program design\n* #### Model core data-structure skills in Web Lab\n* #### Teach common array and object operations\n* #### Guide students in using AI-generated scaffolds responsibly, emphasizing accountability for both data choices and code\n\n#### **Suggested Time:** 75 minutes",
        "student_overview": "#### **By the end of this professional learning module, you will be able to:**\n\n* #### Explain how arrays, objects, and schemas organize real-world data and support clear, predictable program design\n* #### Model core data-structure skills in Web Lab\n* #### Teach common array and object operations\n* #### Guide students in using AI-generated scaffolds responsibly, emphasizing accountability for both data choices and code\n\n#### **Suggested Time:** 75 minutes"
      },
      "seeding_key": {
        "lesson.key": "Teaching Data-Driven Systems",
        "lesson_group.key": "",
        "script.name": "self-paced-pl-teaching-data-driven-systems-2026"
