  "lessons": [
    {
      "key": "lesson-1",
      "name": "hoai2026-dev-lesson",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 1,
      "properties": {
        "background": "dark",
        "overview": "In this Hour of AI lesson, students create their own quest, a game with a goal, one part at a time. They can use AI to make the art, judging each image against their own vision, and get a glimpse into how AI makes images. Students will use block-based code to decide what happens when the player reaches an object or when the characters meet, practicing decomposition and event-based thinking. Because the image generation is a simulation, students can explore safely.",
        "preparation": "- Test out Quest Builder to ensure familiarity with the platform.\n- Review the introduction video and practice walking students through the steps to prompt AI and modify code.\n- Prepare discussion prompts that help students connect with the opportunities and risks of using AI.\n- *[Optional]* Find the resources you need to plan, implement, and celebrate the Hour of AI at your school [here](https://csforall.org/en-US/hour-of-ai/how-to/k-12educator)!",
        "student_overview": "Ready to build your own quest? In Quest Builder, you’ll make a game with a hero, treasure, and a world you design, then use code to decide what happens when the player reachers an important object or when the characters meet. Tell AI what to make, check that each image fits your idea, or draw your own. Then play the quest you built!"
      },
      "seeding_key": {
        "lesson.key": "lesson-1",
        "lesson_group.key": "",
        "script.name": "hoai2026-dev"
      }
    }
  ],
