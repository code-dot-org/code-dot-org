  "vocabularies": [
    {
      "key": "input",
      "word": "Input",
      "definition": "data that are sent to a computer for processing by a program. Can come in a variety of forms, such as tactile interaction, audio, visuals, or text.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "input"
      }
    },
    {
      "key": "output",
      "word": "Output",
      "definition": "any data that are sent from a program to a device. Can come in a variety of forms, such as tactile interaction, audio, visuals, or text.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "output"
      }
    },
    {
      "key": "user_interface",
      "word": "User Interface",
      "definition": "the inputs and outputs that allow a user to interact with a piece of software. User interfaces can include a variety of forms such as buttons, menus, images, text, and graphics.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "user_interface"
      }
    }
  ],
