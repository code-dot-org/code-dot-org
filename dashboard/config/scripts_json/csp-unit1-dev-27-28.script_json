    {
      "key": "2069d12b-ad1b-4223-afc5-5589b95b4810",
      "position": 2,
      "properties": {
        "description": "<i class=\"fa fa-check-square-o\" aria-hidden=\"true\"></i> **Do This:** Review the Question of the Day and give students a moment to just think about what they learned today."
      },
      "seeding_key": {
        "activity_section.key": "2069d12b-ad1b-4223-afc5-5589b95b4810",
        "lesson_activity.key": "6f8f585f-6855-45b5-8171-9ef95f4d9383"
