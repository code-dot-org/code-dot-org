      },
      "seeding_key": {
        "activity_section.key": "34ee3761-82bf-49a1-83b4-7a377b9b311f",
        "lesson_activity.key": "134853de-ed83-451f-9ecd-12439c04caf0"
      }
    },
    {
      "key": "0a51de34-0718-425a-ac1a-cbda16e36df8",
      "position": 12,
      "properties": {
        "progression_name": "More Shades of Color"
      },
      "seeding_key": {
        "activity_section.key": "0a51de34-0718-425a-ac1a-cbda16e36df8",
