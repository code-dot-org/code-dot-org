  "vocabularies": [
    {
      "key": "abstraction",
      "word": "Abstraction",
      "definition": "the process of hiding complex background details so you can focus on working with simpler, high-level ideas",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "abstraction"
      }
    },
    {
      "key": "automatic_input",
      "word": "Automatic Input",
      "definition": "information a device collects on its own, without the user typing, tapping, or speaking.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "automatic_input"
      }
    },
    {
      "key": "binary_number",
      "word": "Binary Number",
      "definition": "a base 2 number with two possible different digits",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "binary_number"
      }
    },
    {
      "key": "bit",
      "word": "Bit",
      "definition": "A contraction of \"Binary Digit\"; the single unit of information in a computer, typically represented as a 0 or 1",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "bit"
      }
    },
    {
      "key": "byte",
      "word": "Byte",
      "definition": "8 bits",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "byte"
      }
    },
    {
      "key": "decimal_number",
      "word": "Decimal Number",
      "definition": "a base 10 number with ten possible different digits",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "decimal_number"
      }
    },
    {
      "key": "edge_case",
      "word": "Edge Case",
      "definition": "an unusual or unexpected situation that an app must still handle correctly, such as losing an internet connection.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "edge_case"
      }
    },
    {
      "key": "hidden_output",
      "word": "Hidden Output",
      "definition": "an action an app performs that the user does not see, such as saving data or sending it to a server.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "hidden_output"
      }
    },
    {
      "key": "input",
      "word": "Input",
      "definition": "data that are sent to a computer for processing by a program. Can come in a variety of forms, such as tactile interaction, audio, visuals, or text.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "input"
      }
    },
    {
      "key": "output",
      "word": "Output",
      "definition": "any data that are sent from a program to a device. Can come in a variety of forms, such as tactile interaction, audio, visuals, or text.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "output"
      }
    },
    {
      "key": "overflow_error",
      "word": "Overflow Error",
      "definition": "Error from attempting to represent a number that is too large.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "overflow_error"
      }
    },
    {
      "key": "round_off_error",
      "word": "Round-off Error",
      "definition": "Error from attempting to represent a number that is too precise. The value is rounded.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "round_off_error"
      }
    },
    {
      "key": "user_input",
      "word": "User Input",
      "definition": "information a user intentionally provides to a device, such as by typing, tapping, or speaking.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "user_input"
      }
    }
  ],
