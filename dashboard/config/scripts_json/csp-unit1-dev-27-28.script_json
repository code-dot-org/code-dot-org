    {
      "key": "6ed3feab-fd91-4d3c-9e66-53dc8a7a19e2",
      "position": 13,
      "properties": {
        "progression_name": "Pixelation Widget: Color"
      },
      "seeding_key": {
        "activity_section.key": "6ed3feab-fd91-4d3c-9e66-53dc8a7a19e2",
        "lesson_activity.key": "134853de-ed83-451f-9ecd-12439c04caf0"
      }
