  "vocabularies": [
    {
      "key": "abstraction",
      "word": "Abstraction",
      "definition": "the process of hiding complex background details so you can focus on working with simpler, high-level ideas",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "abstraction"
      }
    },
    {
      "key": "ai_system",
      "word": "AI System",
      "definition": "a computer system that takes in data, uses a model to find patterns, and produces an output such as a prediction, recommendation, decision, or new content.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "ai_system"
      }
    },
    {
      "key": "algorithm",
      "word": "Algorithm",
      "definition": "a finite set of instructions that accomplish a task. There are usually many algorithms to solve the same problem.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "algorithm"
      }
    },
    {
      "key": "attribution",
      "word": "Attribution",
      "definition": "Giving credit to the original creator of content when required.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "attribution"
      }
    },
    {
      "key": "automatic_input",
      "word": "Automatic Input",
      "definition": "information a device collects on its own, without the user typing, tapping, or speaking.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "automatic_input"
      }
    },
    {
      "key": "bias",
      "word": "Bias",
      "definition": "When an app consistently favors certain people, values, or outcomes over others.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "bias"
      }
    },
    {
      "key": "binary_number",
      "word": "Binary Number",
      "definition": "a base 2 number with two possible different digits",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "binary_number"
      }
    },
    {
      "key": "bit",
      "word": "Bit",
      "definition": "A contraction of \"Binary Digit\"; the single unit of information in a computer, typically represented as a 0 or 1",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "bit"
      }
    },
    {
      "key": "byte",
      "word": "Byte",
      "definition": "8 bits",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "byte"
      }
    },
    {
      "key": "data_bias",
      "word": "Data bias",
      "definition": "when the data used to train or inform an app leaves out, or does not represent, the people and situations the app is meant to serve.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "data_bias"
      }
    },
    {
      "key": "decimal_number",
      "word": "Decimal Number",
      "definition": "a base 10 number with ten possible different digits",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "decimal_number"
      }
    },
    {
      "key": "deepfake",
      "word": "Deepfake",
      "definition": "A realistic AI-generated image, audio, or video that may be mistaken for authentic media.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "deepfake"
      }
    },
    {
      "key": "disclosure",
      "word": "Disclosure",
      "definition": "Letting people know when AI was used to create or change content, so they can decide how much to trust it.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "disclosure"
      }
    },
    {
      "key": "edge_case",
      "word": "Edge Case",
      "definition": "an unusual or unexpected situation that an app must still handle correctly, such as losing an internet connection.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "edge_case"
      }
    },
    {
      "key": "generative_ai",
      "word": "Generative AI",
      "definition": "A type of AI that creates new content, like text, images, music, or code, based on patterns it has learned from examples.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "generative_ai"
      }
    },
    {
      "key": "hidden_output",
      "word": "Hidden Output",
      "definition": "an action an app performs that the user does not see, such as saving data or sending it to a server.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "hidden_output"
      }
    },
    {
      "key": "input",
      "word": "Input",
      "definition": "data that are sent to a computer for processing by a program. Can come in a variety of forms, such as tactile interaction, audio, visuals, or text.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "input"
      }
    },
    {
      "key": "license",
      "word": "License",
      "definition": "The permissions and rules that govern how content can be used or shared.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "license"
      }
    },
    {
      "key": "llm_large_language_model_",
      "word": "LLM (large language model)",
      "definition": "A generative AI tool that creates text by predicting likely sequences of words, based on patterns learned from large amounts of text.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "llm_large_language_model_"
      }
    },
    {
      "key": "model",
      "word": "Model",
      "definition": "the part of an AI system that turns inputs into outputs. A model can follow rules people write, or learn patterns from data.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "model"
      }
    },
    {
      "key": "model_drift",
      "word": "Model Drift",
      "definition": "when a model's performance changes over time because the world it's used in changes, but the model doesn't.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "model_drift"
      }
    },
    {
      "key": "output",
      "word": "Output",
      "definition": "any data that are sent from a program to a device. Can come in a variety of forms, such as tactile interaction, audio, visuals, or text.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "output"
      }
    },
    {
      "key": "overflow_error",
      "word": "Overflow Error",
      "definition": "Error from attempting to represent a number that is too large.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "overflow_error"
      }
    },
    {
      "key": "problem",
      "word": "Problem",
      "definition": "a general description of a task that can (or cannot) be solved with an algorithm",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "problem"
      }
    },
    {
      "key": "program",
      "word": "Program",
      "definition": "a collection of programming statements",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "program"
      }
    },
    {
      "key": "programming_statement",
      "word": "Programming Statement",
      "definition": "a command or instruction",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "programming_statement"
      }
    },
    {
      "key": "round_off_error",
      "word": "Round-off Error",
      "definition": "Error from attempting to represent a number that is too precise. The value is rounded.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "round_off_error"
      }
    },
    {
      "key": "sequencing",
      "word": "Sequencing",
      "definition": "putting steps in an order",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "sequencing"
      }
    },
    {
      "key": "sequential_programming",
      "word": "Sequential Programming",
      "definition": "when program statements run in order, from top to bottom",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "sequential_programming"
      }
    },
    {
      "key": "transparency_statement",
      "word": "Transparency Statement",
      "definition": "describes a system's purpose, training data, and known limits, so users can decide when to trust it.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "transparency_statement"
      }
    },
    {
      "key": "user_input",
      "word": "User Input",
      "definition": "information a user intentionally provides to a device, such as by typing, tapping, or speaking.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "user_input"
      }
    }
  ],
