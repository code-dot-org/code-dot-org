      "properties": {
        "description": "8. Design a Status Message\n9. Build Status States\n10. Completed Level: designing-reliable-apps-lesson11-level9-2026\n11. Run a Reliability Test \n12. CFU - Milestone 3 Reflection\n",
        "progression_name": "Milestone 3"
      },
      "seeding_key": {
