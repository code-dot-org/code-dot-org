      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "mood_boarding"
      }
    },
    {
      "key": "pour_principles",
      "word": "POUR principles",
      "definition": "a framework for thinking about accessibility: Perceivable, Operable, Understandable, Robust",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "pour_principles"
      }
    },
    {
      "key": "problem_statement",
      "word": "problem statement",
      "definition": "clearly explains what a user needs and why it matters, without jumping to a solution",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "problem_statement"
      }
    },
    {
      "key": "prompt_engineering",
      "word": "prompt engineering",
      "definition": "the process of designing, refining, and optimizing prompts given to AI models to achieve desired outputs",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "prompt_engineering"
      }
    },
    {
      "key": "responsiveness",
      "word": "responsiveness",
      "definition": "the practice of designing and developing websites so that their layouts adapt smoothly to different screen sizes and devices, ensuring content is usable and looks good everywhere",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "responsiveness"
      }
    },
    {
      "key": "site_map",
      "word": "site map",
      "definition": "shows how web pages are organized and connected",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "site_map"
      }
    },
    {
      "key": "style_sheet",
      "word": "style sheet",
      "definition": "a file that controls a webpage’s look using colors, fonts, spacing, and layout",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "style_sheet"
      }
    },
    {
      "key": "user_experience",
      "word": "user experience",
      "definition": "the overall experience a person has when interacting with a product, system, or service",
