    {
      "key": "6b725c1f-9ed3-4d4f-ae1d-ae19767f2c1a",
      "position": 4,
      "properties": {
        "description": "<i class=\"fa fa-desktop\" aria-hidden=\"true\"></i> **Transition:** Direct students to Lesson 3, Level 3 to complete the End of Lesson Survey.",
        "name": "End of Lesson Survey",
        "progression_name": "End of Lesson Survey"
      },
      "seeding_key": {
        "activity_section.key": "6b725c1f-9ed3-4d4f-ae1d-ae19767f2c1a",
        "lesson_activity.key": "7bcc2182-da94-45fb-9a1c-65234227f5f7"
