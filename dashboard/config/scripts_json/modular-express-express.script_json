  "lessons": [
    {
      "key": "Programming with Angry Birds",
      "name": "Programming with Angry Birds",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 1,
      "properties": {
        "creative_commons_license": "Creative Commons BY-NC-SA",
        "overview": "In this **skill-building** lesson, students will develop sequential algorithms to move a bird from one side of a maze to the pig at the other side. To do this they will stack code blocks together in a linear sequence, making them move straight, turn left, or turn right.",
        "preparation": " - Play through the puzzles to find any potential problem areas for your class.\n - (Optional) Pick a couple of puzzles to do as a group with your class. \n",
        "purpose": "In this lesson, students will develop programming and debugging skills on a computer platform. The block-based format of these puzzles help students learn about sequence and concepts, without having to worry about perfecting syntax.",
        "student_overview": "Learn about sequences and algorithms with _Angry Birds_."
      },
      "seeding_key": {
        "lesson.key": "Programming with Angry Birds",
        "lesson_group.key": "lessonGroup-2",
        "script.name": "modular-express-express"
      }
    },
    {
      "key": "Debugging in Maze",
      "name": "Debugging in Maze",
      "absolute_position": 2,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 2,
      "properties": {
        "creative_commons_license": "Creative Commons BY-NC-SA",
        "overview": "In this **skill-building** lesson, students will encounter pre-written code that contains mistakes. They will need to step through the existing code to identify errors.",
        "preparation": " - Play through the puzzles to find any potential problem areas for your class.\n - (Optional) Pick a couple of puzzles to do as a group with your class. \n - Review ***CS Fundamentals Main Activity Tips - Lesson Recommendations**.\n - Review the ***Debugging Guide** from this course's curriculum overview page with the class.\n",
        "purpose": "Students in your class might become frustrated with this lesson because of the essence of debugging. Debugging is a concept that is very important to computer programming. Computer scientists have to get really good at facing the bugs in their own programs. Debugging forces the students to recognize problems and overcome them while building critical thinking and problem solving skills.",
        "student_overview": "Find problems in puzzles and practice your debugging skills."
      },
      "seeding_key": {
        "lesson.key": "Debugging in Maze",
        "lesson_group.key": "lessonGroup-2",
        "script.name": "modular-express-express"
      }
    },
    {
      "key": "Sequencing in Music Lab",
      "name": "Sequencing in Music Lab",
      "absolute_position": 3,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 3,
      "properties": {
        "background": "dark",
        "overview": "In this lesson, students will be exploring the foundational concepts of sequencing and loops in programming as they step into the role of a songwriter using Music Lab. They will learn that computers only follow the instructions given to them in the order specified, emphasizing the importance of clear and logical step-by-step directions. Students will discover how to identify repeating patterns in their code and use loops to make it more efficient. By layering musical sounds and breaking down complex tasks, students will develop problem-solving skills while also gaining insight into how technology is used in music careers to bring creative ideas to life."
      },
      "seeding_key": {
        "lesson.key": "Sequencing in Music Lab",
        "lesson_group.key": "lessonGroup-2",
        "script.name": "modular-express-express"
      }
    },
    {
      "key": "Creating Art with Code",
      "name": "Creating Art with Code",
      "absolute_position": 4,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 4,
      "properties": {
        "creative_commons_license": "Creative Commons BY-NC-SA",
        "overview": "In this **skill-building** lesson, students will take control of the Artist to complete drawings on the screen.",
        "preparation": " - Play through the puzzles to find any potential problem areas for your class.\n - (Optional) Obtain protractors for your class to visualize the angles they must use to complete the puzzles.\n - Print one ***Student Handout** for each student.",
        "purpose": "Building off of the students' previous experience with sequencing, this lesson will work to inspire more creativity with coding. The purpose of this lesson is to solidify knowledge on sequencing by introducing new blocks and goals. In this case, students learn more about pixels and angles using the new blocks, while still practicing their sequencing skills. Also, students will be able to visualize new goals such as coding the Artist to draw a square.",
        "student_overview": "Create beautiful images by programming the Artist."
      },
      "seeding_key": {
        "lesson.key": "Creating Art with Code",
        "lesson_group.key": "lessonGroup-2",
        "script.name": "modular-express-express"
      }
    }
  ],
