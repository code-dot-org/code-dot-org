    },
    {
      "key": "ed39bcd8-8c81-40e2-863c-55c3a86c088c",
      "position": 8,
      "properties": {
        "description": "<i class=\"fa fa-list-alt\" aria-hidden=\"true\"></i> **Display**: Show “Lesson Extras” slide",
        "progression_name": "Lesson Extras"
      },
      "seeding_key": {
        "activity_section.key": "ed39bcd8-8c81-40e2-863c-55c3a86c088c",
