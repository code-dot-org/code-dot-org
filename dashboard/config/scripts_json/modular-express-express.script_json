        "lesson_activity.key": "2232ffb2-92dd-42b6-b1cb-fb337b038282"
      }
    },
    {
      "key": "3d90dda6-a9c6-40d6-969e-c8b2b88f7941",
      "position": 5,
      "properties": {
        "description": "<i class=\"fa fa-list-alt\" aria-hidden=\"true\"></i> **Display**: Show “Level 9 - Practice” slide",
        "progression_name": "Practice"
      },
      "seeding_key": {
        "activity_section.key": "3d90dda6-a9c6-40d6-969e-c8b2b88f7941",
        "lesson_activity.key": "2232ffb2-92dd-42b6-b1cb-fb337b038282"
      }
    },
    {
      "key": "30385641-baef-4815-8476-e5458ae3c8e1",
      "position": 6,
      "properties": {
        "description": "<i class=\"fa fa-list-alt\" aria-hidden=\"true\"></i> **Display**: Show “Level 10 - Prediction” slide",
        "progression_name": "Prediction"
      },
      "seeding_key": {
