      }
    },
    {
      "key": "5b9e8bbf-23ae-4a13-9080-6ec7a0d50a21",
      "position": 7,
      "properties": {
        "description": "<i class=\"fa fa-list-alt\" aria-hidden=\"true\"></i> **Display**: Show “Level 11 - Practice” slide",
        "progression_name": "Practice"
      },
      "seeding_key": {
