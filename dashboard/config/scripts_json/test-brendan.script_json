  "lessons": [
    {
      "key": "intro-web-pages",
      "name": "Your First Pet Fish Web Page",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 1,
      "properties": {
        "generate_outline": "This lesson introduces students to the basic structure of a web page using HTML. Students will learn how to create a simple HTML file, add a title to their page, and display text about their pet fish using paragraphs and headings. By the end, students should be able to create a functional web page with basic information about their pet fish."
      },
      "seeding_key": {
        "lesson.key": "intro-web-pages",
        "lesson_group.key": "outlines",
        "script.name": "test-brendan"
      }
    },
    {
      "key": "images-and-styles",
      "name": "Adding Pictures and Style to Your Pet Fish Page",
      "absolute_position": 2,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 2,
      "properties": {
        "generate_outline": "Building on their first web page, students will learn how to enhance it by adding images of their pet fish using the `<img>` tag. They will also be introduced to basic CSS concepts, such as changing text color and background, to make their page more visually appealing. By the end, students should be able to include images and apply simple styling to their pet fish web page."
      },
      "seeding_key": {
        "lesson.key": "images-and-styles",
        "lesson_group.key": "outlines",
        "script.name": "test-brendan"
      }
    }
  ],
