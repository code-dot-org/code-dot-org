  "lessons": [
    {
      "key": "intro-web-fish",
      "name": "My Pet Fish Webpage: Part 1 - Getting Started",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 1,
      "properties": {
        "generate_outline": "This lesson introduces students to what a web page is and its basic structure using HTML. Students will learn how to create a simple HTML file, add a title to their web page, and include a main heading for their pet fish's name using the <h1> tag. They will also add a paragraph describing their pet fish using the <p> tag. By the end, students will have a basic web page displaying their pet fish's name and a short description."
      },
      "seeding_key": {
        "lesson.key": "intro-web-fish",
        "lesson_group.key": "outlines",
        "script.name": "test-brendan"
      }
    },
    {
      "key": "add-images-fish",
      "name": "My Pet Fish Webpage: Part 2 - Pictures and Personality",
      "absolute_position": 2,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 2,
      "properties": {
        "generate_outline": "Building on the previous lesson, students will enhance their pet fish web page by adding images and more detailed information. This lesson teaches how to insert an image of their pet fish using the <img> tag, including important attributes like src and alt. Students will also add additional descriptive paragraphs to share more about their fish's personality or tank setup. By the end, students will have a more complete web page featuring their pet fish's name, a description, and an image."
      },
      "seeding_key": {
        "lesson.key": "add-images-fish",
        "lesson_group.key": "outlines",
        "script.name": "test-brendan"
      }
    }
  ],
