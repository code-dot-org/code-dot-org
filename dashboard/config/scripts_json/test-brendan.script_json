  "lessons": [
    {
      "key": "intro-2d-graphics",
      "name": "Introduction to 2D Graphics",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 1,
      "properties": {
        "generate_outline": "This lesson introduces students to the concept of 2D graphics and how they are rendered on a computer screen within Web Lab. Students will learn about the coordinate system used in Web Lab, understanding how x and y values determine position. They will practice drawing basic geometric shapes such as rectangles and circles using fundamental drawing commands. By the end, students should be able to accurately position and draw simple shapes on the Web Lab canvas."
      },
      "seeding_key": {
        "lesson.key": "intro-2d-graphics",
        "lesson_group.key": "outlines",
        "script.name": "test-brendan"
      }
    },
    {
      "key": "color-and-lines",
      "name": "Drawing with Color and Lines",
      "absolute_position": 2,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 2,
      "properties": {
        "generate_outline": "Building on the previous lesson, students will now explore how to add color and modify line properties for their 2D graphics in Web Lab. They will learn to set fill colors for shapes and adjust the stroke color and thickness for outlines. Students will apply these new techniques to create more visually engaging and diverse drawings. By the end, they should be able to create colorful shapes with customized borders and lines on the Web Lab canvas."
      },
      "seeding_key": {
        "lesson.key": "color-and-lines",
        "lesson_group.key": "outlines",
        "script.name": "test-brendan"
      }
    }
  ],
