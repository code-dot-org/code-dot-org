  "learning_goal_evidence_levels": [
    {
      "understanding": 0,
      "teacher_description": "Student’s answer is nonexistent or unrelated.",
      "ai_prompt": "",
      "seeding_key": {
        "understanding": 0,
        "learning_goal.key": "32ffe368-be0f-44ab-9d02-1fd2243305b2",
        "lesson.key": "lesson-1",
        "lesson_group.key": "lessonGroup-2",
        "script.name": "aif-year2-semester1-unit3"
      }
    },
    {
      "understanding": 1,
      "teacher_description": "Student’s answer names a general reason that data is useful (e.g., \"It helps you learn something.\"), but doesn’t describe how data might become useful. Or, the student’s answer is ambiguous (e.g., \"Data becomes useful with questions.\").",
      "ai_prompt": "",
      "seeding_key": {
        "understanding": 1,
        "learning_goal.key": "32ffe368-be0f-44ab-9d02-1fd2243305b2",
        "lesson.key": "lesson-1",
        "lesson_group.key": "lessonGroup-2",
        "script.name": "aif-year2-semester1-unit3"
      }
    },
    {
      "understanding": 2,
      "teacher_description": "Student’s answer reasonably describes how data becomes useful (e.g., \"By asking questions, collecting data about the question, and then figuring out what the data says.\").",
      "ai_prompt": "",
      "seeding_key": {
        "understanding": 2,
        "learning_goal.key": "32ffe368-be0f-44ab-9d02-1fd2243305b2",
        "lesson.key": "lesson-1",
        "lesson_group.key": "lessonGroup-2",
        "script.name": "aif-year2-semester1-unit3"
      }
    },
    {
      "understanding": 3,
      "teacher_description": "Student’s answer describes how data becomes useful, and how data might be misleading (e.g., \"Data becomes useful when you ask the right questions about it, but it might not always give you the right answer if you don’t have all the data.\").",
      "ai_prompt": "",
      "seeding_key": {
        "understanding": 3,
        "learning_goal.key": "32ffe368-be0f-44ab-9d02-1fd2243305b2",
        "lesson.key": "lesson-1",
        "lesson_group.key": "lessonGroup-2",
        "script.name": "aif-year2-semester1-unit3"
      }
    }
  ]
