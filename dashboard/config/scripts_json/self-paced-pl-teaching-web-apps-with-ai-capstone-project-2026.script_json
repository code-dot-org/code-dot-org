  "lessons": [
    {
      "key": "Navigating the Capstone Project",
      "name": "Navigating the Capstone Project",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": false,
      "relative_position": 1,
      "properties": {
        "overview": "**By the end of this professional learning module, you will be able to:**\n\n- Explain the process-oriented approach, emphasizing iteration, testing, and intentional decision-making over just adding features\n- Use project tools like the Kanban Board and Project Guide to manage workflow, scope, and team roles\n- Facilitate daily spot-checks to monitor progress, prompt reflection, and keep teams aligned\n- Assess and celebrate student growth based on process, reasoning, and iteration, not just the final product",
        "student_overview": "**By the end of this professional learning module, you will be able to:**\n\n- Explain the process-oriented approach, emphasizing iteration, testing, and intentional decision-making over just adding features\n- Use project tools like the Kanban Board and Project Guide to manage workflow, scope, and team roles\n- Facilitate daily spot-checks to monitor progress, prompt reflection, and keep teams aligned\n- Assess and celebrate student growth based on process, reasoning, and iteration, not just the final product"
      },
