  "vocabularies": [
    {
      "key": "abstraction",
      "word": "abstraction",
      "definition": "the practice of focusing only on the details that matter for what you're trying to do and leaving out everything else",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "abstraction"
      }
    },
    {
      "key": "and_",
      "word": "AND (&&)",
      "definition": "a logical operator used in conditional statements that requires all parts of the condition to be true",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "and_"
      }
    },
    {
      "key": "argument",
      "word": "argument",
      "definition": "the actual value that is passed into a function when it is called",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "argument"
      }
    },
    {
      "key": "boolean_expression",
      "word": "Boolean expression",
      "definition": "a data type that can only have one of two values: true or false",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "boolean_expression"
      }
    },
    {
      "key": "conditional_statement",
      "word": "conditional statement",
      "definition": "a programming instruction that makes a computer decide between two or more paths based on whether something is true or false",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "conditional_statement"
      }
    },
    {
      "key": "dom_document_object_model_",
      "word": "DOM (Document Object Model)",
      "definition": "the live, programmable representation of the web page's structure",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "dom_document_object_model_"
      }
    },
    {
      "key": "event_handler",
      "word": "event handler",
      "definition": "defines the reaction that a program takes based on a specific action, like a button click",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "event_handler"
      }
    },
    {
      "key": "event_listener",
      "word": "event listener",
      "definition": "a JavaScript feature that you attach to a web page element to wait for a specific event. It detects when the event occurs and calls an event handler",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "event_listener"
      }
    },
    {
      "key": "flowchart",
      "word": "flowchart",
      "definition": "a diagram that shows the steps in a process using shapes and arrows",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "flowchart"
      }
    },
    {
      "key": "function",
      "word": "function",
      "definition": "a block of organized, reusable code that is used to perform a single, related action",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "function"
      }
    },
    {
      "key": "nested_conditional",
      "word": "nested conditional",
      "definition": "a conditional statement (if/else) inside another conditional statement",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "nested_conditional"
      }
    },
    {
      "key": "not_operator",
      "word": "NOT operator",
      "definition": "a logical operator that reverses the value of a Boolean expression",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "not_operator"
      }
    },
    {
      "key": "operation",
      "word": "operation",
      "definition": "an action that changes the value of a variable using math or logic",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "operation"
      }
    },
    {
      "key": "or_",
      "word": "OR (||)",
      "definition": "a logical operator used in conditional statements that requires at least one part of the condition to be true",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "or_"
      }
    },
    {
      "key": "parameter",
      "word": "parameter",
      "definition": "one or more variables that are passed into a function, allowing flexibility and reusability",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "parameter"
      }
    },
    {
      "key": "state",
      "word": "state",
      "definition": "the current stored values of variables that describe what’s happening in a program right now",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "state"
      }
    },
    {
      "key": "truth_table",
      "word": "truth table",
      "definition": "shows all possible combinations of true and false values for one or more conditions and the result of each combination",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "truth_table"
      }
    },
    {
      "key": "variable",
      "word": "variable",
      "definition": "a container that stores a value, which can change while a program runs",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "variable"
      }
    }
