  "lessons": [
    {
      "key": "Teaching AI and Algorithmic Thinking",
      "name": "Teaching AI and Algorithmic Thinking",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": false,
      "relative_position": 1,
      "properties": {
        "overview": "#### **By the end of this professional learning module, you will be able to:**\n- #### Prepare to teach event-driven programming, explaining how user interactions drive algorithms and conditional logic in interactive apps.\n- #### Guide students in visual planning, introducing flowcharts as tools for mapping algorithms and predicting program behavior.\n- #### Teach foundational JavaScript skills, including variables, functions, and if/else statements, through scaffolded coding and debugging practice.\n\n#### **Estimated Time:** 60 minutes",
        "student_overview": "#### **By the end of this professional learning module, you will be able to:**\n- #### Prepare to teach event-driven programming, explaining how user interactions drive algorithms and conditional logic in interactive apps.\n- #### Guide students in visual planning, introducing flowcharts as tools for mapping algorithms and predicting program behavior.\n- #### Teach foundational JavaScript skills, including variables, functions, and if/else statements, through scaffolded coding and debugging practice.\n\n#### **Estimated Time:** 60 minutes"
      },
      "seeding_key": {
        "lesson.key": "Teaching AI and Algorithmic Thinking",
        "lesson_group.key": "",
        "script.name": "self-paced-pl-ai-and-algorithmic-decisions-pilot-2025"
