  "lessons": [
    {
      "key": "Teaching Iterating with AI",
      "name": "Teaching Iterating with AI",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": false,
      "relative_position": 1,
      "properties": {
        "overview": " **By the end of this professional learning module, you will be able to:**\n\n* Explain how iteration and loops work\n*Implement loops in JavaScript to create interactive features such as filters, searches, and views\n* Guide students in using AI-generated scaffolds responsibly, emphasizing accountability for both data choices and code.",
        "student_overview": " **By the end of this professional learning module, you will be able to:**\n\n* Explain how iteration and loops work\n*Implement loops in JavaScript to create interactive features such as filters, searches, and views\n* Guide students in using AI-generated scaffolds responsibly, emphasizing accountability for both data choices and code."
      },
      "seeding_key": {
        "lesson.key": "Teaching Iterating with AI",
