  "vocabularies": [
    {
      "key": "brand_kit",
      "word": "brand kit",
      "definition": "a set of colors, fonts, and style choices that tell a consistent story and connect to the brand’s audience",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "brand_kit"
      }
    },
    {
      "key": "css_cascading_style_sheets_",
      "word": "CSS (Cascading Style Sheets)",
      "definition": "Controls the layout, colors, fonts, and overall style",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "css_cascading_style_sheets_"
      }
    },
    {
      "key": "footer",
      "word": "Footer",
      "definition": "The strip at the bottom that often includes contact info or copyright details.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "footer"
      }
    },
    {
      "key": "gallery_cards",
      "word": "Gallery cards",
      "definition": "The boxes that group related information, each with a picture, title, and short description.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "gallery_cards"
      }
    },
    {
      "key": "hero_section",
      "word": "Hero section",
      "definition": "The large banner near the top that introduces the main idea, with a heading, short text, and usually a button.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "hero_section"
      }
    },
    {
      "key": "html_hypertext_markup_language_",
      "word": "HTML (HyperText Markup Language)",
      "definition": "Provides the structure and content of a web page",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "html_hypertext_markup_language_"
      }
    },
    {
      "key": "human_centered_design",
      "word": "human-centered design",
      "definition": "the idea that design should start with understanding the needs of the end-user",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "human_centered_design"
      }
    },
    {
      "key": "mood_boarding",
      "word": "mood boarding",
      "definition": "a collection of images, colors, and text used to explore the overall aesthetic of a brand",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "mood_boarding"
      }
    },
    {
      "key": "navigation_bar",
      "word": "Navigation bar",
      "definition": "Tthe menu across the top of a webpage that helps users move between pages or sections.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "navigation_bar"
      }
    },
    {
      "key": "pour_principles",
      "word": "POUR principles",
      "definition": "a framework for thinking about accessibility: Perceivable, Operable, Understandable, Robust",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "pour_principles"
      }
    },
    {
      "key": "problem_statement",
      "word": "problem statement",
      "definition": "clearly explains what a user needs and why it matters, without jumping to a solution",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "problem_statement"
      }
    },
    {
      "key": "prompt_engineering",
      "word": "prompt engineering",
      "definition": "the process of designing, refining, and optimizing prompts given to AI models to achieve desired outputs",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "prompt_engineering"
      }
    },
    {
      "key": "responsiveness",
      "word": "responsiveness",
      "definition": "the practice of designing and developing websites so that their layouts adapt smoothly to different screen sizes and devices, ensuring content is usable and looks good everywhere",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "responsiveness"
      }
    },
    {
      "key": "site_map",
      "word": "site map",
      "definition": "shows how web pages are organized and connected",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "site_map"
      }
    },
    {
      "key": "style_sheet",
      "word": "style sheet",
      "definition": "a file that controls a webpage’s look using colors, fonts, spacing, and layout",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "style_sheet"
      }
    },
    {
      "key": "user_experience",
      "word": "user experience",
      "definition": "the overall experience a person has when interacting with a product, system, or service",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "user_experience"
      }
    },
    {
      "key": "user_flow",
      "word": "user flow",
      "definition": "the path a user takes through a site to complete a task",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "user_flow"
      }
    },
    {
      "key": "user_profile",
      "word": "user profile",
      "definition": "a description of a typical person who uses a product or service. Designers use it to understand the user's goals, needs, and behaviors.",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "user_profile"
      }
    },
    {
      "key": "versioning",
      "word": "versioning",
      "definition": "the general idea of saving a \"working” state of a project so you can safely return to it if a future change causes problems",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "versioning"
      }
    },
    {
      "key": "web_app",
      "word": "Web app",
      "definition": "Interactive tools that connect to the internet and respond to your actions. ",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "web_app"
      }
    },
    {
      "key": "wireframe",
      "word": "wireframe",
      "definition": "a low-fidelity, structural layout showing content and functionality, without visual design",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "wireframe"
      }
    }
