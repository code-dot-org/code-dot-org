  "vocabularies": [
    {
      "key": "abstraction",
      "word": "abstraction",
      "definition": "the practice of focusing only on the details that matter for what you're trying to do and leaving out everything else",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "abstraction"
      }
    },
    {
      "key": "accessibility",
      "word": "accessibility",
      "definition": "the practice of designing products, websites, and spaces so that people with a wide range of abilities, disabilities, and needs can use them fully and independently",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "accessibility"
      }
    },
    {
      "key": "brand_kit",
      "word": "brand kit",
      "definition": "a set of colors, fonts, and style choices that tell a consistent story and connect to the brand's audience",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "brand_kit"
      }
    },
    {
      "key": "decomposition",
      "word": "decomposition",
      "definition": "the process of breaking a complex problem into smaller, manageable parts",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "decomposition"
      }
    },
    {
      "key": "human_centered_design",
      "word": "human-centered design",
      "definition": "making decisions based on how real people actually experience a product",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "human_centered_design"
      }
    },
    {
      "key": "mood_board",
      "word": "mood board",
      "definition": "a collection of images, colors, and text used to explore the overall aesthetic of a brand",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "mood_board"
      }
    },
    {
      "key": "pattern_recognition",
      "word": "pattern recognition",
      "definition": "spotting recurring structures that reveal how a system works",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "pattern_recognition"
      }
    },
    {
      "key": "pour_principles",
      "word": "POUR principles",
      "definition": "four guidelines that define what it means for a web app to be fully accessible to all users",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "pour_principles"
      }
    },
    {
      "key": "problem_statement",
      "word": "problem statement",
      "definition": "a statement that clearly explains what a user needs and why it matters, without jumping to a solution",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "problem_statement"
      }
    },
    {
      "key": "prompt_engineering",
      "word": "prompt engineering",
      "definition": "writing clear, specific instructions that help AI understand exactly what you want it to make or do",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "prompt_engineering"
      }
    },
    {
      "key": "responsiveness",
      "word": "responsiveness",
      "definition": "the practice of designing and developing websites so that their layouts adapt smoothly to different screen sizes and devices",
      "properties": {
      },
      "seeding_key": {
        "vocabulary.key": "responsiveness"
      }
    },
    {
      "key": "site_map",
