    {
      "key": "65fbfb18-afa6-4cca-8506-9d5ce9f7a79d",
      "properties": {
        "description": "Choose the right collaboration move for the moment: brainstorming directions, directing changes, stating negative constraints, and fact-checking AI-written content."
      },
      "seeding_key": {
        "lesson.key": "Web Design",
        "objective.key": "65fbfb18-afa6-4cca-8506-9d5ce9f7a79d"
      }
    },
    {
      "key": "6921e4e2-86a7-4723-9e4d-cf518318d538",
      "properties": {
        "description": "Communicate a design vision to an AI assistant - topic, content, tone, and look - and refine it when the result doesn't match."
      },
      "seeding_key": {
        "lesson.key": "Web Design",
        "objective.key": "6921e4e2-86a7-4723-9e4d-cf518318d538"
      }
    },
    {
      "key": "b7364030-f605-430e-942e-04468bf16cc4",
      "properties": {
        "description": "Prompt precisely in plain language: name the part of the page and the intended outcome, work one change at a time, and evaluate every change before accepting it."
      },
      "seeding_key": {
        "lesson.key": "Web Design",
        "objective.key": "b7364030-f605-430e-942e-04468bf16cc4"
      }
