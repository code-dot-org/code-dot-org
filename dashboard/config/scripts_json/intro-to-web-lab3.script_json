  "lessons": [
    {
      "key": "Web Design",
      "name": "Intro to Web Lab 3",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 1,
      "properties": {
        "overview": "This self-paced lesson introduces students to building webpages in Web Lab by collaborating with AI Tutor. This variant is AI-first: the code workspace is hidden by default, and students work entirely through conversation and the page preview. Instead of HTML/CSS vocabulary, students build AI-collaboration skills - communicating a vision, pointing precisely at what to change, iterating one step at a time, brainstorming before building, and diagnosing gaps between what they asked for and what they got. By the end, students will have built a complete webpage that reflects their own creative decisions and developed a deliberate working relationship with AI."
      },
      "seeding_key": {
        "lesson.key": "Web Design",
        "lesson_group.key": "",
        "script.name": "intro-to-web-lab3"
      }
    }
  ],
