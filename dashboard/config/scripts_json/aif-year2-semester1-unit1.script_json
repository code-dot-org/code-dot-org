      }
    },
    {
      "key": "152357b6-57df-40bb-92df-1f6435271ea6",
      "position": 6,
      "properties": {
        "description": "<i class=\"fa fa-check-square-o\" aria-hidden=\"true\"></i> **Do This:** Tell students to complete the End-of-Project Reflection in Level 4."
      },
