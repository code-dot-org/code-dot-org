  "lessons": [
    {
      "key": "Lesson 1: Milestones and Eras of AI",
      "name": "Lesson 1: Milestones and Eras of AI",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 1,
      "properties": {
        "overview": "**How did AI evolve from early rule-based systems into the tools we see today?**\n\nThis lesson introduces major milestones and eras in the history of AI by having students explore an interactive timeline, create a class timeline card, and compare ELIZA with a modern AI Tutor. Students investigate how AI shifted from early questions and rule-based systems toward tools that learn from data, while recognizing that AI progress includes both breakthroughs and limitations.",
        "preparation": "- Prepare a class timeline space using chart paper, a whiteboard, or wall space. Label it from earliest to most recent so students can post their timeline cards during the activity.\n- Give each student a copy of the Compare Chatbots and AI Milestone Timeline Card activity guides",
        "student_overview": "**How did AI evolve from early rule-based systems into the tools we see today?**\n\nExplore major milestones in AI history, build a class timeline, and compare ELIZA with a modern AI Tutor to see how AI changed from rule-based systems to tools that learn from data."
      },
      "seeding_key": {
        "lesson.key": "Lesson 1: Milestones and Eras of AI",
        "lesson_group.key": "",
        "script.name": "ai-history-2026"
      }
    },
    {
      "key": "Lesson 2: The People Who Shaped AI",
      "name": "Lesson 2: The People Who Shaped AI",
      "absolute_position": 2,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 2,
      "properties": {
        "overview": "**How have people’s ideas, choices, and discoveries shaped the development of AI?**\n\nThis lesson explores the people behind major developments in AI by having students investigate one AI contributor and share their findings through a peer exchange. Students examine how AI was shaped by many kinds of contributions, including foundational ideas, programming tools, datasets, computer vision research, bias research, and critiques of technology’s social impact.",
        "preparation": "- Give each student a copy of the AI Contributor Profile activity guide",
        "student_overview": "**How have people’s ideas, choices, and discoveries shaped the development of AI?**\n\nExplore people who helped shape AI, research one contributor, and share what you learned with classmates to see how different ideas, tools, discoveries, and concerns influenced AI history."
      },
      "seeding_key": {
        "lesson.key": "Lesson 2: The People Who Shaped AI",
        "lesson_group.key": "",
        "script.name": "ai-history-2026"
      }
    }
  ],
