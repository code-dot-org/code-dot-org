  "lessons": [
    {
      "key": "lesson-14",
      "name": "Pre-Assessment",
      "absolute_position": 1,
      "lockable": true,
      "has_lesson_plan": false,
      "relative_position": 1,
      "properties": {
        "assessment": true
      },
      "seeding_key": {
