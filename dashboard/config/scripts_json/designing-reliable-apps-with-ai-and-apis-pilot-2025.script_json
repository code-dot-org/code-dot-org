    },
    {
      "key": "60b43528-2637-46ce-935b-9c019d193e13",
      "position": 15,
      "properties": {
        "description": "<i class=\"fa fa-check-square-o\" aria-hidden=\"true\"></i> **Do This:** Have students draw a timeline graph mapping the code from Level 6. They should label the tasks and wait times in their illustration.",
        "tips": [
          {
            "type": "teachingTip",
            "markdown": "Provide students with use different colors pencils or pens to make the parallel execution clear."
          }
        ]
      },
      "seeding_key": {
        "activity_section.key": "60b43528-2637-46ce-935b-9c019d193e13",
