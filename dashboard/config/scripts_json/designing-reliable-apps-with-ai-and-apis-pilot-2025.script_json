    {
      "key": "678310cf-471e-462e-a8ca-0859a8076550",
      "position": 10,
      "properties": {
        "description": "<i class=\"fa fa-check-square-o\" aria-hidden=\"true\"></i> **Do This:** Introduce the await keyword.",
        "tips": [
          {
            "type": "teachingTip",
            "markdown": "Remind students that 'await' can ONLY be used inside an 'async' function. They are a pair!"
          }
        ]
      },
      "seeding_key": {
        "activity_section.key": "678310cf-471e-462e-a8ca-0859a8076550",
