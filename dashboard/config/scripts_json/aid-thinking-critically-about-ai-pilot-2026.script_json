    {
      "key": "2ac9d249-bbce-4d30-b139-5dc72b939348",
      "position": 5,
      "properties": {
        "description": "<i class=\"fa fa-desktop\" aria-hidden=\"true\"></i> **Transition:** Direct students to Lesson 3, Level 4 to complete the End of Lesson Survey.",
        "name": "End of Lesson Survey",
        "progression_name": "End of Lesson Survey"
