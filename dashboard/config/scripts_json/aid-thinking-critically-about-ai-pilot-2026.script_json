      "seeding_key": {
        "activity_section.key": "a2dbd0e5-414c-4175-b14b-a7b18a00380c",
        "lesson_activity.key": "82dec74c-04f8-4f32-b4dd-0b198365e36d"
      }
    },
    {
      "key": "85897eae-2ad8-432e-aad7-f731ef451eb8",
      "position": 4,
      "properties": {
        "description": "<i class=\"fa fa-check-square-o\" aria-hidden=\"true\"></i> **Do This:** Review the key vocabulary."
      },
