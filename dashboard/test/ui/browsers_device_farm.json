/* AWS Device Farm browser configurations.
   Desktop entries use a Desktop Browser Testing (TestGrid) project.
   Mobile entries use a standard Device Farm project with real devices;
   "device_arn" selects the exact device from the fleet and should match
   a device in the project's static device pool ("ios device pool").
   The runner routes each entry to the correct project ARN based on "mobile". */

[
  {
    "name": "Chrome",
    "browserName": "chrome",
    "browserVersion": "latest"
  },
  {
    "name": "Firefox",
    "browserName": "firefox",
    "browserVersion": "latest"
  },
  {
    "name": "iPhone",
    "mobile": true,
    "device_arn": "arn:aws:devicefarm:us-west-2::device:EEED8AB9E08F4B6C862F982EDA0A0C34",
    "platformName": "iOS",
    "browserName": "Safari"
  },
  {
    "name": "iPad",
    "mobile": true,
    "device_arn": "arn:aws:devicefarm:us-west-2::device:30FFDD10560948EABAF2288A9BF0397C",
    "platformName": "iOS",
    "browserName": "Safari"
  }
]
