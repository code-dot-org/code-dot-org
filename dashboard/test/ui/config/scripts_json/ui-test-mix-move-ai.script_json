  "lessons": [
    {
      "key": "Mix & Move with AI",
      "name": "Mix & Move with AI",
      "absolute_position": 1,
      "lockable": false,
      "has_lesson_plan": true,
      "relative_position": 1,
      "properties": {
        "background": "dark",
        "overview": "In this 45-minute lesson, students explore how creativity, coding, and artificial intelligence (AI) work together to make music and dance. Learners of all ages get an introductory experience with AI and computer science in a safe, supportive environment. They’ll design a dancer, remix a song, and use code to choreograph moves to the beat. Along the way, students will learn basic coding ideas like sequencing, and AI ideas like prompting and iteration.\n\nStudents will see how AI can help spark new ideas rather than replace human creativity. They’ll also meet a professional who uses art, technology, and AI in their career helping students imagine themselves as creative tech makers.",
        "preparation": "- Test out Mix & Move with AI to ensure familiarity with the platform.\n- Review the introduction video and practice walking students through the steps to prompt AI and modify code.\n- Prepare discussion prompts that help students connect with the opportunities and risks of using AI.\n- *[Optional]* Find the resources you need to plan, implement, and celebrate the Hour of AI at your school [here](https://csforall.org/en-US/hour-of-ai/how-to/k-12educator)!",
        "student_overview": "In this 45-minute activity, you’ll use Code.org’s Mix & Move with AI to design your own dancer, mix music from artists like Sabrina Carpenter, Benson Boone, and Shakira, and code your own dance performance. You’ll learn how AI can help you create more while staying in control of your ideas. Explore key coding skills like sequencing and discover how creativity, technology, and AI come together to make something amazing."
      },
      "seeding_key": {
        "lesson.key": "Mix & Move with AI",
        "lesson_group.key": "",
        "script.name": "ui-test-mix-move-ai"
      }
    }
  ],
