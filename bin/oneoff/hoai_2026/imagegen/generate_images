def wanted?(options, entry)
  return false unless options[:ids].empty? || options[:ids].include?(entry['sentenceId'])
  options[:filter].empty? || entry['sentenceId'].include?(options[:filter])
end

if options[:list_words]
  run_dumper('--catalog', *dumper_args).lines.each do |line|
    entry = JSON.parse(line)
