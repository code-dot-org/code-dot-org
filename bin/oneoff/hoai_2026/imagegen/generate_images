# An API key, or for Vertex a service account key.
def credential(key_name)
  key = CDO.send(key_name)
  raise "Error: config key '#{key_name}' is not set" if key.nil? || key.to_s.empty?
  key
end

def transparent?(options, job)
  options[:transparent] && job['transparent']
end

def frame_prompt(options, job, frame)
  transparent?(options, job) ? frame['transparentPrompt'] : frame['prompt']
end

# generateCharacterSet() gives the base the set's seed and each posed frame
# the seed plus its index, so alike prompts don't collapse into alike
# drawings. Only Gemini takes a seed.
def frame_seed(seed, job, frame)
  return nil unless seed
  frame['reference'] ? seed + job['frames'].index(frame) : seed
end

# Raises for a bad response; returns the image bytes for a good one.
def image_from(response)
  if response.code == 429 || response.code >= 500
    raise RetryableImageRequestError, "HTTP #{response.code}: #{response.body.to_s[0, 200]}"
  end
  unless response.success?
    message = response.parsed_response.is_a?(Hash) ? response.parsed_response.dig('error', 'message') : nil
    raise ImageRequestError, "HTTP #{response.code}: #{message || response.body.to_s[0, 200]}"
  end

  b64 = yield(response.parsed_response)
  raise ImageRequestError, 'No image in the response' unless b64
  Base64.decode64(b64)
end

def request_openai_image(options, job, frame, reference)
  headers = {'Authorization' => "Bearer #{credential(options[:key_name])}"}
  params = {
    model: options[:model],
    prompt: frame_prompt(options, job, frame),
    size: SIZE,
    n: 1,
    quality: options[:quality],
  }.compact
  if transparent?(options, job)
    params[:background] = 'transparent'
    params[:output_format] = 'png'
  end

  response =
    if reference
      io = StringIO.new(reference)
      def io.path
        'reference.png'
      end
      HTTParty.post(OPENAI_EDITS_URL, headers: headers, multipart: true, body: params.merge(image: io), timeout: 300)
    else
      HTTParty.post(OPENAI_GENERATIONS_URL, headers: headers.merge('Content-Type' => 'application/json'), body: JSON.generate(params), timeout: 300)
    end

  image_from(response) {|body| body.dig('data', 0, 'b64_json')}
end

# One Gemini generateContent call, on Vertex or the Gemini API. A reference
# image goes ahead of the text, as requestImage() in imageGeneration.ts
# sends it.
def request_google_image(options, job, frame, reference, seed)
  parts = []
  if reference
    mime = reference.b.start_with?(PNG_SIGNATURE) ? 'image/png' : 'image/jpeg'
    parts << {inlineData: {mimeType: mime, data: Base64.strict_encode64(reference)}}
  end
  parts << {text: frame_prompt(options, job, frame)}

  body = {
    contents: [{role: 'user', parts: parts}],
    generationConfig: {
      responseModalities: ['IMAGE'],
      imageConfig: {aspectRatio: '1:1', imageSize: GEMINI_IMAGE_SIZE},
      seed: seed,
      temperature: options[:temperature],
    }.compact,
  }

  response = options[:google].generate_content(options[:model], body, timeout: 300)

  # A thinking image model emits interim drafts ahead of the final render,
  # so the last image part is the one to keep (imageGeneration.ts does the
  # same with the SDK's files).
  image_from(response) do |parsed|
    images = parsed.dig('candidates', 0, 'content', 'parts')&.filter_map do |part|
      part.dig('inlineData', 'data') || part.dig('inline_data', 'data')
    end
    images&.last
  end
end

def request_image(options, job, frame, reference, seed)
  attempts = 0
  begin
    attempts += 1
    if GOOGLE_PROVIDERS.include?(options[:provider])
      request_google_image(options, job, frame, reference, seed)
    else
      request_openai_image(options, job, frame, reference)
    end
  rescue Net::ReadTimeout, Net::OpenTimeout, Errno::ECONNRESET, Errno::EPIPE, EOFError, RetryableImageRequestError => exception
    raise ImageRequestError, exception.message if attempts >= MAX_ATTEMPTS
    sleep(3 * attempts)
    retry
  end
end

# The record a variant starts with: what it is and how it is to be drawn.
def fresh_record(options, job, variant)
  {
    'sentenceId' => job['sentenceId'],
    'slots' => job['slots'],
    'wordIds' => job['wordIds'],
    'variant' => variant,
    'prompt' => job['prompt'],
    'style' => job['style'],
    'imageType' => job['imageType'],
    'subject' => job['subject'],
    'animated' => job['animated'],
    'bodyPlan' => job['bodyPlan'],
    'keyColor' => transparent?(options, job) ? nil : job['keyColor'],
    'transparent' => transparent?(options, job),
    'provider' => options[:provider],
    'model' => options[:model],
    'quality' => options[:quality],
    'project' => options[:project],
    'temperature' => GOOGLE_PROVIDERS.include?(options[:provider]) ? options[:temperature] : nil,
    'frames' => job['frames'].map do |frame|
      {'name' => frame['name'], 'file' => frame_file(job, variant, frame['name']), 'prompt' => frame_prompt(options, job, frame)}
    end,
    'history' => [],
  }.compact
end

# Whether the frames on disk were drawn from words other than this run
# would send: a word's text, the sentence, or the lab's prompt builders
# changed under an unchanged path.
def prompts_changed?(options, job, record)
  drawn = (record['frames'] || []).to_h {|frame| [frame['name'], frame['prompt']]}
  return false if drawn.empty?
  job['frames'].any? {|frame| drawn[frame['name']] != frame_prompt(options, job, frame)}
end

# Moves the variant's frames to the attic and starts its record over,
# keeping what happened in its history.
def retire(options, job, variant, record, reason)
  moved = move_to_attic(job, variant)
  history = (record['history'] || []) << {
    'at' => Time.now.utc.iso8601,
    'reason' => reason,
    'seed' => record['seed'],
    'provider' => record['provider'],
    'model' => record['model'],
    'review' => record['review'],
    'checks' => record['frames']&.to_h {|frame| [frame['name'], frame['checks']]},
    'movedTo' => moved,
  }.compact
  fresh_record(options, job, variant).merge('history' => history, 'redraws' => record['redraws'].to_i)
end

# The checks a frame still needs: missing ones, and ones whose service
# failed last time.
def needs_check?(frame, name)
  frame.dig('checks', name).nil? || frame.dig('checks', name, 'verdict') == 'error'
end

# Draws what a variant lacks, moderates it, redraws what moderation flags,
# and returns how it ended: :complete, :drawn, :checked, :prompt_only,
# :abandoned, or an error message.
def process_variant(options, moderator, prompt_checks, job, variant)
  record = read_record(job, variant)
  present = frames_present(job, variant)

  if record&.dig('abandoned') && !options[:redraw_abandoned]
    return :abandoned
  end

  record ||= fresh_record(options, job, variant)
  record.delete('abandoned')
  if present.any? && review_verdict(record) == 'rejected'
    record = retire(options, job, variant, record, 'rejected in review')
  elsif present.any? && !!record['transparent'] != !!transparent?(options, job)
    record = retire(options, job, variant, record, 'drawn with the other background')
  elsif present.any? && prompts_changed?(options, job, record)
    record = retire(options, job, variant, record, 'prompt changed')
  end
  record['promptCheck'] = prompt_checks[job['prompt']] if prompt_checks[job['prompt']]

  if options[:just_save_prompt]
    write_record(job, variant, record)
    return :prompt_only
  end

  outcome = :complete
  loop do
    missing = job['frames'].reject {|frame| frame_exists?(job, variant, frame['name'])}
    if missing.any?
      outcome = :drawn
      if missing.length == job['frames'].length
        record = fresh_record(options, job, variant).merge(record.slice('history', 'redraws', 'promptCheck'))
        record['seed'] = rand(2**31) if GOOGLE_PROVIDERS.include?(options[:provider])
      end
      # A pose drawn in this run is referenced by the base as the model
      # returned it, as generateCharacterSet() does; a base from an earlier
      # run, by its stored PNG.
      drawn = {}
      missing.each do |frame|
        reference = nil
        if frame['reference']
          reference = drawn[frame['reference']] ||
            File.binread(File.join(output_path, frame_path(job, variant, frame['reference'])))
        end
        raw = request_image(options, job, frame, reference, frame_seed(record['seed'], job, frame))
        drawn[frame['name']] = raw
        path = File.join(output_path, frame_path(job, variant, frame['name']))
        FileUtils.mkdir_p(File.dirname(path))
        File.binwrite(path, to_png(raw))
        entry = record['frames'].find {|f| f['name'] == frame['name']}
        entry['seed'] = frame_seed(record['seed'], job, frame) if record['seed']
        entry.delete('checks')
      end
      record['drawnAt'] = Time.now.utc.iso8601(3)
    end

    if options[:moderation]
      record['frames'].each do |entry|
        png = nil
        load_png = -> {png ||= File.binread(File.join(output_path, frame_path(job, variant, entry['name'])))}
        entry['checks'] ||= {}
        if needs_check?(entry, 'azure')
          outcome = :checked if outcome == :complete
          entry['checks']['azure'] = moderator.azure(load_png.call)
        end
        if options[:judge] && needs_check?(entry, 'judge')
          outcome = :checked if outcome == :complete
          entry['checks']['judge'] = moderator.judge_image(load_png.call)
        end
      end
    end

    break unless moderation_summary(record, require_judge: options[:judge]) == 'flagged'
    redraws = record['redraws'].to_i
    if redraws >= MAX_REDRAWS
      record = retire(options, job, variant, record, 'flagged by moderation')
      record['abandoned'] = {'at' => Time.now.utc.iso8601, 'after' => redraws + 1}
      write_record(job, variant, record)
      return :abandoned
    end
    record = retire(options, job, variant, record, 'flagged by moderation')
    record['redraws'] = redraws + 1
  end

  write_record(job, variant, record)
  outcome
rescue ImageRequestError, Magick::ImageMagickError => exception
  write_record(job, variant, record) if record
  "#{record_path(job, variant)}: #{exception.message}"
end

# Credentials are read only by a run that draws or judges; listing and
# publishing need none.
drawing = !options[:just_upload] && !options[:just_save_prompt]
if drawing && GOOGLE_PROVIDERS.include?(options[:provider])
  options[:google] = GoogleGenerative.new(options[:provider], credential(options[:key_name]))
  options[:project] = options[:google].project
end
if drawing
  puts
  puts "Drawing with #{options[:model]} on #{options[:project] ? "Vertex AI project #{options[:project]}" : options[:provider]}."
end

# Azure has its own credentials; the judges run on Gemini, on the drawing
# provider's route when it is Google's.
judge_google = nil
if options[:judge] && !options[:just_upload]
  judge_google = options[:google] ||
    GoogleGenerative.new(DEFAULT_JUDGE_PROVIDER, credential(API_KEY_NAMES[DEFAULT_JUDGE_PROVIDER]))
end
moderator = Moderator.new(judge_google)

# Each distinct prompt is judged once, and a flagged one is never drawn or
# published. Verdicts already on file apply to every run, judged or not:
# --judge only decides whether new prompts get judged.
verdicts_path = File.join(SCRIPT_PATH, PROMPT_VERDICTS_FILE)
verdicts = File.exist?(verdicts_path) ? JSON.parse(File.read(verdicts_path)) : {}
verdict_for = ->(prompt) {verdicts["#{JUDGE_MODEL}\t#{prompt}"]}
prompts = objects.map {|object| object[:job]['prompt']}.uniq
if options[:judge] && !options[:just_upload]
  unjudged = prompts.reject {|prompt| verdict_for.call(prompt) && verdict_for.call(prompt)['verdict'] != 'error'}
  puts
  puts "Judging #{unjudged.length} of #{prompts.length} prompts..."
  judged = Parallel.map(unjudged, in_threads: options[:jobs]) do |prompt|
    [prompt, moderator.judge_prompt(prompt)]
  end
  judged.each {|prompt, verdict| verdicts["#{JUDGE_MODEL}\t#{prompt}"] = verdict}
  File.write(verdicts_path, JSON.pretty_generate(verdicts)) if judged.any?
end
prompt_checks = prompts.filter_map {|prompt| [prompt, verdict_for.call(prompt)] if verdict_for.call(prompt)}.to_h

blocked = prompts.select do |prompt|
  verdict = prompt_checks.dig(prompt, 'verdict')
  verdict == 'flagged' || (options[:judge] && verdict != 'ok')
end
if blocked.any?
  puts
  puts "Not drawing or publishing #{blocked.length} prompt(s) the judge did not pass:"
  blocked.each {|prompt| puts "  #{prompt_checks.dig(prompt, 'verdict')}: #{prompt}"}
  objects = objects.reject {|object| blocked.include?(object[:job]['prompt'])}
end

tally = Hash.new(0)
failures = []

if options[:just_upload]
  puts "Note: Not drawing. Just using the content in the '#{OUTPUT_DIRECTORY}' directory."
else
  puts
  puts "Processing #{objects.length} variants (#{objects.sum {|o| o[:job]['frames'].length}} images at most)..."
  progress = ProgressBar.create(total: objects.size)
  Parallel.map(objects, in_threads: options[:jobs], finish: lambda do |_, _, result|
    result.is_a?(String) ? failures << result : tally[result] += 1
    progress&.increment
  end
  ) do |object|
    process_variant(options, moderator, prompt_checks, object[:job], object[:variant])
  end
  progress&.finish

  puts
  {
    complete: 'already drawn and checked',
    drawn: 'drawn',
    checked: 'checked only',
    prompt_only: 'records written, not drawn',
    abandoned: "left out after #{MAX_REDRAWS + 1} flagged drawings (--redraw-abandoned tries again)",
  }.each {|key, label| puts "#{tally[key].to_s.rjust(6)} #{label}" if tally[key] > 0}
  if failures.any?
    puts
    puts "#{failures.length} variant(s) failed; run again to retry them:"
    failures.each {|failure| puts "  #{failure}"}
  end
end

exit if options[:just_save_prompt]

# Publishing. A variant is published whole or not at all: the lab finds a
# variant by its first frame, and a set missing a pose after that is an
# error to it, not a fallback.
def publishable(options, job, variant)
  record = read_record(job, variant)
  return 'not drawn' unless record
  return 'abandoned' if record['abandoned']

  missing = job['frames'].reject {|frame| frame_exists?(job, variant, frame['name'])}
  return "#{missing.length} frame(s) missing" if missing.any?

  job['frames'].each do |frame|
    error = validate_image(
      File.join(output_path, frame_path(job, variant, frame['name'])),
      image_type: job['imageType'],
      transparent: record['transparent']
    )
    return "#{frame['name']}: #{error}" if error
  end

  summary = moderation_summary(record, require_judge: options[:judge])
  return "moderation #{summary}" unless summary == 'pass'
  return 'rejected in review' if review_verdict(record) == 'rejected'
  return nil unless options[:production] && !options[:unreviewed]
  return 'not approved in review' unless review_verdict(record) == 'approved'
  # An approval belongs to the drawing it was given to.
  return 'approved for an earlier drawing' unless record.dig('review', 'drawnAt') == record['drawnAt']
  nil
end

bucket_name = "#{BUCKET_NAME}#{options[:production] ? '' : '-devel'}"

puts
puts "Checking #{objects.length} variants for s3://#{bucket_name}/#{BUCKET_PATH}/..."

reasons = Hash.new(0)
ready = objects.select do |object|
  reason = publishable(options, object[:job], object[:variant])
  reasons[reason] += 1 if reason
  reason.nil?
end

gaps = objects.group_by {|object| object[:job]}.select do |_, job_objects|
  (job_objects & ready).empty?
end.keys

puts "#{ready.length.to_s.rjust(6)} ready to publish"
reasons.sort_by {|_, count| -count}.each {|reason, count| puts "#{count.to_s.rjust(6)} held back: #{reason}"}
if gaps.any?
  puts
  puts "#{gaps.length} filling(s) have no publishable variant; the lab treats a missing filling as an error:"
  gaps.first(10).each {|job| puts "  #{job_folder(job)}"}
  puts "  ..." if gaps.length > 10
  if options[:production] && !options[:allow_gaps]
    puts
    puts 'Not publishing to production with gaps. Fill them, or pass --allow-gaps.'
    exit 1
  end
end

puts
if options[:dry_run]
  puts 'Note: Dry run. Not uploading. Specify --no-dry-run to upload.'
else
  puts 'Note: Development bucket. Specify --production to publish for live use.' unless options[:production]

  # Each file with the drawing it holds, so the review manifests know which
  # current drawings the lab's tree has.
  ledger = UploadLedger.new(bucket_name)
  files = ready.flat_map do |object|
    drawn_at = read_record(object[:job], object[:variant])['drawnAt']
    object[:job]['frames'].map {|frame| [frame_path(object[:job], object[:variant], frame['name']), drawn_at]}
  end
  progress = ProgressBar.create(total: files.size)
  Parallel.each(files, in_threads: options[:jobs], finish: ->(_, _, _) {progress&.increment}) do |path, drawn_at|
    AWS::S3.upload_to_bucket(
      bucket_name,
      File.join(BUCKET_PATH, path),
      File.binread(File.join(output_path, path)),
      acl: 'public-read',
      no_random: true,
      content_type: 'image/png'
    )
    ledger.record(File.join(BUCKET_PATH, path), drawn_at)
  end
  progress&.finish
  ledger.save
  puts "Uploaded #{files.length} files for #{ready.length} variants."
end

if options[:publish_review]
  catalog = run_dumper('--catalog', *dumper_args).lines.map {|line| JSON.parse(line)}
  # Every filling of each chosen sentence, whatever --choice or --limit
  # narrowed this run to: a manifest describes a whole sentence.
  sentences = all_jobs.filter {|job| wanted?(options, job)}.group_by {|job| job['sentenceId']}
  status_for = ->(job, variant) {publishable(options, job, variant)}
  ReviewPublisher.new(options, bucket_name, catalog, status_for).
    publish(sentences, all_jobs.map {|job| job['sentenceId']}.uniq)
  puts 'Note: the devel bucket sends no CORS headers; a page elsewhere loads its manifests through manifest.js.' unless options[:production]
end
