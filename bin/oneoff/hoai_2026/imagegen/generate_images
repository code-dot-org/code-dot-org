    kind = [entry['imageType'], entry['subject']].compact.join('/')
    puts
    puts "#{entry['sentenceId']} (#{kind}#{entry['animated'] ? ', animated' : ''}): #{entry['example']}"
    entry['slots'].each do |slot|
      words = slot['words'].map do |word|
        word['id'] == word['text'] ? word['id'] : "#{word['id']} (#{word['text']})"
      end
      words.unshift(EMPTY_WORD_ID) unless slot['required']
      shown = slot['label'] == slot['id'] ? '' : " (shown as \"#{slot['label']}\")"
      puts "  #{slot['id']}#{shown}, #{words.length} choices: #{words.join(', ')}"
    end
  end
  exit
end

puts
puts "Building prompts with dump_prompts.ts..."
