#!/usr/bin/env ruby

# Temporary production diagnostic for one canary host.
#
# Pick one booted Puma child worker at startup, then sample that same PID with
# pumactl_admin, /proc, and rbtrace --memory. This script never runs rbtrace
# heapdump and never enables ObjectSpace allocation tracing.
#
# Usage:
#   bundle exec ruby bin/oneoff/monitor_puma_worker_rbtrace_memory
#   bundle exec ruby bin/oneoff/monitor_puma_worker_rbtrace_memory 5
#
# The optional argument is the sample interval in minutes. Default: 30.

