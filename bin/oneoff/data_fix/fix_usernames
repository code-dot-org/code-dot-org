# rubocop:enable Metrics/CollectionLiteralLength

progress_bar = ProgressBar.create(total: user_ids.size, format: "#{options[:skip_update] ? 'Skipped' : 'Updated'}[%c/%C]: |%W| %a")

user_ids.each_slice(1000) do |user_ids_batch|
  new_username_data = User.where(id: user_ids_batch).pluck(:id, :name, :username).filter_map do |user_id, name, username|
    if username.match?(User::USERNAME_REGEX)
      progress_bar.log %Q[[#{Time.now.utc.iso8601}][#{user_id}] username "#{username} is valid"].yellow
      next
    else
      new_username = UserHelpers.generate_username(User.with_deleted, name)
      progress_bar.log %Q[[#{Time.now.utc.iso8601}][#{user_id}] #{username}" => "#{new_username}"].green
      {id: user_id, username: new_username}
    end
  end

  User.import(new_username_data, on_duplicate_key_update: %i[username], validate: false) unless options[:skip_update]
rescue StandardError
  progress_bar.log "[#{Time.now.utc.iso8601}] Failed to update users batch".red
ensure
  progress_bar.progress += user_ids_batch.size
end

progress_bar.finish
progress_bar.log "Finished at: #{Time.now.utc.iso8601}"
