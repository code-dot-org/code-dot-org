#!/usr/bin/env ruby
# Backfill user_scripts.unit_group_id for non-modular units
# (units that have exactly one unit group)

require 'optparse'

$options = {actually_update: false}
OptionParser.new do |opts|
  opts.banner = "Usage: #{File.basename(__FILE__)} [options]"
  opts.on('-u', '--actually-update', 'Actually perform the update.') do
    $options[:actually_update] = true
  end
  opts.on('-h', '--help', 'Add -u to perform the update.') do
    puts opts
    exit
  end
end.parse!

BATCH_SIZE = 50_000

puts "Called with options: #{$options} batch size #{BATCH_SIZE}"

require_relative '../../dashboard/config/environment'

$stdout.sync = true

def puts_count
  # Use raw SQL with query hint to increase max execution time to 180 seconds
  count = ActiveRecord::Base.connection.select_value(
    "SELECT /*+ SET_VAR(max_execution_time=180000) */ COUNT(*)
     FROM user_scripts
     WHERE unit_group_id IS NULL"
  )
  puts "There are #{count} user_scripts without a unit_group_id"
end

# Phase 1: Identify units with exactly one unit group
def get_unit_ids_with_one_unit_group
  puts "Phase 1: Building list of units with exactly one unit group..."

  # Query for units with exactly one unit group
  unit_ids = []

  Unit.joins(:unit_group_units).
    select('scripts.id, scripts.name, scripts.original_unit_group_id').
    group('scripts.id').
    having('COUNT(*) = 1').
    find_each do |unit|
    # Verify original_unit_group_id is not nil
    if unit.original_unit_group_id.nil?
      raise "Unit #{unit.id} (#{unit.name}) has exactly one unit group but original_unit_group_id is nil"
    end
    if unit.unit_groups.count != 1
      raise "Unit #{unit.id} (#{unit.name}) has #{unit.unit_groups.count} unit groups, expected 1"
    end

    unit_ids << unit.id
  end

  puts "Found #{unit_ids.size} units with exactly one unit group"
  unit_ids
end

# Phase 2: Update user_scripts in batches to avoid timeouts
def update_user_scripts(script_ids)
  raise "no script_ids provided" if script_ids.empty?

  script_ids_str = script_ids.join(',')

  if $options[:actually_update]
    puts "Phase 2: Updating user_scripts in batches of #{BATCH_SIZE}..."

    total_updated = 0
    batch_count = 0
    start_time = Time.now

    loop do
      # Get next batch of IDs with NULL unit_group_id
      ids = ActiveRecord::Base.connection.select_values(
        "SELECT id FROM user_scripts
         WHERE unit_group_id IS NULL AND script_id IN (#{script_ids_str})
         LIMIT #{BATCH_SIZE}"
      )
      break if ids.empty?

      batch_count += 1

      # Update this batch
      updated = ActiveRecord::Base.connection.exec_update(
        "UPDATE /*+ SET_VAR(max_execution_time=180000) */ user_scripts us
         JOIN scripts s ON us.script_id = s.id
         SET us.unit_group_id = s.original_unit_group_id
         WHERE us.id IN (#{ids.join(',')})"
      )

      total_updated += updated

      # Progress reporting
      print '.' # if batch_count % 10 == 0
      if batch_count % 20 == 0
        elapsed = Time.now - start_time
        rate = total_updated / elapsed
        total_records = 250_000_000 # approx total user_scripts rows to be updated
        est_total_hours = (total_updated > 0) ? (elapsed * (total_records / total_updated)) / 3600 : 0
        puts "\n[Batch #{batch_count}, updated #{total_updated} records in #{elapsed.round(1)}s (#{rate.round(1)} rows/sec), est. total hours: #{est_total_hours.round(1)}]"
      end
    end

    puts "\nFinished! Total records updated: #{total_updated}"
  else
    puts "Phase 2: Counting records that would be updated (dry run)..."

    count = ActiveRecord::Base.connection.select_value(
      "SELECT /*+ SET_VAR(max_execution_time=180000) */ COUNT(*) FROM user_scripts
       WHERE unit_group_id IS NULL AND script_id IN (#{script_ids_str})"
    )
    puts "Dry run: Would update #{count} records in approximately #{(count.to_f / BATCH_SIZE).ceil} batches"
  end
end

def main
  puts "Starting backfill process..."
  # puts_count

  unit_ids = get_unit_ids_with_one_unit_group
  update_user_scripts(unit_ids)

  puts_count
  puts $options[:actually_update] ? "Backfill complete!" : "Dry run complete! Use -u flag to actually update."
end

main
