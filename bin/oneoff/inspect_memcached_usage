#!/usr/bin/env ruby

# Simple Memcached Growth Monitor
# Monitors key patterns to identify what's causing cache growth

require_relative '../../dashboard/config/environment'
require 'socket'
require 'timeout'
require 'json'

class MemcachedGrowthMonitor
  REQUIRED_STATS = %w[curr_items bytes].freeze
  CACHE_DUMP_END_MARKERS = %w[END ERROR].freeze

  def initialize(cache_client = nil)
    @cache_client = cache_client || CDO.shared_cache
    @dalli_data = @cache_client.instance_variable_get(:@data)
    @endpoints = @dalli_data.instance_variable_get(:@servers)
    @timeout_duration = 5
    puts "Monitoring endpoints: #{@endpoints.join(', ')}"
  end

  # Main monitoring method - tracks key pattern growth over time
  def monitor_growth(duration_minutes: 15, interval_seconds: 60, samples_per_check: 500)
    puts "=== MEMCACHED GROWTH MONITOR ==="
    puts "Duration: #{duration_minutes} minutes"
    puts "Check interval: #{interval_seconds} seconds"
    puts "Samples per server per check: #{samples_per_check}"
    puts "Started at: #{Time.now.strftime('%Y-%m-%d %H:%M:%S')}"
    puts "-" * 50

    measurements = []
    cycles = (duration_minutes * 60 / interval_seconds).to_i

    cycles.times do |cycle|
      timestamp = Time.now
      cycle_data = collect_cycle_data(cycle + 1, cycles, timestamp, samples_per_check)
      measurements << cycle_data

      analyze_growth_since_last_cycle(measurements) if measurements.length > 1

      sleep interval_seconds unless cycle == cycles - 1
    end

    generate_final_report(measurements)
    measurements
  end

  private def collect_cycle_data(cycle_num, total_cycles, timestamp, samples_per_check)
    puts "\n--- Cycle #{cycle_num}/#{total_cycles} at #{timestamp.strftime('%H:%M:%S')} ---"

    cycle_data = {
      timestamp: timestamp,
      cycle: cycle_num,
      total_items: 0,
      total_bytes: 0,
      patterns: Hash.new {|h, k| h[k] = {count: 0, total_bytes: 0, examples: []}}
    }

    @endpoints.each_with_index do |endpoint, idx|
      hostname, port = endpoint.split(":")
      puts "  Sampling server #{idx + 1} (#{endpoint})..."

      begin
        server_stats = get_server_stats(hostname, port)
        cycle_data[:total_items] += server_stats['curr_items'] || 0
        cycle_data[:total_bytes] += server_stats['bytes'] || 0

        sampled_keys = sample_keys_from_server(hostname, port, samples_per_check)
        puts "    Found #{sampled_keys.length} keys"

        sampled_keys.each do |key_data|
          pattern = categorize_key_pattern(key_data[:key])
          pattern_data = cycle_data[:patterns][pattern]

          pattern_data[:count] += 1
          pattern_data[:total_bytes] += key_data[:size]

          # Keep a few examples (first 3)
          if pattern_data[:examples].length < 3
            pattern_data[:examples] << {
              key: key_data[:key],
              size: key_data[:size]
            }
          end
        end
      rescue => exception
        puts "    ERROR: #{exception.message}"
      end
    end

    # Calculate averages for each pattern
    cycle_data[:patterns].each do |_pattern, data|
      data[:avg_size] = data[:count] > 0 ? (data[:total_bytes] / data[:count]) : 0
    end

    display_cycle_summary(cycle_data)
    cycle_data
  end

  private def get_server_stats(hostname, port)
    stats = {}

    Timeout.timeout(@timeout_duration) do
      sock = TCPSocket.new(hostname, port || 11211)
      sock.write("stats\r\n")

      loop do
        line = sock.readline.strip
        break if line == "END"

        if line.start_with?("STAT")
          parts = line.split(" ", 3)
          stat_name = parts[1]
          stat_value = parts[2]

          if REQUIRED_STATS.include?(stat_name)
            stats[stat_name] = stat_value.to_i
          end
        end
      end
      sock.close
    end

    stats
  rescue => exception
    puts "    Stats error for #{hostname}:#{port} - #{exception.message}"
    {}
  end

  private def sample_keys_from_server(hostname, port, max_samples)
    all_keys = []

    Timeout.timeout(8) do
      # Get active slabs
      sock = TCPSocket.new(hostname, port || 11211)
      sock.write("stats slabs\r\n")

      active_slabs = []
      loop do
        line = sock.readline.strip
        break if line == "END"

        if line.match(/^STAT (\d+):used_chunks (\d+)/) && $2.to_i > 0
          active_slabs << $1.to_i
        end
      end
      sock.close

      return [] if active_slabs.empty?

      # Sample from each slab
      samples_per_slab = [max_samples / active_slabs.length, 20].max

      active_slabs.each do |slab_id|
        break if all_keys.length >= max_samples

        begin
          Timeout.timeout(3) do
            sock = TCPSocket.new(hostname, port || 11211)
            sock.write("stats cachedump #{slab_id} #{samples_per_slab}\r\n")

            loop do
              line = sock.readline.strip
              break if CACHE_DUMP_END_MARKERS.include?(line)

              if line =~ /^ITEM ([^\s]+) \[(\d+) b; (\d+) s\]/
                all_keys << {
                  key: $1,
                  size: $2.to_i,
                  timestamp: $3.to_i,
                  slab: slab_id
                }

                break if all_keys.length >= max_samples
              end
            end
            sock.close
          end
        rescue Timeout::Error
          # Skip this slab on timeout
        end
      end
    end

    all_keys
  rescue => exception
    puts "    Sampling error: #{exception.message}"
    []
  end

  private def categorize_key_pattern(key)
    case key
    when /^optimize-3-/
      'optimize-3-* (Image Cache)'
    when /^session:/
      'session:* (User Sessions)'
    when /^partial_registration_/
      'partial_registration_* (Registration)'
    when /^views\//
      'views/* (View Cache)'
    when /^fragment_cache\//
      'fragment_cache/* (Fragment Cache)'
    when /^ActiveRecord:/
      'ActiveRecord:* (AR Cache)'
    when /^rack:session/
      'rack:session* (Rack Sessions)'
    when /^user_\d+/
      'user_*'
    when /^course_\d+/
      'course_*'
    when /^level_\d+/
      'level_*'
    when /^script_\d+/
      'script_*'
    when /^teacher_/
      'teacher_*'
    when /^student_/
      'student_*'
    when /^progress_/
      'progress_*'
    when /^api_/
      'api_*'
    when /^[a-f0-9]{32}$/
      'md5_hash'
    when /^[a-f0-9]{40}$/
      'sha1_hash'
    when /^\w+:/
      key.split(':', 2)[0] + ':*'
    else
      if key.length > 50
        'long_keys (>50 chars)'
      elsif key =~ /^([a-z_]+)/
        "#{$1}_*"
      else
        'other'
      end
    end
  end

  private def display_cycle_summary(cycle_data)
    puts "    Total: #{cycle_data[:total_items]} items, #{format_bytes(cycle_data[:total_bytes])}"

    # Show top 5 patterns by count
    top_patterns = cycle_data[:patterns].sort_by {|_, data| -data[:count]}.take(5)

    if top_patterns.any?
      puts "    Top patterns this cycle:"
      top_patterns.each do |pattern, data|
        puts "      #{pattern}: #{data[:count]} items (#{format_bytes(data[:total_bytes])})"
      end
    end
  end

  private def analyze_growth_since_last_cycle(measurements)
    current = measurements.last
    previous = measurements[-2]

    time_diff = (current[:timestamp] - previous[:timestamp]) / 60.0 # minutes

    # Overall growth
    items_growth = current[:total_items] - previous[:total_items]
    bytes_growth = current[:total_bytes] - previous[:total_bytes]

    if items_growth > 0 || bytes_growth > 0
      puts "\n  📈 GROWTH DETECTED:"
      puts "    Total: +#{items_growth} items, +#{format_bytes(bytes_growth)}"
      puts "    Rate: #{(items_growth / time_diff).round(1)} items/min, #{format_bytes(bytes_growth / time_diff)}/min"

      # Pattern-specific growth
      growing_patterns = []

      current[:patterns].each do |pattern, current_data|
        previous_data = previous[:patterns][pattern]
        next unless previous_data

        pattern_items_growth = current_data[:count] - previous_data[:count]
        pattern_bytes_growth = current_data[:total_bytes] - previous_data[:total_bytes]

        if pattern_items_growth > 0
          growing_patterns << {
            pattern: pattern,
            items_growth: pattern_items_growth,
            bytes_growth: pattern_bytes_growth,
            rate_per_min: pattern_items_growth / time_diff
          }
        end
      end

      if growing_patterns.any?
        puts "    Growing patterns:"
        growing_patterns.sort_by {|p| -p[:items_growth]}.take(5).each do |p|
          puts "      #{p[:pattern]}: +#{p[:items_growth]} items (+#{format_bytes(p[:bytes_growth])}) - #{p[:rate_per_min].round(1)}/min"
        end
      end
    end
  end

  private def generate_final_report(measurements)
    puts "\n#{('=' * 60)}"
    puts "FINAL GROWTH ANALYSIS REPORT"
    puts '=' * 60

    first = measurements.first
    last = measurements.last
    total_time = (last[:timestamp] - first[:timestamp]) / 60.0

    # Overall trends
    total_items_growth = last[:total_items] - first[:total_items]
    total_bytes_growth = last[:total_bytes] - first[:total_bytes]

    puts "\nOVERALL GROWTH:"
    puts "  Duration: #{total_time.round(1)} minutes"
    puts "  Items: #{first[:total_items]} → #{last[:total_items]} (+#{total_items_growth})"
    puts "  Bytes: #{format_bytes(first[:total_bytes])} → #{format_bytes(last[:total_bytes])} (+#{format_bytes(total_bytes_growth)})"
    puts "  Average rate: #{(total_items_growth / total_time).round(1)} items/min, #{format_bytes(total_bytes_growth / total_time)}/min"

    # Identify patterns with consistent growth
    pattern_growth = {}

    last[:patterns].each do |pattern, last_data|
      first_data = first[:patterns][pattern]
      next unless first_data

      items_growth = last_data[:count] - first_data[:count]
      bytes_growth = last_data[:total_bytes] - first_data[:total_bytes]

      if items_growth > 0
        pattern_growth[pattern] = {
          items_growth: items_growth,
          bytes_growth: bytes_growth,
          items_rate: items_growth / total_time,
          bytes_rate: bytes_growth / total_time,
          final_count: last_data[:count],
          final_bytes: last_data[:total_bytes],
          avg_size: last_data[:avg_size],
          examples: last_data[:examples]
        }
      end
    end

    puts "\nGROWING PATTERNS (sorted by growth rate):"
    if pattern_growth.any?
      sorted_growth = pattern_growth.sort_by {|_, data| -data[:items_rate]}

      sorted_growth.each_with_index do |(pattern, data), index|
        puts "\n#{index + 1}. #{pattern}"
        puts "   Growth: +#{data[:items_growth]} items (+#{format_bytes(data[:bytes_growth])})"
        puts "   Rate: #{data[:items_rate].round(1)} items/min, #{format_bytes(data[:bytes_rate])}/min"
        puts "   Current total: #{data[:final_count]} items (#{format_bytes(data[:final_bytes])})"
        puts "   Average item size: #{format_bytes(data[:avg_size])}"
        puts "   Examples:"
        data[:examples].each do |example|
          puts "     #{example[:key]} (#{format_bytes(example[:size])})"
        end
      end
    else
      puts "  No consistent growth patterns detected"
    end

    # Recommendations
    puts "\nRECOMMENDations:"
    if pattern_growth.any?
      top_grower = pattern_growth.max_by {|_, data| data[:items_rate]}
      puts "  🔍 Focus investigation on: #{top_grower[0]}"
      puts "     This pattern is growing at #{top_grower[1][:items_rate].round(1)} items/min"

      large_items = pattern_growth.select {|_, data| data[:avg_size] > 100_000}
      if large_items.any?
        puts "  💾 Large item patterns to investigate:"
        large_items.each do |pattern, data|
          puts "     #{pattern}: #{format_bytes(data[:avg_size])} avg size"
        end
      end
    else
      puts "  ✅ No significant growth detected during monitoring period"
      puts "  💡 Consider running for longer duration or during peak usage"
    end
  end

  private def format_bytes(bytes)
    return "0 B" if bytes == 0

    units = ['B', 'KB', 'MB', 'GB']
    unit_index = 0
    size = bytes.to_f

    while size >= 1024 && unit_index < units.length - 1
      size /= 1024
      unit_index += 1
    end

    "#{size.round(1)} #{units[unit_index]}"
  end
end

# Quick analysis method for immediate insights
def quick_analysis(monitor)
  puts "=== QUICK CURRENT STATE ANALYSIS ==="

  # Take a snapshot of current key patterns
  snapshot = monitor.send(:collect_cycle_data, 1, 1, Time.now, 1000)

  puts "\nCURRENT KEY PATTERN DISTRIBUTION:"
  sorted_patterns = snapshot[:patterns].sort_by {|_, data| -data[:count]}

  sorted_patterns.take(10).each_with_index do |(pattern, data), index|
    percentage = (data[:count].to_f / snapshot[:patterns].values.sum {|d| d[:count]} * 100).round(1)
    puts "#{index + 1}. #{pattern}"
    puts "   Count: #{data[:count]} (#{percentage}%)"
    puts "   Total size: #{monitor.send(:format_bytes, data[:total_bytes])}"
    puts "   Avg size: #{monitor.send(:format_bytes, data[:avg_size])}"
  end
end

# Main execution
if __FILE__ == $0
  monitor = MemcachedGrowthMonitor.new

  puts "Choose an option:"
  puts "1. Quick analysis (current state snapshot)"
  puts "2. Growth monitoring (default: 15 min)"
  puts "3. Custom monitoring duration"
  print "Enter choice (1-3) or press Enter for growth monitoring: "

  choice = gets.chomp

  case choice
  when '1'
    quick_analysis(monitor)
  when '3'
    print "Duration in minutes: "
    duration = gets.chomp.to_i
    duration = 15 if duration <= 0

    print "Check interval in seconds (default 60): "
    interval = gets.chomp.to_i
    interval = 60 if interval <= 0

    monitor.monitor_growth(duration_minutes: duration, interval_seconds: interval)
  else
    # Default: 15-minute monitoring
    monitor.monitor_growth(duration_minutes: 15, interval_seconds: 60)
  end

  puts "\nMonitoring complete! Check the growth patterns above."
  puts "💡 Tip: Run during peak usage times for best results"
end
