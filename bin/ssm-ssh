#!/usr/bin/env ruby

# Starts an SSH session to the specified EC2 instance through SSM Session
# Manager, using a temporary SSH key sent through EC2 Instance Connect.

repo_root = File.expand_path('..', __dir__)
$LOAD_PATH.unshift File.join(repo_root, 'lib')
ENV['BUNDLE_GEMFILE'] ||= File.join(repo_root, 'Gemfile')
require 'bundler/setup' if File.exist?(ENV['BUNDLE_GEMFILE'])
require 'fileutils'
require 'cdo/aws/session_manager'

def usage
  "Usage: #{$0} INSTANCE_ID PORT USER KEY_PATH"
end

unless ARGV.length == 4
  warn usage
  exit 1
end

instance_id, port, instance_os_user, key_path = ARGV

FileUtils.rm_f(key_path)
unless system('ssh-keygen', '-q', '-t', 'rsa', '-f', key_path, '-N', '')
  warn "Could not create temporary SSH key at #{key_path}"
  exit 1
end

availability_zone = Cdo::Aws::SessionManager.availability_zone_for(instance_id)
unless availability_zone
  warn "Could not find availability zone for EC2 instance #{instance_id.inspect}."
  exit 1
end

unless Cdo::Aws::SessionManager.send_ssh_public_key(
  instance_id: instance_id,
  availability_zone: availability_zone,
  instance_os_user: instance_os_user,
  public_key_path: "#{key_path}.pub"
)
  warn "Could not send SSH public key to EC2 instance #{instance_id.inspect}."
  exit 1
end

exec(
  *Cdo::Aws::SessionManager.start_ssh_session_argv(
    instance_id: instance_id,
    port: port
  )
)
