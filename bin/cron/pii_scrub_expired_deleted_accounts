#!/usr/bin/env ruby
require_relative 'only_one'
abort 'Script already running' unless only_one_running?(__FILE__)

# This cronjob will query for accounts that have been soft-deleted for more than 28 days
# and delete any data considered to be high-risk PII (personally identifiable information).
# This renders the accounts unrecoverable but retains as much useful non-PII data as possible.

require 'active_support/core_ext/numeric/time'
require 'date'
require 'optparse'

options = {}
OptionParser.new do |opts|
  opts.banner = <<~BANNER
    Usage: #{File.basename(__FILE__)} [options]

    This script will scrub PII from accounts that have been soft-deleted for more than 28 days.
    This WILL render the accounts unrecoverable. Use with caution.

    Options:
  BANNER

  opts.on('--dry-run', 'Report expected results without deleting anything') do |dry_run|
    options[:dry_run] = dry_run
  end

  opts.on('-h', '--help', 'Print this') do
    puts opts
    exit
  end
end.parse!

require_relative '../../dashboard/config/environment'
require_relative '../../dashboard/lib/expired_child_account_purger'
ExpiredChildAccountPurger.new(options).purge_expired_child_accounts!
