#!/usr/bin/env ruby
require_relative 'only_one'
abort 'Script already running' unless only_one_running?(__FILE__)

require_relative '../../dashboard/config/environment'
require 'cdo/chat_client'

# Use five minute timeout to allow long delete queries to complete.
DASHBOARD_DB_LONG_TIMEOUT = Cdo::Sequel.database_connection_pool(
  CDO.dashboard_db_writer,
  CDO.dashboard_db_reader,
  query_timeout: 300
)

RETENTION_DAYS = 90
DELETE_BATCH_SIZE = 1_000

# Scan by id so each delete operates on a bounded set of rows. The number of
# qualifying rows is finite even when the database cannot infer that from
# `created_at < cutoff` alone.
def old_record_ids(table_name, cutoff, last_id)
  with_read_only_server do
    DASHBOARD_DB_LONG_TIMEOUT[table_name].
      where {created_at < cutoff}.
      where {id > last_id}.
      order(:id).
      limit(DELETE_BATCH_SIZE).
      select_map(:id)
  end
end

# Some requests pick up child events after the request row is created. Skip any
# request that still has event children instead of letting one FK miss fail the
# whole batch.
def request_ids_without_events(ids)
  requests = ::Sequel[:aichat_requests]
  events = ::Sequel[:aichat_events]

  DASHBOARD_DB_LONG_TIMEOUT[:aichat_requests].
    left_join(:aichat_events, request_id: requests[:id]).
    where(requests[:id] => ids, events[:id] => nil).
    select_map(requests[:id])
end

def delete_in_batches(table_name, cutoff)
  deleted_count = 0
  last_id = 0

  loop do
    ids = old_record_ids(table_name, cutoff, last_id)
    break if ids.empty?

    deleted_count += yield(ids)
    last_id = ids.last
  end

  deleted_count
end

def with_read_only_server
  servers = DASHBOARD_DB_LONG_TIMEOUT.opts.fetch(:servers, {})
  return yield unless servers.key?(:read_only)

  DASHBOARD_DB_LONG_TIMEOUT.with_server(:read_only) do
    yield
  end
end

# We want to avoid storing student chat messages any longer than
# is necessary for analysis to prevent storing excess student PII.
#
# Log the number of records deleted for each table to #cron-daily Slack channel
# so we can easily monitor the deletion process.
def main
  retention_cutoff = Time.now - RETENTION_DAYS.days

  deleted_event_count = delete_in_batches(:aichat_events, retention_cutoff) do |ids|
    DASHBOARD_DB_LONG_TIMEOUT[:aichat_events].where(id: ids).delete
  end
  ChatClient.message('cron-daily', "Deleted #{deleted_event_count} AichatEvent records")

  deleted_request_count = delete_in_batches(:aichat_requests, retention_cutoff) do |ids|
    deletable_ids = request_ids_without_events(ids)
    next 0 if deletable_ids.empty?

    DASHBOARD_DB_LONG_TIMEOUT[:aichat_requests].where(id: deletable_ids).delete
  end
  ChatClient.message('cron-daily', "Deleted #{deleted_request_count} AichatRequest records")
end

main
