#!/usr/bin/env ruby
require_relative 'only_one'
abort 'Script already running' unless only_one_running?(__FILE__)

require_relative '../../dashboard/config/environment'
require 'cdo/chat_client'

# Use five minute timeout to allow long delete queries to complete.
DASHBOARD_DB_LONG_TIMEOUT = Cdo::Sequel.database_connection_pool(
  CDO.dashboard_db_writer,
  CDO.dashboard_db_reader,
  query_timeout: 300
)

RETENTION_DAYS = 90
DELETE_BATCH_SIZE = 1_000

def read_only_replica_configured?
  configured_servers = DASHBOARD_DB_LONG_TIMEOUT.opts.fetch(:servers, {})
  configured_servers.key?(:read_only)
end

def old_record_ids(table_name, last_processed_id, largest_eligible_id)
  if read_only_replica_configured?
    DASHBOARD_DB_LONG_TIMEOUT.with_server(:read_only) do
      DASHBOARD_DB_LONG_TIMEOUT[table_name].
        where {id > last_processed_id}.
        where {id <= largest_eligible_id}.
        order(:id).
        limit(DELETE_BATCH_SIZE).
        select_map(:id)
    end
  else
    DASHBOARD_DB_LONG_TIMEOUT[table_name].
      where {id > last_processed_id}.
      where {id <= largest_eligible_id}.
      order(:id).
      limit(DELETE_BATCH_SIZE).
      select_map(:id)
  end
end

def largest_eligible_id(table_name, retention_cutoff)
  if read_only_replica_configured?
    DASHBOARD_DB_LONG_TIMEOUT.with_server(:read_only) do
      DASHBOARD_DB_LONG_TIMEOUT[table_name].
        where {created_at < retention_cutoff}.
        max(:id)
    end
  else
    DASHBOARD_DB_LONG_TIMEOUT[table_name].
      where {created_at < retention_cutoff}.
      max(:id)
  end
end

# First find the largest id that is old enough to delete. Then batch only
# within that fixed id range so we stop at the retention boundary instead of
# probing into newer rows.
def delete_in_batches(table_name, cutoff)
  total_deleted_rows = 0
  last_processed_id = 0
  largest_id_to_delete = largest_eligible_id(table_name, cutoff)
  if largest_id_to_delete.nil?
    return total_deleted_rows
  end

  loop do
    batch_record_ids = old_record_ids(table_name, last_processed_id, largest_id_to_delete)
    break if batch_record_ids.empty?

    total_deleted_rows += yield(batch_record_ids)
    last_processed_id = batch_record_ids.last
  end

  total_deleted_rows
end

# We want to avoid storing student chat messages any longer than
# is necessary for analysis to prevent storing excess student PII.
#
# Log the number of records deleted for each table to #cron-daily Slack channel
# so we can easily monitor the deletion process.
def main
  retention_cutoff = Time.now - RETENTION_DAYS.days

  deleted_event_count = delete_in_batches(:aichat_events, retention_cutoff) do |ids|
    DASHBOARD_DB_LONG_TIMEOUT[:aichat_events].where(id: ids).delete
  end
  ChatClient.message('cron-daily', "Deleted #{deleted_event_count} AichatEvent records")

  deleted_request_count = delete_in_batches(:aichat_requests, retention_cutoff) do |ids|
    DASHBOARD_DB_LONG_TIMEOUT[:aichat_requests].where(id: ids).delete
  end
  ChatClient.message('cron-daily', "Deleted #{deleted_request_count} AichatRequest records")
end

main
