#!/usr/bin/env ruby
require_relative 'only_one'
abort 'Script already running' unless only_one_running?(__FILE__)

require 'open-uri'
require 'json'
require File.expand_path('../../../pegasus/src/env', __FILE__)
require_relative '../../deployment'
require 'cdo/developers_topic'
require 'cdo/pager_duty'
require 'cdo/slack'

def main
  # Get the primary oncall from PagerDuty.
  primary_dotd_email = PagerDuty.on_call
  primary_dotd_user = primary_dotd_email && Slack.user_mention_tag(primary_dotd_email)
  primary_dotd_user ||= '(ERROR: check schedule)'

  DevelopersTopic.set_dotd_mention(primary_dotd_user)
end

main
