#!/usr/bin/env ruby

require_relative 'only_one'
abort 'Script already running' unless only_one_running?(__FILE__)

require_relative '../../dashboard/config/environment' # Load Rails (and the `CDO.` configuration settings object).
require 'cdo/aws/redshift/client'
require 'cdo/aws/redshift/materialized_view_manager'
require 'cdo/aws/redshift/zero_etl'
require 'cdo/aws/metrics'
require 'cdo/chat_client'

# This job runs HOURLY to emit CloudWatch Metrics and Logs.
# To keep the RED (data) team's signal daily — they consume the pipeline on a daily cadence — the #data-alerts Slack
# summary is posted only once a day, in the window when the legacy DMS export is expected to have completed.
NOTIFY_CHANNEL = 'data-alerts'
ENVIRONMENT_TYPE = CDO.rack_env.to_s
DETAIL_LENGTH_IN_SUMMARY = 3

# UTC hour in which to post the once-a-day data-team summary (the cron fires at :30, so the 19:30 UTC
# run posts). This is roughly when the legacy DMS export completes.
DATA_TEAM_ALERT_HOUR_UTC = 19

# True only in the single hourly run per day designated for the data-team Slack summary, in production.
def data_team_alert_window?
  ENVIRONMENT_TYPE == 'production' && Time.now.utc.hour == DATA_TEAM_ALERT_HOUR_UTC
end

def slack(message)
  ChatClient.message(NOTIFY_CHANNEL, message, color: 'red')
end

def post_data_team_summary(error_integrations, error_tables, mv_summary)
  mv_errors = mv_summary[:error_views]
  return if error_integrations.empty? && error_tables.empty? && mv_errors.empty?

  lines = ["*Zero-ETL → Redshift daily status (#{ENVIRONMENT_TYPE})*"]

  if error_integrations.any?
    lines << "\n*#{error_integrations.size} integration(s) in error state:*"
    error_integrations.each {|i| lines << "• `#{i['integration_id']}` — `#{i['state']}`"}
  end

  if error_tables.any?
    lines << "\n*#{error_tables.size} table(s) failing to replicate:*"
    error_tables.first(DETAIL_LENGTH_IN_SUMMARY).each {|t| lines << "• `#{t['schema_name']}.#{t['table_name']}` (#{t['table_state']})"}
    lines << "_…and #{error_tables.size - DETAIL_LENGTH_IN_SUMMARY} more (see CloudWatch logs)_" if error_tables.size > DETAIL_LENGTH_IN_SUMMARY
  end

  if mv_errors.any?
    lines << "\n*#{mv_errors.size} materialized view(s) in error state:*"
    mv_errors.first(DETAIL_LENGTH_IN_SUMMARY).each {|e| lines << "• `#{e[:row].table_name}` (#{e[:row].view_type}) — #{e[:condition]}"}
    lines << "_…and #{mv_errors.size - DETAIL_LENGTH_IN_SUMMARY} more (see CloudWatch logs)_" if mv_errors.size > DETAIL_LENGTH_IN_SUMMARY
  end

  slack(lines.join("\n"))
end

begin
  redshift = Cdo::Aws::Redshift::Client.new

  # Integration- and table-level replication health (SVV_INTEGRATION* catalog reads; see
  # Cdo::Aws::Redshift::ZeroEtl for the SQL and the healthy/error state rules).
  failed_zeroetl_integrations = Cdo::Aws::Redshift::ZeroEtl.integration_errors(
    client: redshift, environment_type: ENVIRONMENT_TYPE
  )
  failed_zeroetl_integrations.each do |integration|
    CDO.log.error("[zeroetl-monitor] integration #{integration['integration_id']} in state #{integration['state']}")
  end

  failed_zeroetl_tables = Cdo::Aws::Redshift::ZeroEtl.unsynced_tables(
    client: redshift, environment_type: ENVIRONMENT_TYPE
  )
  failed_zeroetl_tables.each do |table|
    CDO.log.error(
      "[zeroetl-monitor] table not synced: #{table['schema_name']}.#{table['table_name']} " \
        "state=#{table['table_state']} reason=#{table['reason']}"
    )
  end

  Rails.application.eager_load!
  redshift_materialized_view_status = Cdo::Aws::Redshift::MaterializedViewManager.emit_view_status_metrics(
    client: redshift,
    environment_type: ENVIRONMENT_TYPE,
    models: AnalyticsExportable.valid_exported_models
  )

  # Once-a-day data-team Slack summary (production only).
  post_data_team_summary(failed_zeroetl_integrations, failed_zeroetl_tables, redshift_materialized_view_status) if data_team_alert_window?
rescue => exception
  CDO.log.error("[zeroetl-monitor] script failed (#{ENVIRONMENT_TYPE}): #{exception.message}")
  slack("*Zero-ETL Monitor Script Failed (#{ENVIRONMENT_TYPE})*\nException: #{exception.message}") if data_team_alert_window?
  raise exception
ensure
  # Short-lived process: flush buffered metrics before exit rather than relying on the async buffer.
  Cdo::Metrics.flush!
end
