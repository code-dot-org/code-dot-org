#!/usr/bin/env ruby

# Daily job that updates the MySQL to Redshift Zero ETL data export pipeline to automatically deploy changes committed to:
#  - the schema of MySQL tables
#  - whether an ActiveRecord Model declares `export_to_analytics`
#  - the Data Classification of one or more Attributes in an ActiveRecord Model that declares `export_to_analytics`
#
# And refresh all Zero ETL Redshift Materialized Views to pick up new/modified/deleted rows in the source MySQL tables.

# Redshift doesn't permit ALTERing the schema of an existing Materialized View. That requires DROP/reCREATE, which
# disrupts Data (RED) Team and its analytics tools. In production any schema change that DROPs a View is NOT
# executed automatically by this job. Those changes must be executed manually by an Infrastructure Engineer via
# rake tasks in coordination with RED team.
#
# This job executes the following three steps:
#   1. Update the RDS Zero ETL Integration data filters to exclude tables that should not be exported.
#   2. Provision (create/update/delete) Materialized Views (skipping update/delete on production)
#   3. Refresh the data in all Materialized Views.

require_relative 'only_one'
abort 'Script already running' unless only_one_running?(__FILE__)

require_relative '../../dashboard/config/environment' # Load Rails.
# The managed test system and production are the only environments with a Zero ETL Integration.
exit unless CDO.test_system? || (rack_env?(:production) && CDO.dashboard_hostname == 'studio.code.org')

require 'cdo/chat_client'
require 'cdo/aws/rds'
require 'cdo/aws/redshift/client'
require 'cdo/aws/redshift/materialized_view_manager'

DBT_MODEL_RUN_UTC_HOUR = 21 # Cron is configured to start this job in time to complete before the daily `dbt` model run.
MAX_WAIT = 12.hours # Something is wrong if the REFRESH takes longer than this.
ENVIRONMENT_TYPE = CDO.rack_env.to_s
NOTIFICATION_CHANNEL = 'data-alerts'

# Don't DROP or update (DROP + CREATE) Materialized Views in production.
PROVISION_OPERATIONS = CDO.test_system? ? %i[add update drop] : %i[add]

def notify_data_team(message, **options)
  return unless ENVIRONMENT_TYPE == 'production'

  ChatClient.message NOTIFICATION_CHANNEL, message, **options
end

def update_zero_etl_filter(db_name:)
  result = Cdo::RDS.update_zero_etl_integration!(
    integration_arn: Cdo::RDS.zero_etl_integration_arn(environment_type: ENVIRONMENT_TYPE),
    desired_data_filter: AnalyticsExportable.zero_etl_data_filter(db_name: db_name),
    db_name: db_name
  )

  if result[:to_add].empty? && result[:to_remove].empty?
    CDO.log.info "[redshift-zero-etl] #{db_name} table filter already matches the models."
    return
  end

  CDO.log.info "[redshift-zero-etl] #{db_name} table filter updated, " \
    "added #{result[:to_add].length} and removed #{result[:to_remove].length} rule(s)."
  notify_data_team \
    "Updated the #{ENVIRONMENT_TYPE} Zero ETL table filter. " \
      "Added: #{result[:to_add].join(', ').presence || 'none'}. " \
      "Removed: #{result[:to_remove].join(', ').presence || 'none'}."
end

# Provision (create/update/delete) Materialized Views.
# Wait for Views to complete provisioning because a REFRESH submitted against a View that is rebuilding would fail.
def provision_views(client:, models:)
  result = Cdo::Aws::Redshift::MaterializedViewManager.provision_all_views(
    client: client,
    environment_type: ENVIRONMENT_TYPE,
    models: models,
    operations: PROVISION_OPERATIONS,
    # `modify_integration` above returns before Zero ETL finishes reloading the tables whose rules changed,
    # so a table the filter just included is still filling. Leave its Views to a later run of this job.
    require_synced_sources: true
  ) do |event, name, detail|
    case event
    when :submitted then CDO.log.info "[redshift-zero-etl] provisioning #{name}: #{detail.join(', ')}"
    when :skipped then CDO.log.info "[redshift-zero-etl] #{name} DDL unchanged; skipped."
    when :deferred then CDO.log.info "[redshift-zero-etl] #{name} is not yet synced; deferred to a later run."
    when :error then CDO.log.error "[redshift-zero-etl] failed to submit #{name}: #{detail.message}"
    # `:drop_batch_submitted` reports the dropped FQNs in the second argument, where every other event
    # reports a table name.
    when :drop_batch_submitted then CDO.log.info "[redshift-zero-etl] dropping orphans: #{name.join(', ')}"
    end
  end

  waited = client.wait_for_statements(statements: result[:statements], timeout: MAX_WAIT.to_i) do |event, name, detail|
    case event
    when :finished then CDO.log.info "[redshift-zero-etl] provisioned #{name} in #{detail}s"
    when :failed then CDO.log.error "[redshift-zero-etl] provisioning failed for #{name}: #{detail}"
    end
  end

  failures = result[:failed] + waited[:failed].map(&:first)
  if failures.any?
    CDO.log.error "[redshift-zero-etl] #{failures.length} view(s) failed to provision in #{ENVIRONMENT_TYPE}: " \
      "#{failures.join(', ')}"
    notify_data_team \
      "#{failures.length} Redshift materialized view(s) failed to provision: #{failures.join(', ')}", color: 'red'
  end

  CDO.log.info "[redshift-zero-etl] provisioned #{waited[:finished].length} statement batch(es) in #{ENVIRONMENT_TYPE}."

  pending = result[:declined].reject {|_operation, fqns| fqns.empty?}
  return if pending.empty?

  summary = pending.map {|operation, fqns| "#{operation} #{fqns.join(', ')}"}.join('; ')
  CDO.log.warn "[redshift-zero-etl] #{ENVIRONMENT_TYPE} View changes this job does not apply: #{summary}"
  notify_data_team \
    "Redshift materialized view changes are waiting on a coordinated rebuild in #{ENVIRONMENT_TYPE}: #{summary}",
    color: 'yellow'
end

begin
  Rails.application.eager_load!

  exportability_errors = AnalyticsExportable.exportability_errors
  if exportability_errors.any?
    notify_data_team \
      "#{exportability_errors.length} model(s) can no longer be exported via Zero ETL and their Redshift " \
        "materialized views are no longer being refreshed: #{exportability_errors.join('; ')}", color: 'red'
  end

  client = Cdo::Aws::Redshift::MaterializedViewManager.redshift_client
  dbt_model_run_at = Time.now.utc.change(hour: DBT_MODEL_RUN_UTC_HOUR) # Today's dbt model run start time.
  models = AnalyticsExportable.valid_exported_models

  update_zero_etl_filter(db_name: ActiveRecord::Base.connection.current_database)
  provision_views(client: client, models: models)

  CDO.log.info "[redshift-zero-etl] refreshing #{ENVIRONMENT_TYPE} materialized views."

  result = Cdo::Aws::Redshift::MaterializedViewManager.refresh_and_wait(
    client: client,
    environment_type: ENVIRONMENT_TYPE,
    models: models,
    timeout: MAX_WAIT.to_i
  ) do |event, name, detail|
    case event
    when :submitted then CDO.log.info "[redshift-zero-etl] submitted #{name}: #{detail.join(', ')}"
    when :skipped then CDO.log.info "[redshift-zero-etl] #{name} not stale; skipped."
    when :no_views then CDO.log.info "[redshift-zero-etl] #{name} has no views."
    when :error then CDO.log.error "[redshift-zero-etl] failed to submit #{name}: #{detail.message}"
    when :finished then CDO.log.info "[redshift-zero-etl] refreshed #{name} in #{detail}s"
    when :failed then CDO.log.error "[redshift-zero-etl] refresh failed for #{name}: #{detail}"
    end
  end

  refreshed = result[:refreshed].length
  failures = result[:failures]

  if failures.any?
    CDO.log.error "[redshift-zero-etl] #{failures.length} view(s) failed in #{ENVIRONMENT_TYPE}: #{failures.join(', ')}"
    notify_data_team \
      "#{failures.length} of #{failures.length + refreshed} Redshift materialized view(s) failed to refresh: " \
        "#{failures.join(', ')}", color: 'red'
  elsif refreshed.zero?
    # Also reached when no models are exported at all, so this must not claim the views are fresh.
    CDO.log.info '[redshift-zero-etl] no stale views to refresh.'
    notify_data_team 'No stale Redshift materialized views to refresh.'
  else
    CDO.log.info "[redshift-zero-etl] refreshed #{refreshed} view(s) in #{ENVIRONMENT_TYPE}."
    notify_data_team "Refreshed #{refreshed} Redshift materialized view(s)."
  end

  if Time.now.utc > dbt_model_run_at
    CDO.log.warn "[redshift-zero-etl] refresh finished after the #{DBT_MODEL_RUN_UTC_HOUR}:00 UTC dbt model run began."
    notify_data_team \
      "Redshift materialized view refresh finished after the #{DBT_MODEL_RUN_UTC_HOUR}:00 UTC dbt model run began, " \
        'which may have read partially stale views.', color: 'yellow'
  end

  # Exit non-zero for cron rather than raising if there were any views that failed to refresh.
  exit 1 if failures.any?
rescue StandardError => exception
  CDO.log.error "[redshift-zero-etl] #{ENVIRONMENT_TYPE} refresh failed: #{exception.message}"
  notify_data_team "Redshift materialized view refresh failed in #{ENVIRONMENT_TYPE}: #{exception.message}", color: 'red'
  raise exception
end
