#!/bin/bash
# Switch this clone's sparse checkout between the pattern sets in
# sparse-patterns/. On a complete clone, a mode only trims the working tree;
# the omitted files have already been transferred. To never transfer them,
# clone with --filter=blob:none --no-checkout, check out bin/ and
# sparse-patterns/ in cone mode, then run this; .drone.yml does so.
#
# Usage: bin/sparse-checkout default|no-production-curriculum|verify
set -e

MODE="${1:-}"
PATTERNS_DIR="sparse-patterns"
PATTERNS="$PATTERNS_DIR/no-production-curriculum"

# The trees a pattern file leaves out: its "!<tree>/**" lines.
omitted_trees() {
  sed -n 's#^!\(.*\)/\*\*$#\1#p' "$1"
}

case "$MODE" in
  default)
    rm -f "$(git rev-parse --git-path info/sparse-checkout)"
    git sparse-checkout disable
    ;;
  no-production-curriculum)
    # Only non-cone patterns can say "everything except these trees". The
    # mode is set through config because --no-cone needs git 2.35 and the CI
    # image has 2.25.
    git config core.sparseCheckout true
    git config core.sparseCheckoutCone false
    git sparse-checkout set --stdin < "$PATTERNS"
    ;;
  verify)
    # Report what the clone holds, and fail if an omitted tree is present in
    # the working tree. The blob count is the number the clone has fetched;
    # a rise between two reports means something read omitted content.
    git count-objects -v
    echo "blobs present: $(git cat-file --batch-all-objects --batch-check --unordered | awk '$2 == "blob"' | wc -l)"
    echo "working tree files: $(find . -type f -not -path './.git/*' -not -path '*/node_modules/*' | wc -l)"
    status=0
    for tree in $(omitted_trees "$PATTERNS"); do
      if [ -d "$tree" ]; then
        echo "ERROR: $tree is present with $(find "$tree" -type f | wc -l) files" >&2
        status=1
      fi
    done
    exit $status
    ;;
  *)
    echo "Usage: $0 default|no-production-curriculum|verify" >&2
    exit 1
    ;;
esac
