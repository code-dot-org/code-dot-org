#!/bin/bash

USAGE="
Opens a shell in a live drone build container via AWS SSM Session Manager, for
interactive debugging. No gateway or SSH key required.

Usage: bin/drone/shell i-0123456789abcdef0 us-west-2

Notes:
  1. The instance id and region are printed by the 'bin/drone/shell' step of the
     drone build.
  2. Run only when drone is in either the unit->\`unit-tests\` or ui->\`ui-tests\`
     step, depending on which you want to debug. Running too early will not work.
  3. The drone workers run in a separate AWS account; this uses the 'codeorg-dev'
     profile (override with DRONE_AWS_PROFILE) which must authenticate to it and
     allow ssm:StartSession.
"

PROFILE="${DRONE_AWS_PROFILE:-codeorg-dev}"

# Opens an interactive shell in the live build container on INSTANCE_ID via SSM.
# 'docker ps -lq' is the most-recently-created container, i.e. the running build.
# The command substitution is escaped so it runs on the worker, not locally.
# stdin is inherited, so bin/drone/vscode can pipe a heredoc into the container.
drone-shell () {
  if [ "$1" = "--help" ] || [ "$#" -lt 1 ]; then
    cat <<< "$USAGE"
    exit 1
  fi
  local instance_id=$1
  local region=$2

  local -a region_args=()
  [ -n "$region" ] && region_args=(--region "$region")

  aws ssm start-session \
    --profile "$PROFILE" \
    "${region_args[@]}" \
    --target "$instance_id" \
    --document-name AWS-StartInteractiveCommand \
    --parameters command="sudo docker exec -it \$(sudo docker ps -lq) bash"
}

# We're being called from the command-line (vs sourced), run drone-shell()
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  drone-shell "$@"
fi
