#!/bin/sh
# Guard both directions of a .gitattributes/Git LFS mismatch in the paths a
# branch changed, printing direction-specific fix instructions on failure.
#
# Usage: bin/drone/check-lfs-pointers <base> <head>
# Checks the files that <head> added or modified since its merge base with
# <base>, as they stand in HEAD (the post-merge tree in drone).
#
# Only changed paths are read because drone's clone is partial
# (sparse-patterns/): reading any other blob would fetch it, one round trip
# each, and git-lfs's own tree walks (`git lfs fsck`) fail on a missing object.
# A mismatch can only enter through a change, so nothing is lost.

base="${1:?usage: $0 <base> <head>}"
head="${2:?usage: $0 <base> <head>}"
header='version https://git-lfs.github.com/spec/v1'
status=0

merge_base=$(git merge-base "$base" "$head") || exit 1
changed=$(git diff --name-only --diff-filter=AM "$merge_base" "$head")
if [ -z "$changed" ]; then
  echo "Git LFS pointer check: no files changed"
  exit 0
fi

# Each line is "<path>: filter: <value>"; the value is "lfs" or "unspecified".
not_pointer=""
stranded=""
tmp=$(mktemp)
printf '%s\n' "$changed" | git check-attr --stdin filter > "$tmp"
while IFS= read -r line; do
  path=${line%: filter: *}
  attr=${line##*: filter: }
  # Deleted on the target branch since the PR branched: nothing to check.
  git cat-file -e "HEAD:$path" 2>/dev/null || continue
  first_line=$(git cat-file -p "HEAD:$path" | head -n 1)
  if [ "$attr" = lfs ] && [ "$first_line" != "$header" ]; then
    not_pointer="$not_pointer    $path
"
  elif [ "$attr" != lfs ] && [ "$first_line" = "$header" ]; then
    stranded="$stranded    $path
"
  fi
done < "$tmp"
rm -f "$tmp"

# Direction 1: a file that .gitattributes marks as LFS is committed as content
# instead of a pointer ("should have been a pointer, but wasn't"). This breaks
# local checkouts.
if [ -n "$not_pointer" ]; then
  cat >&2 <<EOF

ERROR: Git LFS pointer mismatch -- marked as LFS in .gitattributes but committed as content:
$not_pointer
Fix it in your feature branch and commit the result:
    git add --renormalize .
EOF
  status=1
fi

# Direction 2: a file is committed as an LFS pointer but .gitattributes no longer
# tracks it as LFS. git never smudges it, so at runtime the file holds literal
# pointer text -- a latent failure (e.g. JSON.parse of a manifest) that surfaces
# only once a fresh checkout / rebuilt cache stops masking it.
if [ -n "$stranded" ]; then
  cat >&2 <<EOF

ERROR: stranded Git LFS pointer(s) -- committed as a pointer but not LFS-tracked:
$stranded
These files will hold literal pointer text at runtime instead of their content.
Fix it in your feature branch and commit the result:
    git add --renormalize .
If your working tree only has the pointer text, restore the real content first
-- e.g. undo the .gitattributes change so the path is LFS-tracked again,
git restore the file, then renormalize.
EOF
  status=1
fi

[ $status -eq 0 ] && echo "Git LFS pointer check OK ($(printf '%s\n' "$changed" | wc -l) changed files)"
exit $status
