#!/usr/bin/env ruby

# Seeds Challenge activities into the local database for manual testing.
#
# Two modes:
#
#   Default: seeds the three built-in challenges below, attaching the first to
#   lesson 1, the second to lesson 2, and the third to lesson 3 of a unit
#   (default: aif1-2025). "Lesson N" means the lesson with relative_position N
#   — the numbered lesson students see, not the absolute row order.
#
#   --file: seeds the challenges described by a JSON document (see below),
#   which may span multiple units and lessons and may attach a whiteboard
#   starter image to each challenge.
#
# Idempotent: challenges are matched by lesson + question. Existing matches
# have their other attributes (modality, rubric, starter-image alt text)
# updated in place. In every lesson this run touches, challenges whose question
# is no longer seeded to that lesson are deleted, unless they have responses,
# in which case they are left in place with a warning.
#
# Refuses to run in the production environment.
#
# Usage:
#   bin/seed_challenge_activities [unit_name]
#   bin/seed_challenge_activities --file challenges.json
#
# Examples:
#   bin/seed_challenge_activities                       # aif1-2025, lessons 1-3
#   bin/seed_challenge_activities aif1-2025
#   bin/seed_challenge_activities --file my_challenges.json
#
# JSON file shape — a list of objects, one per challenge:
#
#   [
#     {
#       "unit": "aif1-2025",
#       "lesson_name": "Lesson 1: Talking to Machines",
#       "question": "Draw what you think AI looks like on the inside.",
#       "default_modality": "whiteboard",
#       "rubric": [
#         {"level": 0, "description": "..."},
#         {"level": 1, "description": "..."}
#       ],
#       "starter_image": "/abs/or/relative/path/to/image.png",
#       "starter_image_alt_text": "a blank number grid"
#     }
#   ]
#
# Keys with spaces are also accepted ("lesson name", "default modality",
# "starter image"). starter_image is optional; when present it must be a PNG
# and starter_image_alt_text is required (the alt text is how the app knows a
# starter image exists — see the create_challenge_tables migration).

require 'json'
require 'optparse'

# The default unit, and the built-in challenges seeded when no --file is given.
# The Nth challenge attaches to the lesson with relative_position N+1.
#
# default_modality reflects the activity each prompt calls for (pitch/film it ->
# video, draw it -> whiteboard). Rubrics use the Challenge#rubric shape consumed
# by ChallengeEvaluationPromptHelper — a single criterion expressed as a list of
# integer levels: [{"level" => 0, "description" => ...}, ...]. String keys
# throughout so a re-run compares equal to the stored JSON.
DEFAULT_UNIT_NAME = 'aif1-2025'

CHALLENGES = [
  {
    question: 'Shark Tank but for terrible ideas. Invent the most useless, ' \
      'absurd, or chaotic AI product imaginable, then pitch it on camera like ' \
      'you genuinely believe it will make you a billionaire.',
    default_modality: 'video',
    rubric: [
      {
        'level' => 0,
        'description' => "The transcript doesn't describe an AI-related " \
          'product, or describes one where "AI" is just a label with no ' \
          'explanation of what it does.',
      },
      {
        'level' => 1,
        'description' => 'The transcript describes the product as ' \
          'absurdly AI-powered, but the absurdity is generic ("it uses ' \
          'AI for everything," "it\'s the smartest AI ever") — no ' \
          'specific AI behavior is named or implied.',
      },
      {
        'level' => 2,
        'description' => 'The transcript names or clearly describes a ' \
          'real AI behavior or limitation (e.g., "it makes stuff up," ' \
          '"it\'s way too confident," "it only knows what it was ' \
          'trained on") as the source of the joke.',
      },
      {
        'level' => 3,
        'description' => 'The transcript ties the joke to a real AI ' \
          'behavior or limitation and explains why that makes it ' \
          'useless/dangerous/absurd as a product — i.e., the pitch ' \
          'makes an actual (if joking) argument, not just a reference.',
      },
    ],
  },
  {
    question: 'You are a nature documentary narrator — think hushed, ' \
      "dramatic voice, like you're describing a rare animal in the wild. " \
      'Your subject: a confused AI, alone in the wild, trying to complete a ' \
      'sentence it has never seen before. Film a 30 second nature ' \
      'documentary narrating its struggle.',
    default_modality: 'video',
    rubric: [
      {
        'level' => 0,
        'description' => 'The transcript describes the AI as "confused" ' \
          "or \"struggling\" in a generic, human way (like it's scared " \
          'or thinking hard), with no connection to how AI actually ' \
          'generates text.',
      },
      {
        'level' => 1,
        'description' => 'The transcript references the AI "guessing" ' \
          'or "trying" but doesn\'t explain what it\'s guessing based ' \
          'on — the struggle is described, not the mechanism behind it.',
      },
      {
        'level' => 2,
        'description' => 'The transcript narrates the AI ' \
          "predicting/completing based on patterns it's seen before " \
          '(e.g., "it\'s reaching for the most familiar next word," ' \
          '"it\'s never seen this combination, so it\'s stumbling"), ' \
          'tying the struggle to how the AI actually works.',
      },
      {
        'level' => 3,
        'description' => 'The transcript narrates the AI confidently ' \
          'producing a plausible-sounding completion despite not ' \
          'truly understanding the sentence — capturing the gap ' \
          'between fluency and comprehension, not just the struggle ' \
          'itself.',
      },
    ],
  },
  {
    question: 'No one actually knows what AI looks like on the inside, so you ' \
      'get to decide. Draw it - weird, funny mechanical, cosmic - whatever ' \
      'feels right to you.',
    default_modality: 'whiteboard',
    rubric: [
      {
        'level' => 0,
        'description' => 'The drawing shows no attempt to represent AI ' \
          'as a concept (e.g., a generic robot with no distinguishing ' \
          'elements).',
      },
      {
        'level' => 1,
        'description' => 'The drawing includes at least one element ' \
          'suggesting AI (wires, circuits, a screen) but stays at a ' \
          'surface, literal level.',
      },
      {
        'level' => 2,
        'description' => 'The drawing incorporates a specific idea ' \
          'about how AI works or feels (data, numbers, patterns, ' \
          'connections, chaos) beyond generic robot imagery.',
      },
      {
        'level' => 3,
        'description' => 'The drawing uses its visual choices to make ' \
          'a point about AI — not just depicting a concept, but ' \
          'expressing something (uncertainty, scale, weirdness) ' \
          "through how it's drawn.",
      },
    ],
  },
].freeze

# A normalized challenge to seed. Lesson is identified either by relative
# position (default mode) or by name (--file mode).
ChallengeSpec = Struct.new(
  :unit_name,
  :lesson_name,
  :lesson_position,
  :question,
  :default_modality,
  :rubric,
  :starter_image_path,
  :starter_image_alt_text,
  keyword_init: true
)

# Builds the specs for the built-in challenges, mapping the Nth challenge onto
# the lesson with relative_position N+1.
def default_specs(unit_name)
  CHALLENGES.each_with_index.map do |attrs, index|
    ChallengeSpec.new(
      unit_name: unit_name,
      lesson_position: index + 1,
      question: attrs[:question],
      default_modality: attrs[:default_modality],
      rubric: attrs[:rubric]
    )
  end
end

# Reads one of two accepted keys (underscore or space form) from a JSON object.
def fetch_field(object, *keys)
  keys.each do |key|
    return object[key] if object.key?(key)
  end
  nil
end

# Parses the JSON document into specs, aborting with a pointed message on any
# malformed or missing required field.
def specs_from_file(path)
  abort "file #{path.inspect} not found" unless File.exist?(path)

  begin
    document = JSON.parse(File.read(path))
  rescue JSON::ParserError => exception
    abort "file #{path.inspect} is not valid JSON: #{exception.message}"
  end

  abort "file #{path.inspect} must contain a JSON list of challenge objects" unless document.is_a?(Array)
  abort "file #{path.inspect} contains no challenges" if document.empty?

  document.each_with_index.map do |object, index|
    where = "challenge ##{index + 1}"
    abort "#{where}: expected a JSON object" unless object.is_a?(Hash)

    unit_name = fetch_field(object, 'unit', 'unit_name')
    lesson_name = fetch_field(object, 'lesson_name', 'lesson name', 'lesson')
    question = object['question']
    default_modality = fetch_field(object, 'default_modality', 'default modality')
    rubric = object['rubric']
    starter_image_path = fetch_field(object, 'starter_image', 'starter image')
    starter_image_alt_text = fetch_field(
      object, 'starter_image_alt_text', 'whiteboard_starter_image_alt_text'
    )

    abort "#{where}: missing \"unit\"" if unit_name.to_s.empty?
    abort "#{where}: missing \"lesson_name\"" if lesson_name.to_s.empty?
    abort "#{where}: missing \"question\"" if question.to_s.empty?

    if starter_image_path && starter_image_alt_text.to_s.empty?
      abort "#{where}: \"starter_image\" requires \"starter_image_alt_text\" " \
        '(the alt text is how the app knows a starter image exists)'
    end

    ChallengeSpec.new(
      unit_name: unit_name,
      lesson_name: lesson_name,
      question: question,
      default_modality: default_modality,
      rubric: rubric,
      starter_image_path: starter_image_path,
      starter_image_alt_text: starter_image_alt_text
    )
  end
end

# Resolves the Lesson a spec attaches to, aborting if the unit or lesson is
# absent. Units and their lessons are memoized so a multi-challenge file does
# not re-query per row.
def resolve_lesson(spec, unit_cache)
  unit = unit_cache[spec.unit_name] ||= Unit.find_by(name: spec.unit_name)
  abort "unit #{spec.unit_name.inspect} not found" unless unit

  lesson =
    if spec.lesson_position
      # "Lesson N" is the Nth *numbered* lesson a student sees. Unnumbered
      # lessons (e.g. a pre-assessment) get their own relative_position
      # counter, so relative_position alone is ambiguous — pick from the
      # numbered lessons in order instead.
      numbered = unit.lessons.select(&:numbered_lesson?).sort_by(&:absolute_position)
      numbered[spec.lesson_position - 1]
    else
      unit.lessons.find_by(name: spec.lesson_name)
    end

  unless lesson
    wanted = spec.lesson_position ? "numbered lesson #{spec.lesson_position}" : spec.lesson_name.inspect
    abort "unit #{spec.unit_name.inspect} has no #{wanted}"
  end

  lesson
end

# Reads and validates a starter image, returning [bytes, content_type]. Only
# PNG is accepted: the S3 key carries a .png extension and the whiteboard
# pipeline assumes PNG.
def read_starter_image(path, where)
  abort "#{where}: starter image #{path.inspect} not found" unless File.exist?(path)
  unless File.extname(path).casecmp('.png').zero?
    abort "#{where}: starter image must be a PNG (whiteboard starter images are PNG)"
  end
  [File.binread(path), 'image/png']
end

options = {}
OptionParser.new do |opts|
  opts.banner = 'Usage: bin/seed_challenge_activities [unit_name] [--file challenges.json]'
  opts.on('-f', '--file PATH', 'JSON document describing challenges to seed') do |value|
    options[:file] = value
  end
end.parse!(ARGV)

positional_unit_name = ARGV[0]

if options[:file] && positional_unit_name
  abort 'pass either a unit name or --file, not both'
end

# Build and validate the specs before loading Rails so malformed input fails in
# under a second rather than after the ~20s environment boot. Resolving units
# and lessons still needs the database, and happens below.
specs =
  if options[:file]
    specs_from_file(options[:file])
  else
    default_specs(positional_unit_name || DEFAULT_UNIT_NAME)
  end

puts 'loading rails environment...'
require_relative '../dashboard/config/environment'

abort 'refusing to run in the production environment' if Rails.env.production?

created = 0
updated = 0
unchanged = 0
removed = 0
starter_images = 0

unit_cache = {}
# lesson_id => Set of questions seeded to that lesson this run, for the cleanup
# sweep below.
seeded_by_lesson = Hash.new {|hash, key| hash[key] = []}

specs.each_with_index do |spec, index|
  where = "challenge ##{index + 1}"
  lesson = resolve_lesson(spec, unit_cache)
  seeded_by_lesson[lesson.id] << spec.question

  challenge = Challenge.find_or_initialize_by(lesson_id: lesson.id, question: spec.question)
  is_new = challenge.new_record?

  begin
    challenge.assign_attributes(
      default_modality: spec.default_modality,
      whiteboard_starter_image_alt_text: spec.starter_image_alt_text,
      rubric: spec.rubric
    )
  rescue ArgumentError => exception
    # assigning an out-of-range enum value raises before validation.
    abort "#{where}: #{exception.message}"
  end

  if is_new
    challenge.save!
    created += 1
  elsif challenge.changed?
    challenge.save!
    updated += 1
  else
    unchanged += 1
  end

  next unless spec.starter_image_path

  if spec.default_modality != 'whiteboard'
    puts "#{where}: warning: starter image given but default_modality is " \
      "#{spec.default_modality.inspect}; the starter image only applies to whiteboards"
  end
  bytes, content_type = read_starter_image(spec.starter_image_path, where)
  challenge.upload_starter_image(bytes, content_type: content_type)
  starter_images += 1
end

# A question edit leaves the old row behind (matching is by question). In every
# lesson this run touched, remove challenges we did not seed, unless a student
# response points at them.
seeded_by_lesson.each do |lesson_id, questions|
  Challenge.where(lesson_id: lesson_id).where.not(question: questions).each do |challenge|
    if challenge.challenge_responses.exists?
      puts "warning: challenge #{challenge.id} (#{challenge.question.truncate(60).inspect}) " \
        'is not in the seed list but has responses; leaving it in place'
    else
      challenge.destroy!
      removed += 1
    end
  end
end

puts "lessons touched: #{seeded_by_lesson.size}"
puts "challenges created: #{created}, updated: #{updated}, unchanged: #{unchanged}, " \
  "removed: #{removed}, starter images uploaded: #{starter_images}"
